<!doctype html>
<html lang={currentLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content={robotsMeta} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Pinterest Domain Verification -->
		<meta name="p:domain_verify" content="dc89e9b48b7591a1ef4a9929c6326319" />
		
		{!is404 && (
			<>
				<!-- Multilingual Hreflang Cluster -->
				<link rel="alternate" hreflang="en" href={`https://manage.wedding${cleanPath ? `/${cleanPath}` : ''}`} />
				<link rel="alternate" hreflang="es" href={`https://manage.wedding/es${cleanPath ? `/${cleanPath}` : ''}`} />
				<link rel="alternate" hreflang="fr" href={`https://manage.wedding/fr${cleanPath ? `/${cleanPath}` : ''}`} />
				<link rel="alternate" hreflang="de" href={`https://manage.wedding/de${cleanPath ? `/${cleanPath}` : ''}`} />
				<link rel="alternate" hreflang="it" href={`https://manage.wedding/it${cleanPath ? `/${cleanPath}` : ''}`} />
				<link rel="alternate" hreflang="pt" href={`https://manage.wedding/pt${cleanPath ? `/${cleanPath}` : ''}`} />
				<link rel="alternate" hreflang="ja" href={`https://manage.wedding/ja${cleanPath ? `/${cleanPath}` : ''}`} />
				<link rel="alternate" hreflang="x-default" href={`https://manage.wedding${cleanPath ? `/${cleanPath}` : ''}`} />
			</>
		)}

		<!-- Performance: DNS Prefetch & Preconnect for Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Kalam:wght@700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap" rel="stylesheet" />

		<meta name="theme-color" content="#fdfbf7" />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- OpenGraph / Facebook Social Sharing -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://manage.wedding/images/calculator_sketch.webp" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://manage.wedding/images/calculator_sketch.webp" />
		
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8474QVLWBF"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-8474QVLWBF');
		</script>
		
		<!-- Google AdSense -->
		<script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8282026956899927" crossorigin="anonymous"></script>
		
		{finalSchema && (
			<script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
		)}
	</head>
	<body>
		<nav class="nav-sketch">
			<a href={langPrefix || '/'} style="text-decoration: none;">
				<div class="font-heading" style="font-size: clamp(1.4rem, 4vw, 2rem); color: var(--fg-pencil); transform: rotate(-2deg); white-space: nowrap;">
					manage.wedding
				</div>
			</a>

				<!-- Desktop Navigation Links (Single-Word Categories + Language Selector) -->
				<div class="nav-links-desktop" style="display: flex; gap: 1.25rem; align-items: center;">
					{navLinks.map((link) => (
						<a href={link.href}>{link.label}</a>
					))}

					<!-- Language Selector Dropdown (Hidden on /ja) -->
					{!isJa && (
						<div class="lang-dropdown-wrapper" style="position: relative; margin-left: 0.25rem;">
							<button id="lang-menu-btn" class="lang-toggle-btn" aria-label="Select Language" aria-expanded="false" style="display: flex; align-items: center; gap: 0.35rem; background: #fff; border: 1.5px solid var(--fg-pencil); padding: 5px 10px; border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil); cursor: pointer; box-shadow: 2px 2px 0px var(--fg-pencil); transition: all 0.15s ease;">
								<span>🌐</span>
								<span>{currentT.nav.langLabel}</span>
