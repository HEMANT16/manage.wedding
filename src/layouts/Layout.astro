---
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	schema?: object;
}

const { title, description, schema } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		{schema && (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		)}
	</head>
	<body>
		<nav class="nav-sketch">
			<a href="/" style="text-decoration: none;">
				<div class="font-heading" style="font-size: clamp(1.4rem, 4vw, 2rem); color: var(--fg-pencil); transform: rotate(-2deg); white-space: nowrap;">
					manage.wedding
				</div>
			</a>

			<!-- Desktop Navigation Links -->
			<div class="nav-links-desktop">
				<a href="/">All Tools</a>
				<a href="/#budgeting-finance">Budgeting</a>
				<a href="/#drinks-bar">Bar & Drinks</a>
				<a href="/#creative-extras">Creative</a>
				<a href="/" class="hand-btn" style="padding: 6px 16px; font-size: 1rem;">Explore 25 Tools</a>
			</div>

			<!-- Mobile Hamburger Button -->
			<button class="hamburger-btn" id="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
				<span class="bar"></span>
				<span class="bar"></span>
				<span class="bar"></span>
			</button>

			<!-- Mobile Dropdown Drawer -->
			<div class="mobile-menu-drawer" id="mobile-menu-drawer">
				<div class="mobile-nav-grid">
					<a href="/" class="mobile-nav-link">
						<span>🏠</span>
						<span>All 25 Calculators & Tools</span>
					</a>
					<a href="/#drinks-bar" class="mobile-nav-link" onclick="closeMobileMenu()">
						<span>🍾</span>
						<span>Food, Drinks & Bar</span>
					</a>
					<a href="/#guest-management" class="mobile-nav-link" onclick="closeMobileMenu()">
						<span>👥</span>
						<span>Guest Management & Seating</span>
					</a>
					<a href="/#planning-logistics" class="mobile-nav-link" onclick="closeMobileMenu()">
						<span>📅</span>
						<span>Planning & Day-Of Logistics</span>
					</a>
					<a href="/#budgeting-finance" class="mobile-nav-link" onclick="closeMobileMenu()">
						<span>💰</span>
						<span>Budgeting & Cost Estimators</span>
					</a>
					<a href="/#stationery-printables" class="mobile-nav-link" onclick="closeMobileMenu()">
						<span>💌</span>
						<span>Stationery & Table Cards</span>
					</a>
					<a href="/#for-guests" class="mobile-nav-link" onclick="closeMobileMenu()">
						<span>🎁</span>
						<span>Guest Gifts & Anniversary</span>
					</a>
					<a href="/#creative-extras" class="mobile-nav-link" onclick="closeMobileMenu()">
						<span>🎨</span>
						<span>Creative, Hashtags & Speeches</span>
					</a>
				</div>
			</div>
		</nav>

		<script is:inline>
			const toggleBtn = document.getElementById('mobile-menu-toggle');
			const menuDrawer = document.getElementById('mobile-menu-drawer');

			function toggleMobileMenu() {
				const isOpen = toggleBtn.classList.toggle('is-open');
				menuDrawer.classList.toggle('is-active');
				toggleBtn.setAttribute('aria-expanded', isOpen);
			}

			function closeMobileMenu() {
				toggleBtn.classList.remove('is-open');
				menuDrawer.classList.remove('is-active');
				toggleBtn.setAttribute('aria-expanded', 'false');
			}

			if (toggleBtn) {
				toggleBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					toggleMobileMenu();
				});
			}

			// Close on click outside
			document.addEventListener('click', (e) => {
				if (menuDrawer && menuDrawer.classList.contains('is-active')) {
					if (!menuDrawer.contains(e.target) && !toggleBtn.contains(e.target)) {
						closeMobileMenu();
					}
				}
			});

			// Close on ESC key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && menuDrawer && menuDrawer.classList.contains('is-active')) {
					closeMobileMenu();
				}
			});
		</script>

		<slot />

		<footer style="background-color: var(--muted-paper); padding: 3rem 2rem; border-top: 3px dashed var(--fg-pencil); margin-top: 4rem;">
			<div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
				<div class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); font-weight: bold; transform: rotate(1deg);">
					Manage.Wedding &copy; 2026
				</div>
				<div class="nav-links" style="display: flex; gap: 2rem;">
					<a href="/privacy" style="text-decoration: underline; text-decoration-style: wavy; color: var(--fg-pencil);">Privacy Policy</a>
					<a href="/terms" style="text-decoration: underline; text-decoration-style: wavy; color: var(--fg-pencil);">Terms of Service</a>
				</div>
			</div>
		</footer>
	</body>
</html>
