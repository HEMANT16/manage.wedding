								</a>
								<a href={getLangLink('es')} class={`lang-option ${currentLang === 'es' ? 'active' : ''}`} style={`display: flex; align-items: center; justify-content: space-between; padding: 8px 14px; font-size: 0.88rem; color: var(--fg-pencil); text-decoration: none; font-weight: ${currentLang === 'es' ? '700' : '600'}; background: ${currentLang === 'es' ? 'rgba(37,99,235,0.08)' : 'transparent'};`}>
