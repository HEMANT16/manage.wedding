---
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	schema?: object;
	noindex?: boolean;
}

const { title, description, schema, noindex } = Astro.props;

// Dynamic Path & Language Detection (normalized without trailing slash and without .html)
const pathname = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "");
const is404 = pathname === '/404' || pathname.endsWith('/404') || noindex === true;
const robotsMeta = is404 ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";

let currentLang = 'en';
if (pathname.startsWith('/es')) currentLang = 'es';
else if (pathname.startsWith('/fr')) currentLang = 'fr';
else if (pathname.startsWith('/de')) currentLang = 'de';
else if (pathname.startsWith('/it')) currentLang = 'it';
else if (pathname.startsWith('/pt')) currentLang = 'pt';
else if (pathname.startsWith('/ja')) currentLang = 'ja';

const langPrefix = currentLang === 'en' ? '' : `/${currentLang}`;
const cleanPath = pathname.replace(/^\/(es|fr|de|it|pt|ja)/, '').replace(/\.html$/, '').replace(/\/$/, '').replace(/^\//, '');

const canonicalPath = is404 ? '/404' : (currentLang === 'en' ? (cleanPath ? `/${cleanPath}` : '/') : (cleanPath ? `/${currentLang}/${cleanPath}` : `/${currentLang}`));
const canonicalURL = new URL(canonicalPath, Astro.site || 'https://manage.wedding');

function getLangLink(targetLang: string) {
	const prefix = targetLang === 'en' ? '' : `/${targetLang}`;
	if (is404 || cleanPath === '404') {
		return prefix || '/';
	}
	const targetPath = cleanPath ? `${prefix}/${cleanPath}` : (prefix || '/');
	return targetPath;
}

// Dynamic BreadcrumbList Schema Generation (only for subpages with min 2 items)
const pageName = title ? title.split(" — ")[0].split(" (")[0].split(" | ")[0].trim() : "Wedding Planning Tool";

const homeNames: Record<string, string> = {
	en: "Home",
	es: "Inicio",
	fr: "Accueil",
	de: "Startseite",
	it: "Home",
	pt: "Início",
	ja: "ホーム"
};

const isSubPage = Boolean(cleanPath && cleanPath !== "" && cleanPath !== "/");

const breadcrumbItems = [
	{
		"@type": "ListItem",
		"position": 1,
		"name": homeNames[currentLang] || "Home",
		"item": `https://manage.wedding${langPrefix}`
	}
];

if (isSubPage) {
	breadcrumbItems.push({
		"@type": "ListItem",
		"position": 2,
		"name": pageName,
		"item": `https://manage.wedding${pathname}`
	});
}

const breadcrumbSchema = isSubPage ? {
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbItems
} : null;

// Support both schema and jsonLd props with robust merging
let rawSchema = schema || (Astro.props as any).jsonLd;
let finalSchema = rawSchema;
if (finalSchema && (finalSchema as any)["@graph"]) {
	const hasBreadcrumb = (finalSchema as any)["@graph"].some((item: any) => item["@type"] === "BreadcrumbList");
	if (!hasBreadcrumb && breadcrumbSchema) {
		finalSchema = {
			...finalSchema,
			"@graph": [...(finalSchema as any)["@graph"], breadcrumbSchema]
		};
	}
} else if (finalSchema && typeof finalSchema === "object" && !(finalSchema as any)["@graph"]) {
	if (breadcrumbSchema) {
		finalSchema = {
			"@context": "https://schema.org",
			"@graph": [finalSchema, breadcrumbSchema]
		};
	}
} else if (!finalSchema && breadcrumbSchema) {
	finalSchema = {
		"@context": "https://schema.org",
		"@graph": [breadcrumbSchema]
	};
}

