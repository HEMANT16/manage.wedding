				const isOpen = toggleBtn.classList.toggle('is-open');
				menuDrawer.classList.toggle('is-active');
				toggleBtn.setAttribute('aria-expanded', isOpen);
			}

			function closeMobileMenu() {
				toggleBtn.classList.remove('is-open');
				menuDrawer.classList.remove('is-active');
				toggleBtn.setAttribute('aria-expanded', 'false');
			}

			if (toggleBtn) {
				toggleBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					toggleMobileMenu();
				});
			}

			// Close on click outside
			document.addEventListener('click', (e) => {
				if (menuDrawer && menuDrawer.classList.contains('is-active')) {
					if (!menuDrawer.contains(e.target) && !toggleBtn.contains(e.target)) {
						closeMobileMenu();
					}
				}
			});

			// Close on ESC key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && menuDrawer && menuDrawer.classList.contains('is-active')) {
					closeMobileMenu();
				}
			});
		</script>

