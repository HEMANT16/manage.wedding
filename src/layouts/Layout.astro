								<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(65px, 1fr)); gap: 0.4rem;">
									<a href={getLangLink('en')} class={`mobile-lang-btn ${currentLang === 'en' ? 'active' : ''}`} style={`text-align: center; padding: 6px 4px; font-size: 0.82rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-decoration: none; background: ${currentLang === 'en' ? 'var(--fg-pencil)' : '#fff'}; color: ${currentLang === 'en' ? '#fff' : 'var(--fg-pencil)'};`}>🇬🇧 EN</a>
									<a href={getLangLink('es')} class={`mobile-lang-btn ${currentLang === 'es' ? 'active' : ''}`} style={`text-align: center; padding: 6px 4px; font-size: 0.82rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-decoration: none; background: ${currentLang === 'es' ? 'var(--fg-pencil)' : '#fff'}; color: ${currentLang === 'es' ? '#fff' : 'var(--fg-pencil)'};`}>🇪🇸 ES</a>
									<a href={getLangLink('fr')} class={`mobile-lang-btn ${currentLang === 'fr' ? 'active' : ''}`} style={`text-align: center; padding: 6px 4px; font-size: 0.82rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-decoration: none; background: ${currentLang === 'fr' ? 'var(--fg-pencil)' : '#fff'}; color: ${currentLang === 'fr' ? '#fff' : 'var(--fg-pencil)'};`}>🇫🇷 FR</a>
									<a href={getLangLink('de')} class={`mobile-lang-btn ${currentLang === 'de' ? 'active' : ''}`} style={`text-align: center; padding: 6px 4px; font-size: 0.82rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-decoration: none; background: ${currentLang === 'de' ? 'var(--fg-pencil)' : '#fff'}; color: ${currentLang === 'de' ? '#fff' : 'var(--fg-pencil)'};`}>🇩🇪 DE</a>
									<a href={getLangLink('it')} class={`mobile-lang-btn ${currentLang === 'it' ? 'active' : ''}`} style={`text-align: center; padding: 6px 4px; font-size: 0.82rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-decoration: none; background: ${currentLang === 'it' ? 'var(--fg-pencil)' : '#fff'}; color: ${currentLang === 'it' ? '#fff' : 'var(--fg-pencil)'};`}>🇮🇹 IT</a>
									<a href={getLangLink('pt')} class={`mobile-lang-btn ${currentLang === 'pt' ? 'active' : ''}`} style={`text-align: center; padding: 6px 4px; font-size: 0.82rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-decoration: none; background: ${currentLang === 'pt' ? 'var(--fg-pencil)' : '#fff'}; color: ${currentLang === 'pt' ? '#fff' : 'var(--fg-pencil)'};`}>🇵🇹 PT</a>
									<a href={getLangLink('ja')} class={`mobile-lang-btn ${currentLang === 'ja' ? 'active' : ''}`} style={`text-align: center; padding: 6px 4px; font-size: 0.82rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-decoration: none; background: ${currentLang === 'ja' ? 'var(--fg-pencil)' : '#fff'}; color: ${currentLang === 'ja' ? '#fff' : 'var(--fg-pencil)'};`}>🇯🇵 JA</a>
