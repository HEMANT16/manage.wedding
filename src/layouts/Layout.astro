---
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	schema?: object;
}

const { title, description, schema } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://manage.wedding');

// Dynamic BreadcrumbList Schema Generation
const pathname = Astro.url.pathname.replace(/\/$/, "");
const pageName = title ? title.split(" — ")[0].split(" (")[0].split(" | ")[0].trim() : "Wedding Planning Tool";

const breadcrumbItems = [
	{
		"@type": "ListItem",
		"position": 1,
		"name": "Home",
		"item": "https://manage.wedding"
	}
];

if (pathname && pathname !== "") {
	breadcrumbItems.push({
		"@type": "ListItem",
		"position": 2,
		"name": pageName,
		"item": `https://manage.wedding${pathname}`
	});
}

const breadcrumbSchema = {
	"@type": "BreadcrumbList",
	"itemListElement": breadcrumbItems
};

// Merge BreadcrumbList into Schema @graph
let finalSchema = schema;
if (finalSchema && (finalSchema as any)["@graph"]) {
	const hasBreadcrumb = (finalSchema as any)["@graph"].some((item: any) => item["@type"] === "BreadcrumbList");
	if (!hasBreadcrumb && pathname !== "") {
		finalSchema = {
			...finalSchema,
			"@graph": [...(finalSchema as any)["@graph"], breadcrumbSchema]
		};
	}
} else if (!finalSchema && pathname !== "") {
	finalSchema = {
		"@context": "https://schema.org",
		"@graph": [breadcrumbSchema]
	};
}
---

<!doctype html>
<html lang="en">
