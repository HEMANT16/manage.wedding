		<script is:inline>
			const toggleBtn = document.getElementById('mobile-menu-toggle');
			const menuDrawer = document.getElementById('mobile-menu-drawer');
			const langBtn = document.getElementById('lang-menu-btn');
			const langMenu = document.getElementById('lang-dropdown-menu');

			function toggleMobileMenu() {
				const isOpen = toggleBtn.classList.toggle('is-open');
				menuDrawer.classList.toggle('is-active');
				toggleBtn.setAttribute('aria-expanded', isOpen);
				if (langMenu) langMenu.style.display = 'none';
			}

			function closeMobileMenu() {
				toggleBtn.classList.remove('is-open');
				menuDrawer.classList.remove('is-active');
				toggleBtn.setAttribute('aria-expanded', 'false');
			}

			if (toggleBtn) {
				toggleBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					toggleMobileMenu();
				});
			}

			// Language Dropdown Toggle
			if (langBtn && langMenu) {
				langBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					const isHidden = langMenu.style.display === 'none' || langMenu.style.display === '';
					langMenu.style.display = isHidden ? 'block' : 'none';
					langBtn.setAttribute('aria-expanded', isHidden);
				});
			}

			// Close dropdowns on click outside
			document.addEventListener('click', (e) => {
				if (langMenu && !langMenu.contains(e.target) && !langBtn.contains(e.target)) {
					langMenu.style.display = 'none';
					if (langBtn) langBtn.setAttribute('aria-expanded', 'false');
				}
				if (menuDrawer && menuDrawer.classList.contains('is-active')) {
					if (!menuDrawer.contains(e.target) && !toggleBtn.contains(e.target)) {
						closeMobileMenu();
					}
				}
			});

			// Close on ESC key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					if (langMenu) langMenu.style.display = 'none';
					if (menuDrawer && menuDrawer.classList.contains('is-active')) {
						closeMobileMenu();
					}
				}
			});

			// Universal Form State Auto-Save & Auto-Restore
			(function() {
				try {
					const pathKey = window.location.pathname.replace(/\/$/, '') || '/';
					const storagePrefix = 'mw_save_' + pathKey + '_';

					function shouldIgnore(el) {
						if (!el || el.dataset.noSave !== undefined) return true;
						if (el.id === 'global-search-input' || el.id === 'search-input') return true;
						if (el.type === 'hidden' || el.type === 'submit' || el.type === 'button') return true;
						if (el.closest && el.closest('.no-save, #mobile-menu-drawer, #lang-dropdown-menu')) return true;
						return false;
					}

					function restoreState() {
						const inputs = document.querySelectorAll('input, select, textarea');
						inputs.forEach(el => {
							if (shouldIgnore(el)) return;
							const key = storagePrefix + (el.id || el.name);
							if (!el.id && !el.name) return;
							const saved = localStorage.getItem(key);
							if (saved !== null) {
								if (el.type === 'checkbox') {
									el.checked = saved === 'true';
								} else if (el.type === 'radio') {
									el.checked = el.value === saved;
								} else {
									el.value = saved;
								}
								el.dispatchEvent(new Event('input', { bubbles: true }));
								el.dispatchEvent(new Event('change', { bubbles: true }));
							}
						});
					}

					function saveInput(el) {
						if (shouldIgnore(el)) return;
						const key = storagePrefix + (el.id || el.name);
						if (!el.id && !el.name) return;
						if (el.type === 'checkbox') {
							localStorage.setItem(key, el.checked.toString());
						} else if (el.type === 'radio') {
							if (el.checked) localStorage.setItem(key, el.value);
						} else {
							localStorage.setItem(key, el.value);
						}
					}

					document.addEventListener('input', (e) => {
						if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'TEXTAREA')) {
							saveInput(e.target);
						}
					}, { passive: true });

					document.addEventListener('change', (e) => {
						if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'TEXTAREA')) {
							saveInput(e.target);
						}
					}, { passive: true });

					if (document.readyState !== 'loading') {
						restoreState();
					} else {
						document.addEventListener('DOMContentLoaded', restoreState);
					}
				} catch (err) {
					// Fallback silently if localStorage is restricted
				}
			})();
		</script>

