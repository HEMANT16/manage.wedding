---
interface Props {
  title: string;
  description: string;
  h1: string;
  slug: string;
  faqs: { question: string; answer: string }[];
}

const { title, description, h1, slug, faqs } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://events-catering-calculators.com');

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": h1,
  "operatingSystem": "All",
  "applicationCategory": "CalculatorApplication",
  "description": description,
  "url": canonicalURL.toString(),
  "mainEntity": {
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    
    <title>{title}</title>
    
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen font-sans">
    <header class="bg-white shadow-sm py-4">
      <div class="max-w-4xl mx-auto px-4 flex justify-between items-center">
        <a href="/" class="text-xl font-bold text-blue-600">Events & Catering</a>
        <nav class="space-x-4 text-sm text-gray-600">
          <a href="/">Home</a>
          <a href="/wedding-drink-calculator" class="hover:text-blue-600">Wedding Alcohol</a>
          <a href="/alcohol-dilution-calculator" class="hover:text-blue-600">Dilution</a>
          <a href="/cake-pricing-calculator" class="hover:text-blue-600">Cake Pricing</a>
        </nav>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
      <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
        <ol class="list-none p-0 inline-flex">
          <li class="flex items-center">
            <a href="/" class="hover:text-blue-600">Home</a>
            <span class="mx-2">/</span>
          </li>
          <li class="flex items-center">
            <span class="text-gray-800" aria-current="page">{h1}</span>
          </li>
        </ol>
      </nav>

      <h1 class="text-4xl font-extrabold text-gray-900 mb-4">{h1}</h1>
      <p class="text-lg text-gray-600 mb-8">{description}</p>
      
      <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-6 md:p-8 mb-12">
        <slot />
      </div>

      {faqs && faqs.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-bold mb-6">Frequently Asked Questions</h2>
          <div class="space-y-6">
            {faqs.map(faq => (
              <div>
                <h3 class="font-semibold text-lg text-gray-900">{faq.question}</h3>
                <p class="text-gray-600 mt-2">{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}
    </main>
    
    <footer class="bg-gray-800 text-gray-300 py-8 mt-12 text-center text-sm">
      <p>&copy; {new Date().getFullYear()} Events & Catering Calculators. All rights reserved.</p>
    </footer>
  </body>
</html>
