---
export interface Props {
  currentPath?: string;
  category?: 'stationery' | 'food-beverage' | 'budget' | 'logistics' | 'all';
}

const { currentPath = Astro.url.pathname, category } = Astro.props;

interface ToolItem {
  title: string;
  url: string;
  desc: string;
  badge: string;
  icon: string;
  category: 'stationery' | 'food-beverage' | 'budget' | 'logistics';
}

const allTools: ToolItem[] = [
  // Stationery & Print
  {
    title: "Envelope Address Formatter",
    url: "/wedding-envelope-addressing",
    desc: "Format A7 outer envelopes and A2 RSVP cards with formal doctor and family titles.",
    badge: "Etiquette & A7",
    icon: "💌",
    category: "stationery"
  },
  {
    title: "Invitation Suite Sizer",
    url: "/wedding-invitation-suite-sizer",
    desc: "Calculate layered card mat margins, tolerances, and 300 DPI Canva print bleeds.",
    badge: "300 DPI Specs",
    icon: "📐",
    category: "stationery"
  },
  {
    title: "Invitation Postage & Weight",
    url: "/wedding-invitation-postage-calculator",
    desc: "Compute paper weight, wax seal fees, square envelopes, and USPS 2026 rates.",
    badge: "USPS 2026 Rates",
    icon: "📮",
    category: "stationery"
  },
  {
    title: "Thank-You Note Generator",
    url: "/wedding-thank-you-cards",
    desc: "Generate personalized thank-you wording for cash, honeymoon funds, and registry gifts.",
    badge: "Cash & Registry",
    icon: "✍️",
    category: "stationery"
  },
  {
    title: "Folded Table Place Cards",
    url: "/table-place-cards",
    desc: "Generate printable tent place cards with guest names and meal icons.",
    badge: "Printable PDF",
    icon: "📇",
    category: "stationery"
  },
  {
    title: "Reception Menu Maker",
    url: "/reception-menu-maker",
    desc: "Design 4x9 DL and 5x7 table menus with luxury fonts, botanical borders, and dietary tags.",
    badge: "Luxury Fonts",
    icon: "📜",
    category: "stationery"
  },

  // Food, Drinks & Bar
  {
    title: "Open Bar Drink Calculator",
    url: "/wedding-drink-calculator",
    desc: "Calculate total wine, beer, champagne, and spirit bottles for 50 to 300+ guests.",
    badge: "Bar Estimator",
    icon: "🍾",
    category: "food-beverage"
  },
  {
    title: "Wedding Liquor & Spirits Sizer",
    url: "/liquor-wedding-calculator",
    desc: "Exact 750ml vs 1.75L bottle counts for Vodka, Bourbon, Tequila, Gin, and mixers.",
    badge: "Spirits & Handles",
    icon: "🍸",
    category: "food-beverage"
  },
  {
    title: "Wedding Cake Pricing Sizer",
    url: "/cake-pricing-calculator",
    desc: "Calculate cost per slice, baker labor hours, ingredient costs, and bakery margins.",
    badge: "Price Per Slice",
    icon: "🍰",
    category: "food-beverage"
  },
  {
    title: "Cake Tier Serving Sizer",
    url: "/cake-serving-calculator",
    desc: "Match guest headcounts to stacked round and square cake tier dimensions.",
    badge: "Tier Sizing",
    icon: "🎂",
    category: "food-beverage"
  },
  {
    title: "Catering Cost Estimator",
    url: "/catering-cost-estimator",
    desc: "Compare plated dinner vs buffet vs family-style per-head catering budgets.",
    badge: "Per-Head Budget",
    icon: "🍽️",
    category: "food-beverage"
  },

  // Budget & Finance
  {
    title: "Venue True Cost & Fee Sizer",
    url: "/wedding-venue-cost-calculator",
    desc: "Uncover $3k–$10k in hidden fees, F&B minimums, and mandatory 22% plus-plus surcharges.",
    badge: "Plus-Plus (++) Math",
    icon: "🏰",
    category: "budget"
  },
  {
    title: "Who Pays for What? Splitter",
    url: "/who-pays-for-what-wedding",
    desc: "Compare 1950s traditional etiquette against modern 3-way blended family contributions.",
    badge: "1950s vs Modern",
    icon: "👥",
    category: "budget"
  },
  {
    title: "Bachelorette Party Budget Splitter",
    url: "/bachelorette-budget-calculator",
    desc: "Calculate per-bridesmaid costs for Airbnb and dining while covering the bride's share.",
    badge: "Cover the Bride",
    icon: "👰",
    category: "budget"
  },
  {
    title: "Master Budget Allocator",
    url: "/master-budget-calculator",
    desc: "Break down your total budget into realistic percentage milestones.",
    badge: "Percentage Splits",
    icon: "💰",
    category: "budget"
  },
  {
    title: "Vendor Gratuity Calculator",
