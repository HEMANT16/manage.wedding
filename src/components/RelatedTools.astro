      de: "Auszug & Funkeln",
      es: "Despedida Mágica",
      fr: "Sortie Étincelante",
      it: "Uscita Luminosa",
      pt: "Saída Iluminada"
    },
    icon: "✨",
    category: "logistics"
  }
];

// UI Texts Localization
const uiText: Record<string, { keepPlanning: string; heading: string; subtitle: string; launch: string; exploreAll: string }> = {
  en: {
    keepPlanning: "Keep Planning",
    heading: "Recommended Next Steps & Related Tools",
    subtitle: "Every calculation stays 100% free, private in your browser, and instantly exportable to PDF/Word.",
    launch: "Launch Free Tool",
    exploreAll: "✨ Explore All 38+ Free Wedding Planning Calculators & Tools →"
  },
  de: {
    keepPlanning: "Weiterplanen",
    heading: "Empfohlene nächste Schritte & Tools",
    subtitle: "Alle Berechnungen bleiben 100% kostenlos, privat in Ihrem Browser und druckfertig exportierbar.",
    launch: "Kostenloses Tool öffnen",
    exploreAll: "✨ Alle 38+ kostenlosen Hochzeitsrechner & Tools entdecken →"
  },
  es: {
    keepPlanning: "Sigue Planificando",
    heading: "Herramientas Relacionadas Recomendadas",
    subtitle: "Cálculos 100% gratuitos, privados en tu navegador y exportables a PDF/Word.",
    launch: "Abrir Herramienta Gratis",
    exploreAll: "✨ Explorar Todas las 38+ Calculadoras Gratuitas de Boda →"
  },
  fr: {
    keepPlanning: "Continuer la Planification",
    heading: "Outils Recommandés & Prochaines Étapes",
    subtitle: "Calculs 100% gratuits, confidentiels dans votre navigateur et exportables en PDF/Word.",
    launch: "Ouvrir l'Outil Gratuit",
    exploreAll: "✨ Découvrir Tous les 38+ Outils et Simulateurs de Mariage →"
  },
  it: {
    keepPlanning: "Continua a Pianificare",
    heading: "Strumenti e Passi Consigliati",
    subtitle: "Calcoli 100% gratuiti, riservati nel tuo browser ed esportabili in PDF/Word.",
    launch: "Apri Strumento Gratuito",
    exploreAll: "✨ Scopri Tutti i 38+ Calcolatori Gratuiti per il Matrimonio →"
  },
  pt: {
    keepPlanning: "Continuar Planejamento",
    heading: "Próximos Passos e Ferramentas Recomendadas",
    subtitle: "Cálculos 100% gratuitos, privados no seu navegador e exportáveis em PDF/Word.",
    launch: "Abrir Ferramenta Grátis",
    exploreAll: "✨ Explorar Todas as 38+ Calculadoras Gratuitas de Casamento →"
  }
};

const currentUI = uiText[currentLang] || uiText['en'];

// Normalize Category Aliases (e.g. dining -> food-beverage, guests/planning -> logistics)
let targetCategory = category;
if (category === 'dining' as any) targetCategory = 'food-beverage';
else if (category === 'guests' as any || category === 'guests-logistics' as any || category === 'planning' as any) targetCategory = 'logistics';

// Filter out current tool
let filtered = allTools.filter(t => t.url !== cleanCurrent);

if (targetCategory && targetCategory !== 'all') {
  const matching = filtered.filter(t => t.category === targetCategory);
  if (matching.length > 0) filtered = matching;
}

const displayedTools = filtered.slice(0, 3);
---

<section class="related-tools-section no-print" style="margin: 3.5rem auto; padding: 2.5rem 1.5rem; background: var(--bg-paper); border: 2.5px solid var(--fg-pencil); border-radius: 8px; box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
  <div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>

  <div style="text-align: center; margin-bottom: 2rem;">
    <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">
      {currentUI.keepPlanning}
    </span>
    <h2 class="font-heading" style="font-size: clamp(1.6rem, 3.5vw, 2.3rem); color: var(--fg-pencil); margin: 0.25rem 0 0.4rem 0;">
      {currentUI.heading}
    </h2>
    <p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 650px; margin: 0 auto;">
      {currentUI.subtitle}
    </p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
    {displayedTools.map(tool => (
      <a href={`${langPrefix}${tool.url}`} style="text-decoration: none; color: inherit; display: flex;">
        <div class="hand-card" style="padding: 1.5rem; width: 100%; display: flex; flex-direction: column; justify-content: space-between; background: #fff; border: 2px solid var(--fg-pencil); transition: transform 0.2s, box-shadow 0.2s;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 2px 7px; border-radius: 4px;">
                {tool.badge[currentLang] || tool.badge['en']}
              </span>
            </div>
            <h3 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0; line-height: 1.25;">
              {tool.title[currentLang] || tool.title['en']}
            </h3>
            <p class="font-body" style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.5; margin: 0 0 1rem 0;">
              {tool.desc[currentLang] || tool.desc['en']}
            </p>
          </div>
          <div style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.92rem; font-weight: 700; color: var(--accent-blue);">
            <span>{currentUI.launch}</span>
            <span>→</span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <div style="text-align: center; margin-top: 1.75rem;">
    <a href={`${langPrefix}/#featured-favorites`} style="font-size: 0.95rem; font-weight: 700; color: var(--fg-pencil); text-decoration: underline;">
      {currentUI.exploreAll}
    </a>
  </div>
</section>
