  },

  // Logistics & Seating
  {
    title: "Floor Plan & Dance Floor Sizer",
    url: "/seating-clearance-calculator",
    desc: "Calculate dance floor square footage, 60\" table counts, and 60-inch server clearances.",
    badge: "Floor Plan Sizer",
    icon: "🕺",
    category: "logistics"
  },
  {
    title: "Processional Ceremony Builder",
    url: "/wedding-processional-order",
    desc: "Build customized ceremony walking lineups for Christian, Jewish, Catholic, and LGBTQ+ vows.",
    badge: "Ceremony Lineup",
    icon: "⛪",
    category: "logistics"
  },
  {
    title: "Rehearsal Dinner Planner",
    url: "/rehearsal-dinner-planner",
    desc: "Manage rehearsal guest headcounts, out-of-towners, and minute-by-minute schedules.",
    badge: "Rehearsal Timeline",
    icon: "🍷",
    category: "logistics"
  },
  {
    title: "Day-of Timeline Generator",
    url: "/day-of-timeline-generator",
    desc: "Build a minute-by-minute vendor itinerary from morning hair/makeup to grand sparkler exit.",
    badge: "Master Itinerary",
    icon: "⏱️",
    category: "logistics"
  },
  {
    title: "Seating Chart Maker",
    url: "/seating-chart-maker",
    desc: "Drag-and-drop table layouts with instant guest assignment and printable seating cards.",
    badge: "Drag & Drop",
    icon: "🪑",
    category: "logistics"
  }
];

// Clean path comparison
const cleanCurrent = currentPath.replace(/\/$/, "");

// Filter out current tool
let filtered = allTools.filter(t => t.url !== cleanCurrent);

// If category specified or inferrable
if (category && category !== 'all') {
  filtered = filtered.filter(t => t.category === category);
} else {
  // Infer category from current path
  const currentTool = allTools.find(t => t.url === cleanCurrent);
  if (currentTool) {
    const sameCat = filtered.filter(t => t.category === currentTool.category);
    const otherCat = filtered.filter(t => t.category !== currentTool.category);
    filtered = [...sameCat, ...otherCat];
  }
}

// Take top 3 or 4 relevant tools
const displayedTools = filtered.slice(0, 3);
---

<section style="margin: 3.5rem auto; padding: 2.5rem 1.5rem; background: var(--bg-paper); border: 2.5px solid var(--fg-pencil); border-radius: 8px; box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
  <div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>

  <div style="text-align: center; margin-bottom: 2rem;">
    <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">
      Keep Planning
    </span>
    <h2 class="font-heading" style="font-size: clamp(1.6rem, 3.5vw, 2.3rem); color: var(--fg-pencil); margin: 0.25rem 0 0.4rem 0;">
      Recommended Next Steps & Related Tools
    </h2>
    <p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 650px; margin: 0 auto;">
      Every calculation stays 100% free, private in your browser, and instantly exportable to PDF/Word.
    </p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
    {displayedTools.map(tool => (
      <a href={tool.url} style="text-decoration: none; color: inherit; display: flex;">
        <div class="hand-card" style="padding: 1.5rem; width: 100%; display: flex; flex-direction: column; justify-content: space-between; background: #fff; border: 2px solid var(--fg-pencil); transition: transform 0.2s, box-shadow 0.2s;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 2px 7px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            <h3 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0; line-height: 1.25;">
              {tool.title}
            </h3>
            <p class="font-body" style="font-size: 0.92rem; color: var(--text-secondary); line-height: 1.5; margin: 0 0 1rem 0;">
              {tool.desc}
            </p>
          </div>
          <div style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.92rem; font-weight: 700; color: var(--accent-blue);">
            <span>Launch Free Tool</span>
            <span>→</span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <div style="text-align: center; margin-top: 1.75rem;">
    <a href="/new-tools" style="font-size: 0.95rem; font-weight: 700; color: var(--fg-pencil); text-decoration: underline;">
      ✨ Explore All 10 New 2026 Wedding Planning Tools →
    </a>
  </div>
</section>
