export interface Props {
  currentPath?: string;
  category?: 'stationery' | 'food-beverage' | 'budget' | 'logistics' | 'all';
}

const { currentPath = Astro.url.pathname, category } = Astro.props;

// Dynamic Language Detection
const pathname = currentPath.replace(/\/$/, "");
let currentLang = 'en';
if (pathname.startsWith('/es')) currentLang = 'es';
else if (pathname.startsWith('/fr')) currentLang = 'fr';
else if (pathname.startsWith('/de')) currentLang = 'de';
else if (pathname.startsWith('/it')) currentLang = 'it';
else if (pathname.startsWith('/pt')) currentLang = 'pt';

const langPrefix = currentLang === 'en' ? '' : `/${currentLang}`;
const cleanCurrent = pathname.replace(/^\/(es|fr|de|it|pt)/, '');

