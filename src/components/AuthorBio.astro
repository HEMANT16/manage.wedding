---
interface Props {
  authorName?: string;
  authorRole?: string;
  authorUrl?: string;
  publishedDate?: string;
  readTime?: string;
  avatarText?: string;
}

const {
  authorName = "Elena Foster",
  authorRole = "Lead Wedding Financial Strategist & Hospitality Director",
  authorUrl = "/authors/elena-foster",
  publishedDate = "August 2026",
  readTime = "8 min read",
  avatarText = "EF"
} = Astro.props;
---

<div class="author-byline-card hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem 1.5rem; margin: 2.5rem 0; box-shadow: 3px 3px 0px var(--fg-pencil); display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
  <div style="width: 56px; height: 56px; border-radius: 50%; background: #fef3c7; border: 2px solid var(--fg-pencil); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.25rem; color: #92400e; flex-shrink: 0; box-shadow: 2px 2px 0px rgba(0,0,0,0.1);">
    <span>{avatarText}</span>
  </div>
  <div style="flex: 1; min-width: 240px;">
    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.25rem;">
      <span style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; background: #ecfdf5; color: #065f46; border: 1px solid #10b981; padding: 2px 8px; border-radius: 12px;">
        ✓ Verified Expert & Author
      </span>
      <span style="color: var(--text-secondary); font-size: 0.85rem;">•</span>
      <span style="color: var(--text-secondary); font-size: 0.85rem;">{publishedDate}</span>
      <span style="color: var(--text-secondary); font-size: 0.85rem;">•</span>
      <span style="color: var(--text-secondary); font-size: 0.85rem;">{readTime}</span>
    </div>
    <div style="font-size: 1.15rem; font-weight: 800; color: var(--fg-pencil);">
      Written by <a href={authorUrl} style="color: #1d4ed8; text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px;">{authorName}</a>
    </div>
    <p style="margin: 0.2rem 0 0; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.4;">
      {authorRole} • 12+ Years Experience, 400+ Weddings Managed
    </p>
  </div>
  <div>
    <a href={authorUrl} style="background: #f8fafc; color: var(--fg-pencil); text-decoration: none; font-size: 0.85rem; font-weight: 700; padding: 6px 14px; border-radius: 6px; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.35rem; transition: transform 0.1s;">
      <span>View Profile</span>
      <span>&rarr;</span>
    </a>
  </div>
</div>
