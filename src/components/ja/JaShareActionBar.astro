---
interface Props {
  toolTitle?: string;
  defaultText?: string;
  shareUrl?: string;
  hashtags?: string;
  showPrint?: boolean;
  printBtnId?: string;
}

const {
  toolTitle = "結婚式 準備ツール",
  defaultText = "Manage.Wedding 日本版で計算しました！",
  shareUrl = "https://manage.wedding/ja",
  hashtags = "プレ花嫁,結婚式準備,結婚式見積もり,ManageWedding",
  showPrint = true,
  printBtnId = "print-page-btn"
} = Astro.props;
---

<div class="ja-share-action-bar hand-card" style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem 1.5rem; margin: 1.5rem 0; box-shadow: 3px 3px 0px var(--fg-pencil);">
  
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem; border-bottom: 1.5px dashed #cbd5e1; padding-bottom: 0.5rem;">
    <div style="display: flex; align-items: center; gap: 0.4rem; font-weight: 800; font-size: 0.92rem; color: var(--fg-pencil);">
      <span>📤</span>
      <span>計算結果をパートナーや親と共有する</span>
    </div>
    <span style="font-size: 0.75rem; color: var(--text-secondary); background: #f1f5f9; padding: 2px 8px; border-radius: 4px; font-weight: 600;">
      登録不要・1タップ共有
    </span>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.6rem;">
    
    <!-- 1. LINE Share Button -->
    <button 
      type="button" 
      class="ja-share-line-btn" 
      data-url={shareUrl} 
      data-default-text={defaultText}
      style="background: #06C755; color: #ffffff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 10px 8px; font-size: 0.88rem; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; cursor: pointer; box-shadow: 2px 2px 0px var(--fg-pencil); transition: transform 0.05s;"
      onmousedown="this.style.transform='translate(1px, 1px)'" 
      onmouseup="this.style.transform='translate(0, 0)'"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 5.82 2 10.53c0 2.87 1.67 5.4 4.25 6.94-.19.67-.67 2.45-.77 2.82-.12.46.17.45.36.33.15-.1 2.37-1.61 3.33-2.27.9.25 1.85.39 2.83.39 5.52 0 10-3.82 10-8.53S17.52 2 12 2zm-3.6 11.4H6.67a.6.6 0 01-.6-.6V7.8a.6.6 0 011.2 0v4.4h1.13a.6.6 0 010 1.2zm2.4 0a.6.6 0 01-.6-.6V7.8a.6.6 0 011.2 0v5a.6.6 0 01-.6.6zm4.8 0a.6.6 0 01-.42-.18L13.1 10.3v2.5a.6.6 0 01-1.2 0V7.8a.6.6 0 01.42-.18.6.6 0 01.42.18l2.08 2.92V7.8a.6.6 0 011.2 0v5a.6.6 0 01-.42.6zm3.6-3.8a.6.6 0 010 1.2h-1.6v1.4h1.6a.6.6 0 010 1.2h-2.2a.6.6 0 01-.6-.6V7.8a.6.6 0 01.6-.6h2.2a.6.6 0 010 1.2h-1.6v1.2h1.6z"/>
      </svg>
      <span>LINEで送る</span>
    </button>

    <!-- 2. Copy Text Button -->
    <button 
      type="button" 
      class="ja-copy-text-btn" 
      data-url={shareUrl} 
      data-default-text={defaultText}
      style="background: #f8fafc; color: var(--fg-pencil); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 10px 8px; font-size: 0.88rem; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; cursor: pointer; box-shadow: 2px 2px 0px var(--fg-pencil); transition: transform 0.05s;"
      onmousedown="this.style.transform='translate(1px, 1px)'" 
      onmouseup="this.style.transform='translate(0, 0)'"
    >
      <span>📋</span>
      <span class="copy-label">テキストコピー</span>
    </button>

    <!-- 3. X (Twitter) Share Button -->
    <button 
      type="button" 
      class="ja-share-x-btn" 
      data-url={shareUrl} 
      data-hashtags={hashtags}
      data-default-text={defaultText}
      style="background: #000000; color: #ffffff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 10px 8px; font-size: 0.88rem; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; cursor: pointer; box-shadow: 2px 2px 0px var(--fg-pencil); transition: transform 0.05s;"
      onmousedown="this.style.transform='translate(1px, 1px)'" 
      onmouseup="this.style.transform='translate(0, 0)'"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      <span>Xで共有</span>
    </button>

    {showPrint && (
      <button 
        type="button" 
        id={printBtnId}
        class="ja-print-btn" 
        style="background: #fefce8; color: #854d0e; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 10px 8px; font-size: 0.88rem; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; cursor: pointer; box-shadow: 2px 2px 0px var(--fg-pencil); transition: transform 0.05s;"
        onmousedown="this.style.transform='translate(1px, 1px)'" 
        onmouseup="this.style.transform='translate(0, 0)'"
        onclick="window.print()"
      >
        <span>📄</span>
        <span>A4印刷 / PDF</span>
      </button>
    )}

  </div>

  <!-- Toast Notification Container -->
  <div class="ja-copy-toast" style="display: none; background: #059669; color: #ffffff; font-size: 0.82rem; font-weight: 700; text-align: center; padding: 6px 12px; border-radius: 4px; margin-top: 0.6rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
    ✓ LINE・メモ用テキストをクリップボードにコピーしました！
  </div>

</div>

<script is:inline>
  // Global helper function for Japanese dynamic share text formatter
  function setupJaShareBar() {
    document.querySelectorAll('.ja-share-action-bar').forEach(bar => {
      const lineBtn = bar.querySelector('.ja-share-line-btn');
      const copyBtn = bar.querySelector('.ja-copy-text-btn');
      const xBtn = bar.querySelector('.ja-share-x-btn');
      const toast = bar.querySelector('.ja-copy-toast');
      const copyLabel = bar.querySelector('.copy-label');

      function getShareMessage() {
        if (typeof window.getJaLiveShareText === 'function') {
          try {
            return window.getJaLiveShareText();
          } catch(e) {
            console.error(e);
          }
        }
        const defaultText = lineBtn ? lineBtn.getAttribute('data-default-text') : '';
        const url = lineBtn ? lineBtn.getAttribute('data-url') : window.location.href;
        return defaultText + '\n' + url;
      }

      if (lineBtn) {
        lineBtn.onclick = function() {
          const msg = getShareMessage();
          const lineUrl = 'https://line.me/R/msg/text/?' + encodeURIComponent(msg);
          window.open(lineUrl, '_blank');
        };
      }

      if (copyBtn) {
        copyBtn.onclick = function() {
          const msg = getShareMessage();
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(msg).then(() => {
              if (toast) {
                toast.style.display = 'block';
                setTimeout(() => { toast.style.display = 'none'; }, 3000);
              }
              if (copyLabel) copyLabel.textContent = 'コピー完了！';
              setTimeout(() => { if (copyLabel) copyLabel.textContent = 'テキストコピー'; }, 3000);
            });
          } else {
            const ta = document.createElement('textarea');
            ta.value = msg;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            if (toast) {
              toast.style.display = 'block';
              setTimeout(() => { toast.style.display = 'none'; }, 3000);
            }
          }
        };
      }

      if (xBtn) {
        xBtn.onclick = function() {
          const msg = getShareMessage();
          const url = xBtn.getAttribute('data-url') || window.location.href;
          const hashtags = xBtn.getAttribute('data-hashtags') || 'プレ花嫁,結婚式準備';
          const xUrl = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(msg) + '&hashtags=' + encodeURIComponent(hashtags);
          window.open(xUrl, '_blank');
        };
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupJaShareBar);
  } else {
    setupJaShareBar();
  }
</script>
