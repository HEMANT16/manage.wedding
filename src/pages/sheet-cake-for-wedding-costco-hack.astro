---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Sheet Cake for Wedding: The Cost-Cutting Kitchen Hack (Costco Servings Breakdown)",
      "description": "Comprehensive 2026 guide to the wedding kitchen sheet cake hack. Discover Costco half-sheet cake dimensions, 48 vs 72 portion slicing grids, warehouse comparison metrics, cake cutting fee math, and step-by-step banquet staff coordination.",
      "datePublished": "2026-08-18T00:00:00+00:00",
      "dateModified": "2026-08-30T00:00:00+00:00",
      "author": {
        "@type": "Person",
        "name": "Elena Foster",
        "jobTitle": "Lead Wedding Financial Strategist & Hospitality Director",
        "description": "35-year-old mother of two, veteran hospitality director with 12+ years managing 400+ luxury estate and ballroom weddings.",
        "worksFor": {
          "@type": "Organization",
          "name": "Manage.Wedding",
          "url": "https://manage.wedding/authors/elena-foster"
        }
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding",
        "logo": {
          "@type": "ImageObject",
          "url": "https://manage.wedding/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://manage.wedding/sheet-cake-for-wedding-costco-hack"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the wedding kitchen sheet cake hack?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The kitchen sheet cake strategy pairs a small 2-tier decorative display cutting cake (30–40 servings) for ceremonial cake-cutting photos with flat commercial half-sheet cakes ($24.99 at Costco or $45–$65 at local bakeries) sliced discreetly in the banquet kitchen. This cuts total wedding dessert costs by 60% to 75% without guests noticing."
          }
        },
        {
          "@type": "Question",
          "name": "How many servings are in a Costco half-sheet cake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard Costco half-sheet cake ($24.99) yields 48 generous party portions (2x2 inches) or up to 64 to 72 standard catering wedding portions (1x2x4 inches) when cut with a professional catering grid."
          }
        },
        {
          "@type": "Question",
          "name": "How many sheet cakes do I need for 100, 150, or 200 wedding guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For 100 guests: 1 small display cake (30 servings) + 1 Costco half-sheet (48–64 servings). For 150 guests: 1 small display cake (36 servings) + 2 Costco half-sheets (96–128 servings). For 200 guests: 1 small display cake (40 servings) + 3 Costco half-sheets (144–192 servings)."
          }
        },
        {
          "@type": "Question",
          "name": "How far in advance do you need to order a Costco sheet cake for a wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costco requires order form submission at their bakery department kiosk 24 to 48 hours in advance. For weddings, planners recommend submitting the order 7 to 10 days in advance and confirming with the bakery manager 48 hours prior to pickup."
          }
        },
        {
          "@type": "Question",
          "name": "Can you order a plain white undecorated sheet cake from Costco?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. On the paper order kiosk form, select 'No Design / Plain' or write 'Plain white frosting only, no piping, no writing'. This provides a clean blank canvas for catering servers to plate with fresh berries or coulis."
          }
        },
        {
          "@type": "Question",
          "name": "What is a venue cake cutting fee, and will it ruin the Costco savings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A cake cutting fee ranges from $1.50 to $4.50 per slice. If your venue charges $3.00/slice to plate outside dessert, cutting 150 slices costs $450 in service fees. Even with a $450 cutting fee, pairing Costco sheets ($50) with a display cake ($250) costs $750 total, saving over $500 compared to a $1,300 fully tiered custom cake."
          }
        },
        {
          "@type": "Question",
          "name": "What flavors of half-sheet cakes does Costco offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costco offers two signature half-sheet cake combinations: (1) White Vanilla Sponge filled with Vanilla Cheesecake Mousse and iced in White Buttercream, and (2) Chocolate Sponge filled with Chocolate Fudge Mousse and iced in Chocolate Buttercream."
          }
        },
        {
          "@type": "Question",
          "name": "How do you transport and store Costco sheet cakes before the reception?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Costco half-sheet box measures 15x19 inches and weighs 9.5 lbs. Transport it flat on the vehicle floorboard or trunk on a non-slip mat with air conditioning running. Upon arrival, transfer directly into the venue walk-in commercial refrigerator at 38°F–40°F until 45 minutes before dessert service."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Sheet Cake for Wedding: The Cost-Cutting Kitchen Hack (Costco Servings Breakdown) | Manage.Wedding"
  description="How to save 65% to 75% on wedding cake costs by pairing a small ceremonial display cake with Costco or bakery sheet cakes cut discreetly in the catering kitchen."
  schema={schema}
>
  <main class="container" style="padding-top: 2rem; padding-bottom: 4rem; max-width: 960px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
        { name: "Kitchen Sheet Cake Hack" }
      ]}
    />

    <!-- Header Section -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #fef3c7; color: #92400e; padding: 4px 14px; border-radius: 20px; border: 1.5px solid #d97706; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <span>🍰</span>
        <span>Catering Financial Strategy & Cost Breakdown</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2rem, 3.8vw, 2.9rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
        Sheet Cake for Wedding: The Cost-Cutting Kitchen Hack <span style="color: #b45309; font-style: italic;">(Costco Servings & Slicing Blueprint)</span>
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600; flex-wrap: wrap;">
        <span>Published: August 2026</span>
        <span>•</span>
        <span>10 min read</span>
        <span>•</span>
        <span>By <a href="/authors/elena-foster" style="color: #1d4ed8; text-decoration: underline; text-underline-offset: 3px; font-weight: 700;">Elena Foster</a>, Lead Wedding Financial Strategist</span>
      </div>
    </header>

    <!-- First Paragraph Hook (Elena Persona) -->
    <p class="font-body" style="font-size: 1.15rem; line-height: 1.8; color: var(--fg-pencil); margin-bottom: 1.75rem;">
      Here is the unvarnished financial reality that boutique wedding bakeries rarely disclose: a custom 4-tier wedding cake for 150 guests routinely invoices between <strong>$1,100 and $1,500</strong>, but over 60% of that cost has nothing to do with ingredients or flavor. It covers structural internal PVC doweling, cake drums, multi-day tier chilling space, and the sheer cardiac stress of transporting a top-heavy 40-pound confection across town. 
    </p>
    <p class="font-body" style="font-size: 1.12rem; line-height: 1.8; color: var(--fg-pencil); margin-bottom: 2rem;">
      As a hospitality coordinator of 12+ years who has managed over 400 luxury weddings, I tell every budget-conscious couple the exact same thing: <strong>nobody at table 9 knows or cares whether their slice came from an $8-per-slice centerpiece tower or a $25 half-sheet pan in the banquet kitchen.</strong> When plated with a fresh raspberry and mint garnish, the dining experience is completely indistinguishable.
    </p>

    <!-- Visual Sketch Image 1: Display Cutting Cake -->
    <div style="margin: 2rem 0 2.5rem; text-align: center;">
      <div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 12px; padding: 1rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: inline-block; max-width: 100%;">
        <img 
          src="/images/wedding_cake_sketch.webp" 
          alt="Two-tier textured buttercream wedding cutting cake displayed on decorative pedestal for ceremonial photo cut" 
          style="max-width: 100%; height: auto; border-radius: 6px; display: block; max-height: 380px; margin: 0 auto;"
          loading="lazy"
          width="600"
          height="380"
        />
        <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.75rem; font-style: italic; font-weight: 600;">
          Figure 1: A 2-tier decorative display cake (30–40 servings) provides the focal point for photography while kitchen sheet cakes feed the room.
        </p>
      </div>
    </div>

    <!-- Interactive Tool Callout Hero -->
    <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 1.5rem 2rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
          Calculate Sheet Cake vs Tiered Cake Quantities
        </h3>
        <p class="font-body" style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
          Compare round tier dimensions, square sheet pans, cutting grids, and price-per-slice math for your exact guest count.
        </p>
      </div>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/cake-serving-calculator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 10px 18px; border-radius: 6px; font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.4rem;">
          <span>Cake Serving Sizer</span>
          <span>&rarr;</span>
        </a>
        <a href="/cake-pricing-calculator" style="background: #f8fafc; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 10px 18px; border-radius: 6px; font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.4rem;">
          <span>Price Per Slice Calc</span>
        </a>
      </div>
    </div>

    <!-- Main Content Body -->
    <article class="font-body" style="font-size: 1.1rem; line-height: 1.75; color: var(--fg-pencil);">
      
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2rem 0 0.75rem;">
        What Is the Wedding Kitchen Sheet Cake Hack?
      </h2>

      <!-- Direct Answer Box (AI Overview Magnet) -->
      <div style="background: #f0fdf4; border: 2px solid #16a34a; border-radius: 8px; padding: 1.25rem 1.5rem; margin: 1rem 0 1.75rem; box-shadow: 3px 3px 0px #16a34a;">
        <div style="font-size: 0.82rem; font-weight: 800; color: #15803d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.3rem;">
          🎯 Direct Answer: The Kitchen Sheet Cake Strategy
        </div>
        <p class="font-body" style="font-size: 1.05rem; color: #14532d; font-weight: 600; line-height: 1.5; margin: 0;">
          The kitchen sheet cake strategy pairs a small 2-tier decorative display cake (30–40 servings) for ceremonial photos with commercial flat sheet cakes ($24.99–$45 each) sliced discreetly in the banquet kitchen. This reduces total wedding cake expenditures by 65% to 77% without guests ever knowing the difference.
        </p>
      </div>

      <p>
        When you commission an artisan bakery to construct a stacked 4-tier or 5-tier cake, you aren't paying $8.00 to $12.00 a slice for flour, butter, and sugar. You are paying for <strong>food-safe internal support dowels, Masonite cake drums, hours of delicate level-stacking labor, commercial walk-in refrigeration space, and high-risk refrigerated van transit</strong>.
      </p>
      <p>
        Commercial sheet cakes, by contrast, require zero architectural scaffolding and bake flat in a fraction of the time. By purchasing un-tiered sheet cakes from your wedding baker—or wholesale half-sheets from Costco or Sam's Club—you eliminate the structural markup entirely while serving fresh, moist dessert to every table.
      </p>

      <!-- Real Invoice Comparison Table -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Real Invoice Comparison: 150-Guest Wedding Cake Scenarios
      </h2>
      <p>
        Let's compare the <strong>real out-of-pocket invoice</strong> for a 150-person reception across three standard catering configurations:
      </p>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.92rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Cake Setup Strategy</th>
              <th style="padding: 12px 14px; font-weight: 800;">Display Cake Setup</th>
              <th style="padding: 12px 14px; font-weight: 800;">Kitchen Sheet Cake</th>
              <th style="padding: 12px 14px; font-weight: 800; text-align: center;">Total Servings</th>
              <th style="padding: 12px 14px; font-weight: 800; text-align: right;">Total Out-of-Pocket</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Option 1: Full 4-Tier Artisanal Tiered Cake</td>
              <td style="padding: 12px 14px;">4 Tiers (6"+8"+10"+12")</td>
              <td style="padding: 12px 14px; color: #64748b;">None (100% on display)</td>
              <td style="padding: 12px 14px; font-weight: 600; text-align: center;">150 portions</td>
              <td style="padding: 12px 14px; font-weight: 800; color: var(--accent-red); text-align: right;">$1,275 ($8.50/slice)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700; color: #0284c7;">Option 2: 2-Tier Display + Bakery Sheet Cakes</td>
              <td style="padding: 12px 14px;">2 Tiers (6"+8", 38 servings)</td>
              <td style="padding: 12px 14px;">2 Bakery Half-Sheets (112 serv.)</td>
              <td style="padding: 12px 14px; font-weight: 600; text-align: center;">150 portions</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a; text-align: right;">$590 (Save $685)</td>
            </tr>
            <tr style="background: #f0fdf4;">
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">Option 3: 2-Tier Display + Costco Half-Sheets</td>
              <td style="padding: 12px 14px;">2 Tiers (6"+8", 38 servings)</td>
              <td style="padding: 12px 14px;">2 Costco Sheets ($24.99 ea)</td>
              <td style="padding: 12px 14px; font-weight: 600; text-align: center;">153 portions</td>
              <td style="padding: 12px 14px; font-weight: 800; color: #16a34a; text-align: right;">$295 (Save $980 — 77% Off!)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Warehouse Metrics Comparison Table -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Costco vs. Sam's Club vs. BJ's vs. Bakery Sheet Cake Metrics
      </h2>
      <p>
        If you decide to utilize a wholesale warehouse sheet cake, here is how the primary national suppliers compare in dimensions, weight, price, and portion yields:
      </p>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.90rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 10px 12px; font-weight: 800;">Retailer / Source</th>
              <th style="padding: 10px 12px; font-weight: 800;">Cake Dimensions</th>
              <th style="padding: 10px 12px; font-weight: 800;">Approx. Weight</th>
              <th style="padding: 10px 12px; font-weight: 800;">Retail Price</th>
              <th style="padding: 10px 12px; font-weight: 800; text-align: center;">Party Yield (2"×2")</th>
              <th style="padding: 10px 12px; font-weight: 800; text-align: center;">Wedding Yield (1"×2")</th>
              <th style="padding: 10px 12px; font-weight: 800; text-align: right;">Cost Per Slice</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f0fdf4;">
              <td style="padding: 10px 12px; font-weight: 700; color: #16a34a;">Costco Wholesale</td>
              <td style="padding: 10px 12px;">12" × 16" (Half Sheet)</td>
              <td style="padding: 10px 12px;">9.5 lbs (4.3 kg)</td>
              <td style="padding: 10px 12px; font-weight: 700;">$24.99</td>
              <td style="padding: 10px 12px; text-align: center; font-weight: 600;">48 slices</td>
              <td style="padding: 10px 12px; text-align: center; font-weight: 700; color: #16a34a;">64 – 72 slices</td>
              <td style="padding: 10px 12px; text-align: right; font-weight: 800; color: #16a34a;">$0.35 – $0.52</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 10px 12px; font-weight: 700; color: #0284c7;">Sam's Club</td>
              <td style="padding: 10px 12px;">12" × 16" (Half Sheet)</td>
              <td style="padding: 10px 12px;">8.5 lbs (3.8 kg)</td>
              <td style="padding: 10px 12px; font-weight: 700;">$22.98</td>
              <td style="padding: 10px 12px; text-align: center; font-weight: 600;">48 slices</td>
              <td style="padding: 10px 12px; text-align: center; font-weight: 700; color: #0284c7;">64 – 70 slices</td>
              <td style="padding: 10px 12px; text-align: right; font-weight: 800; color: #0284c7;">$0.33 – $0.48</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #faf8f5;">
              <td style="padding: 10px 12px; font-weight: 700; color: #b45309;">BJ's Wholesale</td>
              <td style="padding: 10px 12px;">12" × 16" (Half Sheet)</td>
              <td style="padding: 10px 12px;">8.0 lbs (3.6 kg)</td>
              <td style="padding: 10px 12px; font-weight: 700;">$26.99</td>
              <td style="padding: 10px 12px; text-align: center; font-weight: 600;">48 slices</td>
              <td style="padding: 10px 12px; text-align: center; font-weight: 700; color: #b45309;">64 – 70 slices</td>
              <td style="padding: 10px 12px; text-align: right; font-weight: 800; color: #b45309;">$0.39 – $0.56</td>
            </tr>
            <tr>
              <td style="padding: 10px 12px; font-weight: 700; color: var(--fg-pencil);">Boutique Wedding Baker</td>
              <td style="padding: 10px 12px;">12" × 16" (Half Sheet)</td>
              <td style="padding: 10px 12px;">9.0 lbs (4.1 kg)</td>
              <td style="padding: 10px 12px; font-weight: 700;">$85.00 – $140.00</td>
              <td style="padding: 10px 12px; text-align: center; font-weight: 600;">48 slices</td>
              <td style="padding: 10px 12px; text-align: center; font-weight: 700; color: var(--fg-pencil);">64 – 72 slices</td>
              <td style="padding: 10px 12px; text-align: right; font-weight: 800; color: var(--fg-pencil);">$1.35 – $2.18</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Slicing Blueprint: 48 vs 72 portions -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The Slicing Blueprint: 48 Party Portions vs. 72 Catering Portions
      </h2>
      <p>
        How you instruct your banquet servers to slice a 12" × 16" half-sheet determines whether you get 48 or 72 portions:
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin: 1.5rem 0;">
        <div style="background: #f8fafc; border: 2px solid #cbd5e1; border-radius: 8px; padding: 1.5rem;">
          <strong style="color: #0f172a; font-size: 1.15rem; display: block; margin-bottom: 0.5rem;">🎂 Method A: Standard Party Grid (48 Slices)</strong>
          <ul style="font-size: 0.95rem; color: #475569; line-height: 1.7; margin-left: 1.25rem;">
            <li><strong>Portion Dimensions:</strong> 2 inches × 2 inches × 4 inches.</li>
            <li><strong>Grid Pattern:</strong> 6 cuts across the 12" side × 8 cuts along the 16" side.</li>
            <li><strong>Best For:</strong> Dessert stations where cake is the primary sweet, or receptions without late-night snacks.</li>
          </ul>
        </div>
        <div style="background: #f0fdf4; border: 2px solid #a7f3d0; border-radius: 8px; padding: 1.5rem;">
          <strong style="color: #166534; font-size: 1.15rem; display: block; margin-bottom: 0.5rem;">💎 Method B: Formal Catering Grid (72 Slices)</strong>
          <ul style="font-size: 0.95rem; color: #14532d; line-height: 1.7; margin-left: 1.25rem;">
            <li><strong>Portion Dimensions:</strong> 1 inch × 2 inches × 4 inches (standard wedding portion).</li>
            <li><strong>Grid Pattern:</strong> 6 cuts across the 12" side × 12 cuts along the 16" side.</li>
            <li><strong>Best For:</strong> Plated multi-course dinners where guests are already full, or weddings featuring a dessert bar.</li>
          </ul>
        </div>
      </div>

      <!-- Visual Sketch Image 2: Cake Cutting & Slicing Diagram -->
      <div style="margin: 2.5rem 0; text-align: center;">
        <div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 12px; padding: 1rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: inline-block; max-width: 100%;">
          <img 
            src="/images/cake_cutting_sketch.webp" 
            alt="Hand-drawn diagram of wedding cake ceremonial cutting and sheet cake portioning grid for banquet servers" 
            style="max-width: 100%; height: auto; border-radius: 6px; display: block; max-height: 380px; margin: 0 auto;"
            loading="lazy"
            width="600"
            height="380"
          />
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.75rem; font-style: italic; font-weight: 600;">
            Figure 2: Professional cake portioning guidelines ensure uniform 1" × 2" presentation across all guest banquet tables.
          </p>
        </div>
      </div>

      <!-- Costco Order Form Step-by-Step Blueprint -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        How to Fill Out the Costco Cake Order Form for a Wedding
      </h2>
      <p>
        Costco bakeries do not take orders over the phone or online; you must fill out a physical paper order form at the bakery kiosk inside the warehouse. Follow these exact steps:
      </p>

      <div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; margin: 1.5rem 0;">
        <ol style="padding-left: 1.25rem; line-height: 1.8; margin: 0;">
          <li style="margin-bottom: 0.65rem;">
            <strong>Flavor Selection:</strong> Choose between <em>White Vanilla Cake filled with Vanilla Cheesecake Mousse</em> (best pairing for fruit garnishes) or <em>Chocolate Cake filled with Chocolate Mousse</em>.
          </li>
          <li style="margin-bottom: 0.65rem;">
            <strong>Design Selection:</strong> Check the box for <strong>"Score Cake / Plain"</strong> or <strong>"No Design"</strong>.
          </li>
          <li style="margin-bottom: 0.65rem;">
            <strong>Special Instructions Box:</strong> Write clearly in uppercase: <code>"PLAIN WHITE BUTTERCREAM ONLY. NO PIPING, NO WRITING, NO COLORED ICING."</code>
          </li>
          <li style="margin-bottom: 0.65rem;">
            <strong>Pickup Timing:</strong> Schedule pickup on the <strong>morning of your wedding day</strong> or the <strong>evening before</strong> (keep refrigerated overnight).
          </li>
        </ol>
      </div>

      <!-- Planner Red Flag: Cutting Fee -->
