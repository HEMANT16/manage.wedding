---
import Layout from '../layouts/Layout.astro';

const title = "Wedding Budget & Financial Planning Calculators (Free & Private)";
const description = "Free wedding budget calculators to allocate total spend, audit venue hidden fees (++), split expenses among families, and compute bachelorette costs.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/budget/#collection",
      "name": "Wedding Budget & Finance Calculators",
      "url": "https://manage.wedding/budget",
      "description": "Comprehensive suite of wedding budgeting tools, venue hidden fee calculators, family contribution splitters, and gratuity estimators.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Master Budget Calculator", "url": "https://manage.wedding/master-budget-calculator" },
        { "@type": "WebApplication", "name": "Venue Hidden Fee & True Cost", "url": "https://manage.wedding/wedding-venue-cost-calculator" },
        { "@type": "WebApplication", "name": "Who Pays for What? Splitter", "url": "https://manage.wedding/who-pays-for-what-wedding" },
        { "@type": "WebApplication", "name": "Bachelorette Budget Splitter", "url": "https://manage.wedding/bachelorette-budget-calculator" },
        { "@type": "WebApplication", "name": "Vendor Tipping Calculator", "url": "https://manage.wedding/vendor-tipping-calculator" },
        { "@type": "WebApplication", "name": "Honeymoon Budget Estimator", "url": "https://manage.wedding/honeymoon-budget-estimator" },
        { "@type": "WebApplication", "name": "Wedding Loan Calculator", "url": "https://manage.wedding/wedding-loan-calculator" },
        { "@type": "WebApplication", "name": "Wedding Gift Cash Calculator", "url": "https://manage.wedding/gift-cash-calculator" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the average wedding budget allocation formula?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The verified wedding industry standard allocation is: 45-50% for Reception (Venue, Food & Beverage), 12-15% for Photography & Videography, 10% for Attire & Beauty, 8-10% for Music/Entertainment, 8-10% for Flowers & Decor, 3-5% for Stationery & Postage, and 5% for an unexpected Emergency Buffer."
          }
        },
        {
          "@type": "Question",
          "name": "What are venue plus-plus (++) service fees?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plus-plus (++) refers to mandatory venue service charges (typically 20-24%) and state/local sales tax (6-10%) applied on top of base catering and room rental quotes. In most jurisdictions, sales tax is charged on the combined subtotal of food plus the service fee, adding 30-35% to original base quotes."
          }
        },
        {
          "@type": "Question",
          "name": "How much should you tip wedding vendors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For catering captains and waitstaff, $20-$50 per server (if not included in contract). For bartenders, 15-20% of total bar tab or $50-$100 per bartender. For hair & makeup artists, 15-25%. For DJs, $50-$150. For delivery drivers, $10-$20 per person."
          }
        }
      ]
    }
  ]
};

const budgetTools = [
  {
    title: "Master Budget Allocator",
    url: "/master-budget-calculator",
    icon: "💰",
    badge: "Industry Ratios",
    desc: "Input your total budget to get an automated percentage allocation across venue, catering, photo, and florals with emergency buffers.",
    tags: ["Percentage Math", "Buffer Fund", "Spend Tracker"]
  },
  {
    title: "Venue Hidden Fee & True Cost (++)",
    url: "/wedding-venue-cost-calculator",
    icon: "🏰",
    badge: "Plus-Plus Math",
    desc: "Calculate the real total cost of a venue beyond the base rental. Factors in Food & Beverage minimums, 22% ++ service fees, and taxes.",
    tags: ["F&B Minimums", "Tax on Service Fee", "Out-of-Pocket"]
  },
  {
    title: "Who Pays for What? Splitter",
    url: "/who-pays-for-what-wedding",
    icon: "👥",
    badge: "1950s vs Modern",
    desc: "Compare 1950s traditional protocol against modern 3-way family splits. Assign ownership for 20+ line items with printable agreements.",
    tags: ["Blended Families", "Fair Splits", "Agreement PDF"]
  },
  {
    title: "Bachelorette Budget Splitter",
    url: "/bachelorette-budget-calculator",
    icon: "🍸",
    badge: "Cover the Bride",
    desc: "Split Airbnb, dinners, and group activities evenly among bridesmaids while covering the bride's share. Generates Venmo text requests.",
    tags: ["N-1 Split", "Venmo Copy", "Activity Math"]
  },
  {
    title: "Vendor Tipping Calculator",
    url: "/vendor-tipping-calculator",
    icon: "💵",
    badge: "Gratuity Norms",
    desc: "Eliminate day-of guesswork: calculate standard gratuities and cash envelope breakdowns for every vendor.",
    tags: ["Cash Envelopes", "Gratuity Rules", "Day-Of Checklist"]
  },
  {
    title: "Honeymoon Budget Estimator",
    url: "/honeymoon-budget-estimator",
    icon: "✈️",
    badge: "Travel Planner",
    desc: "Estimate total honeymoon costs for flights, luxury accommodations, dining, excursions, and travel insurance.",
    tags: ["Resort Costs", "Daily Dining", "Flight Buffer"]
  },
  {
    title: "Wedding Loan Calculator",
    url: "/wedding-loan-calculator",
    icon: "🏦",
    badge: "Repayment Math",
    desc: "Calculate exact monthly repayments, total interest charges, and payoff timelines based on APR and term length.",
    tags: ["APR Math", "Monthly Payment", "Interest Cost"]
  },
  {
    title: "Wedding Gift Cash Calculator",
    url: "/gift-cash-calculator",
    icon: "🎁",
    badge: "For Guests",
    desc: "Not sure how much cash or registry gift to give? Calculate the right amount based on relationship, travel costs, and plus-ones.",
    tags: ["Guest Etiquette", "Cash Gift Formula", "Cover My Plate"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Financial Planning Hub</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Wedding <span class="accent-italic">Budget & Finance</span> Calculators
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Take total control of your wedding finances. 100% free, private in-browser calculators to allocate spend, uncover venue plus-plus (++) surcharges, and split costs fairly.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Explore Categories:</span>
      <a href="/budget" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">💰 Budget (Active)</a>
      <a href="/dining" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Dining & Bar</a>
      <a href="/guests" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">👥 Guests & Logistics</a>
      <a href="/stationery" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💌 Stationery & Creative</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {budgetTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
            Launch Calculator →
          </a>
        </div>
      ))}
    </div>

    <!-- In-Depth Budgeting Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Financial Blueprint</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          How to Master Your Wedding Budget
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Strategic rules to avoid hidden fees, prevent debt, and allocate your funds with complete confidence.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. The 50/15/10/10/10/5 Industry Standard Allocation Rule
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Rather than guessing how much to spend on each category, use proven percentage benchmarks verified across thousands of weddings:
        </p>
        
        <div style="overflow-x: auto; margin-top: 1rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Category</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Percentage</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">What It Includes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Venue & Catering</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 700;">45% – 50%</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">Site fee, open bar, plated dinner/buffet, rentals, service fees.</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Photo & Video</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">12% – 15%</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">Lead photographer, second shooter, highlight video, engagement shoot.</td>
              </tr>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Attire & Beauty</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">8% – 10%</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">Dress, suit/tux, veil, alterations, hair & makeup trials.</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Music & Entertainment</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">8% – 10%</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">Live band or DJ/MC, ceremony sound setup, dance lighting.</td>
              </tr>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Florals & Decor</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">8% – 10%</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">Bouquets, boutonnieres, centerpieces, arch installation.</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Emergency Buffer Fund</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-blue); font-weight: 700;">5%</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">Last-minute RSVP surges, weather tents, vendor meals, tips.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          2. The "Plus-Plus" (++) Trap Explained
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          When a venue quotes $150 per person, your true out-of-pocket cost is typically closer to <strong>$200 per person</strong> due to "plus-plus" (++). The first "+" is a mandatory 20–24% administrative service charge, and the second "+" is state/local sales tax (6–10%). Crucially, in most US states, sales tax is calculated on the total <em>after</em> the service charge is added!
        </p>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Frequently Asked Questions
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              What is the average wedding budget allocation formula?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              The verified wedding industry standard allocation is: 45-50% for Reception (Venue, Food & Beverage), 12-15% for Photography & Videography, 10% for Attire & Beauty, 8-10% for Music/Entertainment, 8-10% for Flowers & Decor, 3-5% for Stationery & Postage, and 5% for an unexpected Emergency Buffer.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              What are venue plus-plus (++) service fees?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Plus-plus (++) refers to mandatory venue service charges (typically 20-24%) and state/local sales tax (6-10%) applied on top of base catering and room rental quotes. In most jurisdictions, sales tax is charged on the combined subtotal of food plus the service fee, adding 30-35% to original base quotes.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              How much should you tip wedding vendors?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              For catering captains and waitstaff, $20-$50 per server (if not included in contract). For bartenders, 15-20% of total bar tab or $50-$100 per bartender. For hair & makeup artists, 15-25%. For DJs, $50-$150. For delivery drivers, $10-$20 per person.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
