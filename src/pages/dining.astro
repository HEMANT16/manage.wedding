---
import Layout from '../layouts/Layout.astro';

const title = "Wedding Bar, Food & Dining Calculators (Free & Printable)";
const description = "Free wedding bar calculators, open bar drink estimators, liquor handle sizers, cake pricing calculators, and printable dinner menu makers.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/dining/#collection",
      "name": "Wedding Bar, Food & Dining Calculators",
      "url": "https://manage.wedding/dining",
      "description": "Comprehensive suite of wedding open bar calculators, cake tier sizing tools, catering cost estimators, and printable reception menu makers.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Wedding Drink Calculator", "url": "https://manage.wedding/wedding-drink-calculator" },
        { "@type": "WebApplication", "name": "Wedding Liquor & Spirits Sizer", "url": "https://manage.wedding/liquor-wedding-calculator" },
        { "@type": "WebApplication", "name": "Cake Pricing Calculator", "url": "https://manage.wedding/cake-pricing-calculator" },
        { "@type": "WebApplication", "name": "Cake Serving Calculator", "url": "https://manage.wedding/cake-serving-calculator" },
        { "@type": "WebApplication", "name": "Reception Menu Maker", "url": "https://manage.wedding/reception-menu-maker" },
        { "@type": "WebApplication", "name": "Catering Cost Estimator", "url": "https://manage.wedding/catering-cost-estimator" },
        { "@type": "WebApplication", "name": "Dessert Table, Candy Bar & Cookie Sizer", "url": "https://manage.wedding/wedding-dessert-table-calculator" },
        { "@type": "WebApplication", "name": "Floral Cost Estimator", "url": "https://manage.wedding/floral-cost-estimator" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many drinks per person should you plan for a wedding reception?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The industry standard formula is 2 drinks per guest during Cocktail Hour (Hour 1), plus 1 drink per guest for every subsequent hour of the reception. For a 5-hour reception with 150 guests, plan for approximately 900 total servings."
          }
        },
        {
          "@type": "Question",
          "name": "How many 750ml bottles of wine and liquor do you need for 100 guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a standard 4-hour open bar with 100 guests (500 total drinks): plan for roughly 50 bottles of wine (25 red, 25 white/rosé), 150-200 beers, and 12-14 bottles of 750ml spirits (or 6-7 large 1.75L handle bottles)."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a custom wedding cake cost per slice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Artisanal custom wedding cakes range from $4.50 to $12.00+ per slice depending on intricate fondant detailing, sugar flowers, labor hours, and delivery setup fees."
          }
        }
      ]
    }
  ]
};

const diningTools = [
  {
    title: "Open Bar Drink Calculator",
    url: "/wedding-drink-calculator",
    icon: "🍾",
    badge: "Most Popular",
    desc: "Calculate exact bottle counts for wine, beer, liquor, and mixers for open and soft bars based on guest count and hours.",
    tags: ["Open Bar", "1-Click PDF", "Shopping List"]
  },
  {
    title: "Wedding Liquor & Spirits Sizer",
    url: "/liquor-wedding-calculator",
    icon: "🍸",
    badge: "Handles vs 750ml",
    desc: "Designed for full cocktail-heavy open bars. Optimize spirit ratios, handle bottles (Costco savings), and estimated retail costs.",
    tags: ["Cocktail Ratios", "750ml vs 1.75L", "Retail Costs"]
  },
  {
    title: "Reception Menu Maker",
    url: "/reception-menu-maker",
    icon: "📜",
    badge: "Vector PDF",
    desc: "Design luxury 4x9 DL and 5x7 table menus with elegant serif and script fonts, botanical borders, and dietary tags.",
    tags: ["Custom Fonts", "Printable PDF", "Dietary Tags"]
  },
  {
    title: "Wedding Cake Pricing Sizer",
    url: "/cake-pricing-calculator",
    icon: "🎂",
    badge: "Price Per Slice",
    desc: "For bakers & couples: compute ingredient costs, labor markups, price per slice, and printable client quotes.",
    tags: ["Baker Math", "Price Per Slice", "PDF Quotes"]
  },
  {
    title: "Cake Tier Serving Sizer",
    url: "/cake-serving-calculator",
    icon: "🍰",
    badge: "Visual Sizer",
    desc: "Calculate tier dimensions, cutting portion dimensions (1\"x2\" vs 2\"x2\"), and sheet cake hacks for 50–300+ guests.",
    tags: ["Tier Dimensions", "Sheet Cakes", "Cutting Guide"]
  },
  {
    title: "Dessert Table, Candy Bar & Cookie Sizer",
    url: "/wedding-dessert-table-calculator",
    icon: "🧁",
    badge: "Portion & Variety Math",
    desc: "Calculate mini dessert pieces, Pittsburgh cookie table batches, bulk candy pounds, and jar counts with printable bakery orders.",
    tags: ["Dessert Bar Pieces", "Cookie Table Ratios", "Bulk Candy lbs"]
  },
  {
    title: "Catering Cost Estimator",
    url: "/catering-cost-estimator",
    icon: "🍽️",
    badge: "Per-Head Math",
    desc: "Compare plated, buffet, family-style, and food stations per-head pricing with staffing ratios.",
    tags: ["Plated vs Buffet", "Per-Head Math", "Staff Ratios"]
  },
  {
    title: "Alcohol Dilution Calculator",
    url: "/alcohol-dilution-calculator",
    icon: "🧪",
    badge: "Bartender Pro",
    desc: "Accurately dilute high-proof spirits and batch cocktails down to target ABV percentages.",
    tags: ["ABV Proof", "Batching Math", "Batch Cocktails"]
  },
  {
    title: "Floral Cost Estimator",
    url: "/floral-cost-estimator",
    icon: "💐",
    badge: "Stem Pricing",
    desc: "Estimate costs for bridal bouquets, boutonnieres, centerpieces, and ceremony flower arches.",
    tags: ["Stem Pricing", "Arrangements", "Ceremony Arch"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Bar & Culinary Hub</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Wedding <span class="accent-italic">Bar, Food & Dining</span> Sizers
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Calculate exact open bar alcohol quantities, size wedding cakes, estimate catering costs, and create printable reception menus.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Explore Categories:</span>
      <a href="/budget" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Budget</a>
      <a href="/dining" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">🍾 Dining (Active)</a>
      <a href="/guests" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">👥 Guests & Logistics</a>
      <a href="/stationery" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💌 Stationery & Creative</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {diningTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
            Launch Tool →
          </a>
        </div>
      ))}
    </div>

    <!-- In-Depth Dining & Bar Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Catering Formula</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          How to Calculate Wedding Food & Alcohol Requirements
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Never run dry at the bar and never overpay for extra sheet cakes. Use proven hospitality equations.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. The Standard 1-Drink-Per-Hour Formula
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Wedding guests drink at an accelerated pace during cocktail hour, then stabilize to one drink per hour:
        </p>
        
        <div style="background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-family: var(--font-body); font-size: 1rem; line-height: 1.6;">
          <strong>Total Drinks Needed = (Guest Count × 2 Drinks for Hour 1) + (Guest Count × 1 Drink × Remaining Hours)</strong>
          <br/><br/>
          <em>Example for 150 Guests (5-Hour Reception):</em> (150 × 2) + (150 × 4) = <strong>900 Drinks</strong>.
        </div>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Frequently Asked Questions
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              How many drinks per person should you plan for a wedding reception?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              The industry standard formula is 2 drinks per guest during Cocktail Hour (Hour 1), plus 1 drink per guest for every subsequent hour of the reception. For a 5-hour reception with 150 guests, plan for approximately 900 total servings.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              How many 750ml bottles of wine and liquor do you need for 100 guests?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              For a standard 4-hour open bar with 100 guests (500 total drinks): plan for roughly 50 bottles of wine (25 red, 25 white/rosé), 150-200 beers, and 12-14 bottles of 750ml spirits (or 6-7 large 1.75L handle bottles).
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              How much does a custom wedding cake cost per slice?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Artisanal custom wedding cakes range from $4.50 to $12.00+ per slice depending on intricate fondant detailing, sugar flowers, labor hours, and delivery setup fees.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
