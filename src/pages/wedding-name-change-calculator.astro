		// Helper: Capitalize
		function cap(str) {
			if (!str) return '';
			return str.trim().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ');
		}

		// Helper: Clean for email
		function sanitizeForEmail(str) {
			return str.toLowerCase().replace(/[^a-z0-9]/g, '');
		}

		// Calculate & Update Persona Studio
		function updatePersona() {
			const f1 = cap(p1First.value) || 'Jane';
			const m1 = cap(p1Middle.value) || 'Elizabeth';
			const maid = cap(p1Maiden.value) || 'Doe';
			const s2 = cap(p2Surname.value) || 'Miller';
			const cust = cap(customSurname.value) || 'Diller';
			const format = namingFormatSelect.value;

			let newFullName = '';
			let newSurname = '';
			let monogram = '';
			let isCourtOrder = false;

			if (format === 'blended') {
				customSurnameContainer.style.display = 'block';
			} else {
				customSurnameContainer.style.display = 'none';
			}

			switch (format) {
				case 'take-spouse':
					newSurname = s2;
					newFullName = m1 ? `${f1} ${m1} ${s2}` : `${f1} ${s2}`;
					monogram = `${f1.charAt(0)} ${s2.charAt(0)} ${m1 ? m1.charAt(0) : maid.charAt(0)}`;
					break;
				case 'hyphenated-1':
					newSurname = `${maid}-${s2}`;
					newFullName = m1 ? `${f1} ${m1} ${maid}-${s2}` : `${f1} ${maid}-${s2}`;
					monogram = `${f1.charAt(0)} ${s2.charAt(0)} ${maid.charAt(0)}`;
					break;
				case 'hyphenated-2':
					newSurname = `${s2}-${maid}`;
					newFullName = m1 ? `${f1} ${m1} ${s2}-${maid}` : `${f1} ${s2}-${maid}`;
					monogram = `${f1.charAt(0)} ${maid.charAt(0)} ${s2.charAt(0)}`;
					break;
				case 'maiden-middle':
					newSurname = s2;
					newFullName = `${f1} ${maid} ${s2}`;
					monogram = `${f1.charAt(0)} ${s2.charAt(0)} ${maid.charAt(0)}`;
					break;
				case 'two-middle':
					newSurname = s2;
					newFullName = m1 ? `${f1} ${m1} ${maid} ${s2}` : `${f1} ${maid} ${s2}`;
					monogram = `${f1.charAt(0)} ${s2.charAt(0)} ${maid.charAt(0)}`;
					break;
				case 'blended':
					newSurname = cust;
					newFullName = m1 ? `${f1} ${m1} ${cust}` : `${f1} ${cust}`;
					monogram = `${f1.charAt(0)} ${cust.charAt(0)} ${m1 ? m1.charAt(0) : maid.charAt(0)}`;
					isCourtOrder = true;
					break;
				case 'keep-maiden':
					newSurname = maid;
					newFullName = m1 ? `${f1} ${m1} ${maid}` : `${f1} ${maid}`;
					monogram = `${f1.charAt(0)} ${maid.charAt(0)} ${m1 ? m1.charAt(0) : 'D'}`;
					break;
			}

			previewFullLegal.textContent = newFullName;
			previewMonogram.textContent = monogram.toUpperCase();

			if (isCourtOrder) {
				previewRouteBadge.textContent = '⚖️ Court Petition Required';
				previewRouteBadge.style.color = '#dc2626';
			} else if (format === 'keep-maiden') {
				previewRouteBadge.textContent = '💼 Maiden Name Retained ($0)';
				previewRouteBadge.style.color = '#2563eb';
			} else {
				previewRouteBadge.textContent = '✅ Marriage Cert Route';
				previewRouteBadge.style.color = '#16a34a';
			}

			// Email Handle Preview
			const cleanFirst = sanitizeForEmail(f1);
			const cleanLast = sanitizeForEmail(newSurname);
			previewEmail.textContent = `${cleanFirst}.${cleanLast}@company.com`;
