		// Calculate Fees & Timeline
		function calculateFees() {
			// 1. Marriage Cert Copies
			const copies = parseInt(inputCertCopies.value, 10) || 3;
			const rate = parseFloat(inputCertRate.value) || 20;
			const certTotal = copies * rate;
			feeItem1.textContent = `$${certTotal.toFixed(2)}`;

			// 2. SSA: $0
			// 3. DMV Fee
			const dmvFee = parseFloat(inputDmvFee.value) || 0;
			feeItem3.textContent = `$${dmvFee.toFixed(2)}`;

			// 4. Vehicle Title
			const titleFee = parseFloat(inputTitleFee.value) || 0;
			feeItem4.textContent = `$${titleFee.toFixed(2)}`;

			// 6. Passport
			const passportRadios = document.querySelectorAll('input[name="passport-type"]');
			let passportScenario = 'over-1-yr';
			passportRadios.forEach(r => { if (r.checked) passportScenario = r.value; });

			let passportBase = 145; // $130 renewal + $15 photo
			let passportTime = '4–6 Weeks';

			if (passportScenario === 'within-1-yr') {
				passportBase = 15; // $0 DS-5504 + $15 photo
			} else if (passportScenario === 'first-time') {
				passportBase = 180; // $165 DS-11 + $15 photo
			}

			if (chkPassportExpedite.checked) {
				passportBase += 60;
				passportTime = '2–3 Weeks (Expedited)';
			}

			feeItem6.textContent = `$${passportBase.toFixed(2)}`;
			timePassport.textContent = `⏱️ ${passportTime}`;

			// 8. Checkbook
			const checkFee = parseFloat(inputCheckbookFee.value) || 0;
			feeItem8.textContent = `$${checkFee.toFixed(2)}`;

			// 16. Professional License
			const licFee = parseFloat(inputLicenseFee.value) || 0;
			feeItem16.textContent = `$${licFee.toFixed(2)}`;

			// Total Calculation
			const total = certTotal + dmvFee + titleFee + passportBase + checkFee + licFee;
			displayTotalFee.textContent = `$${total.toFixed(2)}`;

			// Progress Checkboxes
			let checkedCount = 0;
			taskCheckboxes.forEach(chk => {
				if (chk.checked) checkedCount++;
			});

			const totalTasks = taskCheckboxes.length;
			const pct = Math.round((checkedCount / totalTasks) * 100);
			progressText.textContent = `${checkedCount} of ${totalTasks} Tasks Completed (${pct}%)`;
			progressBarFill.style.width = `${pct}%`;

			// Timeline Estimation
			if (chkPassportExpedite.checked) {
				displayTotalWeeks.textContent = '4–6 Wks';
			} else {
				displayTotalWeeks.textContent = '6–8 Wks';
			}
		}

