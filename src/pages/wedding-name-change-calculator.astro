---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/wedding-name-change-calculator/#webapp",
      "name": "Marriage Name Change Checklist & Out-of-Pocket Fee Sizer",
      "url": "https://manage.wedding/wedding-name-change-calculator",
      "description": "Free interactive marriage name change checklist and fee calculator. Format your new surname, calculate total government document fees (Certified Marriage Copies, SSA, Passport, Real ID DMV), and export printable PDF and Word action packets.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Change Your Name After Marriage: Complete Step-by-Step Legal Order",
      "description": "The exact government-verified order of operations for changing your surname legally after getting married without travel delays or document rejections.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Order Certified Marriage Certificates",
          "text": "Obtain 3–4 official certified copies with raised seals from your county clerk or vital records office ($10–$30/copy). You will need physical copies for SSA, DMV, and Passport."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Update Social Security Card (SSA Form SS-5)",
          "text": "Submit Form SS-5 with your certified marriage certificate to the Social Security Administration ($0 fee). The SSA database must update before your DMV or IRS records can change."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Upgrade State Driver's License & Real ID",
          "text": "Visit your local DMV with your marriage certificate, SSA confirmation receipt, and 2 proofs of state residency to update your driver's license ($15–$45 fee)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Update US Passport (Form DS-5504 or DS-82)",
          "text": "Submit your passport update. If your passport was issued less than 1 year ago, use Form DS-5504 for $0 fee. If issued over 1 year ago, submit Form DS-82 ($130 fee)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 5: Notify Banks, Employer HR (Form W-4), and Insurances",
          "text": "Update your payroll W-4, health insurance cards, bank accounts, mortgage/lease, credit cards, and frequent flyer accounts to match your new legal ID."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the very first thing I should do to change my name after marriage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The absolute first step is ordering 3 to 4 certified copies of your marriage certificate from your county clerk or vital statistics office. Once received, your first legal filing MUST be with the Social Security Administration (Form SS-5). State DMVs, the State Department (Passport), and banks cannot process a name change until your updated identity is registered in the federal SSA database."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to change your name after marriage in the United States?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The total out-of-pocket cost typically ranges from $80 to $290. While the Social Security Administration charges $0, you will pay for certified marriage certificate copies ($30–$90 for 3 copies), a new state driver's license / Real ID ($15–$45), a passport update ($0 if issued within 12 months, or $130 renewal fee + $15 photos), and vehicle title updates ($10–$35)."
          }
        },
        {
          "@type": "Question",
          "name": "Can I travel on my honeymoon under my new married name?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if your airline tickets and your physical passport/ID in hand match EXACTLY. Because it takes 4 to 8 weeks to receive certified marriage certificates and new government IDs, you should book all honeymoon flights under your current maiden name. Never book tickets in your new married name if you have not already received your new physical passport."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a court order to take my spouse's last name or hyphenate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In almost all US states, taking your spouse's surname, hyphenating both surnames, or moving your maiden name to your middle name can be done directly using only your certified marriage certificate. A formal court order petition ($150–$450 court fee) is only required if you are inventing a completely new blended surname or altering your first name."
          }
        },
        {
          "@type": "Question",
          "name": "How long does the entire marriage name change process take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The entire process takes approximately 6 to 12 weeks. Certified marriage copies take 1–3 weeks to arrive after the ceremony. SSA processing takes 2–3 weeks. Once SSA is updated, your DMV appointment takes 1 day (with a 2-week wait for the plastic card), and standard passport renewals take 4–6 weeks."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Marriage Name Change Checklist & Fee Sizer (Action Packet)"
	description="Free interactive marriage name change checklist and fee calculator. Format your new surname, calculate total government document fees (SSA, Passport, Real ID, Marriage Certs), and export printable PDF & Word action packets."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Marriage Name Change Sizer" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Legal Order of Operations & Budget Sizer</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Marriage Name Change <span class="accent-italic">Checklist & Fee Sizer</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Format your new surname, compute official government out-of-pocket filing fees, and execute your step-by-step paperwork in the strict legal sequence. Export your customized 1-click action packet.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; margin-bottom: 3rem; align-items: start;">
			
			<!-- Left Column: Name Formatter & Personalization Studio -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						1. Naming Choice & Persona Studio
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Live Preview
					</span>
				</div>

				<!-- Person 1 Inputs -->
				<div style="margin-bottom: 1.25rem;">
					<label class="form-label" style="font-weight: 700; font-size: 0.95rem;">Your Current Legal Name</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr 1.2fr; gap: 0.5rem;">
						<div>
							<input type="text" id="p1-first" class="form-input" value="Jane" placeholder="First Name" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">First</span>
						</div>
						<div>
							<input type="text" id="p1-middle" class="form-input" value="Elizabeth" placeholder="Middle Name" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Middle</span>
						</div>
						<div>
							<input type="text" id="p1-maiden" class="form-input" value="Doe" placeholder="Maiden / Current" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Maiden/Current</span>
						</div>
					</div>
				</div>

				<!-- Person 2 Inputs -->
				<div style="margin-bottom: 1.25rem;">
					<label class="form-label" style="font-weight: 700; font-size: 0.95rem;">Partner's Legal Name</label>
					<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.5rem;">
						<div>
							<input type="text" id="p2-first" class="form-input" value="Alexander" placeholder="Partner First" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Partner First</span>
						</div>
						<div>
							<input type="text" id="p2-surname" class="form-input" value="Miller" placeholder="Partner Surname" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Partner Surname</span>
						</div>
					</div>
				</div>

				<!-- Naming Structure Option Selector -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="naming-format-select" style="font-weight: 700;">Legal Naming Structure Option</label>
					<select id="naming-format-select" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; padding: 0.65rem; width: 100%;">
						<option value="take-spouse" selected>💍 Traditional: Take Partner's Surname (Jane Elizabeth Miller)</option>
						<option value="hyphenated-1">🔗 Hyphenated: Maiden-Spouse (Jane Elizabeth Doe-Miller)</option>
						<option value="hyphenated-2">🔗 Hyphenated: Spouse-Maiden (Jane Elizabeth Miller-Doe)</option>
						<option value="maiden-middle">🏛️ Maiden as Middle Name (Jane Doe Miller)</option>
						<option value="two-middle">📜 Keep Both Middles (Jane Elizabeth Doe Miller)</option>
						<option value="blended">✨ Custom Blended Surname (Requires Court Petition)</option>
						<option value="keep-maiden">💼 Keep Maiden Legally (Socially Use Married Name - $0)</option>
					</select>
				</div>

				<!-- Custom Blended Input (hidden unless blended chosen) -->
				<div id="custom-surname-container" style="display: none; margin-bottom: 1.25rem;">
					<label class="form-label" for="custom-surname" style="font-weight: 700;">Custom Blended Surname</label>
					<input type="text" id="custom-surname" class="form-input" value="Diller" placeholder="e.g. Diller or Novafield" style="width: 100%; padding: 0.5rem;" />
					<small style="color: var(--accent-red); font-size: 0.8rem;">⚠️ Note: Brand new blended surnames require a formal county court petition ($150–$450) in most states.</small>
				</div>

				<!-- Live Preview Callout Card -->
				<div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; box-shadow: 3px 3px 0 var(--fg-pencil); margin-top: 1rem;">
					<div style="font-size: 0.8rem; text-transform: uppercase; font-weight: 800; color: var(--accent-red); letter-spacing: 0.05em; margin-bottom: 0.35rem;">
						Your New Official Persona
					</div>
					
					<div id="preview-full-legal" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); line-height: 1.2; margin-bottom: 0.75rem;">
						Jane Elizabeth Miller
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.88rem; padding-top: 0.75rem; border-top: 1px dashed #cbd5e1;">
						<div>
							<span style="color: var(--text-secondary); display: block; font-size: 0.75rem;">Monogram / Initials:</span>
							<strong id="preview-monogram" style="font-family: var(--font-hand); font-size: 1.3rem; color: var(--accent-blue);">J M E</strong>
						</div>
						<div>
							<span style="color: var(--text-secondary); display: block; font-size: 0.75rem;">Legal Route:</span>
							<strong id="preview-route-badge" style="color: #16a34a; font-size: 0.82rem;">✅ Marriage Cert Route</strong>
						</div>
						<div style="grid-column: span 2;">
							<span style="color: var(--text-secondary); display: block; font-size: 0.75rem;">Work Email Preview:</span>
							<code id="preview-email" style="background: #e2e8f0; padding: 2px 6px; border-radius: 3px; font-size: 0.85rem;">jane.miller@company.com</code>
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Out-of-Pocket Budget & Timeline Dashboard -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						2. Total Filing Fee & Timeline Sizer
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: #e0f2fe; border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Real-Time Total
					</span>
				</div>

				<!-- Big Metric Hero Cards -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
					
					<!-- Metric 1: Total Cost -->
					<div style="background: #fef08a; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; text-align: center; box-shadow: 3px 3px 0 var(--fg-pencil);">
						<span style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: var(--fg-pencil); display: block;">
							Total Out-of-Pocket
						</span>
						<div id="display-total-fee" class="font-heading" style="font-size: 2.2rem; color: var(--fg-pencil); line-height: 1.1; margin: 0.25rem 0;">
							$260.00
						</div>
						<span id="display-fee-range" style="font-size: 0.8rem; color: var(--text-secondary);">
							Across selected government agencies
						</span>
					</div>

					<!-- Metric 2: Estimated Weeks -->
					<div style="background: #e0e7ff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; text-align: center; box-shadow: 3px 3px 0 var(--fg-pencil);">
						<span style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: var(--fg-pencil); display: block;">
							Critical Path Time
						</span>
						<div id="display-total-weeks" class="font-heading" style="font-size: 2.2rem; color: var(--accent-blue); line-height: 1.1; margin: 0.25rem 0;">
							6–8 Wks
						</div>
						<span style="font-size: 0.8rem; color: var(--text-secondary);">
							Sequential processing window
						</span>
					</div>

				</div>

				<!-- Progress Bar -->
				<div style="margin-bottom: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<div style="display: flex; justify-content: space-between; font-size: 0.88rem; font-weight: 700; margin-bottom: 0.4rem;">
						<span>Paperwork Completion Progress:</span>
						<span id="progress-text">0 of 19 Tasks Completed (0%)</span>
					</div>
					<div style="width: 100%; height: 16px; background: #e2e8f0; border-radius: 8px; border: 1.5px solid var(--fg-pencil); overflow: hidden;">
						<div id="progress-bar-fill" style="width: 0%; height: 100%; background: #22c55e; transition: width 0.3s ease;"></div>
					</div>
				</div>

				<!-- Quick Filter & Action Controls -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
					<button type="button" id="btn-filter-all" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem; background: var(--fg-pencil); color: #fff;">
						All 19 Steps
					</button>
					<button type="button" id="btn-filter-vital" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem;">
						Stage 1 & 2 Core IDs
					</button>
					<button type="button" id="btn-filter-travel" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem;">
						Travel & Passport
					</button>
					<button type="button" id="btn-check-all" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem; margin-left: auto;">
						Reset Checkboxes
					</button>
				</div>

				<!-- Export & Download Action Buttons -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<button type="button" id="btn-export-pdf" class="hand-btn" style="background: #fecdd3; border-color: var(--fg-pencil); color: var(--fg-pencil); font-size: 0.95rem; padding: 10px;">
						🖨️ Print / Vector PDF
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="background: #dbeafe; border-color: var(--fg-pencil); color: var(--fg-pencil); font-size: 0.95rem; padding: 10px;">
						📄 Export Word (.doc)
					</button>
					<button type="button" id="btn-copy-checklist" class="hand-btn" style="grid-column: span 2; background: #dcfce7; border-color: var(--fg-pencil); color: var(--fg-pencil); font-size: 0.95rem; padding: 10px;">
						📋 Copy Action Plan to Clipboard
					</button>
				</div>

			</div>

		</div>

		<!-- Step-by-Step Interactive Checklist Accordion & Fee Editor -->
		<section class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.5rem); background: #fff; margin-bottom: 3.5rem;">
			
			<div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
				<div>
					<span class="badge-postit" style="font-size: 0.85rem;">Phased Master Checklist</span>
					<h2 class="font-heading" style="font-size: 1.85rem; margin: 0.35rem 0 0 0; color: var(--fg-pencil);">
						The 5-Stage Legal Order of Operations
					</h2>
				</div>
				<p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0; max-width: 480px;">
					Check boxes as you finish paperwork. Edit cost values to match your local municipality or state fees.
				</p>
			</div>

			<!-- STAGE 1: Certified Marriage Certificate & Vital Records -->
			<div class="checklist-stage" data-stage="vital" style="margin-bottom: 2rem;">
				<div style="background: #f1f5f9; border-left: 5px solid var(--accent-red); padding: 0.75rem 1rem; border-radius: 0 6px 6px 0; margin-bottom: 1rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						Stage 1: Vital Records & Certified Marriage Certificate
					</h3>
					<p style="margin: 0; font-size: 0.88rem; color: var(--text-secondary);">
						Step 1 must be completed before any federal or state agency will accept name change requests.
					</p>
				</div>

				<!-- Item 1: Certified Marriage Certificates -->
				<div class="checklist-item hand-card" style="padding: 1rem; margin-bottom: 0.85rem; background: #fafafa; border: 1.5px solid var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
						<div style="display: flex; align-items: flex-start; gap: 0.75rem; flex: 1; min-width: 260px;">
							<input type="checkbox" id="chk-item-1" class="task-checkbox" style="width: 20px; height: 20px; margin-top: 3px; cursor: pointer;" />
							<div>
								<label for="chk-item-1" style="font-weight: 700; font-size: 1.05rem; color: var(--fg-pencil); cursor: pointer;">
									1. Certified Marriage Certificate Copies (Raised Seal)
								</label>
								<div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
									Order from County Clerk / Vital Records. <strong>Recommended: 3 to 4 copies</strong> (SSA, DMV, Passport, and Home Safe).
								</div>
								<div style="margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
									<span style="font-size: 0.85rem;">Copies needed:</span>
									<input type="number" id="input-cert-copies" min="1" max="10" value="3" style="width: 55px; padding: 3px 6px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
									<span style="font-size: 0.85rem;">@ $</span>
									<input type="number" id="input-cert-rate" min="5" max="50" value="20" style="width: 60px; padding: 3px 6px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
									<span style="font-size: 0.85rem;">/ copy</span>
								</div>
							</div>
						</div>
						<div style="text-align: right; min-width: 110px;">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Fee Subtotal:</span>
							<strong id="fee-item-1" class="item-cost-display" style="font-size: 1.2rem; color: var(--accent-red);">$60.00</strong>
							<span style="display: block; font-size: 0.75rem; color: #16a34a; font-weight: 600;">⏱️ 1–3 Weeks</span>
						</div>
					</div>
				</div>

				<!-- Item 2: SSA Social Security -->
				<div class="checklist-item hand-card" style="padding: 1rem; margin-bottom: 0.85rem; background: #fafafa; border: 1.5px solid var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
						<div style="display: flex; align-items: flex-start; gap: 0.75rem; flex: 1; min-width: 260px;">
							<input type="checkbox" id="chk-item-2" class="task-checkbox" style="width: 20px; height: 20px; margin-top: 3px; cursor: pointer;" />
							<div>
								<label for="chk-item-2" style="font-weight: 700; font-size: 1.05rem; color: var(--fg-pencil); cursor: pointer;">
									2. Social Security Card (SSA Form SS-5)
								</label>
								<div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
									Submit Form SS-5 in person or by mail with Certified Marriage Cert + Valid Photo ID. <strong>Mandatory 1st Legal Update</strong>. Your SSN number remains the same.
								</div>
								<div style="margin-top: 0.35rem; font-size: 0.8rem; color: #4338ca;">
									📄 Required: SSA Form SS-5, Certified Marriage Certificate, Current Driver's License or Passport.
								</div>
							</div>
						</div>
						<div style="text-align: right; min-width: 110px;">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Official Gov Fee:</span>
							<strong id="fee-item-2" class="item-cost-display" style="font-size: 1.2rem; color: #16a34a;">$0.00 (FREE)</strong>
							<span style="display: block; font-size: 0.75rem; color: #16a34a; font-weight: 600;">⏱️ 2–3 Weeks</span>
						</div>
					</div>
				</div>

			</div>

			<!-- STAGE 2: State Driver's License, Real ID & Vehicle -->
			<div class="checklist-stage" data-stage="vital" style="margin-bottom: 2rem;">
				<div style="background: #f1f5f9; border-left: 5px solid var(--accent-blue); padding: 0.75rem 1rem; border-radius: 0 6px 6px 0; margin-bottom: 1rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
