---
import Layout from '../layouts/Layout.astro';

const title = "Free Wedding Reception Menu Maker & Printable Designer";
const description = "Design and print custom wedding dinner menus in minutes. Choose from elegant fonts, floral borders, 4x9 DL, 5x7, and A4 sizes. 100% free with instant PDF download.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/reception-menu-maker/#webapp",
      "name": "Wedding Reception Menu Maker & Printable Designer",
      "url": "https://manage.wedding/reception-menu-maker",
      "description": "Create and print luxury wedding reception menus instantly. Customize courses, select fonts (Playfair, Cinzel, Alex Brush, Cormorant), choose sizes (4x9 DL, 5x7, A4), and export high-res vector PDFs.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Design and Print Wedding Reception Menus",
      "description": "Step-by-step guide to customizing courses, selecting typography, and printing restaurant-quality menu cards.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Choose Menu Design Theme & Card Format",
          "text": "Select from Botanical Garden, Modern Black-Tie, Rustic Kraft, or Romantic Script, and pick your card size (4\" × 9\" DL or 5\" × 7\")."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Select Font Pairing Typography",
          "text": "Pick from luxury serif (Playfair Display, Cormorant Garamond), classical Roman (Cinzel), or flowing calligraphy script (Alex Brush)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Customize Courses & Dietary Badges",
          "text": "Add starters, entrées, dessert, and wine pairings. Include dietary badges (V, VG, GF, DF) to inform guests."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Download Print-Ready PDF or Word Doc",
          "text": "Export high-resolution vector PDFs formatted for printing at home or at professional print shops on 100lb+ linen cardstock."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the standard size for wedding reception menu cards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The two standard wedding menu sizes are: 4\" × 9\" DL (long and narrow, perfect for tucking into folded napkins or chargers) and 5\" × 7\" (standard photo frame or table easel size for shared tables)."
          }
        },
        {
          "@type": "Question",
          "name": "What paper weight is best for printing wedding menus?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Print wedding menus on 100lb to 120lb cover cardstock (270 to 350 GSM). Linen, cotton rag, or felt-textured matte finishes provide a luxury tactile experience and prevent paper curling."
          }
        },
        {
          "@type": "Question",
          "name": "Should every wedding guest get an individual menu card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For plated multi-course dinners, one individual 4x9 card per place setting is traditional. For buffet or family-style dining, 2 shared 5x7 cards per table or one 18x24 easel sign at the buffet is budget-friendly."
          }
        },
        {
          "@type": "Question",
          "name": "How do you indicate dietary restrictions on a wedding menu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use discreet standard abbreviations next to dish titles: (V) for Vegetarian, (VG) for Vegan, (GF) for Gluten-Free, and (DF) for Dairy-Free, with a brief explanatory key at the bottom of the card."
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} schema={schema}>
  <!-- Import Elegant Wedding Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Vector PDF & Custom Typography</span>
      <h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Wedding Reception <span class="accent-italic">Menu Maker</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Create restaurant-quality dinner menus in seconds. Choose from luxury fonts, botanical borders, 4×9" DL or 5×7" sizes, and download print-ready PDFs.
      </p>
    </header>

    <!-- Main Studio Grid -->
    <div id="app-area" class="fade-in" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2.5rem; align-items: start; margin-bottom: 3.5rem;">

      <!-- Hidden images used for jsPDF generation -->
      <img id="floral-tl" src="/images/floral-tl.webp" alt="" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-tr" src="/images/floral-tr.webp" alt="" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-bl" src="/images/floral-bl.webp" alt="" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-br" src="/images/floral-br.webp" alt="" aria-hidden="true" style="display: none;" crossorigin="anonymous" />

      <!-- ===== LEFT COLUMN: DESIGN CONTROLS & EDITOR ===== -->
      <div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
          <h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
            1. Menu Design & Typography
          </h2>
          <span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
            Live Studio
          </span>
        </div>

        <!-- Design Theme Selector -->
        <div class="form-group">
          <label class="form-label" for="themePicker">Design Theme & Aesthetic</label>
          <select id="themePicker" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc;">
            <option value="botanical" selected>🌿 Botanical Garden (Parchment, Classic Borders & Florals)</option>
            <option value="black-tie">👑 Black-Tie Luxury (Crisp White & Minimalist Hairline)</option>
            <option value="romantic">🌸 Romantic Script & Rose Gold Accents</option>
            <option value="rustic">📜 Rustic Kraft & Tuscan Vineyard</option>
            <option value="minimalist">✨ Modern Scandinavian (Clean & Borderless)</option>
          </select>
        </div>

        <!-- Typography / Font Pairings -->
        <div class="form-group">
          <label class="form-label" for="fontPicker">Font Pairing & Header Style</label>
          <select id="fontPicker" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc;">
            <option value="playfair" selected>🏛️ Playfair Display (Classic Editorial Serif)</option>
            <option value="cinzel">👑 Cinzel / Imperial Trajan (Regal & Formal)</option>
            <option value="cormorant">📜 Cormorant Garamond (Delicate Old-World Serif)</option>
            <option value="script">✍️ Alex Brush Calligraphy Script (Flowing & Romantic)</option>
            <option value="modern">📐 Montserrat Tracked (Clean Modern Minimalist)</option>
          </select>
        </div>

        <!-- Card Dimensions / Format -->
        <div class="form-group">
          <label class="form-label" for="sizePicker">Menu Card Dimensions</label>
          <select id="sizePicker" class="form-input" style="cursor: pointer; font-weight: 600;">
            <option value="dl" selected>📇 4" × 9" Long DL (Napkin / Charger Setting — Most Popular)</option>
            <option value="a5">📜 5" × 7" Classic Table Standee (A5 Ratio)</option>
            <option value="a4">📄 A4 / US Letter (Buffet & Station Sign)</option>
          </select>
        </div>

        <!-- Header Names & Date -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
          <div>
            <label class="form-label" for="coupleNames">Couple's Names</label>
            <input id="coupleNames" class="form-input" type="text" value="Charlotte & William" style="font-weight: 600;" />
          </div>
          <div>
            <label class="form-label" for="weddingDate">Date or Tagline</label>
            <input id="weddingDate" class="form-input" type="text" value="October 18, 2026" style="font-weight: 600;" />
          </div>
        </div>

        <!-- Header Title Text -->
        <div class="form-group" style="margin-top: 0.75rem;">
          <label class="form-label" for="menuTitle">Header Title</label>
          <input id="menuTitle" class="form-input" type="text" value="DINNER MENU" style="font-weight: 700; letter-spacing: 2px;" />
        </div>

        <!-- Courses Section Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin: 1.5rem 0 0.75rem 0; border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
          <h3 class="font-heading" style="font-size: 1.25rem; margin: 0; color: var(--fg-pencil);">
            2. Dinner Courses & Dishes
          </h3>
          <span style="font-size: 0.8rem; color: var(--text-secondary);">One dish per line</span>
        </div>

        <!-- Dynamic courses list -->
        <div id="course-list"></div>

        <!-- Add Course Button -->
        <button id="addCourseBtn" type="button" class="menu-add-btn" style="margin-bottom: 1.5rem;">
          + Add Another Course / Course Section
        </button>

        <!-- Dietary Key Toggle -->
        <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1.5rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.92rem; font-weight: 600;">
            <input type="checkbox" id="check-dietary-key" checked style="width: 18px; height: 18px;" />
            <span>Show Dietary Legend at Bottom (V, VG, GF, DF)</span>
          </label>
        </div>

        <!-- Download & Export Actions -->
        <div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
          <button id="printMenuBtn" class="hand-btn" style="width: 100%; padding: 12px; font-size: 1.05rem; gap: 0.5rem;">
            <span>🖨️</span> Print High-Res Menu (PDF / Cardstock)
          </button>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
            <button id="downloadVectorPdfBtn" class="hand-btn secondary" style="padding: 10px; font-size: 0.92rem; gap: 0.35rem;">
              <span>📥</span> Vector PDF
            </button>
            <button id="exportDocBtn" class="hand-btn secondary" style="padding: 10px; font-size: 0.92rem; gap: 0.35rem;">
              <span>📄</span> Export Word Doc
            </button>
          </div>
          
          <p class="font-body" style="font-size: 0.82rem; color: var(--text-secondary); text-align: center; margin: 0;">
            Crisp vector rendering · Formatted for 100lb–120lb linen cardstock
          </p>
        </div>

      </div>

      <!-- ===== RIGHT COLUMN: STICKY LIVE PREVIEW ===== -->
      <div style="position: sticky; top: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <span style="font-family: var(--font-heading); font-size: 1.1rem; color: var(--fg-pencil); font-weight: 700;">
            Live Visual Preview
          </span>
          <span id="preview-size-tag" style="font-size: 0.82rem; font-weight: 700; background: #e2e8f0; padding: 2px 8px; border-radius: 4px;">
            4" × 9" DL Format
          </span>
        </div>

        <div style="display: flex; justify-content: center;">
          
          <!-- Outer Card Container -->
          <div id="menuPreview" class="menu-preview-box" style="
            width: 100%;
            max-width: 400px;
            background: #fdfbf7;
            border: 2px solid #2d2d2d;
            box-shadow: 6px 6px 0px rgba(0,0,0,0.15);
            padding: 40px 32px;
            position: relative;
            min-height: 600px;
            box-sizing: border-box;
            transition: all 0.25s ease;
          ">
            
            <!-- Outer Frame Border -->
            <div id="frame-outer" style="position: absolute; top: 10px; bottom: 10px; left: 10px; right: 10px; border: 1.5px solid #2d2d2d; pointer-events: none; z-index: 1;"></div>
            
            <!-- Inner Frame Border -->
            <div id="frame-inner" style="position: absolute; top: 14px; bottom: 14px; left: 14px; right: 14px; border: 0.75px solid #94a3b8; pointer-events: none; z-index: 1;"></div>

            <!-- Floral Corners (Toggleable by Theme) -->
            <img id="prev-floral-tl" src="/images/floral-tl.webp" alt="" aria-hidden="true" style="position: absolute; top: 15px; left: 15px; width: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-tr" src="/images/floral-tr.webp" alt="" aria-hidden="true" style="position: absolute; top: 15px; right: 15px; width: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-bl" src="/images/floral-bl.webp" alt="" aria-hidden="true" style="position: absolute; bottom: 15px; left: 15px; width: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-br" src="/images/floral-br.webp" alt="" aria-hidden="true" style="position: absolute; bottom: 15px; right: 15px; width: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />

            <!-- Live Menu Typography Content -->
            <div id="menuContent" style="position: relative; z-index: 3; text-align: center;"></div>

          </div>

        </div>
      </div>

    </div>

    <!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
    <div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
      <div class="tape" style="margin: 0 auto 0.75rem;"></div>
      
      <div style="text-align: center; margin-bottom: 1.25rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Bottom Line Up Front (BLUF)</span>
        <h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
          Wedding Menu Printing Standards & Sizing Guide
        </h2>
        <p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
          Everything you need to know about paper weight, dimensions, and quantity ratios for reception table menus.
        </p>
      </div>

      <!-- Formula Highlight Box -->
      <div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
        <p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.6; text-align: center; font-weight: 600;">
          <strong>Individual Place Settings:</strong> 4" × 9" DL (100lb+ Cover Cardstock) • <strong>Shared Tables:</strong> 5" × 7" Standee (2 per Table) • <strong>Buffet Signs:</strong> 18" × 24" Easel Board.
        </p>
      </div>

      <!-- Semantic Benchmark Table -->
      <div style="overflow-x: auto; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 650px;">
          <thead>
            <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Menu Format</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Dimensions</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Print Quantity Ratio</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Recommended Paper Weight</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Table Presentation</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-red);">Individual Long DL</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">4" × 9" (99 × 210 mm)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">1 per Guest (+10% buffer)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">100lb–120lb Linen / Cotton</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Tucked inside folded napkin or charger</td>
            </tr>
            <tr style="background: #faf8f5;">
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--fg-pencil);">Classic Individual A5</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">5" × 7" (127 × 178 mm)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">1 per Guest</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">110lb Matte Smooth</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Plated dinner settings with course pairings</td>
            </tr>
            <tr>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">Dual-Sided Table Standee</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">5" × 7" (Folded Tent)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">2 Cards per Table (8–10 seats)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">120lb Heavy Cardstock</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Shared center stand next to floral centerpiece</td>
            </tr>
            <tr style="background: #faf8f5;">
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: #7c3aed);">Buffet Station Sign</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">8" × 10" or 18" × 24"</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">1 per Food Station</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">Rigid Foamcore / Wood Frame</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Easel stand at carving, cocktail or dessert bar</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- SEO & Design Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          How to Design & Print Elegant Wedding Menus
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Professional tips on course wording, typography pairing, paper cardstock, and printing at home.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. Descriptive Culinary Wording
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Appetizing menu descriptions elevate the entire dining experience. Instead of listing raw ingredients, highlight cooking techniques and signature sauces:
        </p>
        <ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem;">
          <li><em>Instead of "Beef":</em> <strong>Pan-Seared Filet Mignon with Truffled Potato Puree & Red Wine Demi-Glace</strong>.</li>
          <li><em>Instead of "Salmon":</em> <strong>Wild Atlantic Salmon with Charred Lemon Herb Butter & Roasted Broccolini</strong>.</li>
        </ul>
      </section>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          2. Printing at Home vs. Local Print Shops
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Our vector PDF export is formatted at 300 DPI for zero blur. If printing at home, use the <strong>Rear Feed Tray</strong> on your inkjet printer to handle heavy 100lb+ cardstock without roller bending. Alternatively, upload your PDF directly to FedEx Office, Staples, or a local print shop on 110lb textured linen cardstock for under $0.40 per card.
        </p>
      </section>

    </article>

  </main>
</Layout>

<style>
  .menu-add-btn {
    width: 100%;
    padding: 0.75rem;
    border: 2px dashed var(--fg-pencil);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--fg-pencil);
    border-radius: 4px;
    transition: background 0.15s;
  }
  .menu-add-btn:hover { background: #f5f1e8; }

  .course-block {
    border: 1.5px solid var(--fg-pencil);
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1rem;
    background: #fdfbf7;
  }
  .course-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .course-block-label {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
    color: var(--fg-pencil);
  }
  .course-rm-btn {
    background: #fee2e2;
    border: 1px solid #ef4444;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    color: #b91c1c;
    font-weight: bold;
    padding: 2px 6px;
  }
  .course-rm-btn:hover { background: #fecaca; }

  .dietary-tag-pill {
    display: inline-block;
    font-size: 0.70rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 4px;
    vertical-align: middle;
  }
</style>

<script>
  // ── State ───────────────────────────────────────────────────────────
  let courses: { title: string; items: string }[] = [
    { 
      title: 'FIRST COURSE', 
      items: 'Burrata Caprese Salad with Heirloom Tomatoes & Basil [V, GF]\nWild Mushroom & Thyme Tartlet with Truffle Honey' 
    },
    { 
      title: 'MAIN ENTRÉE', 
      items: 'Pan-Seared Filet Mignon with Red Wine Demi-Glace [GF]\nHerb-Crusted Chilean Sea Bass with Lemon Beurre Blanc\nWild Forest Mushroom Risotto with Shaved Truffle [V, VG, GF]' 
    },
    { 
      title: 'DESSERT & TOAST', 
      items: 'Three-Tier Vanilla Bean & Raspberry Wedding Cake\nEspresso Chocolate Mousse Tartlet' 
    },
  ];

  // ── Editor Renderer ──────────────────────────────────────────────────
  function renderEditor() {
    const list = document.getElementById('course-list');
    if (!list) return;
    list.innerHTML = '';

    courses.forEach((c, i) => {
      const div = document.createElement('div');
      div.className = 'course-block';
      div.innerHTML = `
        <div class="course-block-header">
          <p class="course-block-label">Course ${i + 1}</p>
          ${courses.length > 1 ? `<button class="course-rm-btn" data-rm="${i}" title="Remove Course">✕ Delete</button>` : ''}
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <div>
            <label class="form-label" style="font-size: 0.85rem;">Course Header (e.g. Starters, Main Course, Dessert)</label>
            <input class="form-input ci-t" data-i="${i}" type="text" value="${c.title}" style="font-weight: 700;" />
          </div>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
              <label class="form-label" style="font-size: 0.85rem; margin: 0;">Dishes (One per line • use [V], [GF], [VG], [DF])</label>
              <div style="display: flex; gap: 3px;">
                <button type="button" class="btn-tag" data-tag="[GF]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+GF</button>
                <button type="button" class="btn-tag" data-tag="[V]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+V</button>
                <button type="button" class="btn-tag" data-tag="[VG]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+VG</button>
                <button type="button" class="btn-tag" data-tag="[DF]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+DF</button>
              </div>
            </div>
            <textarea class="form-input ci-v" data-i="${i}" style="min-height: 75px; resize: vertical; font-size: 0.92rem;">${c.items}</textarea>
          </div>
        </div>
      `;
      list.appendChild(div);
    });

    // Event Bindings
    list.querySelectorAll('[data-rm]').forEach(b =>
      b.addEventListener('click', e => {
        courses.splice(+(e.currentTarget as HTMLElement).getAttribute('data-rm')!, 1);
        renderEditor();
        renderPreview();
      })
    );
    list.querySelectorAll('.ci-t').forEach(el =>
      el.addEventListener('input', e => {
        courses[+(e.currentTarget as HTMLInputElement).getAttribute('data-i')!].title = (e.currentTarget as HTMLInputElement).value;
        renderPreview();
      })
    );
    list.querySelectorAll('.ci-v').forEach(el =>
      el.addEventListener('input', e => {
        courses[+(e.currentTarget as HTMLTextAreaElement).getAttribute('data-i')!].items = (e.currentTarget as HTMLTextAreaElement).value;
        renderPreview();
      })
    );
    list.querySelectorAll('.btn-tag').forEach(b =>
      b.addEventListener('click', e => {
        const tag = (e.currentTarget as HTMLElement).getAttribute('data-tag');
        const idx = +(e.currentTarget as HTMLElement).getAttribute('data-i')!;
        const textarea = list.querySelector(`.ci-v[data-i="${idx}"]`) as HTMLTextAreaElement;
        if (textarea && tag) {
          textarea.value += ` ${tag}`;
          courses[idx].items = textarea.value;
          renderPreview();
        }
      })
    );
  }

  // ── Helper: Format Dietary Badges ─────────────────────────────────────
  function formatDishWithBadges(text: string): string {
    let formatted = text.trim();
    formatted = formatted.replace(/\[GF\]/gi, '<span class="dietary-tag-pill" style="background:#e0f2fe; color:#0369a1; border:1px solid #7dd3fc;">GF</span>');
    formatted = formatted.replace(/\[V\]/gi, '<span class="dietary-tag-pill" style="background:#f0fdf4; color:#15803d; border:1px solid #86efac;">V</span>');
    formatted = formatted.replace(/\[VG\]/gi, '<span class="dietary-tag-pill" style="background:#fefce8; color:#a16207; border:1px solid #fef08a;">VG</span>');
    formatted = formatted.replace(/\[DF\]/gi, '<span class="dietary-tag-pill" style="background:#fdf2f8; color:#be185d; border:1px solid #fbcfe8;">DF</span>');
    formatted = formatted.replace(/\[NF\]/gi, '<span class="dietary-tag-pill" style="background:#fff7ed; color:#c2410c; border:1px solid #fdba74;">NF</span>');
    return formatted;
  }

  // ── Live Preview Renderer ─────────────────────────────────────────────
  function renderPreview() {
    const el = document.getElementById('menuContent');
    const previewBox = document.getElementById('menuPreview');
    const frameOuter = document.getElementById('frame-outer');
    const frameInner = document.getElementById('frame-inner');
    const floralCorners = [
      document.getElementById('prev-floral-tl'),
      document.getElementById('prev-floral-tr'),
      document.getElementById('prev-floral-bl'),
      document.getElementById('prev-floral-br'),
    ];

    if (!el || !previewBox || !frameOuter || !frameInner) return;

    const theme = (document.getElementById('themePicker') as HTMLSelectElement)?.value || 'botanical';
    const font = (document.getElementById('fontPicker') as HTMLSelectElement)?.value || 'playfair';
    const size = (document.getElementById('sizePicker') as HTMLSelectElement)?.value || 'dl';
    const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Charlotte & William';
    const date = (document.getElementById('weddingDate') as HTMLInputElement)?.value || 'October 18, 2026';
    const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'DINNER MENU';
    const showDietary = (document.getElementById('check-dietary-key') as HTMLInputElement)?.checked ?? true;

    // Update Preview Size Tag
    const sizeTag = document.getElementById('preview-size-tag');
    if (sizeTag) {
      if (size === 'dl') sizeTag.textContent = '4" × 9" DL Format';
      else if (size === 'a5') sizeTag.textContent = '5" × 7" Table Card';
      else sizeTag.textContent = 'A4 / Letter Format';
    }

    // Apply Dimensions Aspect
    if (size === 'dl') {
      previewBox.style.maxWidth = '360px';
      previewBox.style.minHeight = '640px';
    } else if (size === 'a5') {
      previewBox.style.maxWidth = '420px';
      previewBox.style.minHeight = '560px';
    } else {
      previewBox.style.maxWidth = '460px';
      previewBox.style.minHeight = '620px';
    }

    // Apply Theme Styles
    if (theme === 'botanical') {
      previewBox.style.background = '#fdfbf7';
      previewBox.style.color = '#1e293b';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '1.5px solid #2d2d2d';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.75px solid #94a3b8';
      floralCorners.forEach(img => { if (img) img.style.display = 'block'; });
    } else if (theme === 'black-tie') {
      previewBox.style.background = '#ffffff';
      previewBox.style.color = '#0f172a';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '2px solid #0f172a';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.5px solid #0f172a';
      floralCorners.forEach(img => { if (img) img.style.display = 'none'; });
    } else if (theme === 'romantic') {
      previewBox.style.background = '#fff9f8';
      previewBox.style.color = '#3b1c1c';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '1.5px solid #c48b71';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.75px dashed #c48b71';
      floralCorners.forEach(img => { if (img) img.style.display = 'block'; });
    } else if (theme === 'rustic') {
      previewBox.style.background = '#f5ecd7';
      previewBox.style.color = '#2c1810';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '2px solid #5c3a21';
      frameInner.style.display = 'block';
      frameInner.style.border = '1px dashed #8c5a31';
      floralCorners.forEach(img => { if (img) img.style.display = 'none'; });
    } else if (theme === 'minimalist') {
      previewBox.style.background = '#ffffff';
      previewBox.style.color = '#1e293b';
      frameOuter.style.display = 'none';
      frameInner.style.display = 'none';
      floralCorners.forEach(img => { if (img) img.style.display = 'none'; });
    }

    // Determine Typography Styles
    let headerFontFamily = "'Playfair Display', serif";
    let bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
    let titleLetterSpacing = "3px";
    let namesStyle = "font-style: italic;";

    if (font === 'playfair') {
      headerFontFamily = "'Playfair Display', serif";
      bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
      titleLetterSpacing = "3px";
    } else if (font === 'cinzel') {
      headerFontFamily = "'Cinzel', serif";
      bodyFontFamily = "'Cormorant Garamond', serif";
      titleLetterSpacing = "4px";
      namesStyle = "font-weight: 600; letter-spacing: 2px;";
    } else if (font === 'cormorant') {
      headerFontFamily = "'Cormorant Garamond', serif";
      bodyFontFamily = "'Cormorant Garamond', serif";
      titleLetterSpacing = "3px";
      namesStyle = "font-style: italic; font-size: 1.25rem;";
    } else if (font === 'script') {
      headerFontFamily = "'Alex Brush', cursive";
      bodyFontFamily = "'Playfair Display', serif";
      titleLetterSpacing = "1px";
      namesStyle = "font-family: 'Alex Brush', cursive; font-size: 1.85rem; line-height: 1.1;";
    } else if (font === 'modern') {
      headerFontFamily = "'Montserrat', sans-serif";
      bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
      titleLetterSpacing = "5px";
      namesStyle = "font-family: 'Montserrat', sans-serif; font-size: 0.95rem; letter-spacing: 2px; text-transform: uppercase;";
    }

    // Build Preview HTML
    let html = `
      <div style="margin-bottom: 12px;">
        <h3 style="font-family: ${headerFontFamily}; font-size: ${font === 'script' ? '2.4rem' : '1.7rem'}; letter-spacing: ${titleLetterSpacing}; text-transform: ${font === 'script' ? 'none' : 'uppercase'}; margin: 0 0 4px 0; font-weight: 700;">
          ${menuTitle}
        </h3>
        <p style="${namesStyle} margin: 0 0 2px 0;">
          ${names}
        </p>
        <p style="font-size: 0.80rem; letter-spacing: 1.5px; opacity: 0.7; margin: 0; font-family: 'Montserrat', sans-serif;">
          ${date}
        </p>
        <div style="width: 40px; border-top: 1.5px solid currentColor; margin: 12px auto; opacity: 0.6;"></div>
      </div>
    `;

    courses.forEach((c, i) => {
      if (i > 0) {
        html += `<div style="width: 24px; border-top: 1px dashed currentColor; margin: 12px auto; opacity: 0.4;"></div>`;
      }
      
      const rawDishes = c.items.split('\n').filter(l => l.trim());
      const formattedDishes = rawDishes.map(d => `<div style="margin-bottom: 4px; line-height: 1.45;">${formatDishWithBadges(d)}</div>`).join('');

      html += `
        <div style="margin-bottom: 8px;">
          <h4 style="font-family: ${headerFontFamily}; font-size: 1.05rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin: 0 0 4px 0; color: var(--accent-red);">
            ${c.title}
          </h4>
          <div style="font-family: ${bodyFontFamily}; font-size: 0.88rem; opacity: 0.9;">
            ${formattedDishes || '<span style="opacity: 0.4; font-style: italic;">Enter dishes...</span>'}
          </div>
        </div>
      `;
    });

    if (showDietary) {
      html += `
        <div style="margin-top: 18px; padding-top: 8px; border-top: 0.5px solid currentColor; opacity: 0.65; font-size: 0.72rem; font-family: 'Montserrat', sans-serif; letter-spacing: 0.5px;">
          (V) Vegetarian • (VG) Vegan • (GF) Gluten-Free • (DF) Dairy-Free
        </div>
      `;
    }

    el.innerHTML = html;
  }

  // ── Print High-Res Window Engine (Preserves Custom Google Fonts) ─────
  function printHighResMenu() {
    const theme = (document.getElementById('themePicker') as HTMLSelectElement)?.value || 'botanical';
    const font = (document.getElementById('fontPicker') as HTMLSelectElement)?.value || 'playfair';
    const size = (document.getElementById('sizePicker') as HTMLSelectElement)?.value || 'dl';
    const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Charlotte & William';
    const date = (document.getElementById('weddingDate') as HTMLInputElement)?.value || 'October 18, 2026';
    const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'DINNER MENU';
    const showDietary = (document.getElementById('check-dietary-key') as HTMLInputElement)?.checked ?? true;

    // Dimensions CSS
    let cardW = '4in';
    let cardH = '9in';
    if (size === 'a5') { cardW = '5in'; cardH = '7in'; }
    else if (size === 'a4') { cardW = '8.5in'; cardH = '11in'; }

    let bgStyle = '#fdfbf7';
    let textColor = '#1e293b';
    let borderColor = '#2d2d2d';
    let innerBorderColor = '#94a3b8';
    let showCorners = true;

    if (theme === 'black-tie') {
      bgStyle = '#ffffff'; textColor = '#0f172a'; borderColor = '#0f172a'; innerBorderColor = '#0f172a'; showCorners = false;
    } else if (theme === 'romantic') {
      bgStyle = '#fff9f8'; textColor = '#3b1c1c'; borderColor = '#c48b71'; innerBorderColor = '#c48b71'; showCorners = true;
    } else if (theme === 'rustic') {
      bgStyle = '#f5ecd7'; textColor = '#2c1810'; borderColor = '#5c3a21'; innerBorderColor = '#8c5a31'; showCorners = false;
    } else if (theme === 'minimalist') {
      bgStyle = '#ffffff'; textColor = '#1e293b'; borderColor = 'transparent'; innerBorderColor = 'transparent'; showCorners = false;
    }

    let headerFontFamily = "'Playfair Display', serif";
    let bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
    if (font === 'cinzel') { headerFontFamily = "'Cinzel', serif"; bodyFontFamily = "'Cormorant Garamond', serif"; }
    else if (font === 'cormorant') { headerFontFamily = "'Cormorant Garamond', serif"; bodyFontFamily = "'Cormorant Garamond', serif"; }
    else if (font === 'script') { headerFontFamily = "'Alex Brush', cursive"; bodyFontFamily = "'Playfair Display', serif"; }
    else if (font === 'modern') { headerFontFamily = "'Montserrat', sans-serif"; bodyFontFamily = "'Plus Jakarta Sans', sans-serif"; }

    let coursesHtml = '';
    courses.forEach((c, i) => {
      if (i > 0) coursesHtml += `<div style="width: 25px; border-top: 1px dashed currentColor; margin: 10px auto; opacity: 0.4;"></div>`;
      const dishes = c.items.split('\n').filter(l => l.trim()).map(d => `<div style="margin-bottom: 4px; font-size: 10pt; line-height: 1.45;">${formatDishWithBadges(d)}</div>`).join('');
      coursesHtml += `
        <div style="margin-bottom: 8px;">
          <h4 style="font-family: ${headerFontFamily}; font-size: 13pt; margin: 0 0 3px 0; font-weight: 700; text-transform: uppercase; color: #b91c1c;">${c.title}</h4>
          <div style="font-family: ${bodyFontFamily};">${dishes}</div>
        </div>
      `;
    });

    const printWin = window.open('', '_blank');
    if (!printWin) return;

    printWin.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>${menuTitle} — ${names}</title>
        <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
        <style>
          @page { size: auto; margin: 0.25in; }
          body { margin: 0; padding: 20px; display: flex; justify-content: center; background: #eaedf0; font-family: ${bodyFontFamily}; }
          .menu-card {
            width: ${cardW};
            height: ${cardH};
            background: ${bgStyle};
            color: ${textColor};
            padding: 35px 25px;
            box-sizing: border-box;
            position: relative;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
          }
          .dietary-tag-pill { display: inline-block; font-size: 7.5pt; font-weight: bold; padding: 1px 4px; border-radius: 2px; margin-left: 3px; border: 1px solid #94a3b8; }
          @media print {
            body { background: transparent; padding: 0; }
            .menu-card { box-shadow: none; page-break-inside: avoid; }
          }
        </style>
      </head>
      <body>
        <div class="menu-card">
          <div style="position: absolute; top: 8px; bottom: 8px; left: 8px; right: 8px; border: 1.5px solid ${borderColor}; pointer-events: none;"></div>
          <div style="position: absolute; top: 12px; bottom: 12px; left: 12px; right: 12px; border: 0.75px solid ${innerBorderColor}; pointer-events: none;"></div>
          
          <div style="margin-bottom: 12px;">
            <h1 style="font-family: ${headerFontFamily}; font-size: ${font === 'script' ? '28pt' : '20pt'}; margin: 0 0 2px 0; font-weight: 700; text-transform: ${font === 'script' ? 'none' : 'uppercase'};">${menuTitle}</h1>
            <p style="font-size: 13pt; font-style: italic; margin: 0 0 2px 0;">${names}</p>
            <p style="font-size: 9pt; opacity: 0.7; margin: 0; font-family: 'Montserrat', sans-serif;">${date}</p>
            <div style="width: 40px; border-top: 1.5px solid currentColor; margin: 10px auto; opacity: 0.6;"></div>
          </div>

          <div>${coursesHtml}</div>

          ${showDietary ? `
            <div style="margin-top: 15px; padding-top: 8px; border-top: 0.5px solid currentColor; opacity: 0.65; font-size: 8pt; font-family: 'Montserrat', sans-serif;">
              (V) Vegetarian • (VG) Vegan • (GF) Gluten-Free • (DF) Dairy-Free
            </div>
          ` : ''}
        </div>
        <script>window.onload = function() { window.print(); };<\/script>
      </body>
      </html>
    `);
    printWin.document.close();
  }

  // ── Word Doc Export ──────────────────────────────────────────────────
  function exportWordDoc() {
    const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Charlotte & William';
    const date = (document.getElementById('weddingDate') as HTMLInputElement)?.value || 'October 18, 2026';
    const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'DINNER MENU';

    let coursesContent = '';
    courses.forEach(c => {
      coursesContent += `<h3 style="color:#b91c1c; margin-top:15px; text-transform:uppercase;">${c.title}</h3><ul>`;
      c.items.split('\n').filter(l => l.trim()).forEach(item => {
        coursesContent += `<li style="margin-bottom:4px;">${item}</li>`;
      });
      coursesContent += `</ul>`;
    });

    const content = `
      <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
      <head><title>${menuTitle}</title>
      <style>body { font-family: 'Georgia', serif; font-size: 11pt; } h1, h2 { text-align: center; } ul { list-style-type: square; }</style>
      </head>
      <body>
        <h1 style="letter-spacing: 2px;">${menuTitle}</h1>
        <h2 style="font-weight:normal; font-style:italic;">${names}</h2>
        <p style="text-align:center; color:#666;">${date}</p>
        <hr/>
        ${coursesContent}
        <br/><hr/>
        <p style="font-size:9pt; text-align:center; color:#888;">Manage.Wedding — Free Reception Menu Maker</p>
      </body></html>
    `;

    const blob = new Blob([content], { type: 'application/msword' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'wedding-reception-menu.doc';
    link.click();
  }

  // ── Helpers ─────────────────────────────────────────────────────────
  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) { resolve(); return; }
      const s = document.createElement('script');
      s.src = src; s.onload = () => resolve(); s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  // ── Vector PDF Download (jsPDF) ──────────────────────────────────────
  async function downloadVectorPdf() {
    const btn = document.getElementById('downloadVectorPdfBtn') as HTMLButtonElement;
    if (btn) { btn.textContent = 'Building PDF…'; btn.disabled = true; }

    try {
      await loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js');

      const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Charlotte & William';
      const date  = (document.getElementById('weddingDate')  as HTMLInputElement)?.value || 'October 18, 2026';
      const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'DINNER MENU';
      const size = (document.getElementById('sizePicker') as HTMLSelectElement)?.value || 'dl';

      const { jsPDF } = (window as any).jspdf;
      
      // Dimensions in mm
      let W = 101.6; // 4" in mm
      let H = 228.6; // 9" in mm
      if (size === 'a5') { W = 127; H = 177.8; } // 5x7 in mm
      else if (size === 'a4') { W = 210; H = 297; }

      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: [W, H] });
      const cx = W / 2;

      // Background
      pdf.setFillColor(253, 251, 247);
      pdf.rect(0, 0, W, H, 'F');

      // Double Borders
      pdf.setDrawColor(45, 45, 45);
      pdf.setLineWidth(0.5);
      pdf.rect(6, 6, W - 12, H - 12);

      pdf.setDrawColor(180, 180, 180);
      pdf.setLineWidth(0.2);
      pdf.rect(8, 8, W - 16, H - 16);

      let y = size === 'dl' ? 24 : 20;

      // Title
      pdf.setFont('times', 'bold');
      pdf.setFontSize(size === 'dl' ? 18 : 16);
      pdf.setTextColor(30, 30, 30);
      pdf.text(menuTitle, cx, y, { align: 'center' });
      y += 7;

      // Names
      pdf.setFont('times', 'italic');
      pdf.setFontSize(size === 'dl' ? 13 : 12);
      pdf.setTextColor(50, 50, 50);
      pdf.text(names, cx, y, { align: 'center' });
      y += 5;

      // Date
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(8);
      pdf.setTextColor(120, 120, 120);
      pdf.text(date, cx, y, { align: 'center' });
      y += 5;

      // Divider Line
      pdf.setDrawColor(80, 80, 80);
      pdf.setLineWidth(0.3);
      pdf.line(cx - 15, y, cx + 15, y);
      y += 8;

      // Courses
      courses.forEach((course, i) => {
        if (i > 0) {
          pdf.setDrawColor(180, 180, 180);
          pdf.setLineDashPattern([1, 1], 0);
          pdf.line(cx - 8, y, cx + 8, y);
          pdf.setLineDashPattern([], 0);
          y += 6;
        }

        // Course title
        pdf.setFont('times', 'bold');
        pdf.setFontSize(size === 'dl' ? 11 : 10);
        pdf.setTextColor(180, 45, 35);
        pdf.text(course.title, cx, y, { align: 'center' });
        y += 5;

        // Items
        pdf.setFont('times', 'normal');
        pdf.setFontSize(size === 'dl' ? 9.5 : 8.5);
        pdf.setTextColor(50, 50, 50);
        const rawItems = course.items.split('\n').filter(l => l.trim());
        rawItems.forEach(item => {
          const cleanItem = item.replace(/\[(GF|V|VG|DF|NF)\]/g, '($1)');
          pdf.text(cleanItem, cx, y, { align: 'center' });
          y += 4.5;
        });
        y += 3;
      });

      pdf.save('wedding-reception-menu.pdf');
    } catch (err) {
      console.error('PDF error:', err);
      alert('Could not download vector PDF. Use the Print High-Res Menu button for browser print.');
    } finally {
      if (btn) { btn.textContent = 'Vector PDF'; btn.disabled = false; }
    }
  }

  // ── Init & Event Listeners ──────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    renderEditor();
    renderPreview();

    // Live Listeners
    ['themePicker', 'fontPicker', 'sizePicker', 'coupleNames', 'weddingDate', 'menuTitle', 'check-dietary-key'].forEach(id => {
      const el = document.getElementById(id);
      el?.addEventListener('input', renderPreview);
      el?.addEventListener('change', renderPreview);
    });

    document.getElementById('addCourseBtn')?.addEventListener('click', () => {
      courses.push({ title: 'NEW COURSE', items: 'Signature Dish Description [GF]' });
      renderEditor();
      renderPreview();
      document.getElementById('course-list')?.lastElementChild?.scrollIntoView({ behavior: 'smooth' });
    });

    document.getElementById('printMenuBtn')?.addEventListener('click', printHighResMenu);
    document.getElementById('downloadVectorPdfBtn')?.addEventListener('click', downloadVectorPdf);
    document.getElementById('exportDocBtn')?.addEventListener('click', exportWordDoc);
  });
</script>
