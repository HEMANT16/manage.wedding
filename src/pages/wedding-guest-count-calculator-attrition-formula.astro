---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Wedding Guest Count Calculator: Attrition & Decline Rates (A-List vs B-List Formula)",
      "description": "Calculate your true wedding guest attendance with the 4-tier attrition formula. Learn realistic decline rates for local VIPs, out-of-towners, destination guests, and manage A/B invite waves.",
      "datePublished": "2026-08-18T00:00:00+00:00",
      "dateModified": "2026-08-18T00:00:00+00:00",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding",
        "logo": {
          "@type": "ImageObject",
          "url": "https://manage.wedding/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://manage.wedding/wedding-guest-count-calculator-attrition-formula"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What percentage of wedding guests decline an invitation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On average, 15% to 20% of invited guests decline a standard local wedding. However, decline rates range from 5% for close local family members to 45%–60% for international and destination weddings."
          }
        },
        {
          "@type": "Question",
          "name": "How does an A-List and B-List wedding invitation system work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A-List invitations are mailed 10 to 12 weeks before the wedding with an early RSVP deadline (7 weeks prior). As declines arrive, B-List invitations are immediately sent in rolling waves with a standard 3 to 4-week deadline without guests realizing they were on a secondary list."
          }
        },
        {
          "@type": "Question",
          "name": "Should you invite more guests than your venue's maximum fire capacity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never invite more guests than the venue's legal capacity under the assumption that 20% will decline. If attendance exceeds expectations, venues will legally enforce capacity limits and turn guests away at the door."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Wedding Guest Count Calculator: Attrition & Decline Rates (A-List vs B-List Formula) | Manage.Wedding"
  description="Accurately predict wedding guest attendance using the 4-tier attrition formula. Calculate local vs out-of-town decline rates and execute A/B list invitations."
  schema={schema}
>
  <main class="container" style="padding-top: 2rem; padding-bottom: 4rem; max-width: 900px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
        { name: "Wedding Guest Count Calculator" }
      ]}
    />

    <!-- Header Section -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #eff6ff; color: #1e40af; padding: 4px 12px; border-radius: 20px; border: 1.5px solid #3b82f6; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <span>👥</span>
        <span>Guest List Analytics & Attrition Mathematics</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
        Wedding Guest Count Calculator: Attrition & Decline Rates <span style="color: #1d4ed8; font-style: italic;">(A-List vs B-List Formula)</span>
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;">
        <span>Published: August 2026</span>
        <span>•</span>
        <span>9 min read</span>
        <span>•</span>
        <span>By Manage.Wedding Editorial Team</span>
      </div>
    </header>

    <!-- AI Direct Citation Callout (BLUF) -->
    <div style="background: #eff6ff; border: 2px solid #2563eb; border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: 3px 3px 0px #2563eb;">
      <div style="font-size: 0.82rem; font-weight: 800; color: #1e40af; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem;">
        🎯 Guest Attrition Baseline (BLUF)
      </div>
      <p class="font-body" style="font-size: 1.15rem; color: #1e3a8a; font-weight: 600; line-height: 1.5; margin: 0;">
        On average 15% to 20% of invited wedding guests will decline; local VIPs attend at 95%, local guests at 85%, domestic traveling guests at 65% to 75%, and international guests at 40% to 50%.
      </p>
    </div>

    <!-- Interactive Tool Callout Hero -->
    <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
          Calculate Your Final Guest Headcount
        </h3>
        <p class="font-body" style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
          Categorize your invite list by travel distance and VIP tiers to predict final attendance within ±3 guests.
        </p>
      </div>
      <a href="/guest-count-estimator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 10px 22px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.5rem;">
        <span>Open Guest Estimator</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Main Content Body -->
    <article class="font-body" style="font-size: 1.1rem; line-height: 1.7; color: var(--fg-pencil);">
      
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2rem 0 1rem;">
        The Flaw in the "80% Attendance Rule"
      </h2>
      <p>
        Most wedding planning books advise couples to invite 125 people for a 100-person venue, assuming an arbitrary 80% attendance rate.
      </p>
      <p>
        In practice, applying a flat 80% multiplier causes either <strong>severe over-crowding</strong> (if you invite mostly close local friends who attend at 90%+) or <strong>empty tables and lost minimums</strong> (if you host a Sunday or holiday weekend wedding where out-of-state guests decline at 35%+).
      </p>

      <!-- The 4-Tier Attrition Formula Table -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The 4-Tier Attendance Probability Matrix
      </h2>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Guest Tier & Category</th>
              <th style="padding: 12px 14px; font-weight: 800;">Expected Attendance Rate</th>
              <th style="padding: 12px 14px; font-weight: 800;">Decline Probability</th>
              <th style="padding: 12px 14px; font-weight: 800;">Primary Reasons for Decline</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f0fdf4;">
              <td style="padding: 12px 14px; font-weight: 700;">🌟 Tier 1: Local VIPs & Wedding Party</td>
              <td style="padding: 12px 14px; font-weight: 800; color: #16a34a;">95% – 98%</td>
              <td style="padding: 12px 14px; font-weight: 600; color: #16a34a;">2% – 5%</td>
              <td style="padding: 12px 14px; color: #475569;">Immediate family, bridesmaids, groomsmen, childhood best friends</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">🚗 Tier 2: Local Friends & Extended Family</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #0284c7;">85% – 90%</td>
              <td style="padding: 12px 14px; font-weight: 600; color: #0284c7;">10% – 15%</td>
              <td style="padding: 12px 14px; color: #475569;">Local coworkers, cousins, neighbors (&lt;1 hr drive)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #fffbeb;">
              <td style="padding: 12px 14px; font-weight: 700;">✈️ Tier 3: Domestic Out-of-State Guests</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #b45309;">65% – 75%</td>
              <td style="padding: 12px 14px; font-weight: 600; color: #b45309;">25% – 35%</td>
              <td style="padding: 12px 14px; color: #475569;">Requires flights, 2 nights hotel, childcare, PTO</td>
            </tr>
            <tr style="background: #fef2f2;">
              <td style="padding: 12px 14px; font-weight: 700;">🌍 Tier 4: International & Destination</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #dc2626;">40% – 50%</td>
              <td style="padding: 12px 14px; font-weight: 800; color: #dc2626;">50% – 60%</td>
              <td style="padding: 12px 14px; color: #475569;">International passports, currency conversion, high travel expense</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- A-List vs B-List Strategy -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The Seamless A-List and B-List Invitation Timeline
      </h2>
      <p>
        Executing an A/B invitation system allows couples to hit their exact venue maximum without overspending or offending guests:
      </p>

      <div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; margin: 1.5rem 0; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <ul style="margin: 0; padding-left: 1.25rem; font-size: 0.95rem; line-height: 1.7;">
          <li style="margin-bottom: 0.5rem;">
            <strong>Step 1 (10–12 Weeks Out):</strong> Mail A-List invitations. Print an RSVP deadline for <strong>7 weeks before the wedding</strong>.
          </li>
          <li style="margin-bottom: 0.5rem;">
            <strong>Step 2 (7–8 Weeks Out):</strong> As A-List declines arrive, immediately mail B-List invitations with a standard <strong>3-week deadline</strong> printed on their cards.
          </li>
          <li>
            <strong>Step 3 (4 Weeks Out):</strong> Close all RSVPs and submit your exact guaranteed headcount to the caterer and venue coordinator.
          </li>
        </ul>
      </div>

      <!-- Bottom Interactive CTA Section -->
      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 2rem; box-shadow: 4px 4px 0px var(--fg-pencil); text-align: center; margin: 3rem 0;">
        <h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
          Estimate Your Custom Guest Headcount
        </h3>
        <p class="font-body" style="font-size: 1.05rem; max-width: 600px; margin: 0 auto 1.5rem; color: var(--text-secondary);">
          Our interactive calculator uses 4-tier attrition weighting to forecast your final guest count, meal numbers, and table counts.
        </p>
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="/guest-count-estimator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 12px 24px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Open Guest Estimator &rarr;
          </a>
          <a href="/rsvp-tracker" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 12px 20px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            RSVP Tracker &rarr;
          </a>
        </div>
      </div>

    </article>

    <RelatedTools currentPath="/wedding-guest-count-calculator-attrition-formula" category="guests-seating" />
  </main>
</Layout>
