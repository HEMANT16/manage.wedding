---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Catering Cost Estimator & Per-Person Price Calculator",
      "url": "https://manage.wedding/catering-cost-estimator",
      "description": "Free wedding catering cost estimator. Calculate exact food, bar, rentals, service charges (plus-plus), and taxes across plated, buffet, and cocktail receptions. Export to Word, PDF, or Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Estimate Full Wedding Catering & Banquet Costs",
      "description": "Step-by-step method to calculate total reception food, bar packages, rentals, service gratuities, and plus-plus taxes.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Select Meal Style & Menu Tier",
          "text": "Choose Plated Dinner, Buffet, Family Style, or Heavy Cocktail Stations and select your appetizer and dessert configurations."
        },
        {
          "@type": "HowToStep",
          "name": "Configure Bar Packages & Tableware Rentals",
          "text": "Select Open Bar (Beer & Wine or Full Liquor) and itemize china, flatware, glassware, and linen rental fees."
        },
        {
          "@type": "HowToStep",
          "name": "Enter Headcount & Staffing Details",
          "text": "Provide guest count, banquet event duration, and staffing ratios for kitchen chefs, captains, and bussers."
        },
        {
          "@type": "HowToStep",
          "name": "Factor in Mandatory Plus-Plus Fees (Service & Tax)",
          "text": "Apply caterer administrative service charges (18%–24%) and local sales tax (6%–10%) to determine the all-inclusive per-person rate."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the average catering cost per person for a wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The average wedding catering cost ranges from $75 to $150 per guest for food and non-alcoholic drinks. When full open bar, 20-24% service charges, and state sales taxes are added, the true all-inclusive cost typically lands between $120 and $220 per guest."
          }
        },
        {
          "@type": "Question",
          "name": "Is a buffet cheaper than a plated dinner at a wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not always. While buffets require fewer servers (saving on staffing hours), they require 20-30% more food volume because guests serve themselves generous portions. Plated dinners offer exact portion control, so high-end buffets often cost the same as standard plated meals."
          }
        },
        {
          "@type": "Question",
          "name": "What does '++' (plus-plus) mean on a wedding catering quote?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "'Plus-plus' (++) indicates that service charges (typically 20-24%) and local sales tax (6-10%) will be added on top of the base per-person menu price. A $100/person base menu usually ends up costing $130-$135 per person after plus-plus fees."
          }
        },
        {
          "@type": "Question",
          "name": "How do I export my calculated catering estimate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Click the 'Export Word (.doc)', 'Export PDF / Print', or 'Export Excel (.csv)' button at the top of the estimator. You will receive an itemized proposal comparison sheet ready to send to prospective caterers or banquet halls."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Catering Cost Estimator (Free Per-Person Price Calculator & Word Export) | Manage.Wedding"
	description="Instantly calculate full wedding catering costs. Compare plated, buffet, family-style, cocktail stations, and bar packages with hidden fees and Word/PDF exports."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Wedding Catering Cost Estimator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Uncover the true all-inclusive cost of wedding food, open bar packages, table rentals, service fees (plus-plus), and taxes. Export to <strong>Word (.doc)</strong>, <strong>PDF</strong>, or <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Editorial Guide Interlink Banner -->
		<div style="background: #fef3c7; border: 2px solid #d97706; border-radius: 8px; padding: 1rem 1.5rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; box-shadow: 2px 2px 0px #d97706;">
			<div style="display: flex; align-items: center; gap: 0.75rem;">
				<span style="font-size: 1.5rem;">🍽️</span>
				<div>
					<strong style="color: #92400e; font-size: 0.95rem; display: block;">Comparing Plated vs Buffet Catering Packages?</strong>
					<span style="color: #78350f; font-size: 0.88rem;">Read our comprehensive guide on <a href="/catering-cost-per-person-wedding-buffet-vs-plated" style="color: #92400e; text-decoration: underline; font-weight: 700;">Catering Cost Per Person: Buffet vs Plated vs Family Style (Real Math)</a>.</span>
				</div>
			</div>
			<a href="/catering-cost-per-person-wedding-buffet-vs-plated" style="background: #b45309; color: #fff; text-decoration: none; font-weight: 700; font-size: 0.85rem; padding: 6px 14px; border-radius: 6px; border: 1px solid #78350f; white-space: nowrap;">
				Read Guide &rarr;
			</a>
		</div>

		<!-- Main Workspace Grid: Configurator + Real-Time Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="catering-calc-grid">
			
			<!-- Left Column: Input Form & Package Controls -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							🍽️ Banquet & Menu Options
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Configure food, bar, rentals, and service tier
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Currency:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="$" selected>$ (USD/CAD/AUD)</option>
							<option value="£">£ (GBP)</option>
							<option value="€">€ (EUR)</option>
							<option value="₹">₹ (INR)</option>
						</select>
					</div>
				</div>

				<form id="catering-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Guest Count & Vendor Meals -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
						<div>
							<label for="input-guest-count" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Guest Count *
							</label>
							<input type="number" id="input-guest-count" value="100" min="10" max="1000" required style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
						</div>

						<div>
							<label for="input-vendor-meals" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Vendor Meals (Photo, DJ)
							</label>
							<input type="number" id="input-vendor-meals" value="4" min="0" max="30" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
						</div>
					</div>

					<!-- Meal Service Style -->
					<div>
						<label for="select-meal-style" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Meal Service Style
						</label>
						<select id="select-meal-style" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: #fff;">
							<option value="65" selected>Plated 3-Course Dinner ($65 / guest base)</option>
							<option value="50">Buffet Style (2 Entrees & Sides) ($50 / guest base)</option>
							<option value="58">Family Style Shared Platters ($58 / guest base)</option>
							<option value="45">Heavy Cocktail & Food Stations ($45 / guest base)</option>
							<option value="35">Food Truck / Casual Festivity ($35 / guest base)</option>
							<option value="38">Brunch Buffet & Waffle Bar ($38 / guest base)</option>
						</select>
					</div>

					<!-- Passed Appetizers / Cocktail Hour -->
					<div>
						<label for="select-appetizers" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Cocktail Hour Appetizers
						</label>
						<select id="select-appetizers" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="0">None / Included in Venue Package ($0)</option>
							<option value="14" selected>3 Passed Hors d'Oeuvres ($14 / guest)</option>
							<option value="22">5 Passed Hors d'Oeuvres + Grazing Table ($22 / guest)</option>
							<option value="30">Luxury Seafood & Charcuterie Raw Bar ($30 / guest)</option>
						</select>
					</div>

					<!-- Bar & Beverage Package -->
					<div>
						<label for="select-bar-package" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Bar & Beverage Package (4-5 Hours)
						</label>
						<select id="select-bar-package" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="0">Dry Reception / Non-Alcoholic Only ($0 / guest)</option>
							<option value="8">BYO Alcohol (Bar Service & Mixers Only) ($8 / guest)</option>
							<option value="20">Beer, Wine & Champagne Toast ($20 / guest)</option>
							<option value="32" selected>Full Standard Open Bar (Liquor, Beer, Wine) ($32 / guest)</option>
							<option value="46">Premium Top-Shelf Open Bar & Cocktails ($46 / guest)</option>
						</select>
					</div>

					<!-- Rentals & Dinnerware -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
						<div>
							<label for="select-rentals" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Tableware & Linens
							</label>
							<select id="select-rentals" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff;">
								<option value="0">Provided by Venue ($0)</option>
								<option value="10" selected>Standard China & Linen ($10/p)</option>
								<option value="20">Upgraded Vintage / Gold ($20/p)</option>
							</select>
						</div>

						<div>
							<label for="select-dessert-fee" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Cake Cutting / Dessert
							</label>
							<select id="select-dessert-fee" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff;">
								<option value="0">No Cake Cutting Fee ($0)</option>
								<option value="3" selected>Standard Cake Slicing ($3/p)</option>
								<option value="8">Full Caterer Dessert Bar ($8/p)</option>
							</select>
						</div>
					</div>

					<!-- Plus-Plus Fees (Service Charge & Tax) -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-service-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Service Charge (Plus-Plus)
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-service-pct" value="20" min="0" max="35" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>

						<div>
							<label for="input-tax-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Sales Tax Rate
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-tax-pct" value="8" min="0" max="20" step="0.5" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Surcharge Comparison -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								📋 Estimated Catering Invoice
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								All-inclusive food, bar, plus-plus & tax
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Cost Per Head vs Total Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Grand Total Invoice -->
						<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--accent-red); display: block; font-weight: bold;">Grand Total Invoice</span>
							<strong id="res-grand-total" class="font-heading" style="font-size: 2.2rem; color: var(--accent-red); display: block; line-height: 1.2;">$15,681</strong>
							<span id="res-total-guest-note" style="font-size: 0.75rem; color: var(--accent-red);">All fees included</span>
						</div>

						<!-- All-Inclusive Cost Per Head -->
						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block; font-weight: bold;">True Cost Per Guest</span>
							<strong id="res-per-head" class="font-heading" style="font-size: 2.2rem; color: var(--accent-blue); display: block; line-height: 1.2;">$156.81</strong>
							<span id="res-base-diff-note" style="font-size: 0.75rem; color: #1e40af;">Base was $65.00</span>
						</div>

					</div>

					<!-- Itemized Invoice Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Line-Item Expense Breakdown
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🥗 Base Food & Appetizers:</td>
									<td id="res-food-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$7,900.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍷 Bar & Beverage Package:</td>
									<td id="res-bar-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$3,200.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍽️ Table Rentals & Cake Fee:</td>
									<td id="res-rentals-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$1,300.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍱 Vendor Crew Meals (50% off):</td>
									<td id="res-vendor-meals-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$130.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Subtotal (Food + Bar + Rentals):</td>
									<td id="res-pretax-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$12,530.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-red);">
									<td style="padding: 0.4rem 0;">➕ Service Charge (20%):</td>
									<td id="res-service-charge" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$2,506.00</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil);">
									<td style="padding: 0.4rem 0;">🏛️ State Sales Tax (8%):</td>
									<td id="res-sales-tax" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$645.00</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Proportional Cost Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Food & Bar (75%)</span>
							<span style="color: var(--accent-red);">Service & Tax (25%)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-food-portion" style="width: 75%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-fees-portion" style="width: 25%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Planner Surcharge Alert Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						⚠️ The 30% "Plus-Plus" Reality Check:
					</strong>
					<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; color: var(--fg-pencil);">
						Notice how a base menu of <strong>$65/head</strong> jumps to <strong>$156.81/head</strong> once cocktail hors d'oeuvres, open bar, 20% service fees, and 8% taxes are factored in. Never evaluate a catering quote on food alone!
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Official Wedding Catering Estimate</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Guest Count: <span id="print-guests"></span> | All-Inclusive Total: <span id="print-total"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Invoice Item</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 100px; text-align: center;">Per Head</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 120px; text-align: right;">Total Amount</th>
					</tr>
				</thead>
				<tbody id="print-invoice-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
