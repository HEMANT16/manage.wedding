		const guests = parseInt(guestCountInput.value) || 0;
		const vendors = parseInt(vendorMealsInput.value) || 0;

		const mealBasePerHead = parseFloat(mealStyleSelect.value) || 0;
		const appPerHead = parseFloat(appetizersSelect.value) || 0;
		const barPerHead = parseFloat(barPackageSelect.value) || 0;
		const rentalPerHead = parseFloat(rentalsSelect.value) || 0;
		const dessertPerHead = parseFloat(dessertFeeSelect.value) || 0;

		const servicePct = (parseFloat(servicePctInput.value) || 0) / 100;
		const taxPct = (parseFloat(taxPctInput.value) || 0) / 100;

		// Subtotals
		const foodSubtotal = guests * (mealBasePerHead + appPerHead);
		const barSubtotal = guests * barPerHead;
		const rentalsSubtotal = guests * (rentalPerHead + dessertPerHead);
		const vendorMealsSubtotal = vendors * (mealBasePerHead * 0.5); // 50% crew discount

		const pretaxSubtotal = foodSubtotal + barSubtotal + rentalsSubtotal + vendorMealsSubtotal;
		const serviceCharge = pretaxSubtotal * servicePct;
		const salesTax = (pretaxSubtotal + serviceCharge) * taxPct;
		const grandTotal = pretaxSubtotal + serviceCharge + salesTax;

		const trueCostPerHead = guests > 0 ? (grandTotal / guests) : 0;

		// Update DOM
		resGrandTotal.textContent = formatMoney(grandTotal);
		resPerHead.textContent = `${currencySymbol}${trueCostPerHead.toFixed(2)}`;
		resTotalGuestNote.textContent = `Based on ${guests} guests`;
		resBaseDiffNote.textContent = `Base meal was ${currencySymbol}${mealBasePerHead.toFixed(2)}`;

		resFoodSubtotal.textContent = formatMoney(foodSubtotal);
		resBarSubtotal.textContent = formatMoney(barSubtotal);
		resRentalsSubtotal.textContent = formatMoney(rentalsSubtotal);
		resVendorMealsSubtotal.textContent = formatMoney(vendorMealsSubtotal);
		resPretaxSubtotal.textContent = formatMoney(pretaxSubtotal);
		resServiceCharge.textContent = formatMoney(serviceCharge);
		resSalesTax.textContent = formatMoney(salesTax);

		// Proportions
		if (grandTotal > 0) {
			const directFoodBarPct = Math.round((pretaxSubtotal / grandTotal) * 100);
			const feePct = 100 - directFoodBarPct;
			barFoodPortion.style.width = `${directFoodBarPct}%`;
			barFeesPortion.style.width = `${feePct}%`;
		}
	}

	// Listeners
	[guestCountInput, vendorMealsInput, servicePctInput, taxPctInput].forEach(el => el.addEventListener('input', calculateCatering));
	[mealStyleSelect, appetizersSelect, barPackageSelect, rentalsSelect, dessertFeeSelect, currencySelect].forEach(el => el.addEventListener('change', calculateCatering));

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const guests = parseInt(guestCountInput.value) || 0;
		const mealText = mealStyleSelect.options[mealStyleSelect.selectedIndex].text;
		const barText = barPackageSelect.options[barPackageSelect.selectedIndex].text;

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Wedding Catering Proposal Estimate</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Official Catering Cost Estimate</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Guest Count: <strong>${guests}</strong> | True Cost Per Head: <strong>${resPerHead.textContent}</strong></p>
				
				<h3>Selected Catering Services:</h3>
				<p>• <strong>Meal Service:</strong> ${mealText}</p>
				<p>• <strong>Bar Package:</strong> ${barText}</p>

				<h3>Itemized Invoice Breakdown:</h3>
				<table>
					<thead>
						<tr><th>Line Item</th><th style="text-align:right;">Subtotal Amount</th></tr>
					</thead>
					<tbody>
						<tr><td>Base Food & Appetizers</td><td style="text-align:right;">${resFoodSubtotal.textContent}</td></tr>
						<tr><td>Bar & Beverage Package</td><td style="text-align:right;">${resBarSubtotal.textContent}</td></tr>
						<tr><td>Tableware Rentals & Cake Fee</td><td style="text-align:right;">${resRentalsSubtotal.textContent}</td></tr>
						<tr><td>Vendor Meals</td><td style="text-align:right;">${resVendorMealsSubtotal.textContent}</td></tr>
						<tr style="background:#f9f9f9; font-weight:bold;"><td>Direct Subtotal</td><td style="text-align:right;">${resPretaxSubtotal.textContent}</td></tr>
						<tr><td>Service Charge (${servicePctInput.value}%)</td><td style="text-align:right;">${resServiceCharge.textContent}</td></tr>
						<tr><td>Sales Tax (${taxPctInput.value}%)</td><td style="text-align:right;">${resSalesTax.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;"><td>Grand Total Invoice</td><td style="text-align:right; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Catering_Estimate_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const guests = guestCountInput.value;
		document.getElementById('print-date').textContent = new Date().toLocaleDateString();
		document.getElementById('print-guests').textContent = guests;
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-invoice-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Base Food & Cocktail Appetizers</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${guests} Guests</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFoodSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Bar & Beverage Service</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${guests} Guests</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBarSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Table Rentals & Dessert Service</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${guests} Guests</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resRentalsSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Vendor Crew Meals</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${vendorMealsInput.value} Vendors</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resVendorMealsSubtotal.textContent}</td></tr>
			<tr style="background:#fafafa;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Direct Subtotal</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPretaxSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Plus-Plus Service Charge (${servicePctInput.value}%)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resServiceCharge.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">State Sales Tax (${taxPctInput.value}%)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resSalesTax.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:14px;">Grand Total All-Inclusive</td><td style="border:1px solid #ccc; padding:6px; text-align:center; font-weight:bold;">${resPerHead.textContent} / guest</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:14px;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Invoice Line Item,Amount\n";
		csv += `"Base Food & Appetizers","${resFoodSubtotal.textContent}"\n`;
		csv += `"Bar & Beverage Package","${resBarSubtotal.textContent}"\n`;
		csv += `"Table Rentals & Cake Cutting","${resRentalsSubtotal.textContent}"\n`;
		csv += `"Vendor Crew Meals","${resVendorMealsSubtotal.textContent}"\n`;
		csv += `"Direct Subtotal","${resPretaxSubtotal.textContent}"\n`;
		csv += `"Service Charge (${servicePctInput.value}%)","${resServiceCharge.textContent}"\n`;
		csv += `"Sales Tax (${taxPctInput.value}%)","${resSalesTax.textContent}"\n`;
		csv += `"Grand Total All-Inclusive","${resGrandTotal.textContent}"\n`;
		csv += `"True Cost Per Guest","${resPerHead.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Catering_Estimate_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateCatering();
</script>
