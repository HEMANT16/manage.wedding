---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Master Wedding Budget Calculator",
      "url": "https://manage.wedding/master-budget-calculator",
      "description": "Free master wedding budget calculator. Break down venue, catering, photography, attire, and decor costs, track per-guest expenses, and export to Word, PDF, or Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the recommended percentage breakdown for a wedding budget?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The standard industry allocation is: 45-50% for Venue & Catering, 12-15% for Photography & Videography, 8-10% for Attire & Beauty, 8-10% for Flowers & Decor, 8-10% for Music & Entertainment, 3% for Stationery & Invitations, 2% for Favors/Gifts, and 5% for an Emergency Buffer & Hidden Fees."
          }
        },
        {
          "@type": "Question",
          "name": "How does guest count impact total wedding costs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Roughly 50% to 60% of all wedding costs are variable per-person expenses (food, alcohol, rentals, cake, stationery, centerpieces). Reducing your guest count by just 20 people can easily save $3,000 to $6,000 from your total budget."
          }
        },
        {
          "@type": "Question",
          "name": "What hidden fees should be factored into a wedding budget?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Always budget for: 18-24% venue service charges, state/local sales tax (6-10%), vendor meals ($30-$60 each for photographer/DJ), cake cutting and corkage fees ($2-$5/guest), dress alterations ($300-$800), and vendor tips."
          }
        },
        {
          "@type": "Question",
          "name": "How do I export my calculated budget to Word, PDF, or Excel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Click the 'Export Word (.doc)', 'Export PDF / Print', or 'Export Excel (.csv)' button at the top of the budget dashboard. You will instantly receive an itemized financial spreadsheet and summary report."
          }
        }
      ]
    }
  ]
};

const defaultCategories = [
  { id: 'venue', name: 'Venue & Catering', defaultPct: 48, color: '#ffb3ba', desc: 'Reception venue rental, dinner, cocktail appetizers & open bar' },
  { id: 'photo', name: 'Photography & Video', defaultPct: 13, color: '#bae1ff', desc: 'Full-day photo coverage, second shooter, video highlight reel' },
  { id: 'attire', name: 'Attire & Beauty', defaultPct: 9, color: '#ffdfba', desc: 'Wedding dress, suit/tuxedo, alterations, hair & makeup' },
  { id: 'florals', name: 'Flowers & Decor', defaultPct: 8, color: '#baffc9', desc: 'Bouquets, ceremony arch, centerpieces, lighting & rentals' },
  { id: 'entertain', name: 'Music & Entertainment', defaultPct: 7, color: '#ffffba', desc: 'DJ, MC, ceremony musicians, or live reception band' },
  { id: 'rings', name: 'Rings & Officiant', defaultPct: 4, color: '#fbcfe8', desc: 'Wedding bands, marriage license & officiant fee' },
  { id: 'stationery', name: 'Stationery & Postage', defaultPct: 3, color: '#e8baff', desc: 'Save-the-dates, invitations, postage, menus & signage' },
  { id: 'favors', name: 'Favors & Gifts', defaultPct: 2, color: '#fed7aa', desc: 'Bridal party gifts, parent tokens & guest welcome bags' },
  { id: 'transport', name: 'Transportation', defaultPct: 2, color: '#ccfbf1', desc: 'Getaway car, bridal shuttle & guest party bus' },
  { id: 'buffer', name: 'Emergency Buffer & Tax', defaultPct: 4, color: '#e5e7eb', desc: 'Sales tax, vendor meals, overtime & unexpected expenses' }
];
---

<Layout 
	title="Master Wedding Budget Calculator (Free Cost Breakdown & Excel Export) | Manage.Wedding"
	description="Easily calculate and track your master wedding budget. Break down costs for venue, catering, photo, attire, and decor with instant Word, PDF, and CSV exports."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Master Wedding Budget Calculator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Allocate your wedding funds intelligently across venue, catering, photo, and attire. Factor in hidden fees, track cost-per-guest, and export to <strong>Word (.doc)</strong>, <strong>PDF</strong>, or <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Budget Overview Dashboard & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div style="flex: 1; min-width: 250px;">
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💰 Wedding Financial Planner
					</h2>
					<p class="font-body" style="color: var(--text-secondary); font-size: 0.9rem; margin: 0.2rem 0 0 0; text-align: center;">
						Adjust allocations and export your custom budget
					</p>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; width: 100%;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Export Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Export PDF / Print
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Export Excel (.csv)
					</button>
					<button type="button" id="btn-reset-defaults" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						🔄 Reset Industry Standard
					</button>
				</div>
			</div>

			<!-- Preset Budget Tiers -->
			<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
				<span class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
					⚡ Popular Wedding Budget Tiers:
				</span>
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center;">
					<button type="button" class="tier-btn" data-amt="15000" data-guests="50">🪙 Intimate DIY ($15,000 • 50 Guests)</button>
					<button type="button" class="tier-btn active-tier" data-amt="35000" data-guests="120">💎 US Average ($35,000 • 120 Guests)</button>
					<button type="button" class="tier-btn" data-amt="65000" data-guests="150">👑 Elegant Luxury ($65,000 • 150 Guests)</button>
					<button type="button" class="tier-btn" data-amt="120000" data-guests="200">✨ Ultra-Luxe ($120,000 • 200 Guests)</button>
				</div>
			</div>

			<!-- Core Global Inputs: Total Budget, Currency & Guest Count -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
				
				<!-- Total Budget -->
				<div>
					<label for="total-budget-input" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Total Wedding Budget
					</label>
					<div style="display: flex; align-items: center; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; overflow: hidden;">
						<span id="currency-symbol-display" style="padding: 0.6rem 0.8rem; background: var(--bg-paper); border-right: 1px solid var(--fg-pencil); font-weight: bold; font-family: var(--font-heading);">$</span>
						<input type="number" id="total-budget-input" value="35000" min="500" step="500" style="flex: 1; border: none; padding: 0.6rem; font-family: var(--font-body); font-size: 1.2rem; font-weight: bold; outline: none; background: transparent;">
					</div>
				</div>

				<!-- Currency Selector -->
				<div>
					<label for="currency-select" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Currency Symbol
					</label>
					<select id="currency-select" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff;">
						<option value="$" selected>$ (USD / CAD / AUD)</option>
						<option value="£">£ (GBP - British Pound)</option>
						<option value="€">€ (EUR - Euro)</option>
						<option value="₹">₹ (INR - Indian Rupee)</option>
						<option value="¥">¥ (JPY / CNY)</option>
					</select>
				</div>

				<!-- Estimated Guest Count -->
				<div>
					<label for="guest-count-input" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Estimated Guest Count
					</label>
					<input type="number" id="guest-count-input" value="120" min="5" max="1000" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: #fff;">
				</div>

			</div>

			<!-- Dynamic Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total Budget</span>
					<strong id="stat-total-display" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">$35,000</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">100% Allocated</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Cost Per Guest</span>
					<strong id="stat-per-guest" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">$291.67</strong>
					<span id="stat-guest-count-note" style="font-size: 0.75rem; color: #1e40af; display: block;">Based on 120 guests</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Venue & Catering (48%)</span>
					<strong id="stat-venue-amt" class="font-heading" style="font-size: 1.8rem; color: #15803d;">$16,800</strong>
					<span style="font-size: 0.75rem; color: #166534; display: block;">Primary fixed expense</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Buffer & Tax (4%)</span>
					<strong id="stat-buffer-amt" class="font-heading" style="font-size: 1.8rem; color: #a16207;">$1,400</strong>
					<span style="font-size: 0.75rem; color: #854d0e; display: block;">Safety cushion</span>
				</div>
			</div>

			<!-- Visual Stacked Expense Distribution Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Allocated Expense Breakdown</span>
					<span id="pct-warning" class="font-body" style="font-size: 0.85rem; color: #15803d; font-weight: bold;">100% Allocated (Perfect)</span>
				</div>
				<div id="stacked-budget-bar" style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #e5e0d8; margin-bottom: 0.75rem;">
					<!-- Injected via JS -->
				</div>
			</div>

		</div>

		<!-- Interactive Category Allocation Grid -->
		<section style="margin-bottom: 3.5rem;">
			<h2 class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); text-align: center; margin-bottom: 0.5rem;">
				📊 Itemized Category Allocations
			</h2>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); text-align: center; max-width: 600px; margin: 0 auto 1.75rem;">
				Adjust percentage sliders or edit amounts directly. All categories stay in sync in real time.
			</p>

			<div id="categories-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem;">
				<!-- Injected via JS -->
			</div>
		</section>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Official Master Wedding Budget</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Total Budget: <span id="print-total"></span> | Per-Guest: <span id="print-per-guest"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Category</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 60px; text-align: center;">% Share</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 100px; text-align: right;">Allocated Budget</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Scope & Expenses Included</th>
					</tr>
				</thead>
				<tbody id="print-table-body"></tbody>
			</table>
		</div>

		<!-- SEO Article & Comprehensive Guide (Centered Headings) -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Financial Planning Playbook</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					The Complete Wedding Budget Breakdown & Allocation Guide
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					How to build a realistic wedding budget, avoid hidden vendor fees, and allocate every dollar without going into debt.
				</p>
			</div>

			<div style="margin-bottom: 2.5rem; text-align: center;">
				<img 
					src="/images/calculator_sketch.jpg" 
					alt="Hand drawn line art sketch of a calculator sitting on a wedding budget planning notebook" 
					style="width: 100%; max-height: 420px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); margin: 0 auto; display: block;"
				/>
				<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin-top: 0.5rem; font-style: italic;">
					Tracking per-guest allocations ensures venue and catering costs never spiral out of control.
				</p>
			</div>

			<!-- Section 1: The 50/15/10 Rule -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. The 50 / 15 / 10 Industry Standard Budget Rule
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1rem;">
					Financial planners and wedding coordinators recommend organizing your expenses into 5 foundational buckets to avoid running out of funds before hiring key vendors:
				</p>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin: 1.5rem 0;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-red); margin-bottom: 0.5rem; text-align: center;">
							45% - 50%: Reception Experience
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.5; margin: 0;">
							The physical venue rental, passed appetizers, multi-course dinner, open bar alcohol, service staff, tables, chairs, and dinnerware rentals.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-blue); margin-bottom: 0.5rem; text-align: center;">
							12% - 15%: Memories & Media
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.5; margin: 0;">
							Full-day photography, second shooter, videography highlight film, drone aerial footage, and physical heirloom wedding photo albums.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: #16a34a; margin-bottom: 0.5rem; text-align: center;">
							8% - 10%: Florals & Atmosphere
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.5; margin: 0;">
							Bridal bouquets, ceremony arch installations, table centerpieces, candlelight, and special ambient uplighting.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: #d97706; margin-bottom: 0.5rem; text-align: center;">
							8% - 10%: Attire & Beauty
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.5; margin: 0;">
							Wedding dress, veil, suit/tuxedo, alterations, shoes, bridal accessories, trial hair, and day-of professional makeup.
						</p>
					</div>
				</div>
			</section>

			<!-- Section 2: Hidden Fees -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					2. The 6 "Hidden" Wedding Costs That Blindside Couples
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1rem;">
					Vendors rarely mention taxes and gratuities on their base menu pricing. Always factor in these additional charges:
				</p>
				
				<div style="background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.5rem;">
					<ul class="font-body" style="padding-left: 1.2rem; line-height: 1.8; font-size: 1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Venue Service Charges (18% - 24%):</strong> Almost every banquet hall and hotel adds a mandatory administrative fee on top of food and beverage totals.</li>
						<li><strong>State & City Sales Tax (6% - 10%):</strong> Applied on all catering, rentals, and floral deliverables.</li>
						<li><strong>Cake Cutting & Corkage Fees ($2 - $6 / guest):</strong> If you bring your own cake or wine, venues charge service fees to slice or uncork it.</li>
						<li><strong>Vendor Meals ($30 - $60 each):</strong> Your photographer, videographer, DJ, and coordinator work 8-10 hour days and require a hot meal during reception dinner.</li>
						<li><strong>Dress Alteration & Bustle Surcharges ($400 - $900):</strong> Hemming lace and installing a 5-point bustle is almost never included in gown purchase prices.</li>
						<li><strong>Setup & Breakdown Overtime Fees ($150 - $300 / hr):</strong> If the party runs past venue curfews, overtime fees add up rapidly.</li>
					</ul>
				</div>
			</section>

			<!-- Section 3: Cost Per Guest Math -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					3. Why Guest Count Is the #1 Budget Dial You Can Turn
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1rem;">
					Many couples try to save money by cutting back on flowers or hiring a cheaper DJ. However, <strong>over 55% of your total wedding costs are variable per-head expenses</strong> (appetizers, entrees, open bar drinks, champagne toasts, place cards, chair rentals, and cake slices).
				</p>
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
					<p class="font-body" style="margin: 0; font-size: 1.05rem; line-height: 1.6;">
						💡 <strong>The Math:</strong> At an average cost of <strong>$250 to $350 per guest</strong>, reducing your guest list from 150 to 120 guests immediately frees up <strong>$7,500 to $10,500</strong> in real cash savings without compromising on your dream venue or photographer!
					</p>
				</div>
			</section>

			<!-- Section 4: Related Tools -->
			<section style="margin-bottom: 3rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.5rem;">
				<h3 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 1rem; text-align: center;">
					🔗 Integrated Wedding Budget Tools
				</h3>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
					<a href="/catering-cost-estimator" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-blue); display: block;">Catering Cost Estimator</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Calculate exact food, service fees, and per-head banquet totals.</span>
					</a>
					<a href="/vendor-tipping-calculator" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-red); display: block;">Vendor Tipping Calculator</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Exact gratuity etiquette guidelines for DJs, hair stylists, and servers.</span>
					</a>
					<a href="/floral-cost-estimator" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--fg-pencil); display: block;">Floral Cost Estimator</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Estimate bouquet, arch, and centerpiece stem counts and pricing.</span>
					</a>
					<a href="/honeymoon-budget-estimator" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-blue); display: block;">Honeymoon Budget Estimator</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Calculate flights, luxury resorts, excursions, and dining expenses.</span>
					</a>
				</div>
			</section>

			<!-- Section 5: FAQs (Centered Heading) -->
			<section>
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Frequently Asked Questions
				</h3>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						How accurate is this wedding budget calculator?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Our calculator uses vetted, nationwide industry-standard percentages. While exact rates vary between metropolitan cities and rural regions, the proportional distribution (e.g. 48% venue/catering, 13% photography) holds true across virtually all wedding tiers.
					</p>
				</details>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						What is the easiest way to cut a wedding budget in half?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						The two most powerful ways to cut wedding expenses are: 1) <strong>Trim the guest list</strong> (since 50%+ of all costs are per-person meals, drinks, and rentals), and 2) <strong>Choose a Friday or Sunday date during off-peak season</strong> (venues often offer 20-30% discounts off Saturday peak rates).
					</p>
				</details>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						How do I export this budget to Microsoft Word or Excel?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Click the <strong>"📝 Export Word (.doc)"</strong> button at the top right to download a formatted table document, or click <strong>"📊 Export Excel (.csv)"</strong> to generate a clean bookkeeping spreadsheet ready for Google Sheets or Microsoft Excel.
					</p>
				</details>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						How much should be held back for emergency buffers?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						We recommend keeping <strong>4% to 5% of your total budget unassigned</strong> (e.g. $1,400 on a $35,000 budget). This absorbs unexpected overtime fees, umbrella rentals for sudden rain, last-minute dress steaming, and vendor tips without forcing you to borrow money.
					</p>
				</details>
			</section>

		</article>

	</main>
</Layout>

<style>
	.tier-btn {
		background: #fff;
		border: 1.5px solid var(--fg-pencil);
		border-radius: 4px;
		padding: 0.35rem 0.65rem;
		font-family: var(--font-heading);
		font-size: 0.85rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.tier-btn:hover {
		background: var(--muted-paper);
	}
	.tier-btn.active-tier {
		background: var(--accent-blue) !important;
		color: #fff !important;
		border-color: #1e40af !important;
	}

	.category-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 6px;
		padding: 1.1rem;
		box-shadow: 2px 2px 0 var(--fg-pencil);
		display: flex;
		flex-direction: column;
		transition: transform 0.15s ease;
	}
	.category-card:hover {
		transform: translateY(-2px);
		box-shadow: 4px 4px 0 var(--fg-pencil);
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 20px;
		}
	}
</style>

<script is:inline>
	const categories = [
		{ id: 'venue', name: 'Venue & Catering', defaultPct: 48, color: '#ffb3ba', desc: 'Reception venue rental, dinner, appetizers & open bar' },
		{ id: 'photo', name: 'Photography & Video', defaultPct: 13, color: '#bae1ff', desc: 'Full-day photo coverage, video highlight reel & albums' },
		{ id: 'attire', name: 'Attire & Beauty', defaultPct: 9, color: '#ffdfba', desc: 'Dress, suit/tuxedo, alterations, hair & makeup' },
		{ id: 'florals', name: 'Flowers & Decor', defaultPct: 8, color: '#baffc9', desc: 'Bouquets, ceremony arch, centerpieces & lighting' },
		{ id: 'entertain', name: 'Music & Entertainment', defaultPct: 7, color: '#ffffba', desc: 'DJ, MC, ceremony musicians, or reception band' },
		{ id: 'rings', name: 'Rings & Officiant', defaultPct: 4, color: '#fbcfe8', desc: 'Wedding bands, marriage license & officiant fee' },
		{ id: 'stationery', name: 'Stationery & Postage', defaultPct: 3, color: '#e8baff', desc: 'Invitations, save-the-dates, postage & day-of signs' },
		{ id: 'favors', name: 'Favors & Gifts', defaultPct: 2, color: '#fed7aa', desc: 'Wedding party gifts, parent tokens & welcome bags' },
		{ id: 'transport', name: 'Transportation', defaultPct: 2, color: '#ccfbf1', desc: 'Getaway car, bridal shuttle & guest party bus' },
		{ id: 'buffer', name: 'Emergency Buffer & Tax', defaultPct: 4, color: '#e5e7eb', desc: 'Sales tax, vendor meals, overtime & unexpected costs' }
	];

	let userPcts = {};
	categories.forEach(c => { userPcts[c.id] = c.defaultPct; });

	let currencySymbol = '$';

	const totalBudgetInput = document.getElementById('total-budget-input');
	const guestCountInput = document.getElementById('guest-count-input');
	const currencySelect = document.getElementById('currency-select');
	const currencySymbolDisplay = document.getElementById('currency-symbol-display');

	const statTotalDisplay = document.getElementById('stat-total-display');
	const statPerGuest = document.getElementById('stat-per-guest');
	const statGuestCountNote = document.getElementById('stat-guest-count-note');
	const statVenueAmt = document.getElementById('stat-venue-amt');
	const statBufferAmt = document.getElementById('stat-buffer-amt');

	const pctWarning = document.getElementById('pct-warning');
	const stackedBudgetBar = document.getElementById('stacked-budget-bar');
	const categoriesGrid = document.getElementById('categories-grid');

	function formatMoney(amount) {
		return `${currencySymbol}${Math.round(amount).toLocaleString('en-US')}`;
	}

	function calculateBudget() {
		const total = parseFloat(totalBudgetInput.value) || 0;
		const guests = parseInt(guestCountInput.value) || 1;
		currencySymbol = currencySelect.value;
		currencySymbolDisplay.textContent = currencySymbol;

		// Calculate total percentage
		let totalPct = 0;
		categories.forEach(c => {
			totalPct += (parseFloat(userPcts[c.id]) || 0);
		});

		// Update Stats
		statTotalDisplay.textContent = formatMoney(total);
		const perGuestCost = guests > 0 ? (total / guests) : 0;
		statPerGuest.textContent = `${currencySymbol}${perGuestCost.toFixed(2)}`;
		statGuestCountNote.textContent = `Based on ${guests} guests`;

		const venueAmt = total * ((parseFloat(userPcts['venue']) || 0) / 100);
		statVenueAmt.textContent = formatMoney(venueAmt);

		const bufferAmt = total * ((parseFloat(userPcts['buffer']) || 0) / 100);
		statBufferAmt.textContent = formatMoney(bufferAmt);

		// Warning indicator
		if (Math.round(totalPct) === 100) {
			pctWarning.textContent = '100% Allocated (Balanced Budget)';
			pctWarning.style.color = '#15803d';
		} else if (totalPct > 100) {
			pctWarning.textContent = `⚠️ Overallocated (${totalPct}% - please reduce ${totalPct - 100}%)`;
			pctWarning.style.color = 'var(--accent-red)';
		} else {
			pctWarning.textContent = `Unallocated (${totalPct}% - ${100 - totalPct}% remaining)`;
			pctWarning.style.color = '#a16207';
		}

		// Update Stacked Bar
		stackedBudgetBar.innerHTML = '';
		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const displayPct = totalPct > 0 ? (pct / totalPct) * 100 : 0;

			if (displayPct > 0) {
				const seg = document.createElement('div');
				seg.style.cssText = `height: 100%; width: ${displayPct}%; background-color: ${c.color}; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;`;
				seg.title = `${c.name}: ${pct}% (${formatMoney(total * (pct / 100))})`;
				stackedBudgetBar.appendChild(seg);
			}
		});

		if (stackedBudgetBar.lastChild) {
			stackedBudgetBar.lastChild.style.borderRight = 'none';
		}

		// Update Category Cards Amounts
		categories.forEach(c => {
			const amtEl = document.getElementById(`amt-${c.id}`);
			const pctInputEl = document.getElementById(`pct-input-${c.id}`);
			const rangeEl = document.getElementById(`range-${c.id}`);
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);

			if (amtEl) amtEl.textContent = formatMoney(amt);
			if (pctInputEl && document.activeElement !== pctInputEl) pctInputEl.value = pct;
			if (rangeEl && document.activeElement !== rangeEl) rangeEl.value = pct;
		});
	}

	function renderCategoryCards() {
		categoriesGrid.innerHTML = '';
		const total = parseFloat(totalBudgetInput.value) || 0;

		categories.forEach(c => {
			const card = document.createElement('div');
			card.className = 'category-card';

			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);

			card.innerHTML = `
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
					<div style="display: flex; align-items: center; gap: 0.4rem;">
						<span style="width: 14px; height: 14px; background-color: ${c.color}; border: 1.5px solid var(--fg-pencil); border-radius: 3px; display: inline-block;"></span>
						<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil);">${c.name}</strong>
					</div>
					<strong id="amt-${c.id}" class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil);">${formatMoney(amt)}</strong>
				</div>

				<p class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); margin: 0 0 0.75rem 0; line-height: 1.3;">
					${c.desc}
				</p>

				<div style="display: flex; align-items: center; gap: 0.75rem; margin-top: auto;">
					<input type="range" id="range-${c.id}" min="0" max="70" step="1" value="${pct}" style="flex: 1; accent-color: var(--fg-pencil); cursor: pointer;" oninput="updateCatPct('${c.id}', this.value)">
					<div style="display: flex; align-items: center; gap: 0.2rem;">
						<input type="number" id="pct-input-${c.id}" min="0" max="100" step="0.5" value="${pct}" style="width: 50px; padding: 3px 5px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; text-align: center;" oninput="updateCatPct('${c.id}', this.value)">
						<span style="font-size: 0.9rem; font-weight: bold;">%</span>
					</div>
				</div>
			`;

			categoriesGrid.appendChild(card);
		});
	}

	window.updateCatPct = function(id, val) {
		userPcts[id] = parseFloat(val) || 0;
		calculateBudget();
	};

	// Event Listeners
	totalBudgetInput.addEventListener('input', calculateBudget);
	guestCountInput.addEventListener('input', calculateBudget);
	currencySelect.addEventListener('change', calculateBudget);

	// Tier Presets
	document.querySelectorAll('.tier-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.tier-btn').forEach(b => b.classList.remove('active-tier'));
			btn.classList.add('active-tier');

			totalBudgetInput.value = btn.getAttribute('data-amt');
			guestCountInput.value = btn.getAttribute('data-guests');
			calculateBudget();
		});
	});

	// Reset Defaults
	document.getElementById('btn-reset-defaults').addEventListener('click', () => {
		categories.forEach(c => { userPcts[c.id] = c.defaultPct; });
		renderCategoryCards();
		calculateBudget();
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const total = parseFloat(totalBudgetInput.value) || 0;
		const guests = parseInt(guestCountInput.value) || 1;

		let rows = '';
		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);
			rows += `
				<tr>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold;">${c.name}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center;">${pct}%</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:right; font-weight:bold;">${formatMoney(amt)}</td>
					<td style="border:1px solid #ccc; padding:8px; color:#555;">${c.desc}</td>
				</tr>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Master Wedding Budget Breakdown</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Official Master Wedding Budget</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Total Budget: <strong>${formatMoney(total)}</strong> | Guest Count: ${guests} | Cost Per Guest: <strong>${formatMoney(total / guests)}</strong></p>
				<table>
					<thead>
						<tr>
							<th>Category</th>
							<th style="text-align:center;">% Share</th>
							<th style="text-align:right;">Allocated Amount</th>
							<th>Expenses Included</th>
						</tr>
					</thead>
					<tbody>
						${rows}
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Master_Wedding_Budget_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const total = parseFloat(totalBudgetInput.value) || 0;
		const guests = parseInt(guestCountInput.value) || 1;

		document.getElementById('print-date').textContent = new Date().toLocaleDateString();
		document.getElementById('print-total').textContent = formatMoney(total);
		document.getElementById('print-per-guest').textContent = `${formatMoney(total / guests)} (${guests} Guests)`;

		const tbody = document.getElementById('print-table-body');
		tbody.innerHTML = '';

		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);

			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">${c.name}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center;">${pct}%</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: right; font-weight: bold;">${formatMoney(amt)}</td>
				<td style="border: 1px solid #ccc; padding: 6px; color: #555;">${c.desc}</td>
			`;
			tbody.appendChild(tr);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const total = parseFloat(totalBudgetInput.value) || 0;
		let csv = "Category,Percentage Share,Allocated Amount,Included Expenses\n";
		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);
			csv += `"${c.name}",${pct}%,${Math.round(amt)},"${(c.desc||'').replace(/"/g, '""')}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Master_Wedding_Budget_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	renderCategoryCards();
	calculateBudget();
</script>
