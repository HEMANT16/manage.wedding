---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Wedding Planner Cost: Full vs Day-Of Coordinator (Pricing & Duties Comparison)",
      "description": "How much does a wedding planner cost? Compare Day-Of (Month-Of) Coordinators ($1,200-$2,500) vs Full-Service Planning ($5,000-$12,000+), and understand why venue coordinators are not a substitute.",
      "datePublished": "2026-08-18T00:00:00+00:00",
      "dateModified": "2026-08-18T00:00:00+00:00",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding",
        "logo": {
          "@type": "ImageObject",
          "url": "https://manage.wedding/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://manage.wedding/wedding-planner-cost-full-vs-day-of-coordinator"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the difference between a Day-Of Coordinator and a Full Wedding Planner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Day-Of (Month-Of) Coordinator steps in 4 to 6 weeks prior to finalize timelines, conduct the rehearsal, and run day-of logistics ($1,200-$2,500). A Full Wedding Planner handles budget design, vendor sourcing, contract negotiations, styling, and logistics from day one ($5,000-$12,000+)."
          }
        },
        {
          "@type": "Question",
          "name": "Why is a venue coordinator not the same as a day-of wedding planner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A venue coordinator is employed by the venue to protect the property, manage in-house staff, and unlock doors. They do not bustle your dress, cue the processional music, manage outside vendors, pack personal decor, or troubleshoot late hair stylists."
          }
        },
        {
          "@type": "Question",
          "name": "What percentage of a wedding budget goes to planning?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Couples typically allocate 3% to 5% of their budget for a Day-Of Coordinator or 10% to 20% for Full-Service Planning and Design."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Wedding Planner Cost: Full vs Day-Of Coordinator (Pricing & Duties Comparison) | Manage.Wedding"
  description="Compare wedding planner pricing and service levels. Understand Day-Of ($1,200-$2,500), Partial ($3,000-$5,500), and Full Service ($6,000-$12,000+) options."
  schema={schema}
>
  <main class="container" style="padding-top: 2rem; padding-bottom: 4rem; max-width: 900px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
        { name: "Wedding Planner Cost Guide" }
      ]}
    />

    <!-- Header Section -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #eff6ff; color: #1e40af; padding: 4px 12px; border-radius: 20px; border: 1.5px solid #3b82f6; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <span>📋</span>
        <span>Planning Services & Coordination Logistics</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
        Wedding Planner Cost: Full vs Day-Of Coordinator <span style="color: #1d4ed8; font-style: italic;">(Pricing & Duties Comparison)</span>
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;">
        <span>Published: August 2026</span>
        <span>•</span>
        <span>9 min read</span>
        <span>•</span>
        <span>By Manage.Wedding Editorial Team</span>
      </div>
    </header>

    <!-- AI Direct Citation Callout (BLUF) -->
    <div style="background: #eff6ff; border: 2px solid #2563eb; border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: 3px 3px 0px #2563eb;">
      <div style="font-size: 0.82rem; font-weight: 800; color: #1e40af; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem;">
        🎯 Planner Pricing Benchmark (BLUF)
      </div>
      <p class="font-body" style="font-size: 1.15rem; color: #1e3a8a; font-weight: 600; line-height: 1.5; margin: 0;">
        A day-of (month-of) coordinator costs $1,200 to $2,500 to manage timelines and vendor execution, while full-service wedding planning costs $5,000 to $12,000+ or 15% to 20% of total budget for full vendor procurement and design.
      </p>
    </div>

    <!-- Interactive Tool Callout Hero -->
    <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
          Calculate Your Overall Wedding Budget Allocations
        </h3>
        <p class="font-body" style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
          See how hiring a Day-Of Coordinator vs Full Planner adjusts your remaining vendor budget.
        </p>
      </div>
      <a href="/master-budget-calculator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 10px 22px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.5rem;">
        <span>Open Budget Calculator</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Main Content Body -->
    <article class="font-body" style="font-size: 1.1rem; line-height: 1.7; color: var(--fg-pencil);">
      
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2rem 0 1rem;">
        The 3 Levels of Wedding Planning Services
      </h2>
      <p>
        Hiring professional wedding coordination prevents the couple, bridal party, and parents from working on the wedding day. Here is what each service level delivers:
      </p>

      <!-- Tier Comparison Table -->
      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Service Level</th>
              <th style="padding: 12px 14px; font-weight: 800;">Average Pricing</th>
              <th style="padding: 12px 14px; font-weight: 800;">Timeline Involvement</th>
              <th style="padding: 12px 14px; font-weight: 800;">Core Deliverables</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">⏱️ Day-Of / Month-Of Coordination</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">$1,200 – $2,500</td>
              <td style="padding: 12px 14px; font-weight: 600;">Last 4 – 6 Weeks</td>
              <td style="padding: 12px 14px; color: #475569;">Timeline creation, vendor confirmation, rehearsal, 10-12 hrs day-of execution</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700;">🎨 Partial Planning & Design</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #0284c7;">$3,000 – $5,500</td>
              <td style="padding: 12px 14px; font-weight: 600;">Last 4 – 6 Months</td>
              <td style="padding: 12px 14px; color: #475569;">Design mood boards, sourcing missing vendors, contract review, full coordination</td>
            </tr>
            <tr style="background: #eff6ff;">
              <td style="padding: 12px 14px; font-weight: 700;">👑 Full-Service Planning & Production</td>
              <td style="padding: 12px 14px; font-weight: 800; color: #7c3aed;">$6,000 – $14,000+ <br/><span style="font-size: 0.8rem; font-weight: normal;">(or 15-20% of budget)</span></td>
              <td style="padding: 12px 14px; font-weight: 600;">10 – 18 Months</td>
              <td style="padding: 12px 14px; color: #475569;">Budget curation, venue scouting, full vendor management, 3D CAD layouts, complete production</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Venue Coordinator Trap -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The "Venue Coordinator" Trap: Why You Still Need a Private Coordinator
      </h2>
      
      <div style="background: #fffbeb; border: 1.5px solid #d97706; border-radius: 8px; padding: 1.5rem; margin: 1.5rem 0;">
        <h3 class="font-heading" style="font-size: 1.15rem; color: #92400e; margin-bottom: 0.5rem;">
          ⚠️ Venue Coordinator vs Private Coordinator
        </h3>
        <p style="font-size: 0.95rem; line-height: 1.6; color: #78350f; margin: 0;">
          A venue coordinator's legal duty is to the building owner: unlocking restrooms, monitoring noise ordinances, ensuring catering adheres to kitchen rules, and turning off lights at midnight. They will <strong>NOT</strong> pin boutonnieres, coordinate the photographer's sunset schedule, fix a broken dress zipper, pack up your personal guest book, or ensure tips are handed out.
        </p>
      </div>

      <!-- Day-of Coordinator ROI -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Why a Month-Of Coordinator Is the Best ROI in Wedding Planning
      </h2>
      <p>
        At $1,500, a month-of coordinator represents only <strong>3% to 4% of a $40,000 wedding</strong>. By preventing costly vendor overtime fees ($300-$500/hr for photographers and venues) and managing emergency schedule shifts seamlessly, they pay for themselves while ensuring the couple and parents enjoy every minute of the celebration.
      </p>

      <!-- Bottom Interactive CTA Section -->
      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 2rem; box-shadow: 4px 4px 0px var(--fg-pencil); text-align: center; margin: 3rem 0;">
        <h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
          Build Your Complete Day-of Schedule
        </h3>
        <p class="font-body" style="font-size: 1.05rem; max-width: 600px; margin: 0 auto 1.5rem; color: var(--text-secondary);">
          Use our interactive timeline tool to map ceremony, photos, catering cues, and reception speeches in minutes.
        </p>
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="/day-of-timeline-generator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 12px 24px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Open Timeline Generator &rarr;
          </a>
          <a href="/master-budget-calculator" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 12px 20px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Master Wedding Budget &rarr;
          </a>
        </div>
      </div>

    </article>

    <RelatedTools currentPath="/wedding-planner-cost-full-vs-day-of-coordinator" category="budget-finance" />
  </main>
</Layout>
