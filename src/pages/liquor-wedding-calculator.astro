---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/liquor-wedding-calculator/#webapp",
      "name": "Wedding Liquor Calculator & Full Open Bar Spirit Estimator",
      "url": "https://manage.wedding/liquor-wedding-calculator",
      "description": "Calculate exact quantities of liquor bottles (vodka, bourbon, tequila, rum, gin), wine, beer, mixers, garnishes, and ice for a wedding open bar. Includes 750ml vs 1.75L handle sizes and estimated retail costs.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate Liquor and Spirits for a Wedding Bar",
      "description": "Step-by-step guide to calculating 750ml spirit bottles, mixers, and garnishes for open wedding bars.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Enter Guest Count & Reception Hours",
          "text": "Input total 21+ drinking guests and bar duration (standard 4 to 5 hours) to establish total drink servings (Guests × Hours × 1 Drink/Hour)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Set Beer, Wine, and Liquor Split",
          "text": "Adjust percentage splits based on your crowd (Standard: 40% Wine, 40% Liquor, 20% Beer; Cocktail-Heavy: 50% Liquor, 30% Wine, 20% Beer)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Customize Spirit Types for Signature Cocktails",
          "text": "Fine-tune ratios for Vodka, Bourbon/Whiskey, Tequila, Rum, and Gin to match your planned signature cocktails (Margarita, Old Fashioned, Mule)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Review Itemized Bottle Shopping List & Retail Budget",
          "text": "Get exact 750ml or 1.75L bottle counts, 2-liter mixer requirements, citrus fruit counts, ice pounds, and estimated Total Wine shopping budget."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many drinks are in a standard 750ml vs 1.75L bottle of liquor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard 750ml bottle yields approximately 16 cocktails using a standard 1.5 oz pour. A 1.75L 'handle' bottle yields approximately 39 cocktails and usually offers a 20% to 30% cost savings at retailers like Total Wine, Costco, or BevMo."
          }
        },
        {
          "@type": "Question",
          "name": "What is the standard ratio of spirits for a wedding open bar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The industry standard full-bar spirit allocation is: Vodka (30%), Bourbon/Whiskey (25%), Tequila (20%), Rum (15%), and Gin (10%), with additional Triple Sec if serving Margaritas."
          }
        },
        {
          "@type": "Question",
          "name": "How much ice do I need for a full liquor bar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan on 2 lbs of ice per guest for a full liquor bar. Cocktails require ice for shaking/stirring in addition to chilling highballs and rocks glasses."
          }
        },
        {
          "@type": "Question",
          "name": "How much mixer do I need per bottle of liquor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan on 1 Liter of mixer for every 4 cocktails (or roughly three 2-liter bottles for every two 750ml bottles of spirits). Common staples include Club Soda, Tonic, Cola, Lemon-Lime, Cranberry, and Citrus juices."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Liquor Calculator & Open Bar Spirit Estimator (Free Shopping List)"
	description="Calculate exact quantities of liquor bottles (vodka, bourbon, tequila, rum, gin), wine, beer, mixers, garnishes, and ice for a wedding open bar. Includes 750ml vs 1.75L handle sizes and estimated retail costs."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Wedding Liquor & Spirits Sizer" category="food-dining" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Spirits, Mixers & Ice Estimator</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Wedding Liquor Calculator <span class="accent-italic">& Open Bar Sizer</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calculate exact 750ml and 1.75L handle bottle quantities of Vodka, Bourbon, Tequila, Rum, and Gin — plus mixers, fresh citrus garnishes, and ice for a full open bar.
			</p>
		</header>

		<!-- Editorial Guide Interlink Banner -->
		<div style="background: #fef3c7; border: 2px solid #d97706; border-radius: 8px; padding: 1rem 1.5rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; box-shadow: 2px 2px 0px #d97706;">
			<div style="display: flex; align-items: center; gap: 0.75rem;">
				<span style="font-size: 1.5rem;">📖</span>
				<div>
					<strong style="color: #92400e; font-size: 0.95rem; display: block;">Planning a DIY or BYOB Wedding Bar?</strong>
					<span style="color: #78350f; font-size: 0.88rem;">Read our in-depth guides on <a href="/how-much-alcohol-for-wedding-ratios" style="color: #92400e; text-decoration: underline; font-weight: 700;">Exact Bar Ratios & Buying Checklist</a> and <a href="/wedding-bar-cost-open-bar-vs-byob" style="color: #92400e; text-decoration: underline; font-weight: 700;">Open Bar vs BYOB Cost Breakdown</a>.</span>
				</div>
			</div>
			<a href="/how-much-alcohol-for-wedding-ratios" style="background: #b45309; color: #fff; text-decoration: none; font-weight: 700; font-size: 0.85rem; padding: 6px 14px; border-radius: 6px; border: 1px solid #78350f; white-space: nowrap;">
				Read Guide &rarr;
			</a>
		</div>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Inputs & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Bar Setup & Guest Count
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Real-Time Math
					</span>
				</div>

				<!-- Signature Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="bar-preset">Signature Bar Archetype</label>
					<select id="bar-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="classic-open-bar" selected>🍸 Classic Full Open Bar (40% Wine, 40% Liquor, 20% Beer)</option>
						<option value="cocktail-heavy">🍹 Cocktail-Heavy Party (50% Liquor, 30% Wine, 20% Beer)</option>
						<option value="margarita-bourbon">🌵 Tequila & Bourbon Focused (Margarita + Old Fashioned Bar)</option>
						<option value="beer-wine-light-liquor">🍺 Beer & Wine Favored (45% Wine, 35% Beer, 20% Liquor)</option>
						<option value="custom">✏️ Custom Sliders</option>
					</select>
				</div>

				<!-- Guest Count & Duration -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="guests">21+ Drinking Guests</label>
						<input type="number" id="guests" class="form-input" value="120" min="10" max="600" step="5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
					<div>
						<label class="form-label" for="hours">Bar Duration (Hours)</label>
						<input type="number" id="hours" class="form-input" value="4" min="1" max="10" step="0.5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
				</div>

				<!-- Crowd Drinking Vibe & Bottle Size Format -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="vibe">Crowd Drinking Pace</label>
						<select id="vibe" class="form-input" style="cursor: pointer;">
							<option value="light">Light (-25% Drinks)</option>
							<option value="average" selected>Standard (1 Drink / Hr)</option>
							<option value="heavy">Heavy Party (+25% Drinks)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="bottle-size">Spirit Bottle Size</label>
						<select id="bottle-size" class="form-input" style="cursor: pointer; font-weight: 600;">
							<option value="750" selected>Standard 750ml (16 drinks)</option>
							<option value="1750">1.75L Handles (39 drinks)</option>
						</select>
					</div>
				</div>

				<!-- Category Preference Sliders (Beer / Wine / Liquor) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil);">
							Drink Category Preferences (%)
						</strong>
						<span id="sum-pref-check" style="font-size: 0.82rem; font-weight: 700; color: #16a34a; background: #f0fdf4; padding: 2px 6px; border-radius: 4px;">
							Total: 100%
						</span>
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍷 Wine & Sparkling</span>
							<span id="val-pref-wine">40%</span>
						</div>
						<input type="range" id="pref-wine" min="0" max="100" value="40" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍸 Liquor & Cocktails</span>
							<span id="val-pref-liquor">40%</span>
						</div>
						<input type="range" id="pref-liquor" min="0" max="100" value="40" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍺 Beer & Hard Seltzer</span>
							<span id="val-pref-beer">20%</span>
						</div>
						<input type="range" id="pref-beer" min="0" max="100" value="20" style="width: 100%; cursor: pointer;" />
					</div>
				</div>

				<!-- Spirit Type Allocation Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.75rem;">
						Liquor Spirit Breakdown (%)
					</strong>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍸 Vodka (Mules, Tonics, Martinis)</span>
							<span id="val-liq-vodka">30%</span>
						</div>
						<input type="range" id="liq-vodka" min="0" max="100" value="30" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🥃 Bourbon / Whiskey (Old Fashioneds, Highballs)</span>
							<span id="val-liq-whiskey">25%</span>
						</div>
						<input type="range" id="liq-whiskey" min="0" max="100" value="25" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌵 Tequila (Margaritas, Palomas)</span>
							<span id="val-liq-tequila">20%</span>
						</div>
						<input type="range" id="liq-tequila" min="0" max="100" value="20" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌴 Rum (Mojitos, Daiquiris, Dark & Stormy)</span>
							<span id="val-liq-rum">15%</span>
						</div>
						<input type="range" id="liq-rum" min="0" max="100" value="15" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌿 Gin (Gin & Tonic, French 75)</span>
							<span id="val-liq-gin">10%</span>
						</div>
						<input type="range" id="liq-gin" min="0" max="100" value="10" style="width: 100%; cursor: pointer;" />
					</div>
				</div>

				<!-- Champagne Toast Option -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.95rem; font-weight: 600;">
						<input type="checkbox" id="check-champagne-toast" checked style="width: 18px; height: 18px;" />
						<span>Include Dedicated Champagne Toast (+1 flute / guest)</span>
					</label>
				</div>

			</div>

			<!-- Right Column: Results & Shopping List -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Primary Results Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Total Drink Servings Required
						</span>
						<span id="vibe-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							Standard Vibe
						</span>
					</div>

					<div id="res-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						480 Drinks
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.25rem 0;">
						Estimated for <strong id="res-guest-count-label" style="color: var(--fg-pencil);">120 guests</strong> across a <strong id="res-hours-label" style="color: var(--fg-pencil);">4-hour</strong> reception.
					</p>

					<!-- Visual Split Bar -->
					<div style="display: flex; height: 28px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; margin-bottom: 1.5rem; font-size: 0.82rem; font-weight: 800; color: #fff; text-align: center; line-height: 28px;">
						<div id="chart-wine" style="background-color: var(--accent-red); width: 40%; transition: width 0.2s;">Wine (40%)</div>
						<div id="chart-liquor" style="background-color: var(--fg-pencil); width: 40%; transition: width 0.2s;">Liquor (40%)</div>
						<div id="chart-beer" style="background-color: var(--accent-blue); width: 20%; transition: width 0.2s;">Beer (20%)</div>
					</div>

					<!-- Estimated Retail Cost Callout -->
					<div style="background: #fdf6e2; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
						<div>
							<strong style="display: block; font-size: 0.92rem; color: var(--fg-pencil);">Estimated Retail Alcohol Budget:</strong>
							<span style="font-size: 0.82rem; color: #64748b;">(Total Wine / Costco average prices)</span>
						</div>
						<span id="res-est-cost" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red); font-weight: 800;">
							$1,480
						</span>
					</div>

					<!-- Itemized Shopping List Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Spirits Section -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin-bottom: 0.6rem;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🥃 Spirits & Liquor (<span id="bottle-size-label">750ml</span>)
							</strong>
							<strong id="res-total-liquor-bottles" style="color: var(--accent-red);">12 Bottles</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Vodka:</span>
							<strong id="res-vodka">4 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Bourbon / Whiskey:</span>
							<strong id="res-whiskey">3 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Tequila:</span>
							<strong id="res-tequila">2 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Rum:</span>
							<strong id="res-rum">2 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Gin:</span>
							<strong id="res-gin">1 btl</strong>
						</div>

						<!-- Wine & Beer Section -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin: 1rem 0 0.6rem 0;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🍷 Wine, Beer & Champagne
							</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Table Wine (750ml):</span>
							<strong id="res-wine">38 btls (22 Red / 16 White)</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Beer (24-pk Cases):</span>
							<strong id="res-beer">4 Cases (96 Beers)</strong>
						</div>
						<div id="row-champagne" style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Champagne Toast (750ml):</span>
							<strong id="res-champagne" style="color: var(--accent-red);">20 btls</strong>
						</div>

						<!-- Mixers & Garnishes -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin: 1rem 0 0.6rem 0;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🍋 Mixers, Garnishes & Ice
							</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>2L Mixers (Club Soda, Tonic, Cola, Sprite):</span>
							<strong id="res-mixers">24 Bottles (2L)</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Citrus Garnishes (Limes, Lemons, Oranges):</span>
							<strong id="res-garnishes">32 Limes • 18 Lemons • 12 Oranges</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem;">
							<span>Ice Required:</span>
							<strong id="res-ice">240 lbs (12 × 20lb Bags)</strong>
						</div>

					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-shopping-list" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Print Shopping List (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Word Doc
						</button>
					</div>

				</div>

				<!-- Bartending Pro Tip Callout -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						💡 Pro Bartending Rule of Thumb:
					</strong>
					<p style="margin: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<strong>Handle Bottles Save Money:</strong> 1.75L "handle" bottles cost 25% less per ounce than 750ml fifths. If your venue allows you to supply your own alcohol, buy handles for speed-rail pourers and save hundreds!
					</p>
