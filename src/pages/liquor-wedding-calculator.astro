					<p>Guests: ${guestsInput.value} | Duration: ${hoursInput.value} Hours | Est. Total: ${resEstCost.textContent}</p>
					
					<table>
						<thead><tr><th>Item Category</th><th>Item Details</th><th>Quantity to Buy</th></tr></thead>
