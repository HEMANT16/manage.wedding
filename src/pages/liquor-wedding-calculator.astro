							<tr><td><strong>Spirits (${bottleSizeLabel.textContent})</strong></td><td>Vodka</td><td>${resVodka.textContent}</td></tr>
							<tr><td><strong>Spirits</strong></td><td>Bourbon / Whiskey</td><td>${resWhiskey.textContent}</td></tr>
							<tr><td><strong>Spirits</strong></td><td>Tequila</td><td>${resTequila.textContent}</td></tr>
							<tr><td><strong>Spirits</strong></td><td>Rum</td><td>${resRum.textContent}</td></tr>
							<tr><td><strong>Spirits</strong></td><td>Gin</td><td>${resGin.textContent}</td></tr>
							<tr><td><strong>Wine</strong></td><td>Table Wine (Red / White)</td><td>${resWine.textContent}</td></tr>
							<tr><td><strong>Beer</strong></td><td>24-Pack Cases</td><td>${resBeer.textContent}</td></tr>
							<tr><td><strong>Champagne</strong></td><td>Toast Champagne</td><td>${resChampagne.textContent}</td></tr>
							<tr><td><strong>Mixers</strong></td><td>Club Soda, Tonic, Cola, Sprite (2L)</td><td>${resMixers.textContent}</td></tr>
							<tr><td><strong>Garnishes</strong></td><td>Limes, Lemons, Oranges</td><td>${resGarnishes.textContent}</td></tr>
							<tr><td><strong>Ice</strong></td><td>20 lb Bags</td><td>${resIce.textContent}</td></tr>
							<tr class="total-row"><td>ESTIMATED BUDGET</td><td>—</td><td>${resEstCost.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Wedding Alcohol Shopping List</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Open Bar Shopping List</h2>
					<p>Guests: ${guestsInput.value} | Est. Cost: ${resEstCost.textContent}</p>
					<table>
						<thead><tr><th>Item</th><th>Quantity</th></tr></thead>
						<tbody>
							<tr><td>Vodka</td><td>${resVodka.textContent}</td></tr>
							<tr><td>Whiskey/Bourbon</td><td>${resWhiskey.textContent}</td></tr>
							<tr><td>Tequila</td><td>${resTequila.textContent}</td></tr>
