				<h2 id="print-sign-names" style="font-size: 18pt; letter-spacing: 2pt; text-transform: uppercase; margin: 0 0 8pt 0; color: #000;">Emma & Liam</h2>
				<p id="print-sign-date" style="font-size: 13pt; color: #555; margin: 0;">October 18, 2026</p>
			</div>
		</div>

		<div id="print-order-sheet-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Wedding Favors Procurement & Assembly Brief</h1>
				<p id="print-order-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Couple: Emma & Liam | Date: October 18, 2026 | Headcount: 120 Guests</p>
