---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Bridal Shower Budget: Who Pays & Cost Per Guest (Brunch & Favor Calculator)",
      "description": "Learn the true cost of hosting a bridal shower. Compare backyard DIY brunches with restaurant private dining, divide host expenses fairly, and calculate favors and mimosas per guest.",
      "datePublished": "2026-08-18T00:00:00+00:00",
      "dateModified": "2026-08-21T00:00:00+00:00",
      "author": {
        "@type": "Person",
        "name": "Elena Foster",
        "jobTitle": "Lead Wedding Financial Strategist & Hospitality Director",
        "description": "35-year-old mother of two, veteran hospitality director with 12+ years managing 400+ luxury estate and ballroom weddings.",
        "worksFor": {
          "@type": "Organization",
          "name": "Manage.Wedding",
          "url": "https://manage.wedding/authors/elena-foster"
        }
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding",
        "logo": {
          "@type": "ImageObject",
          "url": "https://manage.wedding/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://manage.wedding/bridal-shower-budget-who-pays-cost-per-guest"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who traditionally pays for the bridal shower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Maid of Honor and bridesmaids traditionally host and pay for the bridal shower, often partnering with the Mother of the Bride or Mother of the Groom to co-host and split the catering and venue expenses."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a bridal shower cost per guest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A home or backyard bridal shower costs between $20 and $35 per guest for DIY brunch catering and mimosas. A private restaurant room or tea room luncheon typically costs between $50 and $85 per guest including service fees."
          }
        },
        {
          "@type": "Question",
          "name": "Can you invite guests to a bridal shower if they are not invited to the wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Strict etiquette mandates that everyone invited to a bridal shower must also receive an invitation to the wedding (with the sole exception of distant office coworkers organizing an informal workplace shower)."
          }
        },
        {
          "@type": "Question",
          "name": "How far in advance should a bridal shower be hosted?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Host the bridal shower 6 to 10 weeks before the wedding date. This allows guests sufficient time between purchasing a shower gift and traveling for the wedding weekend."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Bridal Shower Budget: Who Pays & Cost Per Guest (Brunch & Favor Calculator) | Manage.Wedding"
  description="Plan a bridal shower budget without stress. Compare $25 backyard brunches vs $65 restaurant rooms, divide costs between MOH and mothers, and calculate food & drink."
  schema={schema}
>
  <main class="container" style="padding-top: 2rem; padding-bottom: 4rem; max-width: 900px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
        { name: "Bridal Shower Budget & Cost Split" }
      ]}
    />

    <!-- Header Section -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #fdf2f8; color: #be185d; padding: 4px 12px; border-radius: 20px; border: 1.5px solid #f472b6; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <span>🌸</span>
        <span>Hostess Etiquette & Event Economics</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
        Bridal Shower Budget: Who Pays & Cost Per Guest <span style="color: #be185d; font-style: italic;">(Brunch & Favor Calculator)</span>
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;">
        <span>Published: August 2026</span>
        <span>•</span>
        <span>8 min read</span>
        <span>•</span>
        <span>By <a href="/authors/elena-foster" style="color: #1d4ed8; text-decoration: underline; text-underline-offset: 3px; font-weight: 700;">Elena Foster</a>, Lead Wedding Financial Strategist</span>
      </div>
    </header>

    <!-- First Paragraph Hook (Elena Persona) -->
    <p class="font-body" style="font-size: 1.15rem; line-height: 1.75; color: var(--fg-pencil); margin-bottom: 1.5rem;">
      As a mom of two daughters and a wedding planner who has helped hundreds of bridal parties navigate shower logistics, I know how easily bridal shower planning can trigger unspoken financial tension between bridesmaids and family. Before anyone opens Venmo or signs a restaurant private dining contract, let's break down the hard numbers.
    </p>

    <!-- Interactive Tool Callout Hero -->
    <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
          Estimate Your Total Bridal Shower Budget
        </h3>
        <p class="font-body" style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
          Calculate food, champagne, floral centerpieces, game prizes, and split host contributions evenly.
        </p>
      </div>
      <a href="/bridal-shower-calculator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 10px 22px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.5rem;">
        <span>Open Shower Calculator</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Main Content Body -->
    <article class="font-body" style="font-size: 1.1rem; line-height: 1.7; color: var(--fg-pencil);">
      
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2rem 0 0.75rem;">
        How Much Does a Bridal Shower Cost Per Guest?
      </h2>

      <!-- Direct Answer Box (AI Overview Magnet) -->
      <div style="background: #fdf2f8; border: 2px solid #db2777; border-radius: 8px; padding: 1.25rem 1.5rem; margin: 1rem 0 1.75rem; box-shadow: 3px 3px 0px #db2777;">
        <div style="font-size: 0.82rem; font-weight: 800; color: #9d174d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.3rem;">
          🎯 Direct Answer: Bridal Shower Cost Standard
        </div>
        <p class="font-body" style="font-size: 1.05rem; color: #831843; font-weight: 600; line-height: 1.5; margin: 0;">
          A bridal shower costs <strong>$25 to $35 per guest for home DIY brunch ($750–$1,000 for 30 guests)</strong> versus <strong>$60 to $90 per guest for private restaurant dining ($1,800–$2,700)</strong>. Costs are traditionally split between the bridal party and mother of the bride.
        </p>
      </div>

      <p>
        The total financial commitment for a bridal shower depends primarily on whether the event is hosted at a private home or in a restaurant private dining room. Here is the itemized breakdown for a typical <strong>30-guest bridal shower</strong>:
      </p>

      <!-- Cost Comparison Table -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Itemized 30-Guest Budget Comparison (The Raw Math)
      </h2>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Expense Category</th>
              <th style="padding: 12px 14px; font-weight: 800;">Home / Garden Brunch ($25/Guest)</th>
              <th style="padding: 12px 14px; font-weight: 800;">Restaurant Private Dining ($75/Guest)</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">🏠 Venue Space</td>
              <td style="padding: 12px 14px; font-weight: 600; color: #16a34a;">$0 (Living room or patio)</td>
              <td style="padding: 12px 14px; font-weight: 600; color: #b45309;">$350 – $600 (Room minimum / fee)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #fdf2f8;">
              <td style="padding: 12px 14px; font-weight: 700;">🥐 Food & Brunch Catering</td>
              <td style="padding: 12px 14px; font-weight: 600;">$350 – $450 (Bagel bar, quiches, fruit)</td>
              <td style="padding: 12px 14px; font-weight: 600;">$1,100 – $1,400 ($35-$45/plate + 22% fee)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">🍾 Mimosa Bar & Prosecco</td>
              <td style="padding: 12px 14px; font-weight: 600;">$120 – $170 (6 bottles Prosecco + juices)</td>
              <td style="padding: 12px 14px; font-weight: 600;">$320 – $480 (Restaurant beverage packages)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #fdf2f8;">
              <td style="padding: 12px 14px; font-weight: 700;">💐 Florals, Backdrop & Decor</td>
              <td style="padding: 12px 14px; font-weight: 600;">$120 – $180 (Trader Joe's blooms + DIY kit)</td>
              <td style="padding: 12px 14px; font-weight: 600;">$150 – $250 (Custom floral centerpieces)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">🎁 Favors & Game Prizes</td>
              <td style="padding: 12px 14px; font-weight: 600;">$90 – $140 (Custom cookies or mini candles)</td>
              <td style="padding: 12px 14px; font-weight: 600;">$120 – $180 (Packaged macarons)</td>
            </tr>
            <tr style="background: #fdf2f8;">
              <td style="padding: 12px 14px; font-weight: 800; color: #be185d;">TOTAL ESTIMATED SPEND</td>
              <td style="padding: 12px 14px; font-weight: 800; color: #16a34a; font-size: 1.05rem;">$680 – $940 ($23–$31 / guest)</td>
              <td style="padding: 12px 14px; font-weight: 800; color: #be185d; font-size: 1.05rem;">$2,040 – $2,910 ($68–$97 / guest)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Co-Hosting & Payment Division -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Who Pays for the Bridal Shower? 3 Modern Co-Hosting Models
      </h2>
      <p>
        The bride should <strong>never pay for her own shower</strong>. Here are the 3 most common co-hosting structures used today:
      </p>
      
      <h3 class="font-heading" style="font-size: 1.35rem; color: var(--accent-blue); margin: 1.5rem 0 0.5rem;">
        Model A: The Mother of Bride / Bridal Party Partnership (Recommended)
      </h3>
      <p>
        The Mother of the Bride (and/or Mother of the Groom) covers the main food catering and venue cost (55–65% of the total budget), while the Maid of Honor and 4 bridesmaids split decor, mimosa bar supplies, games, prizes, and dessert ($75–$110 per bridesmaid).
      </p>

      <h3 class="font-heading" style="font-size: 1.35rem; color: var(--accent-blue); margin: 1.5rem 0 0.5rem;">
        Model B: The Equal Bridesmaid Split (N Hosts)
      </h3>
      <p>
        If the bridesmaids host alone without family financial backing, all costs are divided equally among the bridal party (e.g. $850 total ÷ 5 bridesmaids = <strong>$170 each</strong>).
      </p>

      <h3 class="font-heading" style="font-size: 1.35rem; color: var(--accent-blue); margin: 1.5rem 0 0.5rem;">
        Model C: The Family Host Model
      </h3>
      <p>
        The bride's aunts or mother host and pay for the entire event at a country club or restaurant, while the bridal party simply attends and manages the day-of gift recording and games.
      </p>

      <!-- Planner Pro-Tip & Red Flag Warning Box -->
      <div class="hand-card" style="background: #fffbeb; border: 2px solid #d97706; border-radius: 8px; padding: 1.5rem; margin: 2rem 0; box-shadow: 3px 3px 0px #d97706;">
        <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; font-weight: 800; color: #92400e; margin-bottom: 0.5rem;">
          <span>🚩</span>
          <span>Planner Red Flag: The Non-Wedding Guest Etiquette Breach</span>
        </div>
        <p style="margin: 0; font-size: 0.98rem; color: #78350f; line-height: 1.6;">
          Never invite someone to a bridal shower who is not also on the confirmed wedding guest list! Doing so signals that the guest is "good enough to buy a registry gift, but not important enough to feed at the wedding reception." Cross-check the shower invite list against your master wedding RSVP spreadsheet before stamping envelopes.
        </p>
      </div>

      <!-- Elena's Candid Verdict Section -->
      <div style="background: #fdf2f8; border: 2px solid #db2777; border-radius: 8px; padding: 1.75rem; margin: 2.5rem 0; box-shadow: 4px 4px 0px #db2777;">
        <h3 class="font-heading" style="font-size: 1.35rem; color: #9d174d; margin-bottom: 0.5rem;">
          👩‍💼 Elena's Candid Verdict & Decision Rule
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: #831843; margin: 0;">
          <strong>My rule of thumb after 400+ weddings:</strong> If the bridal party's budget is modest (under $150 per bridesmaid), host an aesthetic backyard or living room brunch with a DIY bagel bar, prosecco mimosas, and Trader Joe's floral bud vases—it feels intimate, relaxed, and deeply personal. If the Mother of the Bride wants a formal restaurant luncheon, she should generously sponsor the venue/food deposit so younger bridesmaids aren't financially stressed.
        </p>
      </div>

      <!-- Bottom Interactive CTA Section -->
      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 2rem; box-shadow: 4px 4px 0px var(--fg-pencil); text-align: center; margin: 3rem 0;">
        <h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
          Build Your Bridal Shower Budget
        </h3>
        <p class="font-body" style="font-size: 1.05rem; max-width: 600px; margin: 0 auto 1.5rem; color: var(--text-secondary);">
          Customize guest headcounts, calculate food & mimosa ratios, and divide expenses equally among all co-hosts.
        </p>
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="/bridal-shower-calculator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 12px 24px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Open Shower Calculator &rarr;
          </a>
          <a href="/bachelorette-budget-calculator" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 12px 20px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Bachelorette Calculator &rarr;
          </a>
        </div>
      </div>

    </article>

    <RelatedTools currentPath="/bridal-shower-budget-who-pays-cost-per-guest" category="budget-finance" />
  </main>
</Layout>
