---
import Layout from '../layouts/Layout.astro';

const title = "Wedding RSVP Date Calculator (Free & Instant Results)";
const description = "Calculate exactly when to send your save-the-dates, wedding invitations, and set your RSVP deadline instantly with our free wedding RSVP date calculator.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/rsvp-date-calculator/#webapp",
      "name": "Wedding RSVP Date Calculator",
      "url": "https://manage.wedding/rsvp-date-calculator",
      "description": "Calculate exact mailing dates for your save-the-dates, invitations, and RSVP deadlines.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate Wedding RSVP & Invitation Mailing Deadlines",
      "description": "Determine exact milestone dates for Save-the-Dates, formal invitation mailings, and RSVP reply deadlines.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Input Your Official Wedding Date",
          "text": "Select your ceremony and reception date on the calendar input."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Toggle Destination vs. Local Setting",
          "text": "Check the destination wedding option if guests will need to book flights and long-distance hotel accommodations."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Review Generated Mailing Milestones",
          "text": "Calculate your recommended Save-the-Date mailing date (6-8 months out), formal invitation mailing date (6-8 weeks out), and RSVP deadline (3-4 weeks out)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Build Buffer for Vendor Deadlines",
          "text": "Ensure your RSVP cutoff date sits at least 7 to 14 days before your venue and caterer's mandatory final headcount deadline."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How exactly does the wedding RSVP date calculator work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It takes your wedding date and subtracts the industry-standard timelines. For local weddings, it calculates 6 months for save-the-dates, 8 weeks for invites, and 4 weeks for the RSVP deadline. It adjusts automatically if you select a destination wedding!"
          }
        },
        {
          "@type": "Question",
          "name": "When should I make my RSVP date if my caterer needs 2 weeks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our RSVP date calculator sets the deadline at 4 weeks before the wedding. This gives you a solid two-week buffer to track down stragglers before your caterer's 2-week final headcount deadline!"
          }
        },
        {
          "@type": "Question",
          "name": "Do I really need to send Save-the-Dates?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you're planning a wedding on a holiday weekend, a destination wedding, or have guests traveling from far away, absolutely! If it's a small local affair, you might be able to skip them, but they are generally highly recommended."
          }
        },
        {
          "@type": "Question",
          "name": "What if I miss the dates the RSVP date calculator suggests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Don't panic! The calculator provides the *ideal* timeline. If you're running a couple of weeks behind, just get them out as soon as possible and perhaps add an option for guests to RSVP online to speed up the replies."
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
    <div class="home-grid" style="display: block; max-width: 800px;">
      
      <div class="hand-card wobbly-border fade-in">
        <div class="tape"></div>
        <div class="badge-postit">Free Tool</div>
        <h1 class="font-heading" style="font-size: 2.5rem; color: var(--accent-red); margin-bottom: 0.5rem; text-align: center;">RSVP Date Calculator</h1>
        <p style="text-align: center; margin-bottom: 2rem;">Find out exactly when to pop those invitations in the postbox! No stress, just perfect timing.</p>

        <form id="calculator-form">
          <div class="form-group">
            <label for="wedding-date" class="form-label">When is the big day? (Wedding Date)</label>
            <input type="date" id="wedding-date" class="form-input" required />
          </div>

          <div class="form-group" style="display: flex; align-items: center; gap: 1rem; margin-top: 2rem; margin-bottom: 2rem;">
            <input type="checkbox" id="destination-wedding" style="width: 24px; height: 24px; cursor: pointer; accent-color: var(--accent-blue);" />
            <label for="destination-wedding" class="form-label" style="margin: 0; cursor: pointer;">Is it a Destination Wedding? (Check if yes)</label>
          </div>

          <div style="text-align: center;">
            <button type="submit" class="hand-btn">Calculate My Dates!</button>
          </div>
        </form>

        <div id="result-box" class="result-box wobbly-border-dashed" style="margin-top: 3rem;">
          <h3 class="font-heading" style="text-align: center; font-size: 2rem; margin-bottom: 1.5rem; color: var(--fg-pencil);">Your Mailing Timeline</h3>
          
          <div class="result-item">
            <div class="item-label">Send Save-the-Dates</div>
            <div class="item-value" id="res-std">--</div>
          </div>
          <div class="result-item">
            <div class="item-label">Send Invitations</div>
            <div class="item-value" id="res-inv">--</div>
          </div>
          <div class="result-item">
            <div class="item-label">RSVP Deadline</div>
            <div class="item-value" id="res-rsvp">--</div>
          </div>

          <!-- Dynamic Graph -->
          <div style="margin-top: 3rem; position: relative; padding-top: 2rem;">
            <div style="position: absolute; top: 0; left: 0; right: 0; border-top: 2px dashed var(--fg-pencil);"></div>
            <h4 class="font-heading" style="text-align: center; margin-bottom: 1rem; color: var(--fg-pencil);">Visual Timeline</h4>
            <div style="display: flex; height: 40px; border: 3px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #fff;">
              <div id="bar-std" style="width: 33.3%; background-color: var(--post-it); border-right: 3px solid var(--fg-pencil); transition: width 0.5s ease; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 0.9rem;" title="Save-the-Dates">STD</div>
              <div id="bar-inv" style="width: 33.3%; background-color: var(--accent-blue); color: white; border-right: 3px solid var(--fg-pencil); transition: width 0.5s ease; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 0.9rem;" title="Invitations">INV</div>
              <div id="bar-rsvp" style="width: 33.4%; background-color: var(--accent-red); color: white; transition: width 0.5s ease; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 0.9rem;" title="RSVP to Wedding">RSVP to Day</div>
            </div>
          </div>
        </div>

      </div>

      <!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
      <div class="hand-card" style="margin: 3rem auto 0 auto; max-width: 800px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
        <div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
          <h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
            <span>⚡</span> Quick Rule of Thumb (BLUF)
          </h2>
          <span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
            1-Minute Stationery Calendar
          </span>
        </div>
        
        <!-- Core Formula Banner -->
        <div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
          <p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
            <strong>Standard Milestone Formula:</strong> 
            <span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Save-the-Dates = 6–8 Months Out</span> · 
            <span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Invitations = 6–8 Weeks Out</span> · 
            <span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">RSVP Cutoff = 3–4 Weeks Out</span>
          </p>
          <p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
            <strong>Destination Timeline Rule:</strong> Send Save-the-Dates <strong>8–12 months</strong> out, Invitations <strong>12–16 weeks</strong> out, and set RSVP cutoff <strong>6–8 weeks</strong> before the flight departure date.
          </p>
        </div>

        <!-- Semantic Benchmark Table -->
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Mailing Milestone</th>
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Local Wedding Window</th>
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Destination / Holiday</th>
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Recipient Action</th>
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Buffer / Next Step</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Save-the-Dates</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">6–8 Months Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">9–12 Months Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Reserve calendar date</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Launch wedding website URL</td>
              </tr>
              <tr style="background: #faf8f3;">
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Hotel Room Blocks</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">5–6 Months Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">8–10 Months Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Book group rate rooms</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Monitor 30-day cutoff release</td>
              </tr>
              <tr>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Formal Invitations</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">6–8 Weeks Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">12–16 Weeks Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Select entree & party RSVPs</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mail in batches (A-List first)</td>
              </tr>
              <tr style="background: #faf8f3;">
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">B-List Wave 2 Invites</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">4–5 Weeks Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">8–10 Weeks Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Fast online RSVP</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Send upon A-list declines</td>
              </tr>
              <tr>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">RSVP Deadline</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">3–4 Weeks Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">6–8 Weeks Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Final response cutoff</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">7-day buffer for late chasers</td>
              </tr>
              <tr style="background: #faf8f3;">
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Caterer Headcount Lock</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">10–14 Days Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">21–30 Days Prior</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">N/A (Vendor deliverable)</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Submit exact dietary counts</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- SEO Article -->
      <article class="hand-card fade-in" style="margin-top: 3rem; background-color: #fff;">
        <h2 class="font-heading" style="font-size: 2rem; color: var(--accent-blue); margin-bottom: 1.5rem;">The Ultimate Guide to Your Wedding RSVP Date Calculator</h2>
        
        <p>Planning a wedding is like conducting a symphony, except all the musicians are your family members and half of them haven't told you what they want for dinner yet. That's where our <strong>wedding RSVP date calculator</strong> swoops in to save the day (and your sanity!).</p>
        
        <div style="text-align: center; margin: 2rem 0;">
          <img src="/images/postbox-sketch.webp" alt="Wedding RSVP Date Calculator — Mailing Deadline Planner" loading="lazy" decoding="async" style="max-width: 100%; border: 3px solid var(--fg-pencil); border-radius: 4px; box-shadow: 4px 4px 0px 0px var(--fg-pencil); width: 300px; height: auto;" />
        </div>

        <h3 class="font-heading" style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">Why the Timing Matters</h3>
        <p>You might be tempted to just toss your invitations into the post whenever you feel like it. But send them too early, and they end up lost under a pile of junk mail. Send them too late, and your guests are scrambling to find flights (and you're scrambling to give the caterer a final headcount). By using our <strong>RSVP date calculator</strong>, you pinpoint the exact sweet spot for sending save-the-dates, invitations, and setting that all-important RSVP deadline.</p>

        <h3 class="font-heading" style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem;">Destination Weddings vs. Local Weddings</h3>
        <p>If you're asking your loved ones to pack their bags for a beach in Bali or a castle in Scotland, they're going to need a bigger runway. That's why our calculator features a handy destination toggle. For a destination wedding, we recommend pushing your save-the-dates out to 9 months and your invitations to 12 weeks before the big day.</p>

        <h3 class="font-heading" style="font-size: 1.8rem; margin-top: 3rem; margin-bottom: 1.5rem; color: var(--accent-red);">Frequently Asked Questions (FAQs)</h3>
        
        <div class="faq-container">
          <details style="margin-bottom: 1rem; border: 2px dashed var(--fg-pencil); padding: 1rem; background: var(--post-it); border-radius: 4px;">
            <summary class="font-heading" style="font-size: 1.3rem; cursor: pointer; color: var(--fg-pencil); outline: none;">How exactly does the wedding RSVP date calculator work?</summary>
            <p style="margin-top: 1rem; margin-bottom: 0;">It takes your wedding date and subtracts the industry-standard timelines. For local weddings, it calculates 6 months for save-the-dates, 8 weeks for invites, and 4 weeks for the RSVP deadline. It adjusts automatically if you select a destination wedding!</p>
          </details>
          
          <details style="margin-bottom: 1rem; border: 2px dashed var(--fg-pencil); padding: 1rem; background: var(--post-it); border-radius: 4px;">
            <summary class="font-heading" style="font-size: 1.3rem; cursor: pointer; color: var(--fg-pencil); outline: none;">When should I make my RSVP date if my caterer needs 2 weeks?</summary>
            <p style="margin-top: 1rem; margin-bottom: 0;">Our RSVP date calculator sets the deadline at 4 weeks before the wedding. This gives you a solid two-week buffer to track down stragglers before your caterer's 2-week final headcount deadline!</p>
          </details>

          <details style="margin-bottom: 1rem; border: 2px dashed var(--fg-pencil); padding: 1rem; background: var(--post-it); border-radius: 4px;">
            <summary class="font-heading" style="font-size: 1.3rem; cursor: pointer; color: var(--fg-pencil); outline: none;">Do I really need to send Save-the-Dates?</summary>
            <p style="margin-top: 1rem; margin-bottom: 0;">If you're planning a wedding on a holiday weekend, a destination wedding, or have guests traveling from far away, absolutely! If it's a small local affair, you might be able to skip them, but they are generally highly recommended.</p>
          </details>

          <details style="margin-bottom: 1rem; border: 2px dashed var(--fg-pencil); padding: 1rem; background: var(--post-it); border-radius: 4px;">
            <summary class="font-heading" style="font-size: 1.3rem; cursor: pointer; color: var(--fg-pencil); outline: none;">What if I miss the dates the RSVP date calculator suggests?</summary>
            <p style="margin-top: 1rem; margin-bottom: 0;">Don't panic! The calculator provides the *ideal* timeline. If you're running a couple of weeks behind, just get them out as soon as possible and perhaps add an option for guests to RSVP online to speed up the replies.</p>
          </details>
        </div>
      </article>

    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('calculator-form');
    const resStd = document.getElementById('res-std');
    const resInv = document.getElementById('res-inv');
    const resRsvp = document.getElementById('res-rsvp');
    const barStd = document.getElementById('bar-std');
    const barInv = document.getElementById('bar-inv');
    const barRsvp = document.getElementById('bar-rsvp');

    if(form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const dateInput = (document.getElementById('wedding-date') as HTMLInputElement).value;
        const isDestination = (document.getElementById('destination-wedding') as HTMLInputElement).checked;
        
        if (!dateInput) return;

        // Split to avoid timezone issues with pure Date parsing
        const parts = dateInput.split('-');
        const weddingDate = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
        
        let stdDate = new Date(weddingDate.getTime());
        let invDate = new Date(weddingDate.getTime());
        let rsvpDate = new Date(weddingDate.getTime());

        if (isDestination) {
          stdDate.setMonth(stdDate.getMonth() - 9);
          invDate.setDate(invDate.getDate() - (12 * 7));
          rsvpDate.setDate(rsvpDate.getDate() - (6 * 7));
        } else {
          stdDate.setMonth(stdDate.getMonth() - 6);
          invDate.setDate(invDate.getDate() - (8 * 7));
          rsvpDate.setDate(rsvpDate.getDate() - (4 * 7));
        }

        const options: Intl.DateTimeFormatOptions = { weekday: 'short', year: 'numeric', month: 'long', day: 'numeric' };
        
        resStd!.textContent = stdDate.toLocaleDateString('en-US', options);
        resInv!.textContent = invDate.toLocaleDateString('en-US', options);
        resRsvp!.textContent = rsvpDate.toLocaleDateString('en-US', options);

        const totalDuration = weddingDate.getTime() - stdDate.getTime();
        if (totalDuration > 0) {
          const stdToInv = invDate.getTime() - stdDate.getTime();
          const invToRsvp = rsvpDate.getTime() - invDate.getTime();
          const rsvpToWed = weddingDate.getTime() - rsvpDate.getTime();

          const stdPct = (stdToInv / totalDuration) * 100;
          const invPct = (invToRsvp / totalDuration) * 100;
          const rsvpPct = (rsvpToWed / totalDuration) * 100;
          
          barStd!.style.width = `${stdPct}%`;
          barInv!.style.width = `${invPct}%`;
          barRsvp!.style.width = `${rsvpPct}%`;
        }
      });
    }
  });
</script>
