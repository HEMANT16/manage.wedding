---
import Layout from '../layouts/Layout.astro';

const title = "Wedding Stationery, Invitations & Creative Tools (Free)";
const description = "Free wedding stationery tools, envelope address formatters, USPS postage calculators, invitation suite sizers, folded place card makers, and speech timers.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/stationery/#collection",
      "name": "Wedding Stationery & Creative Tools",
      "url": "https://manage.wedding/stationery",
      "description": "Comprehensive suite of wedding envelope addressing formatters, invitation suite layering sizers, USPS postage calculators, place card makers, and speech timers.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Envelope Address Formatter", "url": "https://manage.wedding/wedding-envelope-addressing" },
        { "@type": "WebApplication", "name": "Invitation Suite Sizer", "url": "https://manage.wedding/wedding-invitation-suite-sizer" },
        { "@type": "WebApplication", "name": "Invitation Postage Calculator", "url": "https://manage.wedding/wedding-invitation-postage-calculator" },
        { "@type": "WebApplication", "name": "Folded Place Card Maker", "url": "https://manage.wedding/table-place-cards" },
        { "@type": "WebApplication", "name": "Thank-You Note Generator", "url": "https://manage.wedding/wedding-thank-you-cards" },
        { "@type": "WebApplication", "name": "Digital Invitation Maker", "url": "https://manage.wedding/digital-invitations" },
        { "@type": "WebApplication", "name": "Speech & Toast Timer", "url": "https://manage.wedding/wedding-speech-calculator" },
        { "@type": "WebApplication", "name": "Wedding Hashtag Generator", "url": "https://manage.wedding/wedding-hashtag-generator" },
        { "@type": "WebApplication", "name": "Wedding Date Numerology", "url": "https://manage.wedding/wedding-date-numerology" },
        { "@type": "WebApplication", "name": "Anniversary Gift Finder", "url": "https://manage.wedding/anniversary-gift-finder" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the standard dimensions of an A7 wedding invitation suite?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An A7 suite consists of: A7 Outer Envelope (5.25\" × 7.25\"), Main Invitation Card (5\" × 7\"), A2 RSVP Card (3.5\" × 5\"), A2 Return Envelope (4.375\" × 5.75\"), and Details/Reception Enclosure Card (4\" × 6\" or 3.5\" × 5\")."
          }
        },
        {
          "@type": "Question",
          "name": "How much USPS postage does a wedding invitation require?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard 1-oz rectangular invitation requires a 1-oz Forever Stamp ($0.73 in 2026). If your suite weighs over 1.0 oz (due to multiple cards, heavy 120lb stock), or includes a wax seal / ribbon, it requires a 2-oz stamp ($1.01) plus a $0.44 non-machinable surcharge ($1.45 total)."
          }
        },
        {
          "@type": "Question",
          "name": "How long should a Maid of Honor or Best Man wedding speech be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The sweet spot is 3 to 5 minutes (approximately 450 to 650 spoken words at a conversational pace of 120 WPM). Any speech longer than 6 minutes risks losing the attention of guests."
          }
        }
      ]
    }
  ]
};

const stationeryTools = [
  {
    title: "Envelope Address Formatter",
    url: "/wedding-envelope-addressing",
    icon: "✉️",
    badge: "Etiquette & CSV",
    desc: "Format A7, A2, and inner envelopes with proper etiquette for married couples, doctors, plus-ones, and families. Export printable PDF/Word.",
    tags: ["A7 Envelopes", "Printable PDF", "Etiquette Guide"]
  },
  {
    title: "Invitation Suite Sizer",
    url: "/wedding-invitation-suite-sizer",
    icon: "📐",
    badge: "Canva 300 DPI Specs",
    desc: "Calculate precise layer dimensions, trimming borders, and envelope clearances for A7, A2, A8, and Square suites with Canva 300 DPI bleed specs.",
    tags: ["A7 5x7 Specs", "Layering Mat Sizes", "Canva Bleed Specs"]
  },
  {
    title: "Invitation Postage Calculator",
    url: "/wedding-invitation-postage-calculator",
    icon: "📮",
    badge: "USPS 2026 Rates",
    desc: "Calculate exact envelope weight and USPS postage rates. Factors in wax seals, square envelopes, 1oz vs 2oz, and non-machinable fees.",
    tags: ["Wax Seal Fees", "1oz vs 2oz Stamps", "USPS Rates"]
  },
  {
    title: "Folded Place Card Maker",
    url: "/table-place-cards",
    icon: "🏷️",
    badge: "Print Ready",
    desc: "Generate printable folded tent name cards with table escort numbers and meal icons in seconds.",
    tags: ["Printable PDF", "Folded Tent Cards", "Meal Icons"]
  },
  {
    title: "Thank-You Note Generator",
    url: "/wedding-thank-you-cards",
    icon: "✍️",
    badge: "Cash & Registry",
    desc: "Generate personalized, etiquette-approved thank-you note wording for cash gifts, honeymoon funds, registry items, and vendors.",
    tags: ["Thank You Notes", "Cash Gifts", "Wording Formulas"]
  },
  {
    title: "Digital Invitation Maker",
    url: "/digital-invitations",
    icon: "💌",
    badge: "E-Invites",
    desc: "Design clean, mobile-friendly digital invitations and Save-the-Dates that sync with your guest list.",
    tags: ["E-Invites", "Save-The-Dates", "Digital RSVP"]
  },
  {
    title: "Speech & Toast Timer",
    url: "/wedding-speech-calculator",
    icon: "🎙️",
    badge: "Pacing Stopwatch",
    desc: "Paste your toast or vows to measure spoken reading time (110–130 WPM), pause buffers, and cue cards.",
    tags: ["Speaking Pacing", "Printable Cue Cards", "Vow Timer"]
  },
  {
    title: "Wedding Hashtag Generator",
    url: "/wedding-hashtag-generator",
    icon: "#️⃣",
    badge: "50+ Styles",
    desc: "Generate 50+ clever, romantic, punny, and classic wedding hashtags with printable 8x10 bar signs.",
    tags: ["Social Hashtags", "8x10 Bar Signs", "Pun Generator"]
  },
  {
    title: "Wedding Date Numerology",
    url: "/wedding-date-numerology",
    icon: "✨",
    badge: "Fun & Meaningful",
    desc: "Calculate your marriage life-path number, numerological compatibility, and auspicious date traits.",
    tags: ["Life Path Number", "Date Compatibility", "Astrology"]
  },
  {
    title: "Anniversary Gift Finder",
    url: "/anniversary-gift-finder",
    icon: "💎",
    badge: "Years 1–60",
    desc: "Discover traditional and modern gift materials, gemstones, and romantic card messages for every milestone year.",
    tags: ["Traditional Themes", "Modern Themes", "Card Messages"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Stationery & Creative Hub</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Wedding <span class="accent-italic">Stationery & Creative</span> Tools
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Format formal envelope addressing, size multi-layer invitation suites, calculate USPS postage with wax seals, and time wedding speeches.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Explore Categories:</span>
      <a href="/budget" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Budget</a>
      <a href="/dining" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Dining & Bar</a>
      <a href="/guests" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">👥 Guests & Logistics</a>
      <a href="/stationery" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">💌 Stationery (Active)</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {stationeryTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
            Launch Tool →
          </a>
        </div>
      ))}
    </div>

    <!-- In-Depth Stationery Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Stationery Etiquette</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          How to Format, Size & Mail Wedding Invitation Suites
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Everything you need to know about A7 standards, layering clearances, and USPS non-machinable surcharges.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. The Standard A7 Invitation Suite Hierarchy
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          To ensure all cards slide smoothly into the outer envelope without jamming, adhere to precise step-down dimensions:
        </p>
        
        <div style="overflow-x: auto; margin-top: 1rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Suite Piece</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Standard Size (Inches)</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Canva Bleed Size (300 DPI)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">A7 Outer Envelope</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">5.25" × 7.25"</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1575 × 2175 px</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Main Invitation Card</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">5.00" × 7.00"</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1538 × 2138 px (with 0.125" bleed)</td>
              </tr>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">A2 RSVP Card</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">3.50" × 5.00"</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1088 × 1538 px</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">A2 Return Envelope</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">4.375" × 5.75"</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1312 × 1725 px</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Frequently Asked Questions
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              What are the standard dimensions of an A7 wedding invitation suite?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              An A7 suite consists of: A7 Outer Envelope (5.25" × 7.25\"), Main Invitation Card (5\" × 7\"), A2 RSVP Card (3.5\" × 5\"), A2 Return Envelope (4.375\" × 5.75\"), and Details/Reception Enclosure Card (4\" × 6\" or 3.5\" × 5\").
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              How much USPS postage does a wedding invitation require?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              A standard 1-oz rectangular invitation requires a 1-oz Forever Stamp ($0.73 in 2026). If your suite weighs over 1.0 oz (due to multiple cards, heavy 120lb stock), or includes a wax seal / ribbon, it requires a 2-oz stamp ($1.01) plus a $0.44 non-machinable surcharge ($1.45 total).
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              How long should a Maid of Honor or Best Man wedding speech be?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              The sweet spot is 3 to 5 minutes (approximately 450 to 650 spoken words at a conversational pace of 120 WPM). Any speech longer than 6 minutes risks losing the attention of guests.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
