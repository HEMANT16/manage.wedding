---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/wedding-thank-you-cards/#webapp",
      "name": "Wedding Thank-You Note & Message Generator",
      "url": "https://manage.wedding/wedding-thank-you-cards",
      "description": "Free wedding thank-you card wording generator. Generate personalized, etiquette-perfect thank-you notes for cash gifts, honeymoon funds, registry items, and vendor appreciation. Export printable cards and track batch progress.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Write a Perfect Wedding Thank-You Note",
      "description": "The standard 4-sentence etiquette formula for writing sincere, polished wedding thank-you cards.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Sentence 1: Express Gratitude for Attendance",
          "text": "Thank the guest for celebrating with you or traveling to your wedding day."
        },
        {
          "@type": "HowToStep",
          "name": "Sentence 2: Specifically Name the Gift",
          "text": "Acknowledge the specific gift received (e.g. 'the beautiful Dutch oven' or 'your generous contribution to our honeymoon fund') without mentioning exact cash amounts."
        },
        {
          "@type": "HowToStep",
          "name": "Sentence 3: Share How You Will Use It",
          "text": "Tell the guest how you plan to enjoy the gift (e.g. 'We can't wait to make Sunday roast dinners with it' or 'It made our sunset sailing tour in Hawaii unforgettable')."
        },
        {
          "@type": "HowToStep",
          "name": "Sentence 4: Warm Sign-off & Future Connection",
          "text": "Close with a warm personal sentiment expressing excitement to see them again soon."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long do you have to send wedding thank-you cards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Modern wedding etiquette recommends sending thank-you cards within 3 months of returning from your honeymoon. For gifts received before the wedding, send thank-you notes within 2 to 3 weeks of receipt."
          }
        },
        {
          "@type": "Question",
          "name": "How do you say thank you for cash or money as a wedding gift?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never mention the exact dollar amount in writing. Instead, express gratitude for their 'generous gift' or 'generosity' and mention how you plan to use it, such as toward your honeymoon, future home down payment, or date nights."
          }
        },
        {
          "@type": "Question",
          "name": "Should wedding thank-you cards be handwritten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, traditional wedding etiquette strongly emphasizes handwritten thank-you notes inside physical stationery. While digital tools can draft your wording, writing the message by hand shows genuine personal appreciation."
          }
        },
        {
          "@type": "Question",
          "name": "What do you write to a wedding guest who attended but gave no gift?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Thank them warmly for their presence, companionship, and energy on your wedding day. Highlight a specific memory, such as seeing them on the dance floor or enjoying conversations during the reception."
          }
        },
        {
          "@type": "Question",
          "name": "How do you thank wedding vendors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Thank vendors specifically for their professionalism, artistry, and calmness under pressure. Mentioning specific highlights (e.g. stunning floral arches or keeping the dance floor packed) paired with a 5-star online review is the highest form of vendor appreciation."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Thank-You Note & Message Generator (Free Etiquette Wording)"
	description="Free wedding thank-you card wording generator. Generate personalized thank-you notes for cash gifts, honeymoon funds, registry items, and vendors. Export printable cards and track progress."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">14,800+ Monthly Notes Crafted</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Wedding Thank-You <span class="accent-italic">Message Generator</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Generate heartfelt, etiquette-perfect thank-you card wording for cash gifts, honeymoon funds, registry items, and guests. Copy in 1-click or print directly to stationery.
			</p>
		</header>

		<!-- Main Interactive Generator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Input Form -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Note Customizer
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Etiquette-Tuned
					</span>
				</div>

				<!-- Recipient Name -->
				<div class="form-group">
					<label class="form-label" for="guest-names">Guest / Recipient Name(s)</label>
					<input type="text" id="guest-names" class="form-input" value="Aunt Susan & Uncle Mike" placeholder="e.g. Aunt Susan & Uncle Mike, Jessica & David" />
				</div>

				<!-- Relationship to Couple -->
				<div class="form-group">
					<label class="form-label" for="relationship">Relationship</label>
					<select id="relationship" class="form-input" style="cursor: pointer;">
						<option value="family-close">Close Family (Parents, Grandparents, Siblings)</option>
						<option value="family-extended" selected>Extended Family (Aunts, Uncles, Cousins)</option>
						<option value="friends-close">Close Friends / Wedding Party</option>
						<option value="friends-casual">Coworkers / Casual Friends</option>
						<option value="absent">Guest Who Couldn't Attend (Sent Gift)</option>
						<option value="vendor">Wedding Vendor (Photographer, Planner, Caterer)</option>
					</select>
				</div>

				<!-- Gift Category -->
				<div class="form-group">
					<label class="form-label" for="gift-type">Gift Received</label>
					<select id="gift-type" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="cash" selected>💵 Cash / Check / Financial Gift</option>
						<option value="honeymoon">🏝️ Honeymoon Fund Contribution</option>
						<option value="registry">🎁 Physical Registry Item (Kitchen, Home, Decor)</option>
						<option value="attendance">✨ Presence Only (Attended / No Gift)</option>
						<option value="group">👥 Group Gift (From Multiple Friends/Coworkers)</option>
						<option value="giftcard">💳 Gift Card (Target, Amazon, Home Depot)</option>
					</select>
				</div>

				<!-- Gift Specific Item / Detail -->
				<div class="form-group" id="gift-detail-group">
					<label class="form-label" for="gift-detail">Specific Gift Detail / Intended Use</label>
					<input type="text" id="gift-detail" class="form-input" value="our honeymoon in Hawaii & first home fund" placeholder="e.g. KitchenAid Stand Mixer, sunset cruise in Maui" />
				</div>

				<!-- Tone / Style Selector -->
				<div class="form-group">
					<label class="form-label">Tone & Writing Style</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="tone-btn hand-btn is-active" data-tone="heartfelt" style="padding: 8px; font-size: 0.88rem;">
							💖 Heartfelt & Warm
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="formal" style="padding: 8px; font-size: 0.88rem;">
							🏛️ Formal & Classic
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="casual" style="padding: 8px; font-size: 0.88rem;">
							✨ Modern & Upbeat
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="short" style="padding: 8px; font-size: 0.88rem;">
							⚡ Short & Sweet (3-Sentence)
						</button>
					</div>
				</div>

				<!-- Personal Memory (Optional) -->
				<div class="form-group">
					<label class="form-label" for="personal-memory">Special Memory / Note (Optional)</label>
					<input type="text" id="personal-memory" class="form-input" value="Loved seeing you tearing up the dance floor!" placeholder="e.g. Thank you for traveling all the way from Chicago!" />
				</div>

				<!-- Sign-off Names -->
				<div class="form-group">
					<label class="form-label" for="signoff-names">Your Names (Sign-off)</label>
					<input type="text" id="signoff-names" class="form-input" value="Alex & Jordan" placeholder="e.g. Alex & Jordan" />
				</div>

				<button id="btn-generate-notes" class="hand-btn" style="width: 100%; padding: 14px; font-size: 1.1rem; margin-top: 0.5rem; justify-content: center;">
					<span>✨</span> Generate 3 Message Options
				</button>

			</div>

			<!-- Right Column: 3 Generated Options & Tracker -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Results Header -->
				<div style="display: flex; justify-content: space-between; align-items: center;">
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						Generated Wording Options
					</h3>
					<span id="word-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
						~45-65 words | 1.5 min writing
					</span>
				</div>

				<!-- Option 1 Card (Recommended) -->
				<div class="hand-card" style="padding: 1.5rem; background: #fffcf5; border-left: 6px solid var(--accent-red); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Option 1: Primary Recommendation
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-1" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copy Note
						</button>
					</div>
					<p id="note-opt-1" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
						Dear Aunt Susan & Uncle Mike,

Thank you so much for celebrating our wedding day with us! Having you there meant the world to both of us. We are so incredibly grateful for your generous gift toward our honeymoon in Hawaii & first home fund. Loved seeing you tearing up the dance floor! We can't wait to catch up again soon.

With lots of love,
Alex & Jordan
					</p>
				</div>

				<!-- Option 2 Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid var(--accent-blue); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-blue); letter-spacing: 0.05em;">
							Option 2: Alternative Phrasing
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-2" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copy Note
						</button>
					</div>
					<p id="note-opt-2" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
						Dear Aunt Susan & Uncle Mike,

We cannot thank you enough for making the trip to celebrate our marriage. Your love and presence brought so much joy to our celebration. Thank you sincerely for your wonderfully thoughtful gift for our honeymoon in Hawaii & first home fund. It is going to help us start this new chapter together in such a meaningful way!

Warmest regards,
Alex & Jordan
					</p>
				</div>

				<!-- Option 3 Card (Short & Sweet) -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid #16a34a; position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #16a34a; letter-spacing: 0.05em;">
							Option 3: Crisp & Direct
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-3" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copy Note
						</button>
					</div>
					<p id="note-opt-3" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
						Dear Aunt Susan & Uncle Mike,

Thank you for being part of our special day and for your wonderful generosity. Your gift toward our honeymoon in Hawaii & first home fund is deeply appreciated and means so much to us as newlyweds. Thank you for your warmth and love!

Warmly,
Alex & Jordan
					</p>
				</div>

				<!-- Action Bar -->
				<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
					<button id="btn-print-note" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>🖨️</span> Print Note Stationery (PDF)
					</button>
					<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>📄</span> Export Word Doc (.doc)
					</button>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Bottom Line Up Front (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Quick Rule of Thumb: Wedding Thank-You Notes
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Short on time? Here is the universal 4-sentence structure and timeline rules for writing wedding thank-you cards.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📝 The 4-Sentence Wedding Thank-You Formula:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					[1. Thank for Attending/Celebrating] + [2. Specifically Name Gift (Never exact dollar amount)] + [3. Tell How You'll Use It] + [4. Warm Sign-off & Future Meetup] • ⏰ Send within 3 months of returning from honeymoon.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Gift Scenario</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Etiquette-Approved Phrasing</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">What NOT To Write</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Cash / Check / Money</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Thank you for your generous gift toward our home down payment / honeymoon in Italy."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Never write exact dollar amounts (e.g. "Thanks for the $200").</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Registry Physical Item</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Thank you for the beautiful Dutch oven. We've already used it for our Sunday family stew!"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Don't use generic phrases like "Thanks for the item".</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Honeymoon Experience Fund</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Thank you for treating us to a romantic sunset catamaran dinner cruise in Maui!"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Don't forget to mention the specific adventure or tour funded.</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Guest Who Couldn't Attend</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"We missed you dearly on our wedding day, but we felt your love through your wonderful gift."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Don't guilt them or say "Too bad you skipped our wedding."</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #d97706);">Presence Only (No Gift)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Thank you so much for celebrating with us! Having you there on the dance floor made our day."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Never mention the absence of a physical gift.</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					The Complete Wedding Thank-You Note Etiquette Guide
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Writing 100+ handwritten notes doesn't have to be overwhelming. Follow modern etiquette, timing milestones, and pacing systems to breeze through your stack.
				</p>
			</div>

			<!-- Section 1: The 3-Month Rule -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. The 3-Month Etiquette Timeline Rule
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					There is an old myth that couples have "one full year" to send wedding thank-you notes. In modern wedding etiquette, this is considered outdated and discourteous.
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Gifts Received Before the Wedding:</strong> Send thank-you notes within <strong>2 to 3 weeks of arrival</strong>. This confirms to the sender that the package arrived safely before the chaos of wedding week.</li>
					<li><strong>Wedding Day Gifts & Cash:</strong> Send all cards within <strong>3 months of returning from your honeymoon</strong>.</li>
					<li><strong>Batch Pacing Formula:</strong> Writing 10 cards per night with your spouse finishes a 100-guest wedding in just 10 days!</li>
				</ul>
			</section>

			<!-- Section 2: Cash Gift Rules -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. How to Acknowledge Cash & Monetary Gifts Gracefully
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					The golden rule of monetary gifts is: <em>Acknowledge the generosity, never the number</em>.
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>✅ Correct Examples:</strong><br />
					• "Thank you so much for your generous gift toward our dream honeymoon in Japan. We used it to book an unforgettable traditional tea ceremony in Kyoto!"<br />
					• "Thank you for your warm generosity as we save toward purchasing our first home together. Your support means the world to us."<br /><br />
					<strong>❌ Avoid:</strong> "Thank you for the $150 check."
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Frequently Asked Questions
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">How long do you have to send wedding thank-you cards?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Modern wedding etiquette recommends completing and mailing all thank-you notes within 3 months of returning from your honeymoon.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Should both partners sign the wedding thank-you note?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Yes! The note should be written from the perspective of both partners ("We love it", "We are so grateful") and signed with both names (e.g. <em>Alex & Jordan</em>), even if only one person handles the handwriting.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Do you send a thank-you note to wedding party members who received gifts from the couple?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Yes. Even if you gave your bridesmaids or groomsmen gifts during the rehearsal dinner, you should still send them a heartfelt thank-you card for their time, financial expense, emotional support, and wedding day efforts.
					</p>
				</details>
			</section>

		</article>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/wedding-thank-you-cards" category="stationery" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const guestNamesInput = document.getElementById('guest-names');
		const relationshipSelect = document.getElementById('relationship');
		const giftTypeSelect = document.getElementById('gift-type');
		const giftDetailInput = document.getElementById('gift-detail');
		const giftDetailGroup = document.getElementById('gift-detail-group');
		const memoryInput = document.getElementById('personal-memory');
		const signoffInput = document.getElementById('signoff-names');
		const toneButtons = document.querySelectorAll('.tone-btn');
		const btnGenerate = document.getElementById('btn-generate-notes');

		const noteOpt1 = document.getElementById('note-opt-1');
		const noteOpt2 = document.getElementById('note-opt-2');
		const noteOpt3 = document.getElementById('note-opt-3');
		const wordCountBadge = document.getElementById('word-count-badge');
		const btnPrint = document.getElementById('btn-print-note');
		const btnDoc = document.getElementById('btn-export-doc');

		let currentTone = 'heartfelt';

		// Tone Toggle Handler
		toneButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				toneButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentTone = btn.getAttribute('data-tone');
				generateNotes();
			});
		});

		// Gift Type Handler
		giftTypeSelect.addEventListener('change', () => {
			const type = giftTypeSelect.value;
			if (type === 'attendance') {
				giftDetailGroup.style.display = 'none';
			} else {
				giftDetailGroup.style.display = 'block';
				if (type === 'cash') giftDetailInput.placeholder = 'e.g. our honeymoon in Hawaii & first home fund';
				else if (type === 'honeymoon') giftDetailInput.placeholder = 'e.g. sunset catamaran cruise in Maui';
				else if (type === 'registry') giftDetailInput.placeholder = 'e.g. KitchenAid Stand Mixer in Matte Black';
				else if (type === 'group') giftDetailInput.placeholder = 'e.g. espresso machine';
				else if (type === 'giftcard') giftDetailInput.placeholder = 'e.g. Home Depot gift card for our garden project';
			}
			generateNotes();
		});

		function generateNotes() {
			const names = guestNamesInput.value.trim() || 'Dear Friend';
			const rel = relationshipSelect.value;
			const gift = giftTypeSelect.value;
			const detail = giftDetailInput.value.trim() || 'your wonderful gift';
			const memory = memoryInput.value.trim();
			const signoff = signoffInput.value.trim() || 'Alex & Jordan';

			let opt1 = '', opt2 = '', opt3 = '';

			const memoryClause = memory ? ` ${memory}` : '';

			// Tone Formulations
			if (currentTone === 'heartfelt') {
				if (gift === 'cash') {
					opt1 = `Dear ${names},\n\nThank you so much for celebrating our wedding day with us! Having you there meant the world to both of us. We are so incredibly grateful for your generous gift toward ${detail}.${memoryClause} We can't wait to catch up again soon.\n\nWith lots of love,\n${signoff}`;
					opt2 = `Dear ${names},\n\nWe cannot thank you enough for making the trip to celebrate our marriage. Your love and presence brought so much joy to our celebration. Thank you sincerely for your wonderfully thoughtful gift toward ${detail}. It is going to help us start this new chapter together in such a meaningful way!${memoryClause}\n\nWarmest regards,\n${signoff}`;
					opt3 = `Dear ${names},\n\nThank you for being part of our special day and for your wonderful generosity. Your gift toward ${detail} is deeply appreciated and means so much to us as newlyweds.${memoryClause} Thank you for your warmth and love!\n\nWarmly,\n${signoff}`;
				} else if (gift === 'honeymoon') {
					opt1 = `Dear ${names},\n\nThank you for celebrating our wedding with us! We are beyond grateful for your generous contribution toward ${detail}. It made our honeymoon truly unforgettable and created memories we will cherish forever.${memoryClause}\n\nWith love and gratitude,\n${signoff}`;
					opt2 = `Dear ${names},\n\nHaving you share in our wedding day was so special to us. Thank you from the bottom of our hearts for treating us to ${detail} on our honeymoon! It was one of the absolute highlights of our trip.${memoryClause}\n\nWarmly,\n${signoff}`;
					opt3 = `Dear ${names},\n\nThank you for your love, support, and wonderful honeymoon gift toward ${detail}! Your kindness helped make our first adventure as a married couple extraordinary.${memoryClause}\n\nWith all our love,\n${signoff}`;
				} else if (gift === 'registry') {
					opt1 = `Dear ${names},\n\nThank you so much for celebrating our wedding with us! We absolutely adore the ${detail} you picked out from our registry. We have already found the perfect spot for it in our home!${memoryClause}\n\nWith love,\n${signoff}`;
					opt2 = `Dear ${names},\n\nIt was so wonderful to see you on our wedding day. Thank you so much for your thoughtful gift of the ${detail}. We can't wait to use it for many years of family gatherings and dinners!${memoryClause}\n\nWarmest wishes,\n${signoff}`;
					opt3 = `Dear ${names},\n\nThank you for sharing in our celebration and for the wonderful ${detail}. Your kindness and generosity mean the world to us as we build our home together.${memoryClause}\n\nLove,\n${signoff}`;
				} else {
					// Presence only
					opt1 = `Dear ${names},\n\nThank you so much for celebrating our wedding day with us! Having your love, energy, and presence there made our celebration complete.${memoryClause} We are so grateful for your friendship.\n\nWith love,\n${signoff}`;
					opt2 = `Dear ${names},\n\nWe are so happy you were able to join us for our wedding! Thank you for traveling to celebrate our marriage.${memoryClause} We can't wait to get together again soon!\n\nWarmly,\n${signoff}`;
					opt3 = `Dear ${names},\n\nThank you for being part of the best day of our lives! Your support and joy meant everything to us as we said 'I do.'${memoryClause}\n\nWith love,\n${signoff}`;
				}
			} else if (currentTone === 'formal') {
				opt1 = `Dear ${names},\n\nThank you for gracing us with your presence on our wedding day. We are deeply appreciative of your kind and generous gift toward ${detail}. Your thoughtfulness as we embark on our married life together is profoundly valued.${memoryClause}\n\nSincerely,\n${signoff}`;
				opt2 = `Dear ${names},\n\nWe wish to express our heartfelt appreciation for attending our wedding celebration. Thank you for your generous gift of ${detail}. It was a distinct pleasure having you with us on this momentous occasion.${memoryClause}\n\nWith highest regards,\n${signoff}`;
				opt3 = `Dear ${names},\n\nThank you for sharing in the joy of our marriage. We are deeply grateful for your generous contribution toward ${detail} and thank you for your enduring support of our new family.${memoryClause}\n\nRespectfully and warmly,\n${signoff}`;
			} else if (currentTone === 'casual') {
				opt1 = `Hey ${names}!\n\nThank you so much for coming to celebrate with us—you made our wedding day so much fun! We are so hyped about ${detail}.${memoryClause} Let's hang out soon!\n\nCheers,\n${signoff}`;
				opt2 = `Dear ${names},\n\nThank you for bringing the party to our wedding! We love the ${detail} so much and are so lucky to have you in our corner.${memoryClause} Big hugs!\n\nBest,\n${signoff}`;
				opt3 = `Hey ${names},\n\nThanks a million for celebrating with us and for the amazing gift of ${detail}! It means the world to both of us.${memoryClause} See you soon!\n\nLove,\n${signoff}`;
			} else {
				// Short & Sweet
				opt1 = `Dear ${names},\n\nThank you for celebrating our wedding day with us and for your generous gift toward ${detail}.${memoryClause} We are so grateful for your love and support!\n\nWith love,\n${signoff}`;
				opt2 = `Dear ${names},\n\nWe loved seeing you on our wedding day! Thank you so much for the wonderful ${detail}.${memoryClause} We appreciate you so much.\n\nWarmly,\n${signoff}`;
				opt3 = `Dear ${names},\n\nThank you for making our wedding day unforgettable and for your thoughtful gift of ${detail}.${memoryClause} Sending you all our love!\n\nLove,\n${signoff}`;
			}

			noteOpt1.textContent = opt1;
			noteOpt2.textContent = opt2;
			noteOpt3.textContent = opt3;

			const words = opt1.split(/\s+/).length;
			wordCountBadge.textContent = `~${words} words | ~1.5 mins writing time`;
		}

		// Event Listeners
		[guestNamesInput, relationshipSelect, giftDetailInput, memoryInput, signoffInput].forEach(inp => {
			inp.addEventListener('input', generateNotes);
		});
		btnGenerate.addEventListener('click', generateNotes);

		// Copy Button Logic
		document.querySelectorAll('.copy-note-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				const targetId = btn.getAttribute('data-target');
				const text = document.getElementById(targetId).textContent;
				navigator.clipboard.writeText(text).then(() => {
					const orig = btn.textContent;
					btn.textContent = '✅ Copied!';
					setTimeout(() => { btn.textContent = orig; }, 2000);
				});
			});
		});

		// Print Stationery PDF
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Print Thank-You Note — Manage.Wedding</title>
					<style>
						@page { size: 6in 4in; margin: 0.4in; }
						body { font-family: Georgia, serif; font-size: 12pt; line-height: 1.6; color: #1e293b; padding: 0.2in; }
					</style>
				</head>
				<body>
					<div>${noteText}</div>
					<script>window.onload = function() { window.print(); };<\/script>
				</body>
				</html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Wedding Thank-You Note</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 12pt; line-height: 1.6; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Thank-You Note Draft</h2>
					<p>${noteText}</p>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = `thank-you-${guestNamesInput.value.replace(/[^a-zA-Z0-9]/g, '_')}.doc`;
			link.click();
		});

		// Initial Generation
		generateNotes();
	</script>
</Layout>
