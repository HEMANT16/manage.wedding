---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import RelatedTools from '../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/wedding-playlist-duration-calculator/#webapp",
      "name": "Wedding Playlist, DJ Songs & Duration Sizer",
      "url": "https://manage.wedding/wedding-playlist-duration-calculator",
      "description": "Free 100% client-side wedding playlist duration calculator and DJ music brief maker. Calculate total songs needed per phase (ceremony, cocktail, dinner, dancing), select special dance cues, build must-play and blacklist tracks, and export a printable DJ brief in PDF and Word.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many songs do you need for a 5-hour wedding reception?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a 5-hour wedding reception (300 minutes), you need approximately 85 to 100 songs when tracks play in full (average 3.5 minutes each). For peak dance floor sets where professional DJs mix and transition every 2 to 3 minutes, plan for 20-25 songs per hour. Always provide a total playlist buffer of 120-130 tracks to give your DJ flexibility."
          }
        },
        {
          "@type": "Question",
          "name": "How many songs should be on a wedding 'Must-Play' list?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Top wedding DJs recommend limiting your 'Must-Play' list to 15 to 20 songs maximum. Providing 50+ mandatory songs handcuffs your DJ, preventing them from reading crowd energy and adapting the tempo to keep the dance floor packed."
          }
        },
        {
          "@type": "Question",
          "name": "How long should the First Dance and Parent Dances be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The ideal First Dance and Parent Dance duration is 2.5 to 3 minutes (150 to 180 seconds). Full 4-5 minute studio album versions feel uncomfortably long for the couple and cause guests to lose attention. Instruct your DJ or band to fade out or invite the bridal party to join at the 2:30 mark."
          }
        },
        {
          "@type": "Question",
          "name": "What is the recommended BPM energy curve for a wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard wedding music energy curve starts at 60-80 BPM for Ceremony Prelude (Acoustic/Classical), transitions to 90-115 BPM for Cocktail Hour (Jazzy/Soul/Indie Pop), relaxes to 70-95 BPM during Dinner, ramps up to 110-124 BPM for Dance Warm-Up, hits 120-132 BPM during Peak Party Time (Dance/Pop/Hip Hop/EDM), and finishes with 80-115 BPM Singalong Power Anthems for the Grand Sendoff."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Size and Plan a Wedding Playlist & DJ Music Brief",
      "description": "Step-by-step method to calculate song counts, schedule key moment dances with timestamps, and generate a printable DJ brief.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Set Phase Durations and Transition Style",
          "text": "Input the exact minutes for your Ceremony Prelude, Cocktail Hour, Dinner Service, and Dance Floor Party to calculate base song counts."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Choose Special Moment Tracks & Cue Notes",
          "text": "Select songs and specific timestamp instructions (fade-out at 2:30, chorus entrance) for your Processional, First Dance, Parent Dances, and Cake Cutting."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Build Must-Play and Do-Not-Play Lists",
          "text": "Add up to 15-20 essential crowd-pleasers and blacklist unwanted genres (like line dances) and specific banned songs."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Export Printable DJ Brief (PDF & Word)",
          "text": "Download the complete formatted DJ / Band Music Brief to review during your final vendor timeline walkthrough."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Playlist, DJ Songs & Duration Sizer (Free PDF & Word Brief) | Manage.Wedding"
	description="Calculate exact song counts by wedding phase, select special moment dance cues, build must-play and blacklist tracks, and export a ready-to-print DJ brief in PDF & Word."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Wedding Playlist & DJ Sizer" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🎵</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Free • Private In-Browser • 1-Click DJ Brief PDF Export</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Wedding Playlist & DJ Duration Sizer
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 740px; margin: 0 auto; text-align: center;">
					Calculate exact song counts for every wedding phase, assign key special dances with audio cue notes, build your <strong>Must-Play & Blacklist</strong> sheets, and export a professional <strong>DJ / Band Music Brief</strong> in PDF and Word!
				</p>
			</div>
		</section>

		<!-- 3-Step Quick Guide -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>🎧</span> How to Build Your Wedding Music Brief in 3 Simple Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Set Phase Durations
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Adjust sliders for Ceremony, Cocktail Hour, Dinner, and Dance Floor to calculate exact song counts and BPM flow.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Cue Special Moments
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Pick tracks and precise fade/start instructions for First Dance, Processional, Parent Dances, and Cake Cutting.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Build Must-Play & Export
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Add up to 20 must-plays, blacklist unwanted tracks, and click <strong>"Export PDF Brief"</strong> for your DJ or live band.
					</p>
				</div>
			</div>
		</div>

		<!-- Interactive Application Workspace -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SECTION 1: Phase Duration Sliders & Song Math Dashboard -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🎚️ 1. Wedding Phase Durations & Song Sizer
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Estimate track counts based on minutes per phase and DJ transition mixing style
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center;">
						<label for="select-mix-pacing" class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil);">
							DJ Style:
						</label>
						<select id="select-mix-pacing" style="padding: 0.35rem 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem; font-weight: 600;">
							<option value="radio" selected>Standard Radio Play (~3.5 min / 17 songs/hr)</option>
							<option value="quickmix">Club / DJ Quick Transitions (~2.7 min / 22 songs/hr)</option>
							<option value="lounge">Acoustic & Extended Lounge (~4.2 min / 14 songs/hr)</option>
						</select>
					</div>
				</div>

				<!-- Sliders Grid -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
					
					<!-- Prelude -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-prelude" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🎻</span> Ceremony Prelude
							</label>
							<span id="val-prelude" class="font-heading" style="font-size: 1rem; color: var(--accent-red); font-weight: 700;">30 min</span>
						</div>
						<input type="range" id="slider-prelude" min="15" max="60" step="5" value="30" style="width: 100%; accent-color: var(--accent-red);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>15 min</span>
							<span id="songs-prelude" style="font-weight: 600; color: var(--fg-pencil);">~9 songs (60-80 BPM)</span>
							<span>60 min</span>
						</div>
					</div>

					<!-- Cocktail Hour -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-cocktail" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍸</span> Cocktail Hour
							</label>
							<span id="val-cocktail" class="font-heading" style="font-size: 1rem; color: var(--accent-blue); font-weight: 700;">60 min</span>
						</div>
						<input type="range" id="slider-cocktail" min="30" max="120" step="5" value="60" style="width: 100%; accent-color: var(--accent-blue);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>30 min</span>
							<span id="songs-cocktail" style="font-weight: 600; color: var(--fg-pencil);">~17 songs (90-115 BPM)</span>
							<span>120 min</span>
						</div>
					</div>

					<!-- Dinner Service -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dinner" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍽️</span> Dinner Service
							</label>
							<span id="val-dinner" class="font-heading" style="font-size: 1rem; color: #d97706; font-weight: 700;">90 min</span>
						</div>
						<input type="range" id="slider-dinner" min="45" max="150" step="5" value="90" style="width: 100%; accent-color: #d97706;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>45 min</span>
							<span id="songs-dinner" style="font-weight: 600; color: var(--fg-pencil);">~25 songs (70-95 BPM)</span>
							<span>150 min</span>
						</div>
					</div>

					<!-- Dance Party -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dance" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🕺</span> Dance Floor Party
							</label>
							<span id="val-dance" class="font-heading" style="font-size: 1rem; color: #16a34a; font-weight: 700;">180 min (3.0h)</span>
						</div>
						<input type="range" id="slider-dance" min="60" max="360" step="15" value="180" style="width: 100%; accent-color: #16a34a;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>1 hour</span>
							<span id="songs-dance" style="font-weight: 600; color: var(--fg-pencil);">~52-60 songs (118-132 BPM)</span>
							<span>6 hours</span>
						</div>
					</div>

					<!-- Late Night Afterparty -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-afterparty" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🌙</span> Late-Night / Afterparty
							</label>
							<span id="val-afterparty" class="font-heading" style="font-size: 1rem; color: #7c3aed; font-weight: 700;">0 min</span>
						</div>
						<input type="range" id="slider-afterparty" min="0" max="120" step="15" value="0" style="width: 100%; accent-color: #7c3aed;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>0 min (Off)</span>
							<span id="songs-afterparty" style="font-weight: 600; color: var(--fg-pencil);">0 songs</span>
							<span>120 min</span>
						</div>
					</div>

				</div>

				<!-- Live Sizing Summary Banner -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; background: var(--muted-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; text-align: center;">
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total Music Runtime</span>
						<strong id="display-total-runtime" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil);">6h 00m (360 min)</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Exact Tracks Played</span>
						<strong id="display-exact-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue);">~103 Songs</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Recommended Total Playlist (+20% Buffer)</span>
						<strong id="display-buffered-tracks" class="font-heading" style="font-size: 1.6rem; color: #16a34a;">~125 Songs</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Peak Dance Floor Songs</span>
						<strong id="display-dance-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red);">~52 Songs</strong>
					</div>
				</div>

			</div>

			<!-- SECTION 2: Key Special Moment Track Selector -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							💃 2. Key Special Moments & Audio Cue Timestamps
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Select popular recommendations or input custom songs with precise fade/announcement cues
						</span>
					</div>
					<button type="button" id="btn-autofill-special" class="hand-btn" style="padding: 0.3rem 0.7rem; font-size: 0.8rem; background: #eff6ff;">
						✨ Load Classic Popular Picks
					</button>
				</div>

				<div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" id="special-moments-container">
					<!-- Special moment cards will be rendered dynamically by JS -->
				</div>
			</div>

			<!-- SECTION 3: Must-Play & Blacklist List Builder -->
			<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 1fr; gap: 1.5rem;">
				
				<!-- Must-Play Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.25rem; color: #16a34a; margin: 0;">
								⭐ Must-Play Priority Tracks
							</h3>
							<span class="font-body" style="font-size: 0.8rem; color: var(--text-secondary);">
								Target: 10–20 songs (leaves room for DJ to read the crowd)
							</span>
						</div>
						<span id="must-play-counter" class="badge-postit" style="font-size: 0.85rem;">0 / 20 Songs</span>
					</div>

					<!-- Quick Add Pills -->
					<div style="margin-bottom: 1rem; background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<span class="font-heading" style="font-size: 0.8rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem;">
							⚡ Quick Add Crowd-Pleasers:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;" id="quick-must-pills">
							<button type="button" class="btn-quick-add hand-btn" data-title="September" data-artist="Earth, Wind & Fire" data-phase="dance" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ September (EWF)</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Mr. Brightside" data-artist="The Killers" data-phase="dance" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Mr. Brightside</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="I Wanna Dance With Somebody" data-artist="Whitney Houston" data-phase="dance" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Whitney Houston</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Dancing Queen" data-artist="ABBA" data-phase="dance" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ ABBA Dancing Queen</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Uptown Funk" data-artist="Mark Ronson ft. Bruno Mars" data-phase="dance" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Uptown Funk</button>
						</div>
					</div>

					<!-- Add Track Form -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 0.9fr auto; gap: 0.4rem; margin-bottom: 1rem;">
						<input type="text" id="input-must-title" placeholder="Song Title (e.g. Levitating)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<input type="text" id="input-must-artist" placeholder="Artist (e.g. Dua Lipa)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<select id="select-must-phase" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.8rem; background: #fff;">
							<option value="Dance Floor - Peak">Peak Dance</option>
							<option value="Cocktail Hour">Cocktail</option>
							<option value="Dinner Service">Dinner</option>
							<option value="Singalong Anthem">Singalong</option>
						</select>
						<button type="button" id="btn-add-must" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background: #16a34a; color: #fff;">+ Add</button>
					</div>

					<!-- Must-Play Table / List -->
					<div id="must-play-list" style="max-height: 280px; overflow-y: auto; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #faf8f5; padding: 0.5rem;">
						<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin: 1rem 0;">No must-play songs added yet. Add songs above!</p>
					</div>
				</div>

				<!-- Do-Not-Play (Blacklist) Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.25rem; color: var(--accent-red); margin: 0;">
								🚫 Do-Not-Play (Blacklist)
							</h3>
							<span class="font-body" style="font-size: 0.8rem; color: var(--text-secondary);">
								Genres and tracks strictly forbidden from being played
							</span>
						</div>
						<span id="blacklist-counter" class="badge-postit" style="font-size: 0.85rem; background: #fee2e2; border-color: var(--accent-red);">0 Banned</span>
					</div>

					<!-- Banned Genres Checkboxes -->
