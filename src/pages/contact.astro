---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Us | Manage.Wedding",
  "url": "https://manage.wedding/contact",
  "description": "Get in touch with the Manage.Wedding team. Send us tool feedback, feature requests, calculator suggestions, or general wedding planning inquiries."
};
---

<Layout 
	title="Contact Us | Manage.Wedding — Get in Touch"
	description="Contact Manage.Wedding. Have feedback on a calculator, a bug to report, or an idea for a new wedding planning tool? We'd love to hear from you."
	schema={schema}
>
	<main style="max-width: 1000px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box;">
		
		<!-- Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<span class="badge-postit">We're Here to Help</span>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 52px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin: 0.75rem 0;">
					Contact Manage.Wedding
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 650px; margin: 0 auto; text-align: center;">
					Have an idea for a new calculator, feedback on an existing tool, or found a glitch? Drop us a note below!
				</p>
			</div>
		</section>

		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
			
			<!-- Contact Form Card -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fff;">
				<h2 class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					Send Us a Message
				</h2>
				<p style="font-size: 0.95rem; color: var(--text-secondary); margin-bottom: 1.5rem; text-align: center;">
					Fill out the quick form below to open an email draft directly to our team.
				</p>

				<form id="contact-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					<div>
						<label class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
							Your Name
						</label>
						<input 
							type="text" 
							id="contact-name" 
							required 
							placeholder="e.g., Alex & Jordan" 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box;"
						/>
					</div>

					<div>
						<label class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
							Your Email Address
						</label>
						<input 
							type="email" 
							id="contact-email" 
							required 
							placeholder="e.g., couple@example.com" 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box;"
						/>
					</div>

					<div>
						<label class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
							Topic
						</label>
						<select id="contact-topic" class="hand-input" style="width: 100%; box-sizing: border-box; background: #fff;">
							<option value="Tool Feedback">💡 Suggest a New Calculator / Feature</option>
							<option value="Bug Report">🐛 Report a Calculation Glitch / Bug</option>
							<option value="General Question">💬 General Wedding Planning Question</option>
							<option value="Partnership / Press">🤝 Media, Press, or Partnership</option>
							<option value="Privacy Inquiry">🛡️ Privacy or Data Question</option>
						</select>
					</div>

					<div>
						<label class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
							Message
						</label>
						<textarea 
							id="contact-message" 
							rows="5" 
							required 
							placeholder="Tell us what's on your mind, which tool you're using, or what new feature would make your planning easier..." 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; resize: vertical; font-family: var(--font-body);"
						></textarea>
					</div>

					<button 
						type="submit" 
						class="hand-btn" 
						style="width: 100%; padding: 12px 20px; font-size: 1.15rem; cursor: pointer; margin-top: 0.5rem;"
					>
						✉️ Send Message
					</button>
				</form>

				<div id="contact-toast" style="display: none; background: #dcfce7; border: 2px solid #16a34a; border-radius: 6px; padding: 1rem; margin-top: 1.5rem; text-align: center; color: #166534; font-weight: bold;">
					✅ Message draft created! If your email app did not open automatically, reach out to us at <a href="mailto:hello@manage.wedding" style="color: #166534; text-decoration: underline;">hello@manage.wedding</a>.
				</div>
			</div>

			<!-- Direct Contact Info & FAQ Side Column -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Direct Channels -->
				<div class="hand-card" style="padding: 1.75rem; background: var(--bg-paper);">
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin-bottom: 1rem; text-align: center;">
						Direct Inboxes
					</h3>
					
					<div style="display: flex; flex-direction: column; gap: 1rem; font-size: 0.95rem;">
						<div style="padding: 0.75rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px;">
							<strong style="display: block; color: var(--fg-pencil);">💬 General & Support:</strong>
							<a href="mailto:hello@manage.wedding" style="color: var(--text-color); font-weight: bold; text-decoration: underline;">hello@manage.wedding</a>
						</div>

						<div style="padding: 0.75rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px;">
							<strong style="display: block; color: var(--fg-pencil);">💡 Feature Suggestions:</strong>
							<a href="mailto:ideas@manage.wedding" style="color: var(--text-color); font-weight: bold; text-decoration: underline;">ideas@manage.wedding</a>
						</div>

						<div style="padding: 0.75rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px;">
							<strong style="display: block; color: var(--fg-pencil);">🛡️ Privacy & Compliance:</strong>
							<a href="mailto:privacy@manage.wedding" style="color: var(--text-color); font-weight: bold; text-decoration: underline;">privacy@manage.wedding</a>
						</div>
					</div>
				</div>

				<!-- Quick Response Guarantee -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
						⚡ Response Time
					</h3>
					<p style="font-size: 0.95rem; color: #555; margin: 0; line-height: 1.5; text-align: center;">
						We read every message from couples, bridal party members, and wedding coordinators. We typically respond within <strong>24–48 hours</strong>.
					</p>
				</div>

				<!-- Quick FAQ -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.75rem; text-align: center;">
						Frequently Asked
					</h3>
					<details style="margin-bottom: 0.75rem; cursor: pointer;">
						<summary style="font-weight: bold; color: var(--fg-pencil); font-size: 0.95rem;">Are these tools really 100% free?</summary>
						<p style="font-size: 0.9rem; color: #555; margin-top: 0.35rem; line-height: 1.4;">Yes! All 30+ calculators and downloadable templates are free for personal wedding planning without hidden fees.</p>
					</details>
					<details style="margin-bottom: 0.75rem; cursor: pointer;">
						<summary style="font-weight: bold; color: var(--fg-pencil); font-size: 0.95rem;">Can I request a custom calculator?</summary>
						<p style="font-size: 0.9rem; color: #555; margin-top: 0.35rem; line-height: 1.4;">Absolutely! Use the form or email <a href="mailto:ideas@manage.wedding">ideas@manage.wedding</a> with what you'd like to see.</p>
					</details>
					<details style="cursor: pointer;">
						<summary style="font-weight: bold; color: var(--fg-pencil); font-size: 0.95rem;">Do you save my guest list or speeches?</summary>
						<p style="font-size: 0.9rem; color: #555; margin-top: 0.35rem; line-height: 1.4;">No. Everything runs 100% client-side in your browser storage. We never collect or store your data on remote servers.</p>
					</details>
				</div>

			</div>

		</div>

	</main>

	<script is:inline>
		const contactForm = document.getElementById('contact-form');
		const contactToast = document.getElementById('contact-toast');

		if (contactForm) {
			contactForm.addEventListener('submit', (e) => {
				e.preventDefault();
				const name = document.getElementById('contact-name').value;
				const email = document.getElementById('contact-email').value;
				const topic = document.getElementById('contact-topic').value;
				const message = document.getElementById('contact-message').value;

				const subject = encodeURIComponent(`[Manage.Wedding Contact] ${topic} - from ${name}`);
				const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nTopic: ${topic}\n\nMessage:\n${message}\n\n---\nSent via Manage.Wedding Contact Form`);
				
				const mailtoUrl = `mailto:hello@manage.wedding?subject=${subject}&body=${body}`;
				
				// Open user's email client
				window.location.href = mailtoUrl;

				// Show visual confirmation toast
				if (contactToast) {
					contactToast.style.display = 'block';
					contactToast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				}
			});
		}
	</script>
</Layout>
