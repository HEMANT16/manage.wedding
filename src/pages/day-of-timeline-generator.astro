---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Day-Of Timeline Generator & Schedule Maker",
      "url": "https://manage.wedding/day-of-timeline-generator",
      "description": "Free wedding day timeline generator. Build a stress-free schedule based on your ceremony start time, first look, travel buffer, and export to Word, PDF, or Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does this wedding timeline generator work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Enter your ceremony start time, choose whether you are doing a First Look, and specify your travel buffer. The tool calculates your entire schedule backward and forward—from hair and makeup to the sparkler grand exit—and lets you customize, edit, and export."
          }
        },
        {
          "@type": "Question",
          "name": "How does having a First Look affect the wedding timeline?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A First Look shifts couple, wedding party, and immediate family portraits before the ceremony (roughly 2 to 2.5 hours prior). This allows the newlyweds to fully enjoy their cocktail hour and mingle with guests immediately after the ceremony."
          }
        },
        {
          "@type": "Question",
          "name": "How much buffer time should be added to a wedding schedule?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We recommend adding a 15-minute buffer to hair and makeup, a 15-minute buffer before departing for the ceremony, and a 15-minute cushion before the grand entrance. Delays are inevitable, and buffers keep you on track without feeling rushed."
          }
        },
        {
          "@type": "Question",
          "name": "Can I export this wedding timeline to Word or PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Click the 'Export Word (.doc)' or 'Export PDF / Print' button at the top of your generated timeline. You will get a cleanly formatted schedule with vendor notes and time slots ready to email to your bridal party, coordinator, and photographer."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Build a Seamless Wedding Day Timeline",
      "description": "Step-by-step master guide to creating a perfectly timed, stress-free wedding day itinerary from morning hair and makeup to the sparkler grand exit.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Set Ceremony Start Time as Anchor",
          "text": "Identify your fixed ceremony start time (e.g. 4:30 PM) which serves as the core anchor point for all preceding and succeeding timeline events."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Choose First Look vs. Traditional Reveal",
          "text": "Decide whether to capture couple and wedding party portraits 1.5 to 2 hours before the ceremony (First Look) or during the post-ceremony cocktail hour."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Calculate Hair and Makeup Duration",
          "text": "Budget 45 minutes per bridesmaid/attendee plus 60-90 minutes for the bride, adding a 30-minute buffer before portraits begin."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Schedule Reception Dining and Speeches",
          "text": "Allocate 60 minutes for cocktail hour, 90 minutes (1.5 hrs) for dinner service and toasts, followed by 2.5 to 3 hours of dancing and cake cutting."
        },
        {
          "@type": "HowToStep",
          "name": "Step 5: Export and Share Itinerary",
          "text": "Export your master schedule to Word (.doc), PDF, or CSV and distribute copies to your photographer, DJ/band, caterer, and bridal party."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Day Timeline Generator (Free Schedule Maker with Word & PDF Export) | Manage.Wedding"
	description="Create your perfect wedding day timeline in seconds. Customize first look, ceremony, dinner, and photo schedules. Export to Word (.doc), PDF, or CSV instantly."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Wedding Day Timeline Generator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Plan your perfect, stress-free wedding day down to the minute. Factor in hair & makeup, first looks, travel buffers, and export to <strong>Word (.doc)</strong>, <strong>PDF</strong>, or <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Timeline Builder Controls & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						⏱️ Timeline Generator & Master Itinerary
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Calculated backward and forward from ceremony time
					</span>
				</div>

				<!-- Export & Control Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Export Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Export PDF / Print
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Export Excel (.csv)
					</button>
					<button type="button" id="btn-copy-summary" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📋 Copy Text Summary
					</button>
				</div>
			</div>

			<!-- Preset Timeline Quick Switcher -->
			<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
				<span class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
					⚡ Choose a Popular Timeline Template:
				</span>
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" id="preset-buttons-container">
					<button type="button" class="preset-btn active-preset" data-ceremony="16:00" data-firstlook="yes" data-travel="15" data-reception="4">
						🌅 Afternoon Classic (4:00 PM • First Look)
					</button>
					<button type="button" class="preset-btn" data-ceremony="17:30" data-firstlook="yes" data-travel="10" data-reception="4.5">
						🌇 Sunset Romance (5:30 PM • Golden Hour)
					</button>
					<button type="button" class="preset-btn" data-ceremony="15:30" data-firstlook="no" data-travel="20" data-reception="4">
						⛪ Traditional Church (No First Look)
					</button>
					<button type="button" class="preset-btn" data-ceremony="11:00" data-firstlook="yes" data-travel="10" data-reception="3.5">
						🥞 Morning Brunch Wedding (11:00 AM)
					</button>
				</div>
			</div>

			<!-- Core Configuration Form Inputs -->
			<form id="timeline-form" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; align-items: end;">
				<div>
					<label for="ceremony-time" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						Ceremony Start Time
					</label>
					<input type="time" id="ceremony-time" value="16:00" required style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: var(--bg-paper);">
				</div>

				<div>
					<label for="first-look" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						First Look Photos?
					</label>
					<select id="first-look" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: #fff;">
						<option value="yes" selected>Yes (Photos before Ceremony)</option>
						<option value="no">No (Photos during Cocktail Hour)</option>
					</select>
				</div>

				<div>
					<label for="travel-time" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						Travel to Venue (Mins)
					</label>
					<input type="number" id="travel-time" min="0" max="180" value="15" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: var(--bg-paper);">
				</div>

				<div>
					<label for="reception-hours" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						Reception Length (Hours)
					</label>
					<select id="reception-hours" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: #fff;">
						<option value="3.5">3.5 Hours</option>
						<option value="4" selected>4.0 Hours (Standard)</option>
						<option value="4.5">4.5 Hours</option>
						<option value="5">5.0 Hours</option>
						<option value="6">6.0 Hours (Late Party)</option>
					</select>
				</div>
			</form>
		</div>

		<!-- Main Workspace Grid: Interactive Timeline Stream + Custom Milestone Adder -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 340px; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="timeline-workspace-grid">
			
			<!-- Left: Master Visual Vertical Timeline Stream -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Header & Audience Filter Tabs -->
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h3 class="font-heading" style="font-size: 1.4rem; margin: 0; color: var(--fg-pencil);">
							📋 Day-Of Master Itinerary
						</h3>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
							Drag, edit, or remove timeline events
						</span>
					</div>

					<!-- Role Filter Pills -->
					<div style="display: flex; gap: 0.3rem; flex-wrap: wrap;" id="role-filter-group">
						<button type="button" class="role-pill-btn active-role" data-role="all">All Events</button>
						<button type="button" class="role-pill-btn" data-role="wedding-party">👰 Wedding Party</button>
						<button type="button" class="role-pill-btn" data-role="photo">📸 Photo & Video</button>
						<button type="button" class="role-pill-btn" data-role="reception">🍽️ Reception</button>
					</div>
				</div>

				<!-- Vertical Timeline Container -->
				<div id="timeline-stream" class="timeline-stream-box" style="position: relative; padding-left: 2.25rem; border-left: 3px solid var(--fg-pencil); margin-left: 1rem;">
					<!-- Injected via JS -->
				</div>

			</div>

			<!-- Right: Custom Milestone Adder & Day-Of Buffer Checklist -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Add Custom Milestone Card -->
				<div class="hand-card" style="padding: 1.25rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
						<span>➕</span> Add Custom Milestone
					</h3>
					
					<form id="add-custom-event-form" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<div>
							<label for="custom-event-name" class="font-heading" style="display: block; font-size: 0.85rem; margin-bottom: 0.2rem;">Event / Moment Name</label>
							<input type="text" id="custom-event-name" required placeholder="e.g. Sparkler Send-Off, Private Vows" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.95rem; background: var(--bg-paper);">
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<label for="custom-event-time" class="font-heading" style="display: block; font-size: 0.85rem; margin-bottom: 0.2rem;">Time</label>
								<input type="time" id="custom-event-time" required value="20:00" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.9rem; background: var(--bg-paper);">
							</div>
							<div>
								<label for="custom-event-role" class="font-heading" style="display: block; font-size: 0.85rem; margin-bottom: 0.2rem;">Category</label>
								<select id="custom-event-role" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
									<option value="reception">Reception</option>
									<option value="wedding-party">Wedding Party</option>
									<option value="photo">Photo & Video</option>
								</select>
							</div>
						</div>

						<button type="submit" class="hand-btn" style="padding: 0.5rem; font-size: 0.95rem; margin-top: 0.25rem;">
							✨ Add to Timeline
						</button>
					</form>
				</div>

				<!-- Essential Day-Of Timing Rules Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.5rem;">
						📌 The 15-Minute Buffer Rule:
					</strong>
					<ul class="font-body" style="font-size: 0.85rem; line-height: 1.5; padding-left: 1.1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Hair & Makeup:</strong> Aim to finish 45 minutes before departure.</li>
						<li><strong>Travel:</strong> Add +15 mins to Google Maps travel estimates.</li>
						<li><strong>Ceremony:</strong> Expect a 5-10 min delay for late guests to sit.</li>
						<li><strong>Sunset:</strong> Schedule couple portraits 45 mins before sunset.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Official Wedding Day-Of Itinerary</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Ceremony Start: <span id="print-ceremony-time"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; width: 90px; text-align: left;">Time</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Event / Milestone</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 120px; text-align: left;">Category</th>
					</tr>
				</thead>
				<tbody id="print-timeline-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ BLUF Rule of Thumb</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Quick Rule of Thumb: Wedding Day-Of Timeline Formulas
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>The 1-Minute Core Formula:</strong> Always anchor your master schedule to your <strong>Ceremony Start Time</strong> and calculate backward for prep and forward for reception milestones. Budget <strong>45 minutes per person</strong> for hair & makeup (plus 60–90 min for the bride), schedule couples & party photos <strong>1.5 to 2 hours prior</strong> (if doing a First Look), allot a <strong>30-minute guest arrival buffer</strong>, and budget <strong>1.5 hours (90 mins)</strong> for dinner service.
			</p>
			
			<!-- Benchmark Milestone Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Timeline Milestone</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Standard Duration</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Ideal Target Timing</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Pro Logistics & Buffer Rule</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Hair & Makeup (HMUA)</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">45 min/attendee; 60–90 min bride</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Finish 1 hr prior to portraits</td>
							<td style="padding: 0.6rem 0.8rem;">Add 30-min buffer; bride finishes second-to-last</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">First Look & Couples Portraits</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">45–60 minutes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">T-minus 2.5 to 3 hrs before ceremony</td>
							<td style="padding: 0.6rem 0.8rem;">Private intimate reveal; tests natural lighting</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Wedding Party & Family Photos</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">45–60 minutes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">T-minus 1.5 to 2 hrs before ceremony</td>
							<td style="padding: 0.6rem 0.8rem;">Pre-assign helper with printed family groupings</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Ceremony & Recessional</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">20–30 min (religious: 45–60 min)</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Anchor zero-hour (e.g., 4:30 PM)</td>
							<td style="padding: 0.6rem 0.8rem;">Prelude music starts 20–30 min prior for seating</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Cocktail Hour</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">60 minutes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Immediately post-ceremony</td>
							<td style="padding: 0.6rem 0.8rem;">Bar opens immediately; allows ballroom room flip</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Grand Entrance & Dinner Service</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">90 minutes (1.5 hours)</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">6:30 PM – 8:00 PM</td>
							<td style="padding: 0.6rem 0.8rem;">Intersperse speeches between courses to save time</td>
						</tr>
						<tr>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Open Dancing & Grand Send-Off</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">2.5–3 hours</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">8:00 PM – 11:00 PM</td>
							<td style="padding: 0.6rem 0.8rem;">Announce last call 30 min prior; 15 min exit</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- SEO Article & Comprehensive Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Timeline Master Guide</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem;">
					The Complete Wedding Day-Of Timeline Guide
				</h2>
