<script is:inline>
	let timelineEvents = [];
	let activeRoleFilter = 'all';

	const ceremonyInput = document.getElementById('ceremony-time');
	const firstLookInput = document.getElementById('first-look');
	const travelInput = document.getElementById('travel-time');
	const receptionHoursInput = document.getElementById('reception-hours');
	const timelineStream = document.getElementById('timeline-stream');

	function parseTimeToMinutes(timeStr) {
		const [h, m] = timeStr.split(':').map(Number);
		return h * 60 + m;
	}

	function minutesToFormattedTime(totalMinutes) {
		let normalized = (totalMinutes % 1440 + 1440) % 1440;
		let hours = Math.floor(normalized / 60);
		let minutes = normalized % 60;
		const ampm = hours >= 12 ? 'PM' : 'AM';
		hours = hours % 12;
		if (hours === 0) hours = 12;
		const minStr = minutes < 10 ? '0' + minutes : minutes;
		return `${hours}:${minStr} ${ampm}`;
	}

	function minutesToTimeInput(totalMinutes) {
		let normalized = (totalMinutes % 1440 + 1440) % 1440;
		let hours = Math.floor(normalized / 60);
		let minutes = normalized % 60;
		const hStr = hours < 10 ? '0' + hours : hours;
		const mStr = minutes < 10 ? '0' + minutes : minutes;
		return `${hStr}:${mStr}`;
	}

	function calculateTimeline() {
		const ceremonyMins = parseTimeToMinutes(ceremonyInput.value);
		const firstLook = firstLookInput.value;
		const travelMins = parseInt(travelInput.value) || 0;
		const receptionLengthMins = Math.round(parseFloat(receptionHoursInput.value) * 60);

		timelineEvents = [];

		if (firstLook === 'yes') {
			// Hair & Makeup (starts 4.5 hours before ceremony)
			timelineEvents.push({
				id: 'evt-1',
				minutes: ceremonyMins - travelMins - 120 - 150,
				name: 'Hair & Makeup / Bridal Party Getting Ready',
				role: 'wedding-party',
				description: 'Bridal prep, robes, and mimosa toast'
			});
			// Photographers Arrive
			timelineEvents.push({
				id: 'evt-2',
				minutes: ceremonyMins - travelMins - 120 - 45,
				name: 'Photographer Arrives for Getting Ready & Detail Shots',
				role: 'photo',
				description: 'Dress, rings, shoes, perfume & stationary flat lays'
			});
			// Bride into Dress
			timelineEvents.push({
				id: 'evt-3',
				minutes: ceremonyMins - travelMins - 120 - 15,
				name: 'Bride Steps Into Wedding Dress',
				role: 'wedding-party',
				description: 'Mom and bridesmaids assist with veil & buttons'
			});
			// First Look
			timelineEvents.push({
				id: 'evt-4',
				minutes: ceremonyMins - travelMins - 120,
				name: 'First Look & Couple Portraits',
				role: 'photo',
				description: 'Private romantic moment between the couple'
			});
			// Wedding Party & Family Photos
			timelineEvents.push({
				id: 'evt-5',
				minutes: ceremonyMins - travelMins - 60,
				name: 'Wedding Party & Immediate Family Photos',
				role: 'photo',
				description: 'Bridesmaids, groomsmen, and parents portraits'
			});
			// Travel / Hide Away
			if (travelMins > 0) {
				timelineEvents.push({
					id: 'evt-6',
					minutes: ceremonyMins - travelMins - 15,
					name: 'Depart & Travel to Ceremony Venue',
					role: 'wedding-party',
					description: `${travelMins} minute drive with built-in buffer`
				});
			}
			timelineEvents.push({
				id: 'evt-7',
				minutes: ceremonyMins - 20,
				name: 'Bride & Groom Relax in Suite / Guests Begin Arriving',
				role: 'wedding-party',
				description: 'Prelude music begins and ushers seat guests'
			});
		} else {
			// Traditional (No First Look)
			timelineEvents.push({
				id: 'evt-1',
				minutes: ceremonyMins - travelMins - 180,
				name: 'Hair & Makeup / Bridal Party Getting Ready',
				role: 'wedding-party',
				description: 'Bridal prep, robes, and relaxing with party'
			});
			timelineEvents.push({
				id: 'evt-2',
				minutes: ceremonyMins - travelMins - 75,
				name: 'Photographer Arrives for Getting Ready & Separate Group Photos',
				role: 'photo',
				description: 'Separate bride/bridesmaids & groom/groomsmen portraits'
			});
			if (travelMins > 0) {
				timelineEvents.push({
					id: 'evt-3',
					minutes: ceremonyMins - travelMins - 15,
					name: 'Depart & Travel to Ceremony Venue',
					role: 'wedding-party',
					description: `${travelMins} minute drive with buffer`
				});
			}
			timelineEvents.push({
				id: 'evt-4',
				minutes: ceremonyMins - 20,
				name: 'Tucked Away in Bridal Suite / Guests Arrive',
				role: 'wedding-party',
				description: 'Prelude music starts and ushers seat guests'
			});
		}

		// Ceremony
		timelineEvents.push({
			id: 'evt-ceremony',
			minutes: ceremonyMins,
			name: 'Wedding Ceremony Processional & Vows',
			role: 'ceremony',
			description: 'Processional, vows exchange, ring ceremony & first kiss'
		});

		// Cocktail Hour
		const cocktailMins = ceremonyMins + 30;
		timelineEvents.push({
			id: 'evt-cocktail',
			minutes: cocktailMins,
			name: firstLook === 'yes' ? 'Cocktail Hour (Couple Mingles With Guests)' : 'Cocktail Hour & Post-Ceremony Family Portraits',
			role: 'reception',
			description: firstLook === 'yes' ? 'Signature drinks & appetizers with guests' : 'Formal family photo list and newlywed sunset portraits'
		});

		// Grand Entrance & First Dance
		const grandEntranceMins = cocktailMins + 60;
		timelineEvents.push({
			id: 'evt-entrance',
			minutes: grandEntranceMins,
			name: 'Grand Entrance & Newlyweds First Dance',
			role: 'reception',
			description: 'DJ introduces newlyweds, followed immediately by first dance'
		});

		// Welcome Toast & Dinner
		const dinnerMins = grandEntranceMins + 15;
		timelineEvents.push({
			id: 'evt-dinner',
			minutes: dinnerMins,
			name: 'Welcome Blessing & Dinner Service Begins',
			role: 'reception',
			description: 'Plated dinner, buffet, or family-style dinner service'
		});

		// Toasts & Speeches
		const toastsMins = dinnerMins + 45;
		timelineEvents.push({
			id: 'evt-toasts',
			minutes: toastsMins,
			name: 'Toasts & Speeches (Best Man, Maid of Honor, Parents)',
			role: 'reception',
			description: 'Champagne poured and celebratory toasts delivered'
		});

		// Parent Dances & Cake Cutting
		const cakeMins = dinnerMins + 75;
		timelineEvents.push({
			id: 'evt-cake',
			minutes: cakeMins,
			name: 'Parent Dances & Cake Cutting Ceremony',
			role: 'reception',
			description: 'Father-daughter / mother-son dances & cake cutting'
		});

		// Dance Floor Open
		const dancingMins = dinnerMins + 90;
		timelineEvents.push({
			id: 'evt-dance',
			minutes: dancingMins,
			name: 'Open Dance Floor Party & Late-Night Snacks',
			role: 'reception',
			description: 'High-energy party music and open bar'
		});

		// Grand Exit
		const exitMins = ceremonyMins + 30 + receptionLengthMins;
		timelineEvents.push({
			id: 'evt-exit',
			minutes: exitMins,
			name: 'Grand Sparkler Send-Off / Newlyweds Exit',
			role: 'reception',
			description: 'Sparkler tunnel, vintage car getaway, or last dance'
		});

		// Sort by minutes
		timelineEvents.sort((a, b) => a.minutes - b.minutes);
		renderTimeline();
	}

	function renderTimeline() {
		timelineStream.innerHTML = '';

		const filtered = timelineEvents.filter(evt => {
			if (activeRoleFilter === 'all') return true;
			if (activeRoleFilter === 'wedding-party') return evt.role === 'wedding-party' || evt.role === 'ceremony';
			if (activeRoleFilter === 'photo') return evt.role === 'photo' || evt.role === 'ceremony';
			if (activeRoleFilter === 'reception') return evt.role === 'reception';
			return true;
		});

		if (filtered.length === 0) {
			timelineStream.innerHTML = '<p style="color: var(--text-secondary); font-style: italic;">No events found for this filter.</p>';
			return;
		}

		filtered.forEach((evt, idx) => {
			const card = document.createElement('div');
			card.className = 'timeline-event-card';

			let tagClass = 'tag-wedding-party';
			let tagLabel = '👰 Wedding Party';
			if (evt.role === 'photo') { tagClass = 'tag-photo'; tagLabel = '📸 Photo & Video'; }
			else if (evt.role === 'reception') { tagClass = 'tag-reception'; tagLabel = '🍽️ Reception'; }
			else if (evt.role === 'ceremony') { tagClass = 'tag-ceremony'; tagLabel = '⛪ Ceremony'; }

			const formattedTime = minutesToFormattedTime(evt.minutes);

			card.innerHTML = `
				<div class="timeline-bullet-dot"></div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.3rem;">
					<strong class="font-heading" style="font-size: 1.3rem; color: var(--accent-blue);">${formattedTime}</strong>
					<span class="event-tag ${tagClass}">${tagLabel}</span>
				</div>
				<h4 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.3rem 0;">
					${evt.name}
				</h4>
				<p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); margin: 0; line-height: 1.4;">
					${evt.description || ''}
				</p>
				<div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.4rem;">
					<button type="button" style="background:none; border:none; color: var(--accent-red); cursor:pointer; font-size: 0.8rem; font-weight:bold;" onclick="removeTimelineEvent('${evt.id}')">Remove</button>
				</div>
			`;

			timelineStream.appendChild(card);
		});
	}

	window.removeTimelineEvent = function(id) {
		timelineEvents = timelineEvents.filter(e => e.id !== id);
		renderTimeline();
	};

	// Form change listeners
	ceremonyInput.addEventListener('change', calculateTimeline);
	firstLookInput.addEventListener('change', calculateTimeline);
	travelInput.addEventListener('input', calculateTimeline);
	receptionHoursInput.addEventListener('change', calculateTimeline);

	// Presets
	document.querySelectorAll('.preset-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active-preset'));
			btn.classList.add('active-preset');

			ceremonyInput.value = btn.getAttribute('data-ceremony');
			firstLookInput.value = btn.getAttribute('data-firstlook');
			travelInput.value = btn.getAttribute('data-travel');
			receptionHoursInput.value = btn.getAttribute('data-reception');

			calculateTimeline();
		});
	});

	// Role Filters
	document.querySelectorAll('.role-pill-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.role-pill-btn').forEach(b => b.classList.remove('active-role'));
			btn.classList.add('active-role');
			activeRoleFilter = btn.getAttribute('data-role');
			renderTimeline();
		});
	});

	// Add Custom Milestone Form
	document.getElementById('add-custom-event-form').addEventListener('submit', (e) => {
		e.preventDefault();
		const name = document.getElementById('custom-event-name').value.trim();
		const timeStr = document.getElementById('custom-event-time').value;
		const role = document.getElementById('custom-event-role').value;

		if (!name || !timeStr) return;

		timelineEvents.push({
			id: 'custom-' + Date.now(),
			minutes: parseTimeToMinutes(timeStr),
			name,
			role,
			description: 'Custom added wedding milestone'
		});

		timelineEvents.sort((a, b) => a.minutes - b.minutes);
		renderTimeline();
		document.getElementById('custom-event-name').value = '';
	});

	// 📋 Copy Text Summary
	document.getElementById('btn-copy-summary').addEventListener('click', () => {
		if (timelineEvents.length === 0) return;
		let text = `💍 WEDDING DAY TIMELINE (${minutesToFormattedTime(parseTimeToMinutes(ceremonyInput.value))} Ceremony)\n\n`;
		timelineEvents.forEach(evt => {
			text += `• ${minutesToFormattedTime(evt.minutes)} — ${evt.name}\n`;
		});

		navigator.clipboard.writeText(text).then(() => {
			const btn = document.getElementById('btn-copy-summary');
			btn.textContent = '✅ Copied to Clipboard!';
			setTimeout(() => { btn.textContent = '📋 Copy Text Summary'; }, 2000);
		});
	});

	// 📝 Export to Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		if (timelineEvents.length === 0) return;

		let rows = '';
		timelineEvents.forEach((evt, idx) => {
			rows += `
				<tr>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold; width:100px;">${minutesToFormattedTime(evt.minutes)}</td>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold;">${evt.name}</td>
					<td style="border:1px solid #ccc; padding:8px; width:130px;">${evt.role.replace('-', ' ').toUpperCase()}</td>
					<td style="border:1px solid #ccc; padding:8px; color:#555;">${evt.description || '-'}</td>
				</tr>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Wedding Day Itinerary</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Official Wedding Day-Of Itinerary</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Ceremony Start: ${minutesToFormattedTime(parseTimeToMinutes(ceremonyInput.value))}</p>
				<table>
					<thead>
						<tr>
							<th>Time</th>
							<th>Event / Milestone</th>
							<th>Category</th>
							<th>Logistical Notes</th>
						</tr>
					</thead>
					<tbody>
						${rows}
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Day_Timeline_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const printDate = document.getElementById('print-date');
		const printCeremony = document.getElementById('print-ceremony-time');
		const printTbody = document.getElementById('print-timeline-body');

		printDate.textContent = new Date().toLocaleDateString();
		printCeremony.textContent = minutesToFormattedTime(parseTimeToMinutes(ceremonyInput.value));

		printTbody.innerHTML = '';
		timelineEvents.forEach(evt => {
			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">${minutesToFormattedTime(evt.minutes)}</td>
				<td style="border: 1px solid #ccc; padding: 6px;">
					<strong>${evt.name}</strong>
					<div style="font-size: 11px; color: #555;">${evt.description || ''}</div>
				</td>
				<td style="border: 1px solid #ccc; padding: 6px;">${evt.role.replace('-', ' ').toUpperCase()}</td>
			`;
			printTbody.appendChild(tr);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Time,Event Milestone,Category,Notes\n";
		timelineEvents.forEach(evt => {
			csv += `"${minutesToFormattedTime(evt.minutes)}","${(evt.name||'').replace(/"/g, '""')}","${evt.role}","${(evt.description||'').replace(/"/g, '""')}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Day_Timeline_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateTimeline();
</script>
