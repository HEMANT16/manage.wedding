---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Cash Gift Calculator & Registry Cash Forecaster",
      "url": "https://manage.wedding/gift-cash-calculator",
      "description": "Free wedding cash gift calculator. Calculate exact cash gift envelope amounts for guests, or forecast total registry cash gifts for couples. Export to Word, PDF, or Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much cash should you give as a wedding gift in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a coworker or acquaintance: $75 to $100. For a close friend or cousin: $125 to $200. For immediate family (siblings, parents, godparents) or wedding party: $200 to $400+. If bringing a plus-one, add 50% to 80% to your total gift."
          }
        },
        {
          "@type": "Question",
          "name": "Is the 'cover your plate' wedding gift rule still valid?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No! Modern etiquette experts agree the 'cover your plate' rule is an outdated myth. You are an invited guest, not a restaurant customer paying for dinner. Your gift should be based on your closeness to the couple and what you can comfortably afford."
          }
        },
        {
          "@type": "Question",
          "name": "Should you give less cash if you travel for a destination wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. If you are spending $500 to $2,000 on flights and hotel accommodations to attend a destination wedding, modern etiquette considers your physical presence a major part of the gift. A smaller token gift of $50 to $100 or a thoughtful handwritten card is completely appropriate."
          }
        },
        {
          "@type": "Question",
          "name": "How much total cash do couples typically receive in wedding gifts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An average wedding with 120 guests receives between $12,000 and $18,000 in total cash, check, and digital honeymoon fund gifts, averaging $110 to $150 per attending guest."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Cash Gift Calculator (Free Giving Cheat Sheet & Word Export) | Manage.Wedding"
	description="Calculate exactly how much cash to give at a wedding or forecast total registry cash gifts for couples. Free 2026 etiquette guide with instant Word and PDF exports."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Wedding Cash Gift Calculator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Determine the exact cash envelope amount based on modern etiquette, closeness, plus-ones, and travel costs—or <strong>forecast total cash gifts</strong> for your wedding!
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> How to Use This Gift Calculator in 3 Easy Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Select Calculator Mode
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Choose <strong>"Guest Mode"</strong> (calculate your envelope gift) or <strong>"Couple Mode"</strong> (forecast total cash gifts from all guests).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Adjust Closeness & Travel Costs
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Account for plus-ones, destination flights/hotel expenses, bridal party duties, and venue formality levels.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Export Card Wishes & Breakdown
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Click <strong>"📝 Export Word (.doc)"</strong> or <strong>"🖨️ Export PDF"</strong> to save a complete cash gift breakdown and pre-written wedding card wishes!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Config Form + Live Results & Breakdown -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="gift-calc-grid">
			
			<!-- Left Column: Input Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Mode Switcher Tabs -->
				<div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<button type="button" id="tab-guest-mode" class="mode-tab-btn active-tab" style="flex: 1; padding: 0.55rem; font-family: var(--font-heading); font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer;">
						🎁 I am a Guest (My Gift)
					</button>
					<button type="button" id="tab-couple-mode" class="mode-tab-btn" style="flex: 1; padding: 0.55rem; font-family: var(--font-heading); font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; background: var(--bg-paper);">
						💒 We are the Couple (Total Forecast)
					</button>
				</div>

				<!-- GUEST MODE FORM -->
				<div id="section-guest-mode">
					<form id="guest-gift-form" style="display: flex; flex-direction: column; gap: 1rem;">
						
						<!-- Closeness to Couple -->
						<div>
							<label for="select-relationship" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								1. Relationship to the Couple *
							</label>
							<select id="select-relationship" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
								<option value="175">👑 Immediate Family / Sibling / Best Friend ($150 - $250+)</option>
								<option value="125" selected>🌸 Close Friend / Aunt, Uncle, Cousin ($100 - $175)</option>
								<option value="90">🤝 Casual Friend / Extended Family / Neighbor ($75 - $125)</option>
								<option value="65">💼 Coworker / Acquaintance ($50 - $90)</option>
							</select>
						</div>

						<!-- Attendance & Plus-One -->
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<label for="select-attendance" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Who is Attending?
								</label>
								<select id="select-attendance" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
									<option value="1.0">Solo (Just Me)</option>
									<option value="1.8" selected>Couple (Me + Date / Partner)</option>
									<option value="2.3">Family (Couple + Kids)</option>
								</select>
							</div>

							<div>
								<label for="select-venue-tier" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Wedding Formality
								</label>
								<select id="select-venue-tier" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
									<option value="1.0">Standard / Banquet Hall / Garden</option>
									<option value="1.25">Black-Tie Luxury / Historic Estate (+25%)</option>
									<option value="0.85">Casual Backyard / DIY / Brunch (-15%)</option>
								</select>
							</div>
						</div>

						<!-- Offsets: Travel & Wedding Party -->
						<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
							<span class="font-heading" style="font-size: 0.88rem; color: var(--fg-pencil); display: block;">
								✈️ Travel & Wedding Party Etiquette Offsets:
							</span>
							
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-destination-travel" style="accent-color: var(--fg-pencil);">
								<span>I paid for flights/hotel for a destination wedding (Etiquette discount: -25%)</span>
							</label>

							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-bridal-party-role" style="accent-color: var(--fg-pencil);">
								<span>I am a Bridesmaid / Groomsman (Already spent $600+ on attire/trips: -20%)</span>
							</label>
						</div>

					</form>
				</div>

				<!-- COUPLE MODE FORM (HIDDEN INITIALLY) -->
				<div id="section-couple-mode" style="display: none;">
					<form id="couple-gift-form" style="display: flex; flex-direction: column; gap: 1rem;">
						
						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-guest-count" class="font-heading" style="font-size: 0.95rem; color: var(--accent-red);">
									Total Attending Guests
								</label>
								<span id="display-guest-count" style="font-size: 1.1rem; font-weight: bold; color: var(--accent-red);">120 Guests</span>
							</div>
							<input type="range" id="input-guest-count" min="20" max="350" value="120" step="5" style="width: 100%; accent-color: var(--accent-red);">
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<label for="select-couple-venue-tier" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Reception Formality
								</label>
								<select id="select-couple-venue-tier" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="1.0" selected>Standard Banquet ($110/guest)</option>
									<option value="1.3">Black-Tie Luxury ($145/guest)</option>
									<option value="0.85">Casual / Intimate ($90/guest)</option>
								</select>
							</div>

							<div>
								<label for="select-destination-mode" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Wedding Location
								</label>
								<select id="select-destination-mode" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="1.0" selected>Local Hometown Wedding</option>
									<option value="0.75">Destination Wedding (Guests Traveled)</option>
								</select>
							</div>
						</div>

						<p class="font-body" style="font-size: 0.82rem; color: var(--text-secondary); line-height: 1.4; margin: 0; background: var(--bg-paper); padding: 0.6rem; border-radius: 4px;">
							*Assumes average giving distributions across family (30%), close friends (40%), coworkers (20%), and wedding party (10%).
						</p>

					</form>
				</div>

				<!-- Currency Selector -->
				<div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.3rem; margin-top: 1rem; border-top: 1px dashed #ccc; padding-top: 0.75rem;">
					<span style="font-size: 0.85rem; font-weight: bold;">Currency:</span>
					<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
						<option value="$" selected>$ (USD/CAD/AUD)</option>
						<option value="£">£ (GBP)</option>
						<option value="€">€ (EUR)</option>
						<option value="₹">₹ (INR)</option>
					</select>
				</div>

			</div>

			<!-- Right Column: Live Results & Card Message Recommendations -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Gift Result Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 id="res-card-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								✉️ Recommended Cash Gift
							</h3>
							<span id="res-card-subtitle" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Modern 2026 wedding envelope etiquette
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word Wishes (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Gift Range Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span id="res-range-label" class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Suggested Envelope Amount</span>
						<strong id="res-primary-amount" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">$225</strong>
						<span id="res-range-subtext" style="font-size: 0.85rem; color: var(--accent-red);">Comfortable Range: $200 - $250</span>
					</div>

					<!-- Detailed Math Breakdown List -->
					<div style="margin-bottom: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil); margin-bottom: 0.4rem; text-align: center;">
							🧾 Calculation Factors
						</h4>
						<ul id="res-factors-list" class="font-body" style="list-style: none; padding: 0; margin: 0; font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.35rem; color: var(--fg-pencil);">
							<li style="display:flex; justify-content:space-between; border-bottom:1px solid #eee; padding-bottom:0.2rem;">
								<span>Closeness Baseline:</span> <strong id="fact-base">$125</strong>
							</li>
							<li style="display:flex; justify-content:space-between; border-bottom:1px solid #eee; padding-bottom:0.2rem;">
								<span>Attendance (Couple):</span> <strong id="fact-attendance">x 1.8</strong>
							</li>
							<li style="display:flex; justify-content:space-between; border-bottom:1px solid #eee; padding-bottom:0.2rem;">
								<span>Venue & Travel Adjustments:</span> <strong id="fact-adjustments">1.0x (Standard)</strong>
							</li>
						</ul>
					</div>

					<!-- Visual Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Modest ($50)</span>
							<span>Average ($150)</span>
							<span style="color: var(--accent-red);">Generous ($300+)</span>
						</div>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="gift-gauge-bar" style="width: 55%; height: 100%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Ready-to-Write Card Wishes Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem; text-align: center;">
						💌 Wedding Card Message Idea:
					</strong>
					<p id="card-wish-text" class="font-body" style="font-size: 0.88rem; line-height: 1.45; margin: 0; color: var(--fg-pencil); font-style: italic; text-align: center;">
						"Wishing you both a lifetime of love, laughter, and incredible adventures! May this gift help you create unforgettable memories on your honeymoon."
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Manage.Wedding — Cash Gift Etiquette & Card Wishes Guide</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exported on: <span id="print-date"></span> | Suggested Gift: <span id="print-amount"></span></p>
			</div>
			<div id="print-content-body"></div>
		</div>

		<!-- SEO Article & Comprehensive Guide (Centered Headings) -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Wedding Gift & Cash Registry Playbook</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					The Complete Wedding Cash Gift Etiquette Guide
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					Why the "cover your plate" rule is obsolete, destination wedding offsets, and ready-to-write card messages.
				</p>
			</div>

			<div style="margin-bottom: 2.5rem; text-align: center;">
				<img 
				src="/images/rsvp_envelopes.webp" 
				alt="Wedding Gift Cash Calculator — Envelope & Registry Forecast" 
				loading="lazy"
				decoding="async"
				style="width: 100%; max-height: 420px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); margin: 0 auto; display: block;"
			/>
				<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin-top: 0.5rem; font-style: italic;">
					Giving cash with a heartfelt handwritten card is the #1 requested gift by 92% of modern couples.
				</p>
			</div>

			<!-- Section 1: Detailed Step-by-Step Guide on How to Use This Tool Flawlessly -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. Step-by-Step Guide: How to Calculate Your Gift Amount
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1.25rem;">
					Finding the exact sweet spot for a wedding gift envelope shouldn't cause financial anxiety. Follow this 4-step logic:
				</p>

				<div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.5rem;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-red); margin-bottom: 0.4rem;">
							Step 1: Start with Closeness (Not Catering Costs)
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Your baseline should always reflect how close you are to the bride or groom. Siblings and best friends average $150 to $250+ per person, close friends and cousins average $100 to $175, while coworkers and distant family average $75 to $100.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-blue); margin-bottom: 0.4rem;">
							Step 2: Scale for Plus-Ones and Dates
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							If you are attending with a romantic partner or date, etiquette dictates increasing your gift by <strong>1.8x (not necessarily 2.0x)</strong> to account for two guests enjoying dinner, drinks, and entertainment.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: #16a34a; margin-bottom: 0.4rem;">
							Step 3: Apply the Destination & Bridal Party Offsets
						</h4>
