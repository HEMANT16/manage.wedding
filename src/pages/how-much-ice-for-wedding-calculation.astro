---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "How Much Ice for Wedding: Calculation Per Guest (Cocktail Ice & Trough Cooling Guide)",
      "description": "Calculate exact pounds of ice needed for a wedding bar: cocktail serving ice vs bottle chilling trough ice, summer heat loss rates, and bulk buying tips.",
      "datePublished": "2026-08-18T00:00:00+00:00",
      "dateModified": "2026-08-18T00:00:00+00:00",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding",
        "logo": {
          "@type": "ImageObject",
          "url": "https://manage.wedding/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://manage.wedding/how-much-ice-for-wedding-calculation"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many pounds of ice do you need for 100 wedding guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For 100 guests at an indoor or mild-weather wedding (5 hours), buy 150 lbs of ice (fifteen 10-lb bags). For a warm summer or outdoor wedding above 80°F, increase to 2.5 lbs per person (250 lbs total) to account for faster melting in chilling troughs."
          }
        },
        {
          "@type": "Question",
          "name": "How should ice be divided between cocktail glasses and bottle cooling tubs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use the 50/50 rule: allocate 50% of your ice exclusively for clean cocktail glasses and shaker dilution, and 50% for galvanized steel tubs and coolers chilling beer kegs, white wine, champagne, and soda cans."
          }
        },
        {
          "@type": "Question",
          "name": "Can you use dry ice in drink chilling tubs at a wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never place dry ice in direct contact with beer cans or wine bottles without thick cardboard barriers, as it will freeze liquids solid, shattering glass wine bottles and bursting aluminum beer cans."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="How Much Ice for Wedding: Calculation Per Guest (Cocktail Ice & Trough Cooling Guide)"
  description="Calculate exact pounds of ice needed for a wedding bar: cocktail serving ice vs bottle chilling trough ice, summer heat loss rates, and bulk buying tips."
  schema={schema}
>
  <main class="container" style="padding-top: 2rem; padding-bottom: 4rem; max-width: 900px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
        { name: "Wedding Ice Calculation Guide" }
      ]}
    />

    <!-- Header Section -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #fef3c7; color: #92400e; padding: 4px 12px; border-radius: 20px; border: 1.5px solid #d97706; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <span>🧊</span>
        <span>Bar Logistics & Thermal Sizing</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
        How Much Ice for Wedding: Calculation Per Guest <span style="color: #b45309; font-style: italic;">(Cocktail Ice & Trough Cooling Guide)</span>
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;">
        <span>Published: August 2026</span>
        <span>•</span>
        <span>7 min read</span>
        <span>•</span>
        <span>By Manage.Wedding Editorial Team</span>
      </div>
    </header>

    <!-- AI Direct Citation Callout (BLUF) -->
    <div style="background: #f0fdf4; border: 2px solid #16a34a; border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: 3px 3px 0px #16a34a;">
      <div style="font-size: 0.82rem; font-weight: 800; color: #15803d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem;">
        🎯 The 1.5 to 2.5 lb Ice Rule
      </div>
      <p class="font-body" style="font-size: 1.15rem; color: #14532d; font-weight: 600; line-height: 1.5; margin: 0;">
        Plan <strong>1.5 lbs of ice per guest for cool or indoor weddings</strong> (150 lbs for 100 guests) and <strong>2.5 lbs per guest for summer or outdoor weddings</strong> (250 lbs for 100 guests) to cover glass cocktail ice and drink chilling tubs.
      </p>
    </div>

    <!-- Interactive Tool Callout Hero -->
    <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
          Calculate Ice Pounds & Bar Shopping Lists
        </h3>
        <p class="font-body" style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
          Customize guest count, bar hours, weather heat multipliers, and bag conversions.
        </p>
      </div>
      <a href="/liquor-wedding-calculator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 10px 22px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.5rem;">
        <span>Open Bar & Ice Sizer</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Main Content Body -->
    <article class="font-body" style="font-size: 1.1rem; line-height: 1.7; color: var(--fg-pencil);">
      
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2rem 0 1rem;">
        The 2 Different Types of Wedding Ice
      </h2>
      <p>
        Running out of ice is a bartender's worst nightmare. Lukewarm cocktails and warm beer ruin the guest experience faster than almost anything else. To calculate ice accurately, you must split your purchase into two completely separate functional categories:
      </p>
      <ul style="padding-left: 1.5rem; margin-bottom: 1.5rem;">
        <li style="margin-bottom: 0.5rem;"><strong>1. Clean Glass Serving Ice (50% of total ice):</strong> Clean, food-safe bagged ice stored in sanitized insulated ice wells behind the bar. This ice goes directly into cocktail glasses, rocks glasses, and highball cups.</li>
        <li style="margin-bottom: 0.5rem;"><strong>2. Chilling Trough / Cooler Ice (50% of total ice):</strong> Ice placed into galvanized metal troughs, wine tubs, and coolers to submerge and chill white wine bottles, Prosecco, champagne, beer cans, and soda liters.</li>
      </ul>

      <!-- Ice Sizing Table -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Ice Calculation Matrix by Headcount & Season
      </h2>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Guests</th>
              <th style="padding: 12px 14px; font-weight: 800;">Indoor / Fall / Winter (1.5 lb/guest)</th>
              <th style="padding: 12px 14px; font-weight: 800;">Summer / Outdoor (>80°F, 2.5 lb/guest)</th>
              <th style="padding: 12px 14px; font-weight: 800;">Standard 10-lb Bags</th>
              <th style="padding: 12px 14px; font-weight: 800;">Large 20-lb Bags</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">50 Guests</td>
              <td style="padding: 12px 14px;">75 lbs</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #d97706;">125 lbs</td>
              <td style="padding: 12px 14px;">8–13 bags</td>
              <td style="padding: 12px 14px;">4–7 bags</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700; color: #0284c7;">100 Guests</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">150 lbs</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #d97706;">250 lbs</td>
              <td style="padding: 12px 14px;">15–25 bags</td>
              <td style="padding: 12px 14px;">8–13 bags</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700; color: #d97706;">150 Guests</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">225 lbs</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #d97706;">375 lbs</td>
              <td style="padding: 12px 14px;">23–38 bags</td>
              <td style="padding: 12px 14px;">12–19 bags</td>
            </tr>
            <tr style="background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700; color: #7c3aed;">200 Guests</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">300 lbs</td>
              <td style="padding: 12px 14px; font-weight: 800; color: var(--accent-red);">500 lbs</td>
              <td style="padding: 12px 14px;">30–50 bags</td>
              <td style="padding: 12px 14px;">15–25 bags</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Cooler Capacity & Trough Volume Math
      </h2>
      <p>
        How many coolers do you actually need to transport and store 250+ lbs of ice?
      </p>
      <ul style="padding-left: 1.5rem; margin-bottom: 1.5rem;">
        <li style="margin-bottom: 0.5rem;"><strong>100-Quart Marine Cooler:</strong> Holds roughly <strong>60 to 75 lbs of bagged ice</strong> (or 4 cases of beer plus 30 lbs of ice). You will need 3 to 4 large marine coolers for a 100-guest wedding.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Galvanized Steel Beverage Trough (30 Gallons):</strong> Holds approximately <strong>40 lbs of ice</strong> plus 50 bottles of wine and beer.</li>
        <li style="margin-bottom: 0.5rem;"><strong>The Salt Water Slurry Secret:</strong> To chill warm white wine and champagne bottles in under 15 minutes, add 2 cups of kosher salt and 2 gallons of cold water to your ice trough. Saltwater drops the freezing point, accelerating heat transfer.</li>
      </ul>

      <!-- Bottom Interactive CTA Section -->
      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 2rem; box-shadow: 4px 4px 0px var(--fg-pencil); text-align: center; margin: 3rem 0;">
        <h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
          Calculate Your Total Bar Bottles, Mixers & Ice
        </h3>
        <p class="font-body" style="font-size: 1.05rem; max-width: 600px; margin: 0 auto 1.5rem; color: var(--text-secondary);">
          Model entire open bar packages, handles vs fifths, ice bags, and retail budget estimates.
        </p>
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="/liquor-wedding-calculator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 12px 24px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Open Liquor & Ice Sizer &rarr;
          </a>
          <a href="/wedding-drink-calculator" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 12px 20px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Beer & Wine Sizer &rarr;
          </a>
        </div>
      </div>

    </article>

    <RelatedTools currentPath="/how-much-ice-for-wedding-calculation" category="food-beverage" />
  </main>
</Layout>
