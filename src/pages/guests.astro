---
import Layout from '../layouts/Layout.astro';

const title = "Wedding Guests, Seating & Logistics Calculators (Free Tools)";
const description = "Free wedding guest calculators, visual seating chart makers, dance floor clearance sizers, processional ceremony builders, and day-of timelines.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/guests/#collection",
      "name": "Wedding Guests, Seating & Logistics Calculators",
      "url": "https://manage.wedding/guests",
      "description": "Comprehensive suite of drag-and-drop seating chart tools, floor plan and dance floor clearance estimators, ceremony processional planners, and timeline generators.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Seating Chart Maker", "url": "https://manage.wedding/seating-chart-maker" },
        { "@type": "WebApplication", "name": "Floor Plan & Dance Floor Sizer", "url": "https://manage.wedding/seating-clearance-calculator" },
        { "@type": "WebApplication", "name": "Processional Order Builder", "url": "https://manage.wedding/wedding-processional-order" },
        { "@type": "WebApplication", "name": "Day-Of Timeline Generator", "url": "https://manage.wedding/day-of-timeline-generator" },
        { "@type": "WebApplication", "name": "Rehearsal Dinner Planner", "url": "https://manage.wedding/rehearsal-dinner-planner" },
        { "@type": "WebApplication", "name": "Guest List Manager", "url": "https://manage.wedding/guest-list-manager" },
        { "@type": "WebApplication", "name": "RSVP Tracker", "url": "https://manage.wedding/rsvp-tracker" },
        { "@type": "WebApplication", "name": "Guest Count Estimator", "url": "https://manage.wedding/guest-count-estimator" },
        { "@type": "WebApplication", "name": "RSVP Date Calculator", "url": "https://manage.wedding/rsvp-date-calculator" },
        { "@type": "WebApplication", "name": "Wedding Officiant Script & Ceremony Timer", "url": "https://manage.wedding/wedding-officiant-script-timer" },
        { "@type": "WebApplication", "name": "12-Month Wedding Checklist", "url": "https://manage.wedding/wedding-checklist" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What percentage of wedding guests typically decline an RSVP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For local hometown weddings, 10-15% of invited guests decline. For destination weddings or celebrations requiring flights/hotels, 20-30% of invited guests typically decline."
          }
        },
        {
          "@type": "Question",
          "name": "How big of a dance floor do you need for 150 guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan for 33% to 50% of your total guest headcount on the dance floor simultaneously. For 150 guests, approximately 50-75 people will dance at once. At 4.5 sq ft per dancer, plan for a 15' × 15' (225 sq ft) or 16' × 16' (256 sq ft) dance floor."
          }
        },
        {
          "@type": "Question",
          "name": "How much clearance space should you leave between round wedding tables?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Maintain a minimum of 60 inches (5 feet) from table rim to table rim. This allows 18 inches for chair pull-out on each side plus a 24-inch central service aisle for banquet waitstaff and mobility devices."
          }
        }
      ]
    }
  ]
};

const guestTools = [
  {
    title: "Seating Chart Maker",
    url: "/seating-chart-maker",
    icon: "🪑",
    badge: "Drag & Drop",
    desc: "Interactive visual table arrangement tool. Assign seats, balance tables, and export printable charts.",
    tags: ["Visual Planner", "PDF Export", "Table Balancing"]
  },
  {
    title: "Floor Plan & Dance Floor Sizer",
    url: "/seating-clearance-calculator",
    icon: "📐",
    badge: "Floor Plan Math",
    desc: "Calculate dance floor square footage, 60\" vs 72\" round table counts, and 60-inch server aisle clearances.",
    tags: ["Dance Floor Sizes", "60\" Round Tables", "Venue Sq Ft"]
  },
  {
    title: "Processional Order Builder",
    url: "/wedding-processional-order",
    icon: "⛪",
    badge: "Ceremony Lineup",
    desc: "Build customized ceremony processional walking lineups and recessional exits for Christian, Jewish, Catholic, and LGBTQ+ ceremonies.",
    tags: ["Aisle Walk Order", "Rehearsal Guide", "Printable Cards"]
  },
  {
    title: "Wedding Officiant Script & Ceremony Timer",
    url: "/wedding-officiant-script-timer",
    icon: "📜",
    badge: "Pacing & Binder Cue Cards",
    desc: "Build and time complete ceremony scripts from welcome to first kiss. Converts word counts to spoken minutes (115 WPM) with printable binder cards.",
    tags: ["Ceremony Script Builder", "WPM Pacing Timer", "Printable Binder Cards"]
  },
  {
    title: "Wedding Sparkler Send-Off & Exit Sizer",
    url: "/wedding-sparkler-calculator",
    icon: "✨",
    badge: "Burn Time & Safety",
    desc: "Calculate 20\" vs 36\" sparkler burn times, late-night guest attrition counts, windproof torches, and sand buckets with printable 8x10 bar signs.",
    tags: ["Sparkler Burn Time", "Exit Safety Cues", "8x10 Bar Signs"]
  },
  {
    title: "Day-Of Timeline Generator",
    url: "/day-of-timeline-generator",
    icon: "⏰",
    badge: "Top Rated",
    desc: "Input your ceremony time to auto-generate a comprehensive schedule for hair, photos, dinner, and exits.",
    tags: ["Custom Itinerary", "Vendor Share", "Minute-by-Minute"]
  },
  {
    title: "Rehearsal Dinner Planner",
    url: "/rehearsal-dinner-planner",
    icon: "🍷",
    badge: "Dinner Itinerary",
    desc: "Calculate tiered guest list headcounts (bridal party vs out-of-towners), estimate catering costs, and generate rehearsal night timelines.",
    tags: ["Guest Tiers", "Rehearsal Timeline", "Dinner Budget"]
  },
  {
    title: "Guest List Manager",
    url: "/guest-list-manager",
    icon: "📋",
    badge: "Local-First",
    desc: "Track guest names, plus-ones, addresses, meal choices, and dietary notes with zero cloud tracking.",
    tags: ["Plus-Ones", "CSV Export", "Dietary Notes"]
  },
  {
    title: "RSVP Tracker",
    url: "/rsvp-tracker",
    icon: "✉️",
    badge: "Live Tally",
    desc: "Tally accepted vs declined RSVPs, meal counts, and missing responses with instant progress bars.",
    tags: ["Attendance Tally", "Dietary Counts", "Headcount Lock"]
  },
  {
    title: "Guest Count Estimator",
    url: "/guest-count-estimator",
    icon: "👥",
    badge: "Probability Math",
    desc: "Calculate attendance likelihood curves based on local vs out-of-town guest ratios and venue limits.",
    tags: ["Acceptance Curve", "Venue Cap", "Regret Rates"]
  },
  {
    title: "RSVP Date Calculator",
    url: "/rsvp-date-calculator",
    icon: "📬",
    badge: "Mailing Schedule",
    desc: "Input your wedding date to calculate exact mailing deadlines for Save-the-Dates, Invites, and Caterer locks.",
    tags: ["Mailing Dates", "Caterer Deadlines", "RSVP Due Date"]
  },
  {
    title: "12-Month Wedding Checklist",
    url: "/wedding-checklist",
    icon: "✅",
    badge: "Interactive",
    desc: "A month-by-month interactive task checklist with custom additions so nothing falls through the cracks.",
    tags: ["12-Month Plan", "Progress Tracker", "Task Manager"]
  },
  {
    title: "Dress Alterations Estimator",
    url: "/dress-alterations-estimator",
    icon: "🪡",
    badge: "Tailoring Rates",
    desc: "Estimate bridal gown tailoring costs based on fabric delicacy, layers, hemming, and bustle styles.",
    tags: ["Tailoring Rates", "Bustle Styles", "Fitting Dates"]
  },
  {
    title: "Bridal Dress Size Converter",
    url: "/dress-size-converter",
    icon: "👗",
    badge: "Size Charts",
    desc: "Convert bust, waist, and hip measurements into true US, UK, EU, and Italian bridal dress sizes.",
    tags: ["US UK EU Charts", "Measurement Guide", "Bridal Sizing"]
  },
  {
    title: "Ring Size Converter",
    url: "/ring-size-converter",
    icon: "💍",
    badge: "International",
    desc: "Convert millimeter circumferences into US, UK, and European ring sizes with printable finger sizer.",
    tags: ["Finger Sizer", "International Chart", "Circumference Math"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Logistics & Day-Of Hub</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Wedding <span class="accent-italic">Guests, Seating & Logistics</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Build ceremony walking orders, calculate dance floor dimensions, generate minute-by-minute day-of timelines, and arrange visual seating charts.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Explore Categories:</span>
      <a href="/budget" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Budget</a>
      <a href="/dining" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Dining & Bar</a>
      <a href="/guests" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">👥 Guests (Active)</a>
      <a href="/stationery" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💌 Stationery & Creative</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {guestTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
            Launch Tool →
          </a>
        </div>
      ))}
    </div>

    <!-- In-Depth Logistics Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Event Engineering</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          How to Engineer Smooth Wedding Day-Of Logistics
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          From ceremony lineups to ballroom floor clearance, here are the architectural standards coordinators swear by.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. Dance Floor Sizing Benchmarks
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          A dance floor that is too small creates overcrowding, while a floor that is too large looks empty. Calculate using the <strong>33% Peak Rule (4.5 sq ft per active dancer)</strong>:
        </p>
        
        <div style="overflow-x: auto; margin-top: 1rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Total Guest Count</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Dancers at Once</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--accent-blue);">Recommended Dance Floor Size</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">100 Guests</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">35 – 45 dancers</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">12' × 16' (192 sq ft)</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">150 Guests</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">50 – 70 dancers</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">15' × 15' or 16' × 16' (256 sq ft)</td>
              </tr>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">200 Guests</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">70 – 90 dancers</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">18' × 18' (324 sq ft)</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">250+ Guests</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">90 – 120 dancers</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">20' × 20' (400 sq ft)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Frequently Asked Questions
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              What percentage of wedding guests typically decline an RSVP?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              For local hometown weddings, 10-15% of invited guests decline. For destination weddings or celebrations requiring flights/hotels, 20-30% of invited guests typically decline.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              How big of a dance floor do you need for 150 guests?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Plan for 33% to 50% of your total guest headcount on the dance floor simultaneously. For 150 guests, approximately 50-75 people will dance at once. At 4.5 sq ft per dancer, plan for a 15' × 15' (225 sq ft) or 16' × 16' (256 sq ft) dance floor.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              How much clearance space should you leave between round wedding tables?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Maintain a minimum of 60 inches (5 feet) from table rim to table rim. This allows 18 inches for chair pull-out on each side plus a 24-inch central service aisle for banquet waitstaff and mobility devices.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
