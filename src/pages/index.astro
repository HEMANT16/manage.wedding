---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://manage.wedding/#website",
      "name": "Manage.Wedding — Free Wedding Planning Calculators & Tools",
      "url": "https://manage.wedding/",
      "description": "A collection of 37+ free, private, local-first wedding planning calculators, seating charts, open bar estimators, and printable day-of stationery.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://manage.wedding/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are all calculators on Manage.Wedding completely free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, 100% free with no sign-up, no credit card, and no paywalls. All calculations and printable PDF/Word downloads run entirely client-side on your device."
          }
        },
        {
          "@type": "Question",
          "name": "Does Manage.Wedding track or sell my guest list and budget data?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Manage.Wedding uses a strict Local-First privacy architecture. Your guest list, RSVP tallies, and private budget numbers are stored exclusively in your browser's local memory and are never uploaded to any remote server or sold to third-party vendor directories."
          }
        },
        {
          "@type": "Question",
          "name": "What are the 4 main phases of wedding planning math?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. Budget & Finance (Allocating percentages and auditing venue plus-plus fees), 2. Food, Bar & Catering (Open bar bottle counts and cake sizing), 3. Guests & Logistics (Seating charts, dance floor clearance, and day-of timelines), and 4. Stationery & Creative (A7 envelope addressing, USPS postage, and speech timing)."
          }
        }
      ]
    }
  ]
};

const searchIndex = [
  // Budget
  { title: "Master Budget Allocator", url: "/master-budget-calculator", category: "Budget", desc: "Allocate total spend across industry percentages." },
  { title: "Venue Hidden Fee & True Cost (++)", url: "/wedding-venue-cost-calculator", category: "Budget", desc: "Audit F&B minimums, 22% service fees, and taxes." },
  { title: "Who Pays for What? Splitter", url: "/who-pays-for-what-wedding", category: "Budget", desc: "Compare 1950s traditional protocol vs modern 3-way splits." },
  { title: "Bachelorette Budget Splitter", url: "/bachelorette-budget-calculator", category: "Budget", desc: "Split Airbnb & dining while covering the bride." },
  { title: "Vendor Tipping Calculator", url: "/vendor-tipping-calculator", category: "Budget", desc: "Gratuity norms and cash envelope breakdowns." },
  { title: "Honeymoon Budget Estimator", url: "/honeymoon-budget-estimator", category: "Budget", desc: "Flight, resort, excursion, and dining budgets." },
  { title: "Wedding Loan Calculator", url: "/wedding-loan-calculator", category: "Budget", desc: "APR, monthly payments, and total interest charges." },
  { title: "Wedding Gift Cash Calculator", url: "/gift-cash-calculator", category: "Budget", desc: "How much cash or registry gift to give as a guest." },

  // Dining
  { title: "Open Bar Drink Calculator", url: "/wedding-drink-calculator", category: "Dining", desc: "Wine, beer, champagne, and spirit bottle totals." },
  { title: "Wedding Liquor & Spirits Sizer", url: "/liquor-wedding-calculator", category: "Dining", desc: "750ml vs 1.75L handle bottle optimizer." },
  { title: "Wedding Cake Pricing Sizer", url: "/cake-pricing-calculator", category: "Dining", desc: "Price per slice, labor hours, and client quotes." },
  { title: "Cake Tier Serving Sizer", url: "/cake-serving-calculator", category: "Dining", desc: "Tier dimensions and portion cuts for 50-300+ guests." },
  { title: "Reception Menu Maker", url: "/reception-menu-maker", category: "Dining", desc: "Printable 4x9 DL and 5x7 menus with luxury fonts." },
  { title: "Catering Cost Estimator", url: "/catering-cost-estimator", category: "Dining", desc: "Compare plated dinner vs buffet per-head costs." },
  { title: "Alcohol Dilution Calculator", url: "/alcohol-dilution-calculator", category: "Dining", desc: "ABV proofing and batch cocktail dilution math." },
  { title: "Floral Cost Estimator", url: "/floral-cost-estimator", category: "Dining", desc: "Bouquets, boutonnieres, centerpieces, and arches." },

  // Guests
  { title: "Seating Chart Maker", url: "/seating-chart-maker", category: "Guests", desc: "Interactive drag-and-drop table planner." },
  { title: "Floor Plan & Dance Floor Sizer", url: "/seating-clearance-calculator", category: "Guests", desc: "Dance floor sq ft and 60-inch server clearances." },
  { title: "Processional Order Builder", url: "/wedding-processional-order", category: "Guests", desc: "Ceremony walking lineups and recessional exits." },
  { title: "Day-Of Timeline Generator", url: "/day-of-timeline-generator", category: "Guests", desc: "Minute-by-minute vendor schedule from hair to exit." },
  { title: "Rehearsal Dinner Planner", url: "/rehearsal-dinner-planner", category: "Guests", desc: "Rehearsal guest tiers, budget, and night-before schedule." },
  { title: "Guest List Manager", url: "/guest-list-manager", category: "Guests", desc: "Zero-tracking guest names, plus-ones, and meals." },
  { title: "RSVP Tracker", url: "/rsvp-tracker", category: "Guests", desc: "Live accepted vs declined tally and dietary counts." },
  { title: "Guest Count Estimator", url: "/guest-count-estimator", category: "Guests", desc: "Attendance probability curves and regret rates." },
  { title: "RSVP Date Calculator", url: "/rsvp-date-calculator", category: "Guests", desc: "Mailing deadlines for Save-the-Dates and caterer locks." },
  { title: "12-Month Wedding Checklist", url: "/wedding-checklist", category: "Guests", desc: "Month-by-month interactive task checklist." },
  { title: "Dress Alterations Estimator", url: "/dress-alterations-estimator", category: "Guests", desc: "Gown tailoring costs, hemming, and bustle styles." },
  { title: "Bridal Dress Size Converter", url: "/dress-size-converter", category: "Guests", desc: "US, UK, EU, and Italian bridal dress size charts." },
  { title: "Ring Size Converter", url: "/ring-size-converter", category: "Guests", desc: "Millimeters to US/UK/EU ring sizes with finger sizer." },

  // Stationery
  { title: "Envelope Address Formatter", url: "/wedding-envelope-addressing", category: "Stationery", desc: "Format A7/A2 envelopes with proper doctor & family titles." },
  { title: "Invitation Suite Sizer", url: "/wedding-invitation-suite-sizer", category: "Stationery", desc: "Layering mat margins and Canva 300 DPI bleed specs." },
  { title: "Invitation Postage Calculator", url: "/wedding-invitation-postage-calculator", category: "Stationery", desc: "USPS 2026 rates, wax seal fees, and 2-oz stamps." },
  { title: "Folded Place Card Maker", url: "/table-place-cards", category: "Stationery", desc: "Printable folded tent cards with meal icons." },
  { title: "Thank-You Note Generator", url: "/wedding-thank-you-cards", category: "Stationery", desc: "Wording formulas for cash, honeymoon funds, and gifts." },
  { title: "Digital Invitation Maker", url: "/digital-invitations", category: "Stationery", desc: "Mobile-friendly e-invites that sync with guest list." },
  { title: "Speech & Toast Timer", url: "/wedding-speech-calculator", category: "Stationery", desc: "Word count, reading pacing (120 WPM), and cue cards." },
  { title: "Wedding Hashtag Generator", url: "/wedding-hashtag-generator", category: "Stationery", desc: "50+ clever, punny hashtags with 8x10 bar signs." },
  { title: "Wedding Date Numerology", url: "/wedding-date-numerology", category: "Stationery", desc: "Life-path numbers and auspicious date compatibility." },
  { title: "Anniversary Gift Finder", url: "/anniversary-gift-finder", category: "Stationery", desc: "Traditional and modern gifts for years 1-60." }
];
---

<Layout 
	title="Manage.Wedding | Free Wedding Planning Calculators & Planning Guides"
	description="100% free, private wedding planning calculators. Calculate open bar alcohol, cake servings, master budgets, seating charts, timelines, and printable menus."
	schema={schema}
>
	<main>
		<!-- 1. Hero: Digital Sketchbook & Live Instant Search -->
		<section class="section-paper fade-in" style="padding: 4rem 1.5rem 3rem; position: relative; overflow: hidden; border-bottom: 3px solid var(--fg-pencil);">
			
			<div class="tape" style="top: -10px;"></div>
			
			<div style="max-width: 1050px; margin: 0 auto; text-align: center; position: relative; z-index: 10;">
				
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 6px 16px; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-1deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.95rem; font-weight: 700; color: var(--fg-pencil);">100% Free • Zero-Tracking Privacy • Instant Downloads</span>
				</div>

				<h1 class="font-heading" style="font-size: clamp(36px, 6.5vw, 68px); line-height: 1.15; color: var(--fg-pencil); margin-bottom: 1.25rem;">
					Plan your wedding math <br class="hidden sm:inline" />
					<span style="color: var(--accent-blue); text-decoration: underline; text-decoration-style: wavy;">without the stress.</span>
				</h1>

				<p style="font-size: clamp(1.1rem, 2.5vw, 1.3rem); color: var(--text-secondary); max-width: 760px; margin: 0 auto 2rem; line-height: 1.6;">
					Your private digital sketchbook for open bar estimates, venue hidden fees (++), visual seating charts, and printable stationery.
				</p>

				<!-- Live Instant Search Bar with Dynamic Dropdown -->
				<div style="position: relative; max-width: 650px; margin: 0 auto 2rem;">
					<div class="search-hero-box" style="margin-bottom: 0;">
						<span style="font-size: 1.3rem; color: #64748b;">🔍</span>
						<input 
							type="text" 
							id="home-tool-search" 
							class="search-hero-input" 
							placeholder="Search 37+ tools: drinks, venue fees, seating, speech, cake..."
							aria-label="Search all wedding planning calculators"
							autocomplete="off"
						/>
						<button id="clear-search-btn" style="display: none; background: none; border: none; font-size: 1.1rem; color: #94a3b8; cursor: pointer; padding: 0 0.5rem;">✕</button>
					</div>

					<!-- Search Results Live Dropdown Popup -->
					<div id="search-dropdown-results" style="display: none; position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 4px 4px 0px var(--fg-pencil); max-height: 380px; overflow-y: auto; z-index: 100; text-align: left; padding: 0.5rem;">
						<!-- Injected by JavaScript -->
					</div>
				</div>

				<!-- Fast Shortcut Chips -->
				<div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; max-width: 800px; margin: 0 auto 2rem;">
					<span style="font-size: 0.88rem; font-weight: 600; color: #64748b; align-self: center;">Popular Sizers:</span>
					<a href="/wedding-drink-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Open Bar</a>
					<a href="/wedding-venue-cost-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🏰 Venue Fees (++)</a>
					<a href="/seating-chart-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🪑 Seating Chart</a>
					<a href="/reception-menu-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">📜 Menu Maker</a>
					<a href="/wedding-envelope-addressing" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">✉️ Envelope Addressing</a>
				</div>

				<!-- Main Hero CTAs -->
				<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
					<a href="#featured-favorites" class="hand-btn" style="padding: 14px 30px; font-size: 1.15rem;">
						Explore Top Calculators ↓
					</a>
					<a href="/about" class="hand-btn secondary" style="padding: 14px 26px; font-size: 1.15rem;">
						Why Manage.Wedding?
					</a>
				</div>

			</div>
		</section>

		<!-- 2. Spotlight "Crowd Favorites" (4 Illustrated Cards) -->
		<section id="featured-favorites" style="padding: 4rem 1.5rem; max-width: 1200px; margin: 0 auto;">
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil);">
					⭐ Featured Crowd Favorites
				</h2>
				<p style="font-size: 1.1rem; color: var(--text-secondary); max-width: 600px; margin: 0.25rem auto 0;">
					The most popular tools relied on by thousands of couples and wedding coordinators.
				</p>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 2rem;">
				
				<!-- Featured 1: Open Bar -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/wedding_bar_sketch.webp" 
						alt="Wedding Open Bar Drink Calculator" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #fef08a; border-color: var(--fg-pencil); color: var(--fg-pencil);">Top Favorite</span>
						<span class="tool-time">⏱️ 2 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Wedding Drink Calculator</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Accurately calculate beer, wine, liquor bottles, and ice for full or soft bars.
					</p>
					<a href="/wedding-drink-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Plan Open Bar →
					</a>
				</div>

				<!-- Featured 2: Master Budget -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/calculator_sketch.webp" 
						alt="Master Budget Calculator" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dbeafe; border-color: #93c5fd; color: #1e40af;">Financial Core</span>
						<span class="tool-time">⏱️ 3 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Master Budget Calculator</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Break down any overall budget into verified industry allocation percentages.
					</p>
					<a href="/master-budget-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Allocate Budget →
					</a>
				</div>

				<!-- Featured 3: Day-Of Timeline -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/pocket-watch-sketch.webp" 
						alt="Day-Of Timeline Generator" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dcfce7; border-color: #86efac; color: #166534;">Day-Of Logistics</span>
						<span class="tool-time">⏱️ 3 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Day-Of Timeline Generator</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Generate a detailed, minute-by-minute itinerary schedule for bridal party & vendors.
					</p>
					<a href="/day-of-timeline-generator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Create Timeline →
					</a>
				</div>

				<!-- Featured 4: Seating Chart -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/seating_chart_sketch.webp" 
						alt="Seating Chart Maker" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #f3e8ff; border-color: #d8b4fe; color: #6b21a8;">Interactive Tool</span>
						<span class="tool-time">⏱️ 5 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Seating Chart Maker</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Arrange round and banquet tables, drag guests, and download printable chart exports.
					</p>
					<a href="/seating-chart-maker" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Make Seating Chart →
					</a>
				</div>

			</div>
		</section>

		<!-- 4. The 4-Phase Wedding Planning Master Roadmap -->
		<section style="background: var(--muted-paper); padding: 4.5rem 1.5rem; border-top: 3px dashed var(--fg-pencil); border-bottom: 3px dashed var(--fg-pencil);">
			<div style="max-width: 1100px; margin: 0 auto;">
				
				<div style="text-align: center; margin-bottom: 3rem;">
					<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Timeline Guide</span>
					<h2 class="font-heading" style="font-size: clamp(28px, 4.5vw, 44px); color: var(--fg-pencil);">
						The Master Wedding Planning Roadmap
					</h2>
					<p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 650px; margin: 0.25rem auto 0;">
						When to calculate, size, and finalize each part of your wedding day.
					</p>
				</div>

				<div style="display: flex; flex-direction: column; gap: 1.75rem;">
					
					<!-- Roadmap Step 1 -->
					<div class="hand-card" style="padding: 1.75rem; background: #fff; border-left: 6px solid var(--accent-red);">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								Phase 1: Budget Feasibility & Venue Lockdown (12–9 Months Out)
							</h3>
							<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
								Milestone 01
							</span>
						</div>
						<p class="font-body" style="font-size: 1rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 1rem 0;">
							Establish your total budget ceiling before touring properties. Audit venue quotes for hidden F&B minimums and 22% plus-plus (++) surcharges. Use family contribution agreements to clarify who pays for what without awkward conversations.
						</p>
						<div style="display: flex; gap: 0.75rem; flex-wrap: wrap; font-size: 0.88rem;">
							<a href="/master-budget-calculator" class="tool-tag" style="text-decoration: none; font-weight: 700;">💰 Budget Allocator</a>
							<a href="/wedding-venue-cost-calculator" class="tool-tag" style="text-decoration: none; font-weight: 700;">🏰 Venue Fee (++) Audit</a>
							<a href="/who-pays-for-what-wedding" class="tool-tag" style="text-decoration: none; font-weight: 700;">👥 Family Split Agreement</a>
						</div>
					</div>

					<!-- Roadmap Step 2 -->
					<div class="hand-card" style="padding: 1.75rem; background: #fff; border-left: 6px solid var(--accent-blue);">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								Phase 2: Guest Experience, Catering & Bar Strategy (8–5 Months Out)
							</h3>
							<span style="font-size: 0.85rem; font-weight: 700; background: #dbeafe; border: 1px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
								Milestone 02
							</span>
						</div>
						<p class="font-body" style="font-size: 1rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 1rem 0;">
							Calculate expected guest attendance curves based on local vs out-of-town guest ratios. Estimate open bar wine, beer, and liquor handle bottles (Costco savings), and finalize custom wedding cake pricing per slice.
						</p>
						<div style="display: flex; gap: 0.75rem; flex-wrap: wrap; font-size: 0.88rem;">
							<a href="/wedding-drink-calculator" class="tool-tag" style="text-decoration: none; font-weight: 700;">🍾 Open Bar Calculator</a>
							<a href="/liquor-wedding-calculator" class="tool-tag" style="text-decoration: none; font-weight: 700;">🍸 Liquor Handles Sizer</a>
							<a href="/cake-pricing-calculator" class="tool-tag" style="text-decoration: none; font-weight: 700;">🍰 Cake Pricing Calculator</a>
						</div>
					</div>

					<!-- Roadmap Step 3 -->
					<div class="hand-card" style="padding: 1.75rem; background: #fff; border-left: 6px solid #7c3aed;">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								Phase 3: Invitations, RSVPs & Stationery Production (4–2 Months Out)
							</h3>
							<span style="font-size: 0.85rem; font-weight: 700; background: #f3e8ff; border: 1px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
								Milestone 03
							</span>
						</div>
						<p class="font-body" style="font-size: 1rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 1rem 0;">
							Format A7 outer envelopes with proper etiquette (doctors, married names, families). Calculate total USPS postage including wax seal and non-machinable fees, and track dietary RSVPs as responses arrive.
						</p>
						<div style="display: flex; gap: 0.75rem; flex-wrap: wrap; font-size: 0.88rem;">
