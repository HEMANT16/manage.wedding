---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Manage.Wedding Calculators",
  "url": "https://manage.wedding/",
  "description": "A collection of premium calculators for planning your perfect wedding."
};
---

<Layout 
	title="Manage.Wedding | Precision Planning for Your Perfect Day"
	description="A collection of beautifully designed tools for wedding planning, including drink calculators, cake pricing, seating charts, and more."
	schema={schema}
>
	<main>
		<section class="section-muted fade-in" style="min-height: 80vh; display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden;">
			
			<!-- Decorative scribbles (absolute positioning) -->
			<svg style="position: absolute; top: 10%; right: 15%; width: 150px; height: 150px; opacity: 0.2; transform: rotate(15deg);" viewBox="0 0 100 100">
				<path d="M10,50 Q30,10 50,50 T90,50" fill="none" stroke="var(--fg-pencil)" stroke-width="3" stroke-dasharray="5,5" />
				<circle cx="90" cy="50" r="5" fill="var(--accent-red)" />
			</svg>
			
			<div style="max-width: 1200px; margin: 0 auto; padding: 4rem 2rem; width: 100%; position: relative; z-index: 10;">
				<div style="max-width: 800px; text-align: center; margin: 0 auto;">
					<div class="tape"></div>
					<div class="hand-card" style="display: inline-block; padding: 1rem 2rem; margin-bottom: 2rem; transform: rotate(-2deg); background-color: var(--post-it);">
						<span class="font-heading" style="font-size: 1.5rem; color: var(--accent-red);">Start sketching your budget!</span>
					</div>
					
					<h1 class="font-heading" style="font-size: clamp(40px, 8vw, 80px); line-height: 1.1; margin-bottom: 2rem; color: var(--fg-pencil); transform: rotate(1deg);">
						Budget your wedding <br/><span style="color: var(--accent-blue); text-decoration: underline; text-decoration-style: wavy;">without the stress.</span>
					</h1>
					
					<p class="font-body" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 3rem; max-width: 600px; margin-left: auto; margin-right: auto;">
						Grab your sketchbook. Our hand-crafted tools make wedding planning easy, visual, and fun.
					</p>
					
					<div style="display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap;">
						<a href="#food-beverage" class="hand-btn">View Calculators</a>
						<a href="#" class="hand-btn secondary">Read The Guide</a>
					</div>
				</div>
			</div>
		</section>

		<!-- 1. Food & Beverage (Cream) -->
		<section id="food-beverage" class="section-paper fade-in" style="animation-delay: 0.1s;">
			<div class="category-header">
				<h2 class="category-title font-heading">Food & Beverage</h2>
				<p class="category-desc">Tools to manage the menu, alcohol, and catering costs.</p>
			</div>
			<div class="home-grid">
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Drink Calculator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Plan your standard open bar or soft bar. Calculate exact quantities of beer, wine, liquor, and mixers based on your guest count.
					</p>
					<a href="/wedding-drink-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Plan The Drinks</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Liquor Heavy Bar</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Designed for full open bars with a strong emphasis on cocktails. Optimize your alcohol purchasing with our advanced ratios.
					</p>
					<a href="/liquor-wedding-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Optimize Liquor</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Cake Pricing</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						For bakers and caterers: calculate the exact price you should charge for custom wedding cakes to ensure profitability.
					</p>
					<a href="/cake-pricing-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Price A Cake</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Alcohol Dilution</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						A precise tool for caterers and bartenders to dilute high-proof alcohol down to a target ABV safely and accurately.
					</p>
					<a href="/alcohol-dilution-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Dilute ABV</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Reception Menu Maker</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Generate beautifully formatted, printable dinner menus for your reception tables.
					</p>
					<a href="/reception-menu-maker" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Make Menu</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Cake Serving Calculator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Calculate exactly how many tiers, sizes, and slices of wedding cake you need based on your guest count.
					</p>
					<a href="/cake-serving-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Size Your Cake</a>
				</div>
			</div>
		</section>

		<!-- 2. Guest Management (Blue) -->
		<section id="guest-management" class="section-muted fade-in" style="animation-delay: 0.2s;">
			<div class="category-header">
				<h2 class="category-title font-heading">Guest Management</h2>
				<p class="category-desc">Tools for organizing attendees, RSVPs, and reception seating.</p>
			</div>
			<div class="home-grid">
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Guest Count Estimator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Input your venue capacity and overall budget to see exactly how many guests you can realistically afford to invite.
					</p>
					<a href="/guest-count-estimator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Estimate Guests</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Guest List Manager</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						A comprehensive tracker for names, plus-ones, addresses, and dietary restrictions.
					</p>
					<a href="/guest-list-manager" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Manage Guest List</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">RSVP Tracker</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						A digital system to collect and tally who is attending, synced directly with your Guest List.
					</p>
					<a href="/rsvp-tracker" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Track RSVPs</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Seating Chart Maker</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						A visual drag-and-drop tool for arranging tables and assigning seats perfectly. Exportable to PDF.
					</p>
					<a href="/seating-chart-maker" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Make Seating Chart</a>
				</div>
			</div>
		</section>

		<!-- 3. Planning & Logistics (Cream) -->
		<section id="planning" class="section-paper fade-in" style="animation-delay: 0.3s;">
			<div class="category-header">
				<h2 class="category-title font-heading">Planning & Logistics</h2>
				<p class="category-desc">Tools for organizing time, schedules, and keeping on track.</p>
			</div>
			<div class="home-grid">
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Day-Of Timeline Generator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Input your ceremony start time, and we'll calculate the perfect schedule for hair, photos, dinner, and dancing.
					</p>
					<a href="/day-of-timeline-generator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Generate Timeline</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Wedding Checklist</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						A comprehensive month-by-month task manager to ensure nothing falls through the cracks.
					</p>
					<a href="/wedding-checklist" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">View Checklist</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Wedding Date Numerology</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Enter your birthdates and proposed wedding date to calculate your numerological compatibility and life path!
					</p>
					<a href="/wedding-date-numerology" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Calculate Numerology</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">RSVP Date Calculator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Input your wedding date to instantly get your mailing schedule for Save-the-Dates, Invites, and RSVP deadlines.
					</p>
					<a href="/rsvp-date-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Calculate Dates</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Dress Size Converter</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Bridal sizing is tricky! Input your bust, waist, and hip measurements to find your true bridal size.
					</p>
					<a href="/dress-size-converter" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Convert Size</a>
				</div>
			</div>
		</section>

		<!-- 4. Budgeting & Finance (Blue) -->
		<section id="budgeting" class="section-muted fade-in" style="animation-delay: 0.4s;">
			<div class="category-header">
				<h2 class="category-title font-heading">Budgeting & Finance</h2>
				<p class="category-desc">Tools to keep wedding expenses under control.</p>
			</div>
			<div class="home-grid">
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Master Budget Calculator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Input your total budget, and we'll provide an industry-standard percentage breakdown (venue, attire, florals, etc.).
					</p>
					<a href="/master-budget-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Calculate Budget</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Catering Cost Estimator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Calculate expected catering costs based on guest count, serving style (plated vs buffet), and venue tier.
					</p>
					<a href="/catering-cost-estimator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Estimate Costs</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Floral Cost Estimator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Get accurate estimates for bouquets, centerpieces, and installations based on the season and flower types.
					</p>
					<a href="/floral-cost-estimator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Estimate Florals</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Dress Alterations</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Estimate tailoring costs based on dress fabric, number of layers, and the specific adjustments needed.
					</p>
					<a href="/dress-alterations-estimator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Estimate Alterations</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Wedding Loan Calculator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Financing your big day? Calculate your monthly payments based on loan amount, terms, and interest rate.
					</p>
					<a href="/wedding-loan-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Calculate Loan</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Vendor Tipping Calculator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Not sure who to tip or how much? Calculate standard gratuity for photographers, DJs, and caterers.
					</p>
					<a href="/vendor-tipping-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Calculate Tips</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Honeymoon Budget Estimator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Estimate total costs for flights, hotels, and excursions based on destination and luxury level.
					</p>
					<a href="/honeymoon-budget-estimator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Estimate Honeymoon</a>
				</div>
			</div>
		</section>

		<!-- 5. Stationery & Printables (Cream) -->
		<section id="stationery" class="section-paper fade-in" style="animation-delay: 0.5s;">
			<div class="category-header">
				<h2 class="category-title font-heading">Stationery & Printables</h2>
				<p class="category-desc">Tools for generating printable day-of items and digital invites.</p>
			</div>
			<div class="home-grid">
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Digital Invitations</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Simple, customizable e-invites and Save-the-Dates that sync directly with your RSVP Tracker.
					</p>
					<a href="/digital-invitations" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Create Invites</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Table & Place Cards</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Automatically generate beautiful, printable PDFs for guest tables using your Seating Chart data.
					</p>
					<a href="/table-place-cards" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Generate PDFs</a>
				</div>
			</div>
		</section>

		<!-- 6. For Guests (Blue) -->
		<section id="for-guests" class="section-muted fade-in" style="animation-delay: 0.6s;">
			<div class="category-header">
				<h2 class="category-title font-heading">For The Guests</h2>
				<p class="category-desc">Helpful tools for attendees heading to the big day.</p>
			</div>
			<div class="home-grid">
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Gift Cash Calculator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Not sure how much to give? Calculate the perfect cash gift amount based on your relationship and wedding formality.
					</p>
					<a href="/gift-cash-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Calculate Gift</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Anniversary Gift Finder</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Calculate which anniversary year it is and discover the traditional and modern gift themes for the couple.
					</p>
					<a href="/anniversary-gift-finder" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Find Gifts</a>
				</div>
			</div>
		</section>

		<!-- 7. Creative & Extras -->
		<section id="creative-extras" class="section-muted fade-in" style="animation-delay: 0.7s; background-color: transparent;">
			<div class="category-header">
				<h2 class="category-title font-heading">Creative & Extras</h2>
				<p class="category-desc">Fun tools to brainstorm ideas, write speeches, and pick the perfect rings.</p>
			</div>
			<div class="home-grid">
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Wedding Hashtag Generator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Generate fun, custom wedding hashtags instantly using your names, nicknames, and wedding details.
					</p>
					<a href="/wedding-hashtag-generator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Generate Hashtags</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Wedding Speech Length Calculator</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Writing your vows or a toast? Paste your text to instantly calculate exactly how many minutes it will take to read aloud.
					</p>
					<a href="/wedding-speech-calculator" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Time My Speech</a>
				</div>
				<div class="hand-card">
					<h3 style="font-size: 1.25rem; font-style: italic; margin-bottom: 1.5rem;">Ring Size Converter</h3>
					<p style="font-size: 0.85rem; margin-bottom: 2rem; color: var(--text-secondary);">
						Convert between US, UK, and EU ring sizes instantly, complete with an interactive visual sizing guide.
					</p>
					<a href="/ring-size-converter" class="hand-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Convert Sizes</a>
				</div>
			</div>
		</section>

	</main>
</Layout>

