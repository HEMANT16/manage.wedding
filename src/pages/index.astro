<Layout 
	title="Manage.Wedding | 37+ Free Wedding Planning Calculators & Tools"
	description="100% free, private wedding planning calculators. Calculate open bar quantities, cake servings, budgets, seating charts, timelines, and printable menus with zero tracking."
	schema={schema}
>
	<main>
		<!-- 1. Hero: Planner's Desk & Live Tool Finder -->
		<section class="section-paper fade-in" style="padding: 4rem 1.5rem 3rem; position: relative; overflow: hidden; border-bottom: 3px solid var(--fg-pencil);">
			
			<!-- Decorative Scribble Elements -->
			<div class="tape" style="top: -10px;"></div>
			
			<div style="max-width: 1050px; margin: 0 auto; text-align: center; position: relative; z-index: 10;">
				
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 6px 16px; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-1deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.95rem; font-weight: 700; color: var(--fg-pencil);">100% Free • Zero-Tracking Privacy • Instant Downloads</span>
				</div>

				<h1 class="font-heading" style="font-size: clamp(36px, 6.5vw, 68px); line-height: 1.15; color: var(--fg-pencil); margin-bottom: 1.25rem;">
					Plan your wedding math <br class="hidden sm:inline" />
					<span style="color: var(--accent-blue); text-decoration: underline; text-decoration-style: wavy;">without the stress.</span>
				</h1>

				<p style="font-size: clamp(1.1rem, 2.5vw, 1.3rem); color: var(--text-secondary); max-width: 720px; margin: 0 auto 2rem; line-height: 1.6;">
					Grab your digital sketchbook. Over 37 interactive calculators, visual seating planners, and printable day-of templates built to save you thousands.
				</p>

				<!-- Live Instant Search Bar -->
				<div class="search-hero-box">
					<span style="font-size: 1.3rem; color: #64748b;">🔍</span>
					<input 
						type="text" 
						id="home-tool-search" 
						class="search-hero-input" 
						placeholder="Search: drinks, budget, seating, speech, cake, flowers..."
						aria-label="Search all wedding planning calculators"
						autocomplete="off"
					/>
					<button id="clear-search-btn" style="display: none; background: none; border: none; font-size: 1.1rem; color: #94a3b8; cursor: pointer; padding: 0 0.5rem;">✕</button>
				</div>

				<!-- Fast Shortcut Chips -->
				<div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; max-width: 750px; margin: 0 auto 2rem;">
					<span style="font-size: 0.88rem; font-weight: 600; color: #64748b; align-self: center;">Quick Jump:</span>
					<a href="/wedding-drink-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Open Bar</a>
					<a href="/master-budget-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Budget Allocator</a>
					<a href="/day-of-timeline-generator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">📅 Day-Of Timeline</a>
					<a href="/seating-chart-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🪑 Seating Chart</a>
					<a href="/wedding-speech-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🎙️ Speech Timer</a>
				</div>

				<!-- Main Hero CTAs -->
				<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
					<a href="#all-tools-section" class="hand-btn" style="padding: 14px 30px; font-size: 1.15rem;">
						Explore All 37+ Tools ↓
					</a>
					<a href="/about" class="hand-btn secondary" style="padding: 14px 26px; font-size: 1.15rem;">
						Why Manage.Wedding?
					</a>
