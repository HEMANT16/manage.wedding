	<!-- Client Side Search & Category Filtering Script -->
	<script is:inline>
		const searchInput = document.getElementById('home-tool-search');
		const clearBtn = document.getElementById('clear-search-btn');
		const filterPills = document.querySelectorAll('.filter-pill');
		const toolCards = document.querySelectorAll('.tool-card-item');
		const noResults = document.getElementById('no-results-box');
		const resetBtn = document.getElementById('reset-filter-btn');
		const ticker = document.getElementById('search-status-ticker');
		const visibleCountSpan = document.getElementById('visible-count');

		let activeCategory = 'all';

		function filterTools() {
			const query = (searchInput?.value || '').trim().toLowerCase();

			// Toggle clear button
			if (clearBtn) {
				clearBtn.style.display = query.length > 0 ? 'inline-block' : 'none';
			}

			let visibleCount = 0;

			toolCards.forEach((card) => {
				const cardCat = card.getAttribute('data-category');
				const cardTitle = card.getAttribute('data-title') || '';
				const cardDesc = card.getAttribute('data-desc') || '';

				const matchesCat = (activeCategory === 'all' || cardCat === activeCategory);
				const matchesQuery = !query || cardTitle.includes(query) || cardDesc.includes(query);

				if (matchesCat && matchesQuery) {
					card.style.display = 'flex';
					visibleCount++;
				} else {
					card.style.display = 'none';
				}
			});

			// Status indicator
			if (query.length > 0 || activeCategory !== 'all') {
				if (ticker) ticker.style.display = 'block';
				if (visibleCountSpan) visibleCountSpan.innerText = visibleCount;
			} else {
				if (ticker) ticker.style.display = 'none';
			}

			// Empty state
			if (noResults) {
				noResults.style.display = visibleCount === 0 ? 'block' : 'none';
			}
		}

		// Filter pills click
		filterPills.forEach((pill) => {
			pill.addEventListener('click', () => {
				filterPills.forEach(p => p.classList.remove('is-active'));
				pill.classList.add('is-active');
				activeCategory = pill.getAttribute('data-filter') || 'all';
				filterTools();
			});
		});

		// Search input typing
		if (searchInput) {
			searchInput.addEventListener('input', filterTools);
		}

		// Clear search button
		if (clearBtn) {
			clearBtn.addEventListener('click', () => {
				if (searchInput) searchInput.value = '';
				filterTools();
				if (searchInput) searchInput.focus();
			});
		}

		// Reset button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (searchInput) searchInput.value = '';
				activeCategory = 'all';
				filterPills.forEach(p => {
					if (p.getAttribute('data-filter') === 'all') {
						p.classList.add('is-active');
					} else {
						p.classList.remove('is-active');
					}
				});
				filterTools();
			});
		}
	</script>
</Layout>
