---
import { tools } from '../data/tools';
import '../styles/global.css';

const h1 = "Manage.Wedding Calculators";
const title = "Manage.Wedding | Free Wedding Planning Calculators";
const description = "A collection of free, easy-to-use calculators for planning your wedding, pricing custom cakes, and managing event alcohol.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen font-sans">
    <header class="bg-white shadow-sm py-4">
      <div class="max-w-4xl mx-auto px-4 flex justify-between items-center">
        <a href="/" class="text-xl font-bold text-blue-600">Manage.Wedding</a>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-12">
      <div class="text-center mb-12">
        <h1 class="text-5xl font-extrabold text-gray-900 mb-4">{h1}</h1>
        <p class="text-xl text-gray-600">{description}</p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6">
        {tools.map(tool => (
          <a href={`/${tool.slug}`} class="block bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition-shadow border border-gray-100 group">
            <h2 class="text-2xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">{tool.h1}</h2>
            <p class="text-gray-600">{tool.description}</p>
            <div class="mt-4 text-sm font-semibold text-blue-500">Open Calculator &rarr;</div>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
