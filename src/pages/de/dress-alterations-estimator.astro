							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">40 € – 60 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">70 € – 100 €</td>
