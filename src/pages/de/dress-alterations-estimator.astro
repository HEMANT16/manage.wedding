---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/dress-alterations-estimator/#webapp",
      "name": "Brautkleid-Änderungskosten Rechner",
      "url": "https://manage.wedding/de/dress-alterations-estimator",
      "description": "Kostenloser Rechner für Brautkleid-Änderungen: Berechnen Sie präzise Schneiderkosten für Saumkürzungen, Schleppenaufhängung, Miederanpassung, eingenähte BH-Cups und Express-Zuschläge. Mit Word- & PDF-Export.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "de",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie man die Änderungskosten für das Brautkleid kalkuliert und Anproben plant",
      "description": "Braut-Leitfaden zur Schätzung von Schneiderkosten, Vorbereitung der 3 Anprobetermine und Auswahl der passenden Schleppenaufhängung.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Rockaufbau und Saumverarbeitung prüfen",
          "text": "Ermitteln Sie die Saumart (glatter Saum, Rosshaar-Bordüre oder Spitzenkante) und zählen Sie die Tüll- und Futterlagen."
        },
        {
          "@type": "HowToStep",
          "name": "2. Passform-Anpassungen & Schleppe wählen",
          "text": "Wählen Sie Mieder enger/weiter nähen, Träger kürzen, BH-Cups einnähen und die Art der Schleppenhochsteckung."
        },
        {
          "@type": "HowToStep",
          "name": "3. 3 Anprobetermine rechtzeitig buchen",
          "text": "Planen Sie Termin 1 (8–10 Wochen vorher), Termin 2 (4–5 Wochen vorher) und die finale Abholung (10–14 Tage vor der Hochzeit)."
        },
        {
          "@type": "HowToStep",
          "name": "4. Original-Brautschuh und Unterwäsche mitbringen",
          "text": "Tragen Sie bei jeder Anprobe exakt die Brautschuh-Absatzhöhe und die geplante Shapewear, damit der Saum millimetergenau fällt."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie viel kosten Brautkleid-Änderungen im Durchschnitt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Im deutschsprachigen Raum kosten Standard-Änderungen (Kürzen des Saums, Mieder enger nähen und Schleppe hochstecken) meist zwischen 250 € und 550 €. Bei Kleidern mit vielen Tülllagen, handbestickter Spitze oder aufwendigen Schnürungen können die Schneiderkosten 600 € bis 950 € erreichen."
          }
        },
        {
          "@type": "Question",
          "name": "Warum ist das Kürzen von Spitzenkleidern so teuer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei einer Bogenspitzen-Kante (Scalloped Lace) kann der Saum nicht einfach abgeschnitten werden. Die Schneiderin muss die Spitze in stundenlanger Handarbeit abtrennen, die darunterliegenden Futter- und Tüllröcke kürzen und die Spitze anschließend von Hand auf die neue Rocklänge versetzen."
          }
        },
        {
          "@type": "Question",
          "name": "Wann sollte die erste Brautkleid-Anprobe stattfinden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ideal ist die 1. Anprobe 8 bis 10 Wochen vor der Hochzeit. Die 2. Anprobe erfolgt 4 bis 5 Wochen vorher, und die finale Abholung mit Anprobe findet etwa 10 bis 14 Tage vor dem großen Tag statt."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Brautkleid-Änderungskosten Rechner (Schneiderkosten & Anproben-Guide) | Manage.Wedding"
	description="Kostenloser Rechner für Brautkleid-Änderungen: Berechnen Sie Schneiderkosten für Saum kürzen, Schleppe hochstecken, Mieder anpassen, BH-Cups & Eilzuschläge. Mit Word- & PDF-Export."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Brautkleid-Änderungsrechner" category="budget" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Brautkleid <span class="accent-italic">Änderungskosten Rechner</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Berechnen Sie realistische Schneiderpreise für Saumkürzungen, Schleppenaufhängung, Miederanpassung, eingenähte Cups und Stoffkomplexität. Exportieren Sie Ihre <strong>Änderungs-Checkliste</strong> in <strong>Word (.doc)</strong> oder <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Änderungskosten in 3 Schritten berechnen
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Saum & Rocklagen wählen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Wählen Sie die Kantenverarbeitung (glatt, Rosshaar/Crinoline oder Bogenspitze) und die Anzahl der Tüll- und Futterlagen.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Mieder & Schleppen-Details wählen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Haken Sie Miederanpassung, Trägerkürzung, eingenähte BH-Cups und die Schleppenhochsteckung ab.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Kostenvoranschlag exportieren
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Klicken Sie auf <strong>„📝 Export Word (.doc)“</strong> oder <strong>„🖨️ Export PDF“</strong> als Vorlage für Ihre Schneiderin.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="alterations-calc-grid">
			
			<!-- Left Column: Alterations Configuration Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							✂️ Gewünschte Schneiderarbeiten
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Passform, Saum, Schleppe & Spezialwünsche
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Währung:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="CHF">CHF (Schweiz)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="alterations-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Skirt Hemming -->
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<h3 class="font-heading" style="font-size: 1.1rem; color: var(--accent-red); margin-bottom: 0.5rem;">
							👗 1. Rocksaum kürzen
						</h3>
						
						<div style="margin-bottom: 0.75rem;">
							<label for="select-hem-type" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
								Saumart & Kantenverarbeitung *
							</label>
							<select id="select-hem-type" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.9rem;">
								<option value="0">Kein Kürzen erforderlich (0 €)</option>
								<option value="90" selected>Glatter Saum (Chiffon / Crêpe / Satin) (90 €)</option>
								<option value="150">Saum mit Rosshaarband / Crinoline (150 €)</option>
								<option value="220">Bogenspitzen-Bordüre (Abtrennen & Versetzen von Hand) (220 €)</option>
							</select>
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-skirt-layers" class="font-body" style="font-size: 0.85rem; font-weight: bold;">
									Zusätzliche Tüll- / Futterlagen (je 35 €)
								</label>
								<span id="label-skirt-layers" style="font-size: 0.85rem; font-weight: bold; color: var(--accent-red);">2 Lagen</span>
							</div>
							<input type="range" id="input-skirt-layers" min="0" max="6" value="2" step="1" style="width: 100%; accent-color: var(--accent-red);">
						</div>
					</div>

					<!-- 2. Bodice & Fit Adjustments -->
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<h3 class="font-heading" style="font-size: 1.1rem; color: var(--accent-blue); margin-bottom: 0.5rem;">
							🪡 2. Mieder- & Oberteil-Anpassung
						</h3>
						
						<div style="display: flex; flex-direction: column; gap: 0.5rem;">
							<label style="font-size: 0.88rem; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-take-in-bodice" value="95" checked class="alt-checkbox" style="accent-color: var(--fg-pencil);">
								<span>Mieder an Seitennähten enger/weiter nähen (95 €)</span>
							</label>

							<label style="font-size: 0.88rem; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-shorten-straps" value="45" checked class="alt-checkbox" style="accent-color: var(--fg-pencil);">
								<span>Träger oder Ärmel anheben / kürzen (45 €)</span>
							</label>

							<label style="font-size: 0.88rem; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-sew-in-cups" value="35" checked class="alt-checkbox" style="accent-color: var(--fg-pencil);">
								<span>Push-up / Schaumstoff BH-Cups einnähen (35 €)</span>
							</label>

							<label style="font-size: 0.88rem; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-reshape-neckline" value="65" class="alt-checkbox" style="accent-color: var(--fg-pencil);">
								<span>Ausschnitt oder Rückenausschnitt anpassen (65 €)</span>
							</label>

							<label style="font-size: 0.88rem; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-corset-back" value="120" class="alt-checkbox" style="accent-color: var(--fg-pencil);">
								<span>Reißverschluss auf Schnürung/Korsage umbauen (120 €)</span>
							</label>
						</div>
					</div>

					<!-- 3. Train Bustle & Finishing -->
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<h3 class="font-heading" style="font-size: 1.1rem; color: #16a34a; margin-bottom: 0.5rem;">
							🎀 3. Schleppe hochstecken & Finish
						</h3>
						
						<div style="margin-bottom: 0.75rem;">
							<label for="select-bustle-style" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
								Schleppen-Hochsteckung (Bustle) *
							</label>
							<select id="select-bustle-style" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.9rem;">
								<option value="0">Keine Schleppe / Nicht hochstecken (0 €)</option>
								<option value="45">Einfache Schleppennadel / 1-Punkt-Aufhängung (45 €)</option>
								<option value="85" selected>Französische / 3- bis 5-Punkt-Aufhängung (85 €)</option>
								<option value="140">Ballsaal-Schleppe / Mehrfach-Aufhängung unter Rock (140 €)</option>
							</select>
						</div>

						<div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem;">
							<label style="font-size: 0.88rem; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-beading-repair" value="60" class="alt-checkbox" style="accent-color: var(--fg-pencil);">
								<span>Perlenstickerei & Spitzen-Applikationen sichern (60 €)</span>
							</label>

							<label style="font-size: 0.88rem; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-steaming-press" value="50" checked class="alt-checkbox" style="accent-color: var(--fg-pencil);">
								<span>Professionelles Aufdämpfen & Bügeln vor Abholung (50 €)</span>
							</label>
						</div>

						<div>
							<label for="select-timeline-rush" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
								Zeitplan & Eilservice
							</label>
							<select id="select-timeline-rush" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
								<option value="1.0" selected>Regulär (8–12 Wochen Vorlauf) (Kein Zuschlag)</option>
								<option value="1.3">Eilservice (3–4 Wochen Vorlauf) (+30% Zuschlag)</option>
								<option value="1.6">Express-Notfall (< 2 Wochen Vorlauf) (+60% Zuschlag)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Line-Item Invoice -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Alterations Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								👗 Schneiderkosten-Prognose
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Geschätzte Kosten für alle Anpassungen
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Drucken
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Grand Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Geschätzte Gesamtkosten Änderung</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">470 €</strong>
						<span id="res-range-subtext" style="font-size: 0.85rem; color: var(--accent-red);">Typischer Rahmen: 415 € – 540 €</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Aufgeschlüsselte Schneiderposten
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">👗 Saumkürzung & Extralagen:</td>
									<td id="res-hem-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">160 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🪡 Mieder, Träger & BH-Cups:</td>
									<td id="res-bodice-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">175 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🎀 Schleppen-Hochsteckung:</td>
									<td id="res-bustle-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">85 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">✨ Perlen, Spitze & Dämpfen:</td>
									<td id="res-extras-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">50 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0; color: var(--accent-red);">⚡ Eilzuschlag:</td>
									<td id="res-rush-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">0 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Günstig (250 €)</span>
							<span>Standard (500 €)</span>
							<span style="color: var(--accent-red);">Aufwendig (900 €+)</span>
						</div>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="cost-gauge-bar" style="width: 48%; height: 100%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Fitting Tips Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						📌 Zur 1. Anprobe unbedingt mitbringen:
					</strong>
					<ul class="font-body" style="font-size: 0.85rem; line-height: 1.5; padding-left: 1.1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Original-Brautschuh:</strong> Die genaue Absatzhöhe bestimmt millimetergenau den Saum.</li>
						<li><strong>Geplante Wäsche:</strong> Korsage, trägerloser BH oder nahtlose Shapewear für den perfekten Miedersitz.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Brautkleid-Änderungsübersicht</h1>
