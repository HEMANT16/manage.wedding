<script is:inline>
	const ringDatabase = [
		{ us: 3.0, uk: "F", eu: 44, jp: 4, mm: 44.2, dia: 14.1 },
		{ us: 3.5, uk: "G", eu: 45, jp: 5, mm: 45.5, dia: 14.5 },
		{ us: 4.0, uk: "H 1/2", eu: 47, jp: 7, mm: 46.8, dia: 14.9 },
		{ us: 4.5, uk: "I 1/2", eu: 48, jp: 8, mm: 48.0, dia: 15.3 },
		{ us: 5.0, uk: "J 1/2", eu: 49, jp: 9, mm: 49.3, dia: 15.7 },
		{ us: 5.5, uk: "L", eu: 50, jp: 10, mm: 50.6, dia: 16.1 },
		{ us: 6.0, uk: "M", eu: 52, jp: 11, mm: 51.9, dia: 16.5 },
		{ us: 6.5, uk: "N", eu: 53, jp: 13, mm: 53.1, dia: 16.9 },
		{ us: 7.0, uk: "O", eu: 54, jp: 14, mm: 54.4, dia: 17.3 },
		{ us: 7.5, uk: "P", eu: 56, jp: 15, mm: 55.7, dia: 17.7 },
		{ us: 8.0, uk: "Q", eu: 57, jp: 16, mm: 57.0, dia: 18.1 },
		{ us: 8.5, uk: "Q 1/2", eu: 58, jp: 17, mm: 58.3, dia: 18.5 },
		{ us: 9.0, uk: "R 1/2", eu: 60, jp: 18, mm: 59.5, dia: 18.9 },
		{ us: 9.5, uk: "S 1/2", eu: 61, jp: 19, mm: 60.8, dia: 19.4 },
		{ us: 10.0, uk: "T 1/2", eu: 62, jp: 20, mm: 62.1, dia: 19.8 },
		{ us: 10.5, uk: "U 1/2", eu: 63, jp: 22, mm: 63.4, dia: 20.2 },
		{ us: 11.0, uk: "V 1/2", eu: 65, jp: 23, mm: 64.6, dia: 20.6 },
		{ us: 11.5, uk: "W 1/2", eu: 66, jp: 24, mm: 65.9, dia: 21.0 },
		{ us: 12.0, uk: "Y", eu: 67, jp: 25, mm: 67.2, dia: 21.4 },
		{ us: 12.5, uk: "Z", eu: 68, jp: 26, mm: 68.5, dia: 21.8 },
		{ us: 13.0, uk: "Z+1", eu: 69, jp: 27, mm: 69.7, dia: 22.2 },
		{ us: 13.5, uk: "Z+2", eu: 70, jp: 28, mm: 71.0, dia: 22.6 },
		{ us: 14.0, uk: "Z+3", eu: 72, jp: 29, mm: 72.3, dia: 23.0 },
		{ us: 15.0, uk: "Z+5", eu: 75, jp: 31, mm: 74.8, dia: 23.8 }
	];

	const selectSystem = document.getElementById('select-system');
	const selectRingVal = document.getElementById('select-ring-val');
	const selectBandWidth = document.getElementById('select-band-width');

	const resUs = document.getElementById('res-us');
	const resUk = document.getElementById('res-uk');
	const resEu = document.getElementById('res-eu');
	const resJp = document.getElementById('res-jp');
	const resDia = document.getElementById('res-dia');
	const resDiaIn = document.getElementById('res-dia-in');
	const resCirc = document.getElementById('res-circ');
	const resCircIn = document.getElementById('res-circ-in');

	const visualRingCircle = document.getElementById('visual-ring-circle');
	const visualRingText = document.getElementById('visual-ring-text');
	const bandAdviceBox = document.getElementById('band-advice-box');

	function populateOptions() {
		const sys = selectSystem.value;
		selectRingVal.innerHTML = '';

		ringDatabase.forEach((row, idx) => {
			const opt = document.createElement('option');
			opt.value = idx.toString();

			if (sys === 'eu') opt.textContent = `Größe ${row.eu} (Umfang ${row.mm} mm)`;
			else if (sys === 'us') opt.textContent = `US-Größe ${row.us}`;
			else if (sys === 'uk') opt.textContent = `UK-Größe ${row.uk}`;
			else if (sys === 'jp') opt.textContent = `Japan-Größe ${row.jp}`;
			else if (sys === 'mm') opt.textContent = `${row.mm} mm Umfang (Ø ${row.dia} mm)`;

			selectRingVal.appendChild(opt);
		});

		// Default to EU 54 (index 8)
		selectRingVal.value = "8";
		updateConversion();
	}

	function updateConversion() {
		const idx = parseInt(selectRingVal.value) || 8;
		const baseData = ringDatabase[idx] || ringDatabase[8];
		const offset = parseFloat(selectBandWidth.value) || 0;

		// Calculate adjusted size index if wide band selected
		let effectiveIdx = idx;
		if (offset > 0) {
			const targetUS = baseData.us + offset;
			const found = ringDatabase.findIndex(r => r.us >= targetUS);
			if (found !== -1) effectiveIdx = found;
		}

		const data = ringDatabase[effectiveIdx] || baseData;

		resUs.textContent = data.us.toString();
		resUk.textContent = data.uk;
		resEu.textContent = data.eu.toString();
		resJp.textContent = data.jp.toString();

		const diaIn = (data.dia / 25.4).toFixed(2);
		const circIn = (data.mm / 25.4).toFixed(2);

		resDia.textContent = `${data.dia.toString().replace('.', ',')} mm`;
		resDiaIn.textContent = `${diaIn} in`;
		resCirc.textContent = `${data.mm.toString().replace('.', ',')} mm`;
		resCircIn.textContent = `${circIn} in`;

		// Visual Circle (px size approx 6x scale)
		const pxSize = Math.round(data.dia * 6);
		visualRingCircle.style.width = `${pxSize}px`;
		visualRingCircle.style.height = `${pxSize}px`;
		visualRingText.textContent = `Ø ${data.dia.toString().replace('.', ',')} mm`;

		// Advice
		if (offset > 0) {
			bandAdviceBox.innerHTML = `💡 <strong>Breiten-Offset angewendet:</strong> Ringgröße um <strong>+${offset}</strong> erhöht, um den Reibungswiderstand breiter Ringschienen auszugleichen. Bestellen Sie <strong>Größe ${data.eu}</strong> für den Tragekomfort Ihrer normalen Größe ${baseData.eu}!`;
		} else {
			bandAdviceBox.innerHTML = `💡 <strong>Standard-Passform:</strong> Exaktes Maß für klassische 1,5 mm bis 3 mm Verlobungs- und Trauringe.`;
		}
	}

	selectSystem.addEventListener('change', populateOptions);
	selectRingVal.addEventListener('change', updateConversion);
	selectBandWidth.addEventListener('change', updateConversion);
	document.querySelectorAll('input[name="interior-fit"]').forEach(r => r.addEventListener('change', updateConversion));

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Ringgrößen Spezifikation</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					table { width: 100%; border-collapse: collapse; margin-top: 15px; }
					th, td { border: 1px solid #ccc; padding: 8px; text-align: left; font-size: 13px; }
					th { background: #f2f2f2; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Offizielle Ringgrößen-Maßkarte</h1>
				<p>Erstellt am ${new Date().toLocaleDateString('de-DE')}</p>
				
				<table>
					<tr><th>Größensystem</th><th>Größenwert</th></tr>
					<tr><td>EU & Deutschland (Wiener Maß)</td><td><strong>Größe ${resEu.textContent}</strong></td></tr>
					<tr><td>US & Kanada</td><td><strong>US ${resUs.textContent}</strong></td></tr>
					<tr><td>UK & Australien</td><td><strong>UK ${resUk.textContent}</strong></td></tr>
					<tr><td>Japan & Asien</td><td><strong>Größe ${resJp.textContent}</strong></td></tr>
					<tr><td>Innendurchmesser</td><td>${resDia.textContent}</td></tr>
					<tr><td>Innenumfang</td><td>${resCirc.textContent}</td></tr>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Ringgroesse_EU_${resEu.textContent}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / 1:1 Sizer
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('de-DE');
		document.getElementById('print-us-size').textContent = `EU ${resEu.textContent}`;
		
		document.getElementById('p-us').textContent = resUs.textContent;
		document.getElementById('p-uk').textContent = resUk.textContent;
		document.getElementById('p-eu').textContent = resEu.textContent;
		document.getElementById('p-jp').textContent = resJp.textContent;
		document.getElementById('p-dia').textContent = resDia.textContent;
		document.getElementById('p-circ').textContent = resCirc.textContent;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "EU Groesse,US Groesse,UK Groesse,Japan Groesse,Durchmesser mm,Umfang mm\n";
		ringDatabase.forEach(r => {
			csv += `"${r.eu}","${r.us}","${r.uk}","${r.jp}","${r.dia}","${r.mm}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Internationale_Ringgroessen_Tabelle.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	populateOptions();
</script>
