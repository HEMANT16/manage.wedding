---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Kontakt | Manage.Wedding",
  "url": "https://manage.wedding/de/contact",
  "inLanguage": "de",
  "description": "Kontaktieren Sie das Team von Manage.Wedding. Senden Sie uns Feedback, Funktionswünsche, Rechner-Vorschläge oder Fragen direkt an manage.weddingall@gmail.com."
};
---

<Layout 
	title="Kontakt | Manage.Wedding — Schreiben Sie uns"
	description="Kontaktieren Sie Manage.Wedding direkt unter manage.weddingall@gmail.com. Haben Sie Feedback zu einem Rechner, einen Fehler entdeckt oder eine Idee für ein neues Tool?"
	schema={schema}
>
	<main style="max-width: 1050px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem); box-sizing: border-box;">
		
		<!-- Header -->
		<section class="section-paper" style="margin-bottom: 2.5rem; text-align: center; padding: 2.5rem 1rem;">
			<div class="tape" style="margin: 0 auto 1.25rem;"></div>
			<span class="badge-postit">Wir sind für Sie da</span>
			<h1 class="font-heading" style="font-size: clamp(34px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.2; text-align: center; margin: 0.75rem 0;">
				Kontakt zu Manage.Wedding
			</h1>
			<p style="font-size: 1.2rem; color: var(--text-secondary); max-width: 680px; margin: 0.5rem auto 0; text-align: center; line-height: 1.6;">
				Haben Sie eine Idee für einen neuen Rechner, Feedback zu unseren Tools oder eine Frage zur Hochzeitsplanung? Schreiben Sie uns direkt!
			</p>
		</section>

		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; margin-bottom: 4rem; align-items: start;">
			
			<!-- Direct Contact Form Card -->
			<div class="hand-card" style="padding: clamp(1.75rem, 3.5vw, 2.75rem); background: #fff;">
				<h2 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; text-align: center;">
					Direktnachricht senden
				</h2>
				<p style="font-size: 1.05rem; color: var(--text-secondary); margin-bottom: 1.75rem; text-align: center; line-height: 1.5;">
					Nachrichten gehen direkt an unser Postfach unter <strong style="color: var(--fg-pencil);">manage.weddingall@gmail.com</strong>.
				</p>

				<form id="contact-form" style="display: flex; flex-direction: column; gap: 1.35rem;">
					<!-- Hidden Honeypot Field for Spam Protection -->
					<input type="text" name="_honey" id="contact-honey" style="display: none;" tabindex="-1" autocomplete="off" />

					<div>
						<label for="contact-name" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Ihr Name <span style="color: #dc2626;">*</span>
						</label>
						<input 
							type="text" 
							name="name"
							id="contact-name" 
							required 
							placeholder="z. B. Julia & Maximilian" 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; font-size: 1.05rem; padding: 0.85rem 1rem;"
						/>
					</div>

					<div>
						<label for="contact-email" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Ihre E-Mail-Adresse <span style="color: #dc2626;">*</span>
						</label>
						<input 
							type="email" 
							name="email"
							id="contact-email" 
							required 
							placeholder="z. B. brautpaar@example.de" 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; font-size: 1.05rem; padding: 0.85rem 1rem;"
						/>
					</div>

					<div>
						<label for="contact-topic" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Thema
						</label>
						<select name="topic" id="contact-topic" class="hand-input" style="width: 100%; box-sizing: border-box; background: #fff; font-size: 1.05rem; padding: 0.85rem 1rem; cursor: pointer;">
							<option value="Suggest a Tool">💡 Neuen Rechner / neue Funktion vorschlagen</option>
							<option value="Bug Report">🐛 Rechenfehler oder Problem melden</option>
							<option value="General Question">💬 Allgemeine Frage zur Hochzeitsplanung</option>
							<option value="Partnership / Press">🤝 Medien, Presse oder Kooperation</option>
							<option value="Privacy Inquiry">🛡️ Frage zu Datenschutz oder Datenrechten</option>
						</select>
					</div>

					<div>
						<label for="contact-message" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Nachricht <span style="color: #dc2626;">*</span>
						</label>
						<textarea 
							name="message"
							id="contact-message" 
							rows="5" 
							required 
							placeholder="Beschreiben Sie Ihr Anliegen, welches Tool Sie nutzen oder welche neue Funktion Ihre Planung noch einfacher machen würde..." 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; resize: vertical; font-size: 1.05rem; line-height: 1.6; padding: 0.85rem 1rem;"
						></textarea>
					</div>

					<button 
						type="submit" 
						id="contact-submit-btn"
						class="hand-btn" 
						style="width: 100%; padding: 14px 20px; font-size: 1.15rem; cursor: pointer; margin-top: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.6rem;"
					>
						<span>✉️</span>
						<span id="btn-text">Nachricht direkt absenden</span>
					</button>
				</form>

				<!-- Success Status Box -->
				<div id="contact-success" style="display: none; background: #dcfce7; border: 2px solid #16a34a; border-radius: 6px; padding: 1.5rem; margin-top: 1.5rem; text-align: center; color: #166534;">
					<div style="font-size: 2rem; margin-bottom: 0.35rem;">🎉</div>
					<strong style="font-size: 1.2rem; display: block; margin-bottom: 0.5rem;">Vielen Dank! Ihre Nachricht wurde erfolgreich gesendet.</strong>
					<p style="margin: 0; font-size: 1.02rem; line-height: 1.5;">
						Sie wurde direkt an <strong>manage.weddingall@gmail.com</strong> zugestellt. Wir melden uns innerhalb von 24–48 Stunden bei Ihnen zurück!
					</p>
				</div>

				<!-- Error Fallback Box -->
				<div id="contact-error" style="display: none; background: #fee2e2; border: 2px solid #dc2626; border-radius: 6px; padding: 1.5rem; margin-top: 1.5rem; text-align: center; color: #991b1b;">
					<strong style="font-size: 1.1rem; display: block; margin-bottom: 0.35rem;">Nachricht konnte nicht automatisch versendet werden.</strong>
					<p style="margin: 0; font-size: 1rem;">
						Bitte senden Sie uns Ihre E-Mail direkt an <a id="error-mailto-link" href="mailto:manage.weddingall@gmail.com" style="color: #991b1b; text-decoration: underline; font-weight: bold;">manage.weddingall@gmail.com</a>.
					</p>
				</div>
			</div>

			<!-- Direct Contact Info & FAQ Side Column -->
			<div style="display: flex; flex-direction: column; gap: 1.75rem;">
				
				<!-- Direct Channels -->
				<div class="hand-card" style="padding: 2rem; background: var(--bg-paper);">
					<h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
						Direkter Kontakt & Postfach
					</h3>
					
					<div style="display: flex; flex-direction: column; gap: 1.2rem; font-size: 1rem;">
						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); margin-bottom: 0.35rem; font-size: 1.05rem;">📬 Haupt-E-Mail:</strong>
							<a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 700; text-decoration: underline; font-size: 1.1rem; word-break: break-all;">
								manage.weddingall@gmail.com
							</a>
						</div>

						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); font-size: 1.05rem;">💡 Wobei wir Ihnen helfen:</strong>
							<ul style="margin: 0.5rem 0 0 1.25rem; padding: 0; color: var(--text-secondary); font-size: 0.98rem; line-height: 1.6;">
								<li>Vorschläge für neue Hochzeitsrechner & Formeln</li>
								<li>Korrekturvorschläge und Feedback</li>
								<li>Kooperations- & Medienanfragen</li>
							</ul>
						</div>

						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); font-size: 1.05rem;">🛡️ Datenschutz-Anfragen:</strong>
							<p style="margin: 0.35rem 0 0; color: var(--text-secondary); font-size: 0.98rem; line-height: 1.5;">
								Alle Anfragen zu Datenschutzrechten können ebenfalls direkt an <a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 600; text-decoration: underline;">manage.weddingall@gmail.com</a> gerichtet werden.
							</p>
						</div>
					</div>
				</div>

				<!-- Quick Response Guarantee -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.45rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
						⚡ 24–48 Std. Antwortzeit
					</h3>
					<p style="font-size: 1.02rem; color: var(--text-secondary); margin: 0; line-height: 1.6; text-align: center;">
						Wir lesen jede Nachricht von Brautpaaren, Trauzeugen und Dienstleistern persönlich.
					</p>
				</div>

				<!-- Quick FAQ -->
				<div class="hand-card" style="padding: 2rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 1rem; text-align: center;">
						Häufige Fragen
					</h3>
					<details style="margin-bottom: 0.75rem; cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Sind alle Tools wirklich 100% kostenlos?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Ja! Alle über 30 Rechner und druckbaren Vorlagen stehen Ihnen für Ihre private Hochzeitsplanung völlig frei und ohne Bezahlschranken zur Verfügung.</p>
					</details>
					<details style="margin-bottom: 0.75rem; cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Kann ich einen neuen Rechner anfordern?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Ja, sehr gerne! Senden Sie uns einfach das Formular oben oder schreiben Sie an <a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 600;">manage.weddingall@gmail.com</a>.</p>
					</details>
					<details style="cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Werden meine Gästelisten oder Reden gespeichert?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Nein. Sämtliche Daten verbleiben zu 100% clientseitig im lokalen Speicher Ihres Geräts. Es findet keinerlei Übertragung an externe Server statt.</p>
					</details>
				</div>

			</div>

		</div>

	</main>

	<script is:inline>
		const form = document.getElementById('contact-form');
		const submitBtn = document.getElementById('contact-submit-btn');
		const btnText = document.getElementById('btn-text');
		const successBox = document.getElementById('contact-success');
		const errorBox = document.getElementById('contact-error');
		const errorMailto = document.getElementById('error-mailto-link');

		if (form) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				// Spam honeypot check
				const honey = document.getElementById('contact-honey').value;
				if (honey) {
					console.warn('Bot submission prevented');
					return;
				}

				const name = document.getElementById('contact-name').value.trim();
				const email = document.getElementById('contact-email').value.trim();
				const topic = document.getElementById('contact-topic').value;
				const message = document.getElementById('contact-message').value.trim();

				if (!name || !email || !message) return;

				// UI loading state
				submitBtn.disabled = true;
				btnText.innerText = 'Wird an manage.weddingall@gmail.com gesendet...';
				if (successBox) successBox.style.display = 'none';
				if (errorBox) errorBox.style.display = 'none';

				try {
					const response = await fetch('https://formsubmit.co/ajax/75066fcb859af7eecff2fc720ba6dc94', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'Accept': 'application/json'
						},
						body: JSON.stringify({
							name: name,
							email: email,
							topic: topic,
							message: message,
							_subject: `[Manage.Wedding Kontakt] ${topic} von ${name}`,
							_template: 'table'
						})
					});

					const result = await response.json();

					if (response.ok || result.success === 'true' || result.message) {
						form.reset();
						submitBtn.style.display = 'none';
						if (successBox) {
							successBox.style.display = 'block';
							successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
						}
					} else {
						throw new Error(result.message || 'Submission failed');
					}
				} catch (err) {
					console.error('Direct submission error:', err);
					submitBtn.disabled = false;
					btnText.innerText = 'Nachricht direkt absenden';
					
					const subject = encodeURIComponent(`[Manage.Wedding] ${topic} - von ${name}`);
					const body = encodeURIComponent(`Name: ${name}\nE-Mail: ${email}\nThema: ${topic}\n\nNachricht:\n${message}`);
					if (errorMailto) {
						errorMailto.href = `mailto:manage.weddingall@gmail.com?subject=${subject}&body=${body}`;
					}
					if (errorBox) {
						errorBox.style.display = 'block';
						errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					}
				}
			});
		}
	</script>
</Layout>
