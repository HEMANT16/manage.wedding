---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-date-numerology/#webapp",
      "name": "Hochzeitsdatum-Numerologie & Kompatibilitätsrechner | Manage.Wedding",
      "url": "https://manage.wedding/de/wedding-date-numerology",
      "inLanguage": "de",
      "description": "Kostenloser Hochzeitsdatum-Numerologie-Rechner. Berechnen Sie Lebenspfadzahlen aus Geburtsdaten und Hochzeitsdatum und entdecken Sie die energetische Bedeutung Ihres Hochzeitstags.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Was genau ist Hochzeitsdatum-Numerologie?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die Numerologie des Hochzeitsdatums ist die uralte Methode, die Quersumme aus Tag, Monat und Jahr der Hochzeit zu berechnen, um das energetische Grundthema und die Schwingung der Ehe zu entschlüsseln."
          }
        },
        {
          "@type": "Question",
          "name": "Wie berechnet man die Zahl des Hochzeitsdatums?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Addieren Sie alle einzelnen Ziffern des Datums zusammen und bilden Sie die Quersumme, bis eine einstellige Zahl zwischen 1 und 9 entsteht (oder eine Meisterzahl wie 11, 22). Beispiel: 14.10.2026 = 1+4+1+0+2+0+2+6 = 16 → 1+6 = 7."
          }
        },
        {
          "@type": "Question",
          "name": "Welche Zahl gilt als besonders glücklich für eine Hochzeit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Besonders beliebt für Hochzeiten sind die Zahlen 2 (Partnerschaft & Harmonie) und 6 (Liebe, Familie & Fürsorge). Jede Zahl von 1 bis 9 bringt jedoch ganz eigene, positive Stärken für das gemeinsame Leben mit sich."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Wie berechnet man die Numerologie für Hochzeitstag und Partner?",
      "description": "Schritt-für-Schritt-Anleitung zur Ermittlung der Lebenspfadzahlen und der Schwingung des Hochzeitstermins.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Lebenspfad Partner 1 berechnen",
          "text": "Addieren Sie alle Ziffern des Geburtsdatums von Partner 1 und bilden Sie die einstellige Quersumme."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Lebenspfad Partner 2 berechnen",
          "text": "Addieren Sie alle Ziffern des Geburtsdatums von Partner 2 zur einstelligen Wurzelzahl."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Schwingung des Hochzeitsdatums ermitteln",
          "text": "Berechnen Sie die Quersumme Ihres geplanten Hochzeitsdatums (z. B. 14.10.2026 = 7)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Bedeutung & Kompatibilität interpretieren",
          "text": "Entdecken Sie die archetypischen Stärken Ihrer Verbindung (1 Führung, 2 Harmonie, 4 Beständigkeit, 6 Familie, 8 Wohlstand)."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Hochzeitsdatum-Numerologie | Bedeutung & Kompatibilität berechnen"
	description="Kostenloser Hochzeitsdatum-Numerologie-Rechner. Berechnen Sie Lebenspfadzahlen aus Geburtsdaten und Hochzeitsdatum und entdecken Sie die kosmische Schwingung Ihrer Ehe."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<Breadcrumb title="Hochzeitsdatum-Numerologie" category="stationery-creative" />

		<section class="section-paper fade-in" style="min-height: 100vh; padding: 2rem 1rem;">
			<div style="max-width: 800px; margin: 0 auto;">
				
				<div class="hand-card" style="margin-bottom: 2rem; background: #fff; padding: 2rem;">
					<div class="tape" style="margin: 0 auto 1rem;"></div>
					<h1 class="font-heading" style="text-align: center; color: var(--fg-pencil); font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 0.75rem;">
						Hochzeitsdatum- <span class="accent-italic">Numerologie</span>
					</h1>
					<p class="font-body" style="text-align: center; color: var(--text-secondary); margin-bottom: 2rem; font-size: 1.1rem;">
						Geben Sie Ihre Geburtstage und Ihr Hochzeitsdatum ein, um die kosmische Schwingung und Bedeutung Ihrer Ehe zu enthüllen!
					</p>
					
					<form id="numerology-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
						<div>
							<label for="partner1" class="font-heading" style="display: block; margin-bottom: 0.4rem; color: var(--accent-blue); font-size: 1rem;">Geburtsdatum Partner 1</label>
							<input type="date" id="partner1" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: #fff; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<div>
							<label for="partner2" class="font-heading" style="display: block; margin-bottom: 0.4rem; color: var(--accent-red); font-size: 1rem;">Geburtsdatum Partner 2</label>
							<input type="date" id="partner2" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: #fff; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<div>
							<label for="wedding-date" class="font-heading" style="display: block; margin-bottom: 0.4rem; color: var(--fg-pencil); font-size: 1rem;">Geplantes Hochzeitsdatum</label>
							<input type="date" id="wedding-date" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: #fff; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<button type="submit" class="hand-btn" style="width: 100%; font-size: 1.15rem; margin-top: 0.5rem; padding: 0.85rem;">
							✨ Numerologie & Bedeutung berechnen
						</button>
					</form>
				</div>

				<div id="result-box" class="hand-card" style="margin-bottom: 3rem; background: #fff; padding: 2rem;">
					<h2 class="font-heading" style="color: var(--fg-pencil); margin-bottom: 1rem; font-size: 1.8rem;">Ihre Numerologische Auswertung</h2>
					<div id="initial-message" class="font-body" style="color: var(--text-secondary); font-style: italic;">
						Füllen Sie die obigen Felder aus, um die energetische Bedeutung Ihres Hochzeitstags zu berechnen!
					</div>
					
					<div id="results-content" style="display: none;">
						<div style="margin-bottom: 1.5rem;">
							<h3 class="font-heading" style="color: var(--accent-blue); font-size: 1.25rem;">Lebenspfad Partner 1: Zahl <span id="p1-number"></span></h3>
							<p id="p1-desc" class="font-body" style="color: var(--fg-pencil); margin-top: 0.4rem; line-height: 1.5;"></p>
						</div>
						
						<div style="margin-bottom: 1.5rem;">
							<h3 class="font-heading" style="color: var(--accent-red); font-size: 1.25rem;">Lebenspfad Partner 2: Zahl <span id="p2-number"></span></h3>
							<p id="p2-desc" class="font-body" style="color: var(--fg-pencil); margin-top: 0.4rem; line-height: 1.5;"></p>
						</div>
						
						<div style="margin-bottom: 2rem;">
							<h3 class="font-heading" style="color: var(--fg-pencil); font-size: 1.25rem;">Zahl des Hochzeitsdatums: <span id="wd-number"></span></h3>
							<p id="wd-desc" class="font-body" style="color: var(--fg-pencil); margin-top: 0.4rem; line-height: 1.5;"></p>
						</div>
						
						<div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1.5rem;">
							<h3 class="font-heading" style="text-align: center; color: var(--fg-pencil); font-size: 1.5rem;">Harmonie-Wert: <span id="comp-score"></span>%</h3>
							
							<div style="width: 100%; height: 24px; border: 2px solid var(--fg-pencil); border-radius: 12px; overflow: hidden; margin: 1rem 0; position: relative; background: var(--bg-paper);">
								<div id="gauge-fill" style="width: 0%; height: 100%; background: #16a34a; transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);"></div>
							</div>
							
							<p id="comp-desc" class="font-body" style="text-align: center; font-style: italic; color: var(--fg-pencil);"></p>
						</div>
					</div>
				</div>

				<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
				<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
					<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Auf einen Blick (BLUF)</div>
					<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
						<span>⚡</span> Die Quersummen-Formel für Ihr Hochzeitsdatum
					</h3>
					<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
						<strong>Die 1-Minuten-Formel:</strong> Addieren Sie alle Ziffern des Datums <strong>(Tag + Monat + Jahr)</strong>, bis eine <strong>einstellige Zahl von 1 bis 9</strong> entsteht. Beispiel: <em>14. Oktober 2026</em> ergibt: <code style="background: rgba(255,255,255,0.7); padding: 2px 6px; border-radius: 3px; font-weight: bold;">(1+4) + (1+0) + (2+0+2+6) = 5 + 1 + 10 = 16 → 1 + 6 = 7 (Die Seelensuche)</code>.
					</p>
					
					<!-- Benchmark Numerology Chart Table -->
					<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
							<thead>
								<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
									<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Zahl</th>
									<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Archetyp</th>
									<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Wichtigste Stärken der Ehe</th>
								</tr>
							</thead>
							<tbody>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Zahl 1</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Die Pioniere</td>
									<td style="padding: 0.6rem 0.8rem;">Neuanfänge, Eigenständigkeit, Mut und Tatkraft</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Zahl 2 (Beliebt)</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Die Partner</td>
									<td style="padding: 0.6rem 0.8rem;">Harmonie, emotionale Nähe, Teamgeist und Frieden</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Zahl 3</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Die Kreativen</td>
									<td style="padding: 0.6rem 0.8rem;">Lebensfreude, Lachen, offene Kommunikation & Optimismus</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Zahl 4</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Die Baumeister</td>
									<td style="padding: 0.6rem 0.8rem;">Felsenfestes Fundament, Beständigkeit, Loyalität und Sicherheit</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Zahl 5</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Die Abenteurer</td>
									<td style="padding: 0.6rem 0.8rem;">Reiselust, Spontaneität, Freiheit und aufregende Erlebnisse</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Zahl 6 (Beliebt)</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Die Fürsorger</td>
									<td style="padding: 0.6rem 0.8rem;">Familienliebe, Geborgenheit, Fürsorge und bedingungslose Nähe</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Zahl 7</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Die Seelensuchenden</td>
									<td style="padding: 0.6rem 0.8rem;">Tiefgründigkeit, Seelenverwandtschaft und innere Ruhe</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Zahl 8</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Die Macher</td>
									<td style="padding: 0.6rem 0.8rem;">Große Lebensziele, Wohlstand, Erfolg und ein starkes Vermächtnis</td>
								</tr>
								<tr>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Zahl 9</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Die Herzensmenschen</td>
									<td style="padding: 0.6rem 0.8rem;">Mitgefühl, Großzügigkeit, universelle Liebe und Toleranz</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

				<article class="hand-card" style="margin-bottom: 2rem; background: #fff; padding: 2rem;">
					<h2 class="font-heading" style="color: var(--fg-pencil); font-size: 2rem; margin-bottom: 1.5rem;">Die Bedeutung der Hochzeitsdatum-Numerologie</h2>
					
					<div class="font-body" style="color: var(--fg-pencil); line-height: 1.6; display: flex; flex-direction: column; gap: 1rem; font-size: 1.05rem;">
						<p>Die Wahl des Hochzeitstags ist oft mehr als nur die Suche nach einem passenden Samstag im Sommer. In der <strong>Hochzeitsdatum-Numerologie</strong> spiegelt das Datum das gemeinsame Schicksal und die energetische Grundstimmung Ihrer Ehe wider.</p>
						
						<p>Unser Rechner ermittelt aus den Geburtsdaten der Partner und dem Datum des Ja-Worts die individuellen Lebenspfade und zeigt, wie sich die Schwingungen ergänzen. Ob Ihr Bund auf purem Abenteuergeist (Zahl 5), familiärer Geborgenheit (Zahl 6) oder visionärer Tatkraft (Zahl 8) basiert – die Zahlen bieten eine wunderbare Gelegenheit, gemeinsam innezuhalten und die Werte Ihrer Partnerschaft zu feiern.</p>
					</div>

					<h3 class="font-heading" style="margin-top: 2.5rem; margin-bottom: 1.5rem; font-size: 1.6rem; color: var(--fg-pencil);">Häufig gestellte Fragen (FAQ)</h3>
					
					<div style="display: flex; flex-direction: column; gap: 1rem;">
						<details style="border: 2px solid var(--fg-pencil); padding: 1rem; border-radius: 4px; background: var(--bg-paper);">
							<summary class="font-heading" style="cursor: pointer; font-size: 1.1rem; color: var(--accent-blue);">Können wir unser Datum anpassen, wenn uns die Zahl nicht gefällt?</summary>
							<p class="font-body" style="margin-top: 0.75rem; color: var(--fg-pencil);">Natürlich! Sie können beliebig viele Wunschdaten in unserem Rechner testen, um das Datum zu finden, das sich für Sie beide intuitiv und stimmig anfühlt.</p>
						</details>
					</div>
				</article>

			</div>
		</section>

		<RelatedTools currentPath="/de/wedding-date-numerology" category="stationery" />
	</main>
</Layout>

<script>
	const descriptions: Record<number, string> = {
		1: "Die Pioniere: Eure Energie steht für Mut, Originalität und Führungsstärke. Ihr beschreitet selbstbewusst euren ganz eigenen gemeinsamen Lebensweg.",
		2: "Die Partner: Ein Symbol für Harmonie, Diplomatie, Teamgeist und tiefe emotionale Verbundenheit.",
		3: "Die Lebensfrohen: Humor, Kreativität, ansteckendes Lachen und offene Kommunikation zeichnen eure Partnerschaft aus.",
		4: "Die Baumeister: Ein felsenfestes Fundament, unerschütterliche Loyalität, Verlässlichkeit und Beständigkeit.",
		5: "Die Abenteurer: Neugier auf die Welt, Reiselust, Spontaneität und lebendige Abwechslung.",
		6: "Die Fürsorger: Familiensinn, Herzenswärme, Fürsorge und bedingungslose Liebe stehen im Mittelpunkt.",
		7: "Die Seelensuchenden: Tiefe Seelenverwandtschaft, gegenseitiges Verständnis und innere Ruhe.",
		8: "Die Macher: Ehrgeiz, gemeinsame Meilensteine, Wohlstand und der Aufbau eines großartigen Lebenswerks.",
		9: "Die Herzensmenschen: Mitgefühl, Hilfsbereitschaft, Großzügigkeit und allumfassende Liebe."
	};

	function reduceDate(dateString: string): number {
		if (!dateString) return 0;
		let sum = dateString.replace(/\D/g, '').split('').reduce((acc, digit) => acc + parseInt(digit), 0);
		while (sum > 9) {
			sum = sum.toString().split('').reduce((acc, digit) => acc + parseInt(digit), 0);
		}
		return sum || 1; 
	}

	const form = document.getElementById('numerology-form');
	if (form) {
		form.addEventListener('submit', function(e) {
			e.preventDefault();
			
			const p1Input = document.getElementById('partner1') as HTMLInputElement;
			const p2Input = document.getElementById('partner2') as HTMLInputElement;
			const wdInput = document.getElementById('wedding-date') as HTMLInputElement;
			
			if (!p1Input.value || !p2Input.value || !wdInput.value) return;
			
			const p1Num = reduceDate(p1Input.value);
			const p2Num = reduceDate(p2Input.value);
			const wdNum = reduceDate(wdInput.value);
			
			const initialMsg = document.getElementById('initial-message');
			const resultsContent = document.getElementById('results-content');
			
			if (initialMsg) initialMsg.style.display = 'none';
			if (resultsContent) resultsContent.style.display = 'block';
			
			document.getElementById('p1-number')!.textContent = p1Num.toString();
			document.getElementById('p1-desc')!.textContent = descriptions[p1Num];
			
			document.getElementById('p2-number')!.textContent = p2Num.toString();
			document.getElementById('p2-desc')!.textContent = descriptions[p2Num];
			
			document.getElementById('wd-number')!.textContent = wdNum.toString();
			document.getElementById('wd-desc')!.textContent = descriptions[wdNum];
			
			const seed = (p1Num * 3 + p2Num * 7 + wdNum * 5);
			const score = Math.floor((seed % 26) + 75);
			
			document.getElementById('comp-score')!.textContent = score.toString();
			
			const gaugeFill = document.getElementById('gauge-fill');
			if (gaugeFill) {
				gaugeFill.style.width = '0%';
				setTimeout(() => {
					gaugeFill.style.width = score + '%';
				}, 50);
			}
			
			const compDesc = document.getElementById('comp-desc');
			if (compDesc) {
				if (score >= 95) {
					compDesc.textContent = "Eine herausragende Konstellation! Eure Energien harmonieren auf vollkommene Weise.";
				} else if (score >= 85) {
					compDesc.textContent = "Eine wundervolle Verbindung mit tiefer gegenseitiger Wertschätzung und Harmonie.";
				} else {
					compDesc.textContent = "Ein starkes, stabiles Band aus zwei Persönlichkeiten, die sich wunderbar ergänzen.";
				}
			}
		});
	}
</script>
