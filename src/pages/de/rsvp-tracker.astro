---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/rsvp-tracker/#webapp",
      "name": "Hochzeits-Rückmeldungs-Tracker (RSVP) & Gäste-Manager | Manage.Wedding",
      "url": "https://manage.wedding/de/rsvp-tracker",
      "inLanguage": "de",
      "description": "Kostenloser Online-Rückmeldungs-Tracker für Ihre Hochzeit. Verwalten Sie Zusagen, Absagen, offene Rückmeldungen, Menüwünsche, Begleitpersonen und exportieren Sie Listen nach Word, PDF oder Excel.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie verwaltet man Hochzeits-Rückmeldungen (RSVP) und erinnert säumige Gäste?",
      "description": "Schritt-für-Schritt-Leitfaden zur Erfassung von Rückmeldungsquoten, Menüwünschen und zur Bestätigung der finalen Gästezahl für das Catering.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Rückmeldefrist festlegen & Gästeliste anlegen",
          "text": "Setzen Sie die Rückmeldefrist auf 3 bis 4 Wochen vor dem Hochzeitstermin an und erfassen Sie alle eingeladenen Haushalte."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Zusagen, Absagen & Menüwünsche in Echtzeit erfassen",
          "text": "Tragen Sie eingehende Antworten sofort ein und vermerken Sie Essenswünsche (Fleisch, Fisch, Vegetarisch, Vegan) sowie Allergien (Glutenfrei, Laktosefrei)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Freundliche Erinnerungsnachrichten versenden",
          "text": "Filtern Sie 48 bis 72 Stunden nach Fristablauf nach 'Ausstehend' und senden Sie eine nette Erinnerungs-SMS oder WhatsApp-Nachricht."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Finale Personenzahl sperren & Catering-Export erstellen",
          "text": "Erstellen Sie 14 Tage vor dem Event den finalen Export für den Caterer als Word-Dokument (.doc), druckfertiges PDF oder CSV."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wann sollte die Rückmeldefrist (RSVP) für die Hochzeit liegen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die ideale Rückmeldefrist liegt 3 bis 4 Wochen vor dem Hochzeitstag. So bleibt Ihnen 1 Woche Puffer, um säumigen Gästen nachzutelefonieren, bevor die Location ca. 14 Tage vorher die verbindliche Personenzahl verlangt."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel Prozent der geladenen Gäste sagen im Schnitt ab?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei Gästen aus der Region liegt die Absagequote erfahrungsgemäß bei 10% bis 15%. Bei Weitanreisenden oder reinen Auslandshochzeiten (Destination Weddings) steigen die Absagen auf 25% bis 40%."
          }
        },
        {
          "@type": "Question",
          "name": "Wie formuliert man eine höfliche Erinnerung bei verpasster Frist?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Warten Sie 2 bis 3 Tage nach Fristende und schreiben Sie entspannt: 'Liebe/r [Name], wir finalisieren diese Woche unsere Menüzahlen mit der Location und wollten nachfragen, ob unsere Einladung angekommen ist. Gib uns doch bitte bis [Datum] Bescheid, ob du mit uns feiern kannst!'"
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Hochzeits-Rückmeldungs-Tracker (RSVP) | Gästestatus & Menüwünsche"
	description="Hochzeits-Rückmeldungen mühelos online verwalten. Verfolgen Sie Zusagen, offene Antworten, Absagen und Menüwünsche in Echtzeit mit Word-, PDF- & Excel-Export."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="RSVP & Rückmeldungs-Tracker" category="guests" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Hochzeits- <span class="accent-italic">Rückmeldungs-Tracker (RSVP)</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Echtzeit-Gästeübersicht, Menü-Erfassung und Rückmeldequoten. Exportieren Sie Ihre finale Liste mit einem Klick nach <strong>Word (.doc)</strong>, <strong>PDF</strong> oder <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Overview Stats & Export Dashboard -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						📈 Rückmeldestatus & Quoten-Analyse
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Synchronisiert mit Gästeliste und Sitzplan
					</span>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Word-Export (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ PDF / Drucken
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Excel-Export (.csv)
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Beispieldaten
					</button>
					<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🗑️ Leeren
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Eingeladene Plätze</span>
					<strong id="stat-total" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(<span id="stat-parties">0</span> Einladungen)</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Zusagen (Ja)</span>
					<strong id="stat-attending" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-attending-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% der Plätze</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Ausstehend (Offen)</span>
					<strong id="stat-pending" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span id="stat-pending-pct" style="font-size: 0.75rem; color: #854d0e; display: block;">0% der Plätze</span>
				</div>
				<div style="background: #fef2f2; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #991b1b; display: block;">Absagen (Nein)</span>
					<strong id="stat-declined" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red);">0</strong>
					<span id="stat-declined-pct" style="font-size: 0.75rem; color: #991b1b; display: block;">0% der Plätze</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Rückmeldequote</span>
					<strong id="stat-response-rate" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">0%</strong>
					<span style="font-size: 0.75rem; color: #1e40af; display: block;">Ziel: 95%+</span>
				</div>
			</div>

			<!-- Dynamic Visual Attendance Progress Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Visuelle Rückmelde-Verteilung</span>
					<span id="stat-summary-note" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">Bereit zur Erfassung</span>
				</div>
				<div style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #e5e0d8; margin-bottom: 0.75rem;">
					<div id="bar-attending" style="height: 100%; width: 0%; background-color: #22c55e; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;" title="Zugesagt"></div>
					<div id="bar-pending" style="height: 100%; width: 0%; background-color: #eab308; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;" title="Ausstehend"></div>
					<div id="bar-declined" style="height: 100%; width: 0%; background-color: var(--accent-red); transition: width 0.3s ease;" title="Abgesagt"></div>
				</div>
				<div style="display: flex; justify-content: space-between; font-family: var(--font-body); font-size: 0.85rem;">
					<span style="color: #15803d; font-weight: bold;">🟢 Zugesagt (<span id="legend-attending">0</span>)</span>
					<span style="color: #a16207; font-weight: bold;">🟡 Ausstehend (<span id="legend-pending">0</span>)</span>
					<span style="color: var(--accent-red); font-weight: bold;">🔴 Abgesagt (<span id="legend-declined">0</span>)</span>
				</div>
			</div>
		</div>

		<!-- Workspace Grid: Add / Edit RSVP + Filterable Guest List -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 360px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="rsvp-workspace-grid">
			
			<!-- Left Column: Add / Log RSVP Response -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.25rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>📬</span> Rückmeldung erfassen
				</h2>

				<form id="rsvp-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Guest Full Name -->
					<div>
						<label for="rsvp-name" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Name des Gastes / Haushalts *
						</label>
						<input type="text" id="rsvp-name" required placeholder="z. B. Onkel Robert & Tante Helga" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1.05rem;">
					</div>

					<!-- Group -->
					<div>
						<label for="rsvp-group" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Gruppe / Seite
						</label>
						<select id="rsvp-group" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
							<option value="Brautfamilie">Brautfamilie</option>
							<option value="Bräutigamfamilie">Bräutigamfamilie</option>
							<option value="Brautfreunde">Brautfreunde</option>
							<option value="Bräutigamfreunde">Bräutigamfreunde</option>
							<option value="Gemeinsame Freunde">Gemeinsame Freunde</option>
							<option value="Trauzeugen / VIP">Trauzeugen / VIP</option>
							<option value="Arbeitskollegen">Arbeitskollegen</option>
						</select>
					</div>

					<!-- Party Size & RSVP Selection -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="rsvp-party" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Personenanzahl
							</label>
							<select id="rsvp-party" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="1">1 (Einzelperson)</option>
								<option value="2" selected>2 (Paar / +1)</option>
								<option value="3">3 (Familie mit Kind)</option>
								<option value="4">4 (Familie mit 2 Kindern)</option>
								<option value="5">5+ (Große Gruppe)</option>
							</select>
						</div>
						<div>
							<label for="rsvp-status" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Status Rückmeldung
							</label>
							<select id="rsvp-status" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="Attending">✅ Zugesagt (Ja)</option>
								<option value="Pending">⏳ Ausstehend (Offen)</option>
								<option value="Declined">❌ Abgesagt (Nein)</option>
							</select>
						</div>
					</div>

					<!-- Meal Selection / Dietary -->
					<div>
						<label for="rsvp-dietary" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Menüwahl / Allergien & Unverträglichkeiten
						</label>
						<input type="text" id="rsvp-dietary" placeholder="z. B. 1x Rinderfilet, 1x Vegetarisch, Laktosefrei" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem;">
							<button type="button" class="meal-tag-btn" data-val="Rind / Fleisch" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🥩 Rind</button>
							<button type="button" class="meal-tag-btn" data-val="Geflügel" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🍗 Geflügel</button>
							<button type="button" class="meal-tag-btn" data-val="Fisch" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🐟 Fisch</button>
							<button type="button" class="meal-tag-btn" data-val="Vegetarisch" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🥗 Vegetarisch</button>
							<button type="button" class="meal-tag-btn" data-val="Vegan" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🌱 Vegan</button>
							<button type="button" class="meal-tag-btn" data-val="Glutenfrei" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🌾 Glutenfrei</button>
						</div>
					</div>

					<button type="submit" class="hand-btn" style="width: 100%; padding: 0.85rem; font-size: 1.15rem; margin-top: 0.5rem;">
						✨ Rückmeldung speichern
					</button>

				</form>

				<!-- Follow-Up Message Copy Box -->
				<div style="margin-top: 1.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
					<strong class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
						💬 Vorlage: Freundliche RSVP-Erinnerung
					</strong>
					<p id="copy-template-text" class="font-body" style="font-size: 0.9rem; line-height: 1.4; margin-bottom: 0.5rem; color: var(--fg-pencil);">
						"Hallo! Wir stimmen diese Woche die finalen Gästezahlen und Menüs mit unserem Caterer ab. Gib uns doch bitte kurz bis Freitag Bescheid, ob du dabei sein kannst! Wir freuen uns auf dich! ❤️"
					</p>
					<button type="button" id="btn-copy-template" class="hand-btn secondary" style="padding: 0.25rem 0.6rem; font-size: 0.8rem; width: 100%;">
						📋 Text in die Zwischenablage kopieren
					</button>
				</div>
			</div>

			<!-- Right Column: Searchable, Filterable RSVP Registry Table -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Filter & Search Bar -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
					
					<!-- Search -->
					<div style="flex: 1; min-width: 180px;">
						<input type="text" id="search-input" placeholder="🔍 Gastname oder Menüwunsch suchen..." class="form-input" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem;">
					</div>

					<!-- RSVP Status Filter -->
					<div>
						<select id="filter-status" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Alle Rückmeldungen</option>
							<option value="Attending">✅ Nur Zusagen</option>
							<option value="Pending">⏳ Nur Ausstehend</option>
							<option value="Declined">❌ Nur Absagen</option>
						</select>
					</div>

					<!-- Group Filter -->
					<div>
						<select id="filter-group" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Alle Gruppen</option>
							<option value="Brautfamilie">Brautfamilie</option>
							<option value="Bräutigamfamilie">Bräutigamfamilie</option>
							<option value="Brautfreunde">Brautfreunde</option>
							<option value="Bräutigamfreunde">Bräutigamfreunde</option>
							<option value="Gemeinsame Freunde">Gemeinsame Freunde</option>
							<option value="Trauzeugen / VIP">Trauzeugen / VIP</option>
							<option value="Arbeitskollegen">Arbeitskollegen</option>
						</select>
					</div>
				</div>

				<!-- Table Container -->
				<div id="rsvp-table-wrap" style="overflow-x: auto; max-height: 550px;">
					<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 1rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil); position: sticky; top: 0; z-index: 1;">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Gastname</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Gruppe</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Plätze</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Status</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Menü / Allergien</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Aktionen</th>
							</tr>
						</thead>
						<tbody id="rsvp-table-body">
							<!-- Injected via JS -->
						</tbody>
					</table>
				</div>

				<!-- Empty State Box -->
				<div id="empty-state-box" style="display: none; text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💌</div>
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">Keine Rückmeldungen vorhanden</h3>
					<p class="font-body" style="font-size: 1.05rem; margin-bottom: 1.25rem;">Erfassen Sie Gäste über das linke Formular oder laden Sie Beispieldaten.</p>
					<button type="button" id="btn-empty-sample" class="hand-btn" style="padding: 0.5rem 1.25rem; font-size: 1rem;">
