							<td style="padding: 0.6rem 0.8rem; color: #16a34a; font-weight: 700;">⭐ Ideal: Raum für schöne Geschichten & Ratschläge</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">6 Minuten</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">780 Wörter</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Gemeinsame Rede des Paars</td>
							<td style="padding: 0.6rem 0.8rem; color: #d97706; font-weight: 600;">⚠️ Obergrenze; Unwichtiges kürzen</td>
