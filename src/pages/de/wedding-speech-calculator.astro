						<tr>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red);">7+ Minuten</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; color: var(--accent-red);">900+ Wörter</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Gefahrenzone</td>
							<td style="padding: 0.6rem 0.8rem; color: var(--accent-red); font-weight: 700;">❌ Zu lang: Das Essen wird kalt</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- SEO Article & Comprehensive Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Rede-Leitfaden</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					Der vollständige Ratgeber für gelungene Hochzeitsreden
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					Struktur, Körpersprache und Tipps gegen Lampenfieber.
				</p>
			</div>

			<!-- Section 1: Guide -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. Der klassische Aufbau einer Hochzeitsrede
				</h3>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
