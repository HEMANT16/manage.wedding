<style>
	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 20px;
		}
	}
</style>

<script is:inline>
	const sampleTemplates = {
		bestman: `Liebe Gäste, liebes Brautpaar!

Für diejenigen, die mich noch nicht kennen: Ich bin Alex, der Trauzeuge und seit Studientagen der beste Freund des Bräutigams.

Als ich Maximilian damals kennenlernte, hatte er drei große Lebensziele: erfolgreicher Architekt werden, lernen wie man etwas anderes kocht als Tiefkühlpizza, und eine Frau finden, die klug, wunderschön und geduldig genug ist, seine Fußball-Leidenschaft zu ertragen. Nun, wenn ich die strahlende Braut heute Abend ansehe, würde ich sagen: Volltreffer! [Pause für Lacher]

Aber im Ernst: Wenn man euch beide zusammen sieht, spürt man sofort, wie perfekt ihr euch ergänzt. Sophie, du bringst eine Ruhe und ein Strahlen in Maximilians Leben, das ich vorher noch nie bei ihm gesehen habe.

Bitte erhebt eure Gläser mit mir: Auf ein Leben voller Lachen, wunderbarer Reisen und unendlicher Liebe. Auf Sophie und Maximilian! Prost!`,

		moh: `Hallo ihr Lieben!

Ich bin Sarah, die Trauzeugin und Schwester der Braut. Wenn ich Sophie heute hier stehen sehe, fehlen mir fast die Worte – du siehst einfach umwerfend aus und strahlst von innen heraus.

Als Schwestern haben wir alles geteilt: Kleidung, Geheimnisse und Träume über die Zukunft. Als sie mich nach ihrem zweiten Date mit Maximilian anrief, sagte sie nicht einfach, dass es nett war. Sie sagte: 'Sarah, ich glaube, ich habe gerade meinen Traummann getroffen.' [Pause für Lächeln]

Lieber Maximilian, danke, dass du meine Schwester jeden Tag auf Händen trägst. Sie so glücklich zu sehen, ist das größte Geschenk für unsere ganze Familie.

Lasst uns alle anstoßen: Auf eure Liebe, tiefe Freundschaft und unzählige magische Momente. Auf das Brautpaar!`,

		parent: `Liebe Familie, liebe Freunde!

Im Namen beider Familien möchten wir euch allen von Herzen danken, dass ihr heute hier seid, um diesen unvergesslichen Tag mit uns zu feiern.

Unser Kind aufwachsen zu sehen und heute zu diesem großartigen, warmherzigen Menschen heranreifen zu sehen, ist das größte Glück unseres Lebens. Und unseren neuen Schwiegersohn in die Familie aufzunehmen, fühlt sich an, als hätte sich das letzte Puzzleteil perfekt eingefügt.

Die Ehe ist ein tägliches Versprechen, einander zuzuhören, zu verzeihen und gemeinsam durch alle Jahreszeiten des Lebens zu gehen.

Lasst uns das Glas erheben: Auf die Gesundheit, das Glück und eine wunderbare gemeinsame Zukunft! Prost!`,

		couple: `Liebe Gäste, liebe Freunde und Familie!

Wir möchten nur kurz die Gelegenheit nutzen, um von ganzem Herzen Danke zu sagen. Es ist ein unbeschreibliches Gefühl, all die Menschen, die uns auf unserem Lebensweg begleitet haben, heute in einem Raum versammelt zu sehen.

Ein ganz besonderer Dank gilt unseren Eltern: Danke für eure bedingungslose Liebe, eure Unterstützung und das wunderbare Vorbild, das ihr uns für unsere eigene Ehe seid.

Danke auch an unsere Trauzeugen und Dienstleister, die diesen Tag für uns so unvergesslich gemacht haben.

Und jetzt: Die Gläser sind voll, die Musik läuft – lasst uns die Tanzfläche stürmen und diesen Abend unvergesslich machen! Prost auf euch alle!`
	};

	const speechEditor = document.getElementById('speech-editor');
	const paceSelect = document.getElementById('select-speaking-pace');
	const bufferSelect = document.getElementById('select-pause-buffer');
	const displayWpmRate = document.getElementById('display-wpm-rate');

	const displayTimeResult = document.getElementById('display-time-result');
	const displaySpeechZone = document.getElementById('display-speech-zone');
	const displayWordCount = document.getElementById('display-word-count');
	const displayParagraphCount = document.getElementById('display-paragraph-count');
	const displayCardsCount = document.getElementById('display-cards-count');
	const speechGaugeBar = document.getElementById('speech-gauge-bar');

	function calculateStats() {
		const text = speechEditor.value.trim();
		const wpm = parseInt(paceSelect.value) || 130;
		const bufferSec = parseInt(bufferSelect.value) || 30;

		displayWpmRate.textContent = wpm;

		let words = 0;
		let paragraphs = 0;

		if (text.length > 0) {
			words = text.split(/\s+/).filter(w => w.length > 0).length;
			paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0).length;
		}

		displayWordCount.textContent = words;
		displayParagraphCount.textContent = paragraphs;

		const estimatedCards = Math.max(1, Math.ceil(words / 150));
		displayCardsCount.textContent = `${estimatedCards} Karte${estimatedCards !== 1 ? 'n' : ''}`;

		let totalSeconds = 0;
		if (words > 0) {
			totalSeconds = Math.round((words / wpm) * 60) + bufferSec;
		}

		const mins = Math.floor(totalSeconds / 60);
		const secs = totalSeconds % 60;
		displayTimeResult.textContent = `${mins} Min. ${secs} Sek.`;

		const totalMins = totalSeconds / 60;
		const pct = Math.min(100, Math.max(5, (totalMins / 8) * 100));
		speechGaugeBar.style.width = `${words === 0 ? 0 : pct}%`;

		if (words === 0) {
			displaySpeechZone.textContent = "Text eingeben oder Vorlage laden";
			displaySpeechZone.style.color = "var(--text-secondary)";
			speechGaugeBar.style.backgroundColor = "#ccc";
		} else if (totalMins < 2.5) {
			displaySpeechZone.textContent = "⚡ Eher kurz (Ggf. noch 1 Anekdote ergänzen)";
			displaySpeechZone.style.color = "var(--accent-blue)";
			speechGaugeBar.style.backgroundColor = "var(--accent-blue)";
		} else if (totalMins >= 2.5 && totalMins <= 5.5) {
			displaySpeechZone.textContent = "✅ Perfekte Länge (Ideale Hochzeitsrede)";
			displaySpeechZone.style.color = "#15803d";
			speechGaugeBar.style.backgroundColor = "#16a34a";
		} else if (totalMins > 5.5 && totalMins <= 7.0) {
			displaySpeechZone.textContent = "⚠️ Etwas lang (Kleine Details kürzen)";
			displaySpeechZone.style.color = "#ca8a04";
			speechGaugeBar.style.backgroundColor = "#eab308";
		} else {
			displaySpeechZone.textContent = "🛑 Zu lang (Um 30% kürzen, damit das Essen nicht kalt wird)";
			displaySpeechZone.style.color = "var(--accent-red)";
			speechGaugeBar.style.backgroundColor = "var(--accent-red)";
		}
	}

	// Preset Loaders
	document.querySelectorAll('.btn-load-template').forEach(btn => {
		btn.addEventListener('click', () => {
			const type = btn.getAttribute('data-type');
			if (sampleTemplates[type]) {
				speechEditor.value = sampleTemplates[type];
				calculateStats();
			}
		});
	});

	// Clear Button
	document.getElementById('btn-clear-speech').addEventListener('click', () => {
		speechEditor.value = '';
		calculateStats();
	});

	speechEditor.addEventListener('input', calculateStats);
	paceSelect.addEventListener('change', calculateStats);
	bufferSelect.addEventListener('change', calculateStats);

	// Live Stopwatch Logic
	let timerInterval = null;
	let startTime = 0;
	let elapsedTime = 0;
	let isRunning = false;

	const stopwatchDisplay = document.getElementById('stopwatch-display');
	const btnTimerStart = document.getElementById('btn-timer-start');
	const btnTimerPause = document.getElementById('btn-timer-pause');
	const btnTimerReset = document.getElementById('btn-timer-reset');

	function formatStopwatch(ms) {
		const totalSec = Math.floor(ms / 1000);
		const m = Math.floor(totalSec / 60).toString().padStart(2, '0');
		const s = (totalSec % 60).toString().padStart(2, '0');
		const tenth = Math.floor((ms % 1000) / 100);
		return `${m}:${s}.${tenth}`;
	}

	btnTimerStart.addEventListener('click', () => {
		if (!isRunning) {
			isRunning = true;
			startTime = Date.now() - elapsedTime;
			timerInterval = setInterval(() => {
				elapsedTime = Date.now() - startTime;
				stopwatchDisplay.textContent = formatStopwatch(elapsedTime);
			}, 100);
			btnTimerStart.style.display = 'none';
			btnTimerPause.style.display = 'inline-block';
		}
	});

	btnTimerPause.addEventListener('click', () => {
		if (isRunning) {
			isRunning = false;
			clearInterval(timerInterval);
			btnTimerStart.style.display = 'inline-block';
			btnTimerStart.textContent = '▶️ Fortsetzen';
			btnTimerPause.style.display = 'none';
		}
	});

	btnTimerReset.addEventListener('click', () => {
		isRunning = false;
		clearInterval(timerInterval);
		elapsedTime = 0;
		stopwatchDisplay.textContent = '00:00.0';
		btnTimerStart.style.display = 'inline-block';
		btnTimerStart.textContent = '▶️ Übung starten';
		btnTimerPause.style.display = 'none';
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const text = speechEditor.value.trim() || 'Kein Redetext eingegeben.';
		const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);

		let pTags = '';
		paragraphs.forEach((p, idx) => {
			pTags += `<p style="font-size:16pt; line-height:1.7; margin-bottom:18pt; color:#111;"><strong>[${idx + 1}]</strong> ${p}</p>`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Hochzeitsrede Spickzettel</title>
				<style>
					body { font-family: 'Segoe UI', Calibri, Arial, sans-serif; padding: 30px; font-size: 16pt; }
					h1 { color: #1e3a8a; font-size: 22pt; margin-bottom: 5pt; }
					.meta-box { border: 1pt solid #ccc; background: #f8fafc; padding: 10pt; font-size: 11pt; margin-bottom: 25pt; color: #475569; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Moderationskarten Hochzeitsrede</h1>
				<div class="meta-box">
					<strong>Geschätzte Dauer:</strong> ${displayTimeResult.textContent} | 
					<strong>Wortanzahl:</strong> ${displayWordCount.textContent} Wörter | 
					<strong>Sprechtempo:</strong> ${displayWpmRate.textContent} WPM
				</div>
				${pTags}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeitsrede_Spickzettel_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print Cards
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-est-time').textContent = displayTimeResult.textContent;
		document.getElementById('print-word-count').textContent = `${displayWordCount.textContent} Wörter`;

		const grid = document.getElementById('print-cue-cards-grid');
		grid.innerHTML = '';

		const text = speechEditor.value.trim() || 'Kein Redetext eingegeben.';
		const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);

		for (let i = 0; i < paragraphs.length; i += 2) {
			const cardNum = Math.floor(i / 2) + 1;
			const totalCards = Math.ceil(paragraphs.length / 2);

			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 25px; page-break-inside: avoid; font-family: 'Segoe UI', Arial, sans-serif; background: #fff; margin-bottom: 20px;`;
			
			let inner = `<div style="display:flex; justify-content:space-between; border-bottom:1px solid #000; padding-bottom:5px; margin-bottom:15px; font-size:12px; font-weight:bold;"><span>KARTE ${cardNum} VON ${totalCards}</span><span>GESCHÄTZTE ZEIT: ${displayTimeResult.textContent}</span></div>`;
			
			inner += `<p style="font-size:16px; line-height:1.6; margin-bottom:12px;"><strong>[${i + 1}]</strong> ${paragraphs[i]}</p>`;
			if (paragraphs[i + 1]) {
				inner += `<p style="font-size:16px; line-height:1.6; margin-bottom:0;"><strong>[${i + 2}]</strong> ${paragraphs[i + 1]}</p>`;
			}

			card.innerHTML = inner;
			grid.appendChild(card);
		}

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Kennzahl,Wert\n";
		csv += `"Geschätzte Sprechzeit","${displayTimeResult.textContent}"\n`;
		csv += `"Wortanzahl","${displayWordCount.textContent}"\n`;
		csv += `"Absatzanzahl","${displayParagraphCount.textContent}"\n`;
		csv += `"Sprechtempo","${displayWpmRate.textContent} WPM"\n`;
		csv += `"Bewertung","${displaySpeechZone.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeitsrede_Timing.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Load Best Man template by default
	speechEditor.value = sampleTemplates.bestman;
	calculateStats();
</script>
