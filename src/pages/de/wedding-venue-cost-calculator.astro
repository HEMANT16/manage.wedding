---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-venue-cost-calculator/#webapp",
      "name": "Location-Kostenrechner für die Hochzeit",
      "url": "https://manage.wedding/de/wedding-venue-cost-calculator",
      "description": "Berechnen Sie die echten Gesamtkosten Ihrer Hochzeitslocation inklusive Raummiete, Mindestumsatz, Servicepauschalen, MwSt., Nachtzuschlägen, Reinigung, Korkgeld und externer Infrastruktur.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "de",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie man die tatsächlichen Gesamtkosten einer Hochzeitslocation berechnet",
      "description": "Schritt-für-Schritt-Anleitung zur vollständigen Kostenprüfung von Location-Verträgen über den reinen Mietpreis hinaus.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Grundmiete und Traugebühr ansetzen",
          "text": "Tragen Sie die ausgewiesene Raummiete für Saal und eventuelle Gebühren für die freie Trauung vor Ort ein."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Mindestumsatz für Catering & Getränke prüfen",
          "text": "Prüfen Sie, ob die Location einen Mindestverzehr vorschreibt oder ob ein Pro-Kopf-Pauschalsatz gilt."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Servicepauschalen & Nachtzuschläge einberechnen",
          "text": "Kalkulieren Sie Servicekosten und die stündlichen Nachtzuschläge des Personals ab Mitternacht ein."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Nebenkosten, Reinigung & Zusatzgebühren erfassen",
          "text": "Berücksichtigen Sie Endreinigung, Tellergeld für die Torte (2–4 €/Stück), Korkgeld für mitgebrachte Weine und Kautionen."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Welche versteckten Kosten fallen bei einer Hochzeitslocation an?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Häufige Zusatzkosten sind: Nachtzuschläge für Servicepersonal ab 0:00 Uhr (150–350 €/Std.), Korkgeld für eigene Weine (10–25 €/Flasche), Tellergeld für die Hochzeitstorte (2–4 €/Gast), Gebühren für die Trauzeremonie im Schlossgarten, Endreinigungspauschalen und Technik-Mieten."
          }
        },
        {
          "@type": "Question",
          "name": "Ist eine Scheunenhochzeit mit Selbstversorgung günstiger als ein All-Inclusive-Hotel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nicht zwingend. Zwar locken Scheunen oft mit moderaten Mietpreisen (z. B. 4.000–6.000 €), jedoch müssen Brautpaare Tische, Stühle, Toilettenwagen (ab 1.200 €), Stromaggregate, Kühlwagen, Personal und Küchenequipment für externe Caterer separat anmieten."
          }
        },
        {
          "@type": "Question",
          "name": "Was bedeutet ein Mindestumsatz (F&B Minimum) im Locationvertrag?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Mindestumsatz ist der garantierte Betrag, den Sie für Speisen und Getränke ausgeben müssen. Wird dieser Betrag durch Ihre Gästeanzahl nicht erreicht, stellt die Location die Differenz als Raummiete oder Ausfallgebühr in Rechnung."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Location-Kostenrechner Hochzeit (Versteckte Kosten & Echter Preis) | Manage.Wedding"
	description="Berechnen Sie die echten Gesamtkosten Ihrer Hochzeitslocation: Raummiete, Mindestumsatz, Servicepauschalen, Nachtzuschläge, Korkgeld, Reinigung & Nebenkosten."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Location-Kostenrechner" category="budget" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Versteckte Kosten von 3.000 € – 10.000 € aufdecken</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Hochzeitslocation <span class="accent-italic">Echte Gesamtkosten Rechner</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Ein reines Mietangebot von 5.000 € summiert sich mit Mindestverzehr, Nachtzuschlägen, Reinigung, Korkgeld und Nebenkosten schnell auf über 20.000 €. Berechnen Sie Ihre echten Gesamtkosten vor der Vertragsunterschrift!
			</p>
		</header>

		<!-- Main Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Controls & Line-Item Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Vertragsdaten & Posten
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Gesamtkosten-Prüfer
					</span>
				</div>

				<!-- Venue Archetype Presets -->
				<div class="form-group">
					<label class="form-label" for="venue-preset">Location-Typ & Vertragsvorlage</label>
					<select id="venue-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="hotel" selected>🏨 Hotel / Bankettsaal All-Inclusive (3.500 € Miete + 11.000 € Bewirtung)</option>
						<option value="barn">🌾 Rustikale Scheune / Hofgut (5.500 € Miete + Toilettenwagen + Catering)</option>
						<option value="estate">🏰 Schloss / Historisches Gutshaus (7.500 € Miete + 1.200 € Trauung)</option>
						<option value="winery">🍇 Weingut / Kelterei (4.500 € Miete + Mindestabnahme Wein + Shuttle)</option>
						<option value="custom">✏️ Eigene Vertragsdaten eingeben</option>
					</select>
				</div>

				<!-- Base Rental Fee & Ceremony Fee -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="base-rental">Grundmiete Location (€)</label>
						<input type="number" id="base-rental" class="form-input" value="3500" min="0" step="250" />
					</div>
					<div>
						<label class="form-label" for="ceremony-fee">Trauung vor Ort (€)</label>
						<input type="number" id="ceremony-fee" class="form-input" value="800" min="0" step="100" />
					</div>
				</div>

				<!-- Guest Count & F&B Minimum -->
				<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="guest-count">Gästeanzahl</label>
						<input type="number" id="guest-count" class="form-input" value="80" min="10" max="600" />
					</div>
					<div>
						<label class="form-label" for="fb-spend">Essen & Getränke (€)</label>
						<input type="number" id="fb-spend" class="form-input" value="11200" min="0" step="500" />
					</div>
				</div>

				<!-- Service Rates & Overtime -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="service-charge-rate">Servicezuschlag / Pauschale (%)</label>
						<input type="number" id="service-charge-rate" class="form-input" value="10" min="0" max="30" step="1" />
					</div>
					<div>
						<label class="form-label" for="tax-rate">MwSt.-Satz (%)</label>
						<input type="number" id="tax-rate" class="form-input" value="19" min="0" max="25" step="1" />
					</div>
				</div>

				<!-- Hidden Facility Surcharges -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Zusatzgebühren & Betriebskosten (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="cleaning-fee" style="font-size: 0.9rem;">Endreinigung / Müll</label>
							<input type="number" id="cleaning-fee" class="form-input" value="450" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="security-fee" style="font-size: 0.9rem;">Sicherheit / Parkdienst</label>
							<input type="number" id="security-fee" class="form-input" value="300" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="insurance-fee" style="font-size: 0.9rem;">Veranstalterhaftpflicht</label>
							<input type="number" id="insurance-fee" class="form-input" value="150" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="overtime-fee" style="font-size: 0.9rem;">Nachtzuschlag ab 0:00 Uhr</label>
							<input type="number" id="overtime-fee" class="form-input" value="600" min="0" step="100" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Vendor Friction Add-ons (Cake Cutting / Corkage / Infrastructure) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Tellergeld, Korkgeld & Infrastruktur (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="cake-cutting-rate" style="font-size: 0.9rem;">Tellergeld Torte (€/Gast)</label>
							<input type="number" id="cake-cutting-rate" class="form-input" value="2.50" min="0" step="0.50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="infrastructure-fee" style="font-size: 0.9rem;">Toiletten / Strom / Shuttle</label>
							<input type="number" id="infrastructure-fee" class="form-input" value="0" min="0" step="250" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Real Total & Price Shock Breakdown -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- True Cost Summary Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Echter Gesamtpreis Location
						</span>
						<span id="markup-multiplier-tag" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							5.2× Grundmiete
						</span>
					</div>

					<div id="display-real-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.5rem;">
						18.420 €
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Ausgewiesene Grundmiete war <strong id="display-quoted-base" style="color: var(--fg-pencil);">3.500 €</strong>. Tatsächliche Kosten pro Gast: <strong id="display-per-guest" style="color: var(--fg-pencil);">230 € / Person</strong>.
					</p>

					<!-- Itemized Cost Breakdown Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Grundmiete + Traubereich:</span>
							<strong id="item-base-total">4.300 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Speisen & Getränke (Bewirtung):</span>
							<strong id="item-fb-spend">11.200 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem; color: var(--accent-red);">
							<span>Servicepauschale & Zuschläge:</span>
							<strong id="item-service-charge">1.120 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem; color: var(--accent-blue);">
							<span>Mehrwertsteueranteil:</span>
							<strong id="item-sales-tax">2.340 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Nebenkosten (Reinigung, Security, Nacht):</span>
							<strong id="item-facility-total">1.500 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.95rem;">
							<span>Tellergeld / Nebenausgaben:</span>
							<strong id="item-addons-total">200 €</strong>
						</div>
					</div>

					<!-- Export Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-audit" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> PDF-Kostenübersicht
						</button>
						<button id="btn-export-word" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Word-Export (.doc)
						</button>
					</div>

				</div>

				<!-- Contract Warning Callout Box -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						🚨 3 wichtige Vertragsklauseln vor der Unterschrift:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Nachtzuschläge ab Mitternacht:</strong> Klären Sie verbindlich ab, ob Servicekräfte und Raummiete ab 0:00 Uhr mit 200–350 € pro Stunde extra berechnet werden.</li>
						<li><strong>Lärmschutz & Sperrstunde:</strong> Prüfen Sie, ob ab 22:00 Uhr Fenster und Türen geschlossen bleiben müssen oder eine Dezibel-Obergrenze gilt.</li>
						<li><strong>Korkgeld & Caterer-Bindung:</strong> Einige Locations verlangen bei externen Caterern oder Weinen Ausfallgebühren von 1.000 € bis 2.500 €.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Auf einen Blick</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Faustformel & Vergleich typischer Location-Kosten
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					So setzen sich die tatsächlichen Gesamtkosten bei verschiedenen Location-Typen zusammen.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					💰 Die Location-Gesamtkosten-Formel:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Echter Gesamtpreis = Grundmiete + Trauort + Bewirtung (Speisen & Getränke) + Nachtzuschläge + Reinigung + Teller-/Korkgeld + Externe Mieten • Typischer Faktor: 3,5× bis 5,5× der Grundmiete!
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Location-Typ</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Grundmiete (Angebot)</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Typische Zusatzposten</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Echter Gesamtpreis</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Hotel / Bankettsaal All-Inclusive</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">2.500 € – 4.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mindestverzehr, Servicepauschale, Zimmerkontingente, Parkgebühren</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">16.000 € – 25.000 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Rustikale Scheune / Hofgut (Selbstversorger)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">4.000 € – 7.000 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Toilettenwagen (1.200 €), Strom, Endreinigung, externes Catering</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">18.000 € – 28.000 €</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Historisches Schloss / Gutshaus</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">6.000 € – 12.000 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Traugebühr Garten (1.500 €), Security, Exklusiv-Caterer-Aufpreis</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">25.000 € – 45.000 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Weingut / Kelterei</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">4.000 € – 8.000 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Hauseigene Weinabnahme-Pflicht, Shuttlebusse, Lärmschutzauflagen</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">20.000 € – 32.000 €</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Location-Verträge prüfen und Kostenfallen vermeiden
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Location und Bewirtung machen rund die Hälfte Ihres gesamten Hochzeitsbudgets aus. Nutzen Sie diesen Ratgeber für erfolgreiche Vertragsverhandlungen.
				</p>
			</div>

			<!-- Section 1: Questions to Ask -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					10 wichtige Fragen vor der Unterschrift des Mietvertrags
				</h3>
				<ol class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li>Gibt es einen verbindlichen Mindestumsatz für Essen und Getränke?</li>
					<li>Ab welcher Uhrzeit fallen Nachtzuschläge für das Servicepersonal an (und wie hoch ist der Stundensatz)?</li>
					<li>Sind Tische, Stühle, Tischdecken, Servietten und Gläser im Mietpreis enthalten?</li>
					<li>Wie viele Stunden vor Beginn dürfen Dienstleister (Florist, DJ) zum Aufbau in den Raum?</li>
					<li>Gibt es eine feste Bindung an bestimmte Caterer, oder kann ein eigener Caterer mitgebracht werden?</li>
					<li>Wie hoch sind Tellergeld (Hochzeitstorte) und Korkgeld (eigene Weine/Spirituosen)?</li>
					<li>Ist eine Veranstalterhaftpflichtversicherung der Brautleute vorgeschrieben?</li>
					<li>Welche Lärmschutzauflagen und Sperrstundenregelungen gelten für den Außenbereich?</li>
					<li>Wer übernimmt die Endreinigung und Entsorgung des Altglases?</li>
					<li>Wie lauten die Stornierungs- und Umbuchungsbedingungen bei der Anzahlung?</li>
				</ol>
			</section>

		</article>

		<RelatedTools currentPath="/de/wedding-venue-cost-calculator" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('venue-preset');
		const baseRentalInput = document.getElementById('base-rental');
		const ceremonyFeeInput = document.getElementById('ceremony-fee');
		const guestCountInput = document.getElementById('guest-count');
		const fbSpendInput = document.getElementById('fb-spend');
		const serviceRateInput = document.getElementById('service-charge-rate');
		const taxRateInput = document.getElementById('tax-rate');
		const cleaningFeeInput = document.getElementById('cleaning-fee');
		const securityFeeInput = document.getElementById('security-fee');
		const insuranceFeeInput = document.getElementById('insurance-fee');
		const overtimeFeeInput = document.getElementById('overtime-fee');
		const cakeRateInput = document.getElementById('cake-cutting-rate');
		const infraFeeInput = document.getElementById('infrastructure-fee');

		const displayRealTotal = document.getElementById('display-real-total');
		const displayQuotedBase = document.getElementById('display-quoted-base');
		const displayPerGuest = document.getElementById('display-per-guest');
		const markupTag = document.getElementById('markup-multiplier-tag');

		const itemBaseTotal = document.getElementById('item-base-total');
		const itemFbSpend = document.getElementById('item-fb-spend');
		const itemServiceCharge = document.getElementById('item-service-charge');
		const itemSalesTax = document.getElementById('item-sales-tax');
		const itemFacilityTotal = document.getElementById('item-facility-total');
		const itemAddonsTotal = document.getElementById('item-addons-total');

		const btnPrint = document.getElementById('btn-print-audit');
		const btnWord = document.getElementById('btn-export-word');

		function calculateVenueCost() {
			const base = parseFloat(baseRentalInput.value) || 0;
			const ceremony = parseFloat(ceremonyFeeInput.value) || 0;
			const guests = parseInt(guestCountInput.value, 10) || 1;
			const fb = parseFloat(fbSpendInput.value) || 0;
			const serviceRate = (parseFloat(serviceRateInput.value) || 0) / 100;
			const taxRate = (parseFloat(taxRateInput.value) || 0) / 100;
			const cleaning = parseFloat(cleaningFeeInput.value) || 0;
			const security = parseFloat(securityFeeInput.value) || 0;
			const insurance = parseFloat(insuranceFeeInput.value) || 0;
			const overtime = parseFloat(overtimeFeeInput.value) || 0;
			const cakeRate = parseFloat(cakeRateInput.value) || 0;
			const infra = parseFloat(infraFeeInput.value) || 0;

			// Service & Tax
			const serviceCharge = fb * serviceRate;
			const subtotalBeforeTax = fb + serviceCharge;
			const salesTax = subtotalBeforeTax * taxRate;

			// Addons & Facilities
			const facilityTotal = cleaning + security + insurance + overtime;
			const cakeTotal = cakeRate * guests;
			const addonsTotal = cakeTotal + infra;

			const grandTotal = base + ceremony + fb + serviceCharge + salesTax + facilityTotal + addonsTotal;
			const perGuest = grandTotal / guests;
			const multiplier = base > 0 ? (grandTotal / base).toFixed(1) : 1;

			// Update Displays
			displayRealTotal.textContent = `${Math.round(grandTotal).toLocaleString('de-DE')} €`;
			displayQuotedBase.textContent = `${Math.round(base).toLocaleString('de-DE')} €`;
			displayPerGuest.textContent = `${Math.round(perGuest).toLocaleString('de-DE')} € / Person`;
			markupTag.textContent = `${multiplier}× Grundmiete`;

			itemBaseTotal.textContent = `${Math.round(base + ceremony).toLocaleString('de-DE')} €`;
			itemFbSpend.textContent = `${Math.round(fb).toLocaleString('de-DE')} €`;
			itemServiceCharge.textContent = `${Math.round(serviceCharge).toLocaleString('de-DE')} €`;
			itemSalesTax.textContent = `${Math.round(salesTax).toLocaleString('de-DE')} €`;
			itemFacilityTotal.textContent = `${Math.round(facilityTotal).toLocaleString('de-DE')} €`;
			itemAddonsTotal.textContent = `${Math.round(addonsTotal).toLocaleString('de-DE')} €`;
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'hotel') {
				baseRentalInput.value = 3500;
				ceremonyFeeInput.value = 800;
				guestCountInput.value = 80;
				fbSpendInput.value = 11200;
				serviceRateInput.value = 10;
				taxRateInput.value = 19;
				cleaningFeeInput.value = 450;
				securityFeeInput.value = 300;
				insuranceFeeInput.value = 150;
				overtimeFeeInput.value = 600;
				cakeRateInput.value = 2.50;
				infraFeeInput.value = 0;
			} else if (p === 'barn') {
				baseRentalInput.value = 5500;
				ceremonyFeeInput.value = 600;
				guestCountInput.value = 80;
				fbSpendInput.value = 9600;
				serviceRateInput.value = 0;
				taxRateInput.value = 19;
				cleaningFeeInput.value = 500;
				securityFeeInput.value = 350;
				insuranceFeeInput.value = 180;
				overtimeFeeInput.value = 750;
				cakeRateInput.value = 0;
				infraFeeInput.value = 2200; // Toilettenwagen + Strom
			} else if (p === 'estate') {
				baseRentalInput.value = 7500;
				ceremonyFeeInput.value = 1200;
				guestCountInput.value = 80;
				fbSpendInput.value = 12800;
				serviceRateInput.value = 12;
				taxRateInput.value = 19;
				cleaningFeeInput.value = 650;
				securityFeeInput.value = 450;
				insuranceFeeInput.value = 200;
				overtimeFeeInput.value = 900;
				cakeRateInput.value = 3.50;
				infraFeeInput.value = 400;
			} else if (p === 'winery') {
				baseRentalInput.value = 4500;
				ceremonyFeeInput.value = 700;
				guestCountInput.value = 80;
				fbSpendInput.value = 10400;
				serviceRateInput.value = 10;
				taxRateInput.value = 19;
				cleaningFeeInput.value = 400;
				securityFeeInput.value = 300;
				insuranceFeeInput.value = 150;
				overtimeFeeInput.value = 650;
				cakeRateInput.value = 2.00;
				infraFeeInput.value = 900; // Shuttlebus
			}
			calculateVenueCost();
		});

		// Live Listeners
		[baseRentalInput, ceremonyFeeInput, guestCountInput, fbSpendInput, serviceRateInput, taxRateInput, cleaningFeeInput, securityFeeInput, insuranceFeeInput, overtimeFeeInput, cakeRateInput, infraFeeInput].forEach(inp => {
			inp.addEventListener('input', calculateVenueCost);
		});

		// Print PDF Audit Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Location-Kostenübersicht — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 13pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Location-Kostenübersicht & Gesamtkosten-Prüfung</h1>
					<p>Berechnet für ${guestCountInput.value} Gäste | Datum: ${new Date().toLocaleDateString('de-DE')}</p>
					
					<table>
						<thead>
							<tr><th>Kategorie</th><th>Details</th><th>Betrag (€)</th></tr>
						</thead>
						<tbody>
							<tr><td>Grundmiete & Trauort</td><td>Miete (${baseRentalInput.value} €) + Trauung (${ceremonyFeeInput.value} €)</td><td>${itemBaseTotal.textContent}</td></tr>
							<tr><td>Bewirtung (Essen & Bar)</td><td>Speisen & Getränke-Pauschale</td><td>${itemFbSpend.textContent}</td></tr>
							<tr><td>Servicepauschale</td><td>${serviceRateInput.value}% Servicezuschlag</td><td>${itemServiceCharge.textContent}</td></tr>
							<tr><td>Mehrwertsteuer</td><td>${taxRateInput.value}% MwSt.</td><td>${itemSalesTax.textContent}</td></tr>
							<tr><td>Nebenkosten Location</td><td>Reinigung (${cleaningFeeInput.value} €) + Security (${securityFeeInput.value} €) + Versicherung (${insuranceFeeInput.value} €) + Nacht (${overtimeFeeInput.value} €)</td><td>${itemFacilityTotal.textContent}</td></tr>
							<tr><td>Tellergeld & Infrastruktur</td><td>Tellergeld Torte + Toiletten/Strom/Shuttle</td><td>${itemAddonsTotal.textContent}</td></tr>
							<tr class="total-row"><td>ECHTER GESAMTPREIS</td><td>Gesamtausgaben (${markupTag.textContent})</td><td>${displayRealTotal.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnWord.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Location Kostenprüfung</title>
				<style>body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Location Gesamtkostenprüfung</h2>
					<p>Grundmiete: ${baseRentalInput.value} € | <strong>Echter Gesamtpreis: ${displayRealTotal.textContent}</strong> (${displayPerGuest.textContent})</p>
					<table>
						<thead><tr><th>Posten</th><th>Betrag (€)</th></tr></thead>
						<tbody>
							<tr><td>Grundmiete & Trauort</td><td>${itemBaseTotal.textContent}</td></tr>
							<tr><td>Speisen & Getränke</td><td>${itemFbSpend.textContent}</td></tr>
							<tr><td>Servicepauschale (${serviceRateInput.value}%)</td><td>${itemServiceCharge.textContent}</td></tr>
							<tr><td>MwSt. (${taxRateInput.value}%)</td><td>${itemSalesTax.textContent}</td></tr>
							<tr><td>Nebenkosten (Reinigung, Security, Nacht)</td><td>${itemFacilityTotal.textContent}</td></tr>
							<tr><td>Tellergeld & Infrastruktur</td><td>${itemAddonsTotal.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>GESAMT</td><td>${displayRealTotal.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'Location_Gesamtkosten_Pruefung.doc';
			link.click();
		});

		// Initial Calculation
		calculateVenueCost();
	</script>
</Layout>
