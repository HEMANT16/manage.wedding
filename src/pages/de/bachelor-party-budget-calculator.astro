							</tr>
							<tr>
								<td><strong>5. Anreise & Transport</strong> (Mietbus, Sprit, Taxis)</td>
								<td>${subTransport.textContent}</td>
								<td>${itemTransportShare.textContent}</td>
							</tr>
							<tr>
								<td><strong>6. JGA-Shirts & Kater-Kits</strong> (Gruppen-Shirts, Bräutigam-Kostüm)</td>
								<td>${subSwag.textContent}</td>
								<td>${itemSwagShare.textContent}</td>
							</tr>
							<tr class="total-row">
								<td>GESAMTBEITRAG PRO MANN</td>
								<td>${displayGrandTotal.textContent}</td>
								<td>${displayPerPerson.textContent}</td>
							</tr>
						</tbody>
					</table>

					<h2>Zahlungsplan (PayPal Freunde / Überweisung)</h2>
					<p>• <strong>Rate 1 - Anzahlung (Frist ${paymentDeadlineInput.value || 'Sofort'}):</strong> ${schedDep1.textContent} pro Mann (feste Buchung von Unterkunft & Boot)</p>
