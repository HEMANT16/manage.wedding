---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/bachelor-party-budget-calculator/#webapp",
      "name": "JGA Budget Rechner & Kostenverteiler (Junggesellenabschied Männer)",
      "url": "https://manage.wedding/de/bachelor-party-budget-calculator",
      "inLanguage": "de",
      "description": "Kostenloser JGA Budget Rechner für Männer. Berechnen Sie die exakten Kosten pro Person für Ferienhaus, Aktivitäten, Brauhaustour, Verpflegung und Club – inklusive Freihalten des Bräutigams. Export für PayPal Freunde, Word und PDF.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie man das JGA-Budget für Männer fair plant und aufteilt",
      "description": "Schritt-für-Schritt-Anleitung für Trauzeugen: JGA-Kosten kalkulieren, Geld von den Jungs einsammeln und den Bräutigam komplett einladen.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Teilnehmerzahl fixieren & Bräutigam freihalten",
          "text": "Bestimmen Sie die verbindlichen Zusagen und wenden Sie die N-1 Formel an: Die Kosten des Bräutigams für Unterkunft, Essen und Aktivitäten werden gleichmäßig auf alle Jungs umgelegt."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Feste Gruppenkosten buchen",
          "text": "Kalkulieren Sie unverhandelbare Fixkosten: Ferienhaus, Airbnb-Kaution, Endreinigung sowie 9-Sitzer Mietbus, Maut und Sprit."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Aktivitäten und Abendprogramm planen",
          "text": "Tragen Sie Schätzwerte für Kartfahren, Brauereitour, Bootsmiete, Steakhouse-Abendessen und Club-VIP-Tische ein."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Anzahlung via PayPal Freunde einsammeln",
          "text": "Senden Sie eine transparente Übersicht via WhatsApp: Sammeln Sie 50% Anzahlung 3 bis 6 Monate im Voraus ein, den Rest 2 Wochen vor der Reise."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Zahlt der Bräutigam etwas für seinen JGA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Nach moderner JGA-Etikette wird der Bräutigam von der Gruppe zu 100% freigehalten: Die mitreisenden Freunde teilen sich alle Kosten für Ferienhaus, Essen, Aktivitäten und Getränke gleichmäßig auf (N-1 Regel). Der Bräutigam zahlt höchstens sein eigenes Anreise-Zugticket oder seinen Flug."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel kostet ein JGA für Männer im Durchschnitt pro Person?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Wochenend-JGA mit Städtetrip (z. B. Mallorca, Prag, Hamburg, Amsterdam) kostet im Schnitt 220€ bis 450€ pro Person inklusive Unterkunft, Verpflegung, Programm, Feiern und Bräutigam-Umlage. Ein gemütliches Hüttenwochenende im Harz oder Schwarzwald liegt bei ca. 130€ bis 200€ pro Mann."
          }
        },
        {
          "@type": "Question",
          "name": "Wann sollte der Trauzeuge das Geld für den JGA einsammeln?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sammeln Sie Rate 1 (50% Anzahlung für Unterkunft und feste Exkursionen) 3 bis 6 Monate vorab ein. Rate 2 (die restlichen 50% für Einkäufe, Grillen und Abendkasse) sollte 2 bis 3 Wochen vor Reisebeginn überwiesen sein. Legen Sie niemals tausende Euro privat aus, ohne Anzahlungen erhalten zu haben."
          }
        },
        {
          "@type": "Question",
          "name": "Was tun, wenn ein Freund ein sehr knappes Budget hat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Führen Sie vor der Reiseplanung eine anonyme Umfrage durch. Wenn jemand nicht das gesamte Wochenende mitfahren kann, bieten Sie ihm an, nur zum Samstagabend-Essen dazuzustoßen oder einen freiwilligen Betrag (z. B. 20-30€) für die Bräutigam-Bierrunde beizusteuern."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="JGA Budget Rechner & Kostenverteiler (Bräutigam Freihalten) | Manage.Wedding"
	description="Kostenloser JGA-Kostenrechner für Männer. Berechnen Sie die exakten Kosten pro Person für Ferienhaus, Aktivitäten, Brauhaustour, Verpflegung und Club – inklusive Freihalten des Bräutigams. Export für PayPal Freunde, Word und PDF."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="JGA Budget Rechner" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Bräutigam Freihalten & PayPal Rechner</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				JGA Budget Rechner <span class="accent-italic">& Kostenverteiler</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Berechnen Sie den genauen Beitrag pro Mann für Ferienhaus, Paintball, Brauereiführung, Steakhouse und Clubnacht. Halten Sie den Bräutigam automatisch frei und generieren Sie fertige PayPal- und WhatsApp-Zahlungsaufforderungen.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Setup & Kategorien -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						JGA-Planung & Teilnehmer
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						N-1 Umlagesystem
					</span>
				</div>

				<!-- Destination / Preset Picker -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="destination-preset" style="font-weight: 700;">Reiseziel / JGA-Motto Vorlage</label>
					<select id="destination-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; padding: 0.65rem;">
						<option value="mallorca" selected>🍻 Mallorca / Palma (Bierkönig, Katamaran, Strand / 360€/Mann)</option>
						<option value="prag">🏰 Prag / Budapest (Brauereitour, Schießstand & Feiern / 260€/Mann)</option>
						<option value="hamburg">⚓ Hamburg / St. Pauli (Kiez-Tour, Reeperbahn & Hafen / 240€/Mann)</option>
						<option value="amsterdam">🚲 Amsterdam (Grachtenboot, Craft Beer & Nightlife / 320€/Mann)</option>
						<option value="huette">🌲 Hütte im Schwarzwald / Harz (Fassbier & Großes Grillen / 150€/Mann)</option>
						<option value="custom">✏️ Individuelle Kalkulation</option>
					</select>
				</div>

				<!-- Name des Bräutigams, Zahlende Jungs, Nächte -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label class="form-label" for="groom-name" style="font-size: 0.9rem; font-weight: 600;">Bräutigam</label>
						<input type="text" id="groom-name" class="form-input" value="Max" placeholder="z.B. Max" />
					</div>
					<div>
						<label class="form-label" for="guys-count" style="font-size: 0.9rem; font-weight: 600;">Zahlende Jungs</label>
						<input type="number" id="guys-count" class="form-input" value="7" min="1" max="40" />
					</div>
					<div>
						<label class="form-label" for="trip-nights" style="font-size: 0.9rem; font-weight: 600;">Nächte</label>
						<input type="number" id="trip-nights" class="form-input" value="2" min="1" max="30" />
					</div>
				</div>

				<!-- Bräutigam Freihalten Toggle -->
				<div class="form-group" style="background: #fffcf5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem;">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 0.98rem; margin: 0;">
						<input type="checkbox" id="toggle-cover-groom" checked style="width: 18px; height: 18px; cursor: pointer;" />
						<span>Bräutigam zu 100% freihalten (Zahlt 0€)</span>
					</label>
					<span style="font-size: 0.82rem; color: #64748b; display: block; margin-top: 4px; margin-left: 26px;">
						Klassische JGA-Regel: Die 7 Jungs teilen sich alle Gesamtkosten gleichmäßig auf.
					</span>
				</div>

				<!-- Ausgaben-Kategorien -->
				
				<!-- Kategorie 1: Unterkunft -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏡 1. Unterkunft & Kaution (€)
						</strong>
						<span id="subtotal-lodging" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">900€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-airbnb" style="font-size: 0.85rem;">Ferienhaus / Airbnb / Hotel</label>
							<input type="number" id="exp-airbnb" class="form-input" value="800" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-cleaning" style="font-size: 0.85rem;">Endreinigung & Nebenkosten</label>
							<input type="number" id="exp-cleaning" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Kategorie 2: Aktivitäten -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏎️ 2. Aktivitäten & Erlebnisse (€)
						</strong>
						<span id="subtotal-activities" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">550€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-boat" style="font-size: 0.85rem;">Bootstour / Floß / Katamaran</label>
							<input type="number" id="exp-boat" class="form-input" value="300" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-shooting" style="font-size: 0.85rem;">Kartbahn / Paintball / Schießen</label>
							<input type="number" id="exp-shooting" class="form-input" value="150" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-tours" style="font-size: 0.85rem;">Brauereiführung / Kiez-Tour</label>
							<input type="number" id="exp-tours" class="form-input" value="100" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-golf" style="font-size: 0.85rem;">Sonstige Action / Spiele</label>
							<input type="number" id="exp-golf" class="form-input" value="0" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Kategorie 3: Essen & Grillen -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🥩 3. Essen, Brauhaus & Grillen (€)
						</strong>
						<span id="subtotal-food" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">500€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-dinners" style="font-size: 0.85rem;">Brauhaus / Steakhouse</label>
							<input type="number" id="exp-dinners" class="form-input" value="300" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-groceries" style="font-size: 0.85rem;">Supermarkt & Grillfleisch</label>
							<input type="number" id="exp-groceries" class="form-input" value="120" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-brunch" style="font-size: 0.85rem;">Katerfrühstück, Döner & Snacks</label>
						<input type="number" id="exp-brunch" class="form-input" value="80" min="0" step="10" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Kategorie 4: Nachtleben & Getränke -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🍻 4. Nachtleben, Kneipen & Clubs (€)
						</strong>
						<span id="subtotal-nightlife" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">450€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-bars" style="font-size: 0.85rem;">Kneipentour & Bierrunden</label>
							<input type="number" id="exp-bars" class="form-input" value="200" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-vip" style="font-size: 0.85rem;">Club-Eintritt / VIP-Tisch</label>
							<input type="number" id="exp-vip" class="form-input" value="150" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-booze" style="font-size: 0.85rem;">Fassbier, Kästen & Schnaps Hütte</label>
						<input type="number" id="exp-booze" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Kategorie 5: Anreise & Transport -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🚗 5. Anreise & Transport (€)
						</strong>
						<span id="subtotal-transport" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">120€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-rental" style="font-size: 0.85rem;">Mietbus / Sprit / Maut</label>
							<input type="number" id="exp-rental" class="form-input" value="80" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-uber" style="font-size: 0.85rem;">Großraumtaxis & Uber</label>
							<input type="number" id="exp-uber" class="form-input" value="40" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Kategorie 6: JGA-Shirts & Bauchladen -->
				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🧢 6. Shirts, Kostüm & Kater-Kits (€)
						</strong>
						<span id="subtotal-swag" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">90€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-shirts" style="font-size: 0.85rem;">Gruppen-Shirts & Bräutigam-Kostüm</label>
							<input type="number" id="exp-shirts" class="form-input" value="60" min="0" step="5" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-kits" style="font-size: 0.85rem;">Kater-Kits, Elotrans & Becher</label>
							<input type="number" id="exp-kits" class="form-input" value="30" min="0" step="5" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Zusammenfassung & PayPal Generator -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Cost Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.25rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Kosten pro zahlendem Mann
						</span>
						<span id="groom-status-badge" style="font-size: 0.85rem; font-weight: 800; background: #16a34a; color: #fff; padding: 3px 8px; border-radius: 4px;">
							🤵 Max Zahlt: 0€
						</span>
					</div>

					<div id="display-per-person" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						373€
					</div>

					<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.25rem; font-size: 0.95rem; color: var(--text-secondary); flex-wrap: wrap;">
						<span>🌙 <strong id="display-per-night" style="color: var(--fg-pencil);">186€</strong> / Nacht</span>
						<span>•</span>
						<span>🎁 Bräutigam-Umlage: <strong id="display-groom-subsidy" style="color: var(--accent-red); font-weight: 700;">+47€</strong> / Mann</span>
					</div>

					<p style="font-size: 0.92rem; color: var(--text-secondary); margin: 0 0 1.25rem 0; padding-bottom: 1rem; border-bottom: 1px dashed #cbd5e1;">
						Gesamtbudget der JGA-Gruppe: <strong id="display-trip-grand-total" style="color: var(--fg-pencil); font-weight: 700;">2.610€</strong> für <span id="display-headcount-text">7 Jungs</span> (+ Bräutigam).
					</p>

					<!-- Itemized Per-Person Split Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏡 Unterkunft & Kaution:</span>
							<strong id="item-lodging-share">129€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏎️ Aktivitäten & Erlebnisse:</span>
							<strong id="item-activity-share">79€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🥩 Essen, Brauhaus & Grillen:</span>
							<strong id="item-food-share">71€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🍻 Nachtleben, Kneipen & Clubs:</span>
							<strong id="item-nightlife-share">64€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🚗 Anreise & Mietwagen:</span>
							<strong id="item-transport-share">17€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.9rem;">
							<span>🧢 Shirts & Kater-Kits:</span>
							<strong id="item-swag-share">13€</strong>
