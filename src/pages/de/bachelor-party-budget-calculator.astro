							<tr><td>Essen, Brauhaus & Grillen (Steakhouse, BBQ, Brunch)</td><td>${subFood.textContent}</td><td>${itemFoodShare.textContent}</td></tr>
							<tr><td>Nachtleben, Kneipen & Clubs (Bierrunden, Club, Bar)</td><td>${subNightlife.textContent}</td><td>${itemNightlifeShare.textContent}</td></tr>
							<tr><td>Anreise & Transport (Mietbus, Taxis)</td><td>${subTransport.textContent}</td><td>${itemTransportShare.textContent}</td></tr>
							<tr><td>Shirts, Kostüm & Kater-Kits</td><td>${subSwag.textContent}</td><td>${itemSwagShare.textContent}</td></tr>
							<tr class="total-row"><td>GESAMTKOSTEN PRO MANN</td><td>${displayGrandTotal.textContent}</td><td>${displayPerPerson.textContent}</td></tr>
						</tbody>
					</table>

					<h2>Zahlungsplan (PayPal Freunde)</h2>
					<p>• <strong>Rate 1 - Anzahlung (Frist ${paymentDeadlineInput.value || 'Sofort'}):</strong> ${schedDep1.textContent} / Mann<br>
