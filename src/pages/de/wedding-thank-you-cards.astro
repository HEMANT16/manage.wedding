---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-thank-you-cards/#webapp",
      "name": "Danksagungskarten-Generator Hochzeit | Manage.Wedding",
      "url": "https://manage.wedding/de/wedding-thank-you-cards",
      "inLanguage": "de",
      "description": "Kostenloser Generator für Danksagungstexte zur Hochzeit. Formulieren Sie herzliche, knigge-konforme Dankeskarten für Geldgeschenke, Flitterwochenkasse, Hochzeitsgeschenke und Dienstleister.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie verfasst man den perfekten Danksagungstext zur Hochzeit nach Knigge?",
      "description": "Die bewährte 4-Satz-Formel für ehrliche, stilvolle Danksagungskarten nach der Hochzeit.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Satz 1: Dank für das Kommen und die gemeinsame Feier",
          "text": "Bedanken Sie sich beim Gast dafür, dass er diesen besonderen Tag mit Ihnen gefeiert hat."
        },
        {
          "@type": "HowToStep",
          "name": "Satz 2: Das Geschenk konkret benennen",
          "text": "Erwähnen Sie das Geschenk konkret (z. B. 'den wunderschönen Bräter' oder 'deinen großzügigen Beitrag zu unserer Flitterwochenkasse'), ohne exakte Geldbeträge zu nennen."
        },
        {
          "@type": "HowToStep",
          "name": "Satz 3: Geplante Verwendung schildern",
          "text": "Beschreiben Sie, wie Sie das Geschenk nutzen werden (z. B. 'damit werden wir unseren ersten gemeinsamen Kochabend zelebrieren')."
        },
        {
          "@type": "HowToStep",
          "name": "Satz 4: Herzlicher Gruß & Ausblick auf ein baldiges Wiedersehen",
          "text": "Schließen Sie mit einer persönlichen Verabschiedung und der Vorfreude auf das nächste Treffen."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wann sollte man die Danksagungskarten nach der Hochzeit verschicken?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nach modernem Hochzeitsknigge sollten Danksagungen spätestens 2 bis maximal 3 Monate nach der Rückkehr aus den Flitterwochen verschickt werden. Für vorab per Post erhaltene Geschenke empfiehlt sich eine kurze Danksagung innerhalb von 2 Wochen."
          }
        },
        {
          "@type": "Question",
          "name": "Wie bedankt man sich stilvoll für ein Geldgeschenk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nennen Sie niemals den exakten Euro-Betrag im Text. Bedanken Sie sich stattdessen für die 'großzügige Unterstützung' oder das 'wunderbare Geschenk' und erwähnen Sie den Verwendungszweck (z. B. für die Flitterwochen in Italien oder das gemeinsame Zuhause)."
          }
        },
        {
          "@type": "Question",
          "name": "Sollten Danksagungskarten handgeschrieben sein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Während die gedruckte Danksagungskarte ein schönes Hochzeitsfoto enthält, ist eine kurze persönliche, handgeschriebene Zeile mit beiden Unterschriften das absolute Gütesiegel wahrer Wertschätzung."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Danksagungskarten-Generator Hochzeit | Vorlagen & Knigge-Texte"
	description="Kostenloser Danksagungstexte-Generator für die Hochzeit. Persönliche Texte für Geldgeschenke, Flitterwochen-Kasse, Sachgeschenke und Dienstleister. Knigge-Formulierungen mit 1-Klick-Kopieren & Word/PDF-Druck."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Danksagungskarten-Generator" category="stationery-creative" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Knigge-geprüfte Textvorlagen</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Danksagungskarten <span class="accent-italic">& Text-Generator Hochzeit</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Erstellen Sie persönliche, stilvolle Danksagungstexte für Geldgeschenke, Flitterwochen-Zuschüsse, Geschenke der Wunschliste und Gäste. 1-Klick-Kopieren oder als Word-/PDF-Vorlage exportieren.
			</p>
		</header>

		<!-- Main Interactive Generator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Input Form -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Danksagung anpassen
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Knigge-konform
					</span>
				</div>

				<!-- Recipient Name -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="guest-names" style="font-weight: 700; font-size: 0.95rem;">Name(n) der Gäste</label>
					<input type="text" id="guest-names" class="form-input" value="Tante Susanne & Onkel Michael" placeholder="z. B. Tante Susanne & Onkel Michael, Jessica & David" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
				</div>

				<!-- Relationship to Couple -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="relationship" style="font-weight: 700; font-size: 0.95rem;">Beziehung zum Brautpaar</label>
					<select id="relationship" class="form-input" style="cursor: pointer; width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;">
						<option value="family-close">Engste Familie (Eltern, Großeltern, Geschwister)</option>
						<option value="family-extended" selected>Verwandtschaft (Tanten, Onkel, Cousins)</option>
						<option value="friends-close">Trauzeugen & enge Freunde</option>
						<option value="friends-casual">Kollegen & Bekannte</option>
						<option value="absent">Gast, der nicht kommen konnte (hat Geschenk geschickt)</option>
						<option value="vendor">Dienstleister (Fotograf, Location, DJ, Floristik)</option>
					</select>
				</div>

				<!-- Gift Category -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="gift-type" style="font-weight: 700; font-size: 0.95rem;">Erhaltenes Geschenk</label>
					<select id="gift-type" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;">
						<option value="cash" selected>💵 Geldgeschenk / Briefumschlag</option>
						<option value="honeymoon">🏝️ Beitrag zur Flitterwochenkasse</option>
						<option value="registry">🎁 Sachgeschenk von der Hochzeitsliste</option>
						<option value="attendance">✨ Nur Anwesenheit (Gast ohne Geschenk)</option>
						<option value="group">👥 Gemeinschaftsgeschenk (von Kollegen/Freunden)</option>
						<option value="giftcard">💳 Gutschein</option>
					</select>
				</div>

				<!-- Gift Specific Item / Detail -->
				<div class="form-group" id="gift-detail-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="gift-detail" style="font-weight: 700; font-size: 0.95rem;">Konkretes Geschenk / Verwendungszweck</label>
					<input type="text" id="gift-detail" class="form-input" value="unsere Flitterwochen in Italien & das gemeinsame Zuhause" placeholder="z. B. Küchenmaschine, Katamaran-Tour auf Maui" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
				</div>

				<!-- Tone / Style Selector -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" style="font-weight: 700; margin-bottom: 0.5rem; display: block;">Tonfall & Schreibstil</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="tone-btn hand-btn is-active" data-tone="heartfelt" style="padding: 8px; font-size: 0.88rem;">
							💖 Herzlich & Warm
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="formal" style="padding: 8px; font-size: 0.88rem;">
							🏛️ Formell & Klassisch
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="casual" style="padding: 8px; font-size: 0.88rem;">
							✨ Modern & Frisch
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="short" style="padding: 8px; font-size: 0.88rem;">
							⚡ Kurz & Bündig (3 Sätze)
						</button>
					</div>
				</div>

				<!-- Personal Memory (Optional) -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="personal-memory" style="font-weight: 700; font-size: 0.95rem;">Persönliche Erinnerung (Optional)</label>
					<input type="text" id="personal-memory" class="form-input" value="Es war so schön, mit euch bis spät in die Nacht auf der Tanzfläche zu feiern!" placeholder="z. B. Danke für die weite Anreise aus Hamburg!" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
				</div>

				<!-- Sign-off Names -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="signoff-names" style="font-weight: 700; font-size: 0.95rem;">Eure Namen (Unterschrift)</label>
					<input type="text" id="signoff-names" class="form-input" value="Sophie & Maximilian" placeholder="z. B. Sophie & Maximilian" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
				</div>

				<button id="btn-generate-notes" class="hand-btn" style="width: 100%; padding: 14px; font-size: 1.1rem; margin-top: 0.5rem; justify-content: center;">
					<span>✨</span> 3 Text-Varianten generieren
				</button>

			</div>

			<!-- Right Column: 3 Generated Options & Tracker -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Results Header -->
				<div style="display: flex; justify-content: space-between; align-items: center;">
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						Generierte Textvorschläge
					</h3>
					<span id="word-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
						~50 Wörter | 1,5 Min. Schreibzeit
					</span>
				</div>

				<!-- Option 1 Card (Recommended) -->
				<div class="hand-card" style="padding: 1.5rem; background: #fffcf5; border-left: 6px solid var(--accent-red); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Option 1: Unsere Empfehlung
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-1" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Text kopieren
						</button>
					</div>
					<p id="note-opt-1" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
Liebe Tante Susanne, lieber Onkel Michael,

von ganzem Herzen danken wir euch, dass ihr unseren Hochzeitstag mit uns gefeiert habt! Eure Anwesenheit hat diesen Tag für uns unvergesslich gemacht. Wir haben uns riesig über euer großzügiges Geschenk für unsere Flitterwochen in Italien & das gemeinsame Zuhause gefreut. Es war so schön, mit euch bis spät in die Nacht auf der Tanzfläche zu feiern! Wir freuen uns schon sehr auf unser nächstes Wiedersehen.

Alles Liebe,
Sophie & Maximilian
					</p>
				</div>

				<!-- Option 2 Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid var(--accent-blue); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-blue); letter-spacing: 0.05em;">
							Option 2: Elegante Formulierung
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-2" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Text kopieren
						</button>
					</div>
					<p id="note-opt-2" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
Liebe Tante Susanne, lieber Onkel Michael,

wir möchten uns herzlich bei euch für die wunderschönen gemeinsamen Stunden an unserem Hochzeitstag bedanken. Danke auch für euren wunderbaren Beitrag zu unsere Flitterwochen in Italien & das gemeinsame Zuhause. Ihr helft uns damit sehr, unseren gemeinsamen Lebensabschnitt mit einem ganz besonderen Erlebnis zu beginnen.

Herzliche Grüße,
Sophie & Maximilian
					</p>
				</div>

				<!-- Option 3 Card (Short & Sweet) -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid #16a34a; position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #16a34a; letter-spacing: 0.05em;">
							Option 3: Klar & Herzlich
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-3" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Text kopieren
						</button>
					</div>
					<p id="note-opt-3" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
Liebe Tante Susanne, lieber Onkel Michael,

vielen Dank, dass ihr diesen einmaligen Tag mit uns geteilt habt und für eure herzliche Großzügigkeit für unsere Flitterwochen in Italien & das gemeinsame Zuhause. Wir schätzen eure Unterstützung von Herzen!

Herzlichst,
Sophie & Maximilian
					</p>
				</div>

				<!-- Action Bar -->
				<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
					<button id="btn-print-note" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>🖨️</span> Danksagungskarte drucken (PDF)
					</button>
					<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>📄</span> Word-Export (.doc)
					</button>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Auf einen Blick (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Die 4-Satz-Formel für Danksagungen
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Hier ist die universelle Struktur für Danksagungskarten nach der Hochzeit.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📝 Die 4-Satz-Danksagungsformel:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					[1. Dank für Anwesenheit/Kommen] + [2. Geschenk konkret nennen (keinen Geldbetrag)] + [3. Verwendung schildern] + [4. Herzlicher Gruß & Wiedersehen] • ⏰ Versand innerhalb von 2–3 Monaten nach den Flitterwochen.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Geschenkart</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Knigge-konforme Formulierung</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Was man vermeiden sollte</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Geldgeschenk</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Vielen Dank für deine großzügige Unterstützung für unsere Flitterwochen in Italien."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Keine genauen Euro-Beträge nennen (z. B. "Danke für die 100 €").</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Sachgeschenk (Wunschliste)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Danke für den wunderschönen Bräter. Wir haben ihn schon für unser Sonntagsessen eingeweiht!"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Keine unpersönlichen Floskeln wie "Danke für den Gegenstand".</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Gast ohne Geschenk</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Wir haben uns so gefreut, dass du mit uns gefeiert hast! Deine tolle Stimmung hat die Feier bereichert."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Niemals das Fehlen eines Geschenks ansprechen.</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Der vollständige Ratgeber für Hochzeits-Danksagungen
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Wie Sie den Schreibaufwand entspannt bewältigen und jedem Gast eine ehrliche Freude machen.
				</p>
			</div>

			<!-- Section 1: Timing -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Der richtige Zeitplan für Danksagungskarten
				</h3>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>2–3 Monate nach der Hochzeit:</strong> Der perfekte Zeitpunkt, wenn die offiziellen Hochzeitsfotos vom Fotografen vorliegen.</li>
					<li><strong>In Etappen schreiben:</strong> Wenn Sie jeden Abend gemeinsam 8 bis 10 Karten schreiben, ist eine 80-Personen-Hochzeit in rund einer Woche fertig.</li>
				</ul>
			</section>

			<!-- Section 2: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Häufig gestellte Fragen (FAQ)
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Unterschreiben beide Partner die Karte?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Ja, unbedingt! Der Text ist in der 'Wir'-Form verfasst und wird von beiden Partnern namentlich unterschrieben.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Bekommen auch die Dienstleister eine Dankeskarte?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Fotografen, Floristen, Trauredner und Caterer freuen sich enorm über eine persönliche Dankeskarte mit einem Foto ihrer Arbeit – und eine positive Online-Bewertung!
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/de/wedding-thank-you-cards" category="stationery" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const guestNamesInput = document.getElementById('guest-names');
		const relationshipSelect = document.getElementById('relationship');
		const giftTypeSelect = document.getElementById('gift-type');
		const giftDetailInput = document.getElementById('gift-detail');
		const giftDetailGroup = document.getElementById('gift-detail-group');
		const memoryInput = document.getElementById('personal-memory');
		const signoffInput = document.getElementById('signoff-names');
		const toneButtons = document.querySelectorAll('.tone-btn');
		const btnGenerate = document.getElementById('btn-generate-notes');

		const noteOpt1 = document.getElementById('note-opt-1');
		const noteOpt2 = document.getElementById('note-opt-2');
		const noteOpt3 = document.getElementById('note-opt-3');
		const wordCountBadge = document.getElementById('word-count-badge');
		const btnPrint = document.getElementById('btn-print-note');
		const btnDoc = document.getElementById('btn-export-doc');

		let currentTone = 'heartfelt';

		// Tone Toggle Handler
		toneButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				toneButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentTone = btn.getAttribute('data-tone');
				generateNotes();
			});
		});

		// Gift Type Handler
		giftTypeSelect.addEventListener('change', () => {
			const type = giftTypeSelect.value;
			if (type === 'attendance') {
				giftDetailGroup.style.display = 'none';
			} else {
				giftDetailGroup.style.display = 'block';
				if (type === 'cash') giftDetailInput.placeholder = 'z. B. unsere Flitterwochen in Italien & das gemeinsame Zuhause';
				else if (type === 'honeymoon') giftDetailInput.placeholder = 'z. B. romantisches Abendessen am Strand auf Mallorca';
				else if (type === 'registry') giftDetailInput.placeholder = 'z. B. hochwertiges Geschirrset';
				else if (type === 'group') giftDetailInput.placeholder = 'z. B. Siebträger-Kaffeemaschine';
				else if (type === 'giftcard') giftDetailInput.placeholder = 'z. B. Gutschein für das Einrichtungshaus';
			}
			generateNotes();
		});

		function generateNotes() {
			const names = guestNamesInput.value.trim() || 'Liebe Gäste';
			const gift = giftTypeSelect.value;
			const detail = giftDetailInput.value.trim() || 'euer wunderbares Geschenk';
			const memory = memoryInput.value.trim();
			const signoff = signoffInput.value.trim() || 'Sophie & Maximilian';

			let opt1 = '', opt2 = '', opt3 = '';
			const memoryClause = memory ? ` ${memory}` : '';

			if (currentTone === 'heartfelt') {
				if (gift === 'cash') {
					opt1 = `Liebe/r ${names},\n\nvon ganzem Herzen danken wir euch, dass ihr unseren Hochzeitstag mit uns gefeiert habt! Eure Anwesenheit hat diesen Tag für uns unvergesslich gemacht. Wir haben uns riesig über euer großzügiges Geschenk für ${detail} gefreut.${memoryClause} Wir freuen uns schon sehr auf unser nächstes Wiedersehen.\n\nAlles Liebe,\n${signoff}`;
					opt2 = `Liebe/r ${names},\n\nwir möchten uns herzlich bei euch für die wunderschönen gemeinsamen Stunden an unserem Hochzeitstag bedanken. Danke auch für euren wunderbaren Beitrag zu ${detail}. Ihr helft uns damit sehr, unseren gemeinsamen Lebensabschnitt mit einem ganz besonderen Erlebnis zu beginnen.${memoryClause}\n\nHerzliche Grüße,\n${signoff}`;
					opt3 = `Liebe/r ${names},\n\nvielen Dank, dass ihr diesen einmaligen Tag mit uns geteilt habt und für eure herzliche Großzügigkeit für ${detail}.${memoryClause} Wir schätzen eure Unterstützung von Herzen!\n\nHerzlichst,\n${signoff}`;
				} else if (gift === 'honeymoon') {
					opt1 = `Liebe/r ${names},\n\nvielen Dank für die wundervolle gemeinsame Feier! Über euren Beitrag zu ${detail} haben wir uns unglaublich gefreut. Ihr habt unsere Flitterwochen damit zu einer unvergesslichen Reise gemacht.${memoryClause}\n\nMit den liebsten Grüßen,\n${signoff}`;
					opt2 = `Liebe/r ${names},\n\nes war so schön, dass ihr an unserem großen Tag bei uns wart. Danke von Herzen für euer Geschenk zu ${detail}! Wir werden noch lange an diese Erlebnisse zurückdenken.${memoryClause}\n\nIn Liebe,\n${signoff}`;
					opt3 = `Liebe/r ${names},\n\ndanke für eure Unterstützung und das traumhafte Geschenk für ${detail}!${memoryClause} Wir freuen uns auf viele weitere gemeinsame Momente.\n\nAlles Liebe,\n${signoff}`;
				} else if (gift === 'registry') {
					opt1 = `Liebe/r ${names},\n\nvielen Dank für euer Kommen und das wunderschöne Geschenk: ${detail}! Wir haben schon den perfekten Platz dafür in unserem Zuhause gefunden.${memoryClause}\n\nHerzliche Grüße,\n${signoff}`;
					opt2 = `Liebe/r ${names},\n\nes war ein traumhafter Tag mit euch. Danke für eure liebevolle Aufmerksamkeit und das Geschenk (${detail}). Wir werden es sehr oft und gerne nutzen!${memoryClause}\n\nAlles Liebe,\n${signoff}`;
					opt3 = `Liebe/r ${names},\n\ndanke für die gemeinsame Feier und das wunderbare Geschenk (${detail})! Eure Herzlichkeit bedeutet uns sehr viel.${memoryClause}\n\nHerzlichst,\n${signoff}`;
				} else {
					// Anwesenheit
					opt1 = `Liebe/r ${names},\n\nvielen Dank, dass ihr unseren Hochzeitstag mit uns gefeiert habt! Eure Fröhlichkeit und gute Laune haben unsere Feier perfekt gemacht.${memoryClause}\n\nAlles Liebe,\n${signoff}`;
					opt2 = `Liebe/r ${names},\n\nwir haben uns riesig gefreut, dass ihr den Weg auf euch genommen habt, um diesen Tag mit uns zu verbringen.${memoryClause} Schön, dass es euch gibt!\n\nHerzliche Grüße,\n${signoff}`;
					opt3 = `Liebe/r ${names},\n\ndanke für eure Zeit, euer Lachen und eure Herzlichkeit an unserem großen Tag!${memoryClause}\n\nIn Liebe,\n${signoff}`;
				}
			} else if (currentTone === 'formal') {
				opt1 = `Sehr geehrte/r ${names},\n\nwir bedanken uns sehr herzlich für Ihr Kommen zu unserer Hochzeitsfeier und für Ihr großzügiges Geschenk zu ${detail}.${memoryClause} Wir haben uns über Ihre Anwesenheit sehr gefreut.\n\nMit den besten Grüßen,\n${signoff}`;
				opt2 = `Liebe/r ${names},\n\nfür die erwiesene Aufmerksamkeit und das geschätzte Geschenk zu ${detail} anlässlich unserer Vermählung sprechen wir Ihnen unseren aufrichtigen Dank aus.${memoryClause}\n\nMit freundlichen Grüßen,\n${signoff}`;
				opt3 = `Sehr geehrte/r ${names},\n\nhaben Sie vielen Dank für die guten Wünsche und die Unterstützung zu ${detail}.${memoryClause}\n\nHerzlichst,\n${signoff}`;
			} else if (currentTone === 'casual') {
				opt1 = `Hallo ${names}!\n\nDanke, dass ihr mit uns die Nacht zum Tag gemacht habt! Über euer Geschenk für ${detail} haben wir uns mega gefreut.${memoryClause} Lasst uns ganz bald wiedersehen!\n\nLiebe Grüße,\n${signoff}`;
				opt2 = `Liebe/r ${names},\n\ndanke für die grandiose Stimmung und das super Geschenk (${detail})!${memoryClause} Ihr seid spitze!\n\nBis ganz bald,\n${signoff}`;
				opt3 = `Hey ${names},\n\nvielen Dank fürs Mitfeiern und euer geniales Geschenk für ${detail}!${memoryClause}\n\nBeste Grüße,\n${signoff}`;
			} else {
				// Short
				opt1 = `Liebe/r ${names},\n\nvielen Dank für euer Kommen und das tolle Geschenk für ${detail}.${memoryClause} Wir haben uns sehr gefreut!\n\nAlles Liebe,\n${signoff}`;
				opt2 = `Liebe/r ${names},\n\ndanke für eure Unterstützung und das Geschenk (${detail}). Schön, dass ihr da wart!${memoryClause}\n\nHerzlich,\n${signoff}`;
				opt3 = `Liebe/r ${names},\n\nherzlichen Dank für die wunderschöne Feier mit euch und euer Geschenk für ${detail}!${memoryClause}\n\nLiebe Grüße,\n${signoff}`;
			}

			noteOpt1.textContent = opt1;
			noteOpt2.textContent = opt2;
			noteOpt3.textContent = opt3;

			const words = opt1.split(/\s+/).length;
			wordCountBadge.textContent = `~${words} Wörter | ~1,5 Min. Schreibzeit`;
		}

		// Event Listeners
		[guestNamesInput, relationshipSelect, giftDetailInput, memoryInput, signoffInput].forEach(inp => {
			inp.addEventListener('input', generateNotes);
		});
		btnGenerate.addEventListener('click', generateNotes);

		// Copy Button Logic
		document.querySelectorAll('.copy-note-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				const targetId = btn.getAttribute('data-target');
				const text = document.getElementById(targetId).textContent;
				navigator.clipboard.writeText(text).then(() => {
					const orig = btn.textContent;
					btn.textContent = '✅ Kopiert!';
					setTimeout(() => { btn.textContent = orig; }, 2000);
				});
			});
		});

		// Print Stationery PDF
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Danksagung drucken — Manage.Wedding</title>
					<style>
						@page { size: A6 landscape; margin: 15mm; }
						body { font-family: Georgia, 'Times New Roman', serif; font-size: 11pt; line-height: 1.6; color: #1e293b; }
					</style>
				</head>
				<body>
					<div>${noteText}</div>
					<script>window.onload = function() { window.print(); };<\/script>
				</body>
				</html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Hochzeits-Danksagungstext</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 12pt; line-height: 1.6; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Danksagungstext</h2>
					<p>${noteText}</p>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = `danksagung-${guestNamesInput.value.replace(/[^a-zA-Z0-9]/g, '_')}.doc`;
			link.click();
		});

		// Initial Generation
		generateNotes();
	</script>
</Layout>
