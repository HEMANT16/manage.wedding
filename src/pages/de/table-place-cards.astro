---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/table-place-cards/#webapp",
      "name": "Hochzeits-Platzkarten & Tischnummern Generator | Manage.Wedding",
      "url": "https://manage.wedding/de/table-place-cards",
      "inLanguage": "de",
      "description": "Kostenloser Platzkarten- und Tischnummern-Generator für Ihre Hochzeit. Erstellen Sie druckfertige Klappkarten mit Menü-Icons, flache Namenskarten und Tischnummern mit PDF-, Word- und CSV-Export.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie formatiert, druckt und faltet man Hochzeits-Platzkarten und Tischnummern?",
      "description": "Schritt-für-Schritt-Anleitung zur Auswahl des Kartenformats, Einbindung von Menü-Symbolen fürs Catering und zum sauberen Drucken auf schwerem Feinpapier.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Kartenformat und Design-Rahmen wählen",
          "text": "Wählen Sie zwischen selbststehenden Klappkarten (9 × 5 cm gefaltet), flachen Tischkarten für Kartenhalter oder Aufstellern für Tischnummern."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Tische & Catering-Menü-Icons zuweisen",
          "text": "Verknüpfen Sie jeden Gastnamen mit der Tischnummer und dem Menüsymbol (Rind, Geflügel, Fisch, Vegetarisch) für das Servicepersonal."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Auf 220 bis 300 g/m² Feinkarton drucken",
          "text": "Laden Sie die druckfertige PDF-Vorlage herunter und drucken Sie die Bögen auf festem Kartonpapier oder im lokalen Copyshop."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Rillen, schneiden und alphabetisch sortieren",
          "text": "Nutzen Sie ein Schneidelineal, falzen Sie die Klappkarten mittig und sortieren Sie die Kärtchen für den Tag der Hochzeit tischweise vor."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Was ist der Unterschied zwischen Tischkarten (Escort Cards) und Platzkarten (Place Cards)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tischkarten (Escort Cards) stehen am Saaleingang und verraten dem Gast, an welchem Tisch er sitzt (z. B. 'Tisch 4'). Platzkarten (Place Cards) liegen direkt am Gedeck und weisen dem Gast seinen exakten Stuhl sowie dem Service das vorbestellte Menü zu."
          }
        },
        {
          "@type": "Question",
          "name": "Welches Papiergewicht (Grammatur) eignet sich am besten für DIY-Platzkarten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ideal ist unbeschichteter Feinkarton zwischen 220 und 300 g/m² (z. B. Naturpapier, Büttenpapier oder Kraftpapier). Dadurch stehen gefaltete Zeltkarten stabil auf Stoffservietten, ohne umzukippen."
          }
        },
        {
          "@type": "Question",
          "name": "Warum sind Menü-Symbole (Icons) auf Platzkarten so wichtig?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Servicekräfte im Bankett erkennen anhand dezenter Symbole (🥩 Fleisch, 🐟 Fisch, 🥦 Vegetarisch) sofort, wer welchen Hauptgang erhält – ganz ohne peinliches Nachfragen während festlicher Reden."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Tisch- & Platzkarten-Druckstudio Hochzeit | Kostenlose Vorlagen & Menü-Icons"
	description="Druckfertige Hochzeits-Platzkarten, Klappkarten (Tent Cards) und Tischnummern mit Menü-Symbolen erstellen. Druck-PDFs, Word-Listen und CSV-Dateien sofort exportieren."
	schema={schema}
>
	<!-- Include html2canvas for preview card capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Tisch- & Platzkarten-Studio" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Tisch- & <span class="accent-italic">Platzkarten-Studio</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Erstellen Sie druckfertige Klappkarten, flache Namenskärtchen und Centerpiece-Tischnummern. Inklusive <strong>Catering-Menü-Icons</strong>, Zierrahmen und sofortigem <strong>Druck-PDF</strong> oder <strong>Word (.doc)</strong> Export.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> In 3 einfachen Schritten zu perfekten Platzkarten
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Format & Design wählen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Wählen Sie zwischen selbststehenden Klappkarten (9 × 5 cm), flachen Kärtchen für Halter oder großen Tischnummern (13 × 18 cm).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Tische & Menü-Icons pflegen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Gäste und Tischnummern eintragen oder <strong>"✨ Beispieldaten laden"</strong>. Menü-Symbole (🥩 Rind, 🍗 Geflügel, 🐟 Fisch, 🥦 Veg) aktivieren.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Druck-PDF & Caterer-Liste exportieren
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Klicken Sie auf <strong>"🖨️ PDF / Drucken"</strong> für schnittfertige Bögen oder <strong>"📝 Word-Export"</strong> für die Menüübergabe an den Bankettleiter!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Config Form + Live Preview & Table Roster -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="placecards-calc-grid">
			
			<!-- Left Column: Card Configuration & Table Manager -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🏷️ Karten-Layout & Design-Optionen
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Format, Zierrahmen und Tischzuweisungen anpassen
					</span>
				</div>

				<form id="placecards-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Card Type & Border Theme -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.6rem;">
						<div>
							<label for="select-card-type" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Karten-Format *
							</label>
							<select id="select-card-type" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
								<option value="tent" selected>🏷️ Klappkarten / Zeltkarten (9 × 5 cm gefaltet)</option>
								<option value="flat">🎴 Flache Platzkarten (9 × 5 cm)</option>
								<option value="tablenum">🔢 Tischnummern Aufsteller (13 × 18 cm / DIN A5)</option>
							</select>
						</div>

						<div>
							<label for="select-border-theme" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Zierrahmen-Motiv
							</label>
							<select id="select-border-theme" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
								<option value="botanical" selected>🌿 Eukalyptus & Floralrahmen</option>
								<option value="classic">✒️ Klassische Minimal-Doppellinie</option>
								<option value="crest">🏛️ Elegante Vintage-Eckornamente</option>
							</select>
						</div>
					</div>

					<!-- Options: Meal Icons & Table Number Badges -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block;">
							⚙️ Platzkarten-Optionen
						</span>
						<div style="display: flex; gap: 1rem; flex-wrap: wrap;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-meal-icons" checked style="accent-color: var(--fg-pencil);">
								<span>Catering-Menü-Icons anzeigen (🥩 / 🐟 / 🥦)</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-table-badge" checked style="accent-color: var(--fg-pencil);">
								<span>Tischnummer auf Kärtchen drucken</span>
							</label>
						</div>
					</div>

					<!-- Quick Add Guest & Table Entry -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
							<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
								👥 Erfasste Gäste: <strong id="assigned-count-badge">0 Gäste</strong>
							</span>
							<div style="display: flex; gap: 0.3rem;">
								<button type="button" id="btn-load-samples" class="hand-btn" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; background: #eff6ff;">
									✨ Beispieldaten laden
								</button>
								<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; color: #b91c1c;">
									🗑️ Alle leeren
								</button>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1.3fr 0.8fr 0.9fr auto; gap: 0.35rem; align-items: center;">
							<input type="text" id="input-new-guest-name" placeholder="Gastname" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<input type="text" id="input-new-table-num" placeholder="Tisch #" value="1" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<select id="select-new-meal" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
								<option value="🥩 Rind">🥩 Rind</option>
								<option value="🍗 Geflügel">🍗 Geflügel</option>
								<option value="🐟 Fisch">🐟 Fisch</option>
								<option value="🥦 Vegetarisch">🥦 Veg</option>
							</select>
							<button type="button" id="btn-add-guest" class="hand-btn" style="padding: 0.4rem 0.65rem; font-size: 0.85rem;">
								+ Neu
							</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Card Preview & Table Cards Stream -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Card Preview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖼️ Live-Vorschau der Platzkarte
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Standardmaß 9 × 5 cm Tischkarte
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Word-Tischliste (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ PDF-Druckbögen
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Interactive Preview Place Card Frame -->
					<div id="preview-placecard-canvas" class="theme-botanical" style="border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.75rem 1.25rem; background: #faf8f5; text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.25rem;">
						
						<!-- Corner accents -->
						<div style="position: absolute; top: 4px; left: 4px; width: 12px; height: 12px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 4px; right: 4px; width: 12px; height: 12px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 4px; left: 4px; width: 12px; height: 12px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 4px; right: 4px; width: 12px; height: 12px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<h2 id="prev-guest-name-display" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 0.3rem 0; line-height: 1.2;">
							Sophie Weber
						</h2>

						<div style="width: 40px; height: 1.5px; background: var(--fg-pencil); margin: 0.4rem auto;"></div>

						<p id="prev-table-badge-display" class="font-body" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent-red); margin: 0.3rem 0 0 0; font-weight: bold;">
							TISCH 1
						</p>

						<div id="prev-meal-icon-display" style="position: absolute; bottom: 6px; right: 8px; font-size: 1.1rem;" title="Menüwahl">
							🥩
						</div>
					</div>

					<button type="button" id="btn-download-sample-png" class="hand-btn" style="width: 100%; text-align: center; font-size: 0.95rem; padding: 0.55rem; background: #f0fdf4;">
						📸 Musterkarte als PNG herunterladen
					</button>

				</div>

				<!-- Table Roster & Group Breakdown Stream -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 400px; overflow-y: auto;">
					<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						📋 Gäste nach Tischen geordnet
					</h3>
					<div id="table-cards-stream" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<!-- Populated via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Offizielle Hochzeits-Platzkarten (Druckvorlage)</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exportiert am: <span id="print-date"></span> | Anzahl Platzkarten: <span id="print-guest-count"></span></p>
			</div>
			<div id="print-cards-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Auf einen Blick (BLUF): Formate & Grammaturen
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					1-Minuten Spezifikationen
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Standard-Maße der Papeterie:</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Klappkarten = 9 × 5 cm gefaltet (4 pro DIN A4)</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Flache Tischkarten = 9 × 5 cm (8–10 pro Bogen)</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Tischnummern = 13 × 18 cm (2 pro DIN A4)</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Druckempfehlung:</strong> Verwenden Sie Feinkarton mit <strong>220 bis 300 g/m²</strong>. Schriftgröße <strong>18–22 pt</strong> für Gastnamen, <strong>12–14 pt</strong> für Tischnummern und <strong>16–20 px Menü-Icons</strong> für eine klare Erkennbarkeit im Kerzenschein.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Papeterie-Element</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Endformat</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Pro DIN-A4-Bogen</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Empfohlenes Papier</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Schriftgröße</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Einsatzort</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Gefaltete Klappkarte</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">9 × 5 cm (Gefaltet)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">4 Karten (Offen: 9×10 cm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">250–300 g/m² Karton</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">Name: 18–20 pt</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Direkt am Gedeck / Serviette</td>
						</tr>
						<tr style="background: #faf8f3;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Flache Tischkarte</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">9 × 5 cm (Visitenkartenmaß)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">8 bis 10 Kärtchen</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">220–280 g/m² Bütten/Leinen</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">Name: 16–18 pt</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Kartenhalter / Eingangstisch</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Tischnummer-Aufsteller</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">13 × 18 cm (DIN A5)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">2 Karten pro Bogen</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">300 g/m² oder Acrylrahmen</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">Nummer: 48–60 pt Fett</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Tischmitte / Blumengesteck</td>
						</tr>
						<tr style="background: #faf8f3;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Gastgeschenk-Anhänger</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">5 × 5 cm oder 4 × 7 cm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">12 bis 16 Anhänger</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">200–250 g/m² Kraftpapier</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">Name: 12–14 pt</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Gebunden an Gastgeschenk / Sekt</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- SEO Article & Comprehensive Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Papeterie-Ratgeber</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					Der vollständige Leitfaden für Hochzeits-Platzkarten & Tischnummern
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					Menü-Kennzeichnung, Grammaturen, Falttechniken und der nahtlose Übergang vom Sitzplan zum Dinner.
				</p>
			</div>

			<div style="margin-bottom: 2.5rem; text-align: center;">
				<img 
					src="/images/seating_chart_sketch.webp" 
					alt="Hochzeits-Platzkarten — Druckfertige Klappkarten und Tischnummern" 
					loading="lazy"
					decoding="async"
					style="width: 100%; max-height: 420px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); margin: 0 auto; display: block;"
				/>
				<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin-top: 0.5rem; font-style: italic;">
					Gefaltete Platzkarten sorgen für Ordnung am Tisch und helfen dem Catering bei der korrekten Menüausgabe.
				</p>
			</div>

			<!-- Section 1: Guide -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. Platzkarten professionell zu Hause drucken & falten
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1.25rem;">
					Mit den richtigen Handgriffen gelingt der Ausdruck in professioneller Druckerei-Qualität:
				</p>

				<div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.5rem;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-red); margin-bottom: 0.4rem;">
							Schritt 1: Papierwahl (Mindestens 250 g/m²)
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Wählen Sie für Klappkarten hochwertiges Natur- oder Leinenpapier mit <strong>250 bis 300 g/m²</strong>. Normales Kopierpapier (80 g/m²) knickt auf Stoffservietten sofort ein.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-blue); margin-bottom: 0.4rem;">
							Schritt 2: Rillen vor dem Falten
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Um unschöne Papierbrüche an der Falzkante zu vermeiden, ziehen Sie vor dem Umklappen mit einem Falzbein (oder dem Rücken eines Messers) und einem Lineal eine feine Rill-Linie.
						</p>
					</div>
				</div>
			</section>

			<!-- Section 2: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Häufig gestellte Fragen (FAQ)
				</h3>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						Wie erstelle ich Tischnummern für die Tischmitte?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Wählen Sie oben im Format-Dropdown <strong>"🔢 Tischnummern Aufsteller (13 × 18 cm)"</strong>. Das Tool generiert automatisch große, gut lesbare Nummern im passenden Design für Bilderrahmen oder Holzaufsteller.
					</p>
				</details>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						Wie exportiere ich die Tischliste für das Catering?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Klicken Sie oben auf <strong>"📝 Word-Tischliste (.doc)"</strong>. Sie erhalten eine saubere Word-Tabelle, aufgeschlüsselt nach Tischen und Menüwünschen, ideal zur Übergabe an die Küche.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/de/table-place-cards" category="stationery" />

	</main>
</Layout>

<style>
	.theme-botanical {
		background: #faf8f5 !important;
		border-color: #2d5a27 !important;
	}
	.theme-classic {
		background: #ffffff !important;
		border-color: #000000 !important;
	}
	.theme-crest {
		background: #fdfaf6 !important;
		border-color: #92400e !important;
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 15px;
		}
	}
</style>

<script is:inline>
	let seatedGuestList = [];

	const selectCardType = document.getElementById('select-card-type');
	const selectBorderTheme = document.getElementById('select-border-theme');
	const chkShowMealIcons = document.getElementById('chk-show-meal-icons');
	const chkShowTableBadge = document.getElementById('chk-show-table-badge');

	const prevGuestNameDisplay = document.getElementById('prev-guest-name-display');
	const prevTableBadgeDisplay = document.getElementById('prev-table-badge-display');
	const prevMealIconDisplay = document.getElementById('prev-meal-icon-display');
	const previewCanvas = document.getElementById('preview-placecard-canvas');

	const assignedCountBadge = document.getElementById('assigned-count-badge');
	const tableCardsStream = document.getElementById('table-cards-stream');

	function loadSeatedGuests() {
		try {
			const saved = localStorage.getItem('manage_wedding_guests_de');
			if (saved) {
				const all = JSON.parse(saved);
				seatedGuestList = all.filter(g => g.table && g.table.trim() !== "");
			}
		} catch (e) {
			seatedGuestList = [];
		}

		if (!seatedGuestList || seatedGuestList.length === 0) {
			loadSampleTables();
			return;
		}
		renderPlaceCards();
	}

	function loadSampleTables() {
		seatedGuestList = [
			{ name: "Sophie Weber", table: "1", meal: "🥩 Rind" },
			{ name: "Maximilian Weber", table: "1", meal: "🐟 Fisch" },
			{ name: "Dr. Thomas Meyer", table: "2", meal: "🍗 Geflügel" },
			{ name: "Elena Schulz", table: "2", meal: "🥦 Vegetarisch" },
			{ name: "David Miller", table: "3", meal: "🥩 Rind" },
			{ name: "Tante Hildegard", table: "Brauttisch", meal: "🍗 Geflügel" },
			{ name: "Tobias Wagner", table: "Brauttisch", meal: "🥩 Rind" }
		];
		renderPlaceCards();
	}

	function renderPlaceCards() {
		const cardType = selectCardType.value;
		const theme = selectBorderTheme.value;
		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;

		// Preview update
		previewCanvas.className = `theme-${theme}`;
		
		if (cardType === 'tablenum') {
			prevGuestNameDisplay.textContent = "Tischnummer";
			prevTableBadgeDisplay.textContent = "TISCH 1";
			prevTableBadgeDisplay.style.fontSize = "1.8rem";
			prevMealIconDisplay.style.display = "none";
		} else {
			if (seatedGuestList.length > 0) {
				prevGuestNameDisplay.textContent = seatedGuestList[0].name;
				prevTableBadgeDisplay.textContent = `Tisch ${seatedGuestList[0].table}`;
				prevTableBadgeDisplay.style.fontSize = "0.9rem";
				prevMealIconDisplay.textContent = seatedGuestList[0].meal ? seatedGuestList[0].meal.split(' ')[0] : '🥩';
			} else {
				prevGuestNameDisplay.textContent = "Gastname";
				prevTableBadgeDisplay.textContent = "Tisch 1";
				prevMealIconDisplay.textContent = "🥩";
			}
			prevTableBadgeDisplay.style.display = showTable ? "block" : "none";
			prevMealIconDisplay.style.display = showMeal ? "block" : "none";
		}

		assignedCountBadge.textContent = `${seatedGuestList.length} Gäste`;

		// Group by table
		const grouped = {};
		seatedGuestList.forEach(g => {
			const tbl = g.table || 'Ohne Zuweisung';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push(g);
		});

		tableCardsStream.innerHTML = '';
		if (seatedGuestList.length === 0) {
			tableCardsStream.innerHTML = `
				<div style="text-align: center; padding: 1rem; color: var(--text-secondary); font-style: italic; font-size: 0.9rem;">
					Noch keine Gäste erfasst. Klicken Sie auf "✨ Beispieldaten laden" zum Testen!
				</div>
			`;
			return;
		}

		Object.keys(grouped).forEach(tbl => {
			const groupBlock = document.createElement('div');
			groupBlock.style.cssText = `background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;`;
			
			let listHtml = '';
			grouped[tbl].forEach((g, idx) => {
				listHtml += `
					<div style="display: flex; justify-content: space-between; align-items: center; padding: 0.25rem 0; border-bottom: 1px dotted #ccc; font-size: 0.88rem;">
						<span>${g.name} <small style="color:#666;">(${g.meal || 'Standard'})</small></span>
						<button type="button" class="btn-del-seat hand-btn secondary" data-name="${g.name}" style="padding: 0.15rem 0.4rem; font-size: 0.7rem; color: #b91c1c;">🗑️</button>
					</div>
				`;
			});

			groupBlock.innerHTML = `
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
					<strong class="font-heading" style="color: var(--accent-red); font-size: 1rem;">Tisch: ${tbl}</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); font-weight: bold;">${grouped[tbl].length} Plätze</span>
				</div>
				<div>${listHtml}</div>
			`;
			tableCardsStream.appendChild(groupBlock);
		});

		// Attach delete listeners
		document.querySelectorAll('.btn-del-seat').forEach(btn => {
			btn.addEventListener('click', () => {
				const gName = btn.getAttribute('data-name');
				seatedGuestList = seatedGuestList.filter(g => g.name !== gName);
				renderPlaceCards();
			});
		});
	}

	// Capture PNG
	document.getElementById('btn-download-sample-png').addEventListener('click', () => {
		if (window.html2canvas) {
			window.html2canvas(previewCanvas, {
				scale: 3,
				backgroundColor: null,
				useCORS: true
			}).then(canvas => {
				const link = document.createElement('a');
				link.download = `Platzkarte_Muster.png`;
				link.href = canvas.toDataURL("image/png");
				link.click();
			});
		} else {
			alert("Canvas wird geladen. Bitte in Kürze erneut versuchen.");
		}
	});

	// Quick Add Guest
	document.getElementById('btn-add-guest').addEventListener('click', () => {
		const nameInput = document.getElementById('input-new-guest-name');
		const tblInput = document.getElementById('input-new-table-num');
		const mealSelect = document.getElementById('select-new-meal');

		const name = nameInput.value.trim();
		const table = tblInput.value.trim() || '1';
		const meal = mealSelect.value;

		if (name) {
			seatedGuestList.push({ name, table, meal });
			nameInput.value = '';
			renderPlaceCards();
		}
	});

	// Load Sample Tables
	document.getElementById('btn-load-samples').addEventListener('click', loadSampleTables);

	// Clear All
	document.getElementById('btn-clear-all').addEventListener('click', () => {
		seatedGuestList = [];
		renderPlaceCards();
	});

	// Form Inputs Listeners
	[selectCardType, selectBorderTheme, chkShowMealIcons, chkShowTableBadge].forEach(el => {
		el.addEventListener('change', renderPlaceCards);
	});

	// 📝 Export Word Manifest (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const grouped = {};
		seatedGuestList.forEach(g => {
			const tbl = g.table || 'Ohne Zuweisung';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push(g);
		});

		let tablesHtml = '';
		Object.keys(grouped).forEach(tbl => {
			let rows = '';
			grouped[tbl].forEach(g => {
				rows += `<tr><td>${g.name}</td><td>${g.meal || 'Standard'}</td></tr>`;
			});

			tablesHtml += `
				<h3 style="color:#1e3a8a; margin-top:20px; border-bottom:1px solid #ccc; padding-bottom:4px;">Tisch: ${tbl} (${grouped[tbl].length} Gäste)</h3>
				<table style="width:100%; border-collapse:collapse; margin-bottom:15px; font-size:12px;">
					<thead><tr style="background:#f2f2f2;"><th style="border:1px solid #ccc; padding:6px; text-align:left;">Gastname</th><th style="border:1px solid #ccc; padding:6px; text-align:left;">Menüwahl</th></tr></thead>
					<tbody>${rows}</tbody>
				</table>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Hochzeits-Tischliste & Menüübersicht</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 13px; margin-bottom: 20px; }
					th { border: 1px solid #ccc; padding: 6px; }
					td { border: 1px solid #ccc; padding: 6px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Offizielle Tisch- & Menüübersicht</h1>
				<p>Erstellt am ${new Date().toLocaleDateString('de-DE')} | Erfasste Gäste: <strong>${seatedGuestList.length}</strong></p>
				${tablesHtml}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeits_Tischliste_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print Cards
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('de-DE');
		document.getElementById('print-guest-count').textContent = seatedGuestList.length;

		const grid = document.getElementById('print-cards-grid');
		grid.innerHTML = '';

		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;

		seatedGuestList.forEach(g => {
			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 25px 15px; text-align: center; font-family: 'Georgia', serif; position: relative; height: 130px; box-sizing: border-box;`;
			card.innerHTML = `
				<h2 style="font-size: 20px; margin: 10px 0 5px 0;">${g.name}</h2>
				<div style="width: 30px; height: 1px; background: #000; margin: 5px auto;"></div>
				${showTable ? `<p style="font-size: 13px; font-weight: bold; margin: 5px 0 0 0; text-transform: uppercase;">Tisch ${g.table}</p>` : ''}
				${showMeal ? `<span style="position: absolute; bottom: 8px; right: 10px; font-size: 16px;">${g.meal ? g.meal.split(' ')[0] : '🥩'}</span>` : ''}
			`;
			grid.appendChild(card);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Gastname;Tischnummer;Menue\n";
		seatedGuestList.forEach(g => {
			csv += `"${g.name}";"Tisch ${g.table}";"${g.meal || 'Standard'}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeits_Platzkarten_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	loadSeatedGuests();
</script>
