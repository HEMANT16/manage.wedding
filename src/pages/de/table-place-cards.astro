---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/table-place-cards/#webapp",
      "name": "Hochzeits-Platzkarten & Tischnummern Generator | Manage.Wedding",
      "url": "https://manage.wedding/de/table-place-cards",
      "inLanguage": "de",
      "description": "Kostenloser Platzkarten- und Tischnummern-Generator für Ihre Hochzeit. Erstellen Sie druckfertige Klappkarten mit Menü-Icons, flache Namenskarten und Tischnummern mit PDF-, Word- und CSV-Export.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "Article",
      "headline": "Hochzeits-Platzkarten & Tischnummern Leitfaden: Maße, Papiergewichte & Catering-Symbole",
      "description": "Erfahren Sie den Unterschied zwischen Tischkarten und Sitzplan, ideale Papierstärken, Rilltechniken und die Platzierung von Menü-Icons für die Servicekräfte.",
      "inLanguage": "de",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie formatiert, druckt und faltet man Hochzeits-Platzkarten und Tischnummern?",
      "description": "Schritt-für-Schritt-Anleitung zur Auswahl des Kartenformats, Einbindung von Menü-Symbolen fürs Catering und zum sauberen Drucken auf schwerem Feinpapier.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Kartenformat und Design-Rahmen wählen",
          "text": "Wählen Sie zwischen selbststehenden Klappkarten (9 × 5 cm gefaltet), flachen Tischkarten für Kartenhalter oder Aufstellern für Tischnummern."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Tische & Catering-Menü-Icons zuweisen",
          "text": "Verknüpfen Sie jeden Gastnamen mit der Tischnummer und dem Menüsymbol (Rind, Geflügel, Fisch, Vegetarisch) für das Servicepersonal."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Auf 220 bis 300 g/m² Feinkarton drucken",
          "text": "Laden Sie die druckfertige PDF-Vorlage herunter und drucken Sie die Bögen auf festem Kartonpapier oder im lokalen Copyshop."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Rillen, schneiden und alphabetisch sortieren",
          "text": "Nutzen Sie ein Schneidelineal, falzen Sie die Klappkarten mittig und sortieren Sie die Kärtchen für den Tag der Hochzeit tischweise vor."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Was ist der Unterschied zwischen Tischkarten (Escort Cards) und Platzkarten (Place Cards)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die Tischkarte am Saaleingang weist dem Gast seinen Gesamttisch zu. Die Platzkarte steht direkt am Teller auf dem Stuhl und signalisiert dem Servicepersonal die gewählte Speise."
          }
        },
        {
          "@type": "Question",
          "name": "Welches Papiergewicht eignet sich am besten für Hochzeits-Klappkärtchen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Empfohlen wird Feinkarton zwischen 250 g/m² und 300 g/m² mit matter oder gerippter Leinenstruktur für stabilen Stand ohne Umknicken."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele Platzkarten passen auf einen A4-Bogen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei Klappkarten (9x10 cm offen) passen genau 4 Kärtchen auf einen A4-Bogen. Bei flachen Kärtchen (9x5 cm) passen 8 bis 10 Stück. Bei Tischnummern (13x18 cm) passen genau 2 Aufsteller pro Bogen."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Hochzeits-Platzkarten & Tischnummern Generator (Kostenloses PDF) | Manage.Wedding"
	description="Erstellen und drucken Sie Klappkarten mit Menü-Icons, flache Tischkarten und Tischnummern für Ihre Hochzeit. Schneller PDF-, Word- und CSV-Export."
	schema={schema}
>
	<!-- Include Google Wedding Typography Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

	<!-- Include html2canvas for preview card capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Platzkarten-Generator" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Platzkarten & Tischnummern Generator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Erstellen Sie druckfertige Klappkarten, flache Tischkarten und Tischnummern. Mit <strong>Catering-Menü-Icons</strong>, stilvollen Rahmenmotiven und <strong>druckfertigem PDF-Export</strong> oder <strong>Word (.doc)</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Druckfertige Platzkarten in 3 einfachen Schritten
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Format & Rahmen wählen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Wählen Sie Klappkarten (9x5 cm gefaltet), flache Tischkarten oder große Tischnummern-Aufsteller.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Tische & Menü-Icons zuweisen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Fügen Sie Gäste hinzu und aktivieren Sie Speise-Symbole (Rind, Geflügel, Fisch, Vegetarisch) fürs Catering.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ PDF & Word-Manifest exportieren
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Klicken Sie auf <strong>"🖨️ PDF exportieren / Drucken"</strong> oder <strong>"📝 Word exportieren (.doc)"</strong> für die Serviceleitung.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="placecards-calc-grid">
			
			<!-- Left Column -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🏷️ Layout- & Styling-Optionen
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Passen Sie Kartenformat, florale Motive und Tischzuweisungen an
					</span>
				</div>

				<form id="placecards-form" style="display: flex; flex-direction: column; gap: 1.2rem;">
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;">
						<div>
							<label for="select-card-type" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-red); margin-bottom: 0.35rem;">
								Kartenformat *
							</label>
							<select id="select-card-type" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 6px; background: #fff; font-family: var(--font-body); font-size: 0.92rem; font-weight: 600; cursor: pointer;">
								<option value="tent" selected>🏷️ Klappkarten zum Hinstellen (9x5 cm)</option>
								<option value="flat">🎴 Flache Tischkärtchen (9x5 cm)</option>
								<option value="tablenum">🔢 Tischnummern-Aufsteller (13x18 cm)</option>
							</select>
						</div>

						<div>
							<label for="select-border-theme" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-blue); margin-bottom: 0.35rem;">
								Rahmen-Design *
							</label>
							<select id="select-border-theme" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 6px; background: #fff; font-family: var(--font-body); font-size: 0.92rem; font-weight: 600; cursor: pointer;">
								<option value="botanical" selected>🌿 Botanischer Blatt-Rahmen</option>
								<option value="classic">✒️ Klassische Doppellinie</option>
								<option value="crest">🏛️ Elegante Ornamente & Gold-Wappen</option>
							</select>
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 6px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block;">
							⚙️ Platzkarten-Anpassungen
						</span>
						<div style="display: flex; gap: 1.25rem; flex-wrap: wrap;">
							<label style="font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-meal-icons" checked style="accent-color: var(--brand-primary, #dc2626); width: 16px; height: 16px;">
								<span>Menü-Symbole anzeigen (🥩 / 🐟 / 🥦)</span>
							</label>
							<label style="font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-table-badge" checked style="accent-color: var(--brand-primary, #dc2626); width: 16px; height: 16px;">
								<span>Tischnummer anzeigen</span>
							</label>
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
							<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">
								👥 Gästeliste: <strong id="assigned-count-badge" style="color: var(--accent-red);">1 Gast</strong>
							</span>
							<div style="display: flex; gap: 0.4rem;">
								<button type="button" id="btn-load-samples" class="hand-btn" style="padding: 0.3rem 0.65rem; font-size: 0.8rem; background: #eff6ff;">
									✨ Beispiel laden
								</button>
								<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.3rem 0.65rem; font-size: 0.8rem; color: #b91c1c;">
									🗑️ Alles leeren
								</button>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1.4fr 0.8fr 0.9fr auto; gap: 0.4rem; align-items: center;">
							<input type="text" id="input-new-guest-name" placeholder="Name (z.B. Maximilian Schmidt)" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; font-family: var(--font-body);">
							<input type="text" id="input-new-table-num" placeholder="Tisch #" value="1" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; font-family: var(--font-body);">
							<select id="select-new-meal" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; background: #fff; font-family: var(--font-body);">
								<option value="🥩 Rind">🥩 Rind</option>
								<option value="🍗 Geflügel">🍗 Geflügel</option>
								<option value="🐟 Fisch">🐟 Fisch</option>
								<option value="🥦 Vegetarisch">🥦 Vegetarisch</option>
								<option value="🌱 Vegan">🌱 Vegan</option>
							</select>
							<button type="button" id="btn-add-guest" class="hand-btn" style="padding: 0.5rem 0.85rem; font-size: 0.88rem; background: var(--brand-primary, #dc2626); color: #fff;">
								+ Hinzufügen
							</button>
						</div>
					</div>
				</form>
			</div>

			<!-- Right Column: Live Card Preview -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖼️ Live-Vorschau der Platzkarte
							</h3>
							<span id="preview-scale-label" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Klappkarte (9x5 cm Vorderansicht)
							</span>
						</div>

						<div style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.75rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.88rem; background: #eff6ff;">
								📝 Word exportieren (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.88rem; background: #fef2f2; color: var(--accent-red); font-weight: 700;">
								🖨️ PDF exportieren / Drucken
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.75rem; font-size: 0.88rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<div style="display: flex; justify-content: center; align-items: center; padding: 1.25rem 0; min-height: 240px; background: #f1f5f9; border-radius: 8px; border: 1.5px dashed #cbd5e1; margin-bottom: 1.25rem; overflow: hidden;">
						<div id="preview-placecard-canvas" class="card-format-tent theme-botanical"></div>
					</div>

					<button type="button" id="btn-download-sample-png" class="hand-btn" style="width: 100%; text-align: center; font-size: 0.95rem; padding: 0.6rem; background: #f0fdf4; border: 1.5px solid var(--fg-pencil);">
						📸 Muster-Platzkarte als PNG speichern
					</button>
				</div>

				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 420px; overflow-y: auto;">
					<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						📋 Zugewiesene Gäste nach Tisch <small style="font-size: 0.8rem; font-weight: normal; color: var(--text-secondary);">(Klicken für Vorschau)</small>
					</h3>
					<div id="table-cards-stream" style="display: flex; flex-direction: column; gap: 0.75rem;"></div>
				</div>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Schnelle Faustregeln für Maße & Papiergewichte (BLUF)
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					1-Minuten Spezifikationen
				</span>
			</div>
			
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Standard-Maße der Hochzeitspapeterie:</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Klappkarten = 9 × 5 cm (4 pro A4-Bogen)</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Flache Tischkarten = 9 × 5 cm (8–10 pro Bogen)</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Tischnummern = 13 × 18 cm (2 pro Bogen)</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Papiergewicht & Lesbarkeit:</strong> Auf <strong>250g bis 300g (GSM) Feinkarton</strong> drucken. Schriftgröße <strong>16–20pt</strong> für Namen, <strong>12–14pt</strong> für Tischnummern und <strong>14–18px Menü-Icons</strong> für die Kellner.
				</p>
			</div>

			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Papeterie-Element</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Endformat</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Pro A4-Bogen</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Empfohlenes Papier</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Schriftgrößen</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Platzierung</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Klappkarte (Zeltform)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">9 × 5 cm (Gefaltet)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">4 Karten (Offen: 9×10 cm)</td>
