<script is:inline>
	let guestList = [];

	const couplesNamesInput = document.getElementById('input-couples-names');
	const weddingDateInput = document.getElementById('input-wedding-date');
	const weddingLocationInput = document.getElementById('input-wedding-location');
	const rsvpDeadlineInput = document.getElementById('input-rsvp-deadline');
	const dressCodeSelect = document.getElementById('input-dress-code');
	const rsvpLinkInput = document.getElementById('input-rsvp-link');
	const weddingMessageInput = document.getElementById('input-wedding-message');
	const cardThemeSelect = document.getElementById('select-card-theme');

	// Preview Elements
	const prevGuestName = document.getElementById('prev-guest-name');
	const prevCouplesNames = document.getElementById('prev-couples-names');
	const prevWeddingDate = document.getElementById('prev-wedding-date');
	const prevWeddingLocation = document.getElementById('prev-wedding-location');
	const prevWeddingMessage = document.getElementById('prev-wedding-message');
	const prevDressCode = document.getElementById('prev-dress-code');
	const prevRsvpDeadline = document.getElementById('prev-rsvp-deadline');
	const prevRsvpLink = document.getElementById('prev-rsvp-link');
	const previewCard = document.getElementById('preview-invite-card');

	const guestCountBadge = document.getElementById('guest-count-badge');
	const invitesStreamContainer = document.getElementById('invites-stream-container');

	const chkIncludeGuestName = document.getElementById('chk-include-guest-name');

	function loadGuests() {
		try {
			const saved = localStorage.getItem('manage_wedding_guests_de');
			if (saved) {
				guestList = JSON.parse(saved);
			}
		} catch (e) {
			guestList = [];
		}

		if (!guestList || guestList.length === 0) {
			guestList = [
				{ name: "Sophie & Maximilian Weber", group: "Brautfamilie" },
				{ name: "Dr. Thomas Meyer", group: "Bräutigamfamilie" },
				{ name: "Elena Schulz", group: "Trauzeugen / VIP" },
				{ name: "Tobias & Sarah Wagner", group: "Freundeskreis" }
			];
		}
		renderAll();
	}

	function renderAll() {
		const names = couplesNamesInput.value || 'Sophie & Maximilian';
		const date = weddingDateInput.value || 'Samstag, 17. Oktober 2026 um 15:30 Uhr';
		const location = weddingLocationInput.value || 'Gutshof am See, Schlossallee 12, 82319 Starnberg';
		const rsvpDeadline = rsvpDeadlineInput.value || '15. August 2026';
		const dressCode = dressCodeSelect.value || 'Festlich Elegant';
		const rsvpLink = rsvpLinkInput.value || 'https://manage.wedding/de/rsvp-tracker';
		const msg = weddingMessageInput.value || 'Wir freuen uns darauf, diesen Tag bei Sektempfang, Dinner und Tanz mit euch zu feiern!';
		const theme = cardThemeSelect.value || 'classic';
		const isPersonalized = chkIncludeGuestName.checked;

		// Update Preview Card
		prevCouplesNames.textContent = names;
		prevWeddingDate.textContent = date;
		prevWeddingLocation.textContent = location;
		prevRsvpDeadline.textContent = rsvpDeadline;
		prevDressCode.textContent = dressCode;
		prevRsvpLink.textContent = `Rückmeldung (RSVP): ${rsvpLink}`;
		prevWeddingMessage.textContent = msg ? `„${msg}“` : '';

		if (isPersonalized && guestList.length > 0) {
			prevGuestName.style.display = 'block';
			if (!prevGuestName.textContent.startsWith('Liebe(r) ') && !prevGuestName.textContent.startsWith('Liebe ')) {
				prevGuestName.textContent = `Liebe(r) ${guestList[0].name},`;
			}
		} else {
			prevGuestName.style.display = 'none';
		}

		previewCard.className = `theme-${theme}`;

		// Guest Count
		guestCountBadge.textContent = `${guestList.length} Gäste`;

		// Stream rendering
		invitesStreamContainer.innerHTML = '';
		if (guestList.length === 0) {
			invitesStreamContainer.innerHTML = `
				<div style="text-align: center; padding: 1rem; color: var(--text-secondary); font-style: italic; font-size: 0.9rem;">
					Keine einzelnen Gäste erfasst. Die Karte befindet sich im <strong>Universellen Modus</strong> (ideal für WhatsApp-Gruppen oder Social Media).
				</div>
			`;
		} else {
			guestList.forEach((guest, idx) => {
				const item = document.createElement('div');
				item.style.cssText = `display: flex; justify-content: space-between; align-items: center; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem 0.75rem;`;
				item.innerHTML = `
					<div>
						<strong class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">${guest.name}</strong>
						<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">${guest.group || 'Gast'}</span>
					</div>
					<div style="display: flex; gap: 0.25rem;">
						<button type="button" class="btn-preview-guest hand-btn" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #eff6ff;" title="Karte ansehen">
							👁️ Zeigen
						</button>
						<button type="button" class="btn-download-guest hand-btn" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #f0fdf4;" title="Als PNG laden">
							📸 PNG
						</button>
						<button type="button" class="btn-delete-guest hand-btn secondary" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; color: #b91c1c;" title="Gast entfernen">
							🗑️ Del
						</button>
					</div>
				`;
				invitesStreamContainer.appendChild(item);
			});
		}

		// Attach Guest Listeners
		document.querySelectorAll('.btn-preview-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				if (guestList[idx]) {
					chkIncludeGuestName.checked = true;
					prevGuestName.style.display = 'block';
					prevGuestName.textContent = `Liebe(r) ${guestList[idx].name},`;
				}
			});
		});

		document.querySelectorAll('.btn-download-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				if (guestList[idx]) {
					chkIncludeGuestName.checked = true;
					prevGuestName.style.display = 'block';
					prevGuestName.textContent = `Liebe(r) ${guestList[idx].name},`;
					captureCardPNG(guestList[idx].name);
				}
			});
		});

		document.querySelectorAll('.btn-delete-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				guestList.splice(idx, 1);
				renderAll();
			});
		});
	}

	function captureCardPNG(filenamePrefix) {
		if (window.html2canvas) {
			window.html2canvas(previewCard, {
				scale: 3,
				backgroundColor: null,
				useCORS: true
			}).then(canvas => {
				const link = document.createElement('a');
				const safeName = (filenamePrefix || 'hochzeitseinladung').replace(/[^a-z0-9]/gi, '_').toLowerCase();
				link.download = `Einladung_${safeName}.png`;
				link.href = canvas.toDataURL("image/png");
				link.click();
			});
		} else {
			alert("Canvas-Modul lädt noch. Bitte in Kürze erneut versuchen.");
		}
	}

	// Quick Add Guest
	document.getElementById('btn-quick-add-guest').addEventListener('click', () => {
		const input = document.getElementById('input-quick-add-guest');
		const val = input.value.trim();
		if (val) {
			guestList.push({ name: val, group: 'Hinzugefügt' });
			input.value = '';
			renderAll();
		}
	});

	// Clear All Guests
	document.getElementById('btn-clear-all-guests').addEventListener('click', () => {
		guestList = [];
		renderAll();
	});

	// Load Sample Guests
	document.getElementById('btn-load-sample-guests').addEventListener('click', () => {
		guestList = [
			{ name: "Sophie & Maximilian Weber", group: "Brautfamilie" },
			{ name: "Dr. Thomas Meyer", group: "Bräutigamfamilie" },
			{ name: "Elena Schulz", group: "Trauzeugen / VIP" },
			{ name: "Tobias & Sarah Wagner", group: "Freundeskreis" }
		];
		chkIncludeGuestName.checked = true;
		renderAll();
	});

	// Inputs Listener
	[couplesNamesInput, weddingDateInput, weddingLocationInput, rsvpDeadlineInput, dressCodeSelect, rsvpLinkInput, weddingMessageInput, cardThemeSelect, chkIncludeGuestName].forEach(el => {
		el.addEventListener('input', renderAll);
		el.addEventListener('change', renderAll);
	});

	document.getElementById('btn-download-sample-png').addEventListener('click', () => {
		captureCardPNG('Muster_Einladung');
	});

	// 📝 Export Word Messages (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let sections = '';
		guestList.forEach(guest => {
			sections += `
				<div style="margin-bottom: 25px; padding: 15px; border: 1px solid #ccc; background: #fafafa;">
					<h3 style="margin: 0 0 8px 0; color: #1e3a8a;">Personalisierter Einladungstext für: ${guest.name}</h3>
					<p style="margin: 0; font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; line-height: 1.5; color: #333;">
						„Liebe(r) ${guest.name}, ${couplesNamesInput.value} laden euch herzlich zu ihrer Hochzeit am ${weddingDateInput.value} im ${weddingLocationInput.value} ein! Dresscode: ${dressCodeSelect.value}. Bitte seht euch eure persönliche Einladungskarte an und gebt uns bis zum ${rsvpDeadlineInput.value} hier Bescheid: ${rsvpLinkInput.value}“
					</p>
				</div>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Hochzeitseinladungen — WhatsApp- & Nachrichtentexte</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Digitale Einladungstexte</h1>
				<p>Erstellt am ${new Date().toLocaleDateString('de-DE')} | Brautpaar: <strong>${couplesNamesInput.value}</strong> | Gäste: <strong>${guestList.length}</strong></p>
				
				<h2>Versandfertige WhatsApp- & SMS-Nachrichten:</h2>
				${sections}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeits_Einladungstexte_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print All
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('de-DE');
		document.getElementById('print-couple').textContent = couplesNamesInput.value;

		const grid = document.getElementById('print-invites-grid');
		grid.innerHTML = '';

		guestList.forEach(guest => {
			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 20px; text-align: center; font-family: 'Georgia', serif; margin-bottom: 15px;`;
			card.innerHTML = `
				<p style="font-size: 10px; letter-spacing: 2px; text-transform: uppercase; margin: 0 0 5px 0;">Wir heiraten!</p>
				<h3 style="font-size: 18px; margin: 0 0 10px 0;">Liebe(r) ${guest.name},</h3>
				<p style="font-size: 12px; margin: 0 0 5px 0;">Wir laden euch herzlich ein zur Hochzeit von</p>
				<h2 style="font-size: 26px; margin: 0 0 10px 0;">${couplesNamesInput.value}</h2>
				<p style="font-size: 14px; font-weight: bold; margin: 10px 0 5px 0;">${weddingDateInput.value}</p>
				<p style="font-size: 12px; color: #444; margin: 0 0 10px 0;">${weddingLocationInput.value}</p>
				<p style="font-size: 11px; margin: 0;">Dresscode: ${dressCodeSelect.value} | Rückmeldung: ${rsvpLinkInput.value}</p>
			`;
			grid.appendChild(card);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Gastname;Gruppe;RSVP_Link;Status\n";
		guestList.forEach(guest => {
			csv += `"${guest.name}";"${guest.group || 'Allgemein'}";"${rsvpLinkInput.value}";"Einladung bereit"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeits_Einladungen_Liste_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	loadGuests();
</script>
