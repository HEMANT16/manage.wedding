---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/liquor-wedding-calculator/#webapp",
      "name": "Spirituosen- & Schnapsrechner Hochzeit | Bar-Mengenplaner & Einkaufsliste",
      "url": "https://manage.wedding/de/liquor-wedding-calculator",
      "inLanguage": "de",
      "description": "Kalkulieren Sie den genauen Bedarf an Spirituosen (Wodka, Gin, Rum, Whiskey, Tequila), Wein, Bier, Fillern, Garnituren und Eiswürfeln für Ihre Hochzeitsbar mit praktischer Einkaufsliste und Kommissionskauf-Tipps.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie berechnet man Spirituosen und Cocktails für eine Hochzeitsbar?",
      "description": "Schritt-für-Schritt-Anleitung zur präzisen Mengenplanung von Flaschen, Mixgetränken, Eis und Garnituren für die Hochzeitsfeier.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Gästezahl & Bar-Dauer festlegen",
          "text": "Tragen Sie die Anzahl der erwachsenen Gäste (ab 18 Jahren) sowie die Dauer des Barbetriebs ein (Standard: 4 bis 6 Stunden, 1 Drink pro Person und Stunde)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Getränkeverteilung (Wein, Bier, Longdrinks/Cocktails) anpassen",
          "text": "Wählen Sie das Trinkverhalten Ihrer Hochzeitsgesellschaft (Klassisch: 40% Wein/Sekt, 40% Spirituosen/Longdrinks, 20% Bier; Cocktail-Fokus: 50% Cocktails, 30% Wein, 20% Bier)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Spirituosenarten für Signature-Drinks abstimmen",
          "text": "Passen Sie die Anteile für Gin, Wodka, Whiskey/Bourbon, Rum und Tequila passend zu Ihren Wunsch-Cocktails (z. B. Gin Tonic, Moscow Mule, Aperol Spritz) an."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Detaillierte Einkaufsliste & Kostenschätzung exportieren",
          "text": "Erhalten Sie die exakten Flaschenzahlen (0,75l / 1,0l), Filler-Mengen, Zitrusfrüchte, Eisbedarf in Kilogramm sowie eine geschätzte Budgetkalkulation für den Getränkemarkt."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie viele Drinks ergibt eine 0,75l Flasche Spirituosen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eine Standardflasche (0,75 Liter bzw. 750 ml) ergibt bei einer typischen Dosierung von 4 cl (40 ml) ca. 18 Longdrinks oder Cocktails. Bei kleineren 2 cl Shots reicht eine Flasche für etwa 37 Portionen."
          }
        },
        {
          "@type": "Question",
          "name": "Welche Spirituosen gehören zur Grundausstattung einer Hochzeitsbar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die bewährte Faustformel für den deutschen Sprachraum: Gin (30%), Wodka (25%), Whiskey/Bourbon (20%), Rum (15%) und Tequila oder Liköre wie Aperol/Limoncello (10%)."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel Eiswürfel und Crushed Ice benötigt man für die Bar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kalkulieren Sie mindestens 1,0 kg Eis pro Gast für eine Bar mit Cocktails und Longdrinks. Das Eis wird sowohl zum Shaken und Kühlen im Glas als auch für Weinkühler und Sektkübel benötigt."
          }
        },
        {
          "@type": "Question",
          "name": "Wie funktioniert der Kommissionskauf beim Getränkefachhandel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Beim Kauf auf Kommission bestellen Sie etwa 20–30% mehr Getränke als Puffer. Ungeöffnete und unbeschädigte Flaschen sowie volle Bierkästen können nach der Hochzeit einfach zurückgegeben werden – Sie bezahlen nur, was tatsächlich getrunken wurde."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Spirituosen- & Schnapsrechner Hochzeit | Bar-Mengenplaner & Einkaufsliste"
	description="Kalkulieren Sie den genauen Bedarf an Spirituosenflaschen (Gin, Wodka, Rum, Whiskey), Wein, Bierkästen, Fillern, Garnituren und Eis in kg für Ihre Hochzeitsbar. Inklusive Word/PDF-Einkaufsliste."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Spirituosen- & Schnapsrechner" category="dining" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Bar-Planung, Longdrinks & Cocktails</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Spirituosen- & Schnapsrechner <span class="accent-italic">für die Hochzeitsbar</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Berechnen Sie exakte Flaschenmengen für Gin, Wodka, Whiskey, Rum und Tequila – inklusive passender Filler (Tonic, Cola, Soda), frischer Zitrusfrüchte und Eiswürfel für Ihre Hochzeitsfeier.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Inputs & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Gästezahl & Bar-Konzept
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Echtzeit-Kalkulation
					</span>
				</div>

				<!-- Signature Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="bar-preset">Bar-Typ & Getränke-Schwerpunkt</label>
					<select id="bar-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="classic-open-bar" selected>🍸 Klassische Hochzeitsbar (40% Wein/Sekt, 40% Longdrinks, 20% Bier)</option>
						<option value="cocktail-heavy">🍹 Cocktail-Party & Tanzabend (50% Cocktails/Longdrinks, 30% Wein, 20% Bier)</option>
						<option value="gin-whiskey-focus">🌿 Gin Tonic & Whiskey Bar (Fokus auf Premium Longdrinks)</option>
						<option value="beer-wine-light-liquor">🍺 Bier & Wein Schwerpunkt (45% Wein, 35% Bier, 20% Spirituosen)</option>
						<option value="custom">✏️ Individuelle Prozentverteilung</option>
					</select>
				</div>

				<!-- Guest Count & Duration -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="guests">Erwachsene Gäste (18+)</label>
						<input type="number" id="guests" class="form-input" value="100" min="10" max="600" step="5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
					<div>
						<label class="form-label" for="hours">Bar-Dauer (Stunden)</label>
						<input type="number" id="hours" class="form-input" value="5" min="1" max="12" step="0.5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
				</div>

				<!-- Crowd Drinking Vibe & Bottle Size Format -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="vibe">Trinkfreude der Gäste</label>
						<select id="vibe" class="form-input" style="cursor: pointer;">
							<option value="light">Zurückhaltend (-25% Drinks)</option>
							<option value="average" selected>Normal (1 Drink / Std.)</option>
							<option value="heavy">Feierfreudig / Party (+25% Drinks)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="bottle-size">Flaschengröße Spirituosen</label>
						<select id="bottle-size" class="form-input" style="cursor: pointer; font-weight: 600;">
							<option value="750" selected>Standard 0,75l / 0,7l (ca. 18 Drinks)</option>
							<option value="1000">1,0l Gastroflaschen (ca. 25 Drinks)</option>
						</select>
					</div>
				</div>

				<!-- Category Preference Sliders (Beer / Wine / Liquor) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil);">
							Getränkekategorien (%)
						</strong>
						<span id="sum-pref-check" style="font-size: 0.82rem; font-weight: 700; color: #16a34a; background: #f0fdf4; padding: 2px 6px; border-radius: 4px;">
							Gesamt: 100%
						</span>
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍷 Wein & Schaumwein</span>
							<span id="val-pref-wine">40%</span>
						</div>
						<input type="range" id="pref-wine" min="0" max="100" value="40" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍸 Spirituosen & Longdrinks</span>
							<span id="val-pref-liquor">40%</span>
						</div>
						<input type="range" id="pref-liquor" min="0" max="100" value="40" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍺 Bier & Craft Beer</span>
							<span id="val-pref-beer">20%</span>
						</div>
						<input type="range" id="pref-beer" min="0" max="100" value="20" style="width: 100%; cursor: pointer;" />
					</div>
				</div>

				<!-- Spirit Type Allocation Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.75rem;">
						Spirituosen-Aufteilung (%)
					</strong>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌿 Gin (Gin Tonic, Basil Smash)</span>
							<span id="val-liq-gin">30%</span>
						</div>
						<input type="range" id="liq-gin" min="0" max="100" value="30" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍸 Wodka (Moscow Mule, Wodka Lemon)</span>
							<span id="val-liq-vodka">25%</span>
						</div>
						<input type="range" id="liq-vodka" min="0" max="100" value="25" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🥃 Whiskey / Bourbon (Old Fashioned, Cola)</span>
							<span id="val-liq-whiskey">20%</span>
						</div>
						<input type="range" id="liq-whiskey" min="0" max="100" value="20" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌴 Rum (Mojito, Cuba Libre, Dark & Stormy)</span>
							<span id="val-liq-rum">15%</span>
						</div>
						<input type="range" id="liq-rum" min="0" max="100" value="15" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌵 Tequila & Liköre (Margarita, Shots, Aperol)</span>
							<span id="val-liq-tequila">10%</span>
						</div>
						<input type="range" id="liq-tequila" min="0" max="100" value="10" style="width: 100%; cursor: pointer;" />
					</div>
				</div>

				<!-- Champagne / Sektempfang Option -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.95rem; font-weight: 600;">
						<input type="checkbox" id="check-champagne-toast" checked style="width: 18px; height: 18px;" />
						<span>Sektempfang / Brauttoast einrechnen (+1 Glas Sekt/Gast)</span>
					</label>
				</div>

			</div>

			<!-- Right Column: Results & Shopping List -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Primary Results Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Gesamtbedarf an Getränken
						</span>
						<span id="vibe-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							Standard
						</span>
					</div>

					<div id="res-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						500 Drinks
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.25rem 0;">
						Kalkuliert für <strong id="res-guest-count-label" style="color: var(--fg-pencil);">100 Gäste</strong> bei <strong id="res-hours-label" style="color: var(--fg-pencil);">5 Stunden</strong> Barbetrieb.
					</p>

					<!-- Visual Split Bar -->
					<div style="display: flex; height: 28px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; margin-bottom: 1.5rem; font-size: 0.82rem; font-weight: 800; color: #fff; text-align: center; line-height: 28px;">
						<div id="chart-wine" style="background-color: var(--accent-red); width: 40%; transition: width 0.2s;">Wein (40%)</div>
						<div id="chart-liquor" style="background-color: var(--fg-pencil); width: 40%; transition: width 0.2s;">Spirituosen (40%)</div>
						<div id="chart-beer" style="background-color: var(--accent-blue); width: 20%; transition: width 0.2s;">Bier (20%)</div>
					</div>

					<!-- Estimated Retail Cost Callout -->
					<div style="background: #fdf6e2; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
						<div>
							<strong style="display: block; font-size: 0.92rem; color: var(--fg-pencil);">Geschätztes Einkaufsbudget (Handel/Getränkemarkt):</strong>
							<span style="font-size: 0.82rem; color: #64748b;">(Durchschnittliche Einzelhandelspreise inkl. MwSt.)</span>
						</div>
						<span id="res-est-cost" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red); font-weight: 800;">
							1.420 €
						</span>
					</div>

					<!-- Itemized Shopping List Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Spirits Section -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin-bottom: 0.6rem;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🥃 Spirituosen (<span id="bottle-size-label">0,75l Flaschen</span>)
							</strong>
							<strong id="res-total-liquor-bottles" style="color: var(--accent-red);">12 Flaschen</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Gin:</span>
							<strong id="res-gin">4 Fl.</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Wodka:</span>
							<strong id="res-vodka">3 Fl.</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Whiskey / Bourbon:</span>
							<strong id="res-whiskey">3 Fl.</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Rum (weiß / dunkel):</span>
							<strong id="res-rum">2 Fl.</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Tequila / Liköre (z.B. Aperol):</span>
							<strong id="res-tequila">1 Fl.</strong>
						</div>

						<!-- Wine & Beer Section -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin: 1rem 0 0.6rem 0;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🍷 Wein, Sekt & Bier
							</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Tischwein (0,75l Flaschen):</span>
							<strong id="res-wine">40 Fl. (22 Rot / 18 Weiß)</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Bier (24er-Kästen à 0,33l):</span>
							<strong id="res-beer">5 Kästen (120 Flaschen)</strong>
						</div>
						<div id="row-champagne" style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Sektempfang / Toast (0,75l):</span>
							<strong id="res-champagne" style="color: var(--accent-red);">17 Flaschen Sekt</strong>
						</div>

						<!-- Mixers & Garnishes -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin: 1rem 0 0.6rem 0;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🍋 Filler, Garnituren & Eis
							</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Filler & Softdrinks (Tonic, Cola, Ginger Beer, Soda):</span>
							<strong id="res-mixers">25 Flaschen (à 1,5l)</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Frische Zitrusfrüchte & Garnituren:</span>
							<strong id="res-garnishes">30 Limetten • 18 Zitronen • 12 Orangen</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem;">
							<span>Eiswürfel & Crushed Ice:</span>
							<strong id="res-ice">100 kg (ca. 20 Säcke à 5 kg)</strong>
						</div>

					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-shopping-list" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Einkaufsliste drucken (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Word-Export (.doc)
						</button>
					</div>

				</div>

				<!-- Bartending Pro Tip Callout -->
