---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-processional-order/#webapp",
      "name": "Einzug & Ablauf Trauzeremonie Planer | Manage.Wedding",
      "url": "https://manage.wedding/de/wedding-processional-order",
      "inLanguage": "de",
      "description": "Kostenloser Planer für die Reihenfolge beim Einzug und Auszug der Hochzeit. Individuelle Aufstellungen für Freie Trauung, Standesamt, kirchliche Trauung (evangelisch/katholisch) und moderne Zeremonien.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie plant man die Reihenfolge beim Einzug und Auszug der Trauung?",
      "description": "Schritt-für-Schritt-Anleitung für den feierlichen Einzug in die Kirche oder den freien Trauort mit optimalen Abständen und Musikwechseln.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Platzierung von Großeltern & Eltern",
          "text": "Die Großeltern und Eltern des Bräutigams sowie die Brautmutter nehmen in den vorderen Reihen Platz, bevor die Trauzeugen einziehen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Einzug von Bräutigam, Trauredner & Trauzeugen",
          "text": "Der Bräutigam zieht gemeinsam mit dem Trauzeugen ein oder wartet mit dem Redner/Pfarrer bereits vorne am Altar."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Blumenkinder & Ringträger",
          "text": "Die Blumenkinder und der Ringträger schreiten mit 4 bis 6 Schritten Abstand direkt vor der Braut zum Altar."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Der Brauteinzug & Musikwechsel",
          "text": "Die Musik wechselt zum Brautlied. Die Braut zieht – geführt vom Brautvater, beiden Eltern oder Hand in Hand mit dem Bräutigam – feierlich ein."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wer zieht bei einer Hochzeit zuerst ein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditionell wartet der Bräutigam mit dem Pfarrer/Redner vorne am Altar oder zieht mit seiner Mutter/dem Trauzeugen zuerst ein. Es folgen die Brautjungfern, Blumenkinder und schließlich die Braut mit ihrem Begleiter."
          }
        },
        {
          "@type": "Question",
          "name": "Darf das Brautpaar gemeinsam einziehen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, absolut! In Deutschland und vielen europäischen Traditionen (auch in der evangelischen Kirche) ist der gemeinsame Einzug des Brautpaars Hand in Hand sehr verbreitet und symbolisiert den gemeinsamen Schritt in die Ehe auf Augenhöhe."
          }
        },
        {
          "@type": "Question",
          "name": "Auf welcher Seite steht oder sitzt die Braut am Altar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In der christlichen und weltlichen Tradition im deutschsprachigen Raum steht oder sitzt die Braut links (vom Altar aus gesehen rechts) und der Bräutigam rechts neben ihr."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Einzug & Ablauf Trauzeremonie Planer | Reihenfolge & Auszug"
	description="Kostenloser Planer für die Reihenfolge beim Einzug und Auszug der Trauung. Vorlagen für Freie Trauung, Standesamt, Evangelisch, Katholisch und Modern. Export als Spickzettel für Trauzeugen & Redner."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Einzug & Ablauf der Trauung" category="guests-logistics" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Spickzettel für Trauzeugen & Redner</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Einzug & Ablauf <span class="accent-italic">der Trauzeremonie</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Planen Sie die genaue Geh-Reihenfolge, Altarpositionen, Musik-Einsätze und den Auszug für Freie Trauung, Kirche oder Standesamt. Als Hosentaschen-Spickzettel drucken oder per WhatsApp teilen.
			</p>
		</header>

		<!-- Main Interactive Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Ceremony Configuration & Lineup Builder -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Trauungs-Konfiguration
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Ablauf-Vorlagen
					</span>
				</div>

				<!-- Tradition Selector -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="ceremony-tradition" style="font-weight: 700; font-size: 0.95rem;">Art der Trauung / Zeremonie</label>
					<select id="ceremony-tradition" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;">
						<option value="nondenom" selected>✨ Freie Trauung & Standesamt (Modern & Flexibel)</option>
						<option value="christian">⛪ Evangelische Trauung (Klassischer Einzug)</option>
						<option value="catholic">⛪ Katholische Traumesse (Liturgischer Einzug mit Pfarrer)</option>
						<option value="jewish">✡️ Jüdische Trauung (Unter der Chuppa)</option>
						<option value="lgbtq">🌈 Gemeinsamer Einzug / Symmetrische Trauung</option>
						<option value="minimalist">🌿 Intim & Minimalistisch (Kompakter Einzug / Elopement)</option>
					</select>
				</div>

				<!-- Mode Selector (Processional vs Recessional vs Altar) -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" style="font-weight: 700; margin-bottom: 0.5rem; display: block;">Phase der Zeremonie</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="phase-btn hand-btn is-active" data-phase="processional" style="padding: 8px; font-size: 0.9rem;">
							🚶‍♂️ 1. Feierlicher Einzug
						</button>
						<button type="button" class="phase-btn hand-btn" data-phase="recessional" style="padding: 8px; font-size: 0.9rem;">
							🎉 2. Auszug als Ehepaar
						</button>
					</div>
				</div>

				<!-- Couple Names -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;" class="form-group">
					<div>
						<label class="form-label" for="partner1-name" style="font-weight: 700; font-size: 0.95rem;">Partner 1 (Braut)</label>
						<input type="text" id="partner1-name" class="form-input" value="Sophie" placeholder="z. B. Sophie" style="width: 100%; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
					</div>
					<div>
						<label class="form-label" for="partner2-name" style="font-weight: 700; font-size: 0.95rem;">Partner 2 (Bräutigam)</label>
						<input type="text" id="partner2-name" class="form-input" value="Maximilian" placeholder="z. B. Maximilian" style="width: 100%; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
					</div>
				</div>

				<!-- Escort Selection -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="escort-style" style="font-weight: 700; font-size: 0.95rem;">Begleitung beim Einzug (Brautführung)</label>
					<select id="escort-style" class="form-input" style="cursor: pointer; width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;">
						<option value="father" selected>Geführt vom Brautvater</option>
						<option value="both-parents">Geführt von beiden Eltern (Mutter & Vater)</option>
						<option value="together">Brautpaar zieht gemeinsam Hand in Hand ein</option>
						<option value="mother">Geführt von der Brautmutter</option>
						<option value="sibling">Geführt von Geschwistern / Vertrauensperson</option>
						<option value="solo">Braut zieht alleine ein</option>
					</select>
				</div>

				<!-- Quick Add Custom Attendant -->
				<div class="form-group" style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label class="form-label" style="font-weight: 700; font-size: 0.95rem; display: block; margin-bottom: 0.4rem;">Weiteren Teilnehmer hinzufügen</label>
					<div style="display: flex; gap: 0.5rem;">
						<input type="text" id="custom-member-input" class="form-input" placeholder="z. B. Hund als Ringträger, Musiker" style="flex: 1; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
						<button id="btn-add-custom-member" type="button" class="hand-btn secondary" style="padding: 8px 14px; font-size: 0.9rem;">
							+ Hinzufügen
						</button>
					</div>
				</div>

			</div>

			<!-- Right Column: Interactive Lineup Cards & Coordinator Pocket Sheet -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Lineup Card Container -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 id="lineup-heading" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							1. Reihenfolge beim feierlichen Einzug
						</h3>
						<span id="lineup-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							7 Stationen | ca. 4–6 Schritte Abstand
						</span>
					</div>

					<!-- Visual Lineup Cards List -->
					<div id="lineup-list-container" style="display: flex; flex-direction: column; gap: 0.6rem; max-height: 520px; overflow-y: auto; padding-right: 4px;">
						<!-- Dynamic Step Rows Rendered Here -->
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-pocket-sheet" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Spickzettel drucken (PDF)
						</button>
						<button id="btn-export-text" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📲</span> Für WhatsApp kopieren
						</button>
					</div>

				</div>

				<!-- Music Transition & Timing Cue Box -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						🎵 Musik-Einsätze & Timing-Signale:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Lied 1 (Vorspiel & Einlass):</strong> Ruhiges Instrumentalstück beim Platznehmen der Gäste und Einzug der Trauzeugen.</li>
						<li><strong>Kurze Pause (10–15 Sek.):</strong> Türen schließen sich kurz, Gäste erheben sich von ihren Plätzen.</li>
						<li><strong>Lied 2 (Brauteinzug):</strong> Das Hauptlied beim Einzug der Braut bis zum Altar.</li>
						<li><strong>Lied 3 (Auszugslied):</strong> Schwungvolles, fröhliches Lied beim Auszug des frisch vermählten Paares.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Auf einen Blick (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Einzugs-Reihenfolge & Abstandsregeln
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Hier ist die Übersicht der Geh-Reihenfolge für den Einzug und den feierlichen Auszug.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					🚶‍♂️ Die Grundregel für Einzug & Auszug:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Einzug: [Gäste sitzen → Redner/Bräutigam am Altar → Trauzeugen → Blumenkinder/Ringträger → Braut mit Begleitung] • Auszug: [Ehepaar ZUERST → Blumenkinder → Trauzeugen → Eltern → Gäste].
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Zeremonie-Art</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Typischer Einzugsstil</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Sitzordnung Altar</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Besonderheit</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Freie Trauung / Standesamt</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Bräutigam wartet vorne; Braut zieht mit Vater oder Paar gemeinsam ein.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Braut LINKS, Bräutigam RECHTS</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Sehr flexibel mit eigener Musik & Ritualen</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Evangelische Trauung</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Pfarrer holt das Brautpaar am Kircheneingang ab; gemeinsamer Einzug.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Braut LINKS, Bräutigam RECHTS</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Pfarrer leitet den Einzug mit Glockengeläut</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Katholische Traumesse</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Liturgischer Einzug mit Pfarrer, Ministranten und Brautpaar.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Braut LINKS, Bräutigam RECHTS</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Festliche Liturgie mit Weihrauch & Orgel</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Der vollständige Leitfaden für den Trauungs-Einzug
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Abstände, Musikwechsel und Tipps für einen feierlichen Gang zum Altar ohne Stolpern.
				</p>
			</div>

			<!-- Section 1: Guide -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Die "Halbwegs-Regel" für Fotografen
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Der häufigste Fehler bei Trauungen: Die Beteiligten laufen zu schnell oder zu dicht hintereinander los.
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>📏 Die Halbwegs-Abstandsregel:</strong><br />
					Die nächste Person läuft erst los, wenn die vorausgehende Person mindestens die <strong>Hälfte des Mittelgangs</strong> erreicht hat. So hat der Hochzeitsfotograf freie Sicht auf jeden einzelnen Gast und es entstehen keine unschönen Überdeckungen!
				</div>
			</section>

			<!-- Section 2: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Häufig gestellte Fragen (FAQ)
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Was passiert, wenn Blumenkinder zu schüchtern sind?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Lassen Sie sehr junge Blumenkinder an der Hand eines Elternteils oder älteren Geschwisterkinds laufen. Platzieren Sie die Eltern in den vorderen Reihen, sodass das Kind auf ein vertrautes Gesicht zuläuft.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/de/wedding-processional-order" category="logistics" />

	</main>

	<!-- Interactive Script -->
	<script is:inline>
		const traditionSelect = document.getElementById('ceremony-tradition');
		const partner1Input = document.getElementById('partner1-name');
		const partner2Input = document.getElementById('partner2-name');
		const escortSelect = document.getElementById('escort-style');
		const phaseButtons = document.querySelectorAll('.phase-btn');
		const lineupContainer = document.getElementById('lineup-list-container');
		const lineupHeading = document.getElementById('lineup-heading');
		const lineupCountBadge = document.getElementById('lineup-count-badge');
		const customInput = document.getElementById('custom-member-input');
		const btnAddCustom = document.getElementById('btn-add-custom-member');
		const btnPrint = document.getElementById('btn-print-pocket-sheet');
		const btnCopyText = document.getElementById('btn-export-text');

		let currentPhase = 'processional';
		let lineupData = [];

		const presets = {
			nondenom: [
				{ role: "Platznehmen der Großeltern & Eltern", names: "Großeltern & Eltern", cue: "Vorspiel-Musik läuft" },
				{ role: "Einzug des Bräutigams & Trauzeugen", names: "Bräutigam (Maximilian) & Trauzeuge", cue: "Nehmen vorne am Altar Platz" },
				{ role: "Trauredner / Freier Redner", names: "Trauredner/in", cue: "Stellt sich in die Mitte" },
				{ role: "Brautjungfern / Groomsmen", names: "Trauzeugen & Brautjungfern", cue: "Halbwegs-Abstandsregel" },
				{ role: "Trauzeugin (Maid of Honor)", names: "Trauzeugin", cue: "Steht links neben Brautplatz" },
				{ role: "Ringträger & Blumenkinder", names: "Blumenkinder & Ringträger", cue: "Tragen Ringkissen & Blüten" },
				{ role: "Feierlicher Brauteinzug", names: "Braut (Sophie) mit Begleitung", cue: "🎵 Lied 2 (Brautlied) startet!" }
			],
			christian: [
				{ role: "Platznehmen der Angehörigen", names: "Großeltern & Eltern beider Seiten", cue: "Glockengeläut / Orgel" },
				{ role: "Pfarrer & Bräutigam am Altar", names: "Pfarrer & Bräutigam (Maximilian)", cue: "Stehen am Altar bereit" },
				{ role: "Trauzeugen", names: "Trauzeugen beider Partner", cue: "Nehmen Plätze vorne ein" },
				{ role: "Blumenkinder & Ringträger", names: "Blumenkinder mit Blütenkörbchen", cue: "Schreiten langsam voran" },
				{ role: "Brauteinzug", names: "Braut (Sophie) mit Vater/Begleitung", cue: "🎵 Feierlicher Orgeleinzug" }
			],
			catholic: [
				{ role: "Liturgischer Einzug", names: "Priester, Ministranten & Altardiener", cue: "Einzugsprozession durch den Mittelgang" },
				{ role: "Bräutigam & Trauzeuge", names: "Bräutigam (Maximilian) & Trauzeuge", cue: "Am Altar" },
				{ role: "Eltern & Taufpaten", names: "Eltern & Paten", cue: "Nehmen in der ersten Reihe Platz" },
				{ role: "Blumenkinder", names: "Blumenkinder", cue: "" },
				{ role: "Braut & Begleitung", names: "Braut (Sophie) & Begleitung", cue: "🎵 Festliche Orgelmusik" }
			],
			jewish: [
				{ role: "Rabbiner & Kantor", names: "Rabbiner & Kantor", cue: "Stellen sich unter die Chuppa" },
				{ role: "Großeltern", names: "Großeltern des Paares", cue: "" },
				{ role: "Bräutigam mit beiden Eltern", names: "Bräutigam (Maximilian) + Mutter & Vater", cue: "Stehen rechts unter Chuppa" },
				{ role: "Trauzeugen", names: "Trauzeugen", cue: "" },
				{ role: "Blumenkinder & Ringträger", names: "Blumenkinder", cue: "" },
				{ role: "Braut mit beiden Eltern", names: "Braut (Sophie) + Mutter & Vater", cue: "🎵 Einzug unter die Chuppa" }
			],
			lgbtq: [
				{ role: "Platznehmen der Familien", names: "Eltern & Geschwister", cue: "Einlassmusik" },
				{ role: "Trauredner/in", names: "Freie/r Redner/in", cue: "Nimmt Position vorne ein" },
				{ role: "Trauzeugen & Freunde", names: "Trauzeugen beider Partner", cue: "Symmetrischer Einzug" },
				{ role: "Gemeinsamer Paar-Einzug", names: "Sophie & Maximilian Hand in Hand", cue: "🎵 Haupt-Einzugslied" }
			],
			minimalist: [
				{ role: "Redner & Partner 2", names: "Redner & Maximilian", cue: "Vorne bereit" },
				{ role: "Trauzeugen", names: "Zwei Trauzeugen", cue: "" },
				{ role: "Einzug Partner 1", names: "Sophie & Begleitung", cue: "🎵 Musikstart" }
			]
		};

		function loadTradition() {
			const t = traditionSelect.value;
			const raw = presets[t] || presets.nondenom;
			lineupData = JSON.parse(JSON.stringify(raw));
			applyCustomNames();
		}

		function applyCustomNames() {
			const p1 = partner1Input.value.trim() || 'Sophie';
			const p2 = partner2Input.value.trim() || 'Maximilian';
			const escort = escortSelect.options[escortSelect.selectedIndex].text;

			lineupData.forEach(item => {
				item.role = item.role.replace(/Sophie/g, p1).replace(/Maximilian/g, p2);
				item.names = item.names.replace(/Sophie/g, p1).replace(/Maximilian/g, p2);
				if (item.role.includes('Brauteinzug') || item.role.includes('Partner 1')) {
					item.names = `${p1} (${escort})`;
				}
			});
			renderLineup();
		}

		function renderLineup() {
			lineupContainer.innerHTML = '';

			let displayList = [...lineupData];
			if (currentPhase === 'recessional') {
				lineupHeading.textContent = '2. Reihenfolge beim feierlichen Auszug';
				displayList = [
					{ role: "Frisch vermähltes Ehepaar (Zuerst)", names: `${partner1Input.value || 'Sophie'} & ${partner2Input.value || 'Maximilian'} (Verheiratet!)`, cue: "🎵 Schwungvolles Auszugslied" },
					{ role: "Blumenkinder & Ringträger", names: "Blumenkinder & Ringträger", cue: "Direkt hinter dem Brautpaar" },
					{ role: "Trauzeugen (Paarweise)", names: "Trauzeugin & Trauzeuge", cue: "" },
					{ role: "Brauteltern", names: "Eltern von Partner 1 & 2", cue: "" },
					{ role: "Großeltern & Familie", names: "Großeltern & Familie", cue: "" },
					{ role: "Gäste (Reihe für Reihe)", names: "Gäste folgen nach draußen zum Spalier", cue: "" }
				];
			} else {
				lineupHeading.textContent = '1. Reihenfolge beim feierlichen Einzug';
			}

			lineupCountBadge.textContent = `${displayList.length} Stationen | ca. 4–6 Schritte Abstand`;

			displayList.forEach((item, idx) => {
				const row = document.createElement('div');
				row.style.cssText = "display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; gap: 0.75rem;";
				
				row.innerHTML = `
					<div style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">
						<span style="font-weight: 800; font-size: 1.1rem; color: var(--accent-red); width: 24px; text-align: center;">${idx + 1}</span>
						<div>
							<strong style="font-size: 0.98rem; color: var(--fg-pencil); display: block;">${item.role}</strong>
							<span style="font-size: 0.88rem; color: #475569;">${item.names}</span>
							${item.cue ? `<span style="display: block; font-size: 0.78rem; font-weight: 700; color: var(--accent-blue); margin-top: 2px;">⚡ Signal: ${item.cue}</span>` : ''}
						</div>
					</div>
					<div style="display: flex; gap: 4px;">
						<button type="button" class="btn-move-up hand-btn secondary" data-index="${idx}" style="padding: 3px 7px; font-size: 0.75rem;" ${idx === 0 ? 'disabled' : ''}>▲</button>
						<button type="button" class="btn-move-down hand-btn secondary" data-index="${idx}" style="padding: 3px 7px; font-size: 0.75rem;" ${idx === displayList.length - 1 ? 'disabled' : ''}>▼</button>
					</div>
				`;
				lineupContainer.appendChild(row);
			});

			if (currentPhase === 'processional') {
				document.querySelectorAll('.btn-move-up').forEach(b => {
					b.addEventListener('click', () => {
						const idx = parseInt(b.getAttribute('data-index'), 10);
						if (idx > 0) {
							const temp = lineupData[idx];
							lineupData[idx] = lineupData[idx - 1];
							lineupData[idx - 1] = temp;
							renderLineup();
						}
					});
				});
				document.querySelectorAll('.btn-move-down').forEach(b => {
					b.addEventListener('click', () => {
						const idx = parseInt(b.getAttribute('data-index'), 10);
						if (idx < lineupData.length - 1) {
							const temp = lineupData[idx];
							lineupData[idx] = lineupData[idx + 1];
							lineupData[idx + 1] = temp;
							renderLineup();
						}
					});
				});
			}
		}

		phaseButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				phaseButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentPhase = btn.getAttribute('data-phase');
				renderLineup();
			});
		});

		btnAddCustom.addEventListener('click', () => {
			const val = customInput.value.trim();
			if (!val) return;
			lineupData.splice(lineupData.length - 1, 0, {
				role: val,
				names: val,
				cue: "Eigener Teilnehmer"
			});
			customInput.value = '';
			renderLineup();
		});

		traditionSelect.addEventListener('change', loadTradition);
		[partner1Input, partner2Input, escortSelect].forEach(inp => {
			inp.addEventListener('input', applyCustomNames);
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			let html = `
				<!DOCTYPE html>
				<html>
				<head>
					<title>Ablaufplan Einzug & Auszug — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						h2 { font-size: 13pt; margin-top: 18px; margin-bottom: 6px; border-bottom: 2px solid #0f172a; padding-bottom: 3px; }
						table { width: 100%; border-collapse: collapse; margin-top: 8px; }
						th, td { border: 1px solid #cbd5e1; padding: 6px 10px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
					</style>
				</head>
				<body>
					<h1>Trauungs-Ablauf: ${partner1Input.value || 'Sophie'} & ${partner2Input.value || 'Maximilian'}</h1>
					<p style="font-size: 10pt; color: #64748b; margin-top: 0;">Zeremonie: ${traditionSelect.options[traditionSelect.selectedIndex].text} | Abstand: 4–6 Schritte (Halbwegs-Regel)</p>
					
					<h2>1. Reihenfolge beim feierlichen Einzug</h2>
					<table>
						<thead><tr><th style="width: 35px;">#</th><th>Rolle / Position</th><th>Teilnehmer</th><th>Musik & Timing</th></tr></thead>
						<tbody>
			`;

			lineupData.forEach((item, idx) => {
				html += `
					<tr>
						<td><strong>${idx + 1}</strong></td>
						<td><strong>${item.role}</strong></td>
						<td>${item.names}</td>
						<td>${item.cue || '—'}</td>
					</tr>
				`;
			});

			html += `
						</tbody>
					</table>

					<h2>2. Reihenfolge beim Auszug (Recessional)</h2>
					<table>
						<thead><tr><th style="width: 35px;">#</th><th>Reihenfolge</th><th>Gruppe</th></tr></thead>
						<tbody>
							<tr><td>1</td><td><strong>Frisch vermähltes Ehepaar (Zuerst)</strong></td><td>${partner1Input.value || 'Sophie'} & ${partner2Input.value || 'Maximilian'}</td></tr>
							<tr><td>2</td><td>Blumenkinder & Ringträger</td><td>Blumenkinder</td></tr>
							<tr><td>3</td><td>Trauzeugen</td><td>Trauzeugen (Paarweise)</td></tr>
							<tr><td>4</td><td>Brauteltern & Schwiegereltern</td><td>Eltern beider Partner</td></tr>
							<tr><td>5</td><td>Großeltern & Gäste</td><td>Gäste folgen nach draußen</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`;
			printWindow.document.write(html);
			printWindow.document.close();
		});

		btnCopyText.addEventListener('click', () => {
			let text = `⛪ *Trauungs-Ablauf für ${partner1Input.value || 'Sophie'} & ${partner2Input.value || 'Maximilian'}*\n\n`;
			text += `*🚶‍♂️ Einzugs-Reihenfolge:*\n`;
			lineupData.forEach((item, idx) => {
				text += `${idx + 1}. ${item.role} (${item.names})${item.cue ? ` - _Signal: ${item.cue}_` : ''}\n`;
			});
			text += `\n*🎉 Auszug (Recessional):*\n1. Frisch vermähltes Ehepaar zuerst!\n2. Blumenkinder & Ringträger\n3. Trauzeugen\n4. Eltern\n5. Gäste zum Spalier`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnCopyText.textContent;
				btnCopyText.textContent = '✅ In die Zwischenablage kopiert!';
				setTimeout(() => { btnCopyText.textContent = orig; }, 2500);
			});
		});

		loadTradition();
	</script>
</Layout>
