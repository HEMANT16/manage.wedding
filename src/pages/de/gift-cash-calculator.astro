---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/gift-cash-calculator/#webapp",
      "name": "Geldgeschenk-Rechner Hochzeit & Geschenk-Prognose",
      "url": "https://manage.wedding/de/gift-cash-calculator",
      "description": "Kostenloser Geldgeschenk-Rechner für Hochzeiten: Berechnen Sie den perfekten Geldbetrag im Briefumschlag nach deutschem Knigge oder prognostizieren Sie das gesamte Geldgeschenke-Aufkommen für das Brautpaar.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "inLanguage": "de",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie man das passende Geldgeschenk für eine Hochzeit berechnet",
      "description": "Knigge-Leitfaden zur Berechnung des angemessenen Geldbetrags im Hochzeitsumschlag basierend auf Verwandtschaftsgrad, Begleitung und Reiseaufwand.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Nähe zum Brautpaar bestimmen",
          "text": "Starten Sie mit dem Knigge-Basiswert: 50–80 € für Kollegen/Bekannte, 100–150 € für gute Freunde, 150–300 €+ für Geschwister und engste Familie."
        },
        {
          "@type": "HowToStep",
          "name": "2. Begleitperson (Plus-One) einrechnen",
          "text": "Multiplizieren Sie den Betrag bei einer Paarteilnahme mit dem Faktor 1,8x (bzw. +50 bis 100 €)."
        },
        {
          "@type": "HowToStep",
          "name": "3. Reisekosten & Trauzeugen-Aufwand berücksichtigen",
          "text": "Ziehen Sie 20% bis 30% ab, wenn Sie hohe Flug- und Hotelkosten für eine Destination Wedding oder Ausgaben für den JGA hatten."
        },
        {
          "@type": "HowToStep",
          "name": "4. Mit persönlicher Glückwunschkarte überreichen",
          "text": "Legen Sie das Geld in eine stilvoll handgeschriebene Hochzeitskarte mit herzlichen Wünschen."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie viel Geld schenkt man zur Hochzeit im Jahr 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Als Faustregel gilt: Arbeitskollegen und Bekannte schenken 50 € bis 80 €, gute Freunde und Verwandte 100 € bis 150 €, enge Familienangehörige (Geschwister, Eltern, Paten) 150 € bis 300 €+. Paare schenken zusammen meist 150 € bis 250 €."
          }
        },
        {
          "@type": "Question",
          "name": "Gilt die 'Tellerpauschale-Regel' noch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Moderne Knigge-Experten sind sich einig: Sie sind eingeladene Gäste und keine Restaurantkunden. Das Geschenk richtet sich nach Ihrer Nähe zum Brautpaar und Ihren finanziellen Möglichkeiten, nicht nach den Menükosten der Location."
          }
        },
        {
          "@type": "Question",
          "name": "Schenkt man weniger Geld bei einer Hochzeit mit weiter Anreise?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Wenn Sie hunderte Euro für Flüge und Hotelübernachtungen aufwenden, ist Ihre Anwesenheit bereits ein wesentlicher Teil des Geschenks. Ein kleinerer Betrag (50–100 €) mit einer herzlichen Karte ist absolut angemessen."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel Geld bekommen Brautpaare durchschnittlich geschenkt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei einer durchschnittlichen Hochzeit mit 100 Gästen erhält das Brautpaar zwischen 8.000 € und 13.000 € an Geldgeschenken (ca. 80 € bis 130 € pro anwesendem Gast)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Geldgeschenk-Rechner Hochzeit (Knigge-Richtwerte & Wünsche-Export) | Manage.Wedding"
	description="Kostenloser Hochzeits-Geldgeschenkrechner: Berechnen Sie den passenden Geldbetrag als Hochzeitsgast oder prognostizieren Sie Geldgeschenke für das Brautpaar. Mit Textvorlagen & Export."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Geldgeschenk-Rechner Hochzeit" category="budget" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Geldgeschenk-Rechner <span class="accent-italic">zur Hochzeit</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Berechnen Sie den perfekten Geldbetrag für den Umschlag nach modernem Knigge oder <strong>prognostizieren Sie die gesamten Geldgeschenke</strong> für Ihre Hochzeitsfeier.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Geldgeschenk in 3 Schritten berechnen
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Modus wählen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Wählen Sie <strong>„Gast-Modus“</strong> (für Ihren Umschlag) oder <strong>„Brautpaar-Modus“</strong> (zur Gesamtkalkulation).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Nähe & Begleitung anpassen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Berücksichtigen Sie Verwandtschaftsgrad, Begleitperson, Reisekosten und Trauzeugen-Aufgaben.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Kartentext & Betrag exportieren
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Kopieren Sie fertige Glückwunschtexte oder laden Sie eine Übersicht als <strong>Word- (.doc)</strong> oder <strong>PDF-Dokument</strong> herunter.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Config Form + Live Results & Breakdown -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="gift-calc-grid">
			
			<!-- Left Column: Input Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Mode Switcher Tabs -->
				<div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<button type="button" id="tab-guest-mode" class="mode-tab-btn active-tab" style="flex: 1; padding: 0.55rem; font-family: var(--font-heading); font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; background: var(--fg-pencil); color: #fff;">
						🎁 Ich bin Gast (Mein Geschenk)
					</button>
					<button type="button" id="tab-couple-mode" class="mode-tab-btn" style="flex: 1; padding: 0.55rem; font-family: var(--font-heading); font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; background: var(--bg-paper); color: var(--fg-pencil);">
						💒 Wir sind das Brautpaar (Gesamtprognose)
					</button>
				</div>

				<!-- GUEST MODE FORM -->
				<div id="section-guest-mode">
					<form id="guest-gift-form" style="display: flex; flex-direction: column; gap: 1rem;">
						
						<!-- Closeness to Couple -->
						<div>
							<label for="select-relationship" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								1. Beziehung zum Brautpaar *
							</label>
							<select id="select-relationship" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
								<option value="175">👑 Engste Familie / Geschwister / Trauzeugen (150 – 250 €+)</option>
								<option value="120" selected>🌸 Gute Freunde / Tante, Onkel, Cousin (100 – 150 €)</option>
								<option value="80">🤝 Bekannte / Nachbarn / Vereinskollegen (60 – 100 €)</option>
								<option value="60">💼 Arbeitskollegen / Entferntere Bekannte (50 – 80 €)</option>
							</select>
						</div>

						<!-- Attendance & Plus-One -->
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<label for="select-attendance" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Wer nimmt teil?
								</label>
								<select id="select-attendance" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
									<option value="1.0">Allein (Nur ich)</option>
									<option value="1.8" selected>Paar (Ich + Partner/in)</option>
									<option value="2.3">Familie (Paar + Kinder)</option>
								</select>
							</div>

							<div>
								<label for="select-venue-tier" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Rahmen der Feier
								</label>
								<select id="select-venue-tier" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
									<option value="1.0">Klassisch (Restaurant / Scheune / Saal)</option>
									<option value="1.2">Gehoben / Schloss / 5-Sterne (+20%)</option>
									<option value="0.85">Lockerer Sektempfang / Polterabend (-15%)</option>
								</select>
							</div>
						</div>

						<!-- Offsets: Travel & Wedding Party -->
						<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
							<span class="font-heading" style="font-size: 0.88rem; color: var(--fg-pencil); display: block;">
								✈️ Anreise & Trauzeugen-Rabatte:
							</span>
							
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-destination-travel" style="accent-color: var(--fg-pencil);">
								<span>Hohe Reise-/Hotelkosten für die Hochzeit (-25%)</span>
							</label>

							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-bridal-party-role" style="accent-color: var(--fg-pencil);">
								<span>Ich bin Trauzeuge/Trauzeugin (Hohe Vorab-Ausgaben: -20%)</span>
							</label>
						</div>

					</form>
				</div>

				<!-- COUPLE MODE FORM (HIDDEN INITIALLY) -->
				<div id="section-couple-mode" style="display: none;">
					<form id="couple-gift-form" style="display: flex; flex-direction: column; gap: 1rem;">
						
						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-guest-count" class="font-heading" style="font-size: 0.95rem; color: var(--accent-red);">
									Anzahl der Gäste
								</label>
								<span id="display-guest-count" style="font-size: 1.1rem; font-weight: bold; color: var(--accent-red);">100 Gäste</span>
							</div>
							<input type="range" id="input-guest-count" min="20" max="350" value="100" step="5" style="width: 100%; accent-color: var(--accent-red);">
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<label for="select-couple-venue-tier" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Stil der Location
								</label>
								<select id="select-couple-venue-tier" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="1.0" selected>Standard Feier (ca. 95 € / Gast)</option>
									<option value="1.3">Exklusiv / Schloss (ca. 125 € / Gast)</option>
									<option value="0.85">Gemütlich / DIY (ca. 75 € / Gast)</option>
								</select>
							</div>

							<div>
								<label for="select-destination-mode" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Veranstaltungsort
								</label>
								<select id="select-destination-mode" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="1.0" selected>Heimatort / Regionale Hochzeit</option>
									<option value="0.75">Destination Wedding (Gäste reisen an)</option>
								</select>
							</div>
						</div>

						<p class="font-body" style="font-size: 0.82rem; color: var(--text-secondary); line-height: 1.4; margin: 0; background: var(--bg-paper); padding: 0.6rem; border-radius: 4px;">
							*Basiert auf typischen Geschenkmischungen aus Familie (30%), Freunden (40%), Bekannten (20%) und Trauzeugen (10%).
						</p>

					</form>
				</div>

				<!-- Currency Selector -->
				<div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.3rem; margin-top: 1rem; border-top: 1px dashed #ccc; padding-top: 0.75rem;">
					<span style="font-size: 0.85rem; font-weight: bold;">Währung:</span>
					<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
						<option value="€" selected>€ (EUR)</option>
						<option value="CHF">CHF (Schweiz)</option>
						<option value="$">$ (USD)</option>
						<option value="£">£ (GBP)</option>
					</select>
				</div>

			</div>

			<!-- Right Column: Live Results & Card Message Recommendations -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Gift Result Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 id="res-card-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								✉️ Empfohlenes Geldgeschenk
							</h3>
							<span id="res-card-subtitle" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Knigge-Richtwert für den Briefumschlag
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Drucken
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Gift Range Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span id="res-range-label" class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Empfohlener Betrag</span>
						<strong id="res-primary-amount" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">200 €</strong>
						<span id="res-range-subtext" style="font-size: 0.85rem; color: var(--accent-red);">Angemessener Rahmen: 175 € – 225 €</span>
					</div>

					<!-- Detailed Math Breakdown List -->
					<div style="margin-bottom: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil); margin-bottom: 0.4rem; text-align: center;">
							🧾 Berechnungsfaktoren
						</h4>
						<ul id="res-factors-list" class="font-body" style="list-style: none; padding: 0; margin: 0; font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.35rem; color: var(--fg-pencil);">
							<li style="display:flex; justify-content:space-between; border-bottom:1px solid #eee; padding-bottom:0.2rem;">
								<span>Beziehungs-Basiswert:</span> <strong id="fact-base">120 €</strong>
							</li>
							<li style="display:flex; justify-content:space-between; border-bottom:1px solid #eee; padding-bottom:0.2rem;">
								<span>Teilnahme (Paar):</span> <strong id="fact-attendance">x 1,8</strong>
							</li>
							<li style="display:flex; justify-content:space-between; border-bottom:1px solid #eee; padding-bottom:0.2rem;">
								<span>Anreise & Rahmen:</span> <strong id="fact-adjustments">1,0x (Standard)</strong>
							</li>
						</ul>
					</div>

					<!-- Visual Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Bescheiden (50 €)</span>
							<span>Klassisch (150 €)</span>
							<span style="color: var(--accent-red);">Großzügig (300 €+)</span>
						</div>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="gift-gauge-bar" style="width: 55%; height: 100%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Ready-to-Write Card Wishes Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem; text-align: center;">
						💌 Text-Idee für die Glückwunschkarte:
					</strong>
					<p id="card-wish-text" class="font-body" style="font-size: 0.88rem; line-height: 1.45; margin: 0; color: var(--fg-pencil); font-style: italic; text-align: center;">
						„Von Herzen alles Liebe für eure gemeinsame Zukunft! Möge dieser kleine Beitrag dazu beitragen, eure Flitterwochen unvergesslich zu machen.“
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Manage.Wedding — Geldgeschenk-Empfehlung & Kartengrüße</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exportiert am: <span id="print-date"></span> | Betrag: <span id="print-amount"></span></p>
			</div>
			<div id="print-content-body"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 2.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Auf einen Blick</span>
