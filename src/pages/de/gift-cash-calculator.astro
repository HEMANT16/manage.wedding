						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Engste Familie (Eltern, Geschwister)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right; font-weight: 600;">150 € – 300 €+</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right; font-weight: 600;">250 € – 500 €+</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">150 € – 250 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-size: 0.85rem;">Persönliche Karte & Erinnerungsgeschenk</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Gute Freunde & Trauzeugen</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right; font-weight: 600;">100 € – 175 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right; font-weight: 600;">180 € – 280 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">100 € – 150 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-size: 0.85rem;">Originell verpacktes Geldgeschenk</td>
