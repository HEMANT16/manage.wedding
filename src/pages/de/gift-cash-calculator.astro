							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">80 € – 120 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-size: 0.85rem;">Glückwunschkarte im Kuvert</td>
