							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right; font-weight: 600;">50 € – 80 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right; font-weight: 600;">100 € – 150 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">50 € – 80 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-size: 0.85rem;">Gemeinschaftsgeschenk der Abteilung</td>
