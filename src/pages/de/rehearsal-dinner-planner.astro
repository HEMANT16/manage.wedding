---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/rehearsal-dinner-planner/#webapp",
      "name": "Polterabend-, Get-Together & Probe-Essen Planer | Manage.Wedding",
      "url": "https://manage.wedding/de/rehearsal-dinner-planner",
      "inLanguage": "de",
      "description": "Kostenloser Budget- und Gästelisten-Rechner für das Vorabend-Essen, Get-Together oder Probe-Essen vor der Hochzeit. Berechnet exakte Gästezahlen für Trauzeugen, Familie und weit angereiste Gäste inklusive detailliertem Ablaufplan.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie plant man Gästeliste und Budget für das Vorabend-Essen / Probe-Essen?",
      "description": "Schritt-für-Schritt-Leitfaden für Brautpaare und Gastgeber zur Planung des Vorabends vor der Hochzeit.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Kern-Beteiligte der Trauung erfassen (Stufe 1)",
          "text": "Zählen Sie alle Personen, die bei der Trauzeremonie eine Rolle spielen: Brautpaar, Trauzeugen mit Partnern, Eltern, Geschwister, Trauredner/Pfarrer und Fürbitten-Sprecher."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Weit angereiste Gäste einbinden (Stufe 2)",
          "text": "Entscheiden Sie, ob weit angereiste Gäste direkt zum gesetzten Essen eingeladen werden oder ab 21:00 Uhr zu einem lockeren Get-Together-Drink dazustoßen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Gastronomie-Stil & Location wählen",
          "text": "Wählen Sie zwischen lockerem Brauhaus / Pizza (30–45 €/Person), italienischer Trattoria im Family-Style (50–75 €/Person) oder einem privaten Restaurant-Separee (80–130 €/Person)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Entspannten Vorabend-Ablaufplan erstellen",
          "text": "Planen Sie die Trauprobe um ca. 17:00 Uhr, Beginn des Essens um 18:30 Uhr, Dankesworte & Trauzeugen-Geschenke um 20:15 Uhr und ein pünktliches Ende um ca. 22:00 Uhr."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wer wird traditionell zum Probe-Essen / Vorabend-Essen eingeladen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zum festen Kreis gehören: das Brautpaar, die Trauzeugen und Brautjungfern (jeweils mit Partnern), Eltern, Geschwister, Großeltern sowie der Trauredner bzw. Pfarrer und Personen mit Aufgaben in der Zeremonie."
          }
        },
        {
          "@type": "Question",
          "name": "Muss man alle weit angereisten Gäste zum Vorabend-Essen einladen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Wenn viele Gäste aus der Ferne anreisen, würde ein gesetztes Menü das Budget überstrapazieren. Die moderne Lösung ist ein intimes Vorabendessen für die Trauzeugen und Familie, gefolgt von einem lockeren 'Welcome-Drink & Dessert' an der Hotelbar ab 21:00 Uhr für alle Frühanreisenden."
          }
        },
        {
          "@type": "Question",
          "name": "Wer bezahlt das Vorabend-Essen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditionell übernahmen oft die Eltern des Bräutigams die Kosten für das 'Rehearsal Dinner'. Heute wird das Essen meist vom Brautpaar selbst finanziert oder die Kosten werden anteilig von beiden Elternpaaren übernommen."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Polterabend- & Probe-Essen-Planer | Gästeliste, Budget & Zeitplan (Kostenlos)"
	description="Kostenloser Budget- und Gästerechner für das Vorabend-Essen / Get-Together / Probe-Essen. Berechnet Personenzahlen für Trauzeugen, Familie und weit angereiste Gäste inklusive Zeitplan."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Probe-Essen-Planer" category="dining" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Gästelisten-Knigge & Kostenkontrolle</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Vorabend- & <span class="accent-italic">Probe-Essen-Planer</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Vermeiden Sie Budget-Überraschungen! Berechnen Sie exakte Personenzahlen für Zeremonie-Beteiligte, Familie und weit angereiste Gäste inklusive Vorabend-Zeitplan und Gastronomie-Kosten.
			</p>
		</header>

		<!-- Main Interactive Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Guest Tiers & Format Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Gästekreise & Kopfzahl
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Stufen-Planer
					</span>
				</div>

				<!-- Dining Style Presets -->
				<div class="form-group">
					<label class="form-label" for="dinner-style-preset">Gastronomie-Konzept des Vorabends</label>
					<select id="dinner-style-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="italian" selected>🍝 Italienische Trattoria / Family-Style (58 €/Person + Wein)</option>
						<option value="brewery">🍕 Brauhaus, Pizza & Craft-Bier (38 €/Person)</option>
						<option value="steakhouse">🥩 Gehobenes Restaurant / 3-Gänge-Menü (95 €/Person)</option>
						<option value="taco">🌮 Lockere Gartenparty / BBQ / Foodtruck (28 €/Person)</option>
						<option value="custom">✏️ Individuelle Kostenangaben</option>
					</select>
				</div>

				<!-- Tier 1: Core Mandatory Ceremony Participants -->
				<div style="background: #faf8f5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.25rem;">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.5rem; color: var(--accent-red);">
						Stufe 1: Fester Kreis der Trauzeremonie
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="count-attendants" style="font-size: 0.88rem;">Trauzeugen & Brautjungfern</label>
							<input type="number" id="count-attendants" class="form-input" value="6" min="2" max="30" />
						</div>
						<div>
							<label class="form-label" for="count-plusones" style="font-size: 0.88rem;">Partner der Trauzeugen</label>
							<input type="number" id="count-plusones" class="form-input" value="6" min="0" max="30" />
						</div>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="count-immediate-family" style="font-size: 0.88rem;">Eltern & Geschwister</label>
							<input type="number" id="count-immediate-family" class="form-input" value="8" min="2" max="20" />
						</div>
						<div>
							<label class="form-label" for="count-officiant" style="font-size: 0.88rem;">Trauredner / Pfarrer & Fürbitten</label>
							<input type="number" id="count-officiant" class="form-input" value="2" min="1" max="10" />
						</div>
					</div>
				</div>

				<!-- Tier 2: Extended Family & Out-of-Town Option -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.25rem;">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.5rem; color: var(--accent-blue);">
						Stufe 2: Großeltern & Weit angereiste Gäste
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="count-grandparents" style="font-size: 0.88rem;">Großeltern</label>
							<input type="number" id="count-grandparents" class="form-input" value="4" min="0" max="12" />
						</div>
						<div>
							<label class="form-label" for="count-out-of-town" style="font-size: 0.88rem;">Weit angereiste Gäste</label>
							<input type="number" id="count-out-of-town" class="form-input" value="10" min="0" max="80" />
						</div>
					</div>

					<div class="form-group" style="margin-top: 0.5rem;">
						<label class="form-label" for="out-of-town-mode" style="font-size: 0.88rem;">Umgang mit Weitgereisten</label>
						<select id="out-of-town-mode" class="form-input" style="cursor: pointer; font-size: 0.9rem;">
							<option value="drinks-only" selected>🥂 Welcome-Drink & Dessert nach dem Essen (15 €/P.)</option>
							<option value="full-dinner">🍽️ Volle Einladung zum gesetzten Menü</option>
							<option value="none">🚫 Keine Weitgereisten am Vorabend</option>
						</select>
					</div>
				</div>

				<!-- Pricing per Person & Room Rental -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="cost-per-head">Speisen & Getränke (€/Gast)</label>
						<input type="number" id="cost-per-head" class="form-input" value="58" min="15" step="5" />
					</div>
					<div>
						<label class="form-label" for="room-fee">Raummiete / Mindestverzehr (€)</label>
						<input type="number" id="room-fee" class="form-input" value="200" min="0" step="50" />
					</div>
				</div>

			</div>

			<!-- Right Column: Budget Breakdown & Timeline Generator -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Summary Budget Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Gesamtbudget Vorabend
						</span>
						<span id="display-headcount-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							28 Gäste beim Menü
						</span>
					</div>

					<div id="display-grand-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.5rem;">
						2.288 €
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Menü & Bar: <strong id="display-fb-subtotal" style="color: var(--fg-pencil);">1.774 €</strong> • Service & Trinkgeld (10%): <strong id="display-tax-tip" style="color: var(--fg-pencil);">177 €</strong> • Raum: <strong id="display-room-cost" style="color: var(--fg-pencil);">200 €</strong>.
					</p>

					<!-- Itemized Headcount List -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Brautpaar:</span>
							<strong>2</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Trauzeugen, Brautjungfern & Partner:</span>
							<strong id="item-attendant-total">12</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Eltern, Geschwister & Großeltern:</span>
							<strong id="item-family-total">12</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.95rem;">
							<span>Trauredner, Pfarrer & Fürbitten:</span>
							<strong id="item-officiant-total">2</strong>
						</div>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-timeline" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Zeitplan & Gästeliste drucken (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Word-Export (.doc)
						</button>
					</div>

				</div>

				<!-- Master Rehearsal Night Timeline Schedule -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.75rem;">
						🕒 Idealer Vorabend-Zeitplan (17:00 – 22:00 Uhr):
					</strong>
					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.5;">
						<div><strong>17:00 – 17:45 Uhr:</strong> Ablaufprobe der Trauung vor Ort (Kirche / Standesamt / Trauwiese).</div>
						<div><strong>18:00 – 18:30 Uhr:</strong> Fahrt zum Restaurant & Aperitif / Ankommen.</div>
						<div><strong>18:30 – 19:45 Uhr:</strong> Gemütliches Abendessen & Begrüßungsworte der Gastgeber.</div>
						<div><strong>19:45 – 20:30 Uhr:</strong> Geschenkübergabe an die Trauzeugen & persönliche Anekdoten.</div>
						<div><strong>20:30 – 21:45 Uhr:</strong> Dessert & Eintreffen der weit angereisten Gäste zum Welcome-Drink.</div>
						<div><strong>22:00 Uhr:</strong> Pünktlicher Aufbruch & Erholungsschlaf vor dem großen Tag!</div>
					</div>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Auf einen Blick (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Vorabend- & Probe-Essen: Kosten- & Knigge-Übersicht
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Die 1-Minuten-Faustformel für Gästekreis und durchschnittliche Kosten:
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					🍷 Die Faustformel für das Vorabend-Essen:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Feste Gästezahl = [Brautpaar (2) + Trauzeugen & Partner + Eltern & Geschwister + Trauredner] • Durchschnitt: 20 bis 30 Personen (1.200 € bis 3.000 € Gesamtkosten).
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Gastronomie-Stil</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Kosten pro Gast</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Gesamt (25 Gäste)</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Stimmung & Flair</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Brauhaus & Pizza-Abend</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">30 € – 45 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">850 € – 1.250 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Entspannt, unkompliziert, gesellig</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Italienische Trattoria (Family-Style)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">50 € – 75 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">1.400 € – 2.100 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Herzlich, geteilte Pasta- & Antipasti-Platten</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Gehobenes Restaurant (Separee)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">80 € – 130 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">2.200 € – 3.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Festlich, intim, ruhige Reden</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Gartenparty / BBQ / Foodtruck</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">25 € – 40 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">700 € – 1.100 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Open-Air, locker, für viele Gäste geeignet</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Der vollständige Leitfaden für den Vorabend der Hochzeit
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Von Dankesreden über Trauzeugen-Geschenke bis hin zur cleveren Einbindung von Weitgereisten.
				</p>
			</div>

			<!-- Section 1: Speeches & Gifts -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Reden & Geschenke am Vorabend
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Während bei der Hochzeitsfeier meist nur ausgewählte Personen das Wort ergreifen, ist das Vorabendessen der ideale Ort für emotionale, persönliche Dankesworte:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Dank des Brautpaars:</strong> Das Paar bedankt sich bei den Eltern und Trauzeugen für die Unterstützung der vergangenen Planungsmonate.</li>
					<li><strong>Trauzeugen-Geschenke:</strong> Traditionell überreicht das Brautpaar hier kleine persönliche Aufmerksamkeiten (z. B. gravierte Manschettenknöpfe, Schmuck, seidene Morgenmäntel).</li>
					<li><strong>Spontane Anekdoten:</strong> Freunde aus Kindheitstagen oder Geschwister können ungezwungen lustige Erinnerungen teilen.</li>
				</ul>
			</section>

			<!-- Section 2: Out of Town Strategy -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Der 'Get-Together'-Trick für weit angereiste Gäste
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Reisen 30 bis 50 Gäste schon am Vortag an, würde ein 3-Gänge-Menü für alle das Hochzeitsbudget sprengen. Die bewährte 2-Phasen-Lösung:
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>🍸 Das 2-Stufen-Vorabend-Modell:</strong><br />
					• <strong>18:30 – 20:30 Uhr:</strong> Intimes Abendessen nur für die 20 engsten Beteiligten (Brautpaar, Eltern, Trauzeugen).<br />
					• <strong>Ab 20:45 Uhr:</strong> Lockeres 'Welcome Get-Together' in der Hotel-Lounge, Bar oder im Biergarten. Weitgereiste Gäste stoßen ganz ungezwungen auf ein Glas Wein oder Bier dazu!
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Häufig gestellte Fragen (FAQ)
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Was zieht die Braut am Vorabend an?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Viele Bräute wählen ein weißes Cocktailkleid, einen eleganten weißen Jumpsuit oder ein schickes Midikleid, abgestimmt auf den Stil des Restaurants.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Wann sollte die Veranstaltung am Vorabend enden?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Spätestens um <strong>22:00 bis 22:30 Uhr</strong> sollte das Brautpaar ins Bett gehen. Ausreichend Schlaf und ein frisches Gefühl am Hochzeitsmorgen sind unbezahlbar!
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/de/rehearsal-dinner-planner" category="dining" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('dinner-style-preset');
		const countAttendants = document.getElementById('count-attendants');
		const countPlusOnes = document.getElementById('count-plusones');
		const countImmediateFamily = document.getElementById('count-immediate-family');
		const countOfficiant = document.getElementById('count-officiant');
		const countGrandparents = document.getElementById('count-grandparents');
		const countOutOfTown = document.getElementById('count-out-of-town');
		const outOfTownMode = document.getElementById('out-of-town-mode');

		const costPerHeadInput = document.getElementById('cost-per-head');
		const roomFeeInput = document.getElementById('room-fee');

		const displayHeadcountBadge = document.getElementById('display-headcount-badge');
		const displayGrandTotal = document.getElementById('display-grand-total');
		const displayFbSubtotal = document.getElementById('display-fb-subtotal');
		const displayTaxTip = document.getElementById('display-tax-tip');
		const displayRoomCost = document.getElementById('display-room-cost');

		const itemAttendantTotal = document.getElementById('item-attendant-total');
		const itemFamilyTotal = document.getElementById('item-family-total');
		const itemOfficiantTotal = document.getElementById('item-officiant-total');

		const btnPrint = document.getElementById('btn-print-timeline');
		const btnDoc = document.getElementById('btn-export-doc');

		function calculateRehearsal() {
			const att = parseInt(countAttendants.value, 10) || 0;
			const plus = parseInt(countPlusOnes.value, 10) || 0;
			const fam = parseInt(countImmediateFamily.value, 10) || 0;
			const off = parseInt(countOfficiant.value, 10) || 0;
			const grand = parseInt(countGrandparents.value, 10) || 0;
			const outOfTown = parseInt(countOutOfTown.value, 10) || 0;

			const coreSeated = 2 + att + plus + fam + off + grand;
			let totalSeated = coreSeated;
			let drinksOnlyCount = 0;

			if (outOfTownMode.value === 'full-dinner') {
				totalSeated += outOfTown;
			} else if (outOfTownMode.value === 'drinks-only') {
				drinksOnlyCount = outOfTown;
			}

			const perHead = parseFloat(costPerHeadInput.value) || 0;
			const roomFee = parseFloat(roomFeeInput.value) || 0;

			const foodBarTotal = (totalSeated * perHead) + (drinksOnlyCount * 15);
			const taxTip = foodBarTotal * 0.10; // 10% Trinkgeld / Service
			const grandTotal = foodBarTotal + taxTip + roomFee;

			// Displays
			displayHeadcountBadge.textContent = `${totalSeated} Gäste beim Menü`;
			displayGrandTotal.textContent = `${Math.round(grandTotal).toLocaleString('de-DE')} €`;
			displayFbSubtotal.textContent = `${Math.round(foodBarTotal).toLocaleString('de-DE')} €`;
			displayTaxTip.textContent = `${Math.round(taxTip).toLocaleString('de-DE')} €`;
			displayRoomCost.textContent = `${Math.round(roomFee).toLocaleString('de-DE')} €`;

			itemAttendantTotal.textContent = (att + plus);
			itemFamilyTotal.textContent = (fam + grand);
			itemOfficiantTotal.textContent = off;
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'italian') {
				costPerHeadInput.value = 58;
				roomFeeInput.value = 200;
			} else if (p === 'brewery') {
				costPerHeadInput.value = 38;
				roomFeeInput.value = 100;
			} else if (p === 'steakhouse') {
				costPerHeadInput.value = 95;
				roomFeeInput.value = 350;
			} else if (p === 'taco') {
				costPerHeadInput.value = 28;
				roomFeeInput.value = 0;
			}
			calculateRehearsal();
		});

		// Live Listeners
		[countAttendants, countPlusOnes, countImmediateFamily, countOfficiant, countGrandparents, countOutOfTown, outOfTownMode, costPerHeadInput, roomFeeInput].forEach(inp => {
			inp.addEventListener('input', calculateRehearsal);
			inp.addEventListener('change', calculateRehearsal);
		});

		// Print Itinerary & Roster
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html lang="de">
				<head>
					<title>Vorabend & Probe-Essen — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; line-height: 1.4; }
						h1 { font-size: 20pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 20px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Vorabend- & Probe-Essen: Planung & Ablauf</h1>
					<p>Gästezahl beim Menü: ${displayHeadcountBadge.textContent} | Gesamtbudget: ${displayGrandTotal.textContent}</p>
					
					<h2>Gästeliste & Sitzplatz-Aufteilung</h2>
					<table>
						<thead><tr><th>Kategorie</th><th>Anzahl</th></tr></thead>
						<tbody>
							<tr><td>Brautpaar</td><td>2</td></tr>
							<tr><td>Trauzeugen, Brautjungfern & Partner</td><td>${itemAttendantTotal.textContent}</td></tr>
							<tr><td>Eltern, Geschwister & Großeltern</td><td>${itemFamilyTotal.textContent}</td></tr>
							<tr><td>Trauredner, Pfarrer & Fürbitten</td><td>${itemOfficiantTotal.textContent}</td></tr>
							<tr class="total-row"><td>GESAMTTEILNEHMER MENÜ</td><td>${displayHeadcountBadge.textContent}</td></tr>
						</tbody>
					</table>

					<h2>Empfohlener Vorabend-Zeitplan</h2>
					<ul>
						<li><strong>17:00 Uhr:</strong> Ablaufprobe der Zeremonie in der Location/Kirche</li>
						<li><strong>18:00 Uhr:</strong> Aperitif & Eintreffen im Restaurant</li>
						<li><strong>18:30 Uhr:</strong> Abendessen & Begrüßungsworte</li>
						<li><strong>19:45 Uhr:</strong> Dankesworte & Trauzeugen-Geschenke</li>
						<li><strong>20:30 Uhr:</strong> Welcome-Drinks für weit angereiste Gäste</li>
						<li><strong>22:00 Uhr:</strong> Ende & Nachtruhe vor dem Hochzeitstag</li>
					</ul>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Vorabend-Plan</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Vorabend- & Probe-Essen Plan</h2>
					<p>Gästezahl: ${displayHeadcountBadge.textContent} | <strong>Gesamtbudget: ${displayGrandTotal.textContent}</strong></p>
					<table>
						<thead><tr><th>Kategorie</th><th>Betrag</th></tr></thead>
						<tbody>
							<tr><td>Speisen & Getränke</td><td>${displayFbSubtotal.textContent}</td></tr>
							<tr><td>Trinkgeld & Service (10%)</td><td>${displayTaxTip.textContent}</td></tr>
							<tr><td>Raummiete / Mindestverzehr</td><td>${displayRoomCost.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>GESAMT</td><td>${displayGrandTotal.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'vorabend-plan.doc';
			link.click();
		});

		// Initial Calculation
		calculateRehearsal();
	</script>
</Layout>
