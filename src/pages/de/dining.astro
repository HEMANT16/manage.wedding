---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Getränke-, Menü- & Tortenrechner für die Hochzeit (Kostenlos) | Manage.Wedding";
const description = "Kostenlose Hochzeitsrechner für Getränkebedarf bei Sektempfang & Bar, Flaschengrößen, Hochzeitstorten-Portionen, Catering-Kosten und druckbare Menükarten.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/de/dining/#collection",
      "name": "Hochzeits-Getränke, Bewirtung & Tortenrechner",
      "url": "https://manage.wedding/de/dining",
      "inLanguage": "de",
      "description": "Umfassende Sammlung von Getränkerechnern für Sektempfang & Bar, Tortenetagen-Rechnern, Catering-Kostenvergleichen und Menükarten-Generatoren.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Getränkerechner für die Hochzeit", "url": "https://manage.wedding/de/wedding-drink-calculator" },
        { "@type": "WebApplication", "name": "Spirituosen- & Flaschenrechner", "url": "https://manage.wedding/de/liquor-wedding-calculator" },
        { "@type": "WebApplication", "name": "Hochzeitstorten Preisrechner", "url": "https://manage.wedding/de/cake-pricing-calculator" },
        { "@type": "WebApplication", "name": "Tortenetagen & Portionen Sizer", "url": "https://manage.wedding/de/cake-serving-calculator" },
        { "@type": "WebApplication", "name": "Menükarten Gestalter (4x9 Format)", "url": "https://manage.wedding/de/reception-menu-maker" },
        { "@type": "WebApplication", "name": "Menü vs. Buffet Kostenvergleich", "url": "https://manage.wedding/de/catering-cost-estimator" },
        { "@type": "WebApplication", "name": "Alkoholgehalt & Cocktail-Verdünnung", "url": "https://manage.wedding/de/alcohol-dilution-calculator" },
        { "@type": "WebApplication", "name": "Blumen- & Deko-Kostenrechner", "url": "https://manage.wedding/de/floral-cost-estimator" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie viele Getränke plant man pro Person bei einer Hochzeit ein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die bewährte Formel lautet: 2 Getränke pro Gast während des Sektempfangs (erste Stunde), danach 1 Getränk pro Gast und Stunde für die restliche Feier. Bei einer 6-stündigen Hochzeitsfeier mit 100 Gästen sollten Sie mit ca. 700 Getränkeportionen kalkulieren."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele Flaschen Wein und Sekt benötigt man für 100 Gäste?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für einen Sektempfang und anschließendes Abendessen mit 100 Gästen plant man etwa 20–25 Flaschen Sekt/Prosecco sowie 50–60 Flaschen Wein (je zur Hälfte Rotwein und Weißwein/Rosé)."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel kostet ein Stück Hochzeitstorte im Durchschnitt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Individuelle Hochzeitstorten von Meisterkonditoren liegen in der Regel zwischen 4,50 € und 9,50 € pro Portion, abhängig von Fondant-Verzierungen, echten oder handgemachten Zuckerblumen und Lieferaufwand."
          }
        }
      ]
    }
  ]
};

const diningTools = [
  {
    title: "Getränkerechner für die Hochzeit",
    url: "/de/wedding-drink-calculator",
    icon: "🍾",
    badge: "Top Favorit",
    desc: "Berechnen Sie die genaue Anzahl an Flaschen Wein, Sekt, Bierkästen, Softdrinks und Eiswürfeln für Sektempfang und Abendfeier.",
    tags: ["Sektempfang", "PDF-Einkaufsliste", "Bier & Wein"]
  },
  {
    title: "Spirituosen- & Flaschenrechner",
    url: "/de/liquor-wedding-calculator",
    icon: "🍸",
    badge: "Cocktailbar & Longdrinks",
    desc: "Optimieren Sie Mengen für Gin, Rum, Vodka und Whiskeys, wählen Sie zwischen 0,7L und Großflaschen und berechnen Sie die Baukosten.",
    tags: ["Cocktailmengen", "0,7L vs. 1,0L", "Bar-Einkauf"]
  },
  {
    title: "Menükarten Gestalter (4x9 DL Format)",
    url: "/de/reception-menu-maker",
    icon: "📜",
    badge: "Druckfertige PDF",
    desc: "Gestalten Sie elegante Menükarten für Tische und Teller im Format DIN Lang / 4x9 mit Zierrahmen, Serifen-Schriften und Allergen-Symbolen.",
    tags: ["Menükarten", "Druckbare PDF", "Allergene & Menüs"]
  },
  {
    title: "Hochzeitstorten Preisrechner",
    url: "/de/cake-pricing-calculator",
    icon: "🎂",
    badge: "Preis pro Portion",
    desc: "Für Konditoren und Brautpaare: Kalkulieren Sie Zutatenkosten, Arbeitszeit, Preis pro Stück und druckbare Angebote.",
    tags: ["Konditor-Kalkulation", "Preis pro Stück", "Kostenvoranschlag"]
  },
  {
    title: "Tortenetagen & Portionen Sizer",
    url: "/de/cake-serving-calculator",
    icon: "🍰",
    badge: "Etagen-Geometrie",
    desc: "Berechnen Sie Etagendurchmesser, Portionsgrößen (Kaffeestücke vs. Dessertportionen) und Etagenkombinationen für 50 bis 300+ Gäste.",
    tags: ["Etagengrößen", "Zusatztorten", "Schneide-Leitfaden"]
  },
  {
    title: "Dessert-Buffet, Candy-Bar & Cookie Rechner",
    url: "/de/wedding-dessert-table-calculator",
    icon: "🧁",
    badge: "Dessert-Buffet",
    desc: "Berechnen Sie Mini-Desserts, Dutzend-Bestellungen für Konditoren, Candy-Bar Kilos und drucken Sie 8x10 Schilder 'Liebe ist süß'.",
    tags: ["Mini-Desserts", "Candy-Bar Kilos", "Konditor-Bestellliste"]
  },
  {
    title: "Menü vs. Buffet Kostenvergleich",
    url: "/de/catering-cost-estimator",
    icon: "🍽️",
    badge: "Preis pro Person",
    desc: "Vergleichen Sie gesetztes 3-Gänge-Menü, Buffet, Flying Dinner und Food-Stationen inklusive Servicepersonal-Schlüssel.",
    tags: ["Menü vs Buffet", "Kosten pro Gast", "Servicekräfte"]
  },
  {
    title: "Alkoholgehalt & Cocktail-Verdünnung",
    url: "/de/alcohol-dilution-calculator",
    icon: "🧪",
    badge: "Barkeeper-Tool",
    desc: "Berechnen Sie die exakte Verdünnung und Wasserzugabe beim Vormischen großer Cocktail-Chargen für Ihre Hochzeitsbar.",
    tags: ["Vol.-% Alkohol", "Premix-Cocktails", "Schmelzwasser"]
  },
  {
    title: "Blumen- & Deko-Kostenrechner",
    url: "/de/floral-cost-estimator",
    icon: "💐",
    badge: "Floristik-Planer",
    desc: "Kalkulieren Sie Kosten für Brautstrauß, Wurfstrauß, Anstecker für Bräutigam und Trauzeugen, Tischgestecke und Traubögen.",
    tags: ["Brautstrauß", "Tischdeko", "Traubogen"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Bar-, Bewirtungs- & Torten-Zentrale</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Getränke-, Menü- <span class="accent-italic">& Tortenrechner</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Berechnen Sie exakte Getränkemengen für Sektempfang und Bar, dimensionieren Sie Ihre Hochzeitstorte und gestalten Sie druckfertige Menükarten.
      </p>
    </header>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
      {diningTools.map(tool => (
        <a href={tool.url} class="hand-card tool-item-card" style="display: flex; flex-direction: column; justify-content: space-between; text-decoration: none; padding: 1.75rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); transition: transform 0.2s ease, box-shadow 0.2s ease;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span class="tool-tag" style="background: #eff6ff; border: 1.5px solid var(--fg-pencil); font-size: 0.8rem; font-weight: 700; color: #1e40af;">{tool.badge}</span>
            </div>
            
            <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0; line-height: 1.3;">
              {tool.title}
            </h3>
            
            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin: 0 0 1.25rem 0;">
              {tool.desc}
            </p>
          </div>

          <div>
            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.25rem;">
              {tool.tags.map(tag => (
                <span style="font-size: 0.75rem; background: #f1f5f9; color: #475569; padding: 2px 8px; border-radius: 3px; font-weight: 600;">#{tag}</span>
              ))}
            </div>
            
            <span class="hand-btn" style="display: block; text-align: center; padding: 8px; font-size: 0.95rem;">
              Rechner öffnen →
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- SEO Informational Article -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 3rem;">
      <h2 class="font-heading" style="font-size: 2.2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
        Getränke- & Menükalkulation für Ihre Hochzeitsgesellschaft
      </h2>
      
      <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 1.5rem;">
        Gutes Essen und feine Getränke bleiben Gästen noch Jahre nach der Hochzeit in bester Erinnerung. Doch wie viel Wein, Bier, Sekt und Torte wird tatsächlich getrunken und gegessen? Nutzen Sie unsere Richtwerte, um weder Engpässe zu riskieren noch hunderte Euro an Restbeständen zu verschwenden.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin: 2rem 0;">
        <div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
          <h4 class="font-heading" style="color: var(--accent-red); margin-top: 0; font-size: 1.15rem;">1. Der Sektempfang</h4>
          <p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0;">
            Rechnen Sie mit 1,5 bis 2 Gläsern Sekt oder Champagner pro Gast (eine 0,75L-Flasche reicht für 6 Gläser) plus alkoholfreie Alternativen wie Orangensaft oder hausgemachte Limonade.
          </p>
        </div>

        <div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
          <h4 class="font-heading" style="color: var(--accent-blue); margin-top: 0; font-size: 1.15rem;">2. Der Wein- & Bierbedarf</h4>
          <p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0;">
            Im Sommer trinken Gäste tendenziell mehr Weißwein, Rosé und kühles Fassbier; im Herbst und Winter steigt der Rotweinanteil.
          </p>
        </div>

        <div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
          <h4 class="font-heading" style="color: #16a34a; margin-top: 0; font-size: 1.15rem;">3. Der Anschnitt der Hochzeitstorte</h4>
          <p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0;">
            Wird die Torte als Nachspeise nach Mitternacht serviert, genügt eine Portionsmenge für 60–75% der Gäste. Zum Nachmittagskaffee plant man 100% ein.
          </p>
        </div>
      </div>
    </article>

  </main>
</Layout>
