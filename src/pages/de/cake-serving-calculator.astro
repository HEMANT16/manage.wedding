---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/cake-serving-calculator/#webapp",
      "name": "Hochzeitstorten-Portionsrechner & Etagenplaner | Manage.Wedding",
      "url": "https://manage.wedding/de/cake-serving-calculator",
      "inLanguage": "de",
      "description": "Berechnen Sie exakte Portionsmengen, Etagengrößen (Durchmesser in cm/Zoll), runde vs. quadratische Torten und Blechkuchen-Ergänzungen für Ihre Hochzeit. Inklusive visueller Etagen-Vorschau und Schnittanleitung.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie berechnet man die Portionsanzahl und Etagengröße einer Hochzeitstorte?",
      "description": "Schritt-für-Schritt-Methode zur Ermittlung von Portionsausbeute, Etagendurchmessern und Blechkuchen-Ergänzungen für Hochzeiten.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Tortenform & Aufbau wählen",
          "text": "Wählen Sie runde Etagen (klassisch zylindrisch), quadratische Etagen (ergeben ca. 25% mehr Stücke) oder Herzformen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Portionsstandard festlegen",
          "text": "Wählen Sie schmale Hochzeitstorten-Portionen (ca. 2,5 × 5 cm nach einem Menü) oder großzügige Kaffeetafel-Portionen (ca. 5 × 5 cm zum Nachmittagskaffee)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Gästezahl & Etagenkombination abstimmen",
          "text": "Wählen Sie bewährte 2-, 3- oder 4-stöckige Kombinationen (z. B. 15 / 23 / 30 cm für ca. 100 Gäste) oder nutzen Sie die automatische Gäste-Empfehlung."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Schautorte mit Blechkuchen kombinieren",
          "text": "Ergänzen Sie bei großen Gesellschaften eine optisch elegante Schautorte mit einem unglasierten Blechkuchen aus der Vorbereitungsküche zum günstigen Nachschneiden."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie groß muss eine Hochzeitstorte für 100 Gäste sein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für 100 Gäste ist eine 3-stöckige runde Torte mit Durchmessern von ca. 15 cm (6\"), 23 cm (9\") und 30 cm (12\") der Standard. Sie liefert exakt 100 Hochzeitstorten-Portionen (ca. 2,5 × 5 cm). Alternativ reicht eine 3-stöckige Torte (15/20/25 cm) kombiniert mit einem 1/4 Blechkuchen aus der Küche."
          }
        },
        {
          "@type": "Question",
          "name": "Was ist der Unterschied zwischen Hochzeitstorten- und Kaffeetafel-Portionen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eine Hochzeitstorten-Portion misst ca. 2,5 × 5 × 10 cm Höhe. Sie ist bewusst schmaler geschnitten, da die Torte meist nach einem reichhaltigen Menü oder um Mitternacht serviert wird. Kaffeetafel-Portionen messen ca. 5 × 5 cm (doppeltes Volumen) und sind ideal, wenn die Torte der Hauptgang beim Nachmittagskaffee ist."
          }
        },
        {
          "@type": "Question",
          "name": "Zählt die oberste Etage zu den Gästeportionen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wenn Sie dem Brauch folgen, die oberste 15-cm-Etage einzufrieren (für den 1. Hochzeitstag oder die Taufe), dürfen Sie diese nicht für die Gäste mitzählen. Ziehen Sie ca. 12 Portionen von der Gesamtkapazität ab."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele Portionen ergibt ein ganzes bzw. halbes Backblech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Standard-Gastroblech (ca. 60 × 40 cm) ergibt ca. 96 bis 108 Kaffeetafel-Stücke bzw. bis zu 192 schmale Hochzeitsportionen. Ein halbes Blech liefert ca. 48 bis 54 Kaffeetafel-Stücke."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Hochzeitstorten-Portionsrechner | Etagen- & Portionenplaner (Kostenlos)"
	description="Berechnen Sie exakte Portionsmengen, Etagengrößen (Durchmesser in cm), runde vs. quadratische Torten und Blechkuchen-Ergänzungen für Ihre Hochzeit mit visueller Etagen-Vorschau."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Hochzeitstorten-Portionsrechner" category="dining" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2.5rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 3rem 1.5rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<span class="badge-postit">Konditorei- & Etagen-Planung</span>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Hochzeitstorten-Portionsrechner <span class="accent-italic">& Etagenplaner</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--text-secondary); max-width: 680px; margin: 1rem auto 0; line-height: 1.6;">
					Kalkulieren Sie den genauen Tortenbedarf für Ihre Hochzeitsfeier. Wählen Sie Form, Etagenanzahl, Portionsgröße und entdecken Sie Schnittanleitungen und den smarten Blechkuchen-Spartrick.
				</p>
			</div>
		</section>

		<!-- Interactive Calculator & Visual Studio Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; margin-bottom: 3.5rem;" class="calc-container-grid">
			
			<!-- Left Column: Controls & Inputs -->
			<div class="hand-card" style="padding: 2rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.6rem; margin-bottom: 1.5rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>🎂</span> Torten-Spezifikationen
				</h2>

				<form id="cake-calc-form">
					
					<!-- Calculation Mode -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem; color: var(--fg-pencil);">
							Torten-Konzept / Aufbau:
						</label>
						<div class="mode-select-grid">
							<label class="mode-tab active" id="tab-tiered">
								<input type="radio" name="cakeMode" value="tiered" checked style="display: none;"> Mehrstöckig
							</label>
							<label class="mode-tab" id="tab-sheet">
								<input type="radio" name="cakeMode" value="sheet" style="display: none;"> Reiner Blechkuchen
							</label>
							<label class="mode-tab" id="tab-combo">
								<input type="radio" name="cakeMode" value="combo" style="display: none;"> Schautorte + Blech
							</label>
						</div>
					</div>

					<!-- Guest Count -->
					<div style="margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label class="font-heading" for="guest-count" style="font-size: 1.1rem; color: var(--fg-pencil);">
								Anzahl der Gäste:
							</label>
							<span id="guest-badge" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.9rem;">100 Gäste</span>
						</div>
						<input type="range" id="guest-slider" min="10" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="guest-count" class="form-input" min="1" max="1000" value="100" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem;">
						</div>
					</div>

					<!-- Cake Shape -->
					<div id="shape-group" style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem; color: var(--fg-pencil);">
							Form der Etagen:
						</label>
						<select id="cake-shape" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff; cursor: pointer;">
							<option value="round">Rund (Traditionell, harmonisch & elegant)</option>
							<option value="square">Quadratisch (~25% mehr Stücke pro Etage)</option>
							<option value="heart">Herzform (Romantisch & verspielt)</option>
						</select>
					</div>

					<!-- Slice / Portion Size -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem; color: var(--fg-pencil);">
							Portionsgröße / Schnittmaß:
						</label>
						<select id="portion-size" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff; cursor: pointer;">
							<option value="wedding">Hochzeitstorten-Portion (ca. 2,5 × 5 cm — Standard nach Menü)</option>
							<option value="party">Kaffeetafel-Portion (ca. 5 × 5 cm — Großzügig zum Nachmittagskaffee)</option>
							<option value="dessert">Dessert-Portion (ca. 3,5 × 5 cm — Mittlere Portionsgröße)</option>
						</select>
						<small class="font-body" style="color: var(--text-secondary); display: block; margin-top: 0.35rem; line-height: 1.4;">
							*Hochzeitstorten-Portionen sind schmaler, da Gäste bereits ein mehrgängiges Menü genossen haben.
						</small>
					</div>

					<!-- Tier Preference (Tiered Mode) -->
					<div id="tier-pref-group" style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem; color: var(--fg-pencil);">
							Gewünschte Etagenanzahl:
						</label>
						<select id="tier-count-pref" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff; cursor: pointer;">
							<option value="auto">Automatische Empfehlung (Beste Proportionen)</option>
							<option value="1">1 Etage (Einstöckig / Standesamt)</option>
							<option value="2">2 Etagen (Klein & fein, 30–65 Gäste)</option>
							<option value="3">3 Etagen (Klassiker, 75–130 Gäste)</option>
							<option value="4">4 Etagen (Festlich & groß, 130–220 Gäste)</option>
							<option value="5">5 Etagen (Prunkvoll, 220+ Gäste)</option>
						</select>
					</div>

					<!-- Anniversary Top Tier Checkbox -->
					<div style="margin-bottom: 1.5rem; padding: 0.75rem; background: var(--bg-paper); border: 2px dashed var(--fg-pencil); border-radius: 4px;">
						<label style="display: flex; align-items: flex-start; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="save-top-tier" style="margin-top: 0.3rem; transform: scale(1.2);">
							<span class="font-body" style="font-size: 1rem; color: var(--fg-pencil); line-height: 1.4;">
								<strong>Oberste Etage einfrieren (1. Hochzeitstag / Taufe)?</strong><br>
								<span style="color: var(--text-secondary); font-size: 0.88rem;">Zieht ~12–16 Portionen der Spitze ab, damit für alle Gäste ausreichend Kuchen bleibt.</span>
							</span>
						</label>
					</div>

					<!-- Cake Height Preference -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem; color: var(--fg-pencil);">
							Etagenhöhe / Schichten:
						</label>
						<div class="height-select-grid">
							<label class="height-opt active">
								<input type="radio" name="cakeHeight" value="4" checked style="display: none;"> 10 cm Standard (3 Böden)
							</label>
							<label class="height-opt">
								<input type="radio" name="cakeHeight" value="5" style="display: none;"> 12,5 cm Hohe Event-Torte
							</label>
							<label class="height-opt">
								<input type="radio" name="cakeHeight" value="6" style="display: none;"> 15 cm Double Barrel
							</label>
						</div>
					</div>

					<button type="button" id="recalc-btn" class="hand-btn" style="width: 100%; padding: 1rem; font-size: 1.15rem;">
						✨ Torten-Kalkulation aktualisieren
					</button>

				</form>
			</div>

			<!-- Right Column: Interactive Visuals & Results -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Results Summary Card -->
				<div class="hand-card" style="background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
						<h2 class="font-heading" style="font-size: 1.6rem; color: var(--accent-red); margin: 0;">
							Torten-Bauplan
						</h2>
						<span id="match-status" class="font-heading" style="background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem;">
							Exakte Passung
						</span>
					</div>

					<!-- Big Stats -->
					<div class="cake-stats-grid">
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Gesamtportionen</span>
							<strong id="res-total-servings" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue); display: block;">100</strong>
							<span id="res-servings-diff" style="font-size: 0.75rem; color: var(--text-secondary);">Exakt für 100 Gäste</span>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Etagen / Aufbau</span>
							<strong id="res-tier-count" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); display: block;">3 Etagen</strong>
							<span id="res-tier-detail" style="font-size: 0.75rem; color: var(--text-secondary);">15, 23, 30 cm</span>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Oberfläche (Fondant/Creme)</span>
							<strong id="res-cake-area" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); display: block;">1.320 cm²</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Deko-Fläche</span>
						</div>
					</div>

					<!-- Visual Cake Tier Render Container -->
					<div id="visual-cake-studio" style="border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 1.5rem 0.5rem 0.5rem; background: var(--bg-paper); min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; position: relative; overflow: hidden; max-width: 100%;">
						<div style="position: absolute; top: 8px; left: 10px; font-size: 0.8rem; color: var(--text-secondary); font-family: var(--font-heading);">
							📐 Maßstabsgetreuer Etagen-Bauplan
						</div>
						<!-- Tiers dynamically rendered here -->
						<div id="tiers-render-box" style="display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 100%;"></div>
						<!-- Cake Stand -->
						<div id="cake-stand-plate" style="width: min(240px, 90%); height: 10px; background: #e5e0d8; border: 2px solid var(--fg-pencil); border-radius: 10px; margin-top: -2px;"></div>
						<div id="cake-stand-stem" style="width: 50px; height: 20px; background: #dcd6cc; border: 2px solid var(--fg-pencil); border-top: none; margin-bottom: 4px;"></div>
						<div id="cake-stand-foot" style="width: 100px; height: 8px; background: #dcd6cc; border: 2px solid var(--fg-pencil); border-radius: 4px;"></div>
					</div>

					<!-- Breakdown List per Tier -->
					<div id="tier-breakdown-list" style="margin-top: 1.5rem; font-family: var(--font-body); font-size: 1rem;">
						<!-- Populated via JS -->
					</div>

					<!-- Pro-Tip Callout Box -->
					<div id="pro-tip-box" style="margin-top: 1.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
						<div class="font-heading" style="font-size: 1.1rem; margin-bottom: 0.25rem; color: var(--fg-pencil);">
							💡 Cleverer Spar-Tipp der Konditoren:
						</div>
						<p id="pro-tip-text" class="font-body" style="font-size: 0.95rem; margin: 0; line-height: 1.4;">
							Bestellen Sie eine kleinere 2-stöckige Schautorte für Fotos und das feierliche Anschneiden, kombiniert mit einem passenden unglasierten Blechkuchen in der Küche – das spart rund 40–50% Konditorkosten!
						</p>
					</div>

				</div>

				<!-- Visual Slice Scale Comparison Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin-bottom: 1rem; color: var(--fg-pencil);">
						📏 Portionsgrößen im optischen Vergleich
					</h3>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; text-align: center;">
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
							<div class="font-heading" style="font-size: 1.1rem; color: var(--accent-blue); margin-bottom: 0.5rem;">Hochzeitstorten-Stück</div>
							<div style="width: 40px; height: 80px; background: #ffeaa7; border: 2px solid var(--fg-pencil); margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
								2,5 × 5 cm
							</div>
							<div class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								ca. 125 cm³<br>Standard nach Abendessen / Mitternacht
							</div>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
							<div class="font-heading" style="font-size: 1.1rem; color: var(--accent-red); margin-bottom: 0.5rem;">Kaffeetafel-Stück</div>
							<div style="width: 80px; height: 80px; background: #fab1a0; border: 2px solid var(--fg-pencil); margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
								5 × 5 cm
							</div>
							<div class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								ca. 250 cm³ (2× Volumen)<br>Großzügig zum Nachmittagskaffee
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 3.5rem auto 2.5rem; max-width: 900px; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape"></div>
			
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Auf einen Blick (BLUF): Portions-Matrix nach Etagengrößen
				</h3>
				<span style="background: #fff; border: 1.5px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700; color: var(--accent-red);">
					1-Minuten Faustformel
				</span>
			</div>

			<!-- Formula Highlight Box -->
			<div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<div style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--accent-red); margin-bottom: 0.35rem; font-weight: 700;">
					📐 Die Grundregel für die Portionsausbeute:
				</div>
				<p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.5;">
					<strong>Hochzeitstorten-Portion = ca. 2,5 × 5 × 10 cm Höhe (schmale Portionsgröße nach Mehrgangmenü)</strong><br />
					<strong>Kaffeetafel-Portion = ca. 5 × 5 × 10 cm Höhe (doppeltes Volumen zum Nachmittagskaffee)</strong><br />
					<em>Tipp:</em> Eine Torte liefert exakt <strong>doppelt so viele</strong> Hochzeitstorten-Portionen wie Kaffeetafel-Stücke.
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; margin-bottom: 1rem; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 600px;">
					<thead>
						<tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
