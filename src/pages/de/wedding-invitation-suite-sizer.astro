---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-invitation-suite-sizer/#webapp",
      "name": "Hochzeitseinladungs-Set & Papeterie-Größenplaner | Manage.Wedding",
      "url": "https://manage.wedding/de/wedding-invitation-suite-sizer",
      "inLanguage": "de",
      "description": "Exakte Maße, Umschlag-Toleranzen und Schichtenmaße für Hochzeitseinladungen berechnen. DIN A5/C5, DIN A6/C6, DIN lang, quadratisch und Pocketfold mit 3-mm-Beschnittzugabe und 300-DPI-Druckmaßen.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie plant und dimensioniert man ein mehrteiliges Hochzeitseinladungs-Set?",
      "description": "Schritt-für-Schritt-Anleitung zur Auswahl von Umschlaggrößen (C5, C6, DIN lang), Passepartout-Trägerkarten, Antwortkarten und der 3-mm-Druckbeschnittzugabe.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Umschlagformat nach DIN-Norm wählen",
          "text": "Wählen Sie das äußere Umschlagformat (z. B. DIN C5 für DIN-A5-Karten, DIN C6 für DIN-A6-Postkarten oder DIN lang für moderne Hochformate)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Schichten & Passepartout-Rand kalkulieren",
          "text": "Bei mehrlagigen Einladungen (Layering) verkleinern Sie die bedruckte Einsteckkarte rundum um 3 bis 5 mm, um einen eleganten Farbkarton-Rahmen zu erzeugen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Antwortkarte (RSVP) & Zusatzkarten staffeln",
          "text": "Gestalten Sie Antwortkarten im Format DIN A6 (105 × 148 mm) mit passendem C6-Rücksendeumschlag, sodass alle Einleger sauber in den Hauptumschlag gleiten."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: 3-mm-Beschnittzugabe (Bleed) anlegen",
          "text": "Legen Sie in Canva, InDesign oder Photoshop rundum 3 mm Beschnitt (Bleed @ 300 DPI) an, um weiße Blitzer beim Schneiden zu verhindern."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Was ist das beliebteste Standardformat für Hochzeitseinladungen im deutschsprachigen Raum?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Das Standardformat in Deutschland, Österreich und der Schweiz ist DIN A5 (148 × 210 mm) in einem DIN-C5-Umschlag (162 × 229 mm) oder das elegante Format DIN lang (100 × 210 mm) im DIN-lang-Umschlag (110 × 220 mm)."
          }
        },
        {
          "@type": "Question",
          "name": "Welcher Umschlag passt zu einer DIN-A5- oder DIN-A6-Einladungskarte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nach DIN 5008 gilt: Zu einer DIN-A5-Karte gehört ein DIN-C5-Umschlag. Zu einer DIN-A6-Karte (Postkartenformat) gehört ein DIN-C6-Umschlag. Der C-Umschlag ist immer exakt so dimensioniert, dass die A-Karte mit sicherem Einsteckspiel hineinpasst."
          }
        },
        {
          "@type": "Question",
          "name": "Wie groß muss die Beschnittzugabe (Bleed) bei 300 DPI sein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Druckereien verlangen eine Beschnittzugabe von 3 mm an allen 4 Seiten. Für eine DIN-A5-Karte (148 × 210 mm) legen Sie Ihre Datei in Canva oder Photoshop mit 154 × 216 mm an (entspricht 1819 × 2551 Pixeln bei 300 DPI)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Einladungs-Set & Papeterie-Größenplaner | DIN-Formate & Beschnittrechner"
	description="Exakte Maße für Hochzeitseinladungen berechnen: DIN A6/C6, DIN A5/C5, DIN lang (DL), quadratisch & Pocketfold. Inklusive 3-mm-Beschnittzugabe (Bleed) und 300 DPI Druckmaßen für Canva & Photoshop."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Einladungs-Set-Größenplaner" category="stationery-creative" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">DIN-Normen, Canva 300 DPI & Beschnitt</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Hochzeits-Papeterie <span class="accent-italic">& Einladungs-Set-Planer</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Berechnen Sie millimetergenaue Abmessungen für Hauptkarten, Passepartout-Trägerkarton, Infokarten, Banderolen und passende Briefumschläge (DIN C5, C6, DIN lang).
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Suite Format Selector & Units -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Set-Format & Maßeinheiten
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						300 DPI Druckdaten
					</span>
				</div>

				<!-- Suite Preset Picker -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="suite-format-preset" style="font-weight: 700; font-size: 0.95rem;">Standard Papeterie-Set-Format</label>
					<select id="suite-format-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;">
						<option value="uk-metric" selected>💌 DIN A5 Standard-Set (C5 Umschlag 162×229 mm / Karte 148×210 mm / A6 RSVP)</option>
						<option value="a7-standard">👑 DIN A6 Klassik-Set (C6 Umschlag 114×162 mm / Karte 105×148 mm)</option>
						<option value="tea-length">🥂 DIN Lang (DL) Schmal (DL Umschlag 110×220 mm / Karte 100×210 mm)</option>
						<option value="square-6">🔲 Quadratisch 15×15 cm (Umschlag 155×155 mm / Karte 145×145 mm)</option>
						<option value="a7-layered">🏰 Pocketfold & Mehrlagen-Set (130×185 mm mit Passepartout & Stufenkarten)</option>
						<option value="a8-luxe">🇺🇸 US A7 Format (5×7 Zoll / 127×178 mm)</option>
					</select>
				</div>

				<!-- Measurement Unit Selector -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="unit-selector" style="font-weight: 700; font-size: 0.95rem;">Maßeinheit für Anzeige</label>
					<select id="unit-selector" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;">
						<option value="mm" selected>Millimeter (z. B. 148 × 210 mm)</option>
						<option value="cm">Zentimeter (z. B. 14,8 × 21,0 cm)</option>
						<option value="in">Zoll / Inches (z. B. 5.83" × 8.27")</option>
						<option value="px">Pixel @ 300 DPI für Canva/Photoshop (z. B. 1748 × 2480 px)</option>
					</select>
				</div>

				<!-- Backer Mat Border Width -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="border-reveal" style="font-weight: 700; font-size: 0.95rem;">Trägerkarten-Sichtrand (Layering Mat)</label>
					<select id="border-reveal" class="form-input" style="cursor: pointer; width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;">
						<option value="0.125" selected>3,0 mm (Zarter, edler Sichtrand)</option>
						<option value="0.25">6,0 mm (Breiter, markanter Rahmen)</option>
						<option value="0">Kein Trägerkarton (Einfache Einsteckkarte)</option>
					</select>
				</div>

				<!-- Additional Components (Checkboxes) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Enthaltene Papeterie-Elemente
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-details" checked style="width: 18px; height: 18px;" />
							<span>Infokarte / Ablauf & Anfahrt (Details Card)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-rsvp" checked style="width: 18px; height: 18px;" />
							<span>Antwortkarte (RSVP) & Rücksendeumschlag</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-bellyband" checked style="width: 18px; height: 18px;" />
							<span>Banderole (Belly Band) / Transparentpapier-Banderole</span>
						</label>
					</div>
				</div>

			</div>

			<!-- Right Column: Interactive Layering Canvas & Spec Sheet -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Spec Sheet Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Zuschnitt- & Druck-Spezifikationen
						</span>
						<span id="format-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							DIN A5 Standard-Set
						</span>
					</div>

					<h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Maße der einzelnen Schichten
					</h3>

					<!-- Itemized Dimension Specs Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						
						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>1. Versand-Briefumschlag:</strong></span>
							<strong id="spec-outer-envelope" style="color: var(--accent-blue);">162 × 229 mm (DIN C5)</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>2. Trägerkarton (Backer Mat):</strong></span>
							<strong id="spec-backer-card">148 × 210 mm (DIN A5)</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>3. Bedruckte Hauptkarte:</strong></span>
							<strong id="spec-main-card" style="color: var(--accent-red);">142 × 204 mm</strong>
						</div>

						<div id="row-details" style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>4. Infokarte / Ablauf:</strong></span>
							<strong id="spec-details-card">105 × 148 mm (DIN A6)</strong>
						</div>

						<div id="row-rsvp" style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>5. RSVP-Karte + C6 Umschlag:</strong></span>
							<strong id="spec-rsvp-card">Karte: 105×148 mm | Umschlag: 114×162 mm</strong>
						</div>

						<div id="row-belly" style="display: flex; justify-content: space-between; padding: 0.4rem 0; font-size: 0.92rem;">
							<span><strong>6. Banderole (Belly Band):</strong></span>
							<strong id="spec-bellyband">45 × 330 mm</strong>
						</div>

					</div>

					<!-- Print Bleed Spec Box -->
					<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem; font-size: 0.88rem; color: var(--fg-pencil); line-height: 1.5;">
						<strong>📐 Professionelle Druckbeschnittzugabe (Bleed):</strong><br />
						Fügen Sie in Canva oder Photoshop rundum <strong style="color: var(--accent-red);">+3,0 mm (35 px @ 300 DPI)</strong> Beschnitt an allen 4 Seiten hinzu, um saubere Schnittkanten ohne weiße Blitzer zu gewährleisten!
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-specs" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Zuschnittplan drucken (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Word-Export (.doc)
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Auf einen Blick (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Übersicht: Standardformate, Umschläge & Canva-Pixelmaße
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Hier ist die Referenztabelle aller Standard-Formate nach DIN-Norm und deren passende Umschläge.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 Die DIN-Zuordnungsregel für Papeterie:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					DIN-A5-Karte (148 × 210 mm) ➔ DIN-C5-Umschlag (162 × 229 mm) • DIN-A6-Karte (105 × 148 mm) ➔ DIN-C6-Umschlag (114 × 162 mm) • DIN-lang-Karte (100 × 210 mm) ➔ DIN-lang-Umschlag (110 × 220 mm).
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Format-Name</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Kartengröße</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Passender Umschlag</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Canva 300 DPI Maße</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">DIN A5 Standard</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">148 × 210 mm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">DIN C5 (162 × 229 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1748 × 2480 px</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">DIN A6 / Postkarte (RSVP)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">105 × 148 mm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">DIN C6 (114 × 162 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1240 × 1748 px</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">DIN Lang (DL) Hochformat</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">100 × 210 mm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">DIN Lang (110 × 220 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1181 × 2480 px</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Quadratisch 15 × 15 cm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">145 × 145 mm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Quadrat (155 × 155 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1713 × 1713 px</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Leitfaden für Papeterie-Zuschnitte & Druckqualitäten
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Alles zu Papiergewichten (g/m²), Schichtenaufbau (Layering) und professionellem Zuschnitt.
				</p>
			</div>

			<!-- Section 1: Paper Weights Explained -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Papiergrammaturen im Vergleich (g/m²)
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Die Haptik ist das Herzstück hochwertiger Hochzeitspapeterie:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>300 – 350 g/m² Feinkarton:</strong> Der Goldstandard für Einladungskarten. Liegt stabil und edel in der Hand.</li>
					<li><strong>500 – 600 g/m² Baumwollpapier / Letterpress:</strong> Extrem dicker Luxuskarton für Heißfolienprägung und Tiefprägung.</li>
					<li><strong>100 – 130 g/m² Briefpapier:</strong> Standardstärke für Briefumschläge und Umschlagfutter (Envelope Liners).</li>
				</ul>
			</section>

			<!-- Section 2: Assembly Order -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Reihenfolge beim Zusammenstecken der Einladung
				</h3>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>📦 Stapel-Reihenfolge (von unten nach oben):</strong><br />
					1. <strong>Haupt-Einladungskarte</strong> (Vorderseite nach oben)<br />
					2. <strong>Infokarte / Details</strong> (auf die Hauptkarte gelegt)<br />
					3. <strong>Antwortumschlag (C6)</strong> (Klappe nach unten)<br />
					4. <strong>Antwortkarte (A6)</strong> (unter die Klappe des Antwortumschlags gesteckt)<br />
					5. <strong>Banderole / Schleife</strong> (um das gesamte Set gewickelt)<br />
					6. <strong>In den Hauptumschlag stecken</strong>, sodass beim Öffnen sofort die Namen des Brautpaars sichtbar sind!
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Häufig gestellte Fragen (FAQ)
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Passt eine DIN-A5-Karte in einen DIN-C6-Umschlag?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Nein. Ein DIN-C6-Umschlag (114 × 162 mm) ist für DIN-A6-Karten gedacht. Eine DIN-A5-Karte erfordert zwingend einen DIN-C5-Umschlag (162 × 229 mm).
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Wie lang muss eine Banderole für eine DIN-A5-Karte sein?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Für eine DIN-A5-Karte (148 mm Breite) sollte die Banderole mindestens 330 bis 340 mm lang und 40 bis 50 mm breit sein, um die Karten mit genügend Überlappung zum Verkleben zu umwickeln.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/de/wedding-invitation-suite-sizer" category="stationery" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const formatSelect = document.getElementById('suite-format-preset');
		const unitSelect = document.getElementById('unit-selector');
		const borderRevealSelect = document.getElementById('border-reveal');

		const layerDetailsCheck = document.getElementById('layer-details');
		const layerRsvpCheck = document.getElementById('layer-rsvp');
		const layerBellyCheck = document.getElementById('layer-bellyband');

		const formatBadge = document.getElementById('format-badge');
		const specOuter = document.getElementById('spec-outer-envelope');
		const specBacker = document.getElementById('spec-backer-card');
		const specMain = document.getElementById('spec-main-card');
		const specDetails = document.getElementById('spec-details-card');
		const specRsvp = document.getElementById('spec-rsvp-card');
		const specBelly = document.getElementById('spec-bellyband');

		const rowDetails = document.getElementById('row-details');
		const rowRsvp = document.getElementById('row-rsvp');
		const rowBelly = document.getElementById('row-belly');

		const btnPrint = document.getElementById('btn-print-specs');
		const btnDoc = document.getElementById('btn-export-doc');

		function formatDim(w, h, unit) {
			if (unit === 'in') {
				return `${w.toFixed(2)}" × ${h.toFixed(2)}"`;
			} else if (unit === 'cm') {
				const wCm = (w * 2.54).toFixed(1).replace('.', ',');
				const hCm = (h * 2.54).toFixed(1).replace('.', ',');
				return `${wCm} × ${hCm} cm`;
			} else if (unit === 'mm') {
				const wMm = Math.round(w * 25.4);
				const hMm = Math.round(h * 25.4);
				return `${wMm} × ${hMm} mm`;
			} else if (unit === 'px') {
				const wPx = Math.round(w * 300);
				const hPx = Math.round(h * 300);
				return `${wPx} × ${hPx} px`;
			}
		}

		function updateSuiteDimensions() {
			const fmt = formatSelect.value;
			const unit = unitSelect.value;
			const border = parseFloat(borderRevealSelect.value) || 0;

			let outerW = 6.38, outerH = 9.02, outerName = 'DIN C5 (162×229 mm)';
			let backerW = 5.83, backerH = 8.27; // A5
			let mainW = 5.83, mainH = 8.27;
			let detailsW = 4.13, detailsH = 5.83; // A6
			let rsvpCardW = 4.13, rsvpCardH = 5.83, rsvpEnvW = 4.49, rsvpEnvH = 6.38; // C6
			let bellyW = 1.75, bellyL = 13.00;

			if (fmt === 'uk-metric') {
				formatBadge.textContent = 'DIN A5 Standard-Set';
				outerW = 6.38; outerH = 9.02; outerName = 'DIN C5 (162×229 mm)';
				backerW = 5.83; backerH = 8.27;
				mainW = 5.83 - (border * 2); mainH = 8.27 - (border * 2);
				detailsW = 4.13; detailsH = 5.83;
				rsvpCardW = 4.13; rsvpCardH = 5.83; rsvpEnvW = 4.49; rsvpEnvH = 6.38;
				bellyW = 1.75; bellyL = 13.00;
			} else if (fmt === 'a7-standard') {
				formatBadge.textContent = 'DIN A6 Klassik-Set';
				outerW = 4.49; outerH = 6.38; outerName = 'DIN C6 (114×162 mm)';
				backerW = 4.13; backerH = 5.83;
				mainW = 4.13 - (border * 2); mainH = 5.83 - (border * 2);
				detailsW = 3.00; detailsH = 4.50;
				rsvpCardW = 3.00; rsvpCardH = 4.13; rsvpEnvW = 3.50; rsvpEnvH = 4.50;
				bellyW = 1.50; bellyL = 10.00;
			} else if (fmt === 'tea-length') {
				formatBadge.textContent = 'DIN Lang (DL) Hochformat';
				outerW = 4.33; outerH = 8.66; outerName = 'DIN Lang (110×220 mm)';
				backerW = 3.94; backerH = 8.27;
				mainW = 3.94 - (border * 2); mainH = 8.27 - (border * 2);
				detailsW = 3.50; detailsH = 5.50;
				rsvpCardW = 3.50; rsvpCardH = 4.13; rsvpEnvW = 4.49; rsvpEnvH = 6.38;
				bellyW = 1.75; bellyL = 9.50;
			} else if (fmt === 'square-6') {
				formatBadge.textContent = 'Quadratisch 15×15 cm';
				outerW = 6.10; outerH = 6.10; outerName = 'Quadrat (155×155 mm)';
				backerW = 5.71; backerH = 5.71;
				mainW = 5.71 - (border * 2); mainH = 5.71 - (border * 2);
				detailsW = 4.13; detailsH = 4.13;
				rsvpCardW = 3.94; rsvpCardH = 3.94; rsvpEnvW = 4.33; rsvpEnvH = 4.33;
				bellyW = 1.75; bellyL = 13.00;
			} else if (fmt === 'a7-layered') {
				formatBadge.textContent = 'Pocketfold & Mehrlagen-Set';
				outerW = 5.50; outerH = 7.80; outerName = 'Pocketfold-Umschlag (140×195 mm)';
				backerW = 5.12; backerH = 7.28;
				mainW = 4.72; mainH = 6.89;
				detailsW = 4.72; detailsH = 5.50;
				rsvpCardW = 4.13; rsvpCardH = 4.72; rsvpEnvW = 4.49; rsvpEnvH = 5.12;
				bellyW = 1.75; bellyL = 12.00;
			} else if (fmt === 'a8-luxe') {
				formatBadge.textContent = 'US A7 Format (5×7 Zoll)';
				outerW = 5.25; outerH = 7.25; outerName = 'US A7 (133×184 mm)';
				backerW = 5.00; backerH = 7.00;
				mainW = 5.00 - (border * 2); mainH = 7.00 - (border * 2);
				detailsW = 4.25; detailsH = 5.50;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 1.75; bellyL = 11.50;
			}

			// Update Text Displays
			specOuter.textContent = `${formatDim(outerW, outerH, unit)} (${outerName})`;
			specBacker.textContent = border > 0 ? formatDim(backerW, backerH, unit) : 'Nicht erforderlich (Einlagig)';
			specMain.textContent = formatDim(mainW, mainH, unit);
			specDetails.textContent = formatDim(detailsW, detailsH, unit);
			specRsvp.textContent = `Karte: ${formatDim(rsvpCardW, rsvpCardH, unit)} | Umschlag: ${formatDim(rsvpEnvW, rsvpEnvH, unit)}`;
			specBelly.textContent = formatDim(bellyW, bellyL, unit);

			// Visibility Toggles
			rowDetails.style.display = layerDetailsCheck.checked ? 'flex' : 'none';
			rowRsvp.style.display = layerRsvpCheck.checked ? 'flex' : 'none';
			rowBelly.style.display = layerBellyCheck.checked ? 'flex' : 'none';
		}

		// Listeners
		[formatSelect, unitSelect, borderRevealSelect, layerDetailsCheck, layerRsvpCheck, layerBellyCheck].forEach(elem => {
			elem.addEventListener('change', updateSuiteDimensions);
		});

		// Print Spec Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Hochzeits-Papeterie Zuschnittplan — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Hochzeits-Papeterie Zuschnittplan & Spezifikationen</h1>
					<p>Format: ${formatBadge.textContent} | Maßeinheit: ${unitSelect.options[unitSelect.selectedIndex].text}</p>
					
					<table>
						<thead><tr><th>Papeterie-Element</th><th>Endzuschnitt-Maß</th><th>Beschnittzugabe (Bleed)</th></tr></thead>
						<tbody>
							<tr><td><strong>Versand-Briefumschlag</strong></td><td>${specOuter.textContent}</td><td>Briefumschlag</td></tr>
							<tr><td><strong>Trägerkarton (Backer Mat)</strong></td><td>${specBacker.textContent}</td><td>Basis-Lage</td></tr>
							<tr><td><strong>Bedruckte Hauptkarte</strong></td><td><strong>${specMain.textContent}</strong></td><td>+3,0 mm rundum erforderlich</td></tr>
							<tr><td><strong>Infokarte / Ablauf</strong></td><td>${specDetails.textContent}</td><td>Einleger</td></tr>
							<tr><td><strong>Antwortkarte (RSVP) & Umschlag</strong></td><td>${specRsvp.textContent}</td><td>Antwort-Set</td></tr>
							<tr><td><strong>Banderole (Belly Band)</strong></td><td>${specBelly.textContent}</td><td>Verschlussband</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Hochzeits-Papeterie Maße</title>
				<style>body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Papeterie- & Zuschnittplan</h2>
					<p>Format: ${formatBadge.textContent}</p>
					<table>
						<thead><tr><th>Element</th><th>Zuschnittmaß</th></tr></thead>
						<tbody>
							<tr><td>Versandumschlag</td><td>${specOuter.textContent}</td></tr>
							<tr><td>Trägerkarton</td><td>${specBacker.textContent}</td></tr>
							<tr><td>Hauptkarte</td><td>${specMain.textContent}</td></tr>
							<tr><td>Infokarte</td><td>${specDetails.textContent}</td></tr>
							<tr><td>RSVP-Set</td><td>${specRsvp.textContent}</td></tr>
							<tr><td>Banderole</td><td>${specBelly.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'hochzeits-papeterie-zuschnittplan.doc';
			link.click();
		});

		// Initial Calculation
		updateSuiteDimensions();
	</script>
</Layout>
