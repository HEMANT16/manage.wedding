---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Hochzeitspapeterie, Einladungs- & Kreativ-Tools (Kostenlos) | Manage.Wedding";
const description = "Kostenlose Tools für Hochzeitspapeterie: Umschlag-Adressierung nach Knigge, DIN-Formate (A5/A6/DIN Lang), Portorechner, Tischkarten und Hochzeitsreden-Planer.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/de/stationery/#collection",
      "name": "Hochzeitspapeterie & Kreativ-Tools",
      "url": "https://manage.wedding/de/stationery",
      "inLanguage": "de",
      "description": "Umfassende Sammlung von Werkzeugen für Umschlag-Adressierung, Einladungsformate, Portoberechnung der Deutschen Post, Tischkarten und Redezeit-Kalkulation.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Briefumschlag Adressierung & Knigge", "url": "https://manage.wedding/de/wedding-envelope-addressing" },
        { "@type": "WebApplication", "name": "Einladungsformate & Maße (A6 / B6 / A7)", "url": "https://manage.wedding/de/wedding-invitation-suite-sizer" },
        { "@type": "WebApplication", "name": "Portorechner für Hochzeitspost", "url": "https://manage.wedding/de/wedding-invitation-postage-calculator" },
        { "@type": "WebApplication", "name": "Tisch- & Platzkarten Drucken", "url": "https://manage.wedding/de/table-place-cards" },
        { "@type": "WebApplication", "name": "Danksagungstexte & Vorlagen", "url": "https://manage.wedding/de/wedding-thank-you-cards" },
        { "@type": "WebApplication", "name": "Digitale Hochzeitseinladungen", "url": "https://manage.wedding/de/digital-invitations" },
        { "@type": "WebApplication", "name": "Hochzeitsrede & Zeitplaner", "url": "https://manage.wedding/de/wedding-speech-calculator" },
        { "@type": "WebApplication", "name": "Hochzeits-Hashtag Generator", "url": "https://manage.wedding/de/wedding-hashtag-generator" },
        { "@type": "WebApplication", "name": "Numerologie des Hochzeitsdatums", "url": "https://manage.wedding/de/wedding-date-numerology" },
        { "@type": "WebApplication", "name": "Hochzeitstage & Geschenk-Ratgeber", "url": "https://manage.wedding/de/anniversary-gift-finder" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Welche Maße und Formate sind für Hochzeitseinladungen in Deutschland üblich?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die beliebtesten Formate sind DIN A6 (105 × 148 mm), DIN Lang (105 × 210 mm) sowie quadratische Karten (140 × 140 mm oder 150 × 150 mm). Passende Briefumschläge sind DIN C6, DIN Lang bzw. quadratische Kuverts."
          }
        },
        {
          "@type": "Question",
          "name": "Welches Porto benötigt ein Brief mit Hochzeitseinladung und Wachssiegel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Standardbrief (bis 20 g, max. 5 mm Dicke) kostet 0,85 €. Wiegt die Karte durch schweres Papier (300 g/m²) und Einleger über 20 g oder entsteht durch ein Wachssiegel oder eine Schleife eine Dicke über 5 mm, wird ein Kompaktbrief (bis 50 g, max. 10 mm Dicke für 1,00 €) oder Großbrief (bis 500 g, max. 20 mm Dicke für 1,60 €) fällig."
          }
        },
        {
          "@type": "Question",
          "name": "Wie lange sollte eine Hochzeitsrede der Trauzeugen oder Brauteltern dauern?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die optimale Dauer liegt bei 3 bis 5 Minuten (ca. 350 bis 550 Wörter bei einem ruhigen, natürlichen Sprechtempo von 110–130 Wörtern pro Minute). Ab 6 Minuten nimmt die Aufmerksamkeit der Hochzeitsgesellschaft spürbar ab."
          }
        }
      ]
    }
  ]
};

const stationeryTools = [
  {
    title: "Playlist-Dauer & Song-Rechner",
    url: "/de/wedding-playlist-duration-calculator",
    icon: "🎵",
    badge: "Musik-Timing",
    desc: "Berechnen Sie benötigte Titel für Empfang, Dinner, Eröffnungstanz und Party. Inklusive DJ-Briefing und Blacklist-Generator.",
    tags: ["Hochzeitsmusik", "Songs pro Stunde", "DJ-Briefing"]
  },

  {
    title: "Briefumschlag Adressierung & Knigge",
    url: "/de/wedding-envelope-addressing",
    icon: "✉️",
    badge: "Knigge & CSV",
    desc: "Umschläge formvollendet beschriften für Ehepaare, Familien, Doktortitel und Einzelgäste mit Word- und PDF-Seriendruck.",
    tags: ["DIN C6 / B6 / Lang", "Druckfertige PDF", "Anrede-Knigge"]
  },
  {
    title: "Einladungsformate & Maße (DIN A6 / Lang / A5)",
    url: "/de/wedding-invitation-suite-sizer",
    icon: "📐",
    badge: "Canva 300 DPI Specs",
    desc: "Exakte Millimetermaße, 3mm Beschnittzugabe und Umschlaggrößen für Einleger, Antwortkarten und Infokarten berechnen.",
    tags: ["DIN A6 & Lang", "3mm Beschnitt", "300 DPI Canva"]
  },
  {
    title: "Portorechner für Hochzeitspost",
    url: "/de/wedding-invitation-postage-calculator",
    icon: "📮",
    badge: "Deutsche Post Tarife",
    desc: "Gewicht von Papiergrammaturen (250–350 g/m²), Wachssiegeln und Bändern berechnen und Portostufen (Standard, Kompakt, Großbrief) ermitteln.",
    tags: ["Wachssiegel", "Portostufen €", "Gewichtsrechner"]
  },
  {
    title: "Tisch- & Platzkarten Drucken",
    url: "/de/table-place-cards",
    icon: "🏷️",
    badge: "Druckfertig",
    desc: "Faltbare Tischkärtchen mit Namen, Tischnummer und Essens-Symbolen (Fleisch, Fisch, Vegetarisch, Vegan) für den Service drucken.",
    tags: ["Klappkarten", "Druckbare PDF", "Menü-Piktogramme"]
  },
  {
    title: "Danksagungstexte & Vorlagen",
    url: "/de/wedding-thank-you-cards",
    icon: "✍️",
    badge: "Textbausteine",
    desc: "Herzliche, stilvolle Dankestexte für Geldgeschenke, Hochzeitsgeschenke, Flitterwochen-Beiträge und die Unterstützung der Trauzeugen.",
    tags: ["Danksagungen", "Geldgeschenke", "Herzliche Texte"]
  },
  {
    title: "Digitale Hochzeitseinladungen",
    url: "/de/digital-invitations",
    icon: "💌",
    badge: "E-Invites",
    desc: "Erstellen Sie moderne, smartphone-optimierte digitale Einladungen und Save-the-Dates mit Kalender-Export (.ics) und Online-Rückmeldung.",
    tags: ["Online-Einladung", "Save-The-Date", "Digitales RSVP"]
  },
  {
    title: "Hochzeitsrede & Zeitplaner",
    url: "/de/wedding-speech-calculator",
    icon: "🎙️",
    badge: "Sprechtempo-Timer",
    desc: "Fügen Sie Ihre Rede oder Ihr Eheversprechen ein, um die exakte Lesezeit (110–130 Wörter/Min.) zu messen und 16pt Spickzettel zu drucken.",
    tags: ["Sprechtempo", "Druckbare Spickzettel", "Ehegelübde"]
  },
  {
    title: "Hochzeits-Hashtag Generator",
    url: "/de/wedding-hashtag-generator",
    icon: "#️⃣",
    badge: "50+ Ideen",
    desc: "Generieren Sie über 50 originelle, romantische oder humorvolle Hochzeits-Hashtags und erstellen Sie druckbare Tischaufsteller für Fotos.",
    tags: ["Instagram-Hashtags", "Tischaufsteller", "Wortspiele"]
  },
  {
    title: "Numerologie des Hochzeitsdatums",
    url: "/de/wedding-date-numerology",
    icon: "✨",
    badge: "Bedeutung & Symbolik",
    desc: "Berechnen Sie die Lebenswegzahl Ihres Paares, die Schwingung Ihres Hochzeitsdatums und die symbolische Bedeutung Ihrer Verbindung.",
    tags: ["Lebenswegzahl", "Datums-Bedeutung", "Symbolik"]
  },
  {
    title: "Hochzeitstage & Geschenk-Ratgeber",
    url: "/de/anniversary-gift-finder",
    icon: "💎",
    badge: "Jahr 1 bis 60",
    desc: "Entdecken Sie traditionelle und moderne Jubiläumsbezeichnungen (Papierne, Hölzerne, Zinnerne, Silberne, Goldene Hochzeit) und Geschenkideen.",
    tags: ["Traditionelle Noces", "Geschenkideen", "Glückwunschtexte"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Papeterie- & Kreativ-Zentrale</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Hochzeitspapeterie <span class="accent-italic">& Kreativ-Tools</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Gestalten Sie Umschlag-Beschriftungen nach Knigge, berechnen Sie Briefgewichte und Portokosten, erstellen Sie Tischkarten und proben Sie Ihre Hochzeitsrede.
      </p>
    </header>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
      {stationeryTools.map(tool => (
        <a href={tool.url} class="hand-card tool-item-card" style="display: flex; flex-direction: column; justify-content: space-between; text-decoration: none; padding: 1.75rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); transition: transform 0.2s ease, box-shadow 0.2s ease;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span class="tool-tag" style="background: #fdf2f8; border: 1.5px solid var(--fg-pencil); font-size: 0.8rem; font-weight: 700; color: #9d174d;">{tool.badge}</span>
            </div>
            
            <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0; line-height: 1.3;">
              {tool.title}
            </h3>
            
            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin: 0 0 1.25rem 0;">
              {tool.desc}
            </p>
          </div>

          <div>
            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.25rem;">
              {tool.tags.map(tag => (
                <span style="font-size: 0.75rem; background: #f1f5f9; color: #475569; padding: 2px 8px; border-radius: 3px; font-weight: 600;">#{tag}</span>
              ))}
            </div>
            
            <span class="hand-btn" style="display: block; text-align: center; padding: 8px; font-size: 0.95rem;">
              Rechner öffnen →
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- SEO Informational Article -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 3rem;">
      <h2 class="font-heading" style="font-size: 2.2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
        Papeterie-Knigge & Tipps für perfekte Hochzeitseinladungen
      </h2>
      
      <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 1.5rem;">
        Die Hochzeitspapeterie ist der erste offizielle Eindruck, den Ihre Gäste von Ihrem Fest erhalten. Vom stimmigen Design über die korrekte Anrede auf dem Umschlag bis hin zur rechtzeitigen Portokontrolle sorgen unsere Werkzeuge für ein makelloses Ergebnis.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin: 2rem 0;">
        <div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
          <h4 class="font-heading" style="color: var(--accent-red); margin-top: 0; font-size: 1.15rem;">1. Anrede auf dem Umschlag</h4>
          <p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0;">
            Klassisch: Bei verheirateten Paaren mit gleichem Nachnamen „Frau Maria und Herrn Thomas Müller“; bei unterschiedlichen Nachnamen werden beide Namen voll ausgeschrieben.
          </p>
        </div>

        <div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
          <h4 class="font-heading" style="color: var(--accent-blue); margin-top: 0; font-size: 1.15rem;">2. Wachssiegel & Frankierung</h4>
          <p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0;">
            Wachssiegel und dicke Schleifenbänder führen oft zu einer Überschreitung der 5mm-Dickenbegrenzung für Standardbriefe. Lassen Sie immer einen Musterbrief in der Postfiliale wiegen.
          </p>
        </div>

        <div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
          <h4 class="font-heading" style="color: #16a34a; margin-top: 0; font-size: 1.15rem;">3. Reserve-Exemplare</h4>
          <p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0;">
            Bestellen Sie stets 10% bis 15% mehr Einladungskarten und Umschläge als berechnet – für Nachladungen, Beschriftungsfehler und Erinnerungsfotos.
          </p>
        </div>
      </div>
    </article>

  </main>
</Layout>
