---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Gäste-, Sitzplan- & Logistik-Rechner für die Hochzeit (Kostenlos) | Manage.Wedding";
const description = "Kostenlose Hochzeits-Logistiktools: Interaktiver Tisch- & Sitzplaner, Tanzflächen-Rechner, Einzugsreihenfolge der Zeremonie und minutengenauer Tagesablauf.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/de/guests/#collection",
      "name": "Gäste-, Sitzplan- & Logistik-Rechner",
      "url": "https://manage.wedding/de/guests",
      "inLanguage": "de",
      "description": "Umfassende Suite interaktiver Tools für Sitzpläne per Drag & Drop, Abstands- & Tanzflächenberechnungen, Ablaufpläne für Standesamt/Kirche und Tagesregiepläne.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Interaktiver Tisch- & Sitzplaner", "url": "https://manage.wedding/de/seating-chart-maker" },
        { "@type": "WebApplication", "name": "Tanzfläche & Abstandsplaner", "url": "https://manage.wedding/de/seating-clearance-calculator" },
        { "@type": "WebApplication", "name": "Einzug & Ablauf der Zeremonie", "url": "https://manage.wedding/de/wedding-processional-order" },
        { "@type": "WebApplication", "name": "Tagesablauf & Zeitplan Generator", "url": "https://manage.wedding/de/day-of-timeline-generator" },
        { "@type": "WebApplication", "name": "Polterabend & Generalprobe Planer", "url": "https://manage.wedding/de/rehearsal-dinner-planner" },
        { "@type": "WebApplication", "name": "Gästelisten Manager", "url": "https://manage.wedding/de/guest-list-manager" },
        { "@type": "WebApplication", "name": "Rückmeldungs- & RSVP-Tracker", "url": "https://manage.wedding/de/rsvp-tracker" },
        { "@type": "WebApplication", "name": "Gästeanzahl & Absagen-Schätzer", "url": "https://manage.wedding/de/guest-count-estimator" },
        { "@type": "WebApplication", "name": "Fristenrechner für Hochzeitseinladungen", "url": "https://manage.wedding/de/rsvp-date-calculator" },
        { "@type": "WebApplication", "name": "Freie Trauung Ablauf & Trauredner Skript", "url": "https://manage.wedding/de/wedding-officiant-script-timer" },
        { "@type": "WebApplication", "name": "12-Monats-Hochzeitscheckliste", "url": "https://manage.wedding/de/wedding-checklist" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mit wie vielen Absagen muss man bei einer Hochzeit rechnen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei regionalen Hochzeiten sagen erfahrungsgemäß 10% bis 15% der eingeladenen Gäste ab. Bei Destination Weddings oder Feiern mit weiter Anreise und Hotelübernachtung liegt die Absagequote meist bei 20% bis 30%."
          }
        },
        {
          "@type": "Question",
          "name": "Wie groß sollte die Tanzfläche für 100 bis 150 Hochzeitsgäste sein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Man rechnet damit, dass etwa 30% bis 50% der Gäste gleichzeitig tanzen. Pro Tänzer benötigt man ca. 0,4 bis 0,5 m² Bewegungsfläche. Für 100 bis 150 Gäste ist eine Tanzfläche von 20 bis 30 m² (z. B. 4,5 × 5 m bis 5 × 6 m) optimal."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel Abstand muss zwischen runden Bankettischen eingehalten werden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zwischen den Tischkanten runder Tische sollte ein Mindestabstand von 1,50 m eingehalten werden. Dies garantiert 45 cm für das Zurückschieben der Stühle auf jeder Seite plus einen 60 cm breiten Servicegang für Kellner und Gäste."
          }
        }
      ]
    }
  ]
};

const guestTools = [
  {
    title: "Wunderkerzen & Schilder-Rechner",
    url: "/de/wedding-sparkler-calculator",
    icon: "✨",
    badge: "Druckfertige Schilder",
    desc: "Berechnen Sie benötigte Wunderkerzen, Fotofenster, Sturmfeuerzeuge und Sandeimer. Inklusive 'Lasst Liebe Funken Sprühen'-Schilder.",
    tags: ["Spalier-Auszug", "Druckfertige Schilder", "Sicherheitskarten"]
  },

  {
    title: "Interaktiver Tisch- & Sitzplaner",
    url: "/de/seating-chart-maker",
    icon: "🪑",
    badge: "Drag & Drop",
    desc: "Visuelle Tischordnung für Rundtische und lange Tafeln. Gäste einfach per Drag & Drop zuweisen, Tische ausbalancieren und als PDF exportieren.",
    tags: ["Visueller Planer", "PDF-Export", "Tischbalance"]
  },
  {
    title: "Tanzfläche & Abstandsplaner",
    url: "/de/seating-clearance-calculator",
    icon: "📐",
    badge: "Raumgeometrie",
    desc: "Berechnen Sie die benötigte Tanzflächen-Quadratmeterzahl, Abstände zwischen Tischen (1,5m Regel) und Raumkapazitäten.",
    tags: ["Tanzfläche m²", "Rundtische 150cm", "Raumbedarf"]
  },
  {
    title: "Einzug & Ablauf der Zeremonie",
    url: "/de/wedding-processional-order",
    icon: "⛪",
    badge: "Zeremonie-Ablauf",
    desc: "Erstellen Sie die Aufstellung für den Einzug und Auszug bei kirchlichen, standesamtlichen und freien Trauungen mit Trauzeugen und Blumenkindern.",
    tags: ["Einzug Zeremonie", "Kirchenablauf", "Druckbare Karten"]
  },
  {
    title: "Freie Trauung Ablauf & Trauredner Skript",
    url: "/de/wedding-officiant-script-timer",
    icon: "📜",
    badge: "Rede & A5-Karten",
    desc: "Planen und timen Sie den Ablauf der freien Trauung in 9 Phasen (120 WpM) mit Live-Teleprompter und druckbaren A5-Moderationskarten.",
    tags: ["Ablauf Freie Trauung", "Trauredner Skript", "A5-Moderationskarten"]
  },
  {
    title: "Tagesablauf & Zeitplan Generator",
    url: "/de/day-of-timeline-generator",
    icon: "⏰",
    badge: "Top Bewertet",
    desc: "Geben Sie die Uhrzeit der Trauung ein und erhalten Sie einen minutengenauen Ablaufplan für Brautstyling, Fotograf, Sektempfang und Abendessen.",
    tags: ["Minutengenau", "Dienstleister-Plan", "Ablauf Hochzeit"]
  },
  {
    title: "Polterabend & Generalprobe Planer",
    url: "/de/rehearsal-dinner-planner",
    icon: "🍷",
    badge: "Vorabend-Planer",
    desc: "Kalkulieren Sie Gästeanzahl, Verpflegung und Ablauf für den Polterabend, Probe-Essen oder Get-Together am Vorabend der Hochzeit.",
    tags: ["Polterabend", "Get-Together", "Vorabend-Budget"]
  },
  {
    title: "Gästelisten Manager",
    url: "/de/guest-list-manager",
    icon: "📋",
    badge: "100% Privat",
    desc: "Erfassen Sie Namen, Begleitpersonen (+1), Postadressen, Menüwünsche und Allergien sicher im lokalen Browserspeicher ohne Cloud-Tracking.",
    tags: ["Begleitpersonen", "CSV-Export", "Menüwünsche"]
  },
  {
    title: "Rückmeldungs- & RSVP-Tracker",
    url: "/de/rsvp-tracker",
    icon: "✉️",
    badge: "Echtzeit-Übersicht",
    desc: "Verfolgen Sie Zusagen, Absagen, Menüauswahlen und ausstehende Rückmeldungen mit interaktiven Fortschrittsbalken.",
    tags: ["Zusagen & Absagen", "Menüauswertung", "Gästezahl-Lock"]
  },
  {
    title: "Gästeanzahl & Absagen-Schätzer",
    url: "/de/guest-count-estimator",
    icon: "👥",
    badge: "Wahrscheinlichkeits-Modell",
    desc: "Berechnen Sie die realistische Teilnehmerzahl anhand von Quoten für lokale und von weit her anreisende Hochzeitsgäste.",
    tags: ["Teilnahmequote", "Location-Limit", "Absage-Quote"]
  },
  {
    title: "Fristenrechner für Hochzeitseinladungen",
    url: "/de/rsvp-date-calculator",
    icon: "📬",
    badge: "Versand-Zeitplan",
    desc: "Geben Sie Ihr Hochzeitsdatum ein und berechnen Sie optimale Stichtage für Save-the-Date, Einladungsversand und Meldefristen an den Caterer.",
    tags: ["Versandfristen", "Catering-Stichtag", "Rückmeldedatum"]
  },
  {
    title: "12-Monats-Hochzeitscheckliste",
    url: "/de/wedding-checklist",
    icon: "✅",
    badge: "Interaktiv",
    desc: "Monat für Monat alle wichtigen Erledigungen im Blick behalten – mit Speicherfunktion für eigene Notizen und Aufgaben.",
    tags: ["12-Monate-Plan", "Fortschrittsbalken", "Aufgabenplaner"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Gäste-, Sitzplan- & Logistik-Zentrale</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Gäste-, Sitzplan- <span class="accent-italic">& Logistik-Tools</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Gestalten Sie Sitzpläne visuell per Drag & Drop, optimieren Sie Raumabstände und Tanzflächen und erstellen Sie einen minutengenauen Tagesablauf.
      </p>
    </header>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
      {guestTools.map(tool => (
        <a href={tool.url} class="hand-card tool-item-card" style="display: flex; flex-direction: column; justify-content: space-between; text-decoration: none; padding: 1.75rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); transition: transform 0.2s ease, box-shadow 0.2s ease;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span class="tool-tag" style="background: #f3e8ff; border: 1.5px solid var(--fg-pencil); font-size: 0.8rem; font-weight: 700; color: #6b21a8;">{tool.badge}</span>
            </div>
            
            <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0; line-height: 1.3;">
              {tool.title}
            </h3>
            
            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin: 0 0 1.25rem 0;">
              {tool.desc}
            </p>
          </div>

          <div>
            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.25rem;">
              {tool.tags.map(tag => (
                <span style="font-size: 0.75rem; background: #f1f5f9; color: #475569; padding: 2px 8px; border-radius: 3px; font-weight: 600;">#{tag}</span>
              ))}
            </div>
            
            <span class="hand-btn" style="display: block; text-align: center; padding: 8px; font-size: 0.95rem;">
              Rechner öffnen →
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- SEO Informational Article -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 3rem;">
      <h2 class="font-heading" style="font-size: 2.2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
        Logistik-Leitfaden für einen reibungslosen Hochzeitstag
      </h2>
      
      <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 1.5rem;">
        Ein gelungener Hochzeitstag basiert auf einer durchdachten Logistik im Hintergrund. Wenn Dienstleister genau wissen, wann welcher Programmpunkt stattfindet, und die Tische so angeordnet sind, dass Service und Gäste ausreichend Platz haben, entsteht eine entspannte Atmosphäre ohne Hektik.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin: 2rem 0;">
        <div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
          <h4 class="font-heading" style="color: var(--accent-red); margin-top: 0; font-size: 1.15rem;">1. Der 1,5m Tischabstand</h4>
          <p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0;">
            Achten Sie bei der Raumplanung darauf, dass zwischen den Tischkanten mindestens 1,50 m Freiraum bleiben, damit Servicekräfte Teller servieren können, ohne an Stühlen hängenzubleiben.
          </p>
        </div>

        <div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
          <h4 class="font-heading" style="color: var(--accent-blue); margin-top: 0; font-size: 1.15rem;">2. Pufferzeiten im Tagesablauf</h4>
          <p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0;">
            Planen Sie nach der Trauung und vor dem Abendessen jeweils 15–30 Minuten Pufferzeit ein für Gruppenfotos, Gratulationen und Fahrwege.
          </p>
        </div>

        <div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
          <h4 class="font-heading" style="color: #16a34a; margin-top: 0; font-size: 1.15rem;">3. Einzug & Zeremonie-Regie</h4>
          <p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0;">
            Klären Sie mit Trauzeugen und Blumenkindern vorab die Schrittgeschwindigkeit und den Abstand beim Einzug (4 bis 6 Schritte Abstand).
          </p>
        </div>
      </div>
    </article>

  </main>
</Layout>
