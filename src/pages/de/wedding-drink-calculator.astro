---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-drink-calculator/#webapp",
      "name": "Hochzeits-Getränkerechner & Bar-Mengenplaner",
      "url": "https://manage.wedding/de/wedding-drink-calculator",
      "description": "Kostenloser Getränkerechner für die Hochzeit: Berechnen Sie präzise Flaschenmengen für Wein, Bierkästen, Spirituosen, Sekt für den Sektempfang, Mischgetränke und Eiswürfel in kg.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "de",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie man die Getränkemenge für eine Hochzeit berechnet",
      "description": "Schritt-für-Schritt-Methode zur Kalkulation von Wein, Bier, Cocktails, Sekt und Eis für Ihre Hochzeitsbar.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Gästeanzahl & Dauer der Feier erfassen",
          "text": "Geben Sie die Anzahl der erwachsenen Gäste und die Bar-Öffnungszeiten in Stunden ein (typisch sind 5 bis 8 Stunden)."
        },
        {
          "@type": "HowToStep",
          "name": "2. Bar-Typ & Trinkfreude wählen",
          "text": "Wählen Sie zwischen voller Bar (Bier, Wein, Spirituosen) oder Soft-Bar (Bier & Wein) sowie dem Trinkverhalten Ihrer Hochzeitsgesellschaft."
        },
        {
          "@type": "HowToStep",
          "name": "3. Sektempfang hinzufügen",
          "text": "Aktivieren Sie die Option Sektempfang, um 1 Glas Sekt/Champagner pro Gast (6 Gläser pro 0,75l Flasche) einzuplanen."
        },
        {
          "@type": "HowToStep",
          "name": "4. Einkaufsliste prüfen & exportieren",
          "text": "Erhalten Sie eine exakte Einkaufsliste mit Weinflaschen, Bierkästen (24er), Schnapsflaschen, Litern Softdrinks und Eiswürfeln in kg."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie viel Alkohol trinkt ein Gast durchschnittlich auf einer Hochzeit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Als Faustregel gilt: 1 Getränk pro Gast und Stunde (in den ersten zwei Stunden oft 1,5 bis 2 Getränke, danach 0,5 bis 1). Über einen 6-stündigen Abend trinkt ein Gast im Schnitt 5 bis 7 alkoholische Getränke."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele Gläser Wein sind in einer 0,75l Flasche?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eine Standard-Weinflasche (750 ml) ergibt genau 5 Gläser Wein à 150 ml (0,15 l Ausschankmaß)."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele Gläser Sekt bekommt man aus einer Flasche?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für den Sektempfang oder Brauttoast rechnet man mit 6 Gläsern à 100 ml (0,1 l Sektkelch) pro 0,75l Flasche Sekt, Prosecco oder Champagner."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel Eis benötigt man für eine Hochzeitsbar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Planen Sie ca. 0,75 kg Eis pro Gast ein (für Cocktail-Zubereitung und das Kühlen von Flaschen in Kübeln oder Wannen)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Getränkerechner Hochzeit (Kostenloser Alkohol- & Barmengen-Planer) | Manage.Wedding"
	description="Kostenloser Hochzeits-Getränkerechner: Berechnen Sie die exakte Menge an Wein, Bier (Kästen), Spirituosen, Softdrinks, Sekt für den Sektempfang & Eiswürfel in kg."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<Breadcrumb title="Getränkerechner Hochzeit" category="dining" />
		
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); margin-bottom: 0.5rem; font-weight: 500;">
				Hochzeits <span class="accent-italic">Getränkerechner</span>
			</h1>
			<p class="font-body" style="color: var(--secondary-ink); max-width: 680px; margin: 0 auto; font-size: 1.15rem;">
				Geben Sie Ihre Gästezahl und Feierdauer ein, um exakt zu berechnen, wie viele Weinflaschen, Bierkästen, Schnapsflaschen, Softdrinks und Kilogramm Eis Sie für Ihre Bar benötigen.
			</p>
		</header>

		<div class="home-grid fade-in" style="animation-delay: 0.2s; max-width: 850px; margin: 0 auto;">
			
			<div class="hand-card" style="padding: 1.75rem;">
				<h2 class="font-heading" style="font-size: 1.3rem; margin-top: 0; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					🍹 Bar-Details festlegen
				</h2>

				<form id="calc-form">
					<div class="form-group" style="margin-bottom: 1rem;">
						<label class="form-label" for="guests" style="font-weight: bold; display: block; margin-bottom: 0.3rem;">Anzahl der erwachsenen Gäste</label>
						<input type="number" id="guests" class="form-input" value="100" min="1" max="1000" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
					</div>

					<div class="form-group" style="margin-bottom: 1rem;">
						<label class="form-label" for="hours" style="font-weight: bold; display: block; margin-bottom: 0.3rem;">Dauer der Feier / Bar-Öffnung (Stunden)</label>
						<input type="number" id="hours" class="form-input" value="6" min="1" max="24" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
					</div>

					<div class="form-group" style="margin-bottom: 1rem;">
						<label class="form-label" for="barType" style="font-weight: bold; display: block; margin-bottom: 0.3rem;">Bar-Typ / Getränkeauswahl</label>
						<select id="barType" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
							<option value="open">Offene Vollbar (Bier, Wein, Cocktails & Longdrinks)</option>
							<option value="soft">Klassische Bar (Nur Bier, Wein & Sekt)</option>
						</select>
					</div>

					<div class="form-group" style="margin-bottom: 1rem;">
						<label class="form-label" for="vibe" style="font-weight: bold; display: block; margin-bottom: 0.3rem;">Trinkfreude der Gesellschaft</label>
						<select id="vibe" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
							<option value="average" selected>Normal / Ausgewogen (1 Getränk / Stunde p.P.)</option>
							<option value="light">Eher verhalten / Familienfeier (-25% Verbrauch)</option>
							<option value="heavy">Partyfreudig / Trinkfest (+25% Verbrauch)</option>
						</select>
					</div>

					<div class="form-group" style="margin-bottom: 1.5rem;">
						<label class="form-label" for="champagne" style="font-weight: bold; display: block; margin-bottom: 0.3rem;">Sektempfang / Sekt-Toast einplanen?</label>
						<select id="champagne" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
							<option value="yes" selected>Ja (1 Glas Sekt/Prosecco pro Gast)</option>
							<option value="no">Nein (Kein separater Sektempfang)</option>
						</select>
					</div>

					<button type="submit" id="calc-btn" class="hand-btn" style="width: 100%; padding: 0.75rem; font-size: 1.1rem;">
						🍺 Getränkemengen berechnen
					</button>
				</form>
			</div>

			<div class="hand-card result-box" id="result-container" style="padding: 1.75rem;">
				<h3 class="font-heading" style="margin-bottom: 1.5rem; text-align: center; font-size: 1.4rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					🛒 Ihre Einkaufsliste für die Bar
				</h3>
				
				<div class="result-item" style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb;">
					<div>
						<strong class="item-label" style="display: block; color: var(--fg-pencil);">GESAMT-PORTIONEN</strong>
						<span class="item-desc" style="font-size: 0.8rem; color: var(--text-secondary);">Erforderliche Gesamtanzahl an Drinks</span>
					</div>
					<strong class="item-value" id="res-total" style="font-size: 1.4rem; color: var(--accent-red);">600</strong>
				</div>

				<div class="result-item" style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb;">
					<div>
						<strong class="item-label" style="display: block; color: var(--fg-pencil);">BIER</strong>
						<span class="item-desc" style="font-size: 0.8rem; color: var(--text-secondary);">Kästen (24er-Kiste / 0,33l)</span>
					</div>
					<strong class="item-value" id="res-beer" style="font-size: 1.4rem; color: var(--accent-blue);">8 Kästen</strong>
				</div>

				<div class="result-item" style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb;">
					<div>
						<strong class="item-label" style="display: block; color: var(--fg-pencil);">WEIN (ROT / WEISS / ROSÉ)</strong>
						<span class="item-desc" style="font-size: 0.8rem; color: var(--text-secondary);">Standard-Flaschen (0,75l)</span>
					</div>
					<strong class="item-value" id="res-wine" style="font-size: 1.4rem; color: #16a34a;">48 Flaschen</strong>
				</div>

				<div class="result-item" id="liquor-box" style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb;">
					<div>
						<strong class="item-label" style="display: block; color: var(--fg-pencil);">SPIRITUOSEN / SCHNAPS</strong>
						<span class="item-desc" style="font-size: 0.8rem; color: var(--text-secondary);">Flaschen à 0,75l (Vodka, Gin, Rum)</span>
					</div>
					<strong class="item-value" id="res-liquor" style="font-size: 1.4rem; color: #d97706;">12 Flaschen</strong>
				</div>

				<div class="result-item" id="mixer-box" style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb;">
					<div>
						<strong class="item-label" style="display: block; color: var(--fg-pencil);">MISCHGETRÄNKE & SOFTDRINKS</strong>
						<span class="item-desc" style="font-size: 0.8rem; color: var(--text-secondary);">Liter Cola, Tonic, Säfte & Mineralwasser</span>
					</div>
					<strong class="item-value" id="res-mixers" style="font-size: 1.4rem; color: var(--fg-pencil);">34 Liter</strong>
				</div>

				<div class="result-item" id="champagne-box" style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb;">
					<div>
						<strong class="item-label" style="display: block; color: var(--fg-pencil);">SEKT / CHAMPAGNER</strong>
						<span class="item-desc" style="font-size: 0.8rem; color: var(--text-secondary);">Flaschen à 0,75l für den Sektempfang</span>
					</div>
					<strong class="item-value" id="res-champagne" style="font-size: 1.4rem; color: var(--accent-red);">17 Flaschen</strong>
				</div>

				<div class="result-item" style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0; border-bottom: 2px solid var(--fg-pencil);">
					<div>
						<strong class="item-label" style="display: block; color: var(--fg-pencil);">EISWÜRFEL & CRUSHED ICE</strong>
						<span class="item-desc" style="font-size: 0.8rem; color: var(--text-secondary);">Gesamtgewicht zum Kühlen & Mixen</span>
					</div>
					<strong class="item-value" id="res-ice" style="font-size: 1.4rem; color: var(--accent-blue);">75 kg</strong>
				</div>

				<div id="explanation-box" style="background-color: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.1); margin-top: 1.5rem; padding: 1.25rem; text-align: left;">
					<strong class="font-heading" style="font-size: 1.1rem; display: block; margin-bottom: 0.3rem; color: var(--accent-red);">Berechnungsgrundlage:</strong>
					<p id="explanation-text" class="font-body" style="font-size: 0.95rem; margin: 0; line-height: 1.5;">Kalkuliert auf Basis von 1 Getränk pro Gast und Stunde.</p>
				</div>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 3.5rem auto 2.5rem; max-width: 850px; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Richtwerte für die Hochzeitsbar (Auf einen Blick)
				</h3>
				<span style="background: #fff; border: 1.5px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700; color: var(--accent-red);">
					1-Minuten Bar-Formel
				</span>
			</div>

			<!-- Formula Highlight Box -->
			<div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<div style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--accent-red); margin-bottom: 0.35rem; font-weight: 700;">
					📐 Die bewährte Aufteilung für Hochzeiten:
				</div>
				<p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.5;">
					<strong>1 Getränk pro Gast / Stunde</strong> mit der Standardverteilung <strong>40% Wein</strong> (5 Gläser/Flasche), <strong>30% Bier</strong> (24 Flaschen/Kasten), <strong>30% Longdrinks/Cocktails</strong> (16 Drinks/Flasche) und <strong>ca. 0,75 kg Eis pro Gast</strong>.
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; margin-bottom: 1rem; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 560px;">
					<thead>
						<tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil);">Gäste (6 Std. Bar)</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil); text-align: center;">Gesamt-Drinks</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red); text-align: center;">Wein (0,75l)</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue); text-align: center;">Bier (24er Kästen)</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: #7c3aed; text-align: center;">Schnaps (0,75l)</th>
							<th style="padding: 0.6rem 0.75rem; font-weight: 700; color: var(--fg-pencil); text-align: right;">Eisbedarf</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">50 Gäste</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">300 Drinks</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">24 Flaschen</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">4 Kästen</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">6 Flaschen</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right;">35–50 kg</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fffbeb;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red);">⭐ 100 Gäste</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">600 Drinks</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-red);">48 Flaschen</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-blue);">8 Kästen</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: #7c3aed;">12 Flaschen</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right; font-weight: 700;">75–100 kg</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">150 Gäste</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">900 Drinks</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">72 Flaschen</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">12 Kästen</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">17 Flaschen</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right;">110–150 kg</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">200 Gäste</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">1.200 Drinks</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">96 Flaschen</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">15 Kästen</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">23 Flaschen</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right;">150–200 kg</td>
						</tr>
					</tbody>
				</table>
			</div>

			<p class="font-body" style="font-size: 0.85rem; color: var(--fg-pencil); margin: 0; line-height: 1.4;">
				💡 <strong>Sektempfang-Tipp:</strong> Planen Sie für den Sektempfang nach der Trauung <strong>1 Flasche Sekt pro 6 Gäste</strong> ein (z. B. 17 Flaschen für 100 Gäste).
			</p>
		</div>

		<article class="hand-card" style="margin: 4rem auto; max-width: 850px; padding: 3rem;">
			<h2 class="font-heading" style="font-size: 2.5rem; margin-bottom: 1.5rem; color: var(--fg-pencil); text-align: center;">
				Ratgeber: Bar & Getränke für die Hochzeit planen
			</h2>
			<p class="font-body" style="font-size: 1.2rem; margin-bottom: 2rem;">
				Die Mengenberechnung für eine Hochzeitsbar gehört zu den häufigsten Unsicherheiten bei der Hochzeitsplanung. Niemand möchte, dass um Mitternacht das Bier ausgeht – gleichzeitig sollen aber auch nicht hunderte Euro für ungeöffnete Kartons verschwendet werden.
			</p>

			<h3 class="font-heading" style="font-size: 2rem; margin-top: 2rem; margin-bottom: 1rem; color: var(--accent-red);">Die „1-Getränk-pro-Stunde“-Regel</h3>
			<p class="font-body" style="font-size: 1.2rem; margin-bottom: 2rem;">
				Catering-Profis und Barkeeper kalkulieren mit einem Mittelwert von <strong>1 Getränk pro Gast und Stunde</strong>. Während einige Gäste mehr trinken, trinken Fahrer und ältere Verwandte weniger – im Gesamtschnitt geht die Rechnung zuverlässig auf.
			</p>

			<h3 class="font-heading" style="font-size: 2rem; margin-top: 2rem; margin-bottom: 1rem; color: var(--accent-blue);">Spartipps für den Getränkekauf</h3>
			<ul class="font-body" style="font-size: 1.2rem; margin-bottom: 2rem; padding-left: 1.5rem; line-height: 1.6;">
				<li style="margin-bottom: 0.5rem;"><strong>Kommissionskauf beim Getränkehändler:</strong> Kaufen Sie auf Kommission, sodass Sie ungeöffnete Kästen und Weinkartons nach der Hochzeit einfach zurückgeben können.</li>
				<li style="margin-bottom: 0.5rem;"><strong>Korkgeld verhandeln:</strong> Wenn Sie eigene Weine mitbringen, vereinbaren Sie mit der Location ein faires Korkgeld (meist 10–18 € pro Flasche).</li>
				<li style="margin-bottom: 0.5rem;"><strong>Zwei Signature-Cocktails wählen:</strong> Beschränken Sie Cocktails auf zwei Lieblings-Drinks (z. B. Aperol Spritz & Gin Tonic), um Wartezeiten an der Bar zu minimieren.</li>
			</ul>
		</article>

		<RelatedTools currentPath="/de/wedding-drink-calculator" category="dining" />
	</main>

	<script>
		document.getElementById('calc-form')?.addEventListener('submit', function(e) {
			e.preventDefault();
			
			const guests = parseInt((document.getElementById('guests') as HTMLInputElement).value) || 0;
			const hours = parseInt((document.getElementById('hours') as HTMLInputElement).value) || 0;
			const barType = (document.getElementById('barType') as HTMLSelectElement).value;
			const vibe = (document.getElementById('vibe') as HTMLSelectElement).value;
			const champagne = (document.getElementById('champagne') as HTMLSelectElement).value;

			// Base: 1 drink per person per hour
			let multiplier = 1.0;
			let vibeText = "ausgewogene Trinkfreude";
			if (vibe === 'light') {
				multiplier = 0.75;
				vibeText = "eher verhaltene Trinkfreude (-25%)";
			} else if (vibe === 'heavy') {
				multiplier = 1.25;
				vibeText = "sehr partyfreudige Gesellschaft (+25%)";
			}

			const totalServings = Math.ceil(guests * hours * multiplier);

			let beerRatio = 0.3;
			let wineRatio = 0.4;
			let liquorRatio = 0.3;

			if (barType === 'soft') {
				beerRatio = 0.5;
				wineRatio = 0.5;
				liquorRatio = 0;
			}

			const beerServings = totalServings * beerRatio;
			const wineServings = totalServings * wineRatio;
			const liquorServings = totalServings * liquorRatio;

			// 1 Kasten Bier = 24 Flaschen
			const beerCases = Math.ceil(beerServings / 24);
			// 1 Flasche Wein = 5 Gläser
			const wineBottles = Math.ceil(wineServings / 5);
			// 1 Flasche Spirituosen (750ml) = 16 Drinks
			const liquorBottles = Math.ceil(liquorServings / 16);

			// Sekt: 1 Glas pro Gast, 6 Gläser pro 0,75l Flasche
			const champagneBottles = Math.ceil(guests / 6);

			// Eis: ca. 0,75 kg pro Gast
			const iceKg = Math.ceil(guests * 0.75);
			// Mixers: 1 Liter pro 3 Gäste bei voller Bar
			const mixersLiters = barType === 'open' ? Math.ceil(guests / 3) : 0;

			// Update DOM
			document.getElementById('res-total')!.textContent = totalServings.toString();
			document.getElementById('res-beer')!.textContent = `${beerCases} Kästen`;
			document.getElementById('res-wine')!.textContent = `${wineBottles} Flaschen`;
			
			const liquorBox = document.getElementById('liquor-box')!;
			const mixerBox = document.getElementById('mixer-box')!;
			const champagneBox = document.getElementById('champagne-box')!;
			
			if (barType === 'soft') {
				liquorBox.style.display = 'none';
				mixerBox.style.display = 'none';
			} else {
				liquorBox.style.display = 'flex';
				mixerBox.style.display = 'flex';
				document.getElementById('res-liquor')!.textContent = `${liquorBottles} Flaschen`;
				document.getElementById('res-mixers')!.textContent = `${mixersLiters} Liter`;
			}

			if (champagne === 'yes') {
				champagneBox.style.display = 'flex';
				document.getElementById('res-champagne')!.textContent = `${champagneBottles} Flaschen`;
			} else {
				champagneBox.style.display = 'none';
			}

			document.getElementById('res-ice')!.textContent = `${iceKg} kg`;

			// Update explanation text
			let expl = `Kalkuliert mit einem Basiswert von 1 Getränk pro Gast und Stunde, angepasst für ${vibeText}.`;
			if (barType === 'soft') {
				expl += ` Die Aufteilung erfolgt zu 50% Bier und 50% Wein.`;
			} else {
				expl += ` Die Aufteilung erfolgt zu ca. 40% Wein, 30% Bier und 30% Cocktails/Longdrinks.`;
			}
			if (champagne === 'yes') {
				expl += ` Zusätzlich wurden ${champagneBottles} Flaschen Sekt für den Sektempfang (1 Glas p.P., 6 Gläser/Flasche) hinzugerechnet.`;
			}
			expl += ` Wir empfehlen ca. ${iceKg} kg Eiswürfel (ca. 0,75 kg pro Gast) zum Kühlen und Mixen.`;
			
			document.getElementById('explanation-text')!.textContent = expl;
		});
	</script>
</Layout>
