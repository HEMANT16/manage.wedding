---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-sparkler-calculator/#webapp",
      "name": "Wunderkerzen Auszug Rechner & Kostenlose Druckschilder",
      "url": "https://manage.wedding/de/wedding-sparkler-calculator",
      "inLanguage": "de",
      "description": "Berechnen Sie die exakte Anzahl an Wunderkerzen (50cm vs 90cm), Brenndauer für Fotos, Butan-Brenner und Sandeimer. Inklusive kostenloser druckfertiger Schilder 'Lasst die Liebe funkeln' und Sicherheitskarten.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "So organisieren Sie einen sicheren und magischen Wunderkerzen-Auszug",
      "description": "Schritt-für-Schritt-Leitfaden für Hochzeitsplaner und Trauzeugen zur Koordination von Zündwelle und Hochzeitsspalier.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Reale Gästeanzahl & Wunderkerzenlänge berechnen",
          "text": "Berücksichtigen Sie, dass ca. 25-35% der Gäste vor Mitternacht gehen. Wählen Sie 50 cm (90-120s Brenndauer) oder 90 cm (3,5-4 Min) rauchfreie Metalldraht-Wunderkerzen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Metalleimer mit Sand oder Wasser aufstellen",
          "text": "Platzieren Sie Zinkeimer mit feuchtem Sand am Anfang und Ende des Spaliers, um die heißen Drähte sofort sicher abzulöschen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: 3 Meter breite Doppelreihe formieren",
          "text": "Stellen Sie die Gäste in zwei parallelen Reihen mit mindestens 3 bis 3,5 Metern Mittelgang auf, um Brautkleid, Schleier und Haarspray vor Funkenflug zu schützen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Die Ketten-Zündwelle starten",
          "text": "Verteilen Sie 1 Butan-Sturmbrenner pro 8-10 Gäste. Zünden Sie die erste Kerze an – die Gäste reichen die Glut Spitze-an-Spitze in 20 Sekunden weiter."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 5: Brautpaar-Auszug, Fotokuss & Sofortiges Löschen",
          "text": "Das Paar schreitet langsam durch das Funkenspalier, hält in der Mitte für den Kuss an, und alle Gäste stecken die heißen Drähte in die Sandeimer."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Welche Wunderkerzen-Größe ist für die Hochzeit am besten: 25 cm, 50 cm oder 90 cm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "50 cm Wunderkerzen (Brenndauer 90 bis 120 Sekunden) sind der absolute Goldstandard für Hochzeiten mit 50 bis 150 Gästen. Sie bieten ausreichend Zeit für die Zündwelle und einen entspannten Auszug. 90 cm Wunderkerzen (3,5 bis 4 Minuten) eignen sich für Großhochzeiten ab 150 Gästen oder lange Schlosstreppen. 25 cm Kerzen (30-45s) sind für das Spalier ungeeignet, da die ersten ausgehen, bevor die letzten brennen."
          }
        },
        {
          "@type": "Question",
          "name": "Warum verlangen Hochzeitslocations rauchfreie Wunderkerzen mit Metalldraht?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wunderkerzen mit Stahldrahtkern brennen nahezu rauchfrei ab und hinterlassen keinen glühenden Ascheabfall. Wunderkerzen mit Holz- oder Bambusstab erzeugen dichten, beißenden Qualm, ruinieren Hochzeitsfotos, tropfen heiße Glut auf Festkleider und lösen Rauchmelder aus."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele Wunderkerzen sollte man pro Gast kaufen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei 50 cm oder 90 cm Kerzen reicht 1 Wunderkerze pro anwesendem Gast plus 15% Sicherheitspuffer für Fotografen-Tests und Zündleiter. Bei kurzen 25 cm Kerzen sollten Sie 2 Stück pro Gast einplanen."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wunderkerzen Auszug Rechner — Gratis Druckschilder «Lasst die Liebe funkeln» & Leitfaden"
	description="Berechnen Sie Wunderkerzen (50cm vs 90cm), Foto-Zeitfenster, Butan-Brenner und Sandeimer. Inklusive kostenloser Schilder 'Lasst die Liebe funkeln' und Sicherheitskarten."
	lang="de"
	schema={schema}
>
	<!-- Include html2canvas for instant image capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Wunderkerzen Auszug Rechner" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center; position: relative;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.25rem 1rem 1.75rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratis • Rauchfreie Metalldraht-Wunderkerzen • Druckfertige Schilder in PDF & Word</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(28px, 4.5vw, 50px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Wunderkerzen Auszug Rechner <span class="accent-italic" style="color: #b45309; text-shadow: 1px 1px 0px #fef08a;">& Gratis Schilder</span>
				</h1>
				<p class="font-body" style="font-size: 1.125rem; color: var(--text-secondary); max-width: 820px; margin: 0 auto; line-height: 1.6;">
					Berechnen Sie die exakte Anzahl an Wunderkerzen (50cm vs 90cm), Foto-Zeitfenster, Butan-Brenner und Sandeimer. Inklusive minutiösem Zeitplan und <strong>druckfertigen Schildern « Lasst die Liebe funkeln »</strong>.
				</p>
			</div>
		</section>

		<!-- Visual Step-by-Step "How to Use This Tool" Guide -->
		<section class="hand-card" style="padding: 1.5rem; background: #fffdfa; margin-bottom: 2.5rem; border: 2px solid var(--fg-pencil);">
			<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
				<span style="font-size: 1.4rem;">💡</span>
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0;">
					So nutzen Sie diesen Rechner (In 3 einfachen Schritten)
				</h2>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
				
				<!-- Guide Step 1 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">1</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Gästeanzahl und Uhrzeit</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Gästezahl und Uhrzeit wählen. Bei spätem Auszug (ab 23:00 Uhr) gehen ~30% früher; das Tool verhindert automatisch unnötige Bestellmengen!
					</p>
				</div>

				<!-- Guide Step 2 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">2</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">50 cm oder 90 cm wählen</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Wählen Sie <strong>50 cm (2 Min Brenndauer)</strong> für normale Hochzeiten (40–150 Gäste) oder <strong>90 cm (4 Min)</strong> für über 150 Gäste und entspannte Kussfotos.
					</p>
				</div>

				<!-- Guide Step 3 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">3</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Einkaufsliste & Schilder</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Exakte Packungen, Brenner und Sandeimer ablesen. Namen eingeben, um das <strong>Tischschild zum Einrahmen und Sicherheitskarten</strong> mit 1 Klick zu drucken.
					</p>
				</div>

			</div>
		</section>

		<!-- Main Interactive Calculator Studio -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; margin-bottom: 3rem; align-items: start;">
			
			<!-- Left Column: Inputs & Configuration -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #ffffff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.35rem; margin: 0; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
						<span>⚙️</span> Auszug-Parameter
					</h2>
					<span style="font-size: 0.78rem; font-weight: 700; background: #fef08a; border: 1.5px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
						Echtzeit-Berechnung
					</span>
				</div>

				<!-- Step 1: Total Invited Guests Headcount -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem;">
						<label class="form-label" for="slider-guests" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							1. Zugesagte Hochzeitsgäste insgesamt:
						</label>
						<span id="label-guest-count" style="font-weight: 800; font-size: 1.15rem; color: #b45309; background: #fef3c7; border: 1.5px solid #d97706; padding: 2px 10px; border-radius: 6px;">
							120 Gäste
						</span>
					</div>
					<input type="range" id="slider-guests" min="15" max="400" value="120" step="5" style="width: 100%; accent-color: #b45309; cursor: pointer;" />
					<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.2rem;">
						<span>15 (Intim)</span>
						<span>75 (Klein)</span>
						<span>120 (Mittel)</span>
						<span>250 (Groß)</span>
						<span>400+</span>
					</div>
				</div>

				<!-- Step 2: Send-Off Timing -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label class="form-label" for="select-timing-preset" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem; margin-bottom: 0.3rem; display: block;">
						2. Wann findet der Wunderkerzen-Auszug statt?
					</label>
					<select id="select-timing-preset" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc; border: 2px solid var(--fg-pencil); width: 100%; padding: 0.6rem; border-radius: 6px; font-size: 0.9rem;">
						<option value="late-night" selected>🌙 Spätes Finale (ab 23:00 Uhr) — ~70% der Gäste bleiben</option>
						<option value="staged">🍰 Inszenierter Auszug nach der Torte (21:30 Uhr) — ~95% anwesend</option>
						<option value="ceremony">🌅 Trauung / Sonnenuntergang — 100% anwesend</option>
						<option value="custom">🎛️ Eigener Prozentsatz</option>
					</select>
					
					<div id="custom-retention-box" style="display: none; margin-top: 0.75rem; padding: 0.75rem; background: #fffbeb; border: 1.5px dashed #d97706; border-radius: 6px;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
							<label style="font-size: 0.85rem; font-weight: 700; color: #92400e;">Anwesenheitsquote:</label>
							<span id="label-retention-val" style="font-weight: 800; color: #92400e;">70%</span>
						</div>
						<input type="range" id="slider-retention" min="40" max="100" value="70" step="5" style="width: 100%; accent-color: #d97706;" />
					</div>

					<div style="background: #f8fafc; border-left: 3px solid #b45309; padding: 0.5rem 0.75rem; margin-top: 0.5rem; border-radius: 0 4px 4px 0;">
						<p style="font-size: 0.82rem; color: #475569; margin: 0; line-height: 1.45;">
							👥 <strong>Reale Anwesenheit:</strong> <strong id="retention-summary-text" style="color: #b45309;">84 Gäste</strong> beim Auszug (<span id="attrition-summary-text">36 Gäste</span> gehen früher wegen Kindern oder Heimreise).
						</p>
					</div>
				</div>

				<!-- Step 3: Sparkler Length & Burn Time Selector -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label class="form-label" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem; margin-bottom: 0.4rem; display: block;">
						3. Wunderkerzen-Größe wählen:
					</label>
					
					<div class="sparkler-size-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem;">
						<!-- 50 cm option (Default Gold Standard) -->
						<label class="size-pill active" id="card-len-20" style="border: 2px solid #b45309; background: #fffbeb; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative; box-shadow: 0 0 0 1px #b45309;">
							<input type="radio" name="sparkler-len" value="20" checked style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 800; color: #92400e; background: #fef08a; border: 1px solid #d97706; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">⭐ Ideal</span>
							<strong style="display: block; font-size: 0.9rem; color: #92400e; line-height: 1.15;">50 cm (20")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #b45309; margin-top: 1px;">2 Min Brenndauer</span>
							<span style="display: block; font-size: 0.67rem; color: #78350f; margin-top: 1px;">40–150 Gäste</span>
						</label>

						<!-- 90 cm option (Grand Exits) -->
						<label class="size-pill" id="card-len-36" style="border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative;">
							<input type="radio" name="sparkler-len" value="36" style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 700; color: #0369a1; background: #e0f2fe; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">👑 Grandios</span>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil); line-height: 1.15;">90 cm (36")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #0369a1; margin-top: 1px;">4 Min Brenndauer</span>
							<span style="display: block; font-size: 0.67rem; color: #64748b; margin-top: 1px;">150+ Gäste</span>
						</label>

						<!-- 25 cm option (Small/Risky) -->
						<label class="size-pill" id="card-len-10" style="border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative;">
							<input type="radio" name="sparkler-len" value="10" style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 700; color: #991b1b; background: #fee2e2; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">⚠️ Nur Klein</span>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil); line-height: 1.15;">25 cm (10")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #dc2626; margin-top: 1px;">35s Brenndauer</span>
							<span style="display: block; font-size: 0.67rem; color: #64748b; margin-top: 1px;">&lt;25 Gäste</span>
						</label>
					</div>
				</div>

				<!-- Sparklers Per Guest & Buffer Options -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem;">
					<div>
						<label class="form-label" for="select-sparklers-per-guest" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.85rem;">
							Kerzen pro Gast:
						</label>
						<select id="select-sparklers-per-guest" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<option value="1" selected>1 Wunderkerze (Standard)</option>
							<option value="2">2 Wunderkerzen (Doppelfunken / Reserve)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="select-buffer-pct" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.85rem;">
							Sicherheitspuffer:
						</label>
						<select id="select-buffer-pct" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<option value="15" selected>+15% Puffer (Empfohlen)</option>
							<option value="10">+10% Puffer</option>
							<option value="20">+20% Extra Puffer</option>
							<option value="0">0% Exakt</option>
						</select>
					</div>
				</div>

				<!-- Step 4: Couple Names & Target Send-Off Time -->
				<div style="border-top: 1.5px dashed #cbd5e1; padding-top: 1.25rem;">
					<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
						<h3 class="font-heading" style="font-size: 1.05rem; margin: 0; color: var(--fg-pencil);">
							4. Schilder & Zeitplan personalisieren:
						</h3>
						<span style="font-size: 0.72rem; color: #166534; background: #dcfce7; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Aktualisiert Druckschild ⬇️</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="input-couple-names" style="font-size: 0.82rem; font-weight: 600;">Namen des Brautpaars:</label>
							<input type="text" id="input-couple-names" class="form-input" value="Laura & Felix" placeholder="z. B. Lisa & Jan" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						</div>
						<div>
							<label class="form-label" for="input-exit-time" style="font-size: 0.82rem; font-weight: 600;">Geplante Uhrzeit:</label>
							<input type="text" id="input-exit-time" class="form-input" value="23:45" placeholder="z. B. 23:45" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Results & Equipment Blueprint -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Metric Hero Card -->
				<div class="hand-card shadow-hard" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fffdfa; border: 3px solid var(--fg-pencil); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
						<div>
							<span style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #92400e;">
								Bestellempfehlung
							</span>
							<h3 class="font-heading" style="font-size: 1.35rem; margin: 0.2rem 0 0; color: var(--fg-pencil);">
								Wunderkerzen insgesamt
							</h3>
						</div>
						<div id="badge-pack-size" style="background: #fef08a; border: 2px solid var(--fg-pencil); padding: 4px 10px; border-radius: 6px; font-weight: 800; font-size: 0.85rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
							~12 Packungen (8 Stk.)
						</div>
					</div>

					<div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.5rem;">
						<span id="res-total-sparklers" style="font-size: clamp(3rem, 6vw, 4.2rem); font-weight: 900; color: #b45309; line-height: 1; font-family: var(--font-heading);">
							97
						</span>
						<span style="font-size: 1.25rem; font-weight: 700; color: var(--fg-pencil);">Wunderkerzen gesamt</span>
					</div>

					<div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
