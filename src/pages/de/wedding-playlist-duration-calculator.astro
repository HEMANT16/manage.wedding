								<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; color: var(--accent-blue); font-weight: 700;">16 – 18 Songs</td>
								<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">90 – 115 BPM</td>
								<td style="padding: 0.6rem 0.8rem;">Bossa Nova, entspannter Jazz, Akustik-Pop, leichter Deep House</td>
							</tr>
							<tr style="border-bottom: 1px solid #e2e8f0;">
								<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Hochzeitsdinner</td>
								<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">90 Minuten</td>
								<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; color: var(--accent-blue); font-weight: 700;">24 – 28 Songs</td>
								<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">70 – 95 BPM</td>
								<td style="padding: 0.6rem 0.8rem;">Soul, zeitlose Balladen, angenehme Lautstärke für Tischgespräche</td>
							</tr>
							<tr style="border-bottom: 1px solid #e2e8f0; background: #ecfdf5;">
								<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: #16a34a;">Tanzparty (Peak)</td>
								<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">180 Min (3.0h)</td>
								<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; color: #16a34a; font-weight: 700;">55 – 70 Songs</td>
								<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; color: #16a34a; font-weight: 700;">118 – 132 BPM</td>
								<td style="padding: 0.6rem 0.8rem;">Disco, 80er/90er/2000er Hits, Dance-Pop, House & Partyhymnen</td>
							</tr>
