---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-playlist-duration-calculator/#webapp",
      "name": "Hochzeitsmusik & Playlist Rechner — DJ Song-Planer & Dauer",
      "url": "https://manage.wedding/de/wedding-playlist-duration-calculator",
      "inLanguage": "de",
      "description": "Kostenloser Hochzeitsplaylist-Rechner & DJ-Briefing-Generator. Berechnen Sie die Songanzahl für Trauung, Sektempfang, Dinner und Tanzparty. Inklusive Must-Play-Liste, No-Go-Blacklist und druckfertigem PDF/Word-Export.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie viele Lieder braucht man für eine 6-stündige Hochzeitsfeier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für eine 6-stündige Hochzeit (360 Minuten) werden etwa 100 bis 120 Lieder gespielt (bei durchschnittlich 3,5 Minuten pro Song bzw. 2,5 Minuten bei schnellen DJ-Übergängen). Bereiten Sie eine Gesamtplaylist von 130 bis 140 Titeln mit einem Puffer von 20% vor, damit der DJ flexibel auf die Gäste eingehen kann."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele Lieder sollten auf die Must-Play-Wunschliste für den DJ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Erfahrene Hochzeits-DJs empfehlen maximal 15 bis 20 unverzichtbare Wunschlieder. Eine starre Liste von 50 oder 100 Titeln nimmt dem DJ den Freiraum, die Stimmung der Tanzfläche zu lesen und im richtigen Moment das Tempo zu steigern."
          }
        },
        {
          "@type": "Question",
          "name": "Wie lange sollte der Eröffnungstanz (Brautwalzer) dauern?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die ideale Dauer für den Eröffnungstanz liegt bei 2:30 bis maximal 3 Minuten. Längere 4- bis 5-minütige Albumversionen fühlen sich für das Brautpaar oft lang an. Bitten Sie den DJ um ein sanftes Ausblenden (Fade-Out) bei 2:30 Minuten oder bitten Sie die Trauzeugen und Gäste auf die Tanzfläche."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "So planen Sie Ihre Hochzeits-Playlist und das DJ-Briefing",
      "description": "Schritt-für-Schritt-Anleitung zur Berechnung der Songanzahl, Planung von Eröffnungstanz & Highlights und Erstellung des DJ-Ablaufplans.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Zeiten der Phasen festlegen",
          "text": "Stellen Sie die Schieberegler für Trauung, Sektempfang, Hochzeitsdinner und Party ein."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Schlüsselmomente & Audio-Cues definieren",
          "text": "Wählen Sie Lieder für Einzug, Auszug, Eröffnungstanz, Torte und Brautstraußwurf mit genauen Ausblend-Zeiten."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Must-Play & No-Go-Blacklist erstellen",
          "text": "Fügen Sie bis zu 20 Lieblingssongs hinzu und sperren Sie unerwünschte Genres oder Schlager."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: DJ-Briefing exportieren (PDF & Word)",
          "text": "Laden Sie das übersichtliche Dokument herunter und besprechen Sie es beim Vorgespräch mit Ihrem Hochzeits-DJ."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Hochzeitsmusik & Playlist Rechner — DJ Song-Planer & Dauer (Kostenlos PDF & Word) | Manage.Wedding"
	description="Berechnen Sie die exakte Songanzahl für Ihre Hochzeit, planen Sie Eröffnungstanz & Tortenanschnitt mit Audio-Cues, erstellen Sie Must-Play & No-Go-Listen und exportieren Sie das DJ-Briefing."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Hochzeitsmusik & Playlist Rechner" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🎵</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Kostenlos • Lokal im Browser • Druckfertiger PDF & Word Export</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Hochzeitsmusik & Playlist Rechner
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 740px; margin: 0 auto; text-align: center;">
					Berechnen Sie die exakte Songanzahl für jede Hochzeitsphase, timen Sie Eröffnungstanz & Highlights mit genauen Ausblend-Cues, erstellen Sie <strong>Must-Play & No-Go-Listen</strong> und exportieren Sie das <strong>DJ-Briefing</strong> in PDF und Word!
				</p>
			</div>
		</section>

		<!-- 3-Schritte Anleitung -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>🎧</span> In 3 einfachen Schritten zum perfekten Musik-Briefing
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Phasenzeiten & BPM
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Stellen Sie die Minuten für Trauung, Sektempfang, Dinner und Party ein, um die Songanzahl zu ermitteln.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Highlights & Audio-Cues
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Wählen Sie Songs für Einzug, Eröffnungstanz, Hochzeitstorte und Straußwurf mit sekundengenauem Fade-Out.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Must-Play & PDF-Export
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Fügen Sie bis zu 20 Wunschlieder hinzu, sperren Sie No-Go-Titel und laden Sie das DJ-Briefing herunter.
					</p>
				</div>
			</div>
		</div>

		<!-- Interaktiver Arbeitsbereich -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- ABSCHNITT 1: Phasenzeiten & Song-Kalkulator -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🎚️ 1. Phasendauer & Song-Kalkulator
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Ermitteln Sie die benötigte Musikauswahl je nach DJ-Mixstil
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center;">
						<label for="select-mix-pacing" class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil);">
							Mixstil:
						</label>
						<select id="select-mix-pacing" style="padding: 0.35rem 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem; font-weight: 600;">
							<option value="radio" selected>Standard Radio-Länge (~3.5 min / 17 Songs/h)</option>
							<option value="quickmix">Club / DJ Quick Mix (~2.7 min / 22 Songs/h)</option>
							<option value="lounge">Akustik & Lounge Ausführlich (~4.2 min / 14 Songs/h)</option>
						</select>
					</div>
				</div>

				<!-- Schieberegler Grid -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
					
					<!-- Präludium -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-prelude" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🎻</span> Trauung / Präludium
							</label>
							<span id="val-prelude" class="font-heading" style="font-size: 1rem; color: var(--accent-red); font-weight: 700;">30 min</span>
						</div>
						<input type="range" id="slider-prelude" min="15" max="60" step="5" value="30" style="width: 100%; accent-color: var(--accent-red);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>15 min</span>
							<span id="songs-prelude" style="font-weight: 600; color: var(--fg-pencil);">~9 Songs (60-80 BPM)</span>
							<span>60 min</span>
						</div>
					</div>

					<!-- Sektempfang -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-cocktail" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍸</span> Sektempfang / Get-Together
							</label>
							<span id="val-cocktail" class="font-heading" style="font-size: 1rem; color: var(--accent-blue); font-weight: 700;">60 min</span>
						</div>
						<input type="range" id="slider-cocktail" min="30" max="120" step="5" value="60" style="width: 100%; accent-color: var(--accent-blue);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>30 min</span>
							<span id="songs-cocktail" style="font-weight: 600; color: var(--fg-pencil);">~17 Songs (90-115 BPM)</span>
							<span>120 min</span>
						</div>
					</div>

					<!-- Dinner -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dinner" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍽️</span> Hochzeitsdinner / Menü
							</label>
							<span id="val-dinner" class="font-heading" style="font-size: 1rem; color: #d97706; font-weight: 700;">90 min</span>
						</div>
						<input type="range" id="slider-dinner" min="45" max="150" step="5" value="90" style="width: 100%; accent-color: #d97706;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>45 min</span>
							<span id="songs-dinner" style="font-weight: 600; color: var(--fg-pencil);">~25 Songs (70-95 BPM)</span>
							<span>150 min</span>
						</div>
					</div>

					<!-- Tanzparty -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dance" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🕺</span> Tanzfläche & Party
							</label>
							<span id="val-dance" class="font-heading" style="font-size: 1rem; color: #16a34a; font-weight: 700;">180 min (3.0h)</span>
						</div>
						<input type="range" id="slider-dance" min="60" max="360" step="15" value="180" style="width: 100%; accent-color: #16a34a;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>1 Stunde</span>
							<span id="songs-dance" style="font-weight: 600; color: var(--fg-pencil);">~52-60 Songs (118-132 BPM)</span>
							<span>6 Stunden</span>
						</div>
					</div>

					<!-- Afterparty -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-afterparty" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🌙</span> Late-Night / Afterparty
							</label>
							<span id="val-afterparty" class="font-heading" style="font-size: 1rem; color: #7c3aed; font-weight: 700;">0 min</span>
						</div>
						<input type="range" id="slider-afterparty" min="0" max="120" step="15" value="0" style="width: 100%; accent-color: #7c3aed;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>0 min (Aus)</span>
							<span id="songs-afterparty" style="font-weight: 600; color: var(--fg-pencil);">0 Songs</span>
							<span>120 min</span>
						</div>
					</div>

				</div>

				<!-- Kennzahlen Dashboard -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; background: var(--muted-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; text-align: center;">
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Gesamte Musiklaufzeit</span>
						<strong id="display-total-runtime" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil);">6h 00m (360 min)</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Tatsächlich gespielte Songs</span>
						<strong id="display-exact-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue);">~103 Songs</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Empfohlene Playlist (+20% Puffer)</span>
						<strong id="display-buffered-tracks" class="font-heading" style="font-size: 1.6rem; color: #16a34a;">~125 Songs</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Songs für die Party-Phase</span>
						<strong id="display-dance-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red);">~52 Songs</strong>
					</div>
				</div>

			</div>

			<!-- ABSCHNITT 2: Schlüsselmomente & Audio-Cues -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							💃 2. Schlüsselmomente & Audio-Cue-Zeiten
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Wählen Sie beliebte Klassiker oder tragen Sie individuelle Titel & Fade-Out-Hinweise ein
						</span>
					</div>
					<button type="button" id="btn-autofill-special" class="hand-btn" style="padding: 0.3rem 0.7rem; font-size: 0.8rem; background: #eff6ff;">
						✨ Beliebte Vorschläge laden
					</button>
				</div>

				<div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" id="special-moments-container">
					<!-- Generiert durch JS -->
				</div>
			</div>

			<!-- ABSCHNITT 3: Must-Play & No-Go-Blacklist -->
			<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 1fr; gap: 1.5rem;">
				
				<!-- Must-Play Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.25rem; color: #16a34a; margin: 0;">
								⭐ Must-Play Wunschlieder
							</h3>
							<span class="font-body" style="font-size: 0.8rem; color: var(--text-secondary);">
								Ziel: 10–20 Songs (lässt dem DJ Freiraum)
							</span>
						</div>
						<span id="must-play-counter" class="badge-postit" style="font-size: 0.85rem;">0 / 20 Songs</span>
					</div>

					<!-- Schnell-Auswahl -->
					<div style="margin-bottom: 1rem; background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<span class="font-heading" style="font-size: 0.8rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem;">
							⚡ Beliebte Stimmungsmacher:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;" id="quick-must-pills">
							<button type="button" class="btn-quick-add hand-btn" data-title="Auf uns" data-artist="Andreas Bourani" data-phase="Party" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Andreas Bourani</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="September" data-artist="Earth, Wind & Fire" data-phase="Party" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ September</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Tage wie diese" data-artist="Die Toten Hosen" data-phase="Party" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Toten Hosen</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Dancing Queen" data-artist="ABBA" data-phase="Party" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ ABBA</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Komet" data-artist="Udo Lindenberg & Apache 207" data-phase="Party" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Komet</button>
						</div>
					</div>

					<!-- Hinzufügen Formular -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 0.9fr auto; gap: 0.4rem; margin-bottom: 1rem;">
						<input type="text" id="input-must-title" placeholder="Songtitel (z.B. Levitating)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<input type="text" id="input-must-artist" placeholder="Künstler (z.B. Dua Lipa)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<select id="select-must-phase" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.8rem; background: #fff;">
							<option value="Party & Tanzfläche">Party</option>
							<option value="Sektempfang">Sektempfang</option>
							<option value="Dinner">Dinner</option>
							<option value="Mitsing-Hymne">Mitsing-Hymne</option>
						</select>
						<button type="button" id="btn-add-must" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background: #16a34a; color: #fff;">+ Hinzufügen</button>
					</div>

					<!-- Liste -->
					<div id="must-play-list" style="max-height: 280px; overflow-y: auto; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #faf8f5; padding: 0.5rem;">
						<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin: 1rem 0;">Noch keine Must-Play Songs eingetragen.</p>
					</div>
				</div>

				<!-- No-Go Blacklist Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
