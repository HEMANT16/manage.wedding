---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/honeymoon-budget-estimator/#webapp",
      "name": "Flitterwochen-Budgetrechner nach Reisezielen",
      "url": "https://manage.wedding/de/honeymoon-budget-estimator",
      "description": "Kostenloser Flitterwochen-Rechner: Berechnen Sie realistische Reisekosten für Flüge, 4- & 5-Sterne-Resorts, Overwater-Villen, Dining und Aktivitäten nach Länder-Kategorien. Mit Word- & PDF-Export.",
      "applicationCategory": "TravelApplication",
      "operatingSystem": "All",
      "inLanguage": "de",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie man das Budget für die Flitterwochen plant und berechnet",
      "description": "Schritt-für-Schritt-Anleitung zur Reisebudgetierung für die Hochzeitsreise inklusive Flügen, Unterkünften, Gastronomie und Ausflügen.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Reiseziel-Kategorie wählen",
          "text": "Wählen Sie zwischen günstigen Fernreisezielen (Kategorie 1), klassischen europäischen Reisezielen (Kategorie 2) oder Luxusreisen auf die Malediven (Kategorie 3)."
        },
        {
          "@type": "HowToStep",
          "name": "2. 50% für Unterkunft & Resorts reservieren",
          "text": "Planen Sie rund die Hälfte Ihres Reisebudgets für Strandresorts, Boutique-Hotels oder Überwasser-Bungalows ein."
        },
        {
          "@type": "HowToStep",
          "name": "3. 25% für Flüge & Transfers kalkulieren",
          "text": "Berücksichtigen Sie Hin- und Rückflüge für zwei Personen, Inlandsflüge, Fähren und Flughafentransfers."
        },
        {
          "@type": "HowToStep",
          "name": "4. 15% für Romantik-Dinner & 10% für Ausflüge",
          "text": "Planen Sie Candle-Light-Dinner, Weinbegleitung, Paarmassagen, Schnorchelausflüge und Shopping ein."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie viel kosten Flitterwochen im Durchschnitt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Im deutschsprachigen Raum geben Paare durchschnittlich 4.000 € bis 7.500 € für eine 10- bis 14-tägige Hochzeitsreise aus. Fernreisen nach Bali oder Thailand starten bei ca. 3.500 €, europäische Traumziele (Santorini, Amalfiküste) liegen bei 5.000 € bis 9.000 €, während Luxusreisen auf die Malediven 10.000 € bis 20.000 € kosten."
          }
        },
        {
          "@type": "Question",
          "name": "Wann ist der beste Buchungszeitpunkt für die Flitterwochen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für Fernreisen und beliebte Luxusresorts empfiehlt sich eine Buchung 6 bis 9 Monate im Voraus. Bei Zielen innerhalb Europas oder Pauschalreisen reichen meist 4 bis 6 Monate Vorlauf."
          }
        },
        {
          "@type": "Question",
          "name": "Kann man die Flitterwochen über den Hochzeitstisch / Geldgeschenke finanzieren?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja! Immer mehr Paare wünschen sich Geld für die Flitterwochen oder richten eine digitale Hochzeitsreise-Wunschliste ein, bei der Gäste konkrete Erlebnisse wie ein romantisches Abendessen, einen Tauchausflug oder eine Partnermassage schenken können."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Flitterwochen-Budgetrechner nach Reisezielen (Reisekosten-Planer) | Manage.Wedding"
	description="Kostenloser Flitterwochen-Rechner: Berechnen Sie Reisekosten für Flüge, Hotels, Wasserbungalows, romantische Dinner & Ausflüge nach Länder-Kategorien. Mit Word- & PDF-Export."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Flitterwochen-Budgetrechner" category="budget" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Flitterwochen <span class="accent-italic">Budgetrechner</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Berechnen Sie realistische Gesamtkosten basierend auf <strong>Reiseziel-Kategorie</strong>, Hotelstandard, Flugklasse und Reisedauer. Exportieren Sie Ihren <strong>Reisekostenplan</strong> in <strong>Word (.doc)</strong> oder <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Reisebudgetierung in 3 Schritten
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Reiseziel & Kategorie wählen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Wählen Sie zwischen tropischen Fernreisen (Bali, Thailand), mediterraner Romantik (Santorini, Mallorca) oder Luxus-Wasserbungalows (Malediven).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Hotel-, Flug- & Verpflegungsstil anpassen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Wählen Sie Flugklasse, Resort-Kategorie (Boutique, 4-Sterne, 5-Sterne, Wasserbungalow), Restaurant-Niveau und Reisetage für 2 Personen.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Reiseplan exportieren & teilen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Klicken Sie auf <strong>„📝 Export Word (.doc)“</strong> oder <strong>„🖨️ Export PDF“</strong> für Ihre Reiseunterlagen oder als Vorlage für Ihre Flitterwochen-Wunschliste.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="honeymoon-calc-grid">
			
			<!-- Left Column: Travel Parameters Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							✈️ Reiseziel & Parameter
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Alle Berechnungen gelten automatisch für 2 Reisende
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Währung:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="CHF">CHF (Schweiz)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="honeymoon-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Destination Country Tier -->
					<div>
						<label for="select-country-tier" class="font-heading" style="display: block; font-size: 1rem; color: var(--accent-red); margin-bottom: 0.3rem;">
							1. Reiseziel-Kategorie & Preisniveau *
						</label>
						<select id="select-country-tier" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="tier1">🌴 Kategorie 1: Preiswerte Fernreisen (Bali, Thailand, Portugal, Mexiko, Costa Rica)</option>
							<option value="tier2" selected>🏖️ Kategorie 2: Klassische Traumziele (Santorini, Mallorca, Italien, Spanien, Japan, Hawaii)</option>
							<option value="tier3">💎 Kategorie 3: Luxus & Overwater (Malediven, Bora Bora / Tahiti, Amalfiküste, Schweizer Alpen)</option>
							<option value="tier4">🦁 Kategorie 4: Exklusive Bucket-List (Afrika-Safari, Galápagos, Privatinsel)</option>
							<option value="domestic">🚗 Kategorie 5: Nahziele & Roadtrips in Europa (Südtirol, Provence, Gardasee, Allgäu)</option>
						</select>
					</div>

					<!-- 2. Trip Duration & Flight Class -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;">
						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-trip-days" class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
									Reisedauer (Tage / Nächte)
								</label>
								<span id="trip-days-display" style="font-size: 0.95rem; font-weight: bold; color: var(--accent-blue);">10 Tage</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.5rem;">
								<input type="range" id="input-trip-days" min="3" max="28" value="10" step="1" style="flex: 1; accent-color: var(--accent-blue);">
								<input type="number" id="input-trip-days-num" value="10" min="3" max="28" style="width: 50px; padding: 0.3rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center; font-weight: bold;">
							</div>
						</div>

						<div>
							<label for="select-flight-class" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Flugklasse (Hin- & Rückflug für 2)
							</label>
							<select id="select-flight-class" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
								<option value="economy" selected>Economy Class</option>
								<option value="premium">Premium Economy (+40%)</option>
								<option value="business">Business Class (2,5x)</option>
								<option value="points">Meilen / Bonuspunkte (nur Steuern/Gebühren)</option>
							</select>
						</div>
					</div>

					<!-- 3. Resort & Lodging Standard -->
					<div>
						<label for="select-lodging-style" class="font-heading" style="display: block; font-size: 1rem; color: var(--accent-blue); margin-bottom: 0.3rem;">
							2. Unterkunfts- & Resort-Kategorie (pro Nacht)
						</label>
						<select id="select-lodging-style" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="boutique">Gemütliches Boutique-Hotel / Airbnb Superhost</option>
							<option value="resort4" selected>4-Sterne Strandresort / Historisches Stadthotel</option>
							<option value="luxury5">5-Sterne Luxushotel / Private Poolvilla</option>
							<option value="overwater">Overwater-Bungalow / Luxus-Safari-Lodge</option>
						</select>
					</div>

					<!-- 4. Dining, Excursions & Extras -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<span class="font-heading" style="font-size: 0.95rem; color: #16a34a; display: block;">
							3. Verpflegung, Ausflüge & Extras (für das Paar)
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">Gastronomie & Dinner</span>
								<select id="select-dining-style" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="moderate">Mix aus Cafés, Trattorien & Abendessen</option>
									<option value="fine_dining" selected>Gehobene Restaurants & Sunset-Cocktails</option>
									<option value="budget">Lokale Märkte & Street Food</option>
									<option value="michelin">Gourmet-Menüs & Private Beach Dining</option>
								</select>
							</div>

							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">Aktivitäten & Ausflüge</span>
								<select id="select-excursions-style" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="moderate" selected>Paarmassage, Bootstour & Guides</option>
									<option value="light">Entspannte Strandtage & Spaziergänge</option>
									<option value="heavy">Tägliche Touren (Helikopter, Tauchen, Safari)</option>
								</select>
							</div>
						</div>

						<div style="display: flex; gap: 1rem; flex-wrap: wrap; padding-top: 0.3rem;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-travel-insurance" checked style="accent-color: var(--fg-pencil);">
								<span>Auslandskrankenversicherung & Transfers (250 €)</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-shopping-buffer" checked style="accent-color: var(--fg-pencil);">
								<span>Souvenirs & Shopping-Puffer (350 €)</span>
							</label>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Cost Breakdown -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Honeymoon Total Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🏖️ Geschätztes Flitterwochen-Budget
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Gesamtkosten-Prognose für beide Reisende
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Drucken
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Budget Total Highlight -->
					<div style="background: #f0fdf4; border: 2.5px solid #16a34a; border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: #16a34a; display: block; font-weight: bold;">Geschätztes Gesamtreisebudget</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: #16a34a; display: block; line-height: 1.2;">7.800 €</strong>
						<span id="res-per-day-note" style="font-size: 0.8rem; color: #16a34a;">Ca. 780 € / Tag für zwei Reisende</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Aufgeschlüsselte Reiseausgaben
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">✈️ Hin- & Rückflüge (2 Personen):</td>
									<td id="res-flight-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">2.000 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🏨 Resort & Unterkunft (<span id="res-nights-count">10</span> Nächte):</td>
									<td id="res-hotel-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">3.500 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Gastronomie & Romantik-Dinner:</td>
									<td id="res-food-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">2.600 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🏄 Ausflüge & Aktivitäten für Paare:</td>
									<td id="res-excursions-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">1.100 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0;">🛡️ Versicherung, Transfers & Puffer:</td>
									<td id="res-extras-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">600 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Travel Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span style="color: var(--accent-red);">Flüge (<span id="pct-flights">26%</span>)</span>
							<span style="color: var(--accent-blue);">Hotel (<span id="pct-hotel">45%</span>)</span>
							<span style="color: #16a34a;">Dinner (<span id="pct-food">20%</span>)</span>
							<span style="color: #7c3aed;">Erlebnisse (<span id="pct-excursions">9%</span>)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-flights" style="width: 26%; background: var(--accent-red); transition: width 0.3s ease;"></div>
							<div id="bar-hotel" style="width: 45%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-food" style="width: 20%; background: #16a34a; transition: width 0.3s ease;"></div>
							<div id="bar-excursions" style="width: 9%; background: #7c3aed; transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Registry Cash Fund Tip Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						💡 Tipp für Ihre Hochzeits-Wunschliste:
					</strong>
					<p class="font-body" style="font-size: 0.85rem; line-height: 1.5; margin: 0; color: var(--fg-pencil); text-align: center;">
						Verwandeln Sie Posten aus diesem Rechner in konkrete Geschenkwünsche! Hochzeitsgäste schenken viel lieber ein <em>„Romantisches Candle-Light-Dinner am Strand (150 €)“</em> oder eine <em>„Paarmassage (120 €)“</em> als unpersönliches Geld.
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
