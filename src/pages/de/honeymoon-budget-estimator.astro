</style>

<script is:inline>
	let currencySymbol = '€';

	// Tier Matrix Base Costs (für 2 Reisende in EUR)
	const tierRates = {
		tier1: {
			flightsBase: 1300,
			lodging: { boutique: 80, resort4: 150, luxury5: 290, overwater: 600 },
			dining: { budget: 45, moderate: 80, fine_dining: 140, michelin: 250 },
			excursions: { light: 25, moderate: 60, heavy: 140 }
		},
		tier2: {
			flightsBase: 800,
			lodging: { boutique: 160, resort4: 300, luxury5: 580, overwater: 1000 },
			dining: { budget: 80, moderate: 150, fine_dining: 230, michelin: 400 },
			excursions: { light: 40, moderate: 100, heavy: 220 }
		},
		tier3: {
			flightsBase: 2800,
			lodging: { boutique: 320, resort4: 600, luxury5: 1100, overwater: 1750 },
			dining: { budget: 120, moderate: 220, fine_dining: 380, michelin: 680 },
			excursions: { light: 80, moderate: 180, heavy: 400 }
		},
		tier4: {
			flightsBase: 3400,
			lodging: { boutique: 400, resort4: 780, luxury5: 1350, overwater: 2200 },
			dining: { budget: 140, moderate: 250, fine_dining: 400, michelin: 720 },
			excursions: { light: 100, moderate: 250, heavy: 550 }
		},
		domestic: {
			flightsBase: 300,
			lodging: { boutique: 130, resort4: 240, luxury5: 480, overwater: 800 },
			dining: { budget: 70, moderate: 130, fine_dining: 210, michelin: 380 },
			excursions: { light: 35, moderate: 80, heavy: 180 }
		}
	};

	const countryTierSelect = document.getElementById('select-country-tier');
	const tripDaysSlider = document.getElementById('input-trip-days');
	const tripDaysNum = document.getElementById('input-trip-days-num');
	const tripDaysDisplay = document.getElementById('trip-days-display');

	const flightClassSelect = document.getElementById('select-flight-class');
	const lodgingStyleSelect = document.getElementById('select-lodging-style');
	const diningStyleSelect = document.getElementById('select-dining-style');
	const excursionsStyleSelect = document.getElementById('select-excursions-style');

	const chkInsurance = document.getElementById('chk-travel-insurance');
	const chkBuffer = document.getElementById('chk-shopping-buffer');
	const currencySelect = document.getElementById('currency-select');

	// Result Elements
	const resGrandTotal = document.getElementById('res-grand-total');
	const resPerDayNote = document.getElementById('res-per-day-note');
	const resFlightTotal = document.getElementById('res-flight-total');
	const resHotelTotal = document.getElementById('res-hotel-total');
	const resFoodTotal = document.getElementById('res-food-total');
	const resExcursionsTotal = document.getElementById('res-excursions-total');
	const resExtrasTotal = document.getElementById('res-extras-total');
	const resNightsCount = document.getElementById('res-nights-count');

	const barFlights = document.getElementById('bar-flights');
	const barHotel = document.getElementById('bar-hotel');
	const barFood = document.getElementById('bar-food');
	const barExcursions = document.getElementById('bar-excursions');

	const pctFlights = document.getElementById('pct-flights');
	const pctHotel = document.getElementById('pct-hotel');
	const pctFood = document.getElementById('pct-food');
	const pctExcursions = document.getElementById('pct-excursions');

	function formatMoney(amount) {
		const val = Math.round(amount).toLocaleString('de-DE');
		if (currencySymbol === '€' || currencySymbol === 'CHF') {
			return `${val} ${currencySymbol}`;
		}
		return `${currencySymbol}${val}`;
	}

	function calculateHoneymoon() {
		currencySymbol = currencySelect.value;
		const tierKey = countryTierSelect.value;
		const tier = tierRates[tierKey] || tierRates.tier2;

		const days = parseInt(tripDaysSlider.value) || 10;
		tripDaysNum.value = days;
		tripDaysDisplay.textContent = `${days} Tage / ${days} Nächte`;
		resNightsCount.textContent = days;

		// 1. Flights
		let flightCost = tier.flightsBase;
		const flightClass = flightClassSelect.value;
		if (flightClass === 'premium') flightCost *= 1.4;
		else if (flightClass === 'business') flightCost *= 2.5;
		else if (flightClass === 'points') flightCost = 150;

		// 2. Lodging
		const lodgingPerNight = tier.lodging[lodgingStyleSelect.value] || tier.lodging.resort4;
		const hotelCost = lodgingPerNight * days;

		// 3. Dining
		const diningPerDay = tier.dining[diningStyleSelect.value] || tier.dining.fine_dining;
		const foodCost = diningPerDay * days;

		// 4. Excursions
		const excursionsPerDay = tier.excursions[excursionsStyleSelect.value] || tier.excursions.moderate;
		const excursionsCost = excursionsPerDay * days;

		// 5. Extras
		let extrasCost = 0;
		if (chkInsurance.checked) extrasCost += 250;
		if (chkBuffer.checked) extrasCost += 350;

		const grandTotal = flightCost + hotelCost + foodCost + excursionsCost + extrasCost;
		const perDayCost = Math.round(grandTotal / days);

		// Update UI
		resGrandTotal.textContent = formatMoney(grandTotal);
		resPerDayNote.textContent = `Ca. ${formatMoney(perDayCost)} / Tag für zwei Personen`;
		resFlightTotal.textContent = formatMoney(flightCost);
		resHotelTotal.textContent = formatMoney(hotelCost);
		resFoodTotal.textContent = formatMoney(foodCost);
		resExcursionsTotal.textContent = formatMoney(excursionsCost);
		resExtrasTotal.textContent = formatMoney(extrasCost);

		// Bar Chart
		if (grandTotal > 0) {
			const pF = Math.round((flightCost / grandTotal) * 100);
			const pH = Math.round((hotelCost / grandTotal) * 100);
			const pD = Math.round((foodCost / grandTotal) * 100);
			const pE = 100 - pF - pH - pD;

			barFlights.style.width = `${pF}%`;
			barHotel.style.width = `${pH}%`;
			barFood.style.width = `${pD}%`;
			barExcursions.style.width = `${Math.max(2, pE)}%`;

			pctFlights.textContent = `${pF}%`;
			pctHotel.textContent = `${pH}%`;
			pctFood.textContent = `${pD}%`;
			pctExcursions.textContent = `${Math.max(2, pE)}%`;
		}
	}

	// Listeners
	tripDaysSlider.addEventListener('input', () => {
		tripDaysNum.value = tripDaysSlider.value;
		calculateHoneymoon();
	});
	tripDaysNum.addEventListener('input', () => {
		tripDaysSlider.value = tripDaysNum.value;
		calculateHoneymoon();
	});

	[countryTierSelect, flightClassSelect, lodgingStyleSelect, diningStyleSelect, excursionsStyleSelect, chkInsurance, chkBuffer, currencySelect].forEach(el => {
		el.addEventListener('change', calculateHoneymoon);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Flitterwochen Reisebudget</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Offizielles Flitterwochen-Budget</h1>
				<p>Erstellt am ${new Date().toLocaleDateString('de-DE')} | Reiseziel: <strong>${countryTierSelect.options[countryTierSelect.selectedIndex].text.split('(')[0]}</strong> | Dauer: <strong>${tripDaysSlider.value} Tage</strong> | Geschätztes Gesamtbudget: <strong>${resGrandTotal.textContent}</strong> (${resPerDayNote.textContent})</p>
				
				<h3>Aufgeschlüsselte Reiseausgaben:</h3>
				<table>
					<thead>
						<tr>
							<th>Kategorie</th>
							<th style="text-align:right;">Geschätzter Betrag</th>
						</tr>
					</thead>
					<tbody>
						<tr><td>Flüge für 2 Personen (${flightClassSelect.options[flightClassSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resFlightTotal.textContent}</td></tr>
						<tr><td>Unterkunft / Resort (${tripDaysSlider.value} Nächte @ ${lodgingStyleSelect.options[lodgingStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resHotelTotal.textContent}</td></tr>
						<tr><td>Gastronomie & Dinner (${diningStyleSelect.options[diningStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resFoodTotal.textContent}</td></tr>
						<tr><td>Ausflüge & Aktivitäten (${excursionsStyleSelect.options[excursionsStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resExcursionsTotal.textContent}</td></tr>
						<tr><td>Versicherung, Transfers & Puffer</td><td style="text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;">
							<td>Gesamtes Flitterwochen-Budget</td>
							<td style="text-align:right; color:#16a34a;">${resGrandTotal.textContent}</td>
						</tr>
					</tbody>
				</table>

				<h3 style="margin-top:25px;">Reise-Tipps:</h3>
				<p>• Gültigkeit der Reisepässe prüfen (mind. 6 Monate über das Rückreisedatum hinaus).</p>
				<p>• Auslandskrankenversicherung abschließen und Kreditkarten für den Auslandseinsatz freischalten.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Flitterwochen_Budget_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('de-DE');
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-honeymoon-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Hin- & Rückflüge für 2 Personen</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFlightTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Unterkunft & Resort (${tripDaysSlider.value} Nächte)</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resHotelTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Gastronomie & Dinner</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFoodTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Ausflüge & Aktivitäten</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExcursionsTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Versicherung, Transfers & Puffer</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Geschätztes Gesamtreisebudget</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#16a34a;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Kategorie,Geschätzter Betrag\n";
		csv += `"Flüge (2 Personen)","${resFlightTotal.textContent}"\n`;
		csv += `"Unterkunft (${tripDaysSlider.value} Nächte)","${resHotelTotal.textContent}"\n`;
		csv += `"Gastronomie & Verpflegung","${resFoodTotal.textContent}"\n`;
		csv += `"Ausflüge & Aktivitäten","${resExcursionsTotal.textContent}"\n`;
		csv += `"Versicherung & Nebenkosten","${resExtrasTotal.textContent}"\n`;
		csv += `"Gesamtbudget Flitterwochen","${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Flitterwochen_Budget_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateHoneymoon();
</script>
