---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/catering-cost-estimator/#webapp",
      "name": "Catering- & Menükosten-Rechner Hochzeit | Pro-Kopf-Kalkulator",
      "url": "https://manage.wedding/de/catering-cost-estimator",
      "inLanguage": "de",
      "description": "Kalkulieren Sie die tatsächlichen Gesamtkosten für Hochzeitsessen, Menüs, Buffets, Getränkepauschalen, Servicepauschalen, Tellergeld und Mehrwertsteuer mit Word-, PDF- und CSV-Export.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie berechnet man die Catering-Kosten pro Person für eine Hochzeit?",
      "description": "Schritt-für-Schritt-Methode zur realistischen Kalkulation von Hochzeitsmenü, Getränkepauschale, Mietgeschirr, Servicepersonal und Nebenkosten.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Bewirtungsform & Menü-Kategorie wählen",
          "text": "Wählen Sie zwischen serviertem 3- oder 4-Gänge-Menü, Buffet, Family-Style (Platten am Tisch), Flying Buffet oder Foodtruck und ergänzen Sie Fingerfood für den Sektempfang."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Getränkepauschale & Geschirrmiete konfigurieren",
          "text": "Wählen Sie die Getränkeoption (reine Wein/Bier-Pauschale, All-Inclusive Open Bar oder Korkgeld) sowie Mietkosten für Porzellan, Besteck und Gläser."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Gästezahl & Dienstleister-Verpflegung (Crew Meals) eintragen",
          "text": "Geben Sie die genaue Gästezahl und anwesende Dienstleister (Fotograf, DJ, Trauredner) ein, die meist zum ermäßigten Crew-Tarif verpflegt werden."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Servicepauschale, Nachtzuschläge & MwSt. einrechnen",
          "text": "Berücksichtigen Sie Servicepauschalen (15–20%) und die gesetzliche Mehrwertsteuer (19% in DE), um den echten Endpreis pro Person zu ermitteln."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Was kostet Catering pro Person bei einer Hochzeit in Deutschland/Österreich/Schweiz?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für das reine Essen (Menü oder Buffet) liegen die Kosten meist zwischen 45 € und 90 € pro Gast. Rechnet man Sektempfang, Getränkepauschale (ca. 30–50 €), Servicepersonal, Tellergeld und MwSt. hinzu, liegt der tatsächliche Gesamtpreis meist bei 110 € bis 190 € pro Person."
          }
        },
        {
          "@type": "Question",
          "name": "Ist ein Buffet günstiger als ein serviertes Menü?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nicht zwingend. Zwar benötigt ein Buffet etwas weniger Servicepersonal, allerdings muss der Caterer ca. 20–30% mehr Lebensmittel kalkulieren (Speisenpuffer), damit alle Platten bis zum letzten Gast appetitlich gefüllt bleiben. Hochwertige Buffets kosten oft ähnlich viel wie 3-Gänge-Menüs."
          }
        },
        {
          "@type": "Question",
          "name": "Was bedeutet Tellergeld / Kaffeegedeck bei der Hochzeit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wenn Sie die Hochzeitstorte von einem externen Konditor mitbringen, berechnet die Location meist ein Tellergeld (ca. 2,50 € bis 5,00 € pro Gast) für das Anschneiden, Bereitstellen von Kuchentellern, Kuchengabeln und den Abwasch."
          }
        },
        {
          "@type": "Question",
          "name": "Müssen Dienstleister (Fotograf, DJ, Band) verpflegt werden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Dienstleister, die 6 oder mehr Stunden im Einsatz sind, sollten mit einem warmen Hauptgericht und Getränken versorgt werden. Caterer bieten hierfür meist rabattierte 'Crew-Essen' (ca. 50% des Menüpreises) an."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Catering- & Menükosten-Rechner Hochzeit | Pro-Kopf-Kalkulator (Word/PDF Export)"
	description="Berechnen Sie die realistischen Kosten für Hochzeitsessen, Menüs, Buffets, Getränkepauschalen, Servicepauschalen, Tellergeld und Steuern mit Word-, PDF- und CSV-Export."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Catering- & Menükosten-Rechner" category="dining" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<span class="badge-postit">Menü, Buffet & Getränkepauschalen</span>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Catering- & Menükosten-Rechner <span class="accent-italic">für die Hochzeit</span>
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 720px; margin: 0 auto; text-align: center; line-height: 1.6;">
					Ermitteln Sie die echten Gesamtkosten für Hochzeitsessen, Getränkepauschalen, Mietgeschirr, Service-Zuschläge und Mehrwertsteuer. Exportieren Sie Ihr Angebot als <strong>Word (.doc)</strong>, <strong>PDF</strong> oder <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Main Workspace Grid: Configurator + Real-Time Financial Summary -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="catering-calc-grid">
			
			<!-- Left Column: Input Form & Package Controls -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🍽️ Bewirtung & Menü-Optionen
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Essen, Getränke, Geschirr & Service konfigurieren
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Währung:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; cursor: pointer;">
							<option value="€" selected>€ (EUR)</option>
							<option value="CHF">CHF (Schweizer Franken)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="catering-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Guest Count & Vendor Meals -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
						<div>
							<label for="input-guest-count" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Erwachsene Gäste *
							</label>
							<input type="number" id="input-guest-count" value="90" min="10" max="1000" required style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
						</div>

						<div>
							<label for="input-vendor-meals" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Dienstleister (Foto, DJ, Band)
							</label>
							<input type="number" id="input-vendor-meals" value="4" min="0" max="30" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
						</div>
					</div>

					<!-- Meal Service Style -->
					<div>
						<label for="select-meal-style" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Art der Hauptmahlzeit
						</label>
						<select id="select-meal-style" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff; cursor: pointer;">
							<option value="65" selected>Serviertes 3-Gänge-Menü (65 € / Gast Basis)</option>
							<option value="52">Klassisches Hochzeitsbuffet (2 Hauptgänge + Beilagen) (52 € / Gast)</option>
							<option value="58">Family Style / Tavolata (Platten am Tisch) (58 € / Gast)</option>
							<option value="46">Flying Buffet & Food-Stationen (46 € / Gast)</option>
							<option value="38">Foodtruck / BBQ & Grillbuffet (38 € / Gast)</option>
							<option value="85">Exklusives 4-Gänge Gourmet-Menü (85 € / Gast)</option>
						</select>
					</div>

					<!-- Passed Appetizers / Cocktail Hour -->
					<div>
						<label for="select-appetizers" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Sektempfang & Fingerfood / Canapés
						</label>
						<select id="select-appetizers" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff; cursor: pointer;">
							<option value="0">Kein Fingerfood / Nur Getränke (0 €)</option>
							<option value="12" selected>3 Fingerfood-Häppchen p.P. (12 € / Gast)</option>
							<option value="20">5 Fingerfood-Häppchen + Salziges Gebäck (20 € / Gast)</option>
							<option value="28">Premium Antipasti & Grazing Table (28 € / Gast)</option>
						</select>
					</div>

					<!-- Bar & Beverage Package -->
					<div>
						<label for="select-bar-package" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Getränkepauschale (ca. 6–8 Stunden)
						</label>
						<select id="select-bar-package" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff; cursor: pointer;">
							<option value="12">Nur Alkoholfrei & Kaffeespezialitäten (12 € / Gast)</option>
							<option value="10">Eigenkauf mit Korkgeld/Flaschengeld (10 € / Gast)</option>
							<option value="28">Bier, Wein, Softdrinks & Sektempfang (28 € / Gast)</option>
							<option value="38" selected>Vollpauschale (Wein, Bier, Sekt & Standard Longdrinks) (38 € / Gast)</option>
							<option value="52">Premium Open Bar inkl. Signature Cocktails & Spirituosen (52 € / Gast)</option>
						</select>
					</div>

					<!-- Rentals & Dinnerware -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
						<div>
							<label for="select-rentals" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Geschirr & Tischwäsche
							</label>
							<select id="select-rentals" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff; cursor: pointer;">
								<option value="0">In Location enthalten (0 €)</option>
								<option value="9" selected>Standard Porzellan & Servietten (9 €/p)</option>
								<option value="18">Vintage- / Goldrand-Geschirr (18 €/p)</option>
							</select>
						</div>

						<div>
							<label for="select-dessert-fee" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Tellergeld / Torte & Dessert
							</label>
							<select id="select-dessert-fee" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff; cursor: pointer;">
								<option value="0">Kein Tellergeld (0 €)</option>
								<option value="3.5" selected>Tellergeld Hochzeitstorte (3,50 €/p)</option>
								<option value="8">Großes Dessertbuffet vom Caterer (8 €/p)</option>
							</select>
						</div>
					</div>

					<!-- Plus-Plus Fees (Service Charge & Tax) -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-service-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Servicepauschale / Nachtaufschlag
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-service-pct" value="15" min="0" max="35" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>

						<div>
							<label for="input-tax-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								MwSt.-Satz (DE: 19% / AT: 20% / CH: 8,1%)
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-tax-pct" value="19" min="0" max="25" step="0.1" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Surcharge Comparison -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								📋 Geschätzte Catering-Rechnung
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								All-Inclusive: Essen, Getränke, Service & Steuern
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Word-Export (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ PDF drucken
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Cost Per Head vs Total Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Grand Total Invoice -->
						<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--accent-red); display: block; font-weight: bold;">Gesamtrechnung (Brutto)</span>
							<strong id="res-grand-total" class="font-heading" style="font-size: 2.1rem; color: var(--accent-red); display: block; line-height: 1.2;">15.176 €</strong>
							<span id="res-total-guest-note" style="font-size: 0.75rem; color: var(--accent-red);">Inkl. aller Abgaben</span>
						</div>

						<!-- All-Inclusive Cost Per Head -->
						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block; font-weight: bold;">Echter Preis pro Gast</span>
							<strong id="res-per-head" class="font-heading" style="font-size: 2.1rem; color: var(--accent-blue); display: block; line-height: 1.2;">168,62 €</strong>
							<span id="res-base-diff-note" style="font-size: 0.75rem; color: #1e40af;">Basisessen: 65,00 €</span>
						</div>

					</div>

					<!-- Itemized Invoice Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Aufschlüsselung der Rechnungsposten
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🥗 Hauptessen & Fingerfood:</td>
									<td id="res-food-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">6.930,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍷 Getränkepauschale / Bar:</td>
									<td id="res-bar-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">3.420,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍽️ Geschirr, Wäsche & Tellergeld:</td>
									<td id="res-rentals-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.125,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍱 Crew-Essen Dienstleister (50% Rabatt):</td>
									<td id="res-vendor-meals-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">130,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Zwischensumme Netto (Speisen + Bar + Miete):</td>
									<td id="res-pretax-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">11.605,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-red);">
									<td style="padding: 0.4rem 0;">➕ Servicepauschale (15%):</td>
									<td id="res-service-charge" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.740,75 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil);">
									<td style="padding: 0.4rem 0;">🏛️ Gesetzliche Mehrwertsteuer (19%):</td>
									<td id="res-sales-tax" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">2.535,69 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Proportional Cost Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Speisen & Getränke (72%)</span>
							<span style="color: var(--accent-red);">Service & Steuern (28%)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-food-portion" style="width: 72%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-fees-portion" style="width: 28%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Planner Surcharge Alert Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						⚠️ Der "Netto-zu-Brutto" Realitätscheck:
					</strong>
					<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; color: var(--fg-pencil);">
