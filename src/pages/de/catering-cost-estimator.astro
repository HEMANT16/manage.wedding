	function formatMoney(amount) {
		const formatted = Math.round(amount).toLocaleString('de-DE');
		if (currencySymbol === '€') {
			return `${formatted} €`;
		} else if (currencySymbol === 'CHF') {
			return `${formatted} CHF`;
		} else {
			return `${currencySymbol}${formatted}`;
		}
	}

	function formatMoneyDecimal(amount) {
		const formatted = amount.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
		if (currencySymbol === '€') {
			return `${formatted} €`;
		} else if (currencySymbol === 'CHF') {
			return `${formatted} CHF`;
		} else {
			return `${currencySymbol}${formatted}`;
		}
	}

	function calculateCatering() {
		currencySymbol = currencySelect.value;
		const guests = parseInt(guestCountInput.value) || 0;
		const vendors = parseInt(vendorMealsInput.value) || 0;

		const mealBasePerHead = parseFloat(mealStyleSelect.value) || 0;
		const appPerHead = parseFloat(appetizersSelect.value) || 0;
		const barPerHead = parseFloat(barPackageSelect.value) || 0;
		const rentalPerHead = parseFloat(rentalsSelect.value) || 0;
		const dessertPerHead = parseFloat(dessertFeeSelect.value) || 0;

		const servicePct = (parseFloat(servicePctInput.value) || 0) / 100;
		const taxPct = (parseFloat(taxPctInput.value) || 0) / 100;

		// Subtotals
		const foodSubtotal = guests * (mealBasePerHead + appPerHead);
		const barSubtotal = guests * barPerHead;
		const rentalsSubtotal = guests * (rentalPerHead + dessertPerHead);
		const vendorMealsSubtotal = vendors * (mealBasePerHead * 0.5); // 50% Rabatt

		const pretaxSubtotal = foodSubtotal + barSubtotal + rentalsSubtotal + vendorMealsSubtotal;
		const serviceCharge = pretaxSubtotal * servicePct;
		const salesTax = (pretaxSubtotal + serviceCharge) * taxPct;
		const grandTotal = pretaxSubtotal + serviceCharge + salesTax;

		const trueCostPerHead = guests > 0 ? (grandTotal / guests) : 0;

		// Update DOM
		resGrandTotal.textContent = formatMoney(grandTotal);
		resPerHead.textContent = formatMoneyDecimal(trueCostPerHead);
		resTotalGuestNote.textContent = `Kalkuliert für ${guests} Gäste`;
		resBaseDiffNote.textContent = `Basisessen: ${formatMoneyDecimal(mealBasePerHead)}`;

		resFoodSubtotal.textContent = formatMoneyDecimal(foodSubtotal);
		resBarSubtotal.textContent = formatMoneyDecimal(barSubtotal);
		resRentalsSubtotal.textContent = formatMoneyDecimal(rentalsSubtotal);
		resVendorMealsSubtotal.textContent = formatMoneyDecimal(vendorMealsSubtotal);
		resPretaxSubtotal.textContent = formatMoneyDecimal(pretaxSubtotal);
		resServiceCharge.textContent = formatMoneyDecimal(serviceCharge);
		resSalesTax.textContent = formatMoneyDecimal(salesTax);

		// Proportions
		if (grandTotal > 0) {
			const directFoodBarPct = Math.round((pretaxSubtotal / grandTotal) * 100);
			const feePct = 100 - directFoodBarPct;
			barFoodPortion.style.width = `${directFoodBarPct}%`;
			barFeesPortion.style.width = `${feePct}%`;
		}
	}

	// Listeners
	[guestCountInput, vendorMealsInput, servicePctInput, taxPctInput].forEach(el => el.addEventListener('input', calculateCatering));
	[mealStyleSelect, appetizersSelect, barPackageSelect, rentalsSelect, dessertFeeSelect, currencySelect].forEach(el => el.addEventListener('change', calculateCatering));

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const guests = parseInt(guestCountInput.value) || 0;
		const mealText = mealStyleSelect.options[mealStyleSelect.selectedIndex].text;
		const barText = barPackageSelect.options[barPackageSelect.selectedIndex].text;

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Hochzeits-Catering Kostenkalkulation</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Offizielle Catering-Kostenaufstellung</h1>
				<p>Erstellt am: ${new Date().toLocaleDateString('de-DE')} | Gästezahl: <strong>${guests}</strong> | Gesamtkosten pro Gast: <strong>${resPerHead.textContent}</strong></p>
				
				<h3>Ausgewählte Catering-Leistungen:</h3>
				<p>• <strong>Hauptmahlzeit:</strong> ${mealText}</p>
				<p>• <strong>Getränkepaket:</strong> ${barText}</p>

				<h3>Detaillierte Kostenaufstellung:</h3>
				<table>
					<thead>
						<tr><th>Rechnungsposition</th><th style="text-align:right;">Zwischensumme</th></tr>
					</thead>
					<tbody>
						<tr><td>Hauptessen & Fingerfood</td><td style="text-align:right;">${resFoodSubtotal.textContent}</td></tr>
						<tr><td>Getränkepauschale / Bar</td><td style="text-align:right;">${resBarSubtotal.textContent}</td></tr>
						<tr><td>Mietgeschirr, Wäsche & Tellergeld</td><td style="text-align:right;">${resRentalsSubtotal.textContent}</td></tr>
						<tr><td>Crew-Essen für Dienstleister</td><td style="text-align:right;">${resVendorMealsSubtotal.textContent}</td></tr>
						<tr style="background:#f9f9f9; font-weight:bold;"><td>Zwischensumme Netto</td><td style="text-align:right;">${resPretaxSubtotal.textContent}</td></tr>
						<tr><td>Servicepauschale (${servicePctInput.value}%)</td><td style="text-align:right;">${resServiceCharge.textContent}</td></tr>
						<tr><td>Mehrwertsteuer (${taxPctInput.value}%)</td><td style="text-align:right;">${resSalesTax.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;"><td>Gesamtrechnung (Brutto)</td><td style="text-align:right; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeits_Catering_Kalkulation_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const guests = guestCountInput.value;
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('de-DE');
		document.getElementById('print-guests').textContent = guests;
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-invoice-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Hauptessen & Fingerfood</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${guests} Gäste</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFoodSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Getränkepauschale / Bar</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${guests} Gäste</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBarSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Mietgeschirr, Wäsche & Tellergeld</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${guests} Gäste</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resRentalsSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Crew-Essen für Dienstleister</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${vendorMealsInput.value} Personen</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resVendorMealsSubtotal.textContent}</td></tr>
			<tr style="background:#fafafa;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Zwischensumme Netto</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPretaxSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Servicepauschale (${servicePctInput.value}%)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resServiceCharge.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Mehrwertsteuer (${taxPctInput.value}%)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resSalesTax.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:14px;">Gesamtsumme Brutto</td><td style="border:1px solid #ccc; padding:6px; text-align:center; font-weight:bold;">${resPerHead.textContent} / Gast</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:14px;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Rechnungsposition,Betrag\n";
		csv += `"Hauptessen & Fingerfood","${resFoodSubtotal.textContent}"\n`;
		csv += `"Getraenkepauschale & Bar","${resBarSubtotal.textContent}"\n`;
		csv += `"Mietgeschirr, Waesche & Tellergeld","${resRentalsSubtotal.textContent}"\n`;
		csv += `"Dienstleister-Verpflegung","${resVendorMealsSubtotal.textContent}"\n`;
		csv += `"Zwischensumme Netto","${resPretaxSubtotal.textContent}"\n`;
		csv += `"Servicepauschale (${servicePctInput.value}%)","${resServiceCharge.textContent}"\n`;
		csv += `"Mehrwertsteuer (${taxPctInput.value}%)","${resSalesTax.textContent}"\n`;
		csv += `"Gesamtsumme Brutto","${resGrandTotal.textContent}"\n`;
		csv += `"Kosten pro Gast","${resPerHead.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeits_Catering_Kalkulation_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateCatering();
</script>
