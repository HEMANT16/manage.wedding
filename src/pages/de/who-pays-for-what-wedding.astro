---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/who-pays-for-what-wedding/#webapp",
      "name": "Wer zahlt was bei der Hochzeit? Kostenaufteiler & Finanzplaner",
      "url": "https://manage.wedding/de/who-pays-for-what-wedding",
      "description": "Kostenloser Hochzeitskosten-Aufteiler: Vergleichen Sie traditionelle Bräuche mit modernen Modellen (Drittel-Aufteilung, 50/50 oder Selbstfinanzierung). Mit Word- und PDF-Export.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "de",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie man Hochzeitskosten zwischen Brautpaar und Familien aufteilt",
      "description": "Schritt-für-Schritt-Anleitung zur fairen und transparenten Kostenaufteilung für die Hochzeit.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Gesamtbudget festlegen",
          "text": "Bestimmen Sie den finanziellen Gesamtrahmen (z. B. 30.000 €) basierend auf Location-, Catering- und Dienstleisterangeboten."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Aufteilungsmodell wählen",
          "text": "Entscheiden Sie zwischen traditioneller Aufteilung (Brauteltern zahlen Feier/Kleid, Bräutigameltern Polterabend/Flitterwochen), moderner Drittel-Teilung oder vollständiger Eigenfinanzierung."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Feste Posten zuordnen",
          "text": "Weisen Sie feste Bausteine wie Location & Menü, Brautkleid, Polterabend, Flitterwochen, Blumenschmuck und Ringe klar zu."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Zahlungsmodalitäten mit den Eltern besprechen",
          "text": "Klären Sie, ob die Unterstützung als Pauschalbetrag auf ein Hochzeitskonto überwiesen wird oder Rechnungen direkt beglichen werden."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wer zahlt traditionell was bei einer Hochzeit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditionell übernahmen die Brauteltern das Brautkleid, die Feierlocation, das Festessen, die Hochzeitstorte, den Blumenschmuck und die Einladungskarten. Die Eltern des Bräutigams zahlten den Polterabend, die Flitterwochen, die Gebühren für Standesamt/Kirche sowie den Brautstrauß und die Ansteckblumen."
          }
        },
        {
          "@type": "Question",
          "name": "Wer bezahlt heute die Hochzeit in modernen Partnerschaften?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Heute finanzieren über 60% der Brautpaare ihre Hochzeit überwiegend selbst. Wenn Eltern unterstützen, ist die 'Drittel-Aufteilung' am beliebtesten: Das Brautpaar trägt 40–50% und beide Elternpaare steuern jeweils 25–30% als festen Zuschuss bei."
          }
        },
        {
          "@type": "Question",
          "name": "Wer zahlt den Junggesellenabschied (JGA)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Der Junggesellenabschied wird traditionell von den Trauzeugen organisiert und von allen teilnehmenden Freunden gemeinsam bezahlt. Braut bzw. Bräutigam werden den gesamten Tag über eingeladen."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wer zahlt was bei der Hochzeit? (Kostenaufteiler & Etikette) | Manage.Wedding"
	description="Kostenloser Kostenverteiler: Vergleichen Sie traditionelle Bräuche mit modernen Modellen (Drittel-Aufteilung, 50/50 oder Selbstfinanzierung). Mit Word- & PDF-Export."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Wer zahlt was? Kostenaufteiler" category="budget" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Traditionelle Bräuche vs. Moderne Drittel-Teilung</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Wer zahlt was? <span class="accent-italic">Hochzeitskosten-Aufteiler</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Vergleichen Sie historische Traditionen mit zeitgemäßen Finanzierungsmodellen. Verteilen Sie alle Posten transparent auf Brautpaar und Eltern und exportieren Sie Ihre Vereinbarung mit 1 Klick.
			</p>
		</header>

		<!-- Main Interactive Splitter Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Split Model Setup & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Finanzierungsmodell & Budget
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Kostenverteiler
					</span>
				</div>

				<!-- Total Budget -->
				<div class="form-group">
					<label class="form-label" for="total-wedding-budget">Geschätztes Gesamtbudget (€)</label>
					<input type="number" id="total-wedding-budget" class="form-input" value="30000" min="5000" step="1000" style="font-size: 1.2rem; font-weight: 700;" />
				</div>

				<!-- Split Model Shortcut Selector -->
				<div class="form-group">
					<label class="form-label" for="split-model-preset">Typisches Aufteilungsmodell</label>
					<select id="split-model-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="traditional" selected>📜 Historisch traditionell (Brauteltern 70% / Bräutigameltern 25% / Paar 5%)</option>
						<option value="modern-3way">🤝 Moderne 3-Wege-Teilung (Paar 40% / Brauteltern 30% / Bräutigameltern 30%)</option>
						<option value="couple-100">💍 Brautpaar finanziert 100% selbst (Vollkommene Unabhängigkeit)</option>
						<option value="couple-50-50">⚖️ Partner 1 & Partner 2 teilen 50/50</option>
						<option value="custom">✏️ Individuelle Prozentsätze einstellen</option>
					</select>
				</div>

				<!-- Visual Split Percentages Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Prozentuale Kostenübernahme (%)
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.85rem;">
						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-red);">👰 Anteil Brauteltern:</span>
								<span id="slider-bride-pct-val">70%</span>
							</div>
							<input type="range" id="slider-bride-pct" min="0" max="100" value="70" style="width: 100%; accent-color: var(--accent-red);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-blue);">🤵 Anteil Bräutigameltern:</span>
								<span id="slider-groom-pct-val">25%</span>
							</div>
							<input type="range" id="slider-groom-pct" min="0" max="100" value="25" style="width: 100%; accent-color: var(--accent-blue);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: #16a34a;">💍 Eigenanteil Brautpaar:</span>
								<span id="slider-couple-pct-val">5%</span>
							</div>
							<input type="range" id="slider-couple-pct" min="0" max="100" value="5" style="width: 100%; accent-color: #16a34a;" />
						</div>
					</div>
				</div>

				<!-- Quick Money Talk Guide -->
				<div style="margin-top: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
					<strong style="display: block; color: var(--fg-pencil); margin-bottom: 4px;">💬 Tipp für das Gespräch mit den Eltern:</strong>
					„Wir haben mit der Budgetplanung begonnen! Möchtet ihr einen bestimmten Teil (wie die Musik, den Polterabend oder den Fotografen) übernehmen, oder sollen wir alles eigenständig planen?“
				</div>

			</div>

			<!-- Right Column: Results Breakdown & Itemized Checklist -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Contribution Summary Cards -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Kostenverteilung im Überblick
					</h3>

					<!-- 3 Contribution Summary Bars -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem; text-align: center;">
						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-red);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Brauteltern</span>
							<strong id="card-bride-amount" style="font-size: 1.2rem; color: var(--accent-red); display: block; margin-top: 2px;">21.000 €</strong>
							<span id="card-bride-pct" style="font-size: 0.75rem; color: #64748b;">(70%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-blue);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Bräutigameltern</span>
							<strong id="card-groom-amount" style="font-size: 1.2rem; color: var(--accent-blue); display: block; margin-top: 2px;">7.500 €</strong>
							<span id="card-groom-pct" style="font-size: 0.75rem; color: #64748b;">(25%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid #16a34a;">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Brautpaar</span>
							<strong id="card-couple-amount" style="font-size: 1.2rem; color: #16a34a; display: block; margin-top: 2px;">1.500 €</strong>
							<span id="card-couple-pct" style="font-size: 0.75rem; color: #64748b;">(5%)</span>
						</div>
					</div>

					<!-- Itemized Traditional Responsibilities Table -->
					<div style="max-height: 280px; overflow-y: auto; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; margin-bottom: 1.5rem;">
						<table style="width: 100%; border-collapse: collapse; font-size: 0.86rem; text-align: left;">
							<thead>
								<tr style="background: var(--muted-paper); border-bottom: 1.5px solid var(--fg-pencil);">
									<th style="padding: 6px 8px;">Ausgabenposten</th>
									<th style="padding: 6px 8px; text-align: right;">Traditioneller Kostenträger</th>
								</tr>
							</thead>
							<tbody>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Location, Saalmiete & Festessen</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Brauteltern</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Brautkleid, Schleier & Styling</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Brauteltern</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Hochzeitsfotografie & Video</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Brauteltern</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Einladungskarten & Papeterie</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Brauteltern</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Polterabend / Vorabend-Get-Together</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Bräutigameltern</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Flitterwochen (Flug & Hotel)</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Bräutigameltern</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Standesamtgebühren & Trauredner</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Bräutigameltern</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Brautstrauß & Anstecker</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Bräutigam</td></tr>
								<tr><td>Trauringe & Präsente</td><td style="text-align: right; font-weight: bold; color: #16a34a;">Brautpaar</td></tr>
							</tbody>
						</table>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-agreement" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> PDF-Vereinbarung drucken
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Word-Export (.doc)
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Auf einen Blick</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Faustregel: Wer bezahlt die Hochzeit heute?
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Traditionelle Rollenverteilung im Vergleich zur modernen Kostenaufteilung.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📋 Traditionelle Faustregel auf einen Blick:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Brauteltern: [Brautkleid + Feierlocation & Menü + Fotografie + Dekoration] • Bräutigameltern: [Polterabend + Flitterwochen + Standesamt] • Trauzeugen/Freunde: [JGA-Planung & Kosten]
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Finanzierungsmodell</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Anteil Brauteltern</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Anteil Bräutigameltern</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Anteil Brautpaar</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Historisch traditionell</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">65% – 75% (Location, Kleid, Menü)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">20% – 25% (Polterabend, Reise)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">0% – 10% (Ringe, Gebühren)</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Moderne 3-Wege-Teilung</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">30% Festbetrag / Zuschuss</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">30% Festbetrag / Zuschuss</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">40% Eigenanteil</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">100% Selbstzahler</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">0 € (Ehrengäste)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">0 € (Ehrengäste)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">100% Eigenfinanzierung</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Leitfaden zur Kostenaufteilung und Kommunikation mit der Familie
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Finanzgespräche mit Eltern und Schwiegereltern erfordern Feingefühl, klare Absprachen und transparente Budgetgrenzen.
				</p>
			</div>

			<!-- Section 1: Evolution of Norms -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Von der Aussteuer zur partnerschaftlichen Planung
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Früher galt die Mitgift als Absicherung, weshalb Brauteltern die Hauptkosten trugen. Heute heiraten Paare meist nach mehreren Berufsjahren und tragen die Verantwortung gemeinsam:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Pauschalzuschuss statt Einzelrechnungen:</strong> Um Diskussionen über einzelne Dienstleisterpreise zu vermeiden, empfiehlt sich ein pauschaler Festzuschuss der Eltern auf ein gemeinsames Hochzeitskonto.</li>
					<li><strong>Mitspracherecht bei der Gästeliste:</strong> Zahlen Eltern wesentliche Teile der Bewirtung, ist es fair, ihnen ein angemessenes Kontingent für eigene Freunde und Verwandte einzuräumen.</li>
				</ul>
			</section>

		</article>

		<RelatedTools currentPath="/de/who-pays-for-what-wedding" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const totalBudgetInput = document.getElementById('total-wedding-budget');
		const presetSelect = document.getElementById('split-model-preset');

		const sliderBride = document.getElementById('slider-bride-pct');
		const sliderGroom = document.getElementById('slider-groom-pct');
		const sliderCouple = document.getElementById('slider-couple-pct');

		const bridePctVal = document.getElementById('slider-bride-pct-val');
		const groomPctVal = document.getElementById('slider-groom-pct-val');
		const couplePctVal = document.getElementById('slider-couple-pct-val');

		const cardBrideAmount = document.getElementById('card-bride-amount');
		const cardBridePct = document.getElementById('card-bride-pct');
		const cardGroomAmount = document.getElementById('card-groom-amount');
		const cardGroomPct = document.getElementById('card-groom-pct');
		const cardCoupleAmount = document.getElementById('card-couple-amount');
		const cardCouplePct = document.getElementById('card-couple-pct');

		const btnPrint = document.getElementById('btn-print-agreement');
		const btnDoc = document.getElementById('btn-export-doc');

		function calculateSplits() {
			const total = parseFloat(totalBudgetInput.value) || 0;
			const bPct = parseInt(sliderBride.value, 10);
			const gPct = parseInt(sliderGroom.value, 10);
			const cPct = parseInt(sliderCouple.value, 10);

			bridePctVal.textContent = `${bPct}%`;
			groomPctVal.textContent = `${gPct}%`;
			couplePctVal.textContent = `${cPct}%`;

			const bAmount = (total * bPct) / 100;
			const gAmount = (total * gPct) / 100;
			const cAmount = (total * cPct) / 100;

			cardBrideAmount.textContent = `${Math.round(bAmount).toLocaleString('de-DE')} €`;
			cardBridePct.textContent = `(${bPct}%)`;
			cardGroomAmount.textContent = `${Math.round(gAmount).toLocaleString('de-DE')} €`;
			cardGroomPct.textContent = `(${gPct}%)`;
			cardCoupleAmount.textContent = `${Math.round(cAmount).toLocaleString('de-DE')} €`;
			cardCouplePct.textContent = `(${cPct}%)`;
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'traditional') {
				sliderBride.value = 70;
				sliderGroom.value = 25;
				sliderCouple.value = 5;
			} else if (p === 'modern-3way') {
				sliderBride.value = 30;
				sliderGroom.value = 30;
				sliderCouple.value = 40;
			} else if (p === 'couple-100') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			} else if (p === 'couple-50-50') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			}
			calculateSplits();
		});

		// Slider Listeners with Normalization
		sliderBride.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderBride.value, 10);
			sliderGroom.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderGroom.value;
			calculateSplits();
		});
		sliderGroom.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderGroom.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderBride.value;
			calculateSplits();
		});
		sliderCouple.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderCouple.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderGroom.value = rem - sliderBride.value;
			calculateSplits();
		});

		totalBudgetInput.addEventListener('input', calculateSplits);

		// Print Agreement Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Kostenaufteilung Hochzeit — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Hochzeitskosten-Aufteilungsvereinbarung</h1>
					<p>Gesamtbudget: ${parseFloat(totalBudgetInput.value).toLocaleString('de-DE')} € | Modell: ${presetSelect.options[presetSelect.selectedIndex].text}</p>
					
					<table>
						<thead><tr><th>Kostenträger</th><th>Vereinbarter Anteil</th><th>Betrag (€)</th><th>Hauptverantwortliche Posten</th></tr></thead>
						<tbody>
							<tr><td><strong>Brauteltern</strong></td><td>${sliderBride.value}%</td><td><strong>${cardBrideAmount.textContent}</strong></td><td>Location, Menü/Buffet, Brautkleid, Floristik, Fotografie</td></tr>
							<tr><td><strong>Bräutigameltern</strong></td><td>${sliderGroom.value}%</td><td><strong>${cardGroomAmount.textContent}</strong></td><td>Polterabend, Flitterwochen, Gebühren, Anstecker</td></tr>
							<tr><td><strong>Brautpaar</strong></td><td>${sliderCouple.value}%</td><td><strong>${cardCoupleAmount.textContent}</strong></td><td>Trauringe, Gastgeschenke, Restbeträge</td></tr>
							<tr class="total-row"><td>GESAMTBUDGET</td><td>100%</td><td>${parseFloat(totalBudgetInput.value).toLocaleString('de-DE')} €</td><td>Vollständiger Hochzeitsfinanzplan</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Hochzeitskosten Aufteilung</title>
				<style>body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Vereinbarung zur Hochzeitskosten-Aufteilung</h2>
					<p>Gesamtbudget: ${parseFloat(totalBudgetInput.value).toLocaleString('de-DE')} €</p>
					<table>
						<thead><tr><th>Kostenträger</th><th>Anteil (%)</th><th>Betrag (€)</th></tr></thead>
						<tbody>
							<tr><td>Brauteltern</td><td>${sliderBride.value}%</td><td>${cardBrideAmount.textContent}</td></tr>
							<tr><td>Bräutigameltern</td><td>${sliderGroom.value}%</td><td>${cardGroomAmount.textContent}</td></tr>
							<tr><td>Brautpaar</td><td>${sliderCouple.value}%</td><td>${cardCoupleAmount.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>GESAMT</td><td>100%</td><td>${parseFloat(totalBudgetInput.value).toLocaleString('de-DE')} €</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'Hochzeitskosten_Aufteilung.doc';
			link.click();
		});

		// Initial Calculation
		calculateSplits();
	</script>
</Layout>
