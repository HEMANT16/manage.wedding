---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/vendor-tipping-calculator/#webapp",
      "name": "Hochzeits-Trinkgeldrechner & Umschlag-Planer",
      "url": "https://manage.wedding/de/vendor-tipping-calculator",
      "description": "Kostenloser Trinkgeld-Rechner für Hochzeitsdienstleister: Berechnen Sie angemessene Trinkgelder für Servicepersonal, DJ, Fotografen, Brautstyling, Fahrer und Floristen. Mit Word-, PDF- & CSV-Export.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "inLanguage": "de",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie man Trinkgelder für Hochzeitsdienstleister richtig berechnet und verteilt",
      "description": "Leitfaden zur Trinkgeld-Etikette bei Hochzeiten im deutschsprachigen Raum und Vorbereitung der Bargeld-Umschläge.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Verträge auf bereits enthaltene Servicepauschalen prüfen",
          "text": "Prüfen Sie Catering- und Location-Verträge, ob bereits eine Servicepauschale für das Personal enthalten ist."
        },
        {
          "@type": "HowToStep",
          "name": "2. Prozentuales Trinkgeld für Service & Styling ansetzen",
          "text": "Planen Sie 10% bis 15% für Gastronomie-Servicekräfte und das mobile Brautstyling ein."
        },
        {
          "@type": "HowToStep",
          "name": "3. Pauschalbeträge für DJ, Fotograf und Logistik festlegen",
          "text": "Kalkulieren Sie Pauschalen: 50–100 € für den DJ, 50–100 € für Foto-Assistenten und 20–40 € für Shuttle-Fahrer."
        },
        {
          "@type": "HowToStep",
          "name": "4. Beschriftete Umschläge vorbereiten und delegieren",
          "text": "Bereiten Sie beschriftete Briefumschläge vor und übergeben Sie diese dem Trauzeugen oder Zeremonienmeister zur Verteilung am Abend."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Gibt man selbstständigen Hochzeitsdienstleistern Trinkgeld?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Im deutschsprachigen Raum kalkulieren selbstständige Inhaber (wie Hochzeitsfotografen oder freie Redner) ihre Honorare so, dass sie nicht auf Trinkgeld angewiesen sind. Wenn Sie von der Leistung begeistert sind, freuen sich Dienstleister über 50–100 € Trinkgeld, ein persönliches Geschenk oder vor allem eine ausführliche 5-Sterne-Google-Bewertung."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel Trinkgeld gibt man Kellnern und Barkeepern bei der Hochzeit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Üblich sind entweder 5% bis 10% der gastronomischen Gesamtrechnung oder pauschal 25 € bis 50 € in bar pro Servicekraft und Barkeeper, die am Abend direkt an den Serviceleiter übergeben werden."
          }
        },
        {
          "@type": "Question",
          "name": "Wer sollte die Trinkgeld-Umschläge am Hochzeitstag übergeben?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Als Brautpaar sollten Sie am Hochzeitstag kein Bargeld bei sich tragen. Bereiten Sie beschriftete Umschläge einige Tage vorher vor und übergeben Sie diese beim Probeessen dem Trauzeugen oder Wedding Planner zur Verteilung."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Trinkgeld-Rechner Dienstleister (Trinkgeld-Knigge & Umschlag-Export) | Manage.Wedding"
	description="Kostenloser Hochzeits-Trinkgeldrechner: Berechnen Sie angemessenes Trinkgeld für Caterer, DJ, Fotografen, Brautstyling & Servicekräfte. Mit druckbaren Umschlägen und Word-Export."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Trinkgeld-Rechner Dienstleister" category="budget" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Trinkgeld-Rechner <span class="accent-italic">für Dienstleister</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Berechnen Sie angemessene Trinkgelder nach deutschem Knigge für Servicekräfte, DJ, Fotografen und Styling. Erstellen Sie beschriftete <strong>Bargeld-Umschläge</strong> zum Export in <strong>Word (.doc)</strong> oder <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Trinkgeld-Planung in 3 einfachen Schritten
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Dienstleister & Rechnungen eintragen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Geben Sie Beträge ein oder haken Sie Posten ab, falls eine Servicepauschale bereits im Vertrag enthalten ist.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Richtwerte & Pauschalen prüfen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Der Rechner wendet bewährte Standards an (10–15% für Service & Styling, 50–100 € für DJ & Foto-Assistenten).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Umschlag-Übergabeplan exportieren
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Klicken Sie auf <strong>„📝 Export Word (.doc)“</strong> oder <strong>„🖨️ Export PDF“</strong>, um eine Liste mit Übergabezeiten für Ihre Trauzeugen zu drucken.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="tipping-calc-grid">
			
			<!-- Left Column: 10+ Vendor Categories Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							💵 Dienstleister & Beträge
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Wählen Sie gebuchte Gewerke und Richtwerte aus
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Währung:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="CHF">CHF (Schweiz)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="tipping-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Catering & Bartenders -->
					<div class="vendor-input-group">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
							<label class="font-heading" style="font-size: 1rem; color: var(--accent-red);">
								🍽️ Servicekräfte & Gastronomie
							</label>
							<label style="font-size: 0.78rem; display: flex; align-items: center; gap: 0.3rem; cursor: pointer; color: var(--text-secondary);">
								<input type="checkbox" id="chk-caterer-included"> Bereits im Vertrag enthalten
							</label>
						</div>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Catering- / Getränkerechnung (€)</span>
								<input type="number" id="input-caterer-bill" value="6000" min="0" step="100" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Trinkgeld-Modus</span>
								<select id="select-caterer-rate" class="tip-select">
									<option value="0.10" selected>10% der Rechnung (600 €)</option>
									<option value="0.08">8% der Rechnung (480 €)</option>
									<option value="flat">Pauschal 35 € pro Servicekraft</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 2. Hair & Makeup (HMUA) -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: var(--accent-blue); display: block; margin-bottom: 0.3rem;">
							💄 Brautstyling (Haare & Make-up)
						</label>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Styling-Rechnung (€)</span>
								<input type="number" id="input-beauty-bill" value="650" min="0" step="50" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Trinkgeldsatz</span>
								<select id="select-beauty-rate" class="tip-select">
									<option value="0.15" selected>15% (Standard Vor-Ort)</option>
									<option value="0.10">10% (Solider Standard)</option>
									<option value="0.20">20% (Herausragender Service)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 3. Photography & Videography -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #16a34a; display: block; margin-bottom: 0.3rem;">
							📸 Hochzeitsfotograf & Videograf
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Hauptfotograf/in</span>
								<select id="select-photo-lead" class="tip-select">
									<option value="100" selected>Hauptfotograf (100 €)</option>
									<option value="50">Hauptfotograf (50 €)</option>
									<option value="0">Kein Trinkgeld / Inhaber (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Zweitfotograf / Assistent</span>
								<select id="select-photo-second" class="tip-select">
									<option value="50" selected>Zweitfotograf (50 €)</option>
									<option value="75">Zweitfotograf (75 €)</option>
									<option value="0">Kein Assistent (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 4. DJ & Entertainment -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #7c3aed; display: block; margin-bottom: 0.3rem;">
							🎵 Hochzeits-DJ & Live-Musiker
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">DJ / Moderator</span>
								<select id="select-dj-tip" class="tip-select">
									<option value="80" selected>DJ (80 € Pauschale)</option>
									<option value="100">DJ (100 € Pauschale)</option>
									<option value="50">DJ (50 € Pauschale)</option>
									<option value="0">Kein Trinkgeld (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Zeremonien-Musiker</span>
								<select id="select-band-tip" class="tip-select">
									<option value="30" selected>Musiker (30 € / Person)</option>
									<option value="50">Musiker (50 € / Person)</option>
									<option value="0">Keine Live-Musiker (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 5. Wedding Planner & Coordinator -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #d97706; display: block; margin-bottom: 0.3rem;">
							📋 Wedding Planner / Zeremonienmeister
						</label>
						<div>
							<select id="select-planner-tip" class="tip-select">
								<option value="100" selected>Tagesbegleitung / Koordinator (100 €)</option>
								<option value="150">Komplett-Planer (150 €)</option>
								<option value="50">Zeremonienmeister (50 €)</option>
								<option value="0">Kein Trinkgeld / Inhaber (0 €)</option>
							</select>
						</div>
					</div>

					<!-- 6. Drivers, Officiant & Delivery Setup Crew -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block; text-align: center;">
							🚐 Fahrer, Trauredner & Lieferdienste
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Chauffeur / Shuttle-Fahrer</span>
								<select id="select-driver-tip" class="tip-select">
									<option value="40" selected>Brautauto-Fahrer (40 €)</option>
									<option value="60">Shuttle-Fahrer (60 €)</option>
									<option value="0">Im Mietpreis inbegriffen (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Freie/r Trauredner/in / Standesamt</span>
								<select id="select-officiant-tip" class="tip-select">
									<option value="50" selected>Trauredner Trinkgeld (50 €)</option>
									<option value="30">Kaffeekasse Standesamt (30 €)</option>
									<option value="0">Bereits honoriert (0 €)</option>
								</select>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Floristik & Deko-Aufbau</span>
								<select id="select-delivery-tip" class="tip-select">
									<option value="30" selected>Deko-Aufbauteam (30 €)</option>
									<option value="50">Großes Aufbauteam (50 €)</option>
									<option value="0">Kein Trinkgeld (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Konditor / Tortenlieferung</span>
								<select id="select-cake-tip" class="tip-select">
									<option value="15" selected>Tortenlieferung (15 €)</option>
									<option value="25">Mehrstöckiger Aufbau (25 €)</option>
									<option value="0">Kein Trinkgeld (0 €)</option>
								</select>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Gratuity Breakdown & Cash Envelope Planner -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Gratuity Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								✉️ Gesamtes Trinkgeldbudget
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Bargeldbedarf für die Umschläge am Hochzeitstag
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Drucken
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Gratuity Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Benötigtes Bargeld in Umschlägen</span>
						<strong id="res-total-gratuity" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">1.162 €</strong>
						<span id="res-envelope-count" style="font-size: 0.8rem; color: var(--accent-red);">Verteilt auf 8 vorbereitete Umschläge</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Aufschlüsselung nach Dienstleistern
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Servicepersonal & Gastronomie:</td>
									<td id="res-caterer-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">600 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">💄 Brautstyling (Haare & Make-up):</td>
									<td id="res-beauty-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">98 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📸 Foto- & Videoteam:</td>
									<td id="res-photo-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">150 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🎵 DJ & Zeremonien-Musiker:</td>
									<td id="res-dj-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">110 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📋 Wedding Planner / Koordinator:</td>
									<td id="res-planner-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">100 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🚐 Chauffeur & Trauredner:</td>
									<td id="res-logistics-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">90 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0;">🌸 Floristik-Aufbau & Torte:</td>
									<td id="res-delivery-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">45 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Gratuity Distribution Bar Chart -->
					<div>
						<span class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.3rem; text-align: center;">
