<script is:inline>
	let currencySymbol = '€';

	const currencySelect = document.getElementById('currency-select');
	const chkCatererIncluded = document.getElementById('chk-caterer-included');
	const inputCatererBill = document.getElementById('input-caterer-bill');
	const selectCatererRate = document.getElementById('select-caterer-rate');

	const inputBeautyBill = document.getElementById('input-beauty-bill');
	const selectBeautyRate = document.getElementById('select-beauty-rate');

	const selectPhotoLead = document.getElementById('select-photo-lead');
	const selectPhotoSecond = document.getElementById('select-photo-second');

	const selectDjTip = document.getElementById('select-dj-tip');
	const selectBandTip = document.getElementById('select-band-tip');

	const selectPlannerTip = document.getElementById('select-planner-tip');
	const selectDriverTip = document.getElementById('select-driver-tip');
	const selectOfficiantTip = document.getElementById('select-officiant-tip');
	const selectDeliveryTip = document.getElementById('select-delivery-tip');
	const selectCakeTip = document.getElementById('select-cake-tip');

	// Result Elements
	const resTotalGratuity = document.getElementById('res-total-gratuity');
	const resEnvelopeCount = document.getElementById('res-envelope-count');
	const resCatererTip = document.getElementById('res-caterer-tip');
	const resBeautyTip = document.getElementById('res-beauty-tip');
	const resPhotoTip = document.getElementById('res-photo-tip');
	const resDjTip = document.getElementById('res-dj-tip');
	const resPlannerTip = document.getElementById('res-planner-tip');
	const resLogisticsTip = document.getElementById('res-logistics-tip');
	const resDeliveryTip = document.getElementById('res-delivery-tip');

	const barCaterer = document.getElementById('bar-caterer');
	const barBeauty = document.getElementById('bar-beauty');
	const barPhoto = document.getElementById('bar-photo');
	const barDj = document.getElementById('bar-dj');
	const barPlanner = document.getElementById('bar-planner');
	const barOther = document.getElementById('bar-other');

	function formatMoney(amount) {
		const val = Math.round(amount).toLocaleString('de-DE');
		if (currencySymbol === '€' || currencySymbol === 'CHF') {
			return `${val} ${currencySymbol}`;
		}
		return `${currencySymbol}${val}`;
	}

	function calculateTips() {
		currencySymbol = currencySelect.value;

		// 1. Caterer
		let catererTip = 0;
		if (!chkCatererIncluded.checked) {
			const bill = parseFloat(inputCatererBill.value) || 0;
			const rate = selectCatererRate.value;
			if (rate === 'flat') {
				catererTip = 35 * 8; // ca. 8 Kellner
			} else {
				catererTip = bill * parseFloat(rate);
			}
		}

		// 2. Beauty
		const beautyBill = parseFloat(inputBeautyBill.value) || 0;
		const beautyRate = parseFloat(selectBeautyRate.value) || 0.15;
		const beautyTip = beautyBill * beautyRate;

		// 3. Photo / Video
		const photoLead = parseFloat(selectPhotoLead.value) || 0;
		const photoSecond = parseFloat(selectPhotoSecond.value) || 0;
		const photoTotal = photoLead + photoSecond;

		// 4. DJ & Band
		const djTip = parseFloat(selectDjTip.value) || 0;
		const bandTip = parseFloat(selectBandTip.value) || 0;
		const musicTotal = djTip + bandTip;

		// 5. Planner
		const plannerTip = parseFloat(selectPlannerTip.value) || 0;

		// 6. Drivers & Officiant
		const driverTip = parseFloat(selectDriverTip.value) || 0;
		const officiantTip = parseFloat(selectOfficiantTip.value) || 0;
		const logisticsTotal = driverTip + officiantTip;

		// 7. Delivery Crews
		const deliveryTip = parseFloat(selectDeliveryTip.value) || 0;
		const cakeTip = parseFloat(selectCakeTip.value) || 0;
		const deliveryTotal = deliveryTip + cakeTip;

		const grandTotal = catererTip + beautyTip + photoTotal + musicTotal + plannerTip + logisticsTotal + deliveryTotal;

		// Count active envelopes
		let count = 0;
		if (catererTip > 0) count++;
		if (beautyTip > 0) count++;
		if (photoLead > 0) count++;
		if (photoSecond > 0) count++;
		if (djTip > 0) count++;
		if (bandTip > 0) count++;
		if (plannerTip > 0) count++;
		if (driverTip > 0) count++;
		if (officiantTip > 0) count++;
		if (deliveryTotal > 0) count++;

		// Update UI
		resTotalGratuity.textContent = formatMoney(grandTotal);
		resEnvelopeCount.textContent = `Verteilt auf ${count} vorbereitete Umschläge`;
		resCatererTip.textContent = formatMoney(catererTip);
		resBeautyTip.textContent = formatMoney(beautyTip);
		resPhotoTip.textContent = formatMoney(photoTotal);
		resDjTip.textContent = formatMoney(musicTotal);
		resPlannerTip.textContent = formatMoney(plannerTip);
		resLogisticsTip.textContent = formatMoney(logisticsTotal);
		resDeliveryTip.textContent = formatMoney(deliveryTotal);

		// Bar Chart
		if (grandTotal > 0) {
			barCaterer.style.width = `${Math.round((catererTip / grandTotal) * 100)}%`;
			barBeauty.style.width = `${Math.round((beautyTip / grandTotal) * 100)}%`;
			barPhoto.style.width = `${Math.round((photoTotal / grandTotal) * 100)}%`;
			barDj.style.width = `${Math.round((musicTotal / grandTotal) * 100)}%`;
			barPlanner.style.width = `${Math.round((plannerTip / grandTotal) * 100)}%`;
			barOther.style.width = `${Math.round(((logisticsTotal + deliveryTotal) / grandTotal) * 100)}%`;
		}
	}

	// Listeners
	document.querySelectorAll('.tip-input, #chk-caterer-included').forEach(el => {
		el.addEventListener('input', calculateTips);
		el.addEventListener('change', calculateTips);
	});
	document.querySelectorAll('.tip-select, #currency-select').forEach(el => {
		el.addEventListener('change', calculateTips);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let rows = '';
		if (parseFloat(resCatererTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Servicepersonal & Gastronomie</strong></td><td>Ende der Feier</td><td>Trauzeuge / Koordinator</td><td style="text-align:right; font-weight:bold;">${resCatererTip.textContent}</td></tr>`;
		}
		if (parseFloat(resBeautyTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Brautstyling (Haare & Make-up)</strong></td><td>Nach Fertigstellung</td><td>Trauzeugin / Braut</td><td style="text-align:right; font-weight:bold;">${resBeautyTip.textContent}</td></tr>`;
		}
		if (parseFloat(selectPhotoLead.value) > 0) {
			rows += `<tr><td><strong>Hauptfotograf/in</strong></td><td>Bei Verabschiedung</td><td>Trauzeuge / Bräutigam</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPhotoLead.value)}</td></tr>`;
		}
		if (parseFloat(selectPhotoSecond.value) > 0) {
			rows += `<tr><td><strong>Zweitfotograf / Assistent</strong></td><td>Bei Verabschiedung</td><td>Trauzeuge</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPhotoSecond.value)}</td></tr>`;
		}
		if (parseFloat(selectDjTip.value) > 0) {
			rows += `<tr><td><strong>Hochzeits-DJ</strong></td><td>Ende der Musik</td><td>Trauzeuge</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectDjTip.value)}</td></tr>`;
		}
		if (parseFloat(selectPlannerTip.value) > 0) {
			rows += `<tr><td><strong>Wedding Planner / Koordinator</strong></td><td>Ende der Feier</td><td>Brautpaar</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPlannerTip.value)}</td></tr>`;
		}
		if (parseFloat(selectDriverTip.value) > 0) {
			rows += `<tr><td><strong>Chauffeur / Shuttle-Fahrer</strong></td><td>Nach letzter Fahrt</td><td>Trauzeuge</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectDriverTip.value)}</td></tr>`;
		}
		if (parseFloat(selectOfficiantTip.value) > 0) {
			rows += `<tr><td><strong>Trauredner / Standesamt</strong></td><td>Nach der Trauung</td><td>Trauzeuge</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectOfficiantTip.value)}</td></tr>`;
		}
		if (parseFloat(resDeliveryTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Floristik-Aufbau & Konditor</strong></td><td>Bei Lieferung</td><td>Koordinator / Trauzeuge</td><td style="text-align:right; font-weight:bold;">${resDeliveryTip.textContent}</td></tr>`;
		}

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Trinkgeld-Übergabeplan Dienstleister</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Offizielle Trinkgeld-Übersicht für Dienstleister</h1>
				<p>Erstellt am ${new Date().toLocaleDateString('de-DE')} | Benötigtes Bargeld: <strong>${resTotalGratuity.textContent}</strong> (${resEnvelopeCount.textContent})</p>
				
				<h3>Bargeld-Umschlag Übergabeplan:</h3>
				<table>
					<thead>
						<tr>
							<th>Dienstleister / Rolle</th>
							<th>Zeitpunkt der Übergabe</th>
							<th>Zuständige Person</th>
							<th style="text-align:right;">Bargeldbetrag</th>
						</tr>
					</thead>
					<tbody>
						${rows}
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;">
							<td colspan="3">Gesamtes Trinkgeldbudget</td>
							<td style="text-align:right; color:#b91c1c;">${resTotalGratuity.textContent}</td>
						</tr>
					</tbody>
				</table>

				<h3 style="margin-top:25px;">Hinweise zur Übergabe am Hochzeitstag:</h3>
				<p>• Umschläge 3–5 Tage vorher mit passendem Bargeld befüllen und beschriften.</p>
				<p>• Alle Umschläge am Vorabend an die Trauzeugen übergeben.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeit_Trinkgelder_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('de-DE');
		document.getElementById('print-total').textContent = resTotalGratuity.textContent;

		const tbody = document.getElementById('print-tipping-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Servicepersonal & Gastronomie</td><td style="border:1px solid #ccc; padding:6px;">Ende der Feier</td><td style="border:1px solid #ccc; padding:6px;">Trauzeuge / Koordinator</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resCatererTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Brautstyling (Haare & Make-up)</td><td style="border:1px solid #ccc; padding:6px;">Nach Fertigstellung</td><td style="border:1px solid #ccc; padding:6px;">Trauzeugin</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBeautyTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Foto- & Videoteam</td><td style="border:1px solid #ccc; padding:6px;">Bei Verabschiedung</td><td style="border:1px solid #ccc; padding:6px;">Trauzeuge</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPhotoTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">DJ & Live-Musiker</td><td style="border:1px solid #ccc; padding:6px;">Ende des Auftritts</td><td style="border:1px solid #ccc; padding:6px;">Trauzeuge</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDjTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Wedding Planner / Koordinator</td><td style="border:1px solid #ccc; padding:6px;">Ende der Feier</td><td style="border:1px solid #ccc; padding:6px;">Brautpaar</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPlannerTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Chauffeur & Trauredner</td><td style="border:1px solid #ccc; padding:6px;">Nach erbrachter Leistung</td><td style="border:1px solid #ccc; padding:6px;">Trauzeuge</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resLogisticsTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Floristik-Aufbau & Konditor</td><td style="border:1px solid #ccc; padding:6px;">Bei Anlieferung</td><td style="border:1px solid #ccc; padding:6px;">Koordinator</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDeliveryTip.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td colspan="3" style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Gesamtes Trinkgeld</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#b91c1c;">${resTotalGratuity.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Dienstleister,Zeitpunkt,Zustaendig,Betrag\n";
		csv += `"Servicepersonal & Gastronomie","Ende der Feier","Trauzeuge / Koordinator","${resCatererTip.textContent}"\n`;
		csv += `"Brautstyling","Nach Fertigstellung","Trauzeugin","${resBeautyTip.textContent}"\n`;
		csv += `"Foto- & Videoteam","Bei Verabschiedung","Trauzeuge","${resPhotoTip.textContent}"\n`;
		csv += `"DJ & Musiker","Ende des Auftritts","Trauzeuge","${resDjTip.textContent}"\n`;
		csv += `"Wedding Planner","Ende der Feier","Brautpaar","${resPlannerTip.textContent}"\n`;
		csv += `"Chauffeur & Trauredner","Nach Leistung","Trauzeuge","${resLogisticsTip.textContent}"\n`;
		csv += `"Floristik-Aufbau & Torte","Bei Anlieferung","Koordinator","${resDeliveryTip.textContent}"\n`;
		csv += `"Gesamtbetrag","--","--","${resTotalGratuity.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeit_Trinkgelder_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateTips();
</script>
