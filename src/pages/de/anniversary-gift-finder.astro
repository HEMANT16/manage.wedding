---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/anniversary-gift-finder/#webapp",
      "name": "Hochzeitstage & Jubiläumsgeschenke-Finder | Manage.Wedding",
      "url": "https://manage.wedding/de/anniversary-gift-finder",
      "inLanguage": "de",
      "description": "Kostenloser Hochzeitstage- & Geschenkefinder nach Jahren. Entdecken Sie traditionelle und moderne Hochzeitsjubiläen (Papier, Holz, Rosen, Silber, Gold, Diamant) mit personalisierten Geschenkideen & Textvorlagen.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Welche traditionellen Hochzeitstage gibt es nach Jahren?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die bekanntesten Jubiläen im deutschsprachigen Raum sind: 1 Jahr: Papierhochzeit, 2 Jahre: Baumwollhochzeit, 3 Jahre: Lederne Hochzeit, 5 Jahre: Hölzerne Hochzeit, 10 Jahre: Rosenhochzeit, 15 Jahre: Gläserne/Kristallhochzeit, 20 Jahre: Porzellanhochzeit, 25 Jahre: Silberhochzeit, 30 Jahre: Perlenhochzeit, 40 Jahre: Rubinhochzeit, 50 Jahre: Goldene Hochzeit und 60 Jahre: Diamantene Hochzeit."
          }
        },
        {
          "@type": "Question",
          "name": "Was schenkt man zur Papierhochzeit (1. Hochzeitstag)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zur Papierhochzeit sind gerahmte Eheversprechen, ein Fotobuch des ersten Ehejahres, Konzert- oder Flugtickets für eine Kurzreise oder ein personalisierter Sternenhimmel-Druck der Hochzeitsnacht besonders beliebt."
          }
        },
        {
          "@type": "Question",
          "name": "Kann man zum Hochzeitstag auch ein Erlebnis schenken?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, absolut! Gemeinsame Erlebnisse wie ein Wellnesswochenende, ein Kochkurs für Paare, eine Weinverkostung oder ein Städtetrip zählen heute zu den beliebtesten Geschenken unter Ehepaaren."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Wie findet man das perfekte Geschenk zum Hochzeitstag?",
      "description": "Schritt-für-Schritt-Anleitung zur Auswahl traditioneller und moderner Jubiläumsgeschenke passend zu Ehejahren und Budget.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Jubiläumsjahr auswählen oder berechnen",
          "text": "Wählen Sie Ihr Ehejahr (1. bis 60. Hochzeitstag) oder geben Sie Ihr Hochzeitsdatum ein, um die verstrichenen Jahre automatisch zu berechnen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Traditionelle & moderne Symbolik vergleichen",
          "text": "Entdecken Sie historische Bedeutungen (z. B. Papier für Jahr 1, Holz für Jahr 5, Silber für Jahr 25) und zeitgemäße Interpretationen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Symbolischen Edelstein & Blume entdecken",
          "text": "Erfahren Sie, welcher Edelstein und welche Blume traditionell zum jeweiligen Hochzeitstag gehören."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Geschenkideen nach Budget filtern",
          "text": "Wählen Sie aus romantischen Andenken, Kulinarik, Erlebnissen oder Wohnaccessoires passend zu Ihrem Budget."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 5: Vorschlag & Kartentext exportieren",
          "text": "Exportieren Sie Geschenkideen und gefühlvolle Textvorlagen für Ihre Glückwunschkarte nach Word (.doc) oder als PDF."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Hochzeitstage & Jubiläumsgeschenke-Finder | Traditionelle & moderne Geschenkideen"
	description="Kostenloser Hochzeitstage- & Geschenkefinder nach Jahren. Entdecken Sie traditionelle und moderne Hochzeitsjubiläen (Papier, Holz, Rosen, Silber, Gold, Diamant) mit personalisierten Geschenkideen & Textvorlagen."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Hochzeitstage & Jubiläumsgeschenke" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Hochzeitstage & <span class="accent-italic">Jubiläumsgeschenke-Finder</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Entdecken Sie traditionelle Symbole, Edelsteine, Blumen und <strong>maßgeschneiderte Geschenkideen</strong> für jeden Hochzeitstag vom 1. bis zum 60. Ehejahr!
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> In 3 Schritten zum passenden Jubiläumsgeschenk
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Jubiläumsjahr oder Datum wählen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Wählen Sie das Ehejahr (1., 5., 10., 25., 50. Jahr) oder tragen Sie Ihr Hochzeitsdatum zur automatischen Berechnung ein.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Stil & Budget anpassen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Wählen Sie die Vorlieben Ihres Partners (Romantik, Erlebnisse, Kulinarik, Wohnen) und Ihr geplantes Budget in Euro.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Ideen & Kartentexte ansehen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Erhalten Sie passende Geschenkempfehlungen und exportieren Sie Ihren Plan samt Glückwunsch-Text in Word oder PDF!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="gift-finder-grid">
			
			<!-- Left Column: Questionnaire -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🎁 Hochzeitstag-Auswahl & Filter
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Wählen Sie Ihr Jubiläum oder berechnen Sie es nach Datum
					</span>
				</div>

				<form id="gift-quiz-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- 1. Milestone Year Dropdown -->
					<div>
						<label for="select-anniversary-year" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--accent-red); margin-bottom: 0.25rem;">
							1. Hochzeitstag wählen *
						</label>
						<select id="select-anniversary-year" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-heading); font-size: 1.05rem; background: #fff;">
							<option value="1" selected>1. Jahr — Papierhochzeit (Modern: Uhren)</option>
							<option value="2">2. Jahr — Baumwollhochzeit (Modern: Porzellan)</option>
							<option value="3">3. Jahr — Lederne Hochzeit (Modern: Kristall / Glas)</option>
							<option value="4">4. Jahr — Seidene / Blumenhochzeit (Modern: Elektrogeräte)</option>
							<option value="5">5. Jahr — Hölzerne Hochzeit (Modern: Besteck)</option>
							<option value="6">6. Jahr — Zinnerne / Zuckerhochzeit (Modern: Holzobjekte)</option>
							<option value="7">7. Jahr — Kupferne Hochzeit (Modern: Schreibtisch-Sets)</option>
							<option value="8">8. Jahr — Blecherne Hochzeit (Modern: Bettwäsche / Spitze)</option>
							<option value="9">9. Jahr — Keramikhochzeit (Modern: Lederwaren)</option>
							<option value="10">10. Jahr — Rosenhochzeit (Modern: Diamantschmuck)</option>
							<option value="11">11. Jahr — Stählerne Hochzeit</option>
							<option value="12">12. Jahr — Seidenhochzeit / Nickelhochzeit</option>
							<option value="13">13. Jahr — Spitzenhochzeit</option>
							<option value="14">14. Jahr — Elfenbeinhochzeit</option>
							<option value="15">15. Jahr — Gläserne / Kristallhochzeit (Modern: Uhren)</option>
							<option value="20">20. Jahr — Porzellanhochzeit (Modern: Platin)</option>
							<option value="25">25. Jahr — Silberhochzeit (Silbernes Jubiläum)</option>
							<option value="30">30. Jahr — Perlenhochzeit (Modern: Diamant)</option>
							<option value="35">35. Jahr — Leinwandhochzeit</option>
							<option value="40">40. Jahr — Rubinhochzeit (Rubin-Jubiläum)</option>
							<option value="45">45. Jahr — Saphirhochzeit</option>
							<option value="50">50. Jahr — Goldene Hochzeit (Goldenes Jubiläum)</option>
							<option value="55">55. Jahr — Smaragdhochzeit</option>
							<option value="60">60. Jahr — Diamantene Hochzeit (Diamantenes Jubiläum)</option>
						</select>
					</div>

					<!-- Optional Date Calculator Accordion -->
					<details style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<summary style="font-size: 0.88rem; font-family: var(--font-heading); color: var(--accent-blue); cursor: pointer;">
							📅 Oder automatisch nach Hochzeitsdatum berechnen
						</summary>
						<div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.3rem;">
							<span style="font-size: 0.78rem; color: var(--text-secondary);">Datum Ihrer Eheschließung:</span>
							<input type="date" id="input-wedding-date" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</details>

					<!-- 2. Partner's Personality Vibe -->
					<div>
						<label for="select-partner-vibe" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							2. Vorlieben & Persönlichkeit des Partners
						</label>
						<select id="select-partner-vibe" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="sentimental" selected>💖 Emotional & Romantisch (Fotobücher, Gravuren, Ehegelübde)</option>
							<option value="experiences">✈️ Erlebnisse & Reisen (Wellness-Wochenende, Städtetrip, Kurzurlaub)</option>
							<option value="foodie">🍷 Kulinarik & Genuss (Wein-Abo, Gourmet-Dinner, Kochkurs)</option>
							<option value="practical">⚡ Praktisch & Zeitlos (Uhren, Schmuck, hochwertige Haushaltshelfer)</option>
							<option value="home">🏡 Gemütliches Zuhause (Wohnaccessoires, Decken, Deko)</option>
						</select>
					</div>

					<!-- 3. Target Budget & Recipient -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="select-gift-budget" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								3. Budget-Rahmen
							</label>
							<select id="select-gift-budget" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="under50">Unter 50 € (Kleine Aufmerksamkeit)</option>
								<option value="50to150" selected>50 € – 150 € (Klassischer Rahmen)</option>
								<option value="150to300">150 € – 300 € (Besonderes Andenken)</option>
								<option value="300plus">300 €+ (Großes Jubiläum & Schmuck)</option>
							</select>
						</div>

						<div>
							<label for="select-recipient" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								4. Geschenk für
							</label>
							<select id="select-recipient" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="couple" selected>Uns beide (Gemeinsam)</option>
								<option value="her">Für Sie (Ehefrau / Partnerin)</option>
								<option value="him">Für Ihn (Ehemann / Partner)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Themes & Curated Gift Stream -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Theme Overview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🎉 <span id="res-year-title">1. Hochzeitstag (Papierhochzeit)</span>
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Traditionelle & moderne Jubiläumssymbole
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Word-Vorschlag (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ PDF / Drucken
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Dual Themes Comparison Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
						<div style="background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-red); font-weight: bold; display: block;">
								Traditionell
							</span>
							<strong id="theme-traditional-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Papier
							</strong>
							<p id="theme-traditional-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Symbol für die noch unbeschriebenen Seiten Ihrer gemeinsamen Zukunft.
							</p>
						</div>

						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-blue); font-weight: bold; display: block;">
								Modern
							</span>
							<strong id="theme-modern-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Uhren
							</strong>
							<p id="theme-modern-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Symbol für die kostbare Zeit und die gemeinsamen Stunden.
							</p>
						</div>
					</div>

					<!-- Gemstone & Flower Sub-Themes -->
					<div style="display: flex; justify-content: space-around; font-size: 0.85rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.5rem; margin-bottom: 1.25rem;">
						<span>💎 Edelstein: <strong id="theme-gemstone">Goldschmuck / Peridot</strong></span>
						<span>🌸 Blume: <strong id="theme-flower">Nelke</strong></span>
					</div>

					<!-- 60-Year Milestone Progress Gauge -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.25rem;">
							<span>Jahr 1 (Papier)</span>
							<span>Jahr 25 (Silber)</span>
							<span>Jahr 50 (Gold)</span>
							<span>Jahr 60 (Diamant)</span>
						</div>
						<div style="width: 100%; height: 16px; border: 1.5px solid var(--fg-pencil); border-radius: 8px; overflow: hidden; background: #eee;">
							<div id="gauge-milestone-bar" style="width: 5%; height: 100%; background: var(--accent-red); transition: width 0.4s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Curated Gift Recommendations Stream -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						🛍️ Ausgewählte Geschenk- & Erlebnisideen
					</h3>
					<div id="curated-gifts-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<!-- Injected via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Hochzeitstag-Geschenkefinder & Vorschlag</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exportiert am: <span id="print-date"></span> | Jubiläum: <span id="print-milestone"></span></p>
			</div>
			<div id="print-content-body"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Auf einen Blick (BLUF)</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Die wichtigsten Hochzeitstage & Bedeutungen
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>Die Grundregel:</strong> Traditionelle Hochzeitstage spiegeln die wachsende Festigkeit der Ehe wider: von zarten Anfängen (<strong>1. Jahr Papier</strong>, <strong>2. Jahr Baumwolle</strong>, <strong>3. Jahr Leder</strong>) über feste Beständigkeit (<strong>5. Jahr Holz</strong>, <strong>10. Jahr Rosen</strong>) bis hin zu edlen Metallen (<strong>25. Jahr Silber</strong>, <strong>50. Jahr Gold</strong>).
			</p>
			
			<!-- Benchmark Anniversary Milestones Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Jubiläum</th>
