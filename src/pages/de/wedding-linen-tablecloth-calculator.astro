---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Tischdecken-Größen & Hochzeits-Wäsche Rechner",
      "url": "https://manage.wedding/de/wedding-linen-tablecloth-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Berechnen Sie die exakten Tischdeckenmaße für runde Tische, Banketttische und Stehtische für einen bodenlangen Fall und vergleichen Sie Miete vs. Kauf.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Tischdecken-Größen & Wäsche-Rechner — Bodenlanger Fall"
	description="Berechnen Sie die perfekte Tischdeckengröße für runde Tische, Biertische, Servietten, Tischläufer und vergleichen Sie Miete gegenüber Kauf."
	lang="de"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/de/" style="color: var(--text-secondary); text-decoration: none;">Startseite</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/de/dining" style="color: var(--text-secondary); text-decoration: none;">Essen & Dekoration</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Tischdecken-Rechner</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🧺</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Tischmaße & Mietwäsche-Bedarfsrechner</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Tischdecken-Größen & Wäsche-Rechner
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Ermitteln Sie die <strong>exakten Tischdeckenmaße</strong> für jede Tischform, garantieren Sie einen eleganten bodenlangen Fall, berechnen Sie Servietten und vergleichen Sie <strong>Miete gegenüber Kauf</strong>.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Inputs -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>📐</span> 1. Gästetische Konfiguration
				</h2>

				<div style="margin-bottom: 1rem;">
					<label for="select-table-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Tischform & Größe:</label>
					<select id="select-table-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="round-60" selected>⚪ Rund 150 cm / 60" (8 Personen — Standardhöhe 75 cm)</option>
						<option value="round-72">⚪ Rund 180 cm / 72" (10-12 Personen — Höhe 75 cm)</option>
						<option value="round-48">⚪ Rund 120 cm / 48" (6 Personen / Torte)</option>
						<option value="rect-8ft">📏 Rechteckig 240 x 75 cm / 8 ft Bankett</option>
						<option value="rect-6ft">📏 Rechteckig 180 x 75 cm / 6 ft Bankett</option>
						<option value="highboy-30">🍸 Stehtisch 80 cm (110 cm Stehhöhe)</option>
					</select>
				</div>

				<div style="margin-bottom: 1rem;">
					<label for="select-drop-style" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Überhang / Fall der Decke:</label>
					<select id="select-drop-style" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="floor" selected>✨ Bodenlang (Hochzeits-Standard — 75 cm Fall bis zum Boden)</option>
						<option value="lap">🪑 Knielang / Lässig (35-40 cm Überhang)</option>
						<option value="puddle">👑 Boden-Drapierung / Puddle (+8 cm aufliegend)</option>
					</select>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-table-count" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Anzahl Gästetische:</label>
						<input type="number" id="input-table-count" min="1" max="100" value="15" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="input-guests-count" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Gästezahl (für Servietten):</label>
						<input type="number" id="input-guests-count" min="10" max="600" value="120" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🏷️ 2. Brauttisch & Servicetische
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
					<div>
						<label for="input-head-tables" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Brauttisch / Sweetheart:</label>
						<input type="number" id="input-head-tables" min="0" max="10" value="2" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="input-cocktail-tables" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Stehtische Empfang:</label>
						<input type="number" id="input-cocktail-tables" min="0" max="25" value="6" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="input-service-tables" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Torte / DJ / Geschenke:</label>
						<input type="number" id="input-service-tables" min="0" max="15" value="4" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="select-pricing-mode" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Kostenvergleich:</label>
						<select id="select-pricing-mode" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="both" selected>Miete vs. Kauf vergleichen</option>
							<option value="rent">Nur Miete (16 €/Decke)</option>
							<option value="buy">Nur Kauf (10 €/Decke)</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Exakte Maße</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Empfohlene Deckengröße
						</h2>
					</div>
					<span id="badge-drop-tag" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">Bodenlanger Fall</span>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Gästetisch-Decke</span>
						<strong id="stat-linen-dimension" style="font-size: 1.7rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">300 cm Rund</strong>
						<span id="stat-linen-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(75 cm Fall bis zum Boden)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Gesamtdecken</span>
						<strong id="stat-total-linens" style="font-size: 1.7rem; font-weight: 900; color: #1e40af; line-height: 1.1;">27 Tischdecken</strong>
						<span id="stat-tables-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">Über alle Tische</span>
					</div>
				</div>

				<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #166534; display: block; margin-bottom: 0.35rem;">✨ Servietten und Tischläufer:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #14532d;">
						<div>• <strong id="stat-napkins-count">138 Servietten</strong> (+15% Reserve)</div>
						<div>• <strong id="stat-runner-length">Läufer 270 cm</strong> (30 cm Überhang)</div>
						<div>• <strong id="stat-highboy-linens">6 x 300 cm</strong> Stehtisch-Hussen</div>
						<div>• <strong id="stat-banquet-linens">6 x 230x390 cm</strong> Bankettdecken</div>
					</div>
				</div>

				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🏷️ Mietkosten Schätzung:</span>
						<strong id="stat-rent-cost" style="color: #b91c1c;">486 € (Inkl. Wäsche & Bügeln)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🛒 Kaufkosten Schätzung:</span>
						<strong id="stat-buy-cost" style="color: #1e40af;">297 € (Großhandel)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">💡 Fazit:</span>
						<strong id="stat-verdict" style="color: #15803d;">Kauf spart 189 € (Bügelaufwand nötig)</strong>
					</div>
				</div>

				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Bestellplan drucken (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Word (.doc) exportieren
					</button>
				</div>
			</div>

		</div>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/de/wedding-linen-tablecloth-calculator" category="dining" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-linen-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Hochzeits-Tischdecken & Wäsche Bestellplan</h1>
				<p id="print-linen-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Mietwäsche-Spezifikation | Manage.Wedding</p>
			</div>
			<div id="print-linen-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const selectTableType = document.getElementById('select-table-type');
	const selectDropStyle = document.getElementById('select-drop-style');
	const inputTableCount = document.getElementById('input-table-count');
	const inputGuestsCount = document.getElementById('input-guests-count');
	const inputHeadTables = document.getElementById('input-head-tables');
	const inputCocktailTables = document.getElementById('input-cocktail-tables');
	const inputServiceTables = document.getElementById('input-service-tables');

	const statLinenDimension = document.getElementById('stat-linen-dimension');
	const statLinenSub = document.getElementById('stat-linen-sub');
	const statTotalLinens = document.getElementById('stat-total-linens');
	const badgeDropTag = document.getElementById('badge-drop-tag');

	const statNapkinsCount = document.getElementById('stat-napkins-count');
	const statRunnerLength = document.getElementById('stat-runner-length');
	const statHighboyLinens = document.getElementById('stat-highboy-linens');
	const statBanquetLinens = document.getElementById('stat-banquet-linens');

	const statRentCost = document.getElementById('stat-rent-cost');
	const statBuyCost = document.getElementById('stat-buy-cost');
	const statVerdict = document.getElementById('stat-verdict');

	function calculateLinens() {
		const tableType = selectTableType.value;
		const dropStyle = selectDropStyle.value;
		const guestTables = parseInt(inputTableCount.value, 10) || 15;
		const guests = parseInt(inputGuestsCount.value, 10) || 120;
		const headTables = parseInt(inputHeadTables.value, 10) || 2;
		const cocktailTables = parseInt(inputCocktailTables.value, 10) || 6;
		const serviceTables = parseInt(inputServiceTables.value, 10) || 4;

		let dimension = '300 cm Rund (120")';
		let subText = '75 cm Fall bis zum Boden';
		let runnerLen = 'Läufer 270 cm';

		if (tableType === 'round-60') {
			if (dropStyle === 'floor') { dimension = '300 cm Rund (120")'; subText = 'Exakter 75 cm Bodenfall'; }
			else if (dropStyle === 'lap') { dimension = '230 cm Rund (90")'; subText = 'Knielanger 40 cm Fall'; }
			else { dimension = '335 cm Rund (132")'; subText = 'Bodendrapierung'; }
			runnerLen = 'Läufer 270 cm';
		} else if (tableType === 'round-72') {
			if (dropStyle === 'floor') { dimension = '335 cm Rund (132")'; subText = 'Exakter 75 cm Bodenfall'; }
			else if (dropStyle === 'lap') { dimension = '275 cm Rund (108")'; subText = '45 cm Fall'; }
			else { dimension = '365 cm Rund'; subText = 'Bodendrapierung'; }
			runnerLen = 'Läufer 300 cm';
		} else if (tableType === 'round-48') {
			if (dropStyle === 'floor') { dimension = '275 cm Rund (108")'; subText = 'Exakter 75 cm Bodenfall'; }
			else if (dropStyle === 'lap') { dimension = '230 cm Rund (90")'; subText = 'Knielanger Fall'; }
			else { dimension = '300 cm Rund'; subText = 'Bodendrapierung'; }
			runnerLen = 'Läufer 230 cm';
		} else if (tableType === 'rect-8ft') {
			if (dropStyle === 'floor') { dimension = '230 x 390 cm (90x156")'; subText = 'Bodenlang 4-seitig'; }
			else if (dropStyle === 'lap') { dimension = '150 x 320 cm'; subText = '38 cm Seitenfall'; }
			else { dimension = '275 x 390 cm'; subText = 'Tiefer Fall'; }
			runnerLen = 'Läufer 300 cm';
		} else if (tableType === 'rect-6ft') {
			if (dropStyle === 'floor') { dimension = '230 x 335 cm (90x132")'; subText = 'Bodenlang 4-seitig'; }
			else if (dropStyle === 'lap') { dimension = '150 x 260 cm'; subText = 'Seitlicher Fall'; }
			else { dimension = '230 x 390 cm'; subText = 'Bodendrapierung'; }
			runnerLen = 'Läufer 240 cm';
		} else if (tableType === 'highboy-30') {
			if (dropStyle === 'floor') { dimension = '300 cm Rund (120")'; subText = '110 cm Stehhöhe'; }
			else { dimension = '335 cm Rund'; subText = 'Mit Schleifenband'; }
			runnerLen = 'Ohne Läufer (Schleife)';
		}

		statLinenDimension.textContent = dimension;
		statLinenSub.textContent = `(${subText})`;

		const totalLinens = guestTables + headTables + cocktailTables + serviceTables;
		statTotalLinens.textContent = `${totalLinens} Tischdecken`;

		const totalNapkins = Math.round(guests * 1.15);
		statNapkinsCount.textContent = `${totalNapkins} Servietten`;
		statRunnerLength.textContent = runnerLen;
		statHighboyLinens.textContent = `${cocktailTables} x 300 cm Stehtische`;
		statBanquetLinens.textContent = `${headTables + serviceTables} x 230x390 cm Bankettdecken`;

		const avgRentRate = 18;
		const avgBuyRate = 11;
		const totalRent = totalLinens * avgRentRate + totalNapkins * 0.75;
		const totalBuy = totalLinens * avgBuyRate + totalNapkins * 0.45;
		const diff = totalRent - totalBuy;

		statRentCost.textContent = `${Math.round(totalRent)} € (Inkl. Wäsche & Bügeln)`;
		statBuyCost.textContent = `${Math.round(totalBuy)} € (Großhandel)`;
		statVerdict.textContent = `Kauf spart ${Math.round(diff)} € (Bügelaufwand nötig)`;

		document.getElementById('print-linen-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Tischtyp</th>
						<th style="padding:6pt;">Tischmaße</th>
						<th style="padding:6pt;">Deckengröße</th>
						<th style="padding:6pt; text-align:right;">Menge</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Gästetische</td>
						<td style="padding:6pt;">${selectTableType.options[selectTableType.selectedIndex].text}</td>
						<td style="padding:6pt; font-weight:bold; color:#b91c1c;">${dimension}</td>
						<td style="padding:6pt; text-align:right;"><strong>${guestTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Brauttisch</td>
						<td style="padding:6pt;">Rechteckig 240 x 75 cm</td>
						<td style="padding:6pt;">230 x 390 cm Rechteckig</td>
						<td style="padding:6pt; text-align:right;"><strong>${headTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Stehtische</td>
						<td style="padding:6pt;">80 cm Durchm. x 110 cm Höhe</td>
						<td style="padding:6pt;">300 cm Rund (mit Schleife)</td>
						<td style="padding:6pt; text-align:right;"><strong>${cocktailTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Nebentische (Torte/DJ)</td>
						<td style="padding:6pt;">Bankett 180 / 240 cm</td>
						<td style="padding:6pt;">230 x 335 / 230 x 390 cm</td>
						<td style="padding:6pt; text-align:right;"><strong>${serviceTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Stoffservietten</td>
						<td style="padding:6pt;">50 x 50 cm Baumwolle/Polyester</td>
						<td style="padding:6pt;">Faltung / Knoten</td>
						<td style="padding:6pt; text-align:right; font-weight:bold; color:#166534;"><strong>${totalNapkins}</strong></td>
					</tr>
					<tr style="background:#eff6ff; font-weight:bold; font-size:11pt; border-top:2pt solid #000;">
						<td style="padding:8pt;">GESAMTDECKEN</td>
						<td style="padding:8pt;">Alle Tische zusammen</td>
						<td style="padding:8pt;">Bodenlanger Fall</td>
						<td style="padding:8pt; text-align:right; color:#b91c1c;">${totalLinens} Decken</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	[selectTableType, selectDropStyle, inputTableCount, inputGuestsCount, inputHeadTables, inputCocktailTables, inputServiceTables].forEach(el => {
		el.addEventListener('input', calculateLinens);
		el.addEventListener('change', calculateLinens);
	});

	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateLinens();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateLinens();
		const dimension = statLinenDimension.textContent;
		const totalLinens = statTotalLinens.textContent;
		const napkins = statNapkinsCount.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Tischdecken Bestellung</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Hochzeits-Tischdecken & Wäsche Bestellung</h1>
				<p><strong>Gästetisch-Decke:</strong> ${dimension} | <strong>Gesamtdecken:</strong> ${totalLinens} | <strong>Servietten:</strong> ${napkins}</p>
				<hr/>
				<p><em>Erstellt von Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Tischdecken-Hochzeit-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateLinens();
</script>
