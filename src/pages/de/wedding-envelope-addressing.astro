---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-envelope-addressing/#webapp",
      "name": "Hochzeits-Umschlagbeschriftung & Adressierungs-Knigge | Manage.Wedding",
      "url": "https://manage.wedding/de/wedding-envelope-addressing",
      "inLanguage": "de",
      "description": "Kostenloser Generator für die Beschriftung von Hochzeitseinladungen nach Knigge. Formatiert DIN C5, C6 und DIN-Lang-Umschläge mit akademischen Titeln, unverheirateten Paaren, Begleitungen und Familien. Export nach PDF, Word und CSV.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie beschriftet man Hochzeitseinladungs-Umschläge stilvoll nach Knigge?",
      "description": "Schritt-für-Schritt-Anleitung zur korrekten Adressierung von Briefumschlägen für Ehepaare, Doktoren, unverheiratete Paare und Familien.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Umschlaggröße (DIN C5, C6 oder DIN lang) wählen",
          "text": "Wählen Sie DIN C5 (162 × 229 mm) für DIN-A5-Karten, DIN C6 (114 × 162 mm) für DIN-A6-Karten oder DIN lang für schlanke Hochformate."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Knigge-konforme Anrede anwenden",
          "text": "Wählen Sie die passende Höflichkeitsformel (z. B. Eheleute, Frau Dr. und Herr, zweizeilig bei getrennten Nachnamen oder mit namentlicher Nennung der Kinder)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Straßenname & Hausnummer ausschreiben",
          "text": "Traditioneller Hochzeitsknigge empfiehlt das Ausschreiben von Straßenbezeichnungen (z. B. 'Schlossallee 12' statt Abkürzungen)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Absenderadresse platzieren",
          "text": "Drucken Sie Ihre Absenderadresse zentriert auf die Rückseitenklappe des Umschlags oder dezent oben links auf der Vorderseite."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie adressiert man eine Hochzeitseinladung an ein unverheiratetes Paar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei unverheirateten Paaren im gemeinsamen Haushalt werden beide Namen in zwei getrennten Zeilen aufgeführt (z. B. Zeile 1: 'Frau Sophie Wagner', Zeile 2: 'Herr Maximilian Weber'), alphabetisch sortiert nach dem Nachnamen."
          }
        },
        {
          "@type": "Question",
          "name": "Wie schreibt man akademische Titel (Dr. / Professor) auf den Umschlag?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Akademische Grade werden direkt vor den Namen gesetzt: z. B. 'Frau Dr. med. Sophie Weber und Herr Maximilian Weber'. Wenn beide promoviert sind: 'Frau Dr. Sophie Weber und Herr Dr. Maximilian Weber' oder 'Familie Dres. Weber'."
          }
        },
        {
          "@type": "Question",
          "name": "Wie formuliert man eine Einladung mit Begleitung (+1)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wenn der Name der Begleitung bekannt ist, sollte er immer voll ausgeschrieben werden (z. B. 'Herr Tobias Wagner und Frau Lena Schulz'). Ist der Name unbekannt, schreibt man 'Herr Tobias Wagner und Begleitung'."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Umschlag-Beschriftungsstudio Hochzeit | Adressierungs-Knigge & Druck"
	description="Kostenloser Adressierungs-Generator für Hochzeitseinladungen. Knigge-konforme Anreden (Ehepaare, Doktoren, Familien, Begleitung), DIN C5/C6/DL Umschläge und Etiketten drucken (PDF, Word, CSV)."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Umschlag-Beschriftung & Knigge" category="stationery-creative" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Knigge & Druckstudio</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Umschlag-Beschriftung <span class="accent-italic">& Adressierungs-Knigge</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 700px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Stilvolle Anreden für Ehepaare, Doktoren, Patchwork-Familien und Begleitungen. Vorschau in modernen Kalligraphie-Schriften und 1-Klick-Druck nach PDF und Word.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Controls & Formatter Input -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Umschlag-Format & Anrede
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						DIN-Normen
					</span>
				</div>

				<!-- Envelope Size Selector -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="env-size" style="font-weight: 700; font-size: 0.95rem;">Umschlag-Format</label>
					<select id="env-size" class="form-input" style="cursor: pointer; width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;">
						<option value="a7" selected>DIN C5 Umschlag (162 × 229 mm — für DIN A5 Einladungen)</option>
						<option value="a2">DIN C6 Umschlag (114 × 162 mm — für DIN A6 / RSVP)</option>
						<option value="dl">DIN Lang Umschlag (110 × 220 mm — für schmale Karten)</option>
						<option value="square">Quadratischer Umschlag (155 × 155 mm — Großbrief)</option>
						<option value="inner">Pocketfold / Innenumschlag (Namenszeile ohne Adresse)</option>
					</select>
				</div>

				<!-- Etiquette Preset Quick-Pick -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="etiquette-preset" style="font-weight: 700; font-size: 0.95rem;">
						Knigge-Anrede-Vorlage
					</label>
					<select id="etiquette-preset" class="form-input" style="background: #f8fafc; font-weight: 600; cursor: pointer; width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;">
						<option value="married-same" selected>👫 Ehepaar (gleicher Nachname) — z. B. Eheleute Maximilian und Sophie Weber</option>
						<option value="married-modern">👫 Ehepaar (modern) — z. B. Sophie und Maximilian Weber</option>
						<option value="married-diff">👫 Ehepaar (unterschiedliche Nachnamen) — z. B. Sophie Wagner & Maximilian Weber</option>
						<option value="doctor-wife">🩺 Akademischer Titel (Frau ist Doktor) — z. B. Frau Dr. Sophie Weber & Herr Maximilian Weber</option>
						<option value="doctor-both">🩺 Beide sind Doktoren — z. B. Frau Dr. Sophie Weber & Herr Dr. Maximilian Weber</option>
						<option value="unmarried">💑 Unverheiratetes Paar (Zweizeilig) — z. B. Frau Sophie Wagner / Herr Maximilian Weber</option>
						<option value="single-guest">👤 Einzelgast mit Begleitung — z. B. Herr Tobias Wagner und Begleitung</option>
						<option value="family">👨‍👩‍👧‍👦 Familie mit Kindern — z. B. Familie Weber mit Felix und Lena</option>
						<option value="custom">✏️ Eigene manuelle Eingabe</option>
					</select>
				</div>

				<!-- Recipient Name Line 1 -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="rec-name-1" style="font-weight: 700; font-size: 0.95rem;">Empfängername(n) — Zeile 1</label>
					<input type="text" id="rec-name-1" class="form-input" value="Eheleute Maximilian und Sophie Weber" placeholder="z. B. Eheleute Maximilian und Sophie Weber" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
				</div>

				<!-- Recipient Name Line 2 (Optional for unmarried/plus-ones) -->
				<div class="form-group" id="rec-name-2-group" style="display: none; margin-bottom: 1.25rem;">
					<label class="form-label" for="rec-name-2" style="font-weight: 700; font-size: 0.95rem;">Empfängername (Zeile 2 — Optional)</label>
					<input type="text" id="rec-name-2" class="form-input" value="" placeholder="z. B. Herr Maximilian Weber" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
				</div>

				<!-- Street Address -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="rec-street" style="font-weight: 700; font-size: 0.95rem;">Straße & Hausnummer</label>
					<input type="text" id="rec-street" class="form-input" value="Schlossallee 12" placeholder="z. B. Schlossallee 12" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
				</div>

				<!-- City, State & Zip -->
				<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 0.75rem; margin-bottom: 1.25rem;" class="form-group">
					<div>
						<label class="form-label" for="rec-zip" style="font-weight: 700; font-size: 0.95rem;">PLZ</label>
						<input type="text" id="rec-zip" class="form-input" value="82319" placeholder="PLZ" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
					</div>
					<div>
						<label class="form-label" for="rec-city" style="font-weight: 700; font-size: 0.95rem;">Wohnort</label>
						<input type="text" id="rec-city" class="form-input" value="Starnberg" placeholder="Ort" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
					</div>
				</div>

				<!-- Return Address Toggle & Inputs -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.75rem;">
						<input type="checkbox" id="toggle-return-addr" checked style="width: 18px; height: 18px;" />
						<span>Absenderadresse aufdrucken</span>
					</label>

					<div id="return-addr-fields">
						<div class="form-group" style="margin-bottom: 0.75rem;">
							<label class="form-label" for="ret-names" style="font-size: 0.95rem;">Namen des Brautpaars (Absender)</label>
							<input type="text" id="ret-names" class="form-input" value="Sophie & Maximilian" style="font-size: 0.95rem; padding: 0.55rem; width: 100%; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
						</div>
						<div class="form-group">
							<label class="form-label" for="ret-street" style="font-size: 0.95rem;">Absender Straße, PLZ & Ort</label>
							<input type="text" id="ret-street" class="form-input" value="Rosenweg 4, 80331 München" style="font-size: 0.95rem; padding: 0.55rem; width: 100%; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
						</div>
					</div>
				</div>

				<!-- Style Customization -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label class="form-label" style="font-weight: 700; margin-bottom: 0.5rem; display: block;">Schriftart & Kalligraphie-Stil</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="font-style-btn hand-btn is-active" data-font="script" style="padding: 8px; font-size: 0.9rem; font-family: 'Kalam', cursive;">
							✒️ Moderne Kalligraphie
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="serif" style="padding: 8px; font-size: 0.9rem; font-family: Georgia, serif;">
							🏛️ Klassische Antiqua
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="sans" style="padding: 8px; font-size: 0.9rem; font-family: var(--font-body);">
							✨ Klare Moderne Sans
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="hand" style="padding: 8px; font-size: 0.9rem; font-family: 'Caveat', cursive;">
							✏️ Handgeschrieben
						</button>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Envelope Visual Canvas & Batch Export -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Canvas Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Live-Umschlagvorschau
						</h3>
						<span id="env-size-tag" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							DIN C5: 162 × 229 mm
						</span>
					</div>

					<!-- The Realistic Envelope Box -->
					<div id="envelope-canvas" style="width: 100%; aspect-ratio: 229 / 162; background: #fffcf5; border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 6px 6px 0px var(--fg-pencil); position: relative; padding: clamp(1rem, 3vw, 2rem); display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; transition: all 0.2s ease;">
						
						<!-- Return Address on Front Top-Left -->
						<div id="canvas-return-addr" style="position: absolute; top: clamp(0.75rem, 2vw, 1.25rem); left: clamp(0.75rem, 2vw, 1.25rem); font-size: clamp(0.68rem, 1.2vw, 0.82rem); line-height: 1.35; color: var(--fg-pencil); max-width: 45%;">
							<strong id="canvas-ret-name" style="display: block;">Sophie & Maximilian</strong>
							<span id="canvas-ret-full">Rosenweg 4<br/>80331 München</span>
						</div>

						<!-- Postage Stamp Placeholder Stamp Outline -->
						<div style="position: absolute; top: clamp(0.75rem, 2vw, 1.25rem); right: clamp(0.75rem, 2vw, 1.25rem); width: clamp(40px, 7vw, 55px); height: clamp(50px, 8.5vw, 68px); border: 1.5px dashed #94a3b8; border-radius: 3px; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; color: #94a3b8; text-align: center; text-transform: uppercase; font-weight: 700; padding: 2px;">
							Briefmarke
						</div>

						<!-- Main Recipient Address Block (Centered) -->
						<div id="canvas-recipient-block" style="text-align: center; margin-top: clamp(1rem, 2.5vw, 2rem);">
							<div id="canvas-rec-name-1" style="font-size: clamp(1.2rem, 2.5vw, 1.85rem); font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem; line-height: 1.25;">
								Eheleute Maximilian und Sophie Weber
							</div>
							<div id="canvas-rec-name-2" style="font-size: clamp(1.1rem, 2.2vw, 1.65rem); font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem; display: none; line-height: 1.25;"></div>
							<div id="canvas-rec-street" style="font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: #334155; margin-bottom: 0.2rem; line-height: 1.4;">
								Schlossallee 12
							</div>
							<div id="canvas-rec-city-state-zip" style="font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: #334155; line-height: 1.4;">
								82319 Starnberg
							</div>
						</div>

					</div>

					<!-- Quick Formatting Audit Checklist -->
					<div style="margin-top: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<strong style="font-size: 0.95rem; display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">
							✅ Knigge- & Post-Konformitätscheck:
						</strong>
						<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
							<li>Straßenbezeichnungen vollständig ausgeschrieben.</li>
							<li>DIN-Norm-Umschlag passend zur Einladungskartengröße.</li>
							<li>Akademische und persönliche Anreden nach traditionellem Knigge formatiert.</li>
						</ul>
					</div>

					<!-- Export Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-envelope" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Umschläge drucken (PDF)
						</button>
						<button id="btn-export-word" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Word-Export (.doc)
						</button>
					</div>

				</div>

				<!-- Batch Guest List Address Importer -->
				<div class="hand-card" style="padding: 1.75rem; background: var(--bg-paper);">
					<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
						Adress-Sammelimport (CSV / Text einfügen)
					</h3>
					<p style="font-size: 0.92rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
						Fügen Sie mehrere Adressen ein (eine pro Zeile: <em>Name, Straße & Nr, PLZ, Ort</em>) für den Sammeldruck.
					</p>

					<textarea id="batch-paste-input" rows="4" class="hand-input" style="font-size: 0.88rem; line-height: 1.4; margin-bottom: 0.75rem; width: 100%; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem;" placeholder="Eheleute Maximilian und Sophie Weber, Schlossallee 12, 82319, Starnberg&#10;Dr. Thomas Meyer, Goethestr. 45, 80336, München&#10;Tobias Wagner und Begleitung, Hauptstr. 8, 86150, Augsburg"></textarea>

					<div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
						<button id="btn-load-batch" class="hand-btn" style="padding: 8px 16px; font-size: 0.9rem;">
							Adressen laden
						</button>
						<span id="batch-count-tag" style="font-size: 0.85rem; font-weight: 700; color: #64748b;">1 Adresse aktiv</span>
					</div>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Auf einen Blick (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Adressierungs-Knigge & Titel-Hierarchien
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Hier ist die Übersicht zur korrekten Formulierung auf Umschlägen und Einladungskarten.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 Die goldenen Knigge-Regeln für Briefumschläge:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					1. Verheiratet gleicher Name: "Eheleute Vorname und Vorname Nachname" • 2. Akademische Grade stehen immer direkt vor dem Namen • 3. Unverheiratete Paare werden auf zwei separaten Zeilen aufgeführt • 4. Begleitungen nach Möglichkeit mit vollem Namen nennen.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Gästekonstellation</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Knigge-Anrede auf dem Umschlag</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Wichtige Knigge-Regel</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Ehepaar (gleicher Nachname)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Eheleute Maximilian und Sophie Weber<br><span style="font-size: 0.8rem; color: #64748b;">(oder Sophie und Maximilian Weber)</span></td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Traditionell "Eheleute" oder modern beide Vornamen</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Ehepaar (getrennte Nachnamen)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Frau Sophie Wagner und Herr Maximilian Weber</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Mit "und" verbunden oder auf zwei Zeilen aufgeteilt</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Akademischer Titel (Doktor)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Frau Dr. Sophie Weber und Herr Maximilian Weber</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Akademischer Grad steht direkt vor dem betreffenden Namen</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Unverheiratetes Paar</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Frau Sophie Wagner<br>Herr Maximilian Weber</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Zweizeilig, alphabetisch nach Nachnamen sortiert</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #d97706);">Einzelgast mit Begleitung</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Herr Tobias Wagner und Begleitung</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Echten Namen erfragen oder "und Begleitung" nutzen</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #0284c7);">Familie mit Kindern</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Familie Weber mit Felix und Lena</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Vornamen der Kinder signalisieren, dass sie eingeladen sind</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Der Leitfaden zur perfekten Umschlagbeschriftung
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Schriftarten, Platzierung von Absendern und fehlerfreie Anschriften für die Hochzeitspost.
				</p>
			</div>

			<!-- Section 1: Guide -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Die richtige Platzierung auf dem Briefumschlag
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Damit der Umschlag sowohl elegant aussieht als auch reibungslos durch die Post verarbeitet wird:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Empfängeranschrift:</strong> In der rechten unteren Hälfte des Umschlags zentriert oder linksbündig platziert.</li>
					<li><strong>Absender:</strong> Auf der Rückseite mittig auf der Verschlussklappe oder dezent oben links auf der Vorderseite.</li>
					<li><strong>Frankierzone:</strong> Oben rechts mindestens 40 × 70 mm Platz für Briefmarken freilassen.</li>
				</ul>
			</section>

			<!-- Section 2: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Häufig gestellte Fragen (FAQ)
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Darf man Vornamen auf dem Umschlag weglassen?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Für formelle Einladungen sollten immer die Vornamen beider Partner genannt werden (z. B. 'Eheleute Maximilian und Sophie Weber'), um eine persönliche Wertschätzung auszudrücken.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Wie bedruckt man Umschläge zu Hause im Drucker?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Nutzen Sie den manuellen Einzelblatteinzug Ihres Druckers. Stellen Sie im Druckmenü das Papierformat auf DIN C5 oder DIN C6 ein und wählen Sie als Medientyp 'Schweres Papier / Briefumschlag'.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/de/wedding-envelope-addressing" category="stationery" />

	</main>

	<!-- Interactive Live Script -->
	<script is:inline>
		const envSizeSelect = document.getElementById('env-size');
		const presetSelect = document.getElementById('etiquette-preset');
		const recName1 = document.getElementById('rec-name-1');
		const recName2 = document.getElementById('rec-name-2');
		const recName2Group = document.getElementById('rec-name-2-group');
		const recStreet = document.getElementById('rec-street');
		const recCity = document.getElementById('rec-city');
		const recZip = document.getElementById('rec-zip');

		const toggleReturnAddr = document.getElementById('toggle-return-addr');
		const returnAddrFields = document.getElementById('return-addr-fields');
		const retNames = document.getElementById('ret-names');
		const retStreet = document.getElementById('ret-street');

		const envelopeCanvas = document.getElementById('envelope-canvas');
		const canvasSizeTag = document.getElementById('env-size-tag');
		const canvasRetAddr = document.getElementById('canvas-return-addr');
		const canvasRetName = document.getElementById('canvas-ret-name');
		const canvasRetFull = document.getElementById('canvas-ret-full');
		const canvasRecBlock = document.getElementById('canvas-recipient-block');
		const canvasRecName1 = document.getElementById('canvas-rec-name-1');
		const canvasRecName2 = document.getElementById('canvas-rec-name-2');
		const canvasRecStreet = document.getElementById('canvas-rec-street');
		const canvasRecCityStateZip = document.getElementById('canvas-rec-city-state-zip');

		const fontButtons = document.querySelectorAll('.font-style-btn');
		const batchInput = document.getElementById('batch-paste-input');
		const btnLoadBatch = document.getElementById('btn-load-batch');
		const batchCountTag = document.getElementById('batch-count-tag');
		const btnPrint = document.getElementById('btn-print-envelope');
		const btnWord = document.getElementById('btn-export-word');

		let currentFont = 'script';
		let batchAddresses = [];

		function updateCanvas() {
			canvasRecName1.textContent = recName1.value || 'Empfängername';
			
			if (recName2.value.trim().length > 0) {
				canvasRecName2.style.display = 'block';
				canvasRecName2.textContent = recName2.value.trim();
			} else {
				canvasRecName2.style.display = 'none';
			}

			canvasRecStreet.textContent = recStreet.value || 'Straße & Hausnummer';
			canvasRecCityStateZip.textContent = `${recZip.value || 'PLZ'} ${recCity.value || 'Ort'}`;

			// Return Address
			if (toggleReturnAddr.checked) {
				canvasRetAddr.style.display = 'block';
				canvasRetName.textContent = retNames.value || '';
				canvasRetFull.textContent = retStreet.value || '';
			} else {
				canvasRetAddr.style.display = 'none';
			}

			// Size Aspect Ratio
			const size = envSizeSelect.value;
			if (size === 'a7') {
				envelopeCanvas.style.aspectRatio = '229 / 162';
				canvasSizeTag.textContent = 'DIN C5: 162 × 229 mm';
			} else if (size === 'a2') {
				envelopeCanvas.style.aspectRatio = '162 / 114';
				canvasSizeTag.textContent = 'DIN C6: 114 × 162 mm';
			} else if (size === 'inner') {
				envelopeCanvas.style.aspectRatio = '195 / 140';
				canvasSizeTag.textContent = 'Pocketfold-Innenkarte (Ohne Absender)';
				canvasRetAddr.style.display = 'none';
			} else if (size === 'square') {
				envelopeCanvas.style.aspectRatio = '1 / 1';
				canvasSizeTag.textContent = 'Quadrat: 155 × 155 mm';
			} else if (size === 'dl') {
				envelopeCanvas.style.aspectRatio = '220 / 110';
				canvasSizeTag.textContent = 'DIN Lang: 110 × 220 mm';
			}

			// Apply Font Styles
			if (currentFont === 'script') {
				canvasRecName1.style.fontFamily = "'Kalam', 'Caveat', cursive";
				canvasRecName2.style.fontFamily = "'Kalam', 'Caveat', cursive";
				canvasRecName1.style.letterSpacing = '0.02em';
				canvasRecStreet.style.fontFamily = "var(--font-body)";
				canvasRecCityStateZip.style.fontFamily = "var(--font-body)";
			} else if (currentFont === 'serif') {
				canvasRecName1.style.fontFamily = "Georgia, 'Times New Roman', serif";
				canvasRecName2.style.fontFamily = "Georgia, 'Times New Roman', serif";
				canvasRecName1.style.letterSpacing = '0.05em';
				canvasRecStreet.style.fontFamily = "Georgia, serif";
				canvasRecCityStateZip.style.fontFamily = "Georgia, serif";
			} else if (currentFont === 'sans') {
				canvasRecName1.style.fontFamily = "var(--font-body)";
				canvasRecName2.style.fontFamily = "var(--font-body)";
				canvasRecName1.style.letterSpacing = '0.04em';
				canvasRecStreet.style.fontFamily = "var(--font-body)";
				canvasRecCityStateZip.style.fontFamily = "var(--font-body)";
			} else if (currentFont === 'hand') {
				canvasRecName1.style.fontFamily = "'Caveat', cursive";
				canvasRecName2.style.fontFamily = "'Caveat', cursive";
				canvasRecName1.style.letterSpacing = '0.01em';
				canvasRecStreet.style.fontFamily = "'Caveat', cursive";
				canvasRecCityStateZip.style.fontFamily = "'Caveat', cursive";
			}
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'married-same') {
				recName1.value = 'Eheleute Maximilian und Sophie Weber';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'married-modern') {
				recName1.value = 'Sophie und Maximilian Weber';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'married-diff') {
				recName1.value = 'Sophie Wagner & Maximilian Weber';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'doctor-wife') {
				recName1.value = 'Frau Dr. Sophie Weber & Herr Maximilian Weber';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'doctor-both') {
				recName1.value = 'Frau Dr. Sophie Weber & Herr Dr. Maximilian Weber';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'unmarried') {
				recName1.value = 'Frau Sophie Wagner';
				recName2.value = 'Herr Maximilian Weber';
				recName2Group.style.display = 'block';
			} else if (p === 'single-guest') {
				recName1.value = 'Herr Tobias Wagner und Begleitung';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'family') {
				recName1.value = 'Familie Weber mit Felix und Lena';
				recName2.value = '';
				recName2Group.style.display = 'none';
			}
			updateCanvas();
		});

		// Live Input Listeners
		[recName1, recName2, recStreet, recCity, recZip, retNames, retStreet, envSizeSelect].forEach(input => {
			input.addEventListener('input', updateCanvas);
		});

		toggleReturnAddr.addEventListener('change', () => {
			returnAddrFields.style.display = toggleReturnAddr.checked ? 'block' : 'none';
			updateCanvas();
		});

		// Font Style Button Toggles
		fontButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				fontButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentFont = btn.getAttribute('data-font');
				updateCanvas();
			});
		});

		// Batch Parser
		btnLoadBatch.addEventListener('click', () => {
			const text = batchInput.value.trim();
			if (!text) return;
			const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 0);
			if (lines.length === 0) return;

			batchAddresses = lines.map(line => {
				const parts = line.split(',').map(p => p.trim());
				return {
					name: parts[0] || 'Gastname',
					street: parts[1] || 'Straße & Hausnummer',
					zip: parts[2] || 'PLZ',
					city: parts[3] || 'Ort'
				};
			});

			batchCountTag.textContent = `${batchAddresses.length} Adressen geladen`;

			if (batchAddresses.length > 0) {
				const first = batchAddresses[0];
				recName1.value = first.name;
				recName2.value = '';
				recStreet.value = first.street;
				recZip.value = first.zip;
				recCity.value = first.city;
				updateCanvas();
			}
		});

		// Print PDF Handler
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			const printDoc = printWindow.document;

			const addressesToPrint = batchAddresses.length > 0 ? batchAddresses : [{
				name: recName1.value + (recName2.value ? '<br>' + recName2.value : ''),
				street: recStreet.value,
				zip: recZip.value,
				city: recCity.value
			}];

			const returnHTML = toggleReturnAddr.checked ? `
				<div style="position: absolute; top: 15mm; left: 15mm; font-size: 10pt; line-height: 1.3; font-family: sans-serif; color: #1e293b;">
					<strong>${retNames.value}</strong><br/>
					${retStreet.value}
				</div>
			` : '';

			let pagesHTML = '';
			addressesToPrint.forEach(addr => {
				pagesHTML += `
					<div class="envelope-page" style="width: 229mm; height: 162mm; position: relative; page-break-after: always; box-sizing: border-box; padding: 35mm 20mm 20mm; text-align: center;">
						${returnHTML}
						<div style="margin-top: 30mm;">
							<div style="font-size: 18pt; font-weight: bold; margin-bottom: 6px; font-family: ${currentFont === 'serif' ? 'Georgia, serif' : currentFont === 'sans' ? 'sans-serif' : "'Caveat', cursive"}; color: #1e293b;">
								${addr.name}
							</div>
							<div style="font-size: 12pt; color: #334155; font-family: sans-serif; line-height: 1.4;">
								${addr.street}<br/>
								${addr.zip} ${addr.city}
							</div>
						</div>
					</div>
				`;
			});

			printDoc.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Hochzeits-Umschläge drucken — Manage.Wedding</title>
					<style>
						@page { size: 229mm 162mm; margin: 0; }
						body { margin: 0; padding: 0; background: #fff; }
						.envelope-page { width: 229mm; height: 162mm; page-break-after: always; position: relative; box-sizing: border-box; }
					</style>
				</head>
				<body>
					${pagesHTML}
					<script>
						window.onload = function() { window.print(); };
					<\/script>
				</body>
				</html>
			`);
			printDoc.close();
		});

		// Export Word (.doc) Handler
		btnWord.addEventListener('click', () => {
			const addressesToExport = batchAddresses.length > 0 ? batchAddresses : [{
				name: recName1.value + (recName2.value ? ' & ' + recName2.value : ''),
				street: recStreet.value,
				zip: recZip.value,
				city: recCity.value
			}];

			let content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Hochzeits-Adressliste für Umschläge</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; }
					table { width: 100%; border-collapse: collapse; margin-top: 15px; }
					th, td { border: 1px solid #999; padding: 8px 12px; text-align: left; }
					th { background-color: #f2f2f2; font-weight: bold; }
				</style>
				</head>
				<body>
					<h2>Manage.Wedding — Umschlag-Adressliste (Knigge-formatiert)</h2>
					<p>Erstellt am: ${new Date().toLocaleDateString('de-DE')} | Absender: ${retNames.value}, ${retStreet.value}</p>
					<table>
						<thead>
							<tr>
								<th>#</th>
								<th>Empfängername(n)</th>
								<th>Straße & Hausnummer</th>
								<th>PLZ</th>
								<th>Wohnort</th>
							</tr>
						</thead>
						<tbody>
			`;

			addressesToExport.forEach((addr, idx) => {
				content += `
					<tr>
						<td>${idx + 1}</td>
						<td><strong>${addr.name}</strong></td>
						<td>${addr.street}</td>
						<td>${addr.zip}</td>
						<td>${addr.city}</td>
					</tr>
				`;
			});

			content += `</tbody></table></body></html>`;

			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'hochzeits-umschlag-adressen.doc';
			link.click();
		});

		// Initial Canvas Render
		updateCanvas();
	</script>
</Layout>
