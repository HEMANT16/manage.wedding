---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/guest-list-manager/#webapp",
      "name": "Gästelisten-Manager & Hochzeits-CRM | Manage.Wedding",
      "url": "https://manage.wedding/de/guest-list-manager",
      "inLanguage": "de",
      "description": "Kostenloses Hochzeits-Gästelisten-CRM. Verwalten Sie Begleitpersonen (+1), Unverträglichkeiten, Haushaltsgrößen und exportieren Sie direkt nach Word, PDF oder Excel.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie strukturiert und verwaltet man eine Hochzeits-Gästeliste professionell?",
      "description": "Schritt-für-Schritt-Anleitung zur Erfassung von Einladungen, Haushaltsgruppierungen, Menüwünschen und für den perfekten Export an Caterer und Location.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Ziel-Personenzahl und Einladungsquote berechnen",
          "text": "Teilen Sie die Raumkapazität durch die historische Zusagequote von 80–85%, um die Gesamtanzahl der einzuladenden Personen zu ermitteln."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Gäste nach Haushalten und Gruppen gliedern",
          "text": "Erfassen Sie Hauptgäste, Begleitpersonen (+1) und Gruppenzugehörigkeiten (Brautfamilie, Bräutigamfamilie, Freunde, Kollegen)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Menüwünsche & Allergien in Echtzeit erfassen",
          "text": "Dokumentieren Sie Zusagen, Absagen sowie spezielle Ernährungswünsche (Vegetarisch, Vegan, Glutenfrei, Laktosefrei)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Export für Dienstleister generieren",
          "text": "Laden Sie die fertige Liste als editierbare Word-Datei (.doc), druckfertiges PDF oder Excel-CSV herunter."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie exportiere ich die Gästeliste nach Word oder PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Klicken Sie oben auf '📝 Word-Export (.doc)', um eine formatierte Microsoft-Word-Tabelle herunterzuladen, oder auf '🖨️ PDF / Drucken' für ein druckfertiges Dokument mit allen Namen, Gruppen und Menüwünschen."
          }
        },
        {
          "@type": "Question",
          "name": "Welche Regeln gelten für Begleitpersonen (+1 / Plus-One)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Verheiratete, Verlobte oder fest zusammenlebende Paare werden stets gemeinsam eingeladen. Trauzeugen erhalten traditionell immer eine Begleitperson. Bei rein alleinstehenden Gästen entscheidet das Budget und die Raumkapazität."
          }
        },
        {
          "@type": "Question",
          "name": "Wie funktioniert das A-Listen- und B-Listen-Prinzip?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die A-Liste umfasst engste Familie und Freunde (Versand 8–10 Wochen vorher). Bei eingehenden Absagen werden zeitnah Gäste der B-Liste (Kollegen, Bekannte) nachgeladen, sodass alle Plätze besetzt werden."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Gästelisten-Manager Hochzeit | Kostenloses CRM mit Word- & PDF-Export"
	description="Hochzeits-Gästeliste online organisieren. Verwalten Sie Begleitpersonen, Menüwünsche, Allergien & Zusagen mit direktem Word-, PDF- & Excel-Export."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Gästelisten-Manager" category="guests" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Hochzeits- <span class="accent-italic">Gästelisten-Manager</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Verwalten Sie Rückmeldungen, Begleitpersonen, Menüwünsche und Tischzuweisungen an einem Ort. Exportieren Sie mit einem Klick nach <strong>Word (.doc)</strong>, <strong>PDF</strong> oder <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Overview Metrics & Dashboard -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						📊 Gästelisten-Dashboard
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Automatisch synchronisiert mit Sitzplan & RSVP-Tracker
					</span>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Word-Export (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ PDF / Drucken
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Excel-Export (.csv)
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Beispieldaten
					</button>
					<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🗑️ Leeren
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;" class="stats-counter-grid">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Gesamte Plätze</span>
					<strong id="stat-total-seats" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(<span id="stat-total-parties">0</span> Einladungen)</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Bestätigt (Zugesagt)</span>
					<strong id="stat-attending" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-attending-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% der Plätze</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Offen (Ausstehend)</span>
					<strong id="stat-pending" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span id="stat-pending-pct" style="font-size: 0.75rem; color: #854d0e; display: block;">0% der Plätze</span>
				</div>
				<div style="background: #fef2f2; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #991b1b; display: block;">Abgesagt</span>
					<strong id="stat-declined" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red);">0</strong>
					<span id="stat-declined-pct" style="font-size: 0.75rem; color: #991b1b; display: block;">0% der Plätze</span>
				</div>
				<div style="background: #faf5ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #6b21a8; display: block;">Sonderwünsche</span>
					<strong id="stat-dietary" class="font-heading" style="font-size: 1.8rem; color: #7e22ce;">0</strong>
					<span style="font-size: 0.75rem; color: #6b21a8; display: block;">Catering-relevant</span>
				</div>
			</div>

			<!-- Dynamic Visual Stacked Group Distribution Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Verteilung nach Gästegruppen</span>
					<span id="group-balance-indicator" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">Ausgeglichen</span>
				</div>
				<div id="chart-container" style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: var(--bg-paper); margin-bottom: 0.75rem;">
					<!-- Segments rendered via JS -->
				</div>
				<div id="chart-legend" style="display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.85rem; color: var(--fg-pencil);">
					<!-- Legend rendered via JS -->
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Add Guest Form + Searchable Filterable List -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 360px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="guest-workspace-grid">
			
			<!-- Left Column: Add Guest Card -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.25rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>➕</span> Neuen Gast erfassen
				</h2>

				<form id="guest-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Primary Guest Name -->
					<div>
						<label for="guest-name" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Name des Gastes / Haushalts *
						</label>
						<input type="text" id="guest-name" required placeholder="z. B. Sarah & Tobias Schmidt" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1.05rem;">
					</div>

					<!-- Group Category -->
					<div>
						<label for="guest-group" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Gruppe / Seite
						</label>
						<select id="guest-group" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
							<option value="Brautfamilie">Brautfamilie</option>
							<option value="Bräutigamfamilie">Bräutigamfamilie</option>
							<option value="Brautfreunde">Brautfreunde</option>
							<option value="Bräutigamfreunde">Bräutigamfreunde</option>
							<option value="Gemeinsame Freunde">Gemeinsame Freunde</option>
							<option value="Trauzeugen / VIP">Trauzeugen / VIP</option>
							<option value="Arbeitskollegen">Arbeitskollegen</option>
						</select>
					</div>

					<!-- Party Size & RSVP -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="guest-party" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Personenanzahl
							</label>
							<select id="guest-party" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="1">1 (Einzelperson)</option>
								<option value="2" selected>2 (Paar / +1)</option>
								<option value="3">3 (Familie mit Kind)</option>
								<option value="4">4 (Familie mit 2 Kindern)</option>
								<option value="5">5+ (Große Gruppe)</option>
							</select>
						</div>
						<div>
							<label for="guest-rsvp" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Status RSVP
							</label>
							<select id="guest-rsvp" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="Pending">⏳ Offen (Ausstehend)</option>
								<option value="Attending">✅ Zugesagt (Ja)</option>
								<option value="Declined">❌ Abgesagt (Nein)</option>
							</select>
						</div>
					</div>

					<!-- Dietary Restrictions -->
					<div>
						<label for="guest-dietary" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Menü / Unverträglichkeiten / Allergien
						</label>
						<input type="text" id="guest-dietary" placeholder="z. B. 1x Vegetarisch, Laktosefrei" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						<!-- Quick Dietary Tags -->
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem;">
							<button type="button" class="diet-quick-btn" data-val="Vegetarisch" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Vegetarisch</button>
							<button type="button" class="diet-quick-btn" data-val="Vegan" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Vegan</button>
							<button type="button" class="diet-quick-btn" data-val="Glutenfrei" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Glutenfrei</button>
							<button type="button" class="diet-quick-btn" data-val="Laktosefrei" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Laktosefrei</button>
							<button type="button" class="diet-quick-btn" data-val="Nussallergie" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Nussallergie</button>
						</div>
					</div>

					<!-- Optional Table & Contact Notes -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="guest-table" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Tisch-Nr. (Optional)
							</label>
							<input type="text" id="guest-table" placeholder="z. B. Tisch 3" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						</div>
						<div>
							<label for="guest-email" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								E-Mail / Tel. (Optional)
							</label>
							<input type="text" id="guest-email" placeholder="sarah@beispiel.de" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						</div>
					</div>

					<button type="submit" class="hand-btn" style="width: 100%; padding: 0.85rem; font-size: 1.15rem; margin-top: 0.5rem;">
						✨ Gast hinzufügen
					</button>

				</form>
			</div>

			<!-- Right Column: Interactive Searchable Table & Filter Bar -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Filter Bar -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
					
					<!-- Search Input -->
					<div style="flex: 1; min-width: 180px;">
						<input type="text" id="search-input" placeholder="🔍 Name, Gruppe, Tisch oder Menüwunsch suchen..." class="form-input" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem;">
					</div>

					<!-- Group Filter -->
					<div>
						<select id="filter-group" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Alle Gruppen</option>
							<option value="Brautfamilie">Brautfamilie</option>
							<option value="Bräutigamfamilie">Bräutigamfamilie</option>
							<option value="Brautfreunde">Brautfreunde</option>
							<option value="Bräutigamfreunde">Bräutigamfreunde</option>
							<option value="Gemeinsame Freunde">Gemeinsame Freunde</option>
							<option value="Trauzeugen / VIP">Trauzeugen / VIP</option>
							<option value="Arbeitskollegen">Arbeitskollegen</option>
						</select>
					</div>

					<!-- RSVP Filter -->
					<div>
						<select id="filter-rsvp" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Alle Status</option>
							<option value="Attending">✅ Bestätigt (Zugesagt)</option>
							<option value="Pending">⏳ Offen (Ausstehend)</option>
							<option value="Declined">❌ Abgesagt</option>
						</select>
					</div>
				</div>

				<!-- Guest List Table Container -->
				<div id="guest-list-table-wrap" style="overflow-x: auto; max-height: 550px;">
					<table id="guest-table-elem" style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 1rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil); position: sticky; top: 0; z-index: 1;">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Gastname / Haushalt</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Gruppe</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Status</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Menü / Allergien</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Tisch</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Aktionen</th>
							</tr>
						</thead>
						<tbody id="guest-table-body">
							<!-- Populated via JS -->
						</tbody>
					</table>
				</div>

				<!-- Empty State Note -->
				<div id="empty-state-box" style="display: none; text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💌</div>
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">Ihre Gästeliste ist noch leer</h3>
					<p class="font-body" style="font-size: 1.05rem; margin-bottom: 1.25rem;">Erfassen Sie Gäste über das linke Formular oder laden Sie Beispieldaten zum Testen.</p>
					<button type="button" id="btn-empty-sample" class="hand-btn" style="padding: 0.5rem 1.25rem; font-size: 1rem;">
						➕ 8 Beispieldaten laden
					</button>
				</div>

			</div>
		</div>

		<!-- Hidden Printable Sheet Container for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Offizielle Gästeliste</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportiert am: <span id="print-date"></span> | Bestätigte Plätze: <span id="print-total-seats"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Gastname</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Gruppe</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">Plätze</th>
