---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-hashtag-generator/#webapp",
      "name": "Hochzeits-Hashtag-Generator & Aufsteller-Designer | Manage.Wedding",
      "url": "https://manage.wedding/de/wedding-hashtag-generator",
      "inLanguage": "de",
      "description": "Kostenloser Hochzeits-Hashtag-Generator. Erstellen Sie über 50 individuelle, romantische und witzige Hochzeits-Hashtags aus Ihren Namen. Inklusive 1-Klick-Kopieren, Instagram-Prüfung und druckbaren Tischaufstellern.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie erstellt dieser Generator individuelle Hochzeits-Hashtags?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Unser Generator kombiniert die Vornamen und Nachnamen beider Partner, Paarnamen/Spitznamen, das Hochzeitsjahr und den Hochzeitsort über kreative Wortspiele in 5 Kategorien: Romantisch, Lustig/Wortspiele, Party & Feier, Kurz & Bündig sowie Destination."
          }
        },
        {
          "@type": "Question",
          "name": "Warum sollte man CamelCase (Großschreibung jedes Wortes) bei Hochzeits-Hashtags verwenden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die Großschreibung jedes Wortanfangs (z. B. #FuerImmerMueller statt #fuerimmermueller) macht den Hashtag für Gäste auf Schildern sofort lesbar, verhindert peinliche Worttrennungen und ermöglicht es Screenreadern, die Wörter für barrierefreie Zugänglichkeit korrekt vorzulesen."
          }
        },
        {
          "@type": "Question",
          "name": "Wo sollte man den Hochzeits-Hashtag auf der Feier platzieren?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ideale Orte sind die Save-the-Date-Karten, die Hochzeitshomepage, die Fotobox (Photobooth), Aufsteller an der Bar, Tischkarten und das Gästebuch. Mit unserem Tool können Sie direkt einen druckfertigen Aufsteller im Bilderrahmen-Format exportieren."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Wie erstellt und nutzt man einen perfekten Hochzeits-Hashtag?",
      "description": "Schritt-für-Schritt-Anleitung zur Erstellung einprägsamer Hashtags und Tischaufsteller für Ihre Hochzeitsfotos.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Namen & Details eingeben",
          "text": "Tragen Sie die Vornamen und Nachnamen beider Partner, einen gemeinsamen Paarnamen sowie Hochzeitsjahr oder Ort ein."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Stilrichtung wählen",
          "text": "Filtern Sie nach Romantisch, Lustig, Party oder Kurz und wählen Sie Ihren Favoriten aus über 50 Vorschlägen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Instagram-Verfügbarkeit prüfen",
          "text": "Klicken Sie auf den Instagram-Prüfbutton, um sicherzustellen, dass der Tag nicht von tausenden anderen Feiern belegt ist."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Druckbaren Bar- & Tischaufsteller exportieren",
          "text": "Drucken Sie Ihren gestalteten Aufsteller für Bilderrahmen an Bar und Fotobox in PDF oder Word (.doc) aus."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Hochzeits-Hashtag-Generator | Kostenlose Ideen & Aufsteller drucken"
	description="Kostenloser Hochzeits-Hashtag-Generator. Erstellen Sie über 50 kreative, romantische und lustige Hashtags aus Ihren Namen. Mit 1-Klick-Kopieren, Instagram-Verfügbarkeitsprüfung und druckbaren Tischaufstellern."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Hochzeits-Hashtag-Generator" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Hochzeits-Hashtag <span class="accent-italic">Generator</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Generieren Sie über 50 romantische, witzige und party-taugliche Hochzeits-Hashtags. Mit 1-Klick kopieren, Instagram-Check und <strong>druckbaren Tischaufstellern</strong> in Word & PDF!
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> In 3 Schritten zum perfekten Hochzeits-Hashtag
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Namen & Details eingeben
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Geben Sie Ihre Vor- und Nachnamen, Hochzeitsjahr und optional einen Paarnamen oder den Hochzeitsort ein.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Stil wählen & Favorit markieren
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Filtern Sie nach Romantisch, Witzig, Party oder Kurz und wählen Sie Ihren Lieblings-Hashtag mit einem Klick aus.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Tischaufsteller drucken
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Klicken Sie auf <strong>"🖨️ Aufsteller drucken (PDF)"</strong> für ein schönes Schild an Bar, Fotobox und Tischen.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="hashtag-grid">
			
			<!-- Left Column: Couple Details Form & Filter Tabs -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💍 Namen & Wortspiele
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Geben Sie Ihre Namen ein, um über 50 individuelle Hashtags zu generieren
					</span>
				</div>

				<form id="hashtag-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Partner 1 -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p1-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Vorname Partner 1 *
							</label>
							<input type="text" id="p1-first" value="Sophie" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p1-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Nachname Partner 1 *
							</label>
							<input type="text" id="p1-last" value="Weber" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Partner 2 -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p2-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Vorname Partner 2 *
							</label>
							<input type="text" id="p2-first" value="Maximilian" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p2-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Nachname Partner 2 *
							</label>
							<input type="text" id="p2-last" value="Müller" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Nickname, Year, Destination -->
					<div style="display: grid; grid-template-columns: 1.2fr 0.8fr 1fr; gap: 0.6rem;">
						<div>
							<label for="couple-nickname" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Paarname / Spitzname (Opt.)
							</label>
							<input type="text" id="couple-nickname" value="MaxiUndSophie" placeholder="z. B. Sophimilian" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-year" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Jahr
							</label>
							<input type="number" id="wedding-year" value="2026" min="2024" max="2035" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-city" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Ort / Location (Opt.)
							</label>
							<input type="text" id="wedding-city" placeholder="z. B. München / Mallorca" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</div>

					<!-- Vibe Filter Selector -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
							🎨 Nach Stilrichtung filtern:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
							<button type="button" class="filter-tab-btn active-tab hand-btn" data-vibe="all" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">✨ Alle Ideen (50+)</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="romantic" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">💖 Romantisch</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="funny" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">😂 Witzig & Wortspiele</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="party" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">🥂 Party & Feier</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="short" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">⚡ Kurz & Bündig</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Hashtag Cards Stream & Printable Sign Mockup -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Printable Table Sign Mockup Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖨️ Vorschau: Druckbarer Tischaufsteller
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Druckfertig für Bilderrahmen an Bar, Fotobox & Gästebuchtisch
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Word-Aufsteller (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Aufsteller drucken (PDF)
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Table Sign Mockup Box -->
					<div id="table-sign-mockup" style="border: 2.5px solid var(--fg-pencil); border-radius: 6px; padding: 2rem 1.5rem; background: var(--bg-paper); text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1rem;">
						
						<!-- Corner Marks -->
						<div style="position: absolute; top: 6px; left: 6px; width: 14px; height: 14px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 6px; right: 6px; width: 14px; height: 14px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; left: 6px; width: 14px; height: 14px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; right: 6px; width: 14px; height: 14px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<p style="font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; color: var(--accent-red); margin: 0 0 0.5rem 0; font-weight: bold;">
							HALTET DIE SCHÖNSTEN MOMENTE FEST!
						</p>

						<h2 style="font-family: var(--font-heading); font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0;">
							Markiert eure Fotos & Videos auf Instagram:
						</h2>

						<div style="background: #fff; border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem 1rem; margin: 1rem 0; display: inline-block;">
							<strong id="display-selected-hashtag" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); word-break: break-word;">
								#FürImmerMüller
							</strong>
						</div>

						<p style="font-family: var(--font-body); font-size: 0.88rem; color: var(--text-secondary); margin: 0.5rem 0 0 0; font-style: italic;">
							Damit wir keinen eurer wundervollen Schnappschüsse verpassen!
						</p>
					</div>

					<span style="font-size: 0.78rem; color: var(--text-secondary); text-align: center; display: block;">
						💡 Tipp: Klicken Sie auf eine beliebige Hashtag-Karte unten, um sie als Aufsteller zu wählen!
					</span>

				</div>

				<!-- Generated Hashtags Stream Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 480px; overflow-y: auto;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0;">
							🏷️ Generierte Hashtag-Liste (<span id="tags-count-badge">50+</span>)
						</h3>
						<span style="font-size: 0.78rem; color: var(--accent-red); font-weight: bold;">
							Klicken zum Kopieren & Auswählen
						</span>
					</div>

					<div id="hashtags-stream-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem;">
						<!-- Populated via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border: 4px solid #000; padding: 50px 30px; text-align: center; font-family: 'Segoe UI', Arial, sans-serif; max-width: 600px; margin: 0 auto;">
				<p style="font-size: 16px; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 15px 0; font-weight: bold;">Helft uns, die Liebe festzuhalten</p>
				<h1 style="font-size: 30px; margin: 0 0 20px 0;">Bitte markiert eure Fotos & Videos</h1>
				<div style="border: 2px dashed #000; padding: 20px; margin: 25px 0; background: #fafafa;">
					<h2 id="print-hashtag-display" style="font-size: 36px; margin: 0; color: #000;">#FürImmerMüller</h2>
				</div>
				<p style="font-size: 16px; font-style: italic; color: #444; margin: 20px 0 0 0;">Danke, dass ihr diesen besonderen Tag mit uns feiert!</p>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Auf einen Blick (BLUF)</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Faustregeln für den perfekten Hochzeits-Hashtag
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>Die Grundformel:</strong> Ein guter Hashtag kombiniert <strong>[Nachname] + [Wortspiel/Spruch] + [Jahr]</strong>. Verwenden Sie stets <strong>CamelCase</strong> (Großbuchstaben am Wortanfang), damit der Tag auf Schildern sofort lesbar ist und Screenreader ihn barrierefrei vorlesen können.
			</p>
		</div>

		<!-- SEO Article & Comprehensive Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Social-Media-Leitfaden</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					Der Leitfaden für Ihren Hochzeits-Hashtag
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					Wie Sie alle Fotos Ihrer Gäste bündeln und auf Instagram & TikTok wiederfinden.
				</p>
			</div>

			<!-- Section 1: Guide -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. Die 3 goldenen Regeln für Hochzeits-Hashtags
				</h3>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Nur einen einzigen Haupt-Hashtag nutzen:</strong> Mehrere Tags zersplittern die Fotosammlung auf verschiedene Feeds.</li>
					<li><strong>Immer CamelCase schreiben:</strong> <em>#FuerImmerMueller</em> ist im Vorbeigehen zehnmal besser zu lesen als <em>#fuerimmermueller</em>.</li>
					<li><strong>Vorab auf Instagram prüfen:</strong> Suchen Sie den Tag kurz in der Instagram-App, um sicherzugehen, dass er nicht schon tausendfach belegt ist.</li>
				</ul>
			</section>

			<!-- Section 2: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Häufig gestellte Fragen (FAQ)
				</h3>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper); cursor: pointer;">
					<summary class="font-heading" style="font-size: 1.2rem; color: var(--accent-blue);">
						Wie drucke ich das Schild für unsere Bar oder Fotobox?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Wählen Sie Ihren Wunsch-Hashtag aus und klicken Sie oben auf <strong>"🖨️ Aufsteller drucken (PDF)"</strong>. Drucken Sie die Seite auf festem weißem Papier (z. B. 250 g/m²) aus und stellen Sie sie in einen schönen Bilderrahmen.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/de/wedding-hashtag-generator" category="stationery" />

	</main>
</Layout>

<style>
	.filter-tab-btn.active-tab {
		background: var(--fg-pencil) !important;
		color: #fff !important;
	}

	.print-only {
		display: none;
	}

	
</style>

<script is:inline>
	let selectedFeaturedTag = '#FürImmerMüller';
	let currentVibeFilter = 'all';

	const p1FirstInput = document.getElementById('p1-first');
	const p1LastInput = document.getElementById('p1-last');
	const p2FirstInput = document.getElementById('p2-first');
	const p2LastInput = document.getElementById('p2-last');
	const nicknameInput = document.getElementById('couple-nickname');
	const yearInput = document.getElementById('wedding-year');
	const cityInput = document.getElementById('wedding-city');

	const displaySelectedHashtag = document.getElementById('display-selected-hashtag');
	const printHashtagDisplay = document.getElementById('print-hashtag-display');
	const tagsCountBadge = document.getElementById('tags-count-badge');
	const hashtagsStreamContainer = document.getElementById('hashtags-stream-container');

	function cap(str) {
		if (!str) return '';
		return str.charAt(0).toUpperCase() + str.slice(1);
	}

	function clean(str) {
		return str.replace(/[^a-zA-Z0-9äöüÄÖÜß]/g, '');
	}

	function generateAllTags() {
		const f1 = cap(clean(p1FirstInput.value.trim())) || 'Sophie';
		const l1 = cap(clean(p1LastInput.value.trim())) || 'Weber';
		const f2 = cap(clean(p2FirstInput.value.trim())) || 'Maximilian';
		const l2 = cap(clean(p2LastInput.value.trim())) || 'Müller';
		const nick = cap(clean(nicknameInput.value.trim())) || `${f1}Und${f2}`;
		const yr = clean(yearInput.value.trim()) || '2026';
		const y2 = yr.slice(-2);
		const city = cap(clean(cityInput.value.trim())) || 'München';

		const allTags = [
			// Romantisch
			{ tag: `#FürImmer${l2}`, vibe: 'romantic', score: '99%' },
			{ tag: `#FürImmer${l1}`, vibe: 'romantic', score: '98%' },
			{ tag: `#${f1}Und${f2}FürImmer`, vibe: 'romantic', score: '97%' },
			{ tag: `#Traumhochzeit${l2}`, vibe: 'romantic', score: '96%' },
			{ tag: `#EwigeLiebe${l2}`, vibe: 'romantic', score: '95%' },
			{ tag: `#${f1}Liebt${f2}`, vibe: 'romantic', score: '94%' },
			{ tag: `#ZweiHerzen${l2}`, vibe: 'romantic', score: '92%' },
			{ tag: `#JaIchWill${l2}`, vibe: 'romantic', score: '96%' },
			{ tag: `#${f1}HatIhren${l2}Gefunden`, vibe: 'romantic', score: '93%' },
			{ tag: `#${l1}Wird${l2}`, vibe: 'romantic', score: '95%' },
			
			// Witzig / Wortspiele
			{ tag: `#Hauptsache${l2}`, vibe: 'funny', score: '99%' },
			{ tag: `#EndlichUnterDerHaube${l2}`, vibe: 'funny', score: '97%' },
			{ tag: `#${l2}HatJaGesagt`, vibe: 'funny', score: '96%' },
			{ tag: `#${f1}SchnapptSich${l2}`, vibe: 'funny', score: '95%' },
			{ tag: `#RingDrauf${l2}`, vibe: 'funny', score: '98%' },
			{ tag: `#BesserGehtsNicht${l2}`, vibe: 'funny', score: '94%' },
			{ tag: `#Team${l2}FürsLeben`, vibe: 'funny', score: '93%' },
			{ tag: `#${l2}OderKeiner`, vibe: 'funny', score: '92%' },
			{ tag: `#VerheiratetMit${l2}`, vibe: 'funny', score: '91%' },

			// Party & Feier
			{ tag: `#PartyMitDen${l2}s`, vibe: 'party', score: '99%' },
			{ tag: `#ProstAuf${l2}`, vibe: 'party', score: '97%' },
			{ tag: `#Hochzeitssause${l2}`, vibe: 'party', score: '96%' },
			{ tag: `#KorkenKnallenFür${nick}`, vibe: 'party', score: '98%' },
			{ tag: `#TanzflächeFreiFür${l2}`, vibe: 'party', score: '95%' },
			{ tag: `#${l2}Hochzeitsfestival${yr}`, vibe: 'party', score: '94%' },
			{ tag: `#${nick}FeiernDieLiebe`, vibe: 'party', score: '96%' },

			// Kurz & Bündig
			{ tag: `#${f1}Und${f2}${yr}`, vibe: 'short', score: '98%' },
			{ tag: `#${f1}Und${f2}${y2}`, vibe: 'short', score: '95%' },
			{ tag: `#${nick}${yr}`, vibe: 'short', score: '97%' },
			{ tag: `#Die${l2}s${yr}`, vibe: 'short', score: '99%' },
			{ tag: `#Team${nick}`, vibe: 'short', score: '94%' },
			{ tag: `#${l1}Meets${l2}${y2}`, vibe: 'short', score: '92%' },

			// Destination
			{ tag: `#${l2}In${city}`, vibe: 'romantic', score: '97%' },
			{ tag: `#${nick}In${city}`, vibe: 'party', score: '96%' },
			{ tag: `#${f1}Und${f2}In${city}`, vibe: 'short', score: '93%' }
		];

		return allTags;
	}

	function renderTags() {
		const allTags = generateAllTags();
		
		const filtered = currentVibeFilter === 'all' 
			? allTags 
			: allTags.filter(t => t.vibe === currentVibeFilter);

		tagsCountBadge.textContent = `${filtered.length} Ideen`;

		hashtagsStreamContainer.innerHTML = '';
		filtered.forEach(item => {
			const card = document.createElement('div');
			card.className = 'hand-card';
			card.style.cssText = `padding: 0.75rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.15s ease;`;
			
			const isFeatured = item.tag === selectedFeaturedTag;
			if (isFeatured) {
				card.style.borderColor = 'var(--accent-blue)';
				card.style.background = '#eff6ff';
			}

			const igSearchUrl = `https://www.instagram.com/explore/tags/${encodeURIComponent(item.tag.replace('#', ''))}/`;

			card.innerHTML = `
				<div style="margin-bottom: 0.5rem;">
					<strong class="font-heading tag-title" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; word-break: break-word;">${item.tag}</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">Stil: ${item.vibe}</span>
				</div>
				<div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed #ddd; padding-top: 0.4rem; gap: 0.3rem;">
					<button type="button" class="btn-copy-tag hand-btn" data-tag="${item.tag}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #f0fdf4;">
						📋 Kopieren
					</button>
					<a href="${igSearchUrl}" target="_blank" rel="noopener noreferrer nofollow" class="hand-btn secondary" style="padding: 0.2rem 0.45rem; font-size: 0.72rem; text-decoration: none;">
						🔍 IG-Check
					</a>
				</div>
			`;

			card.addEventListener('click', (e) => {
				if (e.target.tagName === 'BUTTON' || e.target.tagName === 'A') return;
				selectedFeaturedTag = item.tag;
				displaySelectedHashtag.textContent = selectedFeaturedTag;
				printHashtagDisplay.textContent = selectedFeaturedTag;
				renderTags();
			});

			hashtagsStreamContainer.appendChild(card);
		});

		document.querySelectorAll('.btn-copy-tag').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const tag = btn.getAttribute('data-tag');
				navigator.clipboard.writeText(tag).then(() => {
					const oldText = btn.textContent;
					btn.textContent = 'Kopiert! ✅';
					btn.style.background = '#dcfce7';
					setTimeout(() => {
						btn.textContent = oldText;
						btn.style.background = '#f0fdf4';
					}, 1500);
				});
			});
		});
	}

	document.querySelectorAll('.filter-tab-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.filter-tab-btn').forEach(b => {
				b.classList.remove('active-tab');
				b.classList.add('secondary');
			});
			btn.classList.add('active-tab');
			btn.classList.remove('secondary');
			currentVibeFilter = btn.getAttribute('data-vibe');
			renderTags();
		});
	});

	[p1FirstInput, p1LastInput, p2FirstInput, p2LastInput, nicknameInput, yearInput, cityInput].forEach(el => {
		el.addEventListener('input', () => {
			const all = generateAllTags();
			selectedFeaturedTag = all[0].tag;
			displaySelectedHashtag.textContent = selectedFeaturedTag;
			printHashtagDisplay.textContent = selectedFeaturedTag;
			renderTags();
		});
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const allTags = generateAllTags();
		let tagsHtml = '';
		allTags.forEach(t => {
			tagsHtml += `<li style="font-size:14px; font-weight:bold; color:#1e3a8a; margin-bottom:4px;">${t.tag} <span style="font-size:11px; color:#666; font-weight:normal;">(${t.vibe})</span></li>`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Hochzeits-Hashtags & Aufsteller</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					.sign-box { border: 2px solid #333; background: #fafafa; padding: 25px; text-align: center; margin-bottom: 25px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Hochzeits-Hashtag & Aufsteller</h1>
				<p>Erstellt am ${new Date().toLocaleDateString('de-DE')} | Gewählter Tag: <strong>${selectedFeaturedTag}</strong></p>
				
				<div class="sign-box">
					<p style="text-transform:uppercase; letter-spacing:2px; font-size:12px; margin:0 0 10px 0; font-weight:bold;">Haltet die schönsten Momente fest</p>
					<h2 style="font-size:22px; margin:0 0 15px 0;">Bitte markiert eure Fotos & Videos auf Instagram</h2>
					<h1 style="font-size:32px; color:#1e3a8a; margin:10px 0;">${selectedFeaturedTag}</h1>
					<p style="font-style:italic; font-size:13px; margin:15px 0 0 0;">Danke, dass ihr diesen besonderen Tag mit uns feiert!</p>
				</div>

				<h3>Alle 50+ generierten Hochzeits-Hashtags:</h3>
				<ul>${tagsHtml}</ul>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeits_Hashtags_${clean(selectedFeaturedTag)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		printHashtagDisplay.textContent = selectedFeaturedTag;
		window.print();
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const allTags = generateAllTags();
		let csv = "Hashtag,Stil,Score\n";
		allTags.forEach(t => {
			csv += `"${t.tag}","${t.vibe}","${t.score}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hochzeits_Hashtags_Liste.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	renderTags();
</script>
