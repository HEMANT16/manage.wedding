---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://manage.wedding/de/#website",
      "name": "Manage.Wedding — Kostenlose Hochzeitsplaner Rechner & Budget Tools",
      "url": "https://manage.wedding/de/",
      "inLanguage": "de",
      "description": "Private Suite interaktiver Hochzeitsrechner: Getränkebedarf für Sektempfang & Bar, Tischpläne, Hochzeitsbudget und druckbare Papeterie.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://manage.wedding/de/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Sind alle Rechner auf Manage.Wedding wirklich komplett kostenlos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, 100% kostenlos, ohne Registrierung, ohne Kreditkarte und ohne versteckte Gebühren. Alle Berechnungen und PDF-/Word-Downloads werden direkt auf Ihrem Gerät erstellt."
          }
        },
        {
          "@type": "Question",
          "name": "Werden meine Gästeliste oder Budgetdaten auf externen Servern gespeichert?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Manage.Wedding nutzt eine strikte Local-First-Datenschutzarchitektur. Ihre Gästeliste, Adressen und Budgetzahlen bleiben ausschließlich im lokalen Speicher Ihres Browsers und werden niemals an Dritte oder Dienstleister-Verzeichnisse übertragen."
          }
        },
        {
          "@type": "Question",
          "name": "Was sind die 4 wichtigsten Phasen bei der Hochzeitskalkulation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. Budget & Finanzen (Kostenaufteilung und Prüfung von Location-Verträgen), 2. Bewirtung & Torte (Berechnung von Wein, Bier, Sekt und Tortenetagen), 3. Gäste & Logistik (Tischplaner und minutengenauer Tagesablauf), und 4. Papeterie & Details (Umschlag-Adressierung, Menükarten und Redezeit-Planer)."
          }
        }
      ]
    }
  ]
};

const searchIndex = [
  // Budget & Finanzen
  { title: "Hochzeitsbudget Rechner", url: "/de/master-budget-calculator", category: "Budget", desc: "Verteilung nach der bewährten 50/15/10/10/10/5 Branchenformel." },
  { title: "Versteckte Location-Kosten & Rechner", url: "/de/wedding-venue-cost-calculator", category: "Budget", desc: "Mindestumsatz, Servicepauschalen und Raummieten transparent aufschlüsseln." },
  { title: "Wer zahlt was bei der Hochzeit?", url: "/de/who-pays-for-what-wedding", category: "Budget", desc: "Traditionelle Kostenverteilung vs. moderne Aufteilung zwischen Familien und Brautpaar." },
  { title: "JGA Budget Planer (Junggesellenabschied)", url: "/de/bachelorette-budget-calculator", category: "Budget", desc: "Unterkunft und Aktivitäten fair aufteilen und die Kosten der Braut übernehmen." },
  { title: "Trinkgeld-Ratgeber für Dienstleister", url: "/de/vendor-tipping-calculator", category: "Budget", desc: "Übliche Trinkgelder für Service, Fotograf, DJ und Umschlag-Vorlagen." },
  { title: "Flitterwochen Budget Rechner", url: "/de/honeymoon-budget-estimator", category: "Budget", desc: "Flüge, Hotels, Romantik-Dinner, Ausflüge und Packliste kalkulieren." },
  { title: "Hochzeitskredit & Ratenkredit Rechner", url: "/de/wedding-loan-calculator", category: "Budget", desc: "Monatsraten, Zinsbelastung und vollständiger Tilgungsplan." },
  { title: "Geldgeschenke Rechner für Hochzeitsgäste", url: "/de/gift-cash-calculator", category: "Budget", desc: "Passender Betrag je nach Verwandtschaftsgrad, Begleitung und Anreise." },

  // Bewirtung (Dining)
  { title: "Getränkerechner für die Hochzeit", url: "/de/wedding-drink-calculator", category: "Bewirtung", desc: "Flaschen Wein, Sekt, Bierkästen, Spirituosen und Eiswürfel exakt berechnen." },
  { title: "Spirituosen & Barbedarfsrechner", url: "/de/liquor-wedding-calculator", category: "Bewirtung", desc: "Flaschengrößen (0,7L vs. Großflaschen) und Mischverhältnisse für die Cocktailbar." },
  { title: "Hochzeitstorten Preisrechner", url: "/de/cake-pricing-calculator", category: "Bewirtung", desc: "Kosten pro Portion, Arbeitsstunden und Konditor-Kalkulation." },
  { title: "Tortenetagen & Portionen Sizer", url: "/de/cake-serving-calculator", category: "Bewirtung", desc: "Etagengrößen für runde und eckige Hochzeitstorten von 50 bis 300+ Gästen." },
  { title: "Menükarten Gestalter (4x9 DL Format)", url: "/de/reception-menu-maker", category: "Bewirtung", desc: "Elegante Menükarten mit Zierrahmen und Schriften als druckfertige PDF erstellen." },
  { title: "Menü vs. Buffet Kostenvergleich", url: "/de/catering-cost-estimator", category: "Bewirtung", desc: "Preis pro Person zwischen gesetztem Menü, Buffet und Live-Cooking-Stationen." },
  { title: "Alkoholgehalt & Cocktail-Verdünnung", url: "/de/alcohol-dilution-calculator", category: "Bewirtung", desc: "Exakte Mischung von Vol.-% und Wasserzugabe für Premix-Cocktails." },
  { title: "Blumen- & Deko-Kostenrechner", url: "/de/floral-cost-estimator", category: "Bewirtung", desc: "Brautstrauß, Tischgestecke, Anstecker und Traubogen im Kostenüberblick." },

  // Gäste & Logistik (Guests)
  { title: "Interaktiver Tisch- & Sitzplaner", url: "/de/seating-chart-maker", category: "Gäste", desc: "Runde und lange Tafeln per Drag & Drop planen und ausdrucken." },
  { title: "Tanzfläche & Abstandsplaner", url: "/de/seating-clearance-calculator", category: "Gäste", desc: "Quadratmeter für die Tanzfläche und 1,5m Servicegänge für das Personal." },
  { title: "Einzug & Ablauf der Trauung", url: "/de/wedding-processional-order", category: "Gäste", desc: "Reihenfolge für Standesamt, Kirche und freie Trauung festlegen." },
  { title: "Tagesablauf & Zeitplan Generator", url: "/de/day-of-timeline-generator", category: "Gäste", desc: "Minutengenauer Ablaufplan vom Styling über Fotos bis zum Eröffnungstanz." },
  { title: "Polterabend & Generalprobe Planer", url: "/de/rehearsal-dinner-planner", category: "Gäste", desc: "Gästeanzahl, Verpflegung und Ablauf für den Vorabend der Hochzeit." },
  { title: "Gästelisten Manager", url: "/de/guest-list-manager", category: "Gäste", desc: "Begleitpersonen, Postadressen und Essenswünsche übersichtlich verwalten." },
  { title: "Rückmeldungs- & RSVP-Tracker", url: "/de/rsvp-tracker", category: "Gäste", desc: "Echtzeit-Übersicht von Zusagen, Absagen und Menüwünschen." },
  { title: "Gästeanzahl & Absagen-Schätzer", url: "/de/guest-count-estimator", category: "Gäste", desc: "Realistische Teilnahmequote für einheimische und anreisende Gäste." },
  { title: "Fristenrechner für Hochzeitseinladungen", url: "/de/rsvp-date-calculator", category: "Gäste", desc: "Termine für Save-the-Date, Einladungsversand und Rückmeldefrist." },
  { title: "12-Monats-Hochzeitscheckliste", url: "/de/wedding-checklist", category: "Gäste", desc: "Monatliche Aufgabenübersicht mit automatischem Speicherfortschritt." },
  { title: "Brautkleid Änderungsschneider Rechner", url: "/de/dress-alterations-estimator", category: "Gäste", desc: "Kosten für Saumlänge, Korsagenanpassung und Schleppenaufhängung." },
  { title: "Brautkleid Größentabelle & Umrechner", url: "/de/dress-size-converter", category: "Gäste", desc: "Körpermaße in cm in deutsche (EU), UK-, US- und IT-Größen umrechnen." },
  { title: "Ringgrößen-Umrechner (mm Sizer)", url: "/de/ring-size-converter", category: "Gäste", desc: "Innendurchmesser und Umfang in deutsche, US- und europäische Ringgrößen." },

  // Papeterie & Details (Stationery)
  { title: "Briefumschlag Adressierung & Knigge", url: "/de/wedding-envelope-addressing", category: "Papeterie", desc: "Umschläge formvollendet beschriften und drucken (DIN C6 / B6 / A7)." },
  { title: "Einladungsformate & Maße (A6 / B6 / A7)", url: "/de/wedding-invitation-suite-sizer", category: "Papeterie", desc: "Exakte Maße, Einleger-Abstände und 300 DPI Druckvorgaben." },
  { title: "Portorechner für Hochzeitspost", url: "/de/wedding-invitation-postage-calculator", category: "Papeterie", desc: "Gewicht, Wachssiegel, Schleifenbänder und Portostufen berechnen." },
  { title: "Tisch- & Platzkarten Drucken", url: "/de/table-place-cards", category: "Papeterie", desc: "Faltbare Tischkärtchen mit Menü-Symbolen für das Servicepersonal." },
  { title: "Danksagungstexte & Vorlagen", url: "/de/wedding-thank-you-cards", category: "Papeterie", desc: "Herzliche Texte für Geldgeschenke, Hochzeitsgeschenke und Glückwünsche." },
  { title: "Digitale Hochzeitseinladungen", url: "/de/digital-invitations", category: "Papeterie", desc: "Online-Einladungen mit Kalenderfunktion (.ics) und Online-Rückmeldung." },
  { title: "Hochzeitsrede & Zeitplaner", url: "/de/wedding-speech-calculator", category: "Papeterie", desc: "Wortanzahl, Sprechgeschwindigkeit (120 WPM) und druckbare Spickzettel." },
  { title: "Hochzeits-Hashtag Generator", url: "/de/wedding-hashtag-generator", category: "Papeterie", desc: "Kreative Hashtags für Instagram und druckbare Tischaufsteller." },
  { title: "Numerologie des Hochzeitsdatums", url: "/de/wedding-date-numerology", category: "Papeterie", desc: "Lebenswegzahl und spirituelle Bedeutung Ihres Wunsch-Hochzeitsdatums." },
  { title: "Hochzeitstage & Geschenk-Ratgeber", url: "/de/anniversary-gift-finder", category: "Papeterie", desc: "Traditionelle und moderne Geschenke von der Papier- bis zur Diamantenen Hochzeit." }
];
---

<Layout 
	title="Manage.Wedding — Kostenlose Hochzeitsplaner Rechner & Budget Tools"
	description="Private Suite interaktiver Hochzeitsrechner: Getränkerechner für die Hochzeit, Sitzplaner, Budgetrechner und druckbare Papeterie. 100% kostenlos und ohne Anmeldung."
	schema={schema}
>
	<main>
		<!-- 1. Hero: Digital Sketchbook & Live Instant Search -->
		<section class="section-paper fade-in" style="padding: 4rem 1.5rem 3rem; position: relative; overflow: hidden; border-bottom: 3px solid var(--fg-pencil);">
			
			<div class="tape" style="top: -10px;"></div>
			
			<div style="max-width: 1050px; margin: 0 auto; text-align: center; position: relative; z-index: 10;">
				
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 6px 16px; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-1deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.95rem; font-weight: 700; color: var(--fg-pencil);">100% Kostenlos • Volle Privatsphäre • Sofortige Downloads</span>
				</div>

				<h1 class="font-heading" style="font-size: clamp(36px, 6.5vw, 68px); line-height: 1.15; color: var(--fg-pencil); margin-bottom: 1.25rem;">
					Planen Sie Ihre Hochzeitszahlen <br class="hidden sm:inline" />
					<span style="color: var(--accent-blue); text-decoration: underline; text-decoration-style: wavy;">völlig stressfrei.</span>
				</h1>

				<p style="font-size: clamp(1.1rem, 2.5vw, 1.3rem); color: var(--text-secondary); max-width: 760px; margin: 0 auto 2rem; line-height: 1.6;">
					Ihr privates digitales Notizbuch für Getränkebedarf beim Sektempfang, transparente Location-Kosten, interaktive Tischpläne und druckbare Menükarten.
				</p>

				<!-- Live Instant Search Bar with Dynamic Dropdown -->
				<div style="position: relative; max-width: 650px; margin: 0 auto 2rem;">
					<div class="search-hero-box" style="margin-bottom: 0;">
						<span style="font-size: 1.3rem; color: #64748b;">🔍</span>
						<input 
							type="text" 
							id="home-tool-search" 
							class="search-hero-input" 
							placeholder="Rechner suchen: Getränke, Location, Torte, Sitzplan, Rede..."
							aria-label="Hochzeitsrechner durchsuchen"
							autocomplete="off"
						/>
						<button id="clear-search-btn" style="display: none; background: none; border: none; font-size: 1.1rem; color: #94a3b8; cursor: pointer; padding: 0 0.5rem;">✕</button>
					</div>

					<!-- Search Results Live Dropdown Popup -->
					<div id="search-dropdown-results" style="display: none; position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 4px 4px 0px var(--fg-pencil); max-height: 380px; overflow-y: auto; z-index: 100; text-align: left; padding: 0.5rem;">
						<!-- Injected by JavaScript -->
					</div>
				</div>

				<!-- Fast Shortcut Chips -->
				<div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; max-width: 800px; margin: 0 auto 2rem;">
					<span style="font-size: 0.88rem; font-weight: 600; color: #64748b; align-self: center;">Beliebte Rechner:</span>
					<a href="/de/wedding-drink-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Getränkerechner</a>
					<a href="/de/wedding-venue-cost-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🏰 Location-Kosten</a>
					<a href="/de/seating-chart-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🪑 Sitzplaner</a>
					<a href="/de/reception-menu-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">📜 Menükarten</a>
					<a href="/de/wedding-envelope-addressing" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">✉️ Umschlag-Adressierung</a>
				</div>

				<!-- Main Hero CTAs -->
				<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
					<a href="#featured-favorites" class="hand-btn" style="padding: 14px 30px; font-size: 1.15rem;">
						Beliebteste Rechner entdecken ↓
					</a>
					<a href="/de/about" class="hand-btn secondary" style="padding: 14px 26px; font-size: 1.15rem;">
						Warum Manage.Wedding?
					</a>
				</div>

			</div>
		</section>

		<!-- 2. Spotlight "Crowd Favorites" (4 Illustrated Cards) -->
		<section id="featured-favorites" style="padding: 4rem 1.5rem; max-width: 1200px; margin: 0 auto;">
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil);">
					⭐ Die Beliebtesten Rechner
				</h2>
				<p style="font-size: 1.1rem; color: var(--text-secondary); max-width: 600px; margin: 0.25rem auto 0;">
					Die am häufigsten genutzten Planungstools für Brautpaare und Hochzeitsplaner.
				</p>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 2rem;">
				
				<!-- Featured 1: Open Bar -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/wedding_bar_sketch.webp" 
						alt="Getränkerechner für die Hochzeit" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #fef08a; border-color: var(--fg-pencil); color: var(--fg-pencil);">Top Favorit</span>
						<span class="tool-time">⏱️ 2 Min.</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Getränkerechner Hochzeit</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Berechnen Sie Wein, Sekt, Bier, Spirituosen und Eiswürfel für Sektempfang und Party.
					</p>
					<a href="/de/wedding-drink-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Getränke berechnen →
					</a>
				</div>

				<!-- Featured 2: Master Budget -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/calculator_sketch.webp" 
						alt="Hochzeitsbudget Rechner" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dbeafe; border-color: #93c5fd; color: #1e40af;">Finanzen</span>
						<span class="tool-time">⏱️ 3 Min.</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Hochzeitsbudget Rechner</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Teilen Sie jedes Gesamtbudget nach den realistischen Prozentsätzen der Hochzeitsbranche auf.
					</p>
					<a href="/de/master-budget-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Budget aufteilen →
					</a>
				</div>

				<!-- Featured 3: Day-Of Timeline -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/pocket-watch-sketch.webp" 
						alt="Tagesablauf & Zeitplan Generator" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dcfce7; border-color: #86efac; color: #166534;">Logistik</span>
						<span class="tool-time">⏱️ 3 Min.</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Tagesablauf & Zeitplan</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Erstellen Sie einen minutengenauen Ablaufplan für Fotografen, Styling und Trauzeugen.
					</p>
					<a href="/de/day-of-timeline-generator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Zeitplan erstellen →
					</a>
				</div>

				<!-- Featured 4: Seating Chart -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/seating_chart_sketch.webp" 
						alt="Interaktiver Tisch- & Sitzplaner" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #f3e8ff; border-color: #d8b4fe; color: #6b21a8;">Interaktiv</span>
						<span class="tool-time">⏱️ 5 Min.</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Tisch- & Sitzplaner</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Tafeln und Rundtische anordnen, Gäste per Drag & Drop platzieren und als PDF exportieren.
					</p>
					<a href="/de/seating-chart-maker" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Sitzplan erstellen →
					</a>
				</div>

			</div>
		</section>

		<!-- 3. The 4-Phase Wedding Planning Master Roadmap -->
		<section style="background: var(--muted-paper); padding: 4.5rem 1.5rem; border-top: 3px dashed var(--fg-pencil); border-bottom: 3px dashed var(--fg-pencil);">
			<div style="max-width: 1100px; margin: 0 auto;">
				
				<div style="text-align: center; margin-bottom: 3rem;">
					<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Schritt-für-Schritt</span>
					<h2 class="font-heading" style="font-size: clamp(28px, 4.5vw, 44px); color: var(--fg-pencil);">
						Der Masterplan für Ihre Hochzeitsplanung
					</h2>
					<p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 650px; margin: 0.25rem auto 0;">
						Was Sie in jeder Phase Ihrer Hochzeitsvorbereitungen berechnen und festlegen sollten.
					</p>
				</div>

				<div style="display: flex; flex-direction: column; gap: 1.75rem;">
					
					<!-- Roadmap Step 1 -->
					<div class="hand-card" style="padding: 1.75rem; background: #fff; border-left: 6px solid var(--accent-red);">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								Phase 1: Budgetrahmen & Location-Buchung (12 bis 9 Monate vorher)
							</h3>
							<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
								Schritt 01
							</span>
						</div>
