---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "DIY Fotobox & Photo Booth Rechner für Hochzeiten",
      "url": "https://manage.wedding/de/wedding-photo-booth-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Interaktiver Rechner und Bauplan für eine tragbare PVC-Fotobox mit Arcade-Buzzer, automatisierter Software, Thermodruck und Gästebuch-Scrapbook.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="DIY Fotobox Rechner Hochzeit — Bauplan, Papier & Schritt-für-Schritt Anleitung"
	description="Berechnen Sie Instax/Polaroid-Filme, Thermopapier-Rollen, PVC-Zuschnittlisten, leuchtende Arcade-Buzzer, Raumbedarf und Gästebuch-Zubehör."
	lang="de"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/de/" style="color: var(--text-secondary); text-decoration: none;">Startseite</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/de/budget" style="color: var(--text-secondary); text-decoration: none;">Budget & Party</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">DIY Fotobox Rechner & Bauplan</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>📸</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Interaktiver Rechner + Komplette DIY-Bauanleitung</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				DIY Fotobox Rechner & Bauanleitung für die Hochzeit
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 840px; margin: 0 auto; line-height: 1.5;">
				Berechnen Sie <strong>Sofortbild-Filme, Thermopapier-Rollen, PVC-Rohre, Gästebuch</strong> und nutzen Sie unseren bewährten Bauplan für eine automatische Fotobox unter 280 €.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Interactive Controls -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<!-- Section 1: Hardware & Build Style -->
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>🛠️</span> 1. Bauweise & Druckmedium
				</h2>

				<div style="margin-bottom: 1.25rem;">
					<label for="select-booth-architecture" style="display: block; font-size: 0.85rem; font-weight: 700; color: #334155; margin-bottom: 0.35rem;">Fotobox-Typ:</label>
					<select id="select-booth-architecture" style="width: 100%; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 6px; font-size: 0.88rem; background: #fff; font-weight: 600;">
						<option value="pvc-enclosed" selected>🎪 Geschlossene PVC-Kabine (Arcade-Buzzer + Vorhänge + Innenmonitor)</option>
						<option value="open-air-ipad">📱 Offene iPad-Stele mit Ringlicht (Touchscreen + Canon Selphy)</option>
						<option value="dslr-studio">📷 Offenes DSLR-Studio (Spiegelreflex + Studioblitz + Laptop)</option>
						<option value="instax-vintage">🎞️ Vintage Sofortbild-Tisch (Fujifilm Instax / Polaroid)</option>
						<option value="pro-rental">🎩 Professioneller Mietservice (Mit Betreuung und Profi-Drucker)</option>
					</select>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="select-media-format" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Druckformat:</label>
						<select id="select-media-format" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="canon-selphy" selected>🖨️ Canon Selphy Streifen 5x15 / 10x15</option>
							<option value="instax-mini">📷 Instax Mini (Kreditkartenformat)</option>
							<option value="instax-wide">📸 Instax WIDE (Breitbild)</option>
							<option value="polaroid-itype">🎞️ Polaroid Quadratisch (i-Type/600)</option>
							<option value="dnp-pro">⚡ DNP Thermosublimation (700 Drucke)</option>
							<option value="digital-only">📲 100% Digital (AirDrop/QR)</option>
						</select>
					</div>
					<div>
						<label for="input-booth-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Gästeanzahl:</label>
						<input type="number" id="input-booth-guests" min="20" max="600" value="125" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700; font-size: 1rem;" />
					</div>
				</div>

				<!-- Section 2: Engagement & Guestbook Mode -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					📖 2. Nutzung & Gästebuch-Scrapbook
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label for="select-participation-rate" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Nutzungsrate:</label>
						<select id="select-participation-rate" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="0.60">Ruhig / Gemütlich (60% der Gäste)</option>
							<option value="0.75" selected>Standard Hochzeit (75% der Gäste)</option>
							<option value="0.90">Party-Crowd / Sehr Aktiv (90%)</option>
						</select>
					</div>
					<div>
						<label for="select-guestbook-mode" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Fotogästebuch gewünscht?</label>
						<select id="select-guestbook-mode" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="double" selected>Ja (Doppeldruck: 1 Gast + 1 Album)</option>
							<option value="single">Nein (Einzeldruck für den Gast)</option>
							<option value="triple">Gruppen (1 Ausdruck pro Person auf dem Foto)</option>
						</select>
					</div>
				</div>

				<div style="margin-bottom: 1.25rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.2rem;">
						<label for="range-waste-buffer" style="font-size: 0.82rem; font-weight: 700; color: #334155;">Sicherheitspuffer (Testfotos / Verwacklungen):</label>
						<span id="label-waste-buffer" style="font-size: 0.82rem; font-weight: 700; color: #b91c1c;">+15% Puffer</span>
					</div>
					<input type="range" id="range-waste-buffer" min="5" max="30" step="5" value="15" style="width: 100%; accent-color: var(--accent-red);" />
					<span style="font-size: 0.72rem; color: #64748b;">Deckt Testauslöser, unscharfe Schnappschüsse und Papierwechsel ab.</span>
				</div>

				<!-- Section 3: Trigger & Accessories -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🔘 3. Auslöser & Requisiten
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label for="select-trigger-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Startauslöser:</label>
						<select id="select-trigger-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="arcade-button" selected>🔴 Großer roter LED-Arcade-Buzzer (USB)</option>
							<option value="touchscreen">📱 Touchscreen-Tippen (iPad)</option>
							<option value="foot-pedal">🦶 Fußschalter-Pedal</option>
							<option value="camera-shutter">📸 Manueller Kameraauslöser</option>
						</select>
					</div>
					<div>
						<label for="select-props-tier" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Requisiten-Set:</label>
						<select id="select-props-tier" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="standard" selected>Klassisch (45 Schilder am Stab, Brillen, Hüte)</option>
							<option value="deluxe">Deluxe VIP (70 PVC-Schilder, Boas, LED-Brillen)</option>
							<option value="minimal">Edel / Minimalistisch (20 echte Sonnenbrillen & Schiefertafeln)</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Results & Supply Breakdown -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Berechnete Materialliste</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Material & Gesamtkosten
						</h2>
					</div>
					<span id="badge-total-prints" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">215 Fotos</span>
				</div>

				<!-- Highlight Hero Cards -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Film / Druckpapier</span>
						<strong id="stat-film-packs" style="font-size: 1.65rem; font-weight: 900; color: #b91c1c; line-height: 1.15;">2 Packungen Papier</strong>
						<span id="stat-film-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 3px;">(216 vorperforierte 10x15 Streifen)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Geschätzte Kosten</span>
						<strong id="stat-total-cost" style="font-size: 1.65rem; font-weight: 900; color: #1e40af; line-height: 1.15;">275 € DIY</strong>
						<span id="stat-cost-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 3px;">(Spart ~625 € ggü. Miete)</span>
					</div>
				</div>

				<!-- Itemized Shopping Breakdown -->
				<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #166534; display: block; margin-bottom: 0.4rem;">📦 Vollständige Material- & Geräteliste:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem; color: #14532d;">
						<div>• <strong id="stat-camera-spec">DSLR + Dauerstrom-Netzteil</strong></div>
						<div>• <strong id="stat-trigger-spec">4" Leuchtender Arcade-Buzzer USB</strong></div>
						<div>• <strong id="stat-frame-spec">PVC-Rahmen (Passt in Reisetasche)</strong></div>
						<div>• <strong id="stat-guestbook-spec">1 Gästebuch + 540 Klebepunkte</strong></div>
						<div>• <strong id="stat-pens-spec">6 Metallic-Gelstifte</strong></div>
						<div>• <strong id="stat-props-spec">45 Requisiten & Schilder</strong></div>
					</div>
				</div>

				<!-- Venue Clearance & Power -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">📐 Raumbedarf:</span>
						<strong id="stat-space-req" style="color: var(--fg-pencil);">1,8 x 1 m Kabine (oder 3x3 m Offen)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">⚡ Strom & Kabel:</span>
						<strong id="stat-power-req" style="color: var(--fg-pencil);">1 Steckdose + Schwarzes Gaffa-Tape</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">💻 Fotobox-Software:</span>
						<strong id="stat-software-req" style="color: #1e40af;">DSLR Remote Pro / DSLRBooth / LumaBooth</strong>
					</div>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.65rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Zuschnittliste & Tischschild drucken (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.65rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Als Word (.doc) exportieren
					</button>
				</div>
			</div>

		</div>

		<!-- Interactive Floor Plan & Space Clearance Diagram -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						📐 Interaktiver Bauplan & Raumaufteilung
					</h2>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0.2rem 0 0;">
						Wechseln Sie zwischen dem Bauplan der <strong>geschlossenen PVC-Kabine</strong> und dem des <strong>offenen Fotostudios</strong>.
					</p>
				</div>
				<div style="display: inline-flex; gap: 0.5rem;">
					<button type="button" id="btn-tab-pvc" class="hand-btn" style="background: var(--post-it); border: 2px solid var(--fg-pencil); padding: 4px 12px; border-radius: 4px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">
						🎪 Geschlossene PVC-Kabine (1,8 x 1 m)
					</button>
					<button type="button" id="btn-tab-openair" class="hand-btn" style="background: #fff; border: 2px solid var(--fg-pencil); padding: 4px 12px; border-radius: 4px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">
						📸 Offenes Studio (3 x 3 m)
					</button>
				</div>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; align-items: center;">
				
				<!-- SVG Diagram Container -->
				<div id="svg-diagram-container" style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; text-align: center;">
					
					<!-- Blueprint 1: Enclosed PVC Booth (Default) -->
					<svg id="svg-pvc-blueprint" viewBox="0 0 540 400" style="width: 100%; max-width: 500px; height: auto; display: block; margin: 0 auto;">
						<!-- Card Background -->
						<rect x="0" y="0" width="540" height="400" fill="#f8fafc" rx="8" />
						
						<!-- Top Dimension Header Badge -->
						<rect x="70" y="12" width="400" height="26" fill="#0f172a" rx="4" />
						<text x="270" y="29" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="0.5">🎪 PVC-KABINE: 1,8 M HÖHE × 1 M BREITE × 1,2 M TIEFE</text>

						<!-- Outer Booth PVC Enclosure Frame -->
						<rect x="25" y="48" width="490" height="335" fill="#ffffff" stroke="#1e293b" stroke-width="2.5" rx="8" />

						<!-- COMPARTMENT 1: Electronics & Equipment Tower -->
						<rect x="38" y="60" width="464" height="150" fill="#f0fdf4" stroke="#16a34a" stroke-width="1.5" stroke-dasharray="4 4" rx="6" />
						
						<!-- Section Label Pill -->
						<rect x="48" y="68" width="220" height="20" fill="#dcfce7" stroke="#16a34a" stroke-width="1" rx="3" />
						<text x="56" y="82" font-size="10" font-weight="bold" fill="#15803d">⚙️ TECHNIK-TURM (45 CM TIEFE)</text>

						<!-- Big Red Arcade Start Button (Left) -->
						<g transform="translate(90, 130)">
							<circle cx="0" cy="0" r="22" fill="#fee2e2" stroke="#dc2626" stroke-width="1.5" />
							<circle cx="0" cy="0" r="16" fill="#ef4444" stroke="#991b1b" stroke-width="2" />
							<text x="0" y="4" font-size="9" font-weight="bold" fill="#ffffff" text-anchor="middle">DRÜCKEN</text>
							<text x="0" y="32" font-size="9" font-weight="bold" fill="#b91c1c" text-anchor="middle">10 cm Arcade-Buzzer</text>
							<text x="0" y="44" font-size="7.5" fill="#64748b" text-anchor="middle">(USB Leertaste)</text>
						</g>

						<!-- Center Display & Camera Bezel (Middle) -->
						<g transform="translate(270, 100)">
							<!-- Bezel Frame -->
							<rect x="-85" y="-5" width="170" height="68" fill="#0f172a" rx="4" />
							<!-- 17" Screen Glass -->
							<rect x="-78" y="2" width="156" height="54" fill="#1e293b" rx="2" />
							<text x="0" y="22" font-size="10" font-weight="bold" fill="#38bdf8" text-anchor="middle">17" Monitor Live-View</text>
							<text x="0" y="36" font-size="8" fill="#94a3b8" text-anchor="middle">(Bilderrahmen 30x40 cm)</text>
							<text x="0" y="48" font-size="7.5" fill="#cbd5e1" text-anchor="middle">4-Screen Automatisierung</text>
							
							<!-- DSLR Camera Mounted Above Screen -->
							<rect x="-35" y="70" width="70" height="22" fill="#dbeafe" stroke="#2563eb" stroke-width="1.5" rx="3" />
							<text x="0" y="84" font-size="8.5" font-weight="bold" fill="#1e40af" text-anchor="middle">📷 DSLR-Kamera</text>
							<text x="0" y="102" font-size="7.5" font-weight="bold" fill="#dc2626" text-anchor="middle">⚡ Dauerstrom-Netzteil</text>
						</g>

						<!-- External Screen for Crowd (Right) -->
						<g transform="translate(445, 130)">
							<rect x="-35" y="-20" width="70" height="42" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5" rx="4" />
							<text x="0" y="-4" font-size="8.5" font-weight="bold" fill="#854d0e" text-anchor="middle">Laptop-Bildschirm</text>
							<text x="0" y="9" font-size="7.5" fill="#854d0e" text-anchor="middle">Zur Warteschlange</text>
							<text x="0" y="32" font-size="8" font-weight="bold" fill="#ca8a04" text-anchor="middle">Außen-Monitor</text>
							<text x="0" y="44" font-size="7.5" fill="#64748b" text-anchor="middle">(Lustige Posen live!)</text>
						</g>

						<!-- COMPARTMENT 2: Guest Seating Area -->
						<rect x="38" y="220" width="464" height="115" fill="#fff1f2" stroke="#f43f5e" stroke-width="1.5" stroke-dasharray="4 4" rx="6" />
						
						<!-- Section Label Pill -->
						<rect x="48" y="228" width="220" height="20" fill="#ffe4e6" stroke="#f43f5e" stroke-width="1" rx="3" />
