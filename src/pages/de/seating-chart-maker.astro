---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/seating-chart-maker/#webapp",
      "name": "Hochzeits-Sitzplan-Gestalter & Tischplaner | Manage.Wedding",
      "url": "https://manage.wedding/de/seating-chart-maker",
      "inLanguage": "de",
      "description": "Kostenloser Drag-and-Drop-Sitzplan-Gestalter für Ihre Hochzeit. Platzieren Sie zugesagte Gäste an runden Tischen, langen Tafeln oder dem Brauttisch mit Word-, PDF- und Excel-Export.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie erstellt man einen perfekten Hochzeits-Sitzplan in 4 Schritten?",
      "description": "Schritt-für-Schritt-Anleitung zur Tischplanung, Sitzordnung und dem Export für Location und Catering.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Tische & Raum-Layout konfigurieren",
          "text": "Fügen Sie runde Tische (150 cm / 180 cm Ø) oder rechteckige Tafeltische hinzu und legen Sie die Stuhlanzahl pro Tisch fest (meist 8 bis 10 Personen)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Gästegruppen nach Dynamik zusammenstellen",
          "text": "Gruppieren Sie Gäste nach Beziehungskreisen (Brautfamilie, Bräutigamfamilie, Studienfreunde, Arbeitskollegen), um harmonische Gespräche zu fördern."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Gäste per Drag & Drop zuweisen",
          "text": "Ziehen Sie Gästekarten auf die jeweiligen Tische oder nutzen Sie den 1-Klick-Zuweiser. Platzieren Sie engste Familie und Trauzeugen nahe am Brauttisch."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Druckfertigen Export für Location & Caterer erstellen",
          "text": "Laden Sie die fertige Tischordnung als Word-Dokument (.doc), PDF-Tischliste oder CSV-Excel-Datei herunter."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie viele Gäste passen an runde und rechteckige Tische?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein runder Tisch mit 150 cm Durchmesser fasst bequem 8 Personen (maximal 9). Ein 180-cm-Rundtisch bietet Platz für 10 Personen (maximal 11). Ein rechteckiger Banketttisch von 180 cm Länge fasst 6 Personen (3 pro Seite), bei 240 cm Länge 8 Personen (4 pro Seite)."
          }
        },
        {
          "@type": "Question",
          "name": "Was ist der Unterschied zwischen Brauttisch, Sweetheart Table und Königstafel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Sweetheart Table ist ein intimer Zweiertisch nur für Braut und Bräutigam. Der klassische Brauttisch platziert das Brautpaar mit Trauzeugen und Eltern in einer langen Reihe. Die Königstafel (Royal Table) ist eine breite Blocktafel, an der Brautpaar und VIPs einander gegenübersitzen."
          }
        },
        {
          "@type": "Question",
          "name": "Wann sollte die Sitzordnung finalisiert werden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Schließen Sie den Sitzplan ca. 10 bis 14 Tage vor der Hochzeit ab, sobald alle Rückmeldungen (RSVP) vorliegen. So bleibt ausreichend Zeit für den Druck von Tischkarten und Sitzplan-Leinwänden."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Sitzplan-Gestalter Hochzeit | Kostenloser Online-Tischplaner (Drag & Drop)"
	description="Hochzeits-Sitzplan online erstellen. Tische konfigurieren, Gäste per Drag-and-Drop platzieren, Tischkapazitäten überwachen und direkt nach Word, PDF oder Excel exportieren."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Sitzplan-Gestalter" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Hochzeits- <span class="accent-italic">Sitzplan-Gestalter</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Weisen Sie zugesagte Gäste runden Tischen, langen Tafeln oder dem Brauttisch zu. Exportieren Sie Ihren fertigen Tischplan direkt nach <strong>Word (.doc)</strong>, <strong>PDF</strong> oder <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- 💡 3-Step Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
				<strong class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem;">
					<span>💡</span> So funktioniert der Sitzplan-Gestalter (3 einfache Schritte)
				</strong>
				<span style="font-size: 0.85rem; color: var(--fg-pencil); font-family: var(--font-body); font-style: italic;">
					Keine Registrierung erforderlich!
				</span>
			</div>
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: var(--accent-blue); display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						1️⃣ Tische anlegen
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Klicken Sie auf <strong>"+ Tisch anlegen"</strong>. Wählen Sie Tischform (⭕ Rund, ▭ Tafel, ❤️ Brauttisch) und Stuhlanzaht (z. B. 8 oder 10).
					</p>
				</div>

				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: #15803d; display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						2️⃣ Gäste platzieren
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Ziehen Sie Karten aus <strong>Nicht zugewiesen</strong> auf Tische, nutzen Sie das Dropdown oder klicken Sie auf <strong>"⚡ Automatisch füllen"</strong>!
					</p>
				</div>

				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: var(--accent-red); display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						3️⃣ Plan exportieren
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Laden Sie den fertigen Plan mit <strong>"Word-Export"</strong> oder <strong>"PDF / Drucken"</strong> für Location und Caterer herunter.
					</p>
				</div>
			</div>
		</div>

		<!-- Overview Dashboard & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						🪑 Raumplan & Sitzordnungs-Fortschritt
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Automatisch synchronisiert mit Gästeliste & RSVP-Tracker
					</span>
				</div>

				<!-- Export & Control Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Word-Export (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ PDF / Drucken
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Excel-Export (.csv)
					</button>
					<button type="button" id="btn-add-table" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Tisch anlegen
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						🔄 Beispieldaten
					</button>
					<button type="button" id="btn-clear-seating" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🧹 Sitze leeren
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Zugesagte Gäste</span>
					<strong id="stat-total-attending" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Zu platzierende Plätze</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Platziert an Tischen</span>
					<strong id="stat-seated-count" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-seated-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% platziert</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Nicht zugewiesen</span>
					<strong id="stat-unassigned-count" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span style="font-size: 0.75rem; color: #854d0e; display: block;">Brauchen Platz</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Tische im Saal</span>
					<strong id="stat-table-count" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">0</strong>
					<span id="stat-capacity-total" style="font-size: 0.75rem; color: #1e40af; display: block;">0 Stühle gesamt</span>
				</div>
			</div>

			<!-- Dynamic Seating Progress Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Sitzplan-Fertigstellung</span>
					<span id="progress-text" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">0% Platziert</span>
				</div>
				<div style="height: 24px; border: 2px solid var(--fg-pencil); border-radius: 12px; overflow: hidden; background: #e5e0d8;">
					<div id="progress-bar-fill" style="height: 100%; width: 0%; background-color: #22c55e; transition: width 0.3s ease;"></div>
				</div>
			</div>
		</div>

		<!-- Interactive Seating Studio Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 340px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="seating-workspace-grid">
			
			<!-- Left Column: Unassigned Guests Tray + Quick Add -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						👥 Nicht zugewiesen (<span id="unassigned-badge-count">0</span>)
					</h3>
					<button type="button" id="btn-auto-assign" class="hand-btn secondary" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">
						⚡ Auto-Füllen
					</button>
				</div>

				<!-- Search Unassigned -->
				<div style="margin-bottom: 0.75rem;">
					<input type="text" id="unassigned-search" placeholder="🔍 Gast suchen..." style="width: 100%; box-sizing: border-box; padding: 0.55rem 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: var(--bg-paper); color: var(--fg-pencil);">
				</div>

				<!-- Drop Zone for Unassigned -->
				<div id="unassigned-dropzone" class="drop-zone" data-table-id="unassigned" style="min-height: 240px; max-height: 480px; overflow-y: auto; padding: 0.5rem; border: 2px dashed var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); display: flex; flex-direction: column; gap: 0.5rem;">
					<!-- Injected via JS -->
				</div>

				<!-- Quick Add Guest Directly -->
				<div style="margin-top: 1.25rem; border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
					<label for="quick-guest-name" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						➕ Schnelleingabe Gast:
					</label>
					<form id="quick-add-guest-form" style="display: flex; gap: 0.4rem; align-items: center;">
						<input type="text" id="quick-guest-name" required placeholder="Name des Gastes..." style="flex: 1; min-width: 0; padding: 0.55rem 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: var(--bg-paper); color: var(--fg-pencil);">
						<select id="quick-guest-party" title="Personen (Plätze)" style="width: 78px; padding: 0.55rem 0.25rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff; color: var(--fg-pencil);">
							<option value="1">1 Platz</option>
							<option value="2" selected>2 Plätze</option>
							<option value="3">3 Plätze</option>
							<option value="4">4 Plätze</option>
							<option value="5">5 Plätze</option>
						</select>
						<button type="submit" class="hand-btn" style="padding: 0.55rem 0.85rem; font-size: 0.95rem; white-space: nowrap;">
							➕ Neu
						</button>
					</form>
				</div>

			</div>

			<!-- Right Column: Interactive Reception Tables Layout Grid -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h3 class="font-heading" style="font-size: 1.4rem; margin: 0; color: var(--fg-pencil);">
							🍽️ Tische im Festsaal
						</h3>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
							Karten auf Tische ziehen oder über das Tisch-Dropdown zuweisen
						</span>
					</div>
					
					<button type="button" id="btn-add-table-top" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
						➕ Neuer Tisch
					</button>
				</div>

				<!-- Tables Grid Container -->
				<div id="tables-grid-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;">
					<!-- Injected via JS -->
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Offizieller Hochzeits-Sitzplan</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportiert am: <span id="print-date"></span> | Platzierte Gäste: <span id="print-seated-count"></span></p>
			</div>
			<div id="print-tables-content"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Auf einen Blick (BLUF): Tischgrößen & Abstände
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					1-Minuten Richtwerte
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Tischmaße & Personenanzahl:</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">150 cm Rundtisch = 8–9 Personen</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">180 cm Rundtisch = 10–11 Personen</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">240 cm Tafeltisch = 8–10 Personen</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Laufweg-Abstand:</strong> Halten Sie mindestens <strong>150 cm Tischkante-zu-Tischkante</strong> ein, damit Gäste ihre Stühle bequem zurückschieben können und der Service mit Serviertabletts ungehindert passieren kann.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Tischform / Format</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Abmessungen</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Bequeme Belegung</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Maximale Belegung</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Tischwäsche-Größe</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Mindestabstand</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Brauttisch (Sweetheart)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">90–120 cm Halbrund / Rechteck</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">2 Personen (Brautpaar)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">2</td>
