---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/day-of-timeline-generator/#webapp",
      "name": "Tagesablauf- & Zeitplan-Generator Hochzeit | Manage.Wedding",
      "url": "https://manage.wedding/de/day-of-timeline-generator",
      "inLanguage": "de",
      "description": "Kostenloser Zeitplan-Generator für den Hochzeitstag. Erstellen Sie einen stressfreien Tagesablauf basierend auf Trauung, First Look, Sektempfang, Abendessen und Pufferzeiten. Export nach Word, PDF und Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie funktioniert dieser Zeitplan-Generator für die Hochzeit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Geben Sie die Uhrzeit Ihrer Trauung ein, wählen Sie, ob Sie einen First Look (Paarfotos vor der Trauung) planen, und tragen Sie die Fahrzeit zur Location ein. Der Rechner berechnet den gesamten Tagesablauf vorwärts und rückwärts – vom Styling am Morgen bis zum Mitternachtssnack."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel Pufferzeit sollte man am Hochzeitstag einplanen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wir empfehlen mindestens 30 Minuten Puffer beim Styling, 15 Minuten Puffer auf die geschätzte Fahrtzeit und 15 Minuten vor dem Einzug der Gäste. Unvorhergesehene Verzögerungen sind normal und Puffer verhindern Hektik."
          }
        },
        {
          "@type": "Question",
          "name": "Wann sollten die Danksagungen und Dienstleister-Abläufe verteilt werden?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Der vorläufige Ablaufplan sollte 3 bis 4 Wochen vor der Hochzeit an Fotograf, Location, DJ und Trauzeugen gesendet werden. Die finale Version (per Word-/PDF-Export) verteilen Sie 1 Woche vor der Feier."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Wie erstellt man einen perfekten Tagesablauf für die Hochzeit?",
      "description": "Schritt-für-Schritt-Leitfaden für einen entspannten Ablaufplan vom Getting Ready bis zum Eröffnungstanz.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Beginn der Trauung als Ankerpunkt festlegen",
          "text": "Die Uhrzeit der Trauzeremonie (z. B. 14:00 Uhr oder 15:30 Uhr) bildet den festen Anker für alle vor- und nachgelagerten Programmpunkte."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: First Look vs. Fotos beim Sektempfang entscheiden",
          "text": "Entscheiden Sie, ob Sie die Paarfotos vor der Trauung (First Look) machen möchten, um den Sektempfang voll mit den Gästen zu genießen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Styling-Dauer kalkulieren",
          "text": "Rechnen Sie ca. 45 Minuten pro Brautjungfer und 90–120 Minuten für Braut-Haare & Make-up ein."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Abendessen & Reden timen",
          "text": "Planen Sie 90 bis 120 Minuten für das Hochzeitsmenü/Buffet ein und verteilen Sie kurze Reden (max. 3–5 Min.) zwischen den Gängen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 5: Ablaufplan exportieren und verteilen",
          "text": "Exportieren Sie den Master-Ablaufplan nach Word (.doc) oder druckbarem PDF und teilen Sie ihn mit Trauzeugen und Dienstleistern."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Tagesablauf- & Zeitplan-Generator Hochzeit | Word & PDF Export"
	description="Erstellen Sie den perfekten Ablaufplan für Ihren Hochzeitstag. Styling, First Look, Trauung, Sektempfang, Abendessen & Party mit Pufferzeiten. Export nach Word (.doc), PDF und Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Tagesablauf- & Zeitplan-Generator" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Tagesablauf- & Zeitplan-Generator <span class="accent-italic">Hochzeit</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Planen Sie Ihren Hochzeitstag auf die Minute genau – stressfrei und mit optimalen Puffern. Inklusive Export nach <strong>Word (.doc)</strong>, <strong>PDF</strong> und <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Timeline Builder Controls & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						⏱️ Ablaufplan-Konfigurator & Regieplan
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Automatische Vor- und Rückwärtskalkulation ab Trauungsuhrzeit
					</span>
				</div>

				<!-- Export & Control Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Word-Export (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ PDF / Drucken
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Excel (.csv)
					</button>
					<button type="button" id="btn-copy-summary" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📋 Text kopieren
					</button>
				</div>
			</div>

			<!-- Preset Timeline Quick Switcher -->
			<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
				<span class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
					⚡ Typischen Hochzeits-Ablauf wählen:
				</span>
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" id="preset-buttons-container">
					<button type="button" class="preset-btn active-preset" data-ceremony="15:00" data-firstlook="yes" data-travel="15" data-reception="5">
						🌅 Klassischer Nachmittag (15:00 Uhr • First Look)
					</button>
					<button type="button" class="preset-btn" data-ceremony="16:30" data-firstlook="yes" data-travel="10" data-reception="5">
						🌇 Sommerabend (16:30 Uhr • Golden Hour Fotos)
					</button>
					<button type="button" class="preset-btn" data-ceremony="14:00" data-firstlook="no" data-travel="20" data-reception="5.5">
						⛪ Kirchliche Trauung (14:00 Uhr • Fotos beim Sektempfang)
					</button>
					<button type="button" class="preset-btn" data-ceremony="11:30" data-firstlook="yes" data-travel="10" data-reception="4">
						🥞 Standesamt & Mittags-Brunch (11:30 Uhr)
					</button>
				</div>
			</div>

			<!-- Core Configuration Form Inputs -->
			<form id="timeline-form" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; align-items: end;">
				<div>
					<label for="ceremony-time" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						Beginn der Trauung
					</label>
					<input type="time" id="ceremony-time" value="15:00" required style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: var(--bg-paper);">
				</div>

				<div>
					<label for="first-look" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						First Look (Fotos vor der Trauung)?
					</label>
					<select id="first-look" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: #fff;">
						<option value="yes" selected>Ja (Brautpaar-Shooting vor der Trauung)</option>
						<option value="no">Nein (Fotos während des Sektempfangs)</option>
					</select>
				</div>

				<div>
					<label for="travel-time" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						Fahrzeit zur Location (Minuten)
					</label>
					<input type="number" id="travel-time" min="0" max="180" value="15" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: var(--bg-paper);">
				</div>

				<div>
					<label for="reception-hours" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						Dauer der Abendfeier (Stunden)
					</label>
					<select id="reception-hours" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: #fff;">
						<option value="4">4,0 Stunden</option>
						<option value="5" selected>5,0 Stunden (Standard)</option>
						<option value="6">6,0 Stunden</option>
						<option value="7">7,0 Stunden (Open-End Party)</option>
					</select>
				</div>
			</form>
		</div>

		<!-- Main Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 340px; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="timeline-workspace-grid">
			
			<!-- Left: Master Visual Vertical Timeline Stream -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Header & Audience Filter Tabs -->
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h3 class="font-heading" style="font-size: 1.4rem; margin: 0; color: var(--fg-pencil);">
							📋 Regieplan & Tagesablauf
						</h3>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
							Programmpunkte anpassen oder eigene Meilensteine ergänzen
						</span>
					</div>

					<!-- Role Filter Pills -->
					<div style="display: flex; gap: 0.3rem; flex-wrap: wrap;" id="role-filter-group">
						<button type="button" class="role-pill-btn active-role" data-role="all">Alle Punkte</button>
						<button type="button" class="role-pill-btn" data-role="wedding-party">👰 Brautpaar & Trauzeugen</button>
						<button type="button" class="role-pill-btn" data-role="photo">📸 Foto & Video</button>
						<button type="button" class="role-pill-btn" data-role="reception">🍽️ Feier & Gastronomie</button>
					</div>
				</div>

				<!-- Vertical Timeline Container -->
				<div id="timeline-stream" class="timeline-stream-box" style="position: relative; padding-left: 2.25rem; border-left: 3px solid var(--fg-pencil); margin-left: 1rem;">
					<!-- Injected via JS -->
				</div>

			</div>

			<!-- Right: Custom Milestone Adder & Buffer Checklist -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Add Custom Milestone Card -->
				<div class="hand-card" style="padding: 1.25rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
						<span>➕</span> Eigenen Meilenstein hinzufügen
					</h3>
					
					<form id="add-custom-event-form" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<div>
							<label for="custom-event-name" class="font-heading" style="display: block; font-size: 0.85rem; margin-bottom: 0.2rem;">Titel des Programmpunkts</label>
							<input type="text" id="custom-event-name" required placeholder="z. B. Wunderkerzen-Spalier, Brautentführung" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.95rem; background: var(--bg-paper);">
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<label for="custom-event-time" class="font-heading" style="display: block; font-size: 0.85rem; margin-bottom: 0.2rem;">Uhrzeit</label>
								<input type="time" id="custom-event-time" required value="21:30" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.9rem; background: var(--bg-paper);">
							</div>
							<div>
								<label for="custom-event-role" class="font-heading" style="display: block; font-size: 0.85rem; margin-bottom: 0.2rem;">Kategorie</label>
								<select id="custom-event-role" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
									<option value="reception">Feier & Gastronomie</option>
									<option value="wedding-party">Brautpaar & Trauzeugen</option>
									<option value="photo">Foto & Video</option>
								</select>
							</div>
						</div>

						<button type="submit" class="hand-btn" style="padding: 0.5rem; font-size: 0.95rem; margin-top: 0.25rem;">
							✨ Zum Ablaufplan hinzufügen
						</button>
					</form>
				</div>

				<!-- Essential Day-Of Timing Rules Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.5rem;">
						📌 Die 15-Minuten-Pufferregel:
					</strong>
					<ul class="font-body" style="font-size: 0.85rem; line-height: 1.5; padding-left: 1.1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Styling (H&M):</strong> Mindestens 30 Min. vor Abfahrt fertig sein.</li>
						<li><strong>Fahrtzeit:</strong> Rechnen Sie stets +15 Min. Reserve für Parkplatz und Verkehr ein.</li>
						<li><strong>Trauung:</strong> Planen Sie 10 Min. Verzögerung für das Platznehmen ein.</li>
						<li><strong>Golden Hour Fotos:</strong> Ca. 45 Min. vor Sonnenuntergang einplanen.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Offizieller Hochzeits-Ablaufplan</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportiert am: <span id="print-date"></span> | Beginn der Trauung: <span id="print-ceremony-time"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; width: 90px; text-align: left;">Uhrzeit</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Programmpunkt / Meilenstein</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 140px; text-align: left;">Kategorie</th>
					</tr>
				</thead>
				<tbody id="print-timeline-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Auf einen Blick (BLUF)</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Zeitplan-Faustregeln für den Hochzeitstag
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>Die 1-Minuten-Formel:</strong> Die Trauung ist der feste Fixpunkt. Rechnen Sie <strong>90–120 Min.</strong> für Braut-Styling, <strong>45–60 Min.</strong> für First Look & Paarfotos, <strong>60–90 Min.</strong> für den Sektempfang und <strong>90–120 Min.</strong> für das Abendessen ein. Reden sollten maximal 3 bis 4 Minuten dauern.
			</p>
			
			<!-- Benchmark Milestone Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Programmpunkt</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Empfohlene Dauer</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Ideales Timing</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Profi-Tipp für Puffer</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Styling (Haare & Make-up)</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">45 Min./Begleitung; 90–120 Min. Braut</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">1 Std. vor Abfahrt fertig</td>
							<td style="padding: 0.6rem 0.8rem;">Braut als Vorletzte stylen lassen, nicht ganz zum Schluss</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">First Look & Brautpaarfotos</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">45–60 Minuten</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">2,5 Std. vor der Trauung</td>
							<td style="padding: 0.6rem 0.8rem;">Ungestörter Moment; nimmt die Nervosität vor dem Einzug</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Trauzeremonie</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">30–45 Minuten (Kirche: 60 Min.)</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Fester Kernzeitpunkt (z. B. 15:00 Uhr)</td>
							<td style="padding: 0.6rem 0.8rem;">Musik startet 20 Min. vorher beim Eintreffen der Gäste</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Gratulation & Sektempfang</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">60–90 Minuten</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Direkt nach der Trauung</td>
							<td style="padding: 0.6rem 0.8rem;">Fingerfood bereitstellen, damit kein Gast hungrig wird</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Hochzeitsdinner & Reden</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">90–120 Minuten</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">18:30 Uhr – 20:30 Uhr</td>
							<td style="padding: 0.6rem 0.8rem;">Reden zwischen den Gängen halten (je max. 3–4 Min.)</td>
						</tr>
						<tr>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Party, Eröffnungstanz & Torte</td>
