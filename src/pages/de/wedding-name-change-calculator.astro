	<!-- Skripte -->
	<script is:inline>
		const p1First = document.getElementById('p1-first');
		const p1Middle = document.getElementById('p1-middle');
		const p1Maiden = document.getElementById('p1-maiden');
		const p2First = document.getElementById('p2-first');
		const p2Surname = document.getElementById('p2-surname');
		const namingFormatSelect = document.getElementById('naming-format-select');

		const previewFullLegal = document.getElementById('preview-full-legal');
		const previewMonogram = document.getElementById('preview-monogram');
		const previewRouteBadge = document.getElementById('preview-route-badge');
		const previewEmail = document.getElementById('preview-email');

		const displayTotalFee = document.getElementById('display-total-fee');
		const displayTotalWeeks = document.getElementById('display-total-weeks');
		const progressText = document.getElementById('progress-text');
		const progressBarFill = document.getElementById('progress-bar-fill');

		const inputCertCopies = document.getElementById('input-cert-copies');
		const inputCertRate = document.getElementById('input-cert-rate');
		const feeItem1 = document.getElementById('fee-item-1');
		const inputPersoFee = document.getElementById('input-perso-fee');
		const feeItem2 = document.getElementById('fee-item-2');
		const inputPassFee = document.getElementById('input-pass-fee');
		const feeItem3 = document.getElementById('fee-item-3');
		const inputKfzFee = document.getElementById('input-kfz-fee');
		const feeItem4 = document.getElementById('fee-item-4');

		const taskCheckboxes = document.querySelectorAll('.task-checkbox');

		const btnFilterAll = document.getElementById('btn-filter-all');
		const btnFilterVital = document.getElementById('btn-filter-vital');
		const btnFilterTravel = document.getElementById('btn-filter-travel');
		const btnCheckAll = document.getElementById('btn-check-all');

		const btnExportPdf = document.getElementById('btn-export-pdf');
		const btnExportDoc = document.getElementById('btn-export-doc');
		const btnCopyChecklist = document.getElementById('btn-copy-checklist');

		function cap(str) {
			if (!str) return '';
			return str.trim().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ');
		}

		function sanitizeForEmail(str) {
			return str.toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss').replace(/[^a-z0-9]/g, '');
		}

		function updatePersona() {
			const f1 = cap(p1First.value) || 'Anna';
			const m1 = cap(p1Middle.value) || 'Maria';
			const maid = cap(p1Maiden.value) || 'Weber';
			const sp = cap(p2Surname.value) || 'Hoffmann';
			const format = namingFormatSelect.value;

			let newFullName = '';
			let monogram = '';

			switch (format) {
				case 'take-spouse':
					newFullName = `${f1} ${m1} ${sp}`;
					monogram = `${f1.charAt(0)} ${sp.charAt(0)} ${m1 ? m1.charAt(0) : maid.charAt(0)}`;
					break;
				case 'hyphenated-1':
					newFullName = `${f1} ${m1} ${maid}-${sp}`;
					monogram = `${f1.charAt(0)} ${maid.charAt(0)} ${sp.charAt(0)}`;
					break;
				case 'hyphenated-2':
					newFullName = `${f1} ${m1} ${sp}-${maid}`;
					monogram = `${f1.charAt(0)} ${sp.charAt(0)} ${maid.charAt(0)}`;
					break;
				case 'keep-maiden':
					newFullName = `${f1} ${m1} ${maid}`;
					monogram = `${f1.charAt(0)} ${maid.charAt(0)} ${m1 ? m1.charAt(0) : 'W'}`;
					break;
				default:
					newFullName = `${f1} ${m1} ${sp}`;
					monogram = `${f1.charAt(0)} ${sp.charAt(0)} ${maid.charAt(0)}`;
			}

			previewFullLegal.textContent = newFullName;
			previewMonogram.textContent = monogram.toUpperCase();

			const cleanFirst = sanitizeForEmail(f1);
			const cleanLast = format === 'keep-maiden' ? sanitizeForEmail(maid) : sanitizeForEmail(sp);
			previewEmail.textContent = `${cleanFirst}.${cleanLast}@unternehmen.de`;
		}

		function calculateFees() {
			const copies = parseInt(inputCertCopies.value, 10) || 3;
			const rate = parseFloat(inputCertRate.value) || 12;
			const certTotal = copies * rate;
			feeItem1.textContent = `${certTotal.toFixed(2).replace('.', ',')} €`;

			const persoFee = parseFloat(inputPersoFee.value) || 0;
			feeItem2.textContent = `${persoFee.toFixed(2).replace('.', ',')} €`;

			const passFee = parseFloat(inputPassFee.value) || 0;
			feeItem3.textContent = `${passFee.toFixed(2).replace('.', ',')} €`;

			const kfzFee = parseFloat(inputKfzFee.value) || 0;
			feeItem4.textContent = `${kfzFee.toFixed(2).replace('.', ',')} €`;

			const total = certTotal + persoFee + passFee + kfzFee;
			displayTotalFee.textContent = `${total.toFixed(2).replace('.', ',')} €`;

			let checkedCount = 0;
			taskCheckboxes.forEach(chk => { if (chk.checked) checkedCount++; });

			const totalTasks = taskCheckboxes.length;
			const pct = Math.round((checkedCount / totalTasks) * 100);
			progressText.textContent = `${checkedCount} von ${totalTasks} Schritten erledigt (${pct}%)`;
			progressBarFill.style.width = `${pct}%`;
		}

		btnFilterAll.addEventListener('click', () => {
			document.querySelectorAll('.checklist-stage').forEach(st => st.style.display = 'block');
			btnFilterAll.style.background = 'var(--fg-pencil)';
			btnFilterAll.style.color = '#fff';
			btnFilterVital.style.background = '#fff';
			btnFilterVital.style.color = 'var(--fg-pencil)';
			btnFilterTravel.style.background = '#fff';
			btnFilterTravel.style.color = 'var(--fg-pencil)';
		});

		btnFilterVital.addEventListener('click', () => {
			document.querySelectorAll('.checklist-stage').forEach(st => {
				st.style.display = st.getAttribute('data-stage') === 'vital' ? 'block' : 'none';
			});
			btnFilterVital.style.background = 'var(--fg-pencil)';
			btnFilterVital.style.color = '#fff';
			btnFilterAll.style.background = '#fff';
			btnFilterAll.style.color = 'var(--fg-pencil)';
			btnFilterTravel.style.background = '#fff';
			btnFilterTravel.style.color = 'var(--fg-pencil)';
		});

		btnFilterTravel.addEventListener('click', () => {
			document.querySelectorAll('.checklist-stage').forEach(st => {
				st.style.display = st.getAttribute('data-stage') === 'travel' ? 'block' : 'none';
			});
			btnFilterTravel.style.background = 'var(--fg-pencil)';
			btnFilterTravel.style.color = '#fff';
			btnFilterAll.style.background = '#fff';
			btnFilterAll.style.color = 'var(--fg-pencil)';
			btnFilterVital.style.background = '#fff';
			btnFilterVital.style.color = 'var(--fg-pencil)';
		});

		btnCheckAll.addEventListener('click', () => {
			taskCheckboxes.forEach(chk => { chk.checked = false; });
			calculateFees();
		});

		btnCopyChecklist.addEventListener('click', () => {
			const legalName = previewFullLegal.textContent;
			const totalCost = displayTotalFee.textContent;

			let text = `💍 BEHÖRDEN-CHECKLISTE NAMENSÄNDERUNG NACH DER HOCHZEIT\n`;
			text += `====================================================\n`;
			text += `Neuer Name: ${legalName}\n`;
			text += `Amtliche Gebühren: ${totalCost}\n\n`;
			text += `[ ] 1. Standesamt Eheurkunden (${feeItem1.textContent})\n`;
			text += `[ ] 2. Personalausweis im Bürgeramt (${feeItem2.textContent})\n`;
			text += `[ ] 3. Reisepass & biometrische Fotos (${feeItem3.textContent})\n`;
			text += `[ ] 4. Führerschein & Kfz-Schein (${feeItem4.textContent})\n`;
			text += `[ ] 5. Finanzamt (Steuerklassenwechsel)\n`;
			text += `[ ] 6. Krankenkasse (neue eGK Karte)\n`;
			text += `[ ] 7. Arbeitgeber & Personalabteilung\n`;
			text += `[ ] 8. Bankkonten, Freistellungsauftrag & Verträge\n\n`;
			text += `Erstellt auf Manage.Wedding`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnCopyChecklist.innerHTML;
				btnCopyChecklist.innerHTML = '<span>✅</span> In die Zwischenablage kopiert!';
				setTimeout(() => { btnCopyChecklist.innerHTML = orig; }, 2500);
			});
		});

		btnExportDoc.addEventListener('click', () => {
			const legalName = previewFullLegal.textContent;
			const totalCost = displayTotalFee.textContent;
			const dateStr = new Date().toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });

			const html = `
				<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
				<head><meta charset="utf-8"><title>Namensänderung — ${legalName}</title></head>
				<body style="font-family: Calibri, sans-serif; padding: 24px;">
					<h1>💍 Checkliste Namensänderung & Behördengänge nach der Hochzeit</h1>
					<p>Erstellt am ${dateStr} • Manage.Wedding</p>
					<p><strong>Neuer Name:</strong> ${legalName}</p>
					<p><strong>Amtliche Gesamtkosten:</strong> ${totalCost}</p>
					<h3>Behördliche Schritte:</h3>
					<ol>
						<li>Standesamt Eheurkunden (${feeItem1.textContent})</li>
						<li>Personalausweis im Bürgeramt (${feeItem2.textContent})</li>
						<li>Reisepass (${feeItem3.textContent})</li>
						<li>Führerschein & Kfz-Schein (${feeItem4.textContent})</li>
						<li>Finanzamt (Steuerklassenwechsel)</li>
						<li>Krankenkasse</li>
						<li>Arbeitgeber / HR</li>
						<li>Banken & Versicherungen</li>
					</ol>
				</body></html>
			`;

			const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = `Namensaenderung_${sanitizeForEmail(legalName)}.doc`;
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(url);
		});

		btnExportPdf.addEventListener('click', () => { window.print(); });

		[p1First, p1Middle, p1Maiden, p2First, p2Surname, namingFormatSelect, inputCertCopies, inputCertRate, inputPersoFee, inputPassFee, inputKfzFee].forEach(el => {
			if (el) {
				el.addEventListener('input', () => { updatePersona(); calculateFees(); });
				el.addEventListener('change', () => { updatePersona(); calculateFees(); });
			}
		});

		taskCheckboxes.forEach(chk => { chk.addEventListener('change', calculateFees); });

		updatePersona();
		calculateFees();
	</script>
</Layout>
