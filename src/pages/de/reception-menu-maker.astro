---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Menükarten-Gestalter Hochzeit | Menükarten drucken & Vektor-PDF (Kostenlos)";
const description = "Gestalten und drucken Sie elegante Menükarten für Ihre Hochzeit in wenigen Minuten. Gänge, Allergene, edle Schriften (Playfair, Cinzel, Alex Brush), DIN Lang & A5 Formate, kostenloser PDF-Download.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/reception-menu-maker/#webapp",
      "name": "Menükarten-Gestalter Hochzeit & Druckvorlagen-Designer",
      "url": "https://manage.wedding/de/reception-menu-maker",
      "inLanguage": "de",
      "description": "Erstellen und drucken Sie stilvolle Menükarten für die Hochzeit. Passen Sie Gänge, Schriften (Playfair, Cinzel, Alex Brush, Cormorant), Formate (DIN Lang, DIN A5, A4) an und laden Sie druckfertige Vektor-PDFs herunter.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie gestaltet und druckt man elegante Menükarten für die Hochzeit?",
      "description": "Schritt-für-Schritt-Anleitung zur Formulierung, Gestaltung und zum Druck von Restaurant-Qualitäts-Menükarten.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Gästewünsche & Unverträglichkeiten erfassen",
          "text": "Überprüfen Sie Ihre Rückmeldungen (RSVP) auf vegetarische (V), vegane (VG), glutenfreie (GF) oder laktosefreie (LF) Menüwünsche."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Design-Thema & Typografie wählen",
          "text": "Wählen Sie zwischen klassischer Serifenschrift, feiner Kalligrafie oder moderner Typografie passend zu Ihrer Hochzeitspapeterie."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Gänge & Speisenbeschreibungen anpassen",
          "text": "Tragen Sie Vorspeisen, Hauptgänge, Desserts und den Mitternachtssnack mit ansprechenden kulinarischen Details ein."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Format & Papiergewicht wählen",
          "text": "Wählen Sie DIN Lang (10 × 21 cm für die Serviette) oder DIN A5 (für Tischaufsteller) und drucken Sie auf 250–350 g/m² Feinstpapier."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Welches Format ist Standard für Menükarten bei der Hochzeit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Das beliebteste Standardformat ist DIN Lang (ca. 10 × 21 cm), da es perfekt in gefaltete Stoffservietten gesteckt oder auf den Platzteller gelegt werden kann. Für Tischaufsteller (1–2 Karten pro Tisch) wird meist DIN A5 verwendet."
          }
        },
        {
          "@type": "Question",
          "name": "Welches Papiergewicht (Grammatur) sollte man für Menükarten wählen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Empfohlen wird Feinstpapier oder Karton mit 250 g/m² bis 350 g/m² (z. B. Büttenpapier, Leinenstruktur, Naturpapier oder mattes Kraftpapier). Dadurch stehen und liegen die Karten stabil und wellen sich nicht bei Raumfeuchtigkeit."
          }
        },
        {
          "@type": "Question",
          "name": "Braucht jeder Gast eine eigene Menükarte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei einem servierten Menü empfiehlt der Hochzeitsknigge eine individuelle Menükarte pro Gast/Gedeck. Bei einem Buffet oder Family-Style reichen 2 Aufsteller pro Tisch oder eine große Schiefertafel/Staffelei am Buffetanfang."
          }
        },
        {
          "@type": "Question",
          "name": "Wie kennzeichnet man Allergene und vegetarische Gerichte auf der Karte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fügen Sie dezente Kürzel hinter den Gerichten ein: (V) für Vegetarisch, (VG) für Vegan, (GF) für Glutenfrei und (LF) für Laktosefrei, ergänzt durch eine kleine Legende am Kartenende."
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} schema={schema}>
  <!-- Import Elegant Wedding Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    <Breadcrumb title="Menükarten-Gestalter" category="dining" />
    
    <!-- Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Druckfertige Vektor-PDF & Kalligrafie</span>
      <h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Hochzeits- <span class="accent-italic">Menükarten-Gestalter</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 760px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Gestalten Sie stilvolle Menükarten in Sekunden. Wählen Sie edle Schriften, florale Ornamente, DIN Lang oder DIN A5 Formate und laden Sie druckfertige Vektor-PDFs kostenlos herunter.
      </p>
    </header>

    <!-- Main Studio Grid -->
    <div id="app-area" class="fade-in" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2.5rem; align-items: start; margin-bottom: 3.5rem;">

      <!-- Hidden images used for jsPDF generation -->
      <img id="floral-tl" src="/images/floral-tl.webp" alt="Botanical corner top left" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-tr" src="/images/floral-tr.webp" alt="Botanical corner top right" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-bl" src="/images/floral-bl.webp" alt="Botanical corner bottom left" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-br" src="/images/floral-br.webp" alt="Botanical corner bottom right" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />

      <!-- ===== LEFT COLUMN: DESIGN CONTROLS & EDITOR ===== -->
      <div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
          <h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
            1. Design, Stil & Typografie
          </h2>
          <span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
            Live-Studio
          </span>
        </div>

        <!-- Design Theme Selector -->
        <div class="form-group">
          <label class="form-label" for="themePicker">Design-Stil & Farbwelt</label>
          <select id="themePicker" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc;">
            <option value="botanical" selected>🌿 Botanischer Garten (Pergament, Zierlinien & Eukalyptus)</option>
            <option value="black-tie">👑 Black-Tie Luxus (Reines Weiß & feine Konturlinie)</option>
            <option value="romantic">🌸 Romantische Kalligrafie & Roségold-Akzente</option>
            <option value="rustic">📜 Rustikales Kraftpapier & Scheunenhochzeit</option>
            <option value="minimalist">✨ Modern Skandinavisch (Klar & Randlos)</option>
          </select>
        </div>

        <!-- Typography / Font Pairings -->
        <div class="form-group">
          <label class="form-label" for="fontPicker">Schriftart & Überschriftenstil</label>
          <select id="fontPicker" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc;">
            <option value="playfair" selected>🏛️ Playfair Display (Klassische Editorial-Serife)</option>
            <option value="cinzel">👑 Cinzel / Imperial Trajan (Feierlich & Festlich)</option>
            <option value="cormorant">📜 Cormorant Garamond (Elegante Alt-Serife)</option>
            <option value="script">✍️ Alex Brush Kalligrafie (Fließende Handschrift)</option>
            <option value="modern">📐 Montserrat (Moderne, klare Groteskschrift)</option>
          </select>
        </div>

        <!-- Card Dimensions / Format -->
        <div class="form-group">
          <label class="form-label" for="sizePicker">Kartenformat</label>
          <select id="sizePicker" class="form-input" style="cursor: pointer; font-weight: 600;">
            <option value="dl" selected>📇 DIN Lang / 10 × 21 cm (Servietten-Einleger / Platzteller — Der Favorit)</option>
            <option value="a5">📜 DIN A5 / 15 × 21 cm (Tischaufsteller / Menükarte pro Tisch)</option>
            <option value="a4">📄 DIN A4 (Buffet- & Stationen-Aufsteller)</option>
          </select>
        </div>

        <!-- Header Names & Date -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
          <div>
            <label class="form-label" for="coupleNames">Brautpaar-Namen</label>
            <input id="coupleNames" class="form-input" type="text" value="Sophie & Maximilian" style="font-weight: 600;" />
          </div>
          <div>
            <label class="form-label" for="weddingDate">Datum / Untertitel</label>
            <input id="weddingDate" class="form-input" type="text" value="18. Juli 2026" style="font-weight: 600;" />
          </div>
        </div>

        <!-- Header Title Text -->
        <div class="form-group" style="margin-top: 0.75rem;">
          <label class="form-label" for="menuTitle">Titel der Menükarte</label>
          <input id="menuTitle" class="form-input" type="text" value="HOCHZEITSMENÜ" style="font-weight: 700; letter-spacing: 2px;" />
        </div>

        <!-- Courses Section Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin: 1.5rem 0 0.75rem 0; border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
          <h3 class="font-heading" style="font-size: 1.25rem; margin: 0; color: var(--fg-pencil);">
            2. Gänge & Speisenfolge
          </h3>
          <span style="font-size: 0.8rem; color: var(--text-secondary);">Ein Gericht pro Zeile</span>
        </div>

        <!-- Dynamic courses list -->
        <div id="course-list"></div>

        <!-- Add Course Button -->
        <button id="addCourseBtn" type="button" class="menu-add-btn" style="margin-bottom: 1.5rem;">
          + Weiteren Gang / Zwischengang hinzufügen
        </button>

        <!-- Dietary Key Toggle -->
        <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1.5rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.92rem; font-weight: 600;">
            <input type="checkbox" id="check-dietary-key" checked style="width: 18px; height: 18px;" />
            <span>Allergen- & Ernährungs-Legende anzeigen (V, VG, GF, LF)</span>
          </label>
        </div>

        <!-- Download & Export Actions -->
        <div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
          <button id="printMenuBtn" class="hand-btn" style="width: 100%; padding: 12px; font-size: 1.05rem; gap: 0.5rem;">
            <span>🖨️</span> Menükarte hochauflösend drucken (PDF)
          </button>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
            <button id="downloadVectorPdfBtn" class="hand-btn secondary" style="padding: 10px; font-size: 0.92rem; gap: 0.35rem;">
              <span>📥</span> Vektor-PDF
            </button>
            <button id="exportDocBtn" class="hand-btn secondary" style="padding: 10px; font-size: 0.92rem; gap: 0.35rem;">
              <span>📄</span> Word-Export
            </button>
          </div>
          
          <p class="font-body" style="font-size: 0.82rem; color: var(--text-secondary); text-align: center; margin: 0;">
            Kristallklarer Vektordruck · Optimiert für 250–350 g/m² Feinstpapier
          </p>
        </div>

      </div>

      <!-- ===== RIGHT COLUMN: STICKY LIVE PREVIEW ===== -->
      <div style="position: sticky; top: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <span style="font-family: var(--font-heading); font-size: 1.1rem; color: var(--fg-pencil); font-weight: 700;">
            Live-Vorschau
          </span>
          <span id="preview-size-tag" style="font-size: 0.82rem; font-weight: 700; background: #e2e8f0; padding: 2px 8px; border-radius: 4px;">
            DIN Lang (10 × 21 cm)
          </span>
        </div>

        <div style="display: flex; justify-content: center;">
          
          <!-- Outer Card Container -->
          <div id="menuPreview" class="menu-preview-box" style="
            width: 100%;
            max-width: 400px;
            background: #fdfbf7;
            border: 2px solid #2d2d2d;
            box-shadow: 6px 6px 0px rgba(0,0,0,0.15);
            padding: 40px 32px;
            position: relative;
            min-height: 600px;
            box-sizing: border-box;
            transition: all 0.25s ease;
          ">
            
            <!-- Outer Frame Border -->
            <div id="frame-outer" style="position: absolute; top: 10px; bottom: 10px; left: 10px; right: 10px; border: 1.5px solid #2d2d2d; pointer-events: none; z-index: 1;"></div>
            
            <!-- Inner Frame Border -->
            <div id="frame-inner" style="position: absolute; top: 14px; bottom: 14px; left: 14px; right: 14px; border: 0.75px solid #94a3b8; pointer-events: none; z-index: 1;"></div>

            <!-- Floral Corners (Toggleable by Theme) -->
            <img id="prev-floral-tl" src="/images/floral-tl.webp" alt="Floral frame top left" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; top: 15px; left: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-tr" src="/images/floral-tr.webp" alt="Floral frame top right" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; top: 15px; right: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-bl" src="/images/floral-bl.webp" alt="Floral frame bottom left" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; bottom: 15px; left: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-br" src="/images/floral-br.webp" alt="Floral frame bottom right" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; bottom: 15px; right: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />

            <!-- Live Menu Typography Content -->
            <div id="menuContent" style="position: relative; z-index: 3; text-align: center;"></div>

          </div>

        </div>
      </div>

    </div>

    <!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
    <div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
      <div class="tape" style="margin: 0 auto 0.75rem;"></div>
      
      <div style="text-align: center; margin-bottom: 1.25rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Auf einen Blick (BLUF)</span>
        <h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
          Menükarten-Formate & Druckempfehlungen
        </h2>
        <p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
          Die wichtigsten Richtwerte für Papiergewicht, Stückzahlen und Abmessungen auf der Hochzeitstafel:
        </p>
      </div>

      <!-- Formula Highlight Box -->
      <div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
        <p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.6; text-align: center; font-weight: 600;">
          <strong>Individuelles Gedeck:</strong> DIN Lang (10 × 21 cm auf 300 g/m² Feinstpapier) • <strong>Tischaufsteller:</strong> DIN A5 (2 Stück pro Tisch) • <strong>Buffet-Übersicht:</strong> DIN A4 oder A3 Staffelei.
        </p>
      </div>

      <!-- Semantic Benchmark Table -->
      <div style="overflow-x: auto; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 650px;">
          <thead>
            <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Menükarten-Typ</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Maße</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Mengen-Schlüssel</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Empfohlenes Papier</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Platzierung</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">DIN Lang Einleger (Standard)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">100 × 210 mm</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold;">1 Karte pro Gast</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">280–350 g/m² Leinen / Matt</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">In Stoffserviette oder auf Platzteller</td>
            </tr>
            <tr style="background: #faf8f5;">
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">DIN A5 Tischaufsteller</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">148 × 210 mm</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold;">1–2 Karten pro Tisch</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">300–400 g/m² Karton oder Aufsteller</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">In Kartenhalter oder Bilderrahmen</td>
            </tr>
            <tr>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">DIN A4 Stationskarte</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">210 × 297 mm</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold;">1 Karte pro Buffet-Station</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">250 g/m² mit Acrylglas-Ständer</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Direkt am Buffet / Desserttisch</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- SEO Guide & Wording Tips -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          Ratgeber: Hochzeitsmenükarten ansprechend gestalten
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Tipps für appetitanregende Speisenbeschreibungen, den perfekten Ablauf und Allergen-Kennzeichnungen.
        </p>
      </div>

      <!-- Section 1: Wording -->
      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. Appetitliche Formulierungen & Gängestruktur
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Anstatt Gerichte trocken aufzuzählen (z. B. 'Rinderbraten mit Kartoffeln'), wecken sensorische Beschreibungen die Vorfreude der Gäste:
        </p>
        <ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem;">
          <li><strong>Zubereitungsmethode hervorheben:</strong> <em>'Geschmorte Rinderbacke in Barolo-Jus'</em> oder <em>'Auf der Haut gebratenes Zanderfilet'</em>.</li>
          <li><strong>Regionale Herkunft & Saisonales betonen:</strong> <em>'Burrata mit Basilikumpesto & confierten Strauchtomaten'</em> oder <em>'Kürbis-Salbei-Ravioli in nussiger brauner Butter'</em>.</li>
          <li><strong>Weinbegleitung erwähnen:</strong> Fügen Sie unter dem Hauptgang den passenden Begleitwein (z. B. 'Begleitet von 2022 Grauburgunder trocken') ein.</li>
        </ul>
      </section>

      <!-- Section 2: FAQs -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
          Häufig gestellte Fragen (FAQ)
        </h3>

        <details style="margin-bottom: 0.75rem; cursor: pointer;">
          <summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Wann sollte man Menükarten drucken?</summary>
          <p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
            Drucken Sie die Menükarten ca. <strong>2 bis 3 Wochen vor der Hochzeit</strong>. Zu diesem Zeitpunkt sind die endgültigen Gästezahlen und alle Unverträglichkeiten mit dem Caterer abgestimmt.
          </p>
        </details>

        <details style="margin-bottom: 0.75rem; cursor: pointer;">
          <summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Sollte auch die Getränkeauswahl auf der Menükarte stehen?</summary>
          <p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
            Ja, entweder als eigener Abschnitt am Fuß der Karte (z. B. 'Korrespondierende Weine, Fassbier & Signature Drinks') oder auf der Rückseite der DIN Lang Karte.
          </p>
        </details>
      </section>

    </article>

    <RelatedTools currentPath="/de/reception-menu-maker" category="dining" />

  </main>
</Layout>

<style>
  .menu-add-btn {
    width: 100%;
    padding: 8px;
    border: 1.5px dashed var(--fg-pencil);
    border-radius: 4px;
    background: transparent;
    color: var(--fg-pencil);
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s;
    font-size: 0.9rem;
  }
  .menu-add-btn:hover {
    background: var(--bg-paper);
  }
  .course-card-row {
    background: #faf8f5;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .dietary-tag-pill {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 4px;
    border: 1px solid #94a3b8;
    background: #f1f5f9;
    color: #0f172a;
    vertical-align: middle;
  }
</style>

<script>
  interface CourseItem {
    title: string;
    items: string;
  }

  let courses: CourseItem[] = [
    {
      title: 'VORSPEISE',
      items: 'Burrata auf confierten Strauchtomaten mit Basilikumpesto & gerösteten Pinienkernen [V, GF]\nWildkräutersalat mit karamellisiertem Ziegenkäse & Feigen-Dressing [V]'
    },
    {
      title: 'ZWISCHENGANG',
      items: 'Cremige Pastinaken-Trüffel-Suppe mit frischen Kräuter-Croutons [V]'
    },
    {
      title: 'HAUPTGANG',
      items: 'Rinderfiletmedaillon an Rosmarinjus mit getrüffeltem Kartoffelpüree & glasiertem Bundgemüse [GF]\nGebratenes Lachsfilet auf Zitronen-Kräuter-Risotto & grünem Spargel [GF]\nKürbis-Salbei-Ravioli in nussiger brauner Butter & gebratenen Waldpilzen [V]'
    },
    {
      title: 'DESSERT & HOCHZEITSTORTE',
      items: 'Anschnitt der Hochzeitstorte mit frischem Beeren-Ragout\nDuett aus weißem Schokoladen-Mousse & Maracuja-Sorbet [V, GF]'
    },
    {
      title: 'MITTERNACHTSSNACK',
      items: 'Currywurst mit hausgemachter Pflaumen-Sauce\nRegionale Käseauswahl mit Feigensenf, Nüssen & Baguette [V]'
    }
  ];

  function formatDishWithBadges(text: string): string {
    return text.replace(/\[(GF|V|VG|DF|LF|NF)\]/g, '<span class="dietary-tag-pill">$1</span>');
  }

  function renderEditor() {
    const listEl = document.getElementById('course-list');
    if (!listEl) return;
    listEl.innerHTML = '';

    courses.forEach((c, idx) => {
      const row = document.createElement('div');
      row.className = 'course-card-row';
      row.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
          <input type="text" class="form-input course-title-input" value="${c.title}" style="font-weight: 700; font-size: 0.92rem; padding: 4px 8px; width: 70%;" data-idx="${idx}" />
          <button type="button" class="btn-remove-course" data-idx="${idx}" style="background: none; border: none; color: #dc2626; font-size: 0.85rem; font-weight: 700; cursor: pointer;">
            ✕ Entfernen
          </button>
        </div>
        <textarea class="form-input course-items-input" rows="2" style="font-size: 0.88rem; padding: 6px 8px; width: 100%; box-sizing: border-box;" data-idx="${idx}" placeholder="Gerichte eingeben (eines pro Zeile)">${c.items}</textarea>
        <span style="font-size: 0.72rem; color: #64748b;">Kürzel: [V] Vegetarisch, [VG] Vegan, [GF] Glutenfrei, [LF] Laktosefrei</span>
      `;
      listEl.appendChild(row);
    });

    listEl.querySelectorAll('.course-title-input').forEach(input => {
      input.addEventListener('input', (e: any) => {
        const i = parseInt(e.target.getAttribute('data-idx'));
        courses[i].title = e.target.value;
        renderPreview();
      });
    });

    listEl.querySelectorAll('.course-items-input').forEach(textarea => {
      textarea.addEventListener('input', (e: any) => {
        const i = parseInt(e.target.getAttribute('data-idx'));
        courses[i].items = e.target.value;
        renderPreview();
      });
    });

    listEl.querySelectorAll('.btn-remove-course').forEach(btn => {
      btn.addEventListener('click', (e: any) => {
        const i = parseInt(e.target.getAttribute('data-idx'));
        courses.splice(i, 1);
        renderEditor();
        renderPreview();
      });
    });
  }

  function renderPreview() {
    const el = document.getElementById('menuContent');
    const previewBox = document.getElementById('menuPreview');
    const sizeTag = document.getElementById('preview-size-tag');
    if (!el || !previewBox) return;

    const theme = (document.getElementById('themePicker') as HTMLSelectElement)?.value || 'botanical';
    const font = (document.getElementById('fontPicker') as HTMLSelectElement)?.value || 'playfair';
    const size = (document.getElementById('sizePicker') as HTMLSelectElement)?.value || 'dl';
    const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Sophie & Maximilian';
    const date = (document.getElementById('weddingDate') as HTMLInputElement)?.value || '18. Juli 2026';
    const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'HOCHZEITSMENÜ';
    const showDietary = (document.getElementById('check-dietary-key') as HTMLInputElement)?.checked ?? true;

    // Theme Styles
    const floralTl = document.getElementById('prev-floral-tl');
    const floralTr = document.getElementById('prev-floral-tr');
    const floralBl = document.getElementById('prev-floral-bl');
    const floralBr = document.getElementById('prev-floral-br');
    const frameOuter = document.getElementById('frame-outer');
    const frameInner = document.getElementById('frame-inner');

    if (theme === 'botanical') {
      previewBox.style.background = '#fdfbf7';
      previewBox.style.color = '#1e293b';
      if (frameOuter) { frameOuter.style.borderColor = '#2d2d2d'; frameOuter.style.display = 'block'; }
      if (frameInner) { frameInner.style.borderColor = '#94a3b8'; frameInner.style.display = 'block'; }
      [floralTl, floralTr, floralBl, floralBr].forEach(img => { if (img) img.style.display = 'block'; });
    } else if (theme === 'black-tie') {
      previewBox.style.background = '#ffffff';
      previewBox.style.color = '#0f172a';
      if (frameOuter) { frameOuter.style.borderColor = '#0f172a'; frameOuter.style.display = 'block'; }
      if (frameInner) { frameInner.style.borderColor = '#0f172a'; frameInner.style.display = 'block'; }
      [floralTl, floralTr, floralBl, floralBr].forEach(img => { if (img) img.style.display = 'none'; });
    } else if (theme === 'romantic') {
      previewBox.style.background = '#fff9f8';
      previewBox.style.color = '#3b1c1c';
      if (frameOuter) { frameOuter.style.borderColor = '#c48b71'; frameOuter.style.display = 'block'; }
      if (frameInner) { frameInner.style.borderColor = '#c48b71'; frameInner.style.display = 'block'; }
      [floralTl, floralTr, floralBl, floralBr].forEach(img => { if (img) img.style.display = 'none'; });
    } else if (theme === 'rustic') {
      previewBox.style.background = '#f5ecd7';
      previewBox.style.color = '#2c1810';
      if (frameOuter) { frameOuter.style.borderColor = '#5c3a21'; frameOuter.style.display = 'block'; }
      if (frameInner) { frameInner.style.borderColor = '#8c5a31'; frameInner.style.display = 'block'; }
      [floralTl, floralTr, floralBl, floralBr].forEach(img => { if (img) img.style.display = 'none'; });
    } else if (theme === 'minimalist') {
      previewBox.style.background = '#ffffff';
      previewBox.style.color = '#1e293b';
      if (frameOuter) frameOuter.style.display = 'none';
      if (frameInner) frameInner.style.display = 'none';
      [floralTl, floralTr, floralBl, floralBr].forEach(img => { if (img) img.style.display = 'none'; });
    }

    // Size Dimensions
    if (size === 'dl') {
      previewBox.style.maxWidth = '360px';
      previewBox.style.minHeight = '650px';
      if (sizeTag) sizeTag.textContent = 'DIN Lang (10 × 21 cm)';
    } else if (size === 'a5') {
      previewBox.style.maxWidth = '440px';
      previewBox.style.minHeight = '580px';
      if (sizeTag) sizeTag.textContent = 'DIN A5 (15 × 21 cm)';
    } else if (size === 'a4') {
      previewBox.style.maxWidth = '480px';
      previewBox.style.minHeight = '680px';
      if (sizeTag) sizeTag.textContent = 'DIN A4 (21 × 30 cm)';
    }

    // Fonts
    let headerFontFamily = "'Playfair Display', serif";
    let bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
    let titleLetterSpacing = "3px";
    let namesStyle = "font-size: 1.15rem; font-style: italic; font-family: 'Playfair Display', serif;";

    if (font === 'cinzel') {
      headerFontFamily = "'Cinzel', serif";
      bodyFontFamily = "'Cormorant Garamond', serif";
      titleLetterSpacing = "4px";
      namesStyle = "font-family: 'Cinzel', serif; font-size: 1rem; letter-spacing: 2px;";
    } else if (font === 'cormorant') {
      headerFontFamily = "'Cormorant Garamond', serif";
      bodyFontFamily = "'Cormorant Garamond', serif";
      titleLetterSpacing = "2px";
      namesStyle = "font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-style: italic;";
    } else if (font === 'script') {
      headerFontFamily = "'Alex Brush', cursive";
      bodyFontFamily = "'Playfair Display', serif";
      titleLetterSpacing = "1px";
      namesStyle = "font-family: 'Alex Brush', cursive; font-size: 1.85rem; line-height: 1.1;";
    } else if (font === 'modern') {
      headerFontFamily = "'Montserrat', sans-serif";
      bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
      titleLetterSpacing = "5px";
      namesStyle = "font-family: 'Montserrat', sans-serif; font-size: 0.95rem; letter-spacing: 2px; text-transform: uppercase;";
    }

    // Build Preview HTML
    let html = `
      <div style="margin-bottom: 12px;">
        <h3 style="font-family: ${headerFontFamily}; font-size: ${font === 'script' ? '2.4rem' : '1.7rem'}; letter-spacing: ${titleLetterSpacing}; text-transform: ${font === 'script' ? 'none' : 'uppercase'}; margin: 0 0 4px 0; font-weight: 700;">
          ${menuTitle}
        </h3>
        <p style="${namesStyle} margin: 0 0 2px 0;">
          ${names}
        </p>
        <p style="font-size: 0.80rem; letter-spacing: 1.5px; opacity: 0.7; margin: 0; font-family: 'Montserrat', sans-serif;">
          ${date}
        </p>
        <div style="width: 40px; border-top: 1.5px solid currentColor; margin: 12px auto; opacity: 0.6;"></div>
      </div>
    `;

    courses.forEach((c, i) => {
      if (i > 0) {
        html += `<div style="width: 24px; border-top: 1px dashed currentColor; margin: 12px auto; opacity: 0.4;"></div>`;
      }
      
      const rawDishes = c.items.split('\n').filter(l => l.trim());
      const formattedDishes = rawDishes.map(d => `<div style="margin-bottom: 4px; line-height: 1.45;">${formatDishWithBadges(d)}</div>`).join('');

      html += `
        <div style="margin-bottom: 8px;">
          <h4 style="font-family: ${headerFontFamily}; font-size: 1.05rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin: 0 0 4px 0; color: var(--accent-red);">
            ${c.title}
          </h4>
          <div style="font-family: ${bodyFontFamily}; font-size: 0.88rem; opacity: 0.9;">
            ${formattedDishes || '<span style="opacity: 0.4; font-style: italic;">Gerichte eintragen...</span>'}
          </div>
        </div>
      `;
    });

    if (showDietary) {
      html += `
        <div style="margin-top: 18px; padding-top: 8px; border-top: 0.5px solid currentColor; opacity: 0.65; font-size: 0.72rem; font-family: 'Montserrat', sans-serif; letter-spacing: 0.5px;">
          (V) Vegetarisch • (VG) Vegan • (GF) Glutenfrei • (LF) Laktosefrei
        </div>
      `;
    }

    el.innerHTML = html;
  }

  // ── Print High-Res Window Engine ─────
  function printHighResMenu() {
    const theme = (document.getElementById('themePicker') as HTMLSelectElement)?.value || 'botanical';
    const font = (document.getElementById('fontPicker') as HTMLSelectElement)?.value || 'playfair';
    const size = (document.getElementById('sizePicker') as HTMLSelectElement)?.value || 'dl';
    const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Sophie & Maximilian';
    const date = (document.getElementById('weddingDate') as HTMLInputElement)?.value || '18. Juli 2026';
    const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'HOCHZEITSMENÜ';
    const showDietary = (document.getElementById('check-dietary-key') as HTMLInputElement)?.checked ?? true;

    // Dimensions CSS in mm
    let cardW = '100mm';
    let cardH = '210mm';
    if (size === 'a5') { cardW = '148mm'; cardH = '210mm'; }
    else if (size === 'a4') { cardW = '210mm'; cardH = '297mm'; }

    let bgStyle = '#fdfbf7';
    let textColor = '#1e293b';
    let borderColor = '#2d2d2d';
    let innerBorderColor = '#94a3b8';

    if (theme === 'black-tie') {
      bgStyle = '#ffffff'; textColor = '#0f172a'; borderColor = '#0f172a'; innerBorderColor = '#0f172a';
    } else if (theme === 'romantic') {
      bgStyle = '#fff9f8'; textColor = '#3b1c1c'; borderColor = '#c48b71'; innerBorderColor = '#c48b71';
    } else if (theme === 'rustic') {
      bgStyle = '#f5ecd7'; textColor = '#2c1810'; borderColor = '#5c3a21'; innerBorderColor = '#8c5a31';
    } else if (theme === 'minimalist') {
      bgStyle = '#ffffff'; textColor = '#1e293b'; borderColor = 'transparent'; innerBorderColor = 'transparent';
    }

    let headerFontFamily = "'Playfair Display', serif";
    let bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
    if (font === 'cinzel') { headerFontFamily = "'Cinzel', serif"; bodyFontFamily = "'Cormorant Garamond', serif"; }
    else if (font === 'cormorant') { headerFontFamily = "'Cormorant Garamond', serif"; bodyFontFamily = "'Cormorant Garamond', serif"; }
    else if (font === 'script') { headerFontFamily = "'Alex Brush', cursive"; bodyFontFamily = "'Playfair Display', serif"; }
    else if (font === 'modern') { headerFontFamily = "'Montserrat', sans-serif"; bodyFontFamily = "'Plus Jakarta Sans', sans-serif"; }

    let coursesHtml = '';
    courses.forEach((c, i) => {
      if (i > 0) coursesHtml += `<div style="width: 25px; border-top: 1px dashed currentColor; margin: 10px auto; opacity: 0.4;"></div>`;
      const dishes = c.items.split('\n').filter(l => l.trim()).map(d => `<div style="margin-bottom: 4px; font-size: 10pt; line-height: 1.45;">${formatDishWithBadges(d)}</div>`).join('');
      coursesHtml += `
        <div style="margin-bottom: 8px;">
          <h4 style="font-family: ${headerFontFamily}; font-size: 13pt; margin: 0 0 3px 0; font-weight: 700; text-transform: uppercase; color: #b91c1c;">${c.title}</h4>
          <div style="font-family: ${bodyFontFamily};">${dishes}</div>
        </div>
      `;
    });

    const printWin = window.open('', '_blank');
    if (!printWin) return;

    printWin.document.write(`
      <!DOCTYPE html>
      <html lang="de">
      <head>
        <title>${menuTitle} — ${names}</title>
        <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
        <style>
          @page { size: auto; margin: 5mm; }
          body { margin: 0; padding: 20px; display: flex; justify-content: center; background: #eaedf0; font-family: ${bodyFontFamily}; }
          .menu-card {
            width: ${cardW};
            height: ${cardH};
            background: ${bgStyle};
            color: ${textColor};
            padding: 30px 20px;
            box-sizing: border-box;
            position: relative;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
          }
          .dietary-tag-pill { display: inline-block; font-size: 7.5pt; font-weight: bold; padding: 1px 4px; border-radius: 2px; margin-left: 3px; border: 1px solid #94a3b8; }
          @media print {
            body { background: transparent; padding: 0; }
            .menu-card { box-shadow: none; page-break-inside: avoid; }
          }
        </style>
      </head>
      <body>
        <div class="menu-card">
          <div style="position: absolute; top: 6mm; bottom: 6mm; left: 6mm; right: 6mm; border: 1.5px solid ${borderColor}; pointer-events: none;"></div>
          <div style="position: absolute; top: 8mm; bottom: 8mm; left: 8mm; right: 8mm; border: 0.75px solid ${innerBorderColor}; pointer-events: none;"></div>
          
          <div style="margin-bottom: 12px;">
            <h1 style="font-family: ${headerFontFamily}; font-size: ${font === 'script' ? '26pt' : '18pt'}; margin: 0 0 2px 0; font-weight: 700; text-transform: ${font === 'script' ? 'none' : 'uppercase'};">${menuTitle}</h1>
            <p style="font-size: 13pt; font-style: italic; margin: 0 0 2px 0;">${names}</p>
            <p style="font-size: 9pt; opacity: 0.7; margin: 0; font-family: 'Montserrat', sans-serif;">${date}</p>
            <div style="width: 40px; border-top: 1.5px solid currentColor; margin: 10px auto; opacity: 0.6;"></div>
          </div>

          <div>${coursesHtml}</div>

          ${showDietary ? `
            <div style="margin-top: 15px; padding-top: 8px; border-top: 0.5px solid currentColor; opacity: 0.65; font-size: 8pt; font-family: 'Montserrat', sans-serif;">
              (V) Vegetarisch • (VG) Vegan • (GF) Glutenfrei • (LF) Laktosefrei
            </div>
          ` : ''}
        </div>
        <script>window.onload = function() { window.print(); };<\/script>
      </body>
      </html>
    `);
    printWin.document.close();
  }

  // ── Word Doc Export ──────────────────────────────────────────────────
  function exportWordDoc() {
    const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Sophie & Maximilian';
    const date = (document.getElementById('weddingDate') as HTMLInputElement)?.value || '18. Juli 2026';
    const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'HOCHZEITSMENÜ';

    let coursesContent = '';
    courses.forEach(c => {
      coursesContent += `<h3 style="color:#b91c1c; margin-top:15px; text-transform:uppercase;">${c.title}</h3><ul>`;
      c.items.split('\n').filter(l => l.trim()).forEach(item => {
        coursesContent += `<li style="margin-bottom:4px;">${item}</li>`;
      });
      coursesContent += `</ul>`;
    });

    const content = `
      <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
      <head><title>${menuTitle}</title>
      <style>body { font-family: 'Georgia', serif; font-size: 11pt; } h1, h2 { text-align: center; } ul { list-style-type: square; }</style>
      </head>
      <body>
        <h1 style="letter-spacing: 2px;">${menuTitle}</h1>
        <h2 style="font-weight:normal; font-style:italic;">${names}</h2>
        <p style="text-align:center; color:#666;">${date}</p>
        <hr/>
        ${coursesContent}
        <br/><hr/>
        <p style="font-size:9pt; text-align:center; color:#888;">Manage.Wedding — Menükarten-Gestalter</p>
      </body></html>
    `;

    const blob = new Blob([content], { type: 'application/msword' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'hochzeitsmenue-karte.doc';
    link.click();
  }

  // ── Helpers ─────────────────────────────────────────────────────────
  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) { resolve(); return; }
      const s = document.createElement('script');
      s.src = src; s.onload = () => resolve(); s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  // ── Vector PDF Download (jsPDF) ──────────────────────────────────────
  async function downloadVectorPdf() {
    const btn = document.getElementById('downloadVectorPdfBtn') as HTMLButtonElement;
    if (btn) { btn.textContent = 'PDF wird erstellt…'; btn.disabled = true; }

    try {
      await loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js');

      const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Sophie & Maximilian';
      const date  = (document.getElementById('weddingDate')  as HTMLInputElement)?.value || '18. Juli 2026';
      const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'HOCHZEITSMENÜ';
      const size = (document.getElementById('sizePicker') as HTMLSelectElement)?.value || 'dl';

      const { jsPDF } = (window as any).jspdf;
      
      // Dimensions in mm
      let W = 100; // DIN Lang
      let H = 210;
      if (size === 'a5') { W = 148; H = 210; }
      else if (size === 'a4') { W = 210; H = 297; }

      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: [W, H] });
      const cx = W / 2;

      // Background
      pdf.setFillColor(253, 251, 247);
      pdf.rect(0, 0, W, H, 'F');

      // Double Borders
      pdf.setDrawColor(45, 45, 45);
      pdf.setLineWidth(0.5);
      pdf.rect(6, 6, W - 12, H - 12);

      pdf.setDrawColor(180, 180, 180);
      pdf.setLineWidth(0.2);
      pdf.rect(8, 8, W - 16, H - 16);

      let y = size === 'dl' ? 24 : 20;

      // Title
      pdf.setFont('times', 'bold');
      pdf.setFontSize(size === 'dl' ? 18 : 16);
      pdf.setTextColor(30, 30, 30);
      pdf.text(menuTitle, cx, y, { align: 'center' });
      y += 7;

      // Names
      pdf.setFont('times', 'italic');
      pdf.setFontSize(size === 'dl' ? 13 : 12);
      pdf.setTextColor(50, 50, 50);
      pdf.text(names, cx, y, { align: 'center' });
      y += 5;

      // Date
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(8);
      pdf.setTextColor(120, 120, 120);
      pdf.text(date, cx, y, { align: 'center' });
      y += 5;

      // Divider Line
      pdf.setDrawColor(80, 80, 80);
      pdf.setLineWidth(0.3);
      pdf.line(cx - 15, y, cx + 15, y);
      y += 8;

      // Courses
      courses.forEach((course, i) => {
        if (i > 0) {
          pdf.setDrawColor(180, 180, 180);
          pdf.setLineDashPattern([1, 1], 0);
          pdf.line(cx - 8, y, cx + 8, y);
          pdf.setLineDashPattern([], 0);
          y += 6;
        }

        // Course title
        pdf.setFont('times', 'bold');
        pdf.setFontSize(size === 'dl' ? 11 : 10);
        pdf.setTextColor(180, 45, 35);
        pdf.text(course.title, cx, y, { align: 'center' });
        y += 5;

        // Items
        pdf.setFont('times', 'normal');
        pdf.setFontSize(size === 'dl' ? 9.5 : 8.5);
        pdf.setTextColor(50, 50, 50);
        const rawItems = course.items.split('\n').filter(l => l.trim());
        rawItems.forEach(item => {
          const cleanItem = item.replace(/\[(GF|V|VG|DF|LF|NF)\]/g, '($1)');
          pdf.text(cleanItem, cx, y, { align: 'center' });
          y += 4.5;
        });
        y += 3;
      });

      pdf.save('hochzeitsmenue-karte.pdf');
    } catch (err) {
      console.error('PDF error:', err);
      alert('Vektor-PDF konnte nicht erstellt werden. Bitte nutzen Sie die Browser-Druckfunktion.');
    } finally {
      if (btn) { btn.textContent = 'Vektor-PDF'; btn.disabled = false; }
    }
  }

  // ── Init & Event Listeners ──────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    renderEditor();
    renderPreview();

    // Live Listeners
    ['themePicker', 'fontPicker', 'sizePicker', 'coupleNames', 'weddingDate', 'menuTitle', 'check-dietary-key'].forEach(id => {
      const el = document.getElementById(id);
      el?.addEventListener('input', renderPreview);
      el?.addEventListener('change', renderPreview);
    });

    document.getElementById('addCourseBtn')?.addEventListener('click', () => {
      courses.push({ title: 'WEITERER GANG', items: 'Speisenbeschreibung [GF, V]' });
      renderEditor();
      renderPreview();
      document.getElementById('course-list')?.lastElementChild?.scrollIntoView({ behavior: 'smooth' });
    });

    document.getElementById('printMenuBtn')?.addEventListener('click', printHighResMenu);
    document.getElementById('downloadVectorPdfBtn')?.addEventListener('click', downloadVectorPdf);
    document.getElementById('exportDocBtn')?.addEventListener('click', exportWordDoc);
  });
</script>
