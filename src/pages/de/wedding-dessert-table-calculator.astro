---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/wedding-dessert-table-calculator/#webapp",
      "name": "Hochzeit Dessert-Buffet, Candy-Bar & Cookie-Table Rechner",
      "url": "https://manage.wedding/de/wedding-dessert-table-calculator",
      "description": "Kostenloser interaktiver Rechner für Hochzeits-Dessertbuffet, Candy-Bar, Macarons und Kuchenbuffet. Berechnen Sie Mini-Dessert-Mengen, Dutzend-Bestellungen für Konditoren, Süßigkeiten-Kilos und drucken Sie 8x10 Schilder 'Liebe ist süß' sowie Konditor-Bestelllisten in PDF & Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "So berechnen Sie Mengen für Dessertbuffet, Candy-Bar und Konditor-Bestellungen",
      "description": "Schritt-für-Schritt Anleitung zur Mengenberechnung von Mini-Törtchen, Macarons, Candy-Bar Gläsern und Dutzenden für die Hochzeit.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Dessert-Format wählen",
          "text": "Wählen Sie, ob die Mini-Desserts ergänzend zur traditionellen Hochzeitstorte serviert werden (2–3 Stück pro Gast), die Torte komplett ersetzen (4–6 Stück pro Gast), als Cookie-Table oder Candy-Bar nach Gewicht (120g–160g pro Gast)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Sortenvielfalt & Dutzende abstimmen",
          "text": "Wählen Sie 4 bis 8 Sorten (Macarons, Törtchen, Mousse-Gläschen, Mini-Cupcakes, Pralinen, Donuts) und berechnen Sie die genaue Dutzend-Bestellmenge für die Konditorei."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Apothekergläser, Schaufeln & Tütchen dimensionieren",
          "text": "Berechnen Sie das Gesamtgewicht an Süßigkeiten in Kilo, staffeln Sie Apothekergläser in 3 Höhenebenen und planen Sie Gastgeschenk-Tütchen mit 15% Reserve ein."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Schilder & Konditor-Bestelliste drucken",
          "text": "Erstellen Sie druckfertige 8x10 Tisch-Schilder, faltbare Allergen-Kärtchen (Glutenfrei, Vegan) und laden Sie die Konditor-Bestellliste in PDF und Word herunter."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie viele Mini-Desserts pro Person rechnet man bei einer Hochzeit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wenn zusätzlich eine Hochzeitstorte serviert wird, plant man mit 2 bis 3 Mini-Desserts (Bite-Size) pro Gast. Wenn das Dessert-Buffet die Hochzeitstorte komplett ersetzt, rechnet man mit 4 bis 6 Stück pro Person, damit jeder Gast verschiedene Geschmackssorten probieren kann."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele verschiedene Dessertsorten sollte man auf dem Buffet anbieten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für 50–75 Gäste sind 3 bis 4 Sorten ideal. Für 75–125 Gäste 4 bis 5 Sorten. Für 125–200 Gäste 5 bis 7 Sorten. Bei über 200 Gästen maximal 6 bis 8 Sorten. Zu viele Sorten führen zu langen Schlangen am Buffet und dazu, dass beliebte Leckereien in wenigen Minuten vergriffen sind."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel Süßigkeiten benötigt man für eine Candy-Bar zur Hochzeit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rechnen Sie mit 120g bis 160g Süßigkeiten pro Gast. Bei 100 Gästen entspricht dies ca. 12 bis 16 kg Süßigkeiten, verteilt auf 6 bis 8 unterschiedlich hohe Apothekergläser und Bonbonnieren."
          }
        },
        {
          "@type": "Question",
          "name": "Welche Desserts schmelzen bei Sommerhochzeiten im Freien?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Echte Buttercreme wird ab 24°C weich und schmilzt ab 28°C. Schokotrüffel, Ganache-Törtchen und Mousse-Gläschen sollten bis 30 Minuten vor dem Servieren gekühlt bleiben. Macarons ziehen bei hoher Luftfeuchtigkeit Feuchtigkeit und werden klebrig. Für heiße Sommertage eignen sich Kekse mit Royal Icing, Brownies, Cake-Pops und Hartkaramellen."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Hochzeit Dessert-Buffet, Candy-Bar & Cookie Rechner (Kostenlose PDF-Schilder) | Manage.Wedding"
	description="Berechnen Sie genaue Mengen für Dessertbuffet, Dutzende für den Konditor, Candy-Bar Kilos und Gläser. Inklusive 8x10 Schildern 'Liebe ist süß', Allergenkarten und Konditor-Bestelllisten in PDF & Word."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Dessert-Buffet & Candy-Bar" category="food-dining" />
		
		<!-- Hero Section -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🧁</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Kostenlos • Interaktiver Mengenrechner • PDF-Schilder & Konditor-Bestelliste</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Dessert-Buffet, Candy-Bar & Cookie Rechner
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 760px; margin: 0 auto; text-align: center;">
					Berechnen Sie die exakte Anzahl an Mini-Desserts, Candy-Bar Kilos, Apothekergläsern und Dutzenden für Ihre Konditorei. Passen Sie Sorten an, gestalten Sie druckfertige <strong>8x10 Tisch-Schilder "Liebe ist süß"</strong>, Allergen-Kärtchen und laden Sie Ihre <strong>Konditor-Bestelliste</strong> in PDF und Word herunter!
				</p>
			</div>
		</section>

		<!-- 3-Schritte Anleitung -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>✨</span> So planen Sie Ihr süßes Buffet in 3 einfachen Schritten
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Buffet-Art wählen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Zusätzlich zur Hochzeitstorte (2–3 Stk/Gast), als Tortenersatz (4–6 Stk/Gast), Cookie-Table oder Candy-Bar nach Gewicht.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Sorten & Dutzende abstimmen
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Wählen Sie Leckereien (Macarons, Törtchen, Gläschen, Trüffel) und rechnen Sie automatisch in Handwerks-Dutzende um.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Schilder & Liste drucken
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Erstellen Sie gerahmte Tisch-Schilder (8x10 / 5x7), Allergen-Kärtchen und laden Sie die Konditor-Bestellliste in PDF & Word herunter.
					</p>
				</div>
			</div>
		</div>

		<!-- Interactive Application Workspace -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SEKTION 1: Gästeanzahl & Format -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🍰 1. Gästeanzahl & Art des Dessertbuffets
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Gästezahl, Appetit und Servierstil individuell anpassen
						</span>
					</div>
					<span id="badge-variety-rec" class="badge-postit" style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); padding: 4px 10px; border: 1.5px solid var(--fg-pencil); border-radius: 6px;">
						Empfohlen: 4–5 Sorten
					</span>
				</div>

				<!-- Format-Auswahl -->
				<div style="margin-bottom: 1.5rem;">
					<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1rem; color: var(--fg-pencil);">
						Art des Dessertbuffets wählen:
					</label>
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.75rem;" id="format-tabs-container">
						
						<label class="format-tab active" data-format="with-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fef08a; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="with-cake" checked style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🎂 + 🧁</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Neben der Torte</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">2–3 Stk / Gast</span>
						</label>

						<label class="format-tab" data-format="no-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="no-cake" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🧁✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Als Tortenersatz</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">4–6 Stk / Gast</span>
						</label>

						<label class="format-tab" data-format="cookie-table" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="cookie-table" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍪📦</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Keks- & Kuchenbuffet</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">6–8 Kekse + Boxen</span>
						</label>

						<label class="format-tab" data-format="candy-buffet" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="candy-buffet" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍬🍭</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Candy-Bar</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">120g–160g / Gast</span>
						</label>

						<label class="format-tab" data-format="hybrid" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="hybrid" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">👑✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Grand Sweet Table</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">Desserts + Candy + Geschenke</span>
						</label>
					</div>
				</div>

				<!-- Gästezahl & Appetit -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
					
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="input-guests" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								👥 Gästeanzahl:
							</label>
							<span id="badge-guests" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 2px 10px; border-radius: 12px; font-size: 0.9rem;">
								100 Gäste
							</span>
						</div>
						<input type="range" id="slider-guests" min="20" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="input-guests" min="10" max="1000" value="100" class="form-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 1rem; font-weight: 600; background: #fff;">
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<label for="select-appetite" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🍽️ Menü-Kontext & Appetit:
						</label>
						<select id="select-appetite" style="width: 100%; padding: 0.6rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.95rem; font-weight: 600; background: #fff; margin-bottom: 0.5rem;">
							<option value="light">Leicht (Nach üppigem 4-Gänge Menü)</option>
							<option value="standard" selected>Standard (Ausgewogen: 2.5 Stück / 135g Candy)</option>
							<option value="generous">Naschkatzen & Party (Lange Partynacht & Mitternachtssnack)</option>
						</select>
						<div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
							<input type="checkbox" id="chk-takeaway-favors" style="width: 18px; height: 18px; accent-color: var(--accent-blue);">
							<label for="chk-takeaway-favors" class="font-body" style="font-size: 0.85rem; color: var(--fg-pencil); cursor: pointer;">
								<strong>Inklusive Gastgeschenk-Schachteln</strong> (+2 Stück / +80g Candy pro Gast)
							</label>
						</div>
					</div>

				</div>

				<!-- Live Statistik Kennzahlen -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
					
					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Gesamt Mini-Desserts</span>
						<strong id="stat-total-pieces" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red); line-height: 1.2;">250</strong>
						<span id="stat-pieces-per-guest" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(2.5 Stk / Gast)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Konditor-Dutzende</span>
						<strong id="stat-total-dozens" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); line-height: 1.2;">21 Dtz</strong>
						<span id="stat-exact-dozens" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(252 Stück gesamt)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Candy-Bar Gewicht</span>
						<strong id="stat-total-candy" class="font-heading" style="font-size: 1.8rem; color: #16a34a; line-height: 1.2;">12.7 kg</strong>
						<span id="stat-candy-kg" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(28 lbs / 6–8 Gläser)</span>
					</div>

					<div style="text-align: center; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Buffettisch-Länge</span>
						<strong id="stat-table-size" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); line-height: 1.2;">Tisch 2.0–2.4 m</strong>
						<span id="stat-napkins-count" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">150 Cocktailservietten</span>
					</div>

				</div>
			</div>

			<!-- SEKTION 2: Dessert-Sorten & Dutzende -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🧁 2. Sortenaufteilung & Dutzend-Rechner
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Stückzahlen anpassen und exakte Dutzend-Bestellungen für den Konditor einsehen
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
						<button type="button" id="btn-auto-balance" class="hand-btn" style="background: var(--post-it); font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 700; display: inline-flex; align-items: center; gap: 0.3rem;">
							<span>⚖️</span> Auto-Ausgleich
						</button>
						<button type="button" id="btn-reset-varieties" class="hand-btn" style="background: #fff; font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 600;">
							🔄 Zurücksetzen
						</button>
					</div>
				</div>

				<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; font-size: 0.85rem;">
						<span><strong>Verteilte Stücke:</strong> <span id="label-allocated-pieces">250</span> / <span id="label-target-pieces">250</span> Ziel</span>
						<span id="label-allocation-status" style="font-weight: 700; color: #16a34a;">✅ Perfekt Ausgeglichen</span>
					</div>
					<div style="width: 100%; height: 10px; background: #e2e8f0; border-radius: 5px; overflow: hidden; border: 1px solid var(--fg-pencil);">
						<div id="bar-allocation-progress" style="width: 100%; height: 100%; background: #16a34a; transition: width 0.3s ease, background-color 0.3s ease;"></div>
					</div>
				</div>

				<div id="dessert-items-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
				</div>

				<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 6px; padding: 1rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between;">
					<div style="display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 240px;">
