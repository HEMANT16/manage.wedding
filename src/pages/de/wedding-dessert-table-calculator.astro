			<div style="border-bottom: 2pt solid #000; padding-bottom: 3mm; margin-bottom: 5mm;">
				<h1 style="font-size: 18pt; margin: 0 0 2mm 0; color: #000; font-family: 'Georgia', serif;">Konditor-Bestellliste: Dessertbuffet & Candy-Bar</h1>
				<p id="print-bakery-meta" style="font-size: 10pt; color: #333; margin: 0; font-family: Arial, sans-serif;">Brautpaar: Laura & Felix | Datum: 18. Oktober 2026 | Gäste: 100</p>
			</div>
			<div id="print-bakery-tables">
				<!-- Injected by script -->
			</div>
			<div style="margin-top: 6mm; padding-top: 3mm; border-top: 1pt dashed #cbd5e1; font-size: 8.5pt; color: #64748b; text-align: center; font-family: Arial, sans-serif;">
				Erstellt mit Manage.Wedding Dessertbuffet-Rechner • Für beste Stabilität auf festes Papier (200–300g) drucken.
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.format-tab.active {
		background: var(--post-it) !important;
		box-shadow: 2px 2px 0px var(--fg-pencil);
		transform: translateY(-2px);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		@page {
			size: portrait;
			margin: 8mm 10mm;
		}

		html, body {
			background: #fff !important;
			color: #000 !important;
			margin: 0 !important;
			padding: 0 !important;
			font-size: 12pt;
		}

		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
			page-break-inside: avoid !important;
			break-inside: avoid !important;
			box-sizing: border-box !important;
			width: 100% !important;
		}

		.print-page:last-child,
		#print-bakery-sheet-container {
			page-break-after: auto !important;
			break-after: auto !important;
		}

		.tent-card {
			page-break-inside: avoid !important;
			break-inside: avoid !important;
			box-sizing: border-box !important;
		}
	}
</style>

<script is:inline>
	let dessertItems = [
		{ id: 'cupcakes', name: 'Mini-Cupcakes', icon: '🧁', ratio: 0.25, dietary: 'none', count: 65, dozens: 5.5, locked: false },
		{ id: 'macarons', name: 'Französische Macarons', icon: '🍓', ratio: 0.20, dietary: 'Glutenfrei', count: 50, dozens: 4.5, locked: false },
		{ id: 'tartlets', name: 'Frucht- & Zitronentörtchen', icon: '🥧', ratio: 0.15, dietary: 'none', count: 40, dozens: 3.5, locked: false },
		{ id: 'truffles', name: 'Handgemachte Edelschokotrüffel', icon: '🍫', ratio: 0.15, dietary: 'Glutenfrei', count: 40, dozens: 3.5, locked: false },
		{ id: 'shooters', name: 'Mousse- & Panna-Cotta-Gläschen', icon: '🍮', ratio: 0.15, dietary: 'none', count: 35, dozens: 3.0, locked: false },
		{ id: 'donuts', name: 'Mini-Donuts mit Glasur', icon: '🍩', ratio: 0.10, dietary: 'none', count: 20, dozens: 2.0, locked: false }
	];

	const sliderGuests = document.getElementById('slider-guests');
	const inputGuests = document.getElementById('input-guests');
	const badgeGuests = document.getElementById('badge-guests');
	const selectAppetite = document.getElementById('select-appetite');
	const chkTakeaway = document.getElementById('chk-takeaway-favors');
	const selectCandyRatio = document.getElementById('select-candy-ratio');

	const statTotalPieces = document.getElementById('stat-total-pieces');
	const statPiecesPerGuest = document.getElementById('stat-pieces-per-guest');
	const statTotalDozens = document.getElementById('stat-total-dozens');
	const statExactDozens = document.getElementById('stat-exact-dozens');
	const statTotalCandy = document.getElementById('stat-total-candy');
	const statCandyKg = document.getElementById('stat-candy-kg');
	const statTableSize = document.getElementById('stat-table-size');
	const statNapkinsCount = document.getElementById('stat-napkins-count');
	const badgeVarietyRec = document.getElementById('badge-variety-rec');

	const labelAllocated = document.getElementById('label-allocated-pieces');
	const labelTarget = document.getElementById('label-target-pieces');
	const labelStatus = document.getElementById('label-allocation-status');
	const barProgress = document.getElementById('bar-allocation-progress');

	const dessertContainer = document.getElementById('dessert-items-container');
	const tbodyBakeryOrder = document.getElementById('tbody-bakery-order');
	const dietaryCardsPreview = document.getElementById('dietary-cards-preview');

	let currentFormat = 'with-cake';

	document.querySelectorAll('.format-tab').forEach(tab => {
		tab.addEventListener('click', () => {
			document.querySelectorAll('.format-tab').forEach(t => t.classList.remove('active'));
			tab.classList.add('active');
			currentFormat = tab.getAttribute('data-format');
			autoBalancePortions();
			updateCalculations();
		});
	});

	function getPiecesPerGuest() {
		let base = 2.5;
		if (currentFormat === 'no-cake') base = 5.0;
		else if (currentFormat === 'cookie-table') base = 7.0;
		else if (currentFormat === 'candy-buffet') base = 0.5;
		else if (currentFormat === 'hybrid') base = 3.5;

		const appetite = selectAppetite.value;
		if (appetite === 'light') base *= 0.85;
		else if (appetite === 'generous') base *= 1.25;

		if (chkTakeaway.checked) {
			base += (currentFormat === 'cookie-table' ? 4.0 : 2.0);
		}

		return parseFloat(base.toFixed(1));
	}

	function autoBalancePortions() {
		const guests = parseInt(inputGuests.value) || 100;
		const perGuest = getPiecesPerGuest();
		const targetTotal = Math.round(guests * perGuest);

		const activeItems = dessertItems.filter(item => item.count >= 0);
		const totalWeight = activeItems.reduce((acc, item) => acc + item.ratio, 0) || 1;

		let allocatedSum = 0;
		activeItems.forEach((item, index) => {
			if (index === activeItems.length - 1) {
				item.count = Math.max(0, targetTotal - allocatedSum);
			} else {
				const share = Math.round(targetTotal * (item.ratio / totalWeight));
				item.count = share;
				allocatedSum += share;
			}
			item.dozens = Math.ceil(item.count / 12 * 2) / 2;
		});

		renderDessertCards();
	}

	function renderDessertCards() {
		dessertContainer.innerHTML = '';
		
		dessertItems.forEach((item, idx) => {
			const card = document.createElement('div');
			card.className = 'hand-card';
			card.style.padding = '1rem';
			card.style.background = '#fdfbf7';
			card.style.border = '1.5px solid var(--fg-pencil)';

			const dozenCount = Math.ceil(item.count / 12);
			const safetyPieces = dozenCount * 12;

			card.innerHTML = `
				<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.5rem;">
					<div>
						<strong class="font-heading" style="font-size:1.05rem; color:var(--fg-pencil); display:flex; align-items:center; gap:0.4rem;">
							<span>${item.icon || '🧁'}</span> ${item.name}
						</strong>
						<span style="font-size:0.75rem; background:#e2e8f0; padding:2px 6px; border-radius:4px; font-weight:600; color:var(--fg-pencil);">
							${item.dietary === 'none' ? 'Standard' : item.dietary}
						</span>
					</div>
					<button type="button" class="btn-delete-item" data-idx="${idx}" style="background:none; border:none; color:var(--accent-red); cursor:pointer; font-size:1rem; padding:0 4px;" title="Entfernen">✕</button>
				</div>

				<div style="display:flex; align-items:center; justify-content:space-between; margin:0.75rem 0;">
					<div style="display:flex; align-items:center; gap:0.4rem;">
						<button type="button" class="btn-step-minus" data-idx="${idx}" style="width:28px; height:28px; border:1.5px solid var(--fg-pencil); background:#fff; border-radius:4px; font-weight:bold; cursor:pointer;">-</button>
						<input type="number" class="input-item-count" data-idx="${idx}" value="${item.count}" min="0" max="2000" style="width:70px; text-align:center; padding:0.3rem; border:1.5px solid var(--fg-pencil); border-radius:4px; font-weight:700; font-size:1rem;">
						<button type="button" class="btn-step-plus" data-idx="${idx}" style="width:28px; height:28px; border:1.5px solid var(--fg-pencil); background:#fff; border-radius:4px; font-weight:bold; cursor:pointer;">+</button>
					</div>
					<div style="text-align:right;">
						<span style="font-size:0.75rem; color:var(--text-secondary); display:block;">Konditor-Bestellung</span>
						<strong style="font-size:0.95rem; color:var(--accent-blue);">${dozenCount} Dutzend</strong>
						<span style="font-size:0.72rem; color:var(--text-secondary); display:block;">(${safetyPieces} Stück)</span>
					</div>
				</div>
			`;
			dessertContainer.appendChild(card);
		});

		document.querySelectorAll('.btn-step-minus').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const idx = parseInt(e.target.getAttribute('data-idx'));
				if (dessertItems[idx].count >= 6) {
					dessertItems[idx].count -= 6;
					dessertItems[idx].dozens = Math.ceil(dessertItems[idx].count / 12 * 2) / 2;
					renderDessertCards();
					updateCalculations();
				}
			});
		});

		document.querySelectorAll('.btn-step-plus').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const idx = parseInt(e.target.getAttribute('data-idx'));
				dessertItems[idx].count += 6;
				dessertItems[idx].dozens = Math.ceil(dessertItems[idx].count / 12 * 2) / 2;
				renderDessertCards();
				updateCalculations();
			});
		});

		document.querySelectorAll('.input-item-count').forEach(inp => {
			inp.addEventListener('change', (e) => {
				const idx = parseInt(e.target.getAttribute('data-idx'));
				const val = Math.max(0, parseInt(e.target.value) || 0);
				dessertItems[idx].count = val;
				dessertItems[idx].dozens = Math.ceil(val / 12 * 2) / 2;
				renderDessertCards();
				updateCalculations();
			});
		});

		document.querySelectorAll('.btn-delete-item').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const idx = parseInt(e.target.getAttribute('data-idx'));
				if (dessertItems.length > 1) {
					dessertItems.splice(idx, 1);
					renderDessertCards();
					updateCalculations();
				}
			});
		});
	}

	function updateCalculations() {
		const guests = parseInt(inputGuests.value) || 100;
		const perGuest = getPiecesPerGuest();
		const targetTotal = Math.round(guests * perGuest);
		const allocatedSum = dessertItems.reduce((acc, item) => acc + (item.count || 0), 0);
		const totalDozens = Math.ceil(allocatedSum / 12);
		const exactTotalPieces = totalDozens * 12;

		badgeGuests.textContent = `${guests} Gäste`;
		statTotalPieces.textContent = allocatedSum;
		statPiecesPerGuest.textContent = `(${perGuest} Stk / Gast)`;
		statTotalDozens.textContent = `${totalDozens} Dtz`;
		statExactDozens.textContent = `(${exactTotalPieces} Stück gesamt)`;

		labelAllocated.textContent = allocatedSum;
		labelTarget.textContent = targetTotal;

		const percent = targetTotal > 0 ? Math.min(100, Math.round((allocatedSum / targetTotal) * 100)) : 100;
		barProgress.style.width = `${percent}%`;

		if (allocatedSum === targetTotal) {
			labelStatus.textContent = '✅ Perfekt Ausgeglichen';
			labelStatus.style.color = '#16a34a';
			barProgress.style.backgroundColor = '#16a34a';
		} else if (allocatedSum > targetTotal) {
			labelStatus.textContent = `⚠️ Großzügiger Puffer (+${allocatedSum - targetTotal} Stk)`;
			labelStatus.style.color = 'var(--accent-blue)';
			barProgress.style.backgroundColor = 'var(--accent-blue)';
		} else {
			labelStatus.textContent = `⚠️ Es fehlen ${targetTotal - allocatedSum} Stk`;
			labelStatus.style.color = 'var(--accent-red)';
			barProgress.style.backgroundColor = 'var(--accent-red)';
		}

		if (guests <= 75) badgeVarietyRec.textContent = 'Empfohlen: 3–4 Sorten';
		else if (guests <= 125) badgeVarietyRec.textContent = 'Empfohlen: 4–5 Sorten';
		else if (guests <= 200) badgeVarietyRec.textContent = 'Empfohlen: 5–7 Sorten';
		else badgeVarietyRec.textContent = 'Empfohlen: 6–8 Sorten';

		const candyRate = parseFloat(selectCandyRatio.value) || 0.30;
		const totalCandyLbs = Math.round(guests * candyRate);
		const totalCandyKg = (totalCandyLbs * 0.453592).toFixed(1);
		statTotalCandy.textContent = `${totalCandyKg} kg`;
		statCandyKg.textContent = `(${totalCandyLbs} lbs / 6–8 Gläser)`;

		let lgJars = Math.max(1, Math.round(guests / 60));
		let medJars = Math.max(2, Math.round(guests / 40));
		let smJars = Math.max(2, Math.round(guests / 35));
		const totalJars = lgJars + medJars + smJars;

		document.getElementById('jar-large-count').textContent = `${lgJars}x Große Gläser (3–4 kg)`;
		document.getElementById('jar-med-count').textContent = `${medJars}x Mittlere Gläser (1.5–2.5 kg)`;
		document.getElementById('jar-small-count').textContent = `${smJars}x Flache Schalen (0.5–1 kg)`;
		document.getElementById('jar-total-count').textContent = `${totalJars} Glasgefäße`;

		const scoops = Math.min(8, Math.max(3, totalJars - 2));
		const tongs = Math.max(2, Math.round(totalJars / 3));
		const bagCount = Math.round(guests * 1.15);

		document.getElementById('hw-scoop-count').textContent = `${scoops}x Edelstahl / Acryl Schaufeln`;
		document.getElementById('hw-tong-count').textContent = `${tongs}x Mini-Zangen`;
		document.getElementById('hw-bag-count').textContent = `${bagCount} Kraftpapiertüten`;
		document.getElementById('hw-sticker-count').textContent = `${bagCount} Verschlussaufkleber`;

		if (guests <= 60) statTableSize.textContent = 'Tisch 1.5–1.8 m';
		else if (guests <= 140) statTableSize.textContent = 'Tisch 2.0–2.4 m';
		else statTableSize.textContent = '2 Tische à 2.0 m';
		statNapkinsCount.textContent = `${Math.round(guests * 1.5)} Cocktailservietten`;

		renderBakeryOrderTable();
		renderDietaryCardsPreview();
		updateSignPreview();
	}

	function renderBakeryOrderTable() {
		tbodyBakeryOrder.innerHTML = '';
		let printTableRows = '';

		dessertItems.forEach(item => {
			const doz = Math.ceil(item.count / 12);
			const units = doz * 12;
			let storageNote = 'Bei 18–22°C im Schatten lagern.';
			if (item.name.toLowerCase().includes('mousse') || item.name.toLowerCase().includes('törtchen') || item.name.toLowerCase().includes('gläschen')) {
				storageNote = 'Bei 4°C kühlen bis 30 Min vor Verzehr.';
			} else if (item.name.toLowerCase().includes('macaron')) {
				storageNote = 'Luftdicht lagern, vor Feuchtigkeit schützen.';
			}

			const tr = document.createElement('tr');
			tr.style.borderBottom = '1px solid #e2e8f0';
			tr.innerHTML = `
				<td style="padding:8px; font-weight:700; color:var(--fg-pencil);">${item.icon || '🧁'} ${item.name}</td>
				<td style="padding:8px;"><span style="font-size:0.8rem; background:#e2e8f0; padding:2px 6px; border-radius:4px; font-weight:600;">${item.dietary}</span></td>
				<td style="padding:8px; text-align:center; font-weight:600;">${item.count} Stk</td>
				<td style="padding:8px; text-align:center; font-weight:700; color:var(--accent-blue);">${doz} Dutzend (${units} Stk)</td>
				<td style="padding:8px; font-size:0.82rem; color:var(--text-secondary);">${storageNote}</td>
			`;
			tbodyBakeryOrder.appendChild(tr);

			printTableRows += `
				<tr style="border-bottom: 1pt solid #cbd5e1;">
					<td style="padding:6pt; font-weight:bold;">${item.name}</td>
					<td style="padding:6pt;">${item.dietary}</td>
					<td style="padding:6pt; text-align:center;">${item.count} Stk</td>
					<td style="padding:6pt; text-align:center; font-weight:bold; color:#1e40af;">${doz} Dutzend (${units} Stk)</td>
					<td style="padding:6pt; font-size:9pt; font-style:italic;">${storageNote}</td>
				</tr>
			`;
		});

		const candyRate = parseFloat(selectCandyRatio.value) || 0.30;
		const guests = parseInt(inputGuests.value) || 100;
		const totalCandyLbs = Math.round(guests * candyRate);
		const totalCandyKg = (totalCandyLbs * 0.453592).toFixed(1);

		const trCandy = document.createElement('tr');
		trCandy.style.background = '#fef08a';
		trCandy.style.borderBottom = '2px solid var(--fg-pencil)';
		trCandy.innerHTML = `
			<td style="padding:8px; font-weight:700; color:var(--fg-pencil);">🍬 Candy-Bar Süßigkeiten Sortiment</td>
			<td style="padding:8px;"><span style="font-size:0.8rem; background:#fff; padding:2px 6px; border-radius:4px; font-weight:600;">Gemischt</span></td>
			<td style="padding:8px; text-align:center; font-weight:600;">—</td>
			<td style="padding:8px; text-align:center; font-weight:700; color:#16a34a;">${totalCandyKg} kg (~${totalCandyLbs} lbs)</td>
			<td style="padding:8px; font-size:0.82rem; color:var(--fg-pencil);">Auf 6–8 Gläser verteilen inkl. Schaufeln & Tütchen.</td>
		`;
		tbodyBakeryOrder.appendChild(trCandy);

		const couple = document.getElementById('input-couple-names').value || 'Laura & Felix';
		const date = document.getElementById('input-wedding-date').value || '18. Oktober 2026';
		document.getElementById('print-bakery-meta').textContent = `Brautpaar: ${couple} | Datum: ${date} | Gäste: ${guests} | Art: ${currentFormat}`;
		
		document.getElementById('print-bakery-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Dessert / Leckerei</th>
						<th style="padding:6pt;">Allergene</th>
						<th style="padding:6pt; text-align:center;">Stück</th>
						<th style="padding:6pt; text-align:center;">Bestellung (Dutzend)</th>
						<th style="padding:6pt;">Lagerung & Handhabung</th>
					</tr>
				</thead>
				<tbody>
					${printTableRows}
					<tr style="background:#fef9c3; border-top:2pt solid #000; font-weight:bold;">
						<td style="padding:6pt;">Candy-Bar Sortiment</td>
						<td style="padding:6pt;">Gemischt</td>
						<td style="padding:6pt; text-align:center;">—</td>
						<td style="padding:6pt; text-align:center; color:#15803d;">${totalCandyKg} kg (${totalCandyLbs} lbs)</td>
						<td style="padding:6pt; font-size:9pt;">6–8 Apothekergläser + Schaufeln und 10x15cm Tütchen.</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	// Render Foldable Dietary Cards Preview & Paginated Print Sheets (4 per page, 2x2 grid)
	function renderDietaryCardsPreview() {
		dietaryCardsPreview.innerHTML = '';
		
		// 1. Update on-screen preview grid
		dessertItems.forEach(item => {
			const isDietary = item.dietary && item.dietary !== 'none';
			const card = document.createElement('div');
			card.style.background = '#fff';
			card.style.border = '1.5px solid var(--fg-pencil)';
			card.style.borderRadius = '6px';
			card.style.padding = '0.75rem';
			card.style.textAlign = 'center';
			card.style.boxShadow = '2px 2px 0px rgba(0,0,0,0.06)';
			card.innerHTML = `
				<span style="font-size:1.4rem; display:block; margin-bottom:0.25rem;">${item.icon || '🧁'}</span>
				<strong style="font-size:0.9rem; display:block; color:var(--fg-pencil); margin-bottom:0.25rem;">${item.name}</strong>
				<span style="font-size:0.75rem; color:${isDietary ? '#991b1b' : '#166534'}; font-weight:700; background:${isDietary ? '#fee2e2' : '#f0fdf4'}; padding:2px 6px; border-radius:4px; border:1px solid ${isDietary ? '#fca5a5' : '#86efac'}; display:inline-block;">
					${isDietary ? item.dietary : 'Frisch Gebacken'}
				</span>
			`;
			dietaryCardsPreview.appendChild(card);
		});

		// 2. Build multi-page printable tent card sheets (exactly 4 cards per page in 2x2 grid, NO page overflow)
		const chunkSize = 4;
		const totalSheets = Math.ceil(dessertItems.length / chunkSize) || 1;
		let sheetsHtml = '';

		for (let i = 0; i < dessertItems.length; i += chunkSize) {
			const chunk = dessertItems.slice(i, i + chunkSize);
			const sheetNum = Math.floor(i / chunkSize) + 1;
			
			let cardsHtml = '';
			chunk.forEach(item => {
				const isDietary = item.dietary && item.dietary !== 'none';
				const dietaryBadge = isDietary ? `Besondere Ernährung: ${item.dietary}` : 'Handgemachte Hochzeits-Leckerei';
				const badgeBg = isDietary ? '#fef2f2' : '#f0fdf4';
				const badgeBorder = isDietary ? '#f87171' : '#86efac';
				const badgeColor = isDietary ? '#991b1b' : '#166534';

				cardsHtml += `
					<div class="tent-card" style="border:1pt dashed #475569; border-radius:4px; box-sizing:border-box; height:108mm; display:flex; flex-direction:column; justify-content:space-between; background:#ffffff; page-break-inside:avoid; break-inside:avoid; overflow:hidden;">
						<!-- Top Fold Flap (Back of stand) -->
						<div style="height:50mm; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#f8fafc; border-bottom:1.5pt dashed #94a3b8; padding:3mm; text-align:center; box-sizing:border-box;">
							<span style="font-size:7.5pt; color:#64748b; letter-spacing:1.5pt; text-transform:uppercase; font-family:Arial,sans-serif; font-weight:700;">✂ ─── HIER FALTEN ─── ✂</span>
						</div>
						<!-- Bottom Display Face (Front of stand) -->
						<div style="height:58mm; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:3mm 6mm; text-align:center; box-sizing:border-box;">
							<span style="font-size:16pt; line-height:1; margin-bottom:2mm; display:block;">${item.icon || '🧁'}</span>
							<h3 style="font-size:13pt; font-family:'Georgia',serif; margin:0 0 2mm 0; color:#000000; line-height:1.2; font-weight:bold; word-break:break-word;">${item.name}</h3>
							<span style="font-size:8.5pt; font-family:Arial,sans-serif; font-weight:700; color:${badgeColor}; text-transform:uppercase; letter-spacing:0.5pt; background:${badgeBg}; padding:1.5px 7px; border-radius:3px; border:0.75pt solid ${badgeBorder}; display:inline-block;">
								${dietaryBadge}
							</span>
						</div>
					</div>
				`;
			});

			// If last sheet has fewer than 4 items, add blank template cards so the 2x2 grid remains balanced
			const remaining = chunkSize - chunk.length;
			for (let r = 0; r < remaining; r++) {
				cardsHtml += `
					<div class="tent-card" style="border:1pt dashed #cbd5e1; border-radius:4px; box-sizing:border-box; height:108mm; display:flex; flex-direction:column; justify-content:space-between; background:#ffffff; page-break-inside:avoid; break-inside:avoid; overflow:hidden;">
						<div style="height:50mm; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#fafafa; border-bottom:1pt dashed #cbd5e1; padding:3mm; text-align:center; box-sizing:border-box;">
							<span style="font-size:7.5pt; color:#94a3b8; letter-spacing:1.5pt; text-transform:uppercase; font-family:Arial,sans-serif; font-weight:600;">✂ HIER FALTEN ✂</span>
						</div>
						<div style="height:58mm; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:3mm 6mm; text-align:center; box-sizing:border-box;">
							<span style="font-size:14pt; color:#cbd5e1; margin-bottom:1.5mm;">✍️</span>
							<div style="width:75%; height:1pt; border-bottom:1pt dashed #cbd5e1; margin:3mm 0 2mm;"></div>
							<span style="font-size:8pt; color:#94a3b8; font-family:Arial,sans-serif; font-style:italic;">Platz für eigene Beschriftung</span>
						</div>
					</div>
				`;
			}

			sheetsHtml += `
				<div class="print-page print-tent-sheet" style="page-break-after:always; break-after:page; page-break-inside:avoid; break-inside:avoid; padding:6mm 10mm; box-sizing:border-box;">
					<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1.5pt solid #000; padding-bottom:2mm; margin-bottom:4mm;">
						<h2 style="font-family:Arial,sans-serif; font-size:11pt; margin:0; color:#000; font-weight:bold; text-transform:uppercase; letter-spacing:0.5pt;">Buffet-Kärtchen & Allergene (Schneiden & Falten)</h2>
						<span style="font-family:Arial,sans-serif; font-size:9pt; font-weight:bold; color:#475569;">Blatt ${sheetNum} von ${totalSheets}</span>
					</div>
					<div style="display:grid; grid-template-columns:1fr 1fr; grid-template-rows:108mm 108mm; gap:6mm; box-sizing:border-box;">
						${cardsHtml}
					</div>
				</div>
			`;
		}

		document.getElementById('print-tent-sheets-container').innerHTML = sheetsHtml;
	}

	function updateSignPreview() {
		const couple = document.getElementById('input-couple-names').value || 'Laura & Felix';
		const date = document.getElementById('input-wedding-date').value || '18. Oktober 2026';
		const template = document.getElementById('select-sign-template').value;
		const size = document.getElementById('select-sign-size').value;

		document.getElementById('sign-preview-couple').textContent = couple;
		document.getElementById('sign-preview-date').textContent = date;
		document.getElementById('preview-sign-dimension').textContent = size === '8x10' ? '8" x 10" (20x25cm)' : '5" x 7" (13x18cm)';

		const headline = document.getElementById('sign-preview-headline');
		const subtext = document.getElementById('sign-preview-subtext');

		if (template === 'cookie') {
			headline.textContent = 'Kuchenbuffet';
			subtext.textContent = 'Mit viel Liebe von Familie & Freunden gebacken. Bitte zugreifen!';
		} else if (template === 'candy') {
			headline.textContent = 'Ein süßes Ende';
			subtext.textContent = 'Für einen wundervollen Neuanfang! Schnappt euch ein Tütchen.';
		} else if (template === 'modern') {
			headline.textContent = 'Süße Freuden';
			subtext.textContent = 'Für unsere liebsten Gäste. Lasst es euch schmecken!';
		} else {
			headline.textContent = 'Liebe ist süß';
			subtext.textContent = 'Bitte bedient euch!';
		}

		document.getElementById('print-sign-title').textContent = headline.textContent;
		document.getElementById('print-sign-sub').textContent = subtext.textContent;
		document.getElementById('print-sign-names').textContent = couple;
		document.getElementById('print-sign-date').textContent = date;

		const printSignBox = document.getElementById('print-sign-box');
		if (printSignBox) {
			if (size === '5x7') {
				printSignBox.style.maxWidth = '140mm';
				printSignBox.style.maxHeight = '195mm';
				printSignBox.style.padding = '14mm 10mm';
			} else {
				printSignBox.style.maxWidth = '190mm';
				printSignBox.style.maxHeight = '230mm';
				printSignBox.style.padding = '18mm 14mm';
			}
		}
	}

	sliderGuests.addEventListener('input', (e) => {
		inputGuests.value = e.target.value;
		autoBalancePortions();
		updateCalculations();
	});

	inputGuests.addEventListener('input', (e) => {
		sliderGuests.value = e.target.value;
		autoBalancePortions();
		updateCalculations();
	});

	selectAppetite.addEventListener('change', () => {
		autoBalancePortions();
		updateCalculations();
	});

	chkTakeaway.addEventListener('change', () => {
		autoBalancePortions();
		updateCalculations();
	});

	selectCandyRatio.addEventListener('change', updateCalculations);

	document.getElementById('btn-auto-balance').addEventListener('click', () => {
		autoBalancePortions();
		updateCalculations();
	});

	document.getElementById('btn-reset-varieties').addEventListener('click', () => {
		dessertItems = [
			{ id: 'cupcakes', name: 'Mini-Cupcakes', icon: '🧁', ratio: 0.25, dietary: 'none', count: 65, dozens: 5.5, locked: false },
			{ id: 'macarons', name: 'Französische Macarons', icon: '🍓', ratio: 0.20, dietary: 'Glutenfrei', count: 50, dozens: 4.5, locked: false },
			{ id: 'tartlets', name: 'Frucht- & Zitronentörtchen', icon: '🥧', ratio: 0.15, dietary: 'none', count: 40, dozens: 3.5, locked: false },
			{ id: 'truffles', name: 'Handgemachte Edelschokotrüffel', icon: '🍫', ratio: 0.15, dietary: 'Glutenfrei', count: 40, dozens: 3.5, locked: false },
			{ id: 'shooters', name: 'Mousse- & Panna-Cotta-Gläschen', icon: '🍮', ratio: 0.15, dietary: 'none', count: 35, dozens: 3.0, locked: false },
			{ id: 'donuts', name: 'Mini-Donuts mit Glasur', icon: '🍩', ratio: 0.10, dietary: 'none', count: 20, dozens: 2.0, locked: false }
		];
		autoBalancePortions();
		updateCalculations();
	});

	document.getElementById('btn-add-custom-item').addEventListener('click', () => {
		const nameInput = document.getElementById('input-new-item-name');
		const dietaryInput = document.getElementById('select-new-item-dietary');
		const name = nameInput.value.trim();

		if (name) {
			dessertItems.push({
				id: 'custom-' + Date.now(),
				name: name,
				icon: '✨',
				ratio: 0.15,
				dietary: dietaryInput.value,
				count: 30,
				dozens: 2.5,
				locked: false
			});
			nameInput.value = '';
			renderDessertCards();
			updateCalculations();
		}
	});

	document.getElementById('input-couple-names').addEventListener('input', updateSignPreview);
	document.getElementById('input-wedding-date').addEventListener('input', updateSignPreview);
	document.getElementById('select-sign-template').addEventListener('change', updateSignPreview);
	document.getElementById('select-sign-size').addEventListener('change', updateSignPreview);

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		updateSignPreview();
		renderDietaryCardsPreview();
		updateCalculations();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const couple = document.getElementById('input-couple-names').value || 'Laura & Felix';
		const date = document.getElementById('input-wedding-date').value || '18. Oktober 2026';
		const guests = inputGuests.value || '100';

		let tableRowsDoc = '';
		dessertItems.forEach(item => {
			const doz = Math.ceil(item.count / 12);
			const units = doz * 12;
			tableRowsDoc += `
				<tr>
					<td style="padding:6pt; border:1pt solid #cbd5e1; font-weight:bold;">${item.name}</td>
					<td style="padding:6pt; border:1pt solid #cbd5e1;">${item.dietary}</td>
					<td style="padding:6pt; border:1pt solid #cbd5e1; text-align:center;">${item.count} Stk</td>
					<td style="padding:6pt; border:1pt solid #cbd5e1; text-align:center; font-weight:bold; color:#1e40af;">${doz} Dutzend (${units} Stk)</td>
				</tr>
			`;
		});

		const candyRate = parseFloat(selectCandyRatio.value) || 0.30;
		const totalCandyLbs = Math.round(parseInt(guests) * candyRate);
		const totalCandyKg = (totalCandyLbs * 0.453592).toFixed(1);

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Konditor-Bestellliste & Candy-Bar</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Bestellliste: Hochzeits-Dessertbuffet & Candy-Bar</h1>
				<p><strong>Brautpaar:</strong> ${couple} | <strong>Datum:</strong> ${date} | <strong>Gäste:</strong> ${guests}</p>
				<hr/>
				<h2>Aufstellung Konditor-Bestellung (Dutzende)</h2>
				<table>
					<tr style="background:#f1f5f9;">
						<th>Dessert / Leckerei</th><th>Allergene</th><th>Genaue Stück</th><th>Bestellung (Dutzend)</th>
					</tr>
					${tableRowsDoc}
				</table>
				<br/>
				<h2>Candy-Bar & Gläser-Staffelung</h2>
				<p><strong>Gesamtgewicht Süßigkeiten:</strong> ${totalCandyKg} kg (~${totalCandyLbs} lbs)</p>
				<p><strong>Gläser:</strong> 6–8 Apothekergläser in gestaffelten Höhen</p>
				<p><strong>Zubehör & Tütchen:</strong> 6x Schaufeln, 2x Zangen, ${Math.round(parseInt(guests) * 1.15)} Tütchen (10x15 cm) mit Siegelaufklebern.</p>
				<hr/>
				<p><em>Erstellt mit dem Manage.Wedding Dessert-Buffet Rechner</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Konditor-Bestellliste-Hochzeit-${couple.replace(/[^a-zA-Z0-9]/g, '-')}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	autoBalancePortions();
	updateCalculations();
</script>
