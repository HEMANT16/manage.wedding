---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "RSVP- & Einladungsfristen-Rechner Hochzeit | Fristenplaner (Kostenlos)";
const description = "Berechnen Sie exakte Versandtermine für Save-the-Date-Karten, Hochzeitseinladungen und die ideale Rückmeldefrist (RSVP) mit unserem kostenlosen Fristenrechner.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/rsvp-date-calculator/#webapp",
      "name": "RSVP- & Einladungsfristen-Rechner Hochzeit | Manage.Wedding",
      "url": "https://manage.wedding/de/rsvp-date-calculator",
      "inLanguage": "de",
      "description": "Ermitteln Sie exakte Kalendertermine für Save-the-Dates, den Einladungsversand und die Rückmeldefrist für Ihre Hochzeit.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie berechnet man den perfekten Zeitplan für Hochzeitseinladungen und Rückmeldefristen?",
      "description": "Ermitteln Sie die optimalen Meilensteine für Save-the-Dates, Einladungsversand und die finale Catering-Frist.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Hochzeitsdatum eingeben",
          "text": "Wählen Sie das Datum Ihrer standesamtlichen oder kirchlichen Trauung im Kalender aus."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Art der Hochzeit wählen (Lokal vs. Destination Wedding)",
          "text": "Aktivieren Sie die Option für Auslandshochzeiten, falls Gäste Flüge und Urlaubsreisen buchen müssen."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Meilensteine berechnen",
          "text": "Erhalten Sie konkrete Kalenderdaten für Save-the-Dates (6–8 Monate vorher), Einladungsversand (8–10 Wochen vorher) und die Rückmeldefrist (4 Wochen vorher)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Nachzügler-Puffer für die Location einplanen",
          "text": "Stellen Sie sicher, dass Ihre Rückmeldefrist mindestens 10 bis 14 Tage vor der finalen Abgabefrist der Location liegt."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "de",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie funktioniert der RSVP-Fristenrechner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Der Rechner zieht vom Hochzeitsdatum die bewährten Branchenstandards ab: 6 Monate für Save-the-Dates, 8 bis 10 Wochen für die Einladungen und 4 Wochen für die Rückmeldefrist (bei Auslandshochzeiten automatisch erweitert)."
          }
        },
        {
          "@type": "Question",
          "name": "Wann sollte die Rückmeldefrist gesetzt werden, wenn der Caterer 14 Tage vorher Zahlen braucht?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Setzen Sie die Frist auf 4 Wochen vor der Hochzeit. Dadurch gewinnen Sie 14 Tage wertvollen Puffer, um säumigen Gästen nachzutelefonieren, bevor die Location die verbindliche Zahl verlangt."
          }
        },
        {
          "@type": "Question",
          "name": "Sind Save-the-Date-Karten wirklich notwendig?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei Sommerhochzeiten (Mai bis September), Brückentagen, Feiertagen oder wenn viele Gäste von weiter her anreisen: Unbedingt! Bei einer sehr kleinen, lokalen Feier kann man direkt Einladungskarten versenden."
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
    <Breadcrumb title="RSVP-Fristenrechner" category="guests" />

    <div class="home-grid" style="display: block; max-width: 800px; margin: 0 auto;">
      
      <div class="hand-card wobbly-border fade-in" style="background: #fff; padding: 2rem;">
        <div class="tape"></div>
        <div class="badge-postit">Kostenloses Tool</div>
        <h1 class="font-heading" style="font-size: 2.4rem; color: var(--accent-red); margin-bottom: 0.5rem; text-align: center;">
          RSVP- & Einladungsfristen-Rechner
        </h1>
        <p class="font-body" style="text-align: center; margin-bottom: 2rem; color: var(--text-secondary); font-size: 1.1rem;">
          Erfahren Sie auf den Tag genau, wann Save-the-Dates, Einladungskarten und Rückmeldefristen in den Briefkasten gehören!
        </p>

        <form id="calculator-form">
          <div class="form-group" style="margin-bottom: 1.5rem;">
            <label for="wedding-date" class="form-label" style="font-weight: 700; font-size: 1.05rem;">
              Wann ist der große Tag? (Hochzeitsdatum)
            </label>
            <input type="date" id="wedding-date" class="form-input" required style="width: 100%; padding: 0.75rem; font-size: 1.1rem; border: 2px solid var(--fg-pencil); border-radius: 4px;" />
          </div>

          <div class="form-group" style="display: flex; align-items: center; gap: 0.75rem; margin: 1.5rem 0; padding: 0.75rem; background: var(--bg-paper); border: 2px dashed var(--fg-pencil); border-radius: 4px;">
            <input type="checkbox" id="destination-wedding" style="width: 22px; height: 22px; cursor: pointer; accent-color: var(--accent-blue);" />
            <label for="destination-wedding" class="font-body" style="margin: 0; cursor: pointer; font-size: 1rem; color: var(--fg-pencil);">
              <strong>Auslandshochzeit / Destination Wedding</strong> (Flug- & Urlaubsplanung nötig)
            </label>
          </div>

          <div style="text-align: center;">
            <button type="submit" class="hand-btn" style="padding: 0.9rem 2rem; font-size: 1.15rem;">
              ✨ Meilensteine berechnen!
            </button>
          </div>
        </form>

        <div id="result-box" class="result-box wobbly-border-dashed" style="margin-top: 2.5rem; display: none; background: #fffcf5; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.5rem;">
          <h3 class="font-heading" style="text-align: center; font-size: 1.8rem; margin-bottom: 1.5rem; color: var(--fg-pencil);">
            📅 Ihr optimaler Papeterie-Zeitplan
          </h3>
          
          <div class="result-item" style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; border-bottom: 1px dashed var(--fg-pencil);">
            <div class="item-label" style="font-weight: 700;">💌 Save-the-Date-Karten versenden</div>
            <div class="item-value" id="res-std" style="font-weight: 700; color: var(--accent-blue);">--</div>
          </div>
          <div class="result-item" style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; border-bottom: 1px dashed var(--fg-pencil);">
            <div class="item-label" style="font-weight: 700;">📜 Hochzeitseinladungen versenden</div>
            <div class="item-value" id="res-inv" style="font-weight: 700; color: var(--accent-blue);">--</div>
          </div>
          <div class="result-item" style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem;">
            <div class="item-label" style="font-weight: 700; color: var(--accent-red);">⏰ Offizielle Rückmeldefrist (RSVP)</div>
            <div class="item-value" id="res-rsvp" style="font-weight: 800; color: var(--accent-red);">--</div>
          </div>

          <!-- Dynamic Graph -->
          <div style="margin-top: 2rem; position: relative; padding-top: 1.5rem;">
            <div style="position: absolute; top: 0; left: 0; right: 0; border-top: 2px dashed var(--fg-pencil);"></div>
            <h4 class="font-heading" style="text-align: center; margin-bottom: 1rem; color: var(--fg-pencil); font-size: 1.1rem;">
              Visueller Fristenstrahl
            </h4>
            <div style="display: flex; height: 38px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #fff;">
              <div id="bar-std" style="width: 33.3%; background-color: var(--post-it); border-right: 2px solid var(--fg-pencil); transition: width 0.5s ease; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 0.85rem;" title="Save-the-Date">Save-the-Date</div>
              <div id="bar-inv" style="width: 33.3%; background-color: var(--accent-blue); color: white; border-right: 2px solid var(--fg-pencil); transition: width 0.5s ease; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 0.85rem;" title="Einladungen">Einladungen</div>
              <div id="bar-rsvp" style="width: 33.4%; background-color: var(--accent-red); color: white; transition: width 0.5s ease; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 0.85rem;" title="Frist bis Hochzeit">Frist bis Fest</div>
            </div>
          </div>
        </div>

      </div>

      <!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
      <div class="hand-card" style="margin: 3rem auto 0 auto; max-width: 800px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
        <div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: gap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
          <h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
            <span>⚡</span> Auf einen Blick (BLUF): Der Fristen-Standard
          </h2>
          <span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
            1-Minuten Kalender
          </span>
        </div>
        
        <!-- Core Formula Banner -->
        <div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
          <p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
            <strong>Die Faustformel für den Postversand:</strong> 
            <span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Save-the-Date = 6–8 Monate vorher</span> · 
            <span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Einladung = 8–10 Wochen vorher</span> · 
            <span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Rückmeldefrist = 4 Wochen vorher</span>
          </p>
          <p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
            <strong>Auslandshochzeiten / Destination Weddings:</strong> Save-the-Date <strong>9–12 Monate</strong> vorher, Einladungen <strong>12–16 Wochen</strong> vorher und Rückmeldefrist <strong>6–8 Wochen</strong> vor Abreise.
          </p>
        </div>

        <!-- Semantic Benchmark Table -->
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Meilenstein</th>
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Lokale Hochzeit</th>
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Ausland / Feiertag</th>
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Aktion der Gäste</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Save-the-Date-Karten</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">6–8 Monate vorher</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">9–12 Monate vorher</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Termin im Kalender blocken</td>
              </tr>
              <tr style="background: #faf8f3;">
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Hotel-Zimmerkontingent</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">5–6 Monate vorher</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">8–10 Monate vorher</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Zimmer mit Abrufkontingent buchen</td>
              </tr>
              <tr>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Offizielle Einladungen</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">8–10 Wochen vorher</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">12–16 Wochen vorher</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Menüwahl & Begleitung angeben</td>
              </tr>
              <tr style="background: #faf8f3;">
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Rückmeldeschluss (RSVP)</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">4 Wochen vorher</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">6–8 Wochen vorher</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Verbindliche Zusage / Absage</td>
              </tr>
              <tr>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Finale Kopfzahl Location</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">14 Tage vorher</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">21–30 Tage vorher</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Verbindliche Rechnungsbasis</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- SEO Article -->
      <article class="hand-card fade-in" style="margin-top: 3rem; background-color: #fff; padding: 2rem;">
        <h2 class="font-heading" style="font-size: 2rem; color: var(--accent-blue); margin-bottom: 1.5rem;">
          Ratgeber: Papeterie-Fristen für die Hochzeit stressfrei timen
        </h2>
        
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil);">
          Die Planung einer Hochzeit gleicht einem Orchester: Werden Einladungen zu früh verschickt, geraten sie im Alltagstrubel in Vergessenheit. Werden sie zu spät versendet, müssen Gäste Urlaube umplanen und die Location wartet vergeblich auf verbindliche Essenszahlen.
        </p>
        
        <div style="text-align: center; margin: 2rem 0;">
          <img src="/images/postbox-sketch.webp" alt="RSVP-Fristenrechner — Zeitplan für Einladungskarten" loading="lazy" decoding="async" style="max-width: 100%; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 4px 4px 0px var(--fg-pencil); width: 300px; height: auto;" />
        </div>

        <h3 class="font-heading" style="font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem; color: var(--fg-pencil);">
          Warum der 14-Tage-Puffer so entscheidend ist
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil);">
          Caterer und Eventlocations verlangen in ihren Verträgen meist <strong>10 bis 14 Tage vor dem Event</strong> die exakte Personen- und Menüzahl, auf deren Basis eingekauft und abgerechnet wird. Setzen Sie die Frist auf Ihren Einladungskarten daher stets auf <strong>4 Wochen vor dem Termin</strong>. So bleiben Ihnen volle 14 Tage Zeit, säumigen Gästen nachzutelefonieren oder Nachrücker von der B-Liste einzuladen.
        </p>

        <h3 class="font-heading" style="font-size: 1.8rem; margin-top: 3rem; margin-bottom: 1.5rem; color: var(--accent-red);">
          Häufig gestellte Fragen (FAQ)
        </h3>
        
        <div class="faq-container">
          <details style="margin-bottom: 1rem; border: 2px dashed var(--fg-pencil); padding: 1rem; background: var(--post-it); border-radius: 4px; cursor: pointer;">
            <summary class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); outline: none;">
              Wie funktioniert die Berechnung genau?
            </summary>
            <p style="margin-top: 0.75rem; margin-bottom: 0; line-height: 1.6;">
              Der Rechner nimmt Ihr Hochzeitsdatum und zieht die optimalen Zeitspannen ab: 6 Monate für Save-the-Dates, 8 Wochen für die Einladungen und 4 Wochen für die Frist. Bei Auslandshochzeiten werden die Fristen automatisch verlängert.
            </p>
          </details>
          
          <details style="margin-bottom: 1rem; border: 2px dashed var(--fg-pencil); padding: 1rem; background: var(--post-it); border-radius: 4px; cursor: pointer;">
            <summary class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); outline: none;">
              Was tun, wenn man mit dem Zeitplan im Verzug ist?
            </summary>
            <p style="margin-top: 0.75rem; margin-bottom: 0; line-height: 1.6;">
              Keine Panik! Versenden Sie die Einladungen schnellstmöglich und bieten Sie den Gästen eine digitale Rückmeldung (per WhatsApp, E-Mail oder Hochzeits-Website mit QR-Code) an, um die Antwortzeit zu halbieren.
            </p>
          </details>
        </div>
      </article>

    </div>

    <RelatedTools currentPath="/de/rsvp-date-calculator" category="guests" />
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('calculator-form');
    const resultBox = document.getElementById('result-box');
    const resStd = document.getElementById('res-std');
    const resInv = document.getElementById('res-inv');
    const resRsvp = document.getElementById('res-rsvp');
    const barStd = document.getElementById('bar-std');
    const barInv = document.getElementById('bar-inv');
    const barRsvp = document.getElementById('bar-rsvp');

    if(form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const dateInput = (document.getElementById('wedding-date') as HTMLInputElement).value;
        const isDestination = (document.getElementById('destination-wedding') as HTMLInputElement).checked;
        
        if (!dateInput) return;

        const parts = dateInput.split('-');
        const weddingDate = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
        
        let stdDate = new Date(weddingDate.getTime());
        let invDate = new Date(weddingDate.getTime());
        let rsvpDate = new Date(weddingDate.getTime());

        if (isDestination) {
          stdDate.setMonth(stdDate.getMonth() - 9);
          invDate.setDate(invDate.getDate() - (12 * 7));
          rsvpDate.setDate(rsvpDate.getDate() - (6 * 7));
        } else {
          stdDate.setMonth(stdDate.getMonth() - 6);
          invDate.setDate(invDate.getDate() - (8 * 7));
          rsvpDate.setDate(rsvpDate.getDate() - (4 * 7));
        }

        const options: Intl.DateTimeFormatOptions = { weekday: 'short', year: 'numeric', month: 'long', day: 'numeric' };
        
        resStd!.textContent = stdDate.toLocaleDateString('de-DE', options);
        resInv!.textContent = invDate.toLocaleDateString('de-DE', options);
        resRsvp!.textContent = rsvpDate.toLocaleDateString('de-DE', options);

        if (resultBox) resultBox.style.display = 'block';

        const totalDuration = weddingDate.getTime() - stdDate.getTime();
        if (totalDuration > 0) {
          const stdToInv = invDate.getTime() - stdDate.getTime();
          const invToRsvp = rsvpDate.getTime() - invDate.getTime();
          const rsvpToWed = weddingDate.getTime() - rsvpDate.getTime();

          const stdPct = (stdToInv / totalDuration) * 100;
          const invPct = (invToRsvp / totalDuration) * 100;
          const rsvpPct = (rsvpToWed / totalDuration) * 100;
          
          barStd!.style.width = `${stdPct}%`;
          barInv!.style.width = `${invPct}%`;
          barRsvp!.style.width = `${rsvpPct}%`;
        }
      });
    }
  });
</script>
