<script is:inline>
	let currencySymbol = '€';

	const tierSelect = document.getElementById('select-floral-tier');
	const bridalInput = document.getElementById('qty-bridal-bouquet');
	const bridesmaidInput = document.getElementById('qty-bridesmaid-bouquets');
	const boutonniereInput = document.getElementById('qty-boutonnieres');
	const corsageInput = document.getElementById('qty-corsages');

	const archSelect = document.getElementById('select-arch');
	const aisleInput = document.getElementById('qty-aisle-posies');
	const welcomeInput = document.getElementById('qty-welcome-sign');

	const lowCenterpieceInput = document.getElementById('qty-low-centerpieces');
	const tallCenterpieceInput = document.getElementById('qty-tall-centerpieces');
	const sweetheartInput = document.getElementById('qty-sweetheart-garland');
	const cakeInput = document.getElementById('qty-cake-flowers');

	const laborPctInput = document.getElementById('input-labor-pct');
	const deliveryFeeInput = document.getElementById('input-delivery-fee');
	const deliveryCurrSym = document.getElementById('delivery-curr-sym');
	const currencySelect = document.getElementById('currency-select');

	// Result Elements
	const resGrandTotal = document.getElementById('res-grand-total');
	const resTierSummary = document.getElementById('res-tier-summary');
	const resPersonalSubtotal = document.getElementById('res-personal-subtotal');
	const resCeremonySubtotal = document.getElementById('res-ceremony-subtotal');
	const resReceptionSubtotal = document.getElementById('res-reception-subtotal');
	const resStemsSubtotal = document.getElementById('res-stems-subtotal');
	const resLaborAmount = document.getElementById('res-labor-amount');
	const resDeliveryAmount = document.getElementById('res-delivery-amount');

	const barPersonal = document.getElementById('bar-personal');
	const barCeremony = document.getElementById('bar-ceremony');
	const barReception = document.getElementById('bar-reception');
	const barLabor = document.getElementById('bar-labor');

	function formatMoney(amount) {
		const val = Math.round(amount).toLocaleString('de-DE');
		if (currencySymbol === '€' || currencySymbol === 'CHF') {
			return `${val} ${currencySymbol}`;
		}
		return `${currencySymbol}${val}`;
	}

	function calculateFlorals() {
		currencySymbol = currencySelect.value;
		deliveryCurrSym.textContent = currencySymbol;

		const tierMult = parseFloat(tierSelect.value) || 1.5;
		const laborPct = (parseFloat(laborPctInput.value) || 20) / 100;
		const deliveryFee = parseFloat(deliveryFeeInput.value) || 120;

		// 1. Personal Florals
		const bridalCost = (parseInt(bridalInput.value) || 0) * 140 * tierMult;
		const bridesmaidCost = (parseInt(bridesmaidInput.value) || 0) * 70 * tierMult;
		const boutonniereCost = (parseInt(boutonniereInput.value) || 0) * 18 * tierMult;
		const corsageCost = (parseInt(corsageInput.value) || 0) * 28 * tierMult;
		const personalSubtotal = bridalCost + bridesmaidCost + boutonniereCost + corsageCost;

		// 2. Ceremony Florals
		const archCost = (parseFloat(archSelect.value) || 0) * tierMult;
		const aisleCost = (parseInt(aisleInput.value) || 0) * 45 * tierMult;
		const welcomeCost = (parseInt(welcomeInput.value) || 0) * 55 * tierMult;
		const ceremonySubtotal = archCost + aisleCost + welcomeCost;

		// 3. Reception Florals
		const lowCenterCost = (parseInt(lowCenterpieceInput.value) || 0) * 85 * tierMult;
		const tallCenterCost = (parseInt(tallCenterpieceInput.value) || 0) * 190 * tierMult;
		const sweetheartCost = (parseInt(sweetheartInput.value) || 0) * 150 * tierMult;
		const cakeCost = (parseInt(cakeInput.value) || 0) * 35 * tierMult;
		const receptionSubtotal = lowCenterCost + tallCenterCost + sweetheartCost + cakeCost;

		// Stems subtotal
		const stemsSubtotal = personalSubtotal + ceremonySubtotal + receptionSubtotal;
		const laborCost = stemsSubtotal * laborPct;
		const grandTotal = stemsSubtotal + laborCost + deliveryFee;

		// Update UI
		resGrandTotal.textContent = formatMoney(grandTotal);
		resTierSummary.textContent = `${tierSelect.options[tierSelect.selectedIndex].text.split('(')[0]}`;

		resPersonalSubtotal.textContent = formatMoney(personalSubtotal);
		resCeremonySubtotal.textContent = formatMoney(ceremonySubtotal);
		resReceptionSubtotal.textContent = formatMoney(receptionSubtotal);
		resStemsSubtotal.textContent = formatMoney(stemsSubtotal);
		resLaborAmount.textContent = formatMoney(laborCost);
		resDeliveryAmount.textContent = formatMoney(deliveryFee);

		// Proportions
		if (grandTotal > 0) {
			barPersonal.style.width = `${(personalSubtotal / grandTotal) * 100}%`;
			barCeremony.style.width = `${(ceremonySubtotal / grandTotal) * 100}%`;
			barReception.style.width = `${(receptionSubtotal / grandTotal) * 100}%`;
			barLabor.style.width = `${((laborCost + deliveryFee) / grandTotal) * 100}%`;
		}
	}

	// Listeners
	document.querySelectorAll('.floral-input, #input-labor-pct, #input-delivery-fee').forEach(el => {
		el.addEventListener('input', calculateFlorals);
	});
	[tierSelect, archSelect, currencySelect].forEach(el => {
		el.addEventListener('change', calculateFlorals);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const tierName = tierSelect.options[tierSelect.selectedIndex].text;
		const tierMult = parseFloat(tierSelect.value) || 1.0;

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Floristik Kostenvoranschlag Hochzeit</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Offizieller Floristik-Kostenvoranschlag</h1>
				<p>Erstellt am ${new Date().toLocaleDateString('de-DE')} | Qualitätsstufe: <strong>${tierName}</strong> | Gesamtsumme: <strong>${resGrandTotal.textContent}</strong></p>
				
				<h3>Aufstellung der Blumen & Gestecke:</h3>
				<table>
					<thead>
						<tr><th>Floristik-Position</th><th style="text-align:center;">Menge</th><th style="text-align:right;">Zwischensumme</th></tr>
					</thead>
					<tbody>
						<tr><td>Brautstrauß</td><td style="text-align:center;">${bridalInput.value}</td><td style="text-align:right;">${formatMoney(bridalInput.value * 140 * tierMult)}</td></tr>
						<tr><td>Brautjungfern-Sträuße</td><td style="text-align:center;">${bridesmaidInput.value}</td><td style="text-align:right;">${formatMoney(bridesmaidInput.value * 70 * tierMult)}</td></tr>
						<tr><td>Anstecker / Boutonnières</td><td style="text-align:center;">${boutonniereInput.value}</td><td style="text-align:right;">${formatMoney(boutonniereInput.value * 18 * tierMult)}</td></tr>
						<tr><td>Blumenarmbänder / Mütter</td><td style="text-align:center;">${corsageInput.value}</td><td style="text-align:right;">${formatMoney(corsageInput.value * 28 * tierMult)}</td></tr>
						<tr><td>Traubogen / Bogen-Floristik</td><td style="text-align:center;">1</td><td style="text-align:right;">${formatMoney(archSelect.value * tierMult)}</td></tr>
						<tr><td>Gang-Deko / Stuhlschmuck</td><td style="text-align:center;">${aisleInput.value}</td><td style="text-align:right;">${formatMoney(aisleInput.value * 45 * tierMult)}</td></tr>
						<tr><td>Willkommensschild-Floristik</td><td style="text-align:center;">${welcomeInput.value}</td><td style="text-align:right;">${formatMoney(welcomeInput.value * 55 * tierMult)}</td></tr>
						<tr><td>Flache Tischgestecke</td><td style="text-align:center;">${lowCenterpieceInput.value}</td><td style="text-align:right;">${formatMoney(lowCenterpieceInput.value * 85 * tierMult)}</td></tr>
						<tr><td>Hohe Centerpiece-Ständer</td><td style="text-align:center;">${tallCenterpieceInput.value}</td><td style="text-align:right;">${formatMoney(tallCenterpieceInput.value * 190 * tierMult)}</td></tr>
						<tr><td>Brauttisch-Girlande</td><td style="text-align:center;">${sweetheartInput.value}</td><td style="text-align:right;">${formatMoney(sweetheartInput.value * 150 * tierMult)}</td></tr>
						<tr><td>Tortenblumen</td><td style="text-align:center;">${cakeInput.value}</td><td style="text-align:right;">${formatMoney(cakeInput.value * 35 * tierMult)}</td></tr>
						<tr style="background:#f9f9f9; font-weight:bold;"><td>Zwischensumme Blumen</td><td style="text-align:center;">-</td><td style="text-align:right;">${resStemsSubtotal.textContent}</td></tr>
						<tr><td>Floristen-Aufbau vor Ort (${laborPctInput.value}%)</td><td style="text-align:center;">-</td><td style="text-align:right;">${resLaborAmount.textContent}</td></tr>
						<tr><td>Kühltransporter & Anfahrt</td><td style="text-align:center;">-</td><td style="text-align:right;">${resDeliveryAmount.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;"><td>Gesamter Floristik-Kostenvoranschlag</td><td style="text-align:center;">-</td><td style="text-align:right; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Floristik_Kalkulation_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('de-DE');
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tierMult = parseFloat(tierSelect.value) || 1.0;
		const tbody = document.getElementById('print-floral-body');

		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Brautstrauß</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${bridalInput.value}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(bridalInput.value * 140 * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Brautjungfern-Sträuße</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${bridesmaidInput.value}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(bridesmaidInput.value * 70 * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Anstecker & Corsagen</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(boutonniereInput.value) + parseInt(corsageInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((boutonniereInput.value * 18 + corsageInput.value * 28) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Traubogen / Bogen-Floristik</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">1</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(archSelect.value * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Gang-Deko & Willkommensschild</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(aisleInput.value) + parseInt(welcomeInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((aisleInput.value * 45 + welcomeInput.value * 55) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Flache & Hohe Tischgestecke</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(lowCenterpieceInput.value) + parseInt(tallCenterpieceInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((lowCenterpieceInput.value * 85 + tallCenterpieceInput.value * 190) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Brauttisch-Girlande & Tortenblumen</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(sweetheartInput.value) + parseInt(cakeInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((sweetheartInput.value * 150 + cakeInput.value * 35) * tierMult)}</td></tr>
			<tr style="background:#fafafa;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Zwischensumme Blumen</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resStemsSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Aufbau & Montage (${laborPctInput.value}%)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resLaborAmount.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Kühlwagen-Lieferung</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDeliveryAmount.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:14px;">Gesamtsumme Floristik</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:14px;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const tierMult = parseFloat(tierSelect.value) || 1.0;
		let csv = "Element,Anzahl,Zwischensumme\n";
		csv += `"Brautstrauß",${bridalInput.value},"${formatMoney(bridalInput.value * 140 * tierMult)}"\n`;
		csv += `"Brautjungfern-Sträuße",${bridesmaidInput.value},"${formatMoney(bridesmaidInput.value * 70 * tierMult)}"\n`;
		csv += `"Anstecker",${boutonniereInput.value},"${formatMoney(boutonniereInput.value * 18 * tierMult)}"\n`;
		csv += `"Blumenarmbänder",${corsageInput.value},"${formatMoney(corsageInput.value * 28 * tierMult)}"\n`;
		csv += `"Traubogen",1,"${formatMoney(archSelect.value * tierMult)}"\n`;
		csv += `"Gang-Deko",${aisleInput.value},"${formatMoney(aisleInput.value * 45 * tierMult)}"\n`;
		csv += `"Willkommensschild",${welcomeInput.value},"${formatMoney(welcomeInput.value * 55 * tierMult)}"\n`;
		csv += `"Flache Tischgestecke",${lowCenterpieceInput.value},"${formatMoney(lowCenterpieceInput.value * 85 * tierMult)}"\n`;
		csv += `"Hohe Centerpieces",${tallCenterpieceInput.value},"${formatMoney(tallCenterpieceInput.value * 190 * tierMult)}"\n`;
		csv += `"Brauttisch-Girlande",${sweetheartInput.value},"${formatMoney(sweetheartInput.value * 150 * tierMult)}"\n`;
		csv += `"Tortenblumen",${cakeInput.value},"${formatMoney(cakeInput.value * 35 * tierMult)}"\n`;
		csv += `"Zwischensumme Blumen",-,"${resStemsSubtotal.textContent}"\n`;
		csv += `"Aufbau & Montage",-,"${resLaborAmount.textContent}"\n`;
		csv += `"Lieferung",-,"${resDeliveryAmount.textContent}"\n`;
		csv += `"Gesamtbetrag",-,"${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Floristik_Kalkulation_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateFlorals();
</script>
