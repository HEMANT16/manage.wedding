---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/floral-cost-estimator/#webapp",
      "name": "Hochzeitsblumen & Floristik-Kostenrechner",
      "url": "https://manage.wedding/de/floral-cost-estimator",
      "description": "Kostenloser Floristik-Kostenrechner für die Hochzeit: Berechnen Sie Preise für Brautstrauß, Anstecker, Traubogen, Tischdeko, Floristen-Aufbau und Lieferkosten. Mit Word-, PDF- & CSV-Export.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "inLanguage": "de",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie man die Floristik-Kosten für eine Hochzeit berechnet",
      "description": "Schritt-für-Schritt-Anleitung zur Kalkulation von Brautsträußen, Traubögen, Tischgestecken und Floristen-Arbeitskosten.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Personelle Floristik erfassen",
          "text": "Zählen Sie Brautstrauß, Brautjungfernsträuße, Anstecker für Bräutigam und Trauzeugen sowie Corsagen für Mütter."
        },
        {
          "@type": "HowToStep",
          "name": "2. Trauzeremonie-Dekoration festlegen",
          "text": "Wählen Sie zwischen dezentem Stuhlschmuck, einem Eck-Gesteck oder einem voll bestückten floralen Traubogen."
        },
        {
          "@type": "HowToStep",
          "name": "3. Tischdekoration für die Feier berechnen",
          "text": "Multiplizieren Sie die Tischanzahl mit flachen Gestecken (70–140 €) oder hohen Ständern (160–300 €)."
        },
        {
          "@type": "HowToStep",
          "name": "4. Floristen-Aufbau & Anfahrt einkalkulieren",
          "text": "Planen Sie 20% bis 30% Aufschlag für Vorbereitung, Stiel-Wässerung, Kühlung, Vor-Ort-Montage und Abbau ein."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wie viel kosten Hochzeitsblumen im Durchschnitt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Im deutschsprachigen Raum geben Brautpaare durchschnittlich 2.000 € bis 4.500 € für Hochzeitsfloristik aus (ca. 8% bis 12% des Gesamtbudgets). Der Preis variiert stark nach Blumenart (z. B. Pfingstrosen vs. saisonale Rosen), Dichte der Gestecke und Größe des Traubogens."
          }
        },
        {
          "@type": "Question",
          "name": "Was kostet ein Brautstrauß beim Floristen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein klassischer, handgebundener Brautstrauß kostet zwischen 120 € und 200 €. Aufwendige Fine-Art-Sträuße mit echten Gartenrosen, Pfingstrosen oder Orchideen liegen meist bei 220 € bis 350 €."
          }
        },
        {
          "@type": "Question",
          "name": "Warum berechnen Floristen Aufbau- und Arbeitskosten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hochzeitsfloristik erfordert tagelange Vorarbeit: Blumen werden gereinigt, entdornt, in Kühlräumen punktgenau zum Blühen gebracht, gesteckt und am Hochzeitstag mit Kühltransportern zur Location gefahren und vor Ort montiert."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Hochzeitsblumen & Floristik Kostenrechner (Blumenbudget Planer) | Manage.Wedding"
	description="Kostenloser Floristik-Kostenrechner: Berechnen Sie Preise für Brautstrauß, Anstecker, Traubogen, Tischdeko, Aufbau- & Liefergebühren. Mit Word- & PDF-Export."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Hochzeitsblumen Kostenrechner" category="budget" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Hochzeitsblumen <span class="accent-italic">& Floristikrechner</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Kalkulieren Sie Ihr Blumenbudget mit Stiel-Genauigkeit. Berechnen Sie Brautsträuße, Traubögen, Tischgestecke, Floristen-Aufbau und exportieren Sie Ihre <strong>Floristik-Anfrage</strong> in <strong>Word (.doc)</strong> oder <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="floral-calc-grid">
			
			<!-- Left Column: Itemized Floral Quantities -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							🌸 Blumen & Stückzahlen wählen
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Personelle Floristik, Trauung und Tischdekoration
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Währung:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="CHF">CHF (Schweiz)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="floral-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- Floral Density & Bloom Quality Tier -->
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<label for="select-floral-tier" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem; text-align: center;">
							✨ Blumenqualität & Gestaltungsdichte
						</label>
						<select id="select-floral-tier" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="1.0">Standard / Saisonale Mischung (Rosen, Nelken, Eukalyptus) (1.0x)</option>
							<option value="1.5" selected>Romantischer Klassiker (Gartenrosen, Ranunkeln, Hortensien) (1.5x)</option>
							<option value="2.2">Luxus Fine-Art (Pfingstrosen, Anemonen, Orchideen, Edelwicken) (2.2x)</option>
						</select>
					</div>

					<!-- Category 1: Personal Wedding Party Flowers -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							👰 1. Brautstrauß & Anstecker
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="qty-bridal-bouquet" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Brautstrauß (140 €)</label>
								<input type="number" id="qty-bridal-bouquet" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-bridesmaid-bouquets" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Brautjungfern-Sträuße (70 €)</label>
								<input type="number" id="qty-bridesmaid-bouquets" value="3" min="0" max="20" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-boutonnieres" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Anstecker / Boutonnières (18 €)</label>
								<input type="number" id="qty-boutonnieres" value="5" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-corsages" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Blumenarmbänder / Mütter (28 €)</label>
								<input type="number" id="qty-corsages" value="3" min="0" max="20" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Category 2: Ceremony Florals -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-blue); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							⛪ 2. Trauung & Traubogen
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="select-arch" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Traubogen / Bogen-Floristik</label>
								<select id="select-arch" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="0">Kein Traubogen (0 €)</option>
									<option value="350" selected>Eckgesteck für Traubogen (350 €)</option>
									<option value="750">Halb- bis Vollbogen (750 €)</option>
									<option value="1200">Luxus-Floral-Säulen / Vollbogen üppig (1.200 €)</option>
								</select>
							</div>
							<div>
								<label for="qty-aisle-posies" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Gang-Deko / Stuhlschmuck (45 €)</label>
								<input type="number" id="qty-aisle-posies" value="6" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div style="grid-column: span 2;">
								<label for="qty-welcome-sign" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Willkommensschild-Floristik (55 €)</label>
								<input type="number" id="qty-welcome-sign" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Category 3: Reception Table Florals -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: #16a34a; margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							🍽️ 3. Tischdekoration & Feier
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="qty-low-centerpieces" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Flache Tischgestecke (85 €)</label>
								<input type="number" id="qty-low-centerpieces" value="8" min="0" max="40" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-tall-centerpieces" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Hohe Centerpiece-Ständer (190 €)</label>
								<input type="number" id="qty-tall-centerpieces" value="2" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-sweetheart-garland" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Brauttisch-Girlande (150 €)</label>
								<input type="number" id="qty-sweetheart-garland" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-cake-flowers" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Tortenblumen (35 €)</label>
								<input type="number" id="qty-cake-flowers" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Delivery & Labor Settings -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-labor-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Vor-Ort-Aufbau & Floristen-Arbeit
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-labor-pct" value="20" min="0" max="35" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>

						<div>
							<label for="input-delivery-fee" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Kühlwagen-Lieferung & Anfahrt
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-delivery-fee" value="120" min="0" max="1000" step="20" style="width: 70px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span id="delivery-curr-sym" style="font-weight: bold;">€</span>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Line-Item Invoice -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Floral Invoice Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								💐 Floristik-Kostenvoranschlag
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Gestecke, Deko, Aufbau und Lieferung
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Drucken
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Grand Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Geschätzte Gesamtkosten Floristik</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">3.850 €</strong>
						<span id="res-tier-summary" style="font-size: 0.8rem; color: var(--accent-red);">Romantischer Klassiker (1.5x)</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Aufgeschlüsselte Posten
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">👰 Brautstrauß & Anstecker:</td>
									<td id="res-personal-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">786 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">⛪ Trauung & Traubogen:</td>
									<td id="res-ceremony-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.012 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍽️ Tische & Raumdekoration:</td>
									<td id="res-reception-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.868 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Zwischensumme Blumen & Gestecke:</td>
									<td id="res-stems-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">3.666 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-blue);">
									<td style="padding: 0.4rem 0;">🛠️ Aufbau & Vor-Ort-Montage (20%):</td>
									<td id="res-labor-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">733 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil);">
									<td style="padding: 0.4rem 0;">🚚 Kühltransporter & Anfahrt:</td>
									<td id="res-delivery-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">120 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Category Distribution Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Braut & Party</span>
							<span>Trauung</span>
							<span>Tische</span>
							<span style="color: var(--accent-blue);">Aufbau</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-personal" style="width: 25%; background: var(--accent-red); transition: width 0.3s ease;"></div>
							<div id="bar-ceremony" style="width: 25%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-reception" style="width: 35%; background: #16a34a; transition: width 0.3s ease;"></div>
							<div id="bar-labor" style="width: 15%; background: #d97706; transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Florist Tip Alert Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						💡 Spartipp: Trauungs-Blumen wiederverwenden!
					</strong>
					<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; color: var(--fg-pencil);">
						Bitten Sie Ihren Floristen, die Gestecke des Traubogens und der Stühle so zu montieren, dass sie während des Sektempfangs vor den Brauttisch oder das Kuchenbuffet umgesetzt werden können. Das spart sofort 400 € bis 800 €!
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
