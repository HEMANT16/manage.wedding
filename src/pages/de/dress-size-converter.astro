<script is:inline>
	let currentUnit = 'cm';

	const bustInput = document.getElementById('input-bust');
	const waistInput = document.getElementById('input-waist');
	const hipsInput = document.getElementById('input-hips');
	const designerSelect = document.getElementById('input-designer');

	const resStreet = document.getElementById('res-street-size');
	const resBridal = document.getElementById('res-bridal-size');
	const resBodyShape = document.getElementById('res-body-shape');
	const resShapeDesc = document.getElementById('res-shape-desc');

	const barStreet = document.getElementById('bar-street');
	const barBridal = document.getElementById('bar-bridal');
	const barLabelStreet = document.getElementById('bar-label-street');
	const barLabelBridal = document.getElementById('bar-label-bridal');
	const sizeDiffNote = document.getElementById('size-diff-note');

	const matrixUs = document.getElementById('matrix-us');
	const matrixUk = document.getElementById('matrix-uk');
	const matrixEu = document.getElementById('matrix-eu');
	const matrixAu = document.getElementById('matrix-au');
	const matrixIt = document.getElementById('matrix-it');

	const alterationText = document.getElementById('alteration-advice-text');
	const silhouetteContainer = document.getElementById('silhouette-cards-container');

	// Standard Bridal Sizing Table in Inches
	const sizeChartInches = [
		{ bridal: 2, street: 0, eu: 32, bust: 32.5, waist: 24.5, hip: 35 },
		{ bridal: 4, street: 2, eu: 34, bust: 33.5, waist: 25.5, hip: 36 },
		{ bridal: 6, street: 4, eu: 36, bust: 34.5, waist: 26.5, hip: 37 },
		{ bridal: 8, street: 6, eu: 38, bust: 35.5, waist: 27.5, hip: 38 },
		{ bridal: 10, street: 8, eu: 40, bust: 36.5, waist: 28.5, hip: 39.5 },
		{ bridal: 12, street: 10, eu: 42, bust: 38.0, waist: 30.0, hip: 41 },
		{ bridal: 14, street: 12, eu: 44, bust: 39.5, waist: 31.5, hip: 42.5 },
		{ bridal: 16, street: 14, eu: 46, bust: 41.0, waist: 33.0, hip: 44 },
		{ bridal: 18, street: 16, eu: 48, bust: 43.0, waist: 35.0, hip: 46 },
		{ bridal: 20, street: 18, eu: 50, bust: 45.5, waist: 37.5, hip: 48 },
		{ bridal: 22, street: 20, eu: 52, bust: 47.5, waist: 40.0, hip: 50 },
		{ bridal: 24, street: 22, eu: 54, bust: 50.0, waist: 42.5, hip: 52.5 },
		{ bridal: 26, street: 24, eu: 56, bust: 52.5, waist: 45.0, hip: 55 }
	];

	function toInches(val) {
		return currentUnit === 'cm' ? val / 2.54 : val;
	}

	function calculateSizing() {
		let rawB = parseFloat(bustInput.value) || 92;
		let rawW = parseFloat(waistInput.value) || 72;
		let rawH = parseFloat(hipsInput.value) || 99;

		const bIn = toInches(rawB);
		const wIn = toInches(rawW);
		const hIn = toInches(rawH);

		// Find size for each measurement
		let bustSizeObj = sizeChartInches.find(s => bIn <= s.bust) || sizeChartInches[sizeChartInches.length - 1];
		let waistSizeObj = sizeChartInches.find(s => wIn <= s.waist) || sizeChartInches[sizeChartInches.length - 1];
		let hipSizeObj = sizeChartInches.find(s => hIn <= s.hip) || sizeChartInches[sizeChartInches.length - 1];

		// Maximum size needed to fit largest measurement
		const maxBridalSize = Math.max(bustSizeObj.bridal, waistSizeObj.bridal, hipSizeObj.bridal);
		const matchedObj = sizeChartInches.find(s => s.bridal === maxBridalSize) || sizeChartInches[sizeChartInches.length - 1];

		// Designer adjustments
		let adjustedBridal = maxBridalSize;
		const designer = designerSelect.value;
		if (designer === 'couture') {
			adjustedBridal = Math.min(26, maxBridalSize + 2);
		} else if (designer === 'davids') {
			adjustedBridal = Math.max(2, maxBridalSize - 2);
		}

		const streetSizeVal = matchedObj.street;
		const euBridalSize = adjustedBridal + 30; // US 10 = EU 40

		// Determine Body Shape Archetype
		let shape = 'Sanduhr';
		let shapeDetail = 'Ausgewogene Brust- & Hüftmaße mit schmaler Taille';
		let silhouettes = [
			{ name: 'Meerjungfrau / Trompete (Fit & Flare)', desc: 'Betont Kurven und natürlich ausgewogene Proportionen.' },
			{ name: 'Klassische A-Linie', desc: 'Universell schmeichelnder Schnitt mit Taillenfokus.' }
		];

		if (hIn >= bIn + 2 && (hIn - wIn) >= 8) {
			shape = 'Birnenform / A-Typ';
			shapeDetail = 'Hüfte breiter als Brust mit schmalerer Taille';
			silhouettes = [
				{ name: 'Prinzessin / Duchesse / Ballkleid', desc: 'Voluminöser Rock umspielt Hüften und betont die schmale Taille.' },
				{ name: 'Fließende A-Linie / Empire', desc: 'Lenkt den Blick nach oben auf Dekolleté und Mieder.' }
			];
		} else if (bIn >= hIn + 2) {
			shape = 'V-Typ / Umgekehrtes Dreieck';
			shapeDetail = 'Volleres Dekolleté / breitere Schultern als Hüfte';
			silhouettes = [
				{ name: 'A-Linie mit V-Ausschnitt', desc: 'Streckt den Oberkörper und harmonisiert das Schulter-Hüft-Verhältnis.' },
				{ name: 'Ballkleid mit Kellerfalten', desc: 'Schafft optisches Volumen im Rock für perfekte Symmetrie.' }
			];
		} else if (Math.abs(bIn - hIn) <= 2 && (bIn - wIn) <= 6) {
			shape = 'Rechteck / Sportlich-Gerade';
			shapeDetail = 'Gleichmäßige Maße mit dezenter Taillierung';
			silhouettes = [
				{ name: 'Fit-and-Flare mit Gürtel', desc: 'Zaubert optisch weibliche Rundungen an Taille und Hüfte.' },
				{ name: 'Korsagen-Kleid mit Stäbchen', desc: 'Definiert eine klare Taillenstruktur mit eingearbeiteter Korsage.' }
			];
		}

		// Update UI
		const euStreet = matchedObj.eu - 4; // z.B. Alltag 36 vs Braut 40
		resStreet.textContent = `EU ${Math.max(32, euStreet)}`;
		resBridal.textContent = `EU ${euBridalSize}`;
		resBodyShape.textContent = shape;
		resShapeDesc.textContent = shapeDetail;

		// Progress Comparison Bars
		const maxScale = 56;
		const streetPct = Math.min(100, Math.round((euStreet / maxScale) * 100));
		const bridalPct = Math.min(100, Math.round((euBridalSize / maxScale) * 100));

		barStreet.style.width = `${streetPct}%`;
		barBridal.style.width = `${bridalPct}%`;
		barLabelStreet.textContent = `EU ${Math.max(32, euStreet)}`;
		barLabelBridal.textContent = `EU ${euBridalSize}`;

		sizeDiffNote.textContent = '+1 bis 2 Nummern größer als Alltag';

		// International Matrix
		matrixUs.textContent = `${adjustedBridal}`;
		matrixUk.textContent = `${adjustedBridal + 2}`;
		matrixEu.textContent = `${euBridalSize}`;
		matrixAu.textContent = `${euBridalSize + 2}`;
		matrixIt.textContent = `${euBridalSize + 4}`;

		// Alteration Advice Note
		let anchor = 'Hüfte';
		if (bustSizeObj.bridal >= waistSizeObj.bridal && bustSizeObj.bridal >= hipSizeObj.bridal) anchor = 'Brust';
		else if (waistSizeObj.bridal >= bustSizeObj.bridal && waistSizeObj.bridal >= hipSizeObj.bridal) anchor = 'Taille';

		alterationText.innerHTML = `
			Ihr größtes Körpermaß ist die <strong>${anchor} (entspricht EU ${euBridalSize})</strong>. Bestellen Sie <strong>Größe EU ${euBridalSize}</strong>, damit das Kleid problemlos schließt. Ihre Schneiderin kann die übrigen Bereiche bei den Anproben mühelos anpassen.
		`;

		// Silhouettes
		silhouetteContainer.innerHTML = '';
		silhouettes.forEach(s => {
			const div = document.createElement('div');
			div.className = 'silhouette-card';
			div.innerHTML = `
				<h5>✨ ${s.name}</h5>
				<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">${s.desc}</p>
			`;
			silhouetteContainer.appendChild(div);
		});
	}

	// Unit Switcher
	document.getElementById('unit-in').addEventListener('click', () => {
		if (currentUnit === 'in') return;
		currentUnit = 'in';
		document.getElementById('unit-in').classList.add('active-unit');
		document.getElementById('unit-cm').classList.remove('active-unit');
		document.querySelectorAll('.unit-label').forEach(el => el.textContent = 'inches');

		bustInput.value = (parseFloat(bustInput.value) / 2.54).toFixed(1);
		waistInput.value = (parseFloat(waistInput.value) / 2.54).toFixed(1);
		hipsInput.value = (parseFloat(hipsInput.value) / 2.54).toFixed(1);
		calculateSizing();
	});

	document.getElementById('unit-cm').addEventListener('click', () => {
		if (currentUnit === 'cm') return;
		currentUnit = 'cm';
		document.getElementById('unit-cm').classList.add('active-unit');
		document.getElementById('unit-in').classList.remove('active-unit');
		document.querySelectorAll('.unit-label').forEach(el => el.textContent = 'cm');

		bustInput.value = (parseFloat(bustInput.value) * 2.54).toFixed(1);
		waistInput.value = (parseFloat(waistInput.value) * 2.54).toFixed(1);
		hipsInput.value = (parseFloat(hipsInput.value) * 2.54).toFixed(1);
		calculateSizing();
	});

	// Presets
	document.querySelectorAll('.preset-meas-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			let b = parseFloat(btn.getAttribute('data-b'));
			let w = parseFloat(btn.getAttribute('data-w'));
			let h = parseFloat(btn.getAttribute('data-h'));

			if (currentUnit === 'in') {
				b = (b / 2.54).toFixed(1);
				w = (w / 2.54).toFixed(1);
				h = (h / 2.54).toFixed(1);
			}

			bustInput.value = b;
			waistInput.value = w;
			hipsInput.value = h;
			calculateSizing();
		});
	});

	// Input listeners
	bustInput.addEventListener('input', calculateSizing);
	waistInput.addEventListener('input', calculateSizing);
	hipsInput.addEventListener('input', calculateSizing);
	designerSelect.addEventListener('change', calculateSizing);

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const rawB = bustInput.value;
		const rawW = waistInput.value;
		const rawH = hipsInput.value;
		const unit = currentUnit === 'in' ? 'inches' : 'cm';

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Brautkleid Maßkarte</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Offizielle Brautkleid-Maßkarte</h1>
				<p>Erstellt am ${new Date().toLocaleDateString('de-DE')} | Für Brautberatung & Schneiderin</p>
				
				<h3>Gemessene Körpermaße:</h3>
				<table>
					<thead>
						<tr><th>Körperbereich</th><th>Gemessener Wert</th><th>Hinweis</th></tr>
					</thead>
					<tbody>
						<tr><td><strong>Brustumfang</strong></td><td>${rawB} ${unit}</td><td>Über dem geplanten Braut-BH gemessen</td></tr>
						<tr><td><strong>Taillenumfang</strong></td><td>${rawW} ${unit}</td><td>An der schmalsten Stelle gemessen</td></tr>
						<tr><td><strong>Hüftumfang</strong></td><td>${rawH} ${unit}</td><td>An der breitesten Gesäßstelle gemessen</td></tr>
					</tbody>
				</table>

				<h3 style="margin-top:20px;">Größenempfehlung:</h3>
				<table>
					<thead>
						<tr><th>Größensystem</th><th>Empfohlene Größe</th><th>Details</th></tr>
					</thead>
					<tbody>
						<tr><td><strong>Empfohlene EU-Brautgröße</strong></td><td><strong>${resBridal.textContent}</strong></td><td>Bestellung nach größtem Körpermaß</td></tr>
						<tr><td><strong>Alltagskonfektion (DE)</strong></td><td>${resStreet.textContent}</td><td>Normale Alltagsgröße</td></tr>
						<tr><td><strong>US Bridal</strong></td><td>US ${matrixUs.textContent}</td><td>US-Brautstandard</td></tr>
						<tr><td><strong>UK Bridal</strong></td><td>UK ${matrixUk.textContent}</td><td>Großbritannien / Australien</td></tr>
						<tr><td><strong>Körpertyp & Silhouette</strong></td><td>${resBodyShape.textContent}</td><td>${resShapeDesc.textContent}</td></tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Brautkleid_Masskarte_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const printDate = document.getElementById('print-date');
		const printMeasBody = document.getElementById('print-meas-body');
		const printRecSize = document.getElementById('print-rec-size');
		const printStreetSize = document.getElementById('print-street-size');
		const printBodyShape = document.getElementById('print-body-shape');
		const printAlterationNote = document.getElementById('print-alteration-note');

		printDate.textContent = new Date().toLocaleDateString('de-DE');
		const unit = currentUnit === 'in' ? 'inches' : 'cm';

		printMeasBody.innerHTML = `
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">1. Brustumfang</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${bustInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Über BH gemessen</td>
			</tr>
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">2. Taillenumfang</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${waistInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Schmalste Stelle</td>
			</tr>
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">3. Hüftumfang</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${hipsInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Breiteste Gesäßstelle</td>
			</tr>
		`;

		printRecSize.textContent = `${resBridal.textContent} (US ${matrixUs.textContent} / UK ${matrixUk.textContent})`;
		printStreetSize.textContent = resStreet.textContent;
		printBodyShape.textContent = `${resBodyShape.textContent} (${resShapeDesc.textContent})`;
		printAlterationNote.textContent = alterationText.textContent;

		window.print();
	});

	// Initialize
	calculateSizing();
</script>
