---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/dress-size-converter/#webapp",
      "name": "Brautkleid-Größenumrechner & Maßrechner",
      "url": "https://manage.wedding/de/dress-size-converter",
      "description": "Kostenloser Brautkleid-Größenumrechner: Berechnen Sie Ihre exakte Brautmode-Größe für EU/DE, US und UK aus Brust-, Taillen- und Hüftmaßen in cm. Entdecken Sie passende Kleiderschnitte und exportieren Sie Ihre Maßtabelle.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "de",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Warum fallen Brautkleider meist 1 bis 2 Nummern kleiner aus als Alltagsmode?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Brautmode-Designer verwenden traditionelle europäische Größentabellen aus den 1950er-Jahren ohne elastische Stretch-Anteile (Vanity Sizing existiert in der Brautmode nicht). Daher entspricht eine normale Alltagsgröße 38 (M) in der Brautmode meist einer Konfektionsgröße 40 oder 42."
          }
        },
        {
          "@type": "Question",
          "name": "Nach welchem Körpermaß sollte man das Brautkleid bestellen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bestellen Sie das Kleid immer nach Ihrem größten Einzelmaß (Brust, Taille oder Hüfte). Eine Schneiderin kann ein Brautkleid problemlos an mehreren Stellen um 1–2 Nummern enger nähen, während das Erweitern durch minimale Nahtzugaben kaum möglich ist."
          }
        },
        {
          "@type": "Question",
          "name": "Wie misst man sich für ein Brautkleid richtig aus?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Verwenden Sie ein flexibles Maßband: 1) Brust: an der stärksten Stelle über dem geplanten BH; 2) Taille: an der schmalsten Stelle des Oberkörpers (ca. 2–3 cm über dem Bauchnabel); 3) Hüfte: an der breitesten Stelle des Gesäßes bei geschlossenen Beinen."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Wie man Maße nimmt und die richtige Brautkleidgröße ermittelt",
      "description": "Schritt-für-Schritt-Anleitung zum Maßnehmen an Brust, Taille und Hüfte zur Umrechnung in europäische (EU/DE), amerikanische (US) und britische (UK) Brautkleidgrößen.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Drei Kernmaße in Zentimetern ermitteln",
          "text": "Messen Sie Brustumfang, Taillenumfang und Hüftumfang mit einem flexiblen Maßband in Unterwäsche."
        },
        {
          "@type": "HowToStep",
          "name": "2. Mit der Brautmode-Größentabelle abgleichen",
          "text": "Vergleichen Sie Ihre Maße mit den Standards internationaler Brautkleid-Hersteller."
        },
        {
          "@type": "HowToStep",
          "name": "3. Nach dem größten Maß bestellen",
          "text": "Wählen Sie immer die Konfektionsgröße, die zu Ihrem größten Körpermaß passt, damit der Reißverschluss schließt."
        },
        {
          "@type": "HowToStep",
          "name": "4. Maßkarte für das Brautmodengeschäft exportieren",
          "text": "Laden Sie Ihre Maße als Word- (.doc) oder PDF-Dokument herunter und bringen Sie diese zum Beratungsgespräch mit."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Brautkleid-Größenumrechner (EU, US & UK Brautkleider Größentabelle) | Manage.Wedding"
	description="Kostenloser Brautkleid-Größenrechner: Berechnen Sie Ihre Brautkleidgröße in EU, US und UK aus Brust-, Taillen- & Hüftumfang in cm. Inklusive Schnitt-Empfehlungen & PDF-Export."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Brautkleid-Größenrechner" category="budget" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Brautkleid <span class="accent-italic">Größenumrechner</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Ermitteln Sie Ihre perfekte Brautkleidgröße nach <strong>EU / Deutsch (34–48)</strong>, <strong>US</strong> und <strong>UK</strong>. Vergleichen Sie Alltagskonfektion mit Brautmode und exportieren Sie Ihre offizielle <strong>Maßkarte für die Brautboutique</strong>.
				</p>
			</div>
		</section>

		<!-- Main Interactive Sizing Studio Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 380px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="dress-calc-grid">
			
			<!-- Left Column: Input Form Card -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						📏 Körpermaße
					</h2>
					
					<!-- Unit Switcher -->
					<div style="display: flex; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden;">
						<button type="button" id="unit-cm" class="unit-toggle-btn active-unit">cm</button>
						<button type="button" id="unit-in" class="unit-toggle-btn">Inches (in)</button>
					</div>
				</div>

				<form id="dress-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Bust -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-bust" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								1. Brustumfang (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Stärkste Stelle über BH</span>
						</div>
						<input type="number" step="0.5" id="input-bust" value="92" min="50" max="180" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Waist -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-waist" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								2. Taillenumfang (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Schmalste Stelle</span>
						</div>
						<input type="number" step="0.5" id="input-waist" value="72" min="40" max="160" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Hips -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-hips" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								3. Hüftumfang (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Breiteste Gesäßstelle</span>
						</div>
						<input type="number" step="0.5" id="input-hips" value="99" min="50" max="200" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Designer Preference -->
					<div>
						<label for="input-designer" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							Designer-Passform
						</label>
						<select id="input-designer" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="standard" selected>Europäischer Standard (Pronovias, Sincerity, Ladybird)</option>
							<option value="couture">Couture / Figurbetont (Fällt eher schmal aus)</option>
							<option value="davids">Amerikanischer Standard (Fällt etwas weiter aus)</option>
							<option value="maggie">Maggie Sottero / Essense of Australia</option>
						</select>
					</div>

					<!-- Sample Presets -->
					<div style="margin-top: 0.5rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
						<span class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							⚡ Schnellauswahl Beispielmaße:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem;">
							<button type="button" class="preset-meas-btn" data-b="86" data-w="66" data-h="94">Größe 36 (86-66-94)</button>
							<button type="button" class="preset-meas-btn" data-b="94" data-w="74" data-h="102">Größe 40 (94-74-102)</button>
							<button type="button" class="preset-meas-btn" data-b="108" data-w="88" data-h="116">Größe 46 (108-88-116)</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Interactive Results, Sizing Badges, International Matrix & Silhouette Guide -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Sizing Results Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								👗 Empfohlene Brautkleidgröße
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								Berechnet nach Ihrem größten Einzelmaß
							</span>
						</div>

						<!-- Exports -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Drucken
							</button>
						</div>
					</div>

					<!-- Side by Side Sizing Comparison Boxes -->
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Street Size -->
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Alltagskonfektion (DE)</span>
							<strong id="res-street-size" class="font-heading" style="font-size: 2.4rem; color: var(--accent-blue); display: block; line-height: 1.2;">EU 36</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Normale Kleidung</span>
						</div>

						<!-- Primary Bridal Size -->
						<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1rem; text-align: center; position: relative;">
							<span style="position: absolute; top: -10px; right: 10px; background: var(--accent-red); color: #fff; font-size: 0.7rem; font-weight: bold; padding: 2px 6px; border-radius: 10px;">BESTELLE DIESE</span>
							<span class="font-body" style="font-size: 0.85rem; color: var(--accent-red); display: block; font-weight: bold;">Empfohlene Brautgröße</span>
							<strong id="res-bridal-size" class="font-heading" style="font-size: 2.4rem; color: var(--accent-red); display: block; line-height: 1.2;">EU 40</strong>
							<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold;">+1 bis 2 Nummern (Brautstandard)</span>
						</div>

						<!-- Body Shape Archetype -->
						<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Körpersilhouette</span>
							<strong id="res-body-shape" class="font-heading" style="font-size: 1.3rem; color: #15803d; display: block; line-height: 1.3; margin: 0.4rem 0;">Sanduhr</strong>
							<span id="res-shape-desc" style="font-size: 0.75rem; color: #166534; display: block;">Ausgewogene Proportionen</span>
						</div>

					</div>

					<!-- Visual Comparison Bar -->
					<div style="margin-bottom: 1.5rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
							<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Alltagsgröße vs. Brautmode-Größe</span>
							<span id="size-diff-note" class="font-body" style="font-size: 0.85rem; color: var(--accent-red); font-weight: bold;">+1 bis 2 Größen größer</span>
						</div>
						<div style="display: flex; flex-direction: column; gap: 0.5rem;">
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="width: 80px; font-size: 0.85rem; font-weight: bold;">Alltag:</span>
								<div style="flex: 1; height: 18px; background: #e5e7eb; border-radius: 4px; border: 1px solid var(--fg-pencil); overflow: hidden;">
									<div id="bar-street" style="height: 100%; width: 30%; background: var(--accent-blue); transition: width 0.4s ease;"></div>
								</div>
								<span id="bar-label-street" style="width: 60px; font-size: 0.9rem; font-weight: bold;">EU 36</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="width: 80px; font-size: 0.85rem; font-weight: bold; color: var(--accent-red);">Brautmode:</span>
								<div style="flex: 1; height: 18px; background: #e5e7eb; border-radius: 4px; border: 1px solid var(--fg-pencil); overflow: hidden;">
									<div id="bar-bridal" style="height: 100%; width: 45%; background: var(--accent-red); transition: width 0.4s ease;"></div>
								</div>
								<span id="bar-label-bridal" style="width: 60px; font-size: 0.9rem; font-weight: bold; color: var(--accent-red);">EU 40</span>
							</div>
						</div>
					</div>

					<!-- International Conversion Matrix Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🌐 Internationale Brautkleider-Größentabelle
						</h4>
						<div style="overflow-x: auto;">
							<table style="width: 100%; border-collapse: collapse; text-align: center; font-size: 0.95rem; font-family: var(--font-body);">
								<thead>
									<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Standard</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">EU / DE</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">US Bridal</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">UK Bridal</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">IT (Italien)</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">FR (Frankreich)</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">Ihre Größe</td>
										<td id="matrix-eu" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">40</td>
										<td id="matrix-us" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">10</td>
										<td id="matrix-uk" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">12</td>
										<td id="matrix-it" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">44</td>
										<td id="matrix-au" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">42</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>

					<!-- Measurement Anchor Alert & Alteration Guidance -->
					<div style="background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<strong class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							✂️ Bestell- und Änderungsempfehlung:
						</strong>
						<p id="alteration-advice-text" class="font-body" style="font-size: 0.95rem; margin: 0; line-height: 1.5; color: var(--fg-pencil);">
							Ihr größtes Körpermaß ist die Hüfte. Bestellen Sie immer nach dieser Größe, damit das Kleid mühelos schließt. Die Schneiderin passt Taille und Brust bei der Anprobe perfekt an.
						</p>
					</div>

				</div>

				<!-- Flattering Gown Silhouette Recommendations Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
						<span>✨</span> Empfohlene Kleiderschnitte für Ihre Figur
					</h3>
					<div id="silhouette-cards-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
						<!-- Injected via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Offizielle Brautkleid-Maßkarte</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportiert am: <span id="print-date"></span> | Für Brautberatung & Schneiderin</p>
			</div>
			
			<table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 8px; text-align: left;">Körperbereich</th>
						<th style="border: 1px solid #ccc; padding: 8px; text-align: center;">Gemessenes Maß</th>
						<th style="border: 1px solid #ccc; padding: 8px; text-align: center;">Hinweis</th>
					</tr>
				</thead>
				<tbody id="print-meas-body"></tbody>
			</table>

			<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px; background: #fafafa;">
				<h3 style="margin: 0 0 8px 0; font-size: 15px;">Offizielle Größenempfehlung:</h3>
				<p style="margin: 4px 0;">• <strong>Zu bestellende Brautkleidgröße:</strong> <span id="print-rec-size"></span></p>
				<p style="margin: 4px 0;">• <strong>Alltagsgröße:</strong> <span id="print-street-size"></span></p>
				<p style="margin: 4px 0;">• <strong>Körpertyp:</strong> <span id="print-body-shape"></span></p>
				<p style="margin: 4px 0;">• <strong>Änderungshinweis:</strong> <span id="print-alteration-note"></span></p>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Auf einen Blick</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Faustregel: Brautkleidgröße vs. Alltagsgröße
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>Die Grundregel:</strong> Brautkleider fallen in der Regel <strong>1 bis 2 Größen kleiner</strong> aus als Ihre gewohnte Kleidung. Wenn Sie im Alltag eine 38 tragen, benötigen Sie im Brautmodengeschäft meist eine 40 oder 42. Bestellen Sie immer nach Ihrem <strong>größten Körpermaß</strong>, da Engernähen problemlos möglich ist, Erweitern jedoch kaum.
			</p>
			
