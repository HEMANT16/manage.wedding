---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/de/bachelorette-budget-calculator/#webapp",
      "name": "JGA Budget Planer & Kosten-Aufteiler",
      "url": "https://manage.wedding/de/bachelorette-budget-calculator",
      "description": "Kostenloser JGA-Kostenrechner und Aufteiler: Berechnen Sie die Pro-Kopf-Kosten für Unterkunft, Verpflegung, Deko und Aktivitäten, während die Gruppe die Braut einlädt. Mit 1-Klick-WhatsApp- & PayPal-Vorlage.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "de",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Wie man die Kosten für einen Junggesellinnenabschied (JGA) fair aufteilt",
      "description": "Schritt-für-Schritt-Anleitung für Trauzeuginnen zur Budgetierung und fairen Kostenaufteilung beim JGA.",
      "inLanguage": "de",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Schritt 1: Teilnehmerzahl festlegen & Braut einladen",
          "text": "Zählen Sie alle zahlenden Teilnehmerinnen und planen Sie fest ein, dass die Gruppe die Kosten der Braut für Unterkunft, Essen und Drinks gemeinsam übernimmt (N-1 Aufteilung)."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 2: Feste Gemeinschaftsausgaben erfassen",
          "text": "Addieren Sie die Kosten für Ferienwohnung/Hotel, Mietwagen/Zugtickets, Motto-Dekoration, JGA-Shirts und den Wocheneinkauf."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 3: Aktivitäten & Gastronomie kalkulieren",
          "text": "Planen Sie Restaurantbesuche, Brunch, Bootscharter, Wellness-Eintritte oder Weinproben ein."
        },
        {
          "@type": "HowToStep",
          "name": "Schritt 4: Vorauszahlung via PayPal einsammeln",
          "text": "Sammeln Sie 50% der Kosten frühzeitig zur Buchung der Unterkunft ein und den Restbetrag 2–3 Wochen vor dem JGA."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Zahlt die Braut ihren Junggesellinnenabschied (JGA) selbst?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nach traditioneller JGA-Etikette zahlt die Braut an ihrem Junggesellinnenabschied keinen Cent für Gruppenunterkunft, Essen, Drinks und gemeinsame Aktivitäten. Diese Kosten teilen alle Freundinnen unter sich auf. Die Braut übernimmt in der Regel lediglich ihre eigene Anreise/Flüge."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel kostet ein JGA durchschnittlich pro Person?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein lokaler JGA-Tag oder ein gemütliches Wochenend-Event kostet ca. 120 € bis 250 € pro Person. Ein Wochenend-Trip innerhalb Deutschlands/Österreichs/Schweiz liegt bei 280 € bis 450 €. Flugreisen (z. B. Mallorca oder Ibiza) kosten meist 600 € bis 950 € pro Person inklusive Braut-Umlage."
          }
        },
        {
          "@type": "Question",
          "name": "Wann sollte die Trauzeugin das Geld für den JGA einsammeln?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die erste Rate (ca. 50% für Unterkunft und feste Programmpunkte) sollte 3 bis 6 Monate vor dem Termin eingesammelt werden. Der Restbetrag für Verpflegung, Deko und Reservierungen wird 2 bis 3 Wochen vor der Reise via PayPal eingesammelt."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="JGA Budget Planer & Kosten-Aufteiler (Braut-Einlade-Rechner) | Manage.Wedding"
	description="Kostenloser JGA-Rechner & Kostenaufteiler: Berechnen Sie die Pro-Kopf-Kosten für Ferienwohnung, Deko, Drinks & Aktivitäten und übernehmen Sie die Kosten der Braut. Mit WhatsApp-Kopierfunktion."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="JGA Budget Planer" category="budget" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Braut-Umlage & WhatsApp-Zahlungstext</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				JGA Budget Planer <span class="accent-italic">& Kosten-Aufteiler</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Berechnen Sie die genauen Pro-Kopf-Kosten für Unterkunft, Verpflegung, Motto-Deko und Programm. Laden Sie die Braut automatisch ein und kopieren Sie die fertige WhatsApp- & PayPal-Zahlungsaufforderung mit 1 Klick.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Trip Setup & Expense Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						JGA-Planung & Gruppe
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						N-1 Aufteiler
					</span>
				</div>

				<!-- Destination / Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="destination-preset">JGA-Motto / Reise-Vorlage</label>
					<select id="destination-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="wine" selected>🍷 Wein-Wochenende / Mosel (Ferienhaus, Planwagen, Weinprobe / 280 € p.P.)</option>
						<option value="cabin">🏔️ Chalet / Alpen-Hütte (Hüttengaudi, Wellness, Wandern / 350 € p.P.)</option>
						<option value="city">⛵ City-Trip / Hamburg / Amsterdam (Grachtenfahrt, Party / 420 € p.P.)</option>
						<option value="flight">🌴 Mallorca / Ibiza Beach Trip (Finca, Beach Club / 650 € p.P.)</option>
						<option value="local">🏡 Lokaler Mädelsabend / Home-Spa (Brunch, Deko, Drinks / 120 € p.P.)</option>
						<option value="custom">✏️ Eigene JGA-Kalkulation</option>
					</select>
				</div>

				<!-- Bride Name & Total Attendees -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="bride-name">Name der Braut</label>
						<input type="text" id="bride-name" class="form-input" value="Laura" placeholder="z. B. Laura" />
					</div>
					<div>
						<label class="form-label" for="bridesmaid-count">Zahlende Mädels</label>
						<input type="number" id="bridesmaid-count" class="form-input" value="7" min="1" max="30" />
					</div>
				</div>

				<!-- Cover the Bride Toggle -->
				<div class="form-group" style="background: #fffcf5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 0.98rem; margin: 0;">
						<input type="checkbox" id="toggle-cover-bride" checked style="width: 18px; height: 18px;" />
						<span>Braut zu 100% einladen (Braut zahlt 0 €)</span>
					</label>
					<span style="font-size: 0.82rem; color: #64748b; display: block; margin-top: 4px; margin-left: 26px;">
						Standard-Brauch: Die 7 Teilnehmerinnen teilen den Gesamtbetrag gleichmäßig unter sich auf.
					</span>
				</div>

				<!-- Shared Fixed Expenses (Lodging / Transport / Decor) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Gemeinsame Gruppen-Ausgaben (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="airbnb-total" style="font-size: 0.9rem;">Unterkunft / Ferienwohnung</label>
							<input type="number" id="airbnb-total" class="form-input" value="950" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="transport-total" style="font-size: 0.9rem;">Transport / Sprit / Bahn</label>
							<input type="number" id="transport-total" class="form-input" value="200" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="decor-total" style="font-size: 0.9rem;">Deko, Accessoires & Shirts</label>
							<input type="number" id="decor-total" class="form-input" value="180" min="0" step="15" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="grocery-total" style="font-size: 0.9rem;">Einkauf, Snacks & Drinks</label>
							<input type="number" id="grocery-total" class="form-input" value="280" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Dining & Group Activities -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Restaurants & Aktivitäten (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="dining-total" style="font-size: 0.9rem;">Restaurant & Brunches</label>
							<input type="number" id="dining-total" class="form-input" value="450" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="activities-total" style="font-size: 0.9rem;">Weinprobe / Boot / Spa</label>
							<input type="number" id="activities-total" class="form-input" value="350" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Results Card & Venmo Exporter -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Cost Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Kosten pro Teilnehmerin
						</span>
						<span id="bride-status-badge" style="font-size: 0.85rem; font-weight: 800; background: #16a34a; color: #fff; padding: 3px 8px; border-radius: 4px;">
							👰 Laura zahlt: 0 €
						</span>
					</div>

					<div id="display-per-person" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.5rem;">
						344 €
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Gesamtausgaben des JGA: <strong id="display-trip-grand-total" style="color: var(--fg-pencil);">2.410 €</strong> verteilt auf <span id="display-headcount-text">7 zahlende Teilnehmerinnen</span>.
					</p>

					<!-- Itemized Per-Person Split Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Anteil Unterkunft / Ferienhaus:</span>
							<strong id="item-lodging-share">136 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Verpflegung, Einkauf & Essen:</span>
							<strong id="item-food-share">104 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Aktivitäten & Ausflüge:</span>
							<strong id="item-activity-share">50 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Deko, Shirts & Transport:</span>
							<strong id="item-decor-share">54 €</strong>
						</div>
					</div>

					<!-- Payment Schedule Recommendation -->
					<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem; font-size: 0.9rem; line-height: 1.5;">
						<strong style="display: block; color: var(--fg-pencil); margin-bottom: 4px;">📅 Empfohlener Zahlungsplan (PayPal):</strong>
						• <strong>1. Rate (Jetzt zur Buchung):</strong> <span id="sched-dep-1" style="font-weight: 700; color: var(--accent-red);">172 €</span> (Unterkunft & Buchungen)<br />
						• <strong>2. Rate (2 Wochen vor JGA):</strong> <span id="sched-dep-2" style="font-weight: 700; color: var(--accent-blue);">172 €</span> (Einkauf & Restbetrag)
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-copy-venmo" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📲</span> WhatsApp / PayPal Text kopieren
						</button>
						<button id="btn-print-itinerary" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> PDF drucken
						</button>
					</div>

				</div>

				<!-- Trending Themes Cheat Sheet -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						✨ Beliebte JGA-Ideen & Mottos:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Wein- & Genusstour:</strong> Planwagenfahrt, Winzer-Picknick, Weinverkostung (Mosel/Pfalz/Kaiserstuhl).</li>
						<li><strong>Wellness & Chalet-Wochenende:</strong> Sauna, Whirlpool, private Köchin, Yoga am Morgen (Allgäu/Tirol).</li>
						<li><strong>City & Boots-Tour:</strong> Eigene Grachtenfahrt mit Drinks, Rooftop-Bar, Escape Room (Hamburg/Köln/Amsterdam).</li>
						<li><strong>Boho-Picknick & Blumenkranz:</strong> DIY-Flower-Crown-Workshop, Vintage-Picknick im Park.</li>
						<li><strong>Glamping & Lagerfeuer:</strong> Gemütliche Jurte, Stockbrot, Polaroid-Kamera & Cocktails.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Auf einen Blick</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Faustregel: JGA-Kosten fair aufteilen
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Die Standard-Formel zur Kostenberechnung pro Person bei Junggesellinnenabschieden.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					💵 Die JGA-Aufteilungsformel (N-1):
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Kosten pro Teilnehmerin = [Unterkunft + Verpflegung + Deko + Aktivitäten + Restaurants] ÷ [Gesamte Gruppe − 1 (Braut)]
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">JGA-Art & Reiseziel</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Ø Kosten pro Person</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Typische Hauptposten</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Beliebte Aktivitäten</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Weinregion (Mosel / Pfalz)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">220 € – 320 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Ferienhaus, Planwagenfahrt, Weinprobe, Vesper</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Weinberge, Picknick</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Chalet / Alpen-Hütte</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">300 € – 450 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Selbstversorgerhütte, Wellness-Eintritt, Rodeln/Wandern</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Hüttenzauber & Spa</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Großstadt (Hamburg / Köln)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">350 € – 500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Hotelzimmer, Cocktailbar, Hafen-/Bootstour, Clubbing</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Party & Kultur</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Lokaler Tag (Home / Stadt)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">80 € – 160 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Brunch, Blumenkranz-Workshop, Deko, Abendessen</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Entspannt & budgetfreundlich</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Tipps für Trauzeuginnen: JGA planen ohne Stress
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Ein gelungener Junggesellinnenabschied verbindet gute Stimmung mit finanzieller Transparenz für alle Beteiligten.
				</p>
			</div>

			<!-- Section 1: Anonyme Budgetumfrage -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Die anonyme Budgetabfrage vor der Buchung
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					In Freundeskreisen gibt es unterschiedliche Einkommensverhältnisse (Studentinnen, Mütter, Berufseinsteigerinnen). Starten Sie vor jeder Buchung eine <strong>anonyme Umfrage</strong> (z. B. mit Google Forms oder Doodle):
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li>Fragen Sie nach einer maximalen Schmerzgrenze (z. B. bis 150 €, bis 300 €, bis 500 €).</li>
					<li>Bieten Sie Teilzeit-Optionen an: Wer nicht das ganze Wochenende mitkommen kann, schließt sich dem Samstagsprogramm an.</li>
				</ul>
			</section>

		</article>

		<RelatedTools currentPath="/de/bachelorette-budget-calculator" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('destination-preset');
		const brideNameInput = document.getElementById('bride-name');
		const bridesmaidCountInput = document.getElementById('bridesmaid-count');
		const toggleCoverBride = document.getElementById('toggle-cover-bride');

		const airbnbInput = document.getElementById('airbnb-total');
		const transportInput = document.getElementById('transport-total');
		const decorInput = document.getElementById('decor-total');
		const groceryInput = document.getElementById('grocery-total');
		const diningInput = document.getElementById('dining-total');
		const activitiesInput = document.getElementById('activities-total');

		const displayPerPerson = document.getElementById('display-per-person');
		const displayGrandTotal = document.getElementById('display-trip-grand-total');
		const displayHeadcountText = document.getElementById('display-headcount-text');
		const brideStatusBadge = document.getElementById('bride-status-badge');

		const itemLodgingShare = document.getElementById('item-lodging-share');
		const itemFoodShare = document.getElementById('item-food-share');
		const itemActivityShare = document.getElementById('item-activity-share');
		const itemDecorShare = document.getElementById('item-decor-share');
		const schedDep1 = document.getElementById('sched-dep-1');
		const schedDep2 = document.getElementById('sched-dep-2');

		const btnCopyVenmo = document.getElementById('btn-copy-venmo');
		const btnPrint = document.getElementById('btn-print-itinerary');

		function calculateBachelorette() {
			const bridesmaids = parseInt(bridesmaidCountInput.value, 10) || 1;
			const coverBride = toggleCoverBride.checked;
			const bride = brideNameInput.value.trim() || 'Laura';

			const lodging = parseFloat(airbnbInput.value) || 0;
			const transport = parseFloat(transportInput.value) || 0;
			const decor = parseFloat(decorInput.value) || 0;
			const groceries = parseFloat(groceryInput.value) || 0;
			const dining = parseFloat(diningInput.value) || 0;
			const activities = parseFloat(activitiesInput.value) || 0;

			const grandTotal = lodging + transport + decor + groceries + dining + activities;
			const payingCount = coverBride ? bridesmaids : (bridesmaids + 1);

			const perPersonTotal = grandTotal / payingCount;
			const lodgingShare = lodging / payingCount;
			const foodShare = (groceries + dining) / payingCount;
			const activityShare = activities / payingCount;
			const decorShare = (decor + transport) / payingCount;

			displayPerPerson.textContent = `${Math.round(perPersonTotal).toLocaleString('de-DE')} €`;
			displayGrandTotal.textContent = `${Math.round(grandTotal).toLocaleString('de-DE')} €`;
			displayHeadcountText.textContent = `${payingCount} zahlende Teilnehmerin${payingCount === 1 ? '' : 'nen'}`;

			if (coverBride) {
				brideStatusBadge.textContent = `👰 ${bride} zahlt: 0 €`;
				brideStatusBadge.style.background = '#16a34a';
			} else {
				brideStatusBadge.textContent = `👰 ${bride} zahlt gleichen Anteil: ${Math.round(perPersonTotal)} €`;
				brideStatusBadge.style.background = '#0284c7';
			}

			itemLodgingShare.textContent = `${Math.round(lodgingShare).toLocaleString('de-DE')} €`;
			itemFoodShare.textContent = `${Math.round(foodShare).toLocaleString('de-DE')} €`;
			itemActivityShare.textContent = `${Math.round(activityShare).toLocaleString('de-DE')} €`;
			itemDecorShare.textContent = `${Math.round(decorShare).toLocaleString('de-DE')} €`;

			const half = Math.round(perPersonTotal / 2);
			schedDep1.textContent = `${half.toLocaleString('de-DE')} €`;
			schedDep2.textContent = `${(Math.round(perPersonTotal) - half).toLocaleString('de-DE')} €`;
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'wine') {
				airbnbInput.value = 950;
				transportInput.value = 200;
				decorInput.value = 180;
				groceryInput.value = 280;
				diningInput.value = 450;
				activitiesInput.value = 350;
			} else if (p === 'cabin') {
				airbnbInput.value = 1200;
				transportInput.value = 220;
				decorInput.value = 150;
				groceryInput.value = 350;
				diningInput.value = 380;
				activitiesInput.value = 450;
			} else if (p === 'city') {
				airbnbInput.value = 1400;
				transportInput.value = 300;
				decorInput.value = 180;
				groceryInput.value = 250;
				diningInput.value = 600;
				activitiesInput.value = 500;
			} else if (p === 'flight') {
				airbnbInput.value = 2100;
				transportInput.value = 400;
				decorInput.value = 200;
				groceryInput.value = 400;
				diningInput.value = 850;
				activitiesInput.value = 600;
			} else if (p === 'local') {
				airbnbInput.value = 0;
				transportInput.value = 50;
				decorInput.value = 120;
				groceryInput.value = 200;
				diningInput.value = 350;
				activitiesInput.value = 120;
			}
			calculateBachelorette();
		});

		// Live Listeners
		[brideNameInput, bridesmaidCountInput, toggleCoverBride, airbnbInput, transportInput, decorInput, groceryInput, diningInput, activitiesInput].forEach(inp => {
			inp.addEventListener('input', calculateBachelorette);
			inp.addEventListener('change', calculateBachelorette);
		});

		// Copy WhatsApp / PayPal Request
		btnCopyVenmo.addEventListener('click', () => {
			const bride = brideNameInput.value.trim() || 'Laura';
			const perPerson = displayPerPerson.textContent;
			const dep1 = schedDep1.textContent;
			const dep2 = schedDep2.textContent;

			let text = `🎉 *${bride}'s JGA Budget & Zahlungsübersicht*\n\n`;
			text += `Hallo ihr Lieben! Hier ist die Kostenübersicht für unseren JGA für ${bride}:\n\n`;
			text += `💰 *Gesamtbetrag pro Person:* ${perPerson} (wir laden ${bride} komplett ein!)\n\n`;
			text += `📋 *Enthaltene Ausgaben:*\n`;
			text += `• Unterkunft: ${itemLodgingShare.textContent}\n`;
			text += `• Essen, Trinken & Einkauf: ${itemFoodShare.textContent}\n`;
			text += `• Aktivitäten & Ausflüge: ${itemActivityShare.textContent}\n`;
			text += `• Deko, Shirts & Fahrt: ${itemDecorShare.textContent}\n\n`;
			text += `📅 *Zahlungsplan (via PayPal):*\n`;
			text += `1️⃣ 1. Rate (zur Buchung): *${dep1}*\n`;
			text += `2️⃣ 2. Rate (2 Wochen vor JGA): *${dep2}*\n\n`;
			text += `Wir freuen uns schon riesig auf die Party mit ${bride}! 🍾✨`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnCopyVenmo.textContent;
				btnCopyVenmo.textContent = '✅ In Zwischenablage kopiert!';
				setTimeout(() => { btnCopyVenmo.textContent = orig; }, 2500);
			});
		});

		// Print PDF Summary
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>JGA Budget — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; color: #0f172a; margin-bottom: 4px; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 13pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>JGA-Kostenplan für ${brideNameInput.value || 'Laura'}</h1>
					<p>Gesamtausgaben: ${displayGrandTotal.textContent} | <strong>Kosten pro Teilnehmerin: ${displayPerPerson.textContent}</strong></p>
					<table>
						<thead><tr><th>Kategorie</th><th>Gesamt (€)</th><th>Anteil pro Person</th></tr></thead>
						<tbody>
							<tr><td>Unterkunft / Ferienwohnung</td><td>${airbnbInput.value} €</td><td>${itemLodgingShare.textContent}</td></tr>
							<tr><td>Verpflegung & Restaurant</td><td>${parseFloat(groceryInput.value) + parseFloat(diningInput.value)} €</td><td>${itemFoodShare.textContent}</td></tr>
							<tr><td>Aktivitäten & Ausflüge</td><td>${activitiesInput.value} €</td><td>${itemActivityShare.textContent}</td></tr>
							<tr><td>Deko, Motto-Shirts & Fahrt</td><td>${parseFloat(decorInput.value) + parseFloat(transportInput.value)} €</td><td>${itemDecorShare.textContent}</td></tr>
							<tr class="total-row"><td>GESAMTBETRAG PRO TEILNEHMERIN</td><td>${displayGrandTotal.textContent}</td><td>${displayPerPerson.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Initial Calculation
		calculateBachelorette();
	</script>
</Layout>
