---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Wedding Linen & Tablecloth Sizer Calculator",
      "url": "https://manage.wedding/wedding-linen-tablecloth-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calculate exact tablecloth sizes for round and rectangular banquet tables, determine floor drop lengths, runners, napkins, and compare rental vs purchase costs.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate Exact Tablecloth Sizes for Weddings",
      "description": "Step-by-step sizing guide for round, rectangular, and cocktail tables to achieve perfect floor-length drops without dragging.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Measure Table Diameter or Width/Length",
          "text": "Identify standard table dimensions (60-inch round, 72-inch round, 6-foot banquet, 8-foot banquet, or 42-inch highboy)."
        },
        {
          "@type": "HowToStep",
          "name": "Add Double the Desired Drop Height",
          "text": "For standard 30-inch high tables, add 60 inches (30 inches on each side) to the table diameter or length/width for a formal floor-length drape."
        },
        {
          "@type": "HowToStep",
          "name": "Calculate Runners and Napkins",
          "text": "Add 24 inches to table length for runners (12-inch overhang per side) and order 115% of guest count for cloth dinner napkins."
        },
        {
          "@type": "HowToStep",
          "name": "Export Rental & Purchase Inventory Sheet",
          "text": "Generate a clear breakdown for your linen rental company or bulk wholesale order."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What size tablecloth do I need for a 60-inch round table?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a standard 60-inch round table (seats 8 guests) at 30 inches tall, you need a 120-inch round tablecloth for a formal floor-length drop, or a 90-inch round tablecloth for a casual 15-inch lap drop."
          }
        },
        {
          "@type": "Question",
          "name": "What size tablecloth fits an 8-foot rectangular banquet table?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An 8-foot banquet table (96 inches long by 30 inches wide by 30 inches high) requires a 90 x 156-inch rectangular tablecloth for a complete floor-length drop on all four sides."
          }
        },
        {
          "@type": "Question",
          "name": "Is it cheaper to rent or buy wedding linens?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buying standard polyester linens online ($8 to $14 each) is often 30% to 50% cheaper than renting ($15 to $28 each). However, renting includes professional steaming, wrinkle removal, and cleaning, saving hours of pre-wedding labor."
          }
        },
        {
          "@type": "Question",
          "name": "What size tablecloth is used for cocktail highboy tables?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a 30-inch or 36-inch diameter cocktail highboy table at 42 inches tall, use a 120-inch or 132-inch round linen to allow for a floor drape or an elegant sash tie around the center pole."
          }
        }
      ]
    }
  ]
};
---

<Layout
	title="Wedding Linen & Tablecloth Sizer — Floor Drop Calculator"
	description="Calculate exact tablecloth dimensions for round, rectangular, and cocktail tables, determine floor drop lengths, runners, napkins, and compare rental vs buy costs."
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/dining" style="color: var(--text-secondary); text-decoration: none;">Dining & Decor</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Linen & Tablecloth Sizer</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🧺</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Table Sizing & Event Rental Inventory Studio</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Wedding Linen & Tablecloth Sizer
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Calculate <strong>exact tablecloth dimensions</strong> for every table shape, ensure perfect floor-length drops, size runners & napkins, and compare <strong>rental vs purchase costs</strong>.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Table Configuration & Inputs -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>📐</span> 1. Guest Tables Configuration
				</h2>

				<!-- Table Shape & Size -->
				<div style="margin-bottom: 1rem;">
					<label for="select-table-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Guest Table Shape & Size:</label>
					<select id="select-table-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="round-60" selected>⚪ 60" Round (Seats 8 — Standard 30" height)</option>
						<option value="round-72">⚪ 72" Round (Seats 10-12 — Standard 30" height)</option>
						<option value="round-48">⚪ 48" Round (Seats 6 — Sweetheart/Cake)</option>
						<option value="rect-8ft">📏 8 ft Rectangular (96" x 30" Banquet)</option>
						<option value="rect-6ft">📏 6 ft Rectangular (72" x 30" Banquet)</option>
						<option value="highboy-30">🍸 30" Cocktail Highboy (42" Standing Height)</option>
					</select>
				</div>

				<!-- Drop Style -->
				<div style="margin-bottom: 1rem;">
					<label for="select-drop-style" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Desired Drop Length:</label>
					<select id="select-drop-style" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="floor" selected>✨ Floor Length (Formal standard — 30" drop to floor)</option>
						<option value="lap">🪑 Lap Length / Casual (15" drop halfway)</option>
						<option value="puddle">👑 Puddle / Glamour (+3" pooling on floor)</option>
					</select>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-table-count" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Number of Guest Tables:</label>
						<input type="number" id="input-table-count" min="1" max="100" value="15" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="input-guests-count" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Total Guests (for Napkins):</label>
						<input type="number" id="input-guests-count" min="10" max="600" value="120" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
				</div>

				<!-- Specialty Tables -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🏷️ 2. Specialty & Service Tables
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
					<div>
						<label for="input-head-tables" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Head / Sweetheart Tables:</label>
						<input type="number" id="input-head-tables" min="0" max="10" value="2" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="input-cocktail-tables" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Cocktail Highboy Tables:</label>
						<input type="number" id="input-cocktail-tables" min="0" max="25" value="6" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="input-service-tables" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Cake / Gift / DJ Tables:</label>
						<input type="number" id="input-service-tables" min="0" max="15" value="4" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="select-pricing-mode" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Cost Comparison:</label>
						<select id="select-pricing-mode" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="both" selected>Compare Rent vs Buy</option>
							<option value="rent">Rental Only ($18/linen)</option>
							<option value="buy">Purchase Only ($11/linen)</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Results & Sizing Guide -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Exact Sizing Specification</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Recommended Linen Size
						</h2>
					</div>
					<span id="badge-drop-tag" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">Floor Length Drop</span>
				</div>

				<!-- Big Number Highlights -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Guest Table Linen</span>
						<strong id="stat-linen-dimension" style="font-size: 1.7rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">120" Round</strong>
						<span id="stat-linen-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(Exact 30" floor drape)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Total Linens Needed</span>
						<strong id="stat-total-linens" style="font-size: 1.7rem; font-weight: 900; color: #1e40af; line-height: 1.1;">27 Tablecloths</strong>
						<span id="stat-tables-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">Across all tables</span>
					</div>
				</div>

				<!-- Accessories Breakdown Box -->
				<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #166534; display: block; margin-bottom: 0.35rem;">✨ Accessories & Napkins Inventory:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #14532d;">
						<div>• <strong id="stat-napkins-count">138 Napkins</strong> (115% buffer)</div>
						<div>• <strong id="stat-runner-length">108" Runners</strong> (12" overhang)</div>
						<div>• <strong id="stat-highboy-linens">6 x 120"</strong> Highboy Linens</div>
						<div>• <strong id="stat-banquet-linens">6 x 90x156"</strong> Banquet Linens</div>
					</div>
				</div>

				<!-- Cost Comparison Box -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🏷️ Estimated Rental Cost:</span>
						<strong id="stat-rent-cost" style="color: #b91c1c;">$486 (Cleaned & Steamed)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🛒 Estimated Purchase Cost:</span>
						<strong id="stat-buy-cost" style="color: #1e40af;">$297 (Wholesale polyester)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">💡 Verdict:</span>
						<strong id="stat-verdict" style="color: #15803d;">Buy saves $189 (Requires ironing)</strong>
					</div>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Print Linen Order (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Export Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Sizing Reference Table -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem;">
				📋 Complete Wedding Tablecloth Sizing Cheat Sheet
			</h2>
			
			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
					<thead>
						<tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.6rem; color: var(--fg-pencil);">Table Type & Size</th>
							<th style="padding: 0.6rem; color: var(--fg-pencil);">Table Height</th>
							<th style="padding: 0.6rem; color: var(--fg-pencil);">Floor-Length Linen (Formal)</th>
							<th style="padding: 0.6rem; color: var(--fg-pencil);">Lap-Length Linen (Casual)</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem; font-weight: 700;">60" Round (Seats 8)</td>
							<td style="padding: 0.6rem;">30" Standard</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">120" Round</td>
							<td style="padding: 0.6rem;">90" Round</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem; font-weight: 700;">72" Round (Seats 10-12)</td>
							<td style="padding: 0.6rem;">30" Standard</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">132" Round</td>
							<td style="padding: 0.6rem;">108" Round</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem; font-weight: 700;">48" Round (Seats 6 / Cake)</td>
							<td style="padding: 0.6rem;">30" Standard</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">108" Round</td>
							<td style="padding: 0.6rem;">90" Round</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem; font-weight: 700;">8 ft Banquet (96" x 30")</td>
							<td style="padding: 0.6rem;">30" Standard</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">90" x 156" Rectangular</td>
							<td style="padding: 0.6rem;">60" x 126" Rectangular</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem; font-weight: 700;">6 ft Banquet (72" x 30")</td>
							<td style="padding: 0.6rem;">30" Standard</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">90" x 132" Rectangular</td>
							<td style="padding: 0.6rem;">60" x 102" Rectangular</td>
						</tr>
						<tr>
							<td style="padding: 0.6rem; font-weight: 700;">30" Highboy (Cocktail)</td>
							<td style="padding: 0.6rem;">42" Tall</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">120" Round (or 132" with tie)</td>
							<td style="padding: 0.6rem;">Spandex Fitted Cover</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<!-- Frequently Asked Questions -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1.25rem;">
				❓ Frequently Asked Questions: Wedding Linens
			</h2>
			
			<div style="display: flex; flex-direction: column; gap: 1rem;">
				<div style="border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.85rem;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						Why is floor-length linen considered mandatory for weddings?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						Floor-length tablecloths completely conceal metal table legs, electrical cords, and guest bags placed under tables. They create an elevated, seamless aesthetic in wedding reception photos.
					</p>
				</div>

				<div style="border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.85rem;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						How many extra napkins should you order?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						Always order <strong>15% extra napkins</strong>. Guests frequently drop napkins on the dance floor, spills occur during wine service, and vendors/caterers need cloth napkins for bread baskets.
					</p>
				</div>
			</div>
		</section>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/wedding-linen-tablecloth-calculator" category="dining" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-linen-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Wedding Linen & Tablecloth Inventory Order Sheet</h1>
				<p id="print-linen-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Event Rental Specification | Manage.Wedding</p>
			</div>
			<div id="print-linen-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	// Elements
	const selectTableType = document.getElementById('select-table-type');
	const selectDropStyle = document.getElementById('select-drop-style');
	const inputTableCount = document.getElementById('input-table-count');
	const inputGuestsCount = document.getElementById('input-guests-count');
	const inputHeadTables = document.getElementById('input-head-tables');
	const inputCocktailTables = document.getElementById('input-cocktail-tables');
	const inputServiceTables = document.getElementById('input-service-tables');

	const statLinenDimension = document.getElementById('stat-linen-dimension');
	const statLinenSub = document.getElementById('stat-linen-sub');
	const statTotalLinens = document.getElementById('stat-total-linens');
	const badgeDropTag = document.getElementById('badge-drop-tag');

	const statNapkinsCount = document.getElementById('stat-napkins-count');
	const statRunnerLength = document.getElementById('stat-runner-length');
	const statHighboyLinens = document.getElementById('stat-highboy-linens');
	const statBanquetLinens = document.getElementById('stat-banquet-linens');

	const statRentCost = document.getElementById('stat-rent-cost');
	const statBuyCost = document.getElementById('stat-buy-cost');
	const statVerdict = document.getElementById('stat-verdict');

	function calculateLinens() {
		const tableType = selectTableType.value;
		const dropStyle = selectDropStyle.value;
		const guestTables = parseInt(inputTableCount.value, 10) || 15;
		const guests = parseInt(inputGuestsCount.value, 10) || 120;
		const headTables = parseInt(inputHeadTables.value, 10) || 2;
		const cocktailTables = parseInt(inputCocktailTables.value, 10) || 6;
		const serviceTables = parseInt(inputServiceTables.value, 10) || 4;

		let dimension = '120" Round';
		let subText = '30" formal floor drop';
		let runnerLen = '108" Runner';

		if (tableType === 'round-60') {
			if (dropStyle === 'floor') { dimension = '120" Round'; subText = 'Exact 30" floor drape'; }
			else if (dropStyle === 'lap') { dimension = '90" Round'; subText = '15" lap-length drop'; }
			else { dimension = '132" Round'; subText = '6" puddle glamour pooling'; }
			runnerLen = '108" Runner';
		} else if (tableType === 'round-72') {
			if (dropStyle === 'floor') { dimension = '132" Round'; subText = 'Exact 30" floor drape'; }
			else if (dropStyle === 'lap') { dimension = '108" Round'; subText = '18" casual drop'; }
			else { dimension = '144" Custom'; subText = 'Puddle pooling drop'; }
			runnerLen = '120" Runner';
		} else if (tableType === 'round-48') {
			if (dropStyle === 'floor') { dimension = '108" Round'; subText = 'Exact 30" floor drape'; }
			else if (dropStyle === 'lap') { dimension = '90" Round'; subText = '21" lap drop'; }
			else { dimension = '120" Round'; subText = '6" puddle pooling'; }
			runnerLen = '90" Runner';
		} else if (tableType === 'rect-8ft') {
			if (dropStyle === 'floor') { dimension = '90" x 156" Rect.'; subText = 'Full 4-sided floor drape'; }
			else if (dropStyle === 'lap') { dimension = '60" x 126" Rect.'; subText = '15" side drop'; }
			else { dimension = '108" x 156" Rect.'; subText = 'Deep glamour drape'; }
			runnerLen = '120" Runner';
		} else if (tableType === 'rect-6ft') {
			if (dropStyle === 'floor') { dimension = '90" x 132" Rect.'; subText = 'Full 4-sided floor drape'; }
			else if (dropStyle === 'lap') { dimension = '60" x 102" Rect.'; subText = '15" side drop'; }
			else { dimension = '90" x 156" Rect.'; subText = 'Long pooling drop'; }
			runnerLen = '96" Runner';
		} else if (tableType === 'highboy-30') {
			if (dropStyle === 'floor') { dimension = '120" Round'; subText = 'Clean 42" floor drop'; }
			else { dimension = '132" Round'; subText = 'Waist sash / ribbon tie'; }
			runnerLen = 'No Runner (Use Sash)';
		}

		statLinenDimension.textContent = dimension;
		statLinenSub.textContent = `(${subText})`;

		const totalLinens = guestTables + headTables + cocktailTables + serviceTables;
		statTotalLinens.textContent = `${totalLinens} Tablecloths`;

		const totalNapkins = Math.round(guests * 1.15);
		statNapkinsCount.textContent = `${totalNapkins} Napkins`;
		statRunnerLength.textContent = runnerLen;
		statHighboyLinens.textContent = `${cocktailTables} x 120" Highboy Linens`;
		statBanquetLinens.textContent = `${headTables + serviceTables} x 90x156" Banquet Linens`;

		// Financial Estimation
		const avgRentRate = 18;
		const avgBuyRate = 11;
		const totalRent = totalLinens * avgRentRate + totalNapkins * 0.75;
		const totalBuy = totalLinens * avgBuyRate + totalNapkins * 0.45;
		const diff = totalRent - totalBuy;

		statRentCost.textContent = `$${Math.round(totalRent)} (Cleaned & Steamed)`;
		statBuyCost.textContent = `$${Math.round(totalBuy)} (Wholesale order)`;
		statVerdict.textContent = `Buying saves $${Math.round(diff)} (Requires ironing/steaming)`;

		// Print Layout
		document.getElementById('print-linen-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Table / Item Type</th>
						<th style="padding:6pt;">Table Dimensions</th>
						<th style="padding:6pt;">Recommended Linen Size</th>
						<th style="padding:6pt; text-align:right;">Quantity</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Guest Tables</td>
						<td style="padding:6pt;">${selectTableType.options[selectTableType.selectedIndex].text}</td>
						<td style="padding:6pt; font-weight:bold; color:#b91c1c;">${dimension}</td>
						<td style="padding:6pt; text-align:right;"><strong>${guestTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Head / Sweetheart Tables</td>
						<td style="padding:6pt;">8 ft Rectangular / Estate</td>
						<td style="padding:6pt;">90" x 156" Rectangular</td>
						<td style="padding:6pt; text-align:right;"><strong>${headTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Cocktail Highboy Tables</td>
						<td style="padding:6pt;">30" Diameter x 42" High</td>
						<td style="padding:6pt;">120" Round (with sash)</td>
						<td style="padding:6pt; text-align:right;"><strong>${cocktailTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Cake / Gift / DJ Tables</td>
						<td style="padding:6pt;">6 ft / 8 ft Banquet</td>
						<td style="padding:6pt;">90" x 132" / 90" x 156" Rect.</td>
						<td style="padding:6pt; text-align:right;"><strong>${serviceTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Cloth Dinner Napkins</td>
						<td style="padding:6pt;">20" x 20" Cotton / Poly</td>
						<td style="padding:6pt;">Standard Fold / Knot</td>
						<td style="padding:6pt; text-align:right; font-weight:bold; color:#166534;"><strong>${totalNapkins}</strong></td>
					</tr>
					<tr style="background:#eff6ff; font-weight:bold; font-size:11pt; border-top:2pt solid #000;">
						<td style="padding:8pt;">TOTAL TABLECLOTHS</td>
						<td style="padding:8pt;">All Tables Combined</td>
						<td style="padding:8pt;">Floor Length Specification</td>
						<td style="padding:8pt; text-align:right; color:#b91c1c;">${totalLinens} Linens</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	// Listeners
	[selectTableType, selectDropStyle, inputTableCount, inputGuestsCount, inputHeadTables, inputCocktailTables, inputServiceTables].forEach(el => {
		el.addEventListener('input', calculateLinens);
		el.addEventListener('change', calculateLinens);
	});

	// Print PDF
	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateLinens();
		window.print();
	});

	// Export Word
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateLinens();
		const dimension = statLinenDimension.textContent;
		const totalLinens = statTotalLinens.textContent;
		const napkins = statNapkinsCount.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Wedding Linen Specification</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Wedding Linen & Tablecloth Inventory Order</h1>
				<p><strong>Guest Table Linen:</strong> ${dimension} | <strong>Total Tablecloths:</strong> ${totalLinens} | <strong>Napkins:</strong> ${napkins}</p>
				<hr/>
				<p><em>Generated by Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding-Linens-Order-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateLinens();
</script>
