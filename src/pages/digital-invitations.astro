---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Digital Wedding Invitations Generator & E-Invite Maker",
      "url": "https://manage.wedding/digital-invitations",
      "description": "Free digital wedding invitation generator. Create personalized e-invites for your entire guest list with customized WhatsApp/SMS messages, high-resolution PNG downloads, Word, and PDF exports.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are digital wedding invitations acceptable modern etiquette?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Over 65% of modern couples now use digital invitations or hybrid invites. E-invitations are eco-friendly, budget-friendly (saving $800 to $2,500 in paper, calligraphy, and postage stamps), and allow instant 1-click RSVP tracking."
          }
        },
        {
          "@type": "Question",
          "name": "When should I send out digital wedding invitations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Digital wedding invitations should be sent 6 to 8 weeks before a local wedding, and 10 to 14 weeks in advance for destination weddings. Because there is no postal transit delay, guests receive their invite instantly."
          }
        },
        {
          "@type": "Question",
          "name": "How do I text or WhatsApp digital invitations to guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Download the personalized PNG card or click 'Export Word (.doc)'. Our tool generates pre-formatted, personalized SMS and WhatsApp text messages complete with your wedding website link, RSVP deadline, and dress code."
          }
        },
        {
          "@type": "Question",
          "name": "Can I print these digital invitations for older family members?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely! Click 'Export PDF / Print All' to print high-resolution 5x7 inch cards on standard paper or cardstock to hand-deliver or mail to grandparents and traditional guests."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Digital Wedding Invitations Generator (Free e-Invites & Word Export) | Manage.Wedding"
	description="Create and export personalized digital wedding invitations for your entire guest list. Includes customized SMS/WhatsApp messages, Word, PDF, and high-res PNG downloads."
	schema={schema}
>
	<!-- Include html2canvas for instant image capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Digital Invitations Generator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Generate personalized, high-resolution digital wedding invitations for everyone on your guest list. Export individual <strong>PNG Cards</strong>, <strong>Printable PDFs</strong>, or <strong>Word (.doc)</strong> with ready-to-send WhatsApp/SMS messages.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> How to Create Digital E-Invites in 3 Easy Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Enter Wedding Details & Theme
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Enter your couple names, wedding date, ceremony venue, dress code, RSVP deadline, and choose your artistic card border theme.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Sync or Enter Guest Names
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Your saved guest list automatically connects, or click <strong>"✨ Load Sample Guests"</strong> to test customized invitations instantly!
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Export PNGs, PDFs & Text Messages
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Download crystal-clear PNG invitation images, bulk PDF sheets for printing, or export Word (`.doc`) with pre-written text messages!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Controls + Live Preview & Generated Roster -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="invitations-calc-grid">
			
			<!-- Left Column: Wedding Details Form & Guest Sync -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💌 Invitation Details & Theme
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Customize text and card styling for your e-invites
					</span>
				</div>

				<form id="invite-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Theme Style Selector -->
					<div>
						<label for="select-card-theme" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-red); margin-bottom: 0.25rem;">
							Card Design Theme
						</label>
						<select id="select-card-theme" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="classic" selected>✒️ Classic Ink & Calligraphy (Minimalist Elegant)</option>
							<option value="botanical">🌿 Botanical Floral & Olive Leaves</option>
							<option value="romantic">🏛️ Romantic Tuscan Arch & Warm Paper</option>
							<option value="modern">✨ Modern Black-Tie Luxury Frame</option>
						</select>
					</div>

					<!-- Couple's Names -->
					<div>
						<label for="input-couples-names" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Couple's Names *
						</label>
						<input type="text" id="input-couples-names" value="Emma & Alexander" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-heading); font-size: 1.1rem; background: #fff;">
					</div>

					<!-- Wedding Date & Time -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="input-wedding-date" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Date & Time *
							</label>
							<input type="text" id="input-wedding-date" value="Saturday, October 17, 2026 at 4:30 PM" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
						</div>
						<div>
							<label for="input-rsvp-deadline" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								RSVP Deadline
							</label>
							<input type="text" id="input-rsvp-deadline" value="September 15, 2026" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
						</div>
					</div>

					<!-- Location & Dress Code -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.6rem;">
						<div>
							<label for="input-wedding-location" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Venue & City *
							</label>
							<input type="text" id="input-wedding-location" value="The Glasshouse Gardens, San Francisco, CA" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
						</div>
						<div>
							<label for="input-dress-code" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Dress Code
							</label>
							<select id="input-dress-code" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.85rem;">
								<option value="Black-Tie Optional" selected>Black-Tie Optional</option>
								<option value="Cocktail Attire">Cocktail Attire</option>
								<option value="Garden Party Chic">Garden Party Chic</option>
								<option value="Semi-Formal">Semi-Formal</option>
								<option value="Casual & Relaxed">Casual & Relaxed</option>
							</select>
						</div>
					</div>

					<!-- RSVP Website & Short Message -->
					<div>
						<label for="input-rsvp-link" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							RSVP Website Link / Registry URL
						</label>
						<input type="text" id="input-rsvp-link" value="https://manage.wedding/rsvp" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
					</div>

					<div>
						<label for="input-wedding-message" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Personal Note / Welcome Message
						</label>
						<textarea id="input-wedding-message" rows="2" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff; resize: vertical;">Dinner, drinks, and dancing to follow the ceremony!</textarea>
					</div>

					<!-- Guest Personalization Toggle & Management Toolbar -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.6rem;">
						
						<!-- Personalization Mode Toggle -->
						<div style="display: flex; justify-content: space-between; align-items: center; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem 0.75rem;">
							<div>
								<strong class="font-heading" style="font-size: 0.92rem; color: var(--fg-pencil); display: block;">
									Personalize with Guest Names
								</strong>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">
									Uncheck for a clean universal card (no names) for group chats
								</span>
							</div>
							<label style="display: flex; align-items: center; cursor: pointer;">
								<input type="checkbox" id="chk-include-guest-name" checked style="width: 20px; height: 20px; accent-color: var(--accent-blue); cursor: pointer;">
							</label>
						</div>

						<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
							<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
								👥 Guest Roster: <strong id="guest-count-badge">0 Guests</strong>
							</span>
							<div style="display: flex; gap: 0.3rem;">
								<button type="button" id="btn-load-sample-guests" class="hand-btn" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; background: #eff6ff;">
									✨ Load Samples
								</button>
								<button type="button" id="btn-clear-all-guests" class="hand-btn secondary" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; color: #b91c1c;">
									🗑️ Clear All
								</button>
							</div>
						</div>

						<div style="display: flex; gap: 0.4rem;">
							<input type="text" id="input-quick-add-guest" placeholder="Type guest name & press Add..." style="flex: 1; padding: 0.35rem 0.5rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<button type="button" id="btn-quick-add-guest" class="hand-btn" style="padding: 0.35rem 0.65rem; font-size: 0.85rem;">
								+ Add
							</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Card Preview & Batch Generation Export Box -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Card Preview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖼️ Live Card Preview
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Real-time rendering of your digital invitation card
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word Messages (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print All
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- The Interactive Preview Canvas Card -->
					<div id="preview-invite-card" class="theme-classic" style="border: 2.5px solid var(--fg-pencil); border-radius: 6px; padding: 2rem 1.5rem; background: var(--bg-paper); text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.5rem;">
						
						<!-- Aesthetic Hand-Drawn Corner Markers -->
						<div style="position: absolute; top: 6px; left: 6px; width: 16px; height: 16px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 6px; right: 6px; width: 16px; height: 16px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; left: 6px; width: 16px; height: 16px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; right: 6px; width: 16px; height: 16px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<p style="font-family: var(--font-body); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 2.5px; color: var(--accent-red); margin: 0 0 0.5rem 0; font-weight: bold;">
							YOU ARE CORDIALLY INVITED TO CELEBRATE
						</p>

						<h3 id="prev-guest-name" class="font-heading" style="font-size: 1.4rem; color: var(--accent-blue); margin: 0 0 0.75rem 0;">
							Dear Olivia & Liam,
						</h3>

						<p style="font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-secondary); margin: 0 0 0.4rem 0;">
							Together with their families
						</p>

						<h2 id="prev-couples-names" class="font-heading" style="font-size: 2.4rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; line-height: 1.15;">
							Emma & Alexander
						</h2>

						<div style="width: 50px; height: 2px; background: var(--fg-pencil); margin: 0.6rem auto;"></div>

						<p id="prev-wedding-message" class="font-body" style="font-size: 0.95rem; font-style: italic; color: var(--fg-pencil); margin: 0.5rem 0 1rem 0; line-height: 1.4;">
							"Dinner, drinks, and dancing to follow the ceremony!"
						</p>

						<div style="border-top: 1.5px dashed var(--fg-pencil); border-bottom: 1.5px dashed var(--fg-pencil); padding: 0.75rem 0; margin: 1rem 0;">
							<p id="prev-wedding-date" class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.25rem 0; font-weight: bold;">
								Saturday, October 17, 2026 at 4:30 PM
							</p>
							<p id="prev-wedding-location" class="font-body" style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
								The Glasshouse Gardens, San Francisco, CA
							</p>
						</div>

						<div style="display: flex; justify-content: space-around; font-size: 0.8rem; font-family: var(--font-body); color: var(--fg-pencil); margin-top: 0.75rem;">
							<span>👔 Dress Code: <strong id="prev-dress-code">Black-Tie Optional</strong></span>
							<span>📅 RSVP by: <strong id="prev-rsvp-deadline">Sept 15, 2026</strong></span>
						</div>

						<p id="prev-rsvp-link" style="font-family: var(--font-body); font-size: 0.78rem; color: var(--accent-blue); margin: 0.75rem 0 0 0; text-decoration: underline;">
							RSVP & Registry: https://manage.wedding/rsvp
						</p>
					</div>

					<button type="button" id="btn-download-sample-png" class="hand-btn" style="width: 100%; text-align: center; font-size: 1rem; padding: 0.65rem; background: #f0fdf4;">
						📸 Download This Sample Card (High-Res PNG)
					</button>

				</div>

				<!-- Generated Guest Cards Stream Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 450px; overflow-y: auto;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						📥 Generated Guest E-Invites Stream
					</h3>
					<div id="invites-stream-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<!-- Populated via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Official Wedding Invitation Roster</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Couple: <span id="print-couple"></span></p>
			</div>
			<div id="print-invites-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;"></div>
		</div>

		<!-- SEO Article & Comprehensive Guide (Centered Headings) -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Digital Stationery & Etiquette Playbook</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					The Complete Guide to Digital Wedding Invitations
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					Why e-invites save $1,500+, 5 ready-to-send SMS/WhatsApp templates, and modern etiquette standards.
				</p>
			</div>

			<div style="margin-bottom: 2.5rem; text-align: center;">
				<img 
					src="/images/rsvp_envelopes.jpg" 
					alt="Hand drawn line art sketch of wedding invitation envelopes representing digital e-invites and instant online RSVP tracking" 
					style="width: 100%; max-height: 420px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); margin: 0 auto; display: block;"
				/>
				<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin-top: 0.5rem; font-style: italic;">
					Digital invitations eliminate lost mail, postage delays, and allow instant mobile RSVP tracking.
				</p>
			</div>

			<!-- Section 1: Detailed Step-by-Step Guide on How to Use This Tool Flawlessly -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. Step-by-Step Guide: How to Generate & Send E-Invites
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1.25rem;">
					Follow this simple step-by-step workflow to generate and dispatch personalized invitations in under 5 minutes:
				</p>

				<div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.5rem;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-red); margin-bottom: 0.4rem;">
							Step 1: Customize Event Details & Artistic Theme
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Type in your wedding date, start time, venue address, dress code, and wedding website link. Choose your preferred aesthetic border theme (Classic Ink, Botanical Floral, or Romantic Arch).
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-blue); margin-bottom: 0.4rem;">
							Step 2: Sync Your Guest List or Add Names
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							The tool automatically syncs with your <strong>Guest List Manager</strong> database. You can also quickly type new guest names into the quick-add bar or click <strong>"✨ Load Sample Guests"</strong> to test full batch generation.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: #16a34a; margin-bottom: 0.4rem;">
							Step 3: Download Cards & Export Formatted Messages
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Download high-res PNG cards for individual guests, or click <strong>"📝 Export Word Messages (.doc)"</strong> to download an organized text file with customized SMS/WhatsApp invitation copy tailored for every guest!
						</p>
					</div>
				</div>
			</section>

			<!-- Section 2: Paper vs Digital Comparison Table -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					2. Traditional Paper vs. Digital E-Invitations Breakdown
				</h3>
				<div style="overflow-x: auto; margin-bottom: 1.5rem;">
					<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.95rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Comparison Factor</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Traditional Paper Stationery</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Digital E-Invitations</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">Average Cost (100 Sets)</td>
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: bold;">$1,200 - $2,800 (Cards + Stamps)</td>
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); color: #16a34a; font-weight: bold;">$0.00 (100% Free)</td>
							</tr>
							<tr style="background: #faf8f3;">
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">Delivery Speed</td>
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil);">5 to 14 business days (mail delays)</td>
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a;">Instant (1-click SMS / WhatsApp)</td>
							</tr>
							<tr>
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">RSVP Response Rate</td>
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil);">40% - 60% on-time (requires reminder calls)</td>
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a;">85% - 95% on-time (direct mobile link)</td>
							</tr>
							<tr style="background: #faf8f3;">
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">Environmental Impact</td>
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil);">High paper waste, ink, fossil fuel transport</td>
								<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a;">Zero waste (100% Eco-Friendly)</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<!-- Section 3: Ready-to-Send Text Message Templates -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					3. Ready-to-Send SMS & WhatsApp Invitation Copy
				</h3>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin: 1.5rem 0;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.15rem; color: var(--accent-blue); margin-bottom: 0.4rem; text-align: center;">
							Formal & Elegant Message
						</h4>
						<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; background: #fff; padding: 0.75rem; border: 1px solid var(--fg-pencil); border-radius: 4px;">
							"Dear [Guest Name], Emma & Alexander invite you to celebrate their wedding on October 17, 2026 at The Glasshouse Gardens. Please view your official invitation card attached and RSVP online here: [Link]"
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.15rem; color: #16a34a; margin-bottom: 0.4rem; text-align: center;">
							Warm & Casual Message
						</h4>
						<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; background: #fff; padding: 0.75rem; border: 1px solid var(--fg-pencil); border-radius: 4px;">
							"We're getting married! 💍 We would love for you to join us on October 17th. Check out your invite card above and let us know your RSVP and meal preferences here: [Link]"
						</p>
					</div>
				</div>
			</section>

			<!-- Section 4: Related Tools -->
			<section style="margin-bottom: 3rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.5rem;">
				<h3 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 1rem; text-align: center;">
					🔗 Integrated Wedding Stationery & Guest Tools
				</h3>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
					<a href="/guest-list-manager" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-blue); display: block;">Guest List Manager</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Manage guest groups, addresses, plus-ones, and dietary restrictions.</span>
					</a>
					<a href="/rsvp-tracker" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-red); display: block;">RSVP Tracker</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Track real-time acceptances, declines, and meal choices.</span>
					</a>
					<a href="/table-place-cards" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--fg-pencil); display: block;">Table Place Cards Maker</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Generate matching folded tent cards for reception seating.</span>
					</a>
				</div>
			</section>

			<!-- Section 5: FAQs (Centered Heading) -->
			<section>
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Frequently Asked Questions
				</h3>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						Can I send digital invitations via mass BCC email?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Yes! If sending via email, always place your guests' email addresses in the <strong>BCC (Blind Carbon Copy)</strong> field to preserve everyone's privacy and avoid accidental "Reply-All" threads.
					</p>
				</details>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						How do I export all personalized messages to Word?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Click <strong>"📝 Export Word Messages (.doc)"</strong> at the top of the page. The generator formats an organized, copy-and-paste ready document with personalized SMS and WhatsApp texts for every person on your list.
					</p>
				</details>
			</section>

		</article>

	</main>
</Layout>

<style>
	.theme-classic {
		background: #faf8f5 !important;
	}
	.theme-botanical {
		background: #f4f8f3 !important;
		border-color: #2d5a27 !important;
	}
	.theme-romantic {
		background: #fdf5f2 !important;
		border-color: #9f4d36 !important;
	}
	.theme-modern {
		background: #ffffff !important;
		border-color: #000000 !important;
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 20px;
		}
	}
</style>

<script is:inline>
	let guestList = [];

	const couplesNamesInput = document.getElementById('input-couples-names');
	const weddingDateInput = document.getElementById('input-wedding-date');
	const weddingLocationInput = document.getElementById('input-wedding-location');
	const rsvpDeadlineInput = document.getElementById('input-rsvp-deadline');
	const dressCodeSelect = document.getElementById('input-dress-code');
	const rsvpLinkInput = document.getElementById('input-rsvp-link');
	const weddingMessageInput = document.getElementById('input-wedding-message');
	const cardThemeSelect = document.getElementById('select-card-theme');

	// Preview Elements
	const prevGuestName = document.getElementById('prev-guest-name');
	const prevCouplesNames = document.getElementById('prev-couples-names');
	const prevWeddingDate = document.getElementById('prev-wedding-date');
	const prevWeddingLocation = document.getElementById('prev-wedding-location');
	const prevWeddingMessage = document.getElementById('prev-wedding-message');
	const prevDressCode = document.getElementById('prev-dress-code');
	const prevRsvpDeadline = document.getElementById('prev-rsvp-deadline');
	const prevRsvpLink = document.getElementById('prev-rsvp-link');
	const previewCard = document.getElementById('preview-invite-card');

	const guestCountBadge = document.getElementById('guest-count-badge');
	const invitesStreamContainer = document.getElementById('invites-stream-container');

	const chkIncludeGuestName = document.getElementById('chk-include-guest-name');

	function loadGuests() {
		try {
			const saved = localStorage.getItem('manage_wedding_guests');
			if (saved) {
				guestList = JSON.parse(saved);
			}
		} catch (e) {
			guestList = [];
		}

		if (!guestList || guestList.length === 0) {
			guestList = [
				{ name: "Olivia & Liam Johnson", group: "Bride's Family" },
				{ name: "Marcus & Sophia Chen", group: "Groom's Friends" },
				{ name: "David Miller", group: "Coworkers" },
				{ name: "Grandma Evelyn & Grandpa Joe", group: "VIPs" }
			];
		}
		renderAll();
	}

	function renderAll() {
		const names = couplesNamesInput.value || 'Emma & Alexander';
		const date = weddingDateInput.value || 'Saturday, October 17, 2026 at 4:30 PM';
		const location = weddingLocationInput.value || 'The Glasshouse Gardens, San Francisco, CA';
		const rsvpDeadline = rsvpDeadlineInput.value || 'September 15, 2026';
		const dressCode = dressCodeSelect.value || 'Black-Tie Optional';
		const rsvpLink = rsvpLinkInput.value || 'https://manage.wedding/rsvp';
		const msg = weddingMessageInput.value || 'Dinner, drinks, and dancing to follow the ceremony!';
		const theme = cardThemeSelect.value || 'classic';
		const isPersonalized = chkIncludeGuestName.checked;

		// Update Preview Card
		prevCouplesNames.textContent = names;
		prevWeddingDate.textContent = date;
		prevWeddingLocation.textContent = location;
		prevRsvpDeadline.textContent = rsvpDeadline;
		prevDressCode.textContent = dressCode;
		prevRsvpLink.textContent = `RSVP & Registry: ${rsvpLink}`;
		prevWeddingMessage.textContent = msg ? `"${msg}"` : '';

		if (isPersonalized && guestList.length > 0) {
			prevGuestName.style.display = 'block';
			if (!prevGuestName.textContent.startsWith('Dear ')) {
				prevGuestName.textContent = `Dear ${guestList[0].name},`;
			}
		} else {
			prevGuestName.style.display = 'none';
		}

		previewCard.className = `theme-${theme}`;

		// Guest Count
		guestCountBadge.textContent = `${guestList.length} Guests`;

		// Stream rendering
		invitesStreamContainer.innerHTML = '';
		if (guestList.length === 0) {
			invitesStreamContainer.innerHTML = `
				<div style="text-align: center; padding: 1rem; color: var(--text-secondary); font-style: italic; font-size: 0.9rem;">
					No individual guests. Card is in <strong>Universal Broadcast Mode</strong> (Perfect for Instagram, WhatsApp groups, or mass invites).
				</div>
			`;
		} else {
			guestList.forEach((guest, idx) => {
				const item = document.createElement('div');
				item.style.cssText = `display: flex; justify-content: space-between; align-items: center; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem 0.75rem;`;
				item.innerHTML = `
					<div>
						<strong class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">${guest.name}</strong>
						<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">${guest.group || 'Guest'}</span>
					</div>
					<div style="display: flex; gap: 0.25rem;">
						<button type="button" class="btn-preview-guest hand-btn" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #eff6ff;" title="Preview Card">
							👁️ View
						</button>
						<button type="button" class="btn-download-guest hand-btn" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #f0fdf4;" title="Download PNG">
							📸 PNG
						</button>
						<button type="button" class="btn-delete-guest hand-btn secondary" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; color: #b91c1c;" title="Remove Guest">
							🗑️ Del
						</button>
					</div>
				`;
				invitesStreamContainer.appendChild(item);
			});
		}

		// Attach Guest Listeners
		document.querySelectorAll('.btn-preview-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				if (guestList[idx]) {
					chkIncludeGuestName.checked = true;
					prevGuestName.style.display = 'block';
					prevGuestName.textContent = `Dear ${guestList[idx].name},`;
				}
			});
		});

		document.querySelectorAll('.btn-download-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				if (guestList[idx]) {
					chkIncludeGuestName.checked = true;
					prevGuestName.style.display = 'block';
					prevGuestName.textContent = `Dear ${guestList[idx].name},`;
					captureCardPNG(guestList[idx].name);
				}
			});
		});

		document.querySelectorAll('.btn-delete-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				guestList.splice(idx, 1);
				renderAll();
			});
		});
	}

	function captureCardPNG(filenamePrefix) {
		if (window.html2canvas) {
			window.html2canvas(previewCard, {
				scale: 3,
				backgroundColor: null,
				useCORS: true
			}).then(canvas => {
				const link = document.createElement('a');
				const safeName = (filenamePrefix || 'wedding-invite').replace(/[^a-z0-9]/gi, '_').toLowerCase();
				link.download = `Invite_${safeName}.png`;
				link.href = canvas.toDataURL("image/png");
				link.click();
			});
		} else {
			alert("Canvas capture is initializing. Please try again in 2 seconds.");
		}
	}

	// Quick Add Guest
	document.getElementById('btn-quick-add-guest').addEventListener('click', () => {
		const input = document.getElementById('input-quick-add-guest');
		const val = input.value.trim();
		if (val) {
			guestList.push({ name: val, group: 'Added Guest' });
			input.value = '';
			renderAll();
		}
	});

	// Clear All Guests
	document.getElementById('btn-clear-all-guests').addEventListener('click', () => {
		guestList = [];
		renderAll();
	});

	// Load Sample Guests
	document.getElementById('btn-load-sample-guests').addEventListener('click', () => {
		guestList = [
			{ name: "Olivia & Liam Johnson", group: "Bride's Family" },
			{ name: "Marcus & Sophia Chen", group: "Groom's Friends" },
			{ name: "David Miller & Plus One", group: "Coworkers" },
			{ name: "Grandma Evelyn & Grandpa Joe", group: "VIPs" },
			{ name: "Aunt Sarah & Uncle Michael", group: "Family" }
		];
		chkIncludeGuestName.checked = true;
		renderAll();
	});

	// Inputs Listener
	[couplesNamesInput, weddingDateInput, weddingLocationInput, rsvpDeadlineInput, dressCodeSelect, rsvpLinkInput, weddingMessageInput, cardThemeSelect, chkIncludeGuestName].forEach(el => {
		el.addEventListener('input', renderAll);
		el.addEventListener('change', renderAll);
	});

	document.getElementById('btn-download-sample-png').addEventListener('click', () => {
		captureCardPNG('Sample_Invite');
	});

	// 📝 Export Word Messages (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let sections = '';
		guestList.forEach(guest => {
			sections += `
				<div style="margin-bottom: 25px; padding: 15px; border: 1px solid #ccc; background: #fafafa;">
					<h3 style="margin: 0 0 8px 0; color: #1e3a8a;">Personalized Invite Message for: ${guest.name}</h3>
					<p style="margin: 0; font-family: monospace; font-size: 13px; line-height: 1.5; color: #333;">
						"Dear ${guest.name}, ${couplesNamesInput.value} warmly invite you to celebrate their wedding on ${weddingDateInput.value} at ${weddingLocationInput.value}! Dress code is ${dressCodeSelect.value}. Please view your formal invitation card and RSVP online by ${rsvpDeadlineInput.value} here: ${rsvpLinkInput.value}"
					</p>
				</div>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Wedding Digital Invitations Roster</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Digital Invitation Dispatch Copy</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Couple: <strong>${couplesNamesInput.value}</strong> | Total Guests: <strong>${guestList.length}</strong></p>
				
				<h2>Ready-to-Send WhatsApp & SMS Message Copy:</h2>
				${sections}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Invitations_Copy_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print All
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString();
		document.getElementById('print-couple').textContent = couplesNamesInput.value;

		const grid = document.getElementById('print-invites-grid');
		grid.innerHTML = '';

		guestList.forEach(guest => {
			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 20px; text-align: center; font-family: 'Times New Roman', serif; margin-bottom: 15px;`;
			card.innerHTML = `
				<p style="font-size: 10px; letter-spacing: 2px; text-transform: uppercase; margin: 0 0 5px 0;">You Are Cordially Invited</p>
				<h3 style="font-size: 18px; margin: 0 0 10px 0;">Dear ${guest.name},</h3>
				<p style="font-size: 12px; margin: 0 0 5px 0;">To celebrate the marriage of</p>
				<h2 style="font-size: 26px; margin: 0 0 10px 0;">${couplesNamesInput.value}</h2>
				<p style="font-size: 14px; font-weight: bold; margin: 10px 0 5px 0;">${weddingDateInput.value}</p>
				<p style="font-size: 12px; color: #444; margin: 0 0 10px 0;">${weddingLocationInput.value}</p>
				<p style="font-size: 11px; margin: 0;">Dress Code: ${dressCodeSelect.value} | RSVP: ${rsvpLinkInput.value}</p>
			`;
			grid.appendChild(card);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Guest Name,Guest Group,RSVP Link,Status\n";
		guestList.forEach(guest => {
			csv += `"${guest.name}","${guest.group || 'General'}","${rsvpLinkInput.value}","Invite Ready"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Invitations_Roster_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	loadGuests();
</script>
