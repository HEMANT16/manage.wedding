---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/wedding-invitation-suite-sizer/#webapp",
      "name": "Wedding Invitation Suite Sizer & Layering Dimension Calculator",
      "url": "https://manage.wedding/wedding-invitation-suite-sizer",
      "description": "Calculate exact dimensions, trimming borders, and envelope clearances for wedding invitation suites. Sizing charts for A7, A2, A8, Square, and Tea Length cards with 300 DPI Canva print bleed specs.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Size and Layer a Wedding Invitation Suite",
      "description": "Step-by-step sizing guide for matching envelopes, backers, and tiered enclosure cards with proper 1/8 inch print margins.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Choose Your Outer Envelope Standard",
          "text": "The industry standard outer envelope is A7 (5.25\" × 7.25\" / 133 × 184 mm), designed to hold a 5\" × 7\" invitation card with 1/8\" clearance on all sides."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Calculate Backer Mat & Trim Sizes",
          "text": "If layering a cardstock backer, size the backer card to 5.0\" × 7.0\" and trim the printed invitation card to 4.75\" × 6.75\" for a clean 1/8\" border reveal."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Size RSVP Cards to Fit A2 Envelopes",
          "text": "Design your RSVP card at 3.5\" × 5.0\" (or 4.25\" × 5.5\") so it fits smoothly into a pre-addressed A2 return envelope (4.375\" × 5.75\")."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Include 0.125\" (3mm) Print Bleeds",
          "text": "Ensure all artwork files in Canva, Illustrator, or Photoshop include a 0.125\" (300 DPI) bleed margin to prevent white edges during professional guillotine trimming."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the standard size for a wedding invitation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The universal standard size for a wedding invitation is 5\" × 7\" (127 × 178 mm), designed to fit inside an A7 envelope (5.25\" × 7.25\")."
          }
        },
        {
          "@type": "Question",
          "name": "What envelope size holds a 5x7 invitation card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An A7 envelope (5.25\" × 7.25\" / 133 × 184 mm) holds a standard 5\" × 7\" invitation card with optimal 1/8\" slide clearance."
          }
        },
        {
          "@type": "Question",
          "name": "What size is an RSVP card and envelope?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard RSVP cards measure 3.5\" × 5.0\" (4-Bar size) and pair with an A2 envelope (4.375\" × 5.75\") or 4-Bar envelope (3.625\" × 5.125\")."
          }
        },
        {
          "@type": "Question",
          "name": "What are the Canva pixel dimensions for a 5x7 invitation at 300 DPI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a 5\" × 7\" invitation at print quality 300 DPI with standard 0.125\" bleeds, set your canvas dimensions to 1575 × 2175 pixels (or 1500 × 2100 pixels without bleed)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Invitation Suite Sizer & Layering Dimension Calculator"
	description="Calculate exact dimensions, trimming borders, and envelope clearances for wedding invitation suites. Sizing charts for A7, A2, A8, and Tea Length cards with 300 DPI Canva print specs."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">3,600+ Monthly DIY & Stationer Searches</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Wedding Invitation <span class="accent-italic">Suite Sizer & Layering Guide</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Ensure your invitation layers, backer mats, details inserts, and RSVP cards slide into envelopes with millimeter-perfect clearances and 300 DPI print bleeds.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Suite Format Selector & Units -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Suite Format & Units
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						300 DPI Specs
					</span>
				</div>

				<!-- Suite Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="suite-format-preset">Standard Suite Format</label>
					<select id="suite-format-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="a7-standard" selected>💌 A7 Standard 5×7 Suite (Outer 5.25×7.25 / Card 5×7 / RSVP 3.5×5)</option>
						<option value="a7-layered">👑 A7 Layered Mat Suite (Backer 5×7 / Trimmed Card 4.75×6.75 / 1/8" Border)</option>
						<option value="square-6">🔲 Square 6×6 Modern Suite (Outer 6.5×6.5 / Card 6×6 / RSVP 4×4)</option>
						<option value="tea-length">🥂 4×9 Slimline / Tea Length (Outer #10 / Card 3.875×9.25)</option>
						<option value="a8-luxe">🏰 A8 European Luxe (Outer 5.5×8.125 / Card 5.25×7.75)</option>
						<option value="uk-metric">🇬🇧 UK/EU Metric (C5 Envelope 162×229mm / A5 Card 148×210mm)</option>
					</select>
				</div>

				<!-- Measurement Unit Selector -->
				<div class="form-group">
					<label class="form-label" for="unit-selector">Display Measurement Units</label>
					<select id="unit-selector" class="form-input" style="cursor: pointer; font-weight: 600;">
						<option value="in" selected>Inches (e.g. 5.00" × 7.00")</option>
						<option value="mm">Millimeters (e.g. 127 × 178 mm)</option>
						<option value="px">Pixels @ 300 DPI for Canva/Photoshop (e.g. 1500 × 2100 px)</option>
					</select>
				</div>

				<!-- Backer Mat Border Width -->
				<div class="form-group">
					<label class="form-label" for="border-reveal">Backer Mat Reveal Border Width</label>
					<select id="border-reveal" class="form-input" style="cursor: pointer;">
						<option value="0.125" selected>1/8 Inch (0.125" / 3.2 mm) — Standard Delicate Reveal</option>
						<option value="0.25">1/4 Inch (0.250" / 6.4 mm) — Bold Framed Mat</option>
						<option value="0">No Backer (Single Ply Card)</option>
					</select>
				</div>

				<!-- Additional Components (Checkboxes) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Enclosure Layer Options
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-details" checked style="width: 18px; height: 18px;" />
							<span>Include Details / Reception Insert Card</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-rsvp" checked style="width: 18px; height: 18px;" />
							<span>Include Physical RSVP Card & Return Envelope</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-bellyband" checked style="width: 18px; height: 18px;" />
							<span>Include Belly Band / Vellum Wrap</span>
						</label>
					</div>
				</div>

			</div>

			<!-- Right Column: Interactive Layering Canvas & Spec Sheet -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Spec Sheet Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Cut & Print Specifications
						</span>
						<span id="format-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							A7 Standard Suite
						</span>
					</div>

					<h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Layer-by-Layer Dimensions
					</h3>

					<!-- Itemized Dimension Specs Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						
						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>1. Outer Mailing Envelope:</strong></span>
							<strong id="spec-outer-envelope" style="color: var(--accent-blue);">5.25" × 7.25" (A7)</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>2. Backer Card / Mat:</strong></span>
							<strong id="spec-backer-card">5.00" × 7.00"</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>3. Printed Main Invitation:</strong></span>
							<strong id="spec-main-card" style="color: var(--accent-red);">4.75" × 6.75"</strong>
						</div>

						<div id="row-details" style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>4. Details / Reception Insert:</strong></span>
							<strong id="spec-details-card">4.25" × 5.50" (A2)</strong>
						</div>

						<div id="row-rsvp" style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>5. RSVP Card + A2 Envelope:</strong></span>
							<strong id="spec-rsvp-card">Card: 3.5"×5.0" | Env: 4.375"×5.75"</strong>
						</div>

						<div id="row-belly" style="display: flex; justify-content: space-between; padding: 0.4rem 0; font-size: 0.92rem;">
							<span><strong>6. Belly Band / Wrap:</strong></span>
							<strong id="spec-bellyband">1.75" × 11.50"</strong>
						</div>

					</div>

					<!-- Print Bleed Spec Box -->
					<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem; font-size: 0.88rem; color: var(--fg-pencil); line-height: 1.5;">
						<strong>📐 Professional Print Bleed Settings:</strong><br />
						Add <strong style="color: var(--accent-red);">+0.125" (3mm / 38px @ 300 DPI)</strong> on all 4 sides before uploading to professional printers (Minted, Cards & Pockets, CatPrint) to guarantee edge-to-edge full bleed trimming!
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-specs" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Print Cut Sheet (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Word Doc
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Bottom Line Up Front (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Quick Rule of Thumb: Wedding Invitation Dimensions & Envelope Chart
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Short on time? Here is the universal dimension reference chart matching every standard wedding card to its exact envelope and Canva 300 DPI canvas sizes.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 The Universal 1/8" Envelope Clearance Rule:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Envelope Size = [Card Dimensions + 0.25" Width + 0.25" Height] • A 5.0" × 7.0" card requires a 5.25" × 7.25" A7 envelope • A 3.5" × 5.0" RSVP card requires a 4.375" × 5.75" A2 envelope.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Format Name</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Card Size (Inches)</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Matching Envelope</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Canva 300 DPI Canvas</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">A7 Standard (US Universal)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">5.00" × 7.00"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">A7 (5.25" × 7.25")</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1500 × 2100 px</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">A2 RSVP / Response Card</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">3.50" × 5.00" (4-Bar) / 4.25" × 5.5"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">A2 (4.375" × 5.75")</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1050 × 1500 px</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Square Modern</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">6.00" × 6.00"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Square (6.50" × 6.50")</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1800 × 1800 px</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Tea Length / Slimline Menu</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">3.875" × 9.25"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">#10 Policy (4.125" × 9.50")</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1162 × 2775 px</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					The Complete Wedding Invitation Sizing & Print Specification Guide
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Everything you need to know about paper weight (gsm vs lb), guillotine trimming margins, and envelope nesting orders.
				</p>
			</div>

			<!-- Section 1: Paper Weights Explained -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Understanding Cardstock Weights (GSM vs Cover LB)
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Nothing feels more luxurious than substantial paper. Choose the right thickness for each layer:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>110 lb – 120 lb Cover (300 – 320 GSM):</strong> Standard premium wedding cardstock. Sturdy, rigid, and feeds smoothly through digital home printers.</li>
					<li><strong>220 lb – 240 lb Double-Thick (600 GSM Cotton):</strong> Ultra-luxe, heavy board weight. Ideal for letterpress, foil stamping, and blind debossing.</li>
					<li><strong>80 lb – 100 lb Text (120 GSM):</strong> Lightweight paper specifically used for outer envelopes and envelope liners.</li>
				</ul>
			</section>

			<!-- Section 2: Assembly Order -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Proper Invitation Suite Stacking & Assembly Order
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Traditional etiquette dictates how elements are stacked inside the envelope:
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>📦 Layering Sequence (Bottom to Top):</strong><br />
					1. <strong>Main Invitation Card</strong> (Face up on bottom)<br />
					2. <strong>Reception / Details Card</strong> (Face up over invitation)<br />
					3. <strong>RSVP Return Envelope</strong> (Flap facing down)<br />
					4. <strong>RSVP Card</strong> (Tucked under the flap of the RSVP envelope, face up)<br />
					5. <strong>Belly Band / Ribbon</strong> (Wrapped around entire stack)<br />
					6. <strong>Inserted into Outer Envelope</strong> so recipient sees printed names immediately upon opening!
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Frequently Asked Questions
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Can a 5x7 invitation fit in an A6 envelope?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						No. An A6 envelope measures 4.75" × 6.5", which is too small for a 5" × 7" card. A 5" × 7" card strictly requires an A7 envelope (5.25" × 7.25").
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">What is the bleed size for a 5x7 wedding invitation?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Add 0.125" to all sides, resulting in a total document size of 5.25" × 7.25" (1575 × 2175 pixels at 300 DPI).
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">How long should a belly band be for a 5x7 invitation?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						A standard belly band should be 1.5" to 2.0" tall and 11.0" to 11.5" long to wrap comfortably around a multi-card suite with an overlap for adhesive.
					</p>
				</details>
			</section>

		</article>

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const formatSelect = document.getElementById('suite-format-preset');
		const unitSelect = document.getElementById('unit-selector');
		const borderRevealSelect = document.getElementById('border-reveal');

		const layerDetailsCheck = document.getElementById('layer-details');
		const layerRsvpCheck = document.getElementById('layer-rsvp');
		const layerBellyCheck = document.getElementById('layer-bellyband');

		const formatBadge = document.getElementById('format-badge');
		const specOuter = document.getElementById('spec-outer-envelope');
		const specBacker = document.getElementById('spec-backer-card');
		const specMain = document.getElementById('spec-main-card');
		const specDetails = document.getElementById('spec-details-card');
		const specRsvp = document.getElementById('spec-rsvp-card');
		const specBelly = document.getElementById('spec-bellyband');

		const rowDetails = document.getElementById('row-details');
		const rowRsvp = document.getElementById('row-rsvp');
		const rowBelly = document.getElementById('row-belly');

		const btnPrint = document.getElementById('btn-print-specs');
		const btnDoc = document.getElementById('btn-export-doc');

		function formatDim(w, h, unit) {
			if (unit === 'in') {
				return `${w.toFixed(2)}" × ${h.toFixed(2)}"`;
			} else if (unit === 'mm') {
				const wMm = Math.round(w * 25.4);
				const hMm = Math.round(h * 25.4);
				return `${wMm} × ${hMm} mm`;
			} else if (unit === 'px') {
				const wPx = Math.round(w * 300);
				const hPx = Math.round(h * 300);
				return `${wPx} × ${hPx} px`;
			}
		}

		function updateSuiteDimensions() {
			const fmt = formatSelect.value;
			const unit = unitSelect.value;
			const border = parseFloat(borderRevealSelect.value) || 0;

			let outerW = 5.25, outerH = 7.25, outerName = 'A7';
			let backerW = 5.00, backerH = 7.00;
			let mainW = 5.00, mainH = 7.00;
			let detailsW = 4.25, detailsH = 5.50;
			let rsvpCardW = 3.50, rsvpCardH = 5.00, rsvpEnvW = 4.375, rsvpEnvH = 5.75;
			let bellyW = 1.75, bellyL = 11.50;

			if (fmt === 'a7-standard') {
				formatBadge.textContent = 'A7 Standard 5×7 Suite';
				outerW = 5.25; outerH = 7.25; outerName = 'A7';
				backerW = 5.00; backerH = 7.00;
				mainW = 5.00 - (border * 2); mainH = 7.00 - (border * 2);
				detailsW = 4.25; detailsH = 5.50;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 1.75; bellyL = 11.50;
			} else if (fmt === 'a7-layered') {
				formatBadge.textContent = 'A7 Layered Luxe Mat';
				outerW = 5.25; outerH = 7.25; outerName = 'A7';
				backerW = 5.00; backerH = 7.00;
				mainW = 4.75; mainH = 6.75;
				detailsW = 4.00; detailsH = 5.25;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 1.75; bellyL = 11.50;
			} else if (fmt === 'square-6') {
				formatBadge.textContent = 'Square 6×6 Modern Suite';
				outerW = 6.50; outerH = 6.50; outerName = 'Square';
				backerW = 6.00; backerH = 6.00;
				mainW = 6.00 - (border * 2); mainH = 6.00 - (border * 2);
				detailsW = 4.50; detailsH = 4.50;
				rsvpCardW = 4.00; rsvpCardH = 4.00; rsvpEnvW = 4.50; rsvpEnvH = 4.50;
				bellyW = 1.75; bellyL = 13.50;
			} else if (fmt === 'tea-length') {
				formatBadge.textContent = 'Tea Length / Slimline 4×9';
				outerW = 4.125; outerH = 9.50; outerName = '#10 Policy';
				backerW = 3.875; backerH = 9.25;
				mainW = 3.875 - (border * 2); mainH = 9.25 - (border * 2);
				detailsW = 3.50; detailsH = 6.00;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 1.75; bellyL = 9.25;
			} else if (fmt === 'a8-luxe') {
				formatBadge.textContent = 'A8 European Luxe';
				outerW = 5.50; outerH = 8.125; outerName = 'A8';
				backerW = 5.25; backerH = 7.75;
				mainW = 5.25 - (border * 2); mainH = 7.75 - (border * 2);
				detailsW = 4.25; detailsH = 6.00;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 2.00; bellyL = 12.00;
			} else if (fmt === 'uk-metric') {
				formatBadge.textContent = 'UK/EU Metric (A5/C5)';
				outerW = 6.38; outerH = 9.02; outerName = 'C5 (162×229mm)';
				backerW = 5.83; backerH = 8.27; // A5
				mainW = 5.83 - (border * 2); mainH = 8.27 - (border * 2);
				detailsW = 4.13; detailsH = 5.83; // A6
				rsvpCardW = 4.13; rsvpCardH = 5.83; rsvpEnvW = 4.49; rsvpEnvH = 6.38; // C6
				bellyW = 1.75; bellyL = 13.00;
			}

			// Update Text Displays
			specOuter.textContent = `${formatDim(outerW, outerH, unit)} (${outerName})`;
			specBacker.textContent = border > 0 ? formatDim(backerW, backerH, unit) : 'N/A (Single Ply)';
			specMain.textContent = formatDim(mainW, mainH, unit);
			specDetails.textContent = formatDim(detailsW, detailsH, unit);
			specRsvp.textContent = `Card: ${formatDim(rsvpCardW, rsvpCardH, unit)} | Env: ${formatDim(rsvpEnvW, rsvpEnvH, unit)}`;
			specBelly.textContent = formatDim(bellyW, bellyL, unit);

			// Visibility Toggles
			rowDetails.style.display = layerDetailsCheck.checked ? 'flex' : 'none';
			rowRsvp.style.display = layerRsvpCheck.checked ? 'flex' : 'none';
			rowBelly.style.display = layerBellyCheck.checked ? 'flex' : 'none';
		}

		// Listeners
		[formatSelect, unitSelect, borderRevealSelect, layerDetailsCheck, layerRsvpCheck, layerBellyCheck].forEach(elem => {
			elem.addEventListener('change', updateSuiteDimensions);
		});

		// Print Spec Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Wedding Invitation Cut Sheet & Specs — Manage.Wedding</title>
					<style>
						@page { size: 8.5in 11in; margin: 0.5in; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 20pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Wedding Invitation Suite Cut Sheet</h1>
					<p>Format: ${formatBadge.textContent} | Units: ${unitSelect.options[unitSelect.selectedIndex].text}</p>
					
					<table>
						<thead><tr><th>Suite Layer / Component</th><th>Exact Finished Trim Size</th><th>300 DPI Canva Dimensions</th></tr></thead>
						<tbody>
							<tr><td><strong>Outer Mailing Envelope</strong></td><td>${specOuter.textContent}</td><td>Mailing Outer</td></tr>
							<tr><td><strong>Backer Mat Layer</strong></td><td>${specBacker.textContent}</td><td>Base Layer</td></tr>
							<tr><td><strong>Main Invitation Card</strong></td><td><strong>${specMain.textContent}</strong></td><td>+0.125" Full Bleed Required</td></tr>
							<tr><td><strong>Details / Insert Card</strong></td><td>${specDetails.textContent}</td><td>Enclosure</td></tr>
							<tr><td><strong>RSVP Response Card</strong></td><td>${specRsvp.textContent}</td><td>4-Bar / A2 Return</td></tr>
							<tr><td><strong>Belly Band Wrap</strong></td><td>${specBelly.textContent}</td><td>Adhesive Wrap</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Wedding Invitation Specs</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Invitation Suite Sizing Specs</h2>
					<p>Format: ${formatBadge.textContent}</p>
					<table>
						<thead><tr><th>Component</th><th>Trim Size</th></tr></thead>
						<tbody>
							<tr><td>Outer Envelope</td><td>${specOuter.textContent}</td></tr>
							<tr><td>Backer Card</td><td>${specBacker.textContent}</td></tr>
							<tr><td>Main Card</td><td>${specMain.textContent}</td></tr>
							<tr><td>Details Card</td><td>${specDetails.textContent}</td></tr>
							<tr><td>RSVP Suite</td><td>${specRsvp.textContent}</td></tr>
							<tr><td>Belly Band</td><td>${specBelly.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'wedding-invitation-sizing-spec.doc';
			link.click();
		});

		// Initial Calculation
		updateSuiteDimensions();
	</script>
</Layout>
