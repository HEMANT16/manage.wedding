---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/wedding-venue-cost-calculator/#webapp",
      "name": "Wedding Venue True Cost & Hidden Fee Calculator",
      "url": "https://manage.wedding/wedding-venue-cost-calculator",
      "description": "Calculate the true cost of a wedding venue. Factors in base site rental, Food & Beverage minimums, mandatory 22% service charges (plus-plus), sales tax, security, cleaning, cake cutting, and raw space rentals.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate the Real Total Cost of a Wedding Venue",
      "description": "Step-by-step formula to calculate all-in venue expenses beyond the advertised base rental rate.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Start with Base Site Rental Fee",
          "text": "Enter the quoted space rental fee for ceremony and reception hours."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Add Food & Beverage Minimums",
          "text": "Check if the venue requires a mandatory food and beverage spend (F&B minimum) or per-head catering commitment."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Apply the Plus-Plus (++) Surcharge",
          "text": "Multiply catering and bar totals by the mandatory administrative service charge (typically 20%–24%) and state/local sales tax (typically 6%–10%)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Factor in Facility, Security & Vendor Surcharges",
          "text": "Include security guards, post-event cleaning fees, bridal suite early access, cake cutting fees ($2–$5/slice), corkage ($15–$30/bottle), and required event liability insurance."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What does 'plus-plus' (++) mean in wedding venue pricing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In wedding venue and catering contracts, 'plus-plus' (written as ++) indicates that the quoted price does not include the mandatory service charge (typically 20% to 24%) or state/local sales tax (typically 6% to 10%). A $10,000 catering quote with 22% service charge and 8% tax actually totals $13,176."
          }
        },
        {
          "@type": "Question",
          "name": "Is a raw barn venue cheaper than an all-inclusive hotel ballroom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not always. While a raw barn may advertise a low rental fee (e.g. $4,000–$6,000), couples must independently rent tables, chairs, luxury restroom trailers ($1,500+), generator power ($800+), trash removal, and full outside catering setup. Raw venues often end up costing more than all-inclusive packages."
          }
        },
        {
          "@type": "Question",
          "name": "What hidden fees do wedding venues charge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Common hidden venue fees include: mandatory service charges (20–24%), cake cutting fees ($2–$5/guest), corkage fees ($15–$30/bottle), ceremony site fees ($1,000–$2,500), security guard staffing ($300–$600), cleaning/janitorial deposits ($400–$800), and outside caterer buyout penalties ($1,000–$3,000)."
          }
        },
        {
          "@type": "Question",
          "name": "How much should you tip wedding venue staff?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Check your contract carefully: the 20%–24% 'service charge' is usually an administrative operating fee retained by the venue, NOT a gratuity for servers and bartenders. Tip banquet captains $50–$100, and servers/bartenders $20–$50 each if gratuity is not explicitly included."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Venue True Cost & Hidden Fee Calculator (The Real Total)"
	description="Calculate the true cost of a wedding venue. Factors in base site rental, Food & Beverage minimums, mandatory 22% service charges (plus-plus), sales tax, security, cleaning, and raw rentals."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Venue Hidden Fee & True Cost" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Uncover $3k–$10k in Hidden Fees</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Wedding Venue <span class="accent-italic">True Cost Calculator</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				That $6,000 venue quote often turns into $25,000+ after Food & Beverage minimums, 22% "Plus-Plus" service charges, sales tax, security, and cleaning fees. Calculate your real out-of-pocket total before signing!
			</p>
		</header>

		<!-- Editorial Guide Interlink Banner -->
		<div style="background: #fef3c7; border: 2px solid #d97706; border-radius: 8px; padding: 1rem 1.5rem; margin-bottom: 2.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; box-shadow: 2px 2px 0px #d97706;">
			<div style="display: flex; align-items: center; gap: 0.75rem;">
				<span style="font-size: 1.5rem;">🔍</span>
				<div>
					<strong style="color: #92400e; font-size: 0.95rem; display: block;">Wondering How Plus-Plus (++) Surcharges Are Billed?</strong>
					<span style="color: #78350f; font-size: 0.88rem;">Read our comprehensive guide on <a href="/wedding-venue-hidden-costs-contract-red-flags" style="color: #92400e; text-decoration: underline; font-weight: 700;">Wedding Venue Hidden Costs: 15 Contract Red Flags (Plus-Plus & 22% Fee Math)</a>.</span>
				</div>
			</div>
			<a href="/wedding-venue-hidden-costs-contract-red-flags" style="background: #b45309; color: #fff; text-decoration: none; font-weight: 700; font-size: 0.85rem; padding: 6px 14px; border-radius: 6px; border: 1px solid #78350f; white-space: nowrap;">
				Read Guide &rarr;
			</a>
		</div>

		<!-- Main Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Controls & Line-Item Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Venue Contract Inputs
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Plus-Plus (++) Engine
					</span>
				</div>

				<!-- Venue Archetype Presets -->
				<div class="form-group">
					<label class="form-label" for="venue-preset">Venue Style / Contract Archetype</label>
					<select id="venue-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="hotel" selected>🏨 All-Inclusive Hotel / Resort ($5k Base + $15k F&B Minimum + 24% ++)</option>
						<option value="barn">🌾 Rustic Barn / Raw Farmstead ($7k Base + DIY Restrooms + Power + Catering)</option>
						<option value="estate">🏰 Historic Mansion / Estate ($9k Base + $1.5k Ceremony Fee + Outside Catering)</option>
						<option value="winery">🍇 Vineyard / Winery ($6k Base + Mandatory Wine Case Purchases + Shuttle)</option>
						<option value="custom">✏️ Custom Contract Inputs</option>
					</select>
				</div>

				<!-- Base Rental Fee & Ceremony Fee -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="base-rental">Base Site Rental ($)</label>
						<input type="number" id="base-rental" class="form-input" value="5000" min="0" step="250" />
					</div>
					<div>
						<label class="form-label" for="ceremony-fee">Ceremony Fee ($)</label>
						<input type="number" id="ceremony-fee" class="form-input" value="1200" min="0" step="100" />
					</div>
				</div>

				<!-- Guest Count & F&B Minimum -->
				<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="guest-count">Guest Count</label>
						<input type="number" id="guest-count" class="form-input" value="120" min="10" max="600" />
					</div>
					<div>
						<label class="form-label" for="fb-spend">Total Food & Bar Spend ($)</label>
						<input type="number" id="fb-spend" class="form-input" value="14400" min="0" step="500" />
					</div>
				</div>

				<!-- Plus-Plus Rates (Service Charge & Tax) -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="service-charge-rate">Service Charge / Admin (%)</label>
						<input type="number" id="service-charge-rate" class="form-input" value="22" min="0" max="35" step="1" />
					</div>
					<div>
						<label class="form-label" for="tax-rate">Sales Tax Rate (%)</label>
						<input type="number" id="tax-rate" class="form-input" value="8" min="0" max="15" step="0.25" />
					</div>
				</div>

				<!-- Hidden Facility Surcharges -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Mandatory Facility & Staffing Fees ($)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="cleaning-fee" style="font-size: 0.9rem;">Cleaning / Janitorial</label>
							<input type="number" id="cleaning-fee" class="form-input" value="500" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="security-fee" style="font-size: 0.9rem;">Security Guards</label>
							<input type="number" id="security-fee" class="form-input" value="400" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="insurance-fee" style="font-size: 0.9rem;">Event Insurance</label>
							<input type="number" id="insurance-fee" class="form-input" value="175" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="overtime-fee" style="font-size: 0.9rem;">Overtime / Early Access</label>
							<input type="number" id="overtime-fee" class="form-input" value="600" min="0" step="100" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Vendor Friction Add-ons (Cake Cutting / Corkage / Infrastructure) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Vendor Friction & Logistics Add-ons ($)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="cake-cutting-rate" style="font-size: 0.9rem;">Cake Cutting ($/guest)</label>
							<input type="number" id="cake-cutting-rate" class="form-input" value="3.50" min="0" step="0.50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="infrastructure-fee" style="font-size: 0.9rem;">Restroom / Generator / Tent</label>
							<input type="number" id="infrastructure-fee" class="form-input" value="0" min="0" step="250" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Real Total & Price Shock Breakdown -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- True Cost Summary Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Real Out-Of-Pocket Total
						</span>
						<span id="markup-multiplier-tag" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							4.9× Quoted Base
						</span>
					</div>

					<div id="display-real-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.5rem;">
						$27,159
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Quoted Base Rental was <strong id="display-quoted-base" style="color: var(--fg-pencil);">$5,000</strong>. Actual cost per guest: <strong id="display-per-guest" style="color: var(--fg-pencil);">$226/person</strong>.
					</p>

					<!-- Itemized Cost Breakdown Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Base Venue + Ceremony Site:</span>
							<strong id="item-base-total">$6,200</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Food & Bar Spend:</span>
							<strong id="item-fb-spend">$14,400</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem; color: var(--accent-red);">
							<span>Mandatory Service Charge (22% ++):</span>
							<strong id="item-service-charge">$3,168</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem; color: var(--accent-blue);">
							<span>State & Local Sales Tax (8%):</span>
							<strong id="item-sales-tax">$1,405</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Facility (Cleaning, Security, Insurance):</span>
							<strong id="item-facility-total">$1,675</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.95rem;">
							<span>Cake Cutting / Add-ons:</span>
							<strong id="item-addons-total">$420</strong>
						</div>
					</div>

					<!-- Export Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-audit" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Print Cost Audit (PDF)
						</button>
						<button id="btn-export-word" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Word Doc
						</button>
					</div>

				</div>

				<!-- Contract Warning Callout Box -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						🚨 3 Critical Contract Gotchas Before You Sign:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>"Tax on Service Charge":</strong> Many states tax the service charge itself (taxing the 22% fee), adding another 1.8%–2.5% to your total bill.</li>
						<li><strong>Curfew & Sound Ordinances:</strong> Check if outdoor music must shut off at 10:00 PM and what overtime fees apply ($500–$1,500/hr).</li>
						<li><strong>Exclusivity Buyout Penalties:</strong> If you want your own outside caterer, some venues charge a mandatory $1,500–$3,000 buyout fee!</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Bottom Line Up Front (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Quick Rule of Thumb: Real Venue Cost Formulas & Benchmarks
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Short on time? Here is the universal formula to calculate true venue costs and compare real pricing across venue styles.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					💰 The True Wedding Venue Cost Formula:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Real Out-of-Pocket = Base Rental + Ceremony Fee + [Food & Bar × (1 + Service% + Tax%)] + Security + Cleaning + Insurance + Cake/Corkage + Raw Rentals • Average Multiplier: 3.5× to 5.2× the advertised base rental!
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Venue Style</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Quoted Base Rental</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Mandatory Hidden Extras</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Real Out-of-Pocket Total</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">All-Inclusive Hotel / Resort</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">$3,500 – $6,000</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">$15k+ F&B Min, 24% ++ Service Fee, 8% Tax, Parking Valet</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">$24,000 – $36,000</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Rustic Barn / Farmstead (Raw Space)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">$5,000 – $8,500</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Restrooms ($1.5k), Generator ($800), Tent backup, Outside Catering</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">$22,000 – $32,000</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Historic Mansion / Estate</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">$8,000 – $14,000</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Ceremony Fee ($2k), Security ($600), Exclusive Caterer Premium</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">$30,000 – $55,000</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Winery / Vineyard</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">$6,000 – $10,000</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mandatory 2-Case/10 Guest Wine Buy ($3k+), Shuttles, Curfew</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">$26,000 – $42,000</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					How to Audit a Wedding Venue Contract & Avoid Price Shocks
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Venue and catering expenses consume 40% to 50% of your total wedding budget. Master contract negotiation, service charge math, and hidden line items.
				</p>
			</div>

			<!-- Section 1: Decoding Plus-Plus -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Decoding the "Plus-Plus" (++) Multiplier
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					When a venue coordinator says meals are "$120 per person ++", that quote does NOT mean you will pay $120. The ++ notation stands for <strong>Service Charge + Sales Tax</strong>.
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>🧮 Real Example of 100 Guests at $120/person ++:</strong><br />
					• Base Catering: $120 × 100 = <strong>$12,000</strong><br />
					• 22% Administrative Service Charge: $12,000 × 0.22 = <strong>+$2,640</strong><br />
					• Subtotal before tax: <strong>$14,640</strong><br />
					• 8% State Sales Tax (on subtotal): $14,640 × 0.08 = <strong>+$1,171.20</strong><br />
					• <strong>Real Total: $15,811.20</strong> (Actual per-person cost is <strong>$158.11</strong>, not $120!).
				</div>
			</section>

			<!-- Section 2: Questions to Ask -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. 10 Essential Questions to Ask Before Signing
				</h3>
				<ol class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li>Is the service charge distributed to staff as a tip, or is it an administrative venue fee?</li>
					<li>What is the exact Food & Beverage minimum for our chosen date and time?</li>
					<li>Are tables, chairs, linens, and dinnerware included in the rental fee?</li>
					<li>How many hours are included for vendor setup and post-event teardown?</li>
					<li>What is the hourly overtime rate if the reception runs past midnight?</li>
					<li>Do you have an exclusive vendor list, and what is the buyout fee for bringing an outside caterer?</li>
					<li>What are your corkage and cake cutting fees?</li>
					<li>Is event liability insurance required, and what coverage minimums must we purchase?</li>
					<li>Are there outdoor noise curfews or decibel sound limits?</li>
					<li>What is your cancellation and date-change policy regarding our initial deposit?</li>
				</ol>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Frequently Asked Questions
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">What does 'plus-plus' (++) mean in wedding venue pricing?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						It indicates that the base price excludes the mandatory service fee (20–24%) and sales tax (6–10%).
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Is a raw barn venue cheaper than an all-inclusive hotel ballroom?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Often no. Infrastructure costs (restroom trailers, generator power, trash haul-off, rentals) frequently make raw barns more expensive in total.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">How much should you tip venue staff?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Because the 22% service charge is usually an administrative fee, tip banquet captains $50–$100, and servers/bartenders $20–$50 each if gratuity is not explicitly included.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/wedding-venue-cost-calculator" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('venue-preset');
		const baseRentalInput = document.getElementById('base-rental');
		const ceremonyFeeInput = document.getElementById('ceremony-fee');
		const guestCountInput = document.getElementById('guest-count');
		const fbSpendInput = document.getElementById('fb-spend');
		const serviceRateInput = document.getElementById('service-charge-rate');
		const taxRateInput = document.getElementById('tax-rate');
		const cleaningFeeInput = document.getElementById('cleaning-fee');
		const securityFeeInput = document.getElementById('security-fee');
		const insuranceFeeInput = document.getElementById('insurance-fee');
		const overtimeFeeInput = document.getElementById('overtime-fee');
		const cakeRateInput = document.getElementById('cake-cutting-rate');
		const infraFeeInput = document.getElementById('infrastructure-fee');

		const displayRealTotal = document.getElementById('display-real-total');
		const displayQuotedBase = document.getElementById('display-quoted-base');
		const displayPerGuest = document.getElementById('display-per-guest');
		const markupTag = document.getElementById('markup-multiplier-tag');

		const itemBaseTotal = document.getElementById('item-base-total');
		const itemFbSpend = document.getElementById('item-fb-spend');
		const itemServiceCharge = document.getElementById('item-service-charge');
		const itemSalesTax = document.getElementById('item-sales-tax');
		const itemFacilityTotal = document.getElementById('item-facility-total');
		const itemAddonsTotal = document.getElementById('item-addons-total');

		const btnPrint = document.getElementById('btn-print-audit');
		const btnWord = document.getElementById('btn-export-word');

		function calculateVenueCost() {
			const base = parseFloat(baseRentalInput.value) || 0;
			const ceremony = parseFloat(ceremonyFeeInput.value) || 0;
			const guests = parseInt(guestCountInput.value, 10) || 1;
			const fb = parseFloat(fbSpendInput.value) || 0;
			const serviceRate = (parseFloat(serviceRateInput.value) || 0) / 100;
			const taxRate = (parseFloat(taxRateInput.value) || 0) / 100;
			const cleaning = parseFloat(cleaningFeeInput.value) || 0;
			const security = parseFloat(securityFeeInput.value) || 0;
			const insurance = parseFloat(insuranceFeeInput.value) || 0;
			const overtime = parseFloat(overtimeFeeInput.value) || 0;
			const cakeRate = parseFloat(cakeRateInput.value) || 0;
			const infra = parseFloat(infrastructureFeeInput.value) || 0;

			// Plus-Plus Math
			const serviceCharge = fb * serviceRate;
			const subtotalBeforeTax = fb + serviceCharge;
			const salesTax = subtotalBeforeTax * taxRate;

			// Addons & Facilities
			const facilityTotal = cleaning + security + insurance + overtime;
			const cakeTotal = cakeRate * guests;
			const addonsTotal = cakeTotal + infra;

			const grandTotal = base + ceremony + fb + serviceCharge + salesTax + facilityTotal + addonsTotal;
			const perGuest = grandTotal / guests;
			const multiplier = base > 0 ? (grandTotal / base).toFixed(1) : 1;

			// Update Displays
			displayRealTotal.textContent = `$${Math.round(grandTotal).toLocaleString()}`;
			displayQuotedBase.textContent = `$${Math.round(base).toLocaleString()}`;
			displayPerGuest.textContent = `$${Math.round(perGuest).toLocaleString()}/person`;
			markupTag.textContent = `${multiplier}× Quoted Base`;

			itemBaseTotal.textContent = `$${Math.round(base + ceremony).toLocaleString()}`;
			itemFbSpend.textContent = `$${Math.round(fb).toLocaleString()}`;
			itemServiceCharge.textContent = `$${Math.round(serviceCharge).toLocaleString()}`;
			itemSalesTax.textContent = `$${Math.round(salesTax).toLocaleString()}`;
			itemFacilityTotal.textContent = `$${Math.round(facilityTotal).toLocaleString()}`;
			itemAddonsTotal.textContent = `$${Math.round(addonsTotal).toLocaleString()}`;
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'hotel') {
				baseRentalInput.value = 5000;
				ceremonyFeeInput.value = 1200;
				guestCountInput.value = 120;
				fbSpendInput.value = 14400;
				serviceRateInput.value = 24;
				taxRateInput.value = 8;
				cleaningFeeInput.value = 500;
				securityFeeInput.value = 400;
				insuranceFeeInput.value = 175;
				overtimeFeeInput.value = 600;
				cakeRateInput.value = 3.50;
				infraFeeInput.value = 0;
			} else if (p === 'barn') {
				baseRentalInput.value = 7500;
				ceremonyFeeInput.value = 800;
				guestCountInput.value = 120;
				fbSpendInput.value = 12000;
				serviceRateInput.value = 20;
				taxRateInput.value = 7;
				cleaningFeeInput.value = 600;
				securityFeeInput.value = 450;
				insuranceFeeInput.value = 200;
				overtimeFeeInput.value = 800;
				cakeRateInput.value = 0;
				infraFeeInput.value = 2800; // Restroom trailers + generator
			} else if (p === 'estate') {
				baseRentalInput.value = 9500;
				ceremonyFeeInput.value = 1500;
				guestCountInput.value = 120;
				fbSpendInput.value = 16000;
				serviceRateInput.value = 22;
				taxRateInput.value = 8;
				cleaningFeeInput.value = 800;
				securityFeeInput.value = 600;
				insuranceFeeInput.value = 250;
				overtimeFeeInput.value = 1000;
				cakeRateInput.value = 4.00;
				infraFeeInput.value = 500;
			} else if (p === 'winery') {
				baseRentalInput.value = 6500;
				ceremonyFeeInput.value = 1000;
				guestCountInput.value = 120;
				fbSpendInput.value = 15000;
				serviceRateInput.value = 22;
				taxRateInput.value = 8;
				cleaningFeeInput.value = 500;
				securityFeeInput.value = 400;
				insuranceFeeInput.value = 200;
				overtimeFeeInput.value = 750;
				cakeRateInput.value = 3.00;
				infraFeeInput.value = 1200; // Shuttle requirement
			}
			calculateVenueCost();
		});

		// Live Listeners
		[baseRentalInput, ceremonyFeeInput, guestCountInput, fbSpendInput, serviceRateInput, taxRateInput, cleaningFeeInput, securityFeeInput, insuranceFeeInput, overtimeFeeInput, cakeRateInput, infraFeeInput].forEach(inp => {
			inp.addEventListener('input', calculateVenueCost);
		});

		// Print PDF Audit Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Wedding Venue Cost Audit — Manage.Wedding</title>
					<style>
						@page { size: 8.5in 11in; margin: 0.5in; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 20pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 13pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Wedding Venue Cost Audit & True Out-of-Pocket</h1>
					<p>Calculated for ${guestCountInput.value} guests | Date: ${new Date().toLocaleDateString()}</p>
					
					<table>
						<thead>
							<tr><th>Expense Category</th><th>Line Item Details</th><th>Amount ($)</th></tr>
						</thead>
						<tbody>
							<tr><td>Base Site & Ceremony</td><td>Rental Fee ($${baseRentalInput.value}) + Ceremony Site ($${ceremonyFeeInput.value})</td><td>${itemBaseTotal.textContent}</td></tr>
							<tr><td>Food & Beverage Spend</td><td>Catering & Bar Commitment</td><td>${itemFbSpend.textContent}</td></tr>
							<tr><td>Service Charge (++)</td><td>${serviceRateInput.value}% Mandatory Administrative Fee</td><td>${itemServiceCharge.textContent}</td></tr>
							<tr><td>Sales Tax</td><td>${taxRateInput.value}% State & Local Tax</td><td>${itemSalesTax.textContent}</td></tr>
							<tr><td>Facility Fees</td><td>Cleaning ($${cleaningFeeInput.value}) + Security ($${securityFeeInput.value}) + Insurance ($${insuranceFeeInput.value}) + Overtime ($${overtimeFeeInput.value})</td><td>${itemFacilityTotal.textContent}</td></tr>
							<tr><td>Add-ons & Infrastructure</td><td>Cake Cutting + Restroom/Generator/Shuttles</td><td>${itemAddonsTotal.textContent}</td></tr>
							<tr class="total-row"><td>REAL TOTAL OUT-OF-POCKET</td><td>All-in venue and reception cost (${markupTag.textContent})</td><td>${displayRealTotal.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnWord.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Wedding Venue Cost Audit</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Venue True Cost Audit</h2>
					<p>Quoted Base: $${baseRentalInput.value} | <strong>Real Total: ${displayRealTotal.textContent}</strong> (${displayPerGuest.textContent})</p>
					<table>
						<thead><tr><th>Line Item</th><th>Amount ($)</th></tr></thead>
						<tbody>
							<tr><td>Base Venue & Ceremony</td><td>${itemBaseTotal.textContent}</td></tr>
							<tr><td>Food & Bar Spend</td><td>${itemFbSpend.textContent}</td></tr>
							<tr><td>Service Charge (${serviceRateInput.value}% ++)</td><td>${itemServiceCharge.textContent}</td></tr>
							<tr><td>Sales Tax (${taxRateInput.value}%)</td><td>${itemSalesTax.textContent}</td></tr>
							<tr><td>Facility Fees (Cleaning, Security, Insurance)</td><td>${itemFacilityTotal.textContent}</td></tr>
							<tr><td>Add-ons & Rentals</td><td>${itemAddonsTotal.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL</td><td>${displayRealTotal.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'wedding-venue-true-cost-audit.doc';
			link.click();
		});

		// Initial Calculation
		calculateVenueCost();
	</script>
</Layout>
