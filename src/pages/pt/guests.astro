---
import Layout from '../../layouts/Layout.astro';

const title = "Calculadoras de Convidados, Mesas & Logística de Casamento (Gratuito) | Manage.Wedding";
const description = "Calculadoras gratuitas para casamentos: mapa e disposição de mesas, pista de dança, cortejo nupcial, cronograma do grande dia e controlo de RSVP.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/pt/guests/#collection",
      "name": "Calculadoras de Convidados, Mesas & Logística de Casamento",
      "url": "https://manage.wedding/pt/guests",
      "inLanguage": "pt",
      "description": "Conjunto completo de ferramentas de organização: criador interativo de mapa de mesas, dimensionamento de pista de dança, ordem do cortejo e gerador de cronograma ao minuto.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Mapa de Mesas Interativo", "url": "https://manage.wedding/pt/seating-chart-maker" },
        { "@type": "WebApplication", "name": "Espaçamento e Pista de Dança", "url": "https://manage.wedding/pt/seating-clearance-calculator" },
        { "@type": "WebApplication", "name": "Ordem do Cortejo Nupcial", "url": "https://manage.wedding/pt/wedding-processional-order" },
        { "@type": "WebApplication", "name": "Cronograma do Grande Dia", "url": "https://manage.wedding/pt/day-of-timeline-generator" },
        { "@type": "WebApplication", "name": "Jantar de Ensaio / Véspera", "url": "https://manage.wedding/pt/rehearsal-dinner-planner" },
        { "@type": "WebApplication", "name": "Gestão da Lista de Convidados", "url": "https://manage.wedding/pt/guest-list-manager" },
        { "@type": "WebApplication", "name": "Controlo de Confirmações (RSVP)", "url": "https://manage.wedding/pt/rsvp-tracker" },
        { "@type": "WebApplication", "name": "Estimativa de Presenças Reais", "url": "https://manage.wedding/pt/guest-count-estimator" },
        { "@type": "WebApplication", "name": "Calendário de Envio de Convites", "url": "https://manage.wedding/pt/rsvp-date-calculator" },
        { "@type": "WebApplication", "name": "Roteiro de Cerimónia Laica e Temporizador", "url": "https://manage.wedding/pt/wedding-officiant-script-timer" },
        { "@type": "WebApplication", "name": "Checklist de Casamento de 12 Meses", "url": "https://manage.wedding/pt/wedding-checklist" }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "pt",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Que percentagem de convidados costuma recusar o convite de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para casamentos locais, cerca de 10% a 15% dos convidados não conseguem comparecer. Para destination weddings ou celebrações que exigem voos e alojamento em hotel, a taxa de recusa situa-se habitualmente entre 20% e 30%."
          }
        },
        {
          "@type": "Question",
          "name": "Qual deve ser o tamanho da pista de dança para 150 convidados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Calcula-se que 33% a 50% dos convidados estejam na pista em simultâneo no pico da festa. Para 150 convidados (cerca de 50 a 70 pessoas a dançar ao mesmo tempo), a área ideal de pista situa-se entre 20 m² e 25 m² (ex.: 4,5m × 5m ou 5m × 5m)."
          }
        },
        {
          "@type": "Question",
          "name": "Que distância deve existir entre as mesas redondas no salão?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Deve manter-se um espaço mínimo de 1,5 metros (60 polegadas) entre as bordas das mesas. Isto garante 45 cm para o recuo das cadeiras de cada lado e um corredor central de 60 cm para a circulação confortável dos empregados de mesa e convidados."
          }
        }
      ]
    }
  ]
};

const guestTools = [
  {
    title: "Calculadora de Sparklers & Placas",
    url: "/pt/wedding-sparkler-calculator",
    icon: "✨",
    badge: "Placas Imprimíveis",
    desc: "Calcule sparklers necessários, tempo de fotos, maçaricos e baldes de areia. Inclui placas 'Deixe o Amor Brilhar' em PDF e PNG.",
    tags: ["Saída dos Noivos", "Placas Imprimíveis", "Cartões Segurança"]
  },

  {
    title: "Mapa de Mesas Interativo",
    url: "/pt/seating-chart-maker",
    icon: "🪑",
    badge: "Drag & Drop",
    desc: "Disponha mesas redondas e compridas, atribua lugares aos convidados e descarregue a planta do salão para o espaço e catering.",
    tags: ["Disposição de Mesas", "Exportar PDF", "Planta do Salão"]
  },
  {
    title: "Pista de Dança & Espaço de Salão",
    url: "/pt/seating-clearance-calculator",
    icon: "📐",
    badge: "Área em m²",
    desc: "Calcule os metros quadrados necessários para a pista de dança, mesas de 8 a 12 lugares e corredores de 1,5 m de circulação.",
    tags: ["Pista de Dança m²", "Mesas Redondas", "Espaço por Pessoa"]
  },
  {
    title: "Cortejo Nupcial & Ordem de Entrada",
    url: "/pt/wedding-processional-order",
    icon: "⛪",
    badge: "Cerimónia",
    desc: "Organize a ordem exata de entrada e saída para cerimónias religiosas, civis ou simbólicas com guias para padrinhos e damas de honor.",
    tags: ["Entrada da Noiva", "Padrinhos", "Guia de Cortejo"]
  },
  {
    title: "Roteiro de Cerimónia Laica & Temporizador",
    url: "/pt/wedding-officiant-script-timer",
    icon: "📜",
    badge: "Roteiro & Fichas A5",
    desc: "Crie e cronometre o roteiro da cerimónia laica em 9 fases (120 PPM) com teleprompter interativo e fichas A5 para o púlpito.",
    tags: ["Roteiro de Casamento", "Cronómetro de Cerimónia", "Fichas A5 Púlpito"]
  },
  {
    title: "Cronograma do Grande Dia",
    url: "/pt/day-of-timeline-generator",
    icon: "⏰",
    badge: "Mais Popular",
    desc: "Insira a hora da cerimónia para gerar um guião detalhado minuto a minuto para fotógrafo, maquilhadora, catering e corte do bolo.",
    tags: ["Guião do Dia", "Partilhar Fornecedores", "Minuto a Minuto"]
  },
  {
    title: "Jantar de Ensaio / Véspera",
    url: "/pt/rehearsal-dinner-planner",
    icon: "🍷",
    badge: "Véspera",
    desc: "Planeie a lista de convidados para o jantar de véspera (padrinhos e familiares de longe), horários e orçamento da refeição.",
    tags: ["Padrinhos & Família", "Horários da Véspera", "Orçamento"]
  },
  {
    title: "Gestão da Lista de Convidados",
    url: "/pt/guest-list-manager",
    icon: "📋",
    badge: "Local-First",
    desc: "Organize acompanhantes, moradas para convites, escolhas de prato e intolerâncias alimentares com total privacidade.",
    tags: ["Acompanhantes", "Exportar CSV", "Alergénios"]
  },
  {
    title: "Controlo de Confirmações (RSVP)",
    url: "/pt/rsvp-tracker",
    icon: "✉️",
    badge: "Tempo Real",
    desc: "Contabilize confirmações, recusas e respostas em falta com gráficos de progresso automáticos.",
    tags: ["Controlo de Presenças", "Contagem Pratos", "Prazo Limite"]
  },
  {
    title: "Estimativa de Presenças Reais",
    url: "/pt/guest-count-estimator",
    icon: "👥",
    badge: "Probabilidades",
    desc: "Preveja a afluência real de convidados com base na proporção entre convidados locais e familiares que viajam de longe.",
    tags: ["Taxa de Presença", "Capacidade da Quinta", "Faltas Previstas"]
  },
  {
    title: "Calendário de Envio de Convites",
    url: "/pt/rsvp-date-calculator",
    icon: "📬",
    badge: "Prazos",
    desc: "Insira a data do casamento para calcular os prazos ideais para envio de Save-the-Date, convites e fecho com o catering.",
    tags: ["Data de Envio", "Prazo RSVP", "Data Limite Catering"]
  },
  {
    title: "Checklist de Casamento de 12 Meses",
    url: "/pt/wedding-checklist",
    icon: "✅",
    badge: "Interativo",
    desc: "Lista de tarefas interativa mês a mês com gravação automática no navegador para não esquecer nenhum detalhe.",
    tags: ["Plano 12 Meses", "Barra de Progresso", "Tarefas do Casamento"]
  },
  {
    title: "Arranjos do Vestido de Noiva",
    url: "/pt/dress-alterations-estimator",
    icon: "🪡",
    badge: "Atelier & Sarta",
    desc: "Estime os custos de bainhas, ajustes de corpete, colocação de copas e pontos para prender a cauda para as provas na costureira.",
    tags: ["Bainhas & Corpete", "Prender Cauda", "Provas em Atelier"]
  },
  {
    title: "Conversor de Tamanhos de Vestido de Noiva",
    url: "/pt/dress-size-converter",
    icon: "👗",
    badge: "Tabelas Internacionais",
    desc: "Converta medidas de busto, cintura e anca em centímetros para tamanhos de noiva europeus (PT/EU), US, UK e italianos.",
    tags: ["Tamanhos PT/EU", "Guia de Medidas", "Vestido de Noiva"]
  },
  {
    title: "Medidor de Tamanhos de Alianças",
    url: "/pt/ring-size-converter",
    icon: "💍",
    badge: "Medidas Oficiais",
    desc: "Converta o diâmetro ou perímetro em milímetros para a escala de tamanhos de alianças portuguesa e internacional.",
    tags: ["Tamanhos em mm", "Escala Portuguesa", "Alianças de Noivado"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Logística & Organização do Grande Dia</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Calculadoras de <span class="accent-italic">Convidados, Mesas & Logística</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Organize a entrada da cerimónia, calcule as dimensões da pista de dança, crie o cronograma minuto a minuto e desenhe o mapa de mesas interativo.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Categorias:</span>
      <a href="/pt/budget" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Orçamento</a>
      <a href="/pt/dining" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Banquete & Bar</a>
      <a href="/pt/guests" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">👥 Convidados & Logística (Ativo)</a>
      <a href="/pt/stationery" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💌 Papelaria & Lembranças</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {guestTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
            Abrir Ferramenta →
          </a>
        </div>
      ))}
    </div>

    <!-- Logistics Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Engenharia do Evento</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          Como Planear a Logística do Grande Dia
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Da ordem de entrada na cerimónia à circulação no salão de banquetes, os padrões fundamentais para um dia sem falhas.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. Dimensionamento da Pista de Dança
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Uma pista de dança demasiado pequena cria desconforto, enquanto uma área exagerada parece vazia. Calcule usando a <strong>Regra do Pico de 33% (cerca de 0,4 m² a 0,5 m² por pessoa a dançar)</strong>:
        </p>
        
        <div style="overflow-x: auto; margin-top: 1rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Total de Convidados</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Pessoas a Dançar no Pico</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--accent-blue);">Área Recomendada de Pista</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">100 Convidados</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">30 – 45 pessoas</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">16 m² a 20 m² (ex. 4m × 4m ou 4m × 5m)</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">150 Convidados</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">50 – 70 pessoas</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">20 m² a 25 m² (ex. 4,5m × 5m ou 5m × 5m)</td>
              </tr>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">200 Convidados</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">65 – 90 pessoas</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">30 m² a 36 m² (ex. 5m × 6m ou 6m × 6m)</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">250+ Convidados</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">80 – 120 pessoas</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">40 m² a 50 m² (ex. 6m × 7m ou 7m × 7m)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Perguntas Frequentes sobre Convidados e Mesas
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Que percentagem de convidados costuma recusar o convite de casamento?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Para casamentos locais, cerca de 10% a 15% dos convidados não conseguem comparecer. Para destination weddings ou celebrações que exigem voos e alojamento em hotel, a taxa de recusa situa-se habitualmente entre 20% e 30%.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Qual deve ser o tamanho da pista de dança para 150 convidados?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Calcula-se que 33% a 50% dos convidados estejam na pista em simultâneo no pico da festa. Para 150 convidados (cerca de 50 a 70 pessoas a dançar ao mesmo tempo), a área ideal de pista situa-se entre 20 m² e 25 m² (ex.: 4,5m × 5m ou 5m × 5m).
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Que distância deve existir entre as mesas redondas no salão?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Deve manter-se um espaço mínimo de 1,5 metros (60 polegadas) entre as bordas das mesas. Isto garante 45 cm para o recuo das cadeiras de cada lado e um corredor central de 60 cm para a circulação confortável dos empregados de mesa e convidados.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
