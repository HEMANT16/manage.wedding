---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Estimador de Custos de Arranjos do Vestido de Noiva",
      "url": "https://manage.wedding/pt/dress-alterations-estimator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de custos de arranjos para vestidos de noiva. Calcule preços exatos para bainhas, ajuste de corpete, sistema de apanhar a cauda, copas de soutien, mangas e taxas de urgência. Exporte para Word, PDF ou Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanto custam em média os arranjos de um vestido de noiva?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O custo médio dos arranjos de costura para um vestido de noiva varia entre 250 € e 650 € para trabalhos habituais (fazer a bainha, apertar o corpete nas laterais e colocar um sistema de recolha de cauda de 3 pontos). Vestidos complexos com múltiplas camadas de tule, aplicações de renda bordada à mão ou prazos de urgência podem atingir entre 700 € e 1.200 €."
          }
        },
        {
          "@type": "Question",
          "name": "Por que razão fazer a bainha de um vestido com renda é tão dispendioso?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se a saia tiver um acabamento recortado em renda ou fita de crina na extremidade, a costureira não pode simplesmente cortar o tecido a direito. É necessário descoser cuidadosamente todas as aplicações de renda à mão, fazer a bainha no tecido interior e forros de tule, e voltar a coser a renda à mão milímetro a milímetro no novo comprimento."
          }
        },
        {
          "@type": "Question",
          "name": "Quando devem ser marcadas as provas do vestido de noiva?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O ideal é planear 3 provas de atelier: 1) Primeira Prova: 8 a 10 semanas antes do casamento (marcação da bainha, alfinetagem do corpete e definição da cauda); 2) Segunda Prova: 4 a 5 semanas antes (verificação dos pontos cosidos e ajustes finos); 3) Prova Final e Levantamento: 10 a 14 dias antes do casamento (último teste de tamanho e engomagem profissional a vapor)."
          }
        },
        {
          "@type": "Question",
          "name": "O que é obrigatório levar para a primeira prova com a costureira?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Deve OBRIGATORIAMENTE levar os sapatos oficiais com a altura de salto exata que vai usar no dia (para definir a distância da bainha ao chão) e a lingerie, cinta modeladora ou soutien que planeia utilizar (para que o corpete seja ajustado com rigor milimétrico)."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular os Custos e Planear as Provas do Vestido de Noiva",
      "description": "Guia passo a passo para calcular despesas de arranjos de atelier, agendar as 3 provas e orçamentar bainhas, corpete e recolha da cauda.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Avalie a Construção da Saia e Tecidos",
          "text": "Identifique a complexidade da bainha (bordo simples, fita de crina ou renda recortada) e conte o número de camadas de forro e tule."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Defina os Ajustes de Corpete e Sistema de Cauda",
          "text": "Verifique se precisa de apertar laterais, encurtar alças, embutir copas de soutien e selecione o tipo de recolha de cauda (1 ponto, 3 pontos francês ou baile real)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Agende as 3 Provas de Atelier com Antecedência",
          "text": "Marque a 1ª prova (8-10 semanas antes), 2ª prova (4-5 semanas antes) e o levantamento final (10-14 dias antes do casamento)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Leve os Sapatos e Lingerie Oficiais",
          "text": "Use sempre os sapatos de casamento e a roupa interior planeada em todas as provas para garantir o comprimento perfeito."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 5: Exporte a Ficha Técnica para a Costureira",
          "text": "Descarregue a proposta em Word (.doc) ou PDF para apresentar diretamente no atelier de costura."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Estimador de Custos de Arranjos do Vestido de Noiva (Preços & Provas) | Manage.Wedding"
	description="Calcule custos de costura para o vestido de noiva: bainhas, ajuste de corpete, copas de soutien, sistema de cauda e engomagem a vapor com exportação para Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Estimador de Arranjos do Vestido de Noiva
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Estime custos reais de costura para fazer bainhas, recolha da cauda (bustle), ajuste do corpete, copas de soutien e engomagem. Exporte a sua <strong>Ficha de Provas de Vestido</strong> para <strong>Word (.doc)</strong> ou <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Estimar os Arranjos em 3 Passos Simples
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Escolha o Estilo da Saia e Bainha
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Selecione o acabamento do bordo (liso, com fita de crina ou renda bordada) e indique o número de camadas de tule e forro.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Defina o Corpete e Sistema de Cauda
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Assinale os ajustes necessários nas costuras laterais, alças, copas de soutien e o tipo de presilha para recolher a cauda no baile.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporte a Ficha de Provas
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clique em <strong>"📝 Exportar Word (.doc)"</strong> ou <strong>"🖨️ Exportar PDF"</strong> para levar um mapa discriminado para a reunião com a costureira.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="alterations-calc-grid">
			
			<!-- Left Column: Itemized Tailoring Services -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div style="width: 100%;">
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							✂️ Serviços de Costura do Vestido
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Assinale os arranjos necessários para a sua silhueta
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Moeda:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="R$">R$ (BRL)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
							<option value="CHF">CHF</option>
						</select>
					</div>
				</div>

				<form id="alterations-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Hemming & Skirt Layers -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							1. Bainha e Construção da Saia
						</h3>
						<div style="display: flex; flex-direction: column; gap: 0.5rem;">
							<div>
								<label for="select-hem-type" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
									Estilo da Bainha & Complexidade do Bordo
								</label>
								<select id="select-hem-type" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.9rem;">
									<option value="0">Sem Necessidade de Bainha (0 €)</option>
									<option value="110" selected>Bainha Simples Lisa (Crepe, Cetim, Chiffon) (110 €)</option>
									<option value="160">Bainha com Crina / Fita Rígida de Volume (160 €)</option>
									<option value="250">Bordo em Renda Trabalhada (Descosida e recozida à mão) (250 €)</option>
								</select>
							</div>

							<div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-paper); padding: 0.5rem 0.75rem; border: 1px dashed var(--fg-pencil); border-radius: 4px;">
								<div>
									<label for="input-skirt-layers" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Camadas Interiores Adicionais (Tule/Forro)</label>
									<span style="font-size: 0.75rem; color: var(--text-secondary);">30 € por camada extra além do tecido exterior</span>
								</div>
								<div style="display: flex; align-items: center; gap: 0.3rem;">
									<input type="number" id="input-skirt-layers" value="2" min="0" max="10" style="width: 50px; padding: 0.3rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center; background: #fff;">
									<span style="font-size: 0.85rem;">camadas</span>
								</div>
							</div>
						</div>
					</div>

					<!-- 2. Bodice, Straps & Bra Structure -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-blue); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							2. Corpete, Alças & Ajustes ao Corpo
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-take-in-bodice" value="95" checked class="alt-checkbox">
								<span>Ajustar / Apertar Corpete (95 €)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-shorten-straps" value="40" checked class="alt-checkbox">
								<span>Encurtar Alças / Mangas (40 €)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-sew-in-cups" value="35" checked class="alt-checkbox">
								<span>Coser Copas de Soutien (35 €)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-reshape-neckline" value="110" class="alt-checkbox">
								<span>Alterar Decote / Costas (110 €)</span>
							</label>

							<label class="service-checkbox-label" style="grid-column: span 2;">
								<input type="checkbox" id="chk-corset-back" value="150" class="alt-checkbox">
								<span>Substituir Fecho por Costas em Espartilho com Laçada (150 €)</span>
							</label>
						</div>
					</div>

					<!-- 3. Bustle & Train Management -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: #16a34a; margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							3. Sistema de Recolha da Cauda (Bustle)
						</h3>
						<div>
							<label for="select-bustle-style" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
								Estilo de Presilha & Pontos de Fixação
							</label>
							<select id="select-bustle-style" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.9rem;">
								<option value="0">Sem Cauda / Cauda Curta (0 €)</option>
								<option value="60">Sistema Simples de 1 Ponto (Estilo Americano Exterior) (60 €)</option>
								<option value="110" selected>Sistema Francês de 3 a 5 Pontos com Fitas Interiores (110 €)</option>
								<option value="180">Sistema de Baile Real de 7 a 10+ Pontos Invisíveis (180 €)</option>
							</select>
						</div>
					</div>

					<!-- 4. Embellishments, Steaming & Rush Surcharge -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<label class="service-checkbox-label" style="background:#fff;">
								<input type="checkbox" id="chk-beading-repair" value="80" class="alt-checkbox">
								<span>Aplicação Manual de Renda/Pedraria (80 €)</span>
							</label>

							<label class="service-checkbox-label" style="background:#fff;">
								<input type="checkbox" id="chk-steaming-press" value="70" checked class="alt-checkbox">
								<span>Engomagem a Vapor Profissional (70 €)</span>
							</label>
						</div>

						<div style="margin-top: 0.25rem;">
							<label for="select-timeline-rush" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Prazo de Entrega & Taxa de Urgência
							</label>
							<select id="select-timeline-rush" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
								<option value="1.0" selected>Prazo Normal (8 a 12 semanas antes) (Sem Taxa Extra)</option>
								<option value="1.2">Prazo Expresso (4 a 6 semanas antes) (+20% de Taxa de Urgência)</option>
								<option value="1.45">Urgência de Emergência (Menos de 3 semanas) (+45% de Taxa)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Line-Item Invoice -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Alteration Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								👗 Orçamento de Arranjos de Costura
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Estimativa discriminada para as provas no atelier
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Estimated Range Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Custo Total Estimado de Costura</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">520 €</strong>
						<span id="res-range-subtext" style="font-size: 0.8rem; color: var(--accent-red);">Intervalo Típico: 458 € - 598 €</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Discriminação por Trabalho de Costura
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">✂️ Bainha da Saia & Camadas Extras:</td>
									<td id="res-hem-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">170,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🪡 Corpete, Alças e Copas de Soutien:</td>
									<td id="res-bodice-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">170,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">👗 Sistema de Recolha da Cauda:</td>
									<td id="res-bustle-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">110,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">✨ Pedraria & Engomagem a Vapor:</td>
									<td id="res-extras-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">70,00 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Taxa de Urgência de Prazo:</td>
									<td id="res-rush-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">0,00 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Cost Scale Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Económico (200 €)</span>
							<span>Médio (500 €)</span>
							<span style="color: var(--accent-red);">Couture (1.000 €+)</span>
						</div>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="cost-gauge-bar" style="width: 48%; height: 100%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Fitting Appointment Reminder Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						📌 Checklist para a Primeira Prova:
					</strong>
					<ul class="font-body" style="font-size: 0.85rem; line-height: 1.5; padding-left: 1.1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Sapatos de Noiva:</strong> Leve os sapatos oficiais para acertar o comprimento rente ao chão.</li>
						<li><strong>Lingerie & Cinta:</strong> Vista a roupa interior exata para definir a alfinetagem do busto e cintura.</li>
						<li><strong>Véu & Acessórios:</strong> Leve o véu para testar o caimento harmonioso com a cauda do vestido.</li>
					</ul>
				</div>

