<script is:inline>
	let currencySymbol = '€';

	const currencySelect = document.getElementById('currency-select');
	const hemSelect = document.getElementById('select-hem-type');
	const skirtLayersInput = document.getElementById('input-skirt-layers');

	const chkTakeIn = document.getElementById('chk-take-in-bodice');
	const chkStraps = document.getElementById('chk-shorten-straps');
	const chkCups = document.getElementById('chk-sew-in-cups');
	const chkNeckline = document.getElementById('chk-reshape-neckline');
	const chkCorset = document.getElementById('chk-corset-back');

	const bustleSelect = document.getElementById('select-bustle-style');
	const chkBeading = document.getElementById('chk-beading-repair');
	const chkSteaming = document.getElementById('chk-steaming-press');
	const rushSelect = document.getElementById('select-timeline-rush');

	// Result Elements
	const resGrandTotal = document.getElementById('res-grand-total');
	const resRangeSubtext = document.getElementById('res-range-subtext');
	const resHemTotal = document.getElementById('res-hem-total');
	const resBodiceTotal = document.getElementById('res-bodice-total');
	const resBustleTotal = document.getElementById('res-bustle-total');
	const resExtrasTotal = document.getElementById('res-extras-total');
	const resRushTotal = document.getElementById('res-rush-total');
	const costGaugeBar = document.getElementById('cost-gauge-bar');

	function formatMoney(amount) {
		const formatted = Math.round(amount).toLocaleString('pt-PT');
		if (currencySymbol === '€' || currencySymbol === 'CHF') {
			return `${formatted} ${currencySymbol}`;
		}
		return `${currencySymbol}${formatted}`;
	}

	function calculateAlterations() {
		currencySymbol = currencySelect.value;
		const rushMultiplier = parseFloat(rushSelect.value) || 1.0;

		// 1. Hemming
		const baseHem = parseFloat(hemSelect.value) || 0;
		const extraLayers = parseInt(skirtLayersInput.value) || 0;
		const layersCost = baseHem > 0 ? (extraLayers * 30) : 0;
		const hemSubtotal = baseHem + layersCost;

		// 2. Bodice
		let bodiceSubtotal = 0;
		if (chkTakeIn.checked) bodiceSubtotal += parseFloat(chkTakeIn.value);
		if (chkStraps.checked) bodiceSubtotal += parseFloat(chkStraps.value);
		if (chkCups.checked) bodiceSubtotal += parseFloat(chkCups.value);
		if (chkNeckline.checked) bodiceSubtotal += parseFloat(chkNeckline.value);
		if (chkCorset.checked) bodiceSubtotal += parseFloat(chkCorset.value);

		// 3. Bustle
		const bustleSubtotal = parseFloat(bustleSelect.value) || 0;

		// 4. Extras
		let extrasSubtotal = 0;
		if (chkBeading.checked) extrasSubtotal += parseFloat(chkBeading.value);
		if (chkSteaming.checked) extrasSubtotal += parseFloat(chkSteaming.value);

		// Pre-rush subtotal
		const preRushTotal = hemSubtotal + bodiceSubtotal + bustleSubtotal + extrasSubtotal;
		const finalTotal = preRushTotal * rushMultiplier;
		const rushFeeAmount = finalTotal - preRushTotal;

		// Update UI
		resGrandTotal.textContent = formatMoney(finalTotal);
		const lowRange = Math.round(finalTotal * 0.88);
		const highRange = Math.round(finalTotal * 1.15);
		resRangeSubtext.textContent = `Intervalo Típico: ${formatMoney(lowRange)} - ${formatMoney(highRange)}`;

		resHemTotal.textContent = formatMoney(hemSubtotal);
		resBodiceTotal.textContent = formatMoney(bodiceSubtotal);
		resBustleTotal.textContent = formatMoney(bustleSubtotal);
		resExtrasTotal.textContent = formatMoney(extrasSubtotal);
		resRushTotal.textContent = formatMoney(rushFeeAmount);

		// Gauge
		const gaugePct = Math.min(100, Math.max(10, Math.round((finalTotal / 1000) * 100)));
		costGaugeBar.style.width = `${gaugePct}%`;
	}

	// Listeners
	document.querySelectorAll('.alt-checkbox, #input-skirt-layers').forEach(el => {
		el.addEventListener('input', calculateAlterations);
		el.addEventListener('change', calculateAlterations);
	});
	[hemSelect, bustleSelect, rushSelect, currencySelect].forEach(el => {
		el.addEventListener('change', calculateAlterations);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let rows = '';
		if (parseFloat(hemSelect.value) > 0) {
			rows += `<tr><td>Bainha da Saia (${hemSelect.options[hemSelect.selectedIndex].text.split('(')[0]})</td><td style="text-align:right;">${resHemTotal.textContent}</td></tr>`;
		}
		if (chkTakeIn.checked) rows += `<tr><td>Ajustar / Apertar Costuras Laterais do Corpete</td><td style="text-align:right;">${formatMoney(chkTakeIn.value)}</td></tr>`;
		if (chkStraps.checked) rows += `<tr><td>Encurtar Alças / Mangas</td><td style="text-align:right;">${formatMoney(chkStraps.value)}</td></tr>`;
		if (chkCups.checked) rows += `<tr><td>Coser Copas Estruturadas de Soutien</td><td style="text-align:right;">${formatMoney(chkCups.value)}</td></tr>`;
		if (chkNeckline.checked) rows += `<tr><td>Redefinir Decote / Costas</td><td style="text-align:right;">${formatMoney(chkNeckline.value)}</td></tr>`;
		if (chkCorset.checked) rows += `<tr><td>Substituir Fecho por Costas em Espartilho com Laçada</td><td style="text-align:right;">${formatMoney(chkCorset.value)}</td></tr>`;
		if (parseFloat(bustleSelect.value) > 0) {
			rows += `<tr><td>Sistema de Recolha da Cauda (${bustleSelect.options[bustleSelect.selectedIndex].text.split('(')[0]})</td><td style="text-align:right;">${resBustleTotal.textContent}</td></tr>`;
		}
		if (chkBeading.checked) rows += `<tr><td>Aplicação Manual de Pedraria e Rendas</td><td style="text-align:right;">${formatMoney(chkBeading.value)}</td></tr>`;
		if (chkSteaming.checked) rows += `<tr><td>Engomagem a Vapor Profissional de Atelier</td><td style="text-align:right;">${formatMoney(chkSteaming.value)}</td></tr>`;
		if (parseFloat(rushSelect.value) > 1.0) {
			rows += `<tr><td>Taxa de Urgência de Prazo (${rushSelect.options[rushSelect.selectedIndex].text.split('(')[0]})</td><td style="text-align:right;">${resRushTotal.textContent}</td></tr>`;
		}

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Estimativa de Arranjos do Vestido de Noiva</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Estimativa Oficial de Arranjos de Atelier</h1>
				<p>Gerado a ${new Date().toLocaleDateString('pt-PT')} | Total Previsto: <strong>${resGrandTotal.textContent}</strong> (${resRangeSubtext.textContent})</p>
				
				<h3>Serviços de Costura Selecionados:</h3>
				<table>
					<thead>
						<tr><th>Descrição do Serviço</th><th style="text-align:right;">Preço Estimado</th></tr>
					</thead>
					<tbody>
						${rows}
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;"><td>Total Previsto de Arranjos</td><td style="text-align:right; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
					</tbody>
				</table>

				<h3 style="margin-top:20px;">Lembretes para a Prova de Vestido:</h3>
				<p>• Leve os sapatos oficiais de noiva para marcar a bainha exata.</p>
				<p>• Leve a lingerie modeladora e copas pretendidas.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Arranjos_Vestido_Noiva_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('pt-PT');
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-alteration-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Bainha da Saia & Camadas Extras</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resHemTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Corpete, Alças & Copas de Soutien</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBodiceTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Sistema de Recolha da Cauda</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBustleTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Pedraria & Engomagem a Vapor</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Taxa de Urgência de Prazo</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resRushTotal.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:14px;">Total Estimado de Costura</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:14px;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Servico de Costura,Custo Estimado\n";
		csv += `"Bainha da Saia e Camadas Extras","${resHemTotal.textContent}"\n`;
		csv += `"Corpete Alcas e Copas de Soutien","${resBodiceTotal.textContent}"\n`;
		csv += `"Sistema de Recolha da Cauda","${resBustleTotal.textContent}"\n`;
		csv += `"Pedraria e Engomagem a Vapor","${resExtrasTotal.textContent}"\n`;
		csv += `"Taxa de Urgencia de Prazo","${resRushTotal.textContent}"\n`;
		csv += `"Total Estimado de Costura","${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Arranjos_Vestido_Noiva_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateAlterations();
</script>
