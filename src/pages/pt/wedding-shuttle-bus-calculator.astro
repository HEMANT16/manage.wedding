---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calculadora de Vans e Ônibus para Casamento",
      "url": "https://manage.wedding/pt/wedding-shuttle-bus-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calcule a quantidade de ônibus, micro-ônibus ou vans para o transporte de convidados do casamento, horários de viagens e orçamento.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calculadora de Ônibus & Vans para Casamento — Frota e Custos"
	description="Calcule quantos ônibus ou micro-ônibus fretar para os convidados do casamento, rotas hotel-espaço, gorjeta do motorista e orçamento total."
	lang="pt"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/pt/" style="color: var(--text-secondary); text-decoration: none;">Início</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/pt/guests" style="color: var(--text-secondary); text-decoration: none;">Convidados e Logística</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Ônibus & Vans</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🚌</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Transporte de Convidados, Frota & Rotas</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calculadora de Ônibus & Vans para Casamento
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Calcule <strong>quantos ônibus ou vans você precisa fretar</strong>, capacidades (ônibus 46-50 lugares, micro-ônibus 28 lugares), tempo de rota e <strong>custos totais com motorista</strong>.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Inputs -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>👥</span> 1. Convidados e Adesão ao Transporte
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-total-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Total de Convidados:</label>
						<input type="number" id="input-total-guests" min="20" max="500" value="140" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="select-shuttle-rate" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">% que Usará a Van/Ônibus:</label>
						<select id="select-shuttle-rate" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="0.50">50% (Muitos vão de carro próprio)</option>
							<option value="0.65" selected>65% (Média comum em casamentos)</option>
							<option value="0.80">80% (Casamento em sítio/hotel)</option>
							<option value="0.95">95% (Local sem estacionamento)</option>
						</select>
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🛣️ 2. Trajeto e Tipo de Veículo
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label for="select-vehicle-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Tipo de Veículo:</label>
						<select id="select-vehicle-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="56-coach" selected>🚌 Ônibus Executivo (46–50 lugares)</option>
							<option value="28-minibus">🚐 Micro-ônibus (28 lugares)</option>
							<option value="14-sprinter">🚐 Van Executiva (15 lugares)</option>
						</select>
					</div>
					<div>
						<label for="input-drive-time" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Tempo de Viagem Somente Ida (min):</label>
						<input type="number" id="input-drive-time" min="5" max="60" value="15" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					⏰ 3. Diária de Horas & Retorno Antecipado
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="select-charter-hours" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Horas de Contrato Fretado:</label>
						<select id="select-charter-hours" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="5">5 Horas (Apenas ida e volta)</option>
							<option value="7" selected>7 Horas (Cerimônia até fim da festa)</option>
							<option value="9">9 Horas (Dia todo + After-Party)</option>
						</select>
					</div>
					<div>
						<label for="select-early-run" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Viagem Antecipada de Volta?</label>
						<select id="select-early-run" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="yes" selected>Sim (Para idosos e crianças)</option>
							<option value="no">Não (Todos retornam no final)</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Planejamento de Frota</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Frota Recomendada
						</h2>
					</div>
					<span id="badge-shuttle-riders" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">91 Passageiros</span>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Veículos Recomendados</span>
						<strong id="stat-vehicles-needed" style="font-size: 1.8rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">2 Ônibus</strong>
						<span id="stat-vehicles-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(Ônibus 46-50 lugares)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Valor Estimado</span>
						<strong id="stat-total-cost" style="font-size: 1.8rem; font-weight: 900; color: #1e40af; line-height: 1.1;">R$ 4.200</strong>
						<span id="stat-cost-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">Inclui diária e taxas dos motoristas</span>
					</div>
				</div>

				<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #166534; display: block; margin-bottom: 0.35rem;">⏱️ Horários de Viagem e Rota:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #14532d;">
						<div>• <strong id="stat-roundtrip-time">40 min</strong> Ida e Volta Completa</div>
						<div>• <strong id="stat-arrival-runs">1 Viagem por ônibus</strong> (Chegada junta)</div>
						<div>• <strong id="stat-early-departure">21h30</strong> Viagem Antecipada</div>
						<div>• <strong id="stat-final-departure">02h30</strong> Volta Fim de Festa</div>
					</div>
				</div>

				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🚍 Fretamento Base:</span>
						<strong id="stat-base-charter" style="color: var(--fg-pencil);">R$ 3.600 (7h diária)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">💵 Diária / Gorjeta Motorista:</span>
						<strong id="stat-driver-tip" style="color: #b91c1c;">R$ 600 (R$ 300 por motorista)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">👥 Custo por Convidado:</span>
						<strong id="stat-cost-per-head" style="color: #15803d;">~R$ 46,00 por passageiro</strong>
					</div>
				</div>

				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Imprimir Folha de Rota (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Exportar Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/pt/wedding-shuttle-bus-calculator" category="guests" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-shuttle-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Itinerário e Logística de Transporte para Casamento</h1>
				<p id="print-shuttle-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Planejamento de Ônibus & Vans | Manage.Wedding</p>
			</div>
			<div id="print-shuttle-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const inputTotalGuests = document.getElementById('input-total-guests');
	const selectShuttleRate = document.getElementById('select-shuttle-rate');
	const selectVehicleType = document.getElementById('select-vehicle-type');
	const inputDriveTime = document.getElementById('input-drive-time');
	const selectCharterHours = document.getElementById('select-charter-hours');
	const selectEarlyRun = document.getElementById('select-early-run');

	const badgeShuttleRiders = document.getElementById('badge-shuttle-riders');
	const statVehiclesNeeded = document.getElementById('stat-vehicles-needed');
	const statVehiclesSub = document.getElementById('stat-vehicles-sub');
	const statTotalCost = document.getElementById('stat-total-cost');
	const statCostSub = document.getElementById('stat-cost-sub');

	const statRoundtripTime = document.getElementById('stat-roundtrip-time');
	const statArrivalRuns = document.getElementById('stat-arrival-runs');
	const statEarlyDeparture = document.getElementById('stat-early-departure');
	const statFinalDeparture = document.getElementById('stat-final-departure');

	const statBaseCharter = document.getElementById('stat-base-charter');
	const statDriverTip = document.getElementById('stat-driver-tip');
	const statCostPerHead = document.getElementById('stat-cost-per-head');

	function calculateShuttle() {
		const totalGuests = Math.max(10, parseInt(inputTotalGuests.value, 10) || 140);
		const shuttleRate = parseFloat(selectShuttleRate.value) || 0.65;
		const riders = Math.round(totalGuests * shuttleRate);
		const driveTime = Math.max(5, parseInt(inputDriveTime.value, 10) || 15);
		const charterHours = parseInt(selectCharterHours.value, 10) || 7;
		const vehicleType = selectVehicleType.value;
		const hasEarly = selectEarlyRun.value === 'yes';

		badgeShuttleRiders.textContent = `${riders} Passageiros`;

		const roundtripMins = (driveTime * 2) + 10;
		statRoundtripTime.textContent = `${roundtripMins} min Ida e Volta`;

		let capacity = 46;
		let hourlyRate = 260;
		let vehicleLabel = 'Ônibus Executivo (46-50 lugares)';

		if (vehicleType === '56-coach') {
			capacity = 46;
			hourlyRate = 260;
			vehicleLabel = 'Ônibus Executivo (46-50 lugares)';
		} else if (vehicleType === '28-minibus') {
			capacity = 28;
			hourlyRate = 190;
			vehicleLabel = 'Micro-ônibus de 28 lugares';
		} else {
			capacity = 15;
			hourlyRate = 140;
			vehicleLabel = 'Van Executiva de 15 lugares';
		}

		let loopsPossible = 1;
		if (roundtripMins <= 35) loopsPossible = 2;

		const capacityPerVehicle = capacity * loopsPossible;
		const vehiclesNeeded = Math.max(1, Math.ceil(riders / capacityPerVehicle));

		statVehiclesNeeded.textContent = `${vehiclesNeeded} ${vehiclesNeeded > 1 ? 'Ônibus/Vans' : 'Ônibus'}`;
		statVehiclesSub.textContent = `(${vehicleLabel})`;

		if (loopsPossible === 1) {
			statArrivalRuns.textContent = '1 Viagem por ônibus (Chegada junta)';
		} else {
			statArrivalRuns.textContent = '2 Viagens escalonadas por van/ônibus';
		}

		statEarlyDeparture.textContent = hasEarly ? '21h30 Viagem Antecipada' : 'Sem volta antecipada';
		statFinalDeparture.textContent = '02h30 Volta Fim de Festa';

		const baseCost = vehiclesNeeded * charterHours * hourlyRate;
		const driverTip = Math.round(baseCost * 0.15);
		const totalCost = baseCost + driverTip;

		statBaseCharter.textContent = `R$ ${baseCost.toLocaleString()} (${charterHours}h @ R$ ${hourlyRate}/h/veículo)`;
		statDriverTip.textContent = `R$ ${driverTip.toLocaleString()} (R$ ${Math.round(driverTip / vehiclesNeeded)} por motorista)`;
		statTotalCost.textContent = `R$ ${totalCost.toLocaleString()}`;
		statCostSub.textContent = 'Inclui diária e taxas dos motoristas';
		statCostPerHead.textContent = `~R$ ${(totalCost / riders).toFixed(2)} por passageiro`;

		document.getElementById('print-shuttle-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Elemento de Transporte</th>
						<th style="padding:6pt;">Detalhes Logísticos</th>
						<th style="padding:6pt; text-align:right;">Planejamento</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Total Passageiros Transporte</td>
						<td style="padding:6pt;">${totalGuests} convidados x ${Math.round(shuttleRate * 100)}% de uso</td>
						<td style="padding:6pt; text-align:right;"><strong>${riders} Passageiros</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Frota Contratada</td>
						<td style="padding:6pt;">${vehicleLabel}</td>
						<td style="padding:6pt; text-align:right; font-weight:bold; color:#b91c1c;">${vehiclesNeeded} ${vehiclesNeeded > 1 ? 'Veículos' : 'Veículo'}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Tempo de Rota</td>
						<td style="padding:6pt;">${driveTime} min trajeto + 10 min embarque</td>
						<td style="padding:6pt; text-align:right;">${roundtripMins} min Ida e Volta</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Horários de Volta</td>
						<td style="padding:6pt;">${hasEarly ? 'Volta antecipada 21h30 & ' : ''}Fim de festa 02h30</td>
						<td style="padding:6pt; text-align:right;">${hasEarly ? '2 Viagens' : '1 Viagem'}</td>
					</tr>
					<tr style="background:#eff6ff; font-weight:bold; font-size:11pt; border-top:2pt solid #000;">
						<td style="padding:8pt;">VALOR TOTAL ESTIMADO</td>
						<td style="padding:8pt;">${charterHours} Horas de serviço (${vehiclesNeeded} motoristas)</td>
						<td style="padding:8pt; text-align:right; color:#1e40af;">R$ ${totalCost.toLocaleString()}</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	[inputTotalGuests, selectShuttleRate, selectVehicleType, inputDriveTime, selectCharterHours, selectEarlyRun].forEach(el => {
		el.addEventListener('input', calculateShuttle);
		el.addEventListener('change', calculateShuttle);
	});

	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateShuttle();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateShuttle();
		const fleet = statVehiclesNeeded.textContent;
		const cost = statTotalCost.textContent;
		const riders = badgeShuttleRiders.textContent;
		const guests = inputTotalGuests.value;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Transporte Casamento</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Itinerário e Logística de Transporte para Casamento</h1>
				<p><strong>Convidados:</strong> ${guests} | <strong>Passageiros:</strong> ${riders} | <strong>Frota:</strong> ${fleet} | <strong>Orçamento:</strong> ${cost}</p>
				<hr/>
				<p><em>Gerado por Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Transporte-Casamento-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateShuttle();
</script>
