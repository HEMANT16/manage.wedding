---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calculadora e Guia de Cabine de Fotos DIY para Casamento",
      "url": "https://manage.wedding/pt/wedding-photo-booth-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calculadora interativa e guia de montagem de cabine de fotos em PVC com botão arcade, software automatizado, tiras térmicas e álbum de assinaturas scrapbook.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calculadora de Cabine de Fotos DIY para Casamento — Planta Baixa, Filmes & Guia"
	description="Calcule pacotes de filme Instax/Polaroid, bobinas térmicas, lista de corte de tubos de PVC, botão arcade luminoso, medidas de espaço e livro de mensagens."
	lang="pt"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href=""" style="color: var(--text-secondary); text-decoration: none;">Início</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/pt/budget" style="color: var(--text-secondary); text-decoration: none;">Orçamento e Festa</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Cabine de Fotos DIY & Guia</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>📸</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Calculadora Interativa + Guia Completo de Construção DIY</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calculadora e Guia de Cabine de Fotos para Casamento
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 840px; margin: 0 auto; line-height: 1.5;">
				Calcule <strong>filmes instantâneos, bobinas de papel térmico, tubos de PVC, livro de mensagens</strong> e siga nosso passo a passo para construir uma cabine fotográfica automática por menos de R$ 950.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Interactive Controls -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<!-- Section 1: Hardware & Build Style -->
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>🛠️</span> 1. Estrutura e Formato de Foto
				</h2>

				<div style="margin-bottom: 1.25rem;">
					<label for="select-booth-architecture" style="display: block; font-size: 0.85rem; font-weight: 700; color: #334155; margin-bottom: 0.35rem;">Tipo de Cabine:</label>
					<select id="select-booth-architecture" style="width: 100%; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 6px; font-size: 0.88rem; background: #fff; font-weight: 600;">
						<option value="pvc-enclosed" selected>🎪 Cabine Fechada em PVC Portátil (Botão Arcade + Cortinas + Monitor Interno)</option>
						<option value="open-air-ipad">📱 Totem Aberto com iPad & Ring Light (Touchscreen + Canon Selphy)</option>
						<option value="dslr-studio">📷 Estúdio Aberto DSLR Reflex (Câmera Reflex + Flash Studio + Notebook)</option>
						<option value="instax-vintage">🎞️ Canto Vintage Instantâneo (Fujifilm Instax / Polaroid na Mesa)</option>
						<option value="pro-rental">🎩 Aluguel Profissional Tudo Incluso (Com Operador e Sublimação Rápida)</option>
					</select>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="select-media-format" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Formato de Foto:</label>
						<select id="select-media-format" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="canon-selphy" selected>🖨️ Tiras Canon Selphy 5x15 / 10x15</option>
							<option value="instax-mini">📷 Instax Mini (Cartão de Crédito)</option>
							<option value="instax-wide">📸 Instax WIDE (Panorâmico)</option>
							<option value="polaroid-itype">🎞️ Polaroid Quadrada (i-Type/600)</option>
							<option value="dnp-pro">⚡ Sublimação Pro DNP (700 fotos)</option>
							<option value="digital-only">📲 100% Digital (AirDrop/QR)</option>
						</select>
					</div>
					<div>
						<label for="input-booth-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Total de Convidados:</label>
						<input type="number" id="input-booth-guests" min="20" max="600" value="125" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700; font-size: 1rem;" />
					</div>
				</div>

				<!-- Section 2: Engagement & Guestbook Mode -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					📖 2. Adesão e Livro de Mensagens Scrapbook
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label for="select-participation-rate" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Taxa de Adesão:</label>
						<select id="select-participation-rate" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="0.60">Baixa / Intimista (60% dos convidados)</option>
							<option value="0.75" selected>Padrão (75% dos convidados)</option>
							<option value="0.90">Muito Animada / Balada Total (90%)</option>
						</select>
					</div>
					<div>
						<label for="select-guestbook-mode" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Livro com Fotos?</label>
						<select id="select-guestbook-mode" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="double" selected>Sim (Cópia dupla: 1 convidado + 1 álbum)</option>
							<option value="single">Não (Cópia única para o convidado levar)</option>
							<option value="triple">Grupos (1 cópia para cada pessoa na foto)</option>
						</select>
					</div>
				</div>

				<div style="margin-bottom: 1.25rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.2rem;">
						<label for="range-waste-buffer" style="font-size: 0.82rem; font-weight: 700; color: #334155;">Margem de Segurança (Testes / Fotos Tremidas):</label>
						<span id="label-waste-buffer" style="font-size: 0.82rem; font-weight: 700; color: #b91c1c;">+15% Margem</span>
					</div>
					<input type="range" id="range-waste-buffer" min="5" max="30" step="5" value="15" style="width: 100%; accent-color: var(--accent-red);" />
					<span style="font-size: 0.72rem; color: #64748b;">Cobre testes de ângulo, fotos tremidas e troca de cartuchos.</span>
				</div>

				<!-- Section 3: Trigger & Accessories -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🔘 3. Botão de Início e Acessórios
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label for="select-trigger-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Disparador de Início:</label>
						<select id="select-trigger-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="arcade-button" selected>🔴 Grande Botão Arcade Vermelho Iluminado (USB)</option>
							<option value="touchscreen">📱 Toque na Tela (iPad Kiosk)</option>
							<option value="foot-pedal">🦶 Pedal de Chão</option>
							<option value="camera-shutter">📸 Disparador Manual da Câmera</option>
						</select>
					</div>
					<div>
						<label for="select-props-tier" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Kit de Adereços / Placas:</label>
						<select id="select-props-tier" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="standard" selected>Kit Clássico (45 placas divertidas, óculos, chapéus)</option>
							<option value="deluxe">Kit Deluxe VIP (70 placas PVC rígidas, plumas, óculos LED)</option>
							<option value="minimal">Elegante / Minimalista (20 óculos escuros reais e lousinhas)</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Results & Supply Breakdown -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Lista de Materiais Calculada</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Materiais e Orçamento
						</h2>
					</div>
					<span id="badge-total-prints" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">215 Fotos</span>
				</div>

				<!-- Highlight Hero Cards -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Filme / Papel</span>
						<strong id="stat-film-packs" style="font-size: 1.65rem; font-weight: 900; color: #b91c1c; line-height: 1.15;">2 Caixas Papel</strong>
						<span id="stat-film-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 3px;">(216 tirinhas picotadas 10x15)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Custo Estimado</span>
						<strong id="stat-total-cost" style="font-size: 1.65rem; font-weight: 900; color: #1e40af; line-height: 1.15;">R$ 950 DIY</strong>
						<span id="stat-cost-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 3px;">(Economiza ~R$ 1.850 vs Aluguel)</span>
					</div>
				</div>

				<!-- Itemized Shopping Breakdown -->
				<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #166534; display: block; margin-bottom: 0.4rem;">📦 Lista Completa de Itens:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem; color: #14532d;">
						<div>• <strong id="stat-camera-spec">Câmera Reflex + Bateria Falsa CA</strong></div>
						<div>• <strong id="stat-trigger-spec">Botão Arcade Vermelho Iluminado USB</strong></div>
						<div>• <strong id="stat-frame-spec">Estrutura PVC (Cabe em bolsa de viagem)</strong></div>
						<div>• <strong id="stat-guestbook-spec">1 Álbum + 540 Fitas Dupla-Face</strong></div>
						<div>• <strong id="stat-pens-spec">6 Canetas Gel Metálicas</strong></div>
						<div>• <strong id="stat-props-spec">45 Placas e Adereços</strong></div>
					</div>
				</div>

				<!-- Venue Clearance & Power -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">📐 Espaço Necessário:</span>
						<strong id="stat-space-req" style="color: var(--fg-pencil);">1,8 x 1 m Cabine Fechada (ou 3x3 m Aberta)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">⚡ Tomada e Cabos:</span>
						<strong id="stat-power-req" style="color: var(--fg-pencil);">1 Tomada 110/220V + Fita Gaffer Preta</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">💻 Software de Cabine:</span>
						<strong id="stat-software-req" style="color: #1e40af;">DSLR Remote Pro / DSLRBooth / LumaBooth</strong>
					</div>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.65rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Imprimir Lista de Corte e Placa de Mesa (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.65rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Exportar Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Interactive Floor Plan & Space Clearance Diagram -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						📐 Planta Baixa Interativa e Espaço da Cabine
					</h2>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0.2rem 0 0;">
						Alterne entre a planta da <strong>Cabine Fechada em PVC</strong> e a do <strong>Estúdio Aberto com Backdrop</strong>.
					</p>
				</div>
				<div style="display: inline-flex; gap: 0.5rem;">
					<button type="button" id="btn-tab-pvc" class="hand-btn" style="background: var(--post-it); border: 2px solid var(--fg-pencil); padding: 4px 12px; border-radius: 4px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">
						🎪 Cabine Fechada em PVC (1,8 x 1 m)
					</button>
					<button type="button" id="btn-tab-openair" class="hand-btn" style="background: #fff; border: 2px solid var(--fg-pencil); padding: 4px 12px; border-radius: 4px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">
						📸 Estúdio Aberto (3 x 3 m)
					</button>
				</div>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; align-items: center;">
				
				<!-- SVG Diagram Container -->
				<div id="svg-diagram-container" style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; text-align: center;">
					
					<!-- Blueprint 1: Enclosed PVC Booth (Default) -->
					<svg id="svg-pvc-blueprint" viewBox="0 0 540 400" style="width: 100%; max-width: 500px; height: auto; display: block; margin: 0 auto;">
						<!-- Card Background -->
						<rect x="0" y="0" width="540" height="400" fill="#f8fafc" rx="8" />
						
						<!-- Top Dimension Header Badge -->
						<rect x="70" y="12" width="400" height="26" fill="#0f172a" rx="4" />
						<text x="270" y="29" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="0.5">🎪 CABINE DE PVC: 1,8 M ALTURA × 1 M LARGURA × 1,2 M PROFUNDIDADE</text>

						<!-- Outer Booth PVC Enclosure Frame -->
						<rect x="25" y="48" width="490" height="335" fill="#ffffff" stroke="#1e293b" stroke-width="2.5" rx="8" />

						<!-- COMPARTMENT 1: Electronics & Equipment Tower -->
						<rect x="38" y="60" width="464" height="150" fill="#f0fdf4" stroke="#16a34a" stroke-width="1.5" stroke-dasharray="4 4" rx="6" />
						
						<!-- Section Label Pill -->
						<rect x="48" y="68" width="220" height="20" fill="#dcfce7" stroke="#16a34a" stroke-width="1" rx="3" />
						<text x="56" y="82" font-size="10" font-weight="bold" fill="#15803d">⚙️ TORRE DE EQUIPAMENTOS (45 CM PROF.)</text>

						<!-- Big Red Arcade Start Button (Left) -->
						<g transform="translate(90, 130)">
							<circle cx="0" cy="0" r="22" fill="#fee2e2" stroke="#dc2626" stroke-width="1.5" />
							<circle cx="0" cy="0" r="16" fill="#ef4444" stroke="#991b1b" stroke-width="2" />
							<text x="0" y="4" font-size="9" font-weight="bold" fill="#ffffff" text-anchor="middle">APERTE</text>
							<text x="0" y="32" font-size="9" font-weight="bold" fill="#b91c1c" text-anchor="middle">Botão Arcade 10 cm</text>
							<text x="0" y="44" font-size="7.5" fill="#64748b" text-anchor="middle">(USB Barra Espaço)</text>
						</g>

						<!-- Center Display & Camera Bezel (Middle) -->
						<g transform="translate(270, 100)">
							<!-- Bezel Frame -->
							<rect x="-85" y="-5" width="170" height="68" fill="#0f172a" rx="4" />
							<!-- 17" Screen Glass -->
							<rect x="-78" y="2" width="156" height="54" fill="#1e293b" rx="2" />
							<text x="0" y="22" font-size="10" font-weight="bold" fill="#38bdf8" text-anchor="middle">Monitor 17" Vista ao Vivo</text>
							<text x="0" y="36" font-size="8" fill="#94a3b8" text-anchor="middle">(Moldura Porta-Retrato 30x40 cm)</text>
							<text x="0" y="48" font-size="7.5" fill="#cbd5e1" text-anchor="middle">Fluxo de 4 Telas Automáticas</text>
							
							<!-- DSLR Camera Mounted Above Screen -->
							<rect x="-35" y="70" width="70" height="22" fill="#dbeafe" stroke="#2563eb" stroke-width="1.5" rx="3" />
							<text x="0" y="84" font-size="8.5" font-weight="bold" fill="#1e40af" text-anchor="middle">📷 Câmera Reflex</text>
							<text x="0" y="102" font-size="7.5" font-weight="bold" fill="#dc2626" text-anchor="middle">⚡ Ligada na Tomada (Sem Bateria)</text>
						</g>

						<!-- External Screen for Crowd (Right) -->
						<g transform="translate(445, 130)">
							<rect x="-35" y="-20" width="70" height="42" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.5" rx="4" />
							<text x="0" y="-4" font-size="8.5" font-weight="bold" fill="#854d0e" text-anchor="middle">Tela Notebook</text>
							<text x="0" y="9" font-size="7.5" fill="#854d0e" text-anchor="middle">Para a Fila</text>
							<text x="0" y="32" font-size="8" font-weight="bold" fill="#ca8a04" text-anchor="middle">Visão da Fila</text>
							<text x="0" y="44" font-size="7.5" fill="#64748b" text-anchor="middle">(Poses hilárias!)</text>
						</g>

						<!-- COMPARTMENT 2: Guest Seating Area -->
						<rect x="38" y="220" width="464" height="115" fill="#fff1f2" stroke="#f43f5e" stroke-width="1.5" stroke-dasharray="4 4" rx="6" />
						
						<!-- Section Label Pill -->
