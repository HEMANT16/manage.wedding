<script is:inline>
	let currencySymbol = '€';

	// Tier Matrix Base Costs (para 2 pessoas em EUR)
	const tierRates = {
		tier1: {
			flightsBase: 1300,
			lodging: { boutique: 80, resort4: 150, luxury5: 290, overwater: 580 },
			dining: { budget: 45, moderate: 80, fine_dining: 140, michelin: 250 },
			excursions: { light: 25, moderate: 60, heavy: 140 }
		},
		tier2: {
			flightsBase: 1800,
			lodging: { boutique: 160, resort4: 300, luxury5: 580, overwater: 980 },
			dining: { budget: 80, moderate: 150, fine_dining: 240, michelin: 400 },
			excursions: { light: 45, moderate: 95, heavy: 210 }
		},
		tier3: {
			flightsBase: 2800,
			lodging: { boutique: 300, resort4: 580, luxury5: 1100, overwater: 1750 },
			dining: { budget: 120, moderate: 220, fine_dining: 380, michelin: 680 },
			excursions: { light: 80, moderate: 180, heavy: 400 }
		},
		tier4: {
			flightsBase: 3400,
			lodging: { boutique: 400, resort4: 750, luxury5: 1350, overwater: 2100 },
			dining: { budget: 140, moderate: 250, fine_dining: 400, michelin: 720 },
			excursions: { light: 100, moderate: 250, heavy: 550 }
		},
		domestic: {
			flightsBase: 350,
			lodging: { boutique: 120, resort4: 220, luxury5: 450, overwater: 750 },
			dining: { budget: 65, moderate: 120, fine_dining: 200, michelin: 360 },
			excursions: { light: 30, moderate: 75, heavy: 160 }
		}
	};

	const countryTierSelect = document.getElementById('select-country-tier');
	const tripDaysSlider = document.getElementById('input-trip-days');
	const tripDaysNum = document.getElementById('input-trip-days-num');
	const tripDaysDisplay = document.getElementById('trip-days-display');

	const flightClassSelect = document.getElementById('select-flight-class');
	const lodgingStyleSelect = document.getElementById('select-lodging-style');
	const diningStyleSelect = document.getElementById('select-dining-style');
	const excursionsStyleSelect = document.getElementById('select-excursions-style');

	const chkInsurance = document.getElementById('chk-travel-insurance');
	const chkBuffer = document.getElementById('chk-shopping-buffer');
	const currencySelect = document.getElementById('currency-select');

	// Result Elements
	const resGrandTotal = document.getElementById('res-grand-total');
	const resPerDayNote = document.getElementById('res-per-day-note');
	const resFlightTotal = document.getElementById('res-flight-total');
	const resHotelTotal = document.getElementById('res-hotel-total');
	const resFoodTotal = document.getElementById('res-food-total');
	const resExcursionsTotal = document.getElementById('res-excursions-total');
	const resExtrasTotal = document.getElementById('res-extras-total');
	const resNightsCount = document.getElementById('res-nights-count');

	const barFlights = document.getElementById('bar-flights');
	const barHotel = document.getElementById('bar-hotel');
	const barFood = document.getElementById('bar-food');
	const barExcursions = document.getElementById('bar-excursions');

	const pctFlights = document.getElementById('pct-flights');
	const pctHotel = document.getElementById('pct-hotel');
	const pctFood = document.getElementById('pct-food');
	const pctExcursions = document.getElementById('pct-excursions');

	function formatMoney(amount) {
		const formatted = Math.round(amount).toLocaleString('pt-PT');
		if (currencySymbol === '€' || currencySymbol === 'CHF') {
			return `${formatted} ${currencySymbol}`;
		}
		return `${currencySymbol}${formatted}`;
	}

	function calculateHoneymoon() {
		currencySymbol = currencySelect.value;
		const tierKey = countryTierSelect.value;
		const tier = tierRates[tierKey] || tierRates.tier2;

		const days = parseInt(tripDaysSlider.value) || 8;
		tripDaysNum.value = days;
		tripDaysDisplay.textContent = `${days} Dias / ${days} Noites`;
		resNightsCount.textContent = days;

		// 1. Flights
		let flightCost = tier.flightsBase;
		const flightClass = flightClassSelect.value;
		if (flightClass === 'premium') flightCost *= 1.4;
		else if (flightClass === 'business') flightCost *= 2.5;
		else if (flightClass === 'points') flightCost = 150; // Apenas taxas aeroportuárias

		// 2. Lodging
		const lodgingPerNight = tier.lodging[lodgingStyleSelect.value] || tier.lodging.resort4;
		const hotelCost = lodgingPerNight * days;

		// 3. Dining
		const diningPerDay = tier.dining[diningStyleSelect.value] || tier.dining.fine_dining;
		const foodCost = diningPerDay * days;

		// 4. Excursions
		const excursionsPerDay = tier.excursions[excursionsStyleSelect.value] || tier.excursions.moderate;
		const excursionsCost = excursionsPerDay * days;

		// 5. Extras
		let extrasCost = 0;
		if (chkInsurance.checked) extrasCost += 250;
		if (chkBuffer.checked) extrasCost += 300;

		const grandTotal = flightCost + hotelCost + foodCost + excursionsCost + extrasCost;
		const perDayCost = Math.round(grandTotal / days);

		// Update UI
		resGrandTotal.textContent = formatMoney(grandTotal);
		resPerDayNote.textContent = `Cerca de ${formatMoney(perDayCost)} / Dia para o Casal`;
		resFlightTotal.textContent = formatMoney(flightCost);
		resHotelTotal.textContent = formatMoney(hotelCost);
		resFoodTotal.textContent = formatMoney(foodCost);
		resExcursionsTotal.textContent = formatMoney(excursionsCost);
		resExtrasTotal.textContent = formatMoney(extrasCost);

		// Bar Chart
		if (grandTotal > 0) {
			const pF = Math.round((flightCost / grandTotal) * 100);
			const pH = Math.round((hotelCost / grandTotal) * 100);
			const pD = Math.round((foodCost / grandTotal) * 100);
			const pE = 100 - pF - pH - pD;

			barFlights.style.width = `${pF}%`;
			barHotel.style.width = `${pH}%`;
			barFood.style.width = `${pD}%`;
			barExcursions.style.width = `${Math.max(2, pE)}%`;

			pctFlights.textContent = `${pF}%`;
			pctHotel.textContent = `${pH}%`;
			pctFood.textContent = `${pD}%`;
			pctExcursions.textContent = `${Math.max(2, pE)}%`;
		}
	}

	// Listeners
	tripDaysSlider.addEventListener('input', () => {
		tripDaysNum.value = tripDaysSlider.value;
		calculateHoneymoon();
	});
	tripDaysNum.addEventListener('input', () => {
		tripDaysSlider.value = tripDaysNum.value;
		calculateHoneymoon();
	});

	[countryTierSelect, flightClassSelect, lodgingStyleSelect, diningStyleSelect, excursionsStyleSelect, chkInsurance, chkBuffer, currencySelect].forEach(el => {
		el.addEventListener('change', calculateHoneymoon);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Plano de Orçamento da Lua de Mel</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Plano Oficial de Orçamento da Lua de Mel</h1>
				<p>Gerado a ${new Date().toLocaleDateString('pt-PT')} | Destino: <strong>${countryTierSelect.options[countryTierSelect.selectedIndex].text.split('(')[0]}</strong> | Duração: <strong>${tripDaysSlider.value} Dias</strong> | Total Estimado: <strong>${resGrandTotal.textContent}</strong> (${resPerDayNote.textContent})</p>
				
				<h3>Discriminação das Despesas de Viagem:</h3>
				<table>
					<thead>
						<tr>
							<th>Categoria de Despesa</th>
							<th style="text-align:right;">Orçamento Estimado</th>
						</tr>
					</thead>
					<tbody>
						<tr><td>Voos de Ida e Volta para Dois (${flightClassSelect.options[flightClassSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resFlightTotal.textContent}</td></tr>
						<tr><td>Estadia em Resort (${tripDaysSlider.value} Noites @ ${lodgingStyleSelect.options[lodgingStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resHotelTotal.textContent}</td></tr>
						<tr><td>Alimentação e Jantares Românticos (${diningStyleSelect.options[diningStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resFoodTotal.textContent}</td></tr>
						<tr><td>Passeios e Atividades de Casal (${excursionsStyleSelect.options[excursionsStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resExcursionsTotal.textContent}</td></tr>
						<tr><td>Seguro de Viagem, Transfers e Fundo de Lembranças</td><td style="text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;">
							<td>Orçamento Total Necessário</td>
							<td style="text-align:right; color:#16a34a;">${resGrandTotal.textContent}</td>
						</tr>
					</tbody>
				</table>

				<h3 style="margin-top:25px;">Lembretes Importantes para a Viagem:</h3>
				<p>• Verifique a validade dos passaportes (devem ter pelo menos 6 meses de validade à data de regresso).</p>
				<p>• Notifique os bancos dos vossos cartões de crédito sobre a deslocação internacional.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Orcamento_Lua_de_Mel_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('pt-PT');
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-honeymoon-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Voos de Ida e Volta para Dois</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFlightTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Estadia em Resort (${tripDaysSlider.value} Noites)</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resHotelTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Alimentação e Jantares Românticos</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFoodTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Passeios, Spas e Atividades</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExcursionsTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Seguro, Transfers e Fundo de Lembranças</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Orçamento Total Estimado</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#16a34a;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Categoria da Viagem,Custo Estimado\n";
		csv += `"Voos de Ida e Volta (2 Passageiros)","${resFlightTotal.textContent}"\n`;
		csv += `"Alojamento em Resort (${tripDaysSlider.value} Noites)","${resHotelTotal.textContent}"\n`;
		csv += `"Alimentacao e Jantares Romanticos","${resFoodTotal.textContent}"\n`;
		csv += `"Passeios e Atividades","${resExcursionsTotal.textContent}"\n`;
		csv += `"Seguros e Fundo de Compras","${resExtrasTotal.textContent}"\n`;
		csv += `"Orcamento Total da Lua de Mel","${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Orcamento_Lua_de_Mel_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateHoneymoon();
</script>
