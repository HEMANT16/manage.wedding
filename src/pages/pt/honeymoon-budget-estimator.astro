---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Simulador de Orçamento para a Lua de Mel por Destino",
      "url": "https://manage.wedding/pt/honeymoon-budget-estimator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de orçamento para a lua de mel. Estime custos exatos para voos, resorts, bangalôs sobre a água, jantares românticos, passeios e seguro de viagem. Exporte para Word, PDF ou Excel.",
      "applicationCategory": "TravelApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Planear e Calcular o Orçamento da Lua de Mel",
      "description": "Guia passo a passo para calcular despesas de viagem de núpcias entre voos, alojamento, refeições e atividades com base nos escalões de destinos.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Selecione o Escalão do Destino",
          "text": "Escolha entre países tropicais económicos (Escalão 1), clássicos europeus/caraíbas (Escalão 2) ou grande luxo exclusivo (Escalão 3)."
        },
        {
          "@type": "HowToStep",
          "name": "Reserve 45% a 50% para Alojamento e Resorts",
          "text": "Aloque cerca de metade do orçamento para hotéis de charme, resorts de praia ou villas privadas."
        },
        {
          "@type": "HowToStep",
          "name": "Destine 25% a 30% para Voos e Transportes",
          "text": "Preveja os voos de ida e volta para dois passageiros, ferries, comboios e transfers de aeroporto."
        },
        {
          "@type": "HowToStep",
          "name": "Reserve 15% para Gastronomia e 10% para Experiências",
          "text": "Planeie jantares românticos à beira-mar, massagens a dois, passeios de barco e fundo de compras."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanto custa em média uma viagem de lua de mel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uma lua de mel de 8 a 10 dias custa em média entre 3.500 € e 7.500 € para o casal. Destinos tropicais como Bali ou Tailândia rondam entre 3.000 € e 5.000 €, viagens clássicas pela Europa ou Caraíbas ficam entre 5.000 € e 9.000 €, enquanto viagens de grande luxo nas Maldivas ou Polinésia Francesa variam entre 10.000 € e 22.000 €+."
          }
        },
        {
          "@type": "Question",
          "name": "Por que razão o escalão do país tem tanto impacto no orçamento da lua de mel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O poder de compra local varia drasticamente. Em países do Escalão 1 (Tailândia, Vietname, Bali), uma villa de 5 estrelas com piscina privada e jantares de autor custa uma fração (120 € - 220 €/dia) do que o mesmo padrão de luxo custaria em destinos do Escalão 3 como a Costa Amalfitana ou as Maldivas (600 € - 1.500 €/dia)."
          }
        },
        {
          "@type": "Question",
          "name": "Com que antecedência devem os noivos marcar a lua de mel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para voos internacionais de longo curso e resorts de luxo concorridos (especialmente em época alta), marque com 6 a 9 meses de antecedência para garantir as melhores tarifas aéreas e categorias de quartos. Para viagens de média distância ou pacotes tudo incluído, 4 a 6 meses são suficientes."
          }
        },
        {
          "@type": "Question",
          "name": "É possível financiar a lua de mel com a lista de casamento dos convidados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! A maioria dos casais modernos cria uma 'Lista de Casamento / Fundo de Lua de Mel' onde os convidados podem oferecer experiências específicas — como os voos, um cruzeiro de catamarã ao pôr do sol ou um jantar romântico. Isso pode cobrir entre 50% e 80% do custo total da viagem."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Simulador de Orçamento para a Lua de Mel (Por País & Exportação Word) | Manage.Wedding"
	description="Calcule despesas de lua de mel com base nos escalões de destinos. Estime voos, resorts, jantares românticos e passeios com exportação instantânea para Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Simulador de Orçamento para a Lua de Mel
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calcule despesas de viagem realistas com base no <strong>escalão de custo do destino</strong>, classe de voo, estilo de resort e duração da estadia. Exporte o vosso <strong>Plano de Viagem</strong> para <strong>Word (.doc)</strong> ou <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Planear o Orçamento da Viagem em 3 Passos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Escolha o Escalão do Destino
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Selecione o tipo de destino — desde paraísos tropicais económicos (Bali, Tailândia) a capitais europeias ou bangalôs de sonho sobre o mar (Maldivas, Bora Bora).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Personalize Alojamento e Refeições
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Ajuste a classe de voo, tipo de hotel (boutique, 5 estrelas ou villa privada), passeios diários e número de dias de viagem para os dois.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporte o Plano Orçamental
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clique em <strong>"📝 Exportar Word (.doc)"</strong> ou <strong>"🖨️ Exportar PDF"</strong> para guardar o resumo detalhado ou integrar os itens na vossa lista de casamento!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="honeymoon-calc-grid">
			
			<!-- Left Column: Travel Parameters Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							✈️ Parâmetros do Destino e Viagem
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Todos os cálculos incluem automaticamente os custos para duas pessoas
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Moeda:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="R$">R$ (BRL)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
							<option value="CHF">CHF</option>
						</select>
					</div>
				</div>

				<form id="honeymoon-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Destination Country Tier -->
					<div>
						<label for="select-country-tier" class="font-heading" style="display: block; font-size: 1rem; color: var(--accent-red); margin-bottom: 0.3rem;">
							1. Escalão do Destino & Índice de Custo *
						</label>
						<select id="select-country-tier" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="tier1">🌴 Escalão 1: Tropical & Cultural Económico (Bali, Tailândia, Vietname, México, Costa Rica)</option>
							<option value="tier2" selected>🏖️ Escalão 2: Clássico Médio & Resorts (Caraíbas, Itália, Espanha, Japão, Havai, Grécia)</option>
							<option value="tier3">💎 Escalão 3: Grande Luxo & Villas sobre o Mar (Maldivas, Bora Bora, Costa Amalfitana, Alpes)</option>
							<option value="tier4">🦁 Escalão 4: Destinos Exclusivos / Safaris (Safari Tanzânia/Quénia, Cruzeiro Galápagos)</option>
							<option value="domestic">🚗 Escalão 5: Destinos de Proximidade (Madeira, Açores, Douro, Costa Vicentina, Andaluzia)</option>
						</select>
					</div>

					<!-- 2. Trip Duration & Flight Class -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;">
						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-trip-days" class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
									Duração da Viagem (Dias / Noites)
								</label>
								<span id="trip-days-display" style="font-size: 0.95rem; font-weight: bold; color: var(--accent-blue);">8 Dias</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.5rem;">
								<input type="range" id="input-trip-days" min="3" max="28" value="8" step="1" style="flex: 1; accent-color: var(--accent-blue);">
								<input type="number" id="input-trip-days-num" value="8" min="3" max="28" style="width: 50px; padding: 0.3rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center; font-weight: bold;">
							</div>
						</div>

						<div>
							<label for="select-flight-class" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Voos para Dois (Ida e Volta)
							</label>
							<select id="select-flight-class" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
								<option value="economy" selected>Classe Económica</option>
								<option value="premium">Premium Economy (+40%)</option>
								<option value="business">Classe Executiva / Business (2.5x)</option>
								<option value="points">Milhas / Pontos de Cartão (Taxas de 150 €)</option>
							</select>
						</div>
					</div>

					<!-- 3. Resort & Lodging Standard -->
					<div>
						<label for="select-lodging-style" class="font-heading" style="display: block; font-size: 1rem; color: var(--accent-blue); margin-bottom: 0.3rem;">
							2. Estilo de Alojamento e Resort (Por Noite)
						</label>
						<select id="select-lodging-style" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="boutique">Hotel Boutique de Charme / Alojamento Local Premium</option>
							<option value="resort4" selected>Resort de 4 Estrelas em Frente à Praia / Hotel Histórico</option>
							<option value="luxury5">Resort de 5 Estrelas de Grande Luxo / Villa Privada com Piscina</option>
							<option value="overwater">Bangalô sobre a Água (Overwater) / Lodge de Safari Exclusivo</option>
						</select>
					</div>

					<!-- 4. Dining, Excursions & Extras -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<span class="font-heading" style="font-size: 0.95rem; color: #16a34a; display: block;">
							3. Refeições, Passeios e Extras (Para o Casal)
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">Estilo Gastronómico</span>
								<select id="select-dining-style" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="moderate">Misto de Cafés Típicos e Jantares Românticos</option>
									<option value="fine_dining" selected>Jantares Sofisticados & Cocktails ao Pôr do Sol</option>
									<option value="budget">Gastronomia Local e Mercados Tradicionais</option>
									<option value="michelin">Menus de Degustação Michelin & Jantares Privados</option>
								</select>
							</div>

							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">Passeios e Atividades Diárias</span>
								<select id="select-excursions-style" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="moderate" selected>Massagem de Casal, Catamarã e Visitas Guiadas</option>
									<option value="light">Dias de Praia Relaxantes e Passeios Livres</option>
									<option value="heavy">Aventuras Diárias (Mergulho, Helicóptero, Guia Privado)</option>
								</select>
							</div>
						</div>

						<div style="display: flex; gap: 1rem; flex-wrap: wrap; padding-top: 0.3rem;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-travel-insurance" checked style="accent-color: var(--fg-pencil);">
								<span>Incluir Seguro de Viagem e Transfers de Aeroporto (250 €)</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-shopping-buffer" checked style="accent-color: var(--fg-pencil);">
								<span>Fundo para Lembranças e Compras (300 €)</span>
							</label>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Cost Breakdown -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Honeymoon Total Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🏖️ Orçamento Estimado da Lua de Mel
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Previsão global com tudo incluído para duas pessoas
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Budget Total Highlight -->
					<div style="background: #f0fdf4; border: 2.5px solid #16a34a; border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: #16a34a; display: block; font-weight: bold;">Orçamento Total Estimado</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: #16a34a; display: block; line-height: 1.2;">6.700 €</strong>
						<span id="res-per-day-note" style="font-size: 0.8rem; color: #16a34a;">Cerca de 838 € / Dia para o Casal</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Resumo Discriminado das Despesas
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">✈️ Voos de Ida e Volta (2 Pessoas):</td>
									<td id="res-flight-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">2.000 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🏨 Estadia em Resort (<span id="res-nights-count">8</span> Noites):</td>
									<td id="res-hotel-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">2.800 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Gastronomia e Jantares Românticos:</td>
									<td id="res-food-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">1.360 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🏄 Passeios, Spas e Atividades:</td>
									<td id="res-excursions-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">880 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0;">🛡️ Seguro, Transfers & Fundo de Compras:</td>
									<td id="res-extras-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">550 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Travel Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span style="color: var(--accent-red);">Voos (<span id="pct-flights">26%</span>)</span>
							<span style="color: var(--accent-blue);">Resort (<span id="pct-hotel">38%</span>)</span>
							<span style="color: #16a34a;">Refeições (<span id="pct-food">18%</span>)</span>
							<span style="color: #7c3aed;">Atividades (<span id="pct-excursions">18%</span>)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-flights" style="width: 26%; background: var(--accent-red); transition: width 0.3s ease;"></div>
							<div id="bar-hotel" style="width: 38%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-food" style="width: 18%; background: #16a34a; transition: width 0.3s ease;"></div>
							<div id="bar-excursions" style="width: 18%; background: #7c3aed; transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Registry Cash Fund Tip Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						💡 Dica para a Lista de Casamento:
					</strong>
					<p class="font-body" style="font-size: 0.85rem; line-height: 1.5; margin: 0; color: var(--fg-pencil); text-align: center;">
