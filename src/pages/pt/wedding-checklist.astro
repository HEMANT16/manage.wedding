---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-checklist/#webapp",
      "name": "Checklist de Casamento & Gestor de Tarefas a 12 Meses",
      "url": "https://manage.wedding/pt/wedding-checklist",
      "inLanguage": "pt",
      "description": "Checklist interativa de casamento a 12 meses. Acompanhe os marcos de planeamento, guarde o progresso no navegador e garanta que nada fica esquecido.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quando se deve começar a usar a checklist de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O ideal é começar a usar a checklist de casamento 12 a 14 meses antes da data pretendida. Isto assegura tempo suficiente para reservar quintas e fornecedores de topo sem stresse."
          }
        },
        {
          "@type": "Question",
          "name": "Esta checklist guarda o meu progresso automaticamente?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! A ferramenta guarda todas as tarefas assinaladas na memória local do seu navegador (local storage). Ao regressar a esta página, o seu progresso estará exatamente onde o deixou."
          }
        },
        {
          "@type": "Question",
          "name": "Quais são os primeiros itens que devo reservar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As prioridades absolutas são definir o orçamento máximo, estimar a contagem aproximada de convidados e reservar a quinta/espaço. A disponibilidade do espaço dita frequentemente a data final do casamento."
          }
        },
        {
          "@type": "Question",
          "name": "Como gerir os pequenos detalhes sem me sentir sobrecarregado(a)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O nosso gestor divide o planeamento em 12 etapas mensais fáceis de cumprir. Concentre-se apenas nas tarefas do mês atual para evitar a ansiedade dos detalhes dos últimos meses."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Como Planear um Casamento com a Checklist de 12 Meses",
      "description": "Metodologia passo a passo para organizar todo o casamento desde o noivado até ao grande dia.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Fase 1 (12+ Meses): Orçamento, Lista de Convidados e Quinta",
          "text": "Defina o orçamento global, elabore a lista preliminar de convidados e reserve a quinta e o espaço da cerimónia."
        },
        {
          "@type": "HowToStep",
          "name": "Fase 2 (9–10 Meses): Fornecedores Principais e Vestido",
          "text": "Contrate o fotógrafo, videógrafo, catering, animação musical e inicie a procura do vestido de noiva."
        },
        {
          "@type": "HowToStep",
          "name": "Fase 3 (6–7 Meses): Save-the-Date e Flores",
          "text": "Envie os Save-the-Date, contrate o designer floral, encomende os vestidos das damas e marque a lua de mel."
        },
        {
          "@type": "HowToStep",
          "name": "Fase 4 (3–4 Meses): Convites, Bolo e Alianças",
          "text": "Encomende os convites formais, encomende o bolo de casamento, compre as alianças e faça a prova de maquilhagem."
        },
        {
          "@type": "HowToStep",
          "name": "Fase 5 (1–2 Meses): Confirmações (RSVP) e Registo Civil",
          "text": "Recolha as confirmações de presença, dê entrada do processo no Registo Civil/igreja e faça a prova final do vestido."
        },
        {
          "@type": "HowToStep",
          "name": "Fase 6 (Semana do Casamento e Dia D): Execução e Celebração",
          "text": "Finalize o mapa de mesas, prepare os envelopes para fornecedores, faça o ensaio e aproveite o grande dia!"
        }
      ]
    }
  ]
};

const tasks = [
  {
    month: "12+ Meses Antes",
    items: [
      "Definir o orçamento global do casamento",
      "Elaborar a lista aproximada de convidados",
      "Escolher a data do casamento (ou estação pretendida)",
      "Contratar Wedding Planner / Organizador(a) (opcional)",
      "Reservar a quinta / espaço da cerimónia e copo-d'água"
    ]
  },
  {
    month: "10-11 Meses Antes",
    items: [
      "Convidar os padrinhos, madrinhas e damas de honor",
      "Contratar a equipa de fotografia e vídeo",
      "Contactar o padre / celebrante / conservatória",
      "Iniciar a procura e prova de vestidos de noiva"
    ]
  },
  {
    month: "8-9 Meses Antes",
    items: [
      "Agendar degustação de ementas com a quinta/catering",
      "Contratar o DJ, banda ou animação musical",
      "Criar lista de casamento ou dados para prendas",
      "Reservar bloco de quartos de hotel para convidados de longe"
    ]
  },
  {
    month: "6-7 Meses Antes",
    items: [
      "Comprar o vestido de noiva e acessórios principais",
      "Contratar a decoração floral e florista",
      "Enviar os Save-the-Date aos convidados",
      "Planear e reservar as viagens da lua de mel",
      "Escolher e encomendar os vestidos das damas de honor"
    ]
  },
  {
    month: "4-5 Meses Antes",
    items: [
      "Reservar o local para o jantar de ensaio / boas-vindas",
      "Encomendar o bolo de noiva com o cake designer",
      "Comprar e gravar as alianças de casamento",
      "Contratar maquilhadora e cabeleireira de noiva",
      "Fechar a lista oficial com moradas e contactos"
    ]
  },
  {
    month: "3 Meses Antes",
    items: [
      "Encomendar os convites de casamento físicos e digitais",
      "Definir o menu final e seleção de vinhos e bar aberto",
      "Escolher ou alugar o fato do noivo e padrinhos",
      "Comprar as lembranças para os convidados"
    ]
  },
  {
    month: "2 Meses Antes",
    items: [
      "Enviar os convites formais de casamento",
      "Escrever os votos personalizados de casamento",
      "Comprar presentes especiais para pais e padrinhos",
      "Realizar a sessão de prova de maquilhagem e penteado"
    ]
  },
  {
    month: "1 Mês Antes",
    items: [
      "Tratar do processo legal no Registo Civil / Paróquia",
      "Fazer a prova final do vestido de noiva e fato",
      "Organizar o mapa de mesas (seating chart)",
      "Alinhar o cronograma final com todos os fornecedores"
    ]
  },
  {
    month: "2 Semanas Antes",
    items: [
      "Confirmar o número final de pessoas à quinta/catering",
      "Rever a lista de fotos essenciais com o fotógrafo",
      "Fazer corte de cabelo, coloração e tratamentos estéticos"
    ]
  },
  {
    month: "1 Semana Antes",
    items: [
      "Fazer as malas e documentos para a lua de mel",
      "Praticar os votos de casamento em voz alta",
      "Preparar envelopes identificados com pagamentos finais",
      "Fazer manicure, pedicure e massagem de relaxamento"
    ]
  },
  {
    month: "Na Véspera",
    items: [
      "Participar no ensaio da cerimónia",
      "Desfrutar do jantar de ensaio com a família próxima",
      "Descansar bem e ter uma noite de sono tranquila"
    ]
  },
  {
    month: "No Dia do Casamento",
    items: [
      "Tomar um pequeno-almoço reforçado e nutritivo",
      "Entregar as alianças ao padrinho de confiança",
      "Casar e viver o dia mais feliz da sua vida!"
    ]
  }
];
---

<Layout 
	title="Checklist de Casamento & Gestor de Tarefas a 12 Meses | Manage.Wedding"
	description="A nossa checklist completa de casamento a 12 meses ajuda a planear cada detalhe. Guarde o progresso no navegador e mantenha tudo organizado."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<header class="fade-in category-header" style="text-align: center;">
			<h1 class="font-heading" style="font-size: 3.5rem; margin-bottom: 0.5rem; font-weight: 500;">Checklist de <span class="accent-italic">Casamento</span></h1>
			<p class="font-body" style="color: var(--secondary-ink); max-width: 600px; margin: 0 auto;">Acompanhe todas as etapas com o nosso gestor de tarefas a 12 meses por categorias.</p>
		</header>

		<div class="home-grid fade-in" style="animation-delay: 0.2s; max-width: 900px; margin: 0 auto;">
            
			<div class="hand-card result-box" style="margin-bottom: 2rem;">
				<h3 class="font-heading" style="margin-bottom: 1rem; text-align: center;">Progresso Total do Casamento</h3>
				
                <div style="width: 100%; border: 2px solid var(--fg-pencil); height: 30px; position: relative; overflow: hidden; background: var(--bg-paper);">
                    <div id="progress-bar-fill" style="width: 0%; height: 100%; background-color: var(--fg-pencil); transition: width 0.3s ease;"></div>
                    <div id="progress-text" class="font-heading" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--bg-paper); mix-blend-mode: difference;">0%</div>
                </div>
			</div>

			<div class="hand-card">
				<form id="checklist-form">
                    {tasks.map((category, catIndex) => (
                        <div class="checklist-category" style="margin-bottom: 2rem;">
                            <h3 class="font-heading" style="margin-bottom: 1rem; border-bottom: 1px dashed var(--fg-pencil); padding-bottom: 0.5rem;">{category.month}</h3>
                            {category.items.map((item, itemIndex) => (
                                <label style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; cursor: pointer; font-family: var(--font-body);">
                                    <input 
                                        type="checkbox" 
                                        class="task-checkbox" 
                                        data-id={`task-${catIndex}-${itemIndex}`}
                                        style="width: 1.2rem; height: 1.2rem; accent-color: var(--fg-pencil); cursor: pointer;"
                                    />
                                    <span>{item}</span>
                                </label>
                            ))}
                        </div>
                    ))}
				</form>
			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="max-width: 900px; margin: 0 auto 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Resumo Rápido (BLUF)</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Fases Principais da Contagem Decrescente a 12 Meses
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>A Fórmula de 1 Minuto:</strong> Divida a jornada do casamento em <strong>6 fases distintas</strong>: <strong>12+ Meses</strong> (Quinta, Orçamento e Convidados), <strong>9–10 Meses</strong> (Fornecedores Chave e Vestido), <strong>6–7 Meses</strong> (Save-the-Date e Flores), <strong>3–4 Meses</strong> (Convites e Alianças), <strong>1–2 Meses</strong> (Registo Civil e Confirmações) e <strong>Dia D</strong> (Execução e Celebração).
			</p>
			
			<!-- Benchmark Milestone Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Fase de Planeamento</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Janela Temporal</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Tarefas Inegociáveis</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Risco se Atrasar</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">1. Fundação</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">12+ Meses Antes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Definir orçamento, lista inicial, reservar quinta</td>
							<td style="padding: 0.6rem 0.8rem; color: var(--accent-red); font-weight: 600;">Sábados de verão esgotam com 12-18 meses</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">2. Fornecedores Chave</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">9–10 Meses Antes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Foto/vídeo, catering, DJ/banda, prova do vestido</td>
							<td style="padding: 0.6rem 0.8rem;">Vestidos de noiva demoram 6 a 9 meses a confecionar</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">3. Envolvimento</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">6–7 Meses Antes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Enviar Save-the-Date, hotéis, vestidos das damas</td>
							<td style="padding: 0.6rem 0.8rem;">Convidados marcam outras férias ou hotéis encarecem</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">4. Logística e Detalhes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">3–4 Meses Antes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Encomendar convites, bolo, alianças, prova make-up</td>
							<td style="padding: 0.6rem 0.8rem;">Taxas de urgência em tipografias e joalharias</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">5. Reta Final</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">1–2 Meses Antes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Enviar convites (8 sem), Registo Civil, provas finais</td>
							<td style="padding: 0.6rem 0.8rem;">Caducidade de prazos legais / fecho de ementas</td>
						</tr>
						<tr>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">6. O Grande Dia</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Últimas 1–2 Semanas</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Mapa de mesas, envelopes de gorjetas, ensaio</td>
							<td style="padding: 0.6rem 0.8rem; color: #16a34a; font-weight: 600;">Execução serena e memórias inesquecíveis</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

        <article class="hand-card" style="max-width: 900px; margin: 3rem auto;">
            <h2 class="font-heading" style="font-size: 2.5rem; margin-bottom: 1.5rem;">A Checklist Definitiva de Casamento a 12 Meses</h2>
            
            <p class="font-body" style="margin-bottom: 1.5rem; line-height: 1.6;">Organizar um casamento pode parecer uma tarefa gigante, mas não tem de ser motivo de stresse. Dividir todo o processo em tarefas mensais fáceis e claras é o segredo para manter a serenidade. A nossa checklist interativa funciona como um gestor de projeto pessoal que guia o casal passo a passo. Quer faltem 12 meses ou apenas algumas semanas, este roteiro assegura que nada fica esquecido.</p>
            
            <img src="/images/clipboard_sketch.webp" alt="Checklist de Casamento — Gestor de Tarefas a 12 Meses" loading="lazy" decoding="async" style="width: 100%; max-width: 500px; margin: 2rem auto; display: block; border: 2px solid var(--fg-pencil);" />
            
            <h3 class="font-heading" style="font-size: 1.8rem; margin-bottom: 1rem;">Porquê Usar um Gestor de Tarefas Digital?</h3>
            <p class="font-body" style="margin-bottom: 1.5rem; line-height: 1.6;">Um caderno físico é bonito, mas uma ferramenta digital permite ver o progresso real a aumentar a cada clique. Conforme assinala itens como a reserva da quinta ou a escolha do fato, a barra de progresso dá-lhe a satisfação visual do dever cumprido. O seu navegador guarda tudo automaticamente na memória local.</p>
            
            <h3 class="font-heading" style="font-size: 1.8rem; margin-bottom: 1rem;">Marcos Essenciais a Não Perder</h3>
            <p class="font-body" style="margin-bottom: 1.5rem; line-height: 1.6;">Determinadas etapas têm prazos rigorosos. O espaço e os fornecedores mais procurados devem ser contratados o mais cedo possível. Mais tarde, a atenção vira-se para detalhes como provas de vestidos, alinhamento de horários e envio de convites.</p>

            <div style="margin-top: 3rem;">
                <h3 class="font-heading" style="font-size: 2rem; margin-bottom: 1.5rem;">Perguntas Frequentes</h3>
                
                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">Quando se deve começar a usar a checklist de casamento?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">O ideal é começar 12 a 14 meses antes da data pretendida para garantir a disponibilidade da quinta e fornecedores sem sobressaltos.</p>
                </details>
                
                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">Esta checklist guarda o meu progresso automaticamente?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">Sim! A ferramenta guarda todas as tarefas assinaladas na memória local do seu navegador (local storage).</p>
                </details>

                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">Quais são os primeiros itens que devo reservar?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">As prioridades absolutas são definir o orçamento máximo, estimar a contagem de convidados e reservar a quinta / espaço da cerimónia.</p>
                </details>
                
                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">Como gerir os pequenos detalhes?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">Concentre-se nas tarefas do mês em curso e vá avançando fase a fase para manter o planeamento leve e prazeroso.</p>
                </details>
            </div>
        </article>
	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const checkboxes = document.querySelectorAll('.task-checkbox');
		const progressBarFill = document.getElementById('progress-bar-fill');
        const progressText = document.getElementById('progress-text');
        
        const STORAGE_KEY = 'wedding_checklist_tasks_pt';

        // Load saved state
        const loadState = () => {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    checkboxes.forEach((cb) => {
                        if (parsed.includes(cb.dataset.id)) {
                            cb.checked = true;
                        }
                    });
                } catch(e) {
                    console.error("Error parsing saved checklist tasks", e);
                }
            }
            updateProgress();
        };

        // Save current state
        const saveState = () => {
            const checkedIds = Array.from(checkboxes)
                .filter(cb => cb.checked)
                .map(cb => cb.dataset.id);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(checkedIds));
        };

        // Update progress bar
        const updateProgress = () => {
            const total = checkboxes.length;
            const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
            
            if (total === 0) return;

            const percentage = Math.round((checkedCount / total) * 100);
            
            if(progressBarFill) {
                progressBarFill.style.width = `${percentage}%`;
            }
            if(progressText) {
                progressText.textContent = `${percentage}%`;
            }
        };

        // Event listeners
        checkboxes.forEach(cb => {
            cb.addEventListener('change', () => {
                saveState();
                updateProgress();
            });
        });

        loadState();
	});
</script>
