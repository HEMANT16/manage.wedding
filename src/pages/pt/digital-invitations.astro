---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/digital-invitations/#webapp",
      "name": "Gerador de Convites de Casamento Digitais & E-Invites",
      "url": "https://manage.wedding/pt/digital-invitations",
      "inLanguage": "pt",
      "description": "Gerador gratuito de convites digitais de casamento. Crie convites eletrónicos personalizados para toda a lista de convidados com mensagens adaptadas para WhatsApp/SMS, imagens PNG em alta resolução e exportação em Word e PDF.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Criar, Enviar e Gerir Convites de Casamento Digitais",
      "description": "Processo passo a passo para desenhar convites digitais personalizados, escrever mensagens para WhatsApp/SMS e controlar confirmações.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Introduza os Dados do Casamento e Local",
          "text": "Indique os nomes dos noivos, data, hora, local da cerimónia/quinta, dress code, prazo de confirmação de RSVP e link do site."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Escolha o Tema Visual do Convite",
          "text": "Selecione o estilo da moldura artística, como Tinta Clássica, Floral Botânico ou Arco Romântico."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Sincronize a Lista de Convidados",
          "text": "Ligue a base de dados de convidados para gerar automaticamente cartões personalizados com o nome de cada convidado ou família."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Descarregue PNGs e Exporte Mensagens para WhatsApp",
          "text": "Descarregue imagens em alta definição, imprima folhas PDF ou exporte o ficheiro Word com as mensagens de texto prontas a enviar."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Os convites de casamento digitais são aceites na etiqueta moderna?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! Mais de 65% dos noivos utilizam hoje convites digitais ou formatos híbridos. São ecológicos, poupam entre 800€ e 2.500€ em papel, caligrafia e selos de correio, e permitem respostas de RSVP instantâneas com 1 clique."
          }
        },
        {
          "@type": "Question",
          "name": "Quando devem ser enviados os convites de casamento digitais?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os convites digitais devem ser enviados 6 a 8 semanas antes do casamento local (e 10 a 14 semanas antes para casamentos com viagem). Como não há atrasos dos correios, os convidados recebem o convite no próprio dia."
          }
        },
        {
          "@type": "Question",
          "name": "Como enviar os convites digitais por WhatsApp aos convidados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Descarregue a imagem PNG personalizada e anexe-a à mensagem de WhatsApp gerada pela ferramenta com o link de confirmação e detalhes do dress code."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Gerador de Convites de Casamento Digitais | Manage.Wedding"
	description="Crie e exporte convites de casamento digitais personalizados para a sua lista de convidados. Inclui mensagens para WhatsApp e SMS, descarregamento de imagens PNG e exportação Word e PDF."
	schema={schema}
>
	<!-- Include html2canvas for instant image capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Convites Digitais" category="stationery" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Gerador de Convites Digitais
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Gere convites digitais de casamento personalizados e em alta resolução para todos os seus convidados. Exporte cartões em <strong>PNG</strong>, folhas <strong>PDF Imprimíveis</strong> ou ficheiros <strong>Word (.doc)</strong> com mensagens personalizadas prontas a enviar por WhatsApp ou SMS.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Criar Convites Digitais em 3 Passos Simples
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Detalhes do Casamento & Tema
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Introduza os nomes dos noivos, data, local da quinta, dress code, prazo de confirmação de RSVP e escolha a moldura visual.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Sincronize Nomes de Convidados
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						A sua lista de convidados guardada conecta-se automaticamente, ou clique em <strong>"✨ Carregar Exemplos"</strong> para testar!
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Descarregue Imagens e Textos
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Descarregue imagens PNG nítidas, gere o PDF para impressão ou exporte para Word com as mensagens de WhatsApp já escritas!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Controls + Live Preview & Generated Roster -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="invitations-calc-grid">
			
			<!-- Left Column: Wedding Details Form & Guest Sync -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💌 Detalhes do Convite & Tema
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Personalize textos e estilo visual do seu convite eletrónico
					</span>
				</div>

				<form id="invite-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Theme Style Selector -->
					<div>
						<label for="select-card-theme" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-red); margin-bottom: 0.25rem;">
							Tema Visual do Convite
						</label>
						<select id="select-card-theme" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="classic" selected>✒️ Tinta Clássica & Caligrafia (Elegante Minimalista)</option>
							<option value="botanical">🌿 Floral Botânico & Folhas de Oliveira</option>
							<option value="romantic">🏛️ Arco Romântico & Papel Quente</option>
							<option value="modern">✨ Luxo Moderno Moldura Black-Tie</option>
						</select>
					</div>

					<!-- Couple's Names -->
					<div>
						<label for="input-couples-names" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Nomes dos Noivos *
						</label>
						<input type="text" id="input-couples-names" value="Sara & Gonçalo" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-heading); font-size: 1.1rem; background: #fff;">
					</div>

					<!-- Wedding Date & Time -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="input-wedding-date" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Data & Hora *
							</label>
							<input type="text" id="input-wedding-date" value="Sábado, 17 de Outubro de 2026 às 16:30" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
						</div>
						<div>
							<label for="input-rsvp-deadline" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Prazo de RSVP
							</label>
							<input type="text" id="input-rsvp-deadline" value="15 de Setembro de 2026" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
						</div>
					</div>

					<!-- Location & Dress Code -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.6rem;">
						<div>
							<label for="input-wedding-location" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Quinta / Local & Cidade *
							</label>
							<input type="text" id="input-wedding-location" value="Quinta da Serra, Sintra" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
						</div>
						<div>
							<label for="input-dress-code" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Código de Vestuário
							</label>
							<select id="input-dress-code" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.85rem;">
								<option value="Fato Escuro / Gala" selected>Fato Escuro / Gala</option>
								<option value="Cocktail">Cocktail</option>
								<option value="Casual Chic">Casual Chic</option>
								<option value="Semi-Formal">Semi-Formal</option>
								<option value="Livre">Livre / Descontraído</option>
							</select>
						</div>
					</div>

					<!-- RSVP Website & Short Message -->
					<div>
						<label for="input-rsvp-link" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Link do Site de Casamento / Confirmação
						</label>
						<input type="text" id="input-rsvp-link" value="https://manage.wedding/pt/rsvp" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
					</div>

					<div>
						<label for="input-wedding-message" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Mensagem dos Noivos / Nota
						</label>
						<textarea id="input-wedding-message" rows="2" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff; resize: vertical;">Copo-d'água, animação e festa logo a seguir à cerimónia!</textarea>
					</div>

					<!-- Guest Personalization Toggle & Management Toolbar -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.6rem;">
						
						<!-- Personalization Mode Toggle -->
						<div style="display: flex; justify-content: space-between; align-items: center; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem 0.75rem;">
							<div>
								<strong class="font-heading" style="font-size: 0.92rem; color: var(--fg-pencil); display: block;">
									Personalizar com o Nome do Convidado
								</strong>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">
									Desmarque para gerar um convite universal para grupos de WhatsApp
								</span>
							</div>
							<label style="display: flex; align-items: center; cursor: pointer;">
								<input type="checkbox" id="chk-include-guest-name" checked style="width: 20px; height: 20px; accent-color: var(--accent-blue); cursor: pointer;">
							</label>
						</div>

						<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
							<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
								👥 Lista de Convites: <strong id="guest-count-badge">0 Convidados</strong>
							</span>
							<div style="display: flex; gap: 0.3rem;">
								<button type="button" id="btn-load-sample-guests" class="hand-btn" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; background: #eff6ff;">
									✨ Carregar Exemplos
								</button>
								<button type="button" id="btn-clear-all-guests" class="hand-btn secondary" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; color: #b91c1c;">
									🗑️ Limpar Tudo
								</button>
							</div>
						</div>

						<div style="display: flex; gap: 0.4rem;">
							<input type="text" id="input-quick-add-guest" placeholder="Escreva o nome do convidado..." style="flex: 1; padding: 0.35rem 0.5rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<button type="button" id="btn-quick-add-guest" class="hand-btn" style="padding: 0.35rem 0.65rem; font-size: 0.85rem;">
								+ Adicionar
							</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Card Preview & Batch Generation Export Box -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Card Preview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖼️ Pré-visualização em Tempo Real
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Renderização instantânea do seu convite digital
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Mensagens Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- The Interactive Preview Canvas Card -->
					<div id="preview-invite-card" class="theme-classic" style="border: 2.5px solid var(--fg-pencil); border-radius: 6px; padding: 2rem 1.5rem; background: var(--bg-paper); text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.5rem;">
						
						<!-- Corner accents -->
						<div style="position: absolute; top: 6px; left: 6px; width: 16px; height: 16px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 6px; right: 6px; width: 16px; height: 16px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; left: 6px; width: 16px; height: 16px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; right: 6px; width: 16px; height: 16px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<p style="font-family: var(--font-body); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 2.5px; color: var(--accent-red); margin: 0 0 0.5rem 0; font-weight: bold;">
							TEMOS A HONRA DE CONVIDAR
						</p>

						<h3 id="prev-guest-name" class="font-heading" style="font-size: 1.4rem; color: var(--accent-blue); margin: 0 0 0.75rem 0;">
							Queridos Helena & Tiago,
						</h3>

						<p style="font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-secondary); margin: 0 0 0.4rem 0;">
							Juntamente com as suas famílias
						</p>

						<h2 id="prev-couples-names" class="font-heading" style="font-size: 2.4rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; line-height: 1.15;">
							Sara & Gonçalo
						</h2>

						<div style="width: 50px; height: 2px; background: var(--fg-pencil); margin: 0.6rem auto;"></div>

						<p id="prev-wedding-message" class="font-body" style="font-size: 0.95rem; font-style: italic; color: var(--fg-pencil); margin: 0.5rem 0 1rem 0; line-height: 1.4;">
							"Copo-d'água, animação e festa logo a seguir à cerimónia!"
						</p>

						<div style="border-top: 1.5px dashed var(--fg-pencil); border-bottom: 1.5px dashed var(--fg-pencil); padding: 0.75rem 0; margin: 1rem 0;">
							<p id="prev-wedding-date" class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.25rem 0; font-weight: bold;">
								Sábado, 17 de Outubro de 2026 às 16:30
							</p>
							<p id="prev-wedding-location" class="font-body" style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
								Quinta da Serra, Sintra
							</p>
						</div>

						<div style="display: flex; justify-content: space-around; font-size: 0.8rem; font-family: var(--font-body); color: var(--fg-pencil); margin-top: 0.75rem;">
							<span>👔 Dress Code: <strong id="prev-dress-code">Fato Escuro / Gala</strong></span>
							<span>📅 RSVP até: <strong id="prev-rsvp-deadline">15 Set 2026</strong></span>
						</div>

						<p id="prev-rsvp-link" style="font-family: var(--font-body); font-size: 0.78rem; color: var(--accent-blue); margin: 0.75rem 0 0 0; text-decoration: underline;">
							Confirmação & Lista de Casamento: https://manage.wedding/pt/rsvp
						</p>
					</div>

					<button type="button" id="btn-download-sample-png" class="hand-btn" style="width: 100%; text-align: center; font-size: 1rem; padding: 0.65rem; background: #f0fdf4;">
						📸 Descarregar Este Convite de Exemplo (PNG HD)
					</button>

				</div>

				<!-- Generated Guest Cards Stream Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 450px; overflow-y: auto;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						📥 Convites Digitais Gerados por Convidado
					</h3>
					<div id="invites-stream-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Convites de Casamento</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado em: <span id="print-date"></span> | Noivos: <span id="print-couple"></span></p>
			</div>
			<div id="print-invites-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
