			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Resumo Direto ao Assunto (BLUF)
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					Etiqueta de Convites Digitais
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Calendário de Envio Digital:</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Save-the-Date Digital = 6–8 Meses Antes</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Convite Oficial Digital = 6–8 Semanas Antes</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Lembrete de RSVP = 2 Semanas Antes do Prazo</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Etiqueta de Mensagem:</strong> Nunca envie apenas a imagem isolada. Acompanhe sempre o cartão com uma mensagem simpática que inclua o link direto para confirmação de presença (RSVP) e direções do local.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Comunicação Digital</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Momento Ideal de Envio</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Canal Principal</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Taxa Média de Abertura</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Boas Práticas de Etiqueta</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Save-the-Date Digital</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">6 a 8 Meses Antes</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">WhatsApp / SMS / Email</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">94% (Primeiras 48h)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Indicar cidade e link do site</td>
						</tr>
						<tr style="background: #faf8f3;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Convite Oficial Digital</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">6 a 8 Semanas Antes</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mensagem Direta + PNG HD</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">65% RSVP na 1.ª semana</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Enviar personalizado individualmente</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Lembrete de Confirmação</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">2 Semanas Antes do Prazo</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">WhatsApp amigável</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">+25% Respostas Imediatas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Lembrar escolhas de prato e menu</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- SEO Article & Comprehensive Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Manual de Convites Digitais</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					Guia Completo para Convites de Casamento Digitais
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					Vantagens ecológicas, poupança substancial de orçamento e modelos prontos a enviar por WhatsApp.
				</p>
			</div>

			<div style="margin-bottom: 2.5rem; text-align: center;">
				<img 
					src="/images/rsvp_envelopes.webp" 
					alt="Gerador de Convites de Casamento Digitais" 
					loading="lazy"
					decoding="async"
					style="width: 100%; max-height: 420px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); margin: 0 auto; display: block;"
				/>
				<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin-top: 0.5rem; font-style: italic;">
					Os convites digitais eliminam perdas nos correios e facilitam a recolha de respostas no telemóvel.
				</p>
			</div>

			<!-- Section 1: Ready-to-Send Text Message Templates -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. Modelos de Texto Prontos a Enviar por WhatsApp
				</h3>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin: 1.5rem 0;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.15rem; color: var(--accent-blue); margin-bottom: 0.4rem; text-align: center;">
							Mensagem Elegante & Formal
						</h4>
						<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; background: #fff; padding: 0.75rem; border: 1px solid var(--fg-pencil); border-radius: 4px;">
							"Querido(a) [Nome], a Sara e o Gonçalo têm a honra de o(a) convidar para o seu casamento no dia 17 de Outubro de 2026 na Quinta da Serra. Por favor consulte o convite em anexo e confirme a sua presença aqui: [Link]"
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.15rem; color: #16a34a; margin-bottom: 0.4rem; text-align: center;">
							Mensagem Próxima & Descontraída
						</h4>
						<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; background: #fff; padding: 0.75rem; border: 1px solid var(--fg-pencil); border-radius: 4px;">
							"Vamos dar o nó! 💍 Gostaríamos muito de contar com a tua presença no dia 17 de Outubro para celebrar connosco. Vê o teu convite acima e confirma se podes vir e a tua escolha de ementa aqui: [Link]"
						</p>
					</div>
				</div>
			</section>

			<!-- Section 2: Related Tools -->
			<section style="margin-bottom: 3rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.5rem;">
				<h3 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 1rem; text-align: center;">
					🔗 Ferramentas de Planeamento Integradas
				</h3>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
					<a href="/pt/guest-list-manager" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-blue); display: block;">Gestor de Convidados</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Faça a gestão de moradas, grupos e contactos.</span>
					</a>
					<a href="/pt/rsvp-tracker" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-red); display: block;">Controlo de RSVP</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Acompanhe respostas e opções de prato em tempo real.</span>
					</a>
					<a href="/pt/table-place-cards" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--fg-pencil); display: block;">Marcadores de Lugar</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Gere marcadores em tenda com ícones de menu.</span>
					</a>
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes
				</h3>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						Como descarregar todas as mensagens personalizadas para o Word?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Clique em <strong>"📝 Exportar Mensagens Word (.doc)"</strong> no topo da página. O gerador cria um ficheiro Word pronto a copiar e colar com os textos de WhatsApp adaptados ao nome de cada convidado.
					</p>
				</details>
			</section>

		</article>

	</main>
</Layout>

<style>
	.theme-classic {
		background: #faf8f5 !important;
	}
	.theme-botanical {
		background: #f4f8f3 !important;
		border-color: #2d5a27 !important;
	}
	.theme-romantic {
		background: #fdf5f2 !important;
		border-color: #9f4d36 !important;
	}
	.theme-modern {
		background: #ffffff !important;
		border-color: #000000 !important;
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 20px;
		}
	}
</style>

<script is:inline>
	let guestList = [];

	const couplesNamesInput = document.getElementById('input-couples-names');
	const weddingDateInput = document.getElementById('input-wedding-date');
	const weddingLocationInput = document.getElementById('input-wedding-location');
	const rsvpDeadlineInput = document.getElementById('input-rsvp-deadline');
	const dressCodeSelect = document.getElementById('input-dress-code');
	const rsvpLinkInput = document.getElementById('input-rsvp-link');
	const weddingMessageInput = document.getElementById('input-wedding-message');
	const cardThemeSelect = document.getElementById('select-card-theme');

	// Preview Elements
	const prevGuestName = document.getElementById('prev-guest-name');
	const prevCouplesNames = document.getElementById('prev-couples-names');
	const prevWeddingDate = document.getElementById('prev-wedding-date');
	const prevWeddingLocation = document.getElementById('prev-wedding-location');
	const prevWeddingMessage = document.getElementById('prev-wedding-message');
	const prevDressCode = document.getElementById('prev-dress-code');
	const prevRsvpDeadline = document.getElementById('prev-rsvp-deadline');
	const prevRsvpLink = document.getElementById('prev-rsvp-link');
	const previewCard = document.getElementById('preview-invite-card');

	const guestCountBadge = document.getElementById('guest-count-badge');
	const invitesStreamContainer = document.getElementById('invites-stream-container');

	const chkIncludeGuestName = document.getElementById('chk-include-guest-name');

	function loadGuests() {
		try {
			const saved = localStorage.getItem('manage_wedding_guests');
			if (saved) {
				guestList = JSON.parse(saved);
			}
		} catch (e) {
			guestList = [];
		}

		if (!guestList || guestList.length === 0) {
			guestList = [
				{ name: "Helena & Tiago Santos", group: "Família da Noiva" },
				{ name: "Mariana & David Martins", group: "Amigos do Noivo" },
				{ name: "Inês Henriques", group: "Colegas de Trabalho" },
				{ name: "Avó Luísa & Avô António", group: "VIPs" }
			];
		}
		renderAll();
	}

	function renderAll() {
		const names = couplesNamesInput.value || 'Sara & Gonçalo';
		const date = weddingDateInput.value || 'Sábado, 17 de Outubro de 2026 às 16:30';
		const location = weddingLocationInput.value || 'Quinta da Serra, Sintra';
		const rsvpDeadline = rsvpDeadlineInput.value || '15 de Setembro de 2026';
		const dressCode = dressCodeSelect.value || 'Fato Escuro / Gala';
		const rsvpLink = rsvpLinkInput.value || 'https://manage.wedding/pt/rsvp';
		const msg = weddingMessageInput.value || "Copo-d'água, animação e festa logo a seguir à cerimónia!";
		const theme = cardThemeSelect.value || 'classic';
		const isPersonalized = chkIncludeGuestName.checked;

		// Update Preview Card
		prevCouplesNames.textContent = names;
		prevWeddingDate.textContent = date;
		prevWeddingLocation.textContent = location;
		prevRsvpDeadline.textContent = rsvpDeadline;
		prevDressCode.textContent = dressCode;
		prevRsvpLink.textContent = `Confirmação & Lista: ${rsvpLink}`;
		prevWeddingMessage.textContent = msg ? `"${msg}"` : '';

		if (isPersonalized && guestList.length > 0) {
			prevGuestName.style.display = 'block';
			if (!prevGuestName.textContent.startsWith('Querido') && !prevGuestName.textContent.startsWith('Estimado')) {
				prevGuestName.textContent = `Queridos ${guestList[0].name},`;
			}
		} else {
			prevGuestName.style.display = 'none';
		}

		previewCard.className = `theme-${theme}`;

		// Guest Count
		guestCountBadge.textContent = `${guestList.length} Convites`;

		// Stream rendering
		invitesStreamContainer.innerHTML = '';
		if (guestList.length === 0) {
			invitesStreamContainer.innerHTML = `
				<div style="text-align: center; padding: 1rem; color: var(--text-secondary); font-style: italic; font-size: 0.9rem;">
					Nenhum convidado individual. O cartão está em <strong>Modo Universal</strong> (Ideal para grupos de WhatsApp ou redes sociais).
				</div>
			`;
		} else {
			guestList.forEach((guest, idx) => {
				const item = document.createElement('div');
				item.style.cssText = `display: flex; justify-content: space-between; align-items: center; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem 0.75rem;`;
				item.innerHTML = `
					<div>
						<strong class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">${guest.name}</strong>
						<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">${guest.group || 'Convidado'}</span>
					</div>
					<div style="display: flex; gap: 0.25rem;">
						<button type="button" class="btn-preview-guest hand-btn" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #eff6ff;" title="Ver Convite">
							👁️ Ver
						</button>
						<button type="button" class="btn-download-guest hand-btn" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #f0fdf4;" title="Descarregar PNG">
							📸 PNG
						</button>
						<button type="button" class="btn-delete-guest hand-btn secondary" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; color: #b91c1c;" title="Remover">
							🗑️ Del
						</button>
					</div>
				`;
				invitesStreamContainer.appendChild(item);
			});
		}

		// Attach Guest Listeners
		document.querySelectorAll('.btn-preview-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				if (guestList[idx]) {
					chkIncludeGuestName.checked = true;
					prevGuestName.style.display = 'block';
					prevGuestName.textContent = `Queridos ${guestList[idx].name},`;
				}
			});
		});

		document.querySelectorAll('.btn-download-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				if (guestList[idx]) {
					chkIncludeGuestName.checked = true;
					prevGuestName.style.display = 'block';
					prevGuestName.textContent = `Queridos ${guestList[idx].name},`;
					captureCardPNG(guestList[idx].name);
				}
			});
		});

		document.querySelectorAll('.btn-delete-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				guestList.splice(idx, 1);
				renderAll();
			});
		});
	}

	function captureCardPNG(filenamePrefix) {
		if (window.html2canvas) {
			window.html2canvas(previewCard, {
				scale: 3,
				backgroundColor: null,
				useCORS: true
			}).then(canvas => {
				const link = document.createElement('a');
				const safeName = (filenamePrefix || 'convite-casamento').replace(/[^a-z0-9]/gi, '_').toLowerCase();
				link.download = `Convite_${safeName}.png`;
				link.href = canvas.toDataURL("image/png");
				link.click();
			});
		} else {
			alert("A inicializar captura de imagem. Por favor tente novamente dentro de instantes.");
		}
	}

	// Quick Add Guest
	document.getElementById('btn-quick-add-guest').addEventListener('click', () => {
		const input = document.getElementById('input-quick-add-guest');
		const val = input.value.trim();
		if (val) {
			guestList.push({ name: val, group: 'Convidado Adicionado' });
			input.value = '';
			renderAll();
		}
	});

	// Clear All Guests
	document.getElementById('btn-clear-all-guests').addEventListener('click', () => {
		guestList = [];
		renderAll();
	});

	// Load Sample Guests
	document.getElementById('btn-load-sample-guests').addEventListener('click', () => {
		guestList = [
			{ name: "Helena & Tiago Santos", group: "Família da Noiva" },
			{ name: "Mariana & David Martins", group: "Amigos do Noivo" },
			{ name: "Inês Henriques & Acompanhante", group: "Colegas de Trabalho" },
			{ name: "Avó Luísa & Avô António", group: "VIPs" },
			{ name: "Tia Clara & Tio Manuel", group: "Família" }
		];
		chkIncludeGuestName.checked = true;
		renderAll();
	});

	// Inputs Listener
	[couplesNamesInput, weddingDateInput, weddingLocationInput, rsvpDeadlineInput, dressCodeSelect, rsvpLinkInput, weddingMessageInput, cardThemeSelect, chkIncludeGuestName].forEach(el => {
		el.addEventListener('input', renderAll);
		el.addEventListener('change', renderAll);
	});

	document.getElementById('btn-download-sample-png').addEventListener('click', () => {
		captureCardPNG('Convite_Exemplo');
	});

	// 📝 Export Word Messages (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let sections = '';
		guestList.forEach(guest => {
			sections += `
				<div style="margin-bottom: 25px; padding: 15px; border: 1px solid #ccc; background: #fafafa;">
					<h3 style="margin: 0 0 8px 0; color: #1e3a8a;">Mensagem de Convite para: ${guest.name}</h3>
					<p style="margin: 0; font-family: monospace; font-size: 13px; line-height: 1.5; color: #333;">
						"Querido(a) ${guest.name}, ${couplesNamesInput.value} têm a honra de o(a) convidar para o seu casamento no dia ${weddingDateInput.value} em ${weddingLocationInput.value}! Código de vestuário: ${dressCodeSelect.value}. Por favor consulte o convite digital em anexo e confirme a sua presença até ${rsvpDeadlineInput.value} através do link: ${rsvpLinkInput.value}"
					</p>
				</div>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Textos de Convites de Casamento</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Mensagens de Convite para WhatsApp & SMS</h1>
				<p>Gerado em ${new Date().toLocaleDateString('pt-PT')} | Noivos: <strong>${couplesNamesInput.value}</strong> | Total de Convites: <strong>${guestList.length}</strong></p>
				
				<h2>Textos Prontos a Enviar por WhatsApp / SMS:</h2>
				${sections}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Mensagens_Convites_Casamento_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print All
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('pt-PT');
		document.getElementById('print-couple').textContent = couplesNamesInput.value;

		const grid = document.getElementById('print-invites-grid');
		grid.innerHTML = '';

		guestList.forEach(guest => {
			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 20px; text-align: center; font-family: 'Times New Roman', serif; margin-bottom: 15px;`;
			card.innerHTML = `
				<p style="font-size: 10px; letter-spacing: 2px; text-transform: uppercase; margin: 0 0 5px 0;">Temos a honra de convidar</p>
				<h3 style="font-size: 18px; margin: 0 0 10px 0;">Queridos ${guest.name},</h3>
				<p style="font-size: 12px; margin: 0 0 5px 0;">Para celebrar o casamento de</p>
				<h2 style="font-size: 26px; margin: 0 0 10px 0;">${couplesNamesInput.value}</h2>
				<p style="font-size: 14px; font-weight: bold; margin: 10px 0 5px 0;">${weddingDateInput.value}</p>
				<p style="font-size: 12px; color: #444; margin: 0 0 10px 0;">${weddingLocationInput.value}</p>
				<p style="font-size: 11px; margin: 0;">Dress Code: ${dressCodeSelect.value} | RSVP: ${rsvpLinkInput.value}</p>
			`;
			grid.appendChild(card);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Nome do Convidado,Grupo,Link de RSVP,Estado\n";
		guestList.forEach(guest => {
			csv += `"${guest.name}","${guest.group || 'Geral'}","${rsvpLinkInput.value}","Convite Pronto"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Convites_Digitais_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	loadGuests();
</script>
