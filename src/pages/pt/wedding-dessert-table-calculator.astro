---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-dessert-table-calculator/#webapp",
      "name": "Calculadora de Mesa de Doces Finos, Sobremesas & Candy Bar de Casamento",
      "url": "https://manage.wedding/pt/wedding-dessert-table-calculator",
      "description": "Calculadora interativa gratuita para mesa de doces finos de casamento, brigadeiros gourmet, bem-casados e candy bar. Calcule doces por convidado, centos e dúzias para confeitaria, quilos de guloseimas e gere placas imprimíveis 8x10 'O Amor é Doce' e pedidos em PDF e Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular a Quantidade de Doces Finos, Sobremesas e Candy Bar para Casamento",
      "description": "Passo a passo para calcular o número de docinhos por pessoa, quilos de balas para candy bar, suportes de mesa e encomendas para confeitaria.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Escolha o formato da mesa de doces",
          "text": "Defina se os doces finos acompanham o bolo de casamento tradicional (5 a 7 doces por pessoa no padrão brasileiro / 2 a 3 sobremesas bite-size), substituem o bolo (8 a 10 doces por pessoa), mesa de bem-casados ou candy bar por peso (120g a 160g por pessoa)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Equilibre as variedades e centos da confeitaria",
          "text": "Selecione de 4 a 8 tipos de doces (brigadeiros gourmet, macarons, trufas, copinhos de mousse, tortinhas, bem-casados) e converta em dúzias e centos comerciais."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Dimensione potes de vidro, pás e embalagens",
          "text": "Calcule o peso total de guloseimas em kg, organize suportes e bombonieres em 3 níveis de altura e calcule as caixinhas de lembrança com 15% de margem."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Imprima placas decorativas e pedido da confeitaria",
          "text": "Gere placas para moldura (8x10 / 5x7), plaquinhas de identificação com alérgenos (Sem Glúten, Vegano) e baixe a planilha de encomenda em PDF e Word."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quantos doces finos por pessoa devem ser calculados para um casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Na tradição brasileira e portuguesa, quando há bolo de casamento servido com sobremesa, calculam-se de 5 a 7 doces finos por convidado (além de 2 bem-casados por pessoa para lembrancinha). Para sobremesas mini em formato buffet americano, calculam-se de 2 a 3 mini sobremesas por pessoa."
          }
        },
        {
          "@type": "Question",
          "name": "Quantas variedades de doces finos escolher para a mesa de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para 50–75 convidados, escolha de 3 a 4 tipos de doces. Para 75–125 convidados, de 4 a 5 tipos. Para 125–200 convidados, de 5 a 7 tipos. Para mais de 200 convidados, no máximo 6 a 8 variedades. Mais variedades causam filas e fazem os doces mais desejados acabarem nos primeiros minutos."
          }
        },
        {
          "@type": "Question",
          "name": "Quantos quilos de guloseimas são necessários para um Candy Bar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Calcula-se entre 120g e 160g de doces e balas por convidado. Para 100 convidados, isso representa cerca de 12 a 15 kg de guloseimas distribuídas em 6 a 8 potes e bombonieres de vidro de alturas variadas."
          }
        },
        {
          "@type": "Question",
          "name": "Quais doces derretem ou estragam em casamentos ao ar livre no calor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Doces com recheio de creme de leite e brigadeiros com muita manteiga amolecem acima de 25°C. Trufas de chocolate nobre sem temperagem adequada e copinhos de mousse devem ser refrigerados até 30 minutos antes de abrir a mesa. Macarons sofrem com umidade. Para casamentos no verão, aposte em bem-casados, camafeus de nozes, cookies crocantes e balas duras."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Mesa de Doces Finos, Sobremesas & Candy Bar (PDF Grátis) | Manage.Wedding"
	description="Calcule doces finos por pessoa, centos para confeitaria, quilos de balas para candy bar e potes de vidro. Placas 8x10 'O Amor é Doce', tags de alérgenos e pedidos em PDF e Word."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Mesa de Doces & Candy Bar" category="food-dining" />
		
		<!-- Hero Section -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🧁</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratuito • Cálculo Interativo • Placas & Pedido de Confeitaria em PDF</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de Mesa de Doces Finos & Candy Bar
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 760px; margin: 0 auto; text-align: center;">
					Calcule a quantidade exata de docinhos finos, brigadeiros gourmet, quilos de balas para candy bar e centos para sua confeiteira. Personalize sabores, crie <strong>Placas 8x10 Imprimíveis "O Amor é Doce"</strong>, tags de alérgenos e baixe seu <strong>Pedido para Confeitaria</strong> em PDF e Word!
				</p>
			</div>
		</section>

		<!-- Guia em 3 passos -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>✨</span> Como Planejar sua Mesa de Doces em 3 Passos Fáceis
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Escolha o Formato
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Mesa de doces finos com bolo (2–3 mini sobremesas / 5–6 docinhos/pessoa), sem bolo, mesa de bem-casados ou candy bar.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Equilibre os Centos e Dúzias
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Escolha os sabores (brigadeiros, macarons, trufas, tortinhas) e calcule as quantidades exatas para a confeiteira.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Imprima Placas e Encomenda
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Gere placas para porta-retrato (8x10 / 5x7), plaquinhas de buffet com alérgenos e baixe a encomenda em PDF e Word.
					</p>
				</div>
			</div>
		</div>

		<!-- Interactive Application Workspace -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SEÇÃO 1: Convidados e Formato -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🍰 1. Configuração dos Convidados & Formato da Mesa
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Ajuste o número de convidados confirmados, o apetite e o formato de serviço
						</span>
					</div>
					<span id="badge-variety-rec" class="badge-postit" style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); padding: 4px 10px; border: 1.5px solid var(--fg-pencil); border-radius: 6px;">
						Recomendado: 4–5 Variedades
					</span>
				</div>

				<!-- Seletor de Formato -->
				<div style="margin-bottom: 1.5rem;">
					<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1rem; color: var(--fg-pencil);">
						Selecione o Tipo de Mesa Doce:
					</label>
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.75rem;" id="format-tabs-container">
						
						<label class="format-tab active" data-format="with-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fef08a; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="with-cake" checked style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🎂 + 🧁</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Junto ao Bolo</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">2–3 sobremesas / 5–6 doces</span>
						</label>

						<label class="format-tab" data-format="no-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="no-cake" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🧁✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Sem Bolo (Principal)</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">4–6 sobremesas por pessoa</span>
						</label>

						<label class="format-tab" data-format="cookie-table" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="cookie-table" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍪📦</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Mesa de Bem-Casados</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">6–8 unidades + caixas</span>
						</label>

						<label class="format-tab" data-format="candy-buffet" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="candy-buffet" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍬🍭</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Candy Bar & Balas</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">120g–160g / convidado</span>
						</label>

						<label class="format-tab" data-format="hybrid" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="hybrid" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">👑✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Grande Mesa Doce</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">Doces Finos + Candy Bar</span>
						</label>
					</div>
				</div>

				<!-- Convidados e Apetite -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
					
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="input-guests" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								👥 Quantidade de Convidados:
							</label>
							<span id="badge-guests" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 2px 10px; border-radius: 12px; font-size: 0.9rem;">
								100 Convidados
							</span>
						</div>
						<input type="range" id="slider-guests" min="20" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="input-guests" min="10" max="1000" value="100" class="form-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 1rem; font-weight: 600; background: #fff;">
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<label for="select-appetite" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🍽️ Cardápio & Apetite da Festa:
						</label>
						<select id="select-appetite" style="width: 100%; padding: 0.6rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.95rem; font-weight: 600; background: #fff; margin-bottom: 0.5rem;">
							<option value="light">Leve (Após jantar farto de 4 tempos com sobremesa empratada)</option>
							<option value="standard" selected>Padrão (Equilibrado: 2.5 mini sobremesas / 135g doces)</option>
							<option value="generous">Formiguinhas & Balada (Festa animada até a madrugada)</option>
						</select>
						<div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
							<input type="checkbox" id="chk-takeaway-favors" style="width: 18px; height: 18px; accent-color: var(--accent-blue);">
							<label for="chk-takeaway-favors" class="font-body" style="font-size: 0.85rem; color: var(--fg-pencil); cursor: pointer;">
								<strong>Incluir Caixinhas de Lembrança</strong> (+2 doces / +80g balas por convidado)
							</label>
						</div>
					</div>

				</div>

				<!-- Estatísticas Principais -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
					
					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Total de Doces</span>
						<strong id="stat-total-pieces" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red); line-height: 1.2;">250</strong>
						<span id="stat-pieces-per-guest" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(2.5 un / convidado)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Dúzias Confeitaria</span>
						<strong id="stat-total-dozens" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); line-height: 1.2;">21 Dúz</strong>
						<span id="stat-exact-dozens" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(252 unidades totais)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Quilos de Candy Bar</span>
						<strong id="stat-total-candy" class="font-heading" style="font-size: 1.8rem; color: #16a34a; line-height: 1.2;">12.7 kg</strong>
						<span id="stat-candy-kg" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(28 lbs / 6–8 Potes)</span>
					</div>

					<div style="text-align: center; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Montagem da Mesa</span>
						<strong id="stat-table-size" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); line-height: 1.2;">Mesa 2.0–2.4 m</strong>
						<span id="stat-napkins-count" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">150 guardanapos de coquetel</span>
					</div>

				</div>
			</div>

			<!-- SEÇÃO 2: Sabores e Dúzias/Centos -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🧁 2. Variedades de Doces & Dúzias para Encomenda
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Ajuste as unidades por sabor e veja a encomenda exata para sua doceira
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
						<button type="button" id="btn-auto-balance" class="hand-btn" style="background: var(--post-it); font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 700; display: inline-flex; align-items: center; gap: 0.3rem;">
							<span>⚖️</span> Auto-Equilibrar
						</button>
						<button type="button" id="btn-reset-varieties" class="hand-btn" style="background: #fff; font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 600;">
							🔄 Redefinir
						</button>
					</div>
				</div>

				<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; font-size: 0.85rem;">
						<span><strong>Unidades Alocadas:</strong> <span id="label-allocated-pieces">250</span> / <span id="label-target-pieces">250</span> Alvo</span>
						<span id="label-allocation-status" style="font-weight: 700; color: #16a34a;">✅ Perfeitamente Equilibrado</span>
					</div>
					<div style="width: 100%; height: 10px; background: #e2e8f0; border-radius: 5px; overflow: hidden; border: 1px solid var(--fg-pencil);">
						<div id="bar-allocation-progress" style="width: 100%; height: 100%; background: #16a34a; transition: width 0.3s ease, background-color 0.3s ease;"></div>
					</div>
				</div>

				<div id="dessert-items-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
				</div>

				<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 6px; padding: 1rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between;">
					<div style="display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 240px;">
						<span style="font-size: 1.2rem;">➕</span>
