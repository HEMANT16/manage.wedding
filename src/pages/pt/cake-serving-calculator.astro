---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Calculadora de Fatias de Bolo de Casamento & Guia de Andares",
      "url": "https://manage.wedding/pt/cake-serving-calculator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de fatias e andares de bolo de casamento. Calcule o rendimento de bolos redondos, quadrados, formato coração e bolos de tabuleiro com simulador visual e guia de corte.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular as Fatias e Tamanho do Bolo de Casamento",
      "description": "Guia passo a passo para determinar o número de andares, diâmetros e fatias de bolo para casamentos e festas.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Selecione o Formato e Estilo do Bolo",
          "text": "Escolha entre andares redondos clássicos, quadrados (que rendem +25% de fatias) ou formato coração."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Defina as Dimensões da Fatia",
          "text": "Selecione Fatia de Casamento (2,5 x 5 x 10 cm para refeições com sobremesa) ou Fatia de Festa (5 x 5 x 10 cm para lanches e aniversários)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Escolha a Combinação de Andares",
          "text": "Opte por combinações clássicas de 2, 3 ou 4 andares (ex.: 15 cm / 23 cm / 30 cm para 100 convidados) ou deixe o cálculo automático atuar."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Considere um Bolo de Apoio de Cozinha",
          "text": "Adicione um bolo de tabuleiro na cozinha de apoio para alimentar convidados adicionais poupando nas despesas de decoração personalizada."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual o tamanho de bolo de casamento necessário para 100 convidados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para 100 convidados, a opção mais clássica é um bolo redondo de 3 andares com 15 cm, 23 cm e 30 cm de diâmetro (6\", 9\" e 12\"), que rende exatamente 100 fatias padrão de casamento (2,5 x 5 cm)."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é a diferença entre uma fatia de casamento e uma fatia de aniversário?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A fatia de casamento mede 2,5 cm x 5 cm x 10 cm de altura, ideal para ser servida após um banquete completo com várias sobremesas. A fatia de festa mede 5 cm x 5 cm (o dobro do volume), ideal para festas de aniversário onde o bolo é o doce principal."
          }
        },
        {
          "@type": "Question",
          "name": "Devemos contar o topo do bolo nas fatias dos convidados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se seguir a tradição de congelar o andar superior de 15 cm para comemorar o 1.º aniversário de casamento ou as bodas de papel, não o conte para os convidados. Subtraia cerca de 12 fatias ao total."
          }
        },
        {
          "@type": "Question",
          "name": "Como é que os pasteleiros cortam bolos de casamento altos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os profissionais nunca cortam bolos grandes em fatias triangulares. Utilizam o método dos círculos concêntricos: cortam um círculo interior a 5 cm da borda e fatiam o anel exterior em retângulos perfeitos de 2,5 cm."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Fatias de Bolo de Casamento & Andares | Manage.Wedding"
	description="Calcule fatias de bolo de noiva, diâmetro dos andares, rendimento de bolos redondos e quadrados, e bolos de tabuleiro com simulador em escala."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2.5rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 3rem 1.5rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Calculadora de Fatias de Bolo de Casamento
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Descubra o tamanho e andares ideais para o bolo dos noivos. Escolha o formato, dimensões da fatia e explore o simulador visual em escala.
				</p>
			</div>
		</section>

		<!-- Interactive Calculator & Visual Studio Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; margin-bottom: 3.5rem;" class="calc-container-grid">
			
			<!-- Left Column: Controls & Inputs -->
			<div class="hand-card" style="padding: 2rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.8rem; margin-bottom: 1.5rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>🎂</span> Especificações do Bolo
				</h2>

				<form id="cake-calc-form">
					
					<!-- Calculation Mode -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Estilo / Tipo de Bolo:
						</label>
						<div class="mode-select-grid">
							<label class="mode-tab active" id="tab-tiered">
								<input type="radio" name="cakeMode" value="tiered" checked style="display: none;"> Bolo com Andares
							</label>
							<label class="mode-tab" id="tab-sheet">
								<input type="radio" name="cakeMode" value="sheet" style="display: none;"> Bolo de Tabuleiro
							</label>
							<label class="mode-tab" id="tab-combo">
								<input type="radio" name="cakeMode" value="combo" style="display: none;"> Andares + Apoio
							</label>
						</div>
					</div>

					<!-- Guest Count -->
					<div style="margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label class="font-heading" for="guest-count" style="font-size: 1.15rem; color: var(--fg-pencil);">
								Número de Convidados:
							</label>
							<span id="guest-badge" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.9rem;">100 Convidados</span>
						</div>
						<input type="range" id="guest-slider" min="10" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="guest-count" class="form-input" min="1" max="1000" value="100" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem;">
						</div>
					</div>

					<!-- Cake Shape -->
					<div id="shape-group" style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Formato dos Andares:
						</label>
						<select id="cake-shape" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem; background: #fff;">
							<option value="round" selected>Redondo (Clássico, Elegante e Tradicional)</option>
							<option value="square">Quadrado (~25% mais fatias por andar)</option>
							<option value="heart">Formato Coração (Romântico & Tendência)</option>
						</select>
					</div>

					<!-- Slice / Portion Size -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Tamanho da Fatia:
						</label>
						<select id="portion-size" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem; background: #fff;">
							<option value="wedding" selected>Fatia de Casamento (2,5 x 5 x 10 cm de altura — Padrão Banquete)</option>
							<option value="party">Fatia de Festa / Aniversário (5 x 5 x 10 cm — Generosa)</option>
							<option value="dessert">Fatia de Sobremesa (3,8 x 5 x 10 cm — Média)</option>
						</select>
						<small class="font-body" style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">
							*A fatia de casamento é a medida padrão internacional após refeições completas.
						</small>
					</div>

					<!-- Tier Preference (Tiered Mode) -->
					<div id="tier-pref-group" style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Configuração de Andares:
						</label>
						<select id="tier-count-pref" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem; background: #fff;">
							<option value="auto" selected>Recomendação Automática de Proporção</option>
							<option value="1">1 Andar Único</option>
							<option value="2">2 Andares (Casamentos Íntimos 30-65 Convidados)</option>
							<option value="3">3 Andares (Clássico 75-130 Convidados)</option>
							<option value="4">4 Andares (Grande Porte 130-220 Convidados)</option>
							<option value="5">5 Andares (Monumental 220+ Convidados)</option>
						</select>
					</div>

					<!-- Anniversary Top Tier Checkbox -->
					<div style="margin-bottom: 1.5rem; padding: 0.75rem; background: var(--bg-paper); border: 2px dashed var(--fg-pencil); border-radius: 4px;">
						<label style="display: flex; align-items: flex-start; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="save-top-tier" style="margin-top: 0.3rem; transform: scale(1.2);">
							<span class="font-body" style="font-size: 1.05rem; color: var(--fg-pencil); line-height: 1.4;">
								<strong>Guardar o Topo para o 1.º Aniversário de Casamento?</strong><br>
								<span style="color: var(--text-secondary); font-size: 0.9rem;">Subtrai ~12 fatias do topo para congelar, garantindo que não falta bolo aos convidados.</span>
							</span>
						</label>
					</div>

					<!-- Cake Height Preference -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Altura de Cada Andar:
						</label>
						<div class="height-select-grid">
							<label class="height-opt active">
								<input type="radio" name="cakeHeight" value="4" checked style="display: none;"> 10 cm Padrão (3 camadas)
							</label>
							<label class="height-opt">
								<input type="radio" name="cakeHeight" value="5" style="display: none;"> 12,5 cm Alto
							</label>
							<label class="height-opt">
								<input type="radio" name="cakeHeight" value="6" style="display: none;"> 15 cm Double Barrel
							</label>
						</div>
					</div>

					<button type="button" id="recalc-btn" class="hand-btn" style="width: 100%; padding: 1rem; font-size: 1.25rem;">
						✨ Atualizar Cálculo do Bolo
					</button>

				</form>
			</div>

			<!-- Right Column: Interactive Visuals & Results -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Results Summary Card -->
				<div class="hand-card" style="background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
						<h2 class="font-heading" style="font-size: 1.8rem; color: var(--accent-red); margin: 0;">
							Projeto do Bolo
						</h2>
						<span id="match-status" class="font-heading" style="background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem;">
							Ajuste Perfeito
						</span>
					</div>

					<!-- Big Stats -->
					<div class="cake-stats-grid">
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total de Fatias</span>
							<strong id="res-total-servings" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue); display: block;">100</strong>
							<span id="res-servings-diff" style="font-size: 0.75rem; color: var(--text-secondary);">Exato para 100</span>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Andares</span>
							<strong id="res-tier-count" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); display: block;">3 Andares</strong>
							<span id="res-tier-detail" style="font-size: 0.75rem; color: var(--text-secondary);">15cm, 23cm, 30cm</span>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Área de Cobertura</span>
							<strong id="res-cake-area" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); display: block;">1.320 cm²</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Decoração e Creme</span>
						</div>
					</div>

					<!-- Visual Cake Tier Render Container -->
					<div id="visual-cake-studio" style="border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 1.5rem 0.5rem 0.5rem; background: var(--bg-paper); min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; position: relative; overflow: hidden; max-width: 100%;">
						<div style="position: absolute; top: 8px; left: 10px; font-size: 0.8rem; color: var(--text-secondary); font-family: var(--font-heading);">
							📐 Esquema em Escala do Bolo
						</div>
						<!-- Tiers dynamically rendered here -->
						<div id="tiers-render-box" style="display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 100%;"></div>
						<!-- Cake Stand -->
						<div id="cake-stand-plate" style="width: min(240px, 90%); height: 10px; background: #e5e0d8; border: 2px solid var(--fg-pencil); border-radius: 10px; margin-top: -2px;"></div>
						<div id="cake-stand-stem" style="width: 50px; height: 20px; background: #dcd6cc; border: 2px solid var(--fg-pencil); border-top: none; margin-bottom: 4px;"></div>
						<div id="cake-stand-foot" style="width: 100px; height: 8px; background: #dcd6cc; border: 2px solid var(--fg-pencil); border-radius: 4px;"></div>
					</div>

					<!-- Breakdown List per Tier -->
					<div id="tier-breakdown-list" style="margin-top: 1.5rem; font-family: var(--font-body); font-size: 1rem;">
						<!-- Populated via JS -->
					</div>

					<!-- Pro-Tip Callout Box -->
					<div id="pro-tip-box" style="margin-top: 1.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
						<div class="font-heading" style="font-size: 1.1rem; margin-bottom: 0.25rem; color: var(--fg-pencil);">
							💡 Estratégia de Poupança Inteligente:
						</div>
						<p id="pro-tip-text" class="font-body" style="font-size: 0.95rem; margin: 0; line-height: 1.4;">
							Encomende um bolo de 2 andares para o corte e fotografias, complementado por um bolo de tabuleiro retangular na cozinha para os restantes convidados poupando até 50%!
						</p>
					</div>

				</div>

				<!-- Visual Slice Scale Comparison Card -->
				<div class="hand-card" style="padding: 1.5rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin-bottom: 1rem; color: var(--fg-pencil);">
						📏 Comparação Visual das Fatias
					</h3>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; text-align: center;">
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
							<div class="font-heading" style="font-size: 1.1rem; color: var(--accent-blue); margin-bottom: 0.5rem;">Fatia de Casamento</div>
							<div style="width: 40px; height: 80px; background: #ffeaa7; border: 2px solid var(--fg-pencil); margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
								2,5 × 5 cm
							</div>
							<div class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								125 cm³<br>Padrão após jantar completo
							</div>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
							<div class="font-heading" style="font-size: 1.1rem; color: var(--accent-red); margin-bottom: 0.5rem;">Fatia de Festa</div>
							<div style="width: 80px; height: 80px; background: #fab1a0; border: 2px solid var(--fg-pencil); margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
								5 × 5 cm
							</div>
							<div class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								250 cm³<br>Generosa / Aniversário
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 3.5rem auto 2.5rem; max-width: 900px; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape"></div>
			
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Resumo Direto ao Assunto (BLUF)
				</h3>
				<span style="background: #fff; border: 1.5px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700; color: var(--accent-red);">
					Regra Prática em 1 Minuto
				</span>
			</div>

			<!-- Formula Highlight Box -->
			<div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<div style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--accent-red); margin-bottom: 0.35rem; font-weight: 700;">
					📐 A Fórmula Central de Fatias de Bolo:
				</div>
				<p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.5;">
					<strong>Fatia Formal de Casamento = 2,5 cm × 5 cm × 10 cm de altura (125 cm³)</strong><br />
					<strong>Fatia de Festa / Aniversário = 5 cm × 5 cm × 10 cm de altura (250 cm³ — o dobro do volume)</strong><br />
					<em>Regra:</em> Como o bolo de noiva é servido após o banquete e mesa de doces, o rendimento de fatias de casamento é exatamente <strong>o dobro</strong> face a fatias de aniversário.
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; margin-bottom: 1rem; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 600px;">
					<thead>
						<tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil);">Estrutura de Andares</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil); text-align: center;">Diâmetros Redondos</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red); text-align: center;">Fatias Casamento (2,5x5cm)</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue); text-align: center;">Fatias Festa (5x5cm)</th>
							<th style="padding: 0.6rem 0.75rem; font-weight: 700; color: var(--fg-pencil); text-align: right;">N.º Convidados Ideal</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">2 Andares Petite</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">15 cm + 20 cm (6"+8")</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-red);">36 fatias</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">18 fatias</td>
