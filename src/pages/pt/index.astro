---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://manage.wedding/pt/#website",
      "name": "Manage.Wedding — Calculadoras de Casamento & Orçamento Gratuitas",
      "url": "https://manage.wedding/pt/",
      "inLanguage": "pt",
      "description": "Suite privada de calculadoras interativas de casamento: cálculo de open bar e bebidas, mapa de mesas, orçamento e papelaria para imprimir.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://manage.wedding/pt/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Todas as calculadoras no Manage.Wedding são totalmente gratuitas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim, 100% gratuitas, sem necessidade de registo, sem cartão de crédito e sem custos ocultos. Todos os cálculos e downloads em PDF e Word são gerados instantaneamente no seu navegador."
          }
        },
        {
          "@type": "Question",
          "name": "O Manage.Wedding guarda os meus dados de convidados ou orçamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. O Manage.Wedding funciona com uma arquitetura estritamente Local-First. As suas listas de convidados, orçamentos e moradas ficam guardados apenas na memória do seu próprio dispositivo e nunca são enviados para servidores externos."
          }
        },
        {
          "@type": "Question",
          "name": "Quais são as 4 fases principais no planeamento financeiro do casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. Orçamento & Finanças (Distribuição de custos e análise de contratos de quintas/espaços), 2. Banquete & Bebidas (Cálculo de open bar, vinho e andares do bolo), 3. Convidados & Logística (Mapa de mesas e cronograma ao minuto do dia), e 4. Papelaria & Detalhes (Endereçamento de envelopes, ementas coordenadas e tempo de discursos)."
          }
        }
      ]
    }
  ]
};

const searchIndex = [
  // Orçamento & Finanças (Budget)
  { title: "Calculadora de Orçamento Geral", url: "/pt/master-budget-calculator", category: "Orçamento", desc: "Distribuição dos custos segundo a regra comprovada 50/15/10/10/10/5." },
  { title: "Custos Ocultos da Quinta / Espaço", url: "/pt/wedding-venue-cost-calculator", category: "Orçamento", desc: "Calcule o custo real com consumo mínimo de catering e taxas de serviço." },
  { title: "Quem Paga o Quê no Casamento?", url: "/pt/who-pays-for-what-wedding", category: "Orçamento", desc: "Compare a etiqueta tradicional com a divisão moderna entre famílias." },
  { title: "Orçamento da Despedida de Solteira", url: "/pt/bachelorette-budget-calculator", category: "Orçamento", desc: "Divida os custos de alojamento e atividades cobrindo a parte da noiva." },
  { title: "Guia de Gratificações / Gorjetas", url: "/pt/vendor-tipping-calculator", category: "Orçamento", desc: "Valores habituais e envelopes de agradecimento para os fornecedores." },
  { title: "Orçamento da Lua de Mel", url: "/pt/honeymoon-budget-estimator", category: "Orçamento", desc: "Voos, hotéis, jantares românticos, passeios e lista de bagagem." },
  { title: "Simulador de Empréstimo Casamento", url: "/pt/wedding-loan-calculator", category: "Orçamento", desc: "Mensalidades, juros totais e plano de amortização completo." },
  { title: "Presente em Dinheiro (Convidados)", url: "/pt/gift-cash-calculator", category: "Orçamento", desc: "Quanto oferecer aos noivos consoante o grau de parentesco e deslocação." },

  // Banquete & Restauração (Dining)
  { title: "Calculadora de Bebidas & Open Bar", url: "/pt/wedding-drink-calculator", category: "Banquete", desc: "Calcule com rigor garrafas de vinho, espumante, cerveja, bebidas brancas e gelo." },
  { title: "Bebidas Brancas & Garrafas de Bar", url: "/pt/liquor-wedding-calculator", category: "Banquete", desc: "Otimize garrafas de 70cl e garrafas grandes para a barra de cocktails." },
  { title: "Preço do Bolo de Casamento", url: "/pt/cake-pricing-calculator", category: "Banquete", desc: "Custo por fatia, horas de confeção e orçamento de pastelaria." },
  { title: "Andares e Fatias de Bolo de Noiva", url: "/pt/cake-serving-calculator", category: "Banquete", desc: "Dimensões dos andares redondos ou quadrados de 50 a 300+ fatias." },
  { title: "Criador de Ementas (4x9 DL)", url: "/pt/reception-menu-maker", category: "Banquete", desc: "Crie ementas elegantes nos formatos DL 4x9 e 5x7 em PDF vetorial." },
  { title: "Banquete Servido vs. Buffet", url: "/pt/catering-cost-estimator", category: "Banquete", desc: "Compare o custo por pessoa entre menu servido à mesa, buffet e estações." },
  { title: "Teor Alcoólico & Diluição de Cocktails", url: "/pt/alcohol-dilution-calculator", category: "Banquete", desc: "Equilibre a percentagem alcoólica e o volume de água para cocktails de receção." },
  { title: "Orçamento de Flores & Decoração", url: "/pt/floral-cost-estimator", category: "Banquete", desc: "Bouquet de noiva, centros de mesa, lapelas e arco da cerimónia." },

  // Convidados & Logística (Guests)
  { title: "Mapa e Disposição de Mesas Interativo", url: "/pt/seating-chart-maker", category: "Convidados", desc: "Organize mesas redondas e retangulares com drag & drop e imprima o mapa." },
  { title: "Pista de Dança & Espaçamento de Mesas", url: "/pt/seating-clearance-calculator", category: "Convidados", desc: "Área da pista de dança e corredores de 1,5m para a circulação dos empregados." },
  { title: "Cortejo Nupcial & Ordem de Entrada", url: "/pt/wedding-processional-order", category: "Convidados", desc: "Organização da entrada e saída para cerimónias religiosas, civis e simbólicas." },
  { title: "Cronograma do Grande Dia (Minuto a Minuto)", url: "/pt/day-of-timeline-generator", category: "Convidados", desc: "Horários detalhados dos preparativos, maquilhagem, fotos e corte do bolo." },
  { title: "Jantar de Ensaio / Véspera", url: "/pt/rehearsal-dinner-planner", category: "Convidados", desc: "Lista de presença, orçamento de refeição e horários para a véspera." },
  { title: "Gestão da Lista de Convidados", url: "/pt/guest-list-manager", category: "Convidados", desc: "Acompanhantes, moradas para convites e restrições alimentares." },
  { title: "Controlo de Confirmações (RSVP)", url: "/pt/rsvp-tracker", category: "Convidados", desc: "Monitorização em tempo real de presenças, faltas e escolhas de prato." },
  { title: "Estimativa de Presenças Reais", url: "/pt/guest-count-estimator", category: "Convidados", desc: "Percentagem de adesão para convidados locais e familiares que viajam de longe." },
  { title: "Calendário de Envio de Convites", url: "/pt/rsvp-date-calculator", category: "Convidados", desc: "Datas ideais para Save-the-Date, envio de convites e prazo limite de resposta." },
  { title: "Checklist de Casamento de 12 Meses", url: "/pt/wedding-checklist", category: "Convidados", desc: "Lista de tarefas interativa mês a mês com gravação automática." },
  { title: "Arranjos do Vestido de Noiva", url: "/pt/dress-alterations-estimator", category: "Convidados", desc: "Bainhas, ajuste do corpete e colocação do ponto para prender a cauda." },
  { title: "Conversor de Tamanhos de Vestido de Noiva", url: "/pt/dress-size-converter", category: "Convidados", desc: "Converta as suas medidas em cm para tamanhos PT/EU, US, UK e IT." },
  { title: "Medidor & Guia de Tamanhos de Alianças", url: "/pt/ring-size-converter", category: "Convidados", desc: "Diâmetro e perímetro em milímetros para alianças portuguesas e internacionais." },

  // Papelaria & Lembranças (Stationery)
  { title: "Endereçamento de Envelopes & Caligrafia", url: "/pt/wedding-envelope-addressing", category: "Papelaria", desc: "Formatação correta de tratamentos (Família, Exmo.) e impressão em PDF." },
  { title: "Formatos de Convites & Envelopes (A7/A6)", url: "/pt/wedding-invitation-suite-sizer", category: "Papelaria", desc: "Dimensões padrão para convites, cartões RSVP e margens de corte a 300 DPI." },
  { title: "Calculadora de Portes e Selos", url: "/pt/wedding-invitation-postage-calculator", category: "Papelaria", desc: "Peso do convite, selos de cera e taxas dos correios para envio de convites." },
  { title: "Marcadores de Lugar e Mesa", url: "/pt/table-place-cards", category: "Papelaria", desc: "Marcadores dobráveis com ícones de menu para a equipa de serviço." },
  { title: "Textos de Cartões de Agradecimento", url: "/pt/wedding-thank-you-cards", category: "Papelaria", desc: "Ideias de mensagens para ofertas em dinheiro, presentes e presenças." },
  { title: "Convites de Casamento Digitais", url: "/pt/digital-invitations", category: "Papelaria", desc: "Convites online com botão de calendário (.ics) e confirmação digital." },
  { title: "Temporizador de Discursos & Votos", url: "/pt/wedding-speech-calculator", category: "Papelaria", desc: "Contagem de palavras, ritmo de leitura (120 ppm) e cartões de apoio." },
  { title: "Gerador de Hashtags de Casamento", url: "/pt/wedding-hashtag-generator", category: "Papelaria", desc: "Hashtags criativos e placas decorativas para as fotos dos convidados." },
  { title: "Numerologia da Data de Casamento", url: "/pt/wedding-date-numerology", category: "Papelaria", desc: "Caminho de vida e significado espiritual da data da cerimónia." },
  { title: "Bodas de Casamento & Ideias de Presente", url: "/pt/anniversary-gift-finder", category: "Papelaria", desc: "Bodas de Papel, Prata, Ouro e Diamante: presentes do 1º ao 60º aniversário." }
];
---

<Layout 
	title="Manage.Wedding — Calculadoras de Casamento & Orçamento Gratuitas"
	description="Suite privada de calculadoras interativas de casamento: cálculo de open bar e bebidas, mapa de mesas, orçamento e papelaria para imprimir. 100% gratuito e sem cadastro."
	schema={schema}
>
	<main>
		<!-- 1. Hero: Digital Sketchbook & Live Instant Search -->
		<section class="section-paper fade-in" style="padding: 4rem 1.5rem 3rem; position: relative; overflow: hidden; border-bottom: 3px solid var(--fg-pencil);">
			
			<div class="tape" style="top: -10px;"></div>
			
			<div style="max-width: 1050px; margin: 0 auto; text-align: center; position: relative; z-index: 10;">
				
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 6px 16px; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-1deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.95rem; font-weight: 700; color: var(--fg-pencil);">100% Gratuito • Privacidade Total • Downloads Imediatos</span>
				</div>

				<h1 class="font-heading" style="font-size: clamp(36px, 6.5vw, 68px); line-height: 1.15; color: var(--fg-pencil); margin-bottom: 1.25rem;">
					Planeie os números do seu casamento <br class="hidden sm:inline" />
					<span style="color: var(--accent-blue); text-decoration: underline; text-decoration-style: wavy;">sem qualquer stress.</span>
				</h1>

				<p style="font-size: clamp(1.1rem, 2.5vw, 1.3rem); color: var(--text-secondary); max-width: 760px; margin: 0 auto 2rem; line-height: 1.6;">
					O seu caderno digital privado para calcular o open bar, custos da quinta / espaço, criar o mapa de mesas e imprimir ementas.
				</p>

				<!-- Live Instant Search Bar with Dynamic Dropdown -->
				<div style="position: relative; max-width: 650px; margin: 0 auto 2rem;">
					<div class="search-hero-box" style="margin-bottom: 0;">
						<span style="font-size: 1.3rem; color: #64748b;">🔍</span>
						<input 
							type="text" 
							id="home-tool-search" 
							class="search-hero-input" 
							placeholder="Pesquisar ferramenta: open bar, quinta, bolo, mapa de mesas, discursos..."
							aria-label="Pesquisar calculadoras de casamento"
							autocomplete="off"
						/>
						<button id="clear-search-btn" style="display: none; background: none; border: none; font-size: 1.1rem; color: #94a3b8; cursor: pointer; padding: 0 0.5rem;">✕</button>
					</div>

					<!-- Search Results Live Dropdown Popup -->
					<div id="search-dropdown-results" style="display: none; position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 4px 4px 0px var(--fg-pencil); max-height: 380px; overflow-y: auto; z-index: 100; text-align: left; padding: 0.5rem;">
						<!-- Injected by JavaScript -->
					</div>
				</div>

				<!-- Fast Shortcut Chips -->
				<div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; max-width: 800px; margin: 0 auto 2rem;">
					<span style="font-size: 0.88rem; font-weight: 600; color: #64748b; align-self: center;">Ferramentas Populares:</span>
					<a href="/pt/wedding-drink-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Open Bar & Bebidas</a>
					<a href="/pt/wedding-venue-cost-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🏰 Custos da Quinta</a>
					<a href="/pt/seating-chart-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🪑 Mapa de Mesas</a>
					<a href="/pt/reception-menu-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">📜 Ementas Prontas</a>
					<a href="/pt/wedding-envelope-addressing" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">✉️ Envelopes & Convites</a>
				</div>

				<!-- Main Hero CTAs -->
				<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
					<a href="#featured-favorites" class="hand-btn" style="padding: 14px 30px; font-size: 1.15rem;">
						Explorar Ferramentas Principais ↓
					</a>
					<a href="/pt/about" class="hand-btn secondary" style="padding: 14px 26px; font-size: 1.15rem;">
						Porquê o Manage.Wedding?
					</a>
				</div>

			</div>
		</section>

		<!-- 2. Spotlight "Crowd Favorites" (4 Illustrated Cards) -->
		<section id="featured-favorites" style="padding: 4rem 1.5rem; max-width: 1200px; margin: 0 auto;">
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil);">
					⭐ As Ferramentas Mais Usadas
				</h2>
				<p style="font-size: 1.1rem; color: var(--text-secondary); max-width: 600px; margin: 0.25rem auto 0;">
					Os simuladores preferidos por noivos e wedding planners em Portugal e no Brasil.
				</p>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 2rem;">
				
				<!-- Featured 1: Open Bar -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/wedding_bar_sketch.webp" 
						alt="Calculadora de Bebidas & Open Bar de Casamento" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #fef08a; border-color: var(--fg-pencil); color: var(--fg-pencil);">Muito Popular</span>
						<span class="tool-time">⏱️ 2 min</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Calculadora de Bebidas & Bar</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Calcule com exatidão vinho, espumante, cerveja, bebidas brancas e gelo para a festa.
					</p>
					<a href="/pt/wedding-drink-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Calcular Bebidas →
					</a>
				</div>

				<!-- Featured 2: Master Budget -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/calculator_sketch.webp" 
						alt="Calculadora de Orçamento Geral de Casamento" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dbeafe; border-color: #93c5fd; color: #1e40af;">Finanças</span>
						<span class="tool-time">⏱️ 3 min</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Calculadora de Orçamento</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Distribua qualquer valor total de acordo com as percentagens reais da indústria de casamentos.
					</p>
					<a href="/pt/master-budget-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Distribuir Orçamento →
					</a>
				</div>

				<!-- Featured 3: Day-Of Timeline -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/pocket-watch-sketch.webp" 
						alt="Cronograma do Grande Dia de Casamento" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dcfce7; border-color: #86efac; color: #166534;">Logística</span>
						<span class="tool-time">⏱️ 3 min</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Cronograma do Grande Dia</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Gere um guião minuto a minuto para fotógrafos, maquilhagem, padrinhos e fornecedores.
					</p>
					<a href="/pt/day-of-timeline-generator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Criar Cronograma →
					</a>
				</div>

				<!-- Featured 4: Seating Chart -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/seating_chart_sketch.webp" 
						alt="Mapa e Disposição de Mesas Interativo" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #f3e8ff; border-color: #d8b4fe; color: #6b21a8;">Interativo</span>
						<span class="tool-time">⏱️ 5 min</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Mapa de Mesas</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Disponha mesas redondas e compridas, posicione convidados e descarregue a planta.
					</p>
					<a href="/pt/seating-chart-maker" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Criar Mapa de Mesas →
					</a>
				</div>

			</div>
		</section>

		<!-- 3. The 4-Phase Wedding Planning Master Roadmap -->
		<section style="background: var(--muted-paper); padding: 4.5rem 1.5rem; border-top: 3px dashed var(--fg-pencil); border-bottom: 3px dashed var(--fg-pencil);">
			<div style="max-width: 1100px; margin: 0 auto;">
				
				<div style="text-align: center; margin-bottom: 3rem;">
					<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Passo a Passo</span>
					<h2 class="font-heading" style="font-size: clamp(28px, 4.5vw, 44px); color: var(--fg-pencil);">
						O Guia Mestre de Planeamento de Casamento
					</h2>
					<p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 650px; margin: 0.25rem auto 0;">
						O que calcular, definir e validar em cada fase dos preparativos.
					</p>
				</div>

				<div style="display: flex; flex-direction: column; gap: 1.75rem;">
					
					<!-- Roadmap Step 1 -->
					<div class="hand-card" style="padding: 1.75rem; background: #fff; border-left: 6px solid var(--accent-red);">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								Fase 1: Orçamento Real e Escolha da Quinta (12 a 9 Meses Antes)
							</h3>
							<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
								Fase 01
							</span>
						</div>
						<p class="font-body" style="font-size: 1rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 1rem 0;">
							Defina o limite máximo de despesa antes das visitas a quintas e palacetes. Analise os orçamentos para identificar consumos mínimos de catering e taxas de serviço. Esclareça a divisão entre famílias com tranquilidade.
						</p>
