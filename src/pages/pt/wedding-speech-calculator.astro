	</main>
</Layout>

<style>
	.print-only {
		display: none;
	}

	
</style>

<script is:inline>
	const sampleTemplates = {
		bestman: `Boa noite a todos! Para quem ainda não me conhece, sou o Tiago e tenho a enorme honra (e o ocasional desafio) de ser o melhor amigo do noivo desde os tempos da faculdade.

Quando o conheci, ele disse-me que tinha três grandes objetivos na vida: tornar-se um arquiteto de sucesso, aprender a cozinhar algo melhor do que massa com atum e encontrar uma mulher inteligente, linda e com paciência suficiente para aturar a sua paixão pelo futebol. Bem, a olhar para a noiva deslumbrante esta noite, diria que ele conseguiu o mais importante de todos! [Pausa para risos]

Falando com todo o coração: ver a forma como vocês olham um para o outro é inspirador. Ela traz uma calma, alegria e luz à vida dele que nunca tinha visto antes. Vocês são verdadeiramente perfeitos um para o outro.

Peço a todos que levantem os seus copos comigo: A uma vida inteira de cumplicidade, muitas viagens e amor incondicional. Aos noivos! Viva os noivos!`,

		moh: `Olá a todos! Sou a Mariana, a Madrinha e irmã da noiva. Olhando para ela esta noite, sinto uma emoção indescritível ao ver como está radiante, linda e verdadeiramente feliz.

Crescendo juntas, partilhámos tudo — roupas, segredos pela noite dentro e grandes sonhos sobre como seria este dia. Quando ela me ligou depois do segundo encontro com o noivo, não disse apenas que tinha corrido bem; disse: 'Mariana, acho que acabei de conhecer o homem com quem vou casar.' [Pausa com sorriso]

Ao noivo: muito obrigado por cuidares da minha irmã com tanto amor e dedicação todos os dias. Vê-la assim feliz é o maior presente que a nossa família poderia pedir.

A todos, por favor levantem o vosso copo: Que o vosso casamento seja repleto de alegria sem fim, amizade profunda e momentos mágicos. Aos noivos!`,

		parent: `Bem-vindos, família e amigos! Em nome de ambas as famílias, queremos agradecer do fundo do coração a todos os que viajaram de perto e de longe para celebrar este dia tão especial connosco.

Ver os nossos filhos crescerem e tornarem-se nas pessoas bondosas, generosas e extraordinárias que aqui estão hoje é o maior orgulho das nossas vidas. Receber esta nova família é como encaixar a última e perfeita peça de um puzzle.

O casamento constrói-se todos os dias na escolha de amar, perdoar, apoiar e rir juntos em todas as estações da vida. Nunca se esqueçam das promessas que fizeram hoje um ao outro.

Ergamos os copos: Ao amor, à saúde, à felicidade e a um futuro maravilhoso juntos! Viva os noivos!`,

		couple: `Queremos apenas roubar um breve minuto para agradecer do fundo do coração a cada um de vocês que está nesta sala. Olhar à volta e ver todas as pessoas mais importantes da nossa história reunidas aqui é um sonho tornado realidade.

Aos nossos pais: obrigado pelo amor incondicional, pelos sacrifícios e pelo exemplo fantástico de casamento que sempre nos deram. Não seríamos quem somos sem vocês.

Aos nossos padrinhos, damas e a toda a equipa da quinta e fornecedores: obrigado por tornarem este dia tão tranquilo e perfeito.

E agora, chega de discursos da nossa parte — o bar está aberto, a música está pronta, por isso vamos para a pista de dança celebrar! Muito obrigado a todos! [Brinde]`
	};

	const speechEditor = document.getElementById('speech-editor');
	const paceSelect = document.getElementById('select-speaking-pace');
	const bufferSelect = document.getElementById('select-pause-buffer');
	const displayWpmRate = document.getElementById('display-wpm-rate');

	const displayTimeResult = document.getElementById('display-time-result');
	const displaySpeechZone = document.getElementById('display-speech-zone');
	const displayWordCount = document.getElementById('display-word-count');
	const displayParagraphCount = document.getElementById('display-paragraph-count');
	const displayCardsCount = document.getElementById('display-cards-count');
	const speechGaugeBar = document.getElementById('speech-gauge-bar');

	function calculateStats() {
		const text = speechEditor.value.trim();
		const wpm = parseInt(paceSelect.value) || 130;
		const bufferSec = parseInt(bufferSelect.value) || 30;

		displayWpmRate.textContent = wpm;

		let words = 0;
		let paragraphs = 0;

		if (text.length > 0) {
			words = text.split(/\s+/).filter(w => w.length > 0).length;
			paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0).length;
		}

		displayWordCount.textContent = words;
		displayParagraphCount.textContent = paragraphs;

		const estimatedCards = Math.max(1, Math.ceil(words / 150));
		displayCardsCount.textContent = `${estimatedCards} Cartão${estimatedCards !== 1 ? 'ões' : ''}`;

		let totalSeconds = 0;
		if (words > 0) {
			totalSeconds = Math.round((words / wpm) * 60) + bufferSec;
		}

		const mins = Math.floor(totalSeconds / 60);
		const secs = totalSeconds % 60;
		displayTimeResult.textContent = `${mins}m ${secs}s`;

		const totalMins = totalSeconds / 60;
		const pct = Math.min(100, Math.max(5, (totalMins / 8) * 100));
		speechGaugeBar.style.width = `${words === 0 ? 0 : pct}%`;

		if (words === 0) {
			displaySpeechZone.textContent = "Comece a escrever ou carregue um modelo acima";
			displaySpeechZone.style.color = "var(--text-secondary)";
			speechGaugeBar.style.backgroundColor = "#ccc";
		} else if (totalMins < 2.5) {
			displaySpeechZone.textContent = "⚡ Curto (Considere acrescentar mais uma memória)";
			displaySpeechZone.style.color = "var(--accent-blue)";
			speechGaugeBar.style.backgroundColor = "var(--accent-blue)";
		} else if (totalMins >= 2.5 && totalMins <= 5.5) {
			displaySpeechZone.textContent = "✅ Duração Ideal (Perfeito para o copo-d'água)";
			displaySpeechZone.style.color = "#15803d";
			speechGaugeBar.style.backgroundColor = "#16a34a";
		} else if (totalMins > 5.5 && totalMins <= 7.0) {
			displaySpeechZone.textContent = "⚠️ Ligeiramente Longo (Corte pequenos detalhes)";
			displaySpeechZone.style.color = "#ca8a04";
			speechGaugeBar.style.backgroundColor = "#eab308";
		} else {
			displaySpeechZone.textContent = "🛑 Muito Longo (Corte 30% para não atrasar o jantar)";
			displaySpeechZone.style.color = "var(--accent-red)";
			speechGaugeBar.style.backgroundColor = "var(--accent-red)";
		}
	}

	// Preset Loaders
	document.querySelectorAll('.btn-load-template').forEach(btn => {
		btn.addEventListener('click', () => {
			const type = btn.getAttribute('data-type');
			if (sampleTemplates[type]) {
				speechEditor.value = sampleTemplates[type];
				calculateStats();
			}
		});
	});

	// Clear Button
	document.getElementById('btn-clear-speech').addEventListener('click', () => {
		speechEditor.value = '';
		calculateStats();
	});

	speechEditor.addEventListener('input', calculateStats);
	paceSelect.addEventListener('change', calculateStats);
	bufferSelect.addEventListener('change', calculateStats);

	// Live Stopwatch Logic
	let timerInterval = null;
	let startTime = 0;
	let elapsedTime = 0;
	let isRunning = false;

	const stopwatchDisplay = document.getElementById('stopwatch-display');
	const btnTimerStart = document.getElementById('btn-timer-start');
	const btnTimerPause = document.getElementById('btn-timer-pause');
	const btnTimerReset = document.getElementById('btn-timer-reset');

	function formatStopwatch(ms) {
		const totalSec = Math.floor(ms / 1000);
		const m = Math.floor(totalSec / 60).toString().padStart(2, '0');
		const s = (totalSec % 60).toString().padStart(2, '0');
		const tenth = Math.floor((ms % 1000) / 100);
		return `${m}:${s}.${tenth}`;
	}

	btnTimerStart.addEventListener('click', () => {
		if (!isRunning) {
			isRunning = true;
			startTime = Date.now() - elapsedTime;
			timerInterval = setInterval(() => {
				elapsedTime = Date.now() - startTime;
				stopwatchDisplay.textContent = formatStopwatch(elapsedTime);
			}, 100);
			btnTimerStart.style.display = 'none';
			btnTimerPause.style.display = 'inline-block';
		}
	});

	btnTimerPause.addEventListener('click', () => {
		if (isRunning) {
			isRunning = false;
			clearInterval(timerInterval);
			btnTimerStart.style.display = 'inline-block';
			btnTimerStart.textContent = '▶️ Retomar';
			btnTimerPause.style.display = 'none';
		}
	});

	btnTimerReset.addEventListener('click', () => {
		isRunning = false;
		clearInterval(timerInterval);
		elapsedTime = 0;
		stopwatchDisplay.textContent = '00:00.0';
		btnTimerStart.style.display = 'inline-block';
		btnTimerStart.textContent = '▶️ Iniciar Ensaio';
		btnTimerPause.style.display = 'none';
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const text = speechEditor.value.trim() || 'Nenhum texto inserido.';
		const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);

		let pTags = '';
		paragraphs.forEach((p, idx) => {
			pTags += `<p style="font-size:16pt; line-height:1.7; margin-bottom:18pt; color:#111;"><strong>[${idx + 1}]</strong> ${p}</p>`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Discurso de Casamento — Notas para Púlpito</title>
				<style>
					body { font-family: 'Segoe UI', Calibri, Arial, sans-serif; padding: 30px; font-size: 16pt; }
					h1 { color: #1e3a8a; font-size: 22pt; margin-bottom: 5pt; }
					.meta-box { border: 1pt solid #ccc; background: #f8fafc; padding: 10pt; font-size: 11pt; margin-bottom: 25pt; color: #475569; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Minuta de Discurso de Casamento</h1>
				<div class="meta-box">
					<strong>Tempo Estimado:</strong> ${displayTimeResult.textContent} | 
					<strong>Contagem de Palavras:</strong> ${displayWordCount.textContent} palavras | 
					<strong>Cadência de Fala:</strong> ${displayWpmRate.textContent} PPM
				</div>
				${pTags}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Discurso_Casamento_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print Cards
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-est-time').textContent = displayTimeResult.textContent;
		document.getElementById('print-word-count').textContent = `${displayWordCount.textContent} palavras`;

		const grid = document.getElementById('print-cue-cards-grid');
		grid.innerHTML = '';

		const text = speechEditor.value.trim() || 'Nenhum texto inserido.';
		const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);

		// Group every 2 paragraphs into a physical cue card
		for (let i = 0; i < paragraphs.length; i += 2) {
			const cardNum = Math.floor(i / 2) + 1;
			const totalCards = Math.ceil(paragraphs.length / 2);

			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 25px; page-break-inside: avoid; font-family: 'Times New Roman', serif; background: #fff; margin-bottom: 20px;`;
			
			let inner = `<div style="display:flex; justify-content:space-between; border-bottom:1px solid #000; padding-bottom:5px; margin-bottom:15px; font-size:12px; font-weight:bold;"><span>CARTÃO ${cardNum} DE ${totalCards}</span><span>TEMPO ESTIMADO: ${displayTimeResult.textContent}</span></div>`;
			
			inner += `<p style="font-size:16px; line-height:1.6; margin-bottom:12px;"><strong>[${i + 1}]</strong> ${paragraphs[i]}</p>`;
			if (paragraphs[i + 1]) {
				inner += `<p style="font-size:16px; line-height:1.6; margin-bottom:0;"><strong>[${i + 2}]</strong> ${paragraphs[i + 1]}</p>`;
			}

			card.innerHTML = inner;
			grid.appendChild(card);
		}

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Métrica,Valor\n";
		csv += `"Tempo Estimado de Fala","${displayTimeResult.textContent}"\n`;
		csv += `"Contagem de Palavras","${displayWordCount.textContent}"\n`;
		csv += `"Contagem de Parágrafos","${displayParagraphCount.textContent}"\n`;
		csv += `"Ritmo de Fala","${displayWpmRate.textContent} PPM"\n`;
		csv += `"Classificação","${displaySpeechZone.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Estatisticas_Discurso_Casamento.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Load Best Man template by default on first load
	speechEditor.value = sampleTemplates.bestman;
	calculateStats();
</script>
