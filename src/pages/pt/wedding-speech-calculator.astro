---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-speech-calculator/#webapp",
      "name": "Calculadora de Tempo de Discurso de Casamento & Criador de Cartões de Apoio",
      "url": "https://manage.wedding/pt/wedding-speech-calculator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de discursos de casamento 100% no navegador. Calcule o tempo de fala, contagem de palavras e ritmo com modelos para Padrinhos, Damas de Honor e Pais, cronómetro de ensaio e cartões de apoio para impressão em PDF e Word.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual deve ser a duração ideal de um discurso de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A duração ideal de um discurso de casamento situa-se entre 3 e 5 minutos (aproximadamente 400 a 650 palavras). Discursos com menos de 2 minutos parecem apressados, enquanto intervenções superiores a 6 minutos arriscam perder a atenção dos convidados."
          }
        },
        {
          "@type": "Question",
          "name": "A que velocidade em palavras por minuto (PPM) se fala num brinde de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O ritmo médio natural em apresentações orais é de 130 palavras por minuto (PPM). Esta velocidade contempla pausas naturais para respirar, risos dos convidados e contacto visual."
          }
        },
        {
          "@type": "Question",
          "name": "O texto do meu discurso permanece privado nesta ferramenta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim, 100%! Toda a análise, contagem de palavras e cronómetro decorrem estritamente no seu computador através de JavaScript local. Nenhum texto é transmitido para servidores ou ferramentas de IA externas."
          }
        },
        {
          "@type": "Question",
          "name": "Devo ler o discurso no telemóvel ou em cartões de papel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Recomenda-se vivamente o uso de cartões de papel impressos. Ler pelo telemóvel gera reflexos desagradáveis nas fotografias e no vídeo de casamento e arrisca ecrãs bloqueados a meio da leitura."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Como Cronometrar e Ensaiar um Discurso de Casamento",
      "description": "Método passo a passo para redigir, cronometrar, calibrar o ritmo e imprimir cartões de apoio para o discurso de casamento.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Escolha o Seu Papel ou Carregue um Modelo",
          "text": "Selecione o seu papel (Padrinho, Dama de Honor, Pai dos Noivos ou Votos) ou cole o seu rascunho de texto."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Aponte para a Meta de 3 a 5 Minutos (390–650 Palavras)",
          "text": "Mantenha o rascunho entre 390 e 650 palavras, garantindo um brinde conciso e envolvente à cadência de 130 PPM."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Selecione o Ritmo de Fala e Margem de Risos",
          "text": "Defina o ritmo (110 PPM para tom emocional, 130 PPM para tom padrão, 155 PPM para tom enérgico) e acrescente +30s para risos e palmas."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Ensaie em Voz Alta com o Cronómetro Interativo",
          "text": "Leia o discurso em voz alta utilizando o cronómetro de ensaio para treinar respiração e pausas naturais."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 5: Exporte Cartões de Apoio Formatados a 16pt",
          "text": "Gere cartões de leitura em Word ou PDF com letra grande e clara de 16pt para levar consigo para o púlpito."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Tempo e Discursos de Casamento | Manage.Wedding"
	description="Calcule o tempo exato e contagem de palavras do discurso de casamento. Inclui modelos para Padrinhos e Damas de Honor, cronómetro de ensaio e cartões para impressão."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Tempo de Discursos" category="stationery" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de Discursos de Casamento
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calcule o tempo exato de fala, ajuste o ritmo de entrega, pratique com um cronómetro de ensaio em tempo real e exporte <strong>Cartões de Apoio para o Púlpito</strong> em Word e PDF — <strong>100% privado, sem recurso a IA e sem chamadas a servidores externos</strong>!
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Cronometrar e Aperfeiçoar o Discurso em 3 Passos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Cole o Discurso ou Use um Modelo
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Cole o seu rascunho ou clique num dos modelos prontos (Padrinho, Dama de Honor, Pais dos Noivos ou Votos).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Ajuste o Ritmo & Ensaie
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Escolha o ritmo de leitura (110, 130 ou 155 PPM) e ensaie em voz alta com o cronómetro ao vivo.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporte Cartões de Apoio
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clique em <strong>"🖨️ Exportar PDF / Cartões"</strong> ou <strong>"📝 Exportar Word"</strong> para obter cartões com letra grande de 16pt.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Editor Form + Live Time Dashboard & Stopwatch -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="speech-calc-grid">
			
			<!-- Left Column: Speech Text Editor & Preset Loader -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
						<div>
							<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								📝 Editor do Discurso de Casamento
							</h2>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
								Análise 100% privada no navegador (nenhum dado sai do seu dispositivo)
							</span>
						</div>
						<button type="button" id="btn-clear-speech" class="hand-btn secondary" style="padding: 0.25rem 0.55rem; font-size: 0.75rem; color: #b91c1c;">
							🗑️ Limpar Texto
						</button>
					</div>
				</div>

				<!-- Quick Template Pills -->
				<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.65rem; margin-bottom: 1rem;">
					<span class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil); display: block; margin-bottom: 0.35rem;">
						⚡ Carregar Modelos de Estrutura Comprovada:
					</span>
					<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
						<button type="button" class="btn-load-template hand-btn" data-type="bestman" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; background: #eff6ff;">
							🤵 Brinde do Padrinho
						</button>
						<button type="button" class="btn-load-template hand-btn" data-type="moh" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; background: #fdf2f8;">
							💐 Dama de Honor / Madrinha
						</button>
						<button type="button" class="btn-load-template hand-btn" data-type="parent" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; background: #f0fdf4;">
							🥂 Boas-Vindas dos Pais
						</button>
						<button type="button" class="btn-load-template hand-btn" data-type="couple" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; background: #fefce8;">
							💍 Votos & Agradecimento dos Noivos
						</button>
					</div>
				</div>

				<!-- Speech Textarea -->
				<div style="margin-bottom: 1rem;">
					<label for="speech-editor" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Escreva ou Cole o Texto do Seu Discurso:
					</label>
					<textarea id="speech-editor" rows="14" placeholder="Comece a escrever o seu discurso, votos ou brinde de casamento aqui..." style="width: 100%; box-sizing: border-box; padding: 0.85rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; line-height: 1.6; background: #faf8f5; resize: vertical;"></textarea>
				</div>

				<!-- Pacing & Delivery Controls -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<div>
						<label for="select-speaking-pace" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--accent-red); margin-bottom: 0.2rem;">
							Cadência / Ritmo de Fala
						</label>
						<select id="select-speaking-pace" style="width: 100%; box-sizing: border-box; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
							<option value="110">Pausado & Emocional (110 PPM)</option>
							<option value="130" selected>Conversacional Padrão (130 PPM)</option>
							<option value="155">Rápido & Dinâmico (155 PPM)</option>
						</select>
					</div>

					<div>
						<label for="select-pause-buffer" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--accent-blue); margin-bottom: 0.2rem;">
							Margem para Risos e Palmas
						</label>
						<select id="select-pause-buffer" style="width: 100%; box-sizing: border-box; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
							<option value="0">Sem Margem (Leitura Contínua)</option>
							<option value="30" selected>+30s (Risos Moderados)</option>
							<option value="60">+60s (Discurso Humorístico / Palmas)</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Time Dashboard, Progress Bar & Live Stopwatch -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Timing Dashboard Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								⏱️ Painel de Controlo do Tempo
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Calculado à velocidade de <span id="display-wpm-rate">130</span> palavras por minuto
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Discurso (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Cartões
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Big Estimated Time Display -->
					<div style="background: #f0fdf4; border: 2.5px solid #16a34a; border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.25rem;">
						<span style="font-size: 0.88rem; color: #16a34a; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
							Tempo Estimado de Fala
						</span>
						<strong id="display-time-result" class="font-heading" style="font-size: 2.8rem; color: #166534; display: block; line-height: 1.15; margin: 0.2rem 0;">
							3m 45s
						</strong>
						<span id="display-speech-zone" style="font-size: 0.85rem; font-weight: bold; color: #15803d;">
							✅ Duração Ideal (Perfeita para casamento)
						</span>
					</div>

					<!-- Detailed Metric Numbers -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; text-align: center; margin-bottom: 1.25rem;">
						<div style="border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem; background: var(--bg-paper);">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Total Palavras</span>
							<strong id="display-word-count" style="font-size: 1.2rem; color: var(--fg-pencil);">485</strong>
						</div>

						<div style="border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem; background: var(--bg-paper);">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Parágrafos</span>
							<strong id="display-paragraph-count" style="font-size: 1.2rem; color: var(--fg-pencil);">5</strong>
						</div>

						<div style="border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem; background: var(--bg-paper);">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Cartões de Apoio</span>
							<strong id="display-cards-count" style="font-size: 1.2rem; color: var(--fg-pencil);">3 Cartões</strong>
						</div>
					</div>

					<!-- Speech Length Progress Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.25rem;">
							<span>0 min</span>
							<span style="color: #16a34a;">3 - 5 min (Ideal)</span>
							<span style="color: var(--accent-red);">7+ min (Muito Longo)</span>
						</div>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee; position: relative;">
							<div id="speech-gauge-bar" style="width: 50%; height: 100%; background: #16a34a; transition: width 0.3s ease, background-color 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Live Rehearsal Stopwatch Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem; text-align: center;">
						🎙️ Cronómetro de Ensaio em Voz Alta
					</strong>
					<p style="font-size: 0.8rem; color: var(--text-secondary); margin: 0 0 0.75rem 0; text-align: center;">
						Leia o discurso em voz alta para testar a sua velocidade real:
					</p>

					<div style="display: flex; justify-content: center; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
						<span id="stopwatch-display" style="font-family: monospace; font-size: 2rem; font-weight: bold; color: var(--fg-pencil); background: #fff; padding: 0.3rem 0.8rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px;">
							00:00.0
						</span>
					</div>

					<div style="display: flex; justify-content: center; gap: 0.4rem;">
						<button type="button" id="btn-timer-start" class="hand-btn" style="padding: 0.35rem 0.85rem; font-size: 0.85rem; background: #dcfce7; color: #166534;">
							▶️ Iniciar Ensaio
						</button>
						<button type="button" id="btn-timer-pause" class="hand-btn" style="padding: 0.35rem 0.85rem; font-size: 0.85rem; background: #fefce8; color: #854d0e; display: none;">
							⏸️ Pausa
						</button>
						<button type="button" id="btn-timer-reset" class="hand-btn secondary" style="padding: 0.35rem 0.85rem; font-size: 0.85rem;">
							🔄 Repor
						</button>
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation (Cue Cards) -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Cartões de Apoio para Discurso de Casamento</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Tempo Estimado: <span id="print-est-time"></span> | Contagem de Palavras: <span id="print-word-count"></span></p>
			</div>
			<div id="print-cue-cards-grid" style="display: flex; flex-direction: column; gap: 20px;"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Resumo Rápido (BLUF)</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Regra de Ouro: Duração e Palavras do Discurso
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>A Fórmula de 1 Minuto:</strong> A duração perfeita para qualquer brinde de casamento é de <strong>3 a 5 minutos</strong>, o que equivale a <strong>390 a 650 palavras</strong> a um ritmo natural de <strong>120–130 Palavras por Minuto (PPM)</strong>. Menos de 2 minutos parece curto demais, enquanto discursos com mais de 6 minutos arriscam arrefecer os pratos e dispersar a sala.
			</p>
			
			<!-- Benchmark Duration Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Duração do Discurso</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Palavras (130 PPM Padrão)</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Palavras (110 PPM Emocional)</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Papel Recomendado</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Impacto na Sala</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">1–2 Minutos</td>
