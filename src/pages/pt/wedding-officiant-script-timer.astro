  // Teleprompter
  const teleprompterModal = document.getElementById('teleprompter-modal');
  const btnOpenTp = document.getElementById('btn-open-teleprompter');
  const btnCloseTp = document.getElementById('btn-close-teleprompter');
  const tpTitle = document.getElementById('tp-phase-title');
  const tpCounter = document.getElementById('tp-phase-counter');
  const tpTextBody = document.getElementById('tp-text-body');
  const tpTimerDisplay = document.getElementById('tp-timer-display');
  const tpTotalTimerDisplay = document.getElementById('tp-total-timer-display');
  const tpBtnStart = document.getElementById('tp-btn-start');
  const tpBtnPause = document.getElementById('tp-btn-pause');
  const tpBtnReset = document.getElementById('tp-btn-reset');
  const tpBtnPrev = document.getElementById('tp-btn-prev');
  const tpBtnNext = document.getElementById('tp-btn-next');
  const tpProgressDots = document.getElementById('tp-progress-dots');

  let tpCurrentIndex = 0;
  let tpInterval = null;
  let tpPhaseStartTime = 0;
  let tpPhaseElapsed = 0;
  let tpTotalElapsed = 0;
  let tpIsRunning = false;

  function formatStopwatch(ms) {
    const sec = Math.floor(ms / 1000);
    const m = Math.floor(sec / 60).toString().padStart(2, '0');
    const s = (sec % 60).toString().padStart(2, '0');
    const tenth = Math.floor((ms % 1000) / 100);
    return `${m}:${s}.${tenth}`;
  }

  function formatStopwatchSimple(ms) {
    const sec = Math.floor(ms / 1000);
    const m = Math.floor(sec / 60).toString().padStart(2, '0');
    const s = (sec % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  }

  function loadTeleprompterPhase(index) {
    tpCurrentIndex = index;
    const phase = phasesState[tpCurrentIndex];
    if (!phase) return;

    tpTitle.textContent = `Fase ${phase.id}: ${phase.title}`;
    const pace = parseInt(selectPace.value, 10) || 120;
    const clean = getCleanText(phase.text);
    const words = countWords(clean);
    const estSec = Math.round((words / pace) * 60) + (parseInt(phase.durationAction, 10) || 0);

    tpCounter.textContent = `Fase ${phase.id} de 9 • Meta Estimada: ${formatTime(estSec)}`;
    tpProgressDots.textContent = `${phase.id} / 9`;

    let formattedHtml = clean
      .replace(/\n\n/g, '<br/><br/>')
      .replace(/\[(.*?)\]/g, '<span style="background:#e2e8f0; color:#0f172a; padding:2px 6px; border-radius:4px; font-size:1.1rem; font-weight:bold; display:inline-block; margin:4px 0;">[$1]</span>');

    tpTextBody.innerHTML = formattedHtml;
    tpTextBody.scrollTop = 0;

    tpBtnPrev.disabled = tpCurrentIndex === 0;
    tpBtnNext.disabled = tpCurrentIndex === phasesState.length - 1;
    tpBtnPrev.style.opacity = tpCurrentIndex === 0 ? '0.5' : '1';
    tpBtnNext.style.opacity = tpCurrentIndex === phasesState.length - 1 ? '0.5' : '1';
  }

  btnOpenTp.addEventListener('click', () => {
    teleprompterModal.style.display = 'flex';
    loadTeleprompterPhase(0);
  });

  btnCloseTp.addEventListener('click', () => {
    teleprompterModal.style.display = 'none';
    if (tpIsRunning) {
      clearInterval(tpInterval);
      tpIsRunning = false;
      tpBtnStart.style.display = 'inline-block';
      tpBtnPause.style.display = 'none';
    }
  });

  tpBtnStart.addEventListener('click', () => {
    if (!tpIsRunning) {
      tpIsRunning = true;
      tpPhaseStartTime = Date.now() - tpPhaseElapsed;
      tpInterval = setInterval(() => {
        tpPhaseElapsed = Date.now() - tpPhaseStartTime;
        tpTotalElapsed += 100;
        tpTimerDisplay.textContent = formatStopwatch(tpPhaseElapsed);
        tpTotalTimerDisplay.textContent = formatStopwatchSimple(tpTotalElapsed);
      }, 100);
      tpBtnStart.style.display = 'none';
      tpBtnPause.style.display = 'inline-block';
    }
  });

  tpBtnPause.addEventListener('click', () => {
    if (tpIsRunning) {
      tpIsRunning = false;
      clearInterval(tpInterval);
      tpBtnStart.style.display = 'inline-block';
      tpBtnPause.style.display = 'none';
    }
  });

  tpBtnReset.addEventListener('click', () => {
    tpIsRunning = false;
    clearInterval(tpInterval);
    tpPhaseElapsed = 0;
    tpTotalElapsed = 0;
    tpTimerDisplay.textContent = '00:00.0';
    tpTotalTimerDisplay.textContent = '00:00';
    tpBtnStart.style.display = 'inline-block';
    tpBtnPause.style.display = 'none';
  });

  tpBtnPrev.addEventListener('click', () => {
    if (tpCurrentIndex > 0) {
      tpPhaseElapsed = 0;
      tpTimerDisplay.textContent = '00:00.0';
      if (tpIsRunning) tpPhaseStartTime = Date.now();
      loadTeleprompterPhase(tpCurrentIndex - 1);
    }
  });

  tpBtnNext.addEventListener('click', () => {
    if (tpCurrentIndex < phasesState.length - 1) {
      tpPhaseElapsed = 0;
      tpTimerDisplay.textContent = '00:00.0';
      if (tpIsRunning) tpPhaseStartTime = Date.now();
      loadTeleprompterPhase(tpCurrentIndex + 1);
    }
  });

  // Export Word
  document.getElementById('btn-export-doc').addEventListener('click', () => {
    const partnerA = inputPartnerA.value.trim() || 'Noivo/a A';
    const partnerB = inputPartnerB.value.trim() || 'Noivo/a B';
    const officiant = inputOfficiant.value.trim() || 'Celebrante';
    const pace = parseInt(selectPace.value, 10) || 120;

    let phasesHtml = '';
    phasesState.forEach(p => {
      const clean = getCleanText(p.text);
      const words = countWords(clean);
      const spokenSec = Math.round((words / pace) * 60);
      const actionSec = parseInt(p.durationAction, 10) || 0;
      const totalSec = spokenSec + actionSec;

      const paragraphs = clean.split('\n\n').filter(t => t.trim().length > 0);
      let pTags = '';
      paragraphs.forEach(par => {
        pTags += `<p style="font-size:14pt; line-height:1.7; margin-bottom:12pt; color:#111;">${par.replace(/\[(.*?)\]/g, '<strong style="color:#0f172a; background:#e2e8f0; padding:2pt 4pt;">[$1]</strong>')}</p>`;
      });

      phasesHtml += `
        <div style="border: 2pt solid #000; padding: 18pt; margin-bottom: 25pt; page-break-inside: avoid;">
          <div style="border-bottom: 1pt solid #000; padding-bottom: 6pt; margin-bottom: 12pt; font-size: 11pt; font-weight: bold; text-transform: uppercase;">
            <span>FICHA ${p.id} DE 9 — ${p.title}</span> | 
            <span>TEMPO ESTIMADO: ${formatTime(totalSec)}</span> | 
            <span>${words} PALAVRAS</span>
          </div>
          ${pTags}
        </div>
      `;
    });

    const docHtml = `
      <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
      <head>
        <meta charset="utf-8">
        <title>Roteiro de Cerimónia - ${partnerA} & ${partnerB}</title>
        <style>
          body { font-family: 'Times New Roman', Georgia, serif; padding: 25pt; font-size: 14pt; }
          h1 { color: #1e3a8a; font-size: 20pt; margin-bottom: 4pt; }
          .meta-box { border: 1pt solid #cbd5e1; background: #f8fafc; padding: 10pt; font-size: 10pt; margin-bottom: 20pt; color: #334155; }
        </style>
      </head>
      <body>
        <h1>Discurso e Roteiro do Celebrante — ${partnerA} & ${partnerB}</h1>
        <div class="meta-box">
          <strong>Celebrante:</strong> ${officiant} | 
          <strong>Duração Total Estimada:</strong> ${displayTotalRuntime.textContent} | 
          <strong>Cadência:</strong> ${pace} PPM | 
          <strong>Estilo:</strong> ${ceremonyPresets[currentPresetKey]?.name || 'Personalizado'}
        </div>
        ${phasesHtml}
      </body>
      </html>
    `;

    const blob = new Blob(['\ufeff', docHtml], { type: 'application/msword' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Roteiro_Celebrante_${partnerA}_${partnerB}_${new Date().toISOString().slice(0, 10)}.doc`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  // Export PDF
  document.getElementById('btn-export-pdf').addEventListener('click', () => {
    const listContainer = document.getElementById('print-cue-cards-list');
    listContainer.innerHTML = '';
    const pace = parseInt(selectPace.value, 10) || 120;

    phasesState.forEach(p => {
      const clean = getCleanText(p.text);
      const words = countWords(clean);
      const spokenSec = Math.round((words / pace) * 60);
      const actionSec = parseInt(p.durationAction, 10) || 0;
      const totalSec = spokenSec + actionSec;

      const card = document.createElement('div');
      card.className = 'cue-card-page';

      const paragraphs = clean.split('\n\n').filter(t => t.trim().length > 0);
      let bodyHtml = '';
      paragraphs.forEach(par => {
        bodyHtml += `<p style="margin-bottom: 12px; font-size: 14pt; line-height: 1.6;">${par.replace(/\[(.*?)\]/g, '<span class="cue-card-stage-dir">[$1]</span>')}</p>`;
      });

      card.innerHTML = `
        <div class="cue-card-header">
          <span>FICHA ${p.id} DE 9 • ${p.title}</span>
          <span>ESTIMATIVA: ${formatTime(totalSec)} (${words} PALAVRAS)</span>
        </div>
        <div class="cue-card-body">
          ${bodyHtml}
        </div>
      `;

      listContainer.appendChild(card);
    });

    window.print();
  });

  // Copy text
  document.getElementById('btn-copy-script').addEventListener('click', () => {
    const partnerA = inputPartnerA.value.trim() || 'Noivo/a A';
    const partnerB = inputPartnerB.value.trim() || 'Noivo/a B';
    const officiant = inputOfficiant.value.trim() || 'Celebrante';

    let fullText = `ROTEIRO DE CERIMÓNIA NUPCIAL: ${partnerA} & ${partnerB}\n`;
    fullText += `Celebrante: ${officiant} | Duração Estimada: ${displayTotalRuntime.textContent}\n`;
    fullText += `====================================================\n\n`;

    phasesState.forEach(p => {
      fullText += `--- FASE ${p.id}: ${p.title.toUpperCase()} ---\n`;
      fullText += `${getCleanText(p.text)}\n\n`;
    });

    navigator.clipboard.writeText(fullText).then(() => {
      const btn = document.getElementById('btn-copy-script');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span>✅</span> <strong>Copiado!</strong>';
      setTimeout(() => {
        btn.innerHTML = originalText;
      }, 2000);
    });
  });

  renderPhases();
</script>
