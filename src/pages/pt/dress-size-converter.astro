---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Conversor de Tamanhos de Vestido de Noiva & Calculadora de Medidas",
      "url": "https://manage.wedding/pt/dress-size-converter",
      "inLanguage": "pt",
      "description": "Conversor gratuito de tamanhos de vestidos de noiva. Calcule o seu tamanho ideal em tabelas Europeias (EU/PT/ES), Reino Unido (UK) e EUA (US) a partir das medidas de peito, cintura e anca, descubra cortes favorecedores e exporte o seu cartão de medidas.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Por que razão o tamanho do vestido de noiva é superior ao tamanho de roupa habitual?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As marcas de noiva ainda utilizam tabelas de medidas europeias tradicionais concebidas nos anos 50, com tecidos estruturados e sem elasticidade. Enquanto o pronto-a-vestir moderno adotou o 'vanity sizing' (tamanhos mais generosos), a moda nupcial manteve as medidas clássicas. Por isso, é perfeitamente normal que o vestido de noiva seja 1 a 2 números superior ao seu tamanho normal de calças ou vestidos."
          }
        },
        {
          "@type": "Question",
          "name": "Que medida devo priorizar ao encomendar o vestido de noiva?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Deve SEMPRE encomendar o tamanho correspondente à sua maior medida individual (entre peito, cintura e anca). É muito simples e seguro para uma costureira apertar um vestido onde fica largo, mas é extremamente difícil ou impossível alargar um vestido apertado devido às escassas margens de tecido interiores."
          }
        },
        {
          "@type": "Question",
          "name": "Como tirar as medidas corporais com precisão para o vestido?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Utilize uma fita métrica de costura maleável: 1) Peito: na zona de maior projeção do busto, com a lingerie que vai usar no dia. 2) Cintura: no ponto mais estreito do tronco (2 a 4 cm acima do umbigo). 3) Anca: na zona mais saliente dos glúteos com os pés juntos."
          }
        },
        {
          "@type": "Question",
          "name": "Todas as marcas de vestidos de noiva utilizam a mesma tabela de tamanhos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. Casas de alta costura europeias (como Pronovias ou Rosa Clará) têm cortes mais justos nas costelas e anca, enquanto marcas norte-americanas aproximam-se mais dos tamanhos modernos. O nosso conversor permite ajustar o cálculo conforme o estilo da marca."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Como Tirar Medidas e Converter o Tamanho do Vestido de Noiva",
      "description": "Instruções passo a passo para medir o peito, cintura e anca e converter tamanhos comuns para as normas Europeias, UK e US.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Meça os 3 Pontos Fundamentais do Corpo",
          "text": "Com uma fita métrica maleável, meça o contorno do peito, a cintura natural no ponto mais estreito e a anca na linha mais larga dos glúteos."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Compare com as Tabelas Internacionais de Noiva",
          "text": "Cruze as suas medidas em centímetros ou polegadas com as dimensões oficiais dos fabricantes de vestidos de noiva."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Encomende Sempre pelo Tamanho da Maior Medida",
          "text": "Selecione o tamanho que acomoda confortavelmente a sua maior medida. Os ateliers apertam facilmente o excesso nas restantes zonas."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Contemple a Diferença Face ao Pronto-a-Vestir",
          "text": "Conte com um número de etiqueta 1 a 2 tamanhos acima do que veste em marcas de moda de rua comuns."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 5: Exporte o Cartão de Medidas de Atelier",
          "text": "Guarde a sua ficha de medidas em Word (.doc) ou PDF para levar às provas nas lojas de noiva e ateliers de costura."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Conversor de Tamanhos de Vestido de Noiva (Tabela Internacional & Medidas) | Manage.Wedding"
	description="Converta medidas de peito, cintura e anca para tamanhos de vestidos de noiva de Portugal, Espanha, Europa (EU), UK e US. Exporte o seu cartão de medidas."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Conversor de Tamanhos de Vestido de Noiva
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 1rem auto 0;">
					Descubra o seu tamanho de noiva ideal nas normas Europeias (PT/ES/FR), Reino Unido (UK) e EUA (US). Compare roupa comum vs. noiva, descubra cortes favorecedores e exporte o seu <strong>Cartão de Medidas de Atelier</strong>.
				</p>
			</div>
		</section>

		<!-- Main Interactive Sizing Studio Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 380px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="dress-calc-grid">
			
			<!-- Left Column: Input Form Card -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						📏 Medidas Corporais
					</h2>
					
					<!-- Unit Switcher -->
					<div style="display: flex; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden;">
						<button type="button" id="unit-cm" class="unit-toggle-btn active-unit">cm</button>
						<button type="button" id="unit-in" class="unit-toggle-btn">Polegadas (in)</button>
					</div>
				</div>

				<form id="dress-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Bust -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-bust" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								1. Peito / Busto (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Com soutien de casamento</span>
						</div>
						<input type="number" step="0.5" id="input-bust" value="91.5" min="50" max="180" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Waist -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-waist" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								2. Cintura Natural (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Ponto mais estreito</span>
						</div>
						<input type="number" step="0.5" id="input-waist" value="71.0" min="40" max="160" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Hips -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-hips" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								3. Anca (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Ponto mais saliente</span>
						</div>
						<input type="number" step="0.5" id="input-hips" value="99.0" min="50" max="200" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Designer Preference -->
					<div>
						<label for="input-designer" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							Estilo de Corte / Marca de Noiva
						</label>
						<select id="input-designer" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="standard" selected>Média Padrão da Indústria de Noiva</option>
							<option value="couture">Alta Costura Europeia (Pronovias / Rosa Clará - Mais Justo)</option>
							<option value="davids">Prêt-à-Porter Americano (David's Bridal / BHLDN)</option>
							<option value="maggie">Maggie Sottero / Essense of Australia</option>
						</select>
					</div>

					<!-- Sample Presets -->
					<div style="margin-top: 0.5rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
						<span class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							⚡ Exemplos de Medidas Frequentes:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem;">
							<button type="button" class="preset-meas-btn" data-b="86.5" data-w="66.0" data-h="94.0">Tam. 36/38 (86-66-94)</button>
							<button type="button" class="preset-meas-btn" data-b="95.0" data-w="75.0" data-h="103.0">Tam. 40/42 (95-75-103)</button>
							<button type="button" class="preset-meas-btn" data-b="109.0" data-w="89.0" data-h="117.0">Tam. 46/48 (109-89-117)</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Interactive Results, Sizing Badges, International Matrix & Silhouette Guide -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Sizing Results Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								👗 O Seu Tamanho de Noiva Recomendado
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								Calculado para servir confortavelmente na sua maior medida
							</span>
						</div>

						<!-- Exports -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
						</div>
					</div>

					<!-- Side by Side Sizing Comparison Boxes -->
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Street Size -->
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Roupa de Dia a Dia</span>
							<strong id="res-street-size" class="font-heading" style="font-size: 2.4rem; color: var(--accent-blue); display: block; line-height: 1.2;">Tam. 36</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Pronto-a-vestir comum</span>
						</div>

						<!-- Primary Bridal Size -->
						<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1rem; text-align: center; position: relative;">
							<span style="position: absolute; top: -10px; right: 10px; background: var(--accent-red); color: #fff; font-size: 0.7rem; font-weight: bold; padding: 2px 6px; border-radius: 10px;">ENCOMENDE ESTE</span>
							<span class="font-body" style="font-size: 0.85rem; color: var(--accent-red); display: block; font-weight: bold;">Tamanho de Noiva (EU)</span>
							<strong id="res-bridal-size" class="font-heading" style="font-size: 2.4rem; color: var(--accent-red); display: block; line-height: 1.2;">EU 40</strong>
							<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold;">+1 a 2 tamanhos (Normal)</span>
						</div>

						<!-- Body Shape Archetype -->
						<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Silhueta Corporal</span>
							<strong id="res-body-shape" class="font-heading" style="font-size: 1.3rem; color: #15803d; display: block; line-height: 1.3; margin: 0.4rem 0;">Ampulheta</strong>
							<span id="res-shape-desc" style="font-size: 0.75rem; color: #166534; display: block;">Peito e anca proporcionais</span>
						</div>

					</div>

					<!-- Visual Comparison Bar -->
					<div style="margin-bottom: 1.5rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
							<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Desfasamento entre Roupa Comum e Noiva</span>
							<span id="size-diff-note" class="font-body" style="font-size: 0.85rem; color: var(--accent-red); font-weight: bold;">+2 Tamanhos Acima</span>
						</div>
						<div style="display: flex; flex-direction: column; gap: 0.5rem;">
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="width: 80px; font-size: 0.85rem; font-weight: bold;">Comum:</span>
								<div style="flex: 1; height: 18px; background: #e5e7eb; border-radius: 4px; border: 1px solid var(--fg-pencil); overflow: hidden;">
									<div id="bar-street" style="height: 100%; width: 30%; background: var(--accent-blue); transition: width 0.4s ease;"></div>
								</div>
								<span id="bar-label-street" style="width: 65px; font-size: 0.85rem; font-weight: bold;">EU 36</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="width: 80px; font-size: 0.85rem; font-weight: bold; color: var(--accent-red);">Noiva:</span>
								<div style="flex: 1; height: 18px; background: #e5e7eb; border-radius: 4px; border: 1px solid var(--fg-pencil); overflow: hidden;">
									<div id="bar-bridal" style="height: 100%; width: 45%; background: var(--accent-red); transition: width 0.4s ease;"></div>
								</div>
								<span id="bar-label-bridal" style="width: 65px; font-size: 0.85rem; font-weight: bold; color: var(--accent-red);">EU 40</span>
							</div>
						</div>
					</div>

					<!-- International Conversion Matrix Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🌐 Matriz Internacional de Tamanhos Nupciais
						</h4>
						<div style="overflow-x: auto;">
							<table style="width: 100%; border-collapse: collapse; text-align: center; font-size: 0.95rem; font-family: var(--font-body);">
								<thead>
									<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Região</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Europa (PT/ES/FR)</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Itália (IT)</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Reino Unido (UK)</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">EUA (US)</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Austrália (AU)</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">O Seu Tamanho</td>
										<td id="matrix-eu" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">40</td>
										<td id="matrix-it" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">44</td>
										<td id="matrix-uk" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">12</td>
										<td id="matrix-us" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">10</td>
										<td id="matrix-au" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">12</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>

					<!-- Measurement Anchor Alert & Alteration Guidance -->
					<div style="background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<strong class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							✂️ Recomendação de Encomenda & Costura de Atelier:
						</strong>
						<p id="alteration-advice-text" class="font-body" style="font-size: 0.95rem; margin: 0; line-height: 1.5; color: var(--fg-pencil);">
							A sua maior medida individual é a anca (Tamanho EU 40). Encomende sempre o tamanho 40 para garantir que o fecho fecha confortavelmente. A costureira poderá facilmente apertar o busto e a cintura durante as provas.
						</p>
					</div>

				</div>

				<!-- Flattering Gown Silhouette Recommendations Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
						<span>✨</span> Silhuetas de Vestido Recomendadas para a Sua Estrutura
					</h3>
					<div id="silhouette-cards-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
						<!-- Injected via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Cartão Oficial de Medidas de Noiva</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado a: <span id="print-date"></span> | Pronto para a Consultora de Loja & Costureira</p>
			</div>
			
			<table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 8px; text-align: left;">Zona Medida</th>
						<th style="border: 1px solid #ccc; padding: 8px; text-align: center;">Medida da Noiva</th>
						<th style="border: 1px solid #ccc; padding: 8px; text-align: center;">Notas de Ajuste</th>
					</tr>
				</thead>
				<tbody id="print-meas-body"></tbody>
			</table>

			<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px; background: #fafafa;">
				<h3 style="margin: 0 0 8px 0; font-size: 15px;">Recomendações Oficiais de Tamanho:</h3>
				<p style="margin: 4px 0;">• <strong>Tamanho Recomendado a Encomendar:</strong> <span id="print-rec-size"></span></p>
				<p style="margin: 4px 0;">• <strong>Tamanho Habitual de Pronto-a-Vestir:</strong> <span id="print-street-size"></span></p>
				<p style="margin: 4px 0;">• <strong>Silhueta Corporal:</strong> <span id="print-body-shape"></span></p>
				<p style="margin: 4px 0;">• <strong>Conselho de Atelier:</strong> <span id="print-alteration-note"></span></p>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Resumo Direto ao Assunto</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
