	let currentUnit = 'cm'; // default to cm in Portuguese

	const bustInput = document.getElementById('input-bust');
	const waistInput = document.getElementById('input-waist');
	const hipsInput = document.getElementById('input-hips');
	const designerSelect = document.getElementById('input-designer');

	const resStreet = document.getElementById('res-street-size');
	const resBridal = document.getElementById('res-bridal-size');
	const resBodyShape = document.getElementById('res-body-shape');
	const resShapeDesc = document.getElementById('res-shape-desc');

	const barStreet = document.getElementById('bar-street');
	const barBridal = document.getElementById('bar-bridal');
	const barLabelStreet = document.getElementById('bar-label-street');
	const barLabelBridal = document.getElementById('bar-label-bridal');
	const sizeDiffNote = document.getElementById('size-diff-note');

	const matrixUs = document.getElementById('matrix-us');
	const matrixUk = document.getElementById('matrix-uk');
	const matrixEu = document.getElementById('matrix-eu');
	const matrixAu = document.getElementById('matrix-au');
	const matrixIt = document.getElementById('matrix-it');

	const alterationText = document.getElementById('alteration-advice-text');
	const silhouetteContainer = document.getElementById('silhouette-cards-container');

	function toInches(val) {
		return currentUnit === 'cm' ? val / 2.54 : val;
	}

	function calculateSizing() {
		let rawB = parseFloat(bustInput.value) || 91.5;
		let rawW = parseFloat(waistInput.value) || 71.0;
		let rawH = parseFloat(hipsInput.value) || 99.0;

		const bIn = toInches(rawB);
		const wIn = toInches(rawW);
		const hIn = toInches(rawH);

		// Find size for each measurement
		let bustSizeObj = sizeChartInches.find(s => bIn <= s.bust) || sizeChartInches[sizeChartInches.length - 1];
		let waistSizeObj = sizeChartInches.find(s => wIn <= s.waist) || sizeChartInches[sizeChartInches.length - 1];
		let hipSizeObj = sizeChartInches.find(s => hIn <= s.hip) || sizeChartInches[sizeChartInches.length - 1];

		// Maximum size needed to fit largest measurement
		const maxBridalSize = Math.max(bustSizeObj.bridal, waistSizeObj.bridal, hipSizeObj.bridal);
		const matchedObj = sizeChartInches.find(s => s.bridal === maxBridalSize) || sizeChartInches[sizeChartInches.length - 1];

		// Designer adjustments
		let adjustedBridal = maxBridalSize;
		const designer = designerSelect.value;
		if (designer === 'couture') {
			adjustedBridal = Math.min(30, maxBridalSize + 2); // runs small
		} else if (designer === 'davids') {
			adjustedBridal = Math.max(2, maxBridalSize - 2); // runs true to street
