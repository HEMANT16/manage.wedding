			silhouettes = [
				{ name: 'Princesa / Baile', desc: 'A saia volumosa flutua sobre a anca e destaca a cintura.' },
				{ name: 'Linha em A Fluida / Império', desc: 'Desvia o foco para o decote e corpete trabalhado.' }
			];
		} else if (bIn >= hIn + 2) {
			shape = 'Triângulo Invertido';
			shapeDetail = 'Busto ou ombros mais largos do que a anca';
			silhouettes = [
				{ name: 'Corte em A com Decote em V', desc: 'Alongar o tronco e equilibra a proporção entre ombros e anca.' },
				{ name: 'Vestido de Baile com Pregas', desc: 'Acrescenta volume à saia para uma simetria perfeita.' }
			];
		} else if (Math.abs(bIn - hIn) <= 2 && (bIn - wIn) <= 6) {
			shape = 'Retângulo / Atlético';
			shapeDetail = 'Medidas homogéneas com curva de cintura subtil';
			silhouettes = [
				{ name: 'Fit-and-Flare Estruturado', desc: 'Cria a ilusão ótica de curvas no busto e anca.' },
				{ name: 'Corpete com Espartilho', desc: 'Define e molda a cintura com barbatanas estruturadas.' }
			];
		}

		// Update UI
		resStreet.textContent = `Tam. ${streetSizeVal}`;
		resBridal.textContent = `EU ${euBridalSize}`;
		resBodyShape.textContent = shape;
		resShapeDesc.textContent = shapeDetail;

		// Progress Comparison Bars
		const maxScale = 60;
		const streetNum = parseInt(streetSizeVal) || 36;
		const streetPct = Math.min(100, Math.round((streetNum / maxScale) * 100));
		const bridalPct = Math.min(100, Math.round((euBridalSize / maxScale) * 100));

		barStreet.style.width = `${streetPct}%`;
		barBridal.style.width = `${bridalPct}%`;
		barLabelStreet.textContent = `EU ${streetSizeVal}`;
		barLabelBridal.textContent = `EU ${euBridalSize}`;

		const diff = Math.round((euBridalSize - streetNum) / 2);
		sizeDiffNote.textContent = diff > 0 ? `+${diff} Tamanhos Acima da Roupa Comum` : 'Corte Próximo da Roupa Comum';

		// International Matrix
		matrixEu.textContent = `${euBridalSize}`;
		matrixIt.textContent = `${adjustedBridal + 34}`; // IT 44 for EU 40
		matrixUk.textContent = `${adjustedBridal + 2}`; // UK 12 for EU 40
		matrixUs.textContent = `${adjustedBridal}`; // US 10 for EU 40
		matrixAu.textContent = `${adjustedBridal + 2}`; // AU 12

		// Alteration Advice Note
		let anchor = 'anca';
		if (bustSizeObj.bridal >= waistSizeObj.bridal && bustSizeObj.bridal >= hipSizeObj.bridal) anchor = 'peito/busto';
		else if (waistSizeObj.bridal >= bustSizeObj.bridal && waistSizeObj.bridal >= hipSizeObj.bridal) anchor = 'cintura';

		alterationText.innerHTML = `
			A sua maior medida individual é o/a <strong>${anchor} (Tamanho EU ${euBridalSize})</strong>. Encomende o <strong>Tamanho EU ${euBridalSize}</strong> para que o vestido feche com total conforto. A costureira poderá facilmente apertar o tecido em excesso nas restantes zonas durante as provas de atelier.
		`;

		// Silhouettes
		silhouetteContainer.innerHTML = '';
		silhouettes.forEach(s => {
			const div = document.createElement('div');
			div.className = 'silhouette-card';
			div.innerHTML = `
				<h5>✨ ${s.name}</h5>
				<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">${s.desc}</p>
			`;
			silhouetteContainer.appendChild(div);
		});
	}

	// Unit Switcher
	document.getElementById('unit-in').addEventListener('click', () => {
		if (currentUnit === 'in') return;
		currentUnit = 'in';
		document.getElementById('unit-in').classList.add('active-unit');
		document.getElementById('unit-cm').classList.remove('active-unit');
		document.querySelectorAll('.unit-label').forEach(el => el.textContent = 'polegadas');

		bustInput.value = (parseFloat(bustInput.value) / 2.54).toFixed(1);
		waistInput.value = (parseFloat(waistInput.value) / 2.54).toFixed(1);
		hipsInput.value = (parseFloat(hipsInput.value) / 2.54).toFixed(1);
		calculateSizing();
	});

	document.getElementById('unit-cm').addEventListener('click', () => {
		if (currentUnit === 'cm') return;
		currentUnit = 'cm';
		document.getElementById('unit-cm').classList.add('active-unit');
		document.getElementById('unit-in').classList.remove('active-unit');
		document.querySelectorAll('.unit-label').forEach(el => el.textContent = 'cm');

		bustInput.value = (parseFloat(bustInput.value) * 2.54).toFixed(1);
		waistInput.value = (parseFloat(waistInput.value) * 2.54).toFixed(1);
		hipsInput.value = (parseFloat(hipsInput.value) * 2.54).toFixed(1);
		calculateSizing();
	});

	// Presets
	document.querySelectorAll('.preset-meas-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			let b = parseFloat(btn.getAttribute('data-b'));
			let w = parseFloat(btn.getAttribute('data-w'));
			let h = parseFloat(btn.getAttribute('data-h'));

			if (currentUnit === 'in') {
				b = (b / 2.54).toFixed(1);
				w = (w / 2.54).toFixed(1);
				h = (h / 2.54).toFixed(1);
			}

			bustInput.value = b;
			waistInput.value = w;
			hipsInput.value = h;
			calculateSizing();
		});
	});

	// Input listeners
	bustInput.addEventListener('input', calculateSizing);
	waistInput.addEventListener('input', calculateSizing);
	hipsInput.addEventListener('input', calculateSizing);
	designerSelect.addEventListener('change', calculateSizing);

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const rawB = bustInput.value;
		const rawW = waistInput.value;
		const rawH = hipsInput.value;
		const unit = currentUnit === 'in' ? 'polegadas' : 'cm';

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Ficha de Medidas e Tamanhos de Noiva</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Cartão Oficial de Medidas da Noiva</h1>
				<p>Gerado a ${new Date().toLocaleDateString('pt-PT')} | Pronto para a Consultora de Loja e Atelier de Costura</p>
				
				<h3>Medidas Corporais da Noiva:</h3>
				<table>
					<thead>
						<tr><th>Zona Medida</th><th>Valor Medido</th><th>Observações</th></tr>
					</thead>
					<tbody>
						<tr><td><strong>Peito / Busto</strong></td><td>${rawB} ${unit}</td><td>Medido com a lingerie de casamento prevista</td></tr>
						<tr><td><strong>Cintura Natural</strong></td><td>${rawW} ${unit}</td><td>Medido no ponto mais estreito do tronco</td></tr>
						<tr><td><strong>Anca</strong></td><td>${rawH} ${unit}</td><td>Medido na zona mais saliente dos glúteos</td></tr>
					</tbody>
				</table>

				<h3 style="margin-top:20px;">Resumo dos Tamanhos Recomendados:</h3>
				<table>
					<thead>
						<tr><th>Norma / Região</th><th>Tamanho</th><th>Detalhes</th></tr>
					</thead>
					<tbody>
						<tr><td><strong>Tamanho de Noiva Recomendado (EU)</strong></td><td><strong>${resBridal.textContent}</strong></td><td>Calculado para acomodar a maior medida</td></tr>
						<tr><td><strong>Roupa de Dia a Dia</strong></td><td>${resStreet.textContent}</td><td>Pronto-a-vestir comum</td></tr>
						<tr><td><strong>Tamanho UK (Reino Unido)</strong></td><td>UK ${matrixUk.textContent}</td><td>Norma britânica</td></tr>
						<tr><td><strong>Tamanho US (EUA)</strong></td><td>US ${matrixUs.textContent}</td><td>Norma norte-americana</td></tr>
						<tr><td><strong>Silhueta Corporal</strong></td><td>${resBodyShape.textContent}</td><td>${resShapeDesc.textContent}</td></tr>
					</tbody>
				</table>

				<p style="margin-top:20px; font-size:12px; color:#666;">Nota: Confirme sempre a tabela de medidas específica do criador antes de efetuar a encomenda formal.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Ficha_Medidas_Noiva_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const printDate = document.getElementById('print-date');
		const printMeasBody = document.getElementById('print-meas-body');
		const printRecSize = document.getElementById('print-rec-size');
		const printStreetSize = document.getElementById('print-street-size');
		const printBodyShape = document.getElementById('print-body-shape');
		const printAlterationNote = document.getElementById('print-alteration-note');

		printDate.textContent = new Date().toLocaleDateString('pt-PT');
		const unit = currentUnit === 'in' ? 'polegadas' : 'cm';

		printMeasBody.innerHTML = `
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">1. Peito / Busto</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${bustInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Com a lingerie de casamento</td>
			</tr>
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">2. Cintura Natural</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${waistInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Ponto mais estreito do tronco</td>
			</tr>
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">3. Anca</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${hipsInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Curva máxima dos glúteos</td>
			</tr>
		`;

		printRecSize.textContent = `${resBridal.textContent} (UK ${matrixUk.textContent} / US ${matrixUs.textContent})`;
		printStreetSize.textContent = resStreet.textContent;
		printBodyShape.textContent = `${resBodyShape.textContent} (${resShapeDesc.textContent})`;
		printAlterationNote.textContent = alterationText.textContent;

		window.print();
	});

	// Initialize
	calculateSizing();
</script>
