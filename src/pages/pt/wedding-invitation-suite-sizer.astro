---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-invitation-suite-sizer/#webapp",
      "name": "Dimensionador de Papelaria e Conjuntos de Convite de Casamento",
      "url": "https://manage.wedding/pt/wedding-invitation-suite-sizer",
      "inLanguage": "pt",
      "description": "Calcule dimensões exatas, margens de corte e folgas de envelopes para conjuntos de convites de casamento. Tabelas de formatos para A7, A2, A5, C5, envelopes quadrados e especificações de sangria a 300 DPI para Canva e tipografia.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Dimensionar e Sobrepor as Camadas do Convite de Casamento",
      "description": "Guia passo a passo para calcular envelopes, bases em cartolina e cartões suplementares com margens de corte perfeitas de 3 mm.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Escolha o Tamanho do Envelope Exterior",
          "text": "O padrão universal é o envelope A7 (133 × 184 mm / 5.25\" × 7.25\") ou envelope C5 (162 × 229 mm) para cartões A5."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Calcule a Base de Cartolina e a Margem Visível",
          "text": "Se usar uma base contrastante de fundo, dimensione a base para 127 × 178 mm (5\" × 7\") e corte o convite impresso a 121 × 172 mm para revelar uma margem elegante de 3 mm."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Dimensione o Cartão de RSVP e Envelope de Resposta",
          "text": "Crie o cartão de RSVP a 89 × 127 mm (3.5\" × 5\") para caber perfeitamente no envelope de retorno A2 (111 × 146 mm)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Adicione 3 mm de Sangria de Impressão (300 DPI)",
          "text": "No Canva, Photoshop ou Illustrator, adicione 3 mm de sangria em todos os lados para evitar margens brancas indesejadas no corte profissional."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual é a dimensão padrão para um convite de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O tamanho padrão mais comum internacionalmente é 127 × 178 mm (5\" × 7\"), concebido para envelopes A7. Na Europa, o formato A5 (148 × 210 mm) com envelope C5 (162 × 229 mm) também é muito popular."
          }
        },
        {
          "@type": "Question",
          "name": "Que tamanho de envelope deve levar um convite de 13x18 cm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Um convite de 13 × 18 cm (5\" × 7\") requer um envelope A7 com 133 × 184 mm (5.25\" × 7.25\"), garantindo uma folga de cerca de 3 a 4 mm em cada extremidade."
          }
        },
        {
          "@type": "Question",
          "name": "Quais são as dimensões em pixels para Canva a 300 DPI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para um convite de 127 × 178 mm (5\" × 7\") a 300 DPI com 3 mm de sangria, configure o tamanho personalizado no Canva para 1575 × 2175 pixels."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Dimensionador de Conjuntos de Convite de Casamento | Manage.Wedding"
	description="Calcule dimensões exatas, margens de corte e folgas de envelopes para papelaria de casamento. Tabelas para A7, A2, A5, C5 e especificações de corte a 300 DPI."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Dimensionador de Papelaria" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Sangrias a 300 DPI & Folha de Corte</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Dimensionador de <span class="accent-italic">Conjuntos de Convite</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Garanta que os cartões de convite, bases em cartolina, anexos de detalhes e cartões de RSVP entram nos envelopes com folgas milimétricas perfeitas e especificações de corte a 300 DPI.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Suite Format Selector & Units -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Formato & Unidades
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Norma 300 DPI
					</span>
				</div>

				<!-- Suite Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="suite-format-preset">Formato Padrão de Convite</label>
					<select id="suite-format-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="a7-standard" selected>💌 Padrão A7 13×18 cm (Envelope 133×184 / Cartão 127×178 / RSVP 89×127 mm)</option>
						<option value="a7-layered">👑 A7 com Base Dupla (Base 127×178 / Convite 121×172 mm / Margem 3 mm)</option>
						<option value="uk-metric">🇵🇹 Padrão Métrico Europeu (Envelope C5 162×229 mm / Cartão A5 148×210 mm)</option>
						<option value="square-6">🔲 Quadrado Moderno 15×15 cm (Envelope 165×165 / Cartão 152×152 mm)</option>
						<option value="tea-length">🥂 Slimline Longo / Menu 10×24 cm (Envelope DL / Cartão 98×235 mm)</option>
						<option value="a8-luxe">🏰 Luxo Europeu A8 (Envelope 140×206 / Cartão 133×197 mm)</option>
					</select>
				</div>

				<!-- Measurement Unit Selector -->
				<div class="form-group">
					<label class="form-label" for="unit-selector">Unidade de Medida de Exibição</label>
					<select id="unit-selector" class="form-input" style="cursor: pointer; font-weight: 600;">
						<option value="mm" selected>Milímetros (ex.: 127 × 178 mm)</option>
						<option value="in">Polegadas (ex.: 5.00" × 7.00")</option>
						<option value="px">Pixels a 300 DPI para Canva / Photoshop (ex.: 1500 × 2100 px)</option>
					</select>
				</div>

				<!-- Backer Mat Border Width -->
				<div class="form-group">
					<label class="form-label" for="border-reveal">Margem Visível da Base de Cartolina (Passe-partout)</label>
					<select id="border-reveal" class="form-input" style="cursor: pointer;">
						<option value="0.125" selected>3,2 mm (1/8") — Margem Delicada Clássica</option>
						<option value="0.25">6,4 mm (1/4") — Margem Larga Contrastante</option>
						<option value="0">Sem Base (Cartão Simples de Folha Única)</option>
					</select>
				</div>

				<!-- Additional Components (Checkboxes) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Elementos e Camadas Opcionais
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-details" checked style="width: 18px; height: 18px;" />
							<span>Incluir Cartão de Detalhes / Ementa</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-rsvp" checked style="width: 18px; height: 18px;" />
							<span>Incluir Cartão de RSVP Físico & Envelope de Resposta</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-bellyband" checked style="width: 18px; height: 18px;" />
							<span>Incluir Cinta de Papel / Luva em Papel Vegetal</span>
						</label>
					</div>
				</div>

			</div>

			<!-- Right Column: Interactive Layering Canvas & Spec Sheet -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Spec Sheet Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Especificações de Corte e Impressão
						</span>
						<span id="format-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							Conjunto Padrão A7
						</span>
					</div>

					<h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Dimensões por Camada
					</h3>

					<!-- Itemized Dimension Specs Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						
						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>1. Envelope Exterior:</strong></span>
							<strong id="spec-outer-envelope" style="color: var(--accent-blue);">133 × 184 mm (A7)</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>2. Base de Cartolina (Fundo):</strong></span>
							<strong id="spec-backer-card">127 × 178 mm</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>3. Cartão Principal de Convite:</strong></span>
							<strong id="spec-main-card" style="color: var(--accent-red);">121 × 172 mm</strong>
						</div>

						<div id="row-details" style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>4. Cartão de Detalhes / Ementa:</strong></span>
							<strong id="spec-details-card">108 × 140 mm (A2)</strong>
						</div>

						<div id="row-rsvp" style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>5. Cartão RSVP + Envelope A2:</strong></span>
							<strong id="spec-rsvp-card">Cartão: 89×127 mm | Env: 111×146 mm</strong>
						</div>

						<div id="row-belly" style="display: flex; justify-content: space-between; padding: 0.4rem 0; font-size: 0.92rem;">
							<span><strong>6. Cinta / Faixa de Fecho:</strong></span>
							<strong id="spec-bellyband">44 × 292 mm</strong>
						</div>

					</div>

					<!-- Print Bleed Spec Box -->
					<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem; font-size: 0.88rem; color: var(--fg-pencil); line-height: 1.5;">
						<strong>📐 Sangria de Impressão Profissional:</strong><br />
						Adicione <strong style="color: var(--accent-red);">+3 mm (+38 px a 300 DPI)</strong> em todos os 4 lados do ficheiro antes de enviar para a gráfica para garantir um corte perfeito sem bordas brancas.
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-specs" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Folha de Corte (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar Word (.doc)
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumo Direto ao Assunto (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Guia Rápido: Formatos e Folgas de Envelopes
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Tabela de correspondência exata entre tamanhos de cartões, envelopes exteriores e dimensões no Canva a 300 DPI.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 A Regra de Ouro dos 6 mm de Folga do Envelope:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Dimensão do Envelope = [Cartão + 6 mm de Largura + 6 mm de Altura] • Um cartão de 127 × 178 mm exige envelope de 133 × 184 mm (A7) • Um cartão A5 (148 × 210 mm) exige envelope C5 (162 × 229 mm).
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Nome do Formato</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Dimensão do Cartão (mm)</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Envelope Correspondente</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Canva 300 DPI</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Padrão A7 (13 × 18 cm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">127 × 178 mm (5" × 7")</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">A7 (133 × 184 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1500 × 2100 px</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Padrão Europeu A5</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">148 × 210 mm (A5)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">C5 (162 × 229 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1748 × 2480 px</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Quadrado 15×15 cm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">152 × 152 mm (6" × 6")</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Quadrado (165 × 165 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1800 × 1800 px</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Cartão RSVP A2</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">89 × 127 mm (3.5" × 5")</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">A2 (111 × 146 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1050 × 1500 px</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guia Técnico de Impressão e Montagem de Papelaria
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Compreenda gramagens de cartolina (g/m²), ordem de montagem das camadas e regras de sangria gráfica.
				</p>
			</div>

			<!-- Section 1: Paper Weights Explained -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Gramagens de Papel para Casamento (g/m²)
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					A textura e o peso do papel transmitem a sofisticação do evento:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>300 a 350 g/m²:</strong> Cartolina padrão premium para convites de casamento. Rígida e de toque agradável.</li>
					<li><strong>600 g/m² (Cartolina Dupla / Algodão):</strong> Espessura de luxo extra grossa, ideal para estampagem a ouro (hot stamping), relevo seco ou letterpress.</li>
					<li><strong>120 a 140 g/m²:</strong> Papel de gramagem ligeira para os envelopes exteriores e forros interiores.</li>
				</ul>
			</section>

			<!-- Section 2: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Qual é o tamanho de sangria necessário para um convite de 13x18 cm?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Adicione 3 mm a todas as extremidades. O ficheiro final terá 133 × 184 mm (1575 × 2175 pixels a 300 DPI).
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Que comprimento deve ter uma cinta de papel para fechar o convite?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Para um convite de 13 × 18 cm, a cinta deve ter entre 4 a 5 cm de altura e 28 a 30 cm de comprimento para envolver confortavelmente o conjunto com sobreposição de fecho.
					</p>
				</details>
			</section>

		</article>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/pt/wedding-invitation-suite-sizer" category="stationery" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const formatSelect = document.getElementById('suite-format-preset');
		const unitSelect = document.getElementById('unit-selector');
		const borderRevealSelect = document.getElementById('border-reveal');

		const layerDetailsCheck = document.getElementById('layer-details');
		const layerRsvpCheck = document.getElementById('layer-rsvp');
		const layerBellyCheck = document.getElementById('layer-bellyband');

		const formatBadge = document.getElementById('format-badge');
		const specOuter = document.getElementById('spec-outer-envelope');
		const specBacker = document.getElementById('spec-backer-card');
		const specMain = document.getElementById('spec-main-card');
		const specDetails = document.getElementById('spec-details-card');
		const specRsvp = document.getElementById('spec-rsvp-card');
		const specBelly = document.getElementById('spec-bellyband');

		const rowDetails = document.getElementById('row-details');
		const rowRsvp = document.getElementById('row-rsvp');
		const rowBelly = document.getElementById('row-belly');

		const btnPrint = document.getElementById('btn-print-specs');
		const btnDoc = document.getElementById('btn-export-doc');

		function formatDim(w, h, unit) {
			if (unit === 'in') {
				return `${w.toFixed(2)}" × ${h.toFixed(2)}"`;
			} else if (unit === 'mm') {
				const wMm = Math.round(w * 25.4);
				const hMm = Math.round(h * 25.4);
				return `${wMm} × ${hMm} mm`;
			} else if (unit === 'px') {
				const wPx = Math.round(w * 300);
				const hPx = Math.round(h * 300);
				return `${wPx} × ${hPx} px`;
			}
		}

		function updateSuiteDimensions() {
			const fmt = formatSelect.value;
			const unit = unitSelect.value;
			const border = parseFloat(borderRevealSelect.value) || 0;

			let outerW = 5.25, outerH = 7.25, outerName = 'A7 (133×184 mm)';
			let backerW = 5.00, backerH = 7.00;
			let mainW = 5.00, mainH = 7.00;
			let detailsW = 4.25, detailsH = 5.50;
			let rsvpCardW = 3.50, rsvpCardH = 5.00, rsvpEnvW = 4.375, rsvpEnvH = 5.75;
			let bellyW = 1.75, bellyL = 11.50;

			if (fmt === 'a7-standard') {
				formatBadge.textContent = 'Padrão A7 13×18 cm';
				outerW = 5.25; outerH = 7.25; outerName = 'A7 (133×184 mm)';
				backerW = 5.00; backerH = 7.00;
				mainW = 5.00 - (border * 2); mainH = 7.00 - (border * 2);
				detailsW = 4.25; detailsH = 5.50;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 1.75; bellyL = 11.50;
			} else if (fmt === 'a7-layered') {
				formatBadge.textContent = 'A7 com Base Dupla';
				outerW = 5.25; outerH = 7.25; outerName = 'A7 (133×184 mm)';
				backerW = 5.00; backerH = 7.00;
				mainW = 4.75; mainH = 6.75;
				detailsW = 4.00; detailsH = 5.25;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 1.75; bellyL = 11.50;
			} else if (fmt === 'square-6') {
				formatBadge.textContent = 'Quadrado 15×15 cm';
				outerW = 6.50; outerH = 6.50; outerName = 'Quadrado (165×165 mm)';
				backerW = 6.00; backerH = 6.00;
				mainW = 6.00 - (border * 2); mainH = 6.00 - (border * 2);
				detailsW = 4.50; detailsH = 4.50;
				rsvpCardW = 4.00; rsvpCardH = 4.00; rsvpEnvW = 4.50; rsvpEnvH = 4.50;
				bellyW = 1.75; bellyL = 13.50;
			} else if (fmt === 'tea-length') {
				formatBadge.textContent = 'Slimline / Menu 10×24 cm';
				outerW = 4.125; outerH = 9.50; outerName = 'DL (110×220 mm)';
				backerW = 3.875; backerH = 9.25;
				mainW = 3.875 - (border * 2); mainH = 9.25 - (border * 2);
				detailsW = 3.50; detailsH = 6.00;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 1.75; bellyL = 9.25;
			} else if (fmt === 'a8-luxe') {
				formatBadge.textContent = 'Luxo Europeu A8';
				outerW = 5.50; outerH = 8.125; outerName = 'A8 (140×206 mm)';
				backerW = 5.25; backerH = 7.75;
				mainW = 5.25 - (border * 2); mainH = 7.75 - (border * 2);
				detailsW = 4.25; detailsH = 6.00;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 2.00; bellyL = 12.00;
			} else if (fmt === 'uk-metric') {
				formatBadge.textContent = 'Padrão Europeu (A5 / C5)';
				outerW = 6.38; outerH = 9.02; outerName = 'C5 (162×229 mm)';
				backerW = 5.83; backerH = 8.27; // A5
				mainW = 5.83 - (border * 2); mainH = 8.27 - (border * 2);
				detailsW = 4.13; detailsH = 5.83; // A6
				rsvpCardW = 4.13; rsvpCardH = 5.83; rsvpEnvW = 4.49; rsvpEnvH = 6.38; // C6
				bellyW = 1.75; bellyL = 13.00;
			}

			// Update Text Displays
			specOuter.textContent = `${formatDim(outerW, outerH, unit)} (${outerName})`;
			specBacker.textContent = border > 0 ? formatDim(backerW, backerH, unit) : 'N/D (Folha Simples)';
			specMain.textContent = formatDim(mainW, mainH, unit);
			specDetails.textContent = formatDim(detailsW, detailsH, unit);
			specRsvp.textContent = `Cartão: ${formatDim(rsvpCardW, rsvpCardH, unit)} | Env: ${formatDim(rsvpEnvW, rsvpEnvH, unit)}`;
			specBelly.textContent = formatDim(bellyW, bellyL, unit);

			// Visibility Toggles
			rowDetails.style.display = layerDetailsCheck.checked ? 'flex' : 'none';
			rowRsvp.style.display = layerRsvpCheck.checked ? 'flex' : 'none';
			rowBelly.style.display = layerBellyCheck.checked ? 'flex' : 'none';
		}

		// Listeners
		[formatSelect, unitSelect, borderRevealSelect, layerDetailsCheck, layerRsvpCheck, layerBellyCheck].forEach(elem => {
			elem.addEventListener('change', updateSuiteDimensions);
		});

		// Print Spec Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Folha de Corte de Convites — Manage.Wedding</title>
					<style>
						@page { size: 8.5in 11in; margin: 0.5in; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 20pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Folha de Corte de Convites de Casamento</h1>
					<p>Formato: ${formatBadge.textContent} | Unidades: ${unitSelect.options[unitSelect.selectedIndex].text}</p>
					
					<table>
						<thead><tr><th>Camada / Componente</th><th>Tamanho Final de Corte</th><th>Canva 300 DPI</th></tr></thead>
						<tbody>
							<tr><td><strong>Envelope Exterior</strong></td><td>${specOuter.textContent}</td><td>Envelope de Envio</td></tr>
							<tr><td><strong>Base de Cartolina</strong></td><td>${specBacker.textContent}</td><td>Base de Fundo</td></tr>
							<tr><td><strong>Cartão Principal de Convite</strong></td><td><strong>${specMain.textContent}</strong></td><td>+3 mm Sangria Obrigatória</td></tr>
							<tr><td><strong>Cartão de Detalhes / Ementa</strong></td><td>${specDetails.textContent}</td><td>Cartão Anexo</td></tr>
							<tr><td><strong>Cartão de Resposta RSVP</strong></td><td>${specRsvp.textContent}</td><td>Envelope de Retorno</td></tr>
							<tr><td><strong>Cinta / Faixa de Fecho</strong></td><td>${specBelly.textContent}</td><td>Fecho de Papel</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Especificações de Corte de Convites</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Folha de Corte de Convites de Casamento</h2>
					<p>Formato: ${formatBadge.textContent}</p>
					<table>
						<thead><tr><th>Componente</th><th>Tamanho de Corte</th></tr></thead>
						<tbody>
							<tr><td>Envelope Exterior</td><td>${specOuter.textContent}</td></tr>
							<tr><td>Base de Cartolina</td><td>${specBacker.textContent}</td></tr>
							<tr><td>Cartão Principal</td><td>${specMain.textContent}</td></tr>
							<tr><td>Cartão de Detalhes</td><td>${specDetails.textContent}</td></tr>
							<tr><td>Conjunto de RSVP</td><td>${specRsvp.textContent}</td></tr>
							<tr><td>Cinta de Fecho</td><td>${specBelly.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob(['\ufeff' + content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'folha-corte-convites-casamento.doc';
			link.click();
		});

		// Initial Calculation
		updateSuiteDimensions();
	</script>
</Layout>
