---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-thank-you-cards/#webapp",
      "name": "Gerador de Mensagens e Cartões de Agradecimento de Casamento",
      "url": "https://manage.wedding/pt/wedding-thank-you-cards",
      "inLanguage": "pt",
      "description": "Gerador gratuito de textos para cartões de agradecimento de casamento. Crie mensagens personalizadas e com a etiqueta perfeita para prendas em dinheiro, lua de mel, presentes de lista de casamento e agradecimentos a fornecedores.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Escrever uma Mensagem Perfeita de Agradecimento de Casamento",
      "description": "A fórmula padrão de etiqueta em 4 frases para escrever cartões de agradecimento sinceros e elegantes.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Frase 1: Agradeça a Presença e o Carinho",
          "text": "Agradeça ao convidado por ter celebrado o dia convosco ou por ter viajado para estar presente."
        },
        {
          "@type": "HowToStep",
          "name": "Frase 2: Identifique a Oferta Específica Recebida",
          "text": "Mencione o presente específico (ex.: 'a vossa generosa contribuição para a nossa lua de mel' ou 'o maravilhoso faqueiro') sem nunca citar quantias exatas em dinheiro."
        },
        {
          "@type": "HowToStep",
          "name": "Frase 3: Explique Como Vão Desfrutar do Presente",
          "text": "Partilhe como pretendem usar o presente (ex.: 'vai ajudar-nos a mobilar a nossa sala' ou 'tornou o nosso jantar à beira-mar inesquecível')."
        },
        {
          "@type": "HowToStep",
          "name": "Frase 4: Despedida Calorosa e Próximo Encontro",
          "text": "Conclua com uma mensagem pessoal expressando o desejo de se reencontrarem em breve."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanto tempo temos para enviar os cartões de agradecimento de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A etiqueta moderna recomenda o envio de todos os cartões de agradecimento até 3 meses após o regresso da lua de mel. Para prendas recebidas antes do casamento, envie o agradecimento dentro de 2 a 3 semanas após a receção."
          }
        },
        {
          "@type": "Question",
          "name": "Como agradecer prendas de casamento em dinheiro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nunca refira o montante em dinheiro por escrito. Expresse gratidão pela 'generosa oferta' ou 'carinho e generosidade' e explique como pretendem utilizá-lo, como na entrada da casa ou experiências da lua de mel."
          }
        },
        {
          "@type": "Question",
          "name": "Os cartões de agradecimento devem ser escritos à mão?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim, a etiqueta tradicional valoriza imenso mensagens escritas à mão em papelaria física. Embora possa utilizar o gerador para criar a estrutura dos textos, passar a mensagem para o cartão à mão demonstra um apreço genuíno e pessoal."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Gerador de Mensagens e Cartões de Agradecimento de Casamento | Manage.Wedding"
	description="Gerador gratuito de textos para cartões de agradecimento de casamento. Crie mensagens personalizadas para prendas em dinheiro, lua de mel, lista de casamento e fornecedores."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Cartões de Agradecimento" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">+15.000 Mensagens Criadas Mensalmente</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Gerador de Mensagens de <span class="accent-italic">Agradecimento</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Gere textos sinceros e com a etiqueta perfeita para agradecer prendas em dinheiro, contribuições para a lua de mel, presentes da lista e presença dos convidados. Copie com 1 clique ou imprima diretamente.
			</p>
		</header>

		<!-- Main Interactive Generator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Input Form -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Personalizar Agradecimento
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Etiqueta Cuidada
					</span>
				</div>

				<!-- Recipient Name -->
				<div class="form-group">
					<label class="form-label" for="guest-names">Nome(s) do Convidado / Destinatário</label>
					<input type="text" id="guest-names" class="form-input" value="Tia Luísa & Tio Manuel" placeholder="ex.: Tia Luísa & Tio Manuel, Inês & Tiago" />
				</div>

				<!-- Relationship to Couple -->
				<div class="form-group">
					<label class="form-label" for="relationship">Grau de Relação</label>
					<select id="relationship" class="form-input" style="cursor: pointer;">
						<option value="family-close">Família Próxima (Pais, Avós, Irmãos)</option>
						<option value="family-extended" selected>Família Alargada (Tios, Primos)</option>
						<option value="friends-close">Amigos Próximos / Padrinhos e Damas de Honor</option>
						<option value="friends-casual">Colegas de Trabalho / Amigos</option>
						<option value="absent">Convidado que Não Pôde Comparecer (Enviou Presente)</option>
						<option value="vendor">Fornecedor de Casamento (Fotógrafo, Quinta, Músicos)</option>
					</select>
				</div>

				<!-- Gift Category -->
				<div class="form-group">
					<label class="form-label" for="gift-type">Oferta / Presente Recebido</label>
					<select id="gift-type" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="cash" selected>💵 Oferta em Dinheiro / Transferência Bancária</option>
						<option value="honeymoon">🏝️ Contribuição para a Lua de Mel</option>
						<option value="registry">🎁 Presente Físico da Lista de Casamento</option>
						<option value="attendance">✨ Apenas Presença (Sem Presente Físico)</option>
						<option value="group">👥 Presente de Grupo (Amigos / Colegas)</option>
						<option value="giftcard">💳 Cartão Presente / Vale de Loja</option>
					</select>
				</div>

				<!-- Gift Specific Item / Detail -->
				<div class="form-group" id="gift-detail-group">
					<label class="form-label" for="gift-detail">Detalhe do Presente / Utilização Prevista</label>
					<input type="text" id="gift-detail" class="form-input" value="a nossa lua de mel em Itália & fundo para a casa" placeholder="ex.: o maravilhoso faqueiro, passeio de barco na lua de mel" />
				</div>

				<!-- Tone / Style Selector -->
				<div class="form-group">
					<label class="form-label">Tom e Estilo da Mensagem</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="tone-btn hand-btn is-active" data-tone="heartfelt" style="padding: 8px; font-size: 0.88rem;">
							💖 Afetuoso & Emocionante
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="formal" style="padding: 8px; font-size: 0.88rem;">
							🏛️ Formal & Clássico
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="casual" style="padding: 8px; font-size: 0.88rem;">
							✨ Moderno & Descontraído
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="short" style="padding: 8px; font-size: 0.88rem;">
							⚡ Curto & Direto (3 Frases)
						</button>
					</div>
				</div>

				<!-- Personal Memory (Optional) -->
				<div class="form-group">
					<label class="form-label" for="personal-memory">Memória Especial / Nota Pessoal (Opcional)</label>
					<input type="text" id="personal-memory" class="form-input" value="Foi fantástico ver-vos a animar a pista de dança!" placeholder="ex.: Foi maravilhoso ter-vos connosco vindo de tão longe!" />
				</div>

				<!-- Sign-off Names -->
				<div class="form-group">
					<label class="form-label" for="signoff-names">Assinatura dos Noivos</label>
					<input type="text" id="signoff-names" class="form-input" value="Sara & Gonçalo" placeholder="ex.: Sara & Gonçalo" />
				</div>

				<button id="btn-generate-notes" class="hand-btn" style="width: 100%; padding: 14px; font-size: 1.1rem; margin-top: 0.5rem; justify-content: center;">
					<span>✨</span> Gerar 3 Opções de Mensagem
				</button>

			</div>

			<!-- Right Column: 3 Generated Options & Tracker -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Results Header -->
				<div style="display: flex; justify-content: space-between; align-items: center;">
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						Opções de Texto Geradas
					</h3>
					<span id="word-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
						~45-65 palavras | 1.5 min escrita
					</span>
				</div>

				<!-- Option 1 Card (Recommended) -->
				<div class="hand-card" style="padding: 1.5rem; background: #fffcf5; border-left: 6px solid var(--accent-red); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Opção 1: Recomendação Principal
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-1" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copiar Mensagem
						</button>
					</div>
					<p id="note-opt-1" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
						Queridos Tia Luísa & Tio Manuel,

Muito obrigado por terem celebrado o nosso dia de casamento connosco! A vossa presença significou imenso para nós. Estamos profundamente gratos pela vossa generosa oferta para a nossa lua de mel em Itália & fundo para a casa. Foi fantástico ver-vos a animar a pista de dança! Esperamos ver-nos muito em breve.

Com muito carinho e amizade,
Sara & Gonçalo
					</p>
				</div>

				<!-- Option 2 Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid var(--accent-blue); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-blue); letter-spacing: 0.05em;">
							Opção 2: Formulação Alternativa
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-2" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copiar Mensagem
						</button>
					</div>
					<p id="note-opt-2" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
						Queridos Tia Luísa & Tio Manuel,

Não temos palavras para vos agradecer pelo carinho com que nos acompanharam neste dia tão especial. A vossa presença encheu o nosso coração de alegria. Agradecemos sinceramente a vossa maravilhosa oferta para a nossa lua de mel em Itália & fundo para a casa, que nos vai ajudar muito a iniciar esta nova etapa! Foi fantástico ver-vos a animar a pista de dança!

Um abraço muito apertado,
Sara & Gonçalo
					</p>
				</div>

				<!-- Option 3 Card (Short & Sweet) -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid #16a34a; position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #16a34a; letter-spacing: 0.05em;">
							Opção 3: Curta & Direta
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-3" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copiar Mensagem
						</button>
					</div>
					<p id="note-opt-3" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
						Queridos Tia Luísa & Tio Manuel,

Obrigado por fazerem parte do melhor dia das nossas vidas e pela vossa enorme generosidade. O vosso presente para a nossa lua de mel em Itália & fundo para a casa é muito especial para nós como recém-casados. Foi fantástico ver-vos a animar a pista de dança!

Com todo o carinho,
Sara & Gonçalo
					</p>
				</div>

				<!-- Action Bar -->
				<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
					<button id="btn-print-note" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>🖨️</span> Imprimir Cartão de Agradecimento (PDF)
					</button>
					<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>📄</span> Exportar Documento Word (.doc)
					</button>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumo Direto ao Assunto (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Guia Rápido: Etiqueta de Cartões de Agradecimento
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					A fórmula de 4 frases e os prazos essenciais para agradecer aos convidados de forma calorosa e elegante.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📝 A Fórmula das 4 Frases de Agradecimento:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					[1. Agradecer a Presença] + [2. Nomear o Presente (sem valores numéricos)] + [3. Contar Como Vão Desfrutar] + [4. Despedida Afetuosa] • ⏰ Enviar no prazo máximo de 3 meses após a lua de mel.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Tipo de Oferta</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Frase Aprovada pela Etiqueta</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">O Que NUNCA Escrever</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Dinheiro / Transferência</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Muito obrigado pela vossa generosa oferta para a entrada da nossa casa / lua de mel."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Nunca mencione o valor exato (ex.: "Obrigado pelos 150€").</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Presente da Lista</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Muito obrigado pelo maravilhoso faqueiro. Já o usámos no nosso primeiro jantar de domingo!"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Evite frases genéricas como "Obrigado pela prenda".</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Experiência na Lua de Mel</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Obrigado por nos proporcionarem um inesquecível passeio de barco ao pôr do sol!"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Especifique a experiência concreta proporcionada pela oferta.</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Convidado Ausente</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Sentimos muito a vossa falta no casamento, mas sentimos todo o vosso carinho através do presente."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Não faça comentários de culpa por terem faltado.</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #d97706);">Apenas Presença (Sem Presente)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Muito obrigado pela vossa presença e alegria! Ter-vos connosco tornou o nosso dia perfeito."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Nunca refira a ausência de um presente físico.</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guia Completo de Etiqueta para Cartões de Agradecimento
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Escrever dezenas de cartões manuscritos não tem de ser exaustivo. Descubra sistemas de ritmo e boas práticas para concluir os agradecimentos com tranquilidade.
				</p>
			</div>

			<!-- Section 1: The 3-Month Rule -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. A Regra dos 3 Meses de Etiqueta
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					O antigo mito de que os noivos têm "um ano inteiro" para enviar os agradecimentos está hoje completamente ultrapassado:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Prendas Recebidas Antes do Casamento:</strong> Envie o agradecimento em <strong>2 a 3 semanas</strong> para tranquilizar quem enviou que a encomenda chegou bem.</li>
					<li><strong>Prendas Recebidas no Casamento:</strong> Envie todos os cartões no prazo de <strong>3 meses após o regresso da lua de mel</strong>.</li>
					<li><strong>Método dos 10 Cartões por Noite:</strong> Escrevendo 10 cartões por serão a dois, despacham um casamento de 100 convidados em apenas 10 dias!</li>
				</ul>
			</section>

			<!-- Section 2: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Ambos os noivos devem assinar o cartão de agradecimento?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Sim! O texto deve ser escrito na primeira pessoa do plural ("Nós adorámos", "Estamos muito gratos") e assinado por ambos (ex.: <em>Sara & Gonçalo</em>), mesmo que apenas um escreva à mão.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Devemos enviar agradecimento aos padrinhos e damas de honor?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Com certeza. Mesmo que tenham oferecido presentes aos padrinhos durante o planeamento, uma mensagem calorosa e dedicada reconhecendo o apoio emocional e o esforço de ambos no dia é imprescindível.
					</p>
				</details>
			</section>

		</article>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/pt/wedding-thank-you-cards" category="stationery" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const guestNamesInput = document.getElementById('guest-names');
		const relationshipSelect = document.getElementById('relationship');
		const giftTypeSelect = document.getElementById('gift-type');
		const giftDetailInput = document.getElementById('gift-detail');
		const giftDetailGroup = document.getElementById('gift-detail-group');
		const memoryInput = document.getElementById('personal-memory');
		const signoffInput = document.getElementById('signoff-names');
		const toneButtons = document.querySelectorAll('.tone-btn');
		const btnGenerate = document.getElementById('btn-generate-notes');

		const noteOpt1 = document.getElementById('note-opt-1');
		const noteOpt2 = document.getElementById('note-opt-2');
		const noteOpt3 = document.getElementById('note-opt-3');
		const wordCountBadge = document.getElementById('word-count-badge');
		const btnPrint = document.getElementById('btn-print-note');
		const btnDoc = document.getElementById('btn-export-doc');

		let currentTone = 'heartfelt';

		// Tone Toggle Handler
		toneButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				toneButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentTone = btn.getAttribute('data-tone');
				generateNotes();
			});
		});

		// Gift Type Handler
		giftTypeSelect.addEventListener('change', () => {
			const type = giftTypeSelect.value;
			if (type === 'attendance') {
				giftDetailGroup.style.display = 'none';
			} else {
				giftDetailGroup.style.display = 'block';
				if (type === 'cash') giftDetailInput.placeholder = 'ex.: a nossa lua de mel em Itália & fundo para a casa';
				else if (type === 'honeymoon') giftDetailInput.placeholder = 'ex.: passeio de barco ao pôr do sol em Santorini';
				else if (type === 'registry') giftDetailInput.placeholder = 'ex.: a maravilhosa batedeira KitchenAid';
				else if (type === 'group') giftDetailInput.placeholder = 'ex.: a máquina de café expresso';
				else if (type === 'giftcard') giftDetailInput.placeholder = 'ex.: cartão presente da Leroy Merlin para o nosso jardim';
			}
			generateNotes();
		});

		function generateNotes() {
			const names = guestNamesInput.value.trim() || 'Queridos Amigos';
			const rel = relationshipSelect.value;
			const gift = giftTypeSelect.value;
			const detail = giftDetailInput.value.trim() || 'a vossa maravilhosa oferta';
			const memory = memoryInput.value.trim();
			const signoff = signoffInput.value.trim() || 'Sara & Gonçalo';

			let opt1 = '', opt2 = '', opt3 = '';

			const memoryClause = memory ? ` ${memory}` : '';

			// Tone Formulations
			if (currentTone === 'heartfelt') {
				if (gift === 'cash') {
					opt1 = `Queridos ${names},\n\nMuito obrigado por terem celebrado o nosso dia de casamento connosco! A vossa presença significou imenso para nós. Estamos profundamente gratos pela vossa generosa oferta para ${detail}.${memoryClause} Esperamos ver-nos muito em breve!\n\nCom muito carinho e amizade,\n${signoff}`;
					opt2 = `Queridos ${names},\n\nNão temos palavras para vos agradecer pelo carinho com que nos acompanharam neste dia tão especial. A vossa presença encheu o nosso coração de alegria. Agradecemos sinceramente a vossa maravilhosa oferta para ${detail}, que nos vai ajudar muito a iniciar esta nova etapa!${memoryClause}\n\nUm abraço muito apertado,\n${signoff}`;
					opt3 = `Queridos ${names},\n\nObrigado por fazerem parte do melhor dia das nossas vidas e pela vossa enorme generosidade. O vosso presente para ${detail} é muito especial para nós como recém-casados.${memoryClause} Obrigado por todo o carinho e amizade!\n\nCom todo o coração,\n${signoff}`;
				} else if (gift === 'honeymoon') {
					opt1 = `Queridos ${names},\n\nMuito obrigado por celebrarem o nosso casamento connosco! Estamos imensamente gratos pela vossa generosa contribuição para ${detail}. Tornou a nossa lua de mel verdadeiramente inesquecível e criou memórias que guardaremos para sempre.${memoryClause}\n\nCom amor e gratidão,\n${signoff}`;
					opt2 = `Queridos ${names},\n\nTer-vos a partilhar este dia connosco foi maravilhoso. Agradecemos do fundo do coração pelo vosso presente de ${detail} na nossa lua de mel! Foi um dos momentos altos da nossa viagem.${memoryClause}\n\nCom muito carinho,\n${signoff}`;
					opt3 = `Queridos ${names},\n\nMuito obrigado pelo carinho, apoio e fantástica oferta de lua de mel para ${detail}! A vossa gentileza ajudou a tornar a nossa primeira grande aventura de casados inesquecível.${memoryClause}\n\nCom todo o nosso afeto,\n${signoff}`;
				} else if (gift === 'registry') {
					opt1 = `Queridos ${names},\n\nMuito obrigado por celebrarem o nosso casamento connosco! Adorámos absolutamente ${detail} que escolheram da nossa lista de casamento. Já encontrámos o cantinho perfeito para ele na nossa casa!${memoryClause}\n\nCom muito amor,\n${signoff}`;
					opt2 = `Queridos ${names},\n\nFoi fantástico estar convosco no nosso dia de casamento. Muito obrigado pelo presente tão especial de ${detail}. Mal podemos esperar para o usar em muitos almoços de família e jantares de amigos!${memoryClause}\n\nCom as melhores lembranças,\n${signoff}`;
					opt3 = `Queridos ${names},\n\nObrigado por partilharem a nossa alegria e pelo maravilhoso presente de ${detail}. A vossa generosidade significa imenso para nós ao construirmos o nosso lar juntos.${memoryClause}\n\nCom carinho,\n${signoff}`;
				} else {
					// Presence only
					opt1 = `Queridos ${names},\n\nMuito obrigado por terem celebrado o nosso casamento connosco! A vossa energia, alegria e presença tornaram o nosso dia completo.${memoryClause} Estamos imensamente gratos pela vossa amizade.\n\nCom muito afeto,\n${signoff}`;
					opt2 = `Queridos ${names},\n\nFicámos muito felizes por terem conseguido estar connosco neste dia tão importante! Obrigado por terem vindo celebrar o nosso amor.${memoryClause} Esperamos estar juntos novamente muito em breve!\n\nCom carinho,\n${signoff}`;
					opt3 = `Queridos ${names},\n\nObrigado por fazerem parte do melhor dia das nossas vidas! O vosso apoio e amizade significam tudo para nós.${memoryClause}\n\nCom muito amor,\n${signoff}`;
				}
			} else if (currentTone === 'formal') {
				opt1 = `Estimados ${names},\n\nAgradecemos muito sinceramente a vossa honrosa presença no nosso dia de casamento. Estamos profundamente gratos pela vossa generosa e atenciosa oferta para ${detail}.${memoryClause} A vossa amizade e consideração neste início de vida a dois são muito valorizadas.\n\nCom os nossos mais respeitosos cumprimentos,\n${signoff}`;
				opt2 = `Estimados ${names},\n\nQueremos expressar o nosso profundo agradecimento por nos terem acompanhado na celebração do nosso matrimónio. Agradecemos calorosamente a vossa generosa oferta de ${detail}.${memoryClause} Foi uma honra imensa contar com a vossa companhia nesta ocasião tão marcante.\n\nCom distinta consideração,\n${signoff}`;
				opt3 = `Estimados ${names},\n\nObrigado por partilharem connosco a alegria da nossa união. Agradecemos sinceramente a vossa generosa contribuição para ${detail} e o vosso constante apoio à nossa nova família.${memoryClause}\n\nCom elevada estima e amizade,\n${signoff}`;
			} else if (currentTone === 'casual') {
				opt1 = `Olá ${names}!\n\nMuito obrigado por terem vindo festejar connosco — tornaram o nosso casamento ainda mais animado e especial! Estamos radiantes com ${detail}.${memoryClause} Temos de combinar um jantar muito em breve!\n\nUm grande abraço,\n${signoff}`;
				opt2 = `Queridos ${names},\n\nObrigado por terem trazido tanta energia boa ao nosso grande dia! Adorámos ${detail} e somos uns sortudos por vos ter por perto.${memoryClause} Grandes beijinhos e abraços!\n\nCom amizade,\n${signoff}`;
				opt3 = `Olá ${names}!\n\nMil obrigados por terem festejado connosco e pela prenda fantástica de ${detail}! Significa imenso para nós.${memoryClause} Até breve!\n\nCom carinho,\n${signoff}`;
			} else {
				// Short & Sweet
				opt1 = `Queridos ${names},\n\nMuito obrigado por celebrarem o nosso dia de casamento connosco e pela generosa oferta para ${detail}.${memoryClause} Estamos muito gratos pelo vosso carinho e apoio!\n\nCom amor,\n${signoff}`;
				opt2 = `Queridos ${names},\n\nFoi fantástico estar convosco no nosso casamento! Muito obrigado pelo vosso presente de ${detail}.${memoryClause} Um abraço muito especial.\n\nCom carinho,\n${signoff}`;
				opt3 = `Queridos ${names},\n\nObrigado por tornarem o nosso casamento inesquecível e pelo carinhoso presente de ${detail}.${memoryClause} Muitos beijinhos e abraços!\n\nCom afeto,\n${signoff}`;
			}

			noteOpt1.textContent = opt1;
			noteOpt2.textContent = opt2;
			noteOpt3.textContent = opt3;

			const words = opt1.split(/\s+/).length;
			wordCountBadge.textContent = `~${words} palavras | ~1.5 min escrita`;
		}

		// Event Listeners
		[guestNamesInput, relationshipSelect, giftDetailInput, memoryInput, signoffInput].forEach(inp => {
			inp.addEventListener('input', generateNotes);
		});
		btnGenerate.addEventListener('click', generateNotes);

		// Copy Button Logic
		document.querySelectorAll('.copy-note-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				const targetId = btn.getAttribute('data-target');
				const text = document.getElementById(targetId).textContent;
				navigator.clipboard.writeText(text).then(() => {
					const orig = btn.textContent;
					btn.textContent = '✅ Copiado!';
					setTimeout(() => { btn.textContent = orig; }, 2000);
				});
			});
		});

		// Print Stationery PDF
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Imprimir Cartão de Agradecimento — Manage.Wedding</title>
					<style>
						@page { size: 6in 4in; margin: 0.4in; }
						body { font-family: Georgia, serif; font-size: 12pt; line-height: 1.6; color: #1e293b; padding: 0.2in; }
					</style>
				</head>
				<body>
					<div>${noteText}</div>
					<script>window.onload = function() { window.print(); };<\/script>
				</body>
				</html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Cartão de Agradecimento</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 12pt; line-height: 1.6; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Minuta de Agradecimento</h2>
					<p>${noteText}</p>
				</body></html>
			`;
			const blob = new Blob(['\ufeff' + content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = `agradecimento-${guestNamesInput.value.replace(/[^a-zA-Z0-9]/g, '_')}.doc`;
			link.click();
		});

		// Initial Generation
		generateNotes();
	</script>
</Layout>
