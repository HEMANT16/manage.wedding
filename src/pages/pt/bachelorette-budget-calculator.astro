---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/bachelorette-budget-calculator/#webapp",
      "name": "Calculadora de Orçamento e Divisão da Despedida de Solteira",
      "url": "https://manage.wedding/pt/bachelorette-budget-calculator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de despedida de solteira e divisor de despesas. Calcule o custo exato por madrinha para alojamento, jantares, passeios e decoração, cobrindo a parte da noiva. Exporte mensagens prontas para WhatsApp e MB WAY.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Dividir os Custos de uma Despedida de Solteira com Justiça",
      "description": "Guia passo a passo para madrinhas e amigas planearem o orçamento e dividirem as despesas da despedida de solteira.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Defina o Número de Participantes e a Parte da Noiva",
          "text": "Conte o número total de participantes e ative a opção para cobrir a parte da noiva (fórmula padrão N-1)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Some os Custos Fixos de Alojamento e Transporte",
          "text": "Calcule as despesas comuns essenciais: Alojamento Local / hotel, transfers, compras de supermercado e decoração temática."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Estime Refeições e Atividades de Grupo",
          "text": "Insira jantares, brunches, passeio de barco ou catamarã, spas e provas de vinho."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Organize a Cobrança via MB WAY em 2 Tranches",
          "text": "Envie o resumo detalhado no WhatsApp: recolha 50% de sinal para reservar o alojamento e o restante 2 semanas antes da viagem."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "A noiva paga a sua própria despedida de solteira?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pela etiqueta atual, as madrinhas e amigas cobrem integralmente a quota-parte da noiva no alojamento, jantares de grupo, bebidas e atividades partilhadas. A noiva normalmente paga apenas as suas viagens pessoais (voos) e roupa pessoal."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto custa em média uma despedida de solteira por pessoa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uma despedida de fim de semana com estadia (Algarve, Douro, Lisboa) ronda habitualmente entre 250 € e 450 € por pessoa (incluindo o valor para cobrir a noiva). Um fim de semana em turismo rural ou estadia local fica entre 150 € e 250 € por amiga."
          }
        },
        {
          "@type": "Question",
          "name": "Quando é que a Madrinha deve recolher o dinheiro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O primeiro sinal (50% do alojamento e passeios principais) deve ser pedido com 2 a 4 meses de antecedência. O saldo final para compras de supermercado e reservas de restaurantes deve ser recolhido cerca de 2 semanas antes da viagem."
          }
        },
        {
          "@type": "Question",
          "name": "Como agir se alguma amiga não puder suportar o custo total?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Apresente a estimativa financeira com antecedência e discrição. Permita que quem não puder passar o fim de semana completo participe apenas num evento pontual (ex.: no jantar de sábado) ou contribua com um valor simbólico para o brinde."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Orçamento da Despedida de Solteira (Divisão de Custos) | Manage.Wedding"
	description="Calculadora gratuita de despedida de solteira. Calcule o custo exato por amiga para alojamento, jantares e passeios cobrindo a noiva. Exporte pedidos para WhatsApp e MB WAY."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Orçamento da Despedida de Solteira" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Cobrir a Noiva & Exportador para WhatsApp / MB WAY</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Despedida de Solteira <span class="accent-italic">Calculadora & Divisão de Custos</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcule o valor exato por pessoa para alojamento, compras, decoração temática e passeios. Distribua automaticamente a parte da noiva e copie a mensagem de pagamento pronta para o WhatsApp num clique.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Trip Setup & Expense Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Detalhes do Fim de Semana
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Fórmula N-1
					</span>
				</div>

				<!-- Destination / Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="destination-preset">Destino / Estilo de Programa</label>
					<select id="destination-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="nashville" selected>🏖️ Algarve / Albufeira (Praia / Barco / Jantares / 350 € por amiga)</option>
						<option value="scottsdale">🍷 Porto & Vale do Douro (Enoturismo / Barco Rabelo / 380 € por amiga)</option>
						<option value="miami">🪩 Lisboa & Cascais (Rooftops / Noite / Brunch / 420 € por amiga)</option>
						<option value="cabo">🌴 Madeira / Açores (Escapadinha de Ilha / Natureza & Spa / 480 € por amiga)</option>
						<option value="local">🏡 Turismo Rural / Quinta com Piscina (Fim de Semana Tranquilo / 190 € por amiga)</option>
						<option value="custom">✏️ Personalizar Todos os Custos</option>
					</select>
				</div>

				<!-- Bride Name & Total Attendees -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="bride-name">Nome da Noiva</label>
						<input type="text" id="bride-name" class="form-input" value="Sara" placeholder="ex.: Sara" />
					</div>
					<div>
						<label class="form-label" for="bridesmaid-count">Amigas a Pagar</label>
						<input type="number" id="bridesmaid-count" class="form-input" value="7" min="1" max="30" />
					</div>
				</div>

				<!-- Cover the Bride Toggle -->
				<div class="form-group" style="background: #fffcf5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 0.98rem; margin: 0;">
						<input type="checkbox" id="toggle-cover-bride" checked style="width: 18px; height: 18px;" />
						<span>Cobrir 100% dos Custos da Noiva (Noiva Paga 0 €)</span>
					</label>
					<span style="font-size: 0.82rem; color: #64748b; display: block; margin-top: 4px; margin-left: 26px;">
						Etiqueta padrão: As 7 amigas dividem o valor global em partes rigorosamente iguais.
					</span>
				</div>

				<!-- Shared Fixed Expenses (Lodging / Transport / Decor) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Custos Fixos e Comuns de Grupo (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="airbnb-total" style="font-size: 0.9rem;">Alojamento Local / Hotel</label>
							<input type="number" id="airbnb-total" class="form-input" value="1100" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="transport-total" style="font-size: 0.9rem;">Transfers / Portagens / Táxis</label>
							<input type="number" id="transport-total" class="form-input" value="180" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="decor-total" style="font-size: 0.9rem;">Decoração & Brindes</label>
							<input type="number" id="decor-total" class="form-input" value="140" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="grocery-total" style="font-size: 0.9rem;">Supermercado & Bebidas da Casa</label>
							<input type="number" id="grocery-total" class="form-input" value="280" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Dining & Group Activities -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Restaurantes & Atividades de Grupo (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="dining-total" style="font-size: 0.9rem;">Jantares & Brunches</label>
							<input type="number" id="dining-total" class="form-input" value="500" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="activities-total" style="font-size: 0.9rem;">Passeio de Barco / Spa / Prova</label>
							<input type="number" id="activities-total" class="form-input" value="350" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Results Card & Venmo Exporter -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Cost Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Total por Amiga / Madrinha
						</span>
						<span id="bride-status-badge" style="font-size: 0.85rem; font-weight: 800; background: #16a34a; color: #fff; padding: 3px 8px; border-radius: 4px;">
							👰 Sara Paga: 0 €
						</span>
					</div>

					<div id="display-per-person" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.5rem;">
						364 €
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Orçamento global da viagem: <strong id="display-trip-grand-total" style="color: var(--fg-pencil);">2.550 €</strong> distribuído por <span id="display-headcount-text">7 amigas pagantes</span>.
					</p>

					<!-- Itemized Per-Person Split Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Alojamento (Quota com Noiva):</span>
							<strong id="item-lodging-share">157 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Refeições & Supermercado:</span>
							<strong id="item-food-share">111 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Atividades & Passeios:</span>
							<strong id="item-activity-share">50 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Decoração, Brindes & Transfers:</span>
							<strong id="item-decor-share">46 €</strong>
						</div>
					</div>

					<!-- Payment Schedule Recommendation -->
					<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem; font-size: 0.9rem; line-height: 1.5;">
						<strong style="display: block; color: var(--fg-pencil); margin-bottom: 4px;">📅 Calendário Sugerido em 2 Tranches:</strong>
						• <strong>Tranche 1 (Sinal de Reserva):</strong> <span id="sched-dep-1" style="font-weight: 700; color: var(--accent-red);">182 €</span> (bloqueio do alojamento)<br />
						• <strong>Tranche 2 (2 Semanas Antes):</strong> <span id="sched-dep-2" style="font-weight: 700; color: var(--accent-blue);">182 €</span> (restaurantes e compras)
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-copy-venmo" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📲</span> Copiar Mensagem WhatsApp / MB WAY
						</button>
						<button id="btn-print-itinerary" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Orçamento (PDF)
						</button>
					</div>

				</div>

				<!-- Trending Themes Cheat Sheet -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						✨ 5 Temas Populares de Despedida de Solteira:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Dolce Vita & Riviera:</strong> Vestidos de linho, óculos vintage, Aperol Spritz e passeio de barco ao pôr do sol.</li>
						<li><strong>Boho Chic & Sunset:</strong> Tons terra, coroas de flores secas, piquenique na praia e cocktails de autor.</li>
						<li><strong>Disco Fever & Brilhos:</strong> Lantejoulas, bolas de espelhos, noite de dança e brunch no dia seguinte.</li>
						<li><strong>Spa & Bem-Estar:</strong> Roupões a condizer, massagens relaxantes, banhos termais e brunch saudável.</li>
						<li><strong>Vinho & Charme Rural:</strong> Fim de semana em quinta no Douro/Alentejo, prova de vinhos e tábuas de queijos.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumo Direto ao Assunto (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Regra Prática: Orçamento e Divisão da Despedida de Solteira
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Sem tempo a perder? Conheça a fórmula padrão por amiga e os valores de referência para os destinos mais procurados.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					💵 A Fórmula Padrão de Divisão (N-1):
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Custo por Amiga = [Alojamento + Supermercado + Decoração + Atividades + Jantares de Grupo] ÷ [Total de Participantes − 1 (Noiva)] • A noiva cobre apenas viagens pessoais; as amigas partilham todas as despesas comuns.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Destino / Formato</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Custo Médio por Amiga</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Despesas Típicas Incluídas</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Estilo & Atividades</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Algarve (Albufeira / Lagos)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">300 € – 450 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Villa com piscina, passeio de barco às grutas, sunset beach club</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Praia, Festa e Barco</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Porto & Vale do Douro</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">320 € – 480 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Alojamento ribeirinho, prova em caves de vinho do Porto, barco rabelo</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Gastronomia e Enoturismo</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Lisboa & Cascais</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">350 € – 500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Apartamento de charme, jantar com espetáculo, brunch no Cais do Sodré</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Cosmopolita e Noite</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Turismo Rural / Gerês / Alentejo</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">160 € – 260 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Monte com piscina exclusiva, churrasco, jogos e noite temática</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Relaxante e Íntimo</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guia Completo de Organização e Finanças da Despedida de Solteira
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Planear a despedida de solteira perfeita deve ser uma experiência inesquecível e sem constrangimentos financeiros.
				</p>
			</div>

			<!-- Section 1: Who Pays for What -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Quem Paga o Quê na Despedida de Solteira?
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					As conversas sobre dinheiro podem ser delicadas quando as amigas têm diferentes capacidades financeiras. Defina os acordos antes de efetuar reservas:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>O que as Madrinhas e Amigas Pagam:</strong> A sua própria viagem/deslocação, a sua quota de alojamento, refeições, bebidas e atividades, além de cobrirem em conjunto as despesas da noiva no local.</li>
					<li><strong>O que a Noiva Paga:</strong> As suas deslocações individuais (voos ou combustível) e vestuário pessoal. No entanto, é cortesia a noiva oferecer uma rodada de cocktails ou um mimo de agradecimento ao grupo.</li>
					<li><strong>A Regra de Ouro da Madrinha:</strong> Antes de marcar qualquer destino, faça um questionário anónimo (ex.: formulário online) para saber o orçamento confortável de cada participante (ex.: até 200 €, até 350 €, até 500 €).</li>
				</ul>
			</section>

			<!-- Section 2: Collection Schedule -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Como Recolher o Dinheiro sem Situações Desagradáveis
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Nunca avance com montantes elevados do seu próprio bolso sem recolher sinais prévios:
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>📲 Boas Práticas com MB WAY / Tricount:</strong><br />
					• <strong>Fase 1 (Sinal de Alojamento):</strong> Recolha o sinal com 2 a 4 meses de antecedência. Quem não transferir o sinal não é contabilizado na reserva da casa.<br />
					• <strong>Fase 2 (Saldo Restante):</strong> Peça o montante das compras e restaurantes cerca de 15 dias antes da partida.<br />
					• <strong>Despesas no Local:</strong> Use aplicações como <em>Tricount</em> ou <em>Splitwise</em> para registar pequenos gastos espontâneos (cafés, uber, gelados) e acertar contas no final.
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">A noiva deve pagar alguma coisa na sua despedida?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Tradicionalmente não. O grupo divide as despesas da noiva para que ela seja a convidada de honra em todos os momentos comemorativos.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Quantos dias deve durar uma despedida de solteira?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						O formato ideal e mais prático é de 2 dias (fim de semana de sábado a domingo), permitindo descansar na sexta-feira ou aproveitar até ao final de tarde de domingo.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">O que fazer se uma amiga não tiver orçamento para a viagem?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Proponha que participe num almoço ou brinde na véspera do casamento, ou convide-a para jantar caso a viagem seja a uma distância razoável.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/pt/bachelorette-budget-calculator" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('destination-preset');
		const brideNameInput = document.getElementById('bride-name');
		const bridesmaidCountInput = document.getElementById('bridesmaid-count');
		const toggleCoverBride = document.getElementById('toggle-cover-bride');

		const airbnbInput = document.getElementById('airbnb-total');
		const transportInput = document.getElementById('transport-total');
		const decorInput = document.getElementById('decor-total');
		const groceryInput = document.getElementById('grocery-total');
		const diningInput = document.getElementById('dining-total');
		const activitiesInput = document.getElementById('activities-total');

		const displayPerPerson = document.getElementById('display-per-person');
		const displayGrandTotal = document.getElementById('display-trip-grand-total');
		const displayHeadcountText = document.getElementById('display-headcount-text');
		const brideStatusBadge = document.getElementById('bride-status-badge');

		const itemLodgingShare = document.getElementById('item-lodging-share');
		const itemFoodShare = document.getElementById('item-food-share');
		const itemActivityShare = document.getElementById('item-activity-share');
		const itemDecorShare = document.getElementById('item-decor-share');
		const schedDep1 = document.getElementById('sched-dep-1');
		const schedDep2 = document.getElementById('sched-dep-2');

		const btnCopyVenmo = document.getElementById('btn-copy-venmo');
		const btnPrint = document.getElementById('btn-print-itinerary');

		function formatCurrency(val) {
			return `${Math.round(val).toLocaleString('pt-PT')} €`;
		}

		function calculateBachelorette() {
			const bridesmaids = parseInt(bridesmaidCountInput.value, 10) || 1;
			const coverBride = toggleCoverBride.checked;
			const bride = brideNameInput.value.trim() || 'Sara';

			const lodging = parseFloat(airbnbInput.value) || 0;
			const transport = parseFloat(transportInput.value) || 0;
			const decor = parseFloat(decorInput.value) || 0;
			const groceries = parseFloat(groceryInput.value) || 0;
			const dining = parseFloat(diningInput.value) || 0;
			const activities = parseFloat(activitiesInput.value) || 0;

			const grandTotal = lodging + transport + decor + groceries + dining + activities;
			const payingCount = coverBride ? bridesmaids : (bridesmaids + 1);

			const perPersonTotal = grandTotal / payingCount;
			const lodgingShare = lodging / payingCount;
			const foodShare = (groceries + dining) / payingCount;
			const activityShare = activities / payingCount;
			const decorShare = (decor + transport) / payingCount;

			displayPerPerson.textContent = formatCurrency(perPersonTotal);
			displayGrandTotal.textContent = formatCurrency(grandTotal);
			displayHeadcountText.textContent = `${payingCount} amiga${payingCount === 1 ? '' : 's'} a pagar`;

			if (coverBride) {
				brideStatusBadge.textContent = `👰 ${bride} Paga: 0 €`;
				brideStatusBadge.style.background = '#16a34a';
			} else {
				brideStatusBadge.textContent = `👰 ${bride} Paga Quota Igual: ${formatCurrency(perPersonTotal)}`;
				brideStatusBadge.style.background = '#0284c7';
			}

			itemLodgingShare.textContent = formatCurrency(lodgingShare);
			itemFoodShare.textContent = formatCurrency(foodShare);
			itemActivityShare.textContent = formatCurrency(activityShare);
			itemDecorShare.textContent = formatCurrency(decorShare);

			const half = Math.round(perPersonTotal / 2);
			schedDep1.textContent = formatCurrency(half);
			schedDep2.textContent = formatCurrency(Math.round(perPersonTotal) - half);
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'nashville') {
				airbnbInput.value = 1100;
				transportInput.value = 180;
				decorInput.value = 140;
				groceryInput.value = 280;
				diningInput.value = 500;
				activitiesInput.value = 350;
			} else if (p === 'scottsdale') {
				airbnbInput.value = 1300;
				transportInput.value = 160;
				decorInput.value = 150;
				groceryInput.value = 300;
				diningInput.value = 550;
				activitiesInput.value = 400; // Prova Douro
			} else if (p === 'miami') {
				airbnbInput.value = 1500;
				transportInput.value = 200;
				decorInput.value = 160;
				groceryInput.value = 320;
				diningInput.value = 650;
				activitiesInput.value = 450; // Barco / Sunset
			} else if (p === 'cabo') {
				airbnbInput.value = 1600;
				transportInput.value = 220;
				decorInput.value = 120;
				groceryInput.value = 250;
				diningInput.value = 600;
				activitiesInput.value = 500;
			} else if (p === 'local') {
				airbnbInput.value = 650;
				transportInput.value = 60;
				decorInput.value = 90;
				groceryInput.value = 220;
				diningInput.value = 250;
				activitiesInput.value = 120;
			}
			calculateBachelorette();
		});

		// Live Listeners
		[brideNameInput, bridesmaidCountInput, toggleCoverBride, airbnbInput, transportInput, decorInput, groceryInput, diningInput, activitiesInput].forEach(inp => {
			inp.addEventListener('input', calculateBachelorette);
			inp.addEventListener('change', calculateBachelorette);
		});

		// Copy WhatsApp / MB WAY Request
		btnCopyVenmo.addEventListener('click', () => {
			const bride = brideNameInput.value.trim() || 'Sara';
			const perPerson = displayPerPerson.textContent;
			const dep1 = schedDep1.textContent;
			const dep2 = schedDep2.textContent;

			let text = `🎉 *Despedida de Solteira da ${bride} — Detalhes e Pagamento*\n\n`;
			text += `Olá a todas! Eis o resumo dos custos para a despedida da ${bride}:\n\n`;
			text += `💰 *Valor Total por Amiga:* ${perPerson} (cobre a parte da ${bride} para ela pagar 0 €!)\n\n`;
			text += `📋 *O Que Está Incluído:*\n`;
			text += `• Alojamento Local / Estadia: ${itemLodgingShare.textContent}\n`;
			text += `• Jantares, Brunches & Supermercado: ${itemFoodShare.textContent}\n`;
			text += `• Atividades & Passeios de Grupo: ${itemActivityShare.textContent}\n`;
			text += `• Decoração, Brindes & Transfers: ${itemDecorShare.textContent}\n\n`;
			text += `📅 *Pagamento sugerido via MB WAY / Transferência:*\n`;
			text += `1️⃣ Tranche 1 (Sinal de Reserva da Casa): *${dep1}*\n`;
			text += `2️⃣ Tranche 2 (2 semanas antes da viagem): *${dep2}*\n\n`;
			text += `Vai ser inesquecível! Vamos festejar com a ${bride}! 🍾✨`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnCopyVenmo.textContent;
				btnCopyVenmo.textContent = '✅ Mensagem Copiada!';
				setTimeout(() => { btnCopyVenmo.textContent = orig; }, 2500);
			});
		});

		// Print PDF Summary
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Orçamento da Despedida de Solteira — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; color: #0f172a; margin-bottom: 4px; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Despedida de Solteira da ${brideNameInput.value || 'Sara'} — Plano Orçamental</h1>
					<p>Total do Grupo: ${displayGrandTotal.textContent} | <strong>Custo por Participante: ${displayPerPerson.textContent}</strong></p>
					<table>
						<thead><tr><th>Categoria de Despesa</th><th>Total Global (€)</th><th>Quota por Amiga</th></tr></thead>
						<tbody>
							<tr><td>Alojamento Local / Estadia</td><td>${airbnbInput.value} €</td><td>${itemLodgingShare.textContent}</td></tr>
							<tr><td>Restaurantes, Brunches & Supermercado</td><td>${parseFloat(groceryInput.value) + parseFloat(diningInput.value)} €</td><td>${itemFoodShare.textContent}</td></tr>
							<tr><td>Atividades & Passeios de Grupo</td><td>${activitiesInput.value} €</td><td>${itemActivityShare.textContent}</td></tr>
							<tr><td>Decoração, Brindes & Transfers</td><td>${parseFloat(decorInput.value) + parseFloat(transportInput.value)} €</td><td>${itemDecorShare.textContent}</td></tr>
							<tr class="total-row"><td>TOTAL A PAGAR POR AMIGA</td><td>${displayGrandTotal.textContent}</td><td>${displayPerPerson.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Initial Calculation
		calculateBachelorette();
	</script>
</Layout>
