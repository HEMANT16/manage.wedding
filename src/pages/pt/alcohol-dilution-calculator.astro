---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Calculadora de Diluição de Álcool e Teor Alcoólico (ABV)",
      "url": "https://manage.wedding/pt/alcohol-dilution-calculator",
      "inLanguage": "pt",
      "description": "Calcule a quantidade exata de água destilada ou misturador necessária para diluir bebidas alcoólicas e licores caseiros até ao teor alcoólico (ABV) desejado para cocktails de casamento.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Diluir Álcool e Ajustar o Teor Alcoólico (ABV)",
      "description": "Fórmula passo a passo para calcular a adição de água na preparação de cocktails em lote e licores de casamento.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Introduza o Volume Inicial (ml)",
          "text": "Indique a quantidade inicial de álcool base em mililitros (ex.: 750 ml ou 1.000 ml)."
        },
        {
          "@type": "HowToStep",
          "name": "Indique o Teor Alcoólico Inicial (% ABV)",
          "text": "Introduza a percentagem alcoólica de partida (ex.: 95% para álcool neutro/aguardente ou 40% para vodka padrão)."
        },
        {
          "@type": "HowToStep",
          "name": "Defina o Teor Alcoólico Alvo (% ABV)",
          "text": "Especifique a graduação final pretendida (ex.: 20% para cocktails em jarro ou 30% para licores caseiros)."
        },
        {
          "@type": "HowToStep",
          "name": "Obtenha a Quantidade de Água e Volume Final",
          "text": "A ferramenta aplica a fórmula C1 × V1 = C2 × V2 e indica o volume exato de água destilada a misturar."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Como funciona a calculadora de diluição de álcool?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A calculadora baseia-se no princípio químico de conservação de massa (C1 × V1 = C2 × V2) para calcular os mililitros exatos de água a adicionar para atingir o teor alcoólico pretendido."
          }
        },
        {
          "@type": "Question",
          "name": "Por que razão a bebida ficou turva após a diluição?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O efeito de turvação (ou louche) ocorre quando óleos essenciais presentes em bebidas botânicas (como anis, gin ou limoncello) se tornam insolúveis ao baixar o teor alcoólico. Usar água destilada à temperatura ambiente e verter o álcool sobre a água lentamente minimiza este fenómeno."
          }
        },
        {
          "@type": "Question",
          "name": "Que tipo de água devo usar para diluir álcool de cocktails?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Recomenda-se vivamente o uso de água destilada, desmineralizada ou filtrada por osmose inversa. A água da torneira contém cloro e minerais que alteram o aroma e o sabor límpido da bebida."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Diluição de Álcool & Teor Alcoólico (ABV) | Manage.Wedding"
	description="Calcule a quantidade exata de água ou sumo para diluir aguardente, vodka e licores artesanais até ao teor alcoólico pretendido para cocktails de casamento."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<Breadcrumb title="Calculadora de Diluição de Álcool" category="food-dining" />
		
		<header class="fade-in category-header" style="text-align: center;">
			<h1 class="font-heading" style="font-size: 3.5rem; margin-bottom: 0.5rem; font-weight: 500;">Calculadora de <span class="accent-italic">Diluição de Álcool</span></h1>
			<p class="font-body" style="color: var(--secondary-ink); max-width: 650px; margin: 0 auto;">Ajuste o teor alcoólico (ABV) de cocktails em lote, licores tradicionais de casamento ou bebidas de assinatura com precisão científica.</p>
		</header>

		<div class="home-grid fade-in" style="animation-delay: 0.2s; max-width: 900px; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 0 auto;">
			<div class="hand-card">
				<form id="calc-form">
					<div class="form-group">
						<label class="form-label" for="initialVolume">Volume Inicial (ml)</label>
						<input type="number" id="initialVolume" class="form-input" value="1000" min="1" step="0.1" required />
					</div>

					<div class="form-group">
						<label class="form-label" for="initialABV">Teor Alcoólico Inicial (% ABV / Vol)</label>
						<input type="number" id="initialABV" class="form-input" value="95" min="1" max="100" step="0.1" required />
					</div>

					<div class="form-group">
						<label class="form-label" for="targetABV">Teor Alcoólico Alvo (% ABV / Vol)</label>
						<input type="number" id="targetABV" class="form-input" value="40" min="1" max="100" step="0.1" required />
					</div>

					<button type="submit" id="calc-btn" class="hand-btn" style="width: 100%;">Calcular Diluição</button>
				</form>
			</div>

			<div class="hand-card result-box" id="result-container">
				<h3 class="font-heading" style="margin-bottom: 1.5rem;">Resultados da Diluição</h3>
				
				<div class="result-item" style="margin-bottom: 1rem;">
					<span class="item-label">ÁGUA / MISTURADOR</span>
					<span class="item-desc">Quantidade a adicionar (ml)</span>
					<span class="item-value" id="res-water" style="color: var(--accent-blue); font-size: 2.5rem; display: block; margin-top: 0.5rem;">1375.00</span>
				</div>

				<div class="result-item" style="margin-bottom: 2rem;">
					<span class="item-label">VOLUME FINAL</span>
					<span class="item-desc">Volume total resultante (ml)</span>
					<span class="item-value" id="res-final" style="font-size: 1.5rem; display: block; margin-top: 0.5rem;">2375.00</span>
				</div>

				<div class="chart-container" style="border: 2px solid var(--fg-pencil); padding: 1rem; border-radius: 8px; background: #fff;">
					<p class="font-body" style="font-size: 0.9rem; margin-bottom: 0.5rem; font-weight: bold;">Distribuição de Volume</p>
					<div style="display: flex; height: 30px; border: 1px solid var(--fg-pencil); border-radius: 4px; overflow: hidden;">
						<div id="chart-alcohol" style="width: 42.1%; background-color: var(--fg-pencil); color: var(--bg-paper); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; transition: width 0.3s ease;">Álcool Base</div>
						<div id="chart-water" style="width: 57.9%; background-color: transparent; background-image: repeating-linear-gradient(45deg, transparent, transparent 5px, var(--fg-pencil) 5px, var(--fg-pencil) 6px); color: var(--fg-pencil); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold; transition: width 0.3s ease;">Água</div>
					</div>
					<div style="display: flex; justify-content: space-between; margin-top: 0.5rem; font-size: 0.8rem; color: var(--secondary-ink);">
						<span>Álcool Base: <span id="lbl-alcohol">42.1%</span></span>
						<span>Água a Adicionar: <span id="lbl-water">57.9%</span></span>
					</div>
				</div>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 3.5rem auto 2.5rem; max-width: 800px; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape"></div>
			
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Resumo Direto ao Assunto (BLUF)
				</h3>
				<span style="background: #fff; border: 1.5px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700; color: var(--accent-red);">
					Fórmula Química em 1 Minuto
				</span>
			</div>

			<!-- Formula Highlight Box -->
			<div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<div style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--accent-red); margin-bottom: 0.35rem; font-weight: 700;">
					📐 A Equação Central de Diluição:
				</div>
				<p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.5;">
					<strong>C₁ × V₁ = C₂ × V₂</strong><br />
					<strong>Água a Adicionar (ml) = [(ABV Inicial × Volume Inicial) ÷ ABV Alvo] - Volume Inicial</strong><br />
					<em>Onde:</em> C₁ = % Alcoólica Inicial, V₁ = Volume Inicial (ml), C₂ = % Alcoólica Alvo, V₂ = Volume Final (ml).
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; margin-bottom: 1rem; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 560px;">
					<thead>
						<tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil);">Bebida / Base</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil); text-align: center;">Volume Inicial</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red); text-align: center;">ABV Alvo</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue); text-align: center;">Água a Adicionar</th>
							<th style="padding: 0.6rem 0.75rem; font-weight: 700; color: var(--fg-pencil); text-align: right;">Volume Final</th>
						</tr>
					</thead>
					<tbody>
