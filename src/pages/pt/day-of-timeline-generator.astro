		padding: 0.2rem 0.6rem;
		font-size: 0.8rem;
		cursor: pointer;
		font-family: var(--font-body);
		transition: all 0.15s ease;
	}
	.role-pill-btn.active-role {
		background: var(--fg-pencil) !important;
		color: #fff !important;
	}

	.timeline-event-card {
		position: relative;
		margin-bottom: 1.75rem;
