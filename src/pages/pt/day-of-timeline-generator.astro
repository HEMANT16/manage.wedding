</style>

<script is:inline>
	let timelineEvents = [];
	let activeRoleFilter = 'all';

	const ceremonyInput = document.getElementById('ceremony-time');
	const firstLookInput = document.getElementById('first-look');
	const travelInput = document.getElementById('travel-time');
	const receptionHoursInput = document.getElementById('reception-hours');
	const timelineStream = document.getElementById('timeline-stream');

	function parseTimeToMinutes(timeStr) {
		const [h, m] = timeStr.split(':').map(Number);
		return h * 60 + m;
	}

	function minutesToFormattedTime(totalMinutes) {
		let normalized = (totalMinutes % 1440 + 1440) % 1440;
		let hours = Math.floor(normalized / 60);
		let minutes = normalized % 60;
		const hStr = hours < 10 ? '0' + hours : hours;
		const minStr = minutes < 10 ? '0' + minutes : minutes;
		return `${hStr}:${minStr}`;
	}

	function calculateTimeline() {
		const ceremonyMins = parseTimeToMinutes(ceremonyInput.value);
		const firstLook = firstLookInput.value;
		const travelMins = parseInt(travelInput.value) || 0;
		const receptionLengthMins = Math.round(parseFloat(receptionHoursInput.value) * 60);

		timelineEvents = [];

		if (firstLook === 'yes') {
			timelineEvents.push({
				id: 'evt-1',
				minutes: ceremonyMins - travelMins - 120 - 150,
				name: 'Cabelo & Maquilhagem / Preparativos da Noiva',
				role: 'wedding-party',
				description: 'Preparação com damas de honor, roupões e brinde'
			});
			timelineEvents.push({
				id: 'evt-2',
				minutes: ceremonyMins - travelMins - 120 - 45,
				name: 'Chegada da Fotografia & Detalhes',
				role: 'photo',
				description: 'Fotografia de vestido, sapatos, alianças, convites e maquilhagem'
			});
			timelineEvents.push({
				id: 'evt-3',
				minutes: ceremonyMins - travelMins - 120 - 15,
				name: 'Noiva Veste o Vestido de Noiva',
				role: 'wedding-party',
				description: 'Mãe e damas de honor ajudam a fechar o vestido e colocar o véu'
			});
			timelineEvents.push({
				id: 'evt-4',
				minutes: ceremonyMins - travelMins - 120,
				name: 'Sessão "First Look" & Retratos a Dois',
				role: 'photo',
				description: 'Primeiro encontro romântico e privado dos noivos'
			});
			timelineEvents.push({
				id: 'evt-5',
				minutes: ceremonyMins - travelMins - 60,
				name: 'Fotografias com Padrinhos & Família Próxima',
				role: 'photo',
				description: 'Retratos de grupo antes da chegada dos convidados'
			});
			if (travelMins > 0) {
				timelineEvents.push({
					id: 'evt-6',
					minutes: ceremonyMins - travelMins - 15,
					name: 'Deslocação para o Local da Cerimónia / Igreja',
					role: 'wedding-party',
					description: `${travelMins} minutos de viagem com margem de segurança`
				});
			}
			timelineEvents.push({
				id: 'evt-7',
				minutes: ceremonyMins - 20,
				name: 'Noivos em Sala Privada / Chegada dos Convidados',
				role: 'wedding-party',
				description: 'Música de prelúdio e acolhimento dos convidados'
			});
		} else {
			timelineEvents.push({
				id: 'evt-1',
				minutes: ceremonyMins - travelMins - 180,
				name: 'Cabelo & Maquilhagem / Preparativos',
				role: 'wedding-party',
				description: 'Preparativos da noiva e damas de honor'
			});
			timelineEvents.push({
				id: 'evt-2',
				minutes: ceremonyMins - travelMins - 75,
				name: 'Chegada da Fotografia para Making Of',
				role: 'photo',
				description: 'Retratos separados da noiva/damas e do noivo/padrinhos'
			});
			if (travelMins > 0) {
				timelineEvents.push({
					id: 'evt-3',
					minutes: ceremonyMins - travelMins - 15,
					name: 'Deslocação para a Cerimónia',
					role: 'wedding-party',
					description: `${travelMins} minutos de viagem com margem`
				});
			}
			timelineEvents.push({
				id: 'evt-4',
				minutes: ceremonyMins - 20,
				name: 'Acomodação dos Convidados',
				role: 'wedding-party',
				description: 'Música ambiente e entrada dos convidados'
			});
		}

		// Cerimonia
		timelineEvents.push({
			id: 'evt-ceremony',
			minutes: ceremonyMins,
			name: 'Cerimónia de Casamento & Troca de Alianças',
			role: 'ceremony',
			description: 'Entrada solene, votos, troca de alianças e primeiro beijo de casados'
		});

		// Cocktail
		const cocktailMins = ceremonyMins + 45;
		timelineEvents.push({
			id: 'evt-cocktail',
			minutes: cocktailMins,
			name: firstLook === 'yes' ? "Cocktail de Boas-Vindas & Copo-d'Água" : "Cocktail & Fotografias de Família com os Noivos",
			role: 'reception',
			description: firstLook === 'yes' ? 'Entradas volantes e convívio dos noivos com os convidados' : 'Entradas, bebidas e fotografias de grupo no jardim'
		});

		// Entrada no Salao
		const grandEntranceMins = cocktailMins + 75;
		timelineEvents.push({
			id: 'evt-entrance',
			minutes: grandEntranceMins,
			name: 'Entrada Triunfal dos Noivos na Sala de Jantar',
			role: 'reception',
			description: 'Anúncio pelo DJ/Músicos e entrada com música animada'
		});

		// Jantar
		const dinnerMins = grandEntranceMins + 15;
		timelineEvents.push({
			id: 'evt-dinner',
			minutes: dinnerMins,
			name: 'Início do Serviço de Jantar',
			role: 'reception',
			description: 'Serviço de refeição empratada ou buffet da quinta'
		});

		// Discursos e Brindes
		const toastsMins = dinnerMins + 60;
		timelineEvents.push({
			id: 'evt-toasts',
			minutes: toastsMins,
			name: 'Brindes & Discursos dos Padrinhos e Pais',
			role: 'reception',
			description: 'Discursos de homenagem e brinde com champanhe'
		});

		// Corte do Bolo
		const cakeMins = dinnerMins + 105;
		timelineEvents.push({
			id: 'evt-cake',
			minutes: cakeMins,
			name: 'Corte Solene do Bolo de Noiva & Champanhe',
			role: 'reception',
			description: 'Corte do bolo no exterior com sparkles / fogo de artifício'
		});

		// Abertura da Pista
		const dancingMins = dinnerMins + 120;
		timelineEvents.push({
			id: 'evt-dance',
			minutes: dancingMins,
			name: 'Primeira Dança dos Noivos & Abertura da Pista de Dança',
			role: 'reception',
			description: 'Dança a dois, dança com os pais e início da festa com DJ/Banda'
		});

		// Saida / Ceia
		const exitMins = ceremonyMins + 45 + receptionLengthMins;
		timelineEvents.push({
			id: 'evt-exit',
			minutes: exitMins,
			name: 'Ceia da Noite & Encerramento da Festa',
			role: 'reception',
			description: 'Caldo verde, mesa de queijos, doces tradicionais e despedida'
		});

		timelineEvents.sort((a, b) => a.minutes - b.minutes);
		renderTimeline();
	}

	function renderTimeline() {
		timelineStream.innerHTML = '';

		const filtered = timelineEvents.filter(evt => {
			if (activeRoleFilter === 'all') return true;
			if (activeRoleFilter === 'wedding-party') return evt.role === 'wedding-party' || evt.role === 'ceremony';
			if (activeRoleFilter === 'photo') return evt.role === 'photo' || evt.role === 'ceremony';
			if (activeRoleFilter === 'reception') return evt.role === 'reception';
			return true;
		});

		if (filtered.length === 0) {
			timelineStream.innerHTML = '<p style="color: var(--text-secondary); font-style: italic;">Nenhum evento encontrado para este filtro.</p>';
			return;
		}

		filtered.forEach((evt, idx) => {
			const card = document.createElement('div');
			card.className = 'timeline-event-card';

			let tagClass = 'tag-wedding-party';
			let tagLabel = '👰 Noivos & Padrinhos';
			if (evt.role === 'photo') { tagClass = 'tag-photo'; tagLabel = '📸 Fotografia'; }
			else if (evt.role === 'reception') { tagClass = 'tag-reception'; tagLabel = '🍽️ Copo-d’Água'; }
			else if (evt.role === 'ceremony') { tagClass = 'tag-ceremony'; tagLabel = '⛪ Cerimónia'; }

			const formattedTime = minutesToFormattedTime(evt.minutes);

			card.innerHTML = `
				<div class="timeline-bullet-dot"></div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.3rem;">
					<strong class="font-heading" style="font-size: 1.3rem; color: var(--accent-blue);">${formattedTime}</strong>
					<span class="event-tag ${tagClass}">${tagLabel}</span>
				</div>
				<h4 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.3rem 0;">
					${evt.name}
				</h4>
				<p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); margin: 0; line-height: 1.4;">
					${evt.description || ''}
				</p>
				<div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.4rem;">
					<button type="button" style="background:none; border:none; color: var(--accent-red); cursor:pointer; font-size: 0.8rem; font-weight:bold;" onclick="removeTimelineEvent('${evt.id}')">Remover</button>
				</div>
			`;

			timelineStream.appendChild(card);
		});
	}

	window.removeTimelineEvent = function(id) {
		timelineEvents = timelineEvents.filter(e => e.id !== id);
		renderTimeline();
	};

	// Form change listeners
	ceremonyInput.addEventListener('change', calculateTimeline);
	firstLookInput.addEventListener('change', calculateTimeline);
	travelInput.addEventListener('input', calculateTimeline);
	receptionHoursInput.addEventListener('change', calculateTimeline);

	// Presets
	document.querySelectorAll('.preset-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active-preset'));
			btn.classList.add('active-preset');

			ceremonyInput.value = btn.getAttribute('data-ceremony');
			firstLookInput.value = btn.getAttribute('data-firstlook');
			travelInput.value = btn.getAttribute('data-travel');
			receptionHoursInput.value = btn.getAttribute('data-reception');

			calculateTimeline();
		});
	});

	// Role Filters
	document.querySelectorAll('.role-pill-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.role-pill-btn').forEach(b => b.classList.remove('active-role'));
			btn.classList.add('active-role');
			activeRoleFilter = btn.getAttribute('data-role');
			renderTimeline();
		});
	});

	// Add Custom Milestone Form
	document.getElementById('add-custom-event-form').addEventListener('submit', (e) => {
		e.preventDefault();
		const name = document.getElementById('custom-event-name').value.trim();
		const timeStr = document.getElementById('custom-event-time').value;
		const role = document.getElementById('custom-event-role').value;

		if (!name || !timeStr) return;

		timelineEvents.push({
			id: 'custom-' + Date.now(),
			minutes: parseTimeToMinutes(timeStr),
			name,
			role,
			description: 'Momento personalizado adicionado'
		});

		timelineEvents.sort((a, b) => a.minutes - b.minutes);
		renderTimeline();
		document.getElementById('custom-event-name').value = '';
	});

	// 📋 Copy Text Summary
	document.getElementById('btn-copy-summary').addEventListener('click', () => {
		if (timelineEvents.length === 0) return;
		let text = `💍 CRONOGRAMA DO CASAMENTO (Cerimónia às ${minutesToFormattedTime(parseTimeToMinutes(ceremonyInput.value))})\n\n`;
		timelineEvents.forEach(evt => {
			text += `• ${minutesToFormattedTime(evt.minutes)} — ${evt.name}\n`;
		});

		navigator.clipboard.writeText(text).then(() => {
			const btn = document.getElementById('btn-copy-summary');
			btn.textContent = '✅ Copiado para a Área de Transferência!';
			setTimeout(() => { btn.textContent = '📋 Copiar Roteiro'; }, 2000);
		});
	});

	// 📝 Export to Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		if (timelineEvents.length === 0) return;

		let rows = '';
		timelineEvents.forEach((evt, idx) => {
			rows += `
				<tr>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold; width:80px;">${minutesToFormattedTime(evt.minutes)}</td>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold;">${evt.name}</td>
					<td style="border:1px solid #ccc; padding:8px; width:140px;">${evt.role.replace('-', ' ').toUpperCase()}</td>
					<td style="border:1px solid #ccc; padding:8px; color:#555;">${evt.description || '-'}</td>
				</tr>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Roteiro do Dia do Casamento</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Roteiro Oficial do Dia do Casamento</h1>
				<p>Gerado em ${new Date().toLocaleDateString('pt-PT')} | Início da Cerimónia: ${minutesToFormattedTime(parseTimeToMinutes(ceremonyInput.value))}</p>
				<table>
					<thead>
						<tr>
							<th>Hora</th>
							<th>Momento / Marco</th>
							<th>Categoria</th>
							<th>Notas de Logística</th>
						</tr>
					</thead>
					<tbody>
						${rows}
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Cronograma_Casamento_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const printDate = document.getElementById('print-date');
		const printCeremony = document.getElementById('print-ceremony-time');
		const printTbody = document.getElementById('print-timeline-body');

		printDate.textContent = new Date().toLocaleDateString('pt-PT');
		printCeremony.textContent = minutesToFormattedTime(parseTimeToMinutes(ceremonyInput.value));

		printTbody.innerHTML = '';
		timelineEvents.forEach(evt => {
			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">${minutesToFormattedTime(evt.minutes)}</td>
				<td style="border: 1px solid #ccc; padding: 6px;">
					<strong>${evt.name}</strong>
					<div style="font-size: 11px; color: #555;">${evt.description || ''}</div>
				</td>
				<td style="border: 1px solid #ccc; padding: 6px;">${evt.role.replace('-', ' ').toUpperCase()}</td>
			`;
			printTbody.appendChild(tr);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Hora,Momento,Categoria,Notas\n";
		timelineEvents.forEach(evt => {
			csv += `"${minutesToFormattedTime(evt.minutes)}","${(evt.name||'').replace(/"/g, '""')}","${evt.role}","${(evt.description||'').replace(/"/g, '""')}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Cronograma_Casamento_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateTimeline();
</script>
