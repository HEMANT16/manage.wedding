		top: 1rem;
		width: 14px;
		height: 14px;
		background: #fff;
		border: 2.5px solid var(--fg-pencil);
		border-radius: 50%;
		box-shadow: 0 0 0 3px var(--bg-paper);
	}

	.event-tag {
		font-size: 0.75rem;
		padding: 0.1rem 0.45rem;
		border-radius: 3px;
		border: 1px solid var(--fg-pencil);
		font-weight: bold;
		display: inline-block;
	}
	.tag-wedding-party {
		background: #ffdfba;
	}
	.tag-photo {
		background: #baffc9;
	}
	.tag-reception {
		background: #bae1ff;
