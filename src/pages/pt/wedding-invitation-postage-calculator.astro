---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-invitation-postage-calculator/#webapp",
      "name": "Calculadora de Portes e Peso de Convites de Casamento",
      "url": "https://manage.wedding/pt/wedding-invitation-postage-calculator",
      "inLanguage": "pt",
      "description": "Calcule com exatidão o peso do conjunto de convites de casamento e os portes de correio necessários. Inclui gramagem de papel (g/m²), lacres de cera, laços de fita, formatos quadrados e escalões de franquia postal para evitar devoluções.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular o Peso e os Portes Postais dos Convites de Casamento",
      "description": "Guia passo a passo para pesar o conjunto de convites completo e comprar os selos de correio adequados sem risco de devolução.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Reúna uma Amostra Completa do Convite",
          "text": "Junte todos os elementos: envelope exterior, cartão de convite principal, cartão de detalhes do copo-d'água, cartão e envelope de RSVP, fita e lacre de cera."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Verifique os Fatores de Envio Especial",
          "text": "Avalie se o envelope possui lacre de cera em relevo, laço de fita espesso, placa de acrílico ou formato quadrado (15x15 cm) que impeça a triagem automática."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Pese numa Balança Digital de Precisão",
          "text": "Se o peso for até 20g, aplica-se a tarifa base de correio normal. Se pesar entre 21g e 50g, ou entre 51g e 100g, aplica-se o escalão de peso correspondente."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Inclua o Selo no Envelope de Resposta (RSVP)",
          "text": "Cole antecipadamente um selo postal padrão em cada envelope de resposta pré-endereçado aos noivos para facilitar a devolução pelos convidados."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanto custa o envio de um convite de casamento pelos correios?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Um convite retangular padrão com menos de 20g requer um selo de correio normal base (~0,70€ a 0,85€). Se o convite tiver cartolina grossa (300g+) com vários anexos, pesará frequentemente entre 25g e 45g, subindo para o escalão de 20g–50g (~1,10€ a 1,40€)."
          }
        },
        {
          "@type": "Question",
          "name": "Os lacres de cera exigem portes adicionais?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Os lacres de cera adicionam cerca de 4g a 5g de peso e criam uma espessura irregular no envelope. Como podem partir ou encravar nas máquinas de triagem automática, devem ser carimbados manualmente ao balcão."
          }
        },
        {
          "@type": "Question",
          "name": "Por que razão os envelopes quadrados pagam taxa superior?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As máquinas de triagem dos correios exigem que o comprimento do envelope seja superior à altura. Formatos quadrados (proporção 1:1) não passam nos rolos automáticos e requerem tratamento manual."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Portes e Peso de Convites de Casamento | Manage.Wedding"
	description="Calcule com exatidão o peso do conjunto de convites e os portes de correio necessários. Inclui gramagem (g/m²), lacres de cera, laços de fita, envelopes quadrados e taxas de correio."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Portes de Convites" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Evite Devoluções por Falta de Franquia</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Calculadora de <span class="accent-italic">Portes de Convites</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Evite devoluções e carimbos de taxa a pagar! Calcule o peso exato do conjunto de convites em gramas, verifique suplementos de formatos especiais ou lacres de cera e obtenha o orçamento exato de selos postais.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Suite Component Builder & Weight Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Componentes do Conjunto de Convite
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Tarifas Postais 2026
					</span>
				</div>

				<!-- Suite Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="suite-preset">Modelo de Convite Pré-definido</label>
					<select id="suite-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="classic" selected>💌 Conjunto Clássico de 3 Peças (Envelope A7 + Cartão 300g + RSVP + Envelope / ~27g)</option>
						<option value="luxury-wax">👑 Conjunto de Luxo com Lacre de Cera & Fita (Cartão 600g + Detalhes + Lacre / ~41g)</option>
						<option value="square">🔲 Conjunto Quadrado Moderno (Envelope 15x15 cm + Cartolina Dupla / Não Mecanizável)</option>
						<option value="minimalist">🌿 Minimalista 2 Peças (RSVP por QR Code / Sem Envelope de Retorno / ~18g)</option>
						<option value="custom">✏️ Personalizar Componentes</option>
					</select>
				</div>

				<!-- Total Households / Invitations Count -->
				<div class="form-group">
					<label class="form-label" for="invitation-count">Total de Envelopes a Enviar pelos Correios</label>
					<input type="number" id="invitation-count" class="form-input" value="80" min="5" max="500" style="font-size: 1.1rem; font-weight: 700;" />
				</div>

				<!-- Outer Envelope Style -->
				<div class="form-group">
					<label class="form-label" for="outer-envelope-type">Formato e Dimensão do Envelope Exterior</label>
					<select id="outer-envelope-type" class="form-input" style="cursor: pointer;">
						<option value="a7-rect" selected>Envelope Retangular A7 (133 × 184 mm) — Padrão (6,8g)</option>
						<option value="square-6">Envelope Quadrado (15 × 15 cm) — Formato Especial (9,1g)</option>
						<option value="a8-rect">Envelope A8 / Sobrescrito Grande (140 × 206 mm) (8,5g)</option>
					</select>
				</div>

				<!-- Cardstock Thickness (Main Invitation) -->
				<div class="form-group">
					<label class="form-label" for="cardstock-weight">Gramagem do Cartão Principal de Convite 13x18 cm</label>
					<select id="cardstock-weight" class="form-input" style="cursor: pointer;">
						<option value="110lb" selected>Cartolina Padrão (300–350 g/m²) — 9,9g</option>
						<option value="220lb">Cartolina de Luxo Dupla / Algodão (600 g/m²) — 19,8g</option>
						<option value="acrylic">Placa de Acrílico / Rígido (3 mm) — 42,5g</option>
					</select>
				</div>

				<!-- Additional Inserts (Checkboxes) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Cartões Suplementares & Acessórios
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-details-card" checked style="width: 18px; height: 18px;" />
							<span>Cartão de Detalhes / Informações (+5,1g)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-rsvp-card" checked style="width: 18px; height: 18px;" />
							<span>Cartão RSVP Físico + Envelope de Resposta A2 (+9,1g)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-vellum" style="width: 18px; height: 18px;" />
							<span>Envelope Luva / Papel Vegetal Vellum (+5,7g)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--accent-red); font-weight: 700;">
							<input type="checkbox" id="check-wax-seal" style="width: 18px; height: 18px;" />
							<span>Lacre de Cera (+4,3g + Triagem Manual)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--accent-blue); font-weight: 700;">
							<input type="checkbox" id="check-ribbon" style="width: 18px; height: 18px;" />
							<span>Fita de Seda / Cordel (+3,4g + Triagem Manual)</span>
						</label>
					</div>
				</div>

			</div>

			<!-- Right Column: Results, Stamp Shopping List & Non-Machinable Warnings -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Postage Rate & Stamp Recommendation Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Porte Recomendado por Envelope
						</span>
						<span id="stamp-category-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							Escalão 20g–50g
						</span>
					</div>

					<div id="display-rate-per-envelope" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						1,20 €
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Peso Total do Conjunto: <strong id="display-total-weight-g" style="color: var(--fg-pencil);">26,9 g</strong> (<span id="display-total-weight-oz">0.95 oz</span>).
					</p>

					<!-- Itemized Stamp Shopping List -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<strong style="display: block; font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--fg-pencil);">
							📮 Lista de Compra de Selos (<span id="shopping-household-count">80</span> Convites):
						</strong>
						
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span id="outer-stamp-desc">80 × Selos Envelope Exterior:</span>
							<strong id="outer-stamp-cost">96,00 €</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span id="rsvp-stamp-desc">80 × Selos Envelope de Retorno RSVP:</span>
							<strong id="rsvp-stamp-cost">64,00 €</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.5rem 0 0 0; font-size: 1.05rem; font-weight: 700; color: var(--accent-red);">
							<span>ORÇAMENTO TOTAL DE CORREIO:</span>
							<strong id="display-grand-total-postage">160,00 €</strong>
						</div>
					</div>

					<!-- Non-Machinable Flag Alert Box -->
					<div id="non-machinable-alert" style="display: none; background: #fef2f2; border: 1.5px solid #ef4444; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem; font-size: 0.88rem; color: #991b1b; line-height: 1.5;">
						<strong>⚠️ Atenção a Envelopes com Relevo / Formato Especial:</strong><br />
						<span id="non-machinable-reasons">O convite contém lacre de cera ou formato quadrado. Peça o carimbo manual ao balcão dos correios para evitar que o lacre parta nas máquinas automáticas.</span>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-postage" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Folha de Selos (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar Word (.doc)
						</button>
					</div>

				</div>

				<!-- Hand-Canceling Tip Card -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						💌 Dicas para Envio Seguro dos Convites:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Nunca Coloque na Caixa de Rua:</strong> Dirija-se sempre ao balcão dos correios para evitar que os envelopes delicados sejam esmagados com encomendas pesadas.</li>
						<li><strong>Peça Carimbagem Manual:</strong> Solicite simpaticamente ao funcionário: <em>"Poderia carimbar estes convites de casamento à mão para não manchar a caligrafia?"</em></li>
						<li><strong>Leve 1 Convite Montado para Pesar:</strong> Confirme o peso exato da amostra na balança oficial antes de comprar os selos para todos os convidados.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumo Direto ao Assunto (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Escalões de Peso e Portes Postais para Convites
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Consulte a tabela comparativa de pesos e tarifas postais para conjuntos de convites de casamento.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📬 Regra Geral de Franquia Postal para Convites:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Até 20g = Selo Correio Normal Base • De 21g a 50g = Escalão 50g (Maioria dos convites 3 peças com 300g+) • De 51g a 100g = Escalão 100g (Convites em acrílico ou luxo com lacre de cera espesso).
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Tipo de Conjunto de Convite</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Peso Médio Estimado</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Processamento</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Escalão Postal Recomendado</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Simples (A7 + Cartão 300g sem RSVP físico)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">16 – 19 g</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Automático</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">Até 20g (Correio Normal)</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Padrão 3 Peças (A7 + Cartão + RSVP + Envelope)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">25 – 35 g</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Automático / Normal</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">20g a 50g</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Com Lacre de Cera ou Fita de Seda</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">30 – 45 g</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-red);">Manual Recomendado</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">20g a 50g (Carimbo ao balcão)</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Envelope Quadrado (15 × 15 cm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">28 – 40 g</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-red);">Formato Não Padrão</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">20g a 50g (Formato Especial)</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guia Prático para Envio de Convites de Casamento por Correio
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Como calcular o peso exato, escolher selos temáticos e evitar custos imprevistos com devoluções.
				</p>
			</div>

			<!-- Section 1: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Os envelopes de resposta (RSVP) precisam do seu próprio selo?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Sim. A etiqueta de casamento estabelece que os noivos devem colar previamente o selo postal no envelope de resposta para que o convidado apenas precise de preencher o cartão e colocá-lo no marco de correio.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Quando devem ser colocados os convites nos correios?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Para casamentos locais, envie entre 6 a 8 semanas antes do evento. Para convidados no estrangeiro ou casamentos fora da cidade, envie com 10 a 14 semanas de antecedência.
					</p>
				</details>
			</section>

		</article>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/pt/wedding-invitation-postage-calculator" category="stationery" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('suite-preset');
		const invitationCountInput = document.getElementById('invitation-count');
		const outerEnvSelect = document.getElementById('outer-envelope-type');
		const cardstockSelect = document.getElementById('cardstock-weight');

		const checkDetails = document.getElementById('check-details-card');
		const checkRsvp = document.getElementById('check-rsvp-card');
		const checkVellum = document.getElementById('check-vellum');
		const checkWax = document.getElementById('check-wax-seal');
		const checkRibbon = document.getElementById('check-ribbon');

		const displayRate = document.getElementById('display-rate-per-envelope');
		const stampCategoryBadge = document.getElementById('stamp-category-badge');
		const displayWeightOz = document.getElementById('display-total-weight-oz');
		const displayWeightG = document.getElementById('display-total-weight-g');

		const shoppingHouseholdCount = document.getElementById('shopping-household-count');
		const outerStampDesc = document.getElementById('outer-stamp-desc');
		const outerStampCost = document.getElementById('outer-stamp-cost');
		const rsvpStampDesc = document.getElementById('rsvp-stamp-desc');
		const rsvpStampCost = document.getElementById('rsvp-stamp-cost');
		const displayGrandTotalPostage = document.getElementById('display-grand-total-postage');

		const nonMachinableAlert = document.getElementById('non-machinable-alert');
		const nonMachinableReasons = document.getElementById('non-machinable-reasons');

		const btnPrint = document.getElementById('btn-print-postage');
		const btnDoc = document.getElementById('btn-export-doc');

		function calculatePostage() {
			const count = parseInt(invitationCountInput.value, 10) || 1;
			shoppingHouseholdCount.textContent = count;

			// Weight Component Math (grams)
			let weightG = 0;

			// Outer Envelope
			if (outerEnvSelect.value === 'a7-rect') weightG += 6.8;
			else if (outerEnvSelect.value === 'square-6') weightG += 9.1;
			else if (outerEnvSelect.value === 'a8-rect') weightG += 8.5;

			// Main Card
			if (cardstockSelect.value === '110lb') weightG += 9.9;
			else if (cardstockSelect.value === '220lb') weightG += 19.8;
			else if (cardstockSelect.value === 'acrylic') weightG += 42.5;

			// Inserts
			if (checkDetails.checked) weightG += 5.1;
			if (checkRsvp.checked) weightG += 9.1;
			if (checkVellum.checked) weightG += 5.7;
			if (checkWax.checked) weightG += 4.3;
			if (checkRibbon.checked) weightG += 3.4;

			// Non-Machinable / Special
			let isNonMachinable = false;
			const reasons = [];

			if (outerEnvSelect.value === 'square-6') {
				isNonMachinable = true;
				reasons.push('Formato quadrado (proporção 1:1)');
			}
			if (checkWax.checked) {
				isNonMachinable = true;
				reasons.push('Lacre de cera com relevo');
			}
			if (checkRibbon.checked) {
				isNonMachinable = true;
				reasons.push('Laço ou fita em tecido');
			}
			if (cardstockSelect.value === 'acrylic') {
				isNonMachinable = true;
				reasons.push('Placa rígida de acrílico');
			}

			// Postage Rates (EUR estimation)
			let outerRate = 0.80; // até 20g
			let stampName = 'Escalão até 20g (Correio Normal)';

			if (weightG <= 20.0) {
				outerRate = 0.80;
				stampName = 'Escalão até 20g';
			} else if (weightG <= 50.0) {
				outerRate = 1.20;
				stampName = 'Escalão 20g–50g';
			} else if (weightG <= 100.0) {
				outerRate = 1.60;
				stampName = 'Escalão 50g–100g';
			} else {
				outerRate = 2.40;
				stampName = 'Escalão > 100g';
			}

			const rsvpRate = checkRsvp.checked ? 0.80 : 0;

			const totalOuterPostage = outerRate * count;
			const totalRsvpPostage = rsvpRate * count;
			const grandTotal = totalOuterPostage + totalRsvpPostage;

			// Update UI
			displayRate.textContent = `${outerRate.toFixed(2).replace('.', ',')} €`;
			stampCategoryBadge.textContent = stampName;
			displayWeightG.textContent = `${weightG.toFixed(1).replace('.', ',')} g`;
			displayWeightOz.textContent = `${(weightG / 28.3495).toFixed(2)} oz`;

			outerStampDesc.textContent = `${count} × Selos Envelope Exterior (${stampName}):`;
			outerStampCost.textContent = `${totalOuterPostage.toFixed(2).replace('.', ',')} €`;

			if (checkRsvp.checked) {
				rsvpStampDesc.textContent = `${count} × Selos Envelope RSVP (Até 20g):`;
				rsvpStampCost.textContent = `${totalRsvpPostage.toFixed(2).replace('.', ',')} €`;
			} else {
				rsvpStampDesc.textContent = `0 × Selos RSVP (Confirmação Digital/QR):`;
				rsvpStampCost.textContent = `0,00 €`;
			}

			displayGrandTotalPostage.textContent = `${grandTotal.toFixed(2).replace('.', ',')} €`;

			if (isNonMachinable) {
				nonMachinableAlert.style.display = 'block';
				nonMachinableReasons.textContent = `Elementos especiais: ${reasons.join(', ')}. Peça o carimbo manual ao balcão dos correios.`;
			} else {
				nonMachinableAlert.style.display = 'none';
			}
		}

		// Preset Selector Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'classic') {
				outerEnvSelect.value = 'a7-rect';
				cardstockSelect.value = '110lb';
				checkDetails.checked = true;
				checkRsvp.checked = true;
				checkVellum.checked = false;
				checkWax.checked = false;
				checkRibbon.checked = false;
			} else if (p === 'luxury-wax') {
				outerEnvSelect.value = 'a7-rect';
				cardstockSelect.value = '220lb';
				checkDetails.checked = true;
				checkRsvp.checked = true;
				checkVellum.checked = true;
				checkWax.checked = true;
				checkRibbon.checked = true;
			} else if (p === 'square') {
				outerEnvSelect.value = 'square-6';
				cardstockSelect.value = '220lb';
				checkDetails.checked = true;
				checkRsvp.checked = true;
				checkVellum.checked = false;
				checkWax.checked = false;
				checkRibbon.checked = false;
			} else if (p === 'minimalist') {
				outerEnvSelect.value = 'a7-rect';
				cardstockSelect.value = '110lb';
				checkDetails.checked = false;
				checkRsvp.checked = false;
				checkVellum.checked = false;
				checkWax.checked = false;
				checkRibbon.checked = false;
			}
			calculatePostage();
		});

		// Live Listeners
		[invitationCountInput, outerEnvSelect, cardstockSelect, checkDetails, checkRsvp, checkVellum, checkWax, checkRibbon].forEach(inp => {
			inp.addEventListener('input', calculatePostage);
			inp.addEventListener('change', calculatePostage);
		});

		// Print Post Office Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Folha de Selos e Portes Postais — Manage.Wedding</title>
					<style>
						@page { size: 8.5in 11in; margin: 0.5in; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 20pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Folha de Selos para Convites de Casamento</h1>
					<p>Total de Envelopes: ${invitationCountInput.value} | Peso Calculado: ${displayWeightG.textContent} (${displayWeightOz.textContent})</p>
					
					<table>
						<thead><tr><th>Necessidade Postal</th><th>Preço Unitário</th><th>Quantidade</th><th>Total (€)</th></tr></thead>
						<tbody>
							<tr><td><strong>Selos Envelope Exterior</strong><br /><small>${stampCategoryBadge.textContent}</small></td><td>${displayRate.textContent}</td><td>${invitationCountInput.value}</td><td>${outerStampCost.textContent}</td></tr>
							<tr><td><strong>Selos Envelope RSVP</strong><br /><small>Até 20g</small></td><td>${checkRsvp.checked ? '0,80 €' : '0,00 €'}</td><td>${checkRsvp.checked ? invitationCountInput.value : 0}</td><td>${rsvpStampCost.textContent}</td></tr>
							<tr class="total-row"><td>ORÇAMENTO TOTAL DE SELOS</td><td>—</td><td>—</td><td>${displayGrandTotalPostage.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Lista de Compra de Selos Postais</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Lista de Compra de Selos de Casamento</h2>
					<p>Total de Envelopes: ${invitationCountInput.value} | Peso Unitário: ${displayWeightG.textContent} | <strong>Total de Portes: ${displayGrandTotalPostage.textContent}</strong></p>
					<table>
						<thead><tr><th>Item</th><th>Escalão Postal</th><th>Custo Total</th></tr></thead>
						<tbody>
							<tr><td>Envelopes Exteriores</td><td>${stampCategoryBadge.textContent} (${displayRate.textContent})</td><td>${outerStampCost.textContent}</td></tr>
							<tr><td>Envelopes de Resposta (RSVP)</td><td>Até 20g</td><td>${rsvpStampCost.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL</td><td>—</td><td>${displayGrandTotalPostage.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob(['\ufeff' + content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'lista-selos-convites-casamento.doc';
			link.click();
		});

		// Initial Calculation
		calculatePostage();
	</script>
</Layout>
