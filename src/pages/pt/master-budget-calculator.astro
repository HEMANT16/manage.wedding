	const statBufferAmt = document.getElementById('stat-buffer-amt');

	const pctWarning = document.getElementById('pct-warning');
	const stackedBudgetBar = document.getElementById('stacked-budget-bar');
	const categoriesGrid = document.getElementById('categories-grid');

	function formatMoney(amount) {
		const formatted = Math.round(amount).toLocaleString('pt-PT');
		if (currencySymbol === '€' || currencySymbol === 'CHF') {
			return `${formatted} ${currencySymbol}`;
		}
		return `${currencySymbol}${formatted}`;
	}

	function calculateBudget() {
		const total = parseFloat(totalBudgetInput.value) || 0;
		const guests = parseInt(guestCountInput.value) || 1;
		currencySymbol = currencySelect.value;
		currencySymbolDisplay.textContent = currencySymbol;

		// Calculate total percentage
		let totalPct = 0;
		categories.forEach(c => {
			totalPct += (parseFloat(userPcts[c.id]) || 0);
		});

		// Update Stats
		statTotalDisplay.textContent = formatMoney(total);
		const perGuestCost = guests > 0 ? (total / guests) : 0;
		if (currencySymbol === '€' || currencySymbol === 'CHF') {
			statPerGuest.textContent = `${perGuestCost.toFixed(2).replace('.', ',')} ${currencySymbol}`;
		} else {
			statPerGuest.textContent = `${currencySymbol}${perGuestCost.toFixed(2)}`;
		}
		statGuestCountNote.textContent = `Baseado em ${guests} convidados`;

		const venueAmt = total * ((parseFloat(userPcts['venue']) || 0) / 100);
		statVenueAmt.textContent = formatMoney(venueAmt);

		const bufferAmt = total * ((parseFloat(userPcts['buffer']) || 0) / 100);
		statBufferAmt.textContent = formatMoney(bufferAmt);

		// Warning indicator
		if (Math.round(totalPct) === 100) {
			pctWarning.textContent = '100% Distribuído (Orçamento Equilibrado)';
			pctWarning.style.color = '#15803d';
		} else if (totalPct > 100) {
			pctWarning.textContent = `⚠️ Sobrealocado (${totalPct}% - reduza ${totalPct - 100}%)`;
			pctWarning.style.color = 'var(--accent-red)';
		} else {
			pctWarning.textContent = `Por atribuir (${totalPct}% - restam ${100 - totalPct}%)`;
			pctWarning.style.color = '#a16207';
		}

		// Update Stacked Bar
		stackedBudgetBar.innerHTML = '';
		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const displayPct = totalPct > 0 ? (pct / totalPct) * 100 : 0;

			if (displayPct > 0) {
				const seg = document.createElement('div');
				seg.style.cssText = `height: 100%; width: ${displayPct}%; background-color: ${c.color}; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;`;
				seg.title = `${c.name}: ${pct}% (${formatMoney(total * (pct / 100))})`;
				stackedBudgetBar.appendChild(seg);
			}
		});

		if (stackedBudgetBar.lastChild) {
			stackedBudgetBar.lastChild.style.borderRight = 'none';
		}

		// Update Category Cards Amounts
		categories.forEach(c => {
			const amtEl = document.getElementById(`amt-${c.id}`);
			const pctInputEl = document.getElementById(`pct-input-${c.id}`);
			const rangeEl = document.getElementById(`range-${c.id}`);
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);

			if (amtEl) amtEl.textContent = formatMoney(amt);
			if (pctInputEl && document.activeElement !== pctInputEl) pctInputEl.value = pct;
			if (rangeEl && document.activeElement !== rangeEl) rangeEl.value = pct;
		});
	}

	function renderCategoryCards() {
		categoriesGrid.innerHTML = '';
		const total = parseFloat(totalBudgetInput.value) || 0;

		categories.forEach(c => {
			const card = document.createElement('div');
			card.className = 'category-card';

			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);

			card.innerHTML = `
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
					<div style="display: flex; align-items: center; gap: 0.4rem;">
						<span style="width: 14px; height: 14px; background-color: ${c.color}; border: 1.5px solid var(--fg-pencil); border-radius: 3px; display: inline-block;"></span>
						<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil);">${c.name}</strong>
					</div>
					<strong id="amt-${c.id}" class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil);">${formatMoney(amt)}</strong>
				</div>

				<p class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); margin: 0 0 0.75rem 0; line-height: 1.3;">
					${c.desc}
				</p>

				<div style="display: flex; align-items: center; gap: 0.75rem; margin-top: auto;">
					<input type="range" id="range-${c.id}" min="0" max="70" step="1" value="${pct}" style="flex: 1; accent-color: var(--fg-pencil); cursor: pointer;" oninput="updateCatPct('${c.id}', this.value)">
					<div style="display: flex; align-items: center; gap: 0.2rem;">
						<input type="number" id="pct-input-${c.id}" min="0" max="100" step="0.5" value="${pct}" style="width: 50px; padding: 3px 5px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; text-align: center;" oninput="updateCatPct('${c.id}', this.value)">
						<span style="font-size: 0.9rem; font-weight: bold;">%</span>
					</div>
				</div>
			`;

			categoriesGrid.appendChild(card);
		});
	}

	window.updateCatPct = function(id, val) {
		userPcts[id] = parseFloat(val) || 0;
		calculateBudget();
	};

	// Event Listeners
	totalBudgetInput.addEventListener('input', calculateBudget);
	guestCountInput.addEventListener('input', calculateBudget);
	currencySelect.addEventListener('change', calculateBudget);

	// Tier Presets
	document.querySelectorAll('.tier-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.tier-btn').forEach(b => b.classList.remove('active-tier'));
			btn.classList.add('active-tier');

			totalBudgetInput.value = btn.getAttribute('data-amt');
			guestCountInput.value = btn.getAttribute('data-guests');
			calculateBudget();
		});
	});

	// Reset Defaults
	document.getElementById('btn-reset-defaults').addEventListener('click', () => {
		categories.forEach(c => { userPcts[c.id] = c.defaultPct; });
		renderCategoryCards();
		calculateBudget();
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const total = parseFloat(totalBudgetInput.value) || 0;
		const guests = parseInt(guestCountInput.value) || 1;

		let rows = '';
		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);
			rows += `
				<tr>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold;">${c.name}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center;">${pct}%</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:right; font-weight:bold;">${formatMoney(amt)}</td>
					<td style="border:1px solid #ccc; padding:8px; color:#555;">${c.desc}</td>
				</tr>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Plano de Orçamento Geral de Casamento</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Plano Oficial de Orçamento de Casamento</h1>
				<p>Gerado a ${new Date().toLocaleDateString('pt-PT')} | Orçamento Total: <strong>${formatMoney(total)}</strong> | Convidados: ${guests} | Custo por Convidado: <strong>${formatMoney(total / guests)}</strong></p>
				<table>
					<thead>
						<tr>
							<th>Categoria</th>
							<th style="text-align:center;">% Total</th>
							<th style="text-align:right;">Valor Alocado</th>
							<th>Despesas Incluídas</th>
						</tr>
					</thead>
					<tbody>
						${rows}
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Orcamento_Casamento_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const total = parseFloat(totalBudgetInput.value) || 0;
		const guests = parseInt(guestCountInput.value) || 1;

		document.getElementById('print-date').textContent = new Date().toLocaleDateString('pt-PT');
		document.getElementById('print-total').textContent = formatMoney(total);
		document.getElementById('print-per-guest').textContent = `${formatMoney(total / guests)} (${guests} Convidados)`;

		const tbody = document.getElementById('print-table-body');
		tbody.innerHTML = '';

		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);

			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">${c.name}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center;">${pct}%</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: right; font-weight: bold;">${formatMoney(amt)}</td>
				<td style="border: 1px solid #ccc; padding: 6px; color: #555;">${c.desc}</td>
			`;
			tbody.appendChild(tr);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const total = parseFloat(totalBudgetInput.value) || 0;
		let csv = "Categoria,Percentagem,Valor Alocado,Despesas Incluidas\n";
		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);
			csv += `"${c.name}",${pct}%,${Math.round(amt)},"${(c.desc||'').replace(/"/g, '""')}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Orcamento_Casamento_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	renderCategoryCards();
	calculateBudget();
</script>
