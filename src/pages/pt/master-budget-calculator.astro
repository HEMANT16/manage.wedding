---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Calculadora de Orçamento Geral de Casamento",
      "url": "https://manage.wedding/pt/master-budget-calculator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de orçamento de casamento. Distribua os custos por quinta, copo-d'água, fotografia, vestidos e decoração, controle o custo por convidado e exporte para Word, PDF ou Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Definir e Distribuir o Orçamento Global do Casamento",
      "description": "Guia passo a passo para calcular e distribuir as verbas do seu casamento por quinta, catering, fotografia, trajes nupciais e fundo de emergência.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Defina o Montante Total Disponível",
          "text": "Some as poupanças pessoais, a capacidade de poupança mensal até à data e eventuais contribuições familiares para fixar um teto máximo realista."
        },
        {
          "@type": "HowToStep",
          "name": "Reserve 45% a 50% para Espaço e Catering (Copo-d'água)",
          "text": "Destine cerca de metade do orçamento para o aluguer da quinta ou salão, ementas completas, aperitivos, bar aberto e serviço de mesa."
        },
        {
          "@type": "HowToStep",
          "name": "Atribua 12% a 15% para Fotografia e Vídeo",
          "text": "Garanta a cobertura fotográfica profissional do dia inteiro, reportagem de vídeo, drone e o álbum de casamento."
        },
        {
          "@type": "HowToStep",
          "name": "Distribua Vestuário, Flores e Animação",
          "text": "Destine 8% a 10% para vestidos de noiva e fato do noivo com arranjos, 8% para flores e decoração, e 7% a 8% para DJ ou banda ao vivo."
        },
        {
          "@type": "HowToStep",
          "name": "Mantenha uma Margem de Segurança de 4% a 5%",
          "text": "Reserve um fundo para IVA não previsto, horas extras, refeições do staff e pequenos imprevistos de última hora."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual é a percentagem recomendada para cada categoria do casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A distribuição recomendada pelos profissionais é: 45-50% para Espaço e Catering/Copo-d'água, 12-15% para Fotografia e Vídeo, 8-10% para Vestuário e Beleza, 8-10% para Decoração Floral, 7-8% para Música e Animação, 3% para Convites e Estacionário, 2% para Lembranças e 4-5% para Margem de Imprevistos e Taxas."
          }
        },
        {
          "@type": "Question",
          "name": "Como é que o número de convidados influencia o orçamento total?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cerca de 55% a 60% dos custos totais são despesas variáveis por pessoa (ementa, bebidas do bar aberto, bolo, marcadores de mesa e lembranças). Reduzir a lista em 20 convidados pode poupar facilmente entre 2.500 € e 5.000 € no total final."
          }
        },
        {
          "@type": "Question",
          "name": "Que custos ocultos devem ser previstos no planeamento financeiro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tenha sempre em conta o IVA (quando os orçamentos são apresentados sem taxa), taxas de rolha ou corte de bolo externo, refeições de fornecedores (fotógrafo, DJ), arranjos de costura no vestido e eventuais horas extras de espaço ou bar."
          }
        },
        {
          "@type": "Question",
          "name": "Como posso exportar o meu orçamento para Word, PDF ou Excel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Basta clicar nos botões 'Exportar Word (.doc)', 'Exportar PDF / Imprimir' ou 'Exportar Excel (.csv)' no topo do painel para descarregar o documento detalhado e pronto a partilhar com o seu parceiro ou wedding planner."
          }
        }
      ]
    }
  ]
};

const defaultCategories = [
  { id: 'venue', name: 'Quinta & Catering', defaultPct: 48, color: '#ffb3ba', desc: 'Aluguer do espaço, ementas completas, cocktail de boas-vindas e bar aberto' },
  { id: 'photo', name: 'Fotografia & Vídeo', defaultPct: 13, color: '#bae1ff', desc: 'Cobertura de dia inteiro, sessão de solteiros, vídeo cinemático e álbum' },
  { id: 'attire', name: 'Vestuário & Beleza', defaultPct: 9, color: '#ffdfba', desc: 'Vestido de noiva, fato do noivo, arranjos de costura, maquilhagem e penteado' },
  { id: 'florals', name: 'Flores & Decoração', defaultPct: 8, color: '#baffc9', desc: 'Bouquet, arco de cerimónia, centros de mesa, iluminação e mobiliário' },
  { id: 'entertain', name: 'Música & Animação', defaultPct: 7, color: '#ffffba', desc: 'DJ, saxofonista, músicos de cerimónia, banda ao vivo e animação infantil' },
  { id: 'rings', name: 'Alianças & Registo', defaultPct: 4, color: '#fbcfe8', desc: 'Alianças de casamento, processo civil / conservatória ou honorários de celebrante' },
  { id: 'stationery', name: 'Convites & Papelaria', defaultPct: 3, color: '#e8baff', desc: 'Participações, convites, missais, marcadores de lugar e plano de mesas' },
  { id: 'favors', name: 'Lembranças & Detalhes', defaultPct: 2, color: '#fed7aa', desc: 'Lembranças para convidados, presentes para padrinhos e kits de boas-vindas' },
  { id: 'transport', name: 'Transporte & Noite Nupcial', defaultPct: 2, color: '#ccfbf1', desc: 'Carro dos noivos, transporte de convidados e alojamento da noite de núpcias' },
  { id: 'buffer', name: 'Margem de Imprevistos', defaultPct: 4, color: '#e5e7eb', desc: 'IVA imprevisto, refeições de staff, horas extra e despesas de emergência' }
];
---

<Layout 
	title="Calculadora de Orçamento de Casamento (Divisão de Custos & Exportação Excel) | Manage.Wedding"
	description="Calcule e distribua facilmente o seu orçamento de casamento por quinta, catering, fotografia, vestidos e decoração com exportação instantânea para Word, PDF e CSV."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Calculadora de Orçamento Geral" category="budget-finance" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de Orçamento Geral de Casamento
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Distribua as verbas do seu casamento com rigor entre espaço, ementas, fotografia e vestuário. Controle o custo por convidado e exporte para <strong>Word (.doc)</strong>, <strong>PDF</strong> ou <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Budget Overview Dashboard & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div style="flex: 1; min-width: 250px;">
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💰 Simulador Financeiro de Casamento
					</h2>
					<p class="font-body" style="color: var(--text-secondary); font-size: 0.9rem; margin: 0.2rem 0 0 0; text-align: center;">
						Ajuste as percentagens e descarregue o planeamento orçamental personalizado
					</p>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; width: 100%;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Exportar Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Exportar PDF / Imprimir
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Exportar Excel (.csv)
					</button>
					<button type="button" id="btn-reset-defaults" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						🔄 Restaurar Padrões do Setor
					</button>
				</div>
			</div>

			<!-- Preset Budget Tiers -->
			<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
				<span class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
					⚡ Níveis de Orçamento de Casamento Típicos:
				</span>
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center;">
					<button type="button" class="tier-btn" data-amt="15000" data-guests="50">🪙 Íntimo / Económico (15.000 € • 50 Convidados)</button>
					<button type="button" class="tier-btn active-tier" data-amt="30000" data-guests="120">💎 Média Recomendada (30.000 € • 120 Convidados)</button>
					<button type="button" class="tier-btn" data-amt="55000" data-guests="150">👑 Elegante & Quinta (55.000 € • 150 Convidados)</button>
					<button type="button" class="tier-btn" data-amt="95000" data-guests="200">✨ Grande Luxo (95.000 € • 200 Convidados)</button>
				</div>
			</div>

			<!-- Core Global Inputs: Total Budget, Currency & Guest Count -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
				
				<!-- Total Budget -->
				<div>
					<label for="total-budget-input" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Orçamento Total Disponível
					</label>
					<div style="display: flex; align-items: center; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; overflow: hidden;">
						<span id="currency-symbol-display" style="padding: 0.6rem 0.8rem; background: var(--bg-paper); border-right: 1px solid var(--fg-pencil); font-weight: bold; font-family: var(--font-heading);">€</span>
						<input type="number" id="total-budget-input" value="30000" min="500" step="500" style="flex: 1; border: none; padding: 0.6rem; font-family: var(--font-body); font-size: 1.2rem; font-weight: bold; outline: none; background: transparent;">
					</div>
				</div>

				<!-- Currency Selector -->
				<div>
					<label for="currency-select" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Símbolo Monetário
					</label>
					<select id="currency-select" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff;">
						<option value="€" selected>€ (EUR - Euro)</option>
						<option value="R$">R$ (BRL - Real Brasileiro)</option>
						<option value="$">$ (USD / CAD / AUD)</option>
						<option value="£">£ (GBP - Libra Esterlina)</option>
						<option value="CHF">CHF (Franco Suíço)</option>
					</select>
				</div>

				<!-- Estimated Guest Count -->
				<div>
					<label for="guest-count-input" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Número Estimado de Convidados
					</label>
					<input type="number" id="guest-count-input" value="120" min="5" max="1000" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: #fff;">
				</div>

			</div>

			<!-- Dynamic Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Orçamento Total</span>
					<strong id="stat-total-display" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">30.000 €</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">100% Distribuído</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Custo por Convidado</span>
					<strong id="stat-per-guest" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">250,00 €</strong>
					<span id="stat-guest-count-note" style="font-size: 0.75rem; color: #1e40af; display: block;">Baseado em 120 convidados</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Quinta & Catering (48%)</span>
					<strong id="stat-venue-amt" class="font-heading" style="font-size: 1.8rem; color: #15803d;">14.400 €</strong>
					<span style="font-size: 0.75rem; color: #166534; display: block;">Principal custo do evento</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Imprevistos (4%)</span>
					<strong id="stat-buffer-amt" class="font-heading" style="font-size: 1.8rem; color: #a16207;">1.200 €</strong>
					<span style="font-size: 0.75rem; color: #854d0e; display: block;">Fundo de segurança</span>
				</div>
			</div>

			<!-- Visual Stacked Expense Distribution Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Distribuição Visual das Despesas</span>
					<span id="pct-warning" class="font-body" style="font-size: 0.85rem; color: #15803d; font-weight: bold;">100% Distribuído (Equilibrado)</span>
				</div>
				<div id="stacked-budget-bar" style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #e5e0d8; margin-bottom: 0.75rem;">
					<!-- Injected via JS -->
				</div>
			</div>

		</div>

		<!-- Interactive Category Allocation Grid -->
		<section style="margin-bottom: 3.5rem;">
			<h2 class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); text-align: center; margin-bottom: 0.5rem;">
				📊 Alocação Detalhada por Categoria
			</h2>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); text-align: center; max-width: 600px; margin: 0 auto 1.75rem;">
				Ajuste as barras de percentagem ou introduza valores diretos. Todas as categorias são sincronizadas em tempo real.
			</p>

			<div id="categories-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem;">
				<!-- Injected via JS -->
			</div>
		</section>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Plano Oficial de Orçamento de Casamento</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado a: <span id="print-date"></span> | Orçamento Total: <span id="print-total"></span> | Por Convidado: <span id="print-per-guest"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Categoria</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 60px; text-align: center;">% Total</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 100px; text-align: right;">Verba Alocada</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Âmbito e Despesas Incluídas</th>
					</tr>
				</thead>
				<tbody id="print-table-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 2.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumo Direto ao Assunto (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Regra Prática: Divisão Recomendada do Orçamento
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 750px; margin: 0 auto; font-weight: 500;">
					Sem tempo a perder? Eis a fórmula percentual de referência e a tabela prática para orçamentos de 20.000 €, 35.000 € e 60.000 €.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 Fórmula Central em 1 Minuto:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					48% Quinta e Catering + 13% Fotografia/Vídeo + 9% Trajes e Beleza + 8% Decoração e Flores + 7% Música e DJ + 11% Alianças/Papelaria/Outros + 4% Margem = 100% Orçamento
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 580px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Categoria de Despesa</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">% Alvo</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Orçamento 20.000 €</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Orçamento 35.000 €</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Orçamento 60.000 €</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Quinta & Catering (Copo-d'água)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">48%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">9.600 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">16.800 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">28.800 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Fotografia & Vídeo</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">13%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">2.600 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">4.550 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">7.800 €</td>
						</tr>
						<tr>
