---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calculadora de Tamanho de Tenda para Casamento e Gerador",
      "url": "https://manage.wedding/pt/wedding-tent-size-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calcule a metragem quadrada e dimensões exatas de tendas para casamento ao ar livre, pista de dança, palco e potência de gerador elétrico (kVA).",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calculadora de Tamanho de Tenda para Casamento — Metros Quadrados e Pista"
	description="Calcule os metros quadrados e dimensões da tenda para casamento no campo ou praia, pista de dança, buffet e gerador de energia (kVA)."
	lang="pt"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href=""" style="color: var(--text-secondary); text-decoration: none;">Início</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/pt/budget" style="color: var(--text-secondary); text-decoration: none;">Espaço e Locação</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Calculadora de Tenda</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🎪</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Espaço ao Ar Livre & Geradores de Energia</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calculadora de Tamanho de Tenda para Casamento
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Calcule a <strong>metragem quadrada total necessária</strong> para a cobertura do casamento, dimensões padrão de tendas (12x20m, 10x25m...), pista de dança e a <strong>potência do gerador (kVA)</strong>.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Inputs -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>👥</span> 1. Convidados e Disposição das Mesas
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-tent-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Total de Convidados:</label>
						<input type="number" id="input-tent-guests" min="20" max="500" value="130" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="select-seating-style" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Estilo de Mesas:</label>
						<select id="select-seating-style" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="round" selected>⚪ Mesas Redondas (1,3 m² / convidado)</option>
							<option value="rect">📏 Mesas Comunitárias / Retangulares (1,0 m² / conv.)</option>
							<option value="cocktail">🍸 Coquetel / Lounges (0,75 m² / conv.)</option>
							<option value="ceremony">⛪ Fileiras para Cerimônia (0,65 m² / conv.)</option>
						</select>
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					💃 2. Pista de Dança e Palco
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label for="select-music-setup" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Música / Palco:</label>
						<select id="select-music-setup" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="dj" selected>🎧 Cabine de DJ (10 m²)</option>
							<option value="band-small">🎸 Banda 4 integrantes (20 m²)</option>
							<option value="band-large">🎷 Grande Orquestra / Banda Baile (35 m²)</option>
							<option value="none">🔇 Música Ambiente (0 m²)</option>
						</select>
					</div>
					<div>
						<label for="select-dance-ratio" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Tamanho da Pista:</label>
						<select id="select-dance-ratio" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="0.5" selected>Padrão (~50% na pista simultaneamente)</option>
							<option value="0.7">Festa Muito Animada (~70%)</option>
							<option value="0">Sem Pista de Dança</option>
						</select>
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🍹 3. Buffet, Bar e Estrutura
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="input-buffet-stations" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Ilhas de Buffet / Gastronomia:</label>
						<input type="number" id="input-buffet-stations" min="0" max="6" value="2" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="input-bar-stations" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Pontos de Bar / Drinks:</label>
						<input type="number" id="input-bar-stations" min="0" max="6" value="2" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0.75rem;">
					<div>
						<label for="select-tent-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Modelo da Tenda:</label>
						<select id="select-tent-type" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="frame" selected>🏛️ Tenda Estrutural / Galpão (Sem postes centrais)</option>
							<option value="pole">⛺ Tenda Tensionada / Beduína (Postes de madeira)</option>
							<option value="sailcloth">⛵ Tenda Cristal Transparente</option>
						</select>
					</div>
					<div>
						<label for="select-flooring-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Tablado / Piso:</label>
						<select id="select-flooring-type" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="dance-only" selected>Apenas Tablado da Pista de Dança</option>
							<option value="full-turf">Carpete / Grama Sintética Integral</option>
							<option value="full-hardwood">Tablado de Madeira Total Nivelado</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Especificação da Tenda</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Tamanho Ideal da Tenda
						</h2>
					</div>
					<span id="badge-tent-sqft" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">230 m²</span>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Dimensões da Tenda</span>
						<strong id="stat-tent-dimension" style="font-size: 1.9rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">12 x 20 m</strong>
						<span id="stat-tent-alt" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(ou 10 x 25 m)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Pista de Dança</span>
						<strong id="stat-dance-size" style="font-size: 1.9rem; font-weight: 900; color: #1e40af; line-height: 1.1;">5 x 6 m</strong>
						<span id="stat-dance-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">30 m² (para 65 pessoas)</span>
					</div>
				</div>

				<div style="background: #eff6ff; border: 1.5px solid #1e40af; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #1e40af; display: block; margin-bottom: 0.35rem;">⚡ Gerador de Energia & Elétrica:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #1e3a8a;">
						<div>• <strong id="stat-generator-kw">Gerador 25-30 kVA</strong> (Silenciado)</div>
						<div>• <strong id="stat-lighting-strands">120 metros</strong> Varal de Luzes</div>
						<div>• <strong id="stat-power-circuits">6 Circuitos</strong> Dedicados 16A/20A</div>
						<div>• <strong id="stat-side-walls">64 m</strong> Fechamento Lateral / Cristal</div>
					</div>
				</div>

				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🪑 Área das Mesas:</span>
						<strong id="stat-space-seating" style="color: var(--fg-pencil);">170 m²</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">💃 Pista de Dança:</span>
						<strong id="stat-space-dance" style="color: var(--fg-pencil);">30 m²</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🎧 Palco / DJ:</span>
						<strong id="stat-space-stage" style="color: var(--fg-pencil);">10 m²</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">🍸 Buffets e Bares:</span>
						<strong id="stat-space-buffet" style="color: var(--fg-pencil);">30 m²</strong>
					</div>
				</div>

				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Imprimir Projeto (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Exportar Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/pt/wedding-tent-size-calculator" category="budget" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-tent-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Especificação de Tenda e Gerador para Casamento</h1>
				<p id="print-tent-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Ficha de Locação de Cobertura e Estrutura | Manage.Wedding</p>
			</div>
			<div id="print-tent-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const inputTentGuests = document.getElementById('input-tent-guests');
	const selectSeatingStyle = document.getElementById('select-seating-style');
	const selectMusicSetup = document.getElementById('select-music-setup');
	const selectDanceRatio = document.getElementById('select-dance-ratio');
	const inputBuffetStations = document.getElementById('input-buffet-stations');
	const inputBarStations = document.getElementById('input-bar-stations');
	const selectTentType = document.getElementById('select-tent-type');
	const selectFlooringType = document.getElementById('select-flooring-type');

	const badgeTentSqft = document.getElementById('badge-tent-sqft');
	const statTentDimension = document.getElementById('stat-tent-dimension');
	const statTentAlt = document.getElementById('stat-tent-alt');
	const statDanceSize = document.getElementById('stat-dance-size');
	const statDanceSub = document.getElementById('stat-dance-sub');

	const statGeneratorKw = document.getElementById('stat-generator-kw');
	const statLightingStrands = document.getElementById('stat-lighting-strands');
	const statPowerCircuits = document.getElementById('stat-power-circuits');
	const statSideWalls = document.getElementById('stat-side-walls');

	const statSpaceSeating = document.getElementById('stat-space-seating');
	const statSpaceDance = document.getElementById('stat-space-dance');
	const statSpaceStage = document.getElementById('stat-space-stage');
	const statSpaceBuffet = document.getElementById('stat-space-buffet');

	function calculateTent() {
		const guests = Math.max(10, parseInt(inputTentGuests.value, 10) || 130);
		const seatingStyle = selectSeatingStyle.value;

		let sqmPerGuest = 1.3;
		if (seatingStyle === 'rect') sqmPerGuest = 1.0;
		else if (seatingStyle === 'cocktail') sqmPerGuest = 0.75;
		else if (seatingStyle === 'ceremony') sqmPerGuest = 0.65;
		const seatingSqm = Math.round(guests * sqmPerGuest);

		const danceRatio = parseFloat(selectDanceRatio.value) || 0.5;
		const dancers = Math.round(guests * danceRatio);
		const danceSqm = Math.round(dancers * 0.45);
		let danceDim = '5 x 6 m';
		if (danceSqm <= 16) danceDim = '4 x 4 m';
		else if (danceSqm <= 25) danceDim = '5 x 5 m';
		else if (danceSqm <= 35) danceDim = '5 x 7 m';
		else if (danceSqm <= 48) danceDim = '6 x 8 m';
		else danceDim = '8 x 8 m';

		const musicSetup = selectMusicSetup.value;
		let stageSqm = 10;
		if (musicSetup === 'band-small') stageSqm = 20;
		else if (musicSetup === 'band-large') stageSqm = 35;
		else if (musicSetup === 'none') stageSqm = 0;

		const buffets = parseInt(inputBuffetStations.value, 10) || 0;
		const bars = parseInt(inputBarStations.value, 10) || 0;
		const buffetSqm = (buffets * 10) + (bars * 6);

		const rawTotalSqm = seatingSqm + danceSqm + stageSqm + buffetSqm;
		const totalSqm = Math.round(rawTotalSqm * 1.08);

		badgeTentSqft.textContent = `${totalSqm.toLocaleString()} m²`;
		statSpaceSeating.textContent = `${seatingSqm.toLocaleString()} m²`;
		statSpaceDance.textContent = `${danceSqm.toLocaleString()} m²`;
		statSpaceStage.textContent = `${stageSqm.toLocaleString()} m²`;
		statSpaceBuffet.textContent = `${buffetSqm.toLocaleString()} m²`;

		statDanceSize.textContent = danceDim;
		statDanceSub.textContent = `${danceSqm} m² (para ${dancers} pessoas)`;

		let tentDim = '12 x 20 m';
		let tentAlt = '(ou 10 x 25 m)';
		let perimeter = 64;

		if (totalSqm <= 100) {
			tentDim = '10 x 10 m';
			tentAlt = '(100 m²)';
			perimeter = 40;
		} else if (totalSqm <= 150) {
			tentDim = '10 x 15 m';
			tentAlt = '(150 m²)';
			perimeter = 50;
		} else if (totalSqm <= 200) {
			tentDim = '10 x 20 m';
			tentAlt = '(ou 12 x 18 m)';
			perimeter = 60;
		} else if (totalSqm <= 260) {
			tentDim = '12 x 20 m';
			tentAlt = '(ou 10 x 25 m)';
			perimeter = 64;
		} else if (totalSqm <= 320) {
			tentDim = '12 x 25 m';
			tentAlt = '(ou 15 x 20 m)';
			perimeter = 74;
		} else if (totalSqm <= 420) {
			tentDim = '15 x 25 m';
			tentAlt = '(ou 12 x 35 m)';
			perimeter = 80;
		} else {
			tentDim = '15 x 35 m';
			tentAlt = '(525 m²)';
			perimeter = 100;
		}

		statTentDimension.textContent = tentDim;
		statTentAlt.textContent = tentAlt;

		let genKw = '25-30 kVA';
		let circuits = 6;
		if (guests > 150 || musicSetup === 'band-large') {
			genKw = '45-50 kVA';
			circuits = 10;
		} else if (guests > 250) {
			genKw = '70-80 kVA';
			circuits = 16;
		}

		statGeneratorKw.textContent = `Gerador ${genKw}`;
		statLightingStrands.textContent = `${Math.round(perimeter * 1.8)} m`;
		statPowerCircuits.textContent = `${circuits} x 16A/20A`;
		statSideWalls.textContent = `${perimeter} m`;

		document.getElementById('print-tent-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Área da Tenda</th>
						<th style="padding:6pt;">Cálculo</th>
						<th style="padding:6pt; text-align:right;">Espaço Necessário</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Área das Mesas</td>
						<td style="padding:6pt;">${guests} convidados @ ${sqmPerGuest} m²/pessoa</td>
						<td style="padding:6pt; text-align:right;"><strong>${seatingSqm.toLocaleString()} m²</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Pista de Dança</td>
						<td style="padding:6pt;">${danceDim} (${dancers} dançarinos simultâneos)</td>
						<td style="padding:6pt; text-align:right;"><strong>${danceSqm} m²</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Palco / DJ</td>
						<td style="padding:6pt;">${selectMusicSetup.options[selectMusicSetup.selectedIndex].text}</td>
						<td style="padding:6pt; text-align:right;"><strong>${stageSqm} m²</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Buffets e Bares</td>
						<td style="padding:6pt;">${buffets} ilhas de buffet e ${bars} bares</td>
						<td style="padding:6pt; text-align:right;"><strong>${buffetSqm} m²</strong></td>
					</tr>
					<tr style="background:#eff6ff; font-weight:bold; font-size:11pt; border-top:2pt solid #000;">
						<td style="padding:8pt;">MEDIDA DE TENDA RECOMENDADA</td>
						<td style="padding:8pt;">${selectTentType.options[selectTentType.selectedIndex].text}</td>
						<td style="padding:8pt; text-align:right; color:#b91c1c;">${tentDim} (${totalSqm.toLocaleString()} m²)</td>
					</tr>
					<tr style="background:#f0fdf4; font-weight:bold; font-size:10.5pt; border-top:1.5pt solid #15803d;">
						<td style="padding:8pt; color:#15803d;">GERADOR DE ENERGIA</td>
						<td style="padding:8pt; color:#15803d;">${genKw} Silenciado a Diesel</td>
						<td style="padding:8pt; text-align:right; color:#15803d;">${circuits} Circuitos Dedicados</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	[inputTentGuests, selectSeatingStyle, selectMusicSetup, selectDanceRatio, inputBuffetStations, inputBarStations, selectTentType, selectFlooringType].forEach(el => {
		el.addEventListener('input', calculateTent);
		el.addEventListener('change', calculateTent);
	});

	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateTent();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateTent();
		const dimension = statTentDimension.textContent;
		const totalArea = badgeTentSqft.textContent;
		const dance = statDanceSize.textContent;
		const guests = inputTentGuests.value;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Especificação Tenda Casamento</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Especificação de Tenda e Gerador para Casamento</h1>
				<p><strong>Convidados:</strong> ${guests} | <strong>Tenda Recomendada:</strong> ${dimension} (${totalArea}) | <strong>Pista de Dança:</strong> ${dance} | <strong>Gerador:</strong> ${statGeneratorKw.textContent}</p>
				<hr/>
				<p><em>Gerado por Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Tenda-Casamento-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateTent();
</script>
