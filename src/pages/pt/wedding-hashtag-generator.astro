---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-hashtag-generator/#webapp",
      "name": "Gerador de Hashtags de Casamento e Criador de Placas",
      "url": "https://manage.wedding/pt/wedding-hashtag-generator",
      "inLanguage": "pt",
      "description": "Gerador gratuito de hashtags de casamento personalizadas. Crie mais de 50 hashtags românticas, divertidas e originais com cópia em 1 clique e placas para mesas em Word e PDF.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Como cria esta ferramenta hashtags de casamento únicas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O algoritmo combina os primeiros nomes, apelidos, alcunhas do casal, ano e local do casamento em 5 categorias de estilo (Romântico, Divertido/Trocadilhos, Festa, Local de Destino e Curtas)."
          }
        },
        {
          "@type": "Question",
          "name": "Por que razão se deve usar CamelCase (maiúscula em cada palavra) na hashtag?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usar CamelCase (ex.: #CasamentoSilvaSantos em vez de #casamentosilvasantos) facilita imenso a leitura aos convidados, evita erros de escrita e garante que os leitores de ecrã pronunciam cada palavra corretamente."
          }
        },
        {
          "@type": "Question",
          "name": "Como verificar se a hashtag já está a ser usada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pesquise a etiqueta no Instagram ou TikTok. Se tiver poucas publicações antigas, pode usá-la sem problema. Se já tiver milhares de posts, adicione o ano (ex.: #MarianaETiago2026) para torná-la 100% exclusiva."
          }
        },
        {
          "@type": "Question",
          "name": "Onde devemos colocar a hashtag no dia do casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pode exibir a hashtag nos Save-the-Date, convites digitais, placas no balcão do bar, photobooth e marcadores de mesa. Pode imprimir a placa diretamente desta página em Word ou PDF!"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Como Criar e Usar uma Hashtag Personalizada de Casamento",
      "description": "Passo a passo para gerar hashtags memoráveis e exportar placas de mesa para a receção.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Introduza os Nomes e Apelidos dos Noivos",
          "text": "Indique os primeiros nomes e apelidos de ambos os parceiros, alcunhas e o ano do casamento."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Escolha o Estilo Pretendido",
          "text": "Explore as categorias (Românticas, Trocadilhos Divertidos, Festa e Curtas) e guarde as suas favoritas."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Verifique a Disponibilidade no Instagram",
          "text": "Clique no botão de verificação rápida do Instagram para garantir exclusividade."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Utilize Formatação CamelCase",
          "text": "Mantenha a primeira letra de cada palavra em maiúscula para máxima legibilidade."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 5: Exporte a Placa para Impressão",
          "text": "Gere e imprima placas de mesa e bar para colocar em molduras no dia do casamento."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Gerador de Hashtags de Casamento (Criativas & Placas para Mesas) | Manage.Wedding"
	description="Gere hashtags de casamento únicas, românticas e divertidas. Copie num clique e exporte placas para mesas e bares de recepção em Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Gerador de Hashtags de Casamento
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Crie mais de 50 hashtags personalizadas, românticas, divertidas e originais. Copie com 1 clique, verifique no Instagram e exporte <strong>Placas para Mesas e Bares</strong> em Word e PDF!
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Criar a Hashtag Perfeita em 3 Passos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Introduza Nomes & Apelidos
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indique os primeiros nomes e apelidos dos noivos, junção de nomes e o ano ou local da celebração.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Filtre por Estilo & Copie
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Consulte as opções (Românticas, Divertidas, Festa ou Curtas) e clique para copiar ou pré-visualizar.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporte a Placa para as Mesas
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clique em <strong>"🖨️ Exportar Placa para Impressão"</strong> para criar placas emolduradas para o bar e mesas.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Generator Form + Live Results & Sign Mockup -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="hashtag-grid">
			
			<!-- Left Column: Couple Details Form & Filter Tabs -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💍 Dados dos Noivos & Combinações
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Preencha os nomes para gerar dezenas de combinações exclusivas
					</span>
				</div>

				<form id="hashtag-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Partner 1 -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p1-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Primeiro Nome (Noiva/Noivo 1) *
							</label>
							<input type="text" id="p1-first" value="Mariana" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p1-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Apelido / Sobrenome 1 *
							</label>
							<input type="text" id="p1-last" value="Silva" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Partner 2 -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p2-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Primeiro Nome (Noiva/Noivo 2) *
							</label>
							<input type="text" id="p2-first" value="Tiago" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p2-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Apelido / Sobrenome 2 *
							</label>
							<input type="text" id="p2-last" value="Santos" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Nickname, Year, Destination -->
					<div style="display: grid; grid-template-columns: 1.2fr 0.8fr 1fr; gap: 0.6rem;">
						<div>
							<label for="couple-nickname" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Junção / Alcunha (Opcional)
							</label>
							<input type="text" id="couple-nickname" value="MariTiago" placeholder="ex.: MariTiago" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-year" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Ano
							</label>
							<input type="number" id="wedding-year" value="2026" min="2024" max="2035" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-city" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Local / Quinta (Opcional)
							</label>
							<input type="text" id="wedding-city" placeholder="ex.: Sintra / Douro" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</div>

					<!-- Vibe Filter Selector -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
							🎨 Filtrar por Estilo de Hashtag:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
							<button type="button" class="filter-tab-btn active-tab hand-btn" data-vibe="all" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">✨ Todas as Ideias</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="romantic" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">💖 Românticas</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="funny" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">😂 Divertidas</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="party" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">🥂 Festa & Animação</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="short" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">⚡ Curtas & Clássicas</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Hashtag Cards Stream & Printable Sign Mockup -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Printable Table Sign Mockup Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖨️ Pré-visualização da Placa de Mesa e Bar
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Pronta a imprimir para colocar em molduras nas mesas e no bar
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Placa (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Table Sign Mockup Box -->
					<div id="table-sign-mockup" style="border: 2.5px solid var(--fg-pencil); border-radius: 6px; padding: 2rem 1.5rem; background: var(--bg-paper); text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1rem;">
						
						<!-- Corner Marks -->
						<div style="position: absolute; top: 6px; left: 6px; width: 14px; height: 14px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 6px; right: 6px; width: 14px; height: 14px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; left: 6px; width: 14px; height: 14px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; right: 6px; width: 14px; height: 14px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<p style="font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; color: var(--accent-red); margin: 0 0 0.5rem 0; font-weight: bold;">
							AJUDEM-NOS A ETERNIZAR ESTE DIA!
						</p>

						<h2 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0;">
							Partilhem as vossas fotos e vídeos com a nossa hashtag:
						</h2>

						<div style="background: #fff; border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem 1rem; margin: 1rem 0; display: inline-block;">
							<strong id="display-selected-hashtag" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); word-break: break-word;">
								#CasamentoSilvaSantos
							</strong>
						</div>

						<p style="font-family: var(--font-body); font-size: 0.88rem; color: var(--text-secondary); margin: 0.5rem 0 0 0; font-style: italic;">
							Para podermos reviver todos os momentos deste dia especial!
						</p>
					</div>

					<span style="font-size: 0.78rem; color: var(--text-secondary); text-align: center; display: block;">
						💡 Dica: Clique em qualquer hashtag abaixo para a definir na placa de impressão!
					</span>

				</div>

				<!-- Generated Hashtags Stream Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 480px; overflow-y: auto;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0;">
							🏷️ Lista de Hashtags (<span id="tags-count-badge">50+</span>)
						</h3>
						<span style="font-size: 0.78rem; color: var(--accent-red); font-weight: bold;">
							Clique para Copiar e Pré-visualizar
						</span>
					</div>

					<div id="hashtags-stream-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem;">
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border: 4px solid #000; padding: 50px 30px; text-align: center; font-family: 'Times New Roman', serif; max-width: 600px; margin: 0 auto;">
				<p style="font-size: 16px; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 15px 0;">Ajudem-nos a Recordar Este Dia</p>
				<h1 style="font-size: 32px; margin: 0 0 25px 0;">Partilhem as Vossas Fotos & Vídeos</h1>
				<div style="border: 2px dashed #000; padding: 20px; margin: 25px 0; background: #fafafa;">
					<h2 id="print-hashtag-display" style="font-size: 36px; margin: 0; color: #000;">#CasamentoSilvaSantos</h2>
				</div>
				<p style="font-size: 16px; font-style: italic; color: #444; margin: 20px 0 0 0;">Obrigado por celebrarem connosco!</p>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Resumo Rápido (BLUF)</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Regra de Ouro: Fórmulas de Hashtags de Casamento
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>A Fórmula de 1 Minuto:</strong> As melhores hashtags seguem a estrutura: <strong>[Apelido / Nomes] + [Palavra de União/Festa] + [Ano / Local Opcional]</strong>. Use sempre <strong>CamelCase</strong> (primeira letra de cada palavra em maiúscula) para facilitar a leitura e evitar erros na escrita.
			</p>
			
			<!-- Benchmark Hashtag Formulas Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Estilo de Hashtag</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Padrão de Nome</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Exemplo Real</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Ideal Para</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">1. Romântica Clássica</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#Casamento[Apelido1][Apelido2]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: var(--accent-blue);">#CasamentoSilvaSantos</td>
							<td style="padding: 0.6rem 0.8rem;">Casamentos elegantes e formais</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">2. Junção dos Nomes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#[Nome1]E[Nome2]ParaSempre</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: var(--accent-red);">#MarianaETiagoParaSempre</td>
							<td style="padding: 0.6rem 0.8rem;">Casais conhecidos pelos seus nomes próprios</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">3. Festa & Animação</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#FestaDos[Apelido]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: #16a34a;">#FestaDosSantos2026</td>
							<td style="padding: 0.6rem 0.8rem;">Copos-d'água animados e pista de dança</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">4. Local / Destino</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#[Apelido]Em[Local]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: #d97706;">#SantosEmSintra</td>
							<td style="padding: 0.6rem 0.8rem;">Casamentos de destino ou locais emblemáticos</td>
						</tr>
						<tr>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">5. Curta & Minimalista</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#[Iniciais][Ano]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: var(--fg-pencil);">#MeT2026</td>
							<td style="padding: 0.6rem 0.8rem;">Placas compactas e impressões de photobooth</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- SEO Article & Comprehensive Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Manual de Redes Sociais & Partilha</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					Como Criar e Divulgar a Hashtag do Seu Casamento
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					Reúna todas as fotografias espontâneas e vídeos dos convidados num único álbum digital no Instagram e TikTok.
				</p>
			</div>

			<!-- Section 1: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes
				</h3>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						Podemos usar mais do que uma hashtag?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						É fortemente recomendado usar <strong>apenas uma hashtag principal</strong>. Usar várias divide as fotos por canais diferentes, tornando mais difícil ver todas as publicações dos convidados juntas.
					</p>
				</details>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						Como imprimir a placa de mesa para o bar?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Selecione a sua hashtag favorita e clique em <strong>"🖨️ Exportar PDF / Imprimir"</strong> no topo da página. Imprima em papel grosso de qualidade e coloque numa moldura bonita de mesa!
					</p>
				</details>
			</section>

		</article>

	</main>
</Layout>

<style>
	.filter-tab-btn.active-tab {
		background: var(--fg-pencil) !important;
		color: #fff !important;
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 40px;
		}
	}
</style>

<script is:inline>
	let selectedFeaturedTag = '#CasamentoSilvaSantos';
	let currentVibeFilter = 'all';

	const p1FirstInput = document.getElementById('p1-first');
	const p1LastInput = document.getElementById('p1-last');
	const p2FirstInput = document.getElementById('p2-first');
	const p2LastInput = document.getElementById('p2-last');
	const nicknameInput = document.getElementById('couple-nickname');
	const yearInput = document.getElementById('wedding-year');
	const cityInput = document.getElementById('wedding-city');

	const displaySelectedHashtag = document.getElementById('display-selected-hashtag');
	const printHashtagDisplay = document.getElementById('print-hashtag-display');
	const tagsCountBadge = document.getElementById('tags-count-badge');
	const hashtagsStreamContainer = document.getElementById('hashtags-stream-container');

	function cap(str) {
		if (!str) return '';
		return str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();
	}

	function clean(str) {
		return str.replace(/[^a-zA-Z0-9]/g, '');
	}

	function generateAllTags() {
		const f1 = cap(clean(p1FirstInput.value.trim())) || 'Mariana';
		const l1 = cap(clean(p1LastInput.value.trim())) || 'Silva';
		const f2 = cap(clean(p2FirstInput.value.trim())) || 'Tiago';
		const l2 = cap(clean(p2LastInput.value.trim())) || 'Santos';
		const nick = cap(clean(nicknameInput.value.trim())) || `${f1}E${f2}`;
		const yr = clean(yearInput.value.trim()) || '2026';
		const y2 = yr.slice(-2);
		const city = cap(clean(cityInput.value.trim())) || 'Sintra';

		const allTags = [
			// Romanticas
			{ tag: `#Casamento${l1}${l2}`, vibe: 'romantic', score: '99%' },
			{ tag: `#Casamento${l2}`, vibe: 'romantic', score: '98%' },
			{ tag: `#${f1}E${f2}ParaSempre`, vibe: 'romantic', score: '97%' },
			{ tag: `#ParaSempre${l2}`, vibe: 'romantic', score: '96%' },
			{ tag: `#AmorDos${l2}`, vibe: 'romantic', score: '95%' },
			{ tag: `#${f1}DisseSim`, vibe: 'romantic', score: '96%' },
			{ tag: `#OAmorVenceu${l2}`, vibe: 'romantic', score: '94%' },
			{ tag: `#JuntosParaSempre${yr}`, vibe: 'romantic', score: '93%' },
			{ tag: `#Uniao${l1}${l2}`, vibe: 'romantic', score: '95%' },
			{ tag: `#${f1}E${f2}Casam`, vibe: 'romantic', score: '92%' },

			// Divertidas / Trocadilhos
			{ tag: `#AgoraEQueSaoElas${l2}`, vibe: 'funny', score: '98%' },
			{ tag: `#${l2}Casou`, vibe: 'funny', score: '97%' },
			{ tag: `#${f1}ApanhouO${l2}`, vibe: 'funny', score: '96%' },
			{ tag: `#LevaMeAoAltar${l2}`, vibe: 'funny', score: '95%' },
			{ tag: `#OFimDaSolteirice${l2}`, vibe: 'funny', score: '94%' },
			{ tag: `#${nick}DeAlianca`, vibe: 'funny', score: '95%' },
			{ tag: `#AtiraramOArroz`, vibe: 'funny', score: '93%' },
			{ tag: `#QuemCasaQuerCasa${l2}`, vibe: 'funny', score: '92%' },

			// Festa / Copo-d'Agua
			{ tag: `#FestaDos${l2}`, vibe: 'party', score: '99%' },
			{ tag: `#BrindeAos${l2}`, vibe: 'party', score: '98%' },
			{ tag: `#VivaOsNoivos${l2}`, vibe: 'party', score: '97%' },
			{ tag: `#CoposCom${nick}`, vibe: 'party', score: '96%' },
			{ tag: `#DancaDos${l2}`, vibe: 'party', score: '94%' },
			{ tag: `#FestaDoAno${yr}`, vibe: 'party', score: '95%' },
			{ tag: `#BoraCelebrar${nick}`, vibe: 'party', score: '93%' },

			// Curtas & Simples
			{ tag: `#${f1}E${f2}${yr}`, vibe: 'short', score: '99%' },
			{ tag: `#${f1}E${f2}${y2}`, vibe: 'short', score: '96%' },
			{ tag: `#${nick}${yr}`, vibe: 'short', score: '98%' },
			{ tag: `#${l1}${l2}${yr}`, vibe: 'short', score: '95%' },
			{ tag: `#Os${l2}${yr}`, vibe: 'short', score: '97%' },
			{ tag: `#Equipa${nick}`, vibe: 'short', score: '92%' },

			// Destino / Local
			{ tag: `#${l2}Em${city}`, vibe: 'romantic', score: '97%' },
			{ tag: `#${nick}Em${city}`, vibe: 'party', score: '96%' },
			{ tag: `#CasamentoEm${city}${yr}`, vibe: 'short', score: '94%' }
		];

		return allTags;
	}

	function renderTags() {
		const allTags = generateAllTags();
		
		const filtered = currentVibeFilter === 'all' 
			? allTags 
			: allTags.filter(t => t.vibe === currentVibeFilter);

		tagsCountBadge.textContent = `${filtered.length} Tags`;

		hashtagsStreamContainer.innerHTML = '';
		filtered.forEach(item => {
			const card = document.createElement('div');
			card.className = 'hand-card';
			card.style.cssText = `padding: 0.75rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.15s ease;`;
			
			const isFeatured = item.tag === selectedFeaturedTag;
			if (isFeatured) {
				card.style.borderColor = 'var(--accent-blue)';
				card.style.background = '#eff6ff';
			}

			const igSearchUrl = `https://www.instagram.com/explore/tags/${item.tag.replace('#', '')}/`;

			card.innerHTML = `
				<div style="margin-bottom: 0.5rem;">
					<strong class="font-heading tag-title" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; word-break: break-word;">${item.tag}</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">Estilo: ${item.vibe}</span>
				</div>
				<div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed #ddd; padding-top: 0.4rem; gap: 0.3rem;">
					<button type="button" class="btn-copy-tag hand-btn" data-tag="${item.tag}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #f0fdf4;">
						📋 Copiar
					</button>
					<a href="${igSearchUrl}" target="_blank" rel="noopener noreferrer nofollow" class="hand-btn secondary" style="padding: 0.2rem 0.45rem; font-size: 0.72rem; text-decoration: none;">
						🔍 IG
					</a>
				</div>
			`;

			card.addEventListener('click', (e) => {
				if (e.target.tagName === 'BUTTON' || e.target.tagName === 'A') return;
				selectedFeaturedTag = item.tag;
				displaySelectedHashtag.textContent = selectedFeaturedTag;
				printHashtagDisplay.textContent = selectedFeaturedTag;
				renderTags();
			});

			hashtagsStreamContainer.appendChild(card);
		});

		document.querySelectorAll('.btn-copy-tag').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const tag = btn.getAttribute('data-tag');
				navigator.clipboard.writeText(tag).then(() => {
					const oldText = btn.textContent;
					btn.textContent = 'Copiado! ✅';
					btn.style.background = '#dcfce7';
					setTimeout(() => {
						btn.textContent = oldText;
						btn.style.background = '#f0fdf4';
					}, 1500);
				});
			});
		});
	}

	document.querySelectorAll('.filter-tab-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.filter-tab-btn').forEach(b => {
				b.classList.remove('active-tab');
				b.classList.add('secondary');
			});
			btn.classList.add('active-tab');
			btn.classList.remove('secondary');
			currentVibeFilter = btn.getAttribute('data-vibe');
			renderTags();
		});
	});

	[p1FirstInput, p1LastInput, p2FirstInput, p2LastInput, nicknameInput, yearInput, cityInput].forEach(el => {
		el.addEventListener('input', () => {
			const all = generateAllTags();
			selectedFeaturedTag = all[0].tag;
			displaySelectedHashtag.textContent = selectedFeaturedTag;
			printHashtagDisplay.textContent = selectedFeaturedTag;
			renderTags();
		});
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const allTags = generateAllTags();
		let tagsHtml = '';
		allTags.forEach(t => {
			tagsHtml += `<li style="font-size:14px; font-weight:bold; color:#1e3a8a; margin-bottom:4px;">${t.tag} <span style="font-size:11px; color:#666; font-weight:normal;">(${t.vibe})</span></li>`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Placa de Hashtag de Casamento</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					.sign-box { border: 2px solid #333; background: #fafafa; padding: 25px; text-align: center; margin-bottom: 25px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Hashtags e Placas de Casamento</h1>
				<p>Gerado em ${new Date().toLocaleDateString('pt-PT')} | Hashtag Principal: <strong>${selectedFeaturedTag}</strong></p>
				
				<div class="sign-box">
					<p style="text-transform:uppercase; letter-spacing:2px; font-size:12px; margin:0 0 10px 0;">Ajudem-nos a Recordar Este Dia</p>
					<h2 style="font-size:24px; margin:0 0 15px 0;">Partilhem as Vossas Fotos & Vídeos no Instagram</h2>
					<h1 style="font-size:32px; color:#1e3a8a; margin:10px 0;">${selectedFeaturedTag}</h1>
					<p style="font-style:italic; font-size:13px; margin:15px 0 0 0;">Obrigado por celebrarem connosco!</p>
				</div>

				<h3>Mais de 30 Sugestões de Hashtags Geradas:</h3>
				<ul>${tagsHtml}</ul>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hashtags_Casamento_${clean(selectedFeaturedTag)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print Sign
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		printHashtagDisplay.textContent = selectedFeaturedTag;
		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const allTags = generateAllTags();
		let csv = "Hashtag,Estilo,Pontuacao\n";
		allTags.forEach(t => {
			csv += `"${t.tag}","${t.vibe}","${t.score}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hashtags_Casamento.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	renderTags();
</script>
