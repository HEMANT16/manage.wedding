---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/bachelor-party-budget-calculator/#webapp",
      "name": "Calculadora de Orçamento para Despedida de Solteiro e Divisão de Custos",
      "url": "https://manage.wedding/pt/bachelor-party-budget-calculator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita para despedida de solteiro e divisão de despesas. Calcule o valor exato por amigo para alojamento, barco, jantares, discotecas e bebidas cobrindo a parte do noivo. Exporte mensagens para MB Way, Pix, Word e PDF.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Planear e Dividir os Custos de uma Despedida de Solteiro",
      "description": "Guia passo a passo para o padrinho e organizadores: como calcular o orçamento, recolher os pagamentos e oferecer a viagem ao noivo sem dívidas.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Confirmar o Grupo e Oferecer ao Noivo",
          "text": "Conte os amigos confirmados e aplique a regra N-1: as despesas de alojamento, refeições, atividades e bebidas do noivo são divididas igualmente pelos amigos."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Reservar Alojamento e Transporte Coletivo",
          "text": "Some os custos fixos obrigatórios: casa de campo, Airbnb, caução, limpeza e carrinha de 9 lugares com portagens e combustível."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Orçamentar Atividades, Jantares e Noite",
          "text": "Inclua estimativas para aluguer de barco, karting, prova de cervejas, jantar de rodízio e mesa VIP na discoteca."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Recolher o Sinal via MB Way / Transferência",
          "text": "Envie o resumo no WhatsApp: recolha um sinal de 50% entre 3 a 5 meses antes para bloquear as reservas e o restante 2 semanas antes do evento."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O noivo paga alguma despesa na sua despedida de solteiro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. De acordo com a etiqueta tradicional da despedida de solteiro, o noivo é 100% convidado: os padrinhos e amigos dividem entre si a totalidade dos custos de estadia, comida, atividades e bebidas (fórmula N-1). O noivo paga apenas a sua própria viagem individual (voo ou bilhete de comboio)."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto custa em média uma despedida de solteiro por pessoa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uma viagem de fim de semana (ex. Algarve, Lisboa, Porto, Madrid) custa em média entre 220€ e 420€ por pessoa com tudo incluído (alojamento, refeições, atividades, bebidas e a parte do noivo). Um fim de semana em casa de campo com churrasco varia entre 130€ e 200€ por pessoa."
          }
        },
        {
          "@type": "Question",
          "name": "Quando deve o padrinho recolher o dinheiro da despedida?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Recolha a primeira prestação (50% de sinal para garantir o alojamento e o barco) 3 a 5 meses antes. A segunda prestação (os restantes 50% para supermercado, jantares e discotecas) deve ser liquidada 2 semanas antes da viagem. Nunca avance quantias elevadas no seu cartão pessoal sem ter o dinheiro garantido."
          }
        },
        {
          "@type": "Question",
          "name": "O que fazer se um amigo tiver um orçamento mais apertado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Faça uma votação anónima antes de escolher a cidade. Se alguém não puder suportar o fim de semana completo, dê a opção de participar apenas no jantar e saída de sábado ou de contribuir com um valor simbólico (20-30€) para pagar uma rodada ao noivo."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Orçamento para Despedida de Solteiro (Oferecer ao Noivo) | Manage.Wedding"
	description="Calculadora gratuita para despedida de solteiro e divisão de custos. Calcule o valor exato por amigo para alojamento/Airbnb, barco, jantares, discotecas e bebidas oferecendo a parte do noivo. Exporte para MB Way, Pix, Word e PDF."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Orçamento Despedida de Solteiro" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Oferecer ao Noivo & Divisão MB Way</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Orçamento Despedida de Solteiro <span class="accent-italic">& Divisão de Custos</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcule o valor exato por amigo para alojamento, passeio de barco, jantares de rodízio, noites de festa e bebidas. Ofereça automaticamente o fim de semana ao noivo e exporte mensagens para WhatsApp e MB Way em 1 clique.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Configurações & Categorias -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						Detalhes da Viagem & Grupo
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Fórmula N-1
					</span>
				</div>

				<!-- Destination / Preset Picker -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="destination-preset" style="font-weight: 700;">Destino / Tipo de Viagem</label>
					<select id="destination-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; padding: 0.65rem;">
						<option value="algarve" selected>🏖️ Algarve / Albufeira (Barco com DJ, Praia & Discotecas / 380€/amigo)</option>
						<option value="lisboa">🏰 Lisboa / Madrid (Rooftops, Bairro Alto & Jantar / 290€/amigo)</option>
						<option value="porto">🍷 Porto / Douro (Barco Rabelo, Caves de Vinho & Cerveja / 250€/amigo)</option>
						<option value="costa">🏄 Benidorm / Costa del Sol (Karting, Paintball & Praia / 270€/amigo)</option>
						<option value="campo">🏡 Casa de Campo com Piscina (Mega Churrasco & Relax / 140€/amigo)</option>
						<option value="custom">✏️ Configuração Personalizada</option>
					</select>
				</div>

				<!-- Nome do Noivo, Amigos a Pagar, Noites -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label class="form-label" for="groom-name" style="font-size: 0.9rem; font-weight: 600;">Nome do Noivo</label>
						<input type="text" id="groom-name" class="form-input" value="Gonçalo" placeholder="ex. Gonçalo" />
					</div>
					<div>
						<label class="form-label" for="guys-count" style="font-size: 0.9rem; font-weight: 600;">Amigos a Pagar</label>
						<input type="number" id="guys-count" class="form-input" value="7" min="1" max="40" />
					</div>
					<div>
						<label class="form-label" for="trip-nights" style="font-size: 0.9rem; font-weight: 600;">Noites</label>
						<input type="number" id="trip-nights" class="form-input" value="2" min="1" max="30" />
					</div>
				</div>

				<!-- Toggle Oferecer ao Noivo -->
				<div class="form-group" style="background: #fffcf5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem;">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 0.98rem; margin: 0;">
						<input type="checkbox" id="toggle-cover-groom" checked style="width: 18px; height: 18px; cursor: pointer;" />
						<span>Oferecer 100% ao Noivo (O Noivo Paga 0€)</span>
					</label>
					<span style="font-size: 0.82rem; color: #64748b; display: block; margin-top: 4px; margin-left: 26px;">
						Regra padrão: Os 7 amigos dividem o total das despesas em partes iguais.
					</span>
				</div>

				<!-- Categorias de Despesas -->
				
				<!-- Categoria 1: Alojamento -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏡 1. Alojamento e Caução (€)
						</strong>
						<span id="subtotal-lodging" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">900€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-airbnb" style="font-size: 0.85rem;">Villa / Airbnb / Casa de Campo</label>
							<input type="number" id="exp-airbnb" class="form-input" value="800" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-cleaning" style="font-size: 0.85rem;">Limpeza e Taxas</label>
							<input type="number" id="exp-cleaning" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Categoria 2: Atividades -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏄 2. Atividades e Aventuras (€)
						</strong>
						<span id="subtotal-activities" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">550€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-boat" style="font-size: 0.85rem;">Passeio de Barco / Catamarã</label>
							<input type="number" id="exp-boat" class="form-input" value="300" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-shooting" style="font-size: 0.85rem;">Karting / Paintball / Radical</label>
							<input type="number" id="exp-shooting" class="form-input" value="150" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-tours" style="font-size: 0.85rem;">Prova de Vinhos / Cervejaria</label>
							<input type="number" id="exp-tours" class="form-input" value="100" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-golf" style="font-size: 0.85rem;">Outras Atividades / Jogos</label>
							<input type="number" id="exp-golf" class="form-input" value="0" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Categoria 3: Refeições e Churrasco -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🥩 3. Refeições, Churrasco & Súper (€)
						</strong>
						<span id="subtotal-food" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">520€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-dinners" style="font-size: 0.85rem;">Jantar de Grupo / Rodízio</label>
							<input type="number" id="exp-dinners" class="form-input" value="300" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-groceries" style="font-size: 0.85rem;">Supermercado & Grande Churrasco</label>
							<input type="number" id="exp-groceries" class="form-input" value="140" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-brunch" style="font-size: 0.85rem;">Brunch, Almoços Rápidos e Snacks</label>
						<input type="number" id="exp-brunch" class="form-input" value="80" min="0" step="10" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Categoria 4: Noite e Bebidas -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🍻 4. Noite, Bares e Discotecas (€)
						</strong>
						<span id="subtotal-nightlife" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">450€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-bars" style="font-size: 0.85rem;">Bares & Rodadas de Copos</label>
							<input type="number" id="exp-bars" class="form-input" value="200" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-vip" style="font-size: 0.85rem;">Garrafa VIP / Entradas Club</label>
							<input type="number" id="exp-vip" class="form-input" value="150" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-booze" style="font-size: 0.85rem;">Bebidas e Cervejas para a Casa</label>
						<input type="number" id="exp-booze" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Categoria 5: Transporte -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🚗 5. Transporte e Combustível (€)
						</strong>
						<span id="subtotal-transport" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">130€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-rental" style="font-size: 0.85rem;">Carrinha / Gasolina / Portagens</label>
							<input type="number" id="exp-rental" class="form-input" value="80" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-uber" style="font-size: 0.85rem;">Táxis & Uber / Bolt</label>
							<input type="number" id="exp-uber" class="form-input" value="50" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Categoria 6: T-shirts e Lembranças -->
				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🧢 6. T-shirts, Disfarces e Kit (€)
						</strong>
						<span id="subtotal-swag" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">90€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-shirts" style="font-size: 0.85rem;">T-shirts / Disfarce do Noivo</label>
							<input type="number" id="exp-shirts" class="form-input" value="60" min="0" step="5" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-kits" style="font-size: 0.85rem;">Kit Anti-ressaca & Copos</label>
							<input type="number" id="exp-kits" class="form-input" value="30" min="0" step="5" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Resumo, MB Way & Exportações -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Cost Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.25rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Custo por Amigo Pagante
						</span>
						<span id="groom-status-badge" style="font-size: 0.85rem; font-weight: 800; background: #16a34a; color: #fff; padding: 3px 8px; border-radius: 4px;">
							🤵 Gonçalo Paga: 0€
						</span>
					</div>

					<div id="display-per-person" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						377€
					</div>

					<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.25rem; font-size: 0.95rem; color: var(--text-secondary); flex-wrap: wrap;">
						<span>🌙 <strong id="display-per-night" style="color: var(--fg-pencil);">189€</strong> / noite</span>
						<span>•</span>
						<span>🎁 Quota do noivo: <strong id="display-groom-subsidy" style="color: var(--accent-red); font-weight: 700;">+47€</strong> / amigo</span>
					</div>

					<p style="font-size: 0.92rem; color: var(--text-secondary); margin: 0 0 1.25rem 0; padding-bottom: 1rem; border-bottom: 1px dashed #cbd5e1;">
						Orçamento total do grupo: <strong id="display-trip-grand-total" style="color: var(--fg-pencil); font-weight: 700;">2.640€</strong> para <span id="display-headcount-text">7 amigos</span> (+ noivo).
					</p>

					<!-- Itemized Per-Person Split Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏡 Alojamento e Caução:</span>
							<strong id="item-lodging-share">129€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏄 Atividades e Barco:</span>
							<strong id="item-activity-share">79€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🥩 Jantares e Churrasco:</span>
							<strong id="item-food-share">74€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🍻 Noite, Bares e Discotecas:</span>
							<strong id="item-nightlife-share">64€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🚗 Transporte e Gasolina:</span>
							<strong id="item-transport-share">19€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.9rem;">
							<span>🧢 T-shirts e Lembranças:</span>
							<strong id="item-swag-share">13€</strong>
						</div>
					</div>

					<!-- Suggested Payment Schedule -->
