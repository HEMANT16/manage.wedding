---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-processional-order/#webapp",
      "name": "Gerador de Ordem do Cortejo Nupcial e Cerimónia de Casamento",
      "url": "https://manage.wedding/pt/wedding-processional-order",
      "inLanguage": "pt",
      "description": "Gerador gratuito da ordem do cortejo nupcial (entrada e saída da cerimónia). Personalize a entrada para casamentos católicos, civis, tradicionais e laicos. Exporte o guia de bolso para impressão e envio por WhatsApp.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Organizar a Ordem do Cortejo de Entrada e Saída do Casamento",
      "description": "Guia de etiqueta passo a passo para organizar o cortejo nupcial, posições no altar e distanciamento no corredor da cerimónia.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Entrada dos Avós e Pais",
          "text": "O cortejo tem início com a entrada dos avós e pais do noivo, seguindo-se a mãe da noiva (a última pessoa da família a sentar-se antes do início formal)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: O Celebrante, Noivo e Padrinho Entram no Altar",
          "text": "O celebrante/padre, o noivo e o padrinho entram lateralmente ou percorrem a nave antes do cortejo dos padrinhos e damas."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Entrada dos Padrinhos, Damas e Meninos das Alianças",
          "text": "Os padrinhos e damas entram aos pares ou individualmente com um compasso de espera de 4 a 6 passos, seguidos dos meninos das alianças e meninas das flores."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Entrada Solene da Noiva e Transição Musical",
          "text": "A música de entrada nupcial começa. A noiva entra acompanhada pelo pai, por ambos os pais ou sozinha até ao encontro do noivo."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quem entra em primeiro lugar no cortejo tradicional de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No protocolo tradicional católico/ocidental, entram primeiro os avós e a mãe do noivo (acompanhada pelo noivo), seguidos pela mãe da noiva. O celebrante aguarda junto ao altar."
          }
        },
        {
          "@type": "Question",
          "name": "De que lado se posiciona a noiva no altar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nas cerimónias católicas e ocidentais, a noiva fica do lado esquerdo do altar (olhando para o altar) e o noivo do lado direito. Nas tradições judaicas, a noiva fica à direita e o noivo à esquerda."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é a ordem correta para o cortejo de saída (Recessional)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O cortejo de saída faz-se pela ordem inversa da entrada: os recém-casados saem em primeiro lugar sob aplausos e pétalas/arroz, seguidos pelos meninos das alianças, padrinhos, damas e pais."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Ordem do Cortejo Nupcial e Entrada da Cerimónia | Manage.Wedding"
	description="Gerador gratuito da ordem do cortejo nupcial (entrada e saída). Personalize alinhamentos para casamentos católicos, civis e tradicionais. Exporte para PDF e WhatsApp."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Cortejo Nupcial" category="logistics" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Planeador de Cerimónia & Ensaios</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Ordem do <span class="accent-italic">Cortejo Nupcial</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Personalize a ordem de entrada, posições no altar e cortejo de saída para cerimónias católicas, civis, tradicionais e modernas. Exporte guias de bolso para o celebrante, wedding planner e padrinhos.
			</p>
		</header>

		<!-- Main Interactive Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Ceremony Configuration & Lineup Builder -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Configuração do Cortejo
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Multi-Tradição
					</span>
				</div>

				<!-- Tradition Selector -->
				<div class="form-group">
					<label class="form-label" for="ceremony-tradition">Tipo de Cerimónia / Tradição</label>
					<select id="ceremony-tradition" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="catholic" selected>⛪ Cerimónia Católica / Religiosa Tradicional</option>
						<option value="civil">🏛️ Cerimónia Civil / Na Quinta / Laica</option>
						<option value="jewish">✡️ Cerimónia Judaica (Sob a Chuppah)</option>
						<option value="lgbtq">🌈 Entrada Dupla / Igualitária Simétrica</option>
						<option value="minimalist">🌿 Íntima & Minimalista (Cortejo Curto)</option>
					</select>
				</div>

				<!-- Mode Selector (Processional vs Recessional) -->
				<div class="form-group">
					<label class="form-label">Fase do Cortejo</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="phase-btn hand-btn is-active" data-phase="processional" style="padding: 8px; font-size: 0.9rem;">
							🚶‍♂️ 1. Entrada (Cortejo Nupcial)
						</button>
						<button type="button" class="phase-btn hand-btn" data-phase="recessional" style="padding: 8px; font-size: 0.9rem;">
							🎉 2. Saída dos Noivos
						</button>
					</div>
				</div>

				<!-- Couple Names -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="partner1-name">Noiva / Parceiro(a) 1</label>
						<input type="text" id="partner1-name" class="form-input" value="Sara" placeholder="ex.: Sara" />
					</div>
					<div>
						<label class="form-label" for="partner2-name">Noivo / Parceiro(a) 2</label>
						<input type="text" id="partner2-name" class="form-input" value="Gonçalo" placeholder="ex.: Gonçalo" />
					</div>
				</div>

				<!-- Escort Selection -->
				<div class="form-group">
					<label class="form-label" for="escort-style">Acompanhante da Noiva</label>
					<select id="escort-style" class="form-input" style="cursor: pointer;">
						<option value="father" selected>Acompanhada pelo Pai</option>
						<option value="both-parents">Acompanhada por Ambos os Pais (Mãe e Pai)</option>
						<option value="mother">Acompanhada pela Mãe</option>
						<option value="sibling">Acompanhada por Irmão(ã) / Familiar</option>
						<option value="solo">Entrada Sozinha até ao Altar</option>
						<option value="together">Entrada Conjunta com o Noivo</option>
					</select>
				</div>

				<!-- Quick Add Custom Attendant -->
				<div class="form-group" style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label class="form-label">Adicionar Membro Personalizado</label>
					<div style="display: flex; gap: 0.5rem;">
						<input type="text" id="custom-member-input" class="form-input" placeholder="ex.: Menino com Placa 'Lá Vem a Noiva'" style="flex: 1;" />
						<button id="btn-add-custom-member" type="button" class="hand-btn secondary" style="padding: 8px 14px; font-size: 0.9rem;">
							+ Adicionar
						</button>
					</div>
				</div>

			</div>

			<!-- Right Column: Interactive Lineup Cards & Coordinator Pocket Sheet -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Lineup Card Container -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 id="lineup-heading" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							1. Ordem de Entrada do Cortejo
						</h3>
						<span id="lineup-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							8 Passos | ~4-6 passos de intervalo
						</span>
					</div>

					<!-- Visual Lineup Cards List -->
					<div id="lineup-list-container" style="display: flex; flex-direction: column; gap: 0.6rem; max-height: 520px; overflow-y: auto; padding-right: 4px;">
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-pocket-sheet" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Guia de Bolso (PDF)
						</button>
						<button id="btn-export-text" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📲</span> Copiar Cortejo para WhatsApp
						</button>
					</div>

				</div>

				<!-- Music Transition & Timing Cue Box -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						🎵 Dicas de Música e Transições do Cortejo:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Música 1 (Prelúdio do Cortejo):</strong> Para a entrada do noivo, mães, pais e padrinhos/damas.</li>
						<li><strong>Pausa de Silêncio (10–15s):</strong> Silêncio total enquanto os convidados se levantam e as portas se abrem.</li>
						<li><strong>Música 2 (Marcha Nupcial / Entrada da Noiva):</strong> A música solene e emotiva enquanto a noiva caminha até ao altar.</li>
						<li><strong>Música 3 (Saída Triunfal):</strong> Música alegre e festiva enquanto os noivos saem sob chuva de arroz ou pétalas!</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumo Direto ao Assunto (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Guia Rápido: Ordem do Cortejo Nupcial
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Consulte a sequência padrão de entrada e saída para a cerimónia de casamento.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					🚶‍♂️ A Regra Universal do Cortejo de Entrada e Saída:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Entrada: [Noivo com a Mãe → Mãe da Noiva com Pai do Noivo → Padrinhos e Damas → Meninos das Alianças → Noiva com o Pai] • Saída: [Recém-Casados PRIMEIRO → Meninos das Alianças → Padrinhos aos pares → Pais].
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Tipo de Cerimónia</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Estilo de Entrada & Acompanhantes</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Posição no Altar</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Destaque do Protocolo</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Católica Tradicional</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Noivo entra com a mãe; Noiva entra acompanhada pelo pai.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Noiva à ESQUERDA, Noivo à DIREITA</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Mãe da noiva é a última a sentar antes da noiva</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Civil na Quinta</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Entrada flexível dos padrinhos e damas; Noiva com o pai ou ambos os pais.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Geralmente Noiva à Esquerda</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Ritmo mais descontraído e personalizado</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Judaica (Chuppah)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Noivo acompanhado pelos dois pais; Noiva acompanhada pelos dois pais.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Noiva à DIREITA, Noivo à ESQUERDA</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Todos os intervenientes ficam sob a Chuppah</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Moderna / LGBTQ+</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Entrada simultânea em dois corredores ou entrada conjunta como casal.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Posicionamento livre à escolha</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Entrada simétrica celebrando a igualdade</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guia Completo para o Cortejo da Cerimónia de Casamento
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Como coordenar entradas elegantes, evitar passos apressados e garantir fotografias perfeitas no corredor.
				</p>
			</div>

			<!-- Section 1: Halfway Rule -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. A Regra do Meio do Corredor para Fotografia Perfeita
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					O erro mais comum nos ensaios é as damas e padrinhos entrarem colados uns aos outros. Aplique sempre a <strong>Regra do Meio do Corredor</strong>:
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>📏 A Regra do Meio do Corredor:</strong><br />
					Cada par de padrinhos ou dama de honor só deve começar a caminhar quando a pessoa à sua frente já tiver chegado a meio do corredor. Desta forma, o fotógrafo consegue captar retratos individuais limpos e desimpedidos de todos os intervenientes!
				</div>
			</section>

			<!-- Section 2: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Quem entra em primeiro lugar no cortejo tradicional de casamento?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Entra primeiro o noivo acompanhado pela mãe, seguindo-se o pai do noivo com a mãe da noiva, os padrinhos e as damas de honor.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">A noiva pode ser acompanhada por ambos os pais?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Com certeza. Embora a tradição ocidental mais antiga refira apenas o pai, ter a mãe e o pai de braço dado com a noiva é a norma no rito judaico e cada vez mais frequente em casamentos modernos para homenagear ambos por igual.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/pt/wedding-processional-order" category="logistics" />

	</main>

	<!-- Interactive Script -->
	<script is:inline>
		const traditionSelect = document.getElementById('ceremony-tradition');
		const partner1Input = document.getElementById('partner1-name');
		const partner2Input = document.getElementById('partner2-name');
		const escortSelect = document.getElementById('escort-style');
		const phaseButtons = document.querySelectorAll('.phase-btn');
		const lineupContainer = document.getElementById('lineup-list-container');
		const lineupHeading = document.getElementById('lineup-heading');
		const lineupCountBadge = document.getElementById('lineup-count-badge');
		const customInput = document.getElementById('custom-member-input');
		const btnAddCustom = document.getElementById('btn-add-custom-member');
		const btnPrint = document.getElementById('btn-print-pocket-sheet');
		const btnCopyText = document.getElementById('btn-export-text');

		let currentPhase = 'processional';
		let lineupData = [];

		const presets = {
			catholic: [
				{ role: "Entrada do Noivo com a Mãe", names: "Noivo (Gonçalo) & Mãe do Noivo", cue: "Música 1 tem início" },
				{ role: "Entrada do Pai do Noivo com a Mãe da Noiva", names: "Pai do Noivo & Mãe da Noiva", cue: "" },
				{ role: "Entrada dos Padrinhos e Damas de Honor", names: "Padrinhos e Damas (Aos pares)", cue: "Intervalo de meio corredor" },
				{ role: "Meninos das Alianças & Meninas das Flores", names: "Meninos das Alianças", cue: "Levam porta-alianças e pétalas" },
				{ role: "Entrada Solene da Noiva (Sara & Acompanhante)", names: "Noiva (Sara) & Pai", cue: "🎵 Música 2 (Marcha Nupcial)" }
			],
			civil: [
				{ role: "Entrada dos Pais e Família Próxima", names: "Pais e Avós dos Noivos", cue: "Música de Fundo" },
				{ role: "Entrada do Noivo", names: "Noivo (Gonçalo) & Mãe", cue: "" },
				{ role: "Entrada dos Padrinhos e Amigos", names: "Padrinhos e Damas de Honor", cue: "Espaçamento regular" },
				{ role: "Meninos das Alianças", names: "Meninos das Alianças", cue: "" },
				{ role: "Entrada da Noiva", names: "Noiva (Sara) & Acompanhante", cue: "🎵 Música de Entrada da Noiva" }
			],
			jewish: [
				{ role: "Rabino e/ou Cantor", names: "Rabino", cue: "Posicionamento sob a Chuppah" },
				{ role: "Avós dos Noivos", names: "Avós", cue: "" },
				{ role: "Padrinhos", names: "Padrinhos", cue: "" },
				{ role: "Noivo Acompanhado por Ambos os Pais", names: "Noivo (Gonçalo) + Mãe e Pai", cue: "Posiciona-se à esquerda na Chuppah" },
				{ role: "Damas de Honor", names: "Damas de Honor", cue: "" },
				{ role: "Meninos das Alianças", names: "Meninos das Alianças", cue: "" },
				{ role: "Noiva Acompanhada por Ambos os Pais", names: "Noiva (Sara) + Mãe e Pai", cue: "🎵 Entrada Nupcial sob a Chuppah" }
			],
			lgbtq: [
				{ role: "Entrada dos Pais e Famílias", names: "Pais de Ambos os Noivos", cue: "Música 1" },
				{ role: "Celebrante no Altar", names: "Celebrante", cue: "Posição central" },
				{ role: "Cortejo de Padrinhos e Amigos", names: "Padrinhos e Amigos", cue: "Alinhamento simétrico" },
				{ role: "Entrada Conjunta do Casal", names: "Parceiro 1 (Sara) & Parceiro 2 (Gonçalo) Entram Juntos", cue: "🎵 Caminham juntos pelo corredor central" }
			],
			minimalist: [
				{ role: "Celebrante e Noivo", names: "Celebrante & Noivo (Gonçalo)", cue: "Aguardam no altar" },
				{ role: "Testemunhas / Padrinhos", names: "Testemunhas", cue: "" },
				{ role: "Entrada da Noiva", names: "Noiva (Sara) & Acompanhante", cue: "🎵 Entrada da Cerimónia" }
			]
		};

		function loadTradition() {
			const t = traditionSelect.value;
			const raw = presets[t] || presets.catholic;
			lineupData = JSON.parse(JSON.stringify(raw));
			applyCustomNames();
		}

		function applyCustomNames() {
			const p1 = partner1Input.value.trim() || 'Sara';
			const p2 = partner2Input.value.trim() || 'Gonçalo';
			const escort = escortSelect.options[escortSelect.selectedIndex].text;

			lineupData.forEach(item => {
				item.role = item.role.replace(/Sara/g, p1).replace(/Gonçalo/g, p2);
				item.names = item.names.replace(/Sara/g, p1).replace(/Gonçalo/g, p2);
				if (item.role.includes('Noiva') && item.role.includes('Entrada')) {
					item.names = `${p1} & ${escort}`;
				}
			});
			renderLineup();
		}

		function renderLineup() {
			lineupContainer.innerHTML = '';

			let displayList = [...lineupData];
			if (currentPhase === 'recessional') {
				lineupHeading.textContent = '2. Ordem de Saída dos Noivos';
				displayList = [
					{ role: "Recém-Casados Saem em Primeiro", names: `${partner1Input.value || 'Sara'} & ${partner2Input.value || 'Gonçalo'} (Casados!)`, cue: "🎵 Música Festiva de Saída (Chuva de Arroz)" },
					{ role: "Meninos das Alianças", names: "Meninos das Alianças", cue: "Saem logo a seguir aos noivos" },
					{ role: "Padrinhos e Madrinhas", names: "Padrinhos e Damas (Aos pares)", cue: "" },
					{ role: "Pais da Noiva", names: "Pais da Noiva", cue: "" },
					{ role: "Pais do Noivo", names: "Pais do Noivo", cue: "" },
					{ role: "Avós e Família", names: "Avós", cue: "" },
					{ role: "Despedida dos Convidados", names: "Convidados saem para o exterior", cue: "" }
				];
			} else {
				lineupHeading.textContent = '1. Ordem de Entrada do Cortejo';
			}

			lineupCountBadge.textContent = `${displayList.length} Passos | ~4-6 passos de intervalo`;

			displayList.forEach((item, idx) => {
				const row = document.createElement('div');
				row.style.cssText = "display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; gap: 0.75rem;";
				
				row.innerHTML = `
					<div style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">
						<span style="font-weight: 800; font-size: 1.1rem; color: var(--accent-red); width: 24px; text-align: center;">${idx + 1}</span>
						<div>
							<strong style="font-size: 0.98rem; color: var(--fg-pencil); display: block;">${item.role}</strong>
							<span style="font-size: 0.88rem; color: #475569;">${item.names}</span>
							${item.cue ? `<span style="display: block; font-size: 0.78rem; font-weight: 700; color: var(--accent-blue); margin-top: 2px;">⚡ Momento: ${item.cue}</span>` : ''}
						</div>
					</div>
					<div style="display: flex; gap: 4px;">
						<button type="button" class="btn-move-up hand-btn secondary" data-index="${idx}" style="padding: 3px 7px; font-size: 0.75rem;" ${idx === 0 ? 'disabled' : ''}>▲</button>
						<button type="button" class="btn-move-down hand-btn secondary" data-index="${idx}" style="padding: 3px 7px; font-size: 0.75rem;" ${idx === displayList.length - 1 ? 'disabled' : ''}>▼</button>
					</div>
				`;
				lineupContainer.appendChild(row);
			});

			if (currentPhase === 'processional') {
				document.querySelectorAll('.btn-move-up').forEach(b => {
					b.addEventListener('click', () => {
						const idx = parseInt(b.getAttribute('data-index'), 10);
						if (idx > 0) {
							const temp = lineupData[idx];
							lineupData[idx] = lineupData[idx - 1];
							lineupData[idx - 1] = temp;
							renderLineup();
						}
					});
				});
				document.querySelectorAll('.btn-move-down').forEach(b => {
					b.addEventListener('click', () => {
						const idx = parseInt(b.getAttribute('data-index'), 10);
						if (idx < lineupData.length - 1) {
							const temp = lineupData[idx];
							lineupData[idx] = lineupData[idx + 1];
							lineupData[idx + 1] = temp;
							renderLineup();
						}
					});
				});
			}
		}

		phaseButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				phaseButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentPhase = btn.getAttribute('data-phase');
				renderLineup();
			});
		});

		btnAddCustom.addEventListener('click', () => {
			const val = customInput.value.trim();
			if (!val) return;
			lineupData.splice(lineupData.length - 1, 0, {
				role: val,
				names: val,
				cue: "Membro Personalizado"
			});
			customInput.value = '';
			renderLineup();
		});

		traditionSelect.addEventListener('change', loadTradition);
		[partner1Input, partner2Input, escortSelect].forEach(inp => {
			inp.addEventListener('input', applyCustomNames);
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			let html = `
				<!DOCTYPE html>
				<html>
				<head>
					<title>Guia de Bolso do Cortejo — Manage.Wedding</title>
					<style>
						@page { size: 8.5in 11in; margin: 0.5in; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						h2 { font-size: 14pt; margin-top: 18px; margin-bottom: 6px; border-bottom: 2px solid #0f172a; padding-bottom: 3px; }
						table { width: 100%; border-collapse: collapse; margin-top: 8px; }
						th, td { border: 1px solid #cbd5e1; padding: 6px 10px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
					</style>
				</head>
				<body>
					<h1>Guia de Cortejo Nupcial: ${partner1Input.value || 'Sara'} & ${partner2Input.value || 'Gonçalo'}</h1>
					<p style="font-size: 10pt; color: #64748b; margin-top: 0;">Tradição: ${traditionSelect.options[traditionSelect.selectedIndex].text} | Intervalo: 4-6 passos (Regra do Meio do Corredor)</p>
					
					<h2>1. Ordem de Entrada do Cortejo</h2>
					<table>
						<thead><tr><th style="width: 40px;">#</th><th>Papel / Posição</th><th>Participantes</th><th>Música & Momento</th></tr></thead>
						<tbody>
			`;

			lineupData.forEach((item, idx) => {
				html += `
					<tr>
						<td><strong>${idx + 1}</strong></td>
						<td><strong>${item.role}</strong></td>
						<td>${item.names}</td>
						<td>${item.cue || '—'}</td>
					</tr>
				`;
			});

			html += `
						</tbody>
					</table>

					<h2>2. Ordem de Saída da Cerimónia</h2>
					<table>
						<thead><tr><th style="width: 40px;">#</th><th>Ordem</th><th>Participantes</th></tr></thead>
						<tbody>
							<tr><td>1</td><td><strong>Recém-Casados (Primeiro)</strong></td><td>${partner1Input.value || 'Sara'} & ${partner2Input.value || 'Gonçalo'}</td></tr>
							<tr><td>2</td><td>Meninos das Alianças</td><td>Meninos das Alianças</td></tr>
							<tr><td>3</td><td>Padrinhos e Madrinhas</td><td>Padrinhos aos pares</td></tr>
							<tr><td>4</td><td>Pais dos Noivos</td><td>Mãe e Pai de Ambos os Noivos</td></tr>
							<tr><td>5</td><td>Avós e Família</td><td>Avós</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`;
			printWindow.document.write(html);
			printWindow.document.close();
		});

		btnCopyText.addEventListener('click', () => {
			let text = `⛪ *Cortejo da Cerimónia de ${partner1Input.value || 'Sara'} & ${partner2Input.value || 'Gonçalo'}*\n\n`;
			text += `*🚶‍♂️ Ordem de Entrada:*\n`;
			lineupData.forEach((item, idx) => {
				text += `${idx + 1}. ${item.role} (${item.names})${item.cue ? ` - _Momento: ${item.cue}_` : ''}\n`;
			});
			text += `\n*🎉 Saída dos Noivos:*\n1. Recém-Casados Primeiro!\n2. Meninos das Alianças\n3. Padrinhos e Damas\n4. Pais e Avós`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnCopyText.textContent;
				btnCopyText.textContent = '✅ Copiado para o WhatsApp!';
				setTimeout(() => { btnCopyText.textContent = orig; }, 2500);
			});
		});

		loadTradition();
	</script>
</Layout>
