---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-venue-cost-calculator/#webapp",
      "name": "Calculadora do Custo Real da Quinta e Taxas Ocultas",
      "url": "https://manage.wedding/pt/wedding-venue-cost-calculator",
      "inLanguage": "pt",
      "description": "Calcule o custo real de uma quinta ou espaço de casamento. Contemple o aluguer base, mínimos de consumo de catering, IVA, taxas de serviço, limpeza, segurança, corte de bolo e horas extra.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular o Custo Real e Total de uma Quinta de Casamento",
      "description": "Fórmula detalhada para apurar todas as despesas reais do espaço para além do valor anunciado de aluguer base.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Comece com o Aluguer Base do Espaço",
          "text": "Introduza o valor fixo de aluguer da quinta ou salão para as horas da cerimónia e copo-d'água."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Adicione as Ementas e Bar Aberto",
          "text": "Multiplique o preço por pessoa pelo número de convidados ou insira o montante mínimo de consumo exigido pelo espaço."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Aplique o IVA e Taxas de Serviço",
          "text": "Aplique a taxa de IVA aplicável (13% a 23%) e eventuais taxas de serviço ou comissão de espaço."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Some Limpeza, Horas Extra e Taxas de Rolha",
          "text": "Inclua despesas de limpeza final, segurança, seguro de responsabilidade civil, taxa de corte de bolo exterior e horas extra pós-meia-noite."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O que significa 'preço sem IVA / taxas' nos orçamentos de quintas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Muitas quintas e fornecedores apresentam propostas com valores líquidos. Em Portugal e na Europa, o IVA de restauração (13%) ou aluguer de espaço (23%) acresce ao valor final. Uma proposta de catering de 12.000 € acrescida de 13% de IVA totaliza 13.560 €."
          }
        },
        {
          "@type": "Question",
          "name": "Um espaço rústico em bruto fica mais barato do que uma quinta com tudo incluído?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem sempre. Embora o aluguer inicial aparente ser baixo (ex.: 3.500 €), os noivos precisam de contratar à parte geradores de energia, casas de banho portáteis de luxo, tendas de apoio, mobiliário e catering exterior com taxa de deslocação. Com frequência, o valor total supera o de uma quinta completa."
          }
        },
        {
          "@type": "Question",
          "name": "Que taxas ocultas costumam cobrar as quintas de casamentos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As taxas adicionais mais comuns incluem: taxa de exclusividade para fornecedores externos (1.000 € - 2.500 €), taxa de corte de bolo de confeitaria exterior (2 € - 4 €/pessoa), taxa de rolha para vinhos próprios (10 € - 20 €/garrafa), horas extra de bar após as 02:00 (200 € - 500 €/hora) e caução de limpeza."
          }
        },
        {
          "@type": "Question",
          "name": "Como negociar o contrato da quinta para poupar dinheiro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pergunte sempre se o valor inclui atoalhados, mobiliário de exterior, sistema de som para a cerimónia, suite nupcial e prova de ementa para os noivos e pais. Peça a isenção da taxa de corte de bolo e tente negociar a inclusão de uma hora extra de bar aberto."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora do Custo Real da Quinta e Taxas Ocultas | Manage.Wedding"
	description="Calcule o custo verdadeiro de uma quinta de casamentos. Contemple aluguer base, ementas, bar aberto, IVA, taxas de serviço, limpeza, segurança e horas extra."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Custo Real da Quinta & Taxas Ocultas" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Descubra entre 3.000 € e 10.000 € em Custos Ocultos</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Quinta de Casamento <span class="accent-italic">Calculadora do Custo Real</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Um orçamento inicial de 5.000 € de espaço transforma-se frequentemente em mais de 22.000 € após incluir ementas, bar aberto, IVA, taxas de serviço, limpeza e horas extra. Calcule o valor total efetivo antes de assinar o contrato!
			</p>
		</header>

		<!-- Main Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Controls & Line-Item Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Dados do Contrato da Quinta
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Simulador com IVA
					</span>
				</div>

				<!-- Venue Archetype Presets -->
				<div class="form-group">
					<label class="form-label" for="venue-preset">Tipo de Espaço / Modelo Contratual</label>
					<select id="venue-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="hotel" selected>🏰 Quinta com Catering Integrado (4.000 € Base + 14.400 € Ementas + 13% IVA)</option>
						<option value="barn">🌾 Espaço Rústico / Herdade em Bruto (5.500 € Base + Catering Externo + Gerador)</option>
						<option value="estate">🏛️ Palacete Histórico / Solar Nobre (7.500 € Base + 1.200 € Cerimónia + Catering)</option>
						<option value="winery">🍇 Quinta Vinícola / Enoturismo (5.000 € Base + Vinhos da Casa Obrigatórios + Transporte)</option>
						<option value="custom">✏️ Personalizar Todos os Valores</option>
					</select>
				</div>

				<!-- Base Rental Fee & Ceremony Fee -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="base-rental">Aluguer Base do Espaço (€)</label>
						<input type="number" id="base-rental" class="form-input" value="4000" min="0" step="250" />
					</div>
					<div>
						<label class="form-label" for="ceremony-fee">Cerimónia no Local (€)</label>
						<input type="number" id="ceremony-fee" class="form-input" value="800" min="0" step="100" />
					</div>
				</div>

				<!-- Guest Count & F&B Minimum -->
				<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="guest-count">Nº de Convidados</label>
						<input type="number" id="guest-count" class="form-input" value="120" min="10" max="600" />
					</div>
					<div>
						<label class="form-label" for="fb-spend">Total Ementas & Bar (€)</label>
						<input type="number" id="fb-spend" class="form-input" value="14400" min="0" step="500" />
					</div>
				</div>

				<!-- Plus-Plus Rates (Service Charge & Tax) -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="service-charge-rate">Taxa de Serviço / Staff (%)</label>
						<input type="number" id="service-charge-rate" class="form-input" value="5" min="0" max="30" step="1" />
					</div>
					<div>
						<label class="form-label" for="tax-rate">Taxa de IVA Média (%)</label>
						<input type="number" id="tax-rate" class="form-input" value="13" min="0" max="23" step="0.5" />
					</div>
				</div>

				<!-- Hidden Facility Surcharges -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Custos de Instalações e Pessoal (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="cleaning-fee" style="font-size: 0.9rem;">Limpeza Final / Resíduos</label>
							<input type="number" id="cleaning-fee" class="form-input" value="400" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="security-fee" style="font-size: 0.9rem;">Portaria / Vigilância</label>
							<input type="number" id="security-fee" class="form-input" value="300" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="insurance-fee" style="font-size: 0.9rem;">Seguro do Evento</label>
							<input type="number" id="insurance-fee" class="form-input" value="150" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="overtime-fee" style="font-size: 0.9rem;">Horas Extra / Prova</label>
							<input type="number" id="overtime-fee" class="form-input" value="500" min="0" step="100" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Vendor Friction Add-ons (Cake Cutting / Corkage / Infrastructure) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Taxas de Fornecedores Externos & Logística (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="cake-cutting-rate" style="font-size: 0.9rem;">Corte de Bolo Externo (€/pes.)</label>
							<input type="number" id="cake-cutting-rate" class="form-input" value="2.50" min="0" step="0.50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="infrastructure-fee" style="font-size: 0.9rem;">Gerador / WC / Tenda de Apoio</label>
							<input type="number" id="infrastructure-fee" class="form-input" value="0" min="0" step="250" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Real Total & Price Shock Breakdown -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- True Cost Summary Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Custo Real Total Efetivo
						</span>
						<span id="markup-multiplier-tag" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							5.8× Aluguer Base
						</span>
					</div>

					<div id="display-real-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.5rem;">
						23.242 €
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						O aluguer inicial anunciado era de <strong id="display-quoted-base" style="color: var(--fg-pencil);">4.000 €</strong>. Custo real por convidado: <strong id="display-per-guest" style="color: var(--fg-pencil);">194 € / pessoa</strong>.
					</p>

					<!-- Itemized Cost Breakdown Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Espaço Base + Cerimónia:</span>
							<strong id="item-base-total">4.800 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Ementas e Bar Aberto:</span>
							<strong id="item-fb-spend">14.400 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem; color: var(--accent-red);">
							<span>Taxa de Serviço / Staff:</span>
							<strong id="item-service-charge">720 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem; color: var(--accent-blue);">
							<span>IVA Total Estimado:</span>
							<strong id="item-sales-tax">1.966 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Instalações (Limpeza, Segurança, Seguro):</span>
							<strong id="item-facility-total">1.350 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.95rem;">
							<span>Corte de Bolo / Taxas Extras:</span>
							<strong id="item-addons-total">300 €</strong>
						</div>
					</div>

					<!-- Export Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-audit" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Auditoria (PDF)
						</button>
						<button id="btn-export-word" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar Documento Word
						</button>
					</div>

				</div>

				<!-- Contract Warning Callout Box -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						🚨 3 Alertas Críticos no Contrato da Quinta:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>IVA Incluído vs. Acrescido:</strong> Confirme por escrito se os valores por pessoa incluem IVA (13% restauração ou 23% aluguer), sob pena de um aumento súbito de milhares de euros.</li>
						<li><strong>Horário Limite de Música & Horas Extra:</strong> Verifique até que horas a música exterior pode tocar e quanto custa cada hora extra de bar aberto (habitualmente entre 200 € e 450 €/hora).</li>
						<li><strong>Exclusividade de Fornecedores:</strong> Algumas quintas obrigam ao uso do fotógrafo ou DJ da casa, cobrando taxas de penalização caso pretenda contratar profissionais exteriores.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumo Direto ao Assunto (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Regra Prática: Fórmula do Custo Real da Quinta & Comparativo
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Sem tempo a perder? Conheça a fórmula universal para calcular o custo total do espaço e compare os diferentes modelos de quintas.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					💰 A Fórmula do Custo Real da Quinta de Casamento:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Total Real = Aluguer Base + Cerimónia + [(Ementas + Bar) × (1 + Serviço% + IVA%)] + Limpeza + Segurança + Seguro + Corte de Bolo/Rolha + Logística Externa • Multiplicador Médio: 3,5× a 5,5× o valor de aluguer anunciado!
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Estilo de Espaço</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Aluguer Base Anunciado</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Custos Adicionais Típicos</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Custo Real Total Efetivo</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Quinta com Catering Integrado</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">3.000 € – 5.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mínimo de 100 convidados, IVA de 13%, horas extra de bar, cerimónia civil</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">18.000 € – 28.000 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Espaço Rústico / Herdade em Bruto</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">4.000 € – 7.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Catering externo, gerador de energia, WC de luxo, tenda de apoio, iluminação</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">20.000 € – 32.000 €</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Palacete Histórico / Solar Nobre</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">6.500 € – 12.000 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Taxa de conservação, segurança reforçada, catering de autor com taxa de cozinha</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">26.000 € – 48.000 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Quinta Vinícola / Enoturismo</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">4.500 € – 8.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Compra obrigatória de vinhos da propriedade, serviço de transfer, recolha de resíduos</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">22.000 € – 36.000 €</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Como Auditar o Contrato da Quinta de Casamentos e Prevenir Surpresas
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					O espaço e o catering consomem entre 45% e 50% de todo o orçamento de casamento. Domine a negociação contratual, o cálculo do IVA e as alíneas ocultas.
				</p>
			</div>

			<!-- Section 1: Decoding Plus-Plus -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. A Matemática do Preço Real por Pessoa
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Quando uma quinta comunica que a ementa custa "120 € por pessoa + taxas", o valor final a liquidar é bastante superior. É imperativo somar a taxa de IVA e eventuais custos de pessoal.
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>🧮 Exemplo Real para 100 Convidados a 120 € / pessoa + IVA:</strong><br />
					• Catering Base: 120 € × 100 = <strong>12.000 €</strong><br />
					• Taxa de Serviço / Equipa Extra: 12.000 € × 0,05 = <strong>+600 €</strong><br />
					• Subtotal antes de impostos: <strong>12.600 €</strong><br />
					• IVA de Restauração (13% sobre subtotal): 12.600 € × 0,13 = <strong>+1.638 €</strong><br />
					• <strong>Total Real Efetivo: 14.238 €</strong> (O custo real por pessoa é de <strong>142,38 €</strong> e não 120 €!).
				</div>
			</section>

			<!-- Section 2: Questions to Ask -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. 10 Perguntas Obrigatórias Antes de Assinar o Contrato
				</h3>
				<ol class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li>Os preços apresentados por pessoa e de aluguer incluem IVA à taxa legal em vigor?</li>
					<li>Qual é o número mínimo de adultos pagantes exigido para a data escolhida?</li>
					<li>Mobiliário, atoalhados, loiça e cadeiras para a cerimónia exterior estão totalmente incluídos?</li>
					<li>Quantas horas antes do evento os decoradores e floristas podem entrar para montagem?</li>
					<li>Qual é o valor por hora de prolongamento caso a festa continue para além das 02:00?</li>
					<li>Existe exclusividade com fotógrafos, DJ ou animadores, ou podemos trazer profissionais da nossa preferência?</li>
					<li>Cobram alguma taxa de rolha caso tragamos vinhos da família ou bolo de uma confeitaria exterior?</li>
					<li>É obrigatório contratar um seguro de responsabilidade civil para o evento?</li>
					<li>Existem restrições de decibéis ou horários para corte de som na zona exterior de jardim?</li>
					<li>Qual é a política de reembolso ou reagendamento do sinal em caso de motivo de força maior?</li>
				</ol>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes sobre Espaços e Quintas
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">O que significa 'preço sem IVA / taxas' nos orçamentos de quintas?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Indica que o montante anunciado exclui a taxa legal de IVA (13% para alimentação/bebidas ou 23% para prestação de serviços/aluguer de instalações), valor que terá de ser pago na fatura final.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Um espaço rústico em bruto é mais económico do que uma quinta com tudo incluído?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Quase sempre não. A necessidade de alugar geradores elétricos, casas de banho móveis de luxo, tendas impermeáveis e transporte de mobiliário costuma tornar o custo total significativamente mais elevado.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Como saber se o valor do catering inclui pessoal de serviço suficiente?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						O rácio ideal em casamentos de qualidade é de 1 empregado de mesa para cada 10 a 12 convidados no jantar sentado, e pelo menos 2 barmans dedicados para o bar aberto. Confirme se estes rácios estão previstos no contrato.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/pt/wedding-venue-cost-calculator" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('venue-preset');
		const baseRentalInput = document.getElementById('base-rental');
		const ceremonyFeeInput = document.getElementById('ceremony-fee');
		const guestCountInput = document.getElementById('guest-count');
		const fbSpendInput = document.getElementById('fb-spend');
		const serviceRateInput = document.getElementById('service-charge-rate');
		const taxRateInput = document.getElementById('tax-rate');
		const cleaningFeeInput = document.getElementById('cleaning-fee');
		const securityFeeInput = document.getElementById('security-fee');
		const insuranceFeeInput = document.getElementById('insurance-fee');
		const overtimeFeeInput = document.getElementById('overtime-fee');
		const cakeRateInput = document.getElementById('cake-cutting-rate');
		const infraFeeInput = document.getElementById('infrastructure-fee');

		const displayRealTotal = document.getElementById('display-real-total');
		const displayQuotedBase = document.getElementById('display-quoted-base');
		const displayPerGuest = document.getElementById('display-per-guest');
		const markupTag = document.getElementById('markup-multiplier-tag');

		const itemBaseTotal = document.getElementById('item-base-total');
		const itemFbSpend = document.getElementById('item-fb-spend');
		const itemServiceCharge = document.getElementById('item-service-charge');
		const itemSalesTax = document.getElementById('item-sales-tax');
		const itemFacilityTotal = document.getElementById('item-facility-total');
		const itemAddonsTotal = document.getElementById('item-addons-total');

		const btnPrint = document.getElementById('btn-print-audit');
		const btnWord = document.getElementById('btn-export-word');

		function formatCurrency(val) {
			return `${Math.round(val).toLocaleString('pt-PT')} €`;
		}

		function calculateVenueCost() {
			const base = parseFloat(baseRentalInput.value) || 0;
			const ceremony = parseFloat(ceremonyFeeInput.value) || 0;
			const guests = parseInt(guestCountInput.value, 10) || 1;
			const fb = parseFloat(fbSpendInput.value) || 0;
			const serviceRate = (parseFloat(serviceRateInput.value) || 0) / 100;
			const taxRate = (parseFloat(taxRateInput.value) || 0) / 100;
			const cleaning = parseFloat(cleaningFeeInput.value) || 0;
			const security = parseFloat(securityFeeInput.value) || 0;
			const insurance = parseFloat(insuranceFeeInput.value) || 0;
			const overtime = parseFloat(overtimeFeeInput.value) || 0;
			const cakeRate = parseFloat(cakeRateInput.value) || 0;
			const infra = parseFloat(infrastructureFeeInput.value) || 0;

			// Plus-Plus Math
			const serviceCharge = fb * serviceRate;
			const subtotalBeforeTax = fb + serviceCharge + base + ceremony + cleaning + security + insurance + overtime + infra + (cakeRate * guests);
			const salesTax = subtotalBeforeTax * taxRate;

			// Addons & Facilities
			const facilityTotal = cleaning + security + insurance + overtime;
			const cakeTotal = cakeRate * guests;
			const addonsTotal = cakeTotal + infra;

			const grandTotal = base + ceremony + fb + serviceCharge + salesTax + facilityTotal + addonsTotal;
			const perGuest = grandTotal / guests;
			const multiplier = base > 0 ? (grandTotal / base).toFixed(1) : 1;

			// Update Displays
			displayRealTotal.textContent = formatCurrency(grandTotal);
			displayQuotedBase.textContent = formatCurrency(base);
			displayPerGuest.textContent = `${Math.round(perGuest).toLocaleString('pt-PT')} € / pessoa`;
			markupTag.textContent = `${multiplier}× Aluguer Base`;

			itemBaseTotal.textContent = formatCurrency(base + ceremony);
			itemFbSpend.textContent = formatCurrency(fb);
			itemServiceCharge.textContent = formatCurrency(serviceCharge);
			itemSalesTax.textContent = formatCurrency(salesTax);
			itemFacilityTotal.textContent = formatCurrency(facilityTotal);
			itemAddonsTotal.textContent = formatCurrency(addonsTotal);
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'hotel') {
				baseRentalInput.value = 4000;
				ceremonyFeeInput.value = 800;
				guestCountInput.value = 120;
				fbSpendInput.value = 14400;
				serviceRateInput.value = 5;
				taxRateInput.value = 13;
				cleaningFeeInput.value = 400;
				securityFeeInput.value = 300;
				insuranceFeeInput.value = 150;
				overtimeFeeInput.value = 500;
				cakeRateInput.value = 2.50;
				infraFeeInput.value = 0;
			} else if (p === 'barn') {
				baseRentalInput.value = 5500;
				ceremonyFeeInput.value = 600;
				guestCountInput.value = 120;
				fbSpendInput.value = 13200;
				serviceRateInput.value = 5;
				taxRateInput.value = 13;
				cleaningFeeInput.value = 500;
				securityFeeInput.value = 350;
				insuranceFeeInput.value = 180;
				overtimeFeeInput.value = 600;
				cakeRateInput.value = 0;
				infraFeeInput.value = 2200; // WC móveis + gerador
			} else if (p === 'estate') {
				baseRentalInput.value = 7500;
				ceremonyFeeInput.value = 1200;
				guestCountInput.value = 120;
				fbSpendInput.value = 16800;
				serviceRateInput.value = 6;
				taxRateInput.value = 13;
				cleaningFeeInput.value = 600;
				securityFeeInput.value = 500;
				insuranceFeeInput.value = 220;
				overtimeFeeInput.value = 800;
				cakeRateInput.value = 3.00;
				infraFeeInput.value = 400;
			} else if (p === 'winery') {
				baseRentalInput.value = 5000;
				ceremonyFeeInput.value = 800;
				guestCountInput.value = 120;
				fbSpendInput.value = 15000;
				serviceRateInput.value = 5;
				taxRateInput.value = 13;
				cleaningFeeInput.value = 450;
				securityFeeInput.value = 350;
				insuranceFeeInput.value = 180;
				overtimeFeeInput.value = 600;
				cakeRateInput.value = 2.50;
				infraFeeInput.value = 900; // Serviço de transfer
			}
			calculateVenueCost();
		});

		// Live Listeners
		[baseRentalInput, ceremonyFeeInput, guestCountInput, fbSpendInput, serviceRateInput, taxRateInput, cleaningFeeInput, securityFeeInput, insuranceFeeInput, overtimeFeeInput, cakeRateInput, infraFeeInput].forEach(inp => {
			inp.addEventListener('input', calculateVenueCost);
		});

		// Print PDF Audit Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Auditoria de Custos da Quinta — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Auditoria de Custos e Despesas Efetivas da Quinta de Casamento</h1>
					<p>Calculado para ${guestCountInput.value} convidados | Data: ${new Date().toLocaleDateString('pt-PT')}</p>
					
					<table>
						<thead>
							<tr><th>Categoria de Despesa</th><th>Detalhes da Alínea</th><th>Montante (€)</th></tr>
						</thead>
						<tbody>
							<tr><td>Espaço Base & Cerimónia</td><td>Aluguer (${baseRentalInput.value} €) + Espaço de Cerimónia (${ceremonyFeeInput.value} €)</td><td>${itemBaseTotal.textContent}</td></tr>
							<tr><td>Ementas & Bar Aberto</td><td>Compromisso de Catering e Bebidas</td><td>${itemFbSpend.textContent}</td></tr>
							<tr><td>Taxa de Serviço / Staff</td><td>${serviceRateInput.value}% Taxa de Apoio de Sala</td><td>${itemServiceCharge.textContent}</td></tr>
							<tr><td>IVA Estimado</td><td>${taxRateInput.value}% Imposto sobre o Valor Acrescentado</td><td>${itemSalesTax.textContent}</td></tr>
							<tr><td>Instalações & Pessoal</td><td>Limpeza (${cleaningFeeInput.value} €) + Portaria (${securityFeeInput.value} €) + Seguro (${insuranceFeeInput.value} €) + Horas Extra (${overtimeFeeInput.value} €)</td><td>${itemFacilityTotal.textContent}</td></tr>
							<tr><td>Taxas & Logística</td><td>Corte de Bolo + WC Móveis / Gerador / Transfer</td><td>${itemAddonsTotal.textContent}</td></tr>
							<tr class="total-row"><td>CUSTO TOTAL EFETIVO</td><td>Despesa global real com o espaço (${markupTag.textContent})</td><td>${displayRealTotal.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnWord.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Auditoria de Custos da Quinta</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Auditoria de Custos Efetivos da Quinta</h2>
					<p>Aluguer Anunciado: ${baseRentalInput.value} € | <strong>Total Real: ${displayRealTotal.textContent}</strong> (${displayPerGuest.textContent})</p>
					<table>
						<thead><tr><th>Alínea de Despesa</th><th>Montante (€)</th></tr></thead>
						<tbody>
							<tr><td>Aluguer Base & Cerimónia</td><td>${itemBaseTotal.textContent}</td></tr>
							<tr><td>Ementas & Bar Aberto</td><td>${itemFbSpend.textContent}</td></tr>
							<tr><td>Taxa de Serviço (${serviceRateInput.value}%)</td><td>${itemServiceCharge.textContent}</td></tr>
							<tr><td>IVA (${taxRateInput.value}%)</td><td>${itemSalesTax.textContent}</td></tr>
							<tr><td>Instalações (Limpeza, Segurança, Seguro)</td><td>${itemFacilityTotal.textContent}</td></tr>
							<tr><td>Taxas Adicionais & Logística</td><td>${itemAddonsTotal.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL EFETIVO</td><td>${displayRealTotal.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'auditoria-custos-quinta-casamento.doc';
			link.click();
		});

		// Initial Calculation
		calculateVenueCost();
	</script>
</Layout>
