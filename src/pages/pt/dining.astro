---
import Layout from '../../layouts/Layout.astro';

const title = "Calculadoras de Bar Aberto, Catering & Bolo de Casamento (Gratuito e Para Imprimir) | Manage.Wedding";
const description = "Calculadoras gratuitas para casamentos: cálculo de garrafas de vinho e open bar, fatias e andares de bolo, orçamentos de catering e ementas para imprimir.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/pt/dining/#collection",
      "name": "Calculadoras de Banquete, Bar & Gastronomia de Casamento",
      "url": "https://manage.wedding/pt/dining",
      "inLanguage": "pt",
      "description": "Conjunto completo de ferramentas para casamentos: cálculo de bebidas de open bar, dimensionamento de bolos, orçamentos de catering e gerador de ementas em PDF.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Calculadora de Bebidas & Open Bar", "url": "https://manage.wedding/pt/wedding-drink-calculator" },
        { "@type": "WebApplication", "name": "Bebidas Brancas & Garrafas de Bar", "url": "https://manage.wedding/pt/liquor-wedding-calculator" },
        { "@type": "WebApplication", "name": "Preço do Bolo de Casamento", "url": "https://manage.wedding/pt/cake-pricing-calculator" },
        { "@type": "WebApplication", "name": "Andares e Fatias de Bolo de Noiva", "url": "https://manage.wedding/pt/cake-serving-calculator" },
        { "@type": "WebApplication", "name": "Criador de Ementas para Imprimir", "url": "https://manage.wedding/pt/reception-menu-maker" },
        { "@type": "WebApplication", "name": "Banquete Servido vs. Buffet", "url": "https://manage.wedding/pt/catering-cost-estimator" },
        { "@type": "WebApplication", "name": "Teor Alcoólico & Diluição de Cocktails", "url": "https://manage.wedding/pt/alcohol-dilution-calculator" },
        { "@type": "WebApplication", "name": "Orçamento de Flores & Decoração", "url": "https://manage.wedding/pt/floral-cost-estimator" }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "pt",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quantas bebidas por pessoa se deve calcular para o copo-d'água / banquete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A regra comprovada de bar de casamento é: 2 bebidas por pessoa durante o cocktail de boas-vindas (1ª hora), mais 1 bebida por pessoa por cada hora subsequente da refeição e festa. Para uma festa de 5 horas com 100 convidados adultos, preveja cerca de 600 doses/bebidas no total."
          }
        },
        {
          "@type": "Question",
          "name": "Quantas garrafas de vinho e espumante são necessárias para 100 convidados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para 100 convidados adultos num copo-d'água tradicional, preveja em média: 25 a 30 garrafas de vinho tinto, 25 a 30 garrafas de vinho branco/verde, 20 a 25 garrafas de espumante para o brinde e corte do bolo, e cerca de 150 a 200 cervejas."
          }
        },
        {
          "@type": "Question",
          "name": "Como calcular o tamanho do bolo de casamento para todos os convidados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem todos os convidados comem bolo após uma refeição farta. Recomenda-se dimensionar o bolo principal para 80% a 90% do número total de convidados, ou utilizar um bolo falso decorativo de andares complementado por bolo de corte na cozinha."
          }
        }
      ]
    }
  ]
};

const diningTools = [
  {
    title: "Calculadora de Bebidas & Open Bar",
    url: "/pt/wedding-drink-calculator",
    icon: "🍾",
    badge: "Muito Popular",
    desc: "Calcule com exatidão vinho tinto, branco, espumante, cerveja, bebidas brancas, sumos e gelo com lista de compras em PDF.",
    tags: ["Open Bar", "Lista de Compras", "PDF 1-Clique"]
  },
  {
    title: "Bebidas Brancas & Garrafas de Bar",
    url: "/pt/liquor-wedding-calculator",
    icon: "🍸",
    badge: "Garrafas 70cl vs 1.75L",
    desc: "Otimize proporções de gin, vodka, whisky, rum e licores com estimativa de custos para o bar de cocktails.",
    tags: ["Doses de Cocktails", "Poupança em Garrafas", "Bar Aberto"]
  },
  {
    title: "Criador de Ementas para Imprimir",
    url: "/pt/reception-menu-maker",
    icon: "📜",
    badge: "PDF Vetorial",
    desc: "Crie ementas elegantes nos formatos DL (10x21 cm) e 13x18 cm com tipografia clássica, molduras e ícones de restrições alimentares.",
    tags: ["Fontes Elegantes", "PDF para Gráfica", "Alergénios"]
  },
  {
    title: "Preço do Bolo de Casamento",
    url: "/pt/cake-pricing-calculator",
    icon: "🎂",
    badge: "Preço por Fatia",
    desc: "Para pasteleiros e noivos: calcule custos de ingredientes, horas de modelagem, preço por fatia e orçamentos em PDF.",
    tags: ["Custo Ingredientes", "Preço por Fatia", "Orçamento PDF"]
  },
  {
    title: "Andares e Fatias de Bolo de Noiva",
    url: "/pt/cake-serving-calculator",
    icon: "🍰",
    badge: "Guia Visual",
    desc: "Dimensões dos andares redondos ou quadrados, porções de corte e solução com bolo de corte de suporte para 50 a 300+ pessoas.",
    tags: ["Diâmetro dos Andares", "Bolo de Corte", "Guia de Fatias"]
  },
  {
    title: "Mesa de Sobremesas, Doces Finos & Candy Bar",
    url: "/pt/wedding-dessert-table-calculator",
    icon: "🧁",
    badge: "Mesa de Doces",
    desc: "Calcule doces finos por pessoa, centos de docinhos, quilos de balas para candy bar e gere placas e pedidos em PDF.",
    tags: ["Doces Finos por Pessoa", "Candy Bar kg", "Pedido Confeitaria"]
  },
  {
    title: "Banquete Servido vs. Buffet",
    url: "/pt/catering-cost-estimator",
    icon: "🍽️",
    badge: "Custo por Pessoa",
    desc: "Compare prato servido à mesa, buffet tradicional, estações temáticas e finger food com proporção de empregados de mesa.",
    tags: ["Prato vs Buffet", "Rácio de Garçons", "Custo por Cabeça"]
  },
  {
    title: "Teor Alcoólico & Diluição de Cocktails",
    url: "/pt/alcohol-dilution-calculator",
    icon: "🧪",
    badge: "Para Bartenders",
    desc: "Equilibre a percentagem de volume alcoólico (% ABV) e água de diluição para sangrias e cocktails servidos em jarro.",
    tags: ["Grau Alcoólico", "Sangrias & Ponches", "Cocktails em Lote"]
  },
  {
    title: "Orçamento de Flores & Decoração",
    url: "/pt/floral-cost-estimator",
    icon: "💐",
    badge: "Arranjos & Ramos",
    desc: "Estime os custos de flores para o bouquet da noiva, lapelas dos padrinhos, centros de mesa e arco da cerimónia.",
    tags: ["Bouquet de Noiva", "Centros de Mesa", "Arco Floral"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Centro Gastronómico & Bar</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Calculadoras de <span class="accent-italic">Banquete, Bar & Bolo</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Calcule com rigor as garrafas para o open bar, dimensione o bolo de noiva, estime os custos de catering e crie ementas personalizadas para impressão.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Categorias:</span>
      <a href="/pt/budget" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Orçamento</a>
      <a href="/pt/dining" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">🍾 Banquete & Bar (Ativo)</a>
      <a href="/pt/guests" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">👥 Convidados & Logística</a>
      <a href="/pt/stationery" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💌 Papelaria & Lembranças</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {diningTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
            Abrir Calculadora →
          </a>
        </div>
      ))}
    </div>

    <!-- Guide Section -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Guia de Bar & Banquete</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          Como Planear as Bebidas e o Banquete de Casamento
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Regras práticas de consumo de vinho, espumante e cocktails para garantir que não falta nada aos seus convidados.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. A Fórmula Padrão de Bar Aberto (Open Bar)
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          O consumo de bebidas varia ao longo do evento: na 1ª hora (cocktail de boas-vindas com canapés) cada convidado consome em média 2 bebidas. Nas horas seguintes (refeição e pista de dança), o ritmo estabiliza em 1 bebida por hora por pessoa.
        </p>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Perguntas Frequentes sobre Bar e Banquete
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Quantas bebidas por pessoa se deve calcular para o copo-d'água?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              A regra comprovada de bar de casamento é: 2 bebidas por pessoa durante o cocktail de boas-vindas (1ª hora), mais 1 bebida por pessoa por cada hora subsequente da refeição e festa. Para uma festa de 5 horas com 100 convidados adultos, preveja cerca de 600 doses/bebidas no total.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Quantas garrafas de vinho e espumante são necessárias para 100 convidados?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Para 100 convidados adultos num copo-d'água tradicional, preveja em média: 25 a 30 garrafas de vinho tinto, 25 a 30 garrafas de vinho branco/verde, 20 a 25 garrafas de espumante para o brinde e corte do bolo, e cerca de 150 a 200 cervejas.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Como calcular o tamanho do bolo de casamento para todos os convidados?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Nem todos os convidados comem bolo após uma refeição farta. Recomenda-se dimensionar o bolo principal para 80% a 90% do número total de convidados, ou utilizar um bolo falso decorativo de andares complementado por bolo de corte na cozinha.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
