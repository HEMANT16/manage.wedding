---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/who-pays-for-what-wedding/#webapp",
      "name": "Quem Paga o Quê no Casamento? Divisor de Despesas e Tradições",
      "url": "https://manage.wedding/pt/who-pays-for-what-wedding",
      "inLanguage": "pt",
      "description": "Calculadora e guia de divisão de custos de casamento. Compare a tradição clássica com o modelo moderno de divisão a 3 partes entre os noivos e os pais. Exporte o acordo financeiro em PDF e Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Dividir as Despesas de Casamento entre as Famílias e os Noivos",
      "description": "Guia de etiqueta e protocolo para repartir com clareza os custos do casamento entre o casal e os pais de ambas as partes.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Estipule o Orçamento Global",
          "text": "Defina o teto máximo de despesa do casamento com base nas cotações de quintas e catering."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Escolha o Modelo de Pagamento",
          "text": "Decida se vai optar pela tradição clássica, por uma divisão 50/50 entre os noivos ou pelo modelo moderno de divisão a 3 partes com as famílias."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Distribua as Categorias Principais",
          "text": "Atribua a responsabilidade por blocos claros: Espaço e Catering, Trajes, Jantar de Ensaio, Lua de Mel, Fotografia e Alianças."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Formalize os Prazos de Pagamento",
          "text": "Defina se as contribuições familiares serão entregues como donativo único numa conta dedicada ou pagas diretamente aos fornecedores."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quem paga tradicionalmente o quê no casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Na tradição clássica europeia, a família da noiva assume o vestido, o copo-d'água (quinta e catering), o bolo, as flores, os convites e a fotografia. A família do noivo assume o jantar de ensaio/boas-vindas, a certidão e taxas de registo civil, o bouquet da noiva, as lapelas dos padrinhos e a viagem de lua de mel."
          }
        },
        {
          "@type": "Question",
          "name": "Quem paga o jantar de ensaio ou receção de boas-vindas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pelo protocolo tradicional, é a família do noivo quem organiza e custeia o jantar de ensaio. Nos casamentos contemporâneos, muitos noivos optam por assumir esta despesa ou dividir o custo em partes iguais com os pais."
          }
        },
        {
          "@type": "Question",
          "name": "Quem paga o vestido de noiva e os arranjos de costura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tradicionalmente, a noiva e a sua família cobrem a compra do vestido de noiva, o véu, os sapatos, as provas de arranjos e os acessórios."
          }
        },
        {
          "@type": "Question",
          "name": "Como é que os casais modernos dividem os custos hoje?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Atualmente, mais de 60% dos casais financiam a maior parte do evento com as suas próprias poupanças. Quando os pais contribuem, a fórmula mais comum é a divisão em 3 partes: os noivos cobrem 40% a 50%, e cada conjunto de pais oferece uma contribuição fixa em dinheiro (cerca de 25% a 30%)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Quem Paga o Quê no Casamento? Divisor de Despesas (Tradição vs Moderno) | Manage.Wedding"
	description="Calculadora e guia de divisão de custos de casamento. Compare o protocolo tradicional com o modelo moderno a 3 partes. Exporte o acordo de despesas em Word e PDF."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Quem Paga o Quê? Divisão de Despesas" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Protocolo Tradicional vs Divisão Moderna a 3 Partes</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Quem Paga o Quê? <span class="accent-italic">Divisor de Custos de Casamento</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Compare a etiqueta tradicional clássica com os modelos contemporâneos de coparticipação familiar. Distribua as responsabilidades e exporte um resumo financeiro pronto a partilhar com os pais.
			</p>
		</header>

		<!-- Main Interactive Splitter Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Split Model Setup & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Modelo de Partilha e Orçamento
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Etiqueta & Finanças
					</span>
				</div>

				<!-- Total Budget -->
				<div class="form-group">
					<label class="form-label" for="total-wedding-budget">Orçamento Global Estimado (€)</label>
					<input type="number" id="total-wedding-budget" class="form-input" value="30000" min="5000" step="1000" style="font-size: 1.2rem; font-weight: 700;" />
				</div>

				<!-- Split Model Shortcut Selector -->
				<div class="form-group">
					<label class="form-label" for="split-model-preset">Modelo de Distribuição Protocolar</label>
					<select id="split-model-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="traditional" selected>📜 Tradição Clássica (Família da Noiva 70% / Família do Noivo 25% / Noivos 5%)</option>
						<option value="modern-3way">🤝 Divisão Moderna a 3 Partes (Noivos 40% / Pais da Noiva 30% / Pais do Noivo 30%)</option>
						<option value="couple-100">💍 Financiamento Total pelo Casal (Noivos Pagam 100% / Sem Apoio Familiar)</option>
						<option value="couple-50-50">⚖️ Casal 50/50 (Noivo(a) 1 Assume 50% / Noivo(a) 2 Assume 50%)</option>
						<option value="custom">✏️ Distribuição Percentual Personalizada</option>
					</select>
				</div>

				<!-- Visual Split Percentages Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Percentagens de Contribuição por Parte (%)
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.85rem;">
						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-red);">👰 Família da Noiva:</span>
								<span id="slider-bride-pct-val">70%</span>
							</div>
							<input type="range" id="slider-bride-pct" min="0" max="100" value="70" style="width: 100%; accent-color: var(--accent-red);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-blue);">🤵 Família do Noivo:</span>
								<span id="slider-groom-pct-val">25%</span>
							</div>
							<input type="range" id="slider-groom-pct" min="0" max="100" value="25" style="width: 100%; accent-color: var(--accent-blue);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: #16a34a;">💍 Contribuição Direta dos Noivos:</span>
								<span id="slider-couple-pct-val">5%</span>
							</div>
							<input type="range" id="slider-couple-pct" min="0" max="100" value="5" style="width: 100%; accent-color: #16a34a;" />
						</div>
					</div>
				</div>

				<!-- Quick Money Talk Guide -->
				<div style="margin-top: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
					<strong style="display: block; color: var(--fg-pencil); margin-bottom: 4px;">💬 Como Abordar o Tema Financeiro com os Pais:</strong>
					"Estamos a iniciar o planeamento do orçamento do casamento! Gostaríamos de saber se gostariam de contribuir para algum elemento específico (como o copo-d'água, o fotógrafo ou as flores) ou se preferem que planeemos tudo de forma 100% autónoma."
				</div>

			</div>

			<!-- Right Column: Results Breakdown & Itemized Checklist -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Contribution Summary Cards -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Repartição Financeira Estimada
					</h3>

					<!-- 3 Contribution Summary Bars -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem; text-align: center;">
						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-red);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Família da Noiva</span>
							<strong id="card-bride-amount" style="font-size: 1.2rem; color: var(--accent-red); display: block; margin-top: 2px;">21.000 €</strong>
							<span id="card-bride-pct" style="font-size: 0.75rem; color: #64748b;">(70%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-blue);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Família do Noivo</span>
							<strong id="card-groom-amount" style="font-size: 1.2rem; color: var(--accent-blue); display: block; margin-top: 2px;">7.500 €</strong>
							<span id="card-groom-pct" style="font-size: 0.75rem; color: #64748b;">(25%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid #16a34a;">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Os Noivos</span>
							<strong id="card-couple-amount" style="font-size: 1.2rem; color: #16a34a; display: block; margin-top: 2px;">1.500 €</strong>
							<span id="card-couple-pct" style="font-size: 0.75rem; color: #64748b;">(5%)</span>
						</div>
					</div>

					<!-- Itemized Traditional Responsibilities Table -->
					<div style="max-height: 280px; overflow-y: auto; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; margin-bottom: 1.5rem;">
						<table style="width: 100%; border-collapse: collapse; font-size: 0.86rem; text-align: left;">
							<thead>
								<tr style="background: var(--muted-paper); border-bottom: 1.5px solid var(--fg-pencil);">
									<th style="padding: 6px 8px;">Alínea / Categoria</th>
									<th style="padding: 6px 8px; text-align: right;">Responsável Tradicional</th>
								</tr>
							</thead>
							<tbody>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Espaço da Cerimónia e Quinta / Salão</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Família da Noiva</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Ementas, Bar Aberto e Bolo dos Noivos</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Família da Noiva</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Vestido de Noiva, Véu e Arranjos</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Família da Noiva</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Fotografia, Vídeo e Reportagem</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Família da Noiva</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Convites, Participações e Papelaria</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Família da Noiva</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Jantar de Ensaio / Boas-Vindas</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Família do Noivo</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Viagem de Lua de Mel e Alojamento</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Família do Noivo</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Registo Civil / Conservatória e Donativo</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Família do Noivo</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Bouquet da Noiva e Lapelas de Padrinhos</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Família do Noivo</td></tr>
								<tr><td>Alianças de Casamento e Lembranças</td><td style="text-align: right; font-weight: bold; color: #16a34a;">Os Noivos</td></tr>
							</tbody>
						</table>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-agreement" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Acordo (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar Documento Word
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumo Direto ao Assunto (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Regra Prática: Quem Paga o Quê no Casamento
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Sem tempo a perder? Conheça o resumo em 1 minuto do protocolo clássico versus a realidade financeira dos casamentos modernos.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📋 Resumo do Protocolo de Pagamentos:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Família da Noiva: [Vestido + Espaço / Catering do Copo-d'água + Fotografia + Flores + Bolo] • Família do Noivo: [Jantar de Ensaio + Lua de Mel + Registo Civil + Lapelas e Bouquet] • Padrinhos/Damas: [Vestuário Próprio + Despedida de Solteiro(a)].
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Modelo de Partilha</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Quota dos Pais da Noiva</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Quota dos Pais do Noivo</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Quota dos Noivos</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Tradição Clássica</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">65% – 75% (Espaço, Ementas, Traje)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">20% – 25% (Ensaio, Lua de Mel)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">0% – 10% (Alianças, Lembranças)</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Divisão Moderna em 3 Partes</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">30% – 35% (Donativo Fixo)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">30% – 35% (Donativo Fixo)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">30% – 40% (Saldo Restante)</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Autofinanciamento (100%)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">0 € (Convidados de Honra)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">0 € (Convidados de Honra)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">100% Independência Total</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guia de Etiqueta e Financiamento Familiar do Casamento
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Conversar sobre dinheiro com a família exige sensibilidade, limites claros e comunicação transparente.
				</p>
			</div>

			<!-- Section 1: Traditional vs Modern Evolution -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. A Evolução do Dote Histórico para as Parcerias Modernas
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					A tradição de a família da noiva suportar o peso financeiro do casamento remonta a séculos de costumes de dote e convenções sociais. Hoje em dia, com os noivos a casarem-se mais tarde e com estabilidade profissional, o panorama mudou substancialmente:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Quem Decide a Lista de Convidados:</strong> Pela etiqueta clássica, quem assume o custo da quinta e do catering tem direito a sugerir uma proporção direta de convidados. Se os pais cobrirem 50% das despesas, é comum reservarem cerca de metade dos convites para familiares e amigos próximos.</li>
					<li><strong>Donativo Único vs. Faturas Diretas:</strong> Para evitar discussões em torno de escolhas de flores ou fornecedores, sugere-se que os pais entreguem um montante fixo numa conta dedicada ao casamento, deixando a gestão das faturas inteiramente ao critério dos noivos.</li>
				</ul>
			</section>

			<!-- Section 2: Rehearsal Dinner & Groomsmen Costs -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Despesas dos Padrinhos, Damas e Despedidas de Solteiro
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Determinados eventos e trajes possuem patrocinadores bem definidos:
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>🎩 Responsabilidades em Eventos Específicos:</strong><br />
					• <strong>Jantar de Ensaio:</strong> Oferecido e suportado pela família do noivo.<br />
					• <strong>Chá de Panela / Chá de Noiva:</strong> Organizado pela Madrinha e damas de honor.<br />
					• <strong>Despedida de Solteiro(a):</strong> Os participantes dividem todas as despesas e cobrem as despesas do noivo ou noiva.<br />
					• <strong>Fatos e Vestidos de Padrinhos/Damas:</strong> Tradicionalmente, cada padrinho e dama assume o custo do seu próprio traje e calçado.
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes sobre Divisão de Custos
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Quem paga tradicionalmente o vestido de noiva?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Tradicionalmente, a noiva e a sua família custeiam o vestido de noiva, o véu, os sapatos, as provas de alfaiataria e os acessórios de cabeça.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">O que deve a família do noivo pagar?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						A família do noivo assume habitualmente o jantar de ensaio, as taxas de registo civil/conservatória, o donativo ao padre/celebrante, o ramo da noiva, as lapelas e a viagem de lua de mel.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Como financiar um segundo casamento?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Para segundas núpcias, a etiqueta estabelece que o próprio casal assume 100% das despesas, sem expectativa de financiamento por parte dos pais.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/pt/who-pays-for-what-wedding" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const totalBudgetInput = document.getElementById('total-wedding-budget');
		const presetSelect = document.getElementById('split-model-preset');

		const sliderBride = document.getElementById('slider-bride-pct');
		const sliderGroom = document.getElementById('slider-groom-pct');
		const sliderCouple = document.getElementById('slider-couple-pct');

		const bridePctVal = document.getElementById('slider-bride-pct-val');
		const groomPctVal = document.getElementById('slider-groom-pct-val');
		const couplePctVal = document.getElementById('slider-couple-pct-val');

		const cardBrideAmount = document.getElementById('card-bride-amount');
		const cardBridePct = document.getElementById('card-bride-pct');
		const cardGroomAmount = document.getElementById('card-groom-amount');
		const cardGroomPct = document.getElementById('card-groom-pct');
		const cardCoupleAmount = document.getElementById('card-couple-amount');
		const cardCouplePct = document.getElementById('card-couple-pct');

		const btnPrint = document.getElementById('btn-print-agreement');
		const btnDoc = document.getElementById('btn-export-doc');

		function formatCurrency(val) {
			return `${Math.round(val).toLocaleString('pt-PT')} €`;
		}

		function calculateSplits() {
			const total = parseFloat(totalBudgetInput.value) || 0;
			const bPct = parseInt(sliderBride.value, 10);
			const gPct = parseInt(sliderGroom.value, 10);
			const cPct = parseInt(sliderCouple.value, 10);

			bridePctVal.textContent = `${bPct}%`;
			groomPctVal.textContent = `${gPct}%`;
			couplePctVal.textContent = `${cPct}%`;

			const bAmount = (total * bPct) / 100;
			const gAmount = (total * gPct) / 100;
			const cAmount = (total * cPct) / 100;

			cardBrideAmount.textContent = formatCurrency(bAmount);
			cardBridePct.textContent = `(${bPct}%)`;
			cardGroomAmount.textContent = formatCurrency(gAmount);
			cardGroomPct.textContent = `(${gPct}%)`;
			cardCoupleAmount.textContent = formatCurrency(cAmount);
			cardCouplePct.textContent = `(${cPct}%)`;
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'traditional') {
				sliderBride.value = 70;
				sliderGroom.value = 25;
				sliderCouple.value = 5;
			} else if (p === 'modern-3way') {
				sliderBride.value = 30;
				sliderGroom.value = 30;
				sliderCouple.value = 40;
			} else if (p === 'couple-100') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			} else if (p === 'couple-50-50') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			}
			calculateSplits();
		});

		// Slider Listeners with Normalization
		sliderBride.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderBride.value, 10);
			sliderGroom.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderGroom.value;
			calculateSplits();
		});
		sliderGroom.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderGroom.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderBride.value;
			calculateSplits();
		});
		sliderCouple.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderCouple.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderGroom.value = rem - sliderBride.value;
			calculateSplits();
		});

		totalBudgetInput.addEventListener('input', calculateSplits);

		// Print Agreement Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Acordo de Divisão de Custos de Casamento — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Acordo Financeiro de Repartição de Custos de Casamento</h1>
					<p>Orçamento Total Estimado: ${parseFloat(totalBudgetInput.value).toLocaleString('pt-PT')} € | Modelo: ${presetSelect.options[presetSelect.selectedIndex].text}</p>
					
					<table>
						<thead><tr><th>Parte Contribuinte</th><th>Quota Acordada</th><th>Montante Alocado (€)</th><th>Principais Responsabilidades</th></tr></thead>
						<tbody>
							<tr><td><strong>Família da Noiva</strong></td><td>${sliderBride.value}%</td><td><strong>${cardBrideAmount.textContent}</strong></td><td>Quinta e Espaço da Cerimónia, Ementas, Vestido, Flores, Fotografia</td></tr>
							<tr><td><strong>Família do Noivo</strong></td><td>${sliderGroom.value}%</td><td><strong>${cardGroomAmount.textContent}</strong></td><td>Jantar de Ensaio, Lua de Mel, Donativo/Conservatória, Lapelas e Bouquet</td></tr>
							<tr><td><strong>Os Noivos</strong></td><td>${sliderCouple.value}%</td><td><strong>${cardCoupleAmount.textContent}</strong></td><td>Alianças de Casamento, Lembranças, Saldos Finais de Fornecedores</td></tr>
							<tr class="total-row"><td>ORÇAMENTO GLOBAL</td><td>100%</td><td>${parseFloat(totalBudgetInput.value).toLocaleString('pt-PT')} €</td><td>Plano Financeiro Completo</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Acordo de Divisão de Custos</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Acordo de Divisão de Despesas de Casamento</h2>
					<p>Orçamento Total: ${parseFloat(totalBudgetInput.value).toLocaleString('pt-PT')} €</p>
					<table>
						<thead><tr><th>Parte Contribuinte</th><th>Quota (%)</th><th>Montante (€)</th></tr></thead>
						<tbody>
							<tr><td>Família da Noiva</td><td>${sliderBride.value}%</td><td>${cardBrideAmount.textContent}</td></tr>
							<tr><td>Família do Noivo</td><td>${sliderGroom.value}%</td><td>${cardGroomAmount.textContent}</td></tr>
							<tr><td>Os Noivos</td><td>${sliderCouple.value}%</td><td>${cardCoupleAmount.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL</td><td>100%</td><td>${parseFloat(totalBudgetInput.value).toLocaleString('pt-PT')} €</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'acordo-divisao-despesas-casamento.doc';
			link.click();
		});

		// Initial Calculation
		calculateSplits();
	</script>
</Layout>
