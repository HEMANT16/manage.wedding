---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Calculadora de Gratificações para Fornecedores de Casamento",
      "url": "https://manage.wedding/pt/vendor-tipping-calculator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de gratificações e envelopes de gorjetas para casamentos. Calcule valores exatos para catering, DJ, fotógrafos, wedding planners, maquilhagem, motoristas e equipas de montagem. Exporte para Word, PDF ou Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular e Distribuir Gratificações a Fornecedores de Casamento",
      "description": "Guia prático para calcular gorjetas e gratificações, identificar taxas de serviço em contrato e preparar envelopes de dinheiro.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Verifique as Cláusulas de Serviço no Contrato",
          "text": "Consulte o contrato do catering ou espaço para verificar se já inclui gratificação de serviço obrigatória para o staff de sala."
        },
        {
          "@type": "HowToStep",
          "name": "Calcule Gratificações Percentuais de Beleza e Serviço",
          "text": "Aplique 15% a 20% sobre o serviço de maquilhagem/cabelo e catering se a gorjeta não estiver contemplada em contrato."
        },
        {
          "@type": "HowToStep",
          "name": "Defina Gratificações Fixas para Profissionais Dedicados",
          "text": "Atribua valores de referência: 50 € a 150 € para fotógrafo/videógrafo, 50 € a 100 € para DJ/músicos e 50 € a 100 € para o celebrante/donativo."
        },
        {
          "@type": "HowToStep",
          "name": "Prepare e Delegue os Envelopes de Dinheiro",
          "text": "Identifique os envelopes com antecedência e entregue-os ao Padrinho de casamento ou Coordenador para distribuição no final da festa."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "É obrigatório dar gratificação a fornecedores que são donos da sua própria empresa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A etiqueta clássica estipula que os proprietários fixam os seus próprios preços e não esperam gratificação. No entanto, se um profissional independente (como um fotógrafo ou wedding planner) prestar um serviço excecional, uma gratificação de 50 € a 150 € ou um presente com uma avaliação de 5 estrelas é sempre uma demonstração de grande apreço."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é a diferença entre taxa de serviço do catering e gratificação?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A taxa de serviço (muitas vezes incluída na ementa) cobre os custos administrativos e operacionais da quinta/empresa de catering. Raramente é distribuída na totalidade aos empregados de mesa e barmans. Pergunte à empresa se o valor reverte para o pessoal de serviço; caso contrário, é costume gratificar os empregados de mesa com 20 € a 40 € por pessoa em dinheiro."
          }
        },
        {
          "@type": "Question",
          "name": "Quem deve ser responsável por entregar os envelopes de dinheiro no dia do casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os noivos nunca devem andar com dinheiro durante o dia do casamento. Prepare os envelopes identificados dias antes e delegue a entrega ao Padrinho principal ou à Wedding Planner. A maioria das gratificações é entregue no final do turno de cada fornecedor ou no fecho do copo-d'água."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto se deve dar de gratificação à maquilhadora e cabeleireira?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A gratificação padrão para maquilhagem e penteado de noiva varia entre 15% e 20% do valor total do serviço, especialmente quando a equipa se desloca ao domicílio ou quarto de hotel da noiva."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Gratificações para Fornecedores de Casamento (Guia & Envelopes) | Manage.Wedding"
	description="Calcule gratificações exatas para fotógrafos, DJ, catering, maquilhagem e wedding planners. Guia completo com exportação de envelopes de dinheiro em Word, PDF e Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de Gratificações para Fornecedores
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calcule gratificações justas com base nas normas de etiqueta atuais. Discrimine os valores por mais de 10 categorias e exporte <strong>Envelopes de Dinheiro</strong> em <strong>Word (.doc)</strong> ou <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Usar Esta Calculadora em 3 Passos Simples
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Introduza os Valores dos Contratos
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Insira as despesas estimadas por fornecedor e desmarque qualquer serviço que não tenha contratado ou cuja gorjeta já esteja no contrato.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Reveja as Gorjetas Sugeridas
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						A calculadora aplica automaticamente percentagens padrão (15-20%) ou valores fixos de referência (50 € a 150 €) para cada profissional.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporte os Envelopes e Guia de Entrega
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clique em <strong>"📝 Exportar Word (.doc)"</strong> ou <strong>"🖨️ Exportar PDF"</strong> para imprimir a lista com os horários ideais de entrega para o Padrinho ou Coordenador!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="tipping-calc-grid">
			
			<!-- Left Column: 10+ Vendor Categories Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							💵 Fornecedores & Contratos
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Configure os serviços contratados e valores de fatura
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Moeda:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="R$">R$ (BRL)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
							<option value="CHF">CHF</option>
						</select>
					</div>
				</div>

				<form id="tipping-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Catering & Bartenders -->
					<div class="vendor-input-group">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
							<label class="font-heading" style="font-size: 1rem; color: var(--accent-red);">
								🍽️ Catering & Empregados de Sala / Bar
							</label>
							<label style="font-size: 0.78rem; display: flex; align-items: center; gap: 0.3rem; cursor: pointer; color: var(--text-secondary);">
								<input type="checkbox" id="chk-caterer-included"> Gratificação incluída no contrato
							</label>
						</div>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Fatura Total de Catering / Ementas</span>
								<input type="number" id="input-caterer-bill" value="6500" min="0" step="100" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Modo de Gratificação</span>
								<select id="select-caterer-rate" class="tip-select">
									<option value="flat" selected>Valor Fixo de 30 € / Empregado (300 €)</option>
									<option value="0.05">5% da Fatura (325 €)</option>
									<option value="0.10">10% da Fatura (650 €)</option>
									<option value="0.15">15% da Fatura (975 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 2. Hair & Makeup (HMUA) -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: var(--accent-blue); display: block; margin-bottom: 0.3rem;">
							💄 Cabeleireiro & Maquilhagem (HMUA)
						</label>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Fatura Total de Beleza / Noiva</span>
								<input type="number" id="input-beauty-bill" value="450" min="0" step="25" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Percentagem de Gratificação</span>
								<select id="select-beauty-rate" class="tip-select">
									<option value="0.15" selected>15% (Padrão Recomendado)</option>
									<option value="0.20">20% (Serviço Excecional no Local)</option>
									<option value="0.10">10% (Valor Simbólico)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 3. Photography & Videography -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #16a34a; display: block; margin-bottom: 0.3rem;">
							📸 Fotógrafo Principal, 2º Fotógrafo & Vídeo
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Fotógrafo Principal</span>
								<select id="select-photo-lead" class="tip-select">
									<option value="100" selected>Fotógrafo Principal (100 € fixo)</option>
									<option value="150">Fotógrafo Principal (150 € fixo)</option>
									<option value="50">Fotógrafo Principal (50 € fixo)</option>
									<option value="0">Sem Gorjeta / Proprietário (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">2º Fotógrafo / Videógrafo</span>
								<select id="select-photo-second" class="tip-select">
									<option value="60" selected>2º Fotógrafo / Assistente (60 €)</option>
									<option value="80">2º Fotógrafo / Assistente (80 €)</option>
									<option value="40">2º Fotógrafo / Assistente (40 €)</option>
									<option value="0">Sem 2º Fotógrafo (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 4. DJ & Entertainment -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #7c3aed; display: block; margin-bottom: 0.3rem;">
							🎵 DJ de Casamento & Músicos de Cerimónia
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">DJ Principal / Animador</span>
								<select id="select-dj-tip" class="tip-select">
									<option value="75" selected>DJ Principal (75 € fixo)</option>
									<option value="100">DJ Principal (100 € fixo)</option>
									<option value="50">DJ Principal (50 € fixo)</option>
									<option value="0">Sem Gorjeta / Incluído (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Músicos de Cerimónia ao Vivo</span>
								<select id="select-band-tip" class="tip-select">
									<option value="40" selected>Músicos ao Vivo (40 € por elemento)</option>
									<option value="25">Músicos ao Vivo (25 € por elemento)</option>
									<option value="0">Sem Músicos ao Vivo (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 5. Wedding Planner & Coordinator -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #d97706; display: block; margin-bottom: 0.3rem;">
							📋 Wedding Planner / Coordenador do Dia
						</label>
						<div>
							<select id="select-planner-tip" class="tip-select">
								<option value="100" selected>Coordenador do Dia (100 € fixo)</option>
								<option value="150">Wedding Planner Completo (150 € fixo)</option>
								<option value="75">Coordenador do Dia (75 € fixo)</option>
								<option value="0">Sem Gorjeta / Proprietário (0 €)</option>
							</select>
						</div>
					</div>

					<!-- 6. Drivers, Officiant & Delivery Setup Crew -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block; text-align: center;">
							🚐 Logística, Celebrante & Equipas de Entrega
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Motorista de Carro / Transfer</span>
								<select id="select-driver-tip" class="tip-select">
									<option value="40" selected>Motorista dos Noivos (40 € fixo)</option>
									<option value="60">Vários Motoristas (60 € total)</option>
									<option value="0">Incluído no Aluguer (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Celebrante / Donativo Paroquial</span>
								<select id="select-officiant-tip" class="tip-select">
									<option value="60" selected>Donativo / Gratificação (60 €)</option>
									<option value="80">Donativo Paroquial (80 €)</option>
									<option value="40">Donativo Simbólico (40 €)</option>
									<option value="0">Taxa Oficial Coberta (0 €)</option>
								</select>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Equipa de Montagem Floral / Tendas</span>
								<select id="select-delivery-tip" class="tip-select">
									<option value="30" selected>Equipa de Montagem (30 € total)</option>
									<option value="50">Montagem Pesada / Noturna (50 €)</option>
									<option value="20">Montagem Simples (20 €)</option>
									<option value="0">Sem Gorjeta (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Entrega do Bolo dos Noivos</span>
								<select id="select-cake-tip" class="tip-select">
									<option value="15" selected>Entrega de Bolo (15 € fixo)</option>
									<option value="25">Bolo de Vários Andares (25 €)</option>
									<option value="0">Sem Gorjeta (0 €)</option>
								</select>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Gratuity Breakdown & Cash Envelope Planner -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Gratuity Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								✉️ Orçamento de Gratificações
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Dinheiro em numerário necessário para os envelopes
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Gratuity Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Total em Numerário a Preparar</span>
						<strong id="res-total-gratuity" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">827 €</strong>
						<span id="res-envelope-count" style="font-size: 0.8rem; color: var(--accent-red);">Distribuído por 8 Envelopes Identificados</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Resumo dos Envelopes por Categoria
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Catering & Empregados de Sala:</td>
									<td id="res-caterer-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">300 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">💄 Maquilhagem & Cabeleireiro:</td>
									<td id="res-beauty-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">67 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📸 Fotografia & Vídeo:</td>
									<td id="res-photo-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">160 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🎵 DJ & Músicos de Cerimónia:</td>
									<td id="res-dj-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">115 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📋 Coordenador / Wedding Planner:</td>
									<td id="res-planner-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">100 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🚐 Motoristas & Celebrante:</td>
									<td id="res-logistics-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">100 €</td>
