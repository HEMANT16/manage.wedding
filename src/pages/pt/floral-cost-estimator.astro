<script is:inline>
	let currencySymbol = '€';

	const tierSelect = document.getElementById('select-floral-tier');
	const currencySelect = document.getElementById('currency-select');
	const deliveryCurrSym = document.getElementById('delivery-curr-sym');

	// Inputs
	const bridalInput = document.getElementById('qty-bridal-bouquet');
	const bridesmaidInput = document.getElementById('qty-bridesmaid-bouquets');
	const boutonniereInput = document.getElementById('qty-boutonnieres');
	const corsageInput = document.getElementById('qty-corsages');

	const archSelect = document.getElementById('select-arch');
	const aisleInput = document.getElementById('qty-aisle-posies');
	const welcomeInput = document.getElementById('qty-welcome-sign');

	const lowCenterpieceInput = document.getElementById('qty-low-centerpieces');
	const tallCenterpieceInput = document.getElementById('qty-tall-centerpieces');
	const sweetheartInput = document.getElementById('qty-sweetheart-garland');
	const cakeInput = document.getElementById('qty-cake-flowers');

	const laborPctInput = document.getElementById('input-labor-pct');
	const deliveryFeeInput = document.getElementById('input-delivery-fee');

	// Result Displays
	const resGrandTotal = document.getElementById('res-grand-total');
	const resTierSummary = document.getElementById('res-tier-summary');
	const resPersonalSubtotal = document.getElementById('res-personal-subtotal');
	const resCeremonySubtotal = document.getElementById('res-ceremony-subtotal');
	const resReceptionSubtotal = document.getElementById('res-reception-subtotal');
	const resStemsSubtotal = document.getElementById('res-stems-subtotal');
	const resLaborAmount = document.getElementById('res-labor-amount');
	const resDeliveryAmount = document.getElementById('res-delivery-amount');

	const barPersonal = document.getElementById('bar-personal');
	const barCeremony = document.getElementById('bar-ceremony');
	const barReception = document.getElementById('bar-reception');
	const barLabor = document.getElementById('bar-labor');

	function formatMoney(amount) {
		const formatted = Math.round(amount).toLocaleString('pt-PT');
		if (currencySymbol === '€' || currencySymbol === 'CHF') {
			return `${formatted} ${currencySymbol}`;
		}
		return `${currencySymbol}${formatted}`;
	}

	function calculateFlorals() {
		currencySymbol = currencySelect.value;
		deliveryCurrSym.textContent = currencySymbol;

		const tierMult = parseFloat(tierSelect.value) || 1.0;
		const laborPct = (parseFloat(laborPctInput.value) || 0) / 100;
		const deliveryFee = parseFloat(deliveryFeeInput.value) || 0;

		// 1. Personal
		const bridalCost = (parseInt(bridalInput.value) || 0) * 150 * tierMult;
		const bridesmaidCost = (parseInt(bridesmaidInput.value) || 0) * 75 * tierMult;
		const boutonniereCost = (parseInt(boutonniereInput.value) || 0) * 18 * tierMult;
		const corsageCost = (parseInt(corsageInput.value) || 0) * 28 * tierMult;
		const personalSubtotal = bridalCost + bridesmaidCost + boutonniereCost + corsageCost;

		// 2. Ceremony
		const archCost = (parseFloat(archSelect.value) || 0) * tierMult;
		const aisleCost = (parseInt(aisleInput.value) || 0) * 45 * tierMult;
		const welcomeCost = (parseInt(welcomeInput.value) || 0) * 55 * tierMult;
		const ceremonySubtotal = archCost + aisleCost + welcomeCost;

		// 3. Reception
		const lowCenterCost = (parseInt(lowCenterpieceInput.value) || 0) * 85 * tierMult;
		const tallCenterCost = (parseInt(tallCenterpieceInput.value) || 0) * 190 * tierMult;
		const sweetheartCost = (parseInt(sweetheartInput.value) || 0) * 160 * tierMult;
		const cakeCost = (parseInt(cakeInput.value) || 0) * 35 * tierMult;
		const receptionSubtotal = lowCenterCost + tallCenterCost + sweetheartCost + cakeCost;

		// Stems subtotal
		const stemsSubtotal = personalSubtotal + ceremonySubtotal + receptionSubtotal;
		const laborCost = stemsSubtotal * laborPct;
		const grandTotal = stemsSubtotal + laborCost + deliveryFee;

		// Update UI
		resGrandTotal.textContent = formatMoney(grandTotal);
		resTierSummary.textContent = `${tierSelect.options[tierSelect.selectedIndex].text.split('(')[0]}`;

		resPersonalSubtotal.textContent = formatMoney(personalSubtotal);
		resCeremonySubtotal.textContent = formatMoney(ceremonySubtotal);
		resReceptionSubtotal.textContent = formatMoney(receptionSubtotal);
		resStemsSubtotal.textContent = formatMoney(stemsSubtotal);
		resLaborAmount.textContent = formatMoney(laborCost);
		resDeliveryAmount.textContent = formatMoney(deliveryFee);

		// Proportions
		if (grandTotal > 0) {
			barPersonal.style.width = `${(personalSubtotal / grandTotal) * 100}%`;
			barCeremony.style.width = `${(ceremonySubtotal / grandTotal) * 100}%`;
			barReception.style.width = `${(receptionSubtotal / grandTotal) * 100}%`;
			barLabor.style.width = `${((laborCost + deliveryFee) / grandTotal) * 100}%`;
		}
	}

	// Listeners
	document.querySelectorAll('.floral-input, #input-labor-pct, #input-delivery-fee').forEach(el => {
		el.addEventListener('input', calculateFlorals);
	});
	[tierSelect, archSelect, currencySelect].forEach(el => {
		el.addEventListener('change', calculateFlorals);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const tierName = tierSelect.options[tierSelect.selectedIndex].text;
		const tierMult = parseFloat(tierSelect.value) || 1.0;

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Estimativa de Flores para Casamento</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Estimativa Oficial de Decoração Floral</h1>
				<p>Gerado a ${new Date().toLocaleDateString('pt-PT')} | Estilo Floral: <strong>${tierName}</strong> | Total Estimado: <strong>${resGrandTotal.textContent}</strong></p>
				
				<h3>Quantidades e Elementos Florais:</h3>
				<table>
					<thead>
						<tr><th>Elemento Floral</th><th style="text-align:center;">Quantidade</th><th style="text-align:right;">Subtotal</th></tr>
					</thead>
					<tbody>
						<tr><td>Bouquet da Noiva</td><td style="text-align:center;">${bridalInput.value}</td><td style="text-align:right;">${formatMoney(bridalInput.value * 150 * tierMult)}</td></tr>
						<tr><td>Bouquets das Damas de Honor</td><td style="text-align:center;">${bridesmaidInput.value}</td><td style="text-align:right;">${formatMoney(bridesmaidInput.value * 75 * tierMult)}</td></tr>
						<tr><td>Lapelas / Boutonnieres</td><td style="text-align:center;">${boutonniereInput.value}</td><td style="text-align:right;">${formatMoney(boutonniereInput.value * 18 * tierMult)}</td></tr>
						<tr><td>Corsages (Mães / Madrinhas)</td><td style="text-align:center;">${corsageInput.value}</td><td style="text-align:right;">${formatMoney(corsageInput.value * 28 * tierMult)}</td></tr>
						<tr><td>Arco / Pérgula de Cerimónia</td><td style="text-align:center;">1</td><td style="text-align:right;">${formatMoney(archSelect.value * tierMult)}</td></tr>
						<tr><td>Jardins de Passadeira / Bancos</td><td style="text-align:center;">${aisleInput.value}</td><td style="text-align:right;">${formatMoney(aisleInput.value * 45 * tierMult)}</td></tr>
						<tr><td>Arranjo do Cavalete de Boas-Vindas</td><td style="text-align:center;">${welcomeInput.value}</td><td style="text-align:right;">${formatMoney(welcomeInput.value * 55 * tierMult)}</td></tr>
						<tr><td>Centros de Mesa Baixos</td><td style="text-align:center;">${lowCenterpieceInput.value}</td><td style="text-align:right;">${formatMoney(lowCenterpieceInput.value * 85 * tierMult)}</td></tr>
						<tr><td>Centros de Mesa Altos em Estrutura</td><td style="text-align:center;">${tallCenterpieceInput.value}</td><td style="text-align:right;">${formatMoney(tallCenterpieceInput.value * 190 * tierMult)}</td></tr>
						<tr><td>Grinalda da Mesa dos Noivos</td><td style="text-align:center;">${sweetheartInput.value}</td><td style="text-align:right;">${formatMoney(sweetheartInput.value * 160 * tierMult)}</td></tr>
						<tr><td>Flores para o Bolo</td><td style="text-align:center;">${cakeInput.value}</td><td style="text-align:right;">${formatMoney(cakeInput.value * 35 * tierMult)}</td></tr>
						<tr style="background:#f9f9f9; font-weight:bold;"><td>Subtotal Flores Brutas</td><td style="text-align:center;">-</td><td style="text-align:right;">${resStemsSubtotal.textContent}</td></tr>
						<tr><td>Mão de Obra e Montagem no Local (${laborPctInput.value}%)</td><td style="text-align:center;">-</td><td style="text-align:right;">${resLaborAmount.textContent}</td></tr>
						<tr><td>Transporte Frigorífico</td><td style="text-align:center;">-</td><td style="text-align:right;">${resDeliveryAmount.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;"><td>Total Previsto da Cotação Floral</td><td style="text-align:center;">-</td><td style="text-align:right; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Estimativa_Floral_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('pt-PT');
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tierMult = parseFloat(tierSelect.value) || 1.0;
		const tbody = document.getElementById('print-floral-body');

		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Bouquet da Noiva</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${bridalInput.value}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(bridalInput.value * 150 * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Bouquets Damas de Honor</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${bridesmaidInput.value}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(bridesmaidInput.value * 75 * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Lapelas & Corsages</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(boutonniereInput.value) + parseInt(corsageInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((boutonniereInput.value * 18 + corsageInput.value * 28) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Arco / Pérgula de Cerimónia</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">1</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(archSelect.value * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Passadeira & Boas-Vindas</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(aisleInput.value) + parseInt(welcomeInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((aisleInput.value * 45 + welcomeInput.value * 55) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Centros de Mesa (Baixos e Altos)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(lowCenterpieceInput.value) + parseInt(tallCenterpieceInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((lowCenterpieceInput.value * 85 + tallCenterpieceInput.value * 190) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Mesa dos Noivos & Flores de Bolo</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(sweetheartInput.value) + parseInt(cakeInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((sweetheartInput.value * 160 + cakeInput.value * 35) * tierMult)}</td></tr>
			<tr style="background:#fafafa;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Subtotal Flores Brutas</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resStemsSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Mão de Obra e Montagem (${laborPctInput.value}%)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resLaborAmount.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Transporte e Carrinha Frigorífica</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDeliveryAmount.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:14px;">Cotação Total Estimada</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:14px;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const tierMult = parseFloat(tierSelect.value) || 1.0;
		let csv = "Elemento Floral,Quantidade,Subtotal\n";
		csv += `"Bouquet da Noiva",${bridalInput.value},"${formatMoney(bridalInput.value * 150 * tierMult)}"\n`;
		csv += `"Bouquets Damas de Honor",${bridesmaidInput.value},"${formatMoney(bridesmaidInput.value * 75 * tierMult)}"\n`;
		csv += `"Lapelas",${boutonniereInput.value},"${formatMoney(boutonniereInput.value * 18 * tierMult)}"\n`;
		csv += `"Corsages",${corsageInput.value},"${formatMoney(corsageInput.value * 28 * tierMult)}"\n`;
		csv += `"Arco de Cerimonia",1,"${formatMoney(archSelect.value * tierMult)}"\n`;
		csv += `"Jardins de Passadeira",${aisleInput.value},"${formatMoney(aisleInput.value * 45 * tierMult)}"\n`;
		csv += `"Arranjo Boas-Vindas",${welcomeInput.value},"${formatMoney(welcomeInput.value * 55 * tierMult)}"\n`;
		csv += `"Centros Baixos",${lowCenterpieceInput.value},"${formatMoney(lowCenterpieceInput.value * 85 * tierMult)}"\n`;
		csv += `"Centros Altos",${tallCenterpieceInput.value},"${formatMoney(tallCenterpieceInput.value * 190 * tierMult)}"\n`;
		csv += `"Mesa dos Noivos",${sweetheartInput.value},"${formatMoney(sweetheartInput.value * 160 * tierMult)}"\n`;
		csv += `"Flores de Bolo",${cakeInput.value},"${formatMoney(cakeInput.value * 35 * tierMult)}"\n`;
		csv += `"Subtotal Flores Brutas",-,"${resStemsSubtotal.textContent}"\n`;
		csv += `"Mao de Obra e Montagem",-,"${resLaborAmount.textContent}"\n`;
		csv += `"Transporte",-,"${resDeliveryAmount.textContent}"\n`;
		csv += `"Cotacao Total Estimada",-,"${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Estimativa_Floral_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateFlorals();
</script>
