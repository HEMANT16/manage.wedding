---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Estimador de Custos de Flores de Casamento & Orçamento Floral",
      "url": "https://manage.wedding/pt/floral-cost-estimator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de custos florais para casamentos. Calcule preços exatos para bouquets de noiva, damas de honor, lapelas, centros de mesa, arcos de cerimónia e taxas de montagem. Exporte para Word, PDF ou Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular e Planear o Orçamento Floral do Casamento",
      "description": "Guia passo a passo para calcular flores pessoais, arranjos de cerimónia, centros de mesa do copo-d'água e taxas de mão de obra floral.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Contabilize as Flores Pessoais do Cortejo",
          "text": "Defina o bouquet da noiva, bouquets das damas de honor, lapelas para noivo/padrinhos e corsages para as mães e avós."
        },
        {
          "@type": "HowToStep",
          "name": "Estime as Estruturas Florais da Cerimónia",
          "text": "Escolha entre pilares florais minimalistas, aplique floral em semicírculo ou um arco floral completo e exuberante."
        },
        {
          "@type": "HowToStep",
          "name": "Calcule os Centros de Mesa da Receção",
          "text": "Multiplique o número de mesas de convidados pelo preço de centros baixos (70 € a 150 €) ou arranjos altos em estrutura (180 € a 350 €)."
        },
        {
          "@type": "HowToStep",
          "name": "Acrescente 20% a 25% de Mão de Obra e Transporte",
          "text": "Contemple a hidratação das hastes, montagem no local, transporte em carrinha refrigerada e desmontagem noturna."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanto custa em média a decoração floral de um casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Em média, os noivos investem entre 2.000 € e 5.000 € em flores para o casamento, o que representa cerca de 8% a 12% do orçamento global do evento. Os valores variam consoante a raridade botânica das flores (ex.: peónias vs. cravos), a volumetria e a dimensão do arco da cerimónia."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto custa um bouquet de noiva profissional?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Um bouquet de noiva profissional standard com flores da época custa habitualmente entre 120 € e 200 €. Designs exclusivos de alta botânica com rosas inglesas David Austin, peónias fora de época, orquídeas e folhagens nobres situam-se entre 220 € e 350 €."
          }
        },
        {
          "@type": "Question",
          "name": "Por que razão os floristas cobram 20% a 25% de taxa de mão de obra e montagem?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A arte floral em casamentos exige trabalho técnico e físico intenso vários dias antes da boda. O florista limpa hastes, retira espinhos, hidrata as flores em câmaras frigoríficas, estrutura os arranjos e desloca uma equipa com 3 a 4 horas de antecedência à quinta para montar os arcos sob condições climatéricas reais."
          }
        },
        {
          "@type": "Question",
          "name": "Como exportar a minha estimativa para apresentar a fornecedores florais?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clique no botão 'Exportar Word (.doc)', 'Exportar PDF / Imprimir' ou 'CSV' no topo do simulador. O sistema gera uma folha técnica de quantidades e referências pronta a partilhar com os floristas para pedido de orçamento formal."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Estimador de Custos de Flores de Casamento (Orçamento Floral & Word) | Manage.Wedding"
	description="Calcule custos exatos de flores de casamento: bouquets de noiva, centros de mesa, arcos de cerimónia e taxas de montagem com exportação para Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Estimador de Custos de Flores de Casamento
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Planeie o orçamento floral com rigor por cada arranjo. Estime bouquets, arcos de cerimónia, centros de mesa e mão de obra, e exporte a sua <strong>Proposta Floral</strong> para <strong>Word (.doc)</strong> ou <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="floral-calc-grid">
			
			<!-- Left Column: Itemized Floral Quantities -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							🌸 Selecione as Quantidades Florais
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Flores pessoais, decoração da cerimónia e mesas da receção
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Moeda:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="R$">R$ (BRL)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
							<option value="CHF">CHF</option>
						</select>
					</div>
				</div>

				<form id="floral-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- Floral Density & Bloom Quality Tier -->
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<label for="select-floral-tier" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem; text-align: center;">
							✨ Estilo & Categoria das Flores
						</label>
						<select id="select-floral-tier" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="1.0">Standard / Flores da Época (Rosas clássicas, cravos, eucalipto, gipsófila) (1.0x)</option>
							<option value="1.5" selected>Romântico Clássico (Rosas de jardim, ranúnculos, hortênsias, lisianto) (1.5x)</option>
							<option value="2.2">Grande Luxo / Alta Botânica (Peónias importadas, orquídeas, anémonas) (2.2x)</option>
						</select>
					</div>

					<!-- Category 1: Personal Wedding Party Flowers -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							👰 1. Flores Pessoais & Cortejo
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="qty-bridal-bouquet" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Bouquet da Noiva (150 € un)</label>
								<input type="number" id="qty-bridal-bouquet" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-bridesmaid-bouquets" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Bouquets Damas de Honor (75 € un)</label>
								<input type="number" id="qty-bridesmaid-bouquets" value="4" min="0" max="20" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-boutonnieres" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Lapelas / Boutonnieres (18 € un)</label>
								<input type="number" id="qty-boutonnieres" value="6" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-corsages" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Corsages Mães / Madrinhas (28 € un)</label>
								<input type="number" id="qty-corsages" value="4" min="0" max="20" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Category 2: Ceremony Florals -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-blue); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							⛪ 2. Cerimónia & Instalações
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="select-arch" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Arco / Pérgula de Cerimónia</label>
								<select id="select-arch" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="0">Nenhum / Minimalista (0 €)</option>
									<option value="350" selected>Aplique Floral de Canto (350 €)</option>
									<option value="750">Arco Floral Completo (750 €)</option>
									<option value="1200">Pérgula de Grande Luxo & Pilares (1.200 €)</option>
								</select>
							</div>
							<div>
								<label for="qty-aisle-posies" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Jardins de Passadeira / Bancos (45 € un)</label>
								<input type="number" id="qty-aisle-posies" value="6" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div style="grid-column: span 2;">
								<label for="qty-welcome-sign" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Arranjo do Cavalete de Boas-Vindas (55 € un)</label>
								<input type="number" id="qty-welcome-sign" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Category 3: Reception Table Florals -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: #16a34a; margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							🍽️ 3. Centros de Mesa do Copo-d'Água
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="qty-low-centerpieces" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Centros de Mesa Baixos (85 € un)</label>
								<input type="number" id="qty-low-centerpieces" value="8" min="0" max="40" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-tall-centerpieces" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Centros Altos em Estrutura (190 € un)</label>
								<input type="number" id="qty-tall-centerpieces" value="2" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-sweetheart-garland" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Grinalda da Mesa dos Noivos (160 € un)</label>
								<input type="number" id="qty-sweetheart-garland" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-cake-flowers" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Flores para o Bolo dos Noivos (35 € un)</label>
								<input type="number" id="qty-cake-flowers" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Delivery & Labor Settings -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-labor-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Mão de Obra & Montagem no Local
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-labor-pct" value="20" min="0" max="35" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>

						<div>
							<label for="input-delivery-fee" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Taxa de Transporte Frigorífico
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<span id="delivery-curr-sym" style="font-weight: bold;">€</span>
								<input type="number" id="input-delivery-fee" value="100" min="0" max="1000" step="25" style="width: 70px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Line-Item Invoice -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Floral Invoice Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								💐 Resumo do Orçamento Floral
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Flores, arranjos, montagem e transporte
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Grand Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Cotação Total Estimada de Flores</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">4.140 €</strong>
						<span id="res-tier-summary" style="font-size: 0.8rem; color: var(--accent-red);">Escalão Romântico Clássico (1.5x)</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Discriminação por Categoria
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">👰 Flores Pessoais e Cortejo:</td>
									<td id="res-personal-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.005,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">⛪ Cerimónia e Arco Floral:</td>
									<td id="res-ceremony-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.012,50 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍽️ Centros de Mesa e Copo-d'Água:</td>
									<td id="res-reception-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.882,50 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Subtotal das Flores Brutas:</td>
									<td id="res-stems-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">3.900,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-blue);">
									<td style="padding: 0.4rem 0;">🛠️ Mão de Obra e Montagem (20%):</td>
									<td id="res-labor-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">780,00 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil);">
									<td style="padding: 0.4rem 0;">🚚 Transporte e Carrinha Frigorífica:</td>
									<td id="res-delivery-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">100,00 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Category Distribution Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Pessoais</span>
							<span>Cerimónia</span>
							<span>Receção</span>
							<span style="color: var(--accent-blue);">Montagem</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-personal" style="width: 25%; background: var(--accent-red); transition: width 0.3s ease;" title="Pessoais"></div>
							<div id="bar-ceremony" style="width: 25%; background: var(--accent-blue); transition: width 0.3s ease;" title="Cerimónia"></div>
							<div id="bar-reception" style="width: 35%; background: #16a34a; transition: width 0.3s ease;" title="Receção"></div>
							<div id="bar-labor" style="width: 15%; background: #d97706; transition: width 0.3s ease;" title="Mão de Obra & Transporte"></div>
						</div>
					</div>

				</div>

				<!-- Florist Tip Alert Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						💡 Dica de Poupança: Reutilizar Flores da Cerimónia
					</strong>
