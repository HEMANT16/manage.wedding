---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Estimador de Custos de Catering e Copo-d'Água de Casamento",
      "url": "https://manage.wedding/pt/catering-cost-estimator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de catering para casamentos. Calcule o custo real por pessoa e total de ementas empratadas, buffets, bar aberto, aluguer de louças, taxas de serviço e IVA. Exporte para Word, PDF ou Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular o Custo Real de Catering de Casamento",
      "description": "Guia passo a passo para calcular ementas, bar aberto, alugueres e impostos no copo-d'água.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Selecione o Estilo de Refeição e Nível da Ementa",
          "text": "Escolha entre serviço empratado tradicional, buffet, travessas partilhadas à mesa ou estações de cocktails e adicione os aperitivos de boas-vindas."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Configure o Bar Aberto e Aluguer de Louças",
          "text": "Selecione o pacote de bebidas (apenas vinhos/cerveja ou bar aberto completo com destilados) e adicione o aluguer de atoalhados e louças se necessário."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Indique os Convidados e Refeições de Staff",
          "text": "Introduza o número de convidados pagantes e as refeições para fornecedores (fotógrafo, DJ, videógrafo, animadores)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Contemple as Taxas de Serviço e IVA",
          "text": "Aplique a taxa de serviço de catering (10% a 15%) e o IVA de restauração para obter o custo real final por pessoa."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual é o preço médio por pessoa de catering de casamento em Portugal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Em Portugal, o valor médio de copo-d'água situa-se entre 85 € e 150 € por convidado para ementas completas com cocktail de receção, prato de peixe, prato de carne, buffet de sobremesas, ceia e bar aberto."
          }
        },
        {
          "@type": "Question",
          "name": "Um serviço de buffet é mais barato do que o jantar empratado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem sempre. Embora o buffet exija menos empregados de mesa para servir à mesa, exige 20% a 25% mais volume de comida para manter os réchauds e travessas sempre bem compostos."
          }
        },
        {
          "@type": "Question",
          "name": "É obrigatório alimentar os fornecedores no casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Profissionais que trabalham no evento por mais de 6 horas contínuas (fotógrafo, DJ, videógrafo e coordenador) devem ter uma refeição quente incluída, normalmente com 50% de desconto face ao preço do convidado."
          }
        },
        {
          "@type": "Question",
          "name": "Como exportar o orçamento detalhado de catering?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Basta clicar em 'Exportar Word (.doc)', 'Exportar PDF / Imprimir' ou 'CSV' para descarregar a proposta discriminada pronta para comparar com quintas e empresas de catering."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Estimador de Custos de Catering & Copo-d'Água (Preço por Pessoa) | Manage.Wedding"
	description="Calcule custos de catering, ementas empratadas, buffet, bar aberto, alugueres, taxa de serviço e IVA. Exporte orçamentos completos em Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Estimador de Custos de Catering & Copo-d'Água
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Descubra o custo real com tudo incluído de ementas, bar aberto, aluguer de louças, taxas de serviço e IVA. Exporte para <strong>Word (.doc)</strong>, <strong>PDF</strong> ou <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Main Workspace Grid: Configurator + Real-Time Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="catering-calc-grid">
			
			<!-- Left Column: Input Form & Package Controls -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							🍽️ Opções da Ementa & Serviço
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Configure refeição, bar, alugueres e taxas
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Moeda:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="R$">R$ (BRL)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="catering-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Guest Count & Vendor Meals -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
						<div>
							<label for="input-guest-count" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								N.º de Convidados Adultos *
							</label>
							<input type="number" id="input-guest-count" value="100" min="10" max="1000" required style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
						</div>

						<div>
							<label for="input-vendor-meals" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Refeições de Staff (Foto, DJ)
							</label>
							<input type="number" id="input-vendor-meals" value="4" min="0" max="30" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
						</div>
					</div>

					<!-- Meal Service Style -->
					<div>
						<label for="select-meal-style" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Estilo de Serviço da Refeição
						</label>
						<select id="select-meal-style" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: #fff;">
							<option value="75" selected>Jantar Empratado Tradicional (Peixe + Carne) (75 € / pessoa base)</option>
							<option value="60">Buffet Completo de Pratos Quentes (60 € / pessoa base)</option>
							<option value="65">Travessas Partilhadas à Mesa (Family Style) (65 € / pessoa base)</option>
							<option value="55">Estações de Cocktails & Finger Food (55 € / pessoa base)</option>
							<option value="45">Churrasco Tradicional / Porco no Espeto (45 € / pessoa base)</option>
							<option value="40">Brunch & Mesa de Crepes/Waffles (40 € / pessoa base)</option>
						</select>
					</div>

					<!-- Passed Appetizers / Cocktail Hour -->
					<div>
						<label for="select-appetizers" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Cocktail de Boas-Vindas & Canapés
						</label>
						<select id="select-appetizers" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="0">Incluído no Pacote Base (0 €)</option>
							<option value="12" selected>Cocktail Volante de Canapés e Salgadinhos (12 € / pessoa)</option>
							<option value="18">Mesa de Queijos Regionais, Enchidos e Canapés (18 € / pessoa)</option>
							<option value="28">Estação de Marisco & Cortador de Presunto ao Vivo (28 € / pessoa)</option>
						</select>
					</div>

					<!-- Bar & Beverage Package -->
					<div>
						<label for="select-bar-package" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Bar & Bebidas (Copo-d'Água e Festa)
						</label>
						<select id="select-bar-package" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="0">Sem Álcool / Apenas Águas e Sumos (0 € / pessoa)</option>
							<option value="8">Bebidas Próprias dos Noivos (Apenas Taxa de Rolha e Serviço) (8 € / pessoa)</option>
							<option value="16">Vinhos da Casa, Cerveja e Espumante de Brinde (16 € / pessoa)</option>
							<option value="25" selected>Bar Aberto Completo (Vinho, Cerveja e Destilados) (25 € / pessoa)</option>
							<option value="38">Bar Aberto Premium com Cocktails de Assinatura (38 € / pessoa)</option>
						</select>
					</div>

					<!-- Rentals & Dinnerware -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
						<div>
							<label for="select-rentals" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Louças & Atoalhados
							</label>
							<select id="select-rentals" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff;">
								<option value="0">Fornecido pela Quinta (0 €)</option>
								<option value="8" selected>Aluguer Padrão de Toalhas e Louça (8 €/p)</option>
								<option value="16">Louça Vintage, Marcadores & Talheres Dourados (16 €/p)</option>
							</select>
						</div>

						<div>
							<label for="select-dessert-fee" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Bolo dos Noivos & Ceia
							</label>
							<select id="select-dessert-fee" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff;">
								<option value="0">Sem Taxa de Corte / Bolo Próprio (0 €)</option>
								<option value="2.5" selected>Serviço de Corte do Bolo (2,50 €/p)</option>
								<option value="7">Mesa de Doces Tradicionais & Ceia Completa (7 €/p)</option>
							</select>
						</div>
					</div>

					<!-- Service Charge & Tax -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-service-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Taxa de Serviço / Staff
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-service-pct" value="10" min="0" max="30" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>

						<div>
							<label for="input-tax-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Taxa de IVA Aplicável
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-tax-pct" value="13" min="0" max="25" step="0.5" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Surcharge Comparison -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								📋 Proposta Estimada de Catering
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Tudo incluído: comida, bar, alugueres, serviço e IVA
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Cost Per Head vs Total Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Grand Total Invoice -->
						<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--accent-red); display: block; font-weight: bold;">Fatura Total Prevista</span>
							<strong id="res-grand-total" class="font-heading" style="font-size: 2.2rem; color: var(--accent-red); display: block; line-height: 1.2;">15.244 €</strong>
							<span id="res-total-guest-note" style="font-size: 0.75rem; color: var(--accent-red);">Com todas as taxas e IVA</span>
						</div>

						<!-- All-Inclusive Cost Per Head -->
						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block; font-weight: bold;">Custo Real por Convidado</span>
							<strong id="res-per-head" class="font-heading" style="font-size: 2.2rem; color: var(--accent-blue); display: block; line-height: 1.2;">152,44 €</strong>
							<span id="res-base-diff-note" style="font-size: 0.75rem; color: #1e40af;">Ementa base era 75,00 €</span>
						</div>

					</div>

					<!-- Itemized Invoice Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Discriminação dos Custos
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🥗 Ementa Base & Cocktail de Boas-Vindas:</td>
									<td id="res-food-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">8.700,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍷 Pacote de Bar Aberto & Bebidas:</td>
									<td id="res-bar-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">2.500,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍽️ Louças, Toalhas e Corte do Bolo:</td>
									<td id="res-rentals-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.050,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍱 Refeições de Staff / Fornecedores (-50%):</td>
									<td id="res-vendor-meals-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">150,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Subtotal Direto (Sem Impostos):</td>
									<td id="res-pretax-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">12.400,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-red);">
									<td style="padding: 0.4rem 0;">➕ Taxa de Serviço (10%):</td>
									<td id="res-service-charge" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.240,00 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil);">
									<td style="padding: 0.4rem 0;">🏛️ IVA Aplicável (13%):</td>
									<td id="res-sales-tax" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.604,00 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Proportional Cost Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Comida e Bebidas (80%)</span>
							<span style="color: var(--accent-red);">Serviço & IVA (20%)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-food-portion" style="width: 80%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-fees-portion" style="width: 20%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Planner Surcharge Alert Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						⚠️ Dica de Planeamento Orçamental:
					</strong>
					<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; color: var(--fg-pencil);">
						Repare como um menu anunciado a <strong>75 €/pessoa</strong> se transforma em <strong>152,44 €/pessoa</strong> após somar canapés de boas-vindas, bar aberto, serviço e IVA. Peça sempre orçamentos finais com IVA e taxas discriminadas!
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Estimativa Oficial de Catering</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado a: <span id="print-date"></span> | N.º Convidados: <span id="print-guests"></span> | Total Geral: <span id="print-total"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Artigo / Serviço</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 100px; text-align: center;">Convidados</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 120px; text-align: right;">Total (€)</th>
					</tr>
				</thead>
