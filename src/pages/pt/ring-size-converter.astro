---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Conversor Internacional de Tamanhos de Anéis e Alianças",
      "url": "https://manage.wedding/pt/ring-size-converter",
      "inLanguage": "pt",
      "description": "Conversor gratuito de tamanhos de anéis e alianças de casamento. Converta instantaneamente entre Portugal/Europa (EU), Reino Unido (UK), EUA (US), Japão/Ásia, diâmetro e perímetro (mm) com compensação de largura do aro e régua para imprimir em PDF.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Como converter o tamanho de anéis entre Portugal (EU), UK e US?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O tamanho habitual feminino 14 em Portugal (ou EU 54) corresponde ao tamanho US 7, UK O ou N 1/2 e Japão 14, com um diâmetro interior de 17,3 mm e perímetro de 54,4 mm. O nosso conversor faz o mapeamento exato entre os 5 principais sistemas internacionais."
          }
        },
        {
          "@type": "Question",
          "name": "Como é que a largura da aliança afeta o tamanho a encomendar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Alianças mais largas (6 mm a 8 mm+) cobrem maior superfície de pele e criam mais atrito, parecendo mais apertadas do que anéis finos de 2 mm. Os joalheiros recomendam encomendar meio tamanho acima (+0,5 US ou +1 número EU) para alianças largas."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é a diferença entre o interior Conforto (Comfort-Fit) e o Interior Plano?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As alianças Comfort-Fit (anatómicas) têm o interior ligeiramente abaulado e arredondado, deslizando pelos nós dos dedos com mais facilidade e dando uma sensação de maior folga. As alianças Standard têm o interior totalmente plano."
          }
        },
        {
          "@type": "Question",
          "name": "O que fazer se a medida do dedo ficar entre dois tamanhos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Escolha sempre o tamanho acima. Os dedos incham naturalmente no verão, com o calor, após exercício físico ou ao final do dia. Um anel ligeiramente mais largo é infinitamente mais confortável do que um que aperte a circulação."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Como Medir o Dedo e Converter Tamanhos de Anéis",
      "description": "Guia prático de ourivesaria para medir o perímetro do dedo, calcular o diâmetro interior e converter tamanhos internacionais.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Envolva uma Tira de Papel na Base e no Nó do Dedo",
          "text": "Envolva uma tira de papel não elástica na base do dedo anelar e passe pelo nó do dedo para garantir passagem confortável."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Meça o Perímetro em Milímetros",
          "text": "Marque a sobreposição do papel e meça o comprimento esticado com uma régua para obter o perímetro interior em milímetros."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Calcule o Diâmetro Interior (Perímetro ÷ π)",
          "text": "Divida o perímetro por π (3,14159) para obter o diâmetro interior exato ou consulte a nossa tabela."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Contemple a Largura do Aro e Perfil Anatómico",
          "text": "Acrescente meio tamanho para alianças largas (6 mm+) ou mantenha a medida real para perfis anatómicos comfort-fit."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 5: Exporte a Ficha Técnica de Joalharia",
          "text": "Guarde a ficha em Word (.doc) ou imprima o medidor em PDF com escala 1:1 para validar o tamanho antes da compra."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Conversor de Tamanhos de Anéis e Alianças (Tabela EU, UK, US e mm) | Manage.Wedding"
	description="Converta tamanhos de anéis entre Portugal/Europa (EU), UK, US, Japão, diâmetro e perímetro em mm. Inclui medidor para imprimir em PDF e ajustes de largura."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Conversor de Tamanhos de Anéis e Alianças
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Converta tamanhos de joalharia entre <strong>Europa (EU/PT), Reino Unido (UK), EUA (US), Japão, Diâmetro e Perímetro (mm)</strong>. Inclui compensação de largura do aro e <strong>Medidor 1:1 para Imprimir em PDF e Word</strong>!
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Descobrir o Tamanho do Anel em 3 Passos Simples
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Escolha o Sistema Conhecido ou Medida
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Selecione o sistema de tamanhos (EU/Portugal, UK, US, Japão) ou introduza o perímetro/diâmetro do dedo em milímetros.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Ajuste a Largura da Aliança
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indique a espessura do anel (solitário fino de 2 mm vs. aliança larga de 7 mm) para aplicar a compensação de ourivesaria.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporte a Ficha Técnica e Régua 1:1
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Guarde o cartão de joalharia em Word ou imprima a régua em PDF com calibração real a 100% para testar no dedo!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Converter Form + Live Results & Circle Sizer -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="ring-grid">
			
			<!-- Left Column: Sizing Controls & Width Adjustments -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💍 Configurador de Tamanho de Anéis
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Conversão entre Europa, Reino Unido, EUA, Ásia e milímetros exatos
					</span>
				</div>

				<form id="ring-converter-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- 1. Known System & Size Picker -->
					<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.6rem;">
						<div>
							<label for="select-system" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Sistema de Origem *
							</label>
							<select id="select-system" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.92rem;">
								<option value="eu" selected>🇪🇺 🇵🇹 Europa / Portugal (EU)</option>
								<option value="us">🇺🇸 🇨🇦 EUA / Canadá (US)</option>
								<option value="uk">🇬🇧 🇦🇺 Reino Unido / Austrália (UK)</option>
								<option value="jp">🇯🇵 🇨🇳 Japão / Ásia</option>
								<option value="mm">📏 Perímetro em mm</option>
							</select>
						</div>

						<div>
							<label for="select-ring-val" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Selecione o Tamanho *
							</label>
							<select id="select-ring-val" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-heading); font-size: 1rem;">
								<!-- Populated via JS -->
							</select>
						</div>
					</div>

					<!-- 2. Band Width Setting (Crucial for Jeweler Accuracy) -->
					<div>
						<label for="select-band-width" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
							Largura do Aro da Aliança (Compensação de Ourives)
						</label>
						<select id="select-band-width" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
							<option value="0" selected>Aro Fino Padrão (1,5 mm - 3 mm) — Tamanho Real</option>
							<option value="0.25">Aro Médio (4 mm - 5 mm) — +0,25 de Folga</option>
							<option value="0.5">Aliança Larga (6 mm - 8 mm+) — Recomenda-se +0,50 de Folga</option>
						</select>
					</div>

					<!-- 3. Comfort-Fit vs Standard-Fit Interior -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.88rem; color: var(--fg-pencil); display: block;">
							⚙️ Perfil Interior da Aliança:
						</span>
						<div style="display: flex; gap: 1rem; flex-wrap: wrap;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="radio" name="interior-fit" value="standard" checked style="accent-color: var(--fg-pencil);">
								<span>Interior Plano Tradicional</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="radio" name="interior-fit" value="comfort" style="accent-color: var(--fg-pencil);">
								<span>Interior Conforto (Anatómico Arredondado)</span>
							</label>
						</div>
					</div>

					<!-- Quick Sizing Advice Note -->
					<div id="band-advice-box" style="background: #eff6ff; border: 1px solid var(--accent-blue); border-radius: 4px; padding: 0.65rem; font-size: 0.82rem; color: #1e3a8a; line-height: 1.4;">
						💡 <strong>Regra de Joalheiro:</strong> Alianças finas (2 mm) usam a medida exata do dedo. Para alianças masculinas ou femininas largas (6 mm+), subir meio tamanho evita que o aro aperte com o calor.
					</div>

				</form>
			</div>

			<!-- Right Column: Live International Matrix & Visual Scale Circle -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main International Matrix Result Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🌐 Matriz Internacional de Tamanhos
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Tamanhos equivalentes nos principais mercados mundiais
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Medidor 1:1
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- 4-System Big Highlight Grid -->
					<div style="display: grid; grid-template-columns: repeat(2, 1fr); sm:grid-template-columns: repeat(4, 1fr); gap: 0.6rem; text-align: center; margin-bottom: 1.25rem;">
						<div style="background: #fdf2f8; border: 1.5px solid var(--accent-red); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold; text-transform: uppercase;">Europa (EU/PT)</span>
							<strong id="res-eu" class="font-heading" style="font-size: 1.9rem; color: var(--accent-red); display: block; line-height: 1.2;">54</strong>
						</div>

						<div style="background: #eff6ff; border: 1.5px solid var(--accent-blue); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--accent-blue); font-weight: bold; text-transform: uppercase;">Reino Unido (UK)</span>
							<strong id="res-uk" class="font-heading" style="font-size: 1.9rem; color: var(--accent-blue); display: block; line-height: 1.2;">N 1/2</strong>
						</div>

						<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: #16a34a; font-weight: bold; text-transform: uppercase;">EUA / Canadá</span>
							<strong id="res-us" class="font-heading" style="font-size: 1.9rem; color: #16a34a; display: block; line-height: 1.2;">7</strong>
						</div>

						<div style="background: #fafaf9; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--fg-pencil); font-weight: bold; text-transform: uppercase;">Japão / Ásia</span>
							<strong id="res-jp" class="font-heading" style="font-size: 1.9rem; color: var(--fg-pencil); display: block; line-height: 1.2;">14</strong>
						</div>
					</div>

					<!-- Exact Millimeter & Inch Dimensions -->
					<div style="display: flex; justify-content: space-around; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem; font-size: 0.85rem; margin-bottom: 1.25rem;">
						<span>📏 Diâmetro Interior: <strong id="res-dia">17.3 mm</strong> (<span id="res-dia-in">0.68 in</span>)</span>
						<span>📐 Perímetro Interior: <strong id="res-circ">54.4 mm</strong> (<span id="res-circ-in">2.14 in</span>)</span>
					</div>

					<!-- Visual Scaled Ring Sizer Frame -->
					<div style="text-align: center; border-top: 1.5px dashed #ccc; padding-top: 1rem;">
						<span class="font-heading" style="font-size: 0.92rem; color: var(--fg-pencil); display: block; margin-bottom: 0.5rem;">
							🔍 Pré-visualização do Diâmetro do Aro:
						</span>
						<div style="display: flex; justify-content: center; align-items: center; min-height: 130px;">
							<div id="visual-ring-circle" style="width: 104px; height: 104px; border: 5px solid var(--accent-red); border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; box-shadow: 0 0 10px rgba(0,0,0,0.05); background: #fff;">
								<span id="visual-ring-text" style="font-family: monospace; font-size: 0.82rem; font-weight: bold; color: var(--fg-pencil);">
									Ø 17.3 mm
								</span>
							</div>
						</div>
						<p style="font-size: 0.75rem; color: var(--text-secondary); margin: 0.4rem 0 0 0;">
							*Escala de ecrã aproximada. Utilize o PDF para impressão com calibração física 1:1 real.
						</p>
					</div>

				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation (1:1 Scale Sizer) -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 4px 0;">Manage.Wedding — Cartão Oficial de Medidas de Anéis & Régua 1:1</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado a: <span id="print-date"></span> | Tamanho Medido: <span id="print-us-size"></span></p>
			</div>

			<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
				<h3 style="margin:0 0 10px 0;">Especificações Exatas do Tamanho:</h3>
				<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
					<tr><td><strong>Tamanho Europa / Portugal (EU):</strong></td><td id="p-eu">54</td><td><strong>Tamanho Reino Unido (UK):</strong></td><td id="p-uk">N 1/2</td></tr>
					<tr><td><strong>Tamanho EUA / Canadá (US):</strong></td><td id="p-us">7</td><td><strong>Tamanho Japão / Ásia:</strong></td><td id="p-jp">14</td></tr>
					<tr><td><strong>Diâmetro Interior:</strong></td><td id="p-dia">17.3 mm</td><td><strong>Perímetro Interior:</strong></td><td id="p-circ">54.4 mm</td></tr>
				</table>
			</div>

			<div style="border: 2px dashed #000; padding: 25px; text-align: center;">
				<h3 style="margin:0 0 10px 0;">Régua de Medição de Dedos em Papel (Escala 1:1)</h3>
				<p style="font-size: 12px; margin-bottom: 15px;">Recorte esta tira, faça um pequeno corte na ranhura (A), envolva o dedo e puxe a ponta pela ranhura para ler o tamanho diretamente.</p>
				<div style="border: 1px solid #000; height: 35px; width: 100%; max-width: 500px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; font-size: 11px;">
					<span>[RANHURA A]</span>
					<span>44</span><span>47</span><span>50</span><span>52</span><span>54</span><span>57</span><span>60</span><span>62</span><span>65</span><span>67</span><span>70</span>
					<span>[PUXAR]</span>
				</div>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Resumo Direto ao Assunto</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Regra Prática: Fórmulas de Diâmetro e Perímetro de Anéis
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>Fórmula Central de 1 Minuto:</strong> A geometria dos anéis rege-se por <strong>Diâmetro Interior (mm) × π (3,14159) = Perímetro Interior (mm)</strong>. Cada tamanho europeu completo equivale a exatamente <strong>1 mm de perímetro</strong>. Se comprar uma aliança larga (6 mm a 8 mm+), <strong>encomende 1 número acima</strong>. Se a medida do nó do dedo for superior à base, privilegie a medida do nó.
			</p>
			
			<!-- Benchmark Ring Conversion Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
