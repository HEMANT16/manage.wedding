---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://manage.wedding/pt/contact/#webpage",
  "name": "Contacte-nos | Manage.Wedding",
  "url": "https://manage.wedding/pt/contact",
  "inLanguage": "pt",
  "description": "Entre em contacto com a equipa do Manage.Wedding. Envie-nos sugestões de novas calculadoras, feedback sobre ferramentas ou dúvidas de planeamento para manage.weddingall@gmail.com."
};
---

<Layout 
	title="Contacte-nos | Manage.Wedding — Fale Connosco"
	description="Fale diretamente com o Manage.Wedding através de manage.weddingall@gmail.com. Tem sugestões para uma nova calculadora, um erro a reportar ou feedback?"
	schema={schema}
>
	<main style="max-width: 1050px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem); box-sizing: border-box;">
		
		<!-- Header -->
		<section class="section-paper" style="margin-bottom: 2.5rem; text-align: center; padding: 2.5rem 1rem;">
			<div class="tape" style="margin: 0 auto 1.25rem;"></div>
			<span class="badge-postit">Estamos Aqui Para Ajudar</span>
			<h1 class="font-heading" style="font-size: clamp(34px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.2; text-align: center; margin: 0.75rem 0;">
				Fale com o Manage.Wedding
			</h1>
			<p style="font-size: 1.2rem; color: var(--text-secondary); max-width: 680px; margin: 0.5rem auto 0; text-align: center; line-height: 1.6;">
				Tem uma ideia para uma nova calculadora, feedback sobre uma ferramenta ou uma dúvida de planeamento? Envie-nos uma mensagem direta abaixo!
			</p>
		</section>

		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; margin-bottom: 4rem; align-items: start;">
			
			<!-- Direct Contact Form Card -->
			<div class="hand-card" style="padding: clamp(1.75rem, 3.5vw, 2.75rem); background: #fff;">
				<h2 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; text-align: center;">
					Envie-nos uma Mensagem
				</h2>
				<p style="font-size: 1.05rem; color: var(--text-secondary); margin-bottom: 1.75rem; text-align: center; line-height: 1.5;">
					As mensagens são entregues diretamente em <strong style="color: var(--fg-pencil);">manage.weddingall@gmail.com</strong>.
				</p>

				<form id="contact-form" style="display: flex; flex-direction: column; gap: 1.35rem;">
					<!-- Hidden Honeypot Field for Spam Protection -->
					<input type="text" name="_honey" id="contact-honey" style="display: none;" tabindex="-1" autocomplete="off" />

					<div>
						<label for="contact-name" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							O Seu Nome <span style="color: #dc2626;">*</span>
						</label>
						<input 
							type="text" 
							name="name"
							id="contact-name" 
							required 
							placeholder="ex.: Sofia & Tiago" 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; font-size: 1.05rem; padding: 0.85rem 1rem;"
						/>
					</div>

					<div>
						<label for="contact-email" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							O Seu E-mail <span style="color: #dc2626;">*</span>
						</label>
						<input 
							type="email" 
							name="email"
							id="contact-email" 
							required 
							placeholder="ex.: noivos@exemplo.com" 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; font-size: 1.05rem; padding: 0.85rem 1rem;"
						/>
					</div>

					<div>
						<label for="contact-topic" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Assunto
						</label>
						<select name="topic" id="contact-topic" class="hand-input" style="width: 100%; box-sizing: border-box; background: #fff; font-size: 1.05rem; padding: 0.85rem 1rem; cursor: pointer;">
							<option value="Sugerir Nova Ferramenta">💡 Sugerir uma Nova Calculadora / Funcionalidade</option>
							<option value="Reportar Erro">🐛 Reportar um Erro de Cálculo ou Problema Técnico</option>
							<option value="Dúvida Geral">💬 Dúvida Geral de Planeamento de Casamento</option>
							<option value="Parcerias / Imprensa">🤝 Parcerias, Fornecedores ou Imprensa</option>
							<option value="Questão de Privacidade">🛡️ Dúvida sobre Privacidade ou Dados</option>
						</select>
					</div>

					<div>
						<label for="contact-message" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Mensagem <span style="color: #dc2626;">*</span>
						</label>
						<textarea 
							name="message"
							id="contact-message" 
							rows="5" 
							required 
							placeholder="Diga-nos como podemos ajudar, que ferramenta está a utilizar ou que nova funcionalidade tornaria o seu planeamento mais simples..." 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; resize: vertical; font-size: 1.05rem; line-height: 1.6; padding: 0.85rem 1rem;"
						></textarea>
					</div>

					<button 
						type="submit" 
						id="contact-submit-btn"
						class="hand-btn" 
						style="width: 100%; padding: 14px 20px; font-size: 1.15rem; cursor: pointer; margin-top: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.6rem;"
					>
						<span>✉️</span>
						<span id="btn-text">Enviar Mensagem</span>
					</button>
				</form>

				<!-- Success Status Box -->
				<div id="contact-success" style="display: none; background: #dcfce7; border: 2px solid #16a34a; border-radius: 6px; padding: 1.5rem; margin-top: 1.5rem; text-align: center; color: #166534;">
					<div style="font-size: 2rem; margin-bottom: 0.35rem;">🎉</div>
					<strong style="font-size: 1.2rem; display: block; margin-bottom: 0.5rem;">Obrigado! A sua mensagem foi enviada com sucesso.</strong>
					<p style="margin: 0; font-size: 1.02rem; line-height: 1.5;">
						Foi entregue diretamente em <strong>manage.weddingall@gmail.com</strong>. Iremos responder-lhe no prazo de 24 a 48 horas!
					</p>
				</div>

				<!-- Error Fallback Box -->
				<div id="contact-error" style="display: none; background: #fee2e2; border: 2px solid #dc2626; border-radius: 6px; padding: 1.5rem; margin-top: 1.5rem; text-align: center; color: #991b1b;">
					<strong style="font-size: 1.1rem; display: block; margin-bottom: 0.35rem;">Não foi possível enviar a mensagem automaticamente.</strong>
					<p style="margin: 0; font-size: 1rem;">
						Por favor envie-nos um e-mail diretamente para <a id="error-mailto-link" href="mailto:manage.weddingall@gmail.com" style="color: #991b1b; text-decoration: underline; font-weight: bold;">manage.weddingall@gmail.com</a>.
					</p>
				</div>
			</div>

			<!-- Direct Contact Info & FAQ Side Column -->
			<div style="display: flex; flex-direction: column; gap: 1.75rem;">
				
				<!-- Direct Channels -->
				<div class="hand-card" style="padding: 2rem; background: var(--bg-paper);">
					<h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
						Contacto Direto
					</h3>
					
					<div style="display: flex; flex-direction: column; gap: 1.2rem; font-size: 1rem;">
						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); margin-bottom: 0.35rem; font-size: 1.05rem;">📬 E-mail Principal:</strong>
							<a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 700; text-decoration: underline; font-size: 1.1rem; word-break: break-all;">
								manage.weddingall@gmail.com
							</a>
						</div>

						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); font-size: 1.05rem;">💡 Motivos habituais de contacto:</strong>
							<ul style="margin: 0.5rem 0 0 1.25rem; padding: 0; color: var(--text-secondary); font-size: 0.98rem; line-height: 1.6;">
								<li>Sugestões para novas calculadoras de casamento</li>
								<li>Feedback ou pedidos de correção em fórmulas</li>
								<li>Parcerias e colaboração com fornecedores do setor</li>
							</ul>
						</div>

						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); font-size: 1.05rem;">🛡️ Questões de Privacidade:</strong>
							<p style="margin: 0.35rem 0 0; color: var(--text-secondary); font-size: 0.98rem; line-height: 1.5;">
								Todos os pedidos relativos a direitos de privacidade podem ser enviados para <a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 600; text-decoration: underline;">manage.weddingall@gmail.com</a>.
							</p>
						</div>
					</div>
				</div>

				<!-- Quick Response Guarantee -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.45rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
						⚡ Resposta em 24–48h
					</h3>
					<p style="font-size: 1.02rem; color: var(--text-secondary); margin: 0; line-height: 1.6; text-align: center;">
						Lemos pessoalmente todas as mensagens enviadas por noivos, padrinhos e organizadores de casamento.
					</p>
				</div>

				<!-- Quick FAQ -->
				<div class="hand-card" style="padding: 2rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 1rem; text-align: center;">
						Perguntas Frequentes
					</h3>
					<details style="margin-bottom: 0.75rem; cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">As ferramentas são mesmo 100% gratuitas?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Sim! Todas as mais de 30 calculadoras e modelos para descarregar são totalmente gratuitos para uso pessoal, sem custos ocultos nem versões pagas.</p>
					</details>
					<details style="margin-bottom: 0.75rem; cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Posso sugerir uma nova calculadora?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Com certeza! Preencha o formulário acima ou envie um e-mail para <a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 600;">manage.weddingall@gmail.com</a> com a fórmula ou ideia pretendida.</p>
					</details>
					<details style="cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Guardam a minha lista de convidados ou discursos?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Não. Tudo funciona 100% do lado do cliente, na memória do navegador do seu dispositivo. Nunca gravamos os seus dados pessoais em servidores remotos.</p>
					</details>
				</div>

			</div>

		</div>

	</main>

	<script is:inline>
		const form = document.getElementById('contact-form');
		const submitBtn = document.getElementById('contact-submit-btn');
		const btnText = document.getElementById('btn-text');
		const successBox = document.getElementById('contact-success');
		const errorBox = document.getElementById('contact-error');
		const errorMailto = document.getElementById('error-mailto-link');

		if (form) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				// Spam honeypot check
				const honey = document.getElementById('contact-honey').value;
				if (honey) {
					console.warn('Submissão bloqueada por filtro anti-spam');
					return;
				}

				const name = document.getElementById('contact-name').value.trim();
				const email = document.getElementById('contact-email').value.trim();
				const topic = document.getElementById('contact-topic').value;
				const message = document.getElementById('contact-message').value.trim();

				if (!name || !email || !message) return;

				// UI loading state
				submitBtn.disabled = true;
				btnText.innerText = 'A enviar para manage.weddingall@gmail.com...';
				if (successBox) successBox.style.display = 'none';
				if (errorBox) errorBox.style.display = 'none';

				try {
					const response = await fetch('https://formsubmit.co/ajax/75066fcb859af7eecff2fc720ba6dc94', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'Accept': 'application/json'
						},
						body: JSON.stringify({
							name: name,
							email: email,
							topic: topic,
							message: message,
							_subject: `[Manage.Wedding Contacto] ${topic} de ${name}`,
							_template: 'table'
						})
					});

					const result = await response.json();

					if (response.ok || result.success === 'true' || result.message) {
						form.reset();
						submitBtn.style.display = 'none';
						if (successBox) {
							successBox.style.display = 'block';
							successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
						}
					} else {
						throw new Error(result.message || 'Falha no envio');
					}
				} catch (err) {
					console.error('Erro no envio direto:', err);
					submitBtn.disabled = false;
					btnText.innerText = 'Enviar Mensagem';
					
					const subject = encodeURIComponent(`[Manage.Wedding] ${topic} - de ${name}`);
					const body = encodeURIComponent(`Nome: ${name}\nE-mail: ${email}\nAssunto: ${topic}\n\nMensagem:\n${message}`);
					if (errorMailto) {
						errorMailto.href = `mailto:manage.weddingall@gmail.com?subject=${subject}&body=${body}`;
					}
					if (errorBox) {
						errorBox.style.display = 'block';
						errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					}
				}
			});
		}
	</script>
</Layout>
