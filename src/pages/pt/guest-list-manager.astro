---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/guest-list-manager/#webapp",
      "name": "Gestor de Lista de Convidados de Casamento & Controlo de RSVP",
      "url": "https://manage.wedding/pt/guest-list-manager",
      "inLanguage": "pt",
      "description": "Gestor gratuito de lista de convidados de casamento e CRM para noivos. Controle acompanhantes (+1), restrições alimentares, confirmações de RSVP e exporte para Word, PDF ou Excel.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Organizar e Fazer a Gestão da Lista de Convidados de Casamento",
      "description": "Processo passo a passo para criar a lista de convites, categorizar agregados familiares, acompanhar confirmações e exportar listas.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Calcule a Quota Total de Convites",
          "text": "Divida a lotação pretendida da quinta pela taxa média de aceitação de 80% a 85% para saber quantas pessoas pode convidar no total."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Agrupe por Famílias e Círculos de Amizade",
          "text": "Adicione o nome do convidado principal, número de lugares por agregado (+1 / filhos) e a respetiva categoria (Família da Noiva, Família do Noivo, Amigos, Padrinhos)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Acompanhe o Estado de RSVP e Restrições Alimentares",
          "text": "Registe confirmações, recusas e pedidos de menus especiais (sem glúten, vegan, alergias) à medida que os convidados respondem."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Exporte a Lista Formatada para os Fornecedores",
          "text": "Descarregue a lista mestra final em formato Word (.doc), PDF pronto a imprimir ou Excel (.csv) para partilhar com o catering e wedding planner."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Como exportar a lista de convidados para Word ou PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clique no botão 'Exportar Word (.doc)' para descarregar uma tabela editável para o Microsoft Word, ou clique em 'Exportar PDF / Imprimir' para gerar uma lista pronta a imprimir com nomes, grupos, opções alimentares e mesas."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é a regra de etiqueta para acompanhantes (+1) no casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "É boa etiqueta dar acompanhante a convidados casados, noivos, que vivam juntos ou que estejam num relacionamento sério há mais de 1 ano. Para os padrinhos e damas de honor, o convite duplo é padrão. Para solteiros ocasionais, o acompanhante é opcional dependendo do orçamento."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona a estratégia de Lista A e Lista B?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Lista A inclui família direta e amigos próximos que recebem os convites 8 a 10 semanas antes. À medida que surgem recusas na Lista A, enviam-se os convites da Lista B discretamente por fases (pelo menos 5 a 6 semanas antes da data)."
          }
        },
        {
          "@type": "Question",
          "name": "Os dados ficam sincronizados com o Plano de Mesas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! O Manage.Wedding guarda os dados localmente no navegador. Os convidados adicionados aqui aparecem automaticamente no Criador de Plano de Mesas, Controlo de RSVP e Marcadores de Lugar."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Gestor de Lista de Convidados de Casamento | Manage.Wedding"
	description="Organize a sua lista de convidados de casamento com facilidade. Faça a gestão de acompanhantes (+1), restrições alimentares, confirmações de RSVP e exporte para Word, PDF ou Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Gestor de Convidados" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Gestor da Lista de Convidados
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Faça a gestão de confirmações de presença (RSVP), acompanhantes, restrições alimentares e mesas num só local. Exporte para <strong>Word (.doc)</strong>, <strong>PDF</strong> ou <strong>Excel (.csv)</strong> com um só clique.
				</p>
			</div>
		</section>

		<!-- Overview Metrics & Dashboard -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						📊 Painel de Controlo de Convidados
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Sincronizado automaticamente com o Plano de Mesas e Controlo de RSVP
					</span>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Exportar Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Exportar PDF / Imprimir
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Exportar Excel (.csv)
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Carregar Exemplo
					</button>
					<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🗑️ Limpar
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;" class="stats-counter-grid">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total de Lugares</span>
					<strong id="stat-total-seats" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(<span id="stat-total-parties">0</span> convites)</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Confirmados</span>
					<strong id="stat-attending" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-attending-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% do total</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">A Aguardar Resposta</span>
					<strong id="stat-pending" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span id="stat-pending-pct" style="font-size: 0.75rem; color: #854d0e; display: block;">0% do total</span>
				</div>
				<div style="background: #fef2f2; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #991b1b; display: block;">Recusas</span>
					<strong id="stat-declined" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red);">0</strong>
					<span id="stat-declined-pct" style="font-size: 0.75rem; color: #991b1b; display: block;">0% do total</span>
				</div>
				<div style="background: #faf5ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #6b21a8; display: block;">Dietas Especiais</span>
					<strong id="stat-dietary" class="font-heading" style="font-size: 1.8rem; color: #7e22ce;">0</strong>
					<span style="font-size: 0.75rem; color: #6b21a8; display: block;">Avisar Catering</span>
				</div>
			</div>

			<!-- Dynamic Visual Stacked Group Distribution Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Distribuição por Grupos</span>
					<span id="group-balance-indicator" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">Equilíbrio de convidados</span>
				</div>
				<div id="chart-container" style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: var(--bg-paper); margin-bottom: 0.75rem;">
				</div>
				<div id="chart-legend" style="display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.85rem; color: var(--fg-pencil);">
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Add Guest Form + Searchable Filterable List -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 360px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="guest-workspace-grid">
			
			<!-- Left Column: Add Guest Card -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.25rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>➕</span> Adicionar Novo Convidado
				</h2>

				<form id="guest-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Primary Guest Name -->
					<div>
						<label for="guest-name" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Nome Completo do Convidado *
						</label>
						<input type="text" id="guest-name" required placeholder="ex.: Sara Santos" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1.05rem;">
					</div>

					<!-- Group Category -->
					<div>
						<label for="guest-group" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Grupo / Afiliação
						</label>
						<select id="guest-group" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
							<option value="Família da Noiva">Família da Noiva</option>
							<option value="Família do Noivo">Família do Noivo</option>
							<option value="Amigas da Noiva">Amigas da Noiva</option>
							<option value="Amigos do Noivo">Amigos do Noivo</option>
							<option value="Amigos Comuns">Amigos Comuns</option>
							<option value="Padrinhos / VIP">Padrinhos / VIP</option>
							<option value="Colegas de Trabalho">Colegas de Trabalho</option>
						</select>
					</div>

					<!-- Party Size & Plus-One -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="guest-party" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								N.º de Lugares
							</label>
							<select id="guest-party" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="1">1 (Individual)</option>
								<option value="2" selected>2 (Casal / +1)</option>
								<option value="3">3 (Família 3)</option>
								<option value="4">4 (Família 4)</option>
								<option value="5">5+ (Família Grande)</option>
							</select>
						</div>
						<div>
							<label for="guest-rsvp" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Estado do RSVP
							</label>
							<select id="guest-rsvp" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="Pending">⏳ Pendente</option>
								<option value="Attending">✅ Confirmado</option>
								<option value="Declined">❌ Recusado</option>
							</select>
						</div>
					</div>

					<!-- Dietary Restrictions -->
					<div>
						<label for="guest-dietary" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Restrições Alimentares / Alergias
						</label>
						<input type="text" id="guest-dietary" placeholder="ex.: Vegetariano, Sem Glúten, Frutos Secos" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						<!-- Quick Dietary Tags -->
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem;">
							<button type="button" class="diet-quick-btn" data-val="Vegetariano" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Vegetariano</button>
							<button type="button" class="diet-quick-btn" data-val="Vegan" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Vegan</button>
							<button type="button" class="diet-quick-btn" data-val="Sem Glúten" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Sem Glúten</button>
							<button type="button" class="diet-quick-btn" data-val="Sem Lactose" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Sem Lactose</button>
						</div>
					</div>

					<!-- Optional Table & Contact Notes -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="guest-table" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Mesa # (Opcional)
							</label>
							<input type="text" id="guest-table" placeholder="ex.: Mesa 4" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						</div>
						<div>
							<label for="guest-email" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Email / Tel (Opcional)
							</label>
							<input type="text" id="guest-email" placeholder="sara@exemplo.com" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						</div>
					</div>

					<button type="submit" class="hand-btn" style="width: 100%; padding: 0.85rem; font-size: 1.15rem; margin-top: 0.5rem;">
						✨ Adicionar à Lista
					</button>

				</form>
			</div>

			<!-- Right Column: Interactive Searchable Table & Filter Bar -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Filter Bar -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
					
					<!-- Search Input -->
					<div style="flex: 1; min-width: 180px;">
						<input type="text" id="search-input" placeholder="🔍 Pesquisar por nome, dieta ou grupo..." class="form-input" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem;">
					</div>

					<!-- Group Filter -->
					<div>
						<select id="filter-group" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Todos os Grupos</option>
							<option value="Família da Noiva">Família da Noiva</option>
							<option value="Família do Noivo">Família do Noivo</option>
							<option value="Amigas da Noiva">Amigas da Noiva</option>
							<option value="Amigos do Noivo">Amigos do Noivo</option>
							<option value="Amigos Comuns">Amigos Comuns</option>
							<option value="Padrinhos / VIP">Padrinhos / VIP</option>
							<option value="Colegas de Trabalho">Colegas de Trabalho</option>
						</select>
					</div>

					<!-- RSVP Filter -->
					<div>
						<select id="filter-rsvp" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Todos os Estados</option>
							<option value="Attending">Confirmados (Presença)</option>
							<option value="Pending">Aguardando Resposta</option>
							<option value="Declined">Recusados</option>
						</select>
					</div>
				</div>

				<!-- Guest List Table Container -->
				<div id="guest-list-table-wrap" style="overflow-x: auto; max-height: 550px;">
					<table id="guest-table-elem" style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 1rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil); position: sticky; top: 0; z-index: 1;">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Convidado / Lugares</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Grupo</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">RSVP</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Dieta</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Mesa</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Ações</th>
							</tr>
						</thead>
						<tbody id="guest-table-body">
						</tbody>
					</table>
				</div>

				<!-- Empty State Note -->
				<div id="empty-state-box" style="display: none; text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💌</div>
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">A Sua Lista de Convidados Está Vazia</h3>
					<p class="font-body" style="font-size: 1.05rem; margin-bottom: 1.25rem;">Adicione o seu primeiro convidado ou clique em "Carregar Exemplo" para explorar a ferramenta.</p>
					<button type="button" id="btn-empty-sample" class="hand-btn" style="padding: 0.5rem 1.25rem; font-size: 1rem;">
						➕ Carregar 8 Convidados de Exemplo
					</button>
				</div>

			</div>
		</div>

		<!-- Hidden Printable Sheet Container for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Lista Mestra de Convidados</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado em: <span id="print-date"></span> | Total de Lugares: <span id="print-total-seats"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Nome do Convidado</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Grupo</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">Lugares</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">RSVP</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Restrições Alimentares</th>
