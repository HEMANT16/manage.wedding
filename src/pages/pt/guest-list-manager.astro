<script is:inline>
	const STORAGE_KEY = 'manage_wedding_guests';

	const sampleGuests = [
		{ id: '1', name: 'Helena Santos', group: "Família da Noiva", partySize: 2, rsvpStatus: 'Attending', dietary: 'Sem Restrições', table: 'Mesa 1', email: 'helena@exemplo.com' },
		{ id: '2', name: 'Tiago Ferreira', group: "Família do Noivo", partySize: 2, rsvpStatus: 'Attending', dietary: 'Sem Glúten', table: 'Mesa 1', email: 'tiago@exemplo.com' },
		{ id: '3', name: 'Mariana Lima', group: "Padrinhos / VIP", partySize: 1, rsvpStatus: 'Attending', dietary: 'Vegetariano', table: 'Mesa Noivos', email: 'mariana@exemplo.com' },
		{ id: '4', name: 'David Martins', group: "Amigos do Noivo", partySize: 2, rsvpStatus: 'Pending', dietary: 'Sem Restrições', table: 'Mesa 2', email: 'david@exemplo.com' },
		{ id: '5', name: 'Inês Henriques', group: "Amigas da Noiva", partySize: 2, rsvpStatus: 'Pending', dietary: 'Alergia a Nozes', table: 'Mesa 3', email: 'ines@exemplo.com' },
		{ id: '6', name: 'Marco Bento', group: "Colegas de Trabalho", partySize: 1, rsvpStatus: 'Declined', dietary: 'Sem Restrições', table: '', email: 'marco@exemplo.com' },
		{ id: '7', name: 'Sara & Tomás Silva', group: "Amigos Comuns", partySize: 2, rsvpStatus: 'Attending', dietary: 'Vegetariano', table: 'Mesa 2', email: 'silva@exemplo.com' },
		{ id: '8', name: 'Tia Clara', group: "Família da Noiva", partySize: 1, rsvpStatus: 'Attending', dietary: 'Sem Lactose', table: 'Mesa 1', email: 'clara@exemplo.com' }
	];

	const groupColors = {
		"Família da Noiva": "#ffb3ba",
		"Família do Noivo": "#bae1ff",
		"Amigas da Noiva": "#ffdfba",
		"Amigos do Noivo": "#baffc9",
		"Amigos Comuns": "#ffffba",
		"Padrinhos / VIP": "#fbcfe8",
		"Colegas de Trabalho": "#e8baff"
	};

	let guests = [];

	function loadStoredGuests() {
		const raw = localStorage.getItem(STORAGE_KEY);
		if (raw) {
			try {
				guests = JSON.parse(raw);
				guests.forEach(g => {
					if (!g.partySize) g.partySize = 1;
					if (!g.rsvpStatus) g.rsvpStatus = 'Pending';
					if (!g.dietary) g.dietary = 'Sem Restrições';
				});
			} catch (e) {
				guests = [];
			}
		} else {
			guests = [...sampleGuests];
			saveGuests();
		}
	}

	function saveGuests() {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(guests));
		render();
	}

	// DOM Elements
	const form = document.getElementById('guest-form');
	const tableBody = document.getElementById('guest-table-body');
	const emptyStateBox = document.getElementById('empty-state-box');
	const tableWrap = document.getElementById('guest-list-table-wrap');

	const statTotalSeats = document.getElementById('stat-total-seats');
	const statTotalParties = document.getElementById('stat-total-parties');
	const statAttending = document.getElementById('stat-attending');
	const statAttendingPct = document.getElementById('stat-attending-pct');
	const statPending = document.getElementById('stat-pending');
	const statPendingPct = document.getElementById('stat-pending-pct');
	const statDeclined = document.getElementById('stat-declined');
	const statDeclinedPct = document.getElementById('stat-declined-pct');
	const statDietary = document.getElementById('stat-dietary');

	const chartContainer = document.getElementById('chart-container');
	const chartLegend = document.getElementById('chart-legend');

	const searchInput = document.getElementById('search-input');
	const filterGroup = document.getElementById('filter-group');
	const filterRsvp = document.getElementById('filter-rsvp');

	// Add Guest
	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const name = document.getElementById('guest-name').value.trim();
		const group = document.getElementById('guest-group').value;
		const partySize = parseInt(document.getElementById('guest-party').value) || 1;
		const rsvpStatus = document.getElementById('guest-rsvp').value;
		const dietary = document.getElementById('guest-dietary').value.trim() || 'Sem Restrições';
		const table = document.getElementById('guest-table').value.trim();
		const email = document.getElementById('guest-email').value.trim();

		if (!name) return;

		const newGuest = {
			id: Date.now().toString(),
			name,
			group,
			partySize,
			rsvpStatus,
			dietary,
			table: table || '',
			email: email || ''
		};

		guests.unshift(newGuest);
		saveGuests();
		form.reset();
		document.getElementById('guest-dietary').value = '';
	});

	// Quick Dietary Tag Buttons
	document.querySelectorAll('.diet-quick-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			const input = document.getElementById('guest-dietary');
			const val = btn.getAttribute('data-val');
			if (!input.value || input.value === 'Sem Restrições' || input.value === 'None') {
				input.value = val;
			} else if (!input.value.includes(val)) {
				input.value += `, ${val}`;
			}
		});
	});

	// Delete Guest
	window.deleteGuestItem = function(id) {
		if (confirm("Remover este convidado da lista?")) {
			guests = guests.filter(g => g.id !== id);
			saveGuests();
		}
	};

	// Cycle RSVP Status on Click
	window.cycleRsvpStatus = function(id) {
		const g = guests.find(item => item.id === id);
		if (!g) return;
		if (g.rsvpStatus === 'Pending') g.rsvpStatus = 'Attending';
		else if (g.rsvpStatus === 'Attending') g.rsvpStatus = 'Declined';
		else g.rsvpStatus = 'Pending';
		saveGuests();
	};

	// Filter & Search Listeners
	searchInput.addEventListener('input', render);
	filterGroup.addEventListener('change', render);
	filterRsvp.addEventListener('change', render);

	// Sample & Clear Buttons
	document.getElementById('btn-sample-data').addEventListener('click', () => {
		guests = JSON.parse(JSON.stringify(sampleGuests));
		saveGuests();
	});
	document.getElementById('btn-empty-sample').addEventListener('click', () => {
		guests = JSON.parse(JSON.stringify(sampleGuests));
		saveGuests();
	});
	document.getElementById('btn-clear-all').addEventListener('click', () => {
		if (confirm("Tem a certeza de que deseja apagar toda a lista de convidados?")) {
			guests = [];
			saveGuests();
		}
	});

	// 📝 Export to Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		if (guests.length === 0) {
			alert("A sua lista de convidados está vazia. Adicione convidados primeiro!");
			return;
		}

		let tableRows = '';
		guests.forEach((g, idx) => {
			tableRows += `
				<tr>
					<td style="border:1px solid #ccc; padding:8px;">${idx + 1}</td>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold;">${g.name}</td>
					<td style="border:1px solid #ccc; padding:8px;">${g.group}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center;">${g.partySize || 1}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center;">${g.rsvpStatus === 'Attending' ? 'Confirmado' : g.rsvpStatus === 'Declined' ? 'Recusado' : 'Pendente'}</td>
					<td style="border:1px solid #ccc; padding:8px;">${g.dietary}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center;">${g.table || '-'}</td>
					<td style="border:1px solid #ccc; padding:8px;">${g.email || '-'}</td>
				</tr>
			`;
		});

		const totalSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const attendingSeats = guests.filter(g => g.rsvpStatus === 'Attending').reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Manage.Wedding — Lista Mestra de Convidados</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Lista Mestra de Convidados de Casamento</h1>
				<p>Gerado em ${new Date().toLocaleDateString('pt-PT')} | Total de Convites: ${guests.length} | Total de Lugares: ${totalSeats} | Confirmados: ${attendingSeats}</p>
				<table>
					<thead>
						<tr>
							<th>#</th>
							<th>Nome do Convidado</th>
							<th>Grupo</th>
							<th>Lugares</th>
							<th>RSVP</th>
							<th>Restrições Alimentares</th>
							<th>Mesa</th>
							<th>Contacto</th>
						</tr>
					</thead>
					<tbody>
						${tableRows}
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Lista_Convidados_Casamento_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		if (guests.length === 0) {
			alert("A sua lista de convidados está vazia. Adicione convidados primeiro!");
			return;
		}

		const printDate = document.getElementById('print-date');
		const printTotalSeats = document.getElementById('print-total-seats');
		const printTbody = document.getElementById('print-table-body');

		printDate.textContent = new Date().toLocaleDateString('pt-PT');
		const totalSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		printTotalSeats.textContent = `${totalSeats} (${guests.length} Famílias/Grupos)`;

		printTbody.innerHTML = '';
		guests.forEach(g => {
			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">${g.name}</td>
				<td style="border: 1px solid #ccc; padding: 6px;">${g.group}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center;">${g.partySize || 1}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center;">${g.rsvpStatus === 'Attending' ? 'Confirmado' : g.rsvpStatus === 'Declined' ? 'Recusado' : 'Pendente'}</td>
				<td style="border: 1px solid #ccc; padding: 6px;">${g.dietary}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center;">${g.table || '-'}</td>
			`;
			printTbody.appendChild(tr);
		});

		window.print();
	});

	// 📊 Export to Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		if (guests.length === 0) {
			alert("A sua lista de convidados está vazia. Adicione convidados primeiro!");
			return;
		}

		let csv = "Nome do Convidado,Grupo,Lugares,Estado RSVP,Restrições Alimentares,Mesa,Email/Telefone\n";
		guests.forEach(g => {
			const safeName = `"${(g.name || '').replace(/"/g, '""')}"`;
			const safeGroup = `"${(g.group || '').replace(/"/g, '""')}"`;
			const safeDiet = `"${(g.dietary || '').replace(/"/g, '""')}"`;
			const safeTable = `"${(g.table || '').replace(/"/g, '""')}"`;
			const safeEmail = `"${(g.email || '').replace(/"/g, '""')}"`;
			const rsvpPt = g.rsvpStatus === 'Attending' ? 'Confirmado' : g.rsvpStatus === 'Declined' ? 'Recusado' : 'Pendente';
			csv += `${safeName},${safeGroup},${g.partySize || 1},${rsvpPt},${safeDiet},${safeTable},${safeEmail}\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Lista_Convidados_Casamento_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	function render() {
		const q = searchInput.value.toLowerCase().trim();
		const selGroup = filterGroup.value;
		const selRsvp = filterRsvp.value;

		// Filter
		const filtered = guests.filter(g => {
			const matchesQuery = !q || g.name.toLowerCase().includes(q) || (g.dietary && g.dietary.toLowerCase().includes(q)) || g.group.toLowerCase().includes(q) || (g.table && g.table.toLowerCase().includes(q));
			const matchesGroup = selGroup === 'all' || g.group === selGroup;
			const matchesRsvp = selRsvp === 'all' || g.rsvpStatus === selRsvp;
			return matchesQuery && matchesGroup && matchesRsvp;
		});

		// Calculate Stats
		const totalParties = guests.length;
		const totalSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		
		const attendingList = guests.filter(g => g.rsvpStatus === 'Attending');
		const attendingSeats = attendingList.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const pendingList = guests.filter(g => g.rsvpStatus === 'Pending');
		const pendingSeats = pendingList.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const declinedList = guests.filter(g => g.rsvpStatus === 'Declined');
		const declinedSeats = declinedList.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const dietaryCount = guests.filter(g => g.dietary && g.dietary.toLowerCase() !== 'none' && g.dietary.toLowerCase() !== 'sem restrições' && g.dietary.trim() !== '').length;

		statTotalSeats.textContent = totalSeats;
		statTotalParties.textContent = totalParties;
		statAttending.textContent = attendingSeats;
		statAttendingPct.textContent = totalSeats > 0 ? `${Math.round((attendingSeats / totalSeats) * 100)}% do total` : '0%';
		
		statPending.textContent = pendingSeats;
		statPendingPct.textContent = totalSeats > 0 ? `${Math.round((pendingSeats / totalSeats) * 100)}% do total` : '0%';

		statDeclined.textContent = declinedSeats;
		statDeclinedPct.textContent = totalSeats > 0 ? `${Math.round((declinedSeats / totalSeats) * 100)}% do total` : '0%';

		statDietary.textContent = dietaryCount;

		// Render Table
		tableBody.innerHTML = '';
		if (filtered.length === 0 && guests.length === 0) {
			tableWrap.style.display = 'none';
			emptyStateBox.style.display = 'block';
		} else {
			tableWrap.style.display = 'block';
			emptyStateBox.style.display = 'none';

			if (filtered.length === 0) {
				tableBody.innerHTML = `<tr><td colspan="6" style="padding: 2rem; text-align: center; color: var(--text-secondary); font-style: italic;">Nenhum convidado corresponde aos filtros selecionados.</td></tr>`;
			} else {
				filtered.forEach((g, idx) => {
					const tr = document.createElement('tr');
					tr.style.borderBottom = '1px solid var(--muted-paper)';
					tr.style.background = idx % 2 === 0 ? '#fff' : '#faf8f5';

					let rsvpBadgeClass = 'status-pending';
					let rsvpIcon = '⏳ Pendente';
					if (g.rsvpStatus === 'Attending') {
						rsvpBadgeClass = 'status-attending';
						rsvpIcon = '✅ Confirmado';
					} else if (g.rsvpStatus === 'Declined') {
						rsvpBadgeClass = 'status-declined';
						rsvpIcon = '❌ Recusado';
					}

					const isDietSpecial = g.dietary && g.dietary.toLowerCase() !== 'none' && g.dietary.toLowerCase() !== 'sem restrições' && g.dietary.trim() !== '';
					const dietBadge = isDietSpecial 
						? `<span style="color: var(--accent-red); font-weight: bold; background: #fee2e2; padding: 0.1rem 0.4rem; border-radius: 3px; font-size: 0.85rem;">⚠️ ${g.dietary}</span>`
						: `<span style="color: var(--text-secondary); font-size: 0.85rem;">Sem Restrições</span>`;

					tr.innerHTML = `
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							<strong style="display: block; font-size: 1.05rem; color: var(--fg-pencil);">${g.name}</strong>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">
								Lugares: <strong>${g.partySize || 1} lugar${(g.partySize || 1) > 1 ? 'es' : ''}</strong> ${g.email ? `• ${g.email}` : ''}
							</span>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							<span class="group-pill" style="background: ${groupColors[g.group] || '#e5e0d8'};">${g.group}</span>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							<span class="status-badge ${rsvpBadgeClass}" title="Clique para alternar o estado do RSVP" onclick="cycleRsvpStatus('${g.id}')">
								${rsvpIcon}
							</span>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							${dietBadge}
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper); text-align: center;">
							<span style="font-size: 0.9rem; font-weight: bold; color: var(--fg-pencil);">${g.table || '-'}</span>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper); text-align: center;">
							<button type="button" class="action-icon-btn" title="Eliminar Convidado" onclick="deleteGuestItem('${g.id}')">
								🗑️
							</button>
						</td>
					`;
					tableBody.appendChild(tr);
				});
			}
		}

		// Render Visual Distribution Bar & Legend
		chartContainer.innerHTML = '';
		chartLegend.innerHTML = '';

		if (guests.length > 0) {
			const groupCounts = {};
			guests.forEach(g => {
				const seats = parseInt(g.partySize) || 1;
				groupCounts[g.group] = (groupCounts[g.group] || 0) + seats;
			});

			Object.entries(groupCounts).forEach(([grp, count]) => {
				const pct = (count / totalSeats) * 100;
				const segment = document.createElement('div');
				segment.style.cssText = `height: 100%; width: ${pct}%; background-color: ${groupColors[grp] || '#e5e0d8'}; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;`;
				segment.title = `${grp}: ${count} lugares (${pct.toFixed(1)}%)`;
				chartContainer.appendChild(segment);

				const legItem = document.createElement('div');
				legItem.style.cssText = `display: flex; align-items: center; gap: 0.25rem;`;
				legItem.innerHTML = `
					<div style="width: 12px; height: 12px; background-color: ${groupColors[grp] || '#e5e0d8'}; border: 1px solid var(--fg-pencil); border-radius: 2px;"></div>
					<span><strong>${grp}:</strong> ${count} (${Math.round(pct)}%)</span>
				`;
				chartLegend.appendChild(legItem);
			});

			if (chartContainer.lastChild) {
				chartContainer.lastChild.style.borderRight = 'none';
			}
		} else {
			chartContainer.innerHTML = '<div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; color: var(--text-secondary); font-style: italic;">Nenhum convidado adicionado</div>';
		}
	}

	// Initialize
	loadStoredGuests();
	render();
</script>
