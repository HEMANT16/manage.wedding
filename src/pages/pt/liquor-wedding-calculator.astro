---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/liquor-wedding-calculator/#webapp",
      "name": "Calculadora de Bebidas Espirituosas & Bar Aberto de Casamento",
      "url": "https://manage.wedding/pt/liquor-wedding-calculator",
      "inLanguage": "pt",
      "description": "Calcule as quantidades exatas de garrafas de bebidas espirituosas (vodka, whisky, gin, rum, tequila), vinho, cerveja, refrigerantes, guarnições e gelo para o bar aberto do casamento com estimativa de custos em euros.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular Destilados e Bebidas Espirituosas para o Bar de Casamento",
      "description": "Guia passo a passo para calcular garrafas de destilados, refrigerantes e gelo para festas com bar aberto.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Indique o Número de Convidados Adultos e Horas de Festa",
          "text": "Introduza o total de adultos e as horas de serviço de bar aberto para calcular o total de bebidas base (Convidados × Horas × 1 Bebida/Hora)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Defina a Proporção entre Cerveja, Vinho e Espirituosas",
          "text": "Ajuste as percentagens de consumo conforme o perfil dos convidados (Padrão: 40% Vinho, 40% Espirituosas, 20% Cerveja)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Distribua os Tipos de Bebidas Brancas",
          "text": "Ajuste os rácios para Gin, Vodka, Whisky, Rum e Tequila consoante os cocktails de assinatura planeados."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Obtenha a Lista de Compras e Orçamento de Garrafeira",
          "text": "Consulte o número exato de garrafas de 750ml ou 1L, garrafas de água tónica/sumos, citrinos, quilos de gelo e orçamento estimado."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quantos cocktails ou copos rende uma garrafa de espirituosa de 750ml?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uma garrafa padrão de 750ml de destilado (gin, vodka, whisky, rum) rende cerca de 16 cocktails com uma dose clássica de 45ml a 50ml."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é a divisão recomendada de bebidas espirituosas para um bar aberto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A distribuição média de referência em eventos nupciais é: Gin (30%), Vodka (25%), Whisky (20%), Rum (15%) e Tequila/Licores (10%), com tónicas e sumos correspondentes."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto gelo é necessário para um bar aberto com cocktails?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Calcule cerca de 1 kg de gelo por convidado adulto. Os cocktails com espirituosas exigem gelo não apenas para os copos, mas também para o arrefecimento nos shakers e frappeiras de serviço."
          }
        },
        {
          "@type": "Question",
          "name": "Quantos litros de refrigerante e água tónica são necessários por garrafa de destilado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Recomenda-se cerca de 1 litro de mixer (água tónica, cola, ginger ale, sumo) para cada 4 cocktails servidos (aproximadamente duas a três garrafas de 1,5L por cada garrafa de destilado)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Bebidas Espirituosas & Bar Aberto de Casamento | Manage.Wedding"
	description="Calcule garrafas de gin, vodka, whisky, rum, vinho, cerveja, refrigerantes e gelo para o bar aberto do casamento com estimativa de custos e PDF para impressão."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Calculadora de Espirituosas e Bar Aberto" category="food-dining" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Destilados, Cocktails & Gelo</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Calculadora de Espirituosas <span class="accent-italic">& Bar Aberto</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcule as quantidades exatas de garrafas de Gin, Vodka, Whisky, Rum e Tequila — além de refrigerantes, citrinos para guarnição e gelo para um bar aberto de sucesso.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Inputs & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Configuração do Bar & Convidados
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Cálculo em Tempo Real
					</span>
				</div>

				<!-- Signature Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="bar-preset">Estilo de Bar Aberto</label>
					<select id="bar-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="classic-open-bar" selected>🍸 Bar Aberto Clássico (40% Vinho, 40% Espirituosas, 20% Cerveja)</option>
						<option value="cocktail-heavy">🍹 Festa Focada em Cocktails (50% Espirituosas, 30% Vinho, 20% Cerveja)</option>
						<option value="margarita-bourbon">🌵 Foco em Gin & Tequila (Gin Tónico + Margaritas)</option>
						<option value="beer-wine-light-liquor">🍺 Foco em Vinho e Cerveja (45% Vinho, 35% Cerveja, 20% Espirituosas)</option>
						<option value="custom">✏️ Personalizado (Definir Barras)</option>
					</select>
				</div>

				<!-- Guest Count & Duration -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="guests">Convidados Adultos (+18)</label>
						<input type="number" id="guests" class="form-input" value="120" min="10" max="600" step="5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
					<div>
						<label class="form-label" for="hours">Horas de Bar Aberto</label>
						<input type="number" id="hours" class="form-input" value="5" min="1" max="10" step="0.5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
				</div>

				<!-- Crowd Drinking Vibe & Bottle Size Format -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="vibe">Ritmo de Consumo</label>
						<select id="vibe" class="form-input" style="cursor: pointer;">
							<option value="light">Moderado (-25% de Bebidas)</option>
							<option value="average" selected>Normal (1 Bebida / Hora)</option>
							<option value="heavy">Festa Rija (+25% de Bebidas)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="bottle-size">Formato das Garrafas</label>
						<select id="bottle-size" class="form-input" style="cursor: pointer; font-weight: 600;">
							<option value="750" selected>Garrafas 750ml (16 doses)</option>
							<option value="1750">Garrafas 1,5L / 1,75L (35+ doses)</option>
						</select>
					</div>
				</div>

				<!-- Category Preference Sliders (Beer / Wine / Liquor) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil);">
							Distribuição por Categoria (%)
						</strong>
						<span id="sum-pref-check" style="font-size: 0.82rem; font-weight: 700; color: #16a34a; background: #f0fdf4; padding: 2px 6px; border-radius: 4px;">
							Total: 100%
						</span>
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍷 Vinho & Espumante</span>
							<span id="val-pref-wine">40%</span>
						</div>
						<input type="range" id="pref-wine" min="0" max="100" value="40" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍸 Espirituosas & Cocktails</span>
							<span id="val-pref-liquor">40%</span>
						</div>
						<input type="range" id="pref-liquor" min="0" max="100" value="40" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍺 Cerveja & Sidra</span>
							<span id="val-pref-beer">20%</span>
						</div>
						<input type="range" id="pref-beer" min="0" max="100" value="20" style="width: 100%; cursor: pointer;" />
					</div>
				</div>

				<!-- Spirit Type Allocation Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.75rem;">
						Divisão de Destilados (%)
					</strong>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌿 Gin (Gin Tónico, Martinis)</span>
							<span id="val-liq-gin">30%</span>
						</div>
						<input type="range" id="liq-gin" min="0" max="100" value="30" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍸 Vodka (Moscovita/Mule, Caipiroska)</span>
							<span id="val-liq-vodka">25%</span>
						</div>
						<input type="range" id="liq-vodka" min="0" max="100" value="25" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🥃 Whisky / Bourbon (Old Fashioned, Whisky Cola)</span>
							<span id="val-liq-whiskey">20%</span>
						</div>
						<input type="range" id="liq-whiskey" min="0" max="100" value="20" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌴 Rum (Mojitos, Cuba Libre)</span>
							<span id="val-liq-rum">15%</span>
						</div>
						<input type="range" id="liq-rum" min="0" max="100" value="15" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌵 Tequila & Licores (Margaritas, Shots)</span>
							<span id="val-liq-tequila">10%</span>
						</div>
						<input type="range" id="liq-tequila" min="0" max="100" value="10" style="width: 100%; cursor: pointer;" />
					</div>
				</div>

				<!-- Champagne Toast Option -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.95rem; font-weight: 600;">
						<input type="checkbox" id="check-champagne-toast" checked style="width: 18px; height: 18px;" />
						<span>Incluir Brinde de Espumante no Bolo (+1 taça / convidado)</span>
					</label>
				</div>

			</div>

			<!-- Right Column: Results & Shopping List -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Primary Results Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Total de Doses / Bebidas Estimadas
						</span>
						<span id="vibe-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							Ritmo Normal
						</span>
					</div>

					<div id="res-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						600 Bebidas
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.25rem 0;">
						Estimativa para <strong id="res-guest-count-label" style="color: var(--fg-pencil);">120 convidados</strong> durante <strong id="res-hours-label" style="color: var(--fg-pencil);">5 horas</strong> de festa.
					</p>

					<!-- Visual Split Bar -->
					<div style="display: flex; height: 28px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; margin-bottom: 1.5rem; font-size: 0.82rem; font-weight: 800; color: #fff; text-align: center; line-height: 28px;">
						<div id="chart-wine" style="background-color: var(--accent-red); width: 40%; transition: width 0.2s;">Vinho (40%)</div>
						<div id="chart-liquor" style="background-color: var(--fg-pencil); width: 40%; transition: width 0.2s;">Espirituosas (40%)</div>
						<div id="chart-beer" style="background-color: var(--accent-blue); width: 20%; transition: width 0.2s;">Cerveja (20%)</div>
					</div>

					<!-- Estimated Retail Cost Callout -->
					<div style="background: #fdf6e2; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
						<div>
							<strong style="display: block; font-size: 0.92rem; color: var(--fg-pencil);">Orçamento Estimado de Garrafeira:</strong>
							<span style="font-size: 0.82rem; color: #64748b;">(Preços médios em garrafeiras / grossistas)</span>
						</div>
						<span id="res-est-cost" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red); font-weight: 800;">
							1.350 €
						</span>
					</div>

					<!-- Itemized Shopping List Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Spirits Section -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin-bottom: 0.6rem;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🥃 Bebidas Espirituosas (<span id="bottle-size-label">Garrafas 750ml</span>)
							</strong>
							<strong id="res-total-liquor-bottles" style="color: var(--accent-red);">15 Garrafas</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Gin (Beefeater / Tanqueray / Bulldog):</span>
							<strong id="res-gin">5 gf.</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Vodka (Absolut / Smirnoff):</span>
							<strong id="res-vodka">4 gf.</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Whisky / Bourbon (Jameson / Red Label / Jack Daniel's):</span>
							<strong id="res-whiskey">3 gf.</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Rum (Bacardi / Havana Club):</span>
							<strong id="res-rum">2 gf.</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Tequila & Licores:</span>
							<strong id="res-tequila">1 gf.</strong>
						</div>

						<!-- Wine & Beer Section -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin: 1rem 0 0.6rem 0;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🍷 Vinho, Cerveja & Espumante
							</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Vinho de Mesa (750ml):</span>
							<strong id="res-wine">48 gf. (26 Tinto / 22 Branco & Rosé)</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Cerveja (Grades de 24 un):</span>
							<strong id="res-beer">5 Grades (120 Garrafas/Latas)</strong>
						</div>
						<div id="row-champagne" style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Espumante para o Brinde (750ml):</span>
							<strong id="res-champagne" style="color: var(--accent-red);">20 Garrafas</strong>
						</div>

						<!-- Mixers & Garnishes -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin: 1rem 0 0.6rem 0;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🍋 Refrigerantes, Citrinos & Gelo
							</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Refrigerantes & Água Tónica (Garrafas 1,5L/2L):</span>
							<strong id="res-mixers">30 Garrafas</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Citrinos para Guarnição:</span>
							<strong id="res-garnishes">30 Limas • 20 Limões • 12 Laranjas</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem;">
							<span>Gelo Necessário:</span>
							<strong id="res-ice">120 kg (6 × Sacos de 20kg)</strong>
						</div>

					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-shopping-list" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Lista de Compras (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar Word (.doc)
						</button>
					</div>

				</div>

				<!-- Bartending Pro Tip Callout -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						💡 Dica de Barman Profissional:
					</strong>
					<p style="margin: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<strong>Compre com Devolução de Excedentes:</strong> Muitas garrafeiras e distribuidores aceitam a devolução de caixas e garrafas intactas e não refrigeradas. Compre uma margem de segurança de +15% sem receio de desperdiçar dinheiro!
					</p>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
