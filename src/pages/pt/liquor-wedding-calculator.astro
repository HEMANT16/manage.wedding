							<tr><td><strong>Destilados</strong></td><td>Vodka</td><td>${resVodka.textContent}</td></tr>
							<tr><td><strong>Destilados</strong></td><td>Whisky</td><td>${resWhiskey.textContent}</td></tr>
							<tr><td><strong>Destilados</strong></td><td>Rum</td><td>${resRum.textContent}</td></tr>
							<tr><td><strong>Destilados</strong></td><td>Tequila & Licores</td><td>${resTequila.textContent}</td></tr>
							<tr><td><strong>Vinho</strong></td><td>Vinho de Mesa (Tinto / Branco)</td><td>${resWine.textContent}</td></tr>
							<tr><td><strong>Cerveja</strong></td><td>Grades de 24 unidades</td><td>${resBeer.textContent}</td></tr>
							<tr><td><strong>Espumante</strong></td><td>Espumante de Brinde</td><td>${resChampagne.textContent}</td></tr>
							<tr><td><strong>Refrigerantes</strong></td><td>Água Tónica, Cola, Sumos (Garrafas)</td><td>${resMixers.textContent}</td></tr>
							<tr><td><strong>Guarnições</strong></td><td>Limas, Limões, Laranjas</td><td>${resGarnishes.textContent}</td></tr>
							<tr><td><strong>Gelo</strong></td><td>Sacos de 20 kg</td><td>${resIce.textContent}</td></tr>
							<tr class="total-row"><td>ORÇAMENTO ESTIMADO</td><td>—</td><td>${resEstCost.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Lista de Compras de Bebidas</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Lista de Compras para Bar Aberto</h2>
					<p>Convidados: ${guestsInput.value} | Custo Previsto: ${resEstCost.textContent}</p>
					<table>
						<thead><tr><th>Artigo</th><th>Quantidade</th></tr></thead>
						<tbody>
							<tr><td>Gin</td><td>${resGin.textContent}</td></tr>
							<tr><td>Vodka</td><td>${resVodka.textContent}</td></tr>
