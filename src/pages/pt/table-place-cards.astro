---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/table-place-cards/#webapp",
      "name": "Criador de Marcadores de Lugar e Números de Mesa de Casamento",
      "url": "https://manage.wedding/pt/table-place-cards",
      "inLanguage": "pt",
      "description": "Gerador gratuito de marcadores de lugar e números de mesa imprimíveis para casamentos. Crie cartões dobráveis em tenda com ícones de menu, cartões planos e números de mesa com exportação instantânea para PDF, Word e CSV.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "Article",
      "headline": "Guia de Marcadores de Lugar de Casamento e Números de Mesa: Medidas, Papéis e Protocolo",
      "description": "Aprenda a diferença entre placard de mesas e marcadores individuais, gramagens ideais, técnicas de vinco e colocação de ícones de refeição para o catering.",
      "inLanguage": "pt",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Criar, Imprimir e Cortar Marcadores de Lugar de Casamento",
      "description": "Passo a passo para escolher o formato dos marcadores, incluir ícones de pratos para o catering, imprimir em cartolina de alta gramagem e cortar com precisão.",
      "inLanguage": "pt",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Escolha o Formato do Marcador e a Moldura",
          "text": "Selecione cartões dobráveis em tenda (9x5 cm dobrados) para colocar no prato, cartões planos para suporte ou cartazes de número de mesa."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Associe Convidados, Mesas e Ícones de Ementa",
          "text": "Atribua cada convidado ao seu número de mesa e escolha o ícone de refeição correspondente (carne, peixe, vegetariano) para ajudar os empregados de mesa."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Imprima em Cartolina de 220g a 300g (GSM)",
          "text": "Descarregue o PDF de alta resolução com linhas de corte e imprima em cartolina de alta gramagem na sua impressora ou numa gráfica local."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Vincar, Cortar e Organizar por Mesas",
          "text": "Utilize uma guilhotina ou régua com x-ato nas linhas de corte, vinque a dobra central e agrupe os marcadores por mesa para facilitar a montagem."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "pt",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual é a diferença entre marcador de lugar e placard de distribuição?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O placard de casamento (ou plano de mesas) fica na entrada do salão e indica aos convidados a qual mesa devem dirigir-se. O marcador de lugar fica colocado no prato ou guardanapo de cada cadeira, indicando o lugar exato e o prato escolhido."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é a gramagem ideal para imprimir marcadores de lugar tipo tenda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Recomenda-se papel ou cartolina com gramagem entre 250 g/m² e 300 g/m² (papel couché mate, linho ou reciclado kraft) para garantir que o cartão se mantenha em pé perfeitamente."
          }
        },
        {
          "@type": "Question",
          "name": "Quantos marcadores de lugar cabem numa folha A4?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Em cartões dobráveis tipo tenda (9x10 cm abertos), cabem exatamente 4 cartões por folha A4. Em marcadores planos (9x5 cm), de 8 a 10 cartões. Em números de mesa (13x18 cm), exatamente 2 cartazes por folha."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Criador de Marcadores de Lugar & Números de Mesa (PDF Grátis) | Manage.Wedding"
	description="Gere marcadores de lugar dobráveis em tenda com ícones de menu para catering, cartões planos e números de mesa. Exporte em PDF, Word e CSV grátis."
	schema={schema}
>
	<!-- Include Google Wedding Typography Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

	<!-- Include html2canvas for preview card capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Criador de Marcadores de Lugar" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Criador de Marcadores de Lugar & Números de Mesa
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Gere cartões dobráveis tipo tenda, marcadores planos e números para centros de mesa. Com <strong>ícones de pratos para catering</strong> e exportação instantânea para <strong>PDF imprimível</strong> ou <strong>Word (.doc)</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Gerar Marcadores Imprimíveis em 3 Passos Fáceis
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Escolha o Formato e Moldura
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Selecione cartões tipo tenda (9x5 cm dobrados), cartões planos ou cartazes de número de mesa.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Associe Mesas e Opções de Menu
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Adicione os convidados e ative os ícones de refeição (Carne, Peixe, Frango, Vegetariano) para os garçons.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporte em PDF e Lista Word
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clique em <strong>"🖨️ Exportar PDF / Imprimir"</strong> para as folhas de corte ou <strong>"📝 Exportar Word (.doc)"</strong> para o chefe de sala.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="placecards-calc-grid">
			
			<!-- Left Column -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🏷️ Opções de Design e Disposição
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Personalize o formato do cartão, os motivos gráficos e a distribuição por mesas
					</span>
				</div>

				<form id="placecards-form" style="display: flex; flex-direction: column; gap: 1.2rem;">
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;">
						<div>
							<label for="select-card-type" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-red); margin-bottom: 0.35rem;">
								Formato do Cartão *
							</label>
							<select id="select-card-type" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 6px; background: #fff; font-family: var(--font-body); font-size: 0.92rem; font-weight: 600; cursor: pointer;">
								<option value="tent" selected>🏷️ Cartões em Tenda Dobráveis (9x5 cm)</option>
								<option value="flat">🎴 Marcadores Planos (9x5 cm)</option>
								<option value="tablenum">🔢 Números para Centro de Mesa (13x18 cm)</option>
							</select>
						</div>

						<div>
							<label for="select-border-theme" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-blue); margin-bottom: 0.35rem;">
								Moldura Artística *
							</label>
							<select id="select-border-theme" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 6px; background: #fff; font-family: var(--font-body); font-size: 0.92rem; font-weight: 600; cursor: pointer;">
								<option value="botanical" selected>🌿 Moldura Botânica Floral</option>
								<option value="classic">✒️ Linha Dupla Clássica</option>
								<option value="crest">🏛️ Volutas & Brasão Dourado</option>
							</select>
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 6px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block;">
							⚙️ Personalizações do Marcador
						</span>
						<div style="display: flex; gap: 1.25rem; flex-wrap: wrap;">
							<label style="font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-meal-icons" checked style="accent-color: var(--brand-primary, #dc2626); width: 16px; height: 16px;">
								<span>Exibir Ícones de Ementa (🥩 / 🐟 / 🥦)</span>
							</label>
							<label style="font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-table-badge" checked style="accent-color: var(--brand-primary, #dc2626); width: 16px; height: 16px;">
								<span>Exibir Número da Mesa</span>
							</label>
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
							<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">
								👥 Lista de Mesas: <strong id="assigned-count-badge" style="color: var(--accent-red);">1 Convidado</strong>
							</span>
							<div style="display: flex; gap: 0.4rem;">
								<button type="button" id="btn-load-samples" class="hand-btn" style="padding: 0.3rem 0.65rem; font-size: 0.8rem; background: #eff6ff;">
									✨ Carregar Exemplo
								</button>
								<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.3rem 0.65rem; font-size: 0.8rem; color: #b91c1c;">
									🗑️ Limpar Tudo
								</button>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1.4fr 0.8fr 0.9fr auto; gap: 0.4rem; align-items: center;">
							<input type="text" id="input-new-guest-name" placeholder="Nome (ex. Rodrigo Silva)" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; font-family: var(--font-body);">
							<input type="text" id="input-new-table-num" placeholder="Mesa #" value="1" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; font-family: var(--font-body);">
							<select id="select-new-meal" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; background: #fff; font-family: var(--font-body);">
								<option value="🥩 Carne">🥩 Carne</option>
								<option value="🍗 Frango">🍗 Frango</option>
								<option value="🐟 Peixe">🐟 Peixe</option>
								<option value="🥦 Vegetariano">🥦 Vegetariano</option>
								<option value="🌱 Vegano">🌱 Vegano</option>
							</select>
							<button type="button" id="btn-add-guest" class="hand-btn" style="padding: 0.5rem 0.85rem; font-size: 0.88rem; background: var(--brand-primary, #dc2626); color: #fff;">
								+ Adicionar
							</button>
						</div>
					</div>
				</form>
			</div>

			<!-- Right Column: Live Card Preview -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖼️ Pré-visualização em Tempo Real
							</h3>
							<span id="preview-scale-label" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Cartão em Tenda (9x5 cm Vista Frontal)
							</span>
						</div>

						<div style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.75rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.88rem; background: #eff6ff;">
								📝 Exportar Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.88rem; background: #fef2f2; color: var(--accent-red); font-weight: 700;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.75rem; font-size: 0.88rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<div style="display: flex; justify-content: center; align-items: center; padding: 1.25rem 0; min-height: 240px; background: #f1f5f9; border-radius: 8px; border: 1.5px dashed #cbd5e1; margin-bottom: 1.25rem; overflow: hidden;">
						<div id="preview-placecard-canvas" class="card-format-tent theme-botanical"></div>
					</div>

					<button type="button" id="btn-download-sample-png" class="hand-btn" style="width: 100%; text-align: center; font-size: 0.95rem; padding: 0.6rem; background: #f0fdf4; border: 1.5px solid var(--fg-pencil);">
						📸 Descarregar Imagem PNG de Exemplo
					</button>
				</div>

				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 420px; overflow-y: auto;">
					<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						📋 Convidados por Mesa <small style="font-size: 0.8rem; font-weight: normal; color: var(--text-secondary);">(Clique para pré-visualizar)</small>
					</h3>
					<div id="table-cards-stream" style="display: flex; flex-direction: column; gap: 0.75rem;"></div>
				</div>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Regras Rápidas de Medidas & Gramagens (BLUF)
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					Especificações em 1 Minuto
				</span>
			</div>
			
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Medidas Padrão da Papelaria de Casamento:</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Marcadores em Tenda = 9 × 5 cm (4 por folha A4)</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Marcadores Planos = 9 × 5 cm (8–10 por folha A4)</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Números de Mesa = 13 × 18 cm (2 por folha A4)</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Gramagem e Legibilidade:</strong> Imprimir em cartolina de <strong>250g a 300g (GSM)</strong>. Tipografia de <strong>16–20pt</strong> para nomes, <strong>12–14pt</strong> para mesas e ícones de <strong>14–18px</strong> para a equipa de catering.
				</p>
			</div>

			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Item de Papelaria</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Medida Final</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Por Folha A4</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Gramagem Indicada</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Tamanho de Fonte</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Posição</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Cartão Dobrável (Tenda)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">9 × 5 cm (Dobrado)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">4 Cartões (Aberto: 9×10 cm)</td>
