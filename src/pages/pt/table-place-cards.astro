---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/table-place-cards/#webapp",
      "name": "Criador de Marcadores de Lugar e Números de Mesa de Casamento",
      "url": "https://manage.wedding/pt/table-place-cards",
      "inLanguage": "pt",
      "description": "Gerador gratuito de marcadores de lugar e números de mesa imprimíveis para casamentos. Crie cartões dobráveis em tenda com ícones de menu, cartões planos e números de mesa com exportação instantânea para PDF, Word e CSV.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Criar, Imprimir e Cortar Marcadores de Lugar de Casamento",
      "description": "Passo a passo para escolher o formato dos marcadores, incluir ícones de pratos para o catering, imprimir em cartolina de alta gramagem e cortar com precisão.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Escolha o Formato do Marcador e a Moldura",
          "text": "Selecione cartões dobráveis em tenda (9x5 cm dobrados) para colocar no prato, cartões planos para suporte ou cartazes de número de mesa."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Associe Convidados, Mesas e Ícones de Ementa",
          "text": "Atribua cada convidado ao seu número de mesa e escolha o ícone de refeição correspondente (carne, peixe, vegetariano) para ajudar os empregados de mesa."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Imprima em Cartolina de 220g a 300g (GSM)",
          "text": "Descarregue o PDF de alta resolução com linhas de corte e imprima em cartolina de alta gramagem na sua impressora ou numa gráfica local."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Vincar, Cortar e Organizar por Mesas",
          "text": "Utilize uma guilhotina ou régua com x-ato nas linhas de corte, vinque a dobra central e agrupe os marcadores por mesa para facilitar a montagem."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual é a diferença entre marcador de lugar e placard de distribuição?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O placard de casamento (ou plano de mesas) fica na entrada do salão e indica aos convidados a qual mesa devem dirigir-se. O marcador de lugar fica colocado no prato ou guardanapo de cada cadeira, indicando o lugar exato e o prato escolhido."
          }
        },
        {
          "@type": "Question",
          "name": "Qual a gramagem de papel recomendada para marcadores de lugar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Recomenda-se papel cartolina com gramagem entre 220g e 300g (GSM). Isso garante que os cartões em tenda se mantêm de pé com firmeza sobre o guardanapo sem dobrarem com a humidade."
          }
        },
        {
          "@type": "Question",
          "name": "Por que razão os ícones de refeição são úteis nos marcadores?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os empregados de mesa do catering conseguem identificar instantaneamente quem escolheu carne, peixe ou prato vegetariano sem precisarem de interromper as conversas dos convidados durante o serviço."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Criador de Marcadores de Lugar e Números de Mesa | Manage.Wedding"
	description="Gere marcadores de lugar dobráveis (tendas), marcadores planos e números de mesa com ícones de ementa. Exporte folhas PDF prontas a imprimir, listas Word (.doc) e CSV."
	schema={schema}
>
	<!-- Include html2canvas for preview card capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Marcadores de Lugar" category="stationery" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Marcadores de Lugar & Números de Mesa
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Gere marcadores dobráveis em tenda prontos a imprimir, marcadores planos e identificadores de mesa. Inclua <strong>ícones de ementa</strong> para o catering, personalize molduras e exporte em <strong>PDF Imprimível</strong> ou <strong>Word (.doc)</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Criar os Seus Marcadores de Lugar em 3 Passos Simples
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Escolha o Formato e a Moldura
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Selecione marcadores dobráveis em tenda (9x5 cm dobrados), cartões planos ou números grandes de centro de mesa.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Organize Mesas e Ícones de Ementa
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Adicione convidados e mesas ou clique em <strong>"✨ Carregar Exemplos"</strong>. Atribua pratos (Carne, Peixe, Vegetariano) para orientar o catering.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporte o PDF e a Lista Word
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clique em <strong>"🖨️ Exportar PDF / Imprimir"</strong> para gerar as folhas de corte ou <strong>"📝 Exportar Word (.doc)"</strong> para a lista do chefe de sala!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Config Form + Live Preview & Table Roster -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="placecards-calc-grid">
			
			<!-- Left Column: Card Configuration & Table Manager -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🏷️ Estilo do Marcador & Opções de Formato
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Personalize o tipo de cartão, molduras artísticas e atribuição de mesas
					</span>
				</div>

				<form id="placecards-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Card Type & Border Theme -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.6rem;">
						<div>
							<label for="select-card-type" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Formato do Cartão *
							</label>
							<select id="select-card-type" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
								<option value="tent" selected>🏷️ Marcadores em Tenda Dobrável (9x5 cm)</option>
								<option value="flat">🎴 Marcadores Planos (9x5 cm)</option>
								<option value="tablenum">🔢 Identificador de Mesa (13x18 cm)</option>
							</select>
						</div>

						<div>
							<label for="select-border-theme" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Tema da Moldura
							</label>
							<select id="select-border-theme" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
								<option value="botanical" selected>🌿 Moldura Botânica Floral</option>
								<option value="classic">✒️ Linha Dupla Clássica Minimalista</option>
								<option value="crest">🏛️ Arabescos Elegantes e Cantos</option>
							</select>
						</div>
					</div>

					<!-- Options: Meal Icons & Table Number Badges -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block;">
							⚙️ Opções do Marcador
						</span>
						<div style="display: flex; gap: 1rem; flex-wrap: wrap;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-meal-icons" checked style="accent-color: var(--fg-pencil);">
								<span>Mostrar Ícones de Ementa (🥩 / 🐟 / 🥦)</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-table-badge" checked style="accent-color: var(--fg-pencil);">
								<span>Mostrar Número da Mesa</span>
							</label>
						</div>
					</div>

					<!-- Quick Add Guest & Table Entry -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
							<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
								👥 Convidados com Lugar: <strong id="assigned-count-badge">0 Convidados</strong>
							</span>
							<div style="display: flex; gap: 0.3rem;">
								<button type="button" id="btn-load-samples" class="hand-btn" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; background: #eff6ff;">
									✨ Carregar Exemplos
								</button>
								<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; color: #b91c1c;">
									🗑️ Limpar Tudo
								</button>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1.3fr 0.8fr 0.9fr auto; gap: 0.35rem; align-items: center;">
							<input type="text" id="input-new-guest-name" placeholder="Nome do Convidado" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<input type="text" id="input-new-table-num" placeholder="Mesa #" value="1" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<select id="select-new-meal" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
								<option value="🥩 Carne">🥩 Carne</option>
								<option value="🍗 Frango">🍗 Frango</option>
								<option value="🐟 Peixe">🐟 Peixe</option>
								<option value="🥦 Vegetariano">🥦 Veg</option>
							</select>
							<button type="button" id="btn-add-guest" class="hand-btn" style="padding: 0.4rem 0.65rem; font-size: 0.85rem;">
								+ Adicionar
							</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Card Preview & Table Cards Stream -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Card Preview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖼️ Pré-visualização em Tempo Real
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Escala padrão de marcador de lugar (9 x 5 cm)
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Manifesto Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Interactive Preview Place Card Frame -->
					<div id="preview-placecard-canvas" class="theme-botanical" style="border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.75rem 1.25rem; background: #faf8f5; text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.25rem;">
						
						<!-- Corner accents -->
						<div style="position: absolute; top: 4px; left: 4px; width: 12px; height: 12px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 4px; right: 4px; width: 12px; height: 12px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 4px; left: 4px; width: 12px; height: 12px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 4px; right: 4px; width: 12px; height: 12px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<h2 id="prev-guest-name-display" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 0.3rem 0; line-height: 1.2;">
							Helena Santos
						</h2>

						<div style="width: 40px; height: 1.5px; background: var(--fg-pencil); margin: 0.4rem auto;"></div>

						<p id="prev-table-badge-display" class="font-body" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent-red); margin: 0.3rem 0 0 0; font-weight: bold;">
							Mesa 1
						</p>

						<div id="prev-meal-icon-display" style="position: absolute; bottom: 6px; right: 8px; font-size: 1.1rem;" title="Escolha de Prato">
							🥩
						</div>
					</div>

					<button type="button" id="btn-download-sample-png" class="hand-btn" style="width: 100%; text-align: center; font-size: 0.95rem; padding: 0.55rem; background: #f0fdf4;">
						📸 Descarregar Marcador de Exemplo em PNG
					</button>

				</div>

				<!-- Table Roster & Group Breakdown Stream -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 400px; overflow-y: auto;">
					<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						📋 Convidados Atribuídos por Mesa
					</h3>
					<div id="table-cards-stream" style="display: flex; flex-direction: column; gap: 0.75rem;">
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Manage.Wedding — Marcadores de Lugar de Casamento</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exportado em: <span id="print-date"></span> | Total de Convidados: <span id="print-guest-count"></span></p>
			</div>
			<div id="print-cards-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Resumo Direto ao Assunto (BLUF)
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					Especificações de Papelaria
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Dimensões Padrão de Marcadores:</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Marcadores em Tenda = 9 × 5 cm dobrados (4 por folha A4)</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Marcadores Planos = 9 × 5 cm (8 a 10 por folha A4)</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Identificadores de Mesa = 13 × 18 cm (2 por folha A4)</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Gramagem e Legibilidade:</strong> Imprima em <strong>cartolina de 220g a 300g (GSM)</strong>. Utilize <strong>tamanho 16–20pt</strong> para nomes de convidados, <strong>12–14pt</strong> para números de mesa e <strong>16px</strong> para os ícones de ementa.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Elemento de Papelaria</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Dimensões Finais</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Rendimento por Folha A4</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Gramagem Recomendada</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Local de Colocação</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Marcador Dobrável em Tenda</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">9 × 5 cm (Dobrado)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">4 Cartões (Aberto: 9×10 cm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">250g–300g (Auto-sustentável)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Em cima do prato / guardanapo</td>
						</tr>
						<tr style="background: #faf8f3;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Marcador Plano</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">9 × 5 cm (Padrão)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">8 a 10 Cartões</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">220g–260g Texturado / Linho</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Suporte de madeira / metal</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Número de Centro de Mesa</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">13 × 18 cm (5" × 7")</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">2 Cartazes por Folha</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">300g+ ou Moldura em Vidro/Acrílico</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Centro da mesa / arranjo floral</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- SEO Article & Comprehensive Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Manual de Papelaria de Casamento</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					Guia Completo para Marcadores de Lugar e Números de Mesa
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					Marcadores individuais vs. placard de mesa, ícones de ementa para catering, gramagem ideal e preparação de ficheiros.
				</p>
			</div>

			<div style="margin-bottom: 2.5rem; text-align: center;">
				<img 
					src="/images/seating_chart_sketch.webp" 
					alt="Marcadores de Lugar de Casamento" 
					loading="lazy"
					decoding="async"
					style="width: 100%; max-height: 420px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); margin: 0 auto; display: block;"
				/>
				<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin-top: 0.5rem; font-style: italic;">
					Marcadores de lugar elegantes organizam o salão e ajudam o catering a servir cada prato sem interrupções.
				</p>
			</div>

			<!-- Section 1: Detailed Guide -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. Como Imprimir e Dobrar Marcadores sem Vincos Danificados
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1.25rem;">
					Para obter um acabamento profissional em casa ao trabalhar com cartolina de 250g a 300g:
				</p>

				<div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.5rem;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-red); margin-bottom: 0.4rem;">
							Dica de Corte: Guilhotina de Lâmina Rotativa
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Utilize sempre uma base de corte e uma guilhotina rotativa (ou régua metálica e x-ato novo). Evite tesouras comuns para não criar bordas onduladas.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-blue); margin-bottom: 0.4rem;">
							Dica de Dobra: Dobrador de Osso ou Costas da Faca
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Antes de dobrar o cartão ao meio, passe suavemente a lombada de uma faca de manteiga ou uma dobradeira plástica ao longo da linha central com uma régua. Isto evita que as fibras do papel quebrem.
						</p>
					</div>
				</div>
			</section>

			<!-- Section 2: Related Tools -->
			<section style="margin-bottom: 3rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.5rem;">
				<h3 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 1rem; text-align: center;">
					🔗 Ferramentas de Planeamento Integradas
				</h3>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
					<a href="/pt/seating-chart-maker" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-blue); display: block;">Plano de Mesas</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Organizador visual de mesas com arrasto sincronizado.</span>
					</a>
					<a href="/pt/guest-list-manager" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-red); display: block;">Gestor de Convidados</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Faça a gestão de moradas, grupos e contactos.</span>
					</a>
					<a href="/pt/catering-cost-estimator" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--fg-pencil); display: block;">Calculadora de Catering</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Calcule custos de refeição e suplementos de bar.</span>
					</a>
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes
				</h3>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						Como exportar o manifesto de mesas para o chefe de sala?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Clique em <strong>"📝 Exportar Manifesto Word (.doc)"</strong> no topo da página. O documento descarregado inclui cada mesa com a lista completa de convidados sentados e o resumo das opções de refeição.
					</p>
				</details>
			</section>

		</article>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/pt/table-place-cards" category="stationery" />

	</main>
</Layout>

<style>
	.theme-botanical {
		background: #faf8f5 !important;
		border-color: #2d5a27 !important;
	}
	.theme-classic {
		background: #ffffff !important;
		border-color: #000000 !important;
	}
	.theme-crest {
		background: #fdfaf6 !important;
		border-color: #92400e !important;
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 15px;
		}
	}
</style>

<script is:inline>
	let seatedGuestList = [];

	const selectCardType = document.getElementById('select-card-type');
	const selectBorderTheme = document.getElementById('select-border-theme');
	const chkShowMealIcons = document.getElementById('chk-show-meal-icons');
	const chkShowTableBadge = document.getElementById('chk-show-table-badge');

	const prevGuestNameDisplay = document.getElementById('prev-guest-name-display');
	const prevTableBadgeDisplay = document.getElementById('prev-table-badge-display');
	const prevMealIconDisplay = document.getElementById('prev-meal-icon-display');
	const previewCanvas = document.getElementById('preview-placecard-canvas');

	const assignedCountBadge = document.getElementById('assigned-count-badge');
	const tableCardsStream = document.getElementById('table-cards-stream');

	function loadSeatedGuests() {
		try {
			const saved = localStorage.getItem('manage_wedding_guests');
			if (saved) {
				const all = JSON.parse(saved);
				seatedGuestList = all.filter(g => g.table && g.table.trim() !== "");
			}
		} catch (e) {
			seatedGuestList = [];
		}

		if (!seatedGuestList || seatedGuestList.length === 0) {
			loadSampleTables();
			return;
		}
		renderPlaceCards();
	}

	function loadSampleTables() {
		seatedGuestList = [
			{ name: "Helena Santos", table: "1", meal: "🥩 Carne" },
			{ name: "Tiago Ferreira", table: "1", meal: "🐟 Peixe" },
			{ name: "Mariana Lima", table: "2", meal: "🍗 Frango" },
			{ name: "David Martins", table: "2", meal: "🥦 Vegetariano" },
			{ name: "Inês Henriques", table: "3", meal: "🥩 Carne" },
			{ name: "Avó Luísa", table: "Mesa Noivos", meal: "🐟 Peixe" },
			{ name: "Avô António", table: "Mesa Noivos", meal: "🥩 Carne" }
		];
		renderPlaceCards();
	}

	function renderPlaceCards() {
		const cardType = selectCardType.value;
		const theme = selectBorderTheme.value;
		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;

		// Preview update
		previewCanvas.className = `theme-${theme}`;
		
		if (cardType === 'tablenum') {
			prevGuestNameDisplay.textContent = "Identificador de Mesa";
			prevTableBadgeDisplay.textContent = "MESA 1";
			prevTableBadgeDisplay.style.fontSize = "1.8rem";
			prevMealIconDisplay.style.display = "none";
		} else {
			if (seatedGuestList.length > 0) {
				prevGuestNameDisplay.textContent = seatedGuestList[0].name;
				prevTableBadgeDisplay.textContent = `Mesa ${seatedGuestList[0].table}`;
				prevTableBadgeDisplay.style.fontSize = "0.9rem";
				prevMealIconDisplay.textContent = (seatedGuestList[0].meal || '').split(' ')[0] || '🥩';
			} else {
				prevGuestNameDisplay.textContent = "Nome do Convidado";
				prevTableBadgeDisplay.textContent = "Mesa 1";
				prevMealIconDisplay.textContent = "🥩";
			}
			prevTableBadgeDisplay.style.display = showTable ? "block" : "none";
			prevMealIconDisplay.style.display = showMeal ? "block" : "none";
		}

		assignedCountBadge.textContent = `${seatedGuestList.length} Convidados`;

		// Group by table
		const grouped = {};
		seatedGuestList.forEach(g => {
			const tbl = g.table || 'Sem Mesa';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push(g);
		});

		tableCardsStream.innerHTML = '';
		if (seatedGuestList.length === 0) {
			tableCardsStream.innerHTML = `
				<div style="text-align: center; padding: 1rem; color: var(--text-secondary); font-style: italic; font-size: 0.9rem;">
					Nenhum convidado atribuído. Clique em "✨ Carregar Exemplos" para testar!
				</div>
			`;
			return;
		}

		Object.keys(grouped).forEach(tbl => {
			const groupBlock = document.createElement('div');
			groupBlock.style.cssText = `background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;`;
			
			let listHtml = '';
			grouped[tbl].forEach((g) => {
				listHtml += `
					<div style="display: flex; justify-content: space-between; align-items: center; padding: 0.25rem 0; border-bottom: 1px dotted #ccc; font-size: 0.88rem;">
						<span>${g.name} <small style="color:#666;">(${g.meal || 'Menu Padrão'})</small></span>
						<button type="button" class="btn-del-seat hand-btn secondary" data-name="${g.name}" style="padding: 0.15rem 0.4rem; font-size: 0.7rem; color: #b91c1c;">🗑️</button>
					</div>
				`;
			});

			groupBlock.innerHTML = `
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
					<strong class="font-heading" style="color: var(--accent-red); font-size: 1rem;">Mesa: ${tbl}</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); font-weight: bold;">${grouped[tbl].length} Sentados</span>
				</div>
				<div>${listHtml}</div>
			`;
			tableCardsStream.appendChild(groupBlock);
		});

		// Attach delete listeners
		document.querySelectorAll('.btn-del-seat').forEach(btn => {
			btn.addEventListener('click', () => {
				const gName = btn.getAttribute('data-name');
				seatedGuestList = seatedGuestList.filter(g => g.name !== gName);
				renderPlaceCards();
			});
		});
	}

	// Capture PNG
	document.getElementById('btn-download-sample-png').addEventListener('click', () => {
		if (window.html2canvas) {
			window.html2canvas(previewCanvas, {
				scale: 3,
				backgroundColor: null,
				useCORS: true
			}).then(canvas => {
				const link = document.createElement('a');
				link.download = `Marcador_Lugar_Exemplo.png`;
				link.href = canvas.toDataURL("image/png");
				link.click();
			});
		} else {
			alert("A inicializar gerador de imagem. Por favor tente novamente dentro de instantes.");
		}
	});

	// Quick Add Guest
	document.getElementById('btn-add-guest').addEventListener('click', () => {
		const nameInput = document.getElementById('input-new-guest-name');
		const tblInput = document.getElementById('input-new-table-num');
		const mealSelect = document.getElementById('select-new-meal');

		const name = nameInput.value.trim();
		const table = tblInput.value.trim() || '1';
		const meal = mealSelect.value;

		if (name) {
			seatedGuestList.push({ name, table, meal });
			nameInput.value = '';
			renderPlaceCards();
		}
	});

	// Load Sample Tables
	document.getElementById('btn-load-samples').addEventListener('click', loadSampleTables);

	// Clear All
	document.getElementById('btn-clear-all').addEventListener('click', () => {
		seatedGuestList = [];
		renderPlaceCards();
	});

	// Form Inputs Listeners
	[selectCardType, selectBorderTheme, chkShowMealIcons, chkShowTableBadge].forEach(el => {
		el.addEventListener('change', renderPlaceCards);
	});

	// 📝 Export Word Manifest (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const grouped = {};
		seatedGuestList.forEach(g => {
			const tbl = g.table || 'Sem Mesa';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push(g);
		});

		let tablesHtml = '';
		Object.keys(grouped).forEach(tbl => {
			let rows = '';
			grouped[tbl].forEach(g => {
				rows += `<tr><td>${g.name}</td><td>${g.meal || 'Menu Padrão'}</td></tr>`;
			});

			tablesHtml += `
				<h3 style="color:#1e3a8a; margin-top:20px; border-bottom:1px solid #ccc; padding-bottom:4px;">Mesa: ${tbl} (${grouped[tbl].length} Convidados)</h3>
				<table style="width:100%; border-collapse:collapse; margin-bottom:15px; font-size:12px;">
					<thead><tr style="background:#f2f2f2;"><th style="border:1px solid #ccc; padding:6px; text-align:left;">Nome do Convidado</th><th style="border:1px solid #ccc; padding:6px; text-align:left;">Opção de Prato</th></tr></thead>
					<tbody>${rows}</tbody>
				</table>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Manifesto de Mesas do Casamento</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 13px; margin-bottom: 20px; }
					th { border: 1px solid #ccc; padding: 6px; }
					td { border: 1px solid #ccc; padding: 6px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Manifesto de Mesas e Ementas de Casamento</h1>
				<p>Gerado em ${new Date().toLocaleDateString('pt-PT')} | Total de Convidados com Lugar: <strong>${seatedGuestList.length}</strong></p>
				${tablesHtml}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Manifesto_Mesas_Casamento_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print Cards
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('pt-PT');
		document.getElementById('print-guest-count').textContent = seatedGuestList.length;

		const grid = document.getElementById('print-cards-grid');
		grid.innerHTML = '';

		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;

		seatedGuestList.forEach(g => {
			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 25px 15px; text-align: center; font-family: 'Times New Roman', serif; position: relative; height: 130px; box-sizing: border-box;`;
			card.innerHTML = `
				<h2 style="font-size: 20px; margin: 10px 0 5px 0;">${g.name}</h2>
				<div style="width: 30px; height: 1px; background: #000; margin: 5px auto;"></div>
				${showTable ? `<p style="font-size: 13px; font-weight: bold; margin: 5px 0 0 0; text-transform: uppercase;">Mesa ${g.table}</p>` : ''}
				${showMeal ? `<span style="position: absolute; bottom: 8px; right: 10px; font-size: 16px;">${(g.meal || '').split(' ')[0] || '🥩'}</span>` : ''}
			`;
			grid.appendChild(card);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Nome do Convidado,Mesa,Opcao de Prato\n";
		seatedGuestList.forEach(g => {
			csv += `"${g.name}","Mesa ${g.table}","${g.meal || 'Menu Padrao'}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Marcadores_Lugar_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	loadSeatedGuests();
</script>
