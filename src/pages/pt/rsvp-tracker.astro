---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/rsvp-tracker/#webapp",
      "name": "Controlo de RSVP de Casamento & Gestão de Presenças",
      "url": "https://manage.wedding/pt/rsvp-tracker",
      "inLanguage": "pt",
      "description": "Gestor de confirmações de presença (RSVP) de casamento online e gratuito. Acompanhe presenças confirmadas, pendentes, recusas, escolhas de ementa e exporte para Word, PDF ou Excel.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Acompanhar e Gerir as Confirmações de RSVP de Casamento",
      "description": "Método prático para registar respostas, controlar escolhas de prato, contactar convidados atrasados e fechar a contagem final.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Defina o Prazo Limite de Resposta",
          "text": "Estabeleça a data limite de RSVP entre 3 a 4 semanas antes do casamento e carregue a sua lista de convidados."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Registe Confirmações e Escolhas de Menu",
          "text": "À medida que as respostas chegam, assinale se o convidado vai estar presente e registe as preferências de prato (carne, peixe, vegetariano, sem glúten)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Contacte os Convidados Pendentes",
          "text": "Filtre pelos convidados com estado 'Pendente' 48 a 72 horas após o término do prazo para enviar mensagens amigáveis de lembrete."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Feche a Lista e Exporte para o Catering",
          "text": "Descarregue a lista final em formato Word (.doc), PDF ou Excel (.csv) para entregar à quinta e equipa de catering 14 dias antes da boda."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quando deve ser a data limite de confirmação (RSVP)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A data limite ideal é entre 3 a 4 semanas antes do casamento. Isso permite dispor de 1 a 2 semanas para contactar convidados que não responderam e entregar a contagem final à quinta com 14 dias de antecedência."
          }
        },
        {
          "@type": "Question",
          "name": "Como exportar a lista de confirmações para Word, PDF ou Excel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Basta clicar no botão 'Exportar Word (.doc)', 'Exportar PDF / Imprimir' ou 'Exportar Excel (.csv)' no painel de ferramentas. O ficheiro é gerado instantaneamente no seu navegador."
          }
        },
        {
          "@type": "Question",
          "name": "Que percentagem de convidados costuma recusar o convite de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Historicamente, entre 15% a 20% dos convidados locais recusam o convite. Para casamentos com deslocação ou viagens de avião, a taxa de recusa situa-se entre 30% e 45%."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Controlo de RSVP de Casamento | Manage.Wedding"
	description="Acompanhe as confirmações de presença do seu casamento online. Controle convidados confirmados, pendentes e recusas, escolhas de pratos e exporte para Word, PDF ou Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Controlo de RSVP" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Controlo de RSVP de Casamento
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Gestão de presenças em tempo real, registo de pratos e estatísticas de resposta. Exporte a sua lista de confirmações para <strong>Word (.doc)</strong>, <strong>PDF</strong> ou <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Overview Stats & Export Dashboard -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						📈 Progresso de Respostas & Presenças
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Sincronizado automaticamente com o Gestor de Convidados e Plano de Mesas
					</span>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Exportar Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Exportar PDF / Imprimir
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Exportar Excel (.csv)
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Carregar Exemplo
					</button>
					<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🗑️ Limpar
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total de Convidados</span>
					<strong id="stat-total" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(<span id="stat-parties">0</span> convites)</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Confirmados (Sim)</span>
					<strong id="stat-attending" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-attending-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% do total</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Pendentes (Aguardando)</span>
					<strong id="stat-pending" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span id="stat-pending-pct" style="font-size: 0.75rem; color: #854d0e; display: block;">0% do total</span>
				</div>
				<div style="background: #fef2f2; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #991b1b; display: block;">Recusados (Não)</span>
					<strong id="stat-declined" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red);">0</strong>
					<span id="stat-declined-pct" style="font-size: 0.75rem; color: #991b1b; display: block;">0% do total</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Taxa de Resposta</span>
					<strong id="stat-response-rate" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">0%</strong>
					<span style="font-size: 0.75rem; color: #1e40af; display: block;">Meta: 95%+</span>
				</div>
			</div>

			<!-- Dynamic Visual Attendance Progress Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Estado Global das Respostas</span>
					<span id="stat-summary-note" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">Pronto para registar</span>
				</div>
				<div style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #e5e0d8; margin-bottom: 0.75rem;">
					<div id="bar-attending" style="height: 100%; width: 0%; background-color: #22c55e; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;" title="Confirmados"></div>
					<div id="bar-pending" style="height: 100%; width: 0%; background-color: #eab308; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;" title="Pendentes"></div>
					<div id="bar-declined" style="height: 100%; width: 0%; background-color: var(--accent-red); transition: width 0.3s ease;" title="Recusados"></div>
				</div>
				<div style="display: flex; justify-content: space-between; font-family: var(--font-body); font-size: 0.85rem;">
					<span style="color: #15803d; font-weight: bold;">🟢 Confirmados (<span id="legend-attending">0</span>)</span>
					<span style="color: #a16207; font-weight: bold;">🟡 Pendentes (<span id="legend-pending">0</span>)</span>
					<span style="color: var(--accent-red); font-weight: bold;">🔴 Recusados (<span id="legend-declined">0</span>)</span>
				</div>
			</div>
		</div>

		<!-- Workspace Grid: Add / Edit RSVP + Filterable Guest List -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 360px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="rsvp-workspace-grid">
			
			<!-- Left Column: Add / Log RSVP Response -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.25rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>📬</span> Registar Resposta de RSVP
				</h2>

				<form id="rsvp-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Guest Full Name -->
					<div>
						<label for="rsvp-name" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Nome do Convidado *
						</label>
						<input type="text" id="rsvp-name" required placeholder="ex.: Tio Roberto" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1.05rem;">
					</div>

					<!-- Group -->
					<div>
						<label for="rsvp-group" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Grupo / Afiliação
						</label>
						<select id="rsvp-group" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
							<option value="Família da Noiva">Família da Noiva</option>
							<option value="Família do Noivo">Família do Noivo</option>
							<option value="Amigas da Noiva">Amigas da Noiva</option>
							<option value="Amigos do Noivo">Amigos do Noivo</option>
							<option value="Amigos Comuns">Amigos Comuns</option>
							<option value="Padrinhos / VIP">Padrinhos / VIP</option>
							<option value="Colegas de Trabalho">Colegas de Trabalho</option>
						</select>
					</div>

					<!-- Party Size & RSVP Selection -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="rsvp-party" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Lugares / Pessoas
							</label>
							<select id="rsvp-party" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="1">1 (Individual)</option>
								<option value="2" selected>2 (Casal / +1)</option>
								<option value="3">3 (Família 3)</option>
								<option value="4">4 (Família 4)</option>
								<option value="5">5+ (Grupo)</option>
							</select>
						</div>
						<div>
							<label for="rsvp-status" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Estado do RSVP
							</label>
							<select id="rsvp-status" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="Attending">✅ Confirmado (Sim)</option>
								<option value="Pending">⏳ Pendente (Aguardando)</option>
								<option value="Declined">❌ Recusado (Não)</option>
							</select>
						</div>
					</div>

					<!-- Meal Selection / Dietary -->
					<div>
						<label for="rsvp-dietary" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Escolha de Prato / Restrições
						</label>
						<input type="text" id="rsvp-dietary" placeholder="ex.: Carne de Vitela, Vegan, Frutos Secos" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem;">
							<button type="button" class="meal-tag-btn" data-val="Carne / Vitela" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🥩 Carne</button>
							<button type="button" class="meal-tag-btn" data-val="Peixe / Bacalhau" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🐟 Peixe</button>
							<button type="button" class="meal-tag-btn" data-val="Vegetariano" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🥗 Vegetariano</button>
							<button type="button" class="meal-tag-btn" data-val="Sem Glúten" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🌾 Sem Glúten</button>
						</div>
					</div>

					<button type="submit" class="hand-btn" style="width: 100%; padding: 0.85rem; font-size: 1.15rem; margin-top: 0.5rem;">
						✨ Guardar Resposta de RSVP
					</button>

				</form>

				<!-- Follow-Up Message Copy Box -->
				<div style="margin-top: 1.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
					<strong class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
						💬 Mensagem de Lembrete de RSVP:
					</strong>
					<p id="copy-template-text" class="font-body" style="font-size: 0.9rem; line-height: 1.4; margin-bottom: 0.5rem; color: var(--fg-pencil);">
						"Olá! Estamos a fechar a contagem final de convidados com a quinta esta semana. Gostaríamos muito de saber se poderás celebrar connosco! Por favor confirma-nos até sexta-feira. ❤️"
					</p>
					<button type="button" id="btn-copy-template" class="hand-btn secondary" style="padding: 0.25rem 0.6rem; font-size: 0.8rem; width: 100%;">
						📋 Copiar Mensagem de Lembrete
					</button>
				</div>
			</div>

			<!-- Right Column: Searchable, Filterable RSVP Registry Table -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Filter & Search Bar -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
					
					<!-- Search -->
					<div style="flex: 1; min-width: 180px;">
						<input type="text" id="search-input" placeholder="🔍 Pesquisar por nome ou prato..." class="form-input" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem;">
					</div>

					<!-- RSVP Status Filter -->
					<div>
						<select id="filter-status" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Todas as Respostas</option>
							<option value="Attending">✅ Apenas Confirmados</option>
							<option value="Pending">⏳ Apenas Pendentes</option>
							<option value="Declined">❌ Apenas Recusados</option>
						</select>
					</div>

					<!-- Group Filter -->
					<div>
						<select id="filter-group" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Todos os Grupos</option>
							<option value="Família da Noiva">Família da Noiva</option>
							<option value="Família do Noivo">Família do Noivo</option>
							<option value="Amigas da Noiva">Amigas da Noiva</option>
							<option value="Amigos do Noivo">Amigos do Noivo</option>
							<option value="Amigos Comuns">Amigos Comuns</option>
							<option value="Padrinhos / VIP">Padrinhos / VIP</option>
							<option value="Colegas de Trabalho">Colegas de Trabalho</option>
						</select>
					</div>
				</div>

				<!-- Table Container -->
				<div id="rsvp-table-wrap" style="overflow-x: auto; max-height: 550px;">
					<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 1rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil); position: sticky; top: 0; z-index: 1;">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Nome do Convidado</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Grupo</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Lugares</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Estado RSVP</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Prato / Dieta</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Ações</th>
							</tr>
						</thead>
						<tbody id="rsvp-table-body">
						</tbody>
					</table>
				</div>

				<!-- Empty State Box -->
				<div id="empty-state-box" style="display: none; text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💌</div>
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">Nenhuma Resposta de RSVP Registada</h3>
					<p class="font-body" style="font-size: 1.05rem; margin-bottom: 1.25rem;">Adicione respostas usando o formulário à esquerda ou carregue os dados de exemplo.</p>
					<button type="button" id="btn-empty-sample" class="hand-btn" style="padding: 0.5rem 1.25rem; font-size: 1rem;">
						➕ Carregar Exemplos de RSVP
					</button>
				</div>

			</div>
		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Controlo Oficial de RSVP de Casamento</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado em: <span id="print-date"></span> | Total de Confirmados: <span id="print-attending-headcount"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Nome do Convidado</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Grupo</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">Lugares</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">Estado</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Opção de Prato / Dieta</th>
