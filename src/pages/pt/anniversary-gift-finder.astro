	function calculateYearsFromDate(dateStr) {
		const wedding = new Date(dateStr);
		const now = new Date();
		let y = now.getFullYear() - wedding.getFullYear();
		if (now.getMonth() < wedding.getMonth() || (now.getMonth() === wedding.getMonth() && now.getDate() < wedding.getDate())) {
			y--;
		}
		return Math.max(1, y);
	}

