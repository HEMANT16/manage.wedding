---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/anniversary-gift-finder/#webapp",
      "name": "Guia de Presentes e Bodas de Casamento por Ano",
      "url": "https://manage.wedding/pt/anniversary-gift-finder",
      "inLanguage": "pt",
      "description": "Guia gratuito de presentes e bodas de casamento por ano. Descubra os temas tradicionais e modernos, pedras preciosas, flores e ideias de prendas personalizadas por orçamento com exportação para Word e PDF.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quais são os presentes tradicionais e bodas de casamento por ano?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A tradição das bodas começa com Papel (1.º ano), Algodão (2.º), Couro (3.º), Flores/Frutas (4.º), Madeira (5.º), Ferro (6.º), Lã/Cobre (7.º), Barro (8.º), Cerâmica (9.º), Estanho (10.º), Cristal (15.º), Porcelana (20.º), Prata (25.º), Pérola (30.º), Rubi (40.º), Ouro (50.º) e Diamante (60.º)."
          }
        },
        {
          "@type": "Question",
          "name": "Como calcula a ferramenta o ano de bodas a partir da data de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ao introduzir a data do vosso casamento, o calculador mede os anos transcorridos até ao próximo aniversário e apresenta os materiais e presentes correspondentes."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é o presente ideal para o 1.º aniversário de casamento (Bodas de Papel)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para o 1.º ano (Papel), as prendas mais populares incluem os votos de casamento emoldurados, bilhetes de avião ou concertos, um mapa estelar da noite do casamento ou um álbum de fotografias do primeiro ano de casados."
          }
        },
        {
          "@type": "Question",
          "name": "Posso oferecer uma experiência ou viagem de aniversário?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Com certeza! Experiências partilhadas (como escapadinhas de fim de semana, provas de vinhos, spas a dois ou jantares românticos) são atualmente das opções mais apreciadas pelos casais."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Como Escolher a Prenda Perfeita para o Aniversário de Casamento",
      "description": "Passo a passo para identificar o ano de bodas, combinar os materiais tradicionais e selecionar uma prenda marcante.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Selecione o Ano de Bodas ou Data de Casamento",
          "text": "Escolha o aniversário correspondente (do 1.º ao 60.º ano) ou calcule automaticamente inserindo a data do casamento."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Compare os Temas Tradicionais e Modernos",
          "text": "Conheça o simbolismo dos materiais (ex.: Papel no 1.º ano, Madeira no 5.º, Prata no 25.º e Ouro no 50.º)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Descubra a Pedra Preciosa e a Flor Simbólica",
          "text": "Descubra a joalharia e a flor emblemática associadas a esse ano de celebração."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Filtre Sugestões por Orçamento e Perfil",
          "text": "Explore ideias românticas, gastronómicas, experiências a dois e presentes personalizados adaptados ao orçamento."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 5: Exporte a Proposta e a Dedicatória",
          "text": "Descarregue a proposta de presente e modelos de mensagens de amor para o cartão em Word (.doc) ou PDF."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Guia de Presentes de Aniversário de Casamento (Bodas por Ano) | Manage.Wedding"
	description="Descubra os temas tradicionais e modernos das Bodas de Casamento (1 a 60 anos). Sugestões de presentes por orçamento e exportação para Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Guia de Presentes de Aniversário de Casamento
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Descubra os materiais oficiais das <strong>Bodas de Casamento</strong>, pedras preciosas, flores simbólicas e <strong>recomendações de presentes</strong> do 1.º ao 60.º ano!
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Escolher a Prenda Ideal em 3 Passos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Escolha o Ano ou Data
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Selecione o aniversário (1.º, 2.º, 5.º, 10.º, 25.º, 50.º) ou calcule automaticamente pela data de casamento.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Defina o Estilo & Orçamento
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Escolha o perfil do parceiro (Romântico, Viagens/Experiências, Gourmet ou Casa) e o limite de valor.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Veja Sugestões & Dedicatórias
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Consulte ideias selecionadas, frases românticas para o cartão e exporte em Word ou PDF.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Quiz Form + Themes & Curated Gift Stream -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="gift-finder-grid">
			
			<!-- Left Column: Interactive Questionnaire -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🎁 Seletor de Bodas & Preferências
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Selecione o ano de bodas ou calcule pela data do casamento
					</span>
				</div>

				<form id="gift-quiz-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- 1. Milestone Year Dropdown -->
					<div>
						<label for="select-anniversary-year" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--accent-red); margin-bottom: 0.25rem;">
							1. Selecione o Ano de Bodas *
						</label>
						<select id="select-anniversary-year" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-heading); font-size: 1.05rem; background: #fff;">
							<option value="1" selected>1.º Ano — Bodas de Papel (Moderno: Relógios)</option>
							<option value="2">2.º Ano — Bodas de Algodão (Moderno: Porcelana)</option>
							<option value="3">3.º Ano — Bodas de Couro / Trigo (Moderno: Cristal)</option>
							<option value="4">4.º Ano — Bodas de Flores & Frutas (Moderno: Eletrodomésticos)</option>
							<option value="5">5.º Ano — Bodas de Madeira (Moderno: Cutelaria / Prata)</option>
							<option value="6">6.º Ano — Bodas de Açúcar / Ferro (Moderno: Madeira)</option>
							<option value="7">7.º Ano — Bodas de Latão / Lã (Moderno: Acessórios de Secretária)</option>
							<option value="8">8.º Ano — Bodas de Barro / Cobre (Moderno: Linho / Rendas)</option>
							<option value="9">9.º Ano — Bodas de Cerâmica / Vime (Moderno: Couro)</option>
							<option value="10">10.º Ano — Bodas de Estanho / Zinco (Moderno: Joias com Diamantes)</option>
							<option value="15">15.º Ano — Bodas de Cristal (Moderno: Relógios de Luxo)</option>
							<option value="20">20.º Ano — Bodas de Porcelana (Moderno: Platina)</option>
							<option value="25">25.º Ano — Bodas de Prata (Jubileu de Prata)</option>
							<option value="30">30.º Ano — Bodas de Pérola (Moderno: Diamante)</option>
							<option value="35">35.º Ano — Bodas de Coral (Moderno: Jade)</option>
							<option value="40">40.º Ano — Bodas de Rubi (Jubileu de Rubi)</option>
							<option value="45">45.º Ano — Bodas de Safira</option>
							<option value="50">50.º Ano — Bodas de Ouro (Jubileu de Ouro)</option>
							<option value="55">55.º Ano — Bodas de Esmeralda</option>
							<option value="60">60.º Ano — Bodas de Diamante (Jubileu de Diamante)</option>
						</select>
					</div>

					<!-- Optional Date Calculator Accordion -->
					<details style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<summary style="font-size: 0.88rem; font-family: var(--font-heading); color: var(--accent-blue); cursor: pointer;">
							📅 Ou Calcule Automaticamente pela Data de Casamento
						</summary>
						<div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.3rem;">
							<span style="font-size: 0.78rem; color: var(--text-secondary);">Indique a data em que casaram:</span>
							<input type="date" id="input-wedding-date" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</details>

					<!-- 2. Partner's Personality Vibe -->
					<div>
						<label for="select-partner-vibe" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							2. Perfil & Interesses do(a) Parceiro(a)
						</label>
						<select id="select-partner-vibe" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="sentimental" selected>💖 Sentimental & Romântico (Recordações, votos gravados, fotografia)</option>
							<option value="experiences">✈️ Experiências & Viagens (Escapadinhas a dois, spas, noites de hotel)</option>
							<option value="foodie">🍷 Gourmet & Enoturismo (Cabazes gourmet, degustação de vinhos)</option>
							<option value="practical">⚡ Prático & Tecnologia (Relógios, acessórios de qualidade, gadgets)</option>
							<option value="home">🏡 Conforto & Decoração (Mantas de caxemira, peças de design, plantas)</option>
						</select>
					</div>

					<!-- 3. Target Budget & Recipient -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="select-gift-budget" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								3. Orçamento Alvo
							</label>
							<select id="select-gift-budget" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="under50">Até 50 € (Gesto Simbólico)</option>
								<option value="50to150" selected>50 € - 150 € (Ponto Ideal)</option>
								<option value="150to300">150 € - 300 € (Prenda Especial)</option>
								<option value="300plus">300 €+ (Alta Joalharia & Luxo)</option>
							</select>
						</div>

						<div>
							<label for="select-recipient" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								4. A Comprar Para
							</label>
							<select id="select-recipient" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="couple" selected>Para os Dois (Casal)</option>
								<option value="her">Para Ela (Esposa / Noiva)</option>
								<option value="him">Para Ele (Marido / Noivo)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Themes & Curated Gift Stream -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Theme Overview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🎉 <span id="res-year-title">1.º Aniversário de Casamento</span>
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Símbolos oficiais e significado das bodas
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Proposta (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Dual Themes Comparison Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
						<div style="background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-red); font-weight: bold; display: block;">
								Tema Tradicional
							</span>
							<strong id="theme-traditional-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Papel
							</strong>
							<p id="theme-traditional-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Simboliza a página em branco onde começam a escrever a vossa história conjunta.
							</p>
						</div>

						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-blue); font-weight: bold; display: block;">
								Tema Moderno
							</span>
							<strong id="theme-modern-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Relógios
							</strong>
							<p id="theme-modern-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Representa a passagem preciosa do tempo e cada segundo vivido em conjunto.
							</p>
						</div>
					</div>

					<!-- Gemstone & Flower Sub-Themes -->
					<div style="display: flex; justify-content: space-around; font-size: 0.85rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.5rem; margin-bottom: 1.25rem;">
						<span>💎 Pedra / Metal: <strong id="theme-gemstone">Ouro</strong></span>
						<span>🌸 Flor: <strong id="theme-flower">Cravo</strong></span>
					</div>

					<!-- 60-Year Milestone Progress Gauge -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.25rem;">
							<span>1.º (Papel)</span>
							<span>25.º (Prata)</span>
							<span>50.º (Ouro)</span>
							<span>60.º (Diamante)</span>
						</div>
						<div style="width: 100%; height: 16px; border: 1.5px solid var(--fg-pencil); border-radius: 8px; overflow: hidden; background: #eee;">
							<div id="gauge-milestone-bar" style="width: 5%; height: 100%; background: var(--accent-red); transition: width 0.4s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Curated Gift Recommendations Stream -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						🛍️ Ideias Selecionadas de Presentes & Experiências
					</h3>
					<div id="curated-gifts-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Guia de Bodas e Presentes de Aniversário</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exportado em: <span id="print-date"></span> | Aniversário: <span id="print-milestone"></span></p>
			</div>
			<div id="print-content-body"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Resumo Rápido (BLUF)</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Tabela Resumo das Bodas de Casamento Mais Comemoradas
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>A Fórmula das Bodas:</strong> A tradição dos materiais acompanha o fortalecimento da união — começando em elementos leves e moldáveis (<strong>1.º Ano Papel</strong>, <strong>2.º Algodão</strong>, <strong>3.º Couro</strong>), avançando para estruturas sólidas (<strong>5.º Ano Madeira</strong>, <strong>10.º Estanho</strong>, <strong>15.º Cristal</strong>) e culminando em metais preciosos inalteráveis (<strong>25.º Prata</strong>, <strong>50.º Ouro</strong> e <strong>60.º Diamante</strong>).
			</p>
			
			<!-- Benchmark Anniversary Milestones Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Ano de Casamento</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Nome da Boda (Tradicional)</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Tema Moderno</th>
