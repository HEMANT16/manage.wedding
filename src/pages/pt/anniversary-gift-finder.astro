					</div>
					<strong class="font-heading" style="font-size: 0.98rem; color: var(--fg-pencil); display: block;">${item.title}</strong>
					<p class="font-body" style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.15rem 0 0 0; line-height: 1.3;">${item.desc}</p>
				</div>
			`;
			curatedGiftsContainer.appendChild(card);
		});
	}

	yearSelect.addEventListener('change', renderGifts);

	dateInput.addEventListener('change', () => {
		if (dateInput.value) {
			const calculatedYr = calculateYearsFromDate(dateInput.value);
			const options = Array.from(yearSelect.options).map(o => parseInt(o.value));
			let match = options[0];
			for (let opt of options) {
				if (opt <= calculatedYr) match = opt;
			}
			yearSelect.value = match.toString();
			renderGifts();
		}
	});

	[vibeSelect, budgetSelect, recipientSelect].forEach(el => {
		el.addEventListener('change', renderGifts);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Guia de Presentes de Aniversário</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					.box { border: 1px solid #ccc; background: #fafafa; padding: 15px; margin-bottom: 15px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Proposta de Presentes para o ${yr}.º Aniversário</h1>
				<p>Gerado em ${new Date().toLocaleDateString('pt-PT')} | Tema Tradicional: <strong>${mData.traditional}</strong> | Tema Moderno: <strong>${mData.modern}</strong></p>
				
				<div class="box">
					<h3>Simbolismo das Bodas:</h3>
					<p>• Material Tradicional: <strong>${mData.traditional}</strong> — ${mData.tDesc}</p>
					<p>• Tema Moderno: <strong>${mData.modern}</strong> — ${mData.mDesc}</p>
					<p>• Pedra Preciosa: <strong>${mData.gemstone}</strong></p>
					<p>• Flor: <strong>${mData.flower}</strong></p>
				</div>

				<div class="box">
					<h3>Sugestões de Presentes Selecionadas:</h3>
					<p>1. <strong>${mData.gift1.title}</strong> (${mData.gift1.price}) — ${mData.gift1.desc}</p>
					<p>2. <strong>${mData.gift2.title}</strong> (${mData.gift2.price}) — ${mData.gift2.desc}</p>
					<p>3. <strong>${mData.gift3.title}</strong> (${mData.gift3.price}) — ${mData.gift3.desc}</p>
				</div>

				<div class="box">
					<h3>Mensagem Romântica para o Cartão:</h3>
					<p style="font-style:italic;">"Feliz ${yr}.º aniversário de casamento, meu amor! Olhando para trás e para tudo o que construímos juntos, o meu amor e admiração por ti só aumentam a cada ano que passa. Que venham muitos mais!"</p>
				</div>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Guia_Bodas_Ano_${yr}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		document.getElementById('print-date').textContent = new Date().toLocaleDateString('pt-PT');
		document.getElementById('print-milestone').textContent = `${yr}.º Aniversário (${mData.traditional} / ${mData.modern})`;

		const body = document.getElementById('print-content-body');
		body.innerHTML = `
			<div style="border:1px solid #ccc; padding:15px; margin-bottom:15px;">
				<h2 style="margin:0 0 5px 0;">${yr}.º Ano: ${mData.traditional} & ${mData.modern}</h2>
				<p style="margin:5px 0;"><strong>Pedra:</strong> ${mData.gemstone} | <strong>Flor:</strong> ${mData.flower}</p>
				<p style="font-size:13px; color:#444;">${mData.tDesc}</p>
			</div>
			<div style="border:1px solid #ccc; padding:15px;">
				<h3 style="margin:0 0 8px 0;">Dedicatória Recomendada:</h3>
				<p style="font-style:italic; font-size:13px; margin:0;">"Feliz ${yr}.º Aniversário! Obrigado por seres o meu porto seguro, o meu amor e a minha melhor companhia. Brindemos a nós!"</p>
			</div>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		let csv = "Ano de Casamento,Tema Tradicional,Tema Moderno,Pedra,Flor,Perfil,Orcamento\n";
		csv += `"${yr}","${mData.traditional}","${mData.modern}","${mData.gemstone}","${mData.flower}","${vibeSelect.value}","${budgetSelect.value}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Bodas_Casamento_Ano_${yr}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	renderGifts();
</script>
