	function getMilestone(year) {
		if (milestoneDB[year]) return milestoneDB[year];
		const keys = Object.keys(milestoneDB).map(Number).sort((a,b) => a-b);
		let closest = keys[0];
		for (let k of keys) {
			if (k <= year) closest = k;
		}
		return milestoneDB[closest];
	}

