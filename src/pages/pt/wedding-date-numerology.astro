---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-date-numerology/#webapp",
      "name": "Calculadora de Numerologia e Compatibilidade da Data de Casamento",
      "url": "https://manage.wedding/pt/wedding-date-numerology",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de numerologia da data de casamento. Calcule os números do caminho de vida dos noivos, reduza a data da cerimónia e descubra a compatibilidade cósmica do casamento.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O que é a numerologia da data de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A numerologia da data de casamento é a prática milenar de somar e reduzir todos os dígitos do dia da celebração (dia, mês e ano) a um único algarismo de 1 a 9, revelando a energia e o arquétipo espiritual que regerá a união do casal."
          }
        },
        {
          "@type": "Question",
          "name": "Como é calculada a pontuação de compatibilidade do casal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A ferramenta calcula os Caminhos de Vida individuais de cada parceiro a partir das suas datas de nascimento e cruza-os com o número de vibração da data do casamento, gerando uma leitura de harmonia e complementaridade."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é o número mais afortunado para uma data de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não existe um número único perfeito, pois cada um traz dons especiais. Contudo, os números 2 (parceria e diplomacia) e 6 (amor incondicional, família e harmonia) são historicamente os mais procurados para celebrações de casamento."
          }
        },
        {
          "@type": "Question",
          "name": "Podemos testar várias datas antes de escolher a definitiva?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! Pode experimentar quantas datas quiser na nossa calculadora para descobrir qual ressoa melhor com a história e os desejos do vosso casal."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular a Numerologia da Sua Data de Casamento",
      "description": "Guia passo a passo para calcular o Caminho de Vida e interpretar o número de vibração do casamento.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Calcule o Caminho de Vida do(a) Parceiro(a) 1",
          "text": "Some todos os dígitos da data de nascimento (Dia + Mês + Ano) e reduza até obter um dígito de 1 a 9."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Calcule o Caminho de Vida do(a) Parceiro(a) 2",
          "text": "Faça a mesma soma com a data de nascimento do segundo parceiro até obter o seu número raiz."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Calcule o Número de Vibração do Casamento",
          "text": "Some todos os dígitos da data planeada para a cerimónia para desvendar o tema cósmico da vossa união."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Consulte o Significado e Pontuação de Harmonia",
          "text": "Analise a leitura detalhada e a pontuação de compatibilidade cósmica gerada pela nossa ferramenta."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Numerologia da Data de Casamento | Manage.Wedding"
	description="Descubra a numerologia da sua data de casamento e a compatibilidade do casal. Calcule os números do caminho de vida e a vibração espiritual do seu grande dia."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<section class="section-paper fade-in" style="min-height: 100vh; padding: 4rem 1rem;">
			<div style="max-width: 800px; margin: 0 auto;">
				
				<div class="hand-card" style="margin-bottom: 2rem;">
					<h1 class="font-heading" style="text-align: center; color: var(--fg-pencil); font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1rem;">
						Numerologia da Data de Casamento
					</h1>
					<p class="font-body" style="text-align: center; color: var(--text-secondary); margin-bottom: 2rem;">
						Introduza as vossas datas de nascimento e a data pretendida para a cerimónia para desvendar a leitura numerológica e a harmonia do casal!
					</p>
					
					<form id="numerology-form" style="display: flex; flex-direction: column; gap: 1.5rem;">
						<div>
							<label for="partner1" class="font-heading" style="display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">Data de Nascimento do(a) Parceiro(a) 1</label>
							<input type="date" id="partner1" required style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: transparent; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<div>
							<label for="partner2" class="font-heading" style="display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">Data de Nascimento do(a) Parceiro(a) 2</label>
							<input type="date" id="partner2" required style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: transparent; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<div>
							<label for="wedding-date" class="font-heading" style="display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">Data Planeada para o Casamento</label>
							<input type="date" id="wedding-date" required style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: transparent; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<button type="submit" class="hand-btn" style="width: 100%; font-size: 1.25rem; margin-top: 1rem;">Revelar Compatibilidade Cósmica</button>
					</form>
				</div>

				<div id="result-box" class="hand-card" style="margin-bottom: 3rem;">
					<h2 class="font-heading" style="color: var(--fg-pencil); margin-bottom: 1rem; font-size: 2rem;">A Vossa Leitura Numerológica</h2>
					<div id="initial-message" class="font-body" style="color: var(--text-secondary); font-style: italic;">
						Preencha o formulário acima para desvendar os segredos numéricos por detrás da vossa data!
					</div>
					
					<div id="results-content" style="display: none;">
						<div style="margin-bottom: 1.5rem;">
							<h3 class="font-heading" style="color: var(--accent-blue); font-size: 1.25rem;">Caminho de Vida do(a) Parceiro(a) 1: <span id="p1-number"></span></h3>
							<p id="p1-desc" class="font-body" style="color: var(--fg-pencil); margin-top: 0.5rem;"></p>
						</div>
						
						<div style="margin-bottom: 1.5rem;">
							<h3 class="font-heading" style="color: var(--accent-red); font-size: 1.25rem;">Caminho de Vida do(a) Parceiro(a) 2: <span id="p2-number"></span></h3>
							<p id="p2-desc" class="font-body" style="color: var(--fg-pencil); margin-top: 0.5rem;"></p>
						</div>
						
						<div style="margin-bottom: 2rem;">
							<h3 class="font-heading" style="color: var(--fg-pencil); font-size: 1.25rem;">Número de Vibração do Casamento: <span id="wd-number"></span></h3>
							<p id="wd-desc" class="font-body" style="color: var(--fg-pencil); margin-top: 0.5rem;"></p>
						</div>
						
						<div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1.5rem;">
							<h3 class="font-heading" style="text-align: center; color: var(--fg-pencil); font-size: 1.5rem;">Pontuação de Harmonia: <span id="comp-score"></span>%</h3>
							
							<div style="width: 100%; height: 24px; border: 2px solid var(--fg-pencil); border-radius: 12px; overflow: hidden; margin: 1rem 0; position: relative;">
								<div id="gauge-fill" style="width: 0%; height: 100%; background: repeating-linear-gradient(45deg, transparent, transparent 5px, var(--accent-blue) 5px, var(--accent-blue) 10px); transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);"></div>
							</div>
							
							<p id="comp-desc" class="font-body" style="text-align: center; font-style: italic; color: var(--fg-pencil);"></p>
						</div>
					</div>
				</div>

				<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
				<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
					<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Resumo Rápido (BLUF)</div>
					<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
						<span>⚡</span> Fórmula de Redução Numerológica da Data
					</h3>
					<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
						<strong>A Fórmula de 1 Minuto:</strong> Para calcular o número da sua data, some cada algarismo individual <strong>(Dia D+D + Mês M+M + Ano A+A+A+A)</strong> e continue a somar até chegar a um <strong>único dígito (1 a 9)</strong> ou a um <strong>Número Mestre (11, 22, 33)</strong>. Por exemplo, <em>14 de Outubro de 2026 (14/10/2026)</em> resulta em: <code style="background: rgba(255,255,255,0.7); padding: 2px 6px; border-radius: 3px; font-weight: bold;">(1+4) + (1+0) + (2+0+2+6) = 5 + 1 + 10 = 16 → 1 + 6 = 7 (O Buscador Espiritual)</code>.
					</p>
					
					<!-- Benchmark Numerology Chart Table -->
					<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
							<thead>
								<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
									<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Número de Vibração</th>
									<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Arquétipo Espiritual</th>
									<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Forças Principais no Casamento</th>
									<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Estilo Ideal de Casamento</th>
								</tr>
							</thead>
							<tbody>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 1</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">O Pioneiro / Líder</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Novos começos, ambição conjunta e independência mútua</td>
									<td style="padding: 0.6rem 0.8rem;">Espaço moderno e urbano com design arrojado</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 2 (Favorito)</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">O Pacificador / Parceiro</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Diplomacia, profunda intimidade emocional e união de almas</td>
									<td style="padding: 0.6rem 0.8rem; color: #16a34a; font-weight: 600;">Cerimónia em jardim à luz de velas e música acústica</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 3</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">O Criador / Alegria</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Expressão artística, muitas gargalhadas e otimismo transbordante</td>
									<td style="padding: 0.6rem 0.8rem;">Festa estilo cocktail com banda ao vivo animada</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 4</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">O Construtor / Alicerce</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Estabilidade inabalável, lealdade e raízes duradouras</td>
									<td style="padding: 0.6rem 0.8rem;">Palacete histórico ou quinta com banquete clássico</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 5</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">O Aventureiro Livre</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Exploração do mundo, espontaneidade e novas experiências</td>
									<td style="padding: 0.6rem 0.8rem;">Casamento na praia, destination wedding ou elopement</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 6 (Favorito)</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">O Cuidador / Amor</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Harmonia familiar, devoção mútua e calor incondicional</td>
									<td style="padding: 0.6rem 0.8rem; color: #16a34a; font-weight: 600;">Quinta rústica, vinha acolhedora e mesas longas partilhadas</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 7</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">O Buscador da Verdade</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Profundidade espiritual, cumplicidade íntima e sabedoria</td>
									<td style="padding: 0.6rem 0.8rem;">Cerimónia em capela histórica ou jardim botânico secreto</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 8</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">O Realizador / Sucesso</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Prosperidade material, grandes conquistas e legado conjunto</td>
									<td style="padding: 0.6rem 0.8rem;">Salão nobre luxuoso, torre de champanhe e fato formal</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 9</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">O Humanitário / Amor Universal</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Compaixão, generosidade e impacto positivo à sua volta</td>
									<td style="padding: 0.6rem 0.8rem;">Casamento ecológico sustentável com causas solidárias</td>
								</tr>
								<tr>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: #7c3aed;">Mestres 11 / 22 / 33</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Mestre Intuitivo / Arquiteto</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Frequência espiritual elevada, propósito transcendente e destino</td>
									<td style="padding: 0.6rem 0.8rem; color: #7c3aed; font-weight: 600;">Noite sob as estrelas ou celebração no solstício</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

				<article class="hand-card" style="margin-bottom: 2rem;">
					<h2 class="font-heading" style="color: var(--fg-pencil); font-size: 2rem; margin-bottom: 1.5rem;">A Magia da Numerologia no Casamento</h2>
					
					<img src="/images/pocket-watch-sketch.webp" alt="Numerologia da Data de Casamento — Compatibilidade e Caminho de Vida" loading="lazy" decoding="async" style="width: 100%; max-width: 500px; display: block; margin: 2rem auto; border: 2px solid var(--fg-pencil); border-radius: 8px;" />
					
					<div class="font-body" style="color: var(--fg-pencil); line-height: 1.6; display: flex; flex-direction: column; gap: 1rem;">
						<p>A escolha da data do casamento vai muito para além da disponibilidade da quinta ou da estação do ano. Ao explorar a <strong>numerologia da data de casamento</strong>, desvenda a vibração cósmica e o propósito espiritual da vossa união.</p>
						
						<p>Ao somar os números dos Caminhos de Vida de ambos com a data da celebração, obtém uma perspetiva inspiradora sobre as forças e energias predominantes da vossa vida a dois.</p>
					</div>

					<h3 class="font-heading" style="margin-top: 3rem; margin-bottom: 1.5rem; font-size: 1.75rem;">Perguntas Frequentes</h3>
					
					<div style="display: flex; flex-direction: column; gap: 1rem;">
						<details style="border: 2px solid var(--fg-pencil); padding: 1rem; border-radius: 4px;">
							<summary class="font-heading" style="cursor: pointer; font-size: 1.1rem; outline: none; list-style: none;">O que é a numerologia da data de casamento?</summary>
							<p class="font-body" style="margin-top: 1rem; color: var(--text-secondary);">É a prática de somar e reduzir todos os dígitos do dia do casamento até chegar a um único número que simboliza a essência da união.</p>
						</details>
						
						<details style="border: 2px solid var(--fg-pencil); padding: 1rem; border-radius: 4px;">
							<summary class="font-heading" style="cursor: pointer; font-size: 1.1rem; outline: none; list-style: none;">Qual é o número mais afortunado para casar?</summary>
							<p class="font-body" style="margin-top: 1rem; color: var(--text-secondary);">Os números 2 (parceria e equilíbrio) e 6 (amor familiar e carinho) são tradicionalmente os mais apreciados por simbolizarem harmonia e afeto duradouro.</p>
						</details>
					</div>
				</article>

			</div>
		</section>
	</main>
</Layout>

<script>
	const descriptions: Record<number, string> = {
		1: "O Líder: Energia caracterizada por independência, pioneirismo e coragem. Uma caminhada dinâmica onde constroem juntos novas conquistas com muita determinação.",
		2: "O Parceiro: Harmonia, cumplicidade e diplomacia. Traz um equilíbrio suave, profunda empatia emocional e uma ligação de almas gémeas.",
		3: "O Criador: Alegria contagiante, criatividade e comunicação. A vossa união será marcada por gargalhadas, celebrações vibrantes e inspiração constante.",
		4: "O Construtor: Estabilidade, lealdade e bases sólidas. Têm uma capacidade fantástica para construir um futuro duradouro, seguro e próspero.",
		5: "O Aventureiro: Liberdade, viagens e entusiasmo. A vossa vida a dois será uma viagem emocionante repleta de descobertas e novos horizontes.",
		6: "O Cuidador: Amor incondicional, carinho e forte sentido de família. Uma vibração acolhedora, orientada para o lar e o apoio mútuo inabalável.",
		7: "O Buscador: Espiritualidade, reflexão e cumplicidade profunda. Uma ligação intelectual e de alma que ultrapassa o superficial.",
		8: "O Realizador: Ambição, prosperidade e sucesso. Um casal poderoso capaz de alcançar grandes metas e construir um património sólido.",
		9: "O Humanitário: Compaixão, amor universal e generosidade. Uma união altruísta que espalha luz e bem-estar por todos os que vos rodeiam."
	};

	function reduceDate(dateString: string): number {
		if (!dateString) return 0;
		let sum = dateString.replace(/\D/g, '').split('').reduce((acc, digit) => acc + parseInt(digit), 0);
		while (sum > 9) {
			sum = sum.toString().split('').reduce((acc, digit) => acc + parseInt(digit), 0);
		}
		return sum || 1; 
	}

	const form = document.getElementById('numerology-form');
	if (form) {
		form.addEventListener('submit', function(e) {
			e.preventDefault();
			
			const p1Input = document.getElementById('partner1') as HTMLInputElement;
			const p2Input = document.getElementById('partner2') as HTMLInputElement;
			const wdInput = document.getElementById('wedding-date') as HTMLInputElement;
			
			if (!p1Input.value || !p2Input.value || !wdInput.value) return;
			
			const p1Num = reduceDate(p1Input.value);
			const p2Num = reduceDate(p2Input.value);
			const wdNum = reduceDate(wdInput.value);
			
			const initialMsg = document.getElementById('initial-message');
			const resultsContent = document.getElementById('results-content');
			
			if (initialMsg) initialMsg.style.display = 'none';
			if (resultsContent) resultsContent.style.display = 'block';
			
			document.getElementById('p1-number')!.textContent = p1Num.toString();
			document.getElementById('p1-desc')!.textContent = descriptions[p1Num];
			
			document.getElementById('p2-number')!.textContent = p2Num.toString();
			document.getElementById('p2-desc')!.textContent = descriptions[p2Num];
			
			document.getElementById('wd-number')!.textContent = wdNum.toString();
			document.getElementById('wd-desc')!.textContent = descriptions[wdNum];
			
			const seed = (p1Num * 3 + p2Num * 7 + wdNum * 5);
			const score = Math.floor((seed % 26) + 75);
			
			document.getElementById('comp-score')!.textContent = score.toString();
			
			const gaugeFill = document.getElementById('gauge-fill');
			if (gaugeFill) {
				gaugeFill.style.width = '0%';
				setTimeout(() => {
					gaugeFill.style.width = score + '%';
				}, 50);
			}
			
			const compDesc = document.getElementById('comp-desc');
			if (compDesc) {
				if (score >= 95) {
					compDesc.textContent = "Uma sintonia extraordinária! Os vossos astros e números estão perfeitamente alinhados para uma jornada inesquecível.";
				} else if (score >= 85) {
					compDesc.textContent = "Uma conexão maravilhosa com profunda harmonia, alegria e entendimento mútuo.";
				} else {
					compDesc.textContent = "Um vínculo sólido e resiliente, onde as vossas energias individuais se complementam com beleza.";
				}
			}
		});
	}
</script>
