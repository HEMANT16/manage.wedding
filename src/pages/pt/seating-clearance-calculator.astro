---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/seating-clearance-calculator/#webapp",
      "name": "Calculadora de Planta de Sala, Pista de Dança e Espaçamento de Mesas",
      "url": "https://manage.wedding/pt/seating-clearance-calculator",
      "inLanguage": "pt",
      "description": "Calcule as dimensões ideais da pista de dança de casamento, contagem de mesas redondas de 150 cm vs 180 cm, distâncias de circulação (regra dos 1,5m) e área total em metros quadrados (m²) necessária na quinta.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular o Tamanho da Pista de Dança e a Área da Sala de Casamento",
      "description": "Fórmula passo a passo para dimensionar a pista de dança, mesas de jantar e áreas de circulação no copo-d'água.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Estime os Dançarinos em Simultâneo (Regra dos 40%)",
          "text": "Multiplique o total de convidados por 40% a 45% (0,40–0,45) para obter o número médio de pessoas na pista nos momentos de pico."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Calcule a Área da Pista de Dança (0,45 m² por Dançarino)",
          "text": "Multiplique os dançarinos de pico por 0,45 m² por pessoa (ex.: 65 dançarinos × 0,45 m² ≈ 30 m², ou uma pista de 5 m × 6 m)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Calcule a Área das Mesas de Refeição (1,3 a 1,5 m² por Convidado)",
          "text": "Para mesas redondas de 150 cm com 8 lugares, reserve 1,3 m² por convidado, garantindo 1,5 metros de distância entre mesas para passagem de empregados."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Adicione Áreas Técnicas e Estações de Serviço",
          "text": "Some a área do palco da banda ou cabine do DJ (10–20 m²), balcões de bar aberto (20 m²), ilhas de buffet e sobremesas (15 m²)."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Que tamanho de pista de dança é necessário para 100 a 150 convidados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para 100 convidados, recomenda-se uma pista de dança de 4 m × 5 m ou 4,5 m × 4,5 m (20 m²). Para 150 convidados, a dimensão ideal é de 5 m × 6 m (30 m²)."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é a distância recomendada entre mesas de jantar num casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Deve manter-se um espaçamento mínimo de 150 cm (1,5 metros) entre os bordos das mesas. Isso assegura 45 cm para as cadeiras recuadas dos convidados e um corredor central de 60 cm para circulação fluida do serviço de catering."
          }
        },
        {
          "@type": "Question",
          "name": "Quantos metros quadrados (m²) são necessários por convidado no salão da quinta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para um copo-d'água com jantar sentado, pista de dança, bar aberto e buffet, recomenda-se entre 1,6 m² e 2,0 m² por convidado. Um casamento de 150 pessoas requer uma sala ou tenda de pelo menos 250 a 300 m²."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Planta de Sala & Pista de Dança | Manage.Wedding"
	description="Calcule as dimensões exatas da pista de dança, número de mesas redondas de 150 cm vs 180 cm, distâncias de circulação (1,5m) e área em m² para 50 a 300+ convidados."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Planta de Sala & Pista de Dança" category="guests-logistics" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Capacidade do Espaço & Pista de Dança</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Planta de Sala <span class="accent-italic">& Pista de Dança</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Defina a dimensão exata da pista de dança, o número de mesas redondas (150 cm vs 180 cm), as passagens de serviço (regra de 1,5 m de circulação) e a área total em m² necessária antes de reservar a quinta.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Guest Count, Table Style & Room Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Escala do Evento & Espaço
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Métricas em Metros (m²)
					</span>
				</div>

				<!-- Venue Layout Presets -->
				<div class="form-group">
					<label class="form-label" for="layout-preset">Modelo de Espaço / Quinta</label>
					<select id="layout-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="ballroom-150" selected>🏨 Salão de Quinta / Hotel (150 Convidados / Mesas 150cm / DJ)</option>
						<option value="tent-200">🎪 Tenda Exterior (200 Convidados / Tenda 12m × 24m / Banda ao Vivo)</option>
						<option value="barn-120">🌾 Celeiro Rústico (120 Convidados / Mesas Corridas de Madeira)</option>
						<option value="intimate-75">🏛️ Palacete / Jantar Íntimo (75 Convidados)</option>
						<option value="custom">✏️ Configuração Personalizada</option>
					</select>
				</div>

				<!-- Guest Count & Dancing Participation -->
				<div style="display: grid; grid-template-columns: 1.1fr 1.3fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="input-guests">N.º de Convidados</label>
						<input type="number" id="input-guests" class="form-input" value="150" min="20" max="600" step="5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
					<div>
						<label class="form-label" for="dance-participation">Perfil dos Convidados / Dança</label>
						<select id="dance-participation" class="form-input" style="cursor: pointer; font-size: 0.92rem;">
							<option value="0.33">Mais Velhos / Calmo (33% na Pista)</option>
							<option value="0.45" selected>Padrão Animado (45% na Pista)</option>
							<option value="0.60">Grupo Jovem / Festa Total (60% na Pista)</option>
						</select>
					</div>
				</div>

				<!-- Table Shape & Seating Density -->
				<div class="form-group">
					<label class="form-label" for="table-style">Formato das Mesas de Jantar</label>
					<select id="table-style" class="form-input" style="cursor: pointer;">
						<option value="round-60" selected>Mesas Redondas 150 cm (8 a 9 Lugares — Confortável)</option>
						<option value="round-72">Mesas Redondas 180 cm (10 a 11 Lugares — Espaços Grandes)</option>
						<option value="rect-8ft">Mesas Corridas Retangulares 240 cm (8 Lugares)</option>
					</select>
				</div>

				<!-- Venue Dimensions (Optional Check) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Dimensões da Sala da Quinta (Verificação Opcional)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="room-length" style="font-size: 0.9rem;">Comprimento da Sala (m)</label>
							<input type="number" id="room-length" class="form-input" value="18" min="5" step="1" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="room-width" style="font-size: 0.9rem;">Largura da Sala (m)</label>
							<input type="number" id="room-width" class="form-input" value="15" min="5" step="1" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Entertainment & Service Buffers -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Zonas de Apoio, Música & Bar
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-band" style="width: 18px; height: 18px;" />
							<span>Palco de Banda ao Vivo (20 m²) vs Cabine de DJ (10 m²)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-buffet" checked style="width: 18px; height: 18px;" />
							<span>Bancadas de Buffet e Sobremesas (15 m²)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-bar-stations" checked style="width: 18px; height: 18px;" />
							<span>Dois Pontos de Bar Aberto / Cocktails (20 m²)</span>
						</label>
					</div>
				</div>

			</div>

			<!-- Right Column: Results, Dance Floor Sizing & Capacity Check -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Clearance & Dance Floor Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Dimensão Recomendada da Pista
						</span>
						<span id="dance-tile-count-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							30 Placas Modulares (1×1m)
						</span>
					</div>

					<div id="display-dance-dimensions" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						5,0 m × 6,0 m (30 m²)
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Projetada para <strong id="display-peak-dancers" style="color: var(--fg-pencil);">68 pessoas na pista</strong> (45% de 150 convidados @ 0,45 m²/pessoa).
					</p>

					<!-- Itemized Space Breakdown Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<strong style="display: block; font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--fg-pencil);">
							📐 Repartição da Área do Salão:
						</strong>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span>Mesas de Jantar (<strong id="display-tables-needed">19 Mesas</strong>):</span>
							<strong id="display-dining-sqft">195 m²</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span>Pista de Dança:</span>
							<strong id="display-dance-sqft">30 m²</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span>Bares, Buffet e Zona Musical:</span>
							<strong id="display-production-sqft">45 m²</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.5rem 0 0 0; font-size: 1.05rem; font-weight: 700; color: var(--accent-red);">
							<span>ÁREA TOTAL MÍNIMA RECOMENDADA:</span>
							<strong id="display-total-room-needed">270 m²</strong>
						</div>
					</div>

					<!-- Venue Room Fit Evaluation Alert -->
					<div id="room-capacity-alert" style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem; font-size: 0.9rem; color: #166534; line-height: 1.5;">
						<strong id="alert-fit-title">✅ Espaço Ideal (270 m² Disponíveis):</strong><br />
						<span id="alert-fit-body">A sala de 18m × 15m acomoda perfeitamente as 19 mesas, a pista de dança e assegura corredores de 1,5 metros entre mesas.</span>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-floorplan" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Planta & Metragens (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar em Word
						</button>
					</div>

				</div>

				<!-- Table Clearance & ADA Rules Card -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						📏 A Regra de 1,5 Metros de Distância entre Mesas:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Borda a Borda:</strong> Mantenha pelo menos <strong>1,5 metros (150 cm)</strong> entre as bordas de cada mesa redonda. Isso permite aos convidados afastar as cadeiras confortavelmente e deixa um corredor livre de 60 cm para os empregados passarem com os tabuleiros.</li>
						<li><strong>Distância às Paredes:</strong> Mantenha as mesas a pelo menos <strong>1 metro</strong> das paredes e janelas.</li>
						<li><strong>Mesa dos Noivos:</strong> Coloque a mesa dos noivos a <strong>3 metros</strong> da pista de dança para garantir fotografias limpas e visibilidade total sobre a sala.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumo Direto ao Assunto (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Tabela Rápida: Dimensão de Pistas de Dança e Área do Espaço (m²)
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Guia de consulta rápida correlacionando número de convidados (50 a 250), dimensões em metros, número de mesas e área total do salão.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					🕺 A Fórmula Universal da Pista de Dança:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Área da Pista (m²) = [Total de Convidados × 0,45 (Pico de Dançarinos)] × 0,45 m² • Área Total Necessária na Quinta = 1,6 m² a 2,0 m² por pessoa.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">N.º de Convidados</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Dimensões da Pista</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Placas (1×1m)</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Mesas 150cm (8 pax)</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Área Total da Sala</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">50 – 75 Convidados</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">3,5 m × 4,0 m (14 m²)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">14 Placas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">7 – 10 Mesas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">120 – 150 m²</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">100 – 125 Convidados</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">4,5 m × 5,0 m (22 m²)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">22 Placas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">13 – 16 Mesas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">180 – 220 m²</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">150 – 175 Convidados</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">5,0 m × 6,0 m (30 m²)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">30 Placas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">19 – 22 Mesas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">250 – 300 m²</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">200 – 250 Convidados</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">6,0 m × 7,0 m (42 m²)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">42 Placas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">25 – 32 Mesas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">350 – 420 m²</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guia Completo de Espaçamento e Planta de Sala de Casamento
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Como planear a disposição de mesas, evitar aglomerações no bar e garantir energia máxima na pista de dança.
				</p>
			</div>

			<!-- Section 1: Dance Floor Psychology -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. A Psicologia da Pista de Dança (Maior NÃO é Necessariamente Melhor)
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Um dos erros mais frequentes na escolha de espaços é sobrestimar a pista de dança. Uma pista demasiado grande dá a sensação de festa vazia, intimidando os convidados mais tímidos. Uma pista compacta e vibrante convida toda a gente a juntar-se ao grupo:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>A Regra dos 40%:</strong> Em média, entre 35% a 50% dos convidados estão na pista em simultâneo (os restantes estão no bar, a conversar ou no photobooth).</li>
					<li><strong>0,45 m² por Dançarino:</strong> Espaço suficiente para dançar sem choques mantendo o ambiente caloroso.</li>
				</ul>
			</section>

			<!-- Section 2: Outdoor Tent Dimensions -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Dimensões Típicas de Tendas para Casamentos Exteriores
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Se optar por uma tenda no jardim ou vinha, as dimensões padrão recomendadas são:
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>🎪 Tendas em Metros:</strong><br />
					• <strong>100 Convidados:</strong> Tenda 10m × 20m (200 m²)<br />
					• <strong>150 Convidados:</strong> Tenda 12m × 24m (288 m²)<br />
					• <strong>200 Convidados:</strong> Tenda 15m × 25m ou 12m × 30m (360–375 m²)
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Perguntas Frequentes
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Onde deve ficar localizado o bar aberto?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Coloque o bar afastado da porta de entrada e perto da pista de dança para facilitar o fluxo de convidados sem criar filas na entrada do salão.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Quantas pessoas cabem numa mesa redonda de 150 cm?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Uma mesa redonda de 150 cm (5 pés) senta confortavelmente 8 a 9 convidados com pratos de apresentação, marcadores e copos.
					</p>
				</details>
			</section>

		</article>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/pt/seating-clearance-calculator" category="logistics" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('layout-preset');
		const guestsInput = document.getElementById('input-guests');
		const dancePartSelect = document.getElementById('dance-participation');
		const tableStyleSelect = document.getElementById('table-style');

		const roomLengthInput = document.getElementById('room-length');
		const roomWidthInput = document.getElementById('room-width');

		const checkBand = document.getElementById('check-band');
		const checkBuffet = document.getElementById('check-buffet');
		const checkBars = document.getElementById('check-bar-stations');

		const danceTileBadge = document.getElementById('dance-tile-count-badge');
		const displayDanceDimensions = document.getElementById('display-dance-dimensions');
		const displayPeakDancers = document.getElementById('display-peak-dancers');

		const displayTablesNeeded = document.getElementById('display-tables-needed');
		const displayDiningSqft = document.getElementById('display-dining-sqft');
		const displayDanceSqft = document.getElementById('display-dance-sqft');
		const displayProductionSqft = document.getElementById('display-production-sqft');
		const displayTotalRoomNeeded = document.getElementById('display-total-room-needed');

		const roomCapacityAlert = document.getElementById('room-capacity-alert');
		const alertFitTitle = document.getElementById('alert-fit-title');
		const alertFitBody = document.getElementById('alert-fit-body');

		const btnPrint = document.getElementById('btn-print-floorplan');
		const btnDoc = document.getElementById('btn-export-doc');

		function calculateFloorPlan() {
			const guests = parseInt(guestsInput.value, 10) || 1;
			const dancerPct = parseFloat(dancePartSelect.value) || 0.45;
			const tableStyle = tableStyleSelect.value;

			// Dance Floor Math in Metric (0.45 m2 per dancer)
			const peakDancers = Math.round(guests * dancerPct);
			const danceSqm = Math.round(peakDancers * 0.45);
			const side = Math.round(Math.sqrt(danceSqm));
			const danceL = Math.max(4, side);
			const danceW = Math.max(3.5, Math.round((danceSqm / danceL) * 10) / 10);
			const actualDanceSqm = Math.round(danceL * danceW);
			const tileCount = actualDanceSqm; // 1x1m tiles

			// Table Math
			let seatsPerTable = 8;
			let sqmPerGuest = 1.3;
			let tableTypeName = 'Mesas Redondas 150 cm';

			if (tableStyle === 'round-60') {
				seatsPerTable = 8;
				sqmPerGuest = 1.3;
				tableTypeName = 'Mesas Redondas 150 cm (8 lugares)';
			} else if (tableStyle === 'round-72') {
				seatsPerTable = 10;
				sqmPerGuest = 1.5;
				tableTypeName = 'Mesas Redondas 180 cm (10 lugares)';
			} else if (tableStyle === 'rect-8ft') {
				seatsPerTable = 8;
				sqmPerGuest = 1.2;
				tableTypeName = 'Mesas Retangulares 240 cm (8 lugares)';
			}

			const tablesCount = Math.ceil(guests / seatsPerTable);
			const diningSqm = Math.round(guests * sqmPerGuest);

			// Production & Buffers in m2
			let productionSqm = 0;
			if (checkBand.checked) productionSqm += 20; // Band stage
			else productionSqm += 10; // DJ Booth

			if (checkBuffet.checked) productionSqm += 15;
			if (checkBars.checked) productionSqm += 20;

			const totalRoomNeeded = diningSqm + actualDanceSqm + productionSqm;

			// Room Fit Evaluation
			const rLength = parseFloat(roomLengthInput.value) || 0;
			const rWidth = parseFloat(roomWidthInput.value) || 0;
			const roomAvailableSqm = Math.round(rLength * rWidth);

			// Update UI
			danceTileBadge.textContent = `${tileCount} Placas (1×1m)`;
			displayDanceDimensions.textContent = `${danceL} m × ${danceW} m (${actualDanceSqm} m²)`;
			displayPeakDancers.textContent = `${peakDancers} pessoas na pista`;

			displayTablesNeeded.textContent = `${tablesCount} ${tableTypeName}`;
			displayDiningSqft.textContent = `${diningSqm.toLocaleString()} m²`;
			displayDanceSqft.textContent = `${actualDanceSqm.toLocaleString()} m²`;
			displayProductionSqft.textContent = `${productionSqm.toLocaleString()} m²`;
			displayTotalRoomNeeded.textContent = `${totalRoomNeeded.toLocaleString()} m²`;

			if (roomAvailableSqm > 0) {
				if (roomAvailableSqm >= totalRoomNeeded) {
					const surplus = roomAvailableSqm - totalRoomNeeded;
					roomCapacityAlert.style.display = 'block';
					roomCapacityAlert.style.background = '#f0fdf4';
					roomCapacityAlert.style.borderColor = '#16a34a';
					roomCapacityAlert.style.color = '#166534';
					alertFitTitle.textContent = `✅ Espaço Confortável (${roomAvailableSqm.toLocaleString()} m² Disponíveis):`;
					alertFitBody.textContent = `A sala de ${rLength}m × ${rWidth}m acomoda as ${tablesCount} mesas, a pista de dança e deixa uma margem de ${surplus.toLocaleString()} m² para circulação desafogada.`;
				} else {
					const deficit = totalRoomNeeded - roomAvailableSqm;
					roomCapacityAlert.style.display = 'block';
					roomCapacityAlert.style.background = '#fef2f2';
					roomCapacityAlert.style.borderColor = '#ef4444';
					roomCapacityAlert.style.color = '#991b1b';
					alertFitTitle.textContent = `⚠️ Espaço Apertado (Défice de ${deficit.toLocaleString()} m²):`;
					alertFitBody.textContent = `A sala de ${rLength}m × ${rWidth}m (${roomAvailableSqm.toLocaleString()} m²) pode ficar congestionada. Considere usar mesas redondas de 180 cm (10 pax/mesa) ou reduzir estações fixas.`;
				}
			} else {
				roomCapacityAlert.style.display = 'none';
			}
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'ballroom-150') {
				guestsInput.value = 150;
				dancePartSelect.value = '0.45';
				tableStyleSelect.value = 'round-60';
				roomLengthInput.value = 18;
				roomWidthInput.value = 15;
				checkBand.checked = false;
				checkBuffet.checked = true;
				checkBars.checked = true;
			} else if (p === 'tent-200') {
				guestsInput.value = 200;
				dancePartSelect.value = '0.45';
				tableStyleSelect.value = 'round-60';
				roomLengthInput.value = 24;
				roomWidthInput.value = 12;
				checkBand.checked = true;
				checkBuffet.checked = true;
				checkBars.checked = true;
			} else if (p === 'barn-120') {
				guestsInput.value = 120;
				dancePartSelect.value = '0.45';
				tableStyleSelect.value = 'rect-8ft';
				roomLengthInput.value = 18;
				roomWidthInput.value = 12;
				checkBand.checked = false;
				checkBuffet.checked = true;
				checkBars.checked = true;
			} else if (p === 'intimate-75') {
				guestsInput.value = 75;
				dancePartSelect.value = '0.33';
				tableStyleSelect.value = 'round-60';
				roomLengthInput.value = 14;
				roomWidthInput.value = 10;
				checkBand.checked = false;
				checkBuffet.checked = false;
				checkBars.checked = true;
			}
			calculateFloorPlan();
		});

		// Live Listeners
		[guestsInput, dancePartSelect, tableStyleSelect, roomLengthInput, roomWidthInput, checkBand, checkBuffet, checkBars].forEach(inp => {
			inp.addEventListener('input', calculateFloorPlan);
			inp.addEventListener('change', calculateFloorPlan);
		});

		// Print Floor Plan Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Planta de Sala e Pista de Dança — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Planta do Salão & Pista de Dança</h1>
					<p>Convidados: ${guestsInput.value} | Área Total Necessária: ${displayTotalRoomNeeded.textContent}</p>
					
					<table>
						<thead><tr><th>Elemento do Salão</th><th>Especificações / Quantidade</th><th>Área (m²)</th></tr></thead>
						<tbody>
							<tr><td><strong>Pista de Dança</strong></td><td>${displayDanceDimensions.textContent} (${danceTileBadge.textContent})</td><td>${displayDanceSqft.textContent}</td></tr>
							<tr><td><strong>Mesas de Jantar</strong></td><td>${displayTablesNeeded.textContent}</td><td>${displayDiningSqft.textContent}</td></tr>
							<tr><td><strong>Palco, Buffet & Bar</strong></td><td>Música, Buffet, 2 Bares</td><td>${displayProductionSqft.textContent}</td></tr>
							<tr class="total-row"><td>ÁREA TOTAL MÍNIMA RECOMENDADA</td><td>—</td><td>${displayTotalRoomNeeded.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Planta de Sala e Pista de Dança</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Especificações da Planta do Salão</h2>
					<p>Convidados: ${guestsInput.value} | <strong>Área Total: ${displayTotalRoomNeeded.textContent}</strong></p>
					<table>
						<thead><tr><th>Componente</th><th>Detalhes</th><th>Área</th></tr></thead>
						<tbody>
							<tr><td>Pista de Dança</td><td>${displayDanceDimensions.textContent} (${danceTileBadge.textContent})</td><td>${displayDanceSqft.textContent}</td></tr>
							<tr><td>Mesas de Jantar</td><td>${displayTablesNeeded.textContent}</td><td>${displayDiningSqft.textContent}</td></tr>
							<tr><td>Apoio e Bares</td><td>Bares, Buffet, DJ/Banda</td><td>${displayProductionSqft.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL</td><td>—</td><td>${displayTotalRoomNeeded.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'planta-sala-casamento.doc';
			link.click();
		});

		// Initial Calculation
		calculateFloorPlan();
	</script>
</Layout>
