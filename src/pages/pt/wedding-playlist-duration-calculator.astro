	function renderBlacklist() {
		const listContainer = document.getElementById('blacklist-songs-list');
		const counter = document.getElementById('blacklist-counter');
		
		const checkedGenres = Array.from(document.querySelectorAll('.chk-banned-genre:checked')).map(c => c.value);
		const totalBanned = checkedGenres.length + bannedSongsList.length;
		counter.textContent = `${totalBanned} Bloqueadas`;

		if (bannedSongsList.length === 0) {
			listContainer.innerHTML = '<p style="font-size:0.85rem; color:var(--text-secondary); text-align:center; margin:0.5rem 0;">Nenhuma música individual proibida.</p>';
			return;
