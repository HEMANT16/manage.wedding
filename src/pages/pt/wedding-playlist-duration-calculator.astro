---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/pt/wedding-playlist-duration-calculator/#webapp",
      "name": "Calculadora de Playlist de Casamento, Músicas para DJ e Duração",
      "url": "https://manage.wedding/pt/wedding-playlist-duration-calculator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de playlist de casamento e gerador de briefing para DJ ou banda. Calcule o número exato de músicas para cerimônia, recepção, jantar e pista de dança com exportação para PDF e Word.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "BRL"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quantas músicas são necessárias para uma festa de casamento de 6 horas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para um casamento completo de 6 horas (360 minutos), tocam-se cerca de 100 a 120 músicas (considerando 3,5 minutos por faixa completa ou 2,5 minutos em transições dinâmicas de DJ). Recomenda-se preparar uma seleção com 20% de margem (aproximadamente 130 a 140 músicas) para garantir flexibilidade ao DJ."
          }
        },
        {
          "@type": "Question",
          "name": "Quantas músicas indispensáveis (Must-Play) devemos passar para o DJ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os melhores DJs de casamento recomendam limitar a lista de músicas obrigatórias a 15 ou no máximo 20 faixas. Uma lista engessada com mais de 50 faixas impede o profissional de sentir a energia dos convidados e dosar os momentos certos da pista."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto tempo deve durar a primeira dança dos noivos e a dança com os pais?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A duração perfeita para a primeira dança dos recém-casados é de 2:30 a 3 minutos. Músicas com mais de 3 minutos no centro dos holofotes costumam cansar os noivos e dispersar a atenção dos convidados. Peça ao DJ um fade-out suave aos 2 minutos e meio ou combine para convidar padrinhos e amigos para a pista."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Como Planejar a Playlist de Casamento e o Briefing do DJ",
      "description": "Passo a passo para calcular a quantidade de faixas, definir os momentos marcantes com minutagem e exportar a ficha técnica do evento.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Ajuste a Duração de Cada Momento",
          "text": "Defina os minutos do prelúdio, coquetel, jantar e pista de dança para calcular a quantidade de músicas."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Escolha os Momentos Especiais e Instruções de Áudio",
          "text": "Selecione as faixas para entrada dos noivos, primeira dança, corte do bolo e buquê com as marcações de fade-out."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Monte a Lista de Favoritas e a Lista Negra",
          "text": "Adicione até 20 músicas obrigatórias e bloqueie ritmos ou faixas indesejadas."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Exporte o Briefing do DJ (PDF e Word)",
          "text": "Baixe o documento completo e envie diretamente para o profissional ou banda contratada."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Playlist de Casamento, Músicas DJ e Duração (Briefing PDF & Word) | Manage.Wedding"
	description="Calcule o número exato de músicas para seu casamento, planeje as danças especiais com minutagem de áudio, crie listas obrigatórias e proibidas, e baixe o briefing para o DJ."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Playlist & Músicas para DJ" category="guests-logistics" />
		
		<!-- Hero & Cabeçalho -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🎵</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Grátis • No Seu Navegador • Download Rápido em PDF e Word</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de Playlist de Casamento & Músicas DJ
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 740px; margin: 0 auto; text-align: center;">
					Calcule a quantidade exata de músicas para cada fase, planeje as danças com minutos de corte exatos, monte sua <strong>Lista de Favoritas e Lista Negra</strong> e exporte o <strong>Briefing Oficial para o DJ ou Banda</strong> em PDF e Word!
				</p>
			</div>
		</section>

		<!-- Guia Rápido em 3 Passos -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>🎧</span> Planeje a Música do Casamento em 3 Passos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Duração e Ritmo BPM
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Ajuste os controles para cerimônia, recepção, jantar e pista para calcular o total de faixas.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Momentos Especiais
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Defina as músicas para entrada dos noivos, primeira dança, corte do bolo e buquê com notas de áudio.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Listas & Exportar PDF
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Cadastre até 20 músicas obrigatórias, bloqueie faixas indesejadas e gere o PDF do briefing.
					</p>
				</div>
			</div>
		</div>

		<!-- Área de Trabalho Interativa -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SEÇÃO 1: Controles de Tempo & Cálculo de Músicas -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🎚️ 1. Duração das Fases & Quantidade de Músicas
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Estime o número de faixas de acordo com o estilo de transição do DJ
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center;">
						<label for="select-mix-pacing" class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil);">
							Estilo DJ:
						</label>
						<select id="select-mix-pacing" style="padding: 0.35rem 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem; font-weight: 600;">
							<option value="radio" selected>Músicas de Rádio Completas (~3.5 min / 17 músicas/h)</option>
							<option value="quickmix">Transições Rápidas DJ (~2.7 min / 22 músicas/h)</option>
							<option value="lounge">Acústico & Lounge Extenso (~4.2 min / 14 músicas/h)</option>
						</select>
					</div>
				</div>

				<!-- Grid Controles -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
					
					<!-- Prelúdio -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-prelude" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🎻</span> Prelúdio / Cerimônia
							</label>
							<span id="val-prelude" class="font-heading" style="font-size: 1rem; color: var(--accent-red); font-weight: 700;">30 min</span>
						</div>
						<input type="range" id="slider-prelude" min="15" max="60" step="5" value="30" style="width: 100%; accent-color: var(--accent-red);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>15 min</span>
							<span id="songs-prelude" style="font-weight: 600; color: var(--fg-pencil);">~9 faixas (60-80 BPM)</span>
							<span>60 min</span>
						</div>
					</div>

					<!-- Coquetel -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-cocktail" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍸</span> Coquetel de Boas-Vindas
							</label>
							<span id="val-cocktail" class="font-heading" style="font-size: 1rem; color: var(--accent-blue); font-weight: 700;">60 min</span>
						</div>
						<input type="range" id="slider-cocktail" min="30" max="120" step="5" value="60" style="width: 100%; accent-color: var(--accent-blue);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>30 min</span>
							<span id="songs-cocktail" style="font-weight: 600; color: var(--fg-pencil);">~17 faixas (90-115 BPM)</span>
							<span>120 min</span>
						</div>
					</div>

					<!-- Jantar -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dinner" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍽️</span> Almoço / Jantar
							</label>
							<span id="val-dinner" class="font-heading" style="font-size: 1rem; color: #d97706; font-weight: 700;">90 min</span>
						</div>
						<input type="range" id="slider-dinner" min="45" max="150" step="5" value="90" style="width: 100%; accent-color: #d97706;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>45 min</span>
							<span id="songs-dinner" style="font-weight: 600; color: var(--fg-pencil);">~25 faixas (70-95 BPM)</span>
							<span>150 min</span>
						</div>
					</div>

					<!-- Pista de Dança -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dance" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🕺</span> Festa & Pista de Dança
							</label>
							<span id="val-dance" class="font-heading" style="font-size: 1rem; color: #16a34a; font-weight: 700;">180 min (3.0h)</span>
						</div>
						<input type="range" id="slider-dance" min="60" max="360" step="15" value="180" style="width: 100%; accent-color: #16a34a;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>1 hora</span>
							<span id="songs-dance" style="font-weight: 600; color: var(--fg-pencil);">~52-60 faixas (118-132 BPM)</span>
							<span>6 horas</span>
						</div>
					</div>

					<!-- After -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-afterparty" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🌙</span> Madrugada / After
							</label>
							<span id="val-afterparty" class="font-heading" style="font-size: 1rem; color: #7c3aed; font-weight: 700;">0 min</span>
						</div>
						<input type="range" id="slider-afterparty" min="0" max="120" step="15" value="0" style="width: 100%; accent-color: #7c3aed;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>0 min (Off)</span>
							<span id="songs-afterparty" style="font-weight: 600; color: var(--fg-pencil);">0 faixas</span>
							<span>120 min</span>
						</div>
					</div>

				</div>

				<!-- Resumo Numérico -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; background: var(--muted-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; text-align: center;">
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Tempo Total de Música</span>
						<strong id="display-total-runtime" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil);">6h 00m (360 min)</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Músicas Tocadas Reais</span>
						<strong id="display-exact-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue);">~103 Faixas</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Playlist Sugerida (+20% Margem)</span>
						<strong id="display-buffered-tracks" class="font-heading" style="font-size: 1.6rem; color: #16a34a;">~125 Faixas</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Faixas para a Festa</span>
						<strong id="display-dance-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red);">~52 Faixas</strong>
					</div>
				</div>

			</div>

			<!-- SEÇÃO 2: Momentos Especiais & Instruções de Áudio -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							💃 2. Momentos Marcantes & Instruções de Minutagem
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Escolha sugestões consagradas ou preencha com as músicas e minutos de corte desejados
						</span>
					</div>
					<button type="button" id="btn-autofill-special" class="hand-btn" style="padding: 0.3rem 0.7rem; font-size: 0.8rem; background: #eff6ff;">
						✨ Carregar Clássicos
					</button>
				</div>

				<div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" id="special-moments-container">
					<!-- Gerado por JS -->
				</div>
			</div>

			<!-- SEÇÃO 3: Lista de Favoritas e Lista Negra -->
			<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 1fr; gap: 1.5rem;">
				
				<!-- Box Favoritas -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.25rem; color: #16a34a; margin: 0;">
								⭐ Músicas Obrigatórias (Must-Play)
							</h3>
							<span class="font-body" style="font-size: 0.8rem; color: var(--text-secondary);">
								Meta: 10–20 faixas (permite ao DJ sentir o público)
							</span>
						</div>
						<span id="must-play-counter" class="badge-postit" style="font-size: 0.85rem;">0 / 20 Faixas</span>
					</div>

					<!-- Adicionar Rápido -->
					<div style="margin-bottom: 1rem; background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<span class="font-heading" style="font-size: 0.8rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem;">
							⚡ Sucessos Imperdíveis para Dançar:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;" id="quick-must-pills">
							<button type="button" class="btn-quick-add hand-btn" data-title="Não Quero Dinheiro" data-artist="Tim Maia" data-phase="Pista" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Tim Maia</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="September" data-artist="Earth, Wind & Fire" data-phase="Pista" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ September</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Cheia de Manias" data-artist="Raça Negra" data-phase="Pista" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Raça Negra</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Dancing Queen" data-artist="ABBA" data-phase="Pista" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ ABBA</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Evidências" data-artist="Chitãozinho & Xororó" data-phase="Pista" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Evidências</button>
						</div>
					</div>

					<!-- Form Adicionar -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 0.9fr auto; gap: 0.4rem; margin-bottom: 1rem;">
						<input type="text" id="input-must-title" placeholder="Título (ex. Levitating)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<input type="text" id="input-must-artist" placeholder="Artista (ex. Dua Lipa)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<select id="select-must-phase" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.8rem; background: #fff;">
							<option value="Pista de Dança">Pista</option>
							<option value="Coquetel">Coquetel</option>
							<option value="Jantar">Jantar</option>
							<option value="Hino de Fim de Noite">Fim de Noite</option>
						</select>
						<button type="button" id="btn-add-must" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background: #16a34a; color: #fff;">+ Adicionar</button>
					</div>

					<!-- Lista -->
					<div id="must-play-list" style="max-height: 280px; overflow-y: auto; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #faf8f5; padding: 0.5rem;">
						<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin: 1rem 0;">Nenhuma música obrigatória adicionada ainda.</p>
					</div>
				</div>

				<!-- Box Lista Negra -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
