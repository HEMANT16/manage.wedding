---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Calculadora de Prendas em Dinheiro para Casamento & Previsão de Ofertas",
      "url": "https://manage.wedding/pt/gift-cash-calculator",
      "inLanguage": "pt",
      "description": "Calculadora gratuita de prendas em dinheiro para casamentos. Calcule o valor ideal para o envelope de dinheiro (modo convidado) ou faça a previsão total das prendas a receber (modo noivos). Exporte mensagens e valores para Word, PDF ou Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Como Calcular o Valor Certo da Prenda em Dinheiro para um Casamento",
      "description": "Guia de etiqueta prático para calcular quanto dinheiro oferecer no envelope com base no grau de proximidade, acompanhante e custos de deslocação.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Avalie o Grau de Proximidade com os Noivos",
          "text": "Parta das referências habituais: 75 € a 100 € para colegas de trabalho, 100 € a 175 € para amigos próximos/primos, e 150 € a 300 €+ para padrinhos e família direta."
        },
        {
          "@type": "HowToStep",
          "name": "Ajuste para Casal ou Acompanhante (+1)",
          "text": "Se levar acompanhante ou par, multiplique o valor de referência por 1,8x para cobrir dois lugares no copo-d'água."
        },
        {
          "@type": "HowToStep",
          "name": "Considere Deslocações e Custos de Padrinho",
          "text": "Reduza entre 20% e 25% se já gastou valores elevados em voos, alojamento em hotel ou vestuário de dama de honor/padrinho."
        },
        {
          "@type": "HowToStep",
          "name": "Entregue o Envelope com um Postal com Mensagem Sentida",
          "text": "Coloque as notas novas ou o comprovativo de transferência num envelope acompanhado por um postal com votos calorosos e personalizados."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanto dinheiro se deve dar como prenda de casamento em Portugal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para um colega ou conhecido: 75 € a 100 €. Para um amigo próximo ou primo: 125 € a 175 €. Para família direta (irmãos, tios chegados, pais) ou padrinhos: 200 € a 400 €+. Se for acompanhado pelo seu par, o valor médio habitual situa-se entre 200 € e 300 € por casal."
          }
        },
        {
          "@type": "Question",
          "name": "A regra de 'pagar o prato' ainda se aplica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A regra de 'pagar o prato' é hoje considerada um mito desatualizado pela etiqueta moderna. Foi convidado como amigo ou familiar querido para celebrar um momento único, e não como cliente de um restaurante. A sua prenda deve refletir o carinho que tem pelos noivos e o que o seu orçamento pessoal permite confortavelmente."
          }
        },
        {
          "@type": "Question",
          "name": "Deve-se dar menos dinheiro se o casamento for longe (Destination Wedding)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Se teve de despender 300 € a 1.000 € em viagens de avião, combustível ou noites de hotel para estar presente, a sua própria deslocação física é uma prenda valiosa para os noivos. Uma prenda simbólica de 50 € a 100 € ou um postal emotivo é perfeitamente respeitoso."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto dinheiro recebem os noivos em média no total das prendas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Num casamento típico com 100 a 120 convidados em Portugal, os noivos costumam arrecadar entre 11.000 € e 16.000 € no total dos envelopes e transferências bancárias, correspondendo a uma média de 100 € a 135 € por convidado presente."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Prendas em Dinheiro para Casamento (Etiqueta & Envelopes) | Manage.Wedding"
	description="Calcule quanto oferecer no envelope de casamento ou faça a previsão total das prendas a receber pelos noivos. Guia completo com exportação de mensagens para Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de Prendas em Dinheiro
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Determine o montante justo do envelope com base na etiqueta atual, proximidade, acompanhante e despesas de viagem — ou <strong>estime o valor total de prendas monetárias</strong> para o vosso casamento!
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Como Usar Esta Calculadora em 3 Passos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Escolha o Modo da Calculadora
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Selecione <strong>"Modo Convidado"</strong> (calcular o envelope) ou <strong>"Modo Noivos"</strong> (prever o total de prendas em numerário/transferência).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Ajuste Proximidade e Deslocações
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indique se vai acompanhado, despesas com viagens e hotéis, funções de padrinho/madrinha e o estilo do espaço.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporte Mensagens e Resumo
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clique em <strong>"📝 Exportar Mensagens Word"</strong> ou <strong>"🖨️ Exportar PDF"</strong> para obter sugestões de dedicatórias para o postal de felicitações!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Config Form + Live Results & Breakdown -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="gift-calc-grid">
			
			<!-- Left Column: Input Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Mode Switcher Tabs -->
				<div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<button type="button" id="tab-guest-mode" class="mode-tab-btn active-tab" style="flex: 1; padding: 0.55rem; font-family: var(--font-heading); font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer;">
						🎁 Sou Convidado (Minha Prenda)
					</button>
					<button type="button" id="tab-couple-mode" class="mode-tab-btn" style="flex: 1; padding: 0.55rem; font-family: var(--font-heading); font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; background: var(--bg-paper);">
						💒 Somos os Noivos (Previsão Global)
					</button>
				</div>

				<!-- GUEST MODE FORM -->
				<div id="section-guest-mode">
					<form id="guest-gift-form" style="display: flex; flex-direction: column; gap: 1rem;">
						
						<!-- Closeness to Couple -->
						<div>
							<label for="select-relationship" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								1. Grau de Relação com os Noivos *
							</label>
							<select id="select-relationship" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
								<option value="175">👑 Família Direta / Irmão(ã) / Padrinho / Melhor Amigo (150 € - 250 €+)</option>
								<option value="125" selected>🌸 Amigo Próximo / Tios / Primos Diretos (100 € - 175 €)</option>
								<option value="90">🤝 Amigo / Família Alargada / Vizinho (75 € - 125 €)</option>
								<option value="65">💼 Colega de Trabalho / Conhecido (50 € - 90 €)</option>
							</select>
						</div>

						<!-- Attendance & Plus-One -->
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<label for="select-attendance" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Quem vai ao Casamento?
								</label>
								<select id="select-attendance" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
									<option value="1.0">Individual (Apenas Eu)</option>
									<option value="1.8" selected>Casal (Eu + Par / Acompanhante)</option>
									<option value="2.3">Família (Casal + Filhos)</option>
								</select>
							</div>

							<div>
								<label for="select-venue-tier" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Estilo do Casamento
								</label>
								<select id="select-venue-tier" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
									<option value="1.0">Quinta Tradicional / Espaço de Eventos</option>
									<option value="1.25">Palacete Histórico / Gala de Luxo (+25%)</option>
									<option value="0.85">Casamento Íntimo / Rústico / Civil (-15%)</option>
								</select>
							</div>
						</div>

						<!-- Offsets: Travel & Wedding Party -->
						<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
							<span class="font-heading" style="font-size: 0.88rem; color: var(--fg-pencil); display: block;">
								✈️ Fatores de Ajuste de Etiqueta:
							</span>
							
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-destination-travel" style="accent-color: var(--fg-pencil);">
								<span>Paguei voos/hotel para casamento longe (Desconto de etiqueta: -25%)</span>
							</label>

							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-bridal-party-role" style="accent-color: var(--fg-pencil);">
								<span>Sou Padrinho / Dama de Honor (Despesas elevadas em despedida/roupa: -20%)</span>
							</label>
						</div>

					</form>
				</div>

				<!-- COUPLE MODE FORM (HIDDEN INITIALLY) -->
				<div id="section-couple-mode" style="display: none;">
					<form id="couple-gift-form" style="display: flex; flex-direction: column; gap: 1rem;">
						
						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-guest-count" class="font-heading" style="font-size: 0.95rem; color: var(--accent-red);">
									Total de Convidados Confirmados
								</label>
								<span id="display-guest-count" style="font-size: 1.1rem; font-weight: bold; color: var(--accent-red);">120 Convidados</span>
							</div>
							<input type="range" id="input-guest-count" min="20" max="350" value="120" step="5" style="width: 100%; accent-color: var(--accent-red);">
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<label for="select-couple-venue-tier" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Estilo da Receção
								</label>
								<select id="select-couple-venue-tier" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="1.0" selected>Quinta Tradicional (110 €/convidado)</option>
									<option value="1.3">Gala de Grande Luxo (145 €/convidado)</option>
									<option value="0.85">Casamento Íntimo / Rústico (90 €/convidado)</option>
								</select>
							</div>

							<div>
								<label for="select-destination-mode" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
									Localização do Evento
								</label>
								<select id="select-destination-mode" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="1.0" selected>Casamento Local / Concelho</option>
									<option value="0.75">Casamento com Deslocação de Convidados</option>
								</select>
							</div>
						</div>

						<p class="font-body" style="font-size: 0.82rem; color: var(--text-secondary); line-height: 1.4; margin: 0; background: var(--bg-paper); padding: 0.6rem; border-radius: 4px;">
							*Pressupõe uma distribuição realista entre família direta (30%), amigos chegados (40%), colegas (20%) e padrinhos (10%).
						</p>

					</form>
				</div>

				<!-- Currency Selector -->
				<div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.3rem; margin-top: 1rem; border-top: 1px dashed #ccc; padding-top: 0.75rem;">
					<span style="font-size: 0.85rem; font-weight: bold;">Moeda:</span>
					<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
						<option value="€" selected>€ (EUR)</option>
						<option value="R$">R$ (BRL)</option>
						<option value="$">$ (USD)</option>
						<option value="£">£ (GBP)</option>
						<option value="CHF">CHF</option>
					</select>
				</div>

			</div>

			<!-- Right Column: Live Results & Card Message Recommendations -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Gift Result Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 id="res-card-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								✉️ Prenda Recomendada em Dinheiro
							</h3>
							<span id="res-card-subtitle" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Normas de etiqueta de casamento em vigor
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Mensagens Word
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Exportar PDF / Imprimir
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Gift Range Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span id="res-range-label" class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Montante Sugerido para o Envelope</span>
						<strong id="res-primary-amount" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">225 €</strong>
						<span id="res-range-subtext" style="font-size: 0.85rem; color: var(--accent-red);">Intervalo Confortável: 200 € - 250 €</span>
					</div>

					<!-- Detailed Math Breakdown List -->
					<div style="margin-bottom: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil); margin-bottom: 0.4rem; text-align: center;">
							🧾 Fatores de Cálculo
						</h4>
						<ul id="res-factors-list" class="font-body" style="list-style: none; padding: 0; margin: 0; font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.35rem; color: var(--fg-pencil);">
							<li style="display:flex; justify-content:space-between; border-bottom:1px solid #eee; padding-bottom:0.2rem;">
								<span>Referência de Proximidade:</span> <strong id="fact-base">125 €</strong>
							</li>
							<li style="display:flex; justify-content:space-between; border-bottom:1px solid #eee; padding-bottom:0.2rem;">
								<span>Presença (Casal):</span> <strong id="fact-attendance">x 1.8</strong>
							</li>
							<li style="display:flex; justify-content:space-between; border-bottom:1px solid #eee; padding-bottom:0.2rem;">
								<span>Ajustes de Espaço e Deslocação:</span> <strong id="fact-adjustments">1.0x (Padrão)</strong>
							</li>
						</ul>
					</div>

					<!-- Visual Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Simbólico (50 €)</span>
							<span>Padrão (150 €)</span>
							<span style="color: var(--accent-red);">Generoso (300 €+)</span>
						</div>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="gift-gauge-bar" style="width: 55%; height: 100%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Ready-to-Write Card Wishes Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem; text-align: center;">
						💌 Sugestão de Mensagem para o Postal:
					</strong>
					<p id="card-wish-text" class="font-body" style="font-size: 0.88rem; line-height: 1.45; margin: 0; color: var(--fg-pencil); font-style: italic; text-align: center;">
						"Desejo-vos uma vida inteira repleta de amor, cumplicidade e grandes aventuras! Que esta lembrança vos ajude a criar momentos inesquecíveis na vossa lua de mel."
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Manage.Wedding — Guia de Prendas de Casamento & Mensagens</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exportado a: <span id="print-date"></span> | Prenda Sugerida: <span id="print-amount"></span></p>
			</div>
			<div id="print-content-body"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 2.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumo Direto ao Assunto (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Regra Prática: Valores Padrão para Envelopes de Casamento
				</h2>
