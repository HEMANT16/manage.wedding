---
import Layout from '../../layouts/Layout.astro';

const title = "Ferramentas de Papelaria, Convites & Lembranças de Casamento (Gratuito) | Manage.Wedding";
const description = "Ferramentas gratuitas de papelaria: endereçamento de envelopes, formatos de convites, calculadora de portes e selos, marcadores de lugar, discursos e bodas de casamento.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/pt/stationery/#collection",
      "name": "Ferramentas de Papelaria, Convites & Criatividade de Casamento",
      "url": "https://manage.wedding/pt/stationery",
      "inLanguage": "pt",
      "description": "Conjunto completo de ferramentas para papelaria de casamento: formatação de sobrescritos, formatos de convites e envelopes, cálculo de portes de correio, marcadores de mesa e temporizador de discursos.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Endereçamento de Envelopes & Caligrafia", "url": "https://manage.wedding/pt/wedding-envelope-addressing" },
        { "@type": "WebApplication", "name": "Formatos de Convites & Envelopes", "url": "https://manage.wedding/pt/wedding-invitation-suite-sizer" },
        { "@type": "WebApplication", "name": "Calculadora de Portes e Selos", "url": "https://manage.wedding/pt/wedding-invitation-postage-calculator" },
        { "@type": "WebApplication", "name": "Marcadores de Lugar e Mesa", "url": "https://manage.wedding/pt/table-place-cards" },
        { "@type": "WebApplication", "name": "Textos de Cartões de Agradecimento", "url": "https://manage.wedding/pt/wedding-thank-you-cards" },
        { "@type": "WebApplication", "name": "Convites de Casamento Digitais", "url": "https://manage.wedding/pt/digital-invitations" },
        { "@type": "WebApplication", "name": "Temporizador de Discursos & Votos", "url": "https://manage.wedding/pt/wedding-speech-calculator" },
        { "@type": "WebApplication", "name": "Gerador de Hashtags de Casamento", "url": "https://manage.wedding/pt/wedding-hashtag-generator" },
        { "@type": "WebApplication", "name": "Numerologia da Data de Casamento", "url": "https://manage.wedding/pt/wedding-date-numerology" },
        { "@type": "WebApplication", "name": "Bodas de Casamento & Ideias de Presente", "url": "https://manage.wedding/pt/anniversary-gift-finder" }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "pt",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quais são as dimensões padrão para convites de casamento e envelopes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os formatos mais comuns na Europa são: Convite Principal A5 (14,8 × 21 cm) ou 12 × 18 cm (5\"×7\") com Envelope C5 (16,2 × 22,9 cm) ou 13 × 19 cm, e Cartão de RSVP ou Detalhes A6 (10,5 × 14,8 cm)."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto tempo deve durar o discurso do padrinho ou da dama de honor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A duração ideal situa-se entre 3 e 5 minutos (cerca de 400 a 600 palavras lidas a um ritmo calmo de 120 a 130 palavras por minuto). Discursos com mais de 6 minutos tornam-se cansativos para a audiência."
          }
        },
        {
          "@type": "Question",
          "name": "Como endereçar corretamente os envelopes de convite de casamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segundo a etiqueta tradicional portuguesa: para casais casados com filhos 'Exmo. Senhor e Senhora Silva e Filhos' ou 'Família Silva'; para casais casados 'Exmo. Senhor [Nome] e Esposa'; para casais solteiros 'Exma. Senhora [Nome] e Exmo. Senhor [Nome]'; e para convidados solteiros com acompanhante '[Nome do Convidado] e Acompanhante'."
          }
        }
      ]
    }
  ]
};

const stationeryTools = [
  {
    title: "Calculadora de Duração de Playlist",
    url: "/pt/wedding-playlist-duration-calculator",
    icon: "🎵",
    badge: "Minutagem Musical",
    desc: "Calcule músicas necessárias por bloco (cocktail, jantar, primeira dança e pista). Inclui cronograma para o DJ e lista 'Não Tocar'.",
    tags: ["Música de Casamento", "Músicas por Hora", "Guia para o DJ"]
  },

  {
    title: "Endereçamento de Envelopes & Caligrafia",
    url: "/pt/wedding-envelope-addressing",
    icon: "✉️",
    badge: "Etiqueta & PDF",
    desc: "Formatação correta de tratamentos formais para casais, famílias, padrinhos e acompanhantes com impressão direta em PDF e Word.",
    tags: ["Envelopes", "Tratamentos Formais", "PDF & Word"]
  },
  {
    title: "Formatos de Convites & Envelopes",
    url: "/pt/wedding-invitation-suite-sizer",
    icon: "📐",
    badge: "Gráfica 300 DPI",
    desc: "Calcule as dimensões milimétricas para convites A5, 12x18 cm, cartões de RSVP A6 e margens de corte para impressão profissional.",
    tags: ["Formatos A5/A6", "Margens de Corte", "Canva 300 DPI"]
  },
  {
    title: "Calculadora de Portes e Selos",
    url: "/pt/wedding-invitation-postage-calculator",
    icon: "📮",
    badge: "Correios",
    desc: "Calcule o peso exato do conjunto do convite (gramagens de 250 a 350 g/m²), selos de cera, fitas e taxas de envio postal.",
    tags: ["Selo de Cera", "Gramagem Papel", "Taxas de Envio"]
  },
  {
    title: "Marcadores de Lugar e Mesa",
    url: "/pt/table-place-cards",
    icon: "🏷️",
    badge: "Pronto a Imprimir",
    desc: "Gere marcadores de lugar dobráveis em formato tenda com numeração de mesa e ícones de refeição (carne, peixe, vegetariano).",
    tags: ["PDF para Imprimir", "Marcadores de Tenda", "Ícones de Prato"]
  },
  {
    title: "Textos de Cartões de Agradecimento",
    url: "/pt/wedding-thank-you-cards",
    icon: "✍️",
    badge: "Mensagens & Votos",
    desc: "Modelos de mensagens elegantes e personalizadas para agradecer presentes em dinheiro, artigos da lista de casamento e presenças.",
    tags: ["Agradecimento", "Prendas em Dinheiro", "Textos de Etiqueta"]
  },
  {
    title: "Convites de Casamento Digitais",
    url: "/pt/digital-invitations",
    icon: "💌",
    badge: "Convites Online",
    desc: "Crie Save-the-Date e convites virtuais interativos com botão para adicionar ao calendário (.ics) e confirmação digital.",
    tags: ["Save-the-Date", "Calendário .ics", "RSVP Digital"]
  },
  {
    title: "Temporizador de Discursos & Votos",
    url: "/pt/wedding-speech-calculator",
    icon: "🎙️",
    badge: "Cronómetro & Cartões",
    desc: "Cole o texto do seu discurso ou votos para calcular o tempo de fala (110–130 palavras/min), pausas e gerar cartões para o púlpito.",
    tags: ["Ritmo de Fala", "Cartões de Apoio", "Votos Nupciais"]
  },
  {
    title: "Gerador de Hashtags de Casamento",
    url: "/pt/wedding-hashtag-generator",
    icon: "#️⃣",
    badge: "50+ Ideias",
    desc: "Gere mais de 50 opções de hashtags românticos e criativos para os convidados partilharem fotografias com placas decorativas.",
    tags: ["Hashtags Redes Sociais", "Placas de Mesa", "Criatividade"]
  },
  {
    title: "Numerologia da Data de Casamento",
    url: "/pt/wedding-date-numerology",
    icon: "✨",
    badge: "Significado",
    desc: "Descubra o número do caminho de vida da vossa união, harmonia energética e o simbolismo da data escolhida para a cerimónia.",
    tags: ["Caminho de Vida", "Compatibilidade", "Significado da Data"]
  },
  {
    title: "Bodas de Casamento & Ideias de Presente",
    url: "/pt/anniversary-gift-finder",
    icon: "💎",
    badge: "Do 1º ao 60º Ano",
    desc: "Guia completo de bodas tradicionais e modernas (Papel, Prata, Ouro, Diamante), flores, pedras preciosas e ideias de presentes.",
    tags: ["Bodas de Prata & Ouro", "Presentes Simbólicos", "Mensagens Românticas"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Papelaria & Criatividade</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Ferramentas de <span class="accent-italic">Papelaria & Criatividade</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Formate endereços de envelopes com etiqueta, dimensione convites e cartões de RSVP, calcule portes de correio e cronometre discursos de casamento.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Categorias:</span>
      <a href="/pt/budget" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Orçamento</a>
      <a href="/pt/dining" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Banquete & Bar</a>
      <a href="/pt/guests" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">👥 Convidados & Logística</a>
      <a href="/pt/stationery" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">💌 Papelaria (Ativo)</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {stationeryTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
            Abrir Ferramenta →
          </a>
        </div>
      ))}
    </div>

    <!-- Stationery Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Etiqueta & Design</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          Guia de Dimensões e Envio de Convites de Casamento
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Dimensões milimétricas, gramagens recomendadas de papel e dicas postais para evitar custos desnecessários.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. Hierarquia de Formatos de Convites
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Para garantir que todos os elementos cabem perfeitamente dentro do envelope principal sem dobrar, utilize dimensões coordenadas:
        </p>
        
        <div style="overflow-x: auto; margin-top: 1rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Elemento da Papelaria</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Dimensão Padrão (cm / mm)</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Gramagem Recomendada</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Envelope Principal (C5 / 13×19 cm)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">13,5 × 19,5 cm ou 16,2 × 22,9 cm</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">120 g/m² a 160 g/m²</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Convite Principal (A5 / 12×18 cm)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">12,0 × 18,0 cm ou 14,8 × 21,0 cm</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">280 g/m² a 350 g/m² (algodão ou texturado)</td>
              </tr>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Cartão de RSVP / Confirmação</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">9,0 × 13,0 cm ou 10,5 × 14,8 cm (A6)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">250 g/m² a 300 g/m²</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Marcador de Lugar Dobrado</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">9,0 × 5,0 cm (dobrado) / 9,0 × 10,0 cm (aberto)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">250 g/m² a 300 g/m²</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Perguntas Frequentes sobre Papelaria e Convites
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Quais são as dimensões padrão para convites de casamento e envelopes?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Os formatos mais comuns na Europa são: Convite Principal A5 (14,8 × 21 cm) ou 12 × 18 cm (5"×7") com Envelope C5 (16,2 × 22,9 cm) ou 13 × 19 cm, e Cartão de RSVP ou Detalhes A6 (10,5 × 14,8 cm).
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Quanto tempo deve durar o discurso do padrinho ou da dama de honor?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              A duração ideal situa-se entre 3 e 5 minutos (cerca de 400 a 600 palavras lidas a um ritmo calmo de 120 a 130 palavras por minuto). Discursos com mais de 6 minutos tornam-se cansativos para a audiência.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Como endereçar corretamente os envelopes de convite de casamento?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Segundo a etiqueta tradicional portuguesa: para casais casados com filhos 'Exmo. Senhor e Senhora Silva e Filhos' ou 'Família Silva'; para casais casados 'Exmo. Senhor [Nome] e Esposa'; para casais solteiros 'Exma. Senhora [Nome] e Exmo. Senhor [Nome]'; e para convidados solteiros com acompanhante '[Nome do Convidado] e Acompanhante'.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
