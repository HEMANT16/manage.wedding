---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Elena Foster — Lead Wedding Financial Strategist & Author | Manage.Wedding";
const description = "Meet Elena Foster: 35-year-old Lead Wedding Financial Strategist, mother of two, and hospitality director with 12+ years of luxury wedding management experience.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": "https://manage.wedding/authors/elena-foster#profile",
      "name": "Elena Foster Author Profile",
      "url": "https://manage.wedding/authors/elena-foster",
      "description": "Editorial author profile and credentials for Elena Foster, Lead Wedding Financial Strategist at Manage.Wedding.",
      "mainEntity": {
        "@type": "Person",
        "@id": "https://manage.wedding/authors/elena-foster#person",
        "name": "Elena Foster",
        "jobTitle": "Lead Wedding Financial Strategist & Hospitality Director",
        "description": "Elena Foster is a 35-year-old mother of two daughters and a veteran wedding financial strategist with 12+ years in luxury estate banquet management and independent bridal coordination, having managed over 400 weddings.",
        "worksFor": {
          "@type": "Organization",
          "name": "Manage.Wedding",
          "url": "https://manage.wedding"
        },
        "knowsAbout": [
          "Wedding Budget Optimization",
          "Hospitality & Catering Contract Negotiation",
          "Open Bar Alcohol Calculations",
          "Day-Of Timeline Engineering",
          "Vendor Service Fees & Tipping Etiquette",
          "Venue Contract Hidden Cost Auditing"
        ]
      }
    }
  ]
};

const articles = [
  {
    category: "💰 Venue & Budget Strategy",
    items: [
      { title: "Wedding Venue Hidden Costs & 15 Contract Red Flags", url: "/wedding-venue-hidden-costs-contract-red-flags" },
      { title: "The 50/15/10/10/10/5 Wedding Budget Percentage Model", url: "/wedding-budget-breakdown-percentage-model" },
      { title: "Full-Service Planner vs Month-Of Coordinator Cost Guide", url: "/wedding-planner-cost-full-vs-day-of-coordinator" },
      { title: "Wedding Photographer Pricing, Packages & Second Shooter Math", url: "/wedding-photographer-cost-packages-hours-guide" },
      { title: "Wedding DJ & Emcee Pricing, Hours & Audio Packages", url: "/wedding-dj-cost-packages-emcee-pricing" },
      { title: "Master Wedding Tipping Cheat Sheet: Exact Cash Amounts", url: "/wedding-tipping-guide-exact-cash-amounts" },
      { title: "The 5% Wedding Emergency Fund & Buffer Math", url: "/wedding-emergency-fund-buffer-contingency-math" },
      { title: "True Cost Per Guest Multiplier & Compounding Table Math", url: "/wedding-cost-per-guest-multiplier-math" },
      { title: "How to Cut $10,000 from Your Wedding Budget Without Looking Cheap", url: "/how-to-save-money-on-a-wedding-cut-10k" },
      { title: "Wedding Loan Interest Rates, Monthly Payments & APR Math", url: "/wedding-loan-interest-calculator-apr-repayment" }
    ]
  },
  {
    category: "🍾 Bar, Wine & Beverage Logistics",
    items: [
      { title: "Wedding Drink Calculator: The Exact 1 Drink/Hour Buying Formula", url: "/wedding-drink-calculator-guest-formula" },
      { title: "How Much Alcohol for a Wedding: 40/30/30 Beer, Wine & Spirit Ratios", url: "/how-much-alcohol-for-wedding-ratios" },
      { title: "Open Bar vs BYOB Cost Breakdown: Corkage Fee Negotiation", url: "/wedding-bar-cost-open-bar-vs-byob" },
      { title: "BYOB Wedding Venue Stocking Guide & Liquor Liability Insurance", url: "/byob-wedding-venue-alcohol-stocking-guide" },
      { title: "Champagne Toast at Weddings: Waste Math & Prosecco Alternatives", url: "/champagne-toast-wedding-worth-it" },
      { title: "Batch Cocktails for Weddings: Gallon Recipes & Dilution Ratios", url: "/batch-cocktails-for-wedding-gallon-recipes" },
      { title: "Wedding Wine Calculator: Red, White & Rosé Seasonal Ratios", url: "/wedding-wine-calculation-red-white-rose-ratios" },
      { title: "Signature Wedding Cocktail Names: His, Hers & Pet-Themed Ideas", url: "/wedding-cocktail-names-his-hers-pet-ideas" },
      { title: "Wedding Coffee Bar Setup & Gallon Airpot Ratios", url: "/wedding-coffee-bar-setup-guide" },
      { title: "Late-Night Snack Timing, Portions & 70% Headcount Rules", url: "/wedding-late-night-snacks-timing-portions" }
    ]
  },
  {
    category: "🎂 Food, Cake, Florals & Parties",
    items: [
      { title: "Wedding Cake Sizes, Tier Geometry & Slice Pricing Guide", url: "/wedding-cake-sizes-and-prices-tier-guide" },
      { title: "Sheet Cake for Weddings: The $500 Costco Kitchen Hack", url: "/sheet-cake-for-wedding-costco-hack" },
      { title: "Wedding Dessert Table Ideas: Treat Portions Per Guest", url: "/wedding-dessert-table-ideas-treats-per-guest" },
      { title: "Catering Cost Per Person: Buffet vs Plated Banquet Math", url: "/catering-cost-per-person-wedding-buffet-vs-plated" },
      { title: "Wedding Floral Budget Breakdown: Price Per Stem & Item", url: "/wedding-floral-budget-breakdown-price-per-item" },
      { title: "Wedding Favors Waste Prevention & Meaningful Edibles", url: "/wedding-favors-ideas-budget-waste-prevention" },
      { title: "Wedding Menu Wording Examples & Dietary Code Placement", url: "/wedding-menu-wording-examples-dietary-icons" },
      { title: "Rehearsal Dinner Budget Breakdown & Per-Head Family Splits", url: "/rehearsal-dinner-cost-budget-breakdown" },
      { title: "Bridal Shower Budget: Who Pays & Cost Per Guest Breakdown", url: "/bridal-shower-budget-who-pays-cost-per-guest" },
      { title: "Bachelor Party Budget Calculator: Guy Weekend Cost Split", url: "/bachelor-party-budget-calculator-cost-split" }
    ]
  },
  {
    category: "🪑 Logistics, Seating, Etiquette & Legal",
    items: [
      { title: "Who Pays for What? Traditional vs Modern 3-Way Family Splits", url: "/who-pays-for-what-in-a-wedding-traditional-vs-modern" },
      { title: "Bachelorette Party Budget Split: The N-1 Fair Share Formula", url: "/bachelorette-party-budget-split-n-1-formula" },
      { title: "Honeymoon Budget Breakdown: Average Costs & Travel Expense Ratios", url: "/honeymoon-budget-breakdown-average-costs" },
      { title: "Step-by-Step Wedding Name Change Checklist & Legal Roadmap", url: "/wedding-name-change-checklist-step-by-step" },
      { title: "Wedding Seating Chart Etiquette Rules & Layout Strategies", url: "/wedding-seating-chart-maker-etiquette-rules" },
      { title: "Table Clearance & Ballroom Spacing Distance Guide", url: "/table-clearance-wedding-spacing-distance-guide" },
      { title: "Wedding Guest Count Attrition Formula & RSVP Curve", url: "/wedding-guest-count-calculator-attrition-formula" },
      { title: "Wedding RSVP Date Calculator: Chasing Scripts & Timeline", url: "/wedding-rsvp-date-calculator-due-timeline" },
      { title: "How to Track Wedding RSVPs: Data Dictionary & Headcount Manager", url: "/how-to-track-wedding-rsvps-headcount-manager" },
      { title: "Wedding Gift Cash Amount: How Much to Give by Relationship Tier", url: "/wedding-gift-cash-amount-how-much-to-give" }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="container" style="padding-top: 2rem; padding-bottom: 5rem; max-width: 960px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Authors", url: "/about" },
        { name: "Elena Foster" }
      ]}
    />

    <!-- Author Profile Hero Card -->
    <header class="section-paper" style="margin: 2rem 0 3rem; background: #fff; border: 2.5px solid var(--fg-pencil); border-radius: 12px; padding: clamp(1.5rem, 4vw, 3rem); box-shadow: 6px 6px 0px var(--fg-pencil); position: relative;">
      <div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
      
      <div style="display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;">
        <!-- Avatar Circle -->
        <div style="width: 120px; height: 120px; border-radius: 50%; background: #fef3c7; border: 3px solid var(--fg-pencil); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 800; color: #92400e; box-shadow: 4px 4px 0px var(--fg-pencil); flex-shrink: 0;">
          <span>EF</span>
        </div>
        
        <!-- Info Column -->
        <div style="flex: 1; min-width: 280px;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #ecfdf5; color: #065f46; border: 1.5px solid #10b981; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 800; margin-bottom: 0.5rem;">
            <span>✓ Verified Lead Financial Strategist</span>
          </div>
          <h1 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.5rem; line-height: 1.2;">
            Elena Foster
          </h1>
          <p class="font-body" style="font-size: 1.15rem; color: #1e40af; font-weight: 700; margin: 0 0 0.75rem;">
            Lead Wedding Financial Strategist & Hospitality Director • Manage.Wedding
          </p>
          <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; color: var(--text-secondary); font-size: 0.95rem; font-weight: 600;">
            <span>📍 Austin, TX & Nationwide</span>
            <span>•</span>
            <span>💍 12+ Years Experience</span>
            <span>•</span>
            <span>📋 400+ Weddings Managed</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Bio & Editorial Philosophy -->
    <section class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 2rem 2.5rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); line-height: 1.75; font-size: 1.1rem; color: var(--fg-pencil);">
      <h2 class="font-heading" style="font-size: 1.65rem; color: var(--fg-pencil); border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; margin-top: 0; margin-bottom: 1.25rem;">
        About Elena Foster & Editorial Mission
      </h2>
      <p>
        <strong>Hi, I’m Elena!</strong> I’m a 35-year-old mother of two daughters (ages 5 and 3) and a veteran wedding coordinator who has spent the last 12 years directing luxury estate banquets, hotel ballrooms, and private ranch celebrations.
      </p>
      <p>
        After managing more than 400 weddings, I noticed the exact same heartbreaking trend over and over: couples getting financially blindsided by fine print. Quoted $25,000 venue packages magically turning into $35,000 invoices on wedding week. Groomsmen fighting over non-itemized bar tabs. Couples pouring $1,500 of warm champagne down the drain for a 30-second toast.
      </p>
      <p>
        <strong>Why I Write for Manage.Wedding:</strong> Modern wedding media has turned into an advertising lead-gen machine designed to sell your personal information to vendors. I joined Manage.Wedding to build the antidote: 100% free, privacy-first, client-side calculators and candid financial guides that give couples the <em>raw math</em> before they sign non-refundable contracts.
      </p>
      
      <!-- Core Principles Box -->
      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; margin: 1.5rem 0 0.5rem; box-shadow: 3px 3px 0px rgba(0,0,0,0.06);">
        <strong class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); display: block; margin-bottom: 0.5rem;">
          ⚖️ Elena's 4 Golden Rules of Wedding Finance:
        </strong>
        <ul style="margin: 0; padding-left: 1.25rem; font-size: 1rem; color: #334155; line-height: 1.6;">
          <li><strong>The +22% Plus-Plus Rule:</strong> Always calculate compound service fees and sales tax before agreeing to any F&B minimum.</li>
          <li><strong>The 5% Sanity Buffer:</strong> Never allocate 100% of your budget. Always reserve a dedicated 5% fund for week-of logistics and weather holds.</li>
          <li><strong>The 1 Drink/Hour Baseline:</strong> Calibrate alcohol purchases against reception timeline duration rather than generic online guest counts.</li>
          <li><strong>100% Zero-Commission Guarantee:</strong> I never accept vendor kickbacks, affiliate sponsorships, or paid reviews. All recommendations are 100% independent.</li>
        </ul>
      </div>
    </section>

    <!-- Published Articles Directory -->
    <section>
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin-bottom: 1.5rem;">
        Articles & Calculation Guides by Elena Foster ({articles.reduce((acc, cat) => acc + cat.items.length, 0)})
      </h2>

      <div style="display: flex; flex-direction: column; gap: 2rem;">
        {articles.map((cat) => (
          <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; box-shadow: 4px 4px 0px var(--fg-pencil);">
            <h3 class="font-heading" style="font-size: 1.35rem; color: #1e40af; margin-top: 0; margin-bottom: 1rem; border-bottom: 1.5px solid #e2e8f0; padding-bottom: 0.4rem;">
              {cat.category}
            </h3>
            <ul style="margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
              {cat.items.map((art) => (
                <li>
                  <a href={art.url} style="color: var(--fg-pencil); text-decoration: none; font-weight: 600; font-size: 1.05rem; line-height: 1.4; transition: color 0.1s;" onmouseover="this.style.color='#2563eb'" onmouseout="this.style.color='var(--fg-pencil)'">
                    {art.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

  </main>
</Layout>
