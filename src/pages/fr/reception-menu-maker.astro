---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Créateur de Menus de Mariage & Modèles à Imprimer (Gratuit & PDF) | Manage.Wedding";
const description = "Créez et imprimez gratuitement vos menus de mariage personnalisés. Formats 10x21 cm DL, A5 et A4, typographies élégantes, indications allergènes et export PDF haute résolution.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "DesignApplication"],
      "@id": "https://manage.wedding/fr/reception-menu-maker/#webapp",
      "name": "Créateur de Menus de Mariage et Cartes de Table à Imprimer",
      "url": "https://manage.wedding/fr/reception-menu-maker",
      "description": "Créez et imprimez vos menus de réception de mariage. Personnalisez les plats, choisissez vos polices de caractères (Playfair, Cinzel, Calligraphie), sélectionnez le format (DL 10x21 cm, A5, A4) et téléchargez un PDF vectoriel haute résolution.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Rédiger et Imprimer un Menu de Mariage Élégant",
      "description": "Guide pratique pour concevoir, rédiger les intitulés gourmands et imprimer les menus de table de votre réception.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Recenser les Régimes Alimentaires et Allergies",
          "text": "Comptabilisez les convives végétariens (V), sans gluten (GF) ou végétaliens (VG) grâce aux réponses RSVP."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Choisir le Thème Graphique et la Typographie",
          "text": "Optez pour un style Botanique fleuri, Chic Épuré Black-Tie ou Romantique Calligraphie adapté à votre faire-part."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Sélectionner le Format de Carte",
          "text": "Privilégiez le format Long DL (10 × 21 cm) à glisser dans la serviette pliée, ou le format A5 (13 × 18 cm) sur chevalet."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Exporter en PDF Vectoriel et Imprimer sur Papier 300 g/m²",
          "text": "Téléchargez le fichier PDF prêt pour impression sur papier vergé, texturé lin ou coton haute qualité."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quel est le format standard pour un menu de table de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le format le plus populaire en France est le format Long DL (10 × 21 cm ou 99 × 210 mm), idéal pour être glissé dans la serviette ou posé sur l'assiette de présentation. Pour un menu partagé au centre de la table, le format A5 (15 × 21 cm) ou 13 × 18 cm est privilégié."
          }
        },
        {
          "@type": "Question",
          "name": "Quel grammage de papier choisir pour imprimer ses menus de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il est recommandé d'utiliser un papier épais d'un grammage compris entre 250 g/m² et 350 g/m² (papier vergé, papier texturé lin, papier coton ou papier couché mat) pour garantir une excellente tenue en main."
          }
        },
        {
          "@type": "Question",
          "name": "Faut-il prévoir un menu individuel par invité ou un menu par table ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour un dîner assis servi à l'assiette, la coutume veut que chaque invité dispose de son menu individuel (format DL). Pour un buffet dînatoire ou un repas à partager, 2 menus partagés par table de 8 à 10 personnes suffisent amplement."
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} schema={schema}>
  <!-- Import Elegant Wedding Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem); box-sizing: border-box; overflow-x: hidden;">
    <Breadcrumb title="Créateur de Menus de Mariage" category="dining" />
    
    <!-- Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Studio PDF Vectoriel & Typographie</span>
      <h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Créateur de Menus de Mariage <span class="accent-italic">& Cartes de Table</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 760px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Concevez des menus de réception élégants en quelques clics. Choisissez vos polices, vos encadrements floraux, vos formats (DL 10×21 cm, A5, A4) et téléchargez gratuitement votre PDF haute définition.
      </p>
    </header>

    <!-- Main Studio Grid -->
    <div id="app-area" class="fade-in" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2.5rem; align-items: start; margin-bottom: 3.5rem;">

      <!-- Hidden images used for jsPDF generation -->
      <img id="floral-tl" src="/images/floral-tl.webp" alt="Angle botanique haut gauche" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-tr" src="/images/floral-tr.webp" alt="Angle botanique haut droit" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-bl" src="/images/floral-bl.webp" alt="Angle botanique bas gauche" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-br" src="/images/floral-br.webp" alt="Angle botanique bas droit" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />

      <!-- ===== LEFT COLUMN: DESIGN CONTROLS & EDITOR ===== -->
      <div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
          <h2 class="font-heading" style="font-size: 1.4rem; margin: 0; color: var(--fg-pencil);">
            1. Style Graphique & Typographie
          </h2>
          <span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
            Aperçu Direct
          </span>
        </div>

        <!-- Design Theme Selector -->
        <div class="form-group" style="margin-bottom: 1rem;">
          <label class="form-label" for="themePicker" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Ambiance & Thème Visuel</label>
          <select id="themePicker" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-weight: 600; background: #f8fafc; font-size: 0.95rem;">
            <option value="botanical" selected>🌿 Jardin Botanique (Parchemin, Liseré Classique & Fleurs)</option>
            <option value="black-tie">👑 Black-Tie Prestige (Blanc Pur & Filet Noir Épuré)</option>
            <option value="romantic">🌸 Romantique & Accents Or Rose</option>
            <option value="rustic">📜 Kraft Champêtre & Vignoble Toscan</option>
            <option value="minimalist">✨ Moderne Scandinave (Épuré & Sans Bordure)</option>
          </select>
        </div>

        <!-- Typography / Font Pairings -->
        <div class="form-group" style="margin-bottom: 1rem;">
          <label class="form-label" for="fontPicker" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Police de Caractères</label>
          <select id="fontPicker" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-weight: 600; background: #f8fafc; font-size: 0.95rem;">
            <option value="playfair" selected>🏛️ Playfair Display (Sérif Éditorial Classique)</option>
            <option value="cinzel">👑 Cinzel / Trajan Impérial (Majestueux & Formel)</option>
            <option value="cormorant">📜 Cormorant Garamond (Sérif Délicat & Raffiné)</option>
            <option value="script">✍️ Alex Brush Calligraphie (Fluide & Romantique)</option>
            <option value="modern">📐 Montserrat Épuré (Moderne & Contemporain)</option>
          </select>
        </div>

        <!-- Card Dimensions / Format -->
        <div class="form-group" style="margin-bottom: 1rem;">
          <label class="form-label" for="sizePicker" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Dimensions du Menu</label>
          <select id="sizePicker" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-weight: 600; font-size: 0.95rem;">
            <option value="dl" selected>📇 Format Long DL (10 × 21 cm - Serviette / Assiette)</option>
            <option value="a5">📜 Format A5 / 13 × 18 cm (Chevalet de Table Partagé)</option>
            <option value="a4">📄 Format A4 (Affiche Buffet & Animations Culinaires)</option>
          </select>
        </div>

        <!-- Header Names & Date -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
          <div>
            <label class="form-label" for="coupleNames" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Prénoms des Mariés</label>
            <input id="coupleNames" class="form-input" type="text" value="Charlotte & William" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 600;" />
          </div>
          <div>
            <label class="form-label" for="weddingDate" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Date du Mariage</label>
            <input id="weddingDate" class="form-input" type="text" value="18 Octobre 2026" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 600;" />
          </div>
        </div>

        <!-- Header Title Text -->
        <div class="form-group" style="margin-top: 0.75rem; margin-bottom: 1rem;">
          <label class="form-label" for="menuTitle" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Titre de l'En-Tête</label>
          <input id="menuTitle" class="form-input" type="text" value="MENU DE RÉCEPTION" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700; letter-spacing: 2px;" />
        </div>

        <!-- Courses Section Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin: 1.5rem 0 0.75rem 0; border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
          <h3 class="font-heading" style="font-size: 1.2rem; margin: 0; color: var(--fg-pencil);">
            2. Plats & Déroulement du Repas
          </h3>
          <span style="font-size: 0.8rem; color: var(--text-secondary);">Un plat par ligne</span>
        </div>

        <!-- Dynamic courses list -->
        <div id="course-list"></div>

        <!-- Add Course Button -->
        <button id="addCourseBtn" type="button" class="menu-add-btn" style="margin-bottom: 1.5rem;">
          + Ajouter un Plat ou une Étape (ex. Fromages, Trou Normand)
        </button>

        <!-- Dietary Key Toggle -->
        <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1.5rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.92rem; font-weight: 600;">
            <input type="checkbox" id="check-dietary-key" checked style="width: 18px; height: 18px; accent-color: var(--fg-pencil);" />
            <span>Afficher la Légende des Régimes Alimentaires (V, VG, GF, DF)</span>
          </label>
        </div>

        <!-- Download & Export Actions -->
        <div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
          <button id="printMenuBtn" class="hand-btn" style="width: 100%; padding: 12px; font-size: 1.05rem; gap: 0.5rem;">
            <span>🖨️</span> Imprimer Directement (Navigateur)
          </button>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
            <button id="downloadVectorPdfBtn" class="hand-btn secondary" style="padding: 10px; font-size: 0.92rem; gap: 0.35rem;">
              <span>📥</span> Télécharger PDF Vectoriel
            </button>
            <button id="exportDocBtn" class="hand-btn secondary" style="padding: 10px; font-size: 0.92rem; gap: 0.35rem;">
              <span>📄</span> Export Word (.doc)
            </button>
          </div>
          
          <p class="font-body" style="font-size: 0.82rem; color: var(--text-secondary); text-align: center; margin: 0;">
            Rendu vectoriel net · Optimisé pour papier vergé / texturé 250–350 g/m²
          </p>
        </div>

      </div>

      <!-- ===== RIGHT COLUMN: STICKY LIVE PREVIEW ===== -->
      <div style="position: sticky; top: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <span style="font-family: var(--font-heading); font-size: 1.1rem; color: var(--fg-pencil); font-weight: 700;">
            Aperçu Visuel en Temps Réel
          </span>
          <span id="preview-size-tag" style="font-size: 0.82rem; font-weight: 700; background: #e2e8f0; padding: 2px 8px; border-radius: 4px;">
            Format DL (10 × 21 cm)
          </span>
        </div>

        <div style="display: flex; justify-content: center;">
          
          <!-- Outer Card Container -->
          <div id="menuPreview" class="menu-preview-box" style="
            width: 100%;
            max-width: 400px;
            background: #fdfbf7;
            border: 2px solid #2d2d2d;
            box-shadow: 6px 6px 0px rgba(0,0,0,0.15);
            padding: 40px 32px;
            position: relative;
            min-height: 600px;
            box-sizing: border-box;
            transition: all 0.25s ease;
          ">
            
            <!-- Outer Frame Border -->
            <div id="frame-outer" style="position: absolute; top: 10px; bottom: 10px; left: 10px; right: 10px; border: 1.5px solid #2d2d2d; pointer-events: none; z-index: 1;"></div>
            
            <!-- Inner Frame Border -->
            <div id="frame-inner" style="position: absolute; top: 14px; bottom: 14px; left: 14px; right: 14px; border: 0.75px solid #94a3b8; pointer-events: none; z-index: 1;"></div>

            <!-- Floral Corners -->
            <img id="prev-floral-tl" src="/images/floral-tl.webp" alt="Angle floral haut gauche" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; top: 15px; left: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-tr" src="/images/floral-tr.webp" alt="Angle floral haut droit" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; top: 15px; right: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-bl" src="/images/floral-bl.webp" alt="Angle floral bas gauche" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; bottom: 15px; left: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-br" src="/images/floral-br.webp" alt="Angle floral bas droit" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; bottom: 15px; right: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />

            <!-- Live Menu Typography Content -->
            <div id="menuContent" style="position: relative; z-index: 3; text-align: center;"></div>

          </div>

        </div>
      </div>

    </div>

    <!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
    <div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
      <div class="tape" style="margin: 0 auto 0.75rem;"></div>
      
      <div style="text-align: center; margin-bottom: 1.25rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Repères d'Impression</span>
        <h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
          Standards d'Impression & Formats de Menus
        </h2>
        <p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
          Grammages de papier recommandés, dimensions et ratios de cartes par table de mariage.
        </p>
      </div>

      <!-- Semantic Benchmark Table -->
      <div style="overflow-x: auto; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 650px;">
          <thead>
            <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Format de Menu</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Dimensions</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Ratio d'Impression</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Grammage Papier</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Disposition sur Table</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-red);">Individuel Long DL</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">10 × 21 cm (99 × 210 mm)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">1 par Invité (+10% de réserve)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">250–350 g/m² Vergé / Lin</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Glissé dans la serviette ou sur l'assiette</td>
            </tr>
            <tr style="background: #faf8f5;">
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--fg-pencil);">Classique Individuel A5</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">13 × 18 cm ou A5 (15 × 21 cm)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">1 par Invité</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">300 g/m² Couché Mat</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Repas assis avec accord mets-vins détaillé</td>
            </tr>
            <tr>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">Chevalet Partagé</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">13 × 18 cm (Plié ou Chevalet)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">2 Cartes par Table (8–10 pl.)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">350 g/m² Rigide</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Centre de table à côté des fleurs</td>
            </tr>
            <tr style="background: #faf8f5;">
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: #7c3aed);">Affiche Buffet & Ateliers</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">A4 (21 × 29,7 cm) ou A3</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">1 par Atelier / Buffet</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">Papier encadré / Chevalet bois</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">À l'entrée du bar à cocktails ou plancha</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- SEO Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 850px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Guide d'Art de la Table</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          Comment Créer un Menu de Mariage Mémorable
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Le repas de mariage est l'un des souvenirs les plus marquants pour vos invités. Voici les règles pour sublimer la rédaction de vos plats et réussir l'impression de vos cartes de table.
        </p>
      </div>

      <!-- FAQs -->
      <section>
        <h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
          Foire Aux Questions
        </h3>

        <details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
          <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
            Quand finaliser et imprimer les menus de mariage ?
          </summary>
          <p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
            Validez les intitulés exacts avec votre traiteur <strong>4 à 6 semaines avant le mariage</strong>. Lancez l'impression des menus <strong>2 à 3 semaines avant le jour J</strong>, dès que votre plan de table et le décompte des régimes alimentaires sont arrêtés.
          </p>
        </details>
      </section>
    </article>

    <RelatedTools currentPath="/fr/reception-menu-maker" category="stationery" />

  </main>
</Layout>

<style>
  .menu-add-btn {
    width: 100%;
    padding: 0.75rem;
    border: 2px dashed var(--fg-pencil);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--fg-pencil);
    border-radius: 4px;
    transition: background 0.15s;
  }
  .menu-add-btn:hover { background: #f5f1e8; }

  .course-block {
    border: 1.5px solid var(--fg-pencil);
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1rem;
    background: #fdfbf7;
  }
  .course-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .course-block-label {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
    color: var(--fg-pencil);
  }
  .course-rm-btn {
    background: #fee2e2;
    border: 1px solid #ef4444;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    color: #b91c1c;
    font-weight: bold;
    padding: 2px 6px;
  }
  .course-rm-btn:hover { background: #fecaca; }

  .dietary-tag-pill {
    display: inline-block;
    font-size: 0.70rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 4px;
    vertical-align: middle;
  }
</style>

<script is:inline>
  let courses = [
    { 
      title: 'ENTRÉE', 
      items: 'Foie gras de canard mi-cuit, chutney de figues & brioche dorée [GF]\nCarpaccio de Saint-Jacques aux agrumes & huile de truffe' 
    },
    { 
      title: 'PLAT PRINCIPAL', 
      items: 'Filet de bœuf rôti au jus de morilles & écrasé de pommes de terre à la truffe [GF]\nDos de bar sauvage en croûte d\'herbes & émulsion citronnée\nRisotto crémeux aux chanterelles et copeaux de parmesan [V, GF]' 
    },
    { 
      title: 'FROMAGES & DESSERT', 
      items: 'Plateau de fromages affinés de nos régions & mesclun\nWedding Cake vanille bourbon et coulis de framboises fraîches' 
    },
  ];

  function renderEditor() {
    const list = document.getElementById('course-list');
    if (!list) return;
    list.innerHTML = '';

    courses.forEach((c, i) => {
      const div = document.createElement('div');
      div.className = 'course-block';
      div.innerHTML = `
        <div class="course-block-header">
          <p class="course-block-label">Étape ${i + 1}</p>
          ${courses.length > 1 ? `<button type="button" class="course-rm-btn" data-rm="${i}" title="Supprimer">✕ Supprimer</button>` : ''}
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <div>
            <label class="form-label" style="font-size: 0.85rem; display: block; margin-bottom: 0.2rem;">Titre de l'Étape (ex. Entrée, Plat, Trou Normand, Dessert)</label>
            <input class="form-input ci-t" data-i="${i}" type="text" value="${c.title}" style="width: 100%; box-sizing: border-box; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
          </div>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
              <label class="form-label" style="font-size: 0.85rem; margin: 0;">Intitulé des Plats (Un par ligne • tags [V], [GF], [VG], [DF])</label>
              <div style="display: flex; gap: 3px;">
                <button type="button" class="btn-tag" data-tag="[GF]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+GF</button>
                <button type="button" class="btn-tag" data-tag="[V]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+V</button>
                <button type="button" class="btn-tag" data-tag="[VG]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+VG</button>
                <button type="button" class="btn-tag" data-tag="[DF]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+DF</button>
              </div>
            </div>
            <textarea class="form-input ci-v" data-i="${i}" style="width: 100%; box-sizing: border-box; min-height: 75px; resize: vertical; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.92rem;">${c.items}</textarea>
          </div>
        </div>
      `;
      list.appendChild(div);
    });

    // Event Bindings
    list.querySelectorAll('[data-rm]').forEach(b =>
      b.addEventListener('click', e => {
        courses.splice(+e.currentTarget.getAttribute('data-rm'), 1);
        renderEditor();
        renderPreview();
      })
    );
    list.querySelectorAll('.ci-t').forEach(el =>
      el.addEventListener('input', e => {
        courses[+e.currentTarget.getAttribute('data-i')].title = e.currentTarget.value;
        renderPreview();
      })
    );
    list.querySelectorAll('.ci-v').forEach(el =>
      el.addEventListener('input', e => {
        courses[+e.currentTarget.getAttribute('data-i')].items = e.currentTarget.value;
        renderPreview();
      })
    );
    list.querySelectorAll('.btn-tag').forEach(b =>
      b.addEventListener('click', e => {
        const tag = e.currentTarget.getAttribute('data-tag');
        const idx = +e.currentTarget.getAttribute('data-i');
        const textarea = list.querySelector(`.ci-v[data-i="${idx}"]`);
        if (textarea && tag) {
          textarea.value += ` ${tag}`;
          courses[idx].items = textarea.value;
          renderPreview();
        }
      })
    );
  }

  function formatDishWithBadges(text) {
    let formatted = text.trim();
    formatted = formatted.replace(/\[GF\]/gi, '<span class="dietary-tag-pill" style="background:#e0f2fe; color:#0369a1; border:1px solid #7dd3fc;">GF</span>');
    formatted = formatted.replace(/\[V\]/gi, '<span class="dietary-tag-pill" style="background:#f0fdf4; color:#15803d; border:1px solid #86efac;">V</span>');
    formatted = formatted.replace(/\[VG\]/gi, '<span class="dietary-tag-pill" style="background:#fefce8; color:#a16207; border:1px solid #fef08a;">VG</span>');
    formatted = formatted.replace(/\[DF\]/gi, '<span class="dietary-tag-pill" style="background:#fdf2f8; color:#be185d; border:1px solid #fbcfe8;">DF</span>');
    formatted = formatted.replace(/\[NF\]/gi, '<span class="dietary-tag-pill" style="background:#fff7ed; color:#c2410c; border:1px solid #fdba74;">NF</span>');
    return formatted;
  }

  function renderPreview() {
    const el = document.getElementById('menuContent');
    const previewBox = document.getElementById('menuPreview');
    const frameOuter = document.getElementById('frame-outer');
    const frameInner = document.getElementById('frame-inner');
    const floralCorners = [
      document.getElementById('prev-floral-tl'),
      document.getElementById('prev-floral-tr'),
      document.getElementById('prev-floral-bl'),
      document.getElementById('prev-floral-br'),
    ];

    if (!el || !previewBox || !frameOuter || !frameInner) return;

    const theme = document.getElementById('themePicker')?.value || 'botanical';
    const font = document.getElementById('fontPicker')?.value || 'playfair';
    const size = document.getElementById('sizePicker')?.value || 'dl';
    const names = document.getElementById('coupleNames')?.value || 'Charlotte & William';
    const date = document.getElementById('weddingDate')?.value || '18 Octobre 2026';
    const menuTitle = document.getElementById('menuTitle')?.value || 'MENU DE RÉCEPTION';
    const showDietary = document.getElementById('check-dietary-key')?.checked ?? true;

    // Update Preview Size Tag
    const sizeTag = document.getElementById('preview-size-tag');
    if (sizeTag) {
      if (size === 'dl') sizeTag.textContent = 'Format DL (10 × 21 cm)';
      else if (size === 'a5') sizeTag.textContent = 'Format A5 (13 × 18 cm)';
      else sizeTag.textContent = 'Format A4 Affiche';
    }

    // Dimensions
    if (size === 'dl') {
      previewBox.style.maxWidth = '360px';
      previewBox.style.minHeight = '640px';
    } else if (size === 'a5') {
      previewBox.style.maxWidth = '420px';
      previewBox.style.minHeight = '560px';
    } else {
      previewBox.style.maxWidth = '460px';
      previewBox.style.minHeight = '620px';
    }

    // Theme Styles
    if (theme === 'botanical') {
      previewBox.style.background = '#fdfbf7';
      previewBox.style.color = '#1e293b';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '1.5px solid #2d2d2d';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.75px solid #94a3b8';
      floralCorners.forEach(img => { if (img) img.style.display = 'block'; });
    } else if (theme === 'black-tie') {
      previewBox.style.background = '#ffffff';
      previewBox.style.color = '#0f172a';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '2px solid #0f172a';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.5px solid #0f172a';
      floralCorners.forEach(img => { if (img) img.style.display = 'none'; });
    } else if (theme === 'romantic') {
      previewBox.style.background = '#fff9f8';
      previewBox.style.color = '#3b1c1c';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '1.5px solid #c48b71';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.75px dashed #c48b71';
      floralCorners.forEach(img => { if (img) img.style.display = 'block'; });
    } else if (theme === 'rustic') {
      previewBox.style.background = '#f5ecd7';
      previewBox.style.color = '#2c1810';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '2px solid #5c3a21';
      frameInner.style.display = 'block';
      frameInner.style.border = '1px dashed #8c5a31';
      floralCorners.forEach(img => { if (img) img.style.display = 'none'; });
    } else if (theme === 'minimalist') {
      previewBox.style.background = '#ffffff';
      previewBox.style.color = '#1e293b';
      frameOuter.style.display = 'none';
      frameInner.style.display = 'none';
      floralCorners.forEach(img => { if (img) img.style.display = 'none'; });
    }

    // Typography
    let headerFontFamily = "'Playfair Display', serif";
    let bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
    let titleLetterSpacing = "3px";
    let namesStyle = "font-style: italic;";

    if (font === 'playfair') {
      headerFontFamily = "'Playfair Display', serif";
      bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
      titleLetterSpacing = "3px";
    } else if (font === 'cinzel') {
      headerFontFamily = "'Cinzel', serif";
      bodyFontFamily = "'Cormorant Garamond', serif";
      titleLetterSpacing = "4px";
      namesStyle = "font-weight: 600; letter-spacing: 2px;";
    } else if (font === 'cormorant') {
      headerFontFamily = "'Cormorant Garamond', serif";
      bodyFontFamily = "'Cormorant Garamond', serif";
      titleLetterSpacing = "3px";
      namesStyle = "font-style: italic; font-size: 1.25rem;";
    } else if (font === 'script') {
      headerFontFamily = "'Alex Brush', cursive";
      bodyFontFamily = "'Playfair Display', serif";
      titleLetterSpacing = "1px";
      namesStyle = "font-family: 'Alex Brush', cursive; font-size: 1.85rem; line-height: 1.1;";
    } else if (font === 'modern') {
      headerFontFamily = "'Montserrat', sans-serif";
      bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
      titleLetterSpacing = "5px";
      namesStyle = "font-family: 'Montserrat', sans-serif; font-size: 0.95rem; letter-spacing: 2px; text-transform: uppercase;";
    }

    // Build Preview HTML
    let html = `
      <div style="margin-bottom: 12px;">
        <h3 style="font-family: ${headerFontFamily}; font-size: ${font === 'script' ? '2.4rem' : '1.7rem'}; letter-spacing: ${titleLetterSpacing}; text-transform: ${font === 'script' ? 'none' : 'uppercase'}; margin: 0 0 4px 0; font-weight: 700;">
          ${menuTitle}
        </h3>
        <p style="${namesStyle} margin: 0 0 2px 0;">
          ${names}
        </p>
        <p style="font-size: 0.80rem; letter-spacing: 1.5px; opacity: 0.7; margin: 0; font-family: 'Montserrat', sans-serif;">
          ${date}
        </p>
        <div style="width: 40px; border-top: 1.5px solid currentColor; margin: 12px auto; opacity: 0.6;"></div>
      </div>
    `;

    courses.forEach((c, i) => {
      if (i > 0) {
        html += `<div style="width: 24px; border-top: 1px dashed currentColor; margin: 12px auto; opacity: 0.4;"></div>`;
      }
      
      const rawDishes = c.items.split('\n').filter(l => l.trim());
      const formattedDishes = rawDishes.map(d => `<div style="margin-bottom: 4px; line-height: 1.45;">${formatDishWithBadges(d)}</div>`).join('');

      html += `
        <div style="margin-bottom: 8px;">
          <h4 style="font-family: ${headerFontFamily}; font-size: 1.05rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin: 0 0 4px 0; color: var(--accent-red);">
            ${c.title}
          </h4>
          <div style="font-family: ${bodyFontFamily}; font-size: 0.88rem; opacity: 0.9;">
            ${formattedDishes || '<span style="opacity: 0.4; font-style: italic;">Renseignez vos plats...</span>'}
          </div>
        </div>
      `;
    });

    if (showDietary) {
      html += `
        <div style="margin-top: 18px; padding-top: 8px; border-top: 0.5px solid currentColor; opacity: 0.65; font-size: 0.72rem; font-family: 'Montserrat', sans-serif; letter-spacing: 0.5px;">
          (V) Végétarien • (VG) Végétalien/Vegan • (GF) Sans Gluten • (DF) Sans Lactose
        </div>
      `;
    }

    el.innerHTML = html;
  }

  function printHighResMenu() {
    window.print();
  }

  function exportWordDoc() {
    const names = document.getElementById('coupleNames')?.value || 'Charlotte & William';
    const date = document.getElementById('weddingDate')?.value || '18 Octobre 2026';
    const menuTitle = document.getElementById('menuTitle')?.value || 'MENU DE RÉCEPTION';

    let coursesContent = '';
    courses.forEach(c => {
      coursesContent += `<h3 style="color:#b91c1c; margin-top:15px; text-transform:uppercase;">${c.title}</h3><ul>`;
      c.items.split('\n').filter(l => l.trim()).forEach(item => {
        coursesContent += `<li style="margin-bottom:4px;">${item}</li>`;
      });
      coursesContent += `</ul>`;
    });

    const content = `
      <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
      <head><title>${menuTitle}</title>
      <style>body { font-family: 'Georgia', serif; font-size: 11pt; } h1, h2 { text-align: center; } ul { list-style-type: square; }</style>
      </head>
      <body>
        <h1 style="letter-spacing: 2px;">${menuTitle}</h1>
        <h2 style="font-weight:normal; font-style:italic;">${names}</h2>
        <p style="text-align:center; color:#666;">${date}</p>
        <hr/>
        ${coursesContent}
        <br/><hr/>
        <p style="font-size:9pt; text-align:center; color:#888;">Manage.Wedding — Créateur de Menus de Mariage</p>
      </body></html>
    `;

    const blob = new Blob(['\ufeff', content], { type: 'application/msword' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `Menu_Mariage_${names.replace(/\s+/g, '_')}.doc`;
    link.click();
    URL.revokeObjectURL(link.href);
  }

  function loadScript(src) {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) { resolve(); return; }
      const s = document.createElement('script');
      s.src = src; s.onload = () => resolve(); s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  async function downloadVectorPdf() {
    const btn = document.getElementById('downloadVectorPdfBtn');
    if (btn) { btn.textContent = 'Génération PDF…'; btn.disabled = true; }

    try {
      await loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js');

      const names = document.getElementById('coupleNames')?.value || 'Charlotte & William';
      const date  = document.getElementById('weddingDate')?.value || '18 Octobre 2026';
      const menuTitle = document.getElementById('menuTitle')?.value || 'MENU DE RÉCEPTION';
      const size = document.getElementById('sizePicker')?.value || 'dl';

      const { jsPDF } = window.jspdf;
      
      let W = 101.6; // 4" in mm
      let H = 228.6; // 9" in mm
      if (size === 'a5') { W = 127; H = 177.8; }
      else if (size === 'a4') { W = 210; H = 297; }

      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: [W, H] });
      const cx = W / 2;

      // Background
      pdf.setFillColor(253, 251, 247);
      pdf.rect(0, 0, W, H, 'F');

      // Borders
      pdf.setDrawColor(45, 45, 45);
      pdf.setLineWidth(0.5);
      pdf.rect(6, 6, W - 12, H - 12);

      pdf.setDrawColor(180, 180, 180);
      pdf.setLineWidth(0.2);
      pdf.rect(8, 8, W - 16, H - 16);

      let y = size === 'dl' ? 24 : 20;

      // Title
      pdf.setFont('times', 'bold');
      pdf.setFontSize(size === 'dl' ? 18 : 16);
      pdf.setTextColor(30, 30, 30);
      pdf.text(menuTitle, cx, y, { align: 'center' });
      y += 7;

      // Names
      pdf.setFont('times', 'italic');
      pdf.setFontSize(size === 'dl' ? 13 : 12);
      pdf.setTextColor(50, 50, 50);
      pdf.text(names, cx, y, { align: 'center' });
      y += 5;

      // Date
      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(8);
      pdf.setTextColor(120, 120, 120);
      pdf.text(date, cx, y, { align: 'center' });
      y += 5;

      // Divider Line
      pdf.setDrawColor(80, 80, 80);
      pdf.setLineWidth(0.3);
      pdf.line(cx - 15, y, cx + 15, y);
      y += 8;

      // Courses
      courses.forEach((course, i) => {
        if (i > 0) {
          pdf.setDrawColor(180, 180, 180);
          pdf.setLineDashPattern([1, 1], 0);
          pdf.line(cx - 8, y, cx + 8, y);
          pdf.setLineDashPattern([], 0);
          y += 6;
        }

        pdf.setFont('times', 'bold');
        pdf.setFontSize(size === 'dl' ? 11 : 10);
        pdf.setTextColor(180, 45, 35);
        pdf.text(course.title, cx, y, { align: 'center' });
        y += 5;

        pdf.setFont('times', 'normal');
        pdf.setFontSize(size === 'dl' ? 9.5 : 8.5);
        pdf.setTextColor(50, 50, 50);
        const rawItems = course.items.split('\n').filter(l => l.trim());
        rawItems.forEach(item => {
          const cleanItem = item.replace(/\[(GF|V|VG|DF|NF)\]/g, '($1)');
          pdf.text(cleanItem, cx, y, { align: 'center' });
          y += 4.5;
        });
        y += 3;
      });

      pdf.save(`Menu_Mariage_${names.replace(/\s+/g, '_')}.pdf`);
    } catch (err) {
      console.error('PDF error:', err);
      alert('Erreur lors du téléchargement du PDF. Utilisez le bouton Imprimer Directement.');
    } finally {
      if (btn) { btn.textContent = 'Télécharger PDF Vectoriel'; btn.disabled = false; }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderEditor();
    renderPreview();

    ['themePicker', 'fontPicker', 'sizePicker', 'coupleNames', 'weddingDate', 'menuTitle', 'check-dietary-key'].forEach(id => {
      const el = document.getElementById(id);
      el?.addEventListener('input', renderPreview);
      el?.addEventListener('change', renderPreview);
    });

    document.getElementById('addCourseBtn')?.addEventListener('click', () => {
      courses.push({ title: 'NOUVEAU PLAT', items: 'Description du plat signature [GF]' });
      renderEditor();
      renderPreview();
      document.getElementById('course-list')?.lastElementChild?.scrollIntoView({ behavior: 'smooth' });
    });

    document.getElementById('printMenuBtn')?.addEventListener('click', printHighResMenu);
    document.getElementById('downloadVectorPdfBtn')?.addEventListener('click', downloadVectorPdf);
    document.getElementById('exportDocBtn')?.addEventListener('click', exportWordDoc);
  });
</script>
