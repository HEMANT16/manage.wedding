---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/cake-serving-calculator/#webapp",
      "name": "Calculateur de Parts de Gâteau de Mariage et Pièce Montée",
      "url": "https://manage.wedding/fr/cake-serving-calculator",
      "description": "Calculateur gratuit de parts de gâteau de mariage (Wedding cake et pièce montée). Calculez le nombre d'étages, les diamètres en cm, les portions rondes vs carrées et l'astuce du gâteau d'office en cuisine. Visuel 3D et guide de découpe.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Calculer les Parts et Dimensions d'un Gâteau de Mariage",
      "description": "Guide pratique pour dimensionner les étages d'un wedding cake ou d'une pièce montée selon votre nombre d'invités.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Choisir la Forme et le Style du Gâteau",
          "text": "Sélectionnez des étages ronds (traditionnels) ou carrés (découpe en grille offrant ~25% de parts supplémentaires par étage)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Définir la Taille des Parts",
          "text": "Choisissez des parts Mariage standard (2,5 × 5 cm sur 10 cm de haut pour un repas complet) ou des parts Fête généreuses (5 × 5 cm)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Ajuster les Étages selon vos Invités",
          "text": "Explorez les combinaisons 2, 3, 4 ou 5 étages (ex. 15 cm / 23 cm / 30 cm pour 100 invités) ou laissez l'outil recommander la disposition idéale."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Utiliser l'Astuce du Gâteau d'Office (Sheet Cake)",
          "text": "Commandez une belle pièce montée d'apparat 2 étages pour les photos, complétée d'un gâteau rectangulaire en cuisine à moitié prix."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle taille de gâteau de mariage faut-il pour 100 invités ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour 100 personnes, un gâteau à 3 étages ronds de 15 cm (6\"), 23 cm (9\") et 30 cm (12\") de diamètre fournit exactement 100 parts de mariage standard (2,5 × 5 × 10 cm)."
          }
        },
        {
          "@type": "Question",
          "name": "Faut-il compter l'étage supérieur (sommet) dans les parts invités ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si vous souhaitez conserver et congeler le sommet de 15 cm pour le déguster lors de votre premier anniversaire de mariage (tradition), déduisez 12 parts de votre total et prévoyez un étage de base plus large ou un gâteau d'office."
          }
        },
        {
          "@type": "Question",
          "name": "Comment découper un gâteau de mariage à étages sans l'abîmer ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour les étages de 20 cm ou plus, utilisez la méthode des cercles concentriques : découpez un cercle intérieur à 5 cm du bord, tranchez l'anneau extérieur en portions de 2,5 cm, puis découpez le cœur cylindrique restant."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur de Parts de Gâteau de Mariage & Pièce Montée | Manage.Wedding"
	description="Calculez les parts de wedding cake, le nombre et diamètre des étages (cm/pouces), les découpes rondes vs carrées et l'astuce du gâteau d'office."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Parts de Gâteau de Mariage" category="dining" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2.5rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 3rem 1.5rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Calculateur de Parts de Gâteau <span class="accent-italic">& Pièce Montée</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 1rem auto 0;">
					Estimez précisément la quantité de gâteau nécessaire. Choisissez la forme des étages, la taille des parts et visualisez la structure de votre gâteau en temps réel.
				</p>
			</div>
		</section>

		<!-- Interactive Calculator & Visual Studio Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; margin-bottom: 3.5rem;" class="calc-container-grid">
			
			<!-- Left Column: Controls & Inputs -->
			<div class="hand-card" style="padding: 2rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.6rem; margin-bottom: 1.5rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<span>🎂</span> Configuration du Gâteau
				</h2>

				<form id="cake-calc-form">
					
					<!-- Calculation Mode -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem; color: var(--fg-pencil);">
							Style / Formule de Présentation :
						</label>
						<div class="mode-select-grid">
							<label class="mode-tab active" id="tab-tiered">
								<input type="radio" name="cakeMode" value="tiered" checked style="display: none;"> Pièce à Étages
							</label>
							<label class="mode-tab" id="tab-sheet">
								<input type="radio" name="cakeMode" value="sheet" style="display: none;"> Gâteau Plaque
							</label>
							<label class="mode-tab" id="tab-combo">
								<input type="radio" name="cakeMode" value="combo" style="display: none;"> Étage + Plaque
							</label>
						</div>
					</div>

					<!-- Guest Count -->
					<div style="margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label class="font-heading" for="guest-count" style="font-size: 1.1rem; color: var(--fg-pencil);">
								Nombre d'Invités :
							</label>
							<span id="guest-badge" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.9rem;">100 Invités</span>
						</div>
						<input type="range" id="guest-slider" min="10" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="guest-count" class="form-input" min="1" max="1000" value="100" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem;">
						</div>
					</div>

					<!-- Cake Shape -->
					<div id="shape-group" style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem; color: var(--fg-pencil);">
							Forme des Étages :
						</label>
						<select id="cake-shape" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff;">
							<option value="round">Rond (Classique & Raffiné)</option>
							<option value="square">Carré (~25% de parts supplémentaires)</option>
							<option value="heart">Cœur (Romantique & Moderne)</option>
						</select>
					</div>

					<!-- Slice / Portion Size -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem; color: var(--fg-pencil);">
							Format des Parts :
						</label>
						<select id="portion-size" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff;">
							<option value="wedding">Part Mariage (2,5 × 5 × 10 cm — Standard repas 3 plats)</option>
							<option value="party">Part Généreuse / Fête (5 × 5 × 10 cm — Dessert principal)</option>
							<option value="dessert">Part Dessert Moyen (3,8 × 5 × 10 cm)</option>
						</select>
						<small class="font-body" style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">
							*Les parts Mariage standard sont idéales après un dîner complet de mariage.
						</small>
					</div>

					<!-- Tier Preference (Tiered Mode) -->
					<div id="tier-pref-group" style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem; color: var(--fg-pencil);">
							Nombre d'Étages :
						</label>
						<select id="tier-count-pref" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff;">
							<option value="auto">Recommandation Automatique Idéale</option>
							<option value="1">1 Étage (Simple & Épuré)</option>
							<option value="2">2 Étages (Intimiste 30 à 65 Invités)</option>
							<option value="3">3 Étages (Classique 75 à 130 Invités)</option>
							<option value="4">4 Étages (Grand Mariage 130 à 220 Invités)</option>
							<option value="5">5 Étages (Mariage Royal 220+ Invités)</option>
						</select>
					</div>

					<!-- Anniversary Top Tier Checkbox -->
					<div style="margin-bottom: 1.5rem; padding: 0.75rem; background: var(--bg-paper); border: 2px dashed var(--fg-pencil); border-radius: 4px;">
						<label style="display: flex; align-items: flex-start; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="save-top-tier" style="margin-top: 0.3rem; transform: scale(1.2);">
							<span class="font-body" style="font-size: 1rem; color: var(--fg-pencil); line-height: 1.4;">
								<strong>Conserver le sommet pour le 1er anniversaire ?</strong><br>
								<span style="color: var(--text-secondary); font-size: 0.85rem;">Déduit ~12 parts du sommet pour que tous vos convives soient servis.</span>
							</span>
						</label>
					</div>

					<!-- Cake Height Preference -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.1rem; color: var(--fg-pencil);">
							Hauteur des Étages :
						</label>
						<div class="height-select-grid">
							<label class="height-opt active">
								<input type="radio" name="cakeHeight" value="4" checked style="display: none;"> 10 cm (Standard 3 couches)
							</label>
							<label class="height-opt">
								<input type="radio" name="cakeHeight" value="5" style="display: none;"> 12,5 cm (Étage haut)
							</label>
							<label class="height-opt">
								<input type="radio" name="cakeHeight" value="6" style="display: none;"> 15 cm (Double Barrel)
							</label>
						</div>
					</div>

					<button type="button" id="recalc-btn" class="hand-btn" style="width: 100%; padding: 0.9rem; font-size: 1.15rem;">
						✨ Mettre à Jour le Gâteau
					</button>

				</form>
			</div>

			<!-- Right Column: Interactive Visuals & Results -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Results Summary Card -->
				<div class="hand-card" style="background: #fff; padding: 1.75rem;">
					<div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
						<h2 class="font-heading" style="font-size: 1.6rem; color: var(--accent-red); margin: 0;">
							Structure du Gâteau
						</h2>
						<span id="match-status" class="font-heading" style="background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem;">
							Ajustement Idéal
						</span>
					</div>

					<!-- Big Stats -->
					<div class="cake-stats-grid" style="margin-bottom: 1.25rem;">
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total Parts</span>
							<strong id="res-total-servings" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue); display: block;">100</strong>
							<span id="res-servings-diff" style="font-size: 0.75rem; color: var(--text-secondary);">Exact pour 100</span>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Étages</span>
							<strong id="res-tier-count" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); display: block;">3 Étages</strong>
							<span id="res-tier-detail" style="font-size: 0.75rem; color: var(--text-secondary);">15, 23, 30 cm</span>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Surface Estimée</span>
							<strong id="res-cake-area" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); display: block;">1 320 cm²</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Glaçage & Décor</span>
						</div>
					</div>

					<!-- Visual Cake Tier Render Container -->
					<div id="visual-cake-studio" style="border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 1.5rem 0.5rem 0.5rem; background: var(--bg-paper); min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; position: relative; overflow: hidden; max-width: 100%;">
						<div style="position: absolute; top: 8px; left: 10px; font-size: 0.8rem; color: var(--text-secondary); font-family: var(--font-heading);">
							📐 Échelle Visuelle des Étages
						</div>
						<!-- Tiers dynamically rendered here -->
						<div id="tiers-render-box" style="display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 100%;"></div>
						<!-- Cake Stand -->
						<div id="cake-stand-plate" style="width: min(240px, 90%); height: 10px; background: #e5e0d8; border: 2px solid var(--fg-pencil); border-radius: 10px; margin-top: -2px;"></div>
						<div id="cake-stand-stem" style="width: 50px; height: 20px; background: #dcd6cc; border: 2px solid var(--fg-pencil); border-top: none; margin-bottom: 4px;"></div>
						<div id="cake-stand-foot" style="width: 100px; height: 8px; background: #dcd6cc; border: 2px solid var(--fg-pencil); border-radius: 4px;"></div>
					</div>

					<!-- Breakdown List per Tier -->
					<div id="tier-breakdown-list" style="margin-top: 1.5rem; font-family: var(--font-body); font-size: 0.95rem;">
						<!-- Populated via JS -->
					</div>

					<!-- Pro-Tip Callout Box -->
					<div id="pro-tip-box" style="margin-top: 1.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
						<div class="font-heading" style="font-size: 1.05rem; margin-bottom: 0.25rem; color: var(--fg-pencil);">
							💡 Astuce Budget Pâtissier :
						</div>
						<p id="pro-tip-text" class="font-body" style="font-size: 0.92rem; margin: 0; line-height: 1.4;">
							Commandez un gâteau à 2 étages d'apparat pour les photos et la découpe officielle, accompagné d'un gâteau d'office rectangulaire en cuisine pour nourrir le reste des invités avec 50% d'économie !
						</p>
					</div>

				</div>

				<!-- Visual Slice Scale Comparison Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.25rem; margin-bottom: 1rem; color: var(--fg-pencil); text-align: center;">
						📏 Comparatif Visuel des Parts
					</h3>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; text-align: center;">
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
							<div class="font-heading" style="font-size: 1.05rem; color: var(--accent-blue); margin-bottom: 0.5rem;">Part Mariage Standard</div>
							<div style="width: 35px; height: 70px; background: #ffeaa7; border: 2px solid var(--fg-pencil); margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
								2,5×5cm
							</div>
							<div class="font-body" style="font-size: 0.82rem; color: var(--text-secondary);">
								Standard après repas complet à table
							</div>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
							<div class="font-heading" style="font-size: 1.05rem; color: var(--accent-red); margin-bottom: 0.5rem;">Part Fête / Anniversaire</div>
							<div style="width: 70px; height: 70px; background: #fab1a0; border: 2px solid var(--fg-pencil); margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
								5×5cm
							</div>
							<div class="font-body" style="font-size: 0.82rem; color: var(--text-secondary);">
								Généreuse / Dessert unique
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 3.5rem auto 2.5rem; max-width: 900px; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape"></div>
			
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Repères Rapides des Étages de Gâteau
				</h3>
				<span style="background: #fff; border: 1.5px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700; color: var(--accent-red);">
					Guide Pratique
				</span>
			</div>

			<!-- Formula Highlight Box -->
			<div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<div style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--accent-red); margin-bottom: 0.35rem; font-weight: 700;">
					📐 Les Ratios de Portion :
				</div>
				<p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.5;">
					<strong>Part Mariage Formelle = 2,5 cm × 5 cm sur 10 cm de haut</strong><br />
					<strong>Part Fête Généreuse = 5 cm × 5 cm sur 10 cm de haut (Volume doublé)</strong>
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; margin-bottom: 1rem; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 600px;">
					<thead>
						<tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil);">Structure</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil); text-align: center;">Diamètres Ronds (cm / ")</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red); text-align: center;">Parts Mariage (2,5×5 cm)</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue); text-align: center;">Parts Fête (5×5 cm)</th>
							<th style="padding: 0.6rem 0.75rem; font-weight: 700; color: var(--fg-pencil); text-align: right;">Invités Cibles</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">2 Étages Intimiste</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">15 cm + 20 cm (6" + 8")</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-red);">36 parts</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">18 parts</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right;">25–35 Invités</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">2 Étages Classique</td>
