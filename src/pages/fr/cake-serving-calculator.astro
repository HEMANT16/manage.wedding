<script is:inline>
	// Complete Round & Square Servings Map (Wedding 1x2 vs Party 2x2 vs Dessert 1.5x2)
	const singleTierYields = {
		round: {
			4: { wedding: 6, party: 4, dessert: 5 },
			6: { wedding: 12, party: 6, dessert: 8 },
			8: { wedding: 24, party: 12, dessert: 16 },
			9: { wedding: 32, party: 16, dessert: 21 },
			10: { wedding: 38, party: 19, dessert: 25 },
			11: { wedding: 46, party: 23, dessert: 30 },
			12: { wedding: 56, party: 28, dessert: 37 },
			13: { wedding: 66, party: 33, dessert: 44 },
			14: { wedding: 78, party: 39, dessert: 52 },
			15: { wedding: 88, party: 44, dessert: 58 },
			16: { wedding: 100, party: 50, dessert: 66 },
			18: { wedding: 128, party: 64, dessert: 85 }
		},
		square: {
			4: { wedding: 8, party: 4, dessert: 5 },
			6: { wedding: 18, party: 9, dessert: 12 },
			8: { wedding: 32, party: 16, dessert: 21 },
			9: { wedding: 40, party: 20, dessert: 26 },
			10: { wedding: 50, party: 25, dessert: 33 },
			11: { wedding: 60, party: 30, dessert: 40 },
			12: { wedding: 72, party: 36, dessert: 48 },
			13: { wedding: 84, party: 42, dessert: 56 },
			14: { wedding: 98, party: 49, dessert: 65 },
			15: { wedding: 112, party: 56, dessert: 74 },
			16: { wedding: 128, party: 64, dessert: 85 },
			18: { wedding: 162, party: 81, dessert: 108 }
		},
		heart: {
			4: { wedding: 5, party: 3, dessert: 4 },
			6: { wedding: 10, party: 5, dessert: 7 },
			8: { wedding: 20, party: 10, dessert: 14 },
			9: { wedding: 28, party: 14, dessert: 18 },
			10: { wedding: 34, party: 17, dessert: 22 },
			11: { wedding: 41, party: 20, dessert: 27 },
			12: { wedding: 50, party: 25, dessert: 33 },
			13: { wedding: 59, party: 29, dessert: 39 },
			14: { wedding: 70, party: 35, dessert: 46 },
			15: { wedding: 79, party: 39, dessert: 52 },
			16: { wedding: 90, party: 45, dessert: 60 },
			18: { wedding: 115, party: 57, dessert: 76 }
		}
	};

	const standardTierCombos = [
		{ tiers: 1, sizes: [6] },
		{ tiers: 1, sizes: [8] },
		{ tiers: 1, sizes: [10] },
		{ tiers: 1, sizes: [12] },
		{ tiers: 2, sizes: [6, 8] },
		{ tiers: 2, sizes: [6, 9] },
		{ tiers: 2, sizes: [8, 10] },
		{ tiers: 2, sizes: [8, 12] },
		{ tiers: 2, sizes: [10, 12] },
		{ tiers: 3, sizes: [6, 8, 10] },
		{ tiers: 3, sizes: [6, 9, 12] },
		{ tiers: 3, sizes: [8, 10, 12] },
		{ tiers: 3, sizes: [8, 10, 14] },
		{ tiers: 4, sizes: [6, 8, 10, 12] },
		{ tiers: 4, sizes: [6, 8, 10, 14] },
		{ tiers: 4, sizes: [6, 9, 12, 14] },
		{ tiers: 4, sizes: [8, 10, 12, 14] },
		{ tiers: 4, sizes: [8, 10, 12, 16] },
		{ tiers: 5, sizes: [6, 8, 10, 12, 14] },
		{ tiers: 5, sizes: [6, 8, 10, 12, 16] },
		{ tiers: 5, sizes: [6, 9, 12, 14, 16] },
		{ tiers: 5, sizes: [8, 10, 12, 14, 16] },
		{ tiers: 5, sizes: [8, 10, 12, 14, 18] }
	];

	// DOM Elements
	const guestInput = document.getElementById('guest-count');
	const guestSlider = document.getElementById('guest-slider');
	const guestBadge = document.getElementById('guest-badge');
	const shapeSelect = document.getElementById('cake-shape');
	const portionSelect = document.getElementById('portion-size');
	const tierPrefSelect = document.getElementById('tier-count-pref');
	const saveTopTierCheck = document.getElementById('save-top-tier');
	const recalcBtn = document.getElementById('recalc-btn');

	const resTotalServings = document.getElementById('res-total-servings');
	const resServingsDiff = document.getElementById('res-servings-diff');
	const resTierCount = document.getElementById('res-tier-count');
	const resTierDetail = document.getElementById('res-tier-detail');
	const resCakeArea = document.getElementById('res-cake-area');
	const matchStatus = document.getElementById('match-status');
	const tiersRenderBox = document.getElementById('tiers-render-box');
	const tierBreakdownList = document.getElementById('tier-breakdown-list');
	const proTipText = document.getElementById('pro-tip-text');

	// Sync Slider & Input
	guestSlider.addEventListener('input', (e) => {
		guestInput.value = e.target.value;
		guestBadge.textContent = `${e.target.value} Invités`;
		calculateAndRender();
	});

	guestInput.addEventListener('input', (e) => {
		let val = parseInt(e.target.value) || 10;
		if (val > 400) val = 400;
		guestSlider.value = val;
		guestBadge.textContent = `${val} Invités`;
		calculateAndRender();
	});

	// Mode Selector Tabs
	document.querySelectorAll('.mode-tab').forEach(tab => {
		tab.addEventListener('click', () => {
			document.querySelectorAll('.mode-tab').forEach(t => {
				t.classList.remove('active');
				t.style.background = 'var(--bg-paper)';
			});
			tab.classList.add('active');
			tab.style.background = 'var(--post-it)';
			tab.querySelector('input').checked = true;
			calculateAndRender();
		});
	});

	// Height Radios
	document.querySelectorAll('input[name="cakeHeight"]').forEach(radio => {
		radio.parentElement.addEventListener('click', () => {
			document.querySelectorAll('input[name="cakeHeight"]').forEach(r => {
				r.parentElement.classList.remove('active');
				r.parentElement.style.background = 'var(--bg-paper)';
			});
			radio.parentElement.classList.add('active');
			radio.parentElement.style.background = 'var(--post-it)';
			radio.checked = true;
			calculateAndRender();
		});
	});

	// Event Listeners for selects & buttons
	shapeSelect.addEventListener('change', calculateAndRender);
	portionSelect.addEventListener('change', calculateAndRender);
	tierPrefSelect.addEventListener('change', calculateAndRender);
	saveTopTierCheck.addEventListener('change', calculateAndRender);
	recalcBtn.addEventListener('click', calculateAndRender);

	function calculateAndRender() {
		const guests = parseInt(guestInput.value) || 100;
		const mode = document.querySelector('input[name="cakeMode"]:checked').value;
		const shape = shapeSelect.value;
		const portion = portionSelect.value;
		const tierPref = tierPrefSelect.value;
		const saveTopTier = saveTopTierCheck.checked;
		const height = parseInt(document.querySelector('input[name="cakeHeight"]:checked').value) || 4;

		if (mode === 'sheet') {
			renderSheetCakeMode(guests, portion);
			return;
		}

		if (mode === 'combo') {
			renderComboMode(guests, shape, portion, saveTopTier);
			return;
		}

		// Standard Tiered Cake Calculation
		let bestCombo = null;
		let bestServings = 0;
		let minDiff = 9999;

		let candidateCombos = standardTierCombos;
		if (tierPref !== 'auto') {
			const targetTiers = parseInt(tierPref);
			candidateCombos = standardTierCombos.filter(c => c.tiers === targetTiers);
		}

		candidateCombos.forEach(combo => {
			let total = 0;
			combo.sizes.forEach((size, idx) => {
				const tierYield = singleTierYields[shape][size][portion] || 10;
				if (saveTopTier && idx === 0 && combo.sizes.length > 1) {
					// Top tier saved
				} else {
					total += tierYield;
				}
			});

			const diff = total - guests;
			if (diff >= 0 && diff < minDiff) {
				minDiff = diff;
				bestCombo = combo;
				bestServings = total;
			}
		});

		if (!bestCombo && candidateCombos.length > 0) {
			bestCombo = candidateCombos[candidateCombos.length - 1];
			bestServings = bestCombo.sizes.reduce((acc, s, idx) => {
				if (saveTopTier && idx === 0 && bestCombo.sizes.length > 1) return acc;
				return acc + (singleTierYields[shape][s][portion] || 10);
			}, 0);
		}

		renderTieredResults(bestCombo, bestServings, guests, shape, portion, saveTopTier, height);
	}

	function renderTieredResults(combo, totalServings, guests, shape, portion, saveTopTier, height) {
		resTotalServings.textContent = totalServings;
		resTierCount.textContent = `${combo.tiers} Étage${combo.tiers > 1 ? 's' : ''}`;
		resTierDetail.textContent = combo.sizes.map(s => `${Math.round(s * 2.54)} cm (${s}")`).join(', ');

		const diff = totalServings - guests;
		if (diff === 0) {
			matchStatus.textContent = '🎯 Ajustement Idéal';
			matchStatus.style.background = '#dcfce7';
			resServingsDiff.textContent = `Exact pour ${guests} invités`;
		} else if (diff > 0) {
			matchStatus.textContent = `+${diff} Parts de Marge`;
			matchStatus.style.background = 'var(--post-it)';
			resServingsDiff.textContent = `${diff} parts de réserve`;
		} else {
			matchStatus.textContent = `${Math.abs(diff)} Parts Manquantes`;
			matchStatus.style.background = '#fee2e2';
			resServingsDiff.textContent = `Manque ${Math.abs(diff)} parts`;
		}

		// Calculate Area in cm2
		let totalAreaIn2 = 0;
		combo.sizes.forEach(s => {
			if (shape === 'round') {
				totalAreaIn2 += Math.PI * Math.pow(s / 2, 2);
			} else if (shape === 'square') {
				totalAreaIn2 += s * s;
			} else {
				totalAreaIn2 += 0.9 * Math.PI * Math.pow(s / 2, 2);
			}
		});
		const totalAreaCm2 = Math.round(totalAreaIn2 * 6.4516);
		resCakeArea.textContent = `${totalAreaCm2.toLocaleString('fr-FR')} cm²`;

		// Render Visual Tiers
		tiersRenderBox.innerHTML = '';
		const maxDiameter = 18;
		const maxRenderWidth = 240;
		const tierColors = ['#fef08a', '#e0f2fe', '#fed7aa', '#fbcfe8', '#dcfce7'];

		combo.sizes.forEach((size, idx) => {
			const tierDiv = document.createElement('div');
			const renderWidth = Math.max(50, (size / maxDiameter) * maxRenderWidth);
			const tierHeightPx = height === 4 ? 36 : height === 5 ? 44 : 52;
			const isTopSaved = saveTopTier && idx === 0 && combo.sizes.length > 1;

			tierDiv.style.width = `${renderWidth}px`;
			tierDiv.style.height = `${tierHeightPx}px`;
			tierDiv.style.background = isTopSaved ? '#e2e8f0' : tierColors[idx % tierColors.length];
			tierDiv.style.border = '2px solid var(--fg-pencil)';
			tierDiv.style.display = 'flex';
			tierDiv.style.alignItems = 'center';
			tierDiv.style.justifyContent = 'center';
			tierDiv.style.position = 'relative';
			tierDiv.style.fontFamily = 'var(--font-heading)';
			tierDiv.style.fontSize = '0.92rem';
			tierDiv.style.color = 'var(--fg-pencil)';
			tierDiv.style.transition = 'all 0.3s ease';

			if (shape === 'square') {
				tierDiv.style.borderRadius = '2px';
			} else if (shape === 'round') {
				tierDiv.style.borderRadius = idx === 0 ? '6px 6px 0 0' : '0';
			} else {
				tierDiv.style.borderRadius = '8px 8px 0 0';
			}

			if (idx !== combo.sizes.length - 1) {
				tierDiv.style.borderBottom = 'none';
			}

			const tierYield = singleTierYields[shape][size][portion] || 10;
			tierDiv.innerHTML = `<span>${Math.round(size * 2.54)} cm (${isTopSaved ? 'Sommet Gardé' : tierYield + ' parts'})</span>`;

			tiersRenderBox.appendChild(tierDiv);
		});

		// Render Detailed Breakdown List
		tierBreakdownList.innerHTML = '<strong class="font-heading" style="display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">📋 Détail Étage par Étage :</strong>';
		combo.sizes.forEach((size, idx) => {
			const isTopSaved = saveTopTier && idx === 0 && combo.sizes.length > 1;
			const tierYield = singleTierYields[shape][size][portion] || 10;
			const item = document.createElement('div');
			item.className = 'tier-slice-item';
			item.innerHTML = `
				<span><strong>Étage ${idx + 1} (${Math.round(size * 2.54)} cm / ${size}") :</strong> haut. ${Math.round(height * 2.54)} cm</span>
				<span style="font-weight: bold; color: ${isTopSaved ? 'var(--accent-red)' : 'var(--accent-blue)'};">
					${isTopSaved ? '0 part invité (Gardé pour 1er anniversaire)' : tierYield + ' parts mariage'}
				</span>
			`;
			tierBreakdownList.appendChild(item);
		});

		// Dynamic Pro Tip
		if (guests > 120) {
			proTipText.textContent = `Pour ${guests} convives, un grand gâteau à 4 ou 5 étages peut coûter cher. Optez pour un gâteau 3 étages (100 parts) associé à une plaque d'office en cuisine pour économiser environ 250 € !`;
		} else if (saveTopTier) {
			proTipText.textContent = `Comme vous gardez le sommet de 15 cm pour votre 1er anniversaire de mariage, la taille des étages inférieurs a été ajustée pour régaler vos ${guests} invités !`;
		} else {
			proTipText.textContent = `Une part de mariage standard (2,5 × 5 cm) est parfaitement calibrée après un repas complet. Si le gâteau est le dessert unique, choisissez le format "Part Fête" !`;
		}
	}

	function renderSheetCakeMode(guests, portion) {
		let sheetType = '1/4 Plaque (23 × 33 cm)';
		let totalServings = 48;
		let dimensions = '23 × 33 cm';

		if (portion === 'wedding') {
			if (guests <= 48) {
				sheetType = '1 × Quart de Plaque (23 × 33 cm)';
				totalServings = 48;
				dimensions = '23 × 33 cm';
			} else if (guests <= 96) {
				sheetType = '1 × Demi-Plaque (30 × 45 cm)';
				totalServings = 96;
				dimensions = '30 × 45 cm';
			} else if (guests <= 192) {
				sheetType = '1 × Grande Plaque Entière (45 × 60 cm)';
				totalServings = 192;
				dimensions = '45 × 60 cm';
			} else {
				const numSheets = Math.ceil(guests / 192);
				sheetType = `${numSheets} × Grandes Plaques Entières`;
				totalServings = numSheets * 192;
				dimensions = `${numSheets} Plaques`;
			}
		} else {
			if (guests <= 24) {
				sheetType = '1 × Quart de Plaque';
				totalServings = 24;
				dimensions = '23 × 33 cm';
			} else if (guests <= 48) {
				sheetType = '1 × Demi-Plaque';
				totalServings = 48;
				dimensions = '30 × 45 cm';
			} else if (guests <= 96) {
				sheetType = '1 × Grande Plaque';
				totalServings = 96;
				dimensions = '45 × 60 cm';
			} else {
				const numSheets = Math.ceil(guests / 96);
				sheetType = `${numSheets} × Grandes Plaques`;
				totalServings = numSheets * 96;
				dimensions = `${numSheets} Plaques`;
			}
		}

		resTotalServings.textContent = totalServings;
		resTierCount.textContent = 'Gâteau Plaque';
		resTierDetail.textContent = sheetType;
		matchStatus.textContent = 'Formule Plaque';
		matchStatus.style.background = '#e0f2fe';
		resServingsDiff.textContent = `${totalServings - guests >= 0 ? '+' + (totalServings - guests) : totalServings - guests} vs ${guests} invités`;

		tiersRenderBox.innerHTML = `
			<div style="width: 220px; height: 110px; background: #fed7aa; border: 2px solid var(--fg-pencil); border-radius: 4px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: var(--font-heading);">
				<span style="font-size: 1.05rem; color: var(--fg-pencil);">${sheetType}</span>
				<span style="font-size: 0.85rem; color: var(--text-secondary);">${dimensions} — ${totalServings} Parts</span>
				<div style="width: 85%; height: 2px; background: var(--fg-pencil); margin: 6px 0; border-style: dashed;"></div>
				<span style="font-size: 0.75rem; color: var(--accent-blue);">Découpe rapide en cuisine</span>
			</div>
		`;

		tierBreakdownList.innerHTML = `
			<div class="tier-slice-item">
				<span><strong>Format :</strong> ${sheetType}</span>
				<span style="font-weight: bold; color: var(--accent-blue);">${totalServings} Parts Totales</span>
			</div>
			<div class="tier-slice-item">
				<span><strong>Style de Découpe :</strong> Grille rectangulaire uniforme</span>
				<span>Zéro perte / Service express</span>
			</div>
		`;

		proTipText.textContent = `Les gâteaux d'office en plaque sont la solution la plus économique pour les grands banquets. Cuisson homogène et découpe ultra rapide par les maîtres d'hôtel !`;
	}

	function renderComboMode(guests, shape, portion, saveTopTier) {
		const displayTierSizes = [6, 8];
		const displayYield = (saveTopTier ? 0 : (singleTierYields[shape][6][portion] || 12)) + (singleTierYields[shape][8][portion] || 24);
		const neededFromSheet = Math.max(0, guests - displayYield);
		
		let sheetName = '1 × Quart de Plaque (23 × 33 cm)';
		let sheetServings = portion === 'wedding' ? 48 : 24;

		if (neededFromSheet > 48) {
			sheetName = '1 × Demi-Plaque (30 × 45 cm)';
			sheetServings = portion === 'wedding' ? 96 : 48;
		}
		if (neededFromSheet > 96) {
			sheetName = '1 × Grande Plaque (45 × 60 cm)';
			sheetServings = portion === 'wedding' ? 192 : 96;
		}

		const totalComboServings = displayYield + sheetServings;

		resTotalServings.textContent = totalComboServings;
		resTierCount.textContent = 'Apparat + Office';
		resTierDetail.textContent = `2 Étages (15, 20 cm) + ${sheetName.split(' ')[2] || 'Plaque'}`;
		matchStatus.textContent = '💡 Formule Maligne';
		matchStatus.style.background = '#fef08a';
		resServingsDiff.textContent = `+${totalComboServings - guests} parts de réserve`;

		tiersRenderBox.innerHTML = `
			<div style="display: flex; gap: 1rem; align-items: flex-end; justify-content: center; width: 100%;">
				<div style="display: flex; flex-direction: column; align-items: center;">
					<div style="width: 70px; height: 30px; background: #fef08a; border: 2px solid var(--fg-pencil); border-radius: 4px 4px 0 0; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-family: var(--font-heading);">15 cm Haut</div>
					<div style="width: 110px; height: 35px; background: #e0f2fe; border: 2px solid var(--fg-pencil); border-top: none; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-family: var(--font-heading);">20 cm Base</div>
					<span style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px;">Gâteau d'Apparat (${displayYield} parts)</span>
				</div>
				<div style="width: 100px; height: 55px; background: #fed7aa; border: 2px solid var(--fg-pencil); border-radius: 4px; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: var(--font-heading); text-align: center;">
					<span style="font-size: 0.75rem; font-weight: bold;">Gâteau d'Office</span>
					<span style="font-size: 0.7rem; color: var(--accent-blue);">+${sheetServings} parts</span>
				</div>
			</div>
		`;

		tierBreakdownList.innerHTML = `
			<div class="tier-slice-item">
				<span><strong>Gâteau d'Apparat en Salle (15 cm + 20 cm) :</strong></span>
				<span style="color: var(--accent-blue); font-weight: bold;">${displayYield} Parts (Photos & Découpe)</span>
			</div>
			<div class="tier-slice-item">
				<span><strong>Gâteau d'Office en Cuisine (${sheetName}) :</strong></span>
				<span style="color: var(--accent-red); font-weight: bold;">${sheetServings} Parts (Plaque Traiteur)</span>
			</div>
		`;

		proTipText.textContent = `Ce combo hybride vous offre la beauté d'une pièce montée d'apparat tout en économisant 200 € à 400 € de main d'œuvre pâtissière !`;
	}

	// Initial Calculation
	calculateAndRender();
</script>
