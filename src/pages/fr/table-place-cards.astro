---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/table-place-cards/#webapp",
      "name": "Générateur de Marques-Places et Numéros de Table de Mariage",
      "url": "https://manage.wedding/fr/table-place-cards",
      "description": "Générez et imprimez gratuitement vos marques-places chevalets pliés, cartes de placement et numéros de table avec pictogrammes de choix de repas pour le traiteur.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "Article",
      "headline": "Guide Complet des Marques-Places de Mariage, Chevalets et Numéros de Table",
      "description": "Apprenez les différences entre marque-place et plan de table, le grammage de papier idéal, les techniques de pliage et l'insertion des pictogrammes traiteur.",
      "inLanguage": "fr",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Mettre en Page et Imprimer ses Marques-Places de Mariage",
      "description": "Guide étape par étape pour créer des marques-places chevalets avec icônes de repas et les imprimer sur papier cartonné.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Choisir le Format et le Motif de Bordure",
          "text": "Sélectionnez le format chevalet plié (8,5 × 5 cm), la carte plate ou le grand numéro de table de centre de table."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Assigner les Tables et Pictogrammes Menus",
          "text": "Associez le nom de chaque invité à son numéro de table et à son plat (bœuf, volaille, poisson, végétarien) pour faciliter le service traiteur."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Imprimer sur Papier Épais (210 à 300 g/m²)",
          "text": "Exportez les planches PDF et imprimez sur du papier bristol ou vergé pour assurer la bonne tenue du chevalet plié."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Rainurer, Découper et Disposer par Table",
          "text": "Rainurez le pli central avec un plioir et découpez au massicot le long des repères de coupe."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "fr",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle est la différence entre un marque-place et une carte d'escorte (escort card) ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'escort card est remise à l'entrée de la salle pour indiquer à l'invité son numéro de table. Le marque-place est posé directement devant l'assiette pour lui attribuer son siège précis et guider le serveur traiteur avec son choix de plat."
          }
        },
        {
          "@type": "Question",
          "name": "Quel grammage de papier choisir pour des marques-places de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Utilisez un papier cartonné ou vergé entre 250 g/m² et 300 g/m² pour garantir une tenue parfaite du chevalet sans qu'il ne s'affaisse sous l'éclairage de la salle."
          }
        },
        {
          "@type": "Question",
          "name": "Combien de marques-places peut-on imprimer sur une feuille A4 ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour les chevalets pliés (9x10 cm ouverts), exactement 4 cartes entrent par feuille A4. Pour les cartes plates (9x5 cm), entre 8 et 10 cartes par feuille. Pour les numéros de table (13x18 cm), exactement 2 affiches par feuille."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Générateur de Marques-Places et Numéros de Table (PDF Imprimable Gratuit) | Manage.Wedding"
	description="Créez et imprimez des marques-places chevalets pliés, cartes de placement et numéros de table avec pictogrammes repas traiteur. Export PDF, Word et CSV instantané."
	schema={schema}
>
	<!-- Include Google Wedding Typography Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

	<!-- Include html2canvas for preview card capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Créateur de Marques-Places" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Créateur de Marques-Places & Numéros de Table
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Générez des chevalets pliables, des marques-places plats et des numéros de table pour vos centres floraux. Inclut les <strong>pictogrammes de plats traiteur</strong> et l'export <strong>PDF prêt à découper</strong> ou <strong>Word (.doc)</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Comment Générer des Marques-Places en 3 Étapes Simples
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Choisissez le Format & la Bordure
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Sélectionnez chevalets pliés (9x5 cm plié), cartes plates ou grands numéros de table de centre.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Associez Tables & Choix de Menu
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Ajoutez vos convives et activez les pictogrammes de plats (Bœuf, Volaille, Poisson, Végétarien) pour le traiteur.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exportez en PDF & Liste Word
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Cliquez sur <strong>"🖨️ Exporter PDF / Imprimer"</strong> pour les planches à découper ou <strong>"📝 Exporter Word (.doc)"</strong> pour le maître d'hôtel.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="placecards-calc-grid">
			
			<!-- Left Column: Config Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🏷️ Options de Style et Mise en Page
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Personnalisez le format, les bordures artistiques et le plan de table
					</span>
				</div>

				<form id="placecards-form" style="display: flex; flex-direction: column; gap: 1.2rem;">
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;">
						<div>
							<label for="select-card-type" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-red); margin-bottom: 0.35rem;">
								Format de Carte *
							</label>
							<select id="select-card-type" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 6px; background: #fff; font-family: var(--font-body); font-size: 0.92rem; font-weight: 600; cursor: pointer;">
								<option value="tent" selected>🏷️ Chevalets Pliables (9x5 cm plié)</option>
								<option value="flat">🎴 Marques-Places Plats (9x5 cm)</option>
								<option value="tablenum">🔢 Numéros de Table Centre (13x18 cm)</option>
							</select>
						</div>

						<div>
							<label for="select-border-theme" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-blue); margin-bottom: 0.35rem;">
								Thème de Bordure *
							</label>
							<select id="select-border-theme" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 6px; background: #fff; font-family: var(--font-body); font-size: 0.92rem; font-weight: 600; cursor: pointer;">
								<option value="botanical" selected>🌿 Bordure Botanique Florale</option>
								<option value="classic">✒️ Double Ligne Minimaliste</option>
								<option value="crest">🏛️ Volutes & Blason Doré</option>
							</select>
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 6px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block;">
							⚙️ Personnalisations du Marque-Place
						</span>
						<div style="display: flex; gap: 1.25rem; flex-wrap: wrap;">
							<label style="font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-meal-icons" checked style="accent-color: var(--brand-primary, #dc2626); width: 16px; height: 16px;">
								<span>Afficher Pictogrammes Plats (🥩 / 🐟 / 🥦)</span>
							</label>
							<label style="font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-table-badge" checked style="accent-color: var(--brand-primary, #dc2626); width: 16px; height: 16px;">
								<span>Afficher le Numéro de Table</span>
							</label>
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
							<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">
								👥 Liste des Tables : <strong id="assigned-count-badge" style="color: var(--accent-red);">1 Invité</strong>
							</span>
							<div style="display: flex; gap: 0.4rem;">
								<button type="button" id="btn-load-samples" class="hand-btn" style="padding: 0.3rem 0.65rem; font-size: 0.8rem; background: #eff6ff;">
									✨ Charger Exemple
								</button>
								<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.3rem 0.65rem; font-size: 0.8rem; color: #b91c1c;">
									🗑️ Tout Effacer
								</button>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1.4fr 0.8fr 0.9fr auto; gap: 0.4rem; align-items: center;">
							<input type="text" id="input-new-guest-name" placeholder="Nom (ex. Éléonore Martin)" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; font-family: var(--font-body);">
							<input type="text" id="input-new-table-num" placeholder="Table #" value="1" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; font-family: var(--font-body);">
							<select id="select-new-meal" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; background: #fff; font-family: var(--font-body);">
								<option value="🥩 Bœuf">🥩 Bœuf</option>
								<option value="🍗 Volaille">🍗 Volaille</option>
								<option value="🐟 Poisson">🐟 Poisson</option>
								<option value="🥦 Végétarien">🥦 Végétarien</option>
								<option value="🌱 Végétalien">🌱 Végétalien</option>
							</select>
							<button type="button" id="btn-add-guest" class="hand-btn" style="padding: 0.5rem 0.85rem; font-size: 0.88rem; background: var(--brand-primary, #dc2626); color: #fff;">
								+ Ajouter
							</button>
						</div>
					</div>
				</form>
			</div>

			<!-- Right Column: Live Card Preview -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖼️ Aperçu en Direct
							</h3>
							<span id="preview-scale-label" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Chevalet Pliable (9x5 cm Face Avant)
							</span>
						</div>

						<div style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.75rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.88rem; background: #eff6ff;">
								📝 Exporter Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.88rem; background: #fef2f2; color: var(--accent-red); font-weight: 700;">
								🖨️ Exporter PDF / Imprimer
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.75rem; font-size: 0.88rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<div style="display: flex; justify-content: center; align-items: center; padding: 1.25rem 0; min-height: 240px; background: #f1f5f9; border-radius: 8px; border: 1.5px dashed #cbd5e1; margin-bottom: 1.25rem; overflow: hidden;">
						<div id="preview-placecard-canvas" class="card-format-tent theme-botanical"></div>
					</div>

					<button type="button" id="btn-download-sample-png" class="hand-btn" style="width: 100%; text-align: center; font-size: 0.95rem; padding: 0.6rem; background: #f0fdf4; border: 1.5px solid var(--fg-pencil);">
						📸 Télécharger l'Aperçu en Image PNG
					</button>
				</div>

				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 420px; overflow-y: auto;">
					<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						📋 Convives par Table <small style="font-size: 0.8rem; font-weight: normal; color: var(--text-secondary);">(Cliquez pour prévisualiser)</small>
					</h3>
					<div id="table-cards-stream" style="display: flex; flex-direction: column; gap: 0.75rem;"></div>
				</div>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Règle Rapide des Formats & Grammages (BLUF)
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					Spécifications en 1 Minute
				</span>
			</div>
			
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Normes des Formats de Table :</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Chevalets Pliés = 9 × 5 cm (4 par feuille A4)</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Marques-Places Plats = 9 × 5 cm (8–10 par feuille A4)</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Numéros de Table = 13 × 18 cm (2 par feuille A4)</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Grammage et Lisibilité :</strong> Imprimer sur papier cartonné ou vergé de <strong>250g à 300g (GSM)</strong>. Utiliser une taille de <strong>16–20pt</strong> pour les noms, <strong>12–14pt</strong> pour les tables et des pictogrammes de <strong>14–18px</strong> pour les serveurs traiteur.
				</p>
			</div>

			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Élément de Papeterie</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Format Fini</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Par Feuille A4</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Grammage Conseillé</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Taille Typographique</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Emplacement</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Chevalet Plié (Tente)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">9 × 5 cm (Plié)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">4 Cartes (Déplié : 9×10 cm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">250g–300g (Auto-stable)</td>
