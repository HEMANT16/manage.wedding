							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Marque-Place Plat</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">9 × 5 cm (Standard)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">8 à 10 Cartes</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">220g–260g Bristol / Vergé</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">Nom : 16–18pt · Table : 14pt</td>
