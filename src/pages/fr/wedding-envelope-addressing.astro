---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/wedding-envelope-addressing/#webapp",
      "name": "Mise en Page des Adresses d'Enveloppes de Mariage et Règles d'Étiquette",
      "url": "https://manage.wedding/fr/wedding-envelope-addressing",
      "description": "Générez et mettez en page les adresses d'enveloppes de faire-part de mariage selon les règles d'étiquette françaises (couples mariés, médecins, concubins, accompagnants, familles). Export PDF, Word et CSV.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Libeller les Adresses sur les Enveloppes de Faire-Part de Mariage",
      "description": "Guide d'étiquette et de bienséance pour adresser les enveloppes principales, enveloppes intérieures et cartons réponses.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Sélectionner le Format d'Enveloppe",
          "text": "Choisissez le format standard 13 × 18 cm (A7), C5 (16 × 23 cm) ou l'enveloppe retour RSVP C6."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Appliquer les Formules de Civilité Appropriées",
          "text": "Respectez les usages traditionnels (Monsieur et Madame..., Docteur..., Mademoiselle et Monsieur sur deux lignes pour les concubins)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Écrire l'Adresse Postale Sans Abréviation",
          "text": "Selon l'étiquette classique, écrivez en toutes lettres 'Boulevard', 'Avenue', 'Allée' et 'Résidence' pour une présentation soignée."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Positionner l'Adresse de Retour de l'Expéditeur",
          "text": "Imprimez l'adresse des futurs mariés au dos de l'enveloppe sur le rabat de fermeture ou en haut à gauche."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Comment adresser une enveloppe de faire-part à un couple non marié ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Inscrivez le nom de chaque personne sur une ligne distincte (par exemple : 'Mademoiselle Julie Martin' sur la première ligne, puis 'Monsieur Julien Durand' sur la seconde ligne)."
          }
        },
        {
          "@type": "Question",
          "name": "Comment libeller une enveloppe si l'un des conjoints est médecin ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le titre professionnel primant sur le titre de civilité, le médecin est cité en premier : 'Docteur Marie Laurent et Monsieur Julien Laurent' (ou 'Les Docteurs Laurent' si les deux conjoints sont médecins)."
          }
        },
        {
          "@type": "Question",
          "name": "Où inscrire l'adresse de retour des mariés ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditionnellement, l'adresse de retour des mariés est inscrite de manière centrée sur le rabat triangulaire au dos de l'enveloppe, ou en petits caractères en haut à gauche sur la face avant."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Mise en Page des Adresses d'Enveloppes Mariage & Étiquette | Manage.Wedding"
	description="Générez et mettez en page les adresses de faire-part selon les règles d'étiquette françaises (couples mariés, médecins, concubins, accompagnants, familles). Export PDF, Word et CSV."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Adresses d'Enveloppes & Étiquette" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Règles de Bienséance & Export PDF</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Mise en Page des Adresses <span class="accent-italic">d'Enveloppes de Mariage</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 700px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Respectez les règles d'étiquette pour les couples mariés, concubins, médecins, accompagnants (+1) et familles. Prévisualisez les styles de calligraphie et exportez en PDF imprimable et Word.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Controls & Formatter Input -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Format & Étiquette d'Adresse
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						A7 / C5 / C6 / Carré
					</span>
				</div>

				<!-- Envelope Size Selector -->
				<div class="form-group">
					<label class="form-label" for="env-size">Format de l'Enveloppe</label>
					<select id="env-size" class="form-input" style="cursor: pointer;">
						<option value="a7" selected>Enveloppe A7 (133 × 184 mm — Cartons 13×18 cm)</option>
						<option value="a2">Enveloppe Réponse RSVP C6 (114 × 162 mm)</option>
						<option value="inner">Enveloppe Intérieure Nominative (130 × 178 mm)</option>
						<option value="square">Enveloppe Carrée 165 × 165 mm</option>
						<option value="dl">Enveloppe Longue DL 110 × 220 mm</option>
					</select>
				</div>

				<!-- Etiquette Preset Quick-Pick -->
				<div class="form-group">
					<label class="form-label" for="etiquette-preset">
						Raccourci de Civilité & Étiquette
					</label>
					<select id="etiquette-preset" class="form-input" style="background: #f8fafc; font-weight: 600; cursor: pointer;">
						<option value="married-same" selected>👫 Couple Marié (Nom commun) — ex. M. et Mme Alexandre Vaneau</option>
						<option value="married-modern">👫 Couple Marié (Moderne) — ex. Éléonore et Alexandre Vaneau</option>
						<option value="married-diff">👫 Couple Marié (Noms différents) — ex. Mme Éléonore Martin et M. Alexandre Vaneau</option>
						<option value="doctor-wife">🩺 Titre Médical (Épouse médecin) — ex. Docteur Éléonore Martin et M. Alexandre Vaneau</option>
						<option value="doctor-both">🩺 Titre Médical (Tous deux médecins) — ex. Les Docteurs Éléonore et Alexandre Vaneau</option>
						<option value="unmarried">💑 Couple Concubin / Pacsé — (Deux lignes distinctes)</option>
						<option value="single-guest">👤 Invité Célibataire avec Accompagnant(+1) — ex. M. Julien Sterling et son accompagnant(e)</option>
						<option value="family">👨‍👩‍👧‍👦 Famille & Enfants — ex. M. et Mme Vaneau et leurs enfants</option>
						<option value="custom">✏️ Saisie Manuelle Personnalisée</option>
					</select>
				</div>

				<!-- Recipient Name Line 1 -->
				<div class="form-group">
					<label class="form-label" for="rec-name-1">Nom du Destinataire — Ligne 1</label>
					<input type="text" id="rec-name-1" class="form-input" value="Monsieur et Madame Alexandre Vaneau" placeholder="ex. M. et Mme Alexandre Vaneau" />
				</div>

				<!-- Recipient Name Line 2 -->
				<div class="form-group" id="rec-name-2-group" style="display: none;">
					<label class="form-label" for="rec-name-2">Nom du Destinataire (Ligne 2 — Facultatif)</label>
					<input type="text" id="rec-name-2" class="form-input" value="" placeholder="ex. Mademoiselle Julie Martin" />
				</div>

				<!-- Street Address -->
				<div class="form-group">
					<label class="form-label" for="rec-street">Adresse & Numéro de Rue</label>
					<input type="text" id="rec-street" class="form-input" value="14 Avenue des Tilleuls, Bâtiment B" placeholder="ex. 14 Avenue des Tilleuls" />
				</div>

				<!-- City, State & Zip -->
				<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="rec-zip">Code Postal</label>
						<input type="text" id="rec-zip" class="form-input" value="75016" placeholder="75016" />
					</div>
					<div>
						<label class="form-label" for="rec-city">Ville</label>
						<input type="text" id="rec-city" class="form-input" value="Paris" placeholder="Paris" />
					</div>
				</div>

				<!-- Return Address Toggle & Inputs -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.75rem;">
						<input type="checkbox" id="toggle-return-addr" checked style="width: 18px; height: 18px;" />
						<span>Inclure l'Adresse de Retour (Expéditeur)</span>
					</label>

					<div id="return-addr-fields">
						<div class="form-group">
							<label class="form-label" for="ret-names" style="font-size: 0.95rem;">Noms des Mariés (Expéditeur)</label>
							<input type="text" id="ret-names" class="form-input" value="Éléonore & Alexandre" style="font-size: 0.95rem; padding: 0.6rem 0.75rem;" />
						</div>
						<div class="form-group">
							<label class="form-label" for="ret-street" style="font-size: 0.95rem;">Adresse & Ville des Mariés</label>
							<input type="text" id="ret-street" class="form-input" value="8 Rue Royale, 69002 Lyon" style="font-size: 0.95rem; padding: 0.6rem 0.75rem;" />
						</div>
					</div>
				</div>

				<!-- Style Customization -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label class="form-label">Style de Typographie & Calligraphie</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="font-style-btn hand-btn is-active" data-font="script" style="padding: 8px; font-size: 0.9rem; font-family: 'Kalam', cursive;">
							✒️ Calligraphie Moderne
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="serif" style="padding: 8px; font-size: 0.9rem; font-family: Georgia, serif;">
							🏛️ Sérif Classique Roman
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="sans" style="padding: 8px; font-size: 0.9rem; font-family: var(--font-body);">
							✨ Sans-Serif Moderne
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="hand" style="padding: 8px; font-size: 0.9rem; font-family: 'Caveat', cursive;">
							✏️ Écriture Manuscrite
						</button>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Envelope Visual Canvas & Batch Export -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Canvas Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Aperçu Direct de l'Enveloppe
						</h3>
						<span id="env-size-tag" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							A7 : 133 × 184 mm
						</span>
					</div>

					<!-- The Realistic Envelope Box -->
					<div id="envelope-canvas" style="width: 100%; aspect-ratio: 7.25 / 5.25; background: #fffcf5; border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 6px 6px 0px var(--fg-pencil); position: relative; padding: clamp(1rem, 3vw, 2rem); display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; transition: all 0.2s ease;">
						
						<!-- Return Address on Front Top-Left -->
						<div id="canvas-return-addr" style="position: absolute; top: clamp(0.75rem, 2vw, 1.25rem); left: clamp(0.75rem, 2vw, 1.25rem); font-size: clamp(0.68rem, 1.2vw, 0.82rem); line-height: 1.35; color: var(--fg-pencil); max-width: 45%;">
							<strong id="canvas-ret-name" style="display: block;">Éléonore & Alexandre</strong>
							<span id="canvas-ret-full">8 Rue Royale<br/>69002 Lyon</span>
						</div>

						<!-- Postage Stamp Placeholder Stamp Outline -->
						<div style="position: absolute; top: clamp(0.75rem, 2vw, 1.25rem); right: clamp(0.75rem, 2vw, 1.25rem); width: clamp(40px, 7vw, 55px); height: clamp(50px, 8.5vw, 68px); border: 1.5px dashed #94a3b8; border-radius: 3px; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; color: #94a3b8; text-align: center; text-transform: uppercase; font-weight: 700; padding: 2px;">
							Timbre La Poste
						</div>

						<!-- Main Recipient Address Block (Centered) -->
						<div id="canvas-recipient-block" style="text-align: center; margin-top: clamp(1rem, 2.5vw, 2rem);">
							<div id="canvas-rec-name-1" style="font-size: clamp(1.2rem, 2.5vw, 1.85rem); font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem; line-height: 1.25;">
								Monsieur et Madame Alexandre Vaneau
							</div>
							<div id="canvas-rec-name-2" style="font-size: clamp(1.1rem, 2.2vw, 1.65rem); font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem; display: none; line-height: 1.25;"></div>
							<div id="canvas-rec-street" style="font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: #334155; margin-bottom: 0.2rem; line-height: 1.4;">
								14 Avenue des Tilleuls, Bâtiment B
							</div>
							<div id="canvas-rec-city-state-zip" style="font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: #334155; line-height: 1.4;">
								75016 Paris
							</div>
						</div>

					</div>

					<!-- Quick Formatting Audit Checklist -->
					<div style="margin-top: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<strong style="font-size: 0.95rem; display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">
							✅ Vérification de Bienséance & Normes Postales :
						</strong>
						<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
							<li>Civilités et formules de politesse bien orthographiées.</li>
							<li>Nom de voie et commune rédigés sans abréviations complexes.</li>
							<li>Dimensions conformes pour l'insertion de cartons 13 × 18 cm.</li>
						</ul>
					</div>

					<!-- Export Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-envelope" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimer l'Enveloppe (PDF)
						</button>
						<button id="btn-export-word" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Word (.doc)
						</button>
					</div>

				</div>

				<!-- Batch Guest List Address Importer -->
				<div class="hand-card" style="padding: 1.75rem; background: var(--bg-paper);">
					<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
						Importateur d'Adresses en Lot (Copier-Coller / CSV)
					</h3>
					<p style="font-size: 0.92rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
						Collez plusieurs adresses (une par ligne : <em>Nom, Rue, Code Postal, Ville</em>) pour formater l'ensemble de votre carnet d'adresses d'un coup.
					</p>

					<textarea id="batch-paste-input" rows="4" class="hand-input" style="font-size: 0.88rem; line-height: 1.4; margin-bottom: 0.75rem;" placeholder="M. et Mme Robert Davis, 102 Rue des Acacias, 69006, Lyon&#10;Docteur Katherine Evans, 44 Boulevard Haussmann, 75009, Paris&#10;M. Julien Sterling et son accompagnante, 12 Rue de la Paix, 33000, Bordeaux"></textarea>

					<div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
						<button id="btn-load-batch" class="hand-btn" style="padding: 8px 16px; font-size: 0.9rem;">
							Charger les Adresses
						</button>
						<span id="batch-count-tag" style="font-size: 0.85rem; font-weight: 700; color: #64748b;">1 Adresse Prête</span>
					</div>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Repères d'Étiquette</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Guide Rapide : Formules de Politesse sur les Enveloppes de Faire-Part
				</h2>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 Les 4 Règles d'Or du Libellé d'Adresse :
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					1. Pas d'abréviations familières • 2. Les titres professionnels (Docteur, Maître, Colonel) priment sur les civilités • 3. Couples concubins = Lignes superposées • 4. Le format A7 (133 × 184 mm) accueille les cartons 13 × 18 cm.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Situation de l'Invité</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Formule sur l'Enveloppe Extérieure</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Enveloppe Intérieure (Optionnelle)</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Règle d'Étiquette</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Couple Marié (Même nom)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Monsieur et Madame Alexandre Vaneau<br><span style="font-size: 0.8rem; color: #64748b;">(ou Éléonore et Alexandre Vaneau)</span></td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">M. et Mme Vaneau<br><span style="font-size: 0.8rem; color: #64748b;">(ou Éléonore et Alexandre)</span></td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Usage classique ou formule moderne conjointe</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Couple Marié (Noms différents)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Madame Éléonore Martin et Monsieur Alexandre Vaneau</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mme Martin et M. Vaneau</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Citer les deux noms complets</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Épouse Médecin</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Docteur Éléonore Martin et Monsieur Alexandre Vaneau</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Dr Martin et M. Vaneau</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Le titre médical prime et se place en premier</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Couple Concubin / Pacsé</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Mademoiselle Julie Martin<br>Monsieur Julien Durand</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Julie et Julien</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Inscrire les deux noms sur deux lignes superposées</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #d97706);">Célibataire avec Accompagnant (+1)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Monsieur Julien Sterling et son accompagnant(e)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Julien et son invité(e)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Préciser le prénom du +1 si connu</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/fr/wedding-envelope-addressing" category="stationery" />

	</main>

	<!-- Interactive Live Script -->
	<script is:inline>
		const envSizeSelect = document.getElementById('env-size');
		const presetSelect = document.getElementById('etiquette-preset');
		const recName1 = document.getElementById('rec-name-1');
		const recName2 = document.getElementById('rec-name-2');
		const recName2Group = document.getElementById('rec-name-2-group');
		const recStreet = document.getElementById('rec-street');
		const recCity = document.getElementById('rec-city');
		const recZip = document.getElementById('rec-zip');

		const toggleReturnAddr = document.getElementById('toggle-return-addr');
		const returnAddrFields = document.getElementById('return-addr-fields');
		const retNames = document.getElementById('ret-names');
		const retStreet = document.getElementById('ret-street');

		const envelopeCanvas = document.getElementById('envelope-canvas');
		const canvasSizeTag = document.getElementById('env-size-tag');
		const canvasRetAddr = document.getElementById('canvas-return-addr');
		const canvasRetName = document.getElementById('canvas-ret-name');
		const canvasRetFull = document.getElementById('canvas-ret-full');
		const canvasRecName1 = document.getElementById('canvas-rec-name-1');
		const canvasRecName2 = document.getElementById('canvas-rec-name-2');
		const canvasRecStreet = document.getElementById('canvas-rec-street');
		const canvasRecCityStateZip = document.getElementById('canvas-rec-city-state-zip');

		const fontButtons = document.querySelectorAll('.font-style-btn');
		const batchInput = document.getElementById('batch-paste-input');
		const btnLoadBatch = document.getElementById('btn-load-batch');
		const batchCountTag = document.getElementById('batch-count-tag');
		const btnPrint = document.getElementById('btn-print-envelope');
		const btnWord = document.getElementById('btn-export-word');

		let currentFont = 'script';
		let batchAddresses = [];

		function updateCanvas() {
			canvasRecName1.textContent = recName1.value || 'Nom du Destinataire';
			
			if (recName2.value.trim().length > 0) {
				canvasRecName2.style.display = 'block';
				canvasRecName2.textContent = recName2.value.trim();
			} else {
				canvasRecName2.style.display = 'none';
			}

			canvasRecStreet.textContent = recStreet.value || '14 Avenue des Tilleuls';
			canvasRecCityStateZip.textContent = `${recZip.value || '75016'} ${recCity.value || 'Paris'}`;

			if (toggleReturnAddr.checked) {
				canvasRetAddr.style.display = 'block';
				canvasRetName.textContent = retNames.value || '';
				canvasRetFull.textContent = retStreet.value || '';
			} else {
				canvasRetAddr.style.display = 'none';
			}

			const size = envSizeSelect.value;
			if (size === 'a7') {
				envelopeCanvas.style.aspectRatio = '7.25 / 5.25';
				canvasSizeTag.textContent = 'A7 : 133 × 184 mm';
			} else if (size === 'a2') {
				envelopeCanvas.style.aspectRatio = '5.75 / 4.375';
				canvasSizeTag.textContent = 'C6 RSVP : 114 × 162 mm';
			} else if (size === 'inner') {
				envelopeCanvas.style.aspectRatio = '7 / 5.125';
				canvasSizeTag.textContent = 'Intérieure : 130 × 178 mm';
				canvasRetAddr.style.display = 'none';
			} else if (size === 'square') {
				envelopeCanvas.style.aspectRatio = '1 / 1';
				canvasSizeTag.textContent = 'Carrée : 165 × 165 mm';
			} else if (size === 'dl') {
				envelopeCanvas.style.aspectRatio = '9.5 / 4.125';
				canvasSizeTag.textContent = 'Longue DL : 110 × 220 mm';
			}

			if (currentFont === 'script') {
				canvasRecName1.style.fontFamily = "'Kalam', 'Caveat', cursive";
				canvasRecName2.style.fontFamily = "'Kalam', 'Caveat', cursive";
				canvasRecName1.style.letterSpacing = '0.02em';
				canvasRecStreet.style.fontFamily = "var(--font-body)";
				canvasRecCityStateZip.style.fontFamily = "var(--font-body)";
			} else if (currentFont === 'serif') {
				canvasRecName1.style.fontFamily = "Georgia, 'Times New Roman', serif";
				canvasRecName2.style.fontFamily = "Georgia, 'Times New Roman', serif";
				canvasRecName1.style.letterSpacing = '0.05em';
				canvasRecStreet.style.fontFamily = "Georgia, serif";
				canvasRecCityStateZip.style.fontFamily = "Georgia, serif";
			} else if (currentFont === 'sans') {
				canvasRecName1.style.fontFamily = "var(--font-body)";
				canvasRecName2.style.fontFamily = "var(--font-body)";
				canvasRecName1.style.letterSpacing = '0.04em';
				canvasRecStreet.style.fontFamily = "var(--font-body)";
				canvasRecCityStateZip.style.fontFamily = "var(--font-body)";
			} else if (currentFont === 'hand') {
				canvasRecName1.style.fontFamily = "'Caveat', cursive";
				canvasRecName2.style.fontFamily = "'Caveat', cursive";
				canvasRecName1.style.letterSpacing = '0.01em';
				canvasRecStreet.style.fontFamily = "'Caveat', cursive";
				canvasRecCityStateZip.style.fontFamily = "'Caveat', cursive";
			}
		}

		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'married-same') {
				recName1.value = 'Monsieur et Madame Alexandre Vaneau';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'married-modern') {
				recName1.value = 'Éléonore et Alexandre Vaneau';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'married-diff') {
				recName1.value = 'Madame Éléonore Martin et Monsieur Alexandre Vaneau';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'doctor-wife') {
				recName1.value = 'Docteur Éléonore Martin et Monsieur Alexandre Vaneau';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'doctor-both') {
				recName1.value = 'Les Docteurs Éléonore et Alexandre Vaneau';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'unmarried') {
				recName1.value = 'Mademoiselle Julie Martin';
				recName2.value = 'Monsieur Julien Durand';
				recName2Group.style.display = 'block';
			} else if (p === 'single-guest') {
				recName1.value = 'Monsieur Julien Sterling et son accompagnant(e)';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'family') {
				recName1.value = 'Monsieur et Madame Vaneau et leurs enfants';
				recName2.value = '';
				recName2Group.style.display = 'none';
			}
			updateCanvas();
		});

		[recName1, recName2, recStreet, recCity, recZip, retNames, retStreet, envSizeSelect].forEach(input => {
			input.addEventListener('input', updateCanvas);
		});

		toggleReturnAddr.addEventListener('change', () => {
			returnAddrFields.style.display = toggleReturnAddr.checked ? 'block' : 'none';
			updateCanvas();
		});

		fontButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				fontButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentFont = btn.getAttribute('data-font');
				updateCanvas();
			});
		});

		btnLoadBatch.addEventListener('click', () => {
			const text = batchInput.value.trim();
			if (!text) return;
			const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 0);
			if (lines.length === 0) return;

			batchAddresses = lines.map(line => {
				const parts = line.split(',').map(p => p.trim());
				return {
					name: parts[0] || 'Nom Destinataire',
					street: parts[1] || 'Adresse',
					zip: parts[2] || 'Code Postal',
					city: parts[3] || 'Ville'
				};
			});

			batchCountTag.textContent = `${batchAddresses.length} Adresses Chargées`;

			if (batchAddresses.length > 0) {
				const first = batchAddresses[0];
				recName1.value = first.name;
				recName2.value = '';
				recStreet.value = first.street;
				recZip.value = first.zip;
				recCity.value = first.city;
				updateCanvas();
			}
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			const printDoc = printWindow.document;

			const addressesToPrint = batchAddresses.length > 0 ? batchAddresses : [{
				name: recName1.value + (recName2.value ? '<br>' + recName2.value : ''),
				street: recStreet.value,
				zip: recZip.value,
				city: recCity.value
			}];

			const returnHTML = toggleReturnAddr.checked ? `
				<div style="position: absolute; top: 0.5in; left: 0.5in; font-size: 10pt; line-height: 1.3; font-family: sans-serif; color: #1e293b;">
					<strong>${retNames.value}</strong><br/>
					${retStreet.value}
				</div>
			` : '';

			let pagesHTML = '';
			addressesToPrint.forEach(addr => {
				pagesHTML += `
					<div class="envelope-page" style="width: 7.25in; height: 5.25in; position: relative; page-break-after: always; box-sizing: border-box; padding: 1.5in 0.8in 0.8in; text-align: center;">
						${returnHTML}
						<div style="margin-top: 1.2in;">
							<div style="font-size: 18pt; font-weight: bold; margin-bottom: 6px; font-family: ${currentFont === 'serif' ? 'Georgia, serif' : currentFont === 'sans' ? 'sans-serif' : "'Caveat', cursive"}; color: #1e293b;">
								${addr.name}
							</div>
							<div style="font-size: 12pt; color: #334155; font-family: sans-serif; line-height: 1.4;">
								${addr.street}<br/>
								${addr.zip} ${addr.city}
							</div>
						</div>
					</div>
				`;
			});

			printDoc.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Impression Enveloppes de Mariage — Manage.Wedding</title>
					<style>
						@page { size: 7.25in 5.25in; margin: 0; }
						body { margin: 0; padding: 0; background: #fff; }
						.envelope-page { width: 7.25in; height: 5.25in; page-break-after: always; position: relative; box-sizing: border-box; }
					</style>
				</head>
				<body>
					${pagesHTML}
					<script>
						window.onload = function() { window.print(); };
					<\/script>
				</body>
				</html>
			`);
			printDoc.close();
		});

		btnWord.addEventListener('click', () => {
			const addressesToExport = batchAddresses.length > 0 ? batchAddresses : [{
				name: recName1.value + (recName2.value ? ' & ' + recName2.value : ''),
				street: recStreet.value,
				zip: recZip.value,
				city: recCity.value
			}];

			let content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Liste d'Adresses Enveloppes</title>
				<style>
					body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; }
					table { width: 100%; border-collapse: collapse; margin-top: 15px; }
					th, td { border: 1px solid #999; padding: 8px 12px; text-align: left; }
					th { background-color: #f2f2f2; font-weight: bold; }
				</style>
				</head>
				<body>
					<h2>Manage.Wedding — Carnet d'Adresses pour Enveloppes</h2>
					<p>Généré le : ${new Date().toLocaleDateString('fr-FR')} | Expéditeur : ${retNames.value}, ${retStreet.value}</p>
					<table>
						<thead>
							<tr>
								<th>#</th>
								<th>Destinataire</th>
								<th>Adresse</th>
								<th>Code Postal</th>
								<th>Ville</th>
							</tr>
						</thead>
						<tbody>
			`;

			addressesToExport.forEach((addr, idx) => {
				content += `
					<tr>
						<td>${idx + 1}</td>
						<td><strong>${addr.name}</strong></td>
						<td>${addr.street}</td>
						<td>${addr.zip}</td>
						<td>${addr.city}</td>
					</tr>
				`;
			});

			content += `</tbody></table></body></html>`;

			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'adresses-enveloppes-mariage.doc';
			link.click();
		});

		updateCanvas();
	</script>
</Layout>
