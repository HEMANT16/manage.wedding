---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/wedding-invitation-postage-calculator/#webapp",
      "name": "Calculateur d'Affranchissement et Poids de Faire-Part de Mariage",
      "url": "https://manage.wedding/fr/wedding-invitation-postage-calculator",
      "description": "Calculez le poids exact en grammes de votre suite de faire-part et le tarif d'affranchissement La Poste (Lettre Verte 20g, 100g, cachets de cire, timbres personnalisés et enveloppes RSVP).",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Peser et Affranchir ses Faire-Part de Mariage",
      "description": "Guide pour peser son faire-part complet, éviter les courriers retournés et choisir le bon tarif postal.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Assembler un Exemplaire Test Complet",
          "text": "Réunissez l'enveloppe, le carton principal, le carton d'invitation au dîner, le carton RSVP, la pochette calque, le cachet de cire et le ruban."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Peser au Gramme Près sur une Balance de Cuisine",
          "text": "Pesez l'enveloppe garnie. En dessous de 20 grammes, le timbre Lettre Verte 20g suffit. Entre 21 et 100 grammes, le tarif 100g est obligatoire."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Vérifier la Surépaisseur (Cachet de Cire / Relief)",
          "text": "Si votre faire-part comporte un cachet de cire ou un nœud de ruban, demandez une oblitération manuelle au guichet pour éviter qu'il ne soit broyé par les trieuses automatiques."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Pré-Affranchir l'Enveloppe Retour RSVP",
          "text": "Collez un timbre 20g sur chaque enveloppe retour pré-adressée à votre domicile."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien de timbres pour un faire-part de mariage de plus de 20 grammes ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un faire-part pesant entre 21 g et 100 g (ce qui est le cas de la majorité des suites complètes avec plusieurs cartons et cachet de cire) nécessite un affranchissement Lettre Verte tranche 100 g (ou 2 timbres standards 20 g)."
          }
        },
        {
          "@type": "Question",
          "name": "Le cachet de cire abîme-t-il le courrier à La Poste ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les trieuses automatiques de La Poste passent les enveloppes dans des rouleaux mécaniques à haute vitesse qui peuvent arracher les sceaux de cire ou percer les enveloppes. Pour protéger votre cachet, placez-le sur l'enveloppe intérieure ou demandez une oblitération manuelle au guichet."
          }
        },
        {
          "@type": "Question",
          "name": "Faut-il affranchir l'enveloppe réponse RSVP ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui, selon les règles d'étiquette, les mariés pré-remplissent leur adresse et collent un timbre de 20 g sur l'enveloppe retour RSVP afin que les invités n'aient aucun frais à engager pour répondre."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur Frais Postaux Faire-Part & Timbres La Poste | Manage.Wedding"
	description="Calculez le poids exact en grammes de vos faire-part et le coût des timbres La Poste (Lettre Verte 20g, 100g, cachet de cire, timbres personnalisés et enveloppes RSVP)."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Frais Postaux Faire-Part" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Évitez les Courriers Non Affranchis</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Calculateur d'Affranchissement <span class="accent-italic">& Timbres La Poste</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Évitez les taxes pour affranchissement insuffisant ! Calculez le poids exact de votre papeterie en grammes, vérifiez l'impact des cachets de cire et obtenez le budget postal complet pour vos faire-part et cartons réponses.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Suite Component Builder & Weight Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Composition du Faire-Part
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Tarifs La Poste
					</span>
				</div>

				<!-- Suite Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="suite-preset">Modèle Prédéfini de Faire-Part</label>
					<select id="suite-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="classic" selected>💌 Suite Classique 3 Cartons (Enveloppe A7 + Carton 300g + RSVP + Enveloppe / ~27 g)</option>
						<option value="luxury-wax">👑 Suite Prestige avec Cachet de Cire & Ruban (Papier Coton 600g + Sceau / ~42 g)</option>
						<option value="square">🔲 Format Carré Moderne (Enveloppe 16×16 cm + Carton Épais / ~32 g)</option>
						<option value="minimalist">🌿 Carte Unique Épurée (Carton 300g + RSVP en ligne QR Code / ~16 g)</option>
						<option value="custom">✏️ Configuration Personnalisée</option>
					</select>
				</div>

				<!-- Total Households / Invitations Count -->
				<div class="form-group">
					<label class="form-label" for="invitation-count">Nombre de Foyers / Enveloppes à Envoyer</label>
					<input type="number" id="invitation-count" class="form-input" value="85" min="10" max="500" style="font-size: 1.1rem; font-weight: 700;" />
				</div>

				<!-- Outer Envelope Style -->
				<div class="form-group">
					<label class="form-label" for="outer-envelope-type">Format de l'Enveloppe Principale</label>
					<select id="outer-envelope-type" class="form-input" style="cursor: pointer;">
						<option value="a7-rect" selected>Enveloppe Rectangulaire 13 × 18 cm (A7) (7 g)</option>
						<option value="square-6">Enveloppe Carrée 16 × 16 cm (9 g)</option>
						<option value="a8-rect">Enveloppe C5 / 16 × 23 cm (9 g)</option>
					</select>
				</div>

				<!-- Cardstock Thickness (Main Invitation) -->
				<div class="form-group">
					<label class="form-label" for="cardstock-weight">Grammage du Carton Principal</label>
					<select id="cardstock-weight" class="form-input" style="cursor: pointer;">
						<option value="110lb" selected>Papier Standard (300–350 g/m²) — 10 g</option>
						<option value="220lb">Papier Coton Épais / Double Épaisseur (500–600 g/m²) — 20 g</option>
						<option value="acrylic">Plaque Plexiglas / Acrylique Rigide — 42 g</option>
					</select>
				</div>

				<!-- Additional Inserts (Checkboxes) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Encarts & Accessoires Inclus
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-details-card" checked style="width: 18px; height: 18px;" />
							<span>Carton Programme / Dîner (+5 g)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-rsvp-card" checked style="width: 18px; height: 18px;" />
							<span>Carton RSVP + Enveloppe Retour C6 (+9 g)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-vellum" style="width: 18px; height: 18px;" />
							<span>Pochette Calque / Vellum Wrap (+6 g)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--accent-red); font-weight: 700;">
							<input type="checkbox" id="check-wax-seal" style="width: 18px; height: 18px;" />
							<span>Cachet de Cire (+4 g + Surépaisseur)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--accent-blue); font-weight: 700;">
							<input type="checkbox" id="check-ribbon" style="width: 18px; height: 18px;" />
							<span>Ruban de Soie / Nœud Cordelette (+3 g)</span>
						</label>
					</div>
				</div>

			</div>

			<!-- Right Column: Results, Stamp Shopping List & Non-Machinable Warnings -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Postage Rate & Stamp Recommendation Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Tarif d'Affranchissement par Faire-Part
						</span>
						<span id="stamp-category-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							Lettre Verte 100g
						</span>
					</div>

					<div id="display-rate-per-envelope" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						2,58 €
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Poids Total du Faire-Part : <strong id="display-total-weight-g" style="color: var(--fg-pencil);">27,0 grammes</strong> (<span id="display-total-weight-oz">0.95 oz</span>).
					</p>

					<!-- Itemized Stamp Shopping List -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<strong style="display: block; font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--fg-pencil);">
							📮 Récapitulatif Timbres La Poste (<span id="shopping-household-count">85</span> Faire-Part) :
						</strong>
						
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span id="outer-stamp-desc">85 × Timbres Faire-Part :</span>
							<strong id="outer-stamp-cost">219,30 €</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span id="rsvp-stamp-desc">85 × Timbres Enveloppe RSVP (20g) :</span>
							<strong id="rsvp-stamp-cost">109,65 €</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.5rem 0 0 0; font-size: 1.05rem; font-weight: 700; color: var(--accent-red);">
							<span>BUDGET POSTAL TOTAL :</span>
							<strong id="display-grand-total-postage">328,95 €</strong>
						</div>
					</div>

					<!-- Non-Machinable Flag Alert Box -->
					<div id="non-machinable-alert" style="display: none; background: #fef2f2; border: 1.5px solid #ef4444; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem; font-size: 0.88rem; color: #991b1b; line-height: 1.5;">
						<strong>⚠️ Attention à la Surépaisseur & au Cachet de Cire :</strong><br />
						<span id="non-machinable-reasons">Votre faire-part comporte un cachet de cire ou un ruban. Déposez-le au guichet pour demander une oblitération manuelle afin d'éviter le passage en trieuse mécanique.</span>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-postage" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimer la Fiche (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Word (.doc)
						</button>
					</div>

				</div>

				<!-- USPS Hand-Canceling Tip Card -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						💌 Conseils pour l'Envoi des Faire-Part au Bureau de Poste :
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Évitez les boîtes aux lettres de rue :</strong> Déposer des enveloppes avec cachets de cire dans une boîte jaune de rue les envoie directement vers le tri mécanique rapide.</li>
						<li><strong>Présentez-vous au guichet un mardi matin :</strong> Évitez les heures de pointe du samedi. Demandez poliment au guichetier : <em>"Pourriez-vous oblitérer ces faire-part au tampon manuel pour préserver la calligraphie ?"</em></li>
						<li><strong>Pesez 1 exemplaire témoin :</strong> Faites peser votre faire-part complet sur la balance du guichet avant d'acheter votre carnet de timbres de collection ou personnalisés.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Grille Tarifaire</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Guide Rapide : Tranches de Poids & Timbres La Poste (France)
				</h2>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📬 Règle des Tranches de Poids :
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Enveloppe ≤ 20 g = 1,29 € (Lettre Verte 20g) • Enveloppe 21 g à 100 g = 2,58 € (Lettre Verte 100g) • Enveloppe 101 g à 250 g = 4,30 €.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Composition Faire-Part</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Poids Moyen</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Cachet de Cire / Relief</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Tarif Recommandé</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Carte Unique / Épurée (1 seul carton 300g)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">14 à 18 g</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Non (Plat)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">Lettre Verte 20g (1,29 €)</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Suite Complète 3 Cartons (Faire-part + Dîner + RSVP)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">25 à 35 g</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Non</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">Lettre Verte 100g (2,58 €)</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Suite avec Cachet de Cire ou Ruban</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">30 à 45 g</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-red);">OUI (Surépaisseur)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">Lettre Verte 100g (Guichet)</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Plaque Plexiglas ou Coffret</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">60 à 120 g</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-red);">OUI (Rigide)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">100g à 250g (2,58 € à 4,30 €)</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/fr/wedding-invitation-postage-calculator" category="stationery" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('suite-preset');
		const invitationCountInput = document.getElementById('invitation-count');
		const outerEnvSelect = document.getElementById('outer-envelope-type');
		const cardstockSelect = document.getElementById('cardstock-weight');

		const checkDetails = document.getElementById('check-details-card');
		const checkRsvp = document.getElementById('check-rsvp-card');
		const checkVellum = document.getElementById('check-vellum');
		const checkWax = document.getElementById('check-wax-seal');
		const checkRibbon = document.getElementById('check-ribbon');

		const displayRate = document.getElementById('display-rate-per-envelope');
		const stampCategoryBadge = document.getElementById('stamp-category-badge');
		const displayWeightOz = document.getElementById('display-total-weight-oz');
		const displayWeightG = document.getElementById('display-total-weight-g');

		const shoppingHouseholdCount = document.getElementById('shopping-household-count');
		const outerStampDesc = document.getElementById('outer-stamp-desc');
		const outerStampCost = document.getElementById('outer-stamp-cost');
		const rsvpStampDesc = document.getElementById('rsvp-stamp-desc');
		const rsvpStampCost = document.getElementById('rsvp-stamp-cost');
		const displayGrandTotalPostage = document.getElementById('display-grand-total-postage');

		const nonMachinableAlert = document.getElementById('non-machinable-alert');
		const nonMachinableReasons = document.getElementById('non-machinable-reasons');

		const btnPrint = document.getElementById('btn-print-postage');
		const btnDoc = document.getElementById('btn-export-doc');

		function calculatePostage() {
			const count = parseInt(invitationCountInput.value, 10) || 1;
			shoppingHouseholdCount.textContent = count;

			let weightG = 0;

			// Enveloppe
			if (outerEnvSelect.value === 'a7-rect') weightG += 7;
			else if (outerEnvSelect.value === 'square-6') weightG += 9;
			else if (outerEnvSelect.value === 'a8-rect') weightG += 9;

			// Carton principal
			if (cardstockSelect.value === '110lb') weightG += 10;
			else if (cardstockSelect.value === '220lb') weightG += 20;
			else if (cardstockSelect.value === 'acrylic') weightG += 42;

			// Encarts
			if (checkDetails.checked) weightG += 5;
			if (checkRsvp.checked) weightG += 9;
			if (checkVellum.checked) weightG += 6;
			if (checkWax.checked) weightG += 4;
			if (checkRibbon.checked) weightG += 3;

			let hasSpecial = false;
			const reasons = [];

			if (checkWax.checked) {
				hasSpecial = true;
				reasons.push('Cachet de cire (surépaisseur > 5 mm)');
			}
			if (checkRibbon.checked) {
				hasSpecial = true;
				reasons.push('Nœud de ruban / ficelle');
			}
			if (cardstockSelect.value === 'acrylic') {
				hasSpecial = true;
				reasons.push('Carton acrylique rigide');
			}

			let outerRate = 1.29;
			let stampName = 'Lettre Verte 20g';

			if (weightG <= 20) {
				outerRate = 1.29;
				stampName = 'Lettre Verte 20g (1,29 €)';
			} else if (weightG <= 100) {
				outerRate = 2.58;
				stampName = 'Lettre Verte 100g (2,58 €)';
			} else {
				outerRate = 4.30;
				stampName = 'Lettre Verte 250g (4,30 €)';
			}

			const rsvpRate = checkRsvp.checked ? 1.29 : 0;
			const totalOuterPostage = outerRate * count;
			const totalRsvpPostage = rsvpRate * count;
			const grandTotal = totalOuterPostage + totalRsvpPostage;

			displayRate.textContent = `${outerRate.toFixed(2).replace('.', ',')} €`;
			stampCategoryBadge.textContent = stampName;
			displayWeightG.textContent = `${weightG.toFixed(1).replace('.', ',')} grammes`;
			displayWeightOz.textContent = `${(weightG / 28.3495).toFixed(2)} oz`;

			outerStampDesc.textContent = `${count} × Timbres Faire-Part (${stampName}) :`;
			outerStampCost.textContent = `${totalOuterPostage.toFixed(2).replace('.', ',')} €`;

			if (checkRsvp.checked) {
				rsvpStampDesc.textContent = `${count} × Timbres Enveloppe RSVP (20g) :`;
				rsvpStampCost.textContent = `${totalRsvpPostage.toFixed(2).replace('.', ',')} €`;
			} else {
				rsvpStampDesc.textContent = `0 × Timbres RSVP (Réponse en ligne) :`;
				rsvpStampCost.textContent = `0,00 €`;
			}

			displayGrandTotalPostage.textContent = `${grandTotal.toFixed(2).replace('.', ',')} €`;

			if (hasSpecial) {
				nonMachinableAlert.style.display = 'block';
				nonMachinableReasons.textContent = `Attention : ${reasons.join(', ')}. Présentez votre lot au guichet pour une oblitération manuelle.`;
			} else {
				nonMachinableAlert.style.display = 'none';
			}
		}

		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'classic') {
				outerEnvSelect.value = 'a7-rect';
				cardstockSelect.value = '110lb';
				checkDetails.checked = true;
				checkRsvp.checked = true;
				checkVellum.checked = false;
				checkWax.checked = false;
				checkRibbon.checked = false;
			} else if (p === 'luxury-wax') {
				outerEnvSelect.value = 'a7-rect';
				cardstockSelect.value = '220lb';
				checkDetails.checked = true;
				checkRsvp.checked = true;
				checkVellum.checked = true;
				checkWax.checked = true;
				checkRibbon.checked = true;
			} else if (p === 'square') {
				outerEnvSelect.value = 'square-6';
				cardstockSelect.value = '220lb';
				checkDetails.checked = true;
				checkRsvp.checked = true;
				checkVellum.checked = false;
				checkWax.checked = false;
				checkRibbon.checked = false;
			} else if (p === 'minimalist') {
				outerEnvSelect.value = 'a7-rect';
				cardstockSelect.value = '110lb';
				checkDetails.checked = false;
				checkRsvp.checked = false;
				checkVellum.checked = false;
				checkWax.checked = false;
				checkRibbon.checked = false;
			}
			calculatePostage();
		});

		[invitationCountInput, outerEnvSelect, cardstockSelect, checkDetails, checkRsvp, checkVellum, checkWax, checkRibbon].forEach(inp => {
			inp.addEventListener('input', calculatePostage);
			inp.addEventListener('change', calculatePostage);
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Budget Affranchissement Faire-Part — Manage.Wedding</title>
					<style>
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; padding: 20px; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Fiche d'Affranchissement des Faire-Part</h1>
					<p>Nombre de Foyers : ${invitationCountInput.value} | Poids Estimé : ${displayWeightG.textContent}</p>
					
					<table>
						<thead><tr><th>Poste d'Affranchissement</th><th>Tarif Unitaire</th><th>Quantité</th><th>Total Spend (€)</th></tr></thead>
						<tbody>
							<tr><td><strong>Timbres Faire-Part</strong><br /><small>${stampCategoryBadge.textContent}</small></td><td>${displayRate.textContent}</td><td>${invitationCountInput.value}</td><td>${outerStampCost.textContent}</td></tr>
							<tr><td><strong>Timbres Enveloppe RSVP</strong><br /><small>Lettre Verte 20g</small></td><td>${checkRsvp.checked ? '1,29 €' : '0,00 €'}</td><td>${checkRsvp.checked ? invitationCountInput.value : 0}</td><td>${rsvpStampCost.textContent}</td></tr>
							<tr class="total-row"><td>TOTAL BUDGET POSTAL</td><td>—</td><td>—</td><td>${displayGrandTotalPostage.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Fiche Affranchissement Faire-Part</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Récapitulatif d'Affranchissement</h2>
					<p>Faire-Part : ${invitationCountInput.value} | Poids : ${displayWeightG.textContent} | <strong>Total Postal : ${displayGrandTotalPostage.textContent}</strong></p>
					<table>
						<thead><tr><th>Élément</th><th>Type de Timbre</th><th>Coût Total</th></tr></thead>
						<tbody>
							<tr><td>Faire-Part</td><td>${stampCategoryBadge.textContent} (${displayRate.textContent})</td><td>${outerStampCost.textContent}</td></tr>
							<tr><td>Enveloppes RSVP</td><td>Lettre Verte 20g</td><td>${rsvpStampCost.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL</td><td>—</td><td>${displayGrandTotalPostage.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'frais-postaux-faire-part-mariage.doc';
			link.click();
		});

		calculatePostage();
	</script>
</Layout>
