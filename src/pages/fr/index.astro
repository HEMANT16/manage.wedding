---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://manage.wedding/fr/#website",
      "name": "Manage.Wedding — Outils & Simulateurs de Budget Mariage Gratuits",
      "url": "https://manage.wedding/fr/",
      "inLanguage": "fr",
      "description": "Suite privée de calculatrices interactives pour mariage : calcul du vin d'honneur, plan de table, budget réel et papeterie à imprimer.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://manage.wedding/fr/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Tous les outils sur Manage.Wedding sont-ils totalement gratuits ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui, 100% gratuits, sans inscription, sans carte bancaire et sans abonnement. Tous les calculs et téléchargements PDF et Word sont générés instantanément dans votre navigateur."
          }
        },
        {
          "@type": "Question",
          "name": "Manage.Wedding conserve-t-il mes données d'invités ou de budget ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Non. Manage.Wedding fonctionne selon une architecture locale (Local-First). Vos listes d'invités, budgets et adresses postales sont enregistrés exclusivement dans la mémoire de votre appareil et ne sont jamais envoyés sur des serveurs externes."
          }
        },
        {
          "@type": "Question",
          "name": "Quelles sont les 4 étapes indispensables pour planifier les chiffres d'un mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. Budget & Financement (Répartition des dépenses et frais cachés de salle), 2. Boissons & Traiteur (Calcul des bouteilles de vin d'honneur et portions de wedding cake), 3. Invités & Logistique (Plan de table interactif et planning détaillé du Jour J), et 4. Papeterie & Souvenirs (Formatage des enveloppes, menus imprimables et temps de discours)."
          }
        }
      ]
    }
  ]
};

const searchIndex = [
  // Budget (Finances)
  { title: "Simulateur de Budget Global", url: "/fr/master-budget-calculator", category: "Budget", desc: "Répartition selon la règle éprouvée 50/15/10/10/10/5." },
  { title: "Frais Cachés du Lieu de Réception", url: "/fr/wedding-venue-cost-calculator", category: "Budget", desc: "Calculez le coût réel avec minimum de restauration et frais de service." },
  { title: "Qui Paie Quoi au Mariage ?", url: "/fr/who-pays-for-what-wedding", category: "Budget", desc: "Comparez le protocole traditionnel avec la répartition moderne entre familles." },
  { title: "Budget Enterrement de Vie (EVJF / EVG)", url: "/fr/bachelorette-budget-calculator", category: "Budget", desc: "Partagez l'hébergement et les activités en offrant la part de la mariée." },
  { title: "Guide des Pourboires Prestataires", url: "/fr/vendor-tipping-calculator", category: "Budget", desc: "Montants d'usage et création d'enveloppes de remerciement." },
  { title: "Budget Voyage de Noces", url: "/fr/honeymoon-budget-estimator", category: "Budget", desc: "Estimez billets d'avion, hébergements, dîners et liste de valise." },
  { title: "Simulateur de Prêt Mariage", url: "/fr/wedding-loan-calculator", category: "Budget", desc: "Mensualités, coût total des intérêts et tableau d'amortissement." },
  { title: "Calculateur de Cadeau en Argent", url: "/fr/gift-cash-calculator", category: "Budget", desc: "Combien donner selon le lien de parenté, l'accompagnant et le déplacement." },

  // Réception (Dining)
  { title: "Calculateur de Boissons & Vin d'Honneur", url: "/fr/wedding-drink-calculator", category: "Réception", desc: "Estimez précisément vin, bière, champagne, spiritueux et glaçons." },
  { title: "Calculateur de Spiritueux & Bouteilles de Cocktail", url: "/fr/liquor-wedding-calculator", category: "Réception", desc: "Optimisez les bouteilles de 70cl et formats magnums pour le bar." },
  { title: "Calculateur de Prix du Gâteau de Mariage", url: "/fr/cake-pricing-calculator", category: "Réception", desc: "Coût par part, temps de travail et devis pâtissier." },
  { title: "Portions & Étages de Wedding Cake", url: "/fr/cake-serving-calculator", category: "Réception", desc: "Dimensions des étages ronds et carrés pour 50 à 300+ convives." },
  { title: "Créateur de Menus Imprimables (4x9)", url: "/fr/reception-menu-maker", category: "Réception", desc: "Composez des menus élégants aux formats DL 4x9 et 5x7 en PDF vectoriel." },
  { title: "Traiteur : Menu Servi à Table vs Buffet", url: "/fr/catering-cost-estimator", category: "Réception", desc: "Comparez le coût par personne entre service à table, buffet et ateliers culinaires." },
  { title: "Calculateur de Dilution d'Alcool & Cocktails", url: "/fr/alcohol-dilution-calculator", category: "Réception", desc: "Ajustez le degré alcoolique et les volumes pour vos cocktails en fontaine." },
  { title: "Budget Fleurs & Décoration Florale", url: "/fr/floral-cost-estimator", category: "Réception", desc: "Bouquet de mariée, centres de table, boutonnières et arche fleurie." },

  // Invités (Guests)
  { title: "Plan de Table Interactif (Glisser-Déposer)", url: "/fr/seating-chart-maker", category: "Invités", desc: "Agencez vos tables rondes et d'honneur et téléchargez le plan imprimable." },
  { title: "Dimensions de la Salle & Piste de Danse", url: "/fr/seating-clearance-calculator", category: "Invités", desc: "Surface de piste de danse et allées de 1,5m pour le service des serveurs." },
  { title: "Ordre du Cortège Nupcial & Cérémonie", url: "/fr/wedding-processional-order", category: "Invités", desc: "Organisation de l'entrée et de la sortie pour cérémonies civiles et religieuses." },
  { title: "Planning Déroulé du Jour J (Minute par Minute)", url: "/fr/day-of-timeline-generator", category: "Invités", desc: "Itinéraire détaillé des préparatifs, photos, cérémonie et ouverture de bal." },
  { title: "Planificateur de Dîner de Répétition", url: "/fr/rehearsal-dinner-planner", category: "Invités", desc: "Liste des proches, budget restauration et planning de la veille." },
  { title: "Gestionnaire de Liste d'Invités", url: "/fr/guest-list-manager", category: "Invités", desc: "Suivi des accompagnants, adresses postales et régimes alimentaires." },
  { title: "Suivi des Réponses & Confirmations (RSVP)", url: "/fr/rsvp-tracker", category: "Invités", desc: "Compteur en temps réel des présences, désistements et choix de plats." },
  { title: "Estimateur du Taux de Présence Réel", url: "/fr/guest-count-estimator", category: "Invités", desc: "Probabilité de présence selon invités locaux et proches venant de loin." },
  { title: "Calendrier d'Envoi des Faire-part", url: "/fr/rsvp-date-calculator", category: "Invités", desc: "Dates idéales pour Save-the-Date, invitations et date limite de réponse." },
  { title: "Checklist de Mariage sur 12 Mois", url: "/fr/wedding-checklist", category: "Invités", desc: "Liste de tâches interactive mois par mois avec sauvegarde automatique." },
  { title: "Estimateur des Retouches de Robe de Mariée", url: "/fr/dress-alterations-estimator", category: "Invités", desc: "Ourlet, ajustement de bustier et pose de système de traîne." },
  { title: "Convertisseur de Tailles de Robe de Mariée", url: "/fr/dress-size-converter", category: "Invités", desc: "Conversion de vos mensurations en cm vers les tailles FR, US, UK et IT." },
  { title: "Baguier & Guide des Tailles d'Alliances", url: "/fr/ring-size-converter", category: "Invités", desc: "Correspondance en millimètres pour bagues françaises, européennes et US." },

  // Papeterie (Stationery)
  { title: "Adressage & Calligraphie d'Enveloppes", url: "/fr/wedding-envelope-addressing", category: "Papeterie", desc: "Mise en page des adresses avec formules de politesse et export PDF." },
  { title: "Dimensions des Faire-part & Cartons (A7/A6)", url: "/fr/wedding-invitation-suite-sizer", category: "Papeterie", desc: "Formats standards pour cartons d'invitation, RSVP et marges Canva 300 DPI." },
  { title: "Calculateur d'Affranchissement Postal", url: "/fr/wedding-invitation-postage-calculator", category: "Papeterie", desc: "Poids des enveloppes, sceaux de cire et tarifs postaux pour faire-part." },
  { title: "Marque-places & Numéros de Table Imprimables", url: "/fr/table-place-cards", category: "Papeterie", desc: "Chevalets pliables avec pictogrammes de menu pour les serveurs." },
  { title: "Modèles de Cartes de Remerciement", url: "/fr/wedding-thank-you-cards", category: "Papeterie", desc: "Idées de textes pour urne de mariage, cadeaux et présence des invités." },
  { title: "Créateur de Faire-part Digitaux", url: "/fr/digital-invitations", category: "Papeterie", desc: "Cartes numériques avec bouton d'ajout au calendrier et confirmation en ligne." },
  { title: "Chronomètre de Discours & Vœux de Mariage", url: "/fr/wedding-speech-calculator", category: "Papeterie", desc: "Compteur de mots, rythme de parole et fiches aide-mémoire à imprimer." },
  { title: "Générateur de Hashtags de Mariage", url: "/fr/wedding-hashtag-generator", category: "Papeterie", desc: "Idées de hashtags personnalisés et affiches pour les tables de mariage." },
  { title: "Numérologie de la Date de Mariage", url: "/fr/wedding-date-numerology", category: "Papeterie", desc: "Calculez la vibration spirituelle et le chemin de vie de votre date d'union." },
  { title: "Guide des Noces & Cadeaux d'Anniversaire", url: "/fr/anniversary-gift-finder", category: "Papeterie", desc: "Noces de Coton, Émeraude ou Diamant : tous les cadeaux de l'an 1 à 60." }
];
---

<Layout 
	title="Manage.Wedding — Outils & Simulateurs de Budget Mariage Gratuits"
	description="Suite privée de calculatrices interactives pour mariage : calcul du vin d'honneur, plan de table, budget réel et papeterie à imprimer. 100% gratuit et sans inscription."
	schema={schema}
>
	<main>
		<!-- 1. Hero: Digital Sketchbook & Live Instant Search -->
		<section class="section-paper fade-in" style="padding: 4rem 1.5rem 3rem; position: relative; overflow: hidden; border-bottom: 3px solid var(--fg-pencil);">
			
			<div class="tape" style="top: -10px;"></div>
			
			<div style="max-width: 1050px; margin: 0 auto; text-align: center; position: relative; z-index: 10;">
				
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 6px 16px; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-1deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.95rem; font-weight: 700; color: var(--fg-pencil);">100% Gratuit • Confidentialité Totale • Téléchargements Immédiats</span>
				</div>

				<h1 class="font-heading" style="font-size: clamp(36px, 6.5vw, 68px); line-height: 1.15; color: var(--fg-pencil); margin-bottom: 1.25rem;">
					Planifiez les chiffres de votre mariage <br class="hidden sm:inline" />
					<span style="color: var(--accent-blue); text-decoration: underline; text-decoration-style: wavy;">sans aucun stress.</span>
				</h1>

				<p style="font-size: clamp(1.1rem, 2.5vw, 1.3rem); color: var(--text-secondary); max-width: 760px; margin: 0 auto 2rem; line-height: 1.6;">
					Votre carnet de bord numérique privé pour calculer le vin d'honneur, maîtriser les frais de réception, agencer le plan de table et créer votre papeterie.
				</p>

				<!-- Live Instant Search Bar with Dynamic Dropdown -->
				<div style="position: relative; max-width: 650px; margin: 0 auto 2rem;">
					<div class="search-hero-box" style="margin-bottom: 0;">
						<span style="font-size: 1.3rem; color: #64748b;">🔍</span>
						<input 
							type="text" 
							id="home-tool-search" 
							class="search-hero-input" 
							placeholder="Rechercher un outil : vin d'honneur, traiteur, gâteau, plan de table..."
							aria-label="Rechercher des calculatrices de mariage"
							autocomplete="off"
						/>
						<button id="clear-search-btn" style="display: none; background: none; border: none; font-size: 1.1rem; color: #94a3b8; cursor: pointer; padding: 0 0.5rem;">✕</button>
					</div>

					<!-- Search Results Live Dropdown Popup -->
					<div id="search-dropdown-results" style="display: none; position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 4px 4px 0px var(--fg-pencil); max-height: 380px; overflow-y: auto; z-index: 100; text-align: left; padding: 0.5rem;">
						<!-- Injected by JavaScript -->
					</div>
				</div>

				<!-- Fast Shortcut Chips -->
				<div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; max-width: 800px; margin: 0 auto 2rem;">
					<span style="font-size: 0.88rem; font-weight: 600; color: #64748b; align-self: center;">Outils Phares :</span>
					<a href="/fr/wedding-drink-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Vin d'Honneur</a>
					<a href="/fr/wedding-venue-cost-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🏰 Frais de Salle</a>
					<a href="/fr/seating-chart-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🪑 Plan de Table</a>
					<a href="/fr/reception-menu-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">📜 Menus Imprimables</a>
					<a href="/fr/wedding-envelope-addressing" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">✉️ Adressage Faire-part</a>
				</div>

				<!-- Main Hero CTAs -->
				<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
					<a href="#featured-favorites" class="hand-btn" style="padding: 14px 30px; font-size: 1.15rem;">
						Découvrir les Outils Phares ↓
					</a>
					<a href="/fr/about" class="hand-btn secondary" style="padding: 14px 26px; font-size: 1.15rem;">
						Pourquoi Manage.Wedding ?
					</a>
				</div>

			</div>
		</section>

		<!-- 2. Spotlight "Crowd Favorites" (4 Illustrated Cards) -->
		<section id="featured-favorites" style="padding: 4rem 1.5rem; max-width: 1200px; margin: 0 auto;">
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil);">
					⭐ Les Outils Préférés des Mariés
				</h2>
				<p style="font-size: 1.1rem; color: var(--text-secondary); max-width: 600px; margin: 0.25rem auto 0;">
					Les simulateurs plébiscités par des milliers de couples et d'organisateurs d'événements.
				</p>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 2rem;">
				
				<!-- Featured 1: Open Bar -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/wedding_bar_sketch.webp" 
						alt="Calculateur de Boissons & Vin d'Honneur pour Mariage" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #fef08a; border-color: var(--fg-pencil); color: var(--fg-pencil);">Très Populaire</span>
						<span class="tool-time">⏱️ 2 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Calculateur de Boissons & Vin d'Honneur</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Estimez avec précision le vin, le champagne, la bière, les spiritueux et les glaçons pour votre soirée.
					</p>
					<a href="/fr/wedding-drink-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Calculer les Boissons →
					</a>
				</div>

				<!-- Featured 2: Master Budget -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/calculator_sketch.webp" 
						alt="Simulateur de Budget Global de Mariage" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dbeafe; border-color: #93c5fd; color: #1e40af;">Finances</span>
						<span class="tool-time">⏱️ 3 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Simulateur de Budget Global</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Ventilez n'importe quelle somme selon les pourcentages réels du secteur nuptial.
					</p>
					<a href="/fr/master-budget-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Répartir le Budget →
					</a>
				</div>

				<!-- Featured 3: Day-Of Timeline -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/pocket-watch-sketch.webp" 
						alt="Planning Déroulé du Jour J" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dcfce7; border-color: #86efac; color: #166534;">Logistique</span>
						<span class="tool-time">⏱️ 3 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Planning Déroulé du Jour J</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Générez un planning minute par minute pour photographes, coiffeurs et prestataires.
					</p>
					<a href="/fr/day-of-timeline-generator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Créer le Planning →
					</a>
				</div>

				<!-- Featured 4: Seating Chart -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/seating_chart_sketch.webp" 
						alt="Plan de Table Interactif pour Mariage" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #f3e8ff; border-color: #d8b4fe; color: #6b21a8;">Interactif</span>
						<span class="tool-time">⏱️ 5 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Plan de Table Interactif</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Disposez les tables rondes et rectangulaires, placez vos convives et téléchargez le plan.
					</p>
					<a href="/fr/seating-chart-maker" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Créer le Plan de Table →
					</a>
				</div>

			</div>
		</section>

		<!-- 3. The 4-Phase Wedding Planning Master Roadmap -->
		<section style="background: var(--muted-paper); padding: 4.5rem 1.5rem; border-top: 3px dashed var(--fg-pencil); border-bottom: 3px dashed var(--fg-pencil);">
			<div style="max-width: 1100px; margin: 0 auto;">
				
				<div style="text-align: center; margin-bottom: 3rem;">
					<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Feuille de Route</span>
					<h2 class="font-heading" style="font-size: clamp(28px, 4.5vw, 44px); color: var(--fg-pencil);">
						Le Guide Maître d'Organisation
					</h2>
					<p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 650px; margin: 0.25rem auto 0;">
						Ce qu'il faut calculer, dimensionner et valider à chaque étape des préparatifs.
					</p>
				</div>

				<div style="display: flex; flex-direction: column; gap: 1.75rem;">
					
					<!-- Roadmap Step 1 -->
					<div class="hand-card" style="padding: 1.75rem; background: #fff; border-left: 6px solid var(--accent-red);">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								Phase 1 : Budget Réel et Réservation du Lieu (12 à 9 Mois Avant)
							</h3>
							<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
								Étape 01
							</span>
						</div>
						<p class="font-body" style="font-size: 1rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 1rem 0;">
							Définissez votre plafond budgétaire avant les visites de domaines et châteaux. Auditez les devis pour repérer les minimums de facturation traiteur et frais de service cachés. Clarifiez les participations familiales en toute sérénité.
						</p>
						<div style="display: flex; gap: 0.75rem; flex-wrap: wrap; font-size: 0.88rem;">
							<a href="/fr/master-budget-calculator" class="tool-tag" style="text-decoration: none; font-weight: 700;">💰 Simulateur de Budget</a>
