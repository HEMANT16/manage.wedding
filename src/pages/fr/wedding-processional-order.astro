---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/wedding-processional-order/#webapp",
      "name": "Générateur d'Ordre du Cortège de Cérémonie de Mariage",
      "url": "https://manage.wedding/fr/wedding-processional-order",
      "description": "Créez l'ordre d'entrée du cortège et la sortie de cérémonie sur mesure pour mariages laïques, chrétiens, catholiques, juifs et modernes. Guide imprimable pour officiant et témoins.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Organiser l'Ordre du Cortège de Cérémonie de Mariage",
      "description": "Guide pas à pas pour structurer l'entrée des mariés, des témoins, des enfants d'honneur et la sortie de cérémonie.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Installation des Grands-Parents et Parents",
          "text": "Le cortège commence par l'installation des grands-parents, suivie des parents du marié et de la mère de la mariée au premier rang."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Entrée du Marié et de l'Officiant",
          "text": "Le marié entre au bras de sa mère (ou aux côtés de son témoin) et prend position à l'autel ou sous l'arche."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Entrée des Témoins et Enfants d'Honneur",
          "text": "Les témoins, demoiselles d'honneur, garçons d'honneur et enfants d'honneur (porteur d'alliances) remontent l'allée espacés de 4 à 6 pas."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Entrée Magistrale de la Mariée",
          "text": "La musique d'entrée se lance. La mariée fait son entrée au bras de son père, de ses deux parents ou seule."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qui entre en premier dans un cortège de mariage traditionnel français ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditionnellement, les invités prennent place, puis le marié entre au bras de sa mère, suivi des témoins et des enfants d'honneur. La mariée clôture le cortège au bras de son père."
          }
        },
        {
          "@type": "Question",
          "name": "De quel côté se place la mariée à l'autel ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dans la tradition occidentale et laïque, la mariée se tient à gauche de l'autel (face à l'officiant) et le marié à droite. Dans la tradition juive, la mariée se place à droite et le marié à gauche."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle est la distance idéale entre chaque personne dans l'allée ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il est recommandé de respecter la règle du mi-chemin : chaque personne ou duo ne s'engage dans l'allée que lorsque le cortège précédent a franchi la moitié de la nef. Cela permet au photographe de capturer des portraits nets de chacun."
          }
        },
        {
          "@type": "Question",
          "name": "Dans quel ordre se fait la sortie de cérémonie (récession) ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La sortie est l'inverse exact : les nouveaux mariés sortent en premier sous les applaudissements et les pétales, suivis des enfants d'honneur, des témoins en duo, puis des parents et grands-parents."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Ordre du Cortège de Mariage & Entrée Cérémonie (Guide Gratuit) | Manage.Wedding"
	description="Créez l'ordre d'entrée et de sortie pour votre cérémonie laïque, chrétienne, catholique, juive ou moderne. Fiche de poche imprimable pour officiant et témoins."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Ordre du Cortège de Cérémonie" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Répétition & Fiche Déroulé Officiant</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Ordre du Cortège <span class="accent-italic">& Entrée de Cérémonie</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Organisez l'ordre d'entrée dans l'allée, le placement à l'autel et la sortie triomphale pour cérémonie laïque, catholique, juive ou moderne. Exportez une fiche de poche pour vos témoins et votre officiant.
			</p>
		</header>

		<!-- Main Interactive Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Ceremony Configuration & Lineup Builder -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Configuration du Cortège
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Multi-Cérémonies
					</span>
				</div>

				<!-- Tradition Selector -->
				<div class="form-group">
					<label class="form-label" for="ceremony-tradition">Type de Cérémonie / Tradition</label>
					<select id="ceremony-tradition" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="christian" selected>✝️ Cortège Classique Français / Cérémonie Laïque</option>
						<option value="jewish">✡️ Cérémonie Juive (Sous la Houppa)</option>
						<option value="catholic">⛪ Messe de Mariage Catholique</option>
						<option value="nondenom">✨ Cérémonie Laïque Épurée & Moderne</option>
						<option value="lgbtq">🌈 Double Entrée / Symétrique</option>
						<option value="minimalist">🌿 Mariage Intimiste / Cortège Court</option>
					</select>
				</div>

				<!-- Mode Selector (Processional vs Recessional) -->
				<div class="form-group">
					<label class="form-label">Phase de la Cérémonie</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="phase-btn hand-btn is-active" data-phase="processional" style="padding: 8px; font-size: 0.9rem;">
							🚶‍♂️ 1. Entrée (Cortège)
						</button>
						<button type="button" class="phase-btn hand-btn" data-phase="recessional" style="padding: 8px; font-size: 0.9rem;">
							🎉 2. Sortie (Récession)
						</button>
					</div>
				</div>

				<!-- Couple Names -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="partner1-name">Mariée / Conjoint 1</label>
						<input type="text" id="partner1-name" class="form-input" value="Éléonore" placeholder="ex. Éléonore" />
					</div>
					<div>
						<label class="form-label" for="partner2-name">Marié / Conjoint 2</label>
						<input type="text" id="partner2-name" class="form-input" value="Alexandre" placeholder="ex. Alexandre" />
					</div>
				</div>

				<!-- Escort Selection -->
				<div class="form-group">
					<label class="form-label" for="escort-style">Accompagnant de la Mariée (Entrée)</label>
					<select id="escort-style" class="form-input" style="cursor: pointer;">
						<option value="father" selected>Au bras de son Père</option>
						<option value="both-parents">Au bras de ses Deux Parents (Père & Mère)</option>
						<option value="mother">Au bras de sa Mère</option>
						<option value="sibling">Au bras d'un Frère / Sœur / Proche</option>
						<option value="solo">Entrée Seule dans l'Allée</option>
						<option value="together">Entrée Ensemble en Couple</option>
					</select>
				</div>

				<!-- Quick Add Custom Attendant -->
				<div class="form-group" style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label class="form-label">Ajouter un Membre Spécifique au Cortège</label>
					<div style="display: flex; gap: 0.5rem;">
						<input type="text" id="custom-member-input" class="form-input" placeholder="ex. Chien porteur d'alliances, Beau-Père" style="flex: 1;" />
						<button id="btn-add-custom-member" type="button" class="hand-btn secondary" style="padding: 8px 14px; font-size: 0.9rem;">
							+ Ajouter
						</button>
					</div>
				</div>

			</div>

			<!-- Right Column: Interactive Lineup Cards & Coordinator Pocket Sheet -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Lineup Card Container -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 id="lineup-heading" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							1. Ordre d'Entrée du Cortège
						</h3>
						<span id="lineup-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							9 Étapes | Espacement 4-6 pas
						</span>
					</div>

					<!-- Visual Lineup Cards List -->
					<div id="lineup-list-container" style="display: flex; flex-direction: column; gap: 0.6rem; max-height: 520px; overflow-y: auto; padding-right: 4px;">
						<!-- Dynamic Step Rows Rendered Here -->
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-pocket-sheet" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimer la Fiche Témoins / Officiant
						</button>
						<button id="btn-export-text" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📲</span> Copier pour WhatsApp
						</button>
					</div>

				</div>

				<!-- Music Transition & Timing Cue Box -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						🎵 Repères Musicaux & Transitions :
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Morceau 1 (Entrée du Cortège) :</strong> Pour l'installation des parents, du marié et des témoins.</li>
						<li><strong>Pause Musicale (10-15s) :</strong> Silence complet, fermeture et réouverture des portes, l'assemblée se lève.</li>
						<li><strong>Morceau 2 (Entrée de la Mariée) :</strong> Musique majestueuse et émouvante pour la mariée.</li>
						<li><strong>Morceau 3 (Sortie Triomphale) :</strong> Titre festif et entraînant pour la pluie de confettis/pétales !</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Repères Cortège</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Guide Rapide : Ordre de Passage Cérémonie
				</h2>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					🚶‍♂️ La Règle d'Or du Cortège d'Entrée & de Sortie :
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Entrée : [Parents → Marié & sa mère → Témoins & Demoiselles d'honneur → Enfants d'honneur → Mariée & son père] • Sortie : [Nouveaux Mariés en PREMIER → Enfants d'honneur → Témoins → Parents].
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Tradition de Cérémonie</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Style d'Entrée & Escorte</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Placement à l'Autel</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Règle Spécifique</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Classique / Laïque</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Marié avec sa mère ; Mariée avec son père.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mariée à GAUCHE, Marié à DROITE</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">La mariée entre en toute dernière position</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Juive (Houppa)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Marié avec ses 2 parents ; Mariée avec ses 2 parents.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mariée à DROITE, Marié à GAUCHE</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Rabbin en tête ; Tous les parents sous la Houppa</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Messe Catholique</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Prêtre et enfants de chœur en procession liturgique.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mariée à GAUCHE, Marié à DROITE</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Liturgie de la Parole et bénédiction des alliances</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Moderne / LGBTQ+</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Double allée simultanée ou entrée conjointe main dans la main.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Libre selon vos souhaits</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Mise en scène symétrique et égalitaire</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/fr/wedding-processional-order" category="stationery" />

	</main>

	<!-- Interactive Script -->
	<script is:inline>
		const traditionSelect = document.getElementById('ceremony-tradition');
		const partner1Input = document.getElementById('partner1-name');
		const partner2Input = document.getElementById('partner2-name');
		const escortSelect = document.getElementById('escort-style');
		const phaseButtons = document.querySelectorAll('.phase-btn');
		const lineupContainer = document.getElementById('lineup-list-container');
		const lineupHeading = document.getElementById('lineup-heading');
		const lineupCountBadge = document.getElementById('lineup-count-badge');
		const customInput = document.getElementById('custom-member-input');
		const btnAddCustom = document.getElementById('btn-add-custom-member');
		const btnPrint = document.getElementById('btn-print-pocket-sheet');
		const btnCopyText = document.getElementById('btn-export-text');

		let currentPhase = 'processional';
		let lineupData = [];

		const presets = {
			christian: [
				{ role: "Installation des Grands-Parents", names: "Grands-parents des mariés", cue: "Début Morceau 1" },
				{ role: "Installation du Père de la Mariée & Mère du Marié", names: "Parents respectifs", cue: "" },
				{ role: "Entrée de la Mère de la Mariée", names: "Maman de la Mariée (au 1er rang)", cue: "Signal du début officiel" },
				{ role: "Entrée du Marié au bras de sa Mère", names: "Alexandre & sa Maman", cue: "Installation sous l'arche" },
				{ role: "Entrée des Témoins & Demoiselles d'Honneur", names: "Cortège des témoins (en duo ou solo)", cue: "Règle du mi-chemin" },
				{ role: "Témoin Principal / Demoiselle d'Honneur", names: "Témoins d'honneur", cue: "Placement à gauche et à droite" },
				{ role: "Enfants d'Honneur & Porteur d'Alliances", names: "Enfants d'honneur (Alliances & Pétales)", cue: "" },
				{ role: "Entrée de la Mariée & Accompagnant", names: "Éléonore & son Père", cue: "🎵 Morceau 2 (Marche Nuptiale)" }
			],
			jewish: [
				{ role: "Rabbin et/ou Chantre", names: "Rabbin & Cantor", cue: "Placement sous la Houppa" },
				{ role: "Grands-Parents des Mariés", names: "Grands-parents", cue: "" },
				{ role: "Garçons d'Honneur & Témoins", names: "Témoins du marié", cue: "Placement sous la Houppa" },
				{ role: "Entrée du Marié avec ses Deux Parents", names: "Alexandre + Mère & Père", cue: "Placement à gauche sous la Houppa" },
				{ role: "Demoiselles d'Honneur", names: "Témoins de la mariée", cue: "" },
				{ role: "Enfants d'Honneur", names: "Porteur d'alliances", cue: "" },
				{ role: "Entrée de la Mariée avec ses Deux Parents", names: "Éléonore + Mère & Père", cue: "🎵 Entrée sous la Houppa" }
			],
			catholic: [
				{ role: "Procession Liturgique", names: "Prêtre, Diacres & Enfants de Chœur", cue: "Remontent l'allée centrale" },
				{ role: "Entrée du Marié avec sa Mère", names: "Alexandre & sa Mère", cue: "Accueil à l'autel" },
				{ role: "Installation des Mamans", names: "Mères des mariés au 1er rang", cue: "" },
				{ role: "Témoins & Cortège (en duo)", names: "Témoins et amis proches", cue: "Espacement 6 pas" },
				{ role: "Enfants d'Honneur", names: "Porteur d'alliances", cue: "" },
				{ role: "Entrée de la Mariée & son Père", names: "Éléonore & son Père", cue: "🎵 Musique d'Orgue / Entrée" }
			],
			nondenom: [
				{ role: "Installation des Familles VIP", names: "Parents & Grands-Parents", cue: "Musique d'accueil" },
				{ role: "Entrée de l'Officiant(e)", names: "Officiant(e) de Cérémonie", cue: "Prend position au centre" },
				{ role: "Entrée du Conjoint 2", names: "Alexandre (Solo ou avec parents)", cue: "" },
				{ role: "Cortège des Témoins & Proches", names: "Amis proches & demoiselles/garçons", cue: "Règle du mi-chemin" },
				{ role: "Enfants d'Honneur", names: "Porteurs d'alliances / Pétales", cue: "" },
				{ role: "Entrée de la Conjointe 1", names: "Éléonore & son Escorte", cue: "🎵 Morceau Principal d'Entrée" }
			],
			lgbtq: [
				{ role: "Installation des Familles", names: "Parents des deux marié(e)s", cue: "Morceau 1" },
				{ role: "Officiant(e) au Centre", names: "Officiant(e) de cérémonie", cue: "" },
				{ role: "Cortège des Témoins", names: "Témoins et amis en duo", cue: "Alignement symétrique" },
				{ role: "Double Entrée des Marié(e)s", names: "Éléonore & Alexandre (Main dans la main)", cue: "🎵 Entrée conjointe dans l'allée" }
			],
			minimalist: [
				{ role: "Officiant & Marié", names: "Officiant & Alexandre", cue: "Prennent position" },
				{ role: "Témoins", names: "Les deux témoins officiels", cue: "" },
				{ role: "Entrée de la Mariée", names: "Éléonore & son Escorte", cue: "🎵 Entrée de Cérémonie" }
			]
		};

		function loadTradition() {
			const t = traditionSelect.value;
			const raw = presets[t] || presets.christian;
			lineupData = JSON.parse(JSON.stringify(raw));
			applyCustomNames();
		}

		function applyCustomNames() {
			const p1 = partner1Input.value.trim() || 'Éléonore';
			const p2 = partner2Input.value.trim() || 'Alexandre';
			const escort = escortSelect.options[escortSelect.selectedIndex].text;

			lineupData.forEach(item => {
				item.role = item.role.replace(/Éléonore/g, p1).replace(/Alexandre/g, p2);
				item.names = item.names.replace(/Éléonore/g, p1).replace(/Alexandre/g, p2);
				if (item.role.includes('Mariée') && item.role.includes('Accompagnant')) {
					item.names = `${p1} (${escort})`;
				}
			});
			renderLineup();
		}

		function renderLineup() {
			lineupContainer.innerHTML = '';

			let displayList = [...lineupData];
			if (currentPhase === 'recessional') {
				lineupHeading.textContent = '2. Ordre de Sortie de Cérémonie';
				displayList = [
					{ role: "Les Nouveaux Mariés en Premier", names: `${partner1Input.value || 'Éléonore'} & ${partner2Input.value || 'Alexandre'} (Vive les Mariés !)`, cue: "🎵 Musique de Sortie Triomphale" },
					{ role: "Enfants d'Honneur", names: "Enfants d'honneur & Porteur d'alliances", cue: "Sortent juste après le couple" },
					{ role: "Témoins d'Honneur (en duo)", names: "Témoins principaux", cue: "" },
					{ role: "Demoiselles & Garçons d'Honneur", names: "Cortège en duos", cue: "" },
					{ role: "Parents de la Mariée / Conjoint 1", names: "Parents de la Mariée", cue: "" },
					{ role: "Parents du Marié / Conjoint 2", names: "Parents du Marié", cue: "" },
					{ role: "Grands-Parents", names: "Grands-parents", cue: "" },
					{ role: "Sortie des Invités", names: "Les invités suivent rangée par rangée", cue: "Haie d'honneur pour lancer de pétales" }
				];
			} else {
				lineupHeading.textContent = "1. Ordre d'Entrée du Cortège";
			}

			lineupCountBadge.textContent = `${displayList.length} Étapes | Espacement 4-6 pas`;

			displayList.forEach((item, idx) => {
				const row = document.createElement('div');
				row.style.cssText = "display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; gap: 0.75rem;";
				
				row.innerHTML = `
					<div style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">
						<span style="font-weight: 800; font-size: 1.1rem; color: var(--accent-red); width: 24px; text-align: center;">${idx + 1}</span>
						<div>
							<strong style="font-size: 0.98rem; color: var(--fg-pencil); display: block;">${item.role}</strong>
							<span style="font-size: 0.88rem; color: #475569;">${item.names}</span>
							${item.cue ? `<span style="display: block; font-size: 0.78rem; font-weight: 700; color: var(--accent-blue); margin-top: 2px;">⚡ Repère : ${item.cue}</span>` : ''}
						</div>
					</div>
					<div style="display: flex; gap: 4px;">
						<button type="button" class="btn-move-up hand-btn secondary" data-index="${idx}" style="padding: 3px 7px; font-size: 0.75rem;" ${idx === 0 ? 'disabled' : ''}>▲</button>
						<button type="button" class="btn-move-down hand-btn secondary" data-index="${idx}" style="padding: 3px 7px; font-size: 0.75rem;" ${idx === displayList.length - 1 ? 'disabled' : ''}>▼</button>
					</div>
				`;
				lineupContainer.appendChild(row);
			});

			if (currentPhase === 'processional') {
				document.querySelectorAll('.btn-move-up').forEach(b => {
					b.addEventListener('click', () => {
						const idx = parseInt(b.getAttribute('data-index'), 10);
						if (idx > 0) {
							const temp = lineupData[idx];
							lineupData[idx] = lineupData[idx - 1];
							lineupData[idx - 1] = temp;
							renderLineup();
						}
					});
				});
				document.querySelectorAll('.btn-move-down').forEach(b => {
					b.addEventListener('click', () => {
						const idx = parseInt(b.getAttribute('data-index'), 10);
						if (idx < lineupData.length - 1) {
							const temp = lineupData[idx];
							lineupData[idx] = lineupData[idx + 1];
							lineupData[idx + 1] = temp;
							renderLineup();
						}
					});
				});
			}
		}

		phaseButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				phaseButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentPhase = btn.getAttribute('data-phase');
				renderLineup();
			});
		});

		btnAddCustom.addEventListener('click', () => {
			const val = customInput.value.trim();
			if (!val) return;
			lineupData.splice(lineupData.length - 1, 0, {
				role: val,
				names: val,
				cue: "Membre Spécifique"
			});
			customInput.value = '';
			renderLineup();
		});

		traditionSelect.addEventListener('change', loadTradition);
		[partner1Input, partner2Input, escortSelect].forEach(inp => {
			inp.addEventListener('input', applyCustomNames);
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			let html = `
				<!DOCTYPE html>
				<html>
				<head>
					<title>Fiche Cortège Cérémonie — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 1.5cm; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						h2 { font-size: 14pt; margin-top: 18px; margin-bottom: 6px; border-bottom: 2px solid #0f172a; padding-bottom: 3px; }
						table { width: 100%; border-collapse: collapse; margin-top: 8px; }
						th, td { border: 1px solid #cbd5e1; padding: 6px 10px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
					</style>
				</head>
				<body>
					<h1>Guide du Cortège : ${partner1Input.value || 'Éléonore'} & ${partner2Input.value || 'Alexandre'}</h1>
					<p style="font-size: 10pt; color: #64748b; margin-top: 0;">Tradition : ${traditionSelect.options[traditionSelect.selectedIndex].text} | Règle du mi-chemin</p>
					
					<h2>1. Ordre d'Entrée du Cortège (Allée Centrale)</h2>
					<table>
						<thead><tr><th style="width: 40px;">#</th><th>Rôle / Groupe</th><th>Participant(s)</th><th>Repère Musical & Action</th></tr></thead>
						<tbody>
			`;

			lineupData.forEach((item, idx) => {
				html += `
					<tr>
						<td><strong>${idx + 1}</strong></td>
						<td><strong>${item.role}</strong></td>
						<td>${item.names}</td>
						<td>${item.cue || '—'}</td>
					</tr>
				`;
			});

			html += `
						</tbody>
					</table>

					<h2>2. Ordre de Sortie de Cérémonie</h2>
					<table>
						<thead><tr><th style="width: 40px;">#</th><th>Ordre</th><th>Groupe</th></tr></thead>
						<tbody>
							<tr><td>1</td><td><strong>Nouveaux Mariés (En tête)</strong></td><td>${partner1Input.value || 'Éléonore'} & ${partner2Input.value || 'Alexandre'}</td></tr>
							<tr><td>2</td><td>Enfants d'Honneur</td><td>Enfants d'honneur & Alliances</td></tr>
							<tr><td>3</td><td>Témoins d'Honneur</td><td>Témoins en duo</td></tr>
							<tr><td>4</td><td>Demoiselles & Garçons d'Honneur</td><td>Cortège en duos</td></tr>
							<tr><td>5</td><td>Parents des Mariés</td><td>Parents</td></tr>
							<tr><td>6</td><td>Grands-Parents</td><td>Grands-parents</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`;
			printWindow.document.write(html);
			printWindow.document.close();
		});

		btnCopyText.addEventListener('click', () => {
			let text = `⛪ *Cortège de Cérémonie pour ${partner1Input.value || 'Éléonore'} & ${partner2Input.value || 'Alexandre'}*\n\n`;
			text += `*🚶‍♂️ Ordre d'Entrée :*\n`;
			lineupData.forEach((item, idx) => {
				text += `${idx + 1}. ${item.role} (${item.names})${item.cue ? ` - _Repère : ${item.cue}_` : ''}\n`;
			});
			text += `\n*🎉 Sortie de Cérémonie :*\n1. Les Nouveaux Mariés en premier !\n2. Enfants d'honneur\n3. Témoins d'honneur\n4. Demoiselles & Garçons d'honneur\n5. Parents & Grands-parents`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnCopyText.textContent;
				btnCopyText.textContent = '✅ Copié pour WhatsApp !';
				setTimeout(() => { btnCopyText.textContent = orig; }, 2500);
			});
		});

		loadTradition();
	</script>
</Layout>
