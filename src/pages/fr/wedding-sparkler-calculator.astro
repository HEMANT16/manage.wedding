	const resCorridorLen = document.getElementById('res-corridor-len');

	// Timeline Dynamic Elements
	const dynCueTargetTime = document.getElementById('dyn-cue-target-time');
	const timeT30 = document.getElementById('time-t30');
	const timeT15 = document.getElementById('time-t15');
