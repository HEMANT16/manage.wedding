	const signViewStyleA = document.getElementById('sign-view-style-a');
	const signViewStyleB = document.getElementById('sign-view-style-b');
	const signViewStyleC = document.getElementById('sign-view-style-c');

	// Timing dictionary
	const sparklerTimings = {
		'10': { total: 40, wave: 15, photo: 15, quench: 10, label: '35s–45s Totales', pack: 10 },
		'20': { total: 120, wave: 25, photo: 75, quench: 20, label: '120 Secondes Totales (~2 Min)', pack: 8 },
		'36': { total: 240, wave: 30, photo: 180, quench: 30, label: '240 Secondes Totales (~4 Min)', pack: 4 }
	};

	function parseTimeString(timeStr) {
		const match = (timeStr || '').match(/(\d+):(\d+)\s*(AM|PM)?/i);
		if (!match) return { hours: 23, minutes: 45, period: 'PM' };
		let hours = parseInt(match[1], 10);
		let minutes = parseInt(match[2], 10);
		let period = match[3] ? match[3].toUpperCase() : (hours >= 12 ? 'PM' : 'AM');
		return { hours, minutes, period };
	}

	function formatTimeOffset(baseObj, offsetMinutes) {
		let totalMins = baseObj.hours * 60 + baseObj.minutes + offsetMinutes;
		if (baseObj.period === 'PM' && baseObj.hours < 12) totalMins += 12 * 60;
		if (baseObj.period === 'AM' && baseObj.hours === 12) totalMins -= 12 * 60;
		
		totalMins = (totalMins + 1440) % 1440;
		let h = Math.floor(totalMins / 60);
		let m = totalMins % 60;
		const hh = String(h).padStart(2, '0');
		const mm = String(totalMins % 60).padStart(2, '0');
		return `${hh}:${mm}`;
	}

	function calculate() {
		const totalGuests = parseInt(sliderGuests.value, 10);
		if (guestCountBadge) guestCountBadge.textContent = `${totalGuests} invités`;

		// Timing & Retention
		const timingMode = selectTiming ? selectTiming.value : 'late-night';
		let retentionPct = 0.70;

		if (timingMode === 'late-night') {
			if (retentionWrapper) retentionWrapper.style.display = 'none';
			retentionPct = 0.70;
		} else if (timingMode === 'staged') {
			if (retentionWrapper) retentionWrapper.style.display = 'none';
			retentionPct = 0.95;
		} else if (timingMode === 'ceremony') {
			if (retentionWrapper) retentionWrapper.style.display = 'none';
			retentionPct = 1.0;
		} else {
			if (retentionWrapper) retentionWrapper.style.display = 'block';
			retentionPct = parseInt(sliderRetention.value, 10) / 100;
			if (valRetention) valRetention.textContent = `${sliderRetention.value}%`;
		}

		// Participating Guests
		const participatingGuests = Math.max(10, Math.round(totalGuests * retentionPct));
		const earlyDepartures = Math.max(0, totalGuests - participatingGuests);

		if (retentionSummary) retentionSummary.textContent = `${participatingGuests} invités`;
		if (attritionSummary) attritionSummary.textContent = `${earlyDepartures} invités`;
		if (resCalcGuests) resCalcGuests.textContent = `${participatingGuests} invités (${Math.round(retentionPct * 100)}%)`;

		// Sparklers per guest & Buffer
		const sparklersPerGuest = parseInt(selectSparklersPerGuest.value, 10);
		const bufferPct = parseInt(selectBufferPct.value, 10) / 100;

		const baseCount = participatingGuests * sparklersPerGuest;
		const bufferCount = Math.ceil(baseCount * bufferPct);
		const totalSparklers = baseCount + bufferCount;

		if (resBaseCount) resBaseCount.textContent = `${baseCount} cierges (${sparklersPerGuest} par pers.)`;
		if (resBufferCount) resBufferCount.textContent = `+${bufferCount} cierges (+${Math.round(bufferPct * 100)}%)`;
		if (resTotalSparklers) resTotalSparklers.textContent = totalSparklers;

		// Selected Length & Burn Time
		let selectedLength = '20';
		radioSparklerLens.forEach(radio => {
			const label = radio.closest('label');
			if (radio.checked) {
				selectedLength = radio.value;
				if (label) {
					label.classList.add('active');
					label.style.borderColor = '#b45309';
					label.style.background = '#fffbeb';
				}
			} else {
				if (label) {
					label.classList.remove('active');
					label.style.borderColor = '#cbd5e1';
					label.style.background = '#ffffff';
				}
			}
		});

		const timingInfo = sparklerTimings[selectedLength] || sparklerTimings['20'];
		if (resBurnTotalText) resBurnTotalText.textContent = timingInfo.label;
		if (resTimeWave) resTimeWave.textContent = `${timingInfo.wave}s`;
		if (resTimePhoto) resTimePhoto.textContent = `${timingInfo.photo}s`;
		if (resTimeEmber) resTimeEmber.textContent = `${timingInfo.quench}s`;

		const wavePct = (timingInfo.wave / timingInfo.total) * 100;
		const photoPct = (timingInfo.photo / timingInfo.total) * 100;
		const emberPct = (timingInfo.quench / timingInfo.total) * 100;

		if (barLightingWave) barLightingWave.style.width = `${wavePct}%`;
		if (barPhotoWindow) barPhotoWindow.style.width = `${photoPct}%`;
		if (barBurnout) barBurnout.style.width = `${emberPct}%`;

		// Packs
		const packsNeeded = Math.ceil(totalSparklers / timingInfo.pack);
		if (badgePackSize) badgePackSize.textContent = `~${packsNeeded} Packs (${timingInfo.pack} pcs)`;

		// Hardware counts
		const torchCount = Math.max(2, Math.ceil(participatingGuests / 9));
		const bucketCount = Math.max(2, Math.ceil(participatingGuests / 25));
		if (resCountTorches) resCountTorches.textContent = `${torchCount} Chalumeaux`;
		if (resCountBuckets) resCountBuckets.textContent = `${bucketCount} Seaux`;

		// Corridor length: ~0.45m per guest (two lines) + 4m lead/tail buffer
		const corridorMeters = Math.max(8, Math.round((participatingGuests / 2) * 0.45 + 4));
		if (resCorridorLen) resCorridorLen.textContent = `~${corridorMeters}m de long × 3m de large`;

		// Dynamic Signs update
		const coupleNames = (inputSignNames ? inputSignNames.value.trim() : '') || (inputCoupleNames ? inputCoupleNames.value.trim() : '') || 'Camille & Lucas';
		const exitTime = (inputSignTime ? inputSignTime.value.trim() : '') || (inputExitTime ? inputExitTime.value.trim() : '') || '23:45';
		const customMsg = inputSignCustomMsg ? inputSignCustomMsg.value.trim() : '';

		if (dynCueTargetTime) dynCueTargetTime.textContent = exitTime;
		dynSignNames.forEach(el => el.textContent = coupleNames);
		dynSignTimes.forEach(el => el.textContent = exitTime);
		dynCoupleTexts.forEach(el => el.textContent = coupleNames);
		dynGuestsTexts.forEach(el => el.textContent = participatingGuests);
		dynBucketsTexts.forEach(el => el.textContent = bucketCount);
		dynTorchesTexts.forEach(el => el.textContent = torchCount);

		if (customMsg) {
			dynSignSubtextEls.forEach(el => el.textContent = customMsg);
		}

		// Dynamic Timeline calculation
		const timeObj = parseTimeString(exitTime);
		if (timeT30) timeT30.textContent = formatTimeOffset(timeObj, -30);
		if (timeT15) timeT15.textContent = formatTimeOffset(timeObj, -15);
		if (timeT10) timeT10.textContent = formatTimeOffset(timeObj, -10);
		if (timeT3) timeT3.textContent = formatTimeOffset(timeObj, -3);
		if (timeT1) timeT1.textContent = formatTimeOffset(timeObj, -1);
		if (timeT0) timeT0.textContent = formatTimeOffset(timeObj, 0);
		if (timeTp2) timeTp2.textContent = formatTimeOffset(timeObj, 2);
	}

	// Two-Way Sync for Names, Time, and Custom Message
	if (inputSignNames && inputCoupleNames) {
		inputSignNames.addEventListener('input', () => {
			inputCoupleNames.value = inputSignNames.value;
			calculate();
		});
		inputCoupleNames.addEventListener('input', () => {
			inputSignNames.value = inputCoupleNames.value;
			calculate();
		});
	}

	if (inputSignTime && inputExitTime) {
		inputSignTime.addEventListener('input', () => {
			inputExitTime.value = inputSignTime.value;
			calculate();
		});
		inputExitTime.addEventListener('input', () => {
			inputSignTime.value = inputExitTime.value;
			calculate();
		});
	}

	if (inputSignCustomMsg) {
		inputSignCustomMsg.addEventListener('input', () => {
			const msg = inputSignCustomMsg.value.trim() || 'Prenez un cierge magique et rejoignez-nous le long de l\'allée pour la haie d\'honneur des jeunes mariés !';
			dynSignSubtextEls.forEach(el => el.textContent = msg);
		});
	}

	// Sign Switcher
	signStyleBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			signStyleBtns.forEach(b => {
				b.classList.remove('active');
				b.style.background = 'transparent';
				b.style.color = 'var(--fg-pencil)';
			});
			btn.classList.add('active');
			btn.style.background = '#b45309';
			btn.style.color = '#ffffff';

			const style = btn.getAttribute('data-style');
			if (signViewStyleA) signViewStyleA.style.display = style === 'style-a' ? 'block' : 'none';
			if (signViewStyleB) signViewStyleB.style.display = style === 'style-b' ? 'block' : 'none';
			if (signViewStyleC) signViewStyleC.style.display = style === 'style-c' ? 'block' : 'none';
		});
	});

	// Print
	const btnPrintSign = document.getElementById('btn-print-sign');
	if (btnPrintSign) {
		btnPrintSign.addEventListener('click', () => {
			document.body.classList.add('print-sign-only-mode');
			window.print();
		});
	}

	const btnPrintTop = document.getElementById('btn-print-top');
	if (btnPrintTop) {
		btnPrintTop.addEventListener('click', () => {
			document.body.classList.remove('print-sign-only-mode');
			window.print();
		});
	}

	window.addEventListener('afterprint', () => {
		document.body.classList.remove('print-sign-only-mode');
	});

	// PNG Image Download via html2canvas
	const btnDownloadImage = document.getElementById('btn-download-image');
	if (btnDownloadImage) {
		btnDownloadImage.addEventListener('click', () => {
			const targetCanvas = document.getElementById('printable-sign-canvas');
			if (!targetCanvas) return;

			const originalHtml = btnDownloadImage.innerHTML;
			btnDownloadImage.innerHTML = '<span>⏳</span> Génération PNG...';

			if (typeof html2canvas !== 'undefined') {
				html2canvas(targetCanvas, {
					scale: 2,
					useCORS: true,
					backgroundColor: '#ffffff'
				}).then(canvas => {
					const coupleNames = (inputSignNames ? inputSignNames.value.trim() : '') || 'Camille_et_Lucas';
					const link = document.createElement('a');
					link.download = `Panneau-Feux-Bengale-${coupleNames.replace(/[^a-zA-Z0-9]/g, '_')}.png`;
					link.href = canvas.toDataURL('image/png');
					link.click();
					btnDownloadImage.innerHTML = originalHtml;
				}).catch(err => {
					console.error('Error generating image:', err);
					btnDownloadImage.innerHTML = originalHtml;
					alert('Impossible de générer l\'image. Veuillez utiliser "Imprimer Calcul (PDF)".');
				});
			} else {
				btnDownloadImage.innerHTML = originalHtml;
				alert('Le générateur d\'images se charge. Veuillez patienter un instant ou utiliser Imprimer (PDF).');
			}
		});
	}

	// Download Word Doc
	function triggerDownloadWord() {
		const coupleNames = (inputSignNames ? inputSignNames.value.trim() : '') || (inputCoupleNames ? inputCoupleNames.value.trim() : '') || 'Camille & Lucas';
		const exitTime = (inputSignTime ? inputSignTime.value.trim() : '') || (inputExitTime ? inputExitTime.value.trim() : '') || '23:45';
		const customMsg = (inputSignCustomMsg ? inputSignCustomMsg.value.trim() : '') || 'Prenez un cierge magique et rejoignez-nous le long de l\'allée pour la haie d\'honneur des jeunes mariés !';
		const totalSparklers = resTotalSparklers ? resTotalSparklers.textContent : '97';
		const participatingGuests = resCalcGuests ? resCalcGuests.textContent : '84';
		const torchCount = resCountTorches ? resCountTorches.textContent : '9';
		const bucketCount = resCountBuckets ? resCountBuckets.textContent : '4';

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Guide Feux de Bengale et Panneaux — ${coupleNames}</title>
				<style>
					body { font-family: 'Calibri', 'Segoe UI', Arial, sans-serif; padding: 25pt; font-size: 11pt; color: #1e293b; }
					h1 { color: #b45309; font-size: 24pt; margin-bottom: 4pt; text-align: center; }
					h2 { color: #0f172a; font-size: 14pt; margin-top: 18pt; border-bottom: 1.5pt solid #cbd5e1; padding-bottom: 4pt; }
					.sign-box { border: 2pt solid #b45309; padding: 25pt; text-align: center; margin: 20pt 0; background: #fffdfa; }
					table { width: 100%; border-collapse: collapse; margin-top: 10pt; }
					th, td { border: 1pt solid #cbd5e1; padding: 8pt; text-align: left; }
					th { background: #f8fafc; }
				</style>
			</head>
			<body>
				<div class="sign-box">
					<p style="font-size: 16pt; color: #b45309; letter-spacing: 2pt;">✦ ✨ ✦</p>
					<h1 style="font-size: 28pt; margin: 10pt 0;">Que l'Amour Brille</h1>
					<p style="font-size: 16pt; font-weight: bold; color: #b45309;">Sortie aux Feux de Bengale à ${exitTime}</p>
					<p style="font-size: 12pt; margin: 15pt 0;">${customMsg}<br><em>Merci de ne pas allumer avant le signal du coordinateur.</em></p>
					<p style="font-size: 18pt; font-weight: bold; margin-top: 20pt;">${coupleNames}</p>
				</div>

				<h2>📋 Récapitulatif Matériel pour le Coordinateur</h2>
				<table>
					<tr><th>Paramètre</th><th>Valeur</th></tr>
					<tr><td>Prénoms des Mariés</td><td><strong>${coupleNames}</strong></td></tr>
					<tr><td>Heure de Sortie Prévue</td><td><strong>${exitTime}</strong></td></tr>
					<tr><td>Total Cierges à Acheter</td><td><strong>${totalSparklers}</strong></td></tr>
					<tr><td>Invités Participants</td><td><strong>${participatingGuests}</strong></td></tr>
					<tr><td>Chalumeaux au Butane Antivent</td><td><strong>${torchCount}</strong></td></tr>
					<tr><td>Seaux de Sable Métalliques</td><td><strong>${bucketCount}</strong></td></tr>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Guide-Feux-Bengale-${coupleNames.replace(/[^a-zA-Z0-9]/g, '_')}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	}

	const btnDownloadWord = document.getElementById('btn-download-word');
	if (btnDownloadWord) btnDownloadWord.addEventListener('click', triggerDownloadWord);
	const btnDownloadWordTop = document.getElementById('btn-download-word-top');
	if (btnDownloadWordTop) btnDownloadWordTop.addEventListener('click', triggerDownloadWord);

	// Listeners
	if (sliderGuests) sliderGuests.addEventListener('input', calculate);
	if (selectTiming) selectTiming.addEventListener('change', calculate);
	if (sliderRetention) sliderRetention.addEventListener('input', calculate);
	radioSparklerLens.forEach(r => r.addEventListener('change', calculate));
	if (selectSparklersPerGuest) selectSparklersPerGuest.addEventListener('change', calculate);
	if (selectBufferPct) selectBufferPct.addEventListener('change', calculate);

	// Initial Run
	calculate();
})();
</script>
