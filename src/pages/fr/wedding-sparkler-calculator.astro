---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/wedding-sparkler-calculator/#webapp",
      "name": "Calculateur Feux de Bengale & Panneaux Imprimables Gratuits",
      "url": "https://manage.wedding/fr/wedding-sparkler-calculator",
      "inLanguage": "fr",
      "description": "Calculez le nombre exact de feux de bengale (50cm vs 90cm), temps de combustion pour les photos, chalumeaux au butane et seaux de sable. Inclut panneaux imprimables 'Que l'Amour Brille' et fiches de sécurité.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Réussir une Sortie des Mariés Étincelante avec des Feux de Bengale",
      "description": "Guide étape par étape pour coordonner l'allumage en chaîne et former une haie d'honneur lumineuse et sécurisée.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Estimer les Invités Présents et la Longueur",
          "text": "Anticipez le départ de 25 à 35% des invités avant minuit. Choisissez des cierges magiques de 50 cm (90-120s) ou 90 cm (3,5-4 min) sans fumée à tige métallique."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Préparer les Seaux de Sable d'Extinction",
          "text": "Disposez des seaux en zinc remplis de sable ou d'eau au début et à la fin de l'allée pour plonger les tiges brûlantes immédiatement."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Former une Haie d'Honneur de 3 Mètres de Large",
          "text": "Placez les invités sur deux rangées en laissant au moins 3 à 3,5 mètres au centre pour protéger la robe de mariée, le voile et les cheveux."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Lancer la Vague d'Allumage en Chaîne",
          "text": "Désignez 1 responsable muni d'un chalumeau de cuisine au butane pour 8 à 10 invités. Les invités se passent la flamme bout à bout en moins de 20 secondes."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 5 : Déambulation Lente, Baiser et Extinction",
          "text": "Les mariés traversent l'allée lentement, s'arrêtent au milieu pour un baiser photo, puis chacun éteint sa tige dans le sable."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle taille de feux de bengale choisir pour un mariage : 25 cm, 50 cm ou 90 cm ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les feux de bengale de 50 cm (durée de 90 à 120 secondes) sont le standard d'or pour les mariages de 50 à 150 invités, laissant le temps d'allumer et de faire un passage serein. Les cierges de 90 cm (3,5 à 4 minutes) sont parfaits pour les grands mariages de plus de 150 personnes et les allées monumentales. Les petits cierges de 25 cm (30-45 secondes) sont FORTEMENT DÉCONSEILLÉS car les premiers s'éteignent avant que les derniers ne soient allumés."
          }
        },
        {
          "@type": "Question",
          "name": "Pourquoi les châteaux et domaines exigent-ils des cierges sans fumée à tige métallique ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les cierges magiques à tige en fil d'acier ne produisent pas de cendre volante et brûlent sans fumée noire. Les cierges avec baguette en bambou ou en bois produisent une épaisse fumée grise qui asphyxie les invités, gâche les photos et projette des braises qui trouent les robes."
          }
        },
        {
          "@type": "Question",
          "name": "Combien de feux de bengale faut-il prévoir par invité ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour des cierges de 50 cm ou 90 cm, comptez 1 cierge par invité présent lors de la sortie, plus 15% de marge pour les tests et ratés. Si vous utilisez des cierges de 25 cm ou si vos invités souhaitent un deuxième allumage, prévoyez 2 cierges par personne."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur Feux de Bengale Mariage — Panneaux Imprimables Gratuits «Que l'Amour Brille» & Guide"
	description="Calculez le nombre de feux de bengale (50cm vs 90cm), fenêtre photo, chalumeaux et seaux de sable. Inclut panneaux 'Que l'Amour Brille' et fiches de sécurité gratuits."
	lang="fr"
	schema={schema}
>
	<!-- Include html2canvas for instant image capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Calculateur Feux de Bengale" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center; position: relative;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.25rem 1rem 1.75rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratuit • Cierges Métalliques Sans Fumée • Panneaux Imprimables en PDF & Word</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(28px, 4.5vw, 50px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculateur de Feux de Bengale <span class="accent-italic" style="color: #b45309; text-shadow: 1px 1px 0px #fef08a;">et Panneaux Déco</span>
				</h1>
				<p class="font-body" style="font-size: 1.125rem; color: var(--text-secondary); max-width: 820px; margin: 0 auto; line-height: 1.6;">
					Calculez le nombre exact de cierges magiques (50cm vs 90cm), la durée de pose photo, les chalumeaux au butane et les seaux de sable. Comprend le planning minuté et les <strong>panneaux imprimables « Que l'Amour Brille »</strong>.
				</p>
			</div>
		</section>

		<!-- Visual Step-by-Step "How to Use This Tool" Guide -->
		<section class="hand-card" style="padding: 1.5rem; background: #fffdfa; margin-bottom: 2.5rem; border: 2px solid var(--fg-pencil);">
			<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
				<span style="font-size: 1.4rem;">💡</span>
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0;">
					Comment Utiliser ce Calculateur (En 3 Étapes Simples)
				</h2>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
				
				<!-- Guide Step 1 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">1</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Nombre d'Invités et Horaire</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Entrez le total de vos invités et l'heure prévue. Si la sortie a lieu tard (après 23h), ~30% des invités partent plus tôt ; l'outil évite d'acheter des cierges inutiles.
					</p>
				</div>

				<!-- Guide Step 2 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">2</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Choisissez 50 cm ou 90 cm</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Optez pour <strong>50 cm (2 min de combustion)</strong> pour les mariages classiques (40 à 150 personnes) ou <strong>90 cm (4 min)</strong> pour plus de 150 invités.
					</p>
				</div>

				<!-- Guide Step 3 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">3</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Liste d'Achat et Panneaux</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Obtenez le nombre exact de paquets, chalumeaux et seaux. Personnalisez vos prénoms pour imprimer le <strong>panneau de table et fiches de sécurité</strong> en 1 clic.
					</p>
				</div>

			</div>
		</section>

		<!-- Main Interactive Calculator Studio -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; margin-bottom: 3rem; align-items: start;">
			
			<!-- Left Column: Inputs & Configuration -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #ffffff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.35rem; margin: 0; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
						<span>⚙️</span> Paramètres de la Sortie
					</h2>
					<span style="font-size: 0.78rem; font-weight: 700; background: #fef08a; border: 1.5px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
						Calcul en Direct
					</span>
				</div>

				<!-- Step 1: Total Invited Guests Headcount -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem;">
						<label class="form-label" for="slider-guests" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							1. Total des Invités Confirmés :
						</label>
						<span id="label-guest-count" style="font-weight: 800; font-size: 1.15rem; color: #b45309; background: #fef3c7; border: 1.5px solid #d97706; padding: 2px 10px; border-radius: 6px;">
							120 invités
						</span>
					</div>
					<input type="range" id="slider-guests" min="15" max="400" value="120" step="5" style="width: 100%; accent-color: #b45309; cursor: pointer;" />
					<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.2rem;">
						<span>15 (Intime)</span>
						<span>75 (Petit)</span>
						<span>120 (Moyen)</span>
						<span>250 (Grand)</span>
						<span>400+</span>
					</div>
				</div>

				<!-- Step 2: Send-Off Timing -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label class="form-label" for="select-timing-preset" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem; margin-bottom: 0.3rem; display: block;">
						2. Quand Aura Lieu la Sortie aux Feux de Bengale ?
					</label>
					<select id="select-timing-preset" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc; border: 2px solid var(--fg-pencil); width: 100%; padding: 0.6rem; border-radius: 6px; font-size: 0.9rem;">
						<option value="late-night" selected>🌙 Fin de Soirée Tardive (23h30+) — ~70% des Invités Présents</option>
						<option value="staged">🍰 Sortie Simulée Après la Pièce Montée (22h00) — ~95% Présents</option>
						<option value="ceremony">🌅 Sortie de Cérémonie / Crépuscule — 100% Présents</option>
						<option value="custom">🎛️ Pourcentage Personnalisé</option>
					</select>
					
					<div id="custom-retention-box" style="display: none; margin-top: 0.75rem; padding: 0.75rem; background: #fffbeb; border: 1.5px dashed #d97706; border-radius: 6px;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
							<label style="font-size: 0.85rem; font-weight: 700; color: #92400e;">Taux de Présence :</label>
							<span id="label-retention-val" style="font-weight: 800; color: #92400e;">70%</span>
						</div>
						<input type="range" id="slider-retention" min="40" max="100" value="70" step="5" style="width: 100%; accent-color: #d97706;" />
					</div>

					<div style="background: #f8fafc; border-left: 3px solid #b45309; padding: 0.5rem 0.75rem; margin-top: 0.5rem; border-radius: 0 4px 4px 0;">
						<p style="font-size: 0.82rem; color: #475569; margin: 0; line-height: 1.45;">
							👥 <strong>Présence Réelle :</strong> <strong id="retention-summary-text" style="color: #b45309;">84 invités</strong> présents (<span id="attrition-summary-text">36 personnes</span> partent plus tôt en raison de fatigue ou enfants).
						</p>
					</div>
				</div>

				<!-- Step 3: Sparkler Length & Burn Time Selector -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label class="form-label" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem; margin-bottom: 0.4rem; display: block;">
						3. Choisissez la Taille des Cierges :
					</label>
					
					<div class="sparkler-size-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem;">
						<!-- 50 cm option (Default Gold Standard) -->
						<label class="size-pill active" id="card-len-20" style="border: 2px solid #b45309; background: #fffbeb; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative; box-shadow: 0 0 0 1px #b45309;">
							<input type="radio" name="sparkler-len" value="20" checked style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 800; color: #92400e; background: #fef08a; border: 1px solid #d97706; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">⭐ Idéal</span>
							<strong style="display: block; font-size: 0.9rem; color: #92400e; line-height: 1.15;">50 cm (20")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #b45309; margin-top: 1px;">2 Min Flamme</span>
							<span style="display: block; font-size: 0.67rem; color: #78350f; margin-top: 1px;">40–150 Invités</span>
						</label>

						<!-- 90 cm option (Grand Exits) -->
						<label class="size-pill" id="card-len-36" style="border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative;">
							<input type="radio" name="sparkler-len" value="36" style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 700; color: #0369a1; background: #e0f2fe; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">👑 Grandiose</span>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil); line-height: 1.15;">90 cm (36")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #0369a1; margin-top: 1px;">4 Min Flamme</span>
							<span style="display: block; font-size: 0.67rem; color: #64748b; margin-top: 1px;">150+ Invités</span>
						</label>

						<!-- 25 cm option (Small/Risky) -->
						<label class="size-pill" id="card-len-10" style="border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative;">
							<input type="radio" name="sparkler-len" value="10" style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 700; color: #991b1b; background: #fee2e2; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">⚠️ Micro Seul</span>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil); line-height: 1.15;">25 cm (10")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #dc2626; margin-top: 1px;">35s Flamme</span>
							<span style="display: block; font-size: 0.67rem; color: #64748b; margin-top: 1px;">&lt;25 Invités</span>
						</label>
					</div>
				</div>

				<!-- Sparklers Per Guest & Buffer Options -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem;">
					<div>
						<label class="form-label" for="select-sparklers-per-guest" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.85rem;">
							Cierges par Invité :
						</label>
						<select id="select-sparklers-per-guest" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<option value="1" selected>1 Cierge (Standard)</option>
							<option value="2">2 Cierges (Double Éclat / Rechange)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="select-buffer-pct" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.85rem;">
							Marge de Sécurité :
						</label>
						<select id="select-buffer-pct" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<option value="15" selected>+15% Marge (Recommandé)</option>
							<option value="10">+10% Marge</option>
							<option value="20">+20% Marge Extra</option>
							<option value="0">0% Exact</option>
						</select>
					</div>
				</div>

				<!-- Step 4: Couple Names & Target Send-Off Time -->
				<div style="border-top: 1.5px dashed #cbd5e1; padding-top: 1.25rem;">
					<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
						<h3 class="font-heading" style="font-size: 1.05rem; margin: 0; color: var(--fg-pencil);">
							4. Personnalisez les Panneaux Déco et l'Horaire :
						</h3>
						<span style="font-size: 0.72rem; color: #166534; background: #dcfce7; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Actualise le Panneau ⬇️</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="input-couple-names" style="font-size: 0.82rem; font-weight: 600;">Prénoms des Mariés :</label>
							<input type="text" id="input-couple-names" class="form-input" value="Camille & Lucas" placeholder="ex. Chloé & Thomas" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						</div>
						<div>
							<label class="form-label" for="input-exit-time" style="font-size: 0.82rem; font-weight: 600;">Heure de la Sortie :</label>
							<input type="text" id="input-exit-time" class="form-input" value="23:45" placeholder="ex. 23:45" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Results & Equipment Blueprint -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Metric Hero Card -->
				<div class="hand-card shadow-hard" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fffdfa; border: 3px solid var(--fg-pencil); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
						<div>
							<span style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #92400e;">
								Recommandation de Commande
							</span>
							<h3 class="font-heading" style="font-size: 1.35rem; margin: 0.2rem 0 0; color: var(--fg-pencil);">
								Total de Cierges à Commander
							</h3>
						</div>
						<div id="badge-pack-size" style="background: #fef08a; border: 2px solid var(--fg-pencil); padding: 4px 10px; border-radius: 6px; font-weight: 800; font-size: 0.85rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
							~12 Paquets (8 pcs)
						</div>
					</div>

					<div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.5rem;">
						<span id="res-total-sparklers" style="font-size: clamp(3rem, 6vw, 4.2rem); font-weight: 900; color: #b45309; line-height: 1; font-family: var(--font-heading);">
							97
						</span>
						<span style="font-size: 1.25rem; font-weight: 700; color: var(--fg-pencil);">Cierges au Total</span>
					</div>

					<div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.35rem;">
