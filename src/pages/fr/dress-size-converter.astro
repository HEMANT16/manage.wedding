<script is:inline>
	// Standard Size Chart in Centimeters
	const sizeChartCm = [
		{ streetFr: '32', bridalFr: '34', usBridal: 2, ukBridal: 6, euBridal: 32, itBridal: 38, bust: 81, waist: 61, hip: 88 },
		{ streetFr: '34', bridalFr: '36', usBridal: 4, ukBridal: 8, euBridal: 34, itBridal: 40, bust: 84, waist: 64, hip: 91 },
		{ streetFr: '36', bridalFr: '38', usBridal: 6, ukBridal: 10, euBridal: 36, itBridal: 42, bust: 87, waist: 67, hip: 94 },
		{ streetFr: '38', bridalFr: '40', usBridal: 8, ukBridal: 12, euBridal: 38, itBridal: 44, bust: 91, waist: 71, hip: 98 },
		{ streetFr: '40', bridalFr: '42', usBridal: 10, ukBridal: 14, euBridal: 40, itBridal: 46, bust: 95, waist: 75, hip: 102 },
		{ streetFr: '42', bridalFr: '44', usBridal: 12, ukBridal: 16, euBridal: 42, itBridal: 48, bust: 99, waist: 79, hip: 106 },
		{ streetFr: '44', bridalFr: '46', usBridal: 14, ukBridal: 18, euBridal: 44, itBridal: 50, bust: 104, waist: 84, hip: 111 },
		{ streetFr: '46', bridalFr: '48', usBridal: 16, ukBridal: 20, euBridal: 46, itBridal: 52, bust: 109, waist: 89, hip: 116 },
		{ streetFr: '48', bridalFr: '50', usBridal: 18, ukBridal: 22, euBridal: 48, itBridal: 54, bust: 115, waist: 95, hip: 122 },
		{ streetFr: '50', bridalFr: '52', usBridal: 20, ukBridal: 24, euBridal: 50, itBridal: 56, bust: 121, waist: 101, hip: 128 },
		{ streetFr: '52', bridalFr: '54', usBridal: 22, ukBridal: 26, euBridal: 52, itBridal: 58, bust: 127, waist: 107, hip: 134 }
	];

	let currentUnit = 'cm'; // 'cm' or 'in'

	const bustInput = document.getElementById('input-bust');
	const waistInput = document.getElementById('input-waist');
	const hipsInput = document.getElementById('input-hips');
	const designerSelect = document.getElementById('input-designer');

	const resStreet = document.getElementById('res-street-size');
	const resBridal = document.getElementById('res-bridal-size');
	const resBodyShape = document.getElementById('res-body-shape');
	const resShapeDesc = document.getElementById('res-shape-desc');

	const barStreet = document.getElementById('bar-street');
	const barBridal = document.getElementById('bar-bridal');
	const barLabelStreet = document.getElementById('bar-label-street');
	const barLabelBridal = document.getElementById('bar-label-bridal');
	const sizeDiffNote = document.getElementById('size-diff-note');

	const matrixFr = document.getElementById('matrix-fr');
	const matrixEu = document.getElementById('matrix-eu');
	const matrixUs = document.getElementById('matrix-us');
	const matrixUk = document.getElementById('matrix-uk');
	const matrixIt = document.getElementById('matrix-it');

	const alterationText = document.getElementById('alteration-advice-text');
	const silhouetteContainer = document.getElementById('silhouette-cards-container');

	function toCm(val) {
		return currentUnit === 'in' ? val * 2.54 : val;
	}

	function calculateSizing() {
		let rawB = parseFloat(bustInput.value) || 92;
		let rawW = parseFloat(waistInput.value) || 72;
		let rawH = parseFloat(hipsInput.value) || 99;

		const bCm = toCm(rawB);
		const wCm = toCm(rawW);
		const hCm = toCm(rawH);

		// Find size for each measurement
		let bustSizeObj = sizeChartCm.find(s => bCm <= s.bust) || sizeChartCm[sizeChartCm.length - 1];
		let waistSizeObj = sizeChartCm.find(s => wCm <= s.waist) || sizeChartCm[sizeChartCm.length - 1];
		let hipSizeObj = sizeChartCm.find(s => hCm <= s.hip) || sizeChartCm[sizeChartCm.length - 1];

		// Maximum size needed to fit largest measurement
		const maxUsSize = Math.max(bustSizeObj.usBridal, waistSizeObj.usBridal, hipSizeObj.usBridal);
		const matchedObj = sizeChartCm.find(s => s.usBridal === maxUsSize) || sizeChartCm[sizeChartCm.length - 1];

		let adjustedObj = matchedObj;
		const designer = designerSelect.value;
		if (designer === 'couture') {
			const idx = Math.min(sizeChartCm.length - 1, sizeChartCm.indexOf(matchedObj) + 1);
			adjustedObj = sizeChartCm[idx];
		} else if (designer === 'davids') {
			const idx = Math.max(0, sizeChartCm.indexOf(matchedObj) - 1);
			adjustedObj = sizeChartCm[idx];
		}

		// Determine Body Shape
		let shape = 'Sablier (X ou 8)';
		let shapeDetail = 'Épaules et hanches équilibrées avec une taille définie';
		let silhouettes = [
			{ name: 'Sirène / Fourreau', desc: 'Sublime les courbes et met en valeur la taille naturelle.' },
			{ name: 'Ligne A Classique', desc: 'Coupe universelle flatteuse resserrée à la taille.' }
		];

		if (hCm >= bCm + 5 && (hCm - wCm) >= 20) {
			shape = 'Poire / Pyramide (A)';
			shapeDetail = 'Hanches plus généreuses que le buste';
			silhouettes = [
				{ name: 'Robe Princesse / Bal', desc: 'La jupe volumineuse dissimule les hanches tout en soulignant la finesse du buste.' },
				{ name: 'Coupe Empire Fluide', desc: 'Met l’accent sur le décolleté et s’évase délicatement.' }
			];
		} else if (bCm >= hCm + 5) {
			shape = 'Pyramide Inversée (V)';
			shapeDetail = 'Épaules / poitrine plus larges que le bassin';
			silhouettes = [
				{ name: 'Ligne A avec Décolleté V', desc: 'Allonge le buste et équilibre la carrure.' },
				{ name: 'Robe de Bal avec Plis', desc: 'Apporte du volume en bas pour une parfaite symétrie.' }
			];
		} else if (Math.abs(bCm - hCm) <= 5 && (bCm - wCm) <= 15) {
			shape = 'Rectangle / Athlétique (H)';
			shapeDetail = 'Alignement harmonieux avec taille peu marquée';
			silhouettes = [
				{ name: 'Fourreau Évasé', desc: 'Crée l’illusion optique de courbes féminines.' },
				{ name: 'Robe avec Bustier Corset', desc: 'Structure et affine la taille grâce au baleinage.' }
			];
		}

		// Update UI
		resStreet.textContent = `${adjustedObj.streetFr} FR`;
		resBridal.textContent = `${adjustedObj.bridalFr} FR`;
		resBodyShape.textContent = shape;
		resShapeDesc.textContent = shapeDetail;

		// Bars
		const maxScale = 54;
		const streetNum = parseInt(adjustedObj.streetFr) || 38;
		const bridalNum = parseInt(adjustedObj.bridalFr) || 40;
		const streetPct = Math.min(100, Math.round((streetNum / maxScale) * 100));
		const bridalPct = Math.min(100, Math.round((bridalNum / maxScale) * 100));

		barStreet.style.width = `${streetPct}%`;
		barBridal.style.width = `${bridalPct}%`;
		barLabelStreet.textContent = `${adjustedObj.streetFr} FR`;
		barLabelBridal.textContent = `${adjustedObj.bridalFr} FR`;

		const diff = bridalNum - streetNum;
		sizeDiffNote.textContent = diff > 0 ? `+${diff / 2} Taille Au-Dessus du Prêt-à-Porter` : 'Taille identique au prêt-à-porter';

		// Matrix
		matrixFr.textContent = `${adjustedObj.bridalFr} FR`;
		matrixEu.textContent = `${adjustedObj.euBridal}`;
		matrixUs.textContent = `US ${adjustedObj.usBridal}`;
		matrixUk.textContent = `UK ${adjustedObj.ukBridal}`;
		matrixIt.textContent = `IT ${adjustedObj.itBridal}`;

		// Advice
		let anchor = 'les hanches';
		if (bustSizeObj.usBridal >= waistSizeObj.usBridal && bustSizeObj.usBridal >= hipSizeObj.usBridal) anchor = 'la poitrine';
		else if (waistSizeObj.usBridal >= bustSizeObj.usBridal && waistSizeObj.usBridal >= hipSizeObj.usBridal) anchor = 'la taille';

		alterationText.innerHTML = `
			Votre mensuration la plus forte correspond à <strong>${anchor} (${matchedObj.bridalFr} FR)</strong>. Commandez la taille <strong>${adjustedObj.bridalFr} FR</strong> pour que la fermeture s’ajuste sans tension. Votre couturière reprendra facilement le bustier lors des essayages.
		`;

		// Silhouettes
		silhouetteContainer.innerHTML = '';
		silhouettes.forEach(s => {
			const div = document.createElement('div');
			div.className = 'silhouette-card';
			div.innerHTML = `
				<h5>✨ ${s.name}</h5>
				<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">${s.desc}</p>
			`;
			silhouetteContainer.appendChild(div);
		});
	}

	// Unit Switcher
	document.getElementById('unit-cm').addEventListener('click', () => {
		if (currentUnit === 'cm') return;
		currentUnit = 'cm';
		document.getElementById('unit-cm').classList.add('active-unit');
		document.getElementById('unit-in').classList.remove('active-unit');
		document.querySelectorAll('.unit-label').forEach(el => el.textContent = 'cm');

		bustInput.value = (parseFloat(bustInput.value) * 2.54).toFixed(1);
		waistInput.value = (parseFloat(waistInput.value) * 2.54).toFixed(1);
		hipsInput.value = (parseFloat(hipsInput.value) * 2.54).toFixed(1);
		calculateSizing();
	});

	document.getElementById('unit-in').addEventListener('click', () => {
		if (currentUnit === 'in') return;
		currentUnit = 'in';
		document.getElementById('unit-in').classList.add('active-unit');
		document.getElementById('unit-cm').classList.remove('active-unit');
		document.querySelectorAll('.unit-label').forEach(el => el.textContent = 'pouces');

		bustInput.value = (parseFloat(bustInput.value) / 2.54).toFixed(1);
		waistInput.value = (parseFloat(waistInput.value) / 2.54).toFixed(1);
		hipsInput.value = (parseFloat(hipsInput.value) / 2.54).toFixed(1);
		calculateSizing();
	});

	// Presets
	document.querySelectorAll('.preset-meas-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			let b = parseFloat(btn.getAttribute('data-b'));
			let w = parseFloat(btn.getAttribute('data-w'));
			let h = parseFloat(btn.getAttribute('data-h'));

			if (currentUnit === 'in') {
				b = (b / 2.54).toFixed(1);
				w = (w / 2.54).toFixed(1);
				h = (h / 2.54).toFixed(1);
			}

			bustInput.value = b;
			waistInput.value = w;
			hipsInput.value = h;
			calculateSizing();
		});
	});

	// Input listeners
	bustInput.addEventListener('input', calculateSizing);
	waistInput.addEventListener('input', calculateSizing);
	hipsInput.addEventListener('input', calculateSizing);
	designerSelect.addEventListener('change', calculateSizing);

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const rawB = bustInput.value;
		const rawW = waistInput.value;
		const rawH = hipsInput.value;
		const unit = currentUnit === 'cm' ? 'cm' : 'pouces';

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Fiche de Mensurations Robe de Mariée</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Fiche de Mensurations & Tailles Robe de Mariée</h1>
				<p>Généré le ${new Date().toLocaleDateString('fr-FR')} | Document pour Styliste & Atelier de Couture</p>
				
				<h3>Mensurations de la Mariée :</h3>
				<table>
					<thead>
						<tr><th>Zone de Mesure</th><th>Valeur</th><th>Remarques</th></tr>
					</thead>
					<tbody>
						<tr><td><strong>Tour de Poitrine</strong></td><td>${rawB} ${unit}</td><td>Mesuré avec la lingerie du mariage</td></tr>
						<tr><td><strong>Tour de Taille</strong></td><td>${rawW} ${unit}</td><td>Mesuré au creux naturel le plus fin</td></tr>
						<tr><td><strong>Tour de Hanches</strong></td><td>${rawH} ${unit}</td><td>Mesuré au plus fort des fessiers</td></tr>
					</tbody>
				</table>

				<h3 style="margin-top:20px;">Synthèse des Tailles Conseillées :</h3>
				<table>
					<thead>
						<tr><th>Standard</th><th>Taille</th><th>Remarques</th></tr>
					</thead>
					<tbody>
						<tr><td><strong>Taille Robe de Mariée Conseillée</strong></td><td><strong>${resBridal.textContent}</strong></td><td>Commandée selon la mensuration la plus forte</td></tr>
						<tr><td><strong>Taille Prêt-à-Porter Habituelle</strong></td><td>${resStreet.textContent}</td><td>Vêtements du quotidien</td></tr>
						<tr><td><strong>Équivalence Internationale</strong></td><td>${matrixUs.textContent} / ${matrixUk.textContent} / ${matrixIt.textContent}</td><td>Standards US, UK et Italie</td></tr>
						<tr><td><strong>Morphologie Silhouette</strong></td><td>${resBodyShape.textContent}</td><td>${resShapeDesc.textContent}</td></tr>
					</tbody>
				</table>

				<p style="margin-top:20px; font-size:12px; color:#666;">Conseil : Toujours vérifier la grille spécifique de la maison de couture avant validation de commande.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Fiche_Mensurations_Robe_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const printDate = document.getElementById('print-date');
		const printMeasBody = document.getElementById('print-meas-body');
		const printRecSize = document.getElementById('print-rec-size');
		const printStreetSize = document.getElementById('print-street-size');
		const printBodyShape = document.getElementById('print-body-shape');
		const printAlterationNote = document.getElementById('print-alteration-note');

		printDate.textContent = new Date().toLocaleDateString('fr-FR');
		const unit = currentUnit === 'cm' ? 'cm' : 'pouces';

		printMeasBody.innerHTML = `
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">1. Tour de Poitrine</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${bustInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Avec lingerie du mariage</td>
			</tr>
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">2. Tour de Taille</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${waistInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Creux naturel</td>
			</tr>
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">3. Tour de Bassin / Hanches</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${hipsInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Fessiers au plus fort</td>
			</tr>
		`;

		printRecSize.textContent = `${resBridal.textContent} (${matrixUs.textContent} / ${matrixUk.textContent})`;
		printStreetSize.textContent = resStreet.textContent;
		printBodyShape.textContent = `${resBodyShape.textContent} (${resShapeDesc.textContent})`;
		printAlterationNote.textContent = alterationText.textContent;

		window.print();
	});

	// Initialize
	calculateSizing();
</script>
