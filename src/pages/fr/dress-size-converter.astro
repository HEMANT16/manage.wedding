---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/dress-size-converter/#webapp",
      "name": "Convertisseur de Tailles de Robe de Mariée & Mensurations",
      "url": "https://manage.wedding/fr/dress-size-converter",
      "description": "Convertisseur gratuit de taille de robe de mariée. Calculez votre taille exacte en France (FR), Europe (EU), US et UK à partir de votre tour de poitrine, taille et hanches. Découvrez les coupes adaptées à votre morphologie.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pourquoi la taille d'une robe de mariée est-il plus grande que ma taille de prêt-à-porter ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les créateurs de robes de mariée utilisent toujours les grilles de coupe haute couture traditionnelles des années 1950, conçues dans des tissus sans élasticité (mikado, organza, satin duchesse). À l'inverse, la mode de tous les jours a évolué vers des coupes plus flatteuses. Une robe de mariée taille ainsi 1 à 2 crans au-dessus de vos vêtements habituels."
          }
        },
        {
          "@type": "Question",
          "name": "Sur quelle mesure se baser pour commander sa robe de mariée ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fiez-vous toujours à votre mensuration la plus importante (entre la poitrine, la taille et les hanches). Une couturière peut très facilement reprendre et resserrer une robe trop grande, mais il est presque impossible de l'agrandir en raison des marges de couture très serrées."
          }
        },
        {
          "@type": "Question",
          "name": "Comment bien prendre ses mensurations avec un mètre ruban ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Utilisez un mètre ruban souple de couturière : 1) Tour de poitrine : au point le plus saillant avec la lingerie du mariage ; 2) Tour de taille : au creux naturel de la taille (2 cm au-dessus du nombril) ; 3) Tour de hanches : à l'endroit le plus fort des fessiers, pieds joints."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Comment Mesurer et Convertir sa Taille de Robe de Mariée",
      "description": "Guide pratique pour prendre vos mensurations et trouver votre équivalence de taille en France, aux États-Unis et au Royaume-Uni.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Prendre les 3 Mensurations Fondamentales",
          "text": "Mesurez votre tour de poitrine, votre tour de taille naturel et votre tour de hanches en restant bien droite."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Comparer avec la Grille du Créateur",
          "text": "Consultez le tableau de correspondance entre vos centimètres et les tailles standard (FR 36, FR 38, FR 40, etc.)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Choisir la Taille de la Mensuration Majeure",
          "text": "Retenez toujours la taille la plus grande pour que la fermeture éclair se ferme sans tension."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Exporter Votre Fiche d'Essayage",
          "text": "Enregistrez votre récapitulatif en Word (.doc) ou PDF pour le présenter lors de vos rendez-vous en boutique."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Convertisseur de Taille Robe de Mariée (Guide Mensurations & Morphologie) | Manage.Wedding"
	description="Convertissez vos mensurations (poitrine, taille, hanches) en tailles de robe de mariée françaises (FR), européennes (EU) et internationales (US/UK). Export Word et PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Convertisseur de Tailles Robe de Mariée" category="floral-attire" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Convertisseur de Tailles Robe de Mariée
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Trouvez votre taille de robe exacte selon les standards français, européens, américains et britanniques. Comparez prêt-à-porter vs robe de mariée et exportez votre <strong>Fiche de Mensurations</strong>.
				</p>
			</div>
		</section>

		<!-- Main Interactive Sizing Studio Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 380px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="dress-calc-grid">
			
			<!-- Left Column: Input Form Card -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						📏 Vos Mensurations
					</h2>
					
					<!-- Unit Switcher -->
					<div style="display: flex; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden;">
						<button type="button" id="unit-cm" class="unit-toggle-btn active-unit">cm</button>
						<button type="button" id="unit-in" class="unit-toggle-btn">Pouces (in)</button>
					</div>
				</div>

				<form id="dress-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Bust -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-bust" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								1. Tour de Poitrine (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Point le plus fort</span>
						</div>
						<input type="number" step="0.5" id="input-bust" value="92" min="50" max="180" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Waist -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-waist" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								2. Tour de Taille (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Creux naturel</span>
						</div>
						<input type="number" step="0.5" id="input-waist" value="72" min="40" max="160" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Hips -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-hips" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								3. Tour de Bassin / Hanches (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Fessiers au plus large</span>
						</div>
						<input type="number" step="0.5" id="input-hips" value="99" min="50" max="200" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Designer Preference -->
					<div>
						<label for="input-designer" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							Maison de Création / Marque
						</label>
						<select id="input-designer" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="standard" selected>Standard Créateur Français / Européen</option>
							<option value="couture">Haute Couture Espagnole / Italienne (Pronovias - Taille Petit)</option>
							<option value="davids">Standard Américain Prêt-à-Porter (David's Bridal / BHLDN)</option>
							<option value="maggie">Maggie Sottero / Essense of Australia</option>
						</select>
					</div>

					<!-- Sample Presets -->
					<div style="margin-top: 0.5rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
						<span class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							⚡ Mensurations Repères Rapides :
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem;">
							<button type="button" class="preset-meas-btn" data-b="86" data-w="66" data-h="94">Taille 36/38 (86-66-94)</button>
							<button type="button" class="preset-meas-btn" data-b="95" data-w="75" data-h="103">Taille 40/42 (95-75-103)</button>
							<button type="button" class="preset-meas-btn" data-b="110" data-w="90" data-h="118">Taille 46/48 (110-90-118)</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Interactive Results, Sizing Badges, International Matrix & Silhouette Guide -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Sizing Results Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								👗 Votre Taille de Robe Conseillée
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								Calculée pour s'adapter à votre mensuration la plus importante
							</span>
						</div>

						<!-- Exports -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimer PDF
							</button>
						</div>
					</div>

					<!-- Side by Side Sizing Comparison Boxes -->
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Street Size -->
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Taille Prêt-à-Porter</span>
							<strong id="res-street-size" class="font-heading" style="font-size: 2.4rem; color: var(--accent-blue); display: block; line-height: 1.2;">38 FR</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Vêtements du quotidien</span>
						</div>

						<!-- Primary Bridal Size -->
						<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1rem; text-align: center; position: relative;">
							<span style="position: absolute; top: -10px; right: 10px; background: var(--accent-red); color: #fff; font-size: 0.7rem; font-weight: bold; padding: 2px 6px; border-radius: 10px;">À COMMANDER</span>
							<span class="font-body" style="font-size: 0.85rem; color: var(--accent-red); display: block; font-weight: bold;">Taille Robe de Mariée</span>
							<strong id="res-bridal-size" class="font-heading" style="font-size: 2.4rem; color: var(--accent-red); display: block; line-height: 1.2;">40 FR</strong>
							<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold;">(US 10 / UK 12)</span>
						</div>

						<!-- Body Shape Archetype -->
						<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Morphologie</span>
							<strong id="res-body-shape" class="font-heading" style="font-size: 1.3rem; color: #15803d; display: block; line-height: 1.3; margin: 0.4rem 0;">Sablier (X)</strong>
							<span id="res-shape-desc" style="font-size: 0.75rem; color: #166534; display: block;">Épaules et hanches équilibrées</span>
						</div>

					</div>

					<!-- Visual Comparison Bar -->
					<div style="margin-bottom: 1.5rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
							<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Écart Prêt-à-Porter vs Robe Nuptiale</span>
							<span id="size-diff-note" class="font-body" style="font-size: 0.85rem; color: var(--accent-red); font-weight: bold;">+1 Taille Au-Dessus</span>
						</div>
						<div style="display: flex; flex-direction: column; gap: 0.5rem;">
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="width: 100px; font-size: 0.85rem; font-weight: bold;">Prêt-à-porter :</span>
								<div style="flex: 1; height: 18px; background: #e5e7eb; border-radius: 4px; border: 1px solid var(--fg-pencil); overflow: hidden;">
									<div id="bar-street" style="height: 100%; width: 35%; background: var(--accent-blue); transition: width 0.4s ease;"></div>
								</div>
								<span id="bar-label-street" style="width: 55px; font-size: 0.9rem; font-weight: bold;">38 FR</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="width: 100px; font-size: 0.85rem; font-weight: bold; color: var(--accent-red);">Robe Mariée :</span>
								<div style="flex: 1; height: 18px; background: #e5e7eb; border-radius: 4px; border: 1px solid var(--fg-pencil); overflow: hidden;">
									<div id="bar-bridal" style="height: 100%; width: 45%; background: var(--accent-red); transition: width 0.4s ease;"></div>
								</div>
								<span id="bar-label-bridal" style="width: 55px; font-size: 0.9rem; font-weight: bold; color: var(--accent-red);">40 FR</span>
							</div>
						</div>
					</div>

					<!-- International Conversion Matrix Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🌐 Tableau des Équivalences Internationales
						</h4>
						<div style="overflow-x: auto;">
							<table style="width: 100%; border-collapse: collapse; text-align: center; font-size: 0.95rem; font-family: var(--font-body);">
								<thead>
									<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">France (FR)</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Europe (EU)</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">US Mariée</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">UK / Australie</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Italie (IT)</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td id="matrix-fr" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">40 FR</td>
										<td id="matrix-eu" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">38</td>
										<td id="matrix-us" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">10</td>
										<td id="matrix-uk" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">12</td>
										<td id="matrix-it" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">44</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>

					<!-- Measurement Anchor Alert & Alteration Guidance -->
					<div style="background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<strong class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							✂️ Conseil Couturière & Commande :
						</strong>
						<p id="alteration-advice-text" class="font-body" style="font-size: 0.95rem; margin: 0; line-height: 1.5; color: var(--fg-pencil);">
							Votre mensuration la plus forte correspond aux hanches. Commandez toujours cette taille pour que la robe se ferme parfaitement. La couturière ajustera le bustier et la taille lors des essayages.
						</p>
					</div>

				</div>

				<!-- Flattering Gown Silhouette Recommendations Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
						<span>✨</span> Coupes Idéales selon Votre Morphologie
					</h3>
					<div id="silhouette-cards-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
						<!-- Injected via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 20px; margin: 0 0 5px 0;">Manage.Wedding — Fiche de Mensurations & Tailles Robe de Mariée</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exporté le : <span id="print-date"></span> | Fiche pour Styliste & Couturière</p>
			</div>
			
			<table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 8px; text-align: left;">Zone de Mensuration</th>
						<th style="border: 1px solid #ccc; padding: 8px; text-align: center;">Mesure Cliente</th>
						<th style="border: 1px solid #ccc; padding: 8px; text-align: center;">Taille Correspondante</th>
					</tr>
				</thead>
				<tbody id="print-meas-body"></tbody>
			</table>

			<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px; background: #fafafa;">
				<h3 style="margin: 0 0 8px 0; font-size: 15px;">Synthèse des Tailles Conseillées :</h3>
				<p style="margin: 4px 0;">• <strong>Taille Robe de Mariée à Commander :</strong> <span id="print-rec-size"></span></p>
				<p style="margin: 4px 0;">• <strong>Taille Prêt-à-Porter :</strong> <span id="print-street-size"></span></p>
				<p style="margin: 4px 0;">• <strong>Morphologie :</strong> <span id="print-body-shape"></span></p>
				<p style="margin: 4px 0;">• <strong>Note Retouches :</strong> <span id="print-alteration-note"></span></p>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Repères Rapides</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Correspondance des Tailles Prêt-à-Porter vs Robe de Mariée
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>Règle d'or :</strong> Les robes de mariée taillent généralement <strong>1 taille au-dessus</strong> de vos vêtements habituels (ex. un 38 en prêt-à-porter correspond à un 40 en robe de mariée). Commandez toujours selon votre <strong>mensuration la plus grande</strong> (poitrine, taille ou hanches) car resserrer une robe est simple, alors que l'agrandir est très limité.
			</p>
			
			<!-- Benchmark Size Conversion Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Prêt-à-Porter FR</th>
