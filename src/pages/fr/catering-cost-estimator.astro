---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/catering-cost-estimator/#webapp",
      "name": "Estimateur du Coût Traiteur de Mariage & Prix par Personne",
      "url": "https://manage.wedding/fr/catering-cost-estimator",
      "description": "Calculateur gratuit de budget traiteur de mariage. Estimez le coût par personne pour un repas assis, buffet, cocktail dînatoire, vin d'honneur, droit de bouchon, service et location de vaisselle. Export devis Word, PDF et Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Estimer le Coût Global d'un Traiteur de Mariage",
      "description": "Guide complet pour chiffrer le prix par invité (repas, vin d'honneur, boissons, personnel de service, vaisselle et TVA).",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Choisir la Formule de Repas",
          "text": "Sélectionnez un dîner servi à l'assiette, un buffet chaud/froid, un repas à partager ou un cocktail dînatoire avec animations culinaires."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Configurer le Vin d'Honneur et les Pièces Cocktails",
          "text": "Ajoutez 6 à 10 pièces cocktails par personne, ateliers découpe ou bar à huîtres pour le cocktail apéritif."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Intégrer les Boissons et le Droit de Bouchon",
          "text": "Choisissez un forfait boissons traiteur ou appliquez le droit de bouchon si vous apportez votre propre vin et champagne."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Ajouter la Vaisselle, le Service et les Repas Prestataires",
          "text": "Incluez le nappage, le personnel de salle (maîtres d'hôtel, serveurs) et les repas chauds pour le photographe et le DJ."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quel est le prix moyen d'un traiteur de mariage par personne en France ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En France, le budget moyen d'un traiteur de mariage se situe entre 85 € et 160 € par invité tout compris (vin d'honneur avec 6 à 8 pièces, repas assis entrée-plat-fromage-dessert, service en salle, nappage et vaisselle). Pour un menu gastronomique haut de gamme avec open bar, comptez entre 170 € et 250 € par personne."
          }
        },
        {
          "@type": "Question",
          "name": "Un buffet est-il réellement moins cher qu'un repas servi à l'assiette ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pas obligatoirement. Si le buffet réduit légèrement le nombre de serveurs nécessaires, il exige 20% à 25% de volume de nourriture supplémentaire pour que les plats restent généreusement garnis jusqu'au dernier invité. Un buffet soigné revient souvent au même prix qu'un menu servi à table."
          }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce que le droit de bouchon et combien coûte-t-il ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le droit de bouchon est une redevance facturée par le traiteur ou le domaine (généralement 5 € à 15 € par bouteille ouverte) lorsque vous fournissez votre propre vin ou champagne. Il couvre le débouchage, le service au verre, la verrerie et le nettoyage."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur Coût Traiteur Mariage (Prix par Personne & Devis) | Manage.Wedding"
	description="Estimez le coût réel de votre traiteur de mariage : repas assis, buffet, vin d'honneur, droit de bouchon, service, vaisselle et repas prestataires. Export Word et PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Coût Traiteur Mariage" category="dining" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculateur Traiteur de Mariage
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Estimez le coût global tout compris : repas assis ou buffet, vin d'honneur, boissons, location de vaisselle, service et TVA. Exportez votre <strong>Devis Estimatif</strong> en <strong>Word (.doc)</strong> ou <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- Main Workspace Grid: Configurator + Real-Time Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="catering-calc-grid">
			
			<!-- Left Column: Input Form & Package Controls -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							🍽️ Formule & Prestations Traiteur
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Configurez le repas, les boissons, la vaisselle et le service
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Devise :</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="CHF">CHF (Suisse)</option>
							<option value="$">$ (USD/CAD)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="catering-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Guest Count & Vendor Meals -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
						<div>
							<label for="input-guest-count" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Nombre d'Invités Adultes *
							</label>
							<input type="number" id="input-guest-count" value="100" min="10" max="1000" required style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
						</div>

						<div>
							<label for="input-vendor-meals" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Repas Prestataires (Photo, DJ)
							</label>
							<input type="number" id="input-vendor-meals" value="4" min="0" max="30" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
						</div>
					</div>

					<!-- Meal Service Style -->
					<div>
						<label for="select-meal-style" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Formule du Repas de Réception
						</label>
						<select id="select-meal-style" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="65" selected>Dîner Assis 3 Plats Traditionnel (65 € / invité)</option>
							<option value="50">Buffet Chaud & Froid Gourmand (50 € / invité)</option>
							<option value="58">Plats Conviviaux à Partager sur Table (58 € / invité)</option>
							<option value="48">Cocktail Dînatoire & Ateliers Culinaires (48 € / invité)</option>
							<option value="35">Food Truck & Ambiance Festival (35 € / invité)</option>
							<option value="30">Brunch Buffet du Lendemain (30 € / invité)</option>
						</select>
					</div>

					<!-- Passed Appetizers / Cocktail Hour -->
					<div>
						<label for="select-appetizers" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Vin d'Honneur & Cocktail Apéritif
						</label>
						<select id="select-appetizers" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="0">Aucun / Inclus dans la formule globale (0 €)</option>
							<option value="14" selected>Vin d'Honneur Standard (6 à 8 pièces / personne) (14 €)</option>
							<option value="22">Vin d'Honneur Gourmand (10 pièces + Atelier Découpe) (22 €)</option>
							<option value="30">Prestige : Bar à Huîtres, Foie Gras & Plancha (30 €)</option>
						</select>
					</div>

					<!-- Bar & Beverage Package -->
					<div>
						<label for="select-bar-package" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Boissons & Droit de Bouchon
						</label>
						<select id="select-bar-package" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="0">Boissons Sans Alcool Uniquement (0 €)</option>
							<option value="8">Droit de Bouchon (Vous apportez vos bouteilles) (8 € / invité)</option>
							<option value="18">Forfait Vins, Bières & Eaux (18 € / invité)</option>
							<option value="28" selected>Forfait Complet Vins, Champagne & Eaux (28 € / invité)</option>
							<option value="42">Open Bar Prestige Cocktails & Spiritueux (42 € / invité)</option>
						</select>
					</div>

					<!-- Rentals & Dinnerware -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
						<div>
							<label for="select-rentals" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Vaisselle & Nappage
							</label>
							<select id="select-rentals" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff;">
								<option value="0">Fournie par le domaine (0 €)</option>
								<option value="9" selected>Vaisselle & Nappage Standard (9 €/p)</option>
								<option value="18">Vaisselle Vintage / Dorée Prestige (18 €/p)</option>
							</select>
						</div>

						<div>
							<label for="select-dessert-fee" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Service Gâteau / Pièce Montée
							</label>
							<select id="select-dessert-fee" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff;">
								<option value="0">Dessert inclus dans le menu (0 €)</option>
								<option value="3" selected>Frais de découpe & service pièce montée (3 €/p)</option>
								<option value="7">Buffet de desserts traiteur complet (7 €/p)</option>
							</select>
						</div>
					</div>

					<!-- Plus-Plus Fees (Service Charge & Tax) -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-service-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Personnel de Salle / Maître d'Hôtel
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-service-pct" value="15" min="0" max="30" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>

						<div>
							<label for="input-tax-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Taux de TVA Restauration
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-tax-pct" value="10" min="0" max="20" step="0.5" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Surcharge Comparison -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								📋 Devis Estimatif Traiteur
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Budget global tout compris (repas, boissons, service, TVA)
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Devis Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimer PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Cost Per Head vs Total Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Grand Total Invoice -->
						<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--accent-red); display: block; font-weight: bold;">Montant Total TTC</span>
							<strong id="res-grand-total" class="font-heading" style="font-size: 2.2rem; color: var(--accent-red); display: block; line-height: 1.2;">15 092 €</strong>
							<span id="res-total-guest-note" style="font-size: 0.75rem; color: var(--accent-red);">Toutes charges incluses</span>
						</div>

						<!-- All-Inclusive Cost Per Head -->
						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block; font-weight: bold;">Coût Réel / Invité</span>
							<strong id="res-per-head" class="font-heading" style="font-size: 2.2rem; color: var(--accent-blue); display: block; line-height: 1.2;">150,92 €</strong>
							<span id="res-base-diff-note" style="font-size: 0.75rem; color: #1e40af;">Menu seul : 65,00 €</span>
						</div>

					</div>

					<!-- Itemized Invoice Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Détail Postes par Postes
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🥗 Repas & Vin d'Honneur :</td>
									<td id="res-food-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">7 900,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍷 Boissons & Vins :</td>
									<td id="res-bar-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">2 800,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍽️ Vaisselle, Nappage & Gâteau :</td>
									<td id="res-rentals-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1 200,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍱 Repas Prestataires (-50%) :</td>
									<td id="res-vendor-meals-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">130,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Sous-Total HT (Nourriture + Boissons + Matériel) :</td>
									<td id="res-pretax-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">12 030,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-red);">
									<td style="padding: 0.4rem 0;">➕ Personnel de Salle (15%) :</td>
									<td id="res-service-charge" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1 804,50 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil);">
									<td style="padding: 0.4rem 0;">🏛️ TVA Restauration (10%) :</td>
									<td id="res-sales-tax" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1 257,50 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Proportional Cost Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Nourriture & Boissons (80%)</span>
							<span style="color: var(--accent-red);">Service & TVA (20%)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-food-portion" style="width: 80%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-fees-portion" style="width: 20%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Planner Surcharge Alert Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						⚠️ La Réalité des Devis Traiteur :
					</strong>
					<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; color: var(--fg-pencil);">
						Un menu annoncé à <strong>65 € / personne</strong> atteint en réalité <strong>150,92 € / personne</strong> une fois ajoutés le vin d'honneur, les forfaits boissons, la vaisselle, le personnel de salle et la TVA. Évaluez toujours un devis traiteur sur son coût global tout compris !
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 20px; margin: 0 0 5px 0;">Manage.Wedding — Devis Estimatif Traiteur de Mariage</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exporté le : <span id="print-date"></span> | Invités : <span id="print-guests"></span> | Total TTC : <span id="print-total"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Poste de Dépense</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 100px; text-align: center;">Effectif</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 120px; text-align: right;">Montant</th>
					</tr>
				</thead>
				<tbody id="print-invoice-body"></tbody>
			</table>
		</div>

