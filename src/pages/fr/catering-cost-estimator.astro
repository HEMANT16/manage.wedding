<script is:inline>
	let currencySymbol = '€';

	const guestCountInput = document.getElementById('input-guest-count');
	const vendorMealsInput = document.getElementById('input-vendor-meals');
	const mealStyleSelect = document.getElementById('select-meal-style');
	const appetizersSelect = document.getElementById('select-appetizers');
	const barPackageSelect = document.getElementById('select-bar-package');
	const rentalsSelect = document.getElementById('select-rentals');
	const dessertFeeSelect = document.getElementById('select-dessert-fee');
	const servicePctInput = document.getElementById('input-service-pct');
	const taxPctInput = document.getElementById('input-tax-pct');
	const currencySelect = document.getElementById('currency-select');

	const resGrandTotal = document.getElementById('res-grand-total');
	const resPerHead = document.getElementById('res-per-head');
	const resBaseDiffNote = document.getElementById('res-base-diff-note');
	const resTotalGuestNote = document.getElementById('res-total-guest-note');

	const resFoodSubtotal = document.getElementById('res-food-subtotal');
	const resBarSubtotal = document.getElementById('res-bar-subtotal');
	const resRentalsSubtotal = document.getElementById('res-rentals-subtotal');
	const resVendorMealsSubtotal = document.getElementById('res-vendor-meals-subtotal');
	const resPretaxSubtotal = document.getElementById('res-pretax-subtotal');
	const resServiceCharge = document.getElementById('res-service-charge');
	const resSalesTax = document.getElementById('res-sales-tax');

	const barFoodPortion = document.getElementById('bar-food-portion');
	const barFeesPortion = document.getElementById('bar-fees-portion');

	function formatMoney(amount) {
		return `${Math.round(amount).toLocaleString('fr-FR')} ${currencySymbol}`;
	}

	function calculateCatering() {
		currencySymbol = currencySelect.value;
		const guests = parseInt(guestCountInput.value) || 0;
		const vendors = parseInt(vendorMealsInput.value) || 0;

		const mealBasePerHead = parseFloat(mealStyleSelect.value) || 0;
		const appPerHead = parseFloat(appetizersSelect.value) || 0;
		const barPerHead = parseFloat(barPackageSelect.value) || 0;
		const rentalPerHead = parseFloat(rentalsSelect.value) || 0;
		const dessertPerHead = parseFloat(dessertFeeSelect.value) || 0;

		const servicePct = (parseFloat(servicePctInput.value) || 0) / 100;
		const taxPct = (parseFloat(taxPctInput.value) || 0) / 100;

		// Subtotals
		const foodSubtotal = guests * (mealBasePerHead + appPerHead);
		const barSubtotal = guests * barPerHead;
		const rentalsSubtotal = guests * (rentalPerHead + dessertPerHead);
		const vendorMealsSubtotal = vendors * (mealBasePerHead * 0.5); // 50% crew discount

		const pretaxSubtotal = foodSubtotal + barSubtotal + rentalsSubtotal + vendorMealsSubtotal;
		const serviceCharge = pretaxSubtotal * servicePct;
		const salesTax = (pretaxSubtotal + serviceCharge) * taxPct;
		const grandTotal = pretaxSubtotal + serviceCharge + salesTax;

		const trueCostPerHead = guests > 0 ? (grandTotal / guests) : 0;

		// Update DOM
		resGrandTotal.textContent = formatMoney(grandTotal);
		resPerHead.textContent = `${trueCostPerHead.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${currencySymbol}`;
		resTotalGuestNote.textContent = `Calculé pour ${guests} invités`;
		resBaseDiffNote.textContent = `Menu seul : ${mealBasePerHead.toFixed(2)} ${currencySymbol}`;

		resFoodSubtotal.textContent = formatMoney(foodSubtotal);
		resBarSubtotal.textContent = formatMoney(barSubtotal);
		resRentalsSubtotal.textContent = formatMoney(rentalsSubtotal);
		resVendorMealsSubtotal.textContent = formatMoney(vendorMealsSubtotal);
		resPretaxSubtotal.textContent = formatMoney(pretaxSubtotal);
		resServiceCharge.textContent = formatMoney(serviceCharge);
		resSalesTax.textContent = formatMoney(salesTax);

		// Proportions
		if (grandTotal > 0) {
			const directFoodBarPct = Math.round((pretaxSubtotal / grandTotal) * 100);
			const feePct = 100 - directFoodBarPct;
			barFoodPortion.style.width = `${directFoodBarPct}%`;
			barFeesPortion.style.width = `${feePct}%`;
		}
	}

	// Listeners
	[guestCountInput, vendorMealsInput, servicePctInput, taxPctInput].forEach(el => el.addEventListener('input', calculateCatering));
	[mealStyleSelect, appetizersSelect, barPackageSelect, rentalsSelect, dessertFeeSelect, currencySelect].forEach(el => el.addEventListener('change', calculateCatering));

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const guests = parseInt(guestCountInput.value) || 0;
		const mealText = mealStyleSelect.options[mealStyleSelect.selectedIndex].text;
		const barText = barPackageSelect.options[barPackageSelect.selectedIndex].text;

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Devis Estimatif Traiteur Mariage</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Devis Estimatif Traiteur de Mariage</h1>
				<p>Généré le ${new Date().toLocaleDateString('fr-FR')} | Effectif : <strong>${guests} invités</strong> | Coût Réel / Personne : <strong>${resPerHead.textContent}</strong></p>
				
				<h3>Prestations Sélectionnées :</h3>
				<p>• <strong>Formule Repas :</strong> ${mealText}</p>
				<p>• <strong>Boissons & Bar :</strong> ${barText}</p>

				<h3>Détail du Devis :</h3>
				<table>
					<thead>
						<tr><th>Poste de Dépense</th><th style="text-align:right;">Montant</th></tr>
					</thead>
					<tbody>
						<tr><td>Repas & Vin d'Honneur</td><td style="text-align:right;">${resFoodSubtotal.textContent}</td></tr>
						<tr><td>Boissons & Vins</td><td style="text-align:right;">${resBarSubtotal.textContent}</td></tr>
						<tr><td>Vaisselle, Nappage & Gâteau</td><td style="text-align:right;">${resRentalsSubtotal.textContent}</td></tr>
						<tr><td>Repas Prestataires</td><td style="text-align:right;">${resVendorMealsSubtotal.textContent}</td></tr>
						<tr style="background:#f9f9f9; font-weight:bold;"><td>Sous-Total HT</td><td style="text-align:right;">${resPretaxSubtotal.textContent}</td></tr>
						<tr><td>Personnel de Salle (${servicePctInput.value}%)</td><td style="text-align:right;">${resServiceCharge.textContent}</td></tr>
						<tr><td>TVA Restauration (${taxPctInput.value}%)</td><td style="text-align:right;">${resSalesTax.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;"><td>Total Général TTC</td><td style="text-align:right; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Devis_Traiteur_Mariage_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const guests = guestCountInput.value;
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('fr-FR');
		document.getElementById('print-guests').textContent = guests;
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-invoice-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Repas & Vin d'Honneur</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${guests} Invités</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFoodSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Boissons & Bar</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${guests} Invités</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBarSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Vaisselle, Nappage & Pièce Montée</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${guests} Invités</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resRentalsSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Repas Prestataires</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${vendorMealsInput.value} Prestataires</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resVendorMealsSubtotal.textContent}</td></tr>
			<tr style="background:#fafafa;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Sous-Total HT</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPretaxSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Personnel de Salle (${servicePctInput.value}%)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resServiceCharge.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">TVA (${taxPctInput.value}%)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resSalesTax.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:14px;">Total TTC Tout Compris</td><td style="border:1px solid #ccc; padding:6px; text-align:center; font-weight:bold;">${resPerHead.textContent} / invité</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:14px;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Poste de Depense,Montant\n";
		csv += `"Repas & Vin d'Honneur","${resFoodSubtotal.textContent}"\n`;
		csv += `"Boissons & Vins","${resBarSubtotal.textContent}"\n`;
		csv += `"Vaisselle & Nappage","${resRentalsSubtotal.textContent}"\n`;
		csv += `"Repas Prestataires","${resVendorMealsSubtotal.textContent}"\n`;
		csv += `"Sous-Total HT","${resPretaxSubtotal.textContent}"\n`;
		csv += `"Personnel de Salle (${servicePctInput.value}%)","${resServiceCharge.textContent}"\n`;
		csv += `"TVA Restauration (${taxPctInput.value}%)","${resSalesTax.textContent}"\n`;
		csv += `"Total General TTC","${resGrandTotal.textContent}"\n`;
		csv += `"Cout Reel Par Invite","${resPerHead.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Devis_Traiteur_Mariage_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateCatering();
</script>
