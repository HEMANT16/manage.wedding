---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/wedding-dessert-table-calculator/#webapp",
      "name": "Calculateur de Bar à Desserts, Mignardises & Candy Bar de Mariage",
      "url": "https://manage.wedding/fr/wedding-dessert-table-calculator",
      "description": "Calculateur interactif gratuit pour bar à desserts de mariage, buffet de mignardises, macarons, cookies et candy bar. Calculez les portions par invité, douzaines pâtissières, bonbonnières et téléchargez les affiches imprimables 'L'amour est doux' et bons de commande pâtissier en PDF et Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Calculer les Quantités de Mignardises, Gâteaux et Bonbons pour un Mariage",
      "description": "Méthode pas à pas pour dimensionner un buffet de douceurs, calculer le nombre de mignardises par personne, les kilos de bonbons et les commandes pâtissières.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Choisir la formule de service du dessert",
          "text": "Déterminez si les mignardises accompagnent la pièce montée / wedding cake (2 à 3 pièces par invité), le remplacent entièrement (4 à 6 pièces par invité), ou s'il s'agit d'un bar à cookies ou candy bar au poids (120g à 160g par invité)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Équilibrer les variétés et douzaines du pâtissier",
          "text": "Sélectionnez de 4 à 8 variétés (macarons, tartelettes, verrines, mini cupcakes, choux, truffes) et convertissez les pièces en douzaines pour votre traiteur ou artisan pâtissier."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Dimensionner les bonbonnières et sachets de douceurs",
          "text": "Calculez le poids total de bonbons en kg, organisez les bonbonnières en verre sur 3 niveaux d'élévation et prévoyez des sachets cadeaux avec une marge de 15%."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Exporter affiches et bon de commande pour le pâtissier",
          "text": "Générez des affiches de table encadrables (8x10 / 5x7), des cavaliers de buffet avec mentions d'allergènes (Sans Gluten, Vegan) et téléchargez le bon de commande en PDF et Word."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien de mignardises ou mini desserts par personne faut-il prévoir pour un mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si vous servez une pièce montée ou un wedding cake en dessert principal, prévoyez 2 à 3 mignardises par invité. Si le bar à desserts remplace totalement le gâteau de mariage, comptez 4 à 6 mignardises par invité afin que chacun puisse goûter différentes saveurs."
          }
        },
        {
          "@type": "Question",
          "name": "Combien de variétés de desserts doit-on proposer sur un buffet de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour 50 à 75 invités, proposez 3 à 4 variétés. Pour 75 à 125 invités, 4 à 5 variétés. Pour 125 à 200 invités, 5 à 7 variétés. Au-delà de 200 invités, prévoyez 6 à 8 variétés au maximum. Proposer trop de variétés crée de l'indécision, des files d'attente et un épuisement rapide des pièces les plus prisées."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle quantité de bonbons prévoir pour un Candy Bar de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Comptez entre 120g et 160g de bonbons et dragées par invité. Pour 100 personnes, prévoyez environ 12 à 15 kg de confiseries réparties dans 6 à 8 bonbonnières et bocaux en verre à hauteurs variées."
          }
        },
        {
          "@type": "Question",
          "name": "Quels desserts fondent ou s'abîment avec la chaleur lors d'un mariage d'été en plein air ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La crème au beurre commence à ramollir à 24°C et fond à 28°C. Les truffes en chocolat, tartelettes à la ganache et verrines fraîches doivent être conservées au frais jusqu'à 30 minutes avant le service. Les macarons sont très sensibles à l'humidité de l'air. Pour les réceptions d'été, privilégiez les sablés décorés, cannelés, financiers, brownies et bonbons durs."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur de Bar à Desserts, Mignardises & Candy Bar de Mariage (PDF Gratuit) | Manage.Wedding"
	description="Calculez les quantités exactes de mignardises, douzaines pour pâtissier, kilos de bonbons et bonbonnières de candy bar. Affiches 8x10 'L'amour est doux', cavaliers d'allergènes et bon de commande en PDF et Word."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Bar à Desserts & Candy Bar" category="food-dining" />
		
		<!-- Hero Section -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🧁</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratuit • Calculateur Interactif • Affiches & Bon de Commande en PDF</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculateur de Bar à Desserts, Mignardises & Candy Bar
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 760px; margin: 0 auto; text-align: center;">
					Calculez les quantités exactes de mignardises individuelles, le poids de bonbons pour votre candy bar, les bonbonnières et les douzaines pour votre artisan pâtissier. Personnalisez vos douceurs, imprimez vos <strong>Affiches 8x10 "L'amour est doux"</strong>, cavaliers de table et téléchargez votre <strong>Bon de Commande Pâtissier</strong> en PDF et Word !
				</p>
			</div>
		</section>

		<!-- Guide en 3 étapes -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>✨</span> Comment Dimensionner Votre Buffet Sucré en 3 Étapes
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Choisissez la Formule
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						En complément de la pièce montée (2–3 pièces/invité), en remplacement du gâteau (4–6 pièces/invité), ou en bar à bonbons au poids.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Équilibrez les Douzaines
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Sélectionnez vos douceurs préférées (macarons, verrines, tartelettes, choux) et convertissez automatiquement en douzaines pâtissières.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Imprimez Affiches & Commande
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Générez vos affiches pour cadre (8x10 / 5x7), cavaliers d'allergènes et téléchargez le bon de commande pour votre traiteur en PDF et Word.
					</p>
				</div>
			</div>
		</div>

		<!-- Interactive Application Workspace -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SECTION 1: Configuration Invités et Formule -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🍰 1. Configuration des Invités & Formule de Buffet
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Ajustez le nombre d'invités confirmés, la gourmandise et le style de service
						</span>
					</div>
					<span id="badge-variety-rec" class="badge-postit" style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); padding: 4px 10px; border: 1.5px solid var(--fg-pencil); border-radius: 6px;">
						Recommandé : 4–5 Variétés
					</span>
				</div>

				<!-- Onglets Formule -->
				<div style="margin-bottom: 1.5rem;">
					<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1rem; color: var(--fg-pencil);">
						Sélectionnez le Type de Buffet Sucré :
					</label>
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.75rem;" id="format-tabs-container">
						
						<label class="format-tab active" data-format="with-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fef08a; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="with-cake" checked style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🎂 + 🧁</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Avec Pièce Montée</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">2–3 pièces/invité</span>
						</label>

						<label class="format-tab" data-format="no-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="no-cake" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🧁✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Sans Gâteau (Seul)</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">4–6 pièces/invité</span>
						</label>

						<label class="format-tab" data-format="cookie-table" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="cookie-table" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍪📦</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Bar à Cookies & Sablés</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">6–8 sablés + boîtes</span>
						</label>

						<label class="format-tab" data-format="candy-buffet" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="candy-buffet" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍬🍭</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Candy Bar & Bonbons</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">120g–160g / invité</span>
						</label>

						<label class="format-tab" data-format="hybrid" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="hybrid" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">👑✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Grand Buffet Sucré</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">Mignardises + Bonbons</span>
						</label>
					</div>
				</div>

				<!-- Contrôles Invités et Appétit -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
					
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="input-guests" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								👥 Nombre d'Invités :
							</label>
							<span id="badge-guests" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 2px 10px; border-radius: 12px; font-size: 0.9rem;">
								100 Invités
							</span>
						</div>
						<input type="range" id="slider-guests" min="20" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="input-guests" min="10" max="1000" value="100" class="form-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 1rem; font-weight: 600; background: #fff;">
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<label for="select-appetite" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🍽️ Appétit & Contexte du Repas :
						</label>
						<select id="select-appetite" style="width: 100%; padding: 0.6rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.95rem; font-weight: 600; background: #fff; margin-bottom: 0.5rem;">
							<option value="light">Léger (Après repas gastronomique 4 plats et vins)</option>
							<option value="standard" selected>Standard (Équilibré : 2.5 pièces / 135g bonbons)</option>
							<option value="generous">Gourmands / Soirée Dansante (Amateurs de douceurs)</option>
						</select>
						<div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
							<input type="checkbox" id="chk-takeaway-favors" style="width: 18px; height: 18px; accent-color: var(--accent-blue);">
							<label for="chk-takeaway-favors" class="font-body" style="font-size: 0.85rem; color: var(--fg-pencil); cursor: pointer;">
								<strong>Inclure Sachets & Boîtes Cadeaux</strong> (+2 pièces / +80g bonbons par invité)
							</label>
						</div>
					</div>

				</div>

				<!-- Statistiques en temps réel -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
					
					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Total Mignardises</span>
						<strong id="stat-total-pieces" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red); line-height: 1.2;">250</strong>
						<span id="stat-pieces-per-guest" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(2.5 pièces / invité)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Douzaines Pâtissières</span>
						<strong id="stat-total-dozens" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); line-height: 1.2;">21 Douz</strong>
						<span id="stat-exact-dozens" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(252 pièces au total)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Kilos de Bonbons</span>
						<strong id="stat-total-candy" class="font-heading" style="font-size: 1.8rem; color: #16a34a; line-height: 1.2;">12.7 kg</strong>
						<span id="stat-candy-kg" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(28 lbs / 6–8 Bocaux)</span>
					</div>

					<div style="text-align: center; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Dressage Buffet</span>
						<strong id="stat-table-size" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); line-height: 1.2;">Table 2.0–2.4 m</strong>
						<span id="stat-napkins-count" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">150 serviettes cocktail</span>
					</div>

				</div>
			</div>

			<!-- SECTION 2: Variétés et Douzaines -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🧁 2. Répartition des Variétés & Douzaines Pâtissières
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Ajustez les quantités par douceur et visualisez les commandes en douzaines
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
						<button type="button" id="btn-auto-balance" class="hand-btn" style="background: var(--post-it); font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 700; display: inline-flex; align-items: center; gap: 0.3rem;">
							<span>⚖️</span> Auto-Équilibrer
						</button>
						<button type="button" id="btn-reset-varieties" class="hand-btn" style="background: #fff; font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 600;">
							🔄 Réinitialiser
						</button>
					</div>
				</div>

				<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; font-size: 0.85rem;">
						<span><strong>Pièces Assignées :</strong> <span id="label-allocated-pieces">250</span> / <span id="label-target-pieces">250</span> Cible</span>
						<span id="label-allocation-status" style="font-weight: 700; color: #16a34a;">✅ Parfaitement Équilibré</span>
					</div>
					<div style="width: 100%; height: 10px; background: #e2e8f0; border-radius: 5px; overflow: hidden; border: 1px solid var(--fg-pencil);">
						<div id="bar-allocation-progress" style="width: 100%; height: 100%; background: #16a34a; transition: width 0.3s ease, background-color 0.3s ease;"></div>
					</div>
				</div>

				<div id="dessert-items-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
				</div>

				<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 6px; padding: 1rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between;">
					<div style="display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 240px;">
						<span style="font-size: 1.2rem;">➕</span>
