---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/wedding-hashtag-generator/#webapp",
      "name": "Générateur de Hashtags de Mariage et Pancartes de Table",
      "url": "https://manage.wedding/fr/wedding-hashtag-generator",
      "description": "Générez plus de 50 hashtags de mariage originaux, romantiques et festifs. Copie en 1 clic et création de pancartes de table à imprimer en PDF et Word pour le bar et le photobooth.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Comment fonctionne ce générateur de hashtags de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'algorithme combine vos prénoms, noms de famille, surnom de couple, année de mariage et lieu pour créer des dizaines d'idées réparties par ambiance (Romantique, Humour & Jeux de mots, Fête & Soirée, Court & Moderne)."
          }
        },
        {
          "@type": "Question",
          "name": "Pourquoi utiliser des majuscules (CamelCase) dans son hashtag ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le format CamelCase (ex. #MariageAlexEtEleonore au lieu de #mariagealexeteleonore) facilite grandement la lecture pour les invités, évite les fautes de frappe et permet aux lecteurs d'écran d'accessibilité de bien prononcer chaque mot séparément."
          }
        },
        {
          "@type": "Question",
          "name": "Où afficher le hashtag pendant le mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Affichez votre hashtag sur les faire-part, le site internet de votre mariage, le bar à cocktails, le photobooth et les marques-places de table. Vous pouvez imprimer une pancarte encadrable en 1 clic grâce à notre outil !"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Comment Créer et Utiliser son Hashtag de Mariage",
      "description": "Guide pratique pour créer un hashtag unique et récolter toutes les photos de vos invités.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Renseigner les Prénoms et Noms",
          "text": "Indiquez les prénoms des mariés, le nom de famille, l'année du mariage ou la ville de réception."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Filtrer par Style et Choisir son Favori",
          "text": "Parcourez les suggestions (Romantique, Festif, Court) et cliquez sur votre hashtag préféré."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Vérifier la Disponibilité sur Instagram",
          "text": "Vérifiez que le hashtag n'est pas saturé par des milliers de publications existantes en y ajoutant l'année."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Imprimer la Pancarte pour les Tables et le Bar",
          "text": "Exportez votre pancarte en PDF haute définition et glissez-la dans un joli cadre photo sur les tables."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Générateur de Hashtags Mariage & Pancartes de Table | Manage.Wedding"
	description="Générez 50+ hashtags de mariage uniques, drôles et romantiques. Copie en 1 clic et pancartes de table à imprimer en PDF pour bar et photobooth."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Générateur de Hashtags" category="stationery" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<span class="badge-postit">Réseaux Sociaux & Souvenirs Photos</span>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Générateur de Hashtags <span class="accent-italic">de Mariage</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Générez plus de 50 hashtags originaux, romantiques et festifs. Copiez en 1 clic, vérifiez la disponibilité Instagram et exportez une <strong>pancarte de table prête à imprimer</strong> en Word ou PDF !
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Trouver son Hashtag Idéal en 3 Étapes
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Saisir vos Prénoms & Noms
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indiquez vos prénoms, noms de famille, surnom de couple et l'année de célébration.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Choisir son Style & Copier
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Filtrez par ambiance (Romantique, Humour, Soirée festive ou Court) et sélectionnez votre hashtag préféré.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Imprimer la Pancarte de Table
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Générez votre affiche en PDF pour l'installer dans un cadre sur le bar à cocktails et le photobooth.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Generator Form + Live Results & Sign Mockup -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: start; margin-bottom: 3.5rem;">
			
			<!-- Left Column: Couple Details Form & Filter Tabs -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💍 Informations des Mariés
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Saisissez vos prénoms et noms pour générer vos combinaisons
					</span>
				</div>

				<form id="hashtag-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Partner 1 -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p1-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Prénom Conjoint(e) 1 *
							</label>
							<input type="text" id="p1-first" value="Éléonore" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p1-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Nom Conjoint(e) 1 *
							</label>
							<input type="text" id="p1-last" value="Martin" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Partner 2 -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p2-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Prénom Conjoint(e) 2 *
							</label>
							<input type="text" id="p2-first" value="Alexandre" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p2-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Nom Conjoint(e) 2 *
							</label>
							<input type="text" id="p2-last" value="Vaneau" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Nickname, Year, Destination -->
					<div style="display: grid; grid-template-columns: 1.2fr 0.8fr 1fr; gap: 0.6rem;">
						<div>
							<label for="couple-nickname" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Surnom (Optionnel)
							</label>
							<input type="text" id="couple-nickname" value="EleoEtAlex" placeholder="ex. EleoAlex" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-year" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Année
							</label>
							<input type="number" id="wedding-year" value="2026" min="2024" max="2035" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-city" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Lieu / Ville (Opt)
							</label>
							<input type="text" id="wedding-city" placeholder="ex. Provence / Paris" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</div>

					<!-- Vibe Filter Selector -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
							🎨 Filtrer par Style de Hashtag :
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
							<button type="button" class="filter-tab-btn active-tab hand-btn" data-vibe="all" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">✨ Toutes les Idées</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="romantic" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">💖 Romantique</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="funny" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">😂 Humour & Peps</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="party" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">🥂 Fête & Soirée</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="short" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">⚡ Court & Moderne</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Hashtag Cards Stream & Printable Sign Mockup -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Printable Table Sign Mockup Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖨️ Aperçu de la Pancarte de Table
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Pancarte prête à imprimer pour cadre photo au bar et au photobooth
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Pancarte PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Table Sign Mockup Box -->
					<div id="table-sign-mockup" style="border: 2.5px solid var(--fg-pencil); border-radius: 6px; padding: 2rem 1.5rem; background: var(--bg-paper); text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1rem;">
						
						<!-- Corner Marks -->
						<div style="position: absolute; top: 6px; left: 6px; width: 14px; height: 14px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 6px; right: 6px; width: 14px; height: 14px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; left: 6px; width: 14px; height: 14px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; right: 6px; width: 14px; height: 14px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<p style="font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; color: var(--accent-red); margin: 0 0 0.5rem 0; font-weight: bold;">
							AIDEZ-NOUS À IMMORTALISER CE JOUR !
						</p>

						<h2 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0;">
							Partagez vos photos & vidéos sur Instagram avec le hashtag :
						</h2>

						<div style="background: #fff; border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem 1rem; margin: 1rem 0; display: inline-block;">
							<strong id="display-selected-hashtag" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); word-break: break-word;">
								#ViveLesVaneau2026
							</strong>
						</div>

						<p style="font-family: var(--font-body); font-size: 0.88rem; color: var(--text-secondary); margin: 0.5rem 0 0 0; font-style: italic;">
							Pour que nous puissions revivre tous les plus beaux souvenirs de notre journée !
						</p>
					</div>

					<span style="font-size: 0.78rem; color: var(--text-secondary); text-align: center; display: block;">
						💡 Astuce : Cliquez sur n'importe quel hashtag ci-dessous pour l'afficher sur votre pancarte !
					</span>

				</div>

				<!-- Generated Hashtags Stream Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 480px; overflow-y: auto;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0;">
							🏷️ Liste des Hashtags Générés (<span id="tags-count-badge">50+</span>)
						</h3>
						<span style="font-size: 0.78rem; color: var(--accent-red); font-weight: bold;">
							Cliquer pour Copier & Choisir
						</span>
					</div>

					<div id="hashtags-stream-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem;">
						<!-- Populated via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border: 4px solid #000; padding: 50px 30px; text-align: center; font-family: 'Times New Roman', serif; max-width: 600px; margin: 0 auto;">
				<p style="font-size: 16px; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 15px 0;">Aidez-Nous à Immortaliser Cette Journée</p>
				<h1 style="font-size: 28px; margin: 0 0 25px 0;">Identifiez vos Photos & Vidéos</h1>
				<div style="border: 2px dashed #000; padding: 20px; margin: 25px 0; background: #fafafa;">
					<h2 id="print-hashtag-display" style="font-size: 36px; margin: 0; color: #000;">#ViveLesVaneau2026</h2>
				</div>
				<p style="font-size: 16px; font-style: italic; color: #444; margin: 20px 0 0 0;">Merci de célébrer ce moment magique avec nous !</p>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Règle d'Or</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Guide Rapide : Formules & Bonnes Pratiques de Hashtag
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>La Règle d'Or :</strong> Les hashtags les plus mémorables suivent la structure : <strong>[Nom des Mariés] + [Jeu de Mots / Émotion] + [Année / Lieu]</strong>. Utilisez toujours des majuscules au début de chaque mot (<strong>CamelCase</strong>) pour garantir une lisibilité instantanée et éviter les erreurs de frappe.
			</p>
			
			<!-- Benchmark Hashtag Formulas Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Style de Hashtag</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Modèle de Construction</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Exemple Concret</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Idéal Pour</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">1. Le Romantique Intemporel</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#PourLaVieAvecLes[Nom]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: var(--accent-blue);">#PourLaVieAvecLesVaneau</td>
							<td style="padding: 0.6rem 0.8rem;">Mariages classiques et élégants en château / domaine</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">2. Le Clin d'Œil Festif</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#ViveLes[Nom][Annee]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: var(--accent-red);">#ViveLesVaneau2026</td>
							<td style="padding: 0.6rem 0.8rem;">Ambiance chaleureuse et participative</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">3. L'Union des Deux Prénoms</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#[P1]Et[P2]SeMarient</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: #16a34a;">#EleonoreEtAlexandre</td>
							<td style="padding: 0.6rem 0.8rem;">Idéal si les deux mariés gardent leurs noms</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">4. La Soirée Dansante & Cocktail</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#LaFiestaDes[Nom]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: #d97706;">#LaFiestaDesVaneau</td>
							<td style="padding: 0.6rem 0.8rem;">Piste de danse, open bar et soirée jusqu'au bout de la nuit</td>
						</tr>
						<tr>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">5. Court & Épuré</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#[Surnom][Annee]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: var(--fg-pencil);">#EleoAlex2026</td>
							<td style="padding: 0.6rem 0.8rem;">Pancartes photobooth et tirages photos instantanés</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/fr/wedding-hashtag-generator" category="stationery" />

	</main>
</Layout>

<style>
	.filter-tab-btn.active-tab {
		background: var(--fg-pencil) !important;
		color: #fff !important;
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 40px;
		}
	}
</style>

<script is:inline>
	let selectedFeaturedTag = '#ViveLesVaneau2026';
	let currentVibeFilter = 'all';

	const p1FirstInput = document.getElementById('p1-first');
	const p1LastInput = document.getElementById('p1-last');
	const p2FirstInput = document.getElementById('p2-first');
	const p2LastInput = document.getElementById('p2-last');
	const nicknameInput = document.getElementById('couple-nickname');
	const yearInput = document.getElementById('wedding-year');
	const cityInput = document.getElementById('wedding-city');

	const displaySelectedHashtag = document.getElementById('display-selected-hashtag');
	const printHashtagDisplay = document.getElementById('print-hashtag-display');
	const tagsCountBadge = document.getElementById('tags-count-badge');
	const hashtagsStreamContainer = document.getElementById('hashtags-stream-container');

	function cap(str) {
		if (!str) return '';
		return str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();
	}

	function clean(str) {
		return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-zA-Z0-9]/g, '');
	}

	function generateAllTags() {
		const f1 = cap(clean(p1FirstInput.value.trim())) || 'Eleonore';
		const l1 = cap(clean(p1LastInput.value.trim())) || 'Martin';
		const f2 = cap(clean(p2FirstInput.value.trim())) || 'Alexandre';
		const l2 = cap(clean(p2LastInput.value.trim())) || 'Vaneau';
		const nick = cap(clean(nicknameInput.value.trim())) || `${f1}Et${f2}`;
		const yr = clean(yearInput.value.trim()) || '2026';
		const y2 = yr.slice(-2);
		const city = cap(clean(cityInput.value.trim())) || 'Provence';

		const allTags = [
			// Romantique
			{ tag: `#ViveLes${l2}${yr}`, vibe: 'romantic', score: '99%' },
			{ tag: `#PourLaVieAvecLes${l2}`, vibe: 'romantic', score: '98%' },
			{ tag: `#${f1}Et${f2}PourToujours`, vibe: 'romantic', score: '95%' },
			{ tag: `#${f1}ADitOuiA${f2}`, vibe: 'romantic', score: '96%' },
			{ tag: `#Les${l2}PourLaVie`, vibe: 'romantic', score: '94%' },
			{ tag: `#UnisPourToujours${l2}`, vibe: 'romantic', score: '92%' },
			{ tag: `#LeMariageDe${f1}Et${f2}`, vibe: 'romantic', score: '97%' },
			{ tag: `#${f1}Et${f2}SeMarient`, vibe: 'romantic', score: '96%' },
			{ tag: `#ToujoursAvecLes${l2}`, vibe: 'romantic', score: '93%' },
			{ tag: `#${l1}Devient${l2}`, vibe: 'romantic', score: '91%' },
			
			// Humour & Jeux de mots
			{ tag: `#LaBagueAuDoigtDe${l2}`, vibe: 'funny', score: '99%' },
			{ tag: `#IlsOntDitOui${l2}`, vibe: 'funny', score: '97%' },
			{ tag: `#${l2}ALaFolie`, vibe: 'funny', score: '96%' },
			{ tag: `#${f1}Epouse${f2}`, vibe: 'funny', score: '95%' },
			{ tag: `#CestLeGrandJourDes${l2}`, vibe: 'funny', score: '98%' },
			{ tag: `#EnfinMaries${l2}`, vibe: 'funny', score: '94%' },
			{ tag: `#${nick}PourLeMeilleur`, vibe: 'funny', score: '93%' },
			{ tag: `#PasSansLes${l2}`, vibe: 'funny', score: '92%' },

			// Fête & Soirée
			{ tag: `#LaFiestaDes${l2}`, vibe: 'party', score: '99%' },
			{ tag: `#SantePourLes${l2}`, vibe: 'party', score: '97%' },
			{ tag: `#FeteAvecLes${l2}`, vibe: 'party', score: '96%' },
			{ tag: `#OnFeteLeMariageDe${nick}`, vibe: 'party', score: '98%' },
			{ tag: `#DanseAvecLes${l2}`, vibe: 'party', score: '95%' },
			{ tag: `#${l2}WeddingParty${yr}`, vibe: 'party', score: '94%' },
			{ tag: `#ChampagnePourLes${l2}`, vibe: 'party', score: '96%' },

			// Court & Moderne
			{ tag: `#${f1}Et${f2}${yr}`, vibe: 'short', score: '98%' },
			{ tag: `#${f1}Et${f2}${y2}`, vibe: 'short', score: '95%' },
			{ tag: `#${nick}${yr}`, vibe: 'short', score: '97%' },
			{ tag: `#Les${l2}${yr}`, vibe: 'short', score: '99%' },
			{ tag: `#Team${nick}`, vibe: 'short', score: '94%' },

			// Destination
			{ tag: `#${l2}En${city}`, vibe: 'romantic', score: '97%' },
			{ tag: `#${nick}A${city}`, vibe: 'party', score: '96%' }
		];

		return allTags;
	}

	function renderTags() {
		const allTags = generateAllTags();
		
		const filtered = currentVibeFilter === 'all' 
			? allTags 
			: allTags.filter(t => t.vibe === currentVibeFilter);

		tagsCountBadge.textContent = `${filtered.length} Tags`;

		hashtagsStreamContainer.innerHTML = '';
		filtered.forEach(item => {
			const card = document.createElement('div');
			card.className = 'hand-card';
			card.style.cssText = `padding: 0.75rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.15s ease;`;
			
			const isFeatured = item.tag === selectedFeaturedTag;
			if (isFeatured) {
				card.style.borderColor = 'var(--accent-blue)';
				card.style.background = '#eff6ff';
			}

			const igSearchUrl = `https://www.instagram.com/explore/tags/${item.tag.replace('#', '')}/`;

			card.innerHTML = `
				<div style="margin-bottom: 0.5rem;">
					<strong class="font-heading tag-title" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; word-break: break-word;">${item.tag}</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">Style : ${item.vibe}</span>
				</div>
				<div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed #ddd; padding-top: 0.4rem; gap: 0.3rem;">
					<button type="button" class="btn-copy-tag hand-btn" data-tag="${item.tag}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #f0fdf4;">
						📋 Copier
					</button>
					<a href="${igSearchUrl}" target="_blank" rel="noopener noreferrer nofollow" class="hand-btn secondary" style="padding: 0.2rem 0.45rem; font-size: 0.72rem; text-decoration: none;">
						🔍 IG
					</a>
				</div>
			`;

			card.addEventListener('click', (e) => {
				if (e.target.tagName === 'BUTTON' || e.target.tagName === 'A') return;
				selectedFeaturedTag = item.tag;
				displaySelectedHashtag.textContent = selectedFeaturedTag;
				printHashtagDisplay.textContent = selectedFeaturedTag;
				renderTags();
			});

			hashtagsStreamContainer.appendChild(card);
		});

		document.querySelectorAll('.btn-copy-tag').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const tag = btn.getAttribute('data-tag');
				navigator.clipboard.writeText(tag).then(() => {
					const oldText = btn.textContent;
					btn.textContent = 'Copié ! ✅';
					btn.style.background = '#dcfce7';
					setTimeout(() => {
						btn.textContent = oldText;
						btn.style.background = '#f0fdf4';
					}, 1500);
				});
			});
		});
	}

	document.querySelectorAll('.filter-tab-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.filter-tab-btn').forEach(b => {
				b.classList.remove('active-tab');
				b.classList.add('secondary');
			});
			btn.classList.add('active-tab');
			btn.classList.remove('secondary');
			currentVibeFilter = btn.getAttribute('data-vibe');
			renderTags();
		});
	});

	[p1FirstInput, p1LastInput, p2FirstInput, p2LastInput, nicknameInput, yearInput, cityInput].forEach(el => {
		el.addEventListener('input', () => {
			const all = generateAllTags();
			selectedFeaturedTag = all[0].tag;
			displaySelectedHashtag.textContent = selectedFeaturedTag;
			printHashtagDisplay.textContent = selectedFeaturedTag;
			renderTags();
		});
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const allTags = generateAllTags();
		let tagsHtml = '';
		allTags.forEach(t => {
			tagsHtml += `<li style="font-size:14px; font-weight:bold; color:#1e3a8a; margin-bottom:4px;">${t.tag} <span style="font-size:11px; color:#666; font-weight:normal;">(${t.vibe})</span></li>`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Hashtags de Mariage & Pancartes</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					.sign-box { border: 2px solid #333; background: #fafafa; padding: 25px; text-align: center; margin-bottom: 25px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Liste des Hashtags de Mariage</h1>
				<p>Généré le ${new Date().toLocaleDateString('fr-FR')} | Hashtag Vedette : <strong>${selectedFeaturedTag}</strong></p>
				
				<div class="sign-box">
					<p style="text-transform:uppercase; letter-spacing:2px; font-size:12px; margin:0 0 10px 0;">Aidez-nous à immortaliser chaque instant</p>
					<h2 style="font-size:24px; margin:0 0 15px 0;">Partagez vos photos sur Instagram</h2>
					<h1 style="font-size:32px; color:#1e3a8a; margin:10px 0;">${selectedFeaturedTag}</h1>
					<p style="font-style:italic; font-size:13px; margin:15px 0 0 0;">Merci de célébrer cette journée magique avec nous !</p>
				</div>

				<h3>Tous les 50+ Hashtags Générés :</h3>
				<ul>${tagsHtml}</ul>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `hashtags-mariage-${clean(selectedFeaturedTag)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		printHashtagDisplay.textContent = selectedFeaturedTag;
		window.print();
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const allTags = generateAllTags();
		let csv = "Hashtag,Style,Pertinence\n";
		allTags.forEach(t => {
			csv += `"${t.tag}","${t.vibe}","${t.score}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `liste-hashtags-mariage.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	renderTags();
</script>
