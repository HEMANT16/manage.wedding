---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/alcohol-dilution-calculator/#webapp",
      "name": "Calculateur de Dilution d'Alcool et Titre Alcoométrique (ABV)",
      "url": "https://manage.wedding/fr/alcohol-dilution-calculator",
      "description": "Calculateur gratuit de dilution d'alcool. Calculez précisément le volume d'eau ou de diluant à ajouter pour abaisser le degré d'alcool (% vol.) de vos cocktails en bonbonne et spiritueux de mariage.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Diluer un Alcool Fort à un Degré Précis",
      "description": "Méthode pas-à-pas et formule chimique pour diluer des spiritueux ou cocktails préparés en grande quantité.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Renseigner le Volume Initial (ml)",
          "text": "Indiquez le volume de départ de votre alcool fort en millilitres (ex. 750 ml ou 1 000 ml)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Indiquer le Titre Alcoométrique Initial (% vol.)",
          "text": "Renseignez le degré d'alcool de votre bouteille (ex. 40% pour une vodka standard ou 95% pour un alcool pur neutre)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Définir le Degré d'Alcool Visé (% vol.)",
          "text": "Choisissez le degré final désiré (ex. 20% pour un cocktail en fontaine équilibré ou 15% pour un punch léger)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Obtenir le Volume d'Eau ou de Diluant à Ajouter",
          "text": "La formule C1 × V1 = C2 × V2 calcule immédiatement le volume précis d'eau distillée, de jus ou de soda à mélanger."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Comment fonctionne la formule de dilution d'alcool ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Elle repose sur le principe de conservation de la masse d'alcool pur : C1 × V1 = C2 × V2, où C1 est le pourcentage d'alcool initial, V1 le volume de départ, C2 le pourcentage final visé, et V2 le volume total final. Le volume d'eau à ajouter est égal à V2 - V1."
          }
        },
        {
          "@type": "Question",
          "name": "Quel type d'eau utiliser pour diluer un spiritueux ou un cocktail ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il est fortement recommandé d'utiliser de l'eau distillée, déminéralisée de qualité alimentaire ou filtrée par osmose inverse. L'eau du robinet contient du calcaire et du chlore qui altèrent les arômes et peuvent troubler le mélange."
          }
        },
        {
          "@type": "Question",
          "name": "Pourquoi mon cocktail ou alcool devient-il trouble après dilution ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ce phénomène, appelé effet 'louching' ou effet ouzo, se produit lorsque les huiles essentielles aromatiques d'un alcool (comme dans le gin, le pastis ou l'absinthe) ne sont plus solubles lorsque le degré d'alcool descend sous un certain seuil. Pour le limiter, versez toujours l'alcool lentement dans l'eau à température ambiante."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur de Dilution d'Alcool & Cocktails (Degré % vol. & Eau) | Manage.Wedding"
	description="Calculez exactement le volume d'eau ou de diluant à ajouter pour atteindre le degré d'alcool (% vol.) désiré pour vos cocktails de mariage en fontaine."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Dilution d'Alcool & Cocktails" category="dining" />
		
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); margin-bottom: 0.5rem; color: var(--fg-pencil); line-height: 1.15;">
				Calculateur de Dilution d'Alcool <span class="accent-italic">& Cocktails</span>
			</h1>
			<p class="font-body" style="color: var(--secondary-ink); max-width: 680px; margin: 0 auto; font-size: 1.2rem;">
				Ajustez avec précision le degré d'alcool (% vol.) de vos cocktails signatures préparés en bonbonne, liqueurs maison et spiritueux pour votre mariage.
			</p>
		</header>

		<div class="home-grid fade-in" style="max-width: 950px; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 0 auto 3.5rem;">
			
			<!-- Left Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🧪 Paramètres de Dilution
					</h2>
				</div>

				<form id="calc-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					<div class="form-group">
						<label class="form-label" for="initialVolume" style="font-family: var(--font-heading); font-size: 0.95rem;">Volume Initial d'Alcool (ml) *</label>
						<input type="number" id="initialVolume" class="form-input" value="1000" min="1" step="1" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-size: 1.1rem; font-weight: bold;" />
					</div>

					<div class="form-group">
						<label class="form-label" for="initialABV" style="font-family: var(--font-heading); font-size: 0.95rem;">Degré d'Alcool Initial (% vol.) *</label>
						<input type="number" id="initialABV" class="form-input" value="95" min="1" max="100" step="0.1" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-size: 1.1rem; font-weight: bold;" />
					</div>

					<div class="form-group">
						<label class="form-label" for="targetABV" style="font-family: var(--font-heading); font-size: 0.95rem;">Degré d'Alcool Désiré (% vol.) *</label>
						<input type="number" id="targetABV" class="form-input" value="40" min="1" max="100" step="0.1" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-size: 1.1rem; font-weight: bold;" />
					</div>

					<button type="submit" id="calc-btn" class="hand-btn" style="width: 100%; padding: 0.75rem; font-size: 1.05rem; margin-top: 0.5rem;">
						Calculer la Dilution
					</button>
				</form>
			</div>

			<!-- Right Results -->
			<div class="hand-card result-box" id="result-container" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div style="width: 100%;">
						<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							📊 Résultat du Dosage
						</h3>
					</div>
				</div>
				
				<div class="result-item" style="margin-bottom: 1.2rem; background: #eff6ff; border: 2px solid var(--accent-blue); border-radius: 6px; padding: 1rem; text-align: center;">
					<span class="item-label" style="font-size: 0.85rem; font-weight: bold; color: var(--accent-blue); display: block; text-transform: uppercase;">EAU / DILUANT À AJOUTER</span>
					<span class="item-value" id="res-water" style="color: var(--accent-blue); font-size: 2.4rem; font-weight: bold; font-family: var(--font-heading); display: block; line-height: 1.2; margin: 0.2rem 0;">1 375,00 ml</span>
					<span class="item-desc" style="font-size: 0.85rem; color: var(--secondary-ink);">Volume d'eau distillée, soda ou jus</span>
				</div>

				<div class="result-item" style="margin-bottom: 1.5rem; background: #fdfbf7; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; text-align: center;">
					<span class="item-label" style="font-size: 0.8rem; font-weight: bold; color: var(--fg-pencil); display: block; text-transform: uppercase;">VOLUME FINAL DU MÉLANGE</span>
					<span class="item-value" id="res-final" style="font-size: 1.8rem; font-family: var(--font-heading); color: var(--fg-pencil); font-weight: bold; display: block;">2 375,00 ml</span>
					<span style="font-size: 0.8rem; color: var(--secondary-ink);">(soit environ 2,38 Litres prêts à servir)</span>
				</div>

				<div class="chart-container" style="border: 1.5px solid var(--fg-pencil); padding: 1rem; border-radius: 6px; background: var(--bg-paper);">
					<p class="font-body" style="font-size: 0.88rem; margin-bottom: 0.4rem; font-weight: bold;">Proportion du Mélange</p>
					<div style="display: flex; height: 26px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden;">
						<div id="chart-alcohol" style="width: 42.1%; background-color: var(--fg-pencil); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold; transition: width 0.3s ease;">Alcool</div>
						<div id="chart-water" style="width: 57.9%; background-color: var(--accent-blue); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold; transition: width 0.3s ease;">Diluant</div>
					</div>
					<div style="display: flex; justify-content: space-between; margin-top: 0.4rem; font-size: 0.8rem; color: var(--secondary-ink);">
						<span>Alcool pur : <strong id="lbl-alcohol">42,1%</strong></span>
						<span>Diluant : <strong id="lbl-water">57,9%</strong></span>
					</div>
				</div>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 3.5rem auto 2.5rem; max-width: 850px; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape"></div>
			
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Repères Rapides de Dilution
				</h3>
				<span style="background: #fff; border: 1.5px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700; color: var(--accent-red);">
					Formule Chimique
				</span>
			</div>

			<!-- Formula Highlight Box -->
			<div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<div style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--accent-red); margin-bottom: 0.35rem; font-weight: 700;">
					📐 La Formule de Dilution :
				</div>
				<p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.5;">
					<strong>C₁ × V₁ = C₂ × V₂</strong><br />
					<strong>Volume d'Eau à Ajouter (ml) = [(Degré Initial × Volume Initial) ÷ Degré Cible] - Volume Initial</strong>
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; margin-bottom: 1rem; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 560px;">
					<thead>
						<tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil);">Alcool de Base</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil); text-align: center;">Vol. Initial</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red); text-align: center;">Degré Cible</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue); text-align: center;">Eau / Diluant à Ajouter</th>
							<th style="padding: 0.6rem 0.75rem; font-weight: 700; color: var(--fg-pencil); text-align: right;">Volume Total Final</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fffbeb;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red);">⭐ Alcool Neutre 95% vol.</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">1 000 ml</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-red);">40% vol. (Liqueur/Vodka)</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-blue);">+1 375,0 ml</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right; font-weight: 700;">2 375,0 ml</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Vodka / Rhum 40% vol.</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">750 ml</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-red);">20% vol. (Cocktail Bonbonne)</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-blue);">+750,0 ml (Ratio 1:1)</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right;">1 500,0 ml</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Vodka 40% vol.</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">750 ml</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-red);">15% vol. (Punch / Spritz)</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-blue);">+1 250,0 ml</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right;">2 000,0 ml</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">Whisky / Rhum 50% vol.</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">750 ml</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-red);">35% vol.</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-blue);">+321,4 ml</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right;">1 071,4 ml</td>
						</tr>
					</tbody>
				</table>
			</div>

			<p class="font-body" style="font-size: 0.85rem; color: var(--fg-pencil); margin: 0; line-height: 1.4;">
				💡 <strong>Règle de service :</strong> Pour préparer un cocktail en grande quantité (bonbonne avec robinet), un degré final de 15% à 20% vol. est idéal pour garantir convivialité et sécurité.
			</p>
		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="margin: 4rem auto; max-width: 850px; padding: clamp(1.5rem, 3vw, 3rem);">
			<h2 class="font-heading" style="font-size: 2.3rem; margin-bottom: 1.5rem; color: var(--fg-pencil); text-align: center;">
				L'Art de Doser les Cocktails Préparés en Grande Quantité
			</h2>
			
			<img src="/images/bartender_jigger_sketch.webp" alt="Dilution alcool et dosage cocktails de mariage" loading="lazy" decoding="async" style="width: 100%; max-width: 400px; display: block; margin: 2rem auto; border: 2px solid var(--fg-pencil); border-radius: 8px;" />

			<p class="font-body" style="font-size: 1.15rem; margin-bottom: 1.5rem; line-height: 1.6;">
				Préparer des cocktails à l'avance en fontaine ou bonbonnes à robinet (Punch planteur, Sangria blanche, Mojito géant) permet de fluidifier le service au vin d'honneur sans faire attendre les invités. Cependant, un mauvais calcul de dilution peut rendre la boisson trop forte ou au contraire fade et insipide.
			</p>

			<h3 class="font-heading" style="font-size: 1.7rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--accent-blue);">
				Pourquoi Utiliser de l'Eau Distillée ou Filtrée ?
			</h3>
			<p class="font-body" style="font-size: 1.05rem; margin-bottom: 1.5rem; line-height: 1.6;">
				Pour les macérations et liqueurs maison (Limoncello, eau-de-vie arrangée), l'eau du robinet contient des minéraux et des résidus de chlore qui réagissent avec les tanins et provoquent un dépôt blanchâtre inesthétique. Privilégiez toujours une eau de source neutre ou déminéralisée alimentaire.
			</p>

			<h3 class="font-heading" style="font-size: 1.7rem; margin-top: 2.5rem; margin-bottom: 1.25rem; color: var(--fg-pencil); text-align: center;">
				Foire Aux Questions
			</h3>
			
			<div class="faq-container">
				<details class="faq-item" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.15rem; cursor: pointer; color: var(--accent-blue);">
						Comment calculer l'ajout de glaçons dans la dilution ?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; color: var(--secondary-ink); line-height: 1.5;">
						Lorsque des glaçons fondent dans une fontaine à cocktail, ils ajoutent environ 15% à 20% de volume d'eau sur une durée de 2 heures. Si vous servez avec des glaçons en libre-service, préparez votre base légèrement plus concentrée (environ 22% à 25% vol.) pour anticiper cette fonte.
					</p>
				</details>
			</div>
		</article>

		<RelatedTools currentPath="/fr/alcohol-dilution-calculator" category="dining" />
	</main>

	<script is:inline>
		const form = document.getElementById('calc-form');
		const resWater = document.getElementById('res-water');
		const resFinal = document.getElementById('res-final');
		
		const chartAlcohol = document.getElementById('chart-alcohol');
		const chartWater = document.getElementById('chart-water');
		const lblAlcohol = document.getElementById('lbl-alcohol');
		const lblWater = document.getElementById('lbl-water');

		function calculate() {
			const initialVolume = parseFloat(document.getElementById('initialVolume').value);
			const initialABV = parseFloat(document.getElementById('initialABV').value) / 100;
			const targetABV = parseFloat(document.getElementById('targetABV').value) / 100;

			if (targetABV >= initialABV) {
				alert("Le degré cible (% vol.) doit être strictement inférieur au degré initial pour effectuer une dilution.");
				return;
			}
			
			if (isNaN(initialVolume) || isNaN(initialABV) || isNaN(targetABV) || initialVolume <= 0 || initialABV <= 0 || targetABV <= 0) {
				return;
			}

			// C1V1 = C2V2 => V2 = (C1V1) / C2
			const finalVolume = (initialABV * initialVolume) / targetABV;
			const waterToAdd = finalVolume - initialVolume;

			// Update DOM
			if (resWater && resFinal) {
				resWater.textContent = `${waterToAdd.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ml`;
				resFinal.textContent = `${finalVolume.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ml`;
			}

			// Update Chart
			if (chartAlcohol && chartWater && lblAlcohol && lblWater) {
				const alcoholPct = (initialVolume / finalVolume) * 100;
				const waterPct = (waterToAdd / finalVolume) * 100;

				chartAlcohol.style.width = `${alcoholPct}%`;
				chartWater.style.width = `${waterPct}%`;
				lblAlcohol.textContent = `${alcoholPct.toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}%`;
				lblWater.textContent = `${waterPct.toLocaleString('fr-FR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}%`;
			}
		}

		form?.addEventListener('submit', (e) => {
			e.preventDefault();
			calculate();
		});

		['initialVolume', 'initialABV', 'targetABV'].forEach(id => {
			document.getElementById(id)?.addEventListener('input', calculate);
		});

		// Trigger initial calculation
		calculate();
	</script>
	
	<style>
		@media (max-width: 768px) {
			.home-grid {
				grid-template-columns: 1fr !important;
			}
		}
	</style>
</Layout>
