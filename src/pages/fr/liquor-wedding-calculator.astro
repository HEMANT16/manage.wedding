---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/liquor-wedding-calculator/#webapp",
      "name": "Calculateur d'Alcools Forts et Spiritueux de Mariage",
      "url": "https://manage.wedding/fr/liquor-wedding-calculator",
      "description": "Calculateur gratuit d'alcools forts et spiritueux pour open bar de mariage. Calculez les quantités exactes de vodka, whisky, rhum, gin, tequila, diluants, agrumes et glaçons (kg). Export liste de courses Word et PDF.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Calculer les Spiritueux et Cocktails pour un Bar de Mariage",
      "description": "Guide pratique pour dimensionner les bouteilles d'alcool fort, les diluants (sodas/jus), les fruits et la glace pour un open bar réussi.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Définir le Nombre de Buveurs et la Durée",
          "text": "Indiquez le nombre d'invités adultes et la durée du service pour calculer le volume total de verres nécessaires."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Répartir entre Vins, Bières et Spiritueux",
          "text": "Ajustez les pourcentages selon l'ambiance souhaitée (Bar classique : 40% Vins, 40% Spiritueux, 20% Bières ; Soirée Cocktails : 50% Spiritueux)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Personnaliser les Alcools pour Cocktails Signatures",
          "text": "Dosez les ratios de Vodka, Whisky, Tequila, Rhum et Gin selon vos cocktails phares (Mojito, Moscow Mule, Gin Tonic, Spritz)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Exporter la Liste d'Achats et Budget Estimé",
          "text": "Obtenez le nombre précis de bouteilles de 75 cl ou 1,75 L, les litres de sodas/jus, les agrumes frais et les kilos de glaçons."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien de verres de cocktail contient une bouteille de 75 cl d'alcool fort ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Une bouteille standard de 75 cl de spiritueux (vodka, whisky, rhum, gin) permet de préparer environ 16 verres ou cocktails en comptant une dose standard de 4,5 cl d'alcool par verre."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle est la répartition idéale des alcools forts pour un open bar de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La répartition classique recommandée par les barmen est : Vodka (30%), Whisky/Bourbon (25%), Rhum (20%), Gin (15%) et Tequila (10%), en adaptant selon vos cocktails signatures."
          }
        },
        {
          "@type": "Question",
          "name": "Combien de litres de sodas et jus (mixers) faut-il prévoir par bouteille d'alcool ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Comptez environ 1 litre de diluant pour 4 cocktails (soit environ 4 litres de sodas/jus par bouteille de 75 cl de spiritueux). Prévoyez du Tonic, de l'eau gazeuse, du Cola, de la limonade et des jus de fruits."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur d'Alcools Forts & Spiritueux de Mariage (Open Bar & Cocktails) | Manage.Wedding"
	description="Calculez les quantités exactes de bouteilles de vodka, whisky, rhum, gin, tequila, diluants et glaçons (kg) pour votre open bar de mariage. Export Word et PDF."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Alcools Forts & Spiritueux Mariage" category="dining" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Simulateur Spiritueux, Diluants & Glaçons</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Calculateur d'Alcools Forts <span class="accent-italic">& Open Bar</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calculez précisément vos besoins en bouteilles de Vodka, Whisky, Rhum, Gin et Tequila (75 cl ou 1,75 L), diluants, agrumes frais et sacs de glaçons.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Inputs & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Configuration du Bar
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Calcul en Temps Réel
					</span>
				</div>

				<!-- Signature Preset Picker -->
				<div class="form-group" style="margin-bottom: 1rem;">
					<label class="form-label" for="bar-preset" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Profil d'Ambiance du Bar</label>
					<select id="bar-preset" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #f8fafc; font-weight: 600; font-size: 0.95rem;">
						<option value="classic-open-bar" selected>🍸 Open Bar Équilibré (40% Vin, 40% Spiritueux, 20% Bière)</option>
						<option value="cocktail-heavy">🍹 Soirée Cocktails Phares (50% Spiritueux, 30% Vin, 20% Bière)</option>
						<option value="margarita-bourbon">🌵 Spécial Rhum & Whisky (Mojito + Old Fashioned)</option>
						<option value="beer-wine-light-liquor">🍺 Dominante Vins & Bières (45% Vin, 35% Bière, 20% Spiritueux)</option>
						<option value="custom">✏️ Personnalisation Manuelle</option>
					</select>
				</div>

				<!-- Guest Count & Duration -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;" class="form-group">
					<div>
						<label class="form-label" for="guests" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Invités Adultes</label>
						<input type="number" id="guests" class="form-input" value="120" min="10" max="600" step="5" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-size: 1.1rem; font-weight: 700;" />
					</div>
					<div>
						<label class="form-label" for="hours" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Durée du Bar (Heures)</label>
						<input type="number" id="hours" class="form-input" value="4" min="1" max="10" step="0.5" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-size: 1.1rem; font-weight: 700;" />
					</div>
				</div>

				<!-- Crowd Drinking Vibe & Bottle Size Format -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem; margin-bottom: 1rem;" class="form-group">
					<div>
						<label class="form-label" for="vibe" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Rythme des Invités</label>
						<select id="vibe" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.95rem;">
							<option value="light">Modéré (-25% de verres)</option>
							<option value="average" selected>Standard (1 verre / h)</option>
							<option value="heavy">Très Festif (+25% de verres)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="bottle-size" style="font-family: var(--font-heading); font-size: 0.95rem; display: block; margin-bottom: 0.3rem;">Format Bouteille</label>
						<select id="bottle-size" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-weight: 600; font-size: 0.95rem;">
							<option value="750" selected>Standard 75 cl (16 verres)</option>
							<option value="1750">Grand Format 1,75 L (39 verres)</option>
						</select>
					</div>
				</div>

				<!-- Category Preference Sliders (Beer / Wine / Liquor) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil);">
							Répartition des Catégories (%)
						</strong>
						<span id="sum-pref-check" style="font-size: 0.82rem; font-weight: 700; color: #16a34a; background: #f0fdf4; padding: 2px 6px; border-radius: 4px;">
							Total: 100%
						</span>
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍷 Vins & Bulles</span>
							<span id="val-pref-wine">40%</span>
						</div>
						<input type="range" id="pref-wine" min="0" max="100" value="40" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍸 Spiritueux & Cocktails</span>
							<span id="val-pref-liquor">40%</span>
						</div>
						<input type="range" id="pref-liquor" min="0" max="100" value="40" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍺 Bières & Cidres</span>
							<span id="val-pref-beer">20%</span>
						</div>
						<input type="range" id="pref-beer" min="0" max="100" value="20" style="width: 100%; cursor: pointer;" />
					</div>
				</div>

				<!-- Spirit Type Allocation Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.75rem;">
						Répartition des Alcools Forts (%)
					</strong>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍸 Vodka (Mules, Tonics, Cocktails)</span>
							<span id="val-liq-vodka">30%</span>
						</div>
						<input type="range" id="liq-vodka" min="0" max="100" value="30" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🥃 Whisky / Bourbon (Old Fashioned, Highball)</span>
							<span id="val-liq-whiskey">25%</span>
						</div>
						<input type="range" id="liq-whiskey" min="0" max="100" value="25" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌴 Rhum (Mojitos, Planteur, Daiquiri)</span>
							<span id="val-liq-rum">20%</span>
						</div>
						<input type="range" id="liq-rum" min="0" max="100" value="20" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌿 Gin (Gin Tonic, French 75)</span>
							<span id="val-liq-gin">15%</span>
						</div>
						<input type="range" id="liq-gin" min="0" max="100" value="15" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌵 Tequila (Margarita, Paloma)</span>
							<span id="val-liq-tequila">10%</span>
						</div>
						<input type="range" id="liq-tequila" min="0" max="100" value="10" style="width: 100%; cursor: pointer;" />
					</div>
				</div>

				<!-- Champagne Toast Option -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.95rem; font-weight: 600;">
						<input type="checkbox" id="check-champagne-toast" checked style="width: 18px; height: 18px; accent-color: var(--fg-pencil);" />
						<span>Inclure le Champagne pour le Toast (+1 flûte / invité)</span>
					</label>
				</div>

			</div>

			<!-- Right Column: Results & Shopping List -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Primary Results Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Total des Verres Nécessaires
						</span>
						<span id="vibe-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							Rythme Standard
						</span>
					</div>

					<div id="res-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						480 Verres
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.25rem 0;">
						Estimé pour <strong id="res-guest-count-label" style="color: var(--fg-pencil);">120 invités</strong> sur <strong id="res-hours-label" style="color: var(--fg-pencil);">4 heures</strong> de bar.
					</p>

					<!-- Visual Split Bar -->
					<div style="display: flex; height: 28px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; margin-bottom: 1.5rem; font-size: 0.82rem; font-weight: 800; color: #fff; text-align: center; line-height: 28px;">
						<div id="chart-wine" style="background-color: var(--accent-red); width: 40%; transition: width 0.2s;">Vin (40%)</div>
						<div id="chart-liquor" style="background-color: var(--fg-pencil); width: 40%; transition: width 0.2s;">Alcool (40%)</div>
						<div id="chart-beer" style="background-color: var(--accent-blue); width: 20%; transition: width 0.2s;">Bière (20%)</div>
					</div>

					<!-- Estimated Retail Cost Callout -->
					<div style="background: #fdf6e2; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
						<div>
							<strong style="display: block; font-size: 0.92rem; color: var(--fg-pencil);">Budget Alcool Estimé (Achat Direct) :</strong>
							<span style="font-size: 0.82rem; color: #64748b;">(Tarifs moyens caviste / grande surface)</span>
						</div>
						<span id="res-est-cost" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red); font-weight: 800;">
							1 380 €
						</span>
					</div>

					<!-- Itemized Shopping List Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Spirits Section -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin-bottom: 0.6rem;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🥃 Spiritueux & Alcools Forts (<span id="bottle-size-label">75 cl</span>)
							</strong>
							<strong id="res-total-liquor-bottles" style="color: var(--accent-red);">12 Bouteilles</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Vodka :</span>
							<strong id="res-vodka">4 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Whisky / Bourbon :</span>
							<strong id="res-whiskey">3 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Rhum (Blanc / Ambré) :</span>
							<strong id="res-rum">2 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Gin :</span>
							<strong id="res-gin">2 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Tequila :</span>
							<strong id="res-tequila">1 btl</strong>
						</div>

						<!-- Wine & Beer Section -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin: 1rem 0 0.6rem 0;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🍷 Vins, Bières & Champagne
							</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Vin de Table (75 cl) :</span>
							<strong id="res-wine">38 btls (22 Rouge / 16 Blanc)</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Bière (Cartons de 24 btls) :</span>
							<strong id="res-beer">4 Cartons (96 Bières)</strong>
						</div>
						<div id="row-champagne" style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Champagne / Crémant (Toast) :</span>
							<strong id="res-champagne" style="color: var(--accent-red);">20 btls</strong>
						</div>

						<!-- Mixers & Garnishes -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin: 1rem 0 0.6rem 0;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🍋 Diluants, Agrumes & Glaçons
							</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Diluants (Tonic, Soda, Cola, Jus) :</span>
							<strong id="res-mixers">24 Bouteilles (1,5 L)</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Agrumes (Citrons verts, jaunes, oranges) :</span>
							<strong id="res-garnishes">32 Citrons verts • 18 Citrons • 12 Oranges</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem;">
							<span>Glaçons Requis :</span>
							<strong id="res-ice">85 kg (17 sacs de 5 kg)</strong>
						</div>

					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-shopping-list" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimer Liste (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Word (.doc)
						</button>
					</div>

				</div>

				<!-- Bartending Pro Tip Callout -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
