	<!-- Interactive Calculation Script -->
	<script is:inline>
		const presetSelect = document.getElementById('bar-preset');
		const guestsInput = document.getElementById('guests');
		const hoursInput = document.getElementById('hours');
		const vibeSelect = document.getElementById('vibe');
		const bottleSizeSelect = document.getElementById('bottle-size');
		const chkChampagne = document.getElementById('check-champagne-toast');

		const prefWineInput = document.getElementById('pref-wine');
		const prefLiqInput = document.getElementById('pref-liquor');
		const prefBeerInput = document.getElementById('pref-beer');

		const valPrefWine = document.getElementById('val-pref-wine');
		const valPrefLiq = document.getElementById('val-pref-liquor');
		const valPrefBeer = document.getElementById('val-pref-beer');
		const sumPrefCheck = document.getElementById('sum-pref-check');

		const liqVodkaInput = document.getElementById('liq-vodka');
		const liqWhiskeyInput = document.getElementById('liq-whiskey');
		const liqTequilaInput = document.getElementById('liq-tequila');
		const liqRumInput = document.getElementById('liq-rum');
		const liqGinInput = document.getElementById('liq-gin');

		const valLiqVodka = document.getElementById('val-liq-vodka');
		const valLiqWhiskey = document.getElementById('val-liq-whiskey');
		const valLiqTequila = document.getElementById('val-liq-tequila');
		const valLiqRum = document.getElementById('val-liq-rum');
		const valLiqGin = document.getElementById('val-liq-gin');

		const resTotal = document.getElementById('res-total');
		const resGuestLabel = document.getElementById('res-guest-count-label');
		const resHoursLabel = document.getElementById('res-hours-label');
		const vibeBadge = document.getElementById('vibe-badge');
		const resEstCost = document.getElementById('res-est-cost');

		const chartWine = document.getElementById('chart-wine');
		const chartLiq = document.getElementById('chart-liquor');
		const chartBeer = document.getElementById('chart-beer');

		const bottleSizeLabel = document.getElementById('bottle-size-label');
		const resTotalLiquorBottles = document.getElementById('res-total-liquor-bottles');
		const resVodka = document.getElementById('res-vodka');
		const resWhiskey = document.getElementById('res-whiskey');
		const resTequila = document.getElementById('res-tequila');
		const resRum = document.getElementById('res-rum');
		const resGin = document.getElementById('res-gin');

		const resWine = document.getElementById('res-wine');
		const resBeer = document.getElementById('res-beer');
		const resChampagne = document.getElementById('res-champagne');
		const rowChampagne = document.getElementById('row-champagne');

		const resMixers = document.getElementById('res-mixers');
		const resGarnishes = document.getElementById('res-garnishes');
		const resIce = document.getElementById('res-ice');

		const btnPrint = document.getElementById('btn-print-shopping-list');
		const btnDoc = document.getElementById('btn-export-doc');

		function calculateLiquor() {
			const guests = parseInt(guestsInput.value, 10) || 1;
			const hours = parseFloat(hoursInput.value) || 1;
			const vibe = vibeSelect.value;
			const bottleSize = parseInt(bottleSizeSelect.value, 10) || 750;
			const drinksPerBottle = bottleSize === 1750 ? 39 : 16;
			const unitName = bottleSize === 1750 ? 'Bouteilles 1,75 L' : 'Bouteilles 75 cl';

			bottleSizeLabel.textContent = bottleSize === 1750 ? '1,75 L' : '75 cl';

			// Vibe Multiplier
			let multiplier = 1.0;
			if (vibe === 'light') {
				multiplier = 0.75;
				vibeBadge.textContent = 'Rythme Modéré (-25%)';
			} else if (vibe === 'heavy') {
				multiplier = 1.25;
				vibeBadge.textContent = 'Très Festif (+25%)';
			} else {
				vibeBadge.textContent = 'Rythme Standard';
			}

			// Preferences
			let pWine = parseInt(prefWineInput.value, 10) || 0;
			let pLiq = parseInt(prefLiqInput.value, 10) || 0;
			let pBeer = parseInt(prefBeerInput.value, 10) || 0;

			valPrefWine.textContent = `${pWine}%`;
			valPrefLiq.textContent = `${pLiq}%`;
			valPrefBeer.textContent = `${pBeer}%`;

			const prefSum = pWine + pLiq + pBeer;
			sumPrefCheck.textContent = `Total: ${prefSum}%`;
			if (prefSum !== 100) {
				sumPrefCheck.style.color = '#dc2626';
				sumPrefCheck.style.background = '#fef2f2';
			} else {
				sumPrefCheck.style.color = '#16a34a';
				sumPrefCheck.style.background = '#f0fdf4';
			}

			// Normalized Prefs
			const normWine = prefSum > 0 ? pWine / prefSum : 0.4;
			const normLiq = prefSum > 0 ? pLiq / prefSum : 0.4;
			const normBeer = prefSum > 0 ? pBeer / prefSum : 0.2;

			// Spirit Allocations
			let lVodka = parseInt(liqVodkaInput.value, 10) || 0;
			let lWhiskey = parseInt(liqWhiskeyInput.value, 10) || 0;
			let lTequila = parseInt(liqTequilaInput.value, 10) || 0;
			let lRum = parseInt(liqRumInput.value, 10) || 0;
			let lGin = parseInt(liqGinInput.value, 10) || 0;

			valLiqVodka.textContent = `${lVodka}%`;
			valLiqWhiskey.textContent = `${lWhiskey}%`;
			valLiqTequila.textContent = `${lTequila}%`;
			valLiqRum.textContent = `${lRum}%`;
			valLiqGin.textContent = `${lGin}%`;

			const liqSum = lVodka + lWhiskey + lTequila + lRum + lGin;
			const normVodka = liqSum > 0 ? lVodka / liqSum : 0.3;
			const normWhiskey = liqSum > 0 ? lWhiskey / liqSum : 0.25;
			const normRum = liqSum > 0 ? lRum / liqSum : 0.20;
			const normGin = liqSum > 0 ? lGin / liqSum : 0.15;
			const normTequila = liqSum > 0 ? lTequila / liqSum : 0.10;

			// Total Drinks Calculation
			const totalServings = Math.ceil(guests * hours * multiplier);
			resTotal.textContent = `${totalServings} Verres`;
			resGuestLabel.textContent = `${guests} invités`;
			resHoursLabel.textContent = `${hours} heures`;

			// Category Servings
			const wineDrinks = Math.round(totalServings * normWine);
			const liqDrinks = Math.round(totalServings * normLiq);
			const beerDrinks = Math.round(totalServings * normBeer);

			// Chart widths
			chartWine.style.width = `${normWine * 100}%`;
			chartWine.textContent = `Vin (${Math.round(normWine * 100)}%)`;
			chartLiq.style.width = `${normLiq * 100}%`;
			chartLiq.textContent = `Alcool (${Math.round(normLiq * 100)}%)`;
			chartBeer.style.width = `${normBeer * 100}%`;
			chartBeer.textContent = `Bière (${Math.round(normBeer * 100)}%)`;

			// Quantities
			const totalLiqBottles = Math.ceil(liqDrinks / drinksPerBottle);
			let vodkaBottles = lVodka > 0 ? Math.round(totalLiqBottles * normVodka) : 0;
			let whiskeyBottles = lWhiskey > 0 ? Math.round(totalLiqBottles * normWhiskey) : 0;
			let rumBottles = lRum > 0 ? Math.round(totalLiqBottles * normRum) : 0;
			let ginBottles = lGin > 0 ? Math.round(totalLiqBottles * normGin) : 0;
			let tequilaBottles = lTequila > 0 ? Math.round(totalLiqBottles * normTequila) : 0;

			let currentSum = vodkaBottles + whiskeyBottles + rumBottles + ginBottles + tequilaBottles;
			if (currentSum === 0 && totalLiqBottles > 0) {
				vodkaBottles = totalLiqBottles;
			} else if (currentSum !== totalLiqBottles && totalLiqBottles > 0) {
				const diff = totalLiqBottles - currentSum;
				if (vodkaBottles > 0) vodkaBottles = Math.max(0, vodkaBottles + diff);
				else if (whiskeyBottles > 0) whiskeyBottles = Math.max(0, whiskeyBottles + diff);
			}

			const wineBottles = Math.ceil(wineDrinks / 5);
			const redWine = Math.ceil(wineBottles * 0.55);
			const whiteWine = wineBottles - redWine;
			const beerCases = Math.ceil(beerDrinks / 24);

			let champagneBottles = 0;
			if (chkChampagne.checked) {
				champagneBottles = Math.ceil(guests / 6);
				rowChampagne.style.display = 'flex';
				resChampagne.textContent = `${champagneBottles} Bouteilles`;
			} else {
				rowChampagne.style.display = 'none';
			}

			// Mixers & Garnishes
			const totalMixerLiters = liqDrinks * 0.25;
			const mixer2LBottles = Math.ceil(totalMixerLiters / 1.5);

			const limeCount = Math.ceil((liqDrinks * 0.45) / 8 * 1.5);
			const lemonCount = Math.ceil((liqDrinks * 0.30) / 8 * 1.5);
			const orangeCount = Math.ceil((liqDrinks * 0.15) / 8 * 1.5);

			const iceKg = Math.ceil(guests * 0.7);
			const iceBags5kg = Math.ceil(iceKg / 5);

			// Estimated Retail Cost (EUR averages)
			const spiritPrice = bottleSize === 1750 ? 38 : 22;
			const winePrice = 12;
			const beerCasePrice = 28;
			const champPrice = 18;
			const mixerPrice = 2.0;

			const estTotalCost = (totalLiqBottles * spiritPrice) +
				(wineBottles * winePrice) +
				(beerCases * beerCasePrice) +
				(champagneBottles * champPrice) +
				(mixer2LBottles * mixerPrice) +
				(iceBags5kg * 3.5);

			resEstCost.textContent = `${Math.round(estTotalCost).toLocaleString('fr-FR')} €`;

			// Update Displays
			resTotalLiquorBottles.textContent = `${totalLiqBottles} ${unitName}`;
			resVodka.textContent = `${vodkaBottles} btls`;
			resWhiskey.textContent = `${whiskeyBottles} btls`;
			resRum.textContent = `${rumBottles} btls`;
			resGin.textContent = `${ginBottles} btls`;
			resTequila.textContent = `${tequilaBottles} btls`;

			resWine.textContent = `${wineBottles} btls (${redWine} Rouge / ${whiteWine} Blanc)`;
			resBeer.textContent = `${beerCases} Cartons (${beerCases * 24} Bières)`;
			resMixers.textContent = `${mixer2LBottles} Bouteilles (Tonic, Soda, Cola, Jus)`;
			resGarnishes.textContent = `${limeCount} Citrons verts • ${lemonCount} Citrons • ${orangeCount} Oranges`;
			resIce.textContent = `${iceKg} kg (${iceBags5kg} sacs de 5 kg)`;
		}

		// Preset Handlers
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'classic-open-bar') {
				prefWineInput.value = 40; prefLiqInput.value = 40; prefBeerInput.value = 20;
				liqVodkaInput.value = 30; liqWhiskeyInput.value = 25; liqRumInput.value = 20; liqGinInput.value = 15; liqTequilaInput.value = 10;
			} else if (p === 'cocktail-heavy') {
				prefWineInput.value = 30; prefLiqInput.value = 50; prefBeerInput.value = 20;
				liqVodkaInput.value = 35; liqWhiskeyInput.value = 25; liqRumInput.value = 20; liqGinInput.value = 15; liqTequilaInput.value = 5;
			} else if (p === 'margarita-bourbon') {
				prefWineInput.value = 30; prefLiqInput.value = 45; prefBeerInput.value = 25;
				liqVodkaInput.value = 20; liqWhiskeyInput.value = 35; liqRumInput.value = 30; liqGinInput.value = 10; liqTequilaInput.value = 5;
			} else if (p === 'beer-wine-light-liquor') {
				prefWineInput.value = 45; prefLiqInput.value = 20; prefBeerInput.value = 35;
				liqVodkaInput.value = 30; liqWhiskeyInput.value = 30; liqRumInput.value = 20; liqGinInput.value = 10; liqTequilaInput.value = 10;
			}
			calculateLiquor();
		});

		// Live Listeners
		[guestsInput, hoursInput, vibeSelect, bottleSizeSelect, chkChampagne,
		 prefWineInput, prefLiqInput, prefBeerInput,
		 liqVodkaInput, liqWhiskeyInput, liqTequilaInput, liqRumInput, liqGinInput].forEach(elem => {
			elem.addEventListener('input', calculateLiquor);
			elem.addEventListener('change', calculateLiquor);
		});

		// Print Shopping List
		btnPrint.addEventListener('click', () => {
			window.print();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Liste d'Achats Alcools et Spiritueux Mariage</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Liste d'Achats Open Bar & Spiritueux</h2>
					<p>Invités : ${guestsInput.value} | Durée : ${hoursInput.value}h | Budget Estimé : ${resEstCost.textContent}</p>
					<table>
						<thead><tr><th>Boisson / Article</th><th>Quantité à Acheter</th></tr></thead>
						<tbody>
							<tr><td>Vodka</td><td>${resVodka.textContent}</td></tr>
							<tr><td>Whisky / Bourbon</td><td>${resWhiskey.textContent}</td></tr>
							<tr><td>Rhum</td><td>${resRum.textContent}</td></tr>
							<tr><td>Gin</td><td>${resGin.textContent}</td></tr>
							<tr><td>Tequila</td><td>${resTequila.textContent}</td></tr>
							<tr><td>Vins de Table (Rouge / Blanc)</td><td>${resWine.textContent}</td></tr>
							<tr><td>Bières (Cartons 24)</td><td>${resBeer.textContent}</td></tr>
							${chkChampagne.checked ? `<tr><td>Champagne Toast</td><td>${resChampagne.textContent}</td></tr>` : ''}
							<tr><td>Diluants & Sodas</td><td>${resMixers.textContent}</td></tr>
							<tr><td>Agrumes</td><td>${resGarnishes.textContent}</td></tr>
							<tr><td>Glaçons</td><td>${resIce.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob(['\ufeff', content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = `Liste_Alcools_Spiritueux_Mariage_${new Date().toISOString().slice(0, 10)}.doc`;
			link.click();
			URL.revokeObjectURL(link.href);
		});

		// Initial Run
		calculateLiquor();
	</script>
</Layout>
