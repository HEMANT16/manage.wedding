---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/dress-alterations-estimator/#webapp",
      "name": "Estimateur du Coût des Retouches de Robe de Mariée",
      "url": "https://manage.wedding/fr/dress-alterations-estimator",
      "description": "Calculateur gratuit du coût des retouches de robe de mariée. Estimez le tarif d'un ourlet en dentelle, reprise de bustier, coques de maintien, remonte-traîne et repassage vapeur. Export devis couturière Word, PDF et Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien coûtent les retouches d'une robe de mariée en moyenne ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En moyenne, le coût des retouches se situe entre 250 € et 650 € pour des ajustements standards (ourlet simple, reprise du bustier à la taille et pose d'un remonte-traîne 3 points). Pour une robe haute couture en dentelle brodée de perles ou multi-épaisseurs de tulle, le tarif peut atteindre 700 € à 1 100 €."
          }
        },
        {
          "@type": "Question",
          "name": "Pourquoi l'ourlet d'une robe en dentelle est-il si onéreux ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sur une robe ornée de festons de dentelle en bas de jupe, la couturière ne peut pas simplement couper le tissu. Elle doit découdre minutieusement chaque applique de dentelle à la main, raccourcir les doublures intérieures et le tulle, puis recoudre la bordure de dentelle à la main à la longueur exacte."
          }
        },
        {
          "@type": "Question",
          "name": "Quand faut-il prévoir ses rendez-vous d'essayage et retouches ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Comptez 3 rendez-vous clés : 1) Premier essayage : 8 à 10 semaines avant le mariage (épinglage de l'ourlet avec les chaussures définitives, ajustement du bustier et choix du remonte-traîne) ; 2) Deuxième essayage : 4 à 5 semaines avant (vérification des coutures) ; 3) Essayage final : 10 à 14 jours avant le jour J (essayage ultime et défroissage vapeur professionnel)."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Comment Estimer le Tarif des Retouches de Robe de Mariée",
      "description": "Guide pratique pour évaluer les prestations de retouche, planifier ses 3 essayages et budgétiser l'ourlet, le bustier et le remonte-traîne.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Identifier la Finition de l'Ourlet et les Épaisseurs",
          "text": "Observez le bas de votre jupe (bord franc, crinoline rigide ou dentelle festonnée) et comptez le nombre de couches de tulle et doublures."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Définir les Ajustements du Bustier",
          "text": "Vérifiez si le bustier doit être resserré aux pinces, les bretelles raccourcies, ou si des coques de poitrine doivent être intégrées."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Choisir le Système de Remonte-Traîne",
          "text": "Sélectionnez une attache simple 1 point (style américain) ou un remonte-traîne discret sous-jupe 3 à 5 points (style français) pour danser confortablement."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Apporter Chaussures et Sous-Vêtements du Jour J",
          "text": "Venez impérativement au 1er essayage avec vos chaussures à talons exactes et la lingerie que vous porterez au mariage."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur Retouches Robe de Mariée (Ourlet, Bustier & Devis Couture) | Manage.Wedding"
	description="Estimez le coût réel des retouches de votre robe de mariée : ourlet en dentelle, reprise de bustier, pose de coques et remonte-traîne. Export Word et PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Retouches Robe de Mariée" category="floral-attire" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Retouches Robe de Mariée
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Estimez les tarifs réels d'atelier pour l'ourlet, la reprise de bustier, le remonte-traîne et les coques de maintien. Exportez votre <strong>Fiche d'Essayage</strong> en <strong>Word (.doc)</strong> ou <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Chiffrer ses Retouches en 3 Étapes
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Finition de l'Ourlet
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Sélectionnez la matière de la jupe (crêpe simple, crinoline rigide ou dentelle) et le nombre de couches de tulle.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Ajustements du Haut & Traîne
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Cochez les reprises de bustier, bretelles, coques de maintien et choisissez votre type de remonte-traîne.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Fiche pour l'Atelier
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Exportez votre fiche détaillée pour vérifier la cohérence des devis lors de votre 1er rendez-vous d'essayage.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="alterations-calc-grid">
			
			<!-- Left Column: Itemized Tailoring Services -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div style="width: 100%;">
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							✂️ Prestations de Retouche
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Cochez les travaux de couture nécessaires sur votre robe
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem; margin-top: 0.5rem; width: 100%; justify-content: flex-end;">
						<span style="font-size: 0.85rem; font-weight: bold;">Devise :</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="$">$ (USD/CAD)</option>
							<option value="CHF">CHF (Suisse)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="alterations-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Hemming & Skirt Layers -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							1. Ourlet de la Jupe & Matières
						</h3>
						<div style="display: flex; flex-direction: column; gap: 0.5rem;">
							<div>
								<label for="select-hem-type" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
									Finition du Bas de Robe
								</label>
								<select id="select-hem-type" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.9rem;">
									<option value="0">Aucun ourlet nécessaire (0 €)</option>
									<option value="120" selected>Ourlet Franc Simple (Crêpe, Satin, Mousseline) (120 €)</option>
									<option value="180">Bande de Crin / Crinoline Rigide (180 €)</option>
									<option value="270">Dentelle Festonnée (Décousue et recousue à la main) (270 €)</option>
								</select>
							</div>

							<div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-paper); padding: 0.5rem 0.75rem; border: 1px dashed var(--fg-pencil); border-radius: 4px;">
								<div>
									<label for="input-skirt-layers" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Épaisseurs de Tulle / Doublures</label>
									<span style="font-size: 0.75rem; color: var(--text-secondary);">35 € par couche supplémentaire sous la jupe</span>
								</div>
								<div style="display: flex; align-items: center; gap: 0.3rem;">
									<input type="number" id="input-skirt-layers" value="2" min="0" max="10" style="width: 50px; padding: 0.3rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center; background: #fff;">
									<span style="font-size: 0.85rem;">couches</span>
								</div>
							</div>
						</div>
					</div>

					<!-- 2. Bodice, Straps & Bra Structure -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-blue); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							2. Bustier, Bretelles & Maintien Poitrine
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-take-in-bodice" value="100" checked class="alt-checkbox">
								<span>Reprise des Côtés du Bustier (100 €)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-shorten-straps" value="45" checked class="alt-checkbox">
								<span>Raccourcir Bretelles / Épaules (45 €)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-sew-in-cups" value="35" checked class="alt-checkbox">
								<span>Pose de Coques Poitrine (35 €)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-reshape-neckline" value="110" class="alt-checkbox">
								<span>Reprise Décolleté / Dos Nu (110 €)</span>
							</label>

							<label class="service-checkbox-label" style="grid-column: span 2;">
								<input type="checkbox" id="chk-corset-back" value="150" class="alt-checkbox">
								<span>Transformation en Laçage Corset (Gain 1 à 2 tailles) (150 €)</span>
							</label>
						</div>
					</div>

					<!-- 3. Bustle & Train Management -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: #16a34a; margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							3. Remonte-Traîne (Système d'Attache)
						</h3>
						<div>
							<label for="select-bustle-style" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
								Style d'Attache de la Traîne
							</label>
							<select id="select-bustle-style" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.9rem;">
								<option value="0">Aucun remonte-traîne / Robe sans traîne (0 €)</option>
								<option value="60">Attache Simple 1 Point Extérieur (Style américain) (60 €)</option>
								<option value="110" selected>Remonte-Traîne 3 à 5 Points Sous-Jupe (Style français) (110 €)</option>
								<option value="180">Attache Prestige 7 à 10+ Points pour Grande Traîne (180 €)</option>
							</select>
						</div>
					</div>

					<!-- 4. Embellishments, Steaming & Rush Surcharge -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<label class="service-checkbox-label" style="background:#fff;">
								<input type="checkbox" id="chk-beading-repair" value="80" class="alt-checkbox">
								<span>Reprise Perlage & Dentelle (80 €)</span>
							</label>

							<label class="service-checkbox-label" style="background:#fff;">
								<input type="checkbox" id="chk-steaming-press" value="70" checked class="alt-checkbox">
								<span>Défroissage Vapeur Pro (70 €)</span>
							</label>
						</div>

						<div style="margin-top: 0.25rem;">
							<label for="select-timeline-rush" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Délai & Majoration Urgence
							</label>
							<select id="select-timeline-rush" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
								<option value="1.0" selected>Délai Normal (8 à 12 semaines avant) (Aucun surcoût)</option>
								<option value="1.2">Retouche Express (4 à 6 semaines avant) (+20% Majoration)</option>
								<option value="1.45">Urgence Dernière Minute (Moins de 3 semaines) (+45% Majoration)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Line-Item Invoice -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Alteration Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								👗 Devis Estimatif Couture
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Synthèse détaillée pour vos essayages
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Devis Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimer PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Estimated Range Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Coût Total Estimé des Retouches</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">480 €</strong>
						<span id="res-range-subtext" style="font-size: 0.8rem; color: var(--accent-red);">Fourchette moyenne : 420 € - 550 €</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Détail par Poste de Couture
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">✂️ Ourlet Jupe & Doublures :</td>
									<td id="res-hem-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">190,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🪡 Bustier, Bretelles & Coques :</td>
									<td id="res-bodice-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">180,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">👗 Système de Remonte-Traîne :</td>
									<td id="res-bustle-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">110,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">✨ Perlage & Défroissage Vapeur :</td>
									<td id="res-extras-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">70,00 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Majoration Délai Urgent :</td>
									<td id="res-rush-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">0,00 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Cost Scale Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Accessible (200 €)</span>
							<span>Moyen (500 €)</span>
							<span style="color: var(--accent-red);">Haute Couture (900 €+)</span>
						</div>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="cost-gauge-bar" style="width: 48%; height: 100%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Fitting Appointment Reminder Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						📌 Rappel Indispensable pour le 1er Essayage :
					</strong>
					<ul class="font-body" style="font-size: 0.85rem; line-height: 1.5; padding-left: 1.1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Chaussures :</strong> Vous DEVEZ impérativement porter vos chaussures définitives pour régler la hauteur d'ourlet.</li>
						<li><strong>Sous-vêtements :</strong> Venez avec la lingerie ou le body gainant prévu pour le jour J.</li>
						<li><strong>Accessoires :</strong> Apportez votre voile pour tester l'harmonie avec la traîne.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 20px; margin: 0 0 5px 0;">Manage.Wedding — Fiche d'Ajustement Retouches Robe de Mariée</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exporté le : <span id="print-date"></span> | Devis Total Estimé : <span id="print-total"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
