---
import Layout from '../../layouts/Layout.astro';

const title = "Simulateurs d'Invités, Plan de Table & Logistique de Mariage (Outils Gratuits)";
const description = "Simulateurs gratuits pour les invités de mariage : plan de table interactif, surface de piste de danse, cortège de cérémonie et planning du Jour J.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/fr/guests/#collection",
      "name": "Simulateurs d'Invités, Plan de Table et Logistique de Mariage",
      "url": "https://manage.wedding/fr/guests",
      "inLanguage": "fr",
      "description": "Suite complète d'outils pour agencer le plan de table, dimensionner la salle et la piste de danse, organiser le cortège et générer le planning du Jour J.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Plan de Table Interactif", "url": "https://manage.wedding/fr/seating-chart-maker" },
        { "@type": "WebApplication", "name": "Dimensions Salle & Piste de Danse", "url": "https://manage.wedding/fr/seating-clearance-calculator" },
        { "@type": "WebApplication", "name": "Ordre du Cortège Nupcial", "url": "https://manage.wedding/fr/wedding-processional-order" },
        { "@type": "WebApplication", "name": "Planning Déroulé du Jour J", "url": "https://manage.wedding/fr/day-of-timeline-generator" },
        { "@type": "WebApplication", "name": "Planificateur Dîner de Répétition", "url": "https://manage.wedding/fr/rehearsal-dinner-planner" },
        { "@type": "WebApplication", "name": "Gestionnaire de Liste d'Invités", "url": "https://manage.wedding/fr/guest-list-manager" },
        { "@type": "WebApplication", "name": "Suivi des Réponses (RSVP)", "url": "https://manage.wedding/fr/rsvp-tracker" },
        { "@type": "WebApplication", "name": "Estimateur du Taux de Présence", "url": "https://manage.wedding/fr/guest-count-estimator" },
        { "@type": "WebApplication", "name": "Calendrier d'Envoi Faire-part", "url": "https://manage.wedding/fr/rsvp-date-calculator" },
        { "@type": "WebApplication", "name": "Déroulé & Discours de Cérémonie Laïque", "url": "https://manage.wedding/fr/wedding-officiant-script-timer" },
        { "@type": "WebApplication", "name": "Checklist Mariage 12 Mois", "url": "https://manage.wedding/fr/wedding-checklist" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quel est le pourcentage moyen de désistement aux invitations de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour un mariage local réunissant des proches résidant à proximité, le taux de déclinaison est de 10 à 15%. Pour un mariage de destination ou nécessitant hôtel et transport, le taux de refus se situe entre 20 et 30%."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle surface de piste de danse prévoir pour 150 convives ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On estime que 33% à 50% des invités dansent simultanément. Pour 150 personnes (environ 50 à 75 danseurs actifs à raison de 0,45 m² par personne), prévoyez une piste de 25 à 30 m² (soit environ 5m × 5m ou 5m × 6m)."
          }
        },
        {
          "@type": "Question",
          "name": "Quel espace laisser entre les tables rondes d'un banquet ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Laissez un espace minimum de 1,50 m (150 cm) de bord de table à bord de table. Cet écartement offre 45 cm de recul pour les chaises de chaque côté et une allée centrale de 60 cm pour le passage des serveurs et convives."
          }
        }
      ]
    }
  ]
};

const guestTools = [
  {
    title: "Calculateur de Feux de Bengale & Panneaux",
    url: "/fr/wedding-sparkler-calculator",
    icon: "✨",
    badge: "Panneaux Imprimables",
    desc: "Calculez le nombre de cierges magiques, durée des photos, chalumeaux et seaux de sable. Panneaux 'Que l\'Amour Brille' inclus.",
    tags: ["Haie d\'Honneur", "Panneaux Imprimables", "Fiches Sécurité"]
  },

  {
    title: "Plan de Table Interactif",
    url: "/fr/seating-chart-maker",
    icon: "🪑",
    badge: "Glisser-Déposer",
    desc: "Outil visuel d'agencement des tables rondes et rectangulaires. Placez vos invités, équilibrez les affinités et exportez le plan PDF.",
    tags: ["Disposition Visuelle", "Export PDF", "Équilibrage Tables"]
  },
  {
    title: "Dimensions de Salle & Piste de Danse",
    url: "/fr/seating-clearance-calculator",
    icon: "📐",
    badge: "Calculs Métriques",
    desc: "Calculez la surface nécessaire en m², le nombre de tables rondes (150cm vs 180cm) et les allées de 1,5m pour le service.",
    tags: ["Surface Piste de Danse", "Tables Rondes 150cm", "Allées 1,5m"]
  },
  {
    title: "Ordre du Cortège Nupcial & Cérémonie",
    url: "/fr/wedding-processional-order",
    icon: "⛪",
    badge: "Protocole d'Entrée",
    desc: "Organisez l'entrée et la sortie pour cérémonies civiles, religieuses ou laïques : témoins, demoiselles d'honneur et cortège.",
    tags: ["Entrée des Mariés", "Répétition Cérémonie", "Fiches Imprimables"]
  },
  {
    title: "Déroulé & Discours de Cérémonie Laïque",
    url: "/fr/wedding-officiant-script-timer",
    icon: "📜",
    badge: "Trame & Fiches A5",
    desc: "Rédigez et chronométrez le déroulé de votre cérémonie laïque en 9 étapes (120 mots/min) avec prompteur et fiches de pupitre.",
    tags: ["Discours Officiant", "Minuteur Cérémonie", "Fiches A5 Pupitre"]
  },
  {
    title: "Planning Déroulé du Jour J",
    url: "/fr/day-of-timeline-generator",
    icon: "⏰",
    badge: "Très Populaire",
    desc: "Indiquez l'heure de votre cérémonie pour générer un itinéraire complet : coiffure, photos de couple, vin d'honneur et soirée.",
    tags: ["Planning Minute par Minute", "Partage Prestataires", "Word & PDF"]
  },
  {
    title: "Planificateur de Dîner de Répétition",
    url: "/fr/rehearsal-dinner-planner",
    icon: "🍷",
    badge: "Veille du Mariage",
    desc: "Gérez la liste des proches, estimez le budget du repas de la veille et organisez le déroulé de la répétition des vœux.",
    tags: ["Proches & Témoins", "Planning de la Veille", "Budget Restauration"]
  },
  {
    title: "Gestionnaire de Liste d'Invités",
    url: "/fr/guest-list-manager",
    icon: "📋",
    badge: "100% Privé Local",
    desc: "Suivez noms, accompagnants, adresses postales, choix de plats et régimes alimentaires sans transmission de données sur le cloud.",
    tags: ["Accompagnants (+1)", "Export CSV", "Régimes Alimentaires"]
  },
  {
    title: "Suivi des Réponses & Confirmations (RSVP)",
    url: "/fr/rsvp-tracker",
    icon: "✉️",
    badge: "Compteur Temps Réel",
    desc: "Comptabilisez les présences confirmées, désistements, choix de menus et relances en attente avec barres de progression.",
    tags: ["Taux de Réponse", "Choix de Plats", "Verrouillage Traiteur"]
  },
  {
    title: "Estimateur du Taux de Présence Réel",
    url: "/fr/guest-count-estimator",
    icon: "👥",
    badge: "Calcul de Probabilité",
    desc: "Anticipez le nombre final de convives selon le ratio d'invités locaux et de proches venant de loin ou de l'étranger.",
    tags: ["Taux d'Acceptation", "Capacité Salle", "Désistements"]
  },
  {
    title: "Calendrier d'Envoi des Faire-part",
    url: "/fr/rsvp-date-calculator",
    icon: "📬",
    badge: "Rétroplanning Postal",
    desc: "Indiquez la date de votre mariage pour calculer les dates optimales pour Save-the-Date, faire-part et date limite RSVP.",
    tags: ["Date d'Envoi", "Délai Traiteur", "Date Limite RSVP"]
  },
  {
    title: "Checklist de Mariage sur 12 Mois",
    url: "/fr/wedding-checklist",
    icon: "✅",
    badge: "Interactif",
    desc: "Rétroplanning interactif mois par mois avec ajout de tâches personnalisées pour ne rien oublier le Jour J.",
    tags: ["Planning 12 Mois", "Suivi Avancement", "Gestion de Tâches"]
  },
  {
    title: "Estimateur des Retouches de Robe",
    url: "/fr/dress-alterations-estimator",
    icon: "🪡",
    badge: "Tarifs Retoucheuse",
    desc: "Estimez le coût des retouches selon le tissu (dentelle, tulle, soie), l'ourlet, le bustier et la pose de boutonnière pour traîne.",
    tags: ["Tarifs Retouches", "Remonte-Traîne", "Calendrier d'Essais"]
  },
  {
    title: "Convertisseur de Tailles de Robe de Mariée",
    url: "/fr/dress-size-converter",
    icon: "👗",
    badge: "Tableaux Internationaux",
    desc: "Convertissez vos mensurations de poitrine, taille et hanches en cm vers les tailles françaises, US, UK et italiennes.",
    tags: ["Tailles FR US UK IT", "Guide des Mesures", "Robes de Mariée"]
  },
  {
    title: "Baguier & Guide des Tailles d'Alliances",
    url: "/fr/ring-size-converter",
    icon: "💍",
    badge: "Guide en Millimètres",
    desc: "Convertissez la circonférence de votre doigt en mm vers les tailles de bagues françaises (48-70), européennes et américaines.",
    tags: ["Baguier Imprimable", "Tableau International", "Mesure en mm"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Pôle Logistique & Invités</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Simulateurs d'<span class="accent-italic">Invités, Plan de Table & Logistique</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Organisez le cortège de cérémonie, calculez la surface de piste de danse, générez le planning minute par minute et agencez vos tables.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Catégories :</span>
      <a href="/fr/budget" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Budget</a>
      <a href="/fr/dining" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Réception & Bar</a>
      <a href="/fr/guests" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">👥 Invités (Actif)</a>
      <a href="/fr/stationery" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💌 Papeterie & Créatif</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {guestTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
            Ouvrir l'Outil →
          </a>
        </div>
      ))}
    </div>

    <!-- In-Depth Logistics Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Normes d'Agencement</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          Comment Réussir l'Agencement de la Salle et le Déroulé du Jour J
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Du cortège d'entrée aux allées de circulation pour les serveurs, voici les règles appliquées par les professionnels.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. Repères de Surface pour la Piste de Danse
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Une piste trop petite crée une bousculade, tandis qu'une piste démesurée paraît déserte. Appliquez la <strong>règle des 33% de danseurs simultanés (0,45 m² par personne)</strong> :
        </p>
        
        <div style="overflow-x: auto; margin-top: 1rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Nombre d'Invités Total</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Danseurs Simultanés</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--accent-blue);">Surface de Piste Recommandée</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">100 Invités</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">35 à 45 danseurs</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">18 à 20 m² (ex. 4m × 5m)</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">150 Invités</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">50 à 70 danseurs</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">25 à 30 m² (ex. 5m × 5m ou 5m × 6m)</td>
              </tr>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">200 Invités</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">70 à 90 danseurs</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">35 à 40 m² (ex. 6m × 6m)</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">250+ Invités</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">90 à 120 danseurs</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">45 à 55 m² (ex. 7m × 7m)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Foire Aux Questions
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Quel est le pourcentage moyen de désistement aux invitations de mariage ?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Comptez 10 à 15% de déclinaisons pour un mariage local et 20 à 30% pour un mariage nécessitant un voyage ou une réservation d'hôtel.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Quelle surface de piste de danse prévoir pour 150 convives ?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Une piste de 25 à 30 m² (environ 5m × 5m ou 5m × 6m) accueille confortablement 50 à 70 danseurs en simultané.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Quel espace laisser entre les tables rondes d'un banquet ?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Un écartement de 1,50 m entre les bords des tables permet le recul confortable des chaises et le passage aisé des serveurs de banquet.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
