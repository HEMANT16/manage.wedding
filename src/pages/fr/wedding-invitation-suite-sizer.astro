---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/wedding-invitation-suite-sizer/#webapp",
      "name": "Guide des Formats de Faire-Part et Enveloppes de Mariage",
      "url": "https://manage.wedding/fr/wedding-invitation-suite-sizer",
      "description": "Calculez les dimensions exactes, fonds perdus d'impression (300 DPI), formats d'enveloppes (A7, C5, C6, DL, Carré) et marges de coupe pour vos faire-part de mariage.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Dimensionner et Superposer une Suite de Papeterie de Mariage",
      "description": "Guide technique pour assortir cartons, enveloppes, contrecollés et cartons réponses avec 3 mm de fond perdu.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Choisir le Format de l'Enveloppe Principale",
          "text": "L'enveloppe A7 (133 × 184 mm) ou l'enveloppe C5 européenne (162 × 229 mm) constituent les standards pour accueillir vos cartons d'invitation avec une marge de glissement de 3 à 5 mm."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Dimensionner le Carton de Fond et le Carton Découpé",
          "text": "Pour un effet superposé (matting), prévoyez un carton de fond de 127 × 178 mm et réduisez le carton imprimé de 3 mm sur chaque bord (121 × 172 mm)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Dimensionner le Carton Réponse et l'Enveloppe RSVP",
          "text": "Créez le carton RSVP au format 90 × 127 mm pour qu'il s'insère parfaitement dans une enveloppe réponse C6 (114 × 162 mm) ou A2."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Ajouter 3 mm de Fond Perdu (Bleed) à 300 DPI",
          "text": "Ajoutez systématiquement 3 mm de fond perdu sur Canva, Photoshop ou Illustrator pour éviter tout liseré blanc lors de la découpe au massicot."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle est la taille standard d'un faire-part de mariage en France ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En France et en Europe, les formats les plus répandus sont le 13 × 18 cm (format A7 international), le format A5 (14,8 × 21 cm) inséré dans une enveloppe C5, le format carré 15 × 15 cm et le format long 10 × 21 cm (enveloppe DL)."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle taille d'enveloppe pour un faire-part 13 × 18 cm ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un carton de 12,7 × 17,8 cm (5×7 pouces) se glisse dans une enveloppe A7 (13,3 × 18,4 cm) ou une enveloppe B6 / 14 × 19 cm pour laisser 3 mm de jeu à l'insertion."
          }
        },
        {
          "@type": "Question",
          "name": "Quelles dimensions en pixels pour Canva à 300 DPI ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour un faire-part 13 × 18 cm (5×7 pouces) à 300 DPI avec 3 mm de fond perdu, réglez votre projet Canva à 1575 × 2175 pixels (ou 1500 × 2100 pixels sans fond perdu)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Guide des Formats de Faire-Part & Enveloppes de Mariage (Canva 300 DPI) | Manage.Wedding"
	description="Calculez les dimensions exactes, fonds perdus d'impression (300 DPI), formats d'enveloppes (A7, C5, C6, DL, Carré) et marges de coupe pour vos faire-part de mariage."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Formats de Faire-Part & Enveloppes" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Specs d'Impression 300 DPI & Découpe</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Formats de Faire-Part <span class="accent-italic">& Dimensions d'Enveloppes</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Assurez-vous que vos cartons d'invitation, contrecollés, cartons réponses RSVP et cartons détails s'insèrent dans leurs enveloppes avec une précision millimétrique et des repères d'impression à 300 DPI.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Suite Format Selector & Units -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Format de Papeterie & Unités
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Qualité 300 DPI
					</span>
				</div>

				<!-- Suite Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="suite-format-preset">Format Standard de Faire-Part</label>
					<select id="suite-format-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="a7-standard" selected>💌 Standard A7 / 13×18 cm (Enveloppe 133×184 / Carton 127×178 / RSVP 90×127 mm)</option>
						<option value="a7-layered">👑 A7 Superposé avec Contrecollé (Fond 13×18 cm / Carton découpé 3 mm)</option>
						<option value="square-6">🔲 Format Carré Moderne 15×15 cm (Enveloppe 165×165 / Carton 150×150 mm)</option>
						<option value="tea-length">🥂 Format Long Élancé 10×21 cm (Enveloppe DL 110×220 / Carton 98×210 mm)</option>
						<option value="uk-metric">🇫🇷 Format Européen A5/C5 (Enveloppe C5 162×229 / Carton A5 148×210 mm)</option>
						<option value="a8-luxe">🏰 Format Prestige 14×20 cm (Enveloppe 140×206 / Carton 133×197 mm)</option>
					</select>
				</div>

				<!-- Measurement Unit Selector -->
				<div class="form-group">
					<label class="form-label" for="unit-selector">Unité d'Affichage des Dimensions</label>
					<select id="unit-selector" class="form-input" style="cursor: pointer; font-weight: 600;">
						<option value="mm" selected>Millimètres (ex. 127 × 178 mm)</option>
						<option value="in">Pouces / Inches (ex. 5.00" × 7.00")</option>
						<option value="px">Pixels @ 300 DPI pour Canva & Photoshop (ex. 1500 × 2100 px)</option>
					</select>
				</div>

				<!-- Backer Mat Border Width -->
				<div class="form-group">
					<label class="form-label" for="border-reveal">Largeur du Liseré de Fond (Contrecollé)</label>
					<select id="border-reveal" class="form-input" style="cursor: pointer;">
						<option value="0.125" selected>3 mm (1/8 pouce) — Liseré Délicat Standard</option>
						<option value="0.25">6 mm (1/4 pouce) — Cadre Épais Marqué</option>
						<option value="0">Aucun Contrecollé (Carton Simple)</option>
					</select>
				</div>

				<!-- Additional Components (Checkboxes) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Éléments Inclus dans la Suite
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-details" checked style="width: 18px; height: 18px;" />
							<span>Carton Détails / Programme & Hébergements</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-rsvp" checked style="width: 18px; height: 18px;" />
							<span>Carton Réponse RSVP & Enveloppe Retour</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-bellyband" checked style="width: 18px; height: 18px;" />
							<span>Bandeau Papier / Calque Vellum de Maintien</span>
						</label>
					</div>
				</div>

			</div>

			<!-- Right Column: Interactive Layering Canvas & Spec Sheet -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Spec Sheet Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Fiche Technique de Découpe & Impression
						</span>
						<span id="format-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							Standard A7 / 13×18 cm
						</span>
					</div>

					<h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Dimensions Couche par Couche
					</h3>

					<!-- Itemized Dimension Specs Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						
						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>1. Enveloppe Principale d'Expédition :</strong></span>
							<strong id="spec-outer-envelope" style="color: var(--accent-blue);">133 × 184 mm (A7)</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>2. Carton de Fond (Contrecollé) :</strong></span>
							<strong id="spec-backer-card">127 × 178 mm</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>3. Faire-Part Imprimé Principal :</strong></span>
							<strong id="spec-main-card" style="color: var(--accent-red);">121 × 172 mm</strong>
						</div>

						<div id="row-details" style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>4. Carton Détails & Programme :</strong></span>
							<strong id="spec-details-card">108 × 140 mm (A2)</strong>
						</div>

						<div id="row-rsvp" style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>5. Carton RSVP + Enveloppe Retour :</strong></span>
							<strong id="spec-rsvp-card">Carton : 89×127 mm | Env : 111×146 mm</strong>
						</div>

						<div id="row-belly" style="display: flex; justify-content: space-between; padding: 0.4rem 0; font-size: 0.92rem;">
							<span><strong>6. Bandeau Papier / Vellum :</strong></span>
							<strong id="spec-bellyband">45 × 292 mm</strong>
						</div>

					</div>

					<!-- Print Bleed Spec Box -->
					<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem; font-size: 0.88rem; color: var(--fg-pencil); line-height: 1.5;">
						<strong>📐 Fond Perdu Professionnel (Bleed) :</strong><br />
						Ajoutez systématiquement <strong style="color: var(--accent-red);">+3 mm (+38 px @ 300 DPI)</strong> sur les 4 côtés de votre fichier graphique avant de l'exporter en PDF pour éviter tout liseré blanc lors de la coupe au massicot !
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-specs" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimer la Fiche (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Word (.doc)
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Tableau des Correspondances</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Guide Rapide : Formats de Cartons, Enveloppes & Dimensions Canva 300 DPI
				</h2>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 Règle Universelle du Jeu d'Insertion (3 à 5 mm) :
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Taille d'Enveloppe = [Carton + 5 à 6 mm en largeur et hauteur] • Un carton 127 × 178 mm requiert une enveloppe 133 × 184 mm • Un carton A5 (148 × 210 mm) requiert une enveloppe C5 (162 × 229 mm).
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Format</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Dimensions Carton</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Enveloppe Associée</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Canva 300 DPI</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Standard A7 / 13×18 cm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">127 × 178 mm (5×7")</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">A7 (133 × 184 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1500 × 2100 px</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Européen A5 / C5</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">148 × 210 mm (A5)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">C5 (162 × 229 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1748 × 2480 px</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Carré Moderne</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">150 × 150 mm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Carré (165 × 165 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1772 × 1772 px</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Format Long / DL</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">98 × 210 mm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">DL (110 × 220 mm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">1157 × 2480 px</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guide Technique de Papeterie & Impression de Faire-Part
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Tout savoir sur le grammage papier (g/m²), les marges de coupe et l'ordre d'assemblage dans l'enveloppe.
				</p>
			</div>

			<!-- Section 1: Paper Weights Explained -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Choisir le Bon Grammage Papier (g/m²)
				</h3>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>300 à 350 g/m² (Papier Bristol / Couché Mat) :</strong> Le standard des faire-part élégants. Rigide, agréable en main et compatible avec la plupart des imprimantes jet d'encre haut de gamme.</li>
					<li><strong>500 à 600 g/m² (Papier Coton / Double Épaisseur) :</strong> Papier de luxe épais. Recommandé pour le gaufrage, la dorure à chaud (hot foil) et le letterpress.</li>
					<li><strong>120 à 140 g/m² :</strong> Grammage réservé aux enveloppes extérieures et aux doublures intérieures d'enveloppes (liners).</li>
				</ul>
			</section>

			<!-- Section 2: Assembly Order -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Ordre d'Assemblage Traditionnel dans l'Enveloppe
				</h3>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>📦 Ordre d'Empilement (Du bas vers le haut) :</strong><br />
					1. <strong>Faire-Part Principal</strong> (Face visible au fond)<br />
					2. <strong>Carton Programme / Détails</strong> (Face visible sur le faire-part)<br />
					3. <strong>Enveloppe Retour RSVP</strong> (Rabat vers le bas)<br />
					4. <strong>Carton Réponse RSVP</strong> (Glissé sous le rabat de l'enveloppe retour)<br />
					5. <strong>Bandeau Papier / Ruban</strong> (Ensérant l'ensemble des cartons)<br />
					6. <strong>Insertion dans l'Enveloppe Principale</strong> orienté de façon à ce que le texte soit immédiatement lisible dès l'ouverture !
				</div>
			</section>

		</article>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/fr/wedding-invitation-suite-sizer" category="stationery" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const formatSelect = document.getElementById('suite-format-preset');
		const unitSelect = document.getElementById('unit-selector');
		const borderRevealSelect = document.getElementById('border-reveal');

		const layerDetailsCheck = document.getElementById('layer-details');
		const layerRsvpCheck = document.getElementById('layer-rsvp');
		const layerBellyCheck = document.getElementById('layer-bellyband');

		const formatBadge = document.getElementById('format-badge');
		const specOuter = document.getElementById('spec-outer-envelope');
		const specBacker = document.getElementById('spec-backer-card');
		const specMain = document.getElementById('spec-main-card');
		const specDetails = document.getElementById('spec-details-card');
		const specRsvp = document.getElementById('spec-rsvp-card');
		const specBelly = document.getElementById('spec-bellyband');

		const rowDetails = document.getElementById('row-details');
		const rowRsvp = document.getElementById('row-rsvp');
		const rowBelly = document.getElementById('row-belly');

		const btnPrint = document.getElementById('btn-print-specs');
		const btnDoc = document.getElementById('btn-export-doc');

		function formatDim(w, h, unit) {
			if (unit === 'in') {
				return `${w.toFixed(2)}" × ${h.toFixed(2)}"`;
			} else if (unit === 'mm') {
				const wMm = Math.round(w * 25.4);
				const hMm = Math.round(h * 25.4);
				return `${wMm} × ${hMm} mm`;
			} else if (unit === 'px') {
				const wPx = Math.round(w * 300);
				const hPx = Math.round(h * 300);
				return `${wPx} × ${hPx} px`;
			}
		}

		function updateSuiteDimensions() {
			const fmt = formatSelect.value;
			const unit = unitSelect.value;
			const border = parseFloat(borderRevealSelect.value) || 0;

			let outerW = 5.25, outerH = 7.25, outerName = 'A7';
			let backerW = 5.00, backerH = 7.00;
			let mainW = 5.00, mainH = 7.00;
			let detailsW = 4.25, detailsH = 5.50;
			let rsvpCardW = 3.50, rsvpCardH = 5.00, rsvpEnvW = 4.375, rsvpEnvH = 5.75;
			let bellyW = 1.75, bellyL = 11.50;

			if (fmt === 'a7-standard') {
				formatBadge.textContent = 'Standard A7 / 13×18 cm';
				outerW = 5.25; outerH = 7.25; outerName = 'A7 (133×184 mm)';
				backerW = 5.00; backerH = 7.00;
				mainW = 5.00 - (border * 2); mainH = 7.00 - (border * 2);
				detailsW = 4.25; detailsH = 5.50;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 1.75; bellyL = 11.50;
			} else if (fmt === 'a7-layered') {
				formatBadge.textContent = 'A7 Superposé avec Contrecollé';
				outerW = 5.25; outerH = 7.25; outerName = 'A7 (133×184 mm)';
				backerW = 5.00; backerH = 7.00;
				mainW = 4.75; mainH = 6.75;
				detailsW = 4.00; detailsH = 5.25;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 1.75; bellyL = 11.50;
			} else if (fmt === 'square-6') {
				formatBadge.textContent = 'Carré Moderne 15×15 cm';
				outerW = 6.50; outerH = 6.50; outerName = 'Carré (165×165 mm)';
				backerW = 6.00; backerH = 6.00;
				mainW = 6.00 - (border * 2); mainH = 6.00 - (border * 2);
				detailsW = 4.50; detailsH = 4.50;
				rsvpCardW = 4.00; rsvpCardH = 4.00; rsvpEnvW = 4.50; rsvpEnvH = 4.50;
				bellyW = 1.75; bellyL = 13.50;
			} else if (fmt === 'tea-length') {
				formatBadge.textContent = 'Format Long Élancé / DL 10×21 cm';
				outerW = 4.125; outerH = 9.50; outerName = 'DL (110×220 mm)';
				backerW = 3.875; backerH = 9.25;
				mainW = 3.875 - (border * 2); mainH = 9.25 - (border * 2);
				detailsW = 3.50; detailsH = 6.00;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 1.75; bellyL = 9.25;
			} else if (fmt === 'uk-metric') {
				formatBadge.textContent = 'Européen A5 / C5';
				outerW = 6.38; outerH = 9.02; outerName = 'C5 (162×229 mm)';
				backerW = 5.83; backerH = 8.27;
				mainW = 5.83 - (border * 2); mainH = 8.27 - (border * 2);
				detailsW = 4.13; detailsH = 5.83;
				rsvpCardW = 4.13; rsvpCardH = 5.83; rsvpEnvW = 4.49; rsvpEnvH = 6.38;
				bellyW = 1.75; bellyL = 13.00;
			} else if (fmt === 'a8-luxe') {
				formatBadge.textContent = 'Prestige 14×20 cm';
				outerW = 5.50; outerH = 8.125; outerName = '140×206 mm';
				backerW = 5.25; backerH = 7.75;
				mainW = 5.25 - (border * 2); mainH = 7.75 - (border * 2);
				detailsW = 4.25; detailsH = 6.00;
				rsvpCardW = 3.50; rsvpCardH = 5.00; rsvpEnvW = 4.375; rsvpEnvH = 5.75;
				bellyW = 2.00; bellyL = 12.00;
			}

			specOuter.textContent = `${formatDim(outerW, outerH, unit)} (${outerName})`;
			specBacker.textContent = border > 0 ? formatDim(backerW, backerH, unit) : 'N/A (Carton simple)';
			specMain.textContent = formatDim(mainW, mainH, unit);
			specDetails.textContent = formatDim(detailsW, detailsH, unit);
			specRsvp.textContent = `Carton : ${formatDim(rsvpCardW, rsvpCardH, unit)} | Env : ${formatDim(rsvpEnvW, rsvpEnvH, unit)}`;
			specBelly.textContent = formatDim(bellyW, bellyL, unit);

			rowDetails.style.display = layerDetailsCheck.checked ? 'flex' : 'none';
			rowRsvp.style.display = layerRsvpCheck.checked ? 'flex' : 'none';
			rowBelly.style.display = layerBellyCheck.checked ? 'flex' : 'none';
		}

		[formatSelect, unitSelect, borderRevealSelect, layerDetailsCheck, layerRsvpCheck, layerBellyCheck].forEach(elem => {
			elem.addEventListener('change', updateSuiteDimensions);
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Fiche Technique Découpe Faire-Part — Manage.Wedding</title>
					<style>
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; padding: 20px; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Fiche Technique Papeterie de Mariage</h1>
					<p>Format : ${formatBadge.textContent} | Unité : ${unitSelect.options[unitSelect.selectedIndex].text}</p>
					
					<table>
						<thead><tr><th>Composant Papeterie</th><th>Dimensions Finies Découpées</th><th>Rôle</th></tr></thead>
						<tbody>
							<tr><td><strong>Enveloppe Principale</strong></td><td>${specOuter.textContent}</td><td>Expédition</td></tr>
							<tr><td><strong>Carton de Fond (Contrecollé)</strong></td><td>${specBacker.textContent}</td><td>Support Rigide</td></tr>
							<tr><td><strong>Faire-Part Principal</strong></td><td><strong>${specMain.textContent}</strong></td><td>+3 mm Fond Perdu Requis</td></tr>
							<tr><td><strong>Carton Détails & Programme</strong></td><td>${specDetails.textContent}</td><td>Encart</td></tr>
							<tr><td><strong>Carton Réponse RSVP</strong></td><td>${specRsvp.textContent}</td><td>Retour</td></tr>
							<tr><td><strong>Bandeau Vellum / Papier</strong></td><td>${specBelly.textContent}</td><td>Maintien</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Dimensions Faire-Part</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Fiche Technique Dimensions Papeterie</h2>
					<p>Format : ${formatBadge.textContent}</p>
					<table>
						<thead><tr><th>Composant</th><th>Dimensions</th></tr></thead>
						<tbody>
							<tr><td>Enveloppe Principale</td><td>${specOuter.textContent}</td></tr>
							<tr><td>Carton de Fond</td><td>${specBacker.textContent}</td></tr>
							<tr><td>Faire-Part Principal</td><td>${specMain.textContent}</td></tr>
							<tr><td>Carton Détails</td><td>${specDetails.textContent}</td></tr>
							<tr><td>Suite RSVP</td><td>${specRsvp.textContent}</td></tr>
							<tr><td>Bandeau</td><td>${specBelly.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'dimensions-faire-part-mariage.doc';
			link.click();
		});

		updateSuiteDimensions();
	</script>
</Layout>
