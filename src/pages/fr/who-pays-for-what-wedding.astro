---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/who-pays-for-what-wedding/#webapp",
      "name": "Qui Paie Quoi au Mariage ? Simulateur de Répartition des Frais",
      "url": "https://manage.wedding/fr/who-pays-for-what-wedding",
      "description": "Simulateur gratuit de répartition des dépenses de mariage. Comparez la tradition historique et la répartition moderne équitable entre familles et mariés. Export d'accord financier imprimable.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Répartir les Dépenses d'un Mariage Entre les Familles et les Mariés",
      "description": "Guide d'étiquette pour distribuer sereinement les postes budgétaires entre le couple et leurs parents respectifs.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Fixer le Budget Global Estimé",
          "text": "Déterminez le montant prévisionnel total (ex. 20 000 € ou 30 000 €) selon vos envies de réception."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Choisir le Modèle de Contribution",
          "text": "Optez pour la tradition (famille de la mariée finance le repas/la robe, famille du marié le vin d'honneur/voyage), l'auto-financement à 100% par le couple ou la règle moderne des 3 tiers."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Attribuer les Postes de Dépense Spécifiques",
          "text": "Clarifiez la prise en charge de chaque poste majeur : Domaine, Traiteur, Tenues, Photographe, Fleurs et Alliances."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Convenir des Modalités de Paiement",
          "text": "Privilégiez un don forfaitaire sur un compte dédié mariage pour éviter les désaccords lors des règlements d'acomptes."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qui paie traditionnellement quoi lors d'un mariage en France ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dans la tradition française : la famille de la mariée prenait en charge la robe de mariée, la location du lieu, le traiteur, les faire-part et les fleurs. La famille du marié finançait le costume, les alliances, le bouquet de la mariée, le repas de la veille et le voyage de noces."
          }
        },
        {
          "@type": "Question",
          "name": "Comment les couples financent-ils leur mariage aujourd'hui ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aujourd'hui, plus de 70% des couples financent la majorité de leur mariage eux-mêmes grâce à leur épargne. Lorsque les parents participent, la formule moderne la plus courante est un don forfaitaire d'un montant équivalent de part et d'autre."
          }
        },
        {
          "@type": "Question",
          "name": "Qui paie les tenues des témoins et demoiselles d'honneur ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En règle générale, les témoins et demoiselles d'honneur achètent ou louent leur propre tenue, tandis que les mariés leur offrent les boutonnières, les petits bouquets assortis et une attention personnalisée en remerciement."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Qui Paie Quoi au Mariage ? Simulateur de Répartition (Traditionnel vs Moderne)"
	description="Simulateur gratuit de répartition des frais de mariage. Comparez la tradition historique et la répartition moderne équitable entre familles et mariés."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Qui Paie Quoi ? Répartition" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Tradition vs Répartition Moderne</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Qui Paie Quoi au Mariage ? <span class="accent-italic">Simulateur de Répartition</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Comparez la tradition avec les modes de financement contemporains. Répartissez les postes de dépenses entre les mariés et leurs familles et exportez un récapitulatif clair en 1 clic.
			</p>
		</header>

		<!-- Main Interactive Splitter Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Split Model Setup & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Modèle de Financement
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Règles d'Étiquette
					</span>
				</div>

				<!-- Total Budget -->
				<div class="form-group">
					<label class="form-label" for="total-wedding-budget">Budget Total Estimé du Mariage (€)</label>
					<input type="number" id="total-wedding-budget" class="form-input" value="20000" min="2000" step="1000" style="font-size: 1.2rem; font-weight: 700;" />
				</div>

				<!-- Split Model Shortcut Selector -->
				<div class="form-group">
					<label class="form-label" for="split-model-preset">Modèle Prédéfini</label>
					<select id="split-model-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="traditional" selected>📜 Traditionnel Historique (Famille Mariée 60% / Famille Marié 30% / Couple 10%)</option>
						<option value="modern-3way">🤝 Moderne : Règle des 3 Tiers (Couple 40% / Famille 1 30% / Famille 2 30%)</option>
						<option value="couple-100">💍 Auto-Financement 100% par le Couple (Indépendance Totale)</option>
						<option value="couple-50-50">⚖️ Partage 50/50 Égalitaire Entre les Deux Mariés</option>
						<option value="custom">✏️ Répartition Personnalisée par Curseur</option>
					</select>
				</div>

				<!-- Visual Split Percentages Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Pourcentage de Contribution (%)
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.85rem;">
						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-red);">👰 Part Famille de la Mariée :</span>
								<span id="slider-bride-pct-val">60%</span>
							</div>
							<input type="range" id="slider-bride-pct" min="0" max="100" value="60" style="width: 100%; accent-color: var(--accent-red);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-blue);">🤵 Part Famille du Marié :</span>
								<span id="slider-groom-pct-val">30%</span>
							</div>
							<input type="range" id="slider-groom-pct" min="0" max="100" value="30" style="width: 100%; accent-color: var(--accent-blue);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: #16a34a;">💍 Part Personnelle du Couple :</span>
								<span id="slider-couple-pct-val">10%</span>
							</div>
							<input type="range" id="slider-couple-pct" min="0" max="100" value="10" style="width: 100%; accent-color: #16a34a;" />
						</div>
					</div>
				</div>

				<!-- Quick Money Talk Guide -->
				<div style="margin-top: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
					<strong style="display: block; color: var(--fg-pencil); margin-bottom: 4px;">💬 Comment aborder le sujet avec ses parents :</strong>
					« Nous commençons à construire le budget de notre mariage ! Nous voulions savoir si vous souhaitiez contribuer à un élément précis (comme le vin d'honneur ou les fleurs), ou si vous préférez que nous organisions tout par nous-mêmes. »
				</div>

			</div>

			<!-- Right Column: Results Breakdown & Itemized Checklist -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Contribution Summary Cards -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Répartition Financière Résultante
					</h3>

					<!-- 3 Contribution Summary Bars -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem; text-align: center;">
						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-red);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Famille Mariée</span>
							<strong id="card-bride-amount" style="font-size: 1.2rem; color: var(--accent-red); display: block; margin-top: 2px;">12 000 €</strong>
							<span id="card-bride-pct" style="font-size: 0.75rem; color: #64748b;">(60%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-blue);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Famille Marié</span>
							<strong id="card-groom-amount" style="font-size: 1.2rem; color: var(--accent-blue); display: block; margin-top: 2px;">6 000 €</strong>
							<span id="card-groom-pct" style="font-size: 0.75rem; color: #64748b;">(30%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid #16a34a;">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Le Couple</span>
							<strong id="card-couple-amount" style="font-size: 1.2rem; color: #16a34a; display: block; margin-top: 2px;">2 000 €</strong>
							<span id="card-couple-pct" style="font-size: 0.75rem; color: #64748b;">(10%)</span>
						</div>
					</div>

					<!-- Itemized Traditional Responsibilities Table -->
					<div style="max-height: 280px; overflow-y: auto; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; margin-bottom: 1.5rem;">
						<table style="width: 100%; border-collapse: collapse; font-size: 0.86rem; text-align: left;">
							<thead>
								<tr style="background: var(--muted-paper); border-bottom: 1.5px solid var(--fg-pencil);">
									<th style="padding: 6px 8px;">Poste de Dépense</th>
									<th style="padding: 6px 8px; text-align: right;">Payeur Traditionnel</th>
								</tr>
							</thead>
							<tbody>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Lieu de Réception & Domaine</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Famille Mariée</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Traiteur, Repas & Gâteau</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Famille Mariée</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Robe de Mariée & Voile</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Famille Mariée</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Photographe & Vidéaste</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Famille Mariée</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Faire-part & Papeterie</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Famille Mariée</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Repas de la Veille / Répétition</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Famille Marié</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Voyage de Noces (Billets/Hôtel)</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Famille Marié</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Alliances & Frais Célébration</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Famille Marié</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Bouquet Mariée & Boutonnières</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Famille Marié</td></tr>
								<tr><td>Cadeaux Témoins & Imprévus</td><td style="text-align: right; font-weight: bold; color: #16a34a;">Le Couple</td></tr>
							</tbody>
						</table>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-agreement" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimer Répartition (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Fiche Word
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Repères d'Étiquette</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Grille Comparative : Modèles Historiques vs Pratiques Actuelles
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Voici la comparaison des modèles de prise en charge financière pour les mariages contemporains.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Modèle de Paiement</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Famille de la Mariée</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Famille du Marié</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Part du Couple</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Traditionnel Historique</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">60% à 70% (Lieu, Traiteur, Robe)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">25% à 30% (Voyage, Vin d'honneur)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">5% à 10% (Alliances, Cadeaux)</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Règle des 3 Tiers (Moderne)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">30% (Don Forfaitaire)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">30% (Don Forfaitaire)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">40% (Épargne Personnelle)</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Auto-Financement (100%)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">0 € (Invités d'honneur)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">0 € (Invités d'honneur)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">100% Liberté Totale de Choix</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guide Pratique de Financement Familial d'un Mariage
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Discuter d'argent avec ses proches demande clarté, tact et bienveillance pour préserver l'harmonie des deux familles.
				</p>
			</div>

			<!-- Section 1: Evolution -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. L'Évolution des Coutumes Familiales
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					À l'origine issue des anciennes dots, la tradition voulait que les parents de la mariée prennent en charge l'essentiel de la noce. Aujourd'hui, les futurs mariés s'installent plus tard dans la vie et assument une grande part des frais pour garder le contrôle total de leurs décisions :
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Le Nombre d'Invités :</strong> Lorsque les familles contribuent financièrement, il est d'usage de leur allouer un quota d'invitations proportionnel à leur participation.</li>
					<li><strong>Don Global vs Paiement de Factures :</strong> Pour éviter les discussions sur les choix esthétiques (photographe, DJ, fleurs), il est souvent préférable de recevoir un montant forfaitaire global sur un compte dédié mariage.</li>
				</ul>
			</section>

			<!-- Section 2: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Foire Aux Questions
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Qui paie traditionnellement la robe de mariée ?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Traditionnellement, la mariée et ses parents financent la robe, le voile, les chaussures et les retouches d'essayage.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Que prend en charge la famille du marié ?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Historiquement, la famille du marié prenait en charge le repas de la veille, le voyage de noces, les alliances et le bouquet de fleurs de la mariée.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Comment gérer les frais pour un remariage ?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Pour une seconde union, l'étiquette universelle veut que le couple prenne en charge 100% des dépenses sans solliciter leurs parents.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/fr/who-pays-for-what-wedding" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const totalBudgetInput = document.getElementById('total-wedding-budget');
		const presetSelect = document.getElementById('split-model-preset');

		const sliderBride = document.getElementById('slider-bride-pct');
		const sliderGroom = document.getElementById('slider-groom-pct');
		const sliderCouple = document.getElementById('slider-couple-pct');

		const bridePctVal = document.getElementById('slider-bride-pct-val');
		const groomPctVal = document.getElementById('slider-groom-pct-val');
		const couplePctVal = document.getElementById('slider-couple-pct-val');

		const cardBrideAmount = document.getElementById('card-bride-amount');
		const cardBridePct = document.getElementById('card-bride-pct');
		const cardGroomAmount = document.getElementById('card-groom-amount');
		const cardGroomPct = document.getElementById('card-groom-pct');
		const cardCoupleAmount = document.getElementById('card-couple-amount');
		const cardCouplePct = document.getElementById('card-couple-pct');

		const btnPrint = document.getElementById('btn-print-agreement');
		const btnDoc = document.getElementById('btn-export-doc');

		function formatCurrency(val) {
			return `${Math.round(val).toLocaleString('fr-FR')} €`;
		}

		function calculateSplits() {
			const total = parseFloat(totalBudgetInput.value) || 0;
			const bPct = parseInt(sliderBride.value, 10);
			const gPct = parseInt(sliderGroom.value, 10);
			const cPct = parseInt(sliderCouple.value, 10);

			bridePctVal.textContent = `${bPct}%`;
			groomPctVal.textContent = `${gPct}%`;
			couplePctVal.textContent = `${cPct}%`;

			const bAmount = (total * bPct) / 100;
			const gAmount = (total * gPct) / 100;
			const cAmount = (total * cPct) / 100;

			cardBrideAmount.textContent = formatCurrency(bAmount);
			cardBridePct.textContent = `(${bPct}%)`;
			cardGroomAmount.textContent = formatCurrency(gAmount);
			cardGroomPct.textContent = `(${gPct}%)`;
			cardCoupleAmount.textContent = formatCurrency(cAmount);
			cardCouplePct.textContent = `(${cPct}%)`;
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'traditional') {
				sliderBride.value = 60;
				sliderGroom.value = 30;
				sliderCouple.value = 10;
			} else if (p === 'modern-3way') {
				sliderBride.value = 30;
				sliderGroom.value = 30;
				sliderCouple.value = 40;
			} else if (p === 'couple-100') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			} else if (p === 'couple-50-50') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			}
			calculateSplits();
		});

		// Slider Listeners with Normalization
		sliderBride.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderBride.value, 10);
			sliderGroom.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderGroom.value;
			calculateSplits();
		});
		sliderGroom.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderGroom.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderBride.value;
			calculateSplits();
		});
		sliderCouple.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderCouple.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderGroom.value = rem - sliderBride.value;
			calculateSplits();
		});

		totalBudgetInput.addEventListener('input', calculateSplits);

		// Print Agreement Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Accord de Répartition des Dépenses — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Répartition Financière des Dépenses de Mariage</h1>
					<p>Budget Prévisionnel Total : ${formatCurrency(parseFloat(totalBudgetInput.value))} | Modèle : ${presetSelect.options[presetSelect.selectedIndex].text}</p>
					
					<table>
						<thead><tr><th>Partie Prenante</th><th>Part (%)</th><th>Montant Alloué (€)</th><th>Postes Historiquement Associés</th></tr></thead>
						<tbody>
							<tr><td><strong>Famille de la Mariée</strong></td><td>${sliderBride.value}%</td><td><strong>${cardBrideAmount.textContent}</strong></td><td>Lieu de Réception, Traiteur, Robe de Mariée, Papeterie</td></tr>
							<tr><td><strong>Famille du Marié</strong></td><td>${sliderGroom.value}%</td><td><strong>${cardGroomAmount.textContent}</strong></td><td>Repas de Répétition, Voyage de Noces, Alliances, Bouquet</td></tr>
							<tr><td><strong>Le Couple</strong></td><td>${sliderCouple.value}%</td><td><strong>${cardCoupleAmount.textContent}</strong></td><td>Cadeaux Témoins, Tenues Personnelles, Solde Restant</td></tr>
							<tr class="total-row"><td>TOTAL BUDGET</td><td>100%</td><td>${formatCurrency(parseFloat(totalBudgetInput.value))}</td><td>Plan de Financement Global</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Répartition des Frais de Mariage</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Répartition des Dépenses de Mariage</h2>
					<p>Budget Total : ${formatCurrency(parseFloat(totalBudgetInput.value))}</p>
					<table>
						<thead><tr><th>Contributeur</th><th>Part (%)</th><th>Montant (€)</th></tr></thead>
						<tbody>
							<tr><td>Famille de la Mariée</td><td>${sliderBride.value}%</td><td>${cardBrideAmount.textContent}</td></tr>
							<tr><td>Famille du Marié</td><td>${sliderGroom.value}%</td><td>${cardGroomAmount.textContent}</td></tr>
							<tr><td>Le Couple</td><td>${sliderCouple.value}%</td><td>${cardCoupleAmount.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL</td><td>100%</td><td>${formatCurrency(parseFloat(totalBudgetInput.value))}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'repartition-frais-mariage.doc';
			link.click();
		});

		// Initial Calculation
		calculateSplits();
	</script>
</Layout>
