---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/anniversary-gift-finder/#webapp",
      "name": "Guide des Cadeaux d'Anniversaire de Mariage par Année",
      "url": "https://manage.wedding/fr/anniversary-gift-finder",
      "description": "Trouvez le cadeau d'anniversaire de mariage parfait selon la matière traditionnelle et moderne pour chaque année (Noces de Coton, Cuir, Bois, Étain, Argent, Or). Idées cadeaux personnalisées, expériences et textes de vœux.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelles sont les noces traditionnelles d'anniversaire de mariage par année ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La tradition associe chaque année de mariage à une matière : 1 an (Coton), 2 ans (Cuir), 3 ans (Froment), 4 ans (Cire), 5 ans (Bois), 10 ans (Étain), 15 ans (Cristal), 20 ans (Porcelaine), 25 ans (Argent), 30 ans (Perle), 40 ans (Émeraude), 50 ans (Or) et 60 ans (Diamant)."
          }
        },
        {
          "@type": "Question",
          "name": "Comment le calculateur détermine-t-il les années de noces ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En renseignant votre date de mariage exacte, l'outil calcule automatiquement le nombre d'années écoulées et vous suggère les noces à célébrer pour votre prochain anniversaire."
          }
        },
        {
          "@type": "Question",
          "name": "Quel est le meilleur cadeau pour 1 an de mariage (Noces de Coton) ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour la 1ère année, les cadeaux les plus appréciés sont des peignoirs en coton égyptien brodés à vos initiales, du beau linge de lit en satin de coton, une impression sur toile de vos vœux de mariage ou un weekend cocooning en amoureux."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Comment Choisir un Cadeau d'Anniversaire de Mariage Idéal",
      "description": "Méthode pas à pas pour trouver un cadeau personnalisé qui honore la matière symbolique de votre année de mariage.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Choisir l'Année ou Renseigner la Date",
          "text": "Sélectionnez votre nombre d'années de mariage (de 1 à 60 ans) ou entrez la date du jour J."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Découvrir la Matière Traditionnelle et Moderne",
          "text": "Consultez la symbolique de la matière officielle (Bois, Cuir, Argent, etc.) ainsi que la pierre précieuse et la fleur associées."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Filtrer par Budget et Personnalité",
          "text": "Sélectionnez le profil de votre conjoint(e) (Romantique, Gastronome, Baroudeur, Cocooning) pour voir les suggestions sur-mesure."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Télécharger la Fiche & Modèle de Carte",
          "text": "Exportez votre sélection en Word (.doc) ou PDF avec un texte de vœux touchant prêt à recopier."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Cadeaux Anniversaire de Mariage par Année (Noces & Idées) | Manage.Wedding"
	description="Trouvez le cadeau parfait pour vos noces de mariage (Coton, Cuir, Bois, Étain, Argent, Or). Suggestions par budget, symbolique et textes de vœux à imprimer."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Cadeaux d'Anniversaire de Mariage" category="stationery" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<span class="badge-postit">Noces & Guide des Matières</span>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Guide des Cadeaux <span class="accent-italic">d'Anniversaire de Mariage</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Découvrez les matières traditionnelles et modernes, les pierres précieuses et les fleurs symboliques pour chaque anniversaire de 1 à 60 ans de mariage !
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Trouver son Cadeau Idéal en 3 Étapes
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Choisir l'Année de Noces
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Sélectionnez votre jalon (1 an, 5 ans, 10 ans, 25 ans...) ou entrez votre date de mariage pour le calcul automatique.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Personnaliser selon les Goûts & Budget
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indiquez l'ambiance recherchée (Romantique, Escapade, Gastronomie, Cocooning) et votre fourchette de prix.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Consulter les Idées & Modèles de Vœux
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Accédez aux idées de cadeaux thématiques et exportez votre sélection en Word (.doc) ou PDF avec un texte de carte touchant.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Quiz Form + Themes & Curated Gift Stream -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: start; margin-bottom: 3.5rem;">
			
			<!-- Left Column: Questionnaire -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🎁 Sélecteur de Noces & Préférences
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Choisissez votre jalon d'anniversaire ou calculez par date
					</span>
				</div>

				<form id="gift-quiz-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- 1. Milestone Year Dropdown -->
					<div>
						<label for="select-anniversary-year" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--accent-red); margin-bottom: 0.25rem;">
							1. Choisir l'Année d'Anniversaire *
						</label>
						<select id="select-anniversary-year" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-heading); font-size: 1.05rem; background: #fff;">
							<option value="1" selected>1 an de mariage — Noces de Coton (Moderne : Horloge)</option>
							<option value="2">2 ans de mariage — Noces de Cuir (Moderne : Porcelaine)</option>
							<option value="3">3 ans de mariage — Noces de Froment (Moderne : Cristal)</option>
							<option value="4">4 ans de mariage — Noces de Cire (Moderne : Électroménager)</option>
							<option value="5">5 ans de mariage — Noces de Bois (Moderne : Argenterie)</option>
							<option value="6">6 ans de mariage — Noces de Chypre (Moderne : Objets sculptés)</option>
							<option value="7">7 ans de mariage — Noces de Laine (Moderne : Cuivre & Bureau)</option>
							<option value="8">8 ans de mariage — Noces de Coquelicot (Moderne : Linge fin)</option>
							<option value="9">9 ans de mariage — Noces de Faïence (Moderne : Maroquinerie)</option>
							<option value="10">10 ans de mariage — Noces d'Étain (Moderne : Diamant)</option>
							<option value="11">11 ans de mariage — Noces de Corail</option>
							<option value="12">12 ans de mariage — Noces de Soie</option>
							<option value="13">13 ans de mariage — Noces de Muguet</option>
							<option value="14">14 ans de mariage — Noces de Plomb</option>
							<option value="15">15 ans de mariage — Noces de Cristal (Moderne : Montres)</option>
							<option value="20">20 ans de mariage — Noces de Porcelaine (Moderne : Platine)</option>
							<option value="25">25 ans de mariage — Noces d'Argent (Jubilé d'Argent)</option>
							<option value="30">30 ans de mariage — Noces de Perle (Moderne : Diamant)</option>
							<option value="35">35 ans de mariage — Noces de Rubis</option>
							<option value="40">40 ans de mariage — Noces d'Émeraude</option>
							<option value="45">45 ans de mariage — Noces de Vermeil</option>
							<option value="50">50 ans de mariage — Noces d'Or (Jubilé d'Or)</option>
							<option value="55">55 ans de mariage — Noces d'Orchidée</option>
							<option value="60">60 ans de mariage — Noces de Diamant (Jubilé de Diamant)</option>
						</select>
					</div>

					<!-- Optional Date Calculator Accordion -->
					<details style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<summary style="font-size: 0.88rem; font-family: var(--font-heading); color: var(--accent-blue); cursor: pointer;">
							📅 Ou Calculer Automatiquement selon la Date du Mariage
						</summary>
						<div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.3rem;">
							<span style="font-size: 0.78rem; color: var(--text-secondary);">Indiquez la date de votre mariage :</span>
							<input type="date" id="input-wedding-date" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</details>

					<!-- 2. Partner's Personality Vibe -->
					<div>
						<label for="select-partner-vibe" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							2. Profil & Style de Cadeau Souhaité
						</label>
						<select id="select-partner-vibe" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="sentimental" selected>💖 Romantique & Souvenirs (Gravure, album photo, vœux)</option>
							<option value="experiences">✈️ Expériences & Escapades (Nuit insolite, spa en duo, voyage)</option>
							<option value="foodie">🍷 Gastronomie & Vins (Dégustation œnologique, dîner étoilé, panier gourmand)</option>
							<option value="practical">⚡ Moderne & Bijoux (Montre, maroquinerie, bijoux fins)</option>
							<option value="home">🏡 Cocooning & Maison (Linge haut de gamme, décoration, art de la table)</option>
						</select>
					</div>

					<!-- 3. Target Budget & Recipient -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="select-gift-budget" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								3. Budget Prévu
							</label>
							<select id="select-gift-budget" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="under50">Moins de 50 € (Attention délicate)</option>
								<option value="50to150" selected>50 € - 150 € (Bel équilibre)</option>
								<option value="150to300">150 € - 300 € (Cadeau premium)</option>
								<option value="300plus">300 € + (Grand jalon & Joaillerie)</option>
							</select>
						</div>

						<div>
							<label for="select-recipient" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								4. Destinataire
							</label>
							<select id="select-recipient" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="couple" selected>Pour le Couple (En duo)</option>
								<option value="her">Pour Elle (Épouse / Conjointe)</option>
								<option value="him">Pour Lui (Époux / Conjoint)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Themes & Curated Gift Stream -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Theme Overview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🎉 <span id="res-year-title">1 an de mariage — Noces de Coton</span>
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Symboles officiels traditionnels et contemporains
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Fiche PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Dual Themes Comparison Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
						<div style="background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-red); font-weight: bold; display: block;">
								Matière Traditionnelle
							</span>
							<strong id="theme-traditional-title" class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Coton
							</strong>
							<p id="theme-traditional-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Symbole de douceur, de confort et des premiers liens délicats tissés au quotidien.
							</p>
						</div>

						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-blue); font-weight: bold; display: block;">
								Thème Moderne
							</span>
							<strong id="theme-modern-title" class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Horloges
							</strong>
							<p id="theme-modern-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Représente le temps précieux partagé et chaque seconde gravée dans vos mémoires.
							</p>
						</div>
					</div>

					<!-- Gemstone & Flower Sub-Themes -->
					<div style="display: flex; justify-content: space-around; font-size: 0.85rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.5rem; margin-bottom: 1.25rem;">
						<span>💎 Pierre : <strong id="theme-gemstone">Nacre / Or</strong></span>
						<span>🌸 Fleur : <strong id="theme-flower">Œillet</strong></span>
					</div>

					<!-- 60-Year Milestone Progress Gauge -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.25rem;">
							<span>1 an (Coton)</span>
							<span>10 ans (Étain)</span>
							<span>25 ans (Argent)</span>
							<span>50 ans (Or)</span>
						</div>
						<div style="width: 100%; height: 16px; border: 1.5px solid var(--fg-pencil); border-radius: 8px; overflow: hidden; background: #eee;">
							<div id="gauge-milestone-bar" style="width: 5%; height: 100%; background: var(--accent-red); transition: width 0.4s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Curated Gift Recommendations Stream -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						🛍️ Idées Cadeaux & Expériences Recommandées
					</h3>
					<div id="curated-gifts-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<!-- Injected via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Guide Cadeaux Anniversaire de Mariage (Manage.Wedding)</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exporté le : <span id="print-date"></span> | Jalon : <span id="print-milestone"></span></p>
			</div>
			<div id="print-content-body"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Symbolique des Noces</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Guide Rapide : Évolution des Matières au Fil des Années
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>La Règle d'Or :</strong> Les matières traditionnelles progressent au même rythme que la solidité de votre engagement : des matières douces et souples du début (<strong>1 an Coton</strong>, <strong>2 ans Cuir</strong>), vers des éléments solides et pérennes (<strong>5 ans Bois</strong>, <strong>10 ans Étain</strong>) jusqu'aux métaux et joyaux précieux (<strong>25 ans Argent</strong>, <strong>50 ans Or</strong>, <strong>60 ans Diamant</strong>).
			</p>
			
			<!-- Benchmark Anniversary Milestones Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Année de Mariage</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Noces Traditionnelles</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Thème Moderne</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Pierre Symbolique</th>
