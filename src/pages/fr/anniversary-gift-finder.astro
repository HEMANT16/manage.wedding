				<div class="box">
					<h3>Symbolique de l'Année :</h3>
					<p>• Matière Traditionnelle : <strong>${mData.traditional}</strong> — ${mData.tDesc}</p>
					<p>• Thème Moderne : <strong>${mData.modern}</strong> — ${mData.mDesc}</p>
					<p>• Pierre Symbolique : <strong>${mData.gemstone}</strong></p>
					<p>• Fleur Associée : <strong>${mData.flower}</strong></p>
				</div>

				<div class="box">
					<h3>Idées Cadeaux Recommandées :</h3>
					<p>1. <strong>${mData.gift1.title}</strong> (${mData.gift1.price}) — ${mData.gift1.desc}</p>
					<p>2. <strong>${mData.gift2.title}</strong> (${mData.gift2.price}) — ${mData.gift2.desc}</p>
					<p>3. <strong>${mData.gift3.title}</strong> (${mData.gift3.price}) — ${mData.gift3.desc}</p>
				</div>

				<div class="box">
					<h3>Modèle de Texte pour votre Carte de Vœux :</h3>
					<p style="font-style:italic;">"Joyeux anniversaire de mariage mon amour ! Déjà ${yr} an${yr > 1 ? 's' : ''} que nous nous sommes dit oui. En regardant tout ce que nous avons construit ensemble, mon amour et mon admiration pour toi grandissent chaque jour. À toutes nos prochaines années de bonheur !"</p>
				</div>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `noces-mariage-${yr}-ans.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		document.getElementById('print-date').textContent = new Date().toLocaleDateString('fr-FR');
		document.getElementById('print-milestone').textContent = `${yr} an${yr > 1 ? 's' : ''} de mariage (Noces de ${mData.traditional})`;

		const body = document.getElementById('print-content-body');
		body.innerHTML = `
			<div style="border:1px solid #ccc; padding:15px; margin-bottom:15px;">
				<h2 style="margin:0 0 5px 0;">${yr} an${yr > 1 ? 's' : ''} : Noces de ${mData.traditional}</h2>
				<p style="margin:5px 0;"><strong>Pierre :</strong> ${mData.gemstone} | <strong>Fleur :</strong> ${mData.flower}</p>
				<p style="font-size:13px; color:#444;">${mData.tDesc}</p>
			</div>
			<div style="border:1px solid #ccc; padding:15px;">
				<h3 style="margin:0 0 8px 0;">Modèle de Message pour Carte :</h3>
				<p style="font-style:italic; font-size:13px; margin:0;">"Joyeux ${yr} an${yr > 1 ? 's' : ''} de mariage mon amour ! Merci d'être mon pilier, ma joie et ma plus belle aventure au quotidien. Vive nous deux !"</p>
			</div>
		`;

		window.print();
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		let csv = "Année,Matière Traditionnelle,Thème Moderne,Pierre,Fleur,Ambiance,Budget\n";
		csv += `"${yr}","${mData.traditional}","${mData.modern}","${mData.gemstone}","${mData.flower}","${vibeSelect.value}","${budgetSelect.value}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `noces-mariage-${yr}-ans.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	renderGifts();
</script>
