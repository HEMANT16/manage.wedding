---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contactez-Nous | Manage.Wedding",
  "url": "https://manage.wedding/fr/contact",
  "inLanguage": "fr",
  "description": "Contactez l'équipe de Manage.Wedding. Envoyez vos suggestions d'outils, demandes d'amélioration ou questions sur l'organisation de mariage à manage.weddingall@gmail.com."
};
---

<Layout 
	title="Contactez-Nous | Manage.Wedding — Écrivez-Nous"
	description="Contactez directement Manage.Wedding à manage.weddingall@gmail.com. Une idée de simulateur, un retour d'expérience ou une question d'organisation ?"
	schema={schema}
>
	<main style="max-width: 1050px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem); box-sizing: border-box;">
		
		<!-- Header -->
		<section class="section-paper" style="margin-bottom: 2.5rem; text-align: center; padding: 2.5rem 1rem;">
			<div class="tape" style="margin: 0 auto 1.25rem;"></div>
			<span class="badge-postit">À Votre Écoute</span>
			<h1 class="font-heading" style="font-size: clamp(34px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.2; text-align: center; margin: 0.75rem 0;">
				Contactez Manage.Wedding
			</h1>
			<p style="font-size: 1.2rem; color: var(--text-secondary); max-width: 680px; margin: 0.5rem auto 0; text-align: center; line-height: 1.6;">
				Une idée pour un nouvel outil, une remarque sur un simulateur ou une question d'organisation ? Envoyez-nous un message ci-dessous !
			</p>
		</section>

		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; margin-bottom: 4rem; align-items: start;">
			
			<!-- Direct Contact Form Card -->
			<div class="hand-card" style="padding: clamp(1.75rem, 3.5vw, 2.75rem); background: #fff;">
				<h2 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; text-align: center;">
					Envoyez-Nous un Message Direct
				</h2>
				<p style="font-size: 1.05rem; color: var(--text-secondary); margin-bottom: 1.75rem; text-align: center; line-height: 1.5;">
					Vos messages arrivent directement dans notre boîte e-mail à <strong style="color: var(--fg-pencil);">manage.weddingall@gmail.com</strong>.
				</p>

				<form id="contact-form" style="display: flex; flex-direction: column; gap: 1.35rem;">
					<!-- Hidden Honeypot Field for Spam Protection -->
					<input type="text" name="_honey" id="contact-honey" style="display: none;" tabindex="-1" autocomplete="off" />

					<div>
						<label for="contact-name" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Votre Nom / Prénoms des Mariés <span style="color: #dc2626;">*</span>
						</label>
						<input 
							type="text" 
							name="name"
							id="contact-name" 
							required 
							placeholder="ex. Camille & Julien" 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; font-size: 1.05rem; padding: 0.85rem 1rem;"
						/>
					</div>

					<div>
						<label for="contact-email" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Votre Adresse E-mail <span style="color: #dc2626;">*</span>
						</label>
						<input 
							type="email" 
							name="email"
							id="contact-email" 
							required 
							placeholder="ex. contact@exemple.fr" 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; font-size: 1.05rem; padding: 0.85rem 1rem;"
						/>
					</div>

					<div>
						<label for="contact-topic" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Sujet de Votre Demande
						</label>
						<select name="topic" id="contact-topic" class="hand-input" style="width: 100%; box-sizing: border-box; background: #fff; font-size: 1.05rem; padding: 0.85rem 1rem; cursor: pointer;">
							<option value="Proposer un outil">💡 Suggérer une nouvelle calculatrice ou fonctionnalité</option>
							<option value="Signaler un bug">🐛 Signaler une anomalie ou un bug de calcul</option>
							<option value="Question générale">💬 Question générale sur l'organisation de mariage</option>
							<option value="Partenariat / Presse">🤝 Médias, presse ou partenariat professionnel</option>
							<option value="Confidentialité">🛡️ Question relative aux données et à la vie privée</option>
						</select>
					</div>

					<div>
						<label for="contact-message" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Message <span style="color: #dc2626;">*</span>
						</label>
						<textarea 
							name="message"
							id="contact-message" 
							rows="5" 
							required 
							placeholder="Partagez-nous votre avis, l'outil que vous utilisez ou la fonctionnalité qui vous simplifierait la vie..." 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; resize: vertical; font-size: 1.05rem; line-height: 1.6; padding: 0.85rem 1rem;"
						></textarea>
					</div>

					<button 
						type="submit" 
						id="contact-submit-btn"
						class="hand-btn" 
						style="width: 100%; padding: 14px 20px; font-size: 1.15rem; cursor: pointer; margin-top: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.6rem;"
					>
						<span>✉️</span>
						<span id="btn-text">Envoyer le Message</span>
					</button>
				</form>

				<!-- Success Status Box -->
				<div id="contact-success" style="display: none; background: #dcfce7; border: 2px solid #16a34a; border-radius: 6px; padding: 1.5rem; margin-top: 1.5rem; text-align: center; color: #166534;">
					<div style="font-size: 2rem; margin-bottom: 0.35rem;">🎉</div>
					<strong style="font-size: 1.2rem; display: block; margin-bottom: 0.5rem;">Merci ! Votre message a bien été envoyé.</strong>
					<p style="margin: 0; font-size: 1.02rem; line-height: 1.5;">
						Il a été transmis directement à <strong>manage.weddingall@gmail.com</strong>. Nous vous répondrons sous 24 à 48 heures ouvrées !
					</p>
				</div>

				<!-- Error Fallback Box -->
				<div id="contact-error" style="display: none; background: #fee2e2; border: 2px solid #dc2626; border-radius: 6px; padding: 1.5rem; margin-top: 1.5rem; text-align: center; color: #991b1b;">
					<strong style="font-size: 1.1rem; display: block; margin-bottom: 0.35rem;">Impossible d'envoyer le message automatiquement.</strong>
					<p style="margin: 0; font-size: 1rem;">
						Veuillez nous écrire directement par e-mail à <a id="error-mailto-link" href="mailto:manage.weddingall@gmail.com" style="color: #991b1b; text-decoration: underline; font-weight: bold;">manage.weddingall@gmail.com</a>.
					</p>
				</div>
			</div>

			<!-- Direct Contact Info & FAQ Side Column -->
			<div style="display: flex; flex-direction: column; gap: 1.75rem;">
				
				<!-- Direct Channels -->
				<div class="hand-card" style="padding: 2rem; background: var(--bg-paper);">
					<h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
						Coordonnées Directes
					</h3>
					
					<div style="display: flex; flex-direction: column; gap: 1.2rem; font-size: 1rem;">
						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); margin-bottom: 0.35rem; font-size: 1.05rem;">📬 E-mail Principal :</strong>
							<a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 700; text-decoration: underline; font-size: 1.1rem; word-break: break-all;">
								manage.weddingall@gmail.com
							</a>
						</div>

						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); font-size: 1.05rem;">💡 Pourquoi nous contacter :</strong>
							<ul style="margin: 0.5rem 0 0 1.25rem; padding: 0; color: var(--text-secondary); font-size: 0.98rem; line-height: 1.6;">
								<li>Suggestions de nouvelles calculatrices de mariage</li>
								<li>Demandes d'ajustement ou retour d'expérience</li>
								<li>Partenariats prestataires et wedding planners</li>
							</ul>
						</div>

						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); font-size: 1.05rem;">🛡️ Vie Privée & Données :</strong>
							<p style="margin: 0.35rem 0 0; color: var(--text-secondary); font-size: 0.98rem; line-height: 1.5;">
								Toutes vos questions relatives à la confidentialité peuvent être adressées à <a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 600; text-decoration: underline;">manage.weddingall@gmail.com</a>.
							</p>
						</div>
					</div>
				</div>

				<!-- Quick Response Guarantee -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.45rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
						⚡ Réponse sous 24 à 48h
					</h3>
					<p style="font-size: 1.02rem; color: var(--text-secondary); margin: 0; line-height: 1.6; text-align: center;">
						Nous lisons personnellement chaque message envoyé par les futurs mariés, témoins et organisateurs.
					</p>
				</div>

				<!-- Quick FAQ -->
				<div class="hand-card" style="padding: 2rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 1rem; text-align: center;">
						Questions Fréquentes
					</h3>
					<details style="margin-bottom: 0.75rem; cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Ces outils sont-ils réellement 100% gratuits ?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Oui ! L'ensemble de nos plus de 30 simulateurs et modèles téléchargeables est entièrement gratuit pour votre usage personnel.</p>
					</details>
					<details style="margin-bottom: 0.75rem; cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Puis-je suggérer un nouvel outil ?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Absolument ! Envoyez-nous simplement votre formule ou besoin via le formulaire ci-contre ou par e-mail.</p>
					</details>
					<details style="cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Enregistrez-vous ma liste d'invités ?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Non. Vos données sont conservées uniquement dans la mémoire de votre navigateur et ne sont jamais stockées sur des serveurs distants.</p>
					</details>
				</div>

			</div>

		</div>

	</main>

	<script is:inline>
		const form = document.getElementById('contact-form');
		const submitBtn = document.getElementById('contact-submit-btn');
		const btnText = document.getElementById('btn-text');
		const successBox = document.getElementById('contact-success');
		const errorBox = document.getElementById('contact-error');
		const errorMailto = document.getElementById('error-mailto-link');

		if (form) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				const honey = document.getElementById('contact-honey').value;
				if (honey) {
					console.warn('Soumission de bot bloquée');
					return;
				}

				const name = document.getElementById('contact-name').value.trim();
				const email = document.getElementById('contact-email').value.trim();
				const topic = document.getElementById('contact-topic').value;
				const message = document.getElementById('contact-message').value.trim();

				if (!name || !email || !message) return;

				submitBtn.disabled = true;
				btnText.innerText = 'Envoi en cours à manage.weddingall@gmail.com...';
				if (successBox) successBox.style.display = 'none';
				if (errorBox) errorBox.style.display = 'none';

				try {
					const response = await fetch('https://formsubmit.co/ajax/75066fcb859af7eecff2fc720ba6dc94', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'Accept': 'application/json'
						},
						body: JSON.stringify({
							name: name,
							email: email,
							topic: topic,
							message: message,
							_subject: `[Contact Manage.Wedding FR] ${topic} de la part de ${name}`,
							_template: 'table'
						})
					});

					const result = await response.json();

					if (response.ok || result.success === 'true' || result.message) {
						form.reset();
						submitBtn.style.display = 'none';
						if (successBox) {
							successBox.style.display = 'block';
							successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
						}
					} else {
						throw new Error(result.message || 'Échec de l\'envoi');
					}
				} catch (err) {
					console.error('Erreur lors de l\'envoi :', err);
					submitBtn.disabled = false;
					btnText.innerText = 'Envoyer le Message Directement';
					
					const subject = encodeURIComponent(`[Manage.Wedding FR] ${topic} - de la part de ${name}`);
					const body = encodeURIComponent(`Nom : ${name}\nE-mail : ${email}\nSujet : ${topic}\n\nMessage :\n${message}`);
					if (errorMailto) {
						errorMailto.href = `mailto:manage.weddingall@gmail.com?subject=${subject}&body=${body}`;
					}
					if (errorBox) {
						errorBox.style.display = 'block';
						errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					}
				}
			});
		}
	</script>
</Layout>
