---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Calculateur de Budget Global de Mariage",
      "url": "https://manage.wedding/fr/master-budget-calculator",
      "description": "Calculateur gratuit de budget global de mariage. Répartissez vos dépenses (lieu, traiteur, photographe, tenues, fleurs), suivez le coût par invité et exportez vers Word, PDF ou Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Établir et Répartir son Budget de Mariage",
      "description": "Guide étape par étape pour calculer et distribuer son enveloppe de mariage entre le domaine, le traiteur, le photographe, les tenues et la marge d'imprévus.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Définir Votre Enveloppe Globale",
          "text": "Faites le total de votre épargne personnelle, de votre capacité d'épargne mensuelle d'ici le Jour J et des contributions confirmées des proches pour fixer votre plafond de dépense."
        },
        {
          "@type": "HowToStep",
          "name": "Allouer 45% à 50% au Domaine et au Traiteur",
          "text": "Réservez la moitié de votre budget pour la location de la salle ou du château, le vin d'honneur, le repas servi à table ou buffet, les boissons et le mobilier."
        },
        {
          "@type": "HowToStep",
          "name": "Consacrer 12% à 15% à la Photo et Vidéo",
          "text": "Budgétisez le reportage photo complet des préparatifs jusqu'à la pièce montée, le film souvenir et l'album haut de gamme."
        },
        {
          "@type": "HowToStep",
          "name": "Répartir les Tenues, Fleurs et Animation",
          "text": "Prévoyez 8% à 10% pour la robe de mariée, le costume et la mise en beauté, 8% pour l'art floral et 8% pour le DJ ou groupe de musique."
        },
        {
          "@type": "HowToStep",
          "name": "Conserver une Marge de Sécurité de 5%",
          "text": "Gardez une réserve de secours obligatoire de 5% pour couvrir le droit de bouchon, les repas prestataires, les retouches et les heures supplémentaires de soirée."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle est la répartition idéale du budget d'un mariage en France ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La règle générale observée par les organisateurs de mariage est : 45 à 50% pour le Lieu & Traiteur, 12 à 15% pour la Photo & Vidéo, 8 à 10% pour les Tenues & Beauté, 8 à 10% pour les Fleurs & Décoration, 7 à 8% pour le DJ & Musique, 4% pour les Alliances, 3% pour la Papeterie et 5% pour la Marge de Sécurité."
          }
        },
        {
          "@type": "Question",
          "name": "Comment le nombre d'invités impacte-t-il le coût total du mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Environ 50% à 60% des dépenses d'un mariage sont variables par personne (traiteur, vins, champagne, gâteau, location de vaisselle, faire-part, dragées). Réduire votre liste de seulement 15 à 20 convives permet d'économiser immédiatement entre 2 500 € et 4 500 €."
          }
        },
        {
          "@type": "Question",
          "name": "Quels sont les frais cachés à anticiper lors des préparatifs ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "N'oubliez pas d'inclure : les repas pour vos prestataires (30 à 50 € par personne pour photographe/DJ), le droit de bouchon si vous apportez votre propre vin (3 à 8 € par bouteille), les retouches de robe (150 à 450 €), l'affranchissement des faire-part et les heures supplémentaires du domaine."
          }
        },
        {
          "@type": "Question",
          "name": "Comment exporter mon budget vers Word, PDF ou Excel ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cliquez simplement sur les boutons 'Export Word (.doc)', 'Export PDF / Imprimer' ou 'Export Excel (.csv)' en haut du simulateur pour obtenir votre rapport financier détaillé."
          }
        }
      ]
    }
  ]
};

const defaultCategories = [
  { id: 'venue', name: 'Lieu de réception & Traiteur', defaultPct: 48, color: '#ffb3ba', desc: 'Location du domaine/château, vin d\'honneur, repas, boissons & mobilier' },
  { id: 'photo', name: 'Photographie & Vidéo', defaultPct: 13, color: '#bae1ff', desc: 'Reportage journée complète, vidéaste, drone & livre photo souvenir' },
  { id: 'attire', name: 'Tenues & Mise en beauté', defaultPct: 9, color: '#ffdfba', desc: 'Robe de mariée, costume, retouches, voile, coiffure & maquillage' },
  { id: 'florals', name: 'Fleurs & Décoration', defaultPct: 8, color: '#baffc9', desc: 'Bouquet de mariée, arche de cérémonie, centres de table & bougies' },
  { id: 'entertain', name: 'Musique & Animation', defaultPct: 7, color: '#ffffba', desc: 'DJ, sonorisation, éclairage de piste, musiciens ou groupe live' },
  { id: 'rings', name: 'Alliances & Cérémonie', defaultPct: 4, color: '#fbcfe8', desc: 'Alliances, démarches civiles & officiant de cérémonie laïque' },
  { id: 'stationery', name: 'Papeterie & Affranchissement', defaultPct: 3, color: '#e8baff', desc: 'Save-the-date, faire-part, timbres, menus, marque-places & remerciements' },
  { id: 'favors', name: 'Cadeaux Invités & Témoins', defaultPct: 2, color: '#fed7aa', desc: 'Petites attentions pour les invités, dragées & cadeaux témoins' },
  { id: 'transport', name: 'Transport & Hébergement', defaultPct: 2, color: '#ccfbf1', desc: 'Voiture des mariés, navette pour les invités & chambre nuptiale' },
  { id: 'buffer', name: 'Marge Imprévus & Taxes', defaultPct: 4, color: '#e5e7eb', desc: 'Repas prestataires, droit de bouchon, heures sup & imprévus' }
];
---

<Layout 
	title="Calculateur de Budget de Mariage (Répartition des Dépenses & Export Excel) | Manage.Wedding"
	description="Calculez et maîtrisez votre budget de mariage. Répartissez vos dépenses entre lieu, traiteur, photographe, robe et fleurs avec export instantané Word, PDF et Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Calculateur de Budget Global" category="budget-finance" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculateur de Budget de Mariage
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Répartissez intelligemment votre enveloppe financière entre domaine, traiteur, photo et tenues. Suivez votre coût par invité et exportez vers <strong>Word (.doc)</strong>, <strong>PDF</strong> ou <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Budget Overview Dashboard & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div style="flex: 1; min-width: 250px;">
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💰 Planificateur Financier de Mariage
					</h2>
					<p class="font-body" style="color: var(--text-secondary); font-size: 0.9rem; margin: 0.2rem 0 0 0; text-align: center;">
						Ajustez les curseurs et téléchargez votre synthèse budgétaire
					</p>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; width: 100%;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Export Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Export PDF / Imprimer
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Export Excel (.csv)
					</button>
					<button type="button" id="btn-reset-defaults" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						🔄 Rétablir Ratios Standards
					</button>
				</div>
			</div>

			<!-- Preset Budget Tiers -->
			<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
				<span class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
					⚡ Profils Budgétaires Fréquents :
				</span>
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center;">
					<button type="button" class="tier-btn" data-amt="12000" data-guests="50">🪙 Mariage Intime & DIY (12 000 € • 50 Invités)</button>
					<button type="button" class="tier-btn active-tier" data-amt="20000" data-guests="100">💎 Moyenne Française (20 000 € • 100 Invités)</button>
					<button type="button" class="tier-btn" data-amt="45000" data-guests="130">👑 Réception Haut de Gamme (45 000 € • 130 Invités)</button>
					<button type="button" class="tier-btn" data-amt="80000" data-guests="180">✨ Grand Luxe (80 000 € • 180 Invités)</button>
				</div>
			</div>

			<!-- Core Global Inputs: Total Budget, Currency & Guest Count -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
				
				<!-- Total Budget -->
				<div>
					<label for="total-budget-input" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Budget Total Prévu
					</label>
					<div style="display: flex; align-items: center; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; overflow: hidden;">
						<span id="currency-symbol-display" style="padding: 0.6rem 0.8rem; background: var(--bg-paper); border-right: 1px solid var(--fg-pencil); font-weight: bold; font-family: var(--font-heading);">€</span>
						<input type="number" id="total-budget-input" value="20000" min="500" step="500" style="flex: 1; border: none; padding: 0.6rem; font-family: var(--font-body); font-size: 1.2rem; font-weight: bold; outline: none; background: transparent;">
					</div>
				</div>

				<!-- Currency Selector -->
				<div>
					<label for="currency-select" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Devise
					</label>
					<select id="currency-select" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff;">
						<option value="€" selected>€ (EUR - Euro)</option>
						<option value="$">$ (USD / CAD)</option>
						<option value="£">£ (GBP - Livre Sterling)</option>
						<option value="CHF">CHF (Franc Suisse)</option>
					</select>
				</div>

				<!-- Estimated Guest Count -->
				<div>
					<label for="guest-count-input" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Nombre Estimé d'Invités
					</label>
					<input type="number" id="guest-count-input" value="100" min="5" max="1000" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: #fff;">
				</div>

			</div>

			<!-- Dynamic Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Budget Total</span>
					<strong id="stat-total-display" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">20 000 €</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">100% Réparti</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Coût par Invité</span>
					<strong id="stat-per-guest" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">200,00 €</strong>
					<span id="stat-guest-count-note" style="font-size: 0.75rem; color: #1e40af; display: block;">Pour 100 invités</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Lieu & Traiteur (48%)</span>
					<strong id="stat-venue-amt" class="font-heading" style="font-size: 1.8rem; color: #15803d;">9 600 €</strong>
					<span style="font-size: 0.75rem; color: #166534; display: block;">Dépense principale</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Marge Imprévus (4%)</span>
					<strong id="stat-buffer-amt" class="font-heading" style="font-size: 1.8rem; color: #a16207;">800 €</strong>
					<span style="font-size: 0.75rem; color: #854d0e; display: block;">Coussin de sécurité</span>
				</div>
			</div>

			<!-- Visual Stacked Expense Distribution Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Ventilation Graphique des Postes</span>
					<span id="pct-warning" class="font-body" style="font-size: 0.85rem; color: #15803d; font-weight: bold;">100% Réparti (Équilibré)</span>
				</div>
				<div id="stacked-budget-bar" style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #e5e0d8; margin-bottom: 0.75rem;">
					<!-- Injected via JS -->
				</div>
			</div>

		</div>

		<!-- Interactive Category Allocation Grid -->
		<section style="margin-bottom: 3.5rem;">
			<h2 class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); text-align: center; margin-bottom: 0.5rem;">
				📊 Répartition Détaillée par Poste de Dépense
			</h2>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); text-align: center; max-width: 600px; margin: 0 auto 1.75rem;">
				Ajustez les pourcentages avec les curseurs ou saisissez directement les montants. Tout se recalcule en direct.
			</p>

			<div id="categories-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem;">
				<!-- Injected via JS -->
			</div>
		</section>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Synthèse Officielle du Budget de Mariage</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exporté le : <span id="print-date"></span> | Budget Total : <span id="print-total"></span> | Coût par Invité : <span id="print-per-guest"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Poste de Dépense</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 70px; text-align: center;">Part (%)</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 120px; text-align: right;">Budget Alloué</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Prestations & Éléments Inclus</th>
					</tr>
				</thead>
				<tbody id="print-table-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 2.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Repères Clés en 1 Coup d'Œil</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					La Règle d'Or de Répartition du Budget
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 750px; margin: 0 auto; font-weight: 500;">
					Voici la formule éprouvée et le tableau comparatif pour des budgets de 15 000 €, 25 000 € et 40 000 €.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 La Formule Standard des Organisateurs :
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					48% Lieu & Traiteur + 13% Photo/Vidéo + 9% Tenues & Beauté + 8% Fleurs & Déco + 7% Musique/DJ + 11% Alliances/Papeterie/Cadeaux + 4% Imprévus = 100% du Budget
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 580px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Poste de Dépense</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Part Cible</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Budget 15 000 €</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Budget 25 000 €</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Budget 40 000 €</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Lieu de Réception & Traiteur</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">48%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">7 200 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">12 000 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">19 200 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Photographie & Vidéo</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">13%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">1 950 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">3 250 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">5 200 €</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #d97706;">Tenues, Robe & Beauté</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">9%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">1 350 €</td>
