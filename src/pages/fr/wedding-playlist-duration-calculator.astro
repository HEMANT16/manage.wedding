---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/wedding-playlist-duration-calculator/#webapp",
      "name": "Calculateur de Playlist de Mariage, Musique DJ et Durée",
      "url": "https://manage.wedding/fr/wedding-playlist-duration-calculator",
      "inLanguage": "fr",
      "description": "Calculateur gratuit de playlist de mariage et générateur de fiche de briefing pour DJ. Calculez le nombre de morceaux pour chaque moment (cérémonie, vin d'honneur, dîner, soirée dansante) et exportez votre brief DJ en PDF et Word.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien de morceaux faut-il prévoir pour une soirée de mariage de 6 heures ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pour un mariage complet de 6 heures (360 minutes), environ 100 à 120 morceaux seront diffusés (comptez 3,5 minutes par titre complet ou 2,5 minutes en transitions rapides de DJ). Nous conseillons de préparer une sélection totale de 130 à 140 morceaux avec une marge de sécurité de 20% pour laisser au DJ la liberté d'adapter son set."
          }
        },
        {
          "@type": "Question",
          "name": "Combien de chansons indispensables (Must-Play) doit-on donner au DJ ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les DJs de mariage recommandent de limiter votre liste de coups de cœur indispensables à 15 ou 20 titres maximum. Imposer une liste rigide de plus de 50 morceaux empêche le DJ de lire la dynamique de la piste et de relancer l'ambiance au bon moment."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle est la durée idéale pour l'ouverture de bal des mariés ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La durée idéale d'une première danse est de 2 minutes 30 à 3 minutes. Au-delà de 3 minutes sous les projecteurs, le moment peut sembler long pour les mariés et les invités. Demandez à votre DJ d'effectuer un fondu progressif (fade out) ou d'inviter les témoins et convives à rejoindre la piste au bout de 2 minutes et demie."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Comment Dimensionner sa Playlist et Créer la Fiche de Briefing DJ",
      "description": "Méthode pas à pas pour calculer le nombre de titres par phase, programmer les moments clés avec minutage et télécharger la fiche de soirée.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Définir les Durées de Chaque Phase",
          "text": "Ajustez les curseurs pour le prélude de cérémonie, le vin d'honneur, le dîner et la soirée dansante."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Choisir les Moments Clés et Repères Audio",
          "text": "Renseignez les titres et consignes de fondu pour l'entrée des mariés, l'ouverture de bal, la pièce montée et le bouquet."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Établir la Liste Coups de Cœur et Liste Noire",
          "text": "Sélectionnez vos 15-20 titres indispensables et bannissez les genres ou chansons indésirables."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Exporter le Brief DJ (PDF & Word)",
          "text": "Téléchargez la fiche complète prête à être remise à votre DJ ou orchestre lors du calage final."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur de Playlist de Mariage, Musique DJ et Durée (Fiche PDF & Word Gratuite) | Manage.Wedding"
	description="Calculez le nombre exact de morceaux pour votre mariage, paramétrez les moments clés avec repères audio, créez vos listes indispensables et liste noire, et téléchargez la fiche DJ."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Playlist & Musique DJ" category="guests-logistics" />
		
		<!-- Hero & En-tête -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🎵</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratuit • Sans Inscription • Export PDF & Word Immédiat</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculateur de Playlist de Mariage & Fiche DJ
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 740px; margin: 0 auto; text-align: center;">
					Calculez le nombre de morceaux pour chaque phase, programmez vos temps forts avec minutage de fondu, créez vos <strong>Listes Coups de Cœur & Liste Noire</strong>, et exportez la <strong>Fiche de Briefing DJ / Groupe</strong> en PDF et Word !
				</p>
			</div>
		</section>

		<!-- Guide Visuel 3 Étapes -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>🎧</span> Organisez la Musique de votre Mariage en 3 Étapes
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Durées & Tempo BPM
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Réglez les curseurs pour la cérémonie, le vin d'honneur, le dîner et la soirée pour calculer les titres.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Moments Clés & Repères
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Choisissez les musiques pour l'entrée, l'ouverture de bal, la pièce montée et le lancer de bouquet.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Listes & Export DJ
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Sélectionnez jusqu'à 20 coups de cœur, bannissez les titres ringards et téléchargez le PDF de briefing.
					</p>
				</div>
			</div>
		</div>

		<!-- Espace de Travail -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SECTION 1: Curseurs de Durée -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🎚️ 1. Durée des Phases & Calcul des Titres
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Estimez le volume de chansons selon le style de mixage du DJ
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center;">
						<label for="select-mix-pacing" class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil);">
							Style DJ :
						</label>
						<select id="select-mix-pacing" style="padding: 0.35rem 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem; font-weight: 600;">
							<option value="radio" selected>Morceaux Radio Complets (~3.5 min / 17 titres/h)</option>
							<option value="quickmix">Enchaînements Rapides DJ (~2.7 min / 22 titres/h)</option>
							<option value="lounge">Acoustique & Lounge Étendu (~4.2 min / 14 titres/h)</option>
						</select>
					</div>
				</div>

				<!-- Grille Curseurs -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
					
					<!-- Prélude -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-prelude" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🎻</span> Prélude Cérémonie
							</label>
							<span id="val-prelude" class="font-heading" style="font-size: 1rem; color: var(--accent-red); font-weight: 700;">30 min</span>
						</div>
						<input type="range" id="slider-prelude" min="15" max="60" step="5" value="30" style="width: 100%; accent-color: var(--accent-red);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>15 min</span>
							<span id="songs-prelude" style="font-weight: 600; color: var(--fg-pencil);">~9 morceaux (60-80 BPM)</span>
							<span>60 min</span>
						</div>
					</div>

					<!-- Vin d'Honneur -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-cocktail" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍸</span> Vin d'Honneur / Cocktail
							</label>
							<span id="val-cocktail" class="font-heading" style="font-size: 1rem; color: var(--accent-blue); font-weight: 700;">60 min</span>
						</div>
						<input type="range" id="slider-cocktail" min="30" max="120" step="5" value="60" style="width: 100%; accent-color: var(--accent-blue);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>30 min</span>
							<span id="songs-cocktail" style="font-weight: 600; color: var(--fg-pencil);">~17 morceaux (90-115 BPM)</span>
							<span>120 min</span>
						</div>
					</div>

					<!-- Dîner -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dinner" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍽️</span> Dîner / Repas
							</label>
							<span id="val-dinner" class="font-heading" style="font-size: 1rem; color: #d97706; font-weight: 700;">90 min</span>
						</div>
						<input type="range" id="slider-dinner" min="45" max="150" step="5" value="90" style="width: 100%; accent-color: #d97706;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>45 min</span>
							<span id="songs-dinner" style="font-weight: 600; color: var(--fg-pencil);">~25 morceaux (70-95 BPM)</span>
							<span>150 min</span>
						</div>
					</div>

					<!-- Soirée Dansante -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dance" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🕺</span> Soirée Dansante
							</label>
							<span id="val-dance" class="font-heading" style="font-size: 1rem; color: #16a34a; font-weight: 700;">180 min (3.0h)</span>
						</div>
						<input type="range" id="slider-dance" min="60" max="360" step="15" value="180" style="width: 100%; accent-color: #16a34a;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>1 heure</span>
							<span id="songs-dance" style="font-weight: 600; color: var(--fg-pencil);">~52-60 morceaux (118-132 BPM)</span>
							<span>6 heures</span>
						</div>
					</div>

					<!-- After -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-afterparty" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🌙</span> Fin de Nuit / After
							</label>
							<span id="val-afterparty" class="font-heading" style="font-size: 1rem; color: #7c3aed; font-weight: 700;">0 min</span>
						</div>
						<input type="range" id="slider-afterparty" min="0" max="120" step="15" value="0" style="width: 100%; accent-color: #7c3aed;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>0 min (Désactivé)</span>
							<span id="songs-afterparty" style="font-weight: 600; color: var(--fg-pencil);">0 morceau</span>
							<span>120 min</span>
						</div>
					</div>

				</div>

				<!-- Récapitulatif Chiffré -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; background: var(--muted-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; text-align: center;">
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Temps Total de Musique</span>
						<strong id="display-total-runtime" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil);">6h 00m (360 min)</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Titres Joués Réellement</span>
						<strong id="display-exact-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue);">~103 Titres</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Playlist Recommandée (+20% Marge)</span>
						<strong id="display-buffered-tracks" class="font-heading" style="font-size: 1.6rem; color: #16a34a;">~125 Titres</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Morceaux pour la Soirée</span>
						<strong id="display-dance-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red);">~52 Titres</strong>
					</div>
				</div>

			</div>

			<!-- SECTION 2: Moments Clés et Repères de Sonorisation -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							💃 2. Moments Clés & Consignes de Minutage Audio
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Sélectionnez nos suggestions populaires ou personnalisez avec vos minutages exacts
						</span>
					</div>
					<button type="button" id="btn-autofill-special" class="hand-btn" style="padding: 0.3rem 0.7rem; font-size: 0.8rem; background: #eff6ff;">
						✨ Charger les Classiques
					</button>
				</div>

				<div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" id="special-moments-container">
					<!-- Généré par JS -->
				</div>
			</div>

			<!-- SECTION 3: Coups de Cœur et Liste Noire -->
			<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 1fr; gap: 1.5rem;">
				
				<!-- Boîte Coups de Cœur -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.25rem; color: #16a34a; margin: 0;">
								⭐ Chansons Incontournables (Must-Play)
							</h3>
							<span class="font-body" style="font-size: 0.8rem; color: var(--text-secondary);">
								Objectif : 10–20 titres (laisse le DJ s'adapter à la piste)
							</span>
						</div>
						<span id="must-play-counter" class="badge-postit" style="font-size: 0.85rem;">0 / 20 Titres</span>
					</div>

					<!-- Ajout Rapide -->
					<div style="margin-bottom: 1rem; background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<span class="font-heading" style="font-size: 0.8rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem;">
							⚡ Succès Incontournables de Piste :
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;" id="quick-must-pills">
							<button type="button" class="btn-quick-add hand-btn" data-title="One More Time" data-artist="Daft Punk" data-phase="Soirée" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Daft Punk</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="September" data-artist="Earth, Wind & Fire" data-phase="Soirée" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ September</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="La Grenade" data-artist="Clara Luciani" data-phase="Soirée" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Clara Luciani</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Dancing Queen" data-artist="ABBA" data-phase="Soirée" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ ABBA</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Alors on danse" data-artist="Stromae" data-phase="Soirée" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Stromae</button>
						</div>
					</div>

					<!-- Formulaire Ajout -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 0.9fr auto; gap: 0.4rem; margin-bottom: 1rem;">
						<input type="text" id="input-must-title" placeholder="Titre (ex. Levitating)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<input type="text" id="input-must-artist" placeholder="Artiste (ex. Dua Lipa)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<select id="select-must-phase" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.8rem; background: #fff;">
							<option value="Soirée Dansante">Soirée</option>
							<option value="Cocktail / Vin d'Honneur">Cocktail</option>
							<option value="Dîner / Repas">Dîner</option>
							<option value="Fin de Soirée">Fin de Soirée</option>
						</select>
						<button type="button" id="btn-add-must" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background: #16a34a; color: #fff;">+ Ajouter</button>
					</div>

					<!-- Liste -->
					<div id="must-play-list" style="max-height: 280px; overflow-y: auto; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #faf8f5; padding: 0.5rem;">
						<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin: 1rem 0;">Aucun morceau ajouté pour l'instant.</p>
					</div>
				</div>

				<!-- Boîte Liste Noire -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
						<div>
