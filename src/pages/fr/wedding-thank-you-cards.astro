---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/wedding-thank-you-cards/#webapp",
      "name": "Générateur de Cartes et Textes de Remerciement de Mariage",
      "url": "https://manage.wedding/fr/wedding-thank-you-cards",
      "description": "Générez des messages de remerciement de mariage personnalisés et conformes aux règles de bienséance pour dons d'urne, cagnottes voyage de noces, listes de mariage et prestataires.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Rédiger un Mot de Remerciement de Mariage Parfait",
      "description": "La structure classique en 4 phrases pour écrire des cartes de remerciement sincères et élégantes.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Phrase 1 : Remercier pour la Présence et le Partage",
          "text": "Remerciez chaleureusement le convive d'avoir partagé votre journée ou d'avoir fait le déplacement."
        },
        {
          "@type": "HowToStep",
          "name": "Phrase 2 : Nommer Précisément le Cadeau Reçu",
          "text": "Mentionnez le cadeau reçu (votre généreuse attention pour notre voyage de noces, le sublime robot pâtissier) sans jamais écrire de montant en euros."
        },
        {
          "@type": "HowToStep",
          "name": "Phrase 3 : Expliquer Comment le Cadeau Sera Utilisé",
          "text": "Partagez un projet concret (ex. 'Nous avons pu financer une sortie en catamaran au coucher du soleil' ou 'Il orne déjà notre cuisine')."
        },
        {
          "@type": "HowToStep",
          "name": "Phrase 4 : Formule Finale & Perspectives",
          "text": "Concluez par des vœux chaleureux et l'envie de se revoir très bientôt."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quel est le délai pour envoyer les cartes de remerciement de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "L'usage recommande d'envoyer l'ensemble de ses cartes de remerciement dans les 3 mois suivant le mariage (ou le retour de voyage de noces). Pour les cadeaux reçus en amont du mariage, un mot sous 2 à 3 semaines est conseillé."
          }
        },
        {
          "@type": "Question",
          "name": "Comment remercier pour un don d'argent ou une enveloppe d'urne ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ne mentionnez jamais le montant en chiffres. Remerciez simplement pour 'votre généreuse attention' ou 'votre grande générosité' et précisez à quoi ce don servira (voyage de noces, aménagement du logement, projet futur)."
          }
        },
        {
          "@type": "Question",
          "name": "Les cartes de remerciement doivent-elles être écrites à la main ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui, même si le texte est préparé ou imprimé, ajouter un petit mot manuscrit personnalisé et les signatures des deux mariés témoigne d'une délicatesse particulièrement appréciée."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Générateur de Textes de Remerciement Mariage (Exemples Gratuits) | Manage.Wedding"
	description="Générez des messages de remerciement personnalisés pour dons d'urne, cagnotte voyage de noces, cadeaux de liste et prestataires. Export PDF et Word."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Messages de Remerciement" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Formules & Rdaction de Cartes</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Générateur de Textes <span class="accent-italic">de Remerciement de Mariage</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Générez des mots de remerciement sincères, touchants et conformes à l'étiquette pour vos enveloppes d'urne, cagnottes voyage de noces, listes de mariage et invités. Copiez en 1 clic ou exportez en PDF et Word.
			</p>
		</header>

		<!-- Main Interactive Generator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Input Form -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Personnalisation du Message
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Style Émotion
					</span>
				</div>

				<!-- Recipient Name -->
				<div class="form-group">
					<label class="form-label" for="guest-names">Nom ou Prénom(s) du Destinataire</label>
					<input type="text" id="guest-names" class="form-input" value="Tante Sylvie & Oncle Michel" placeholder="ex. Tante Sylvie & Oncle Michel, Julie & Marc" />
				</div>

				<!-- Relationship to Couple -->
				<div class="form-group">
					<label class="form-label" for="relationship">Lien de Parenté / Relation</label>
					<select id="relationship" class="form-input" style="cursor: pointer;">
						<option value="family-close">Famille Proche (Parents, Grands-Parents, Frères & Sœurs)</option>
						<option value="family-extended" selected>Famille Élargie (Oncles, Tantes, Cousins)</option>
						<option value="friends-close">Amis Proches / Témoins / Demoiselles d'Honneur</option>
						<option value="friends-casual">Collègues de Travail / Amis</option>
						<option value="absent">Invité Absent ayant envoyé un cadeau</option>
						<option value="vendor">Prestataire de Mariage (Photographe, Traiteur, DJ)</option>
					</select>
				</div>

				<!-- Gift Category -->
				<div class="form-group">
					<label class="form-label" for="gift-type">Cadeau Reçu</label>
					<select id="gift-type" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="cash" selected>💵 Enveloppe / Don à l'Urne de Mariage</option>
						<option value="honeymoon">🏝️ Participation au Voyage de Noces</option>
						<option value="registry">🎁 Cadeau Physique / Liste de Mariage</option>
						<option value="attendance">✨ Présence & Souvenir (Sans cadeau)</option>
						<option value="group">👥 Cadeau Commun (Groupe d'amis ou collègues)</option>
						<option value="giftcard">💳 Carte Cadeau (Maison, Déco, Expérience)</option>
					</select>
				</div>

				<!-- Gift Specific Item / Detail -->
				<div class="form-group" id="gift-detail-group">
					<label class="form-label" for="gift-detail">Détail du Cadeau / Projet Financé</label>
					<input type="text" id="gift-detail" class="form-input" value="notre voyage de noces au Japon et nos projets futurs" placeholder="ex. robot pâtissier, excursion plongée en Polynésie" />
				</div>

				<!-- Tone / Style Selector -->
				<div class="form-group">
					<label class="form-label">Tonalité d'Écriture</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="tone-btn hand-btn is-active" data-tone="heartfelt" style="padding: 8px; font-size: 0.88rem;">
							💖 Émouvant & Chaleureux
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="formal" style="padding: 8px; font-size: 0.88rem;">
							🏛️ Classique & Élégant
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="casual" style="padding: 8px; font-size: 0.88rem;">
							✨ Moderne & Pétillant
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="short" style="padding: 8px; font-size: 0.88rem;">
							⚡ Court & Efficace
						</button>
					</div>
				</div>

				<!-- Personal Memory (Optional) -->
				<div class="form-group">
					<label class="form-label" for="personal-memory">Souvenir ou Clin d'Œil Particulier (Optionnel)</label>
					<input type="text" id="personal-memory" class="form-input" value="Nous avons adoré vous voir enflammer la piste de danse !" placeholder="ex. Merci d'avoir fait tout ce voyage depuis Nice !" />
				</div>

				<!-- Sign-off Names -->
				<div class="form-group">
					<label class="form-label" for="signoff-names">Prénoms des Mariés (Signature)</label>
					<input type="text" id="signoff-names" class="form-input" value="Éléonore & Alexandre" placeholder="ex. Éléonore & Alexandre" />
				</div>

				<button id="btn-generate-notes" class="hand-btn" style="width: 100%; padding: 14px; font-size: 1.1rem; margin-top: 0.5rem; justify-content: center;">
					<span>✨</span> Générer 3 Variantes de Remerciement
				</button>

			</div>

			<!-- Right Column: 3 Generated Options & Tracker -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Results Header -->
				<div style="display: flex; justify-content: space-between; align-items: center;">
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						Propositions de Textes
					</h3>
					<span id="word-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
						~50 mots | 1 min d'écriture
					</span>
				</div>

				<!-- Option 1 Card (Recommended) -->
				<div class="hand-card" style="padding: 1.5rem; background: #fffcf5; border-left: 6px solid var(--accent-red); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Option 1 : Recommandation Principale
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-1" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copier
						</button>
					</div>
					<p id="note-opt-1" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
Chère Tante Sylvie, Cher Oncle Michel,

Un immense merci d'avoir partagé ce jour si précieux à nos côtés ! Votre présence et votre affection ont illuminé notre mariage. Nous vous remercions du fond du cœur pour votre très généreuse attention pour notre voyage de noces au Japon et nos projets futurs. Nous avons adoré vous voir enflammer la piste de danse ! Au plaisir de vous retrouver très vite.

Avec toute notre affection,
Éléonore & Alexandre
					</p>
				</div>

				<!-- Option 2 Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid var(--accent-blue); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-blue); letter-spacing: 0.05em;">
							Option 2 : Variante Chaleureuse
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-2" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copier
						</button>
					</div>
					<p id="note-opt-2" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
Chère Tante Sylvie, Cher Oncle Michel,

Nous tenions à vous remercier chaleureusement pour votre présence à notre mariage. Avoir nos proches réunis autour de nous a rendu cette journée inoubliable. Merci infiniment pour votre délicate générosité dédiée à notre voyage de noces au Japon et nos projets futurs. Elle nous touche profondément et nous aide à débuter ce nouveau chapitre !

Tendrement,
Éléonore & Alexandre
					</p>
				</div>

				<!-- Option 3 Card (Short & Sweet) -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid #16a34a; position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #16a34a; letter-spacing: 0.05em;">
							Option 3 : Concis & Direct
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-3" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copier
						</button>
					</div>
					<p id="note-opt-3" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
Chère Tante Sylvie, Cher Oncle Michel,

Merci infiniment d'avoir été à nos côtés pour célébrer notre union et pour votre merveilleuse générosité. Votre soutien pour notre voyage de noces au Japon et nos projets futurs nous va droit au cœur. Merci pour tout votre amour !

Affectueusement,
Éléonore & Alexandre
					</p>
				</div>

				<!-- Action Bar -->
				<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
					<button id="btn-print-note" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>🖨️</span> Imprimer la Carte (PDF)
					</button>
					<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>📄</span> Export Word (.doc)
					</button>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Structure Essentielle</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Guide Rapide : La Formule des Cartes de Remerciement
				</h2>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📝 La Formule en 4 Phrases des Remerciements de Mariage :
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					[1. Remercier pour la présence] + [2. Nommer le cadeau sans montant] + [3. Expliquer son utilisation future] + [4. Formule de conclusion chaleureuse] • ⏰ Envoi sous 3 mois maximum.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Type de Cadeau</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Formulation Élégante</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">À Éviter Absolument</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Don d'Argent / Urne</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Merci du fond du cœur pour votre délicate générosité qui nous aide à financer notre voyage de noces."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Ne jamais citer de montant en euros (ex. "Merci pour le chèque de 200 €").</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Objet de Liste de Mariage</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Merci pour ce magnifique service d'assiettes qui sublime déjà notre table au quotidien !"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Éviter les formules trop vagues comme "Merci pour l'objet".</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Cagnotte Voyage de Noces</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Grâce à vous, nous avons pu déguster un dîner romantique inoubliable face à la mer !"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Ne pas oublier d'évoquer l'activité financée.</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Invité Absent</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Votre absence a créé un vide lors de notre mariage, mais votre attention nous a profondément émus."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Ne pas formuler de reproche sur l'absence.</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/fr/wedding-thank-you-cards" category="stationery" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const guestNamesInput = document.getElementById('guest-names');
		const relationshipSelect = document.getElementById('relationship');
		const giftTypeSelect = document.getElementById('gift-type');
		const giftDetailInput = document.getElementById('gift-detail');
		const giftDetailGroup = document.getElementById('gift-detail-group');
		const memoryInput = document.getElementById('personal-memory');
		const signoffInput = document.getElementById('signoff-names');
		const toneButtons = document.querySelectorAll('.tone-btn');
		const btnGenerate = document.getElementById('btn-generate-notes');

		const noteOpt1 = document.getElementById('note-opt-1');
		const noteOpt2 = document.getElementById('note-opt-2');
		const noteOpt3 = document.getElementById('note-opt-3');
		const wordCountBadge = document.getElementById('word-count-badge');
		const btnPrint = document.getElementById('btn-print-note');
		const btnDoc = document.getElementById('btn-export-doc');

		let currentTone = 'heartfelt';

		toneButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				toneButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentTone = btn.getAttribute('data-tone');
				generateNotes();
			});
		});

		giftTypeSelect.addEventListener('change', () => {
			const type = giftTypeSelect.value;
			if (type === 'attendance') {
				giftDetailGroup.style.display = 'none';
			} else {
				giftDetailGroup.style.display = 'block';
				if (type === 'cash') giftDetailInput.placeholder = 'ex. notre voyage de noces au Japon et nos projets futurs';
				else if (type === 'honeymoon') giftDetailInput.placeholder = 'ex. dîner romantique face à la mer à Kyoto';
				else if (type === 'registry') giftDetailInput.placeholder = 'ex. robot pâtissier en fonte';
				else if (type === 'group') giftDetailInput.placeholder = 'ex. machine à expresso';
				else if (type === 'giftcard') giftDetailInput.placeholder = 'ex. carte cadeau décoration maison';
			}
			generateNotes();
		});

		function generateNotes() {
			const names = guestNamesInput.value.trim() || 'Chers Amis';
			const gift = giftTypeSelect.value;
			const detail = giftDetailInput.value.trim() || 'votre très beau cadeau';
			const memory = memoryInput.value.trim();
			const signoff = signoffInput.value.trim() || 'Éléonore & Alexandre';

			let opt1 = '', opt2 = '', opt3 = '';
			const memoryClause = memory ? ` ${memory}` : '';

			if (currentTone === 'heartfelt') {
				if (gift === 'cash') {
					opt1 = `Chère / Cher ${names},\n\nUn immense merci d'avoir célébré notre mariage à nos côtés ! Votre présence a rendu cette journée magique. Nous vous remercions de tout cœur pour votre très généreuse attention pour ${detail}.${memoryClause} Nous avons hâte de vous retrouver très vite.\n\nAvec toute notre affection,\n${signoff}`;
					opt2 = `Chère / Cher ${names},\n\nNous ne vous remercierons jamais assez pour votre venue. Votre amour et votre bienveillance ont illuminé notre union. Merci infiniment pour votre geste si attentionné pour ${detail}.${memoryClause} Cela nous aide à commencer cette nouvelle vie de la plus belle des manières !\n\nTendrement,\n${signoff}`;
					opt3 = `Chère / Cher ${names},\n\nMerci d'avoir fait partie des moments précieux de notre mariage et pour votre magnifique générosité. Votre cadeau pour ${detail} nous touche droit au cœur.${memoryClause} Merci pour tout votre amour !\n\nAffectueusement,\n${signoff}`;
				} else if (gift === 'honeymoon') {
					opt1 = `Chère / Cher ${names},\n\nMerci de tout cœur d'avoir célébré notre mariage avec nous ! Nous sommes infiniment reconnaissants pour votre participation à ${detail}. Cela a rendu notre voyage de noces inoubliable.${memoryClause}\n\nAvec toute notre gratitude,\n${signoff}`;
					opt2 = `Chère / Cher ${names},\n\nVotre présence à notre mariage nous a comblés de bonheur. Merci infiniment de nous avoir offert ${detail} pour notre lune de miel ! C'était un moment magique.${memoryClause}\n\nBien affectueusement,\n${signoff}`;
					opt3 = `Chère / Cher ${names},\n\nMerci pour votre amour et votre merveilleuse contribution à ${detail} ! Votre attention a rendu notre première aventure de mariés inoubliable.${memoryClause}\n\nAvec toute notre tendresse,\n${signoff}`;
				} else if (gift === 'registry') {
					opt1 = `Chère / Cher ${names},\n\nMerci infiniment d'avoir partagé ce moment unique avec nous ! Nous adorons ${detail}. Il a déjà trouvé une place de choix dans notre maison !${memoryClause}\n\nAvec toute notre affection,\n${signoff}`;
					opt2 = `Chère / Cher ${names},\n\nQuel bonheur de vous avoir vus à notre mariage ! Merci de tout cœur pour ${detail}. Nous avons hâte de l'utiliser lors de nos prochains repas en famille !${memoryClause}\n\nTendres pensées,\n${signoff}`;
					opt3 = `Chère / Cher ${names},\n\nMerci pour votre présence et pour ${detail}. Votre délicatesse nous touche énormément.${memoryClause}\n\nAvec notre amitié,\n${signoff}`;
				} else {
					opt1 = `Chère / Cher ${names},\n\nUn immense merci d'avoir célébré notre mariage avec nous ! Votre joie, vos sourires et votre présence ont rendu cette journée parfaite.${memoryClause} Nous avons une chance infinie de vous avoir à nos côtés.\n\nAvec toute notre affection,\n${signoff}`;
					opt2 = `Chère / Cher ${names},\n\nNous étions si heureux de vous avoir près de nous pour échanger nos vœux. Merci pour ce moment inoubliable.${memoryClause}\n\nAffectueusement,\n${signoff}`;
					opt3 = `Chère / Cher ${names},\n\nMerci d'avoir rendu le plus beau jour de notre vie encore plus festif et chaleureux !${memoryClause}\n\nAvec toute notre amitié,\n${signoff}`;
				}
			} else if (currentTone === 'formal') {
				opt1 = `Chère / Cher ${names},\n\nNous tenons à vous exprimer notre sincère gratitude pour votre présence à notre mariage. Nous vous remercions chaleureusement pour votre généreuse contribution à ${detail}.${memoryClause}\n\nAvec nos sentiments les plus respectueux,\n${signoff}`;
				opt2 = `Chère / Cher ${names},\n\nCe fut un honneur et une grande joie de vous compter parmi nos invités. Merci infiniment pour votre attention pour ${detail}.${memoryClause}\n\nBien cordialement,\n${signoff}`;
				opt3 = `Chère / Cher ${names},\n\nNous vous remercions du fond du cœur d'avoir partagé la joie de notre union et pour votre soutien précieux pour ${detail}.${memoryClause}\n\nAvec notre plus profond respect,\n${signoff}`;
			} else if (currentTone === 'casual') {
				opt1 = `Coucou ${names} !\n\nMerci mille fois d'être venus célébrer notre mariage avec nous, c'était tellement génial ! On est super contents pour ${detail}.${memoryClause} On se voit très vite !\n\nGrosses bises,\n${signoff}`;
				opt2 = `Salut ${names} !\n\nMerci d'avoir mis l'ambiance au mariage ! On adore ${detail}, vous êtes au top !${memoryClause}\n\nÀ très vite,\n${signoff}`;
				opt3 = `Coucou ${names} !\n\nUn énorme merci pour votre présence et pour ${detail}, ça nous fait super plaisir !${memoryClause}\n\nPlein de bisous,\n${signoff}`;
			} else {
				opt1 = `Chère / Cher ${names},\n\nMerci beaucoup d'avoir été à nos côtés pour notre mariage et pour votre généreuse attention pour ${detail}.${memoryClause}\n\nAffectueusement,\n${signoff}`;
				opt2 = `Chère / Cher ${names},\n\nQuel plaisir d'avoir partagé ce moment avec vous ! Merci de tout cœur pour ${detail}.${memoryClause}\n\nBien amicalement,\n${signoff}`;
				opt3 = `Chère / Cher ${names},\n\nMerci d'avoir rendu notre journée inoubliable et pour votre délicate attention pour ${detail}.${memoryClause}\n\nTendrement,\n${signoff}`;
			}

			noteOpt1.textContent = opt1;
			noteOpt2.textContent = opt2;
			noteOpt3.textContent = opt3;

			const words = opt1.split(/\s+/).length;
			wordCountBadge.textContent = `~${words} mots | ~1 min d'écriture`;
		}

		[guestNamesInput, relationshipSelect, giftDetailInput, memoryInput, signoffInput].forEach(inp => {
			inp.addEventListener('input', generateNotes);
		});
		btnGenerate.addEventListener('click', generateNotes);

		document.querySelectorAll('.copy-note-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				const targetId = btn.getAttribute('data-target');
				const text = document.getElementById(targetId).textContent;
				navigator.clipboard.writeText(text).then(() => {
					const orig = btn.textContent;
					btn.textContent = '✅ Copié !';
					setTimeout(() => { btn.textContent = orig; }, 2000);
				});
			});
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Impression Mot de Remerciement — Manage.Wedding</title>
					<style>
						@page { size: 15cm 10cm; margin: 1cm; }
						body { font-family: Georgia, serif; font-size: 11pt; line-height: 1.6; color: #1e293b; padding: 15px; }
					</style>
				</head>
				<body>
					<div>${noteText}</div>
					<script>window.onload = function() { window.print(); };<\/script>
				</body>
				</html>
			`);
			printWindow.document.close();
		});

		btnDoc.addEventListener('click', () => {
			const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Texte de Remerciement</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 12pt; line-height: 1.6; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Projet de Mot de Remerciement</h2>
					<p>${noteText}</p>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = `remerciement-${guestNamesInput.value.replace(/[^a-zA-Z0-9]/g, '_')}.doc`;
			link.click();
		});

		generateNotes();
	</script>
</Layout>
