---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/wedding-speech-calculator/#webapp",
      "name": "Calculateur de Durée des Discours de Mariage et Fiches Mémo",
      "url": "https://manage.wedding/fr/wedding-speech-calculator",
      "description": "Outil 100% gratuit pour calculer le temps de parole en minutes et le décompte de mots de votre discours de mariage. Modèles de discours pour témoins, père de la mariée et mariés, chronomètre de répétition et fiches mémo à imprimer.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle est la durée idéale pour un discours de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La durée idéale d'un discours de mariage se situe entre 3 et 5 minutes (soit environ 400 à 650 mots). En dessous de 2 minutes, le discours semble trop bref ; au-delà de 6 minutes, l'attention des invités décroît et les plats du traiteur risquent de refroidir."
          }
        },
        {
          "@type": "Question",
          "name": "Quel est le rythme moyen de parole (mots par minute) pour un toast ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le débit naturel en prise de parole publique se situe à 130 mots par minute. Ce rythme intègre les respirations, le contact visuel avec l'assistance et les temps de rires des invités."
          }
        },
        {
          "@type": "Question",
          "name": "Faut-il lire son discours sur son smartphone ou sur des fiches cartonnées ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il est fortement recommandé d'utiliser des fiches cartonnées (type Bristol en grands caractères 16pt). Un smartphone reflète la lumière sur les photos de mariage, risque de se verrouiller en plein discours et donne une impression d'impréparation."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Comment Rédiger et Chronométrer un Discours de Mariage",
      "description": "Méthode pas à pas pour structurer, minuter et imprimer des fiches de discours prêtes pour le jour J.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Choisir un Modèle ou Coller son Texte",
          "text": "Sélectionnez votre rôle (Témoin du Marié, Témoin de la Mariée, Père de la Mariée, Remerciements des Mariés) ou collez votre brouillon."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Viser l'Équilibre 3 à 5 Minutes (400–650 Mots)",
          "text": "Ajustez le volume de texte pour atteindre le créneau optimal de 3 à 5 minutes à 130 mots par minute."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Répéter à Voix Haute avec le Chronomètre",
          "text": "Lisez votre texte à haute voix en utilisant le chronomètre interactif pour caler votre respiration naturelle."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Exporter les Fiches Mémo (PDF / Word)",
          "text": "Générez vos fiches en grand format 16pt avec numérotation des paragraphes et repères de pause."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur Durée Discours de Mariage & Fiches Mémo (Gratuit) | Manage.Wedding"
	description="Calculez le temps de parole exact et le nombre de mots pour votre discours de témoin, demoiselle d'honneur ou parents. Modèles gratuits, minuteur et fiches PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Chronomètre & Discours de Mariage" category="stationery" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<span class="badge-postit">Calculateur de Débit & Fiches Répétition</span>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculateur de Durée <span class="accent-italic">des Discours de Mariage</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Mesurez le temps de parole exact, ajustez le débit de diction, entraînez-vous avec le chronomètre de répétition et imprimez vos <strong>fiches mémo en 16pt</strong> en Word et PDF — <strong>100% confidentiel, local et sans IA</strong> !
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Comment Réussir et Caler son Discours en 3 Étapes
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Coller son Texte ou Charger un Modèle
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Collez votre brouillon ou chargez un modèle éprouvé (Témoin du Marié, Témoin de la Mariée, Parents ou Mariés).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Ajuster le Débit & Répéter
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Choisissez votre rythme (110, 130 ou 155 mots/min) et entraînez-vous à voix haute avec le chronomètre interactif.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Imprimer les Fiches Mémo 16pt
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Cliquez sur <strong>"🖨️ Fiches PDF"</strong> pour obtenir des fiches cartonnées faciles à lire sous la lumière tamisée de la salle.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Editor Form + Live Time Dashboard & Stopwatch -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: start; margin-bottom: 3.5rem;">
			
			<!-- Left Column: Speech Text Editor & Preset Loader -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
						<div>
							<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								📝 Rédacteur & Éditeur de Discours
							</h2>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
								Analyse locale et privée (aucun texte n'est transmis sur internet)
							</span>
						</div>
						<button type="button" id="btn-clear-speech" class="hand-btn secondary" style="padding: 0.25rem 0.55rem; font-size: 0.75rem; color: #b91c1c;">
							🗑️ Effacer
						</button>
					</div>
				</div>

				<!-- Quick Template Pills -->
				<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.65rem; margin-bottom: 1rem;">
					<span class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil); display: block; margin-bottom: 0.35rem;">
						⚡ Charger un Modèle de Discours Prédéfini :
					</span>
					<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
						<button type="button" class="btn-load-template hand-btn" data-type="bestman" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; background: #eff6ff;">
							🤵 Témoin du Marié
						</button>
						<button type="button" class="btn-load-template hand-btn" data-type="moh" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; background: #fdf2f8;">
							💐 Témoin de la Mariée
						</button>
						<button type="button" class="btn-load-template hand-btn" data-type="parent" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; background: #f0fdf4;">
							🥂 Discours des Parents
						</button>
						<button type="button" class="btn-load-template hand-btn" data-type="couple" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; background: #fefce8;">
							💍 Mot des Mariés
						</button>
					</div>
				</div>

				<!-- Speech Textarea -->
				<div style="margin-bottom: 1rem;">
					<label for="speech-editor" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Tapez ou Collez votre Texte ici :
					</label>
					<textarea id="speech-editor" rows="14" placeholder="Commencez à saisir votre discours, vos vœux ou votre toast ici..." style="width: 100%; box-sizing: border-box; padding: 0.85rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; line-height: 1.6; background: #faf8f5; resize: vertical;"></textarea>
				</div>

				<!-- Pacing & Delivery Controls -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<div>
						<label for="select-speaking-pace" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--accent-red); margin-bottom: 0.2rem;">
							Débit de Parole
						</label>
						<select id="select-speaking-pace" style="width: 100%; box-sizing: border-box; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
							<option value="110">Posé & Émotionnel (110 mots/min)</option>
							<option value="130" selected>Naturel / Conversationnel (130 mots/min)</option>
							<option value="155">Dynamique & Énergique (155 mots/min)</option>
						</select>
					</div>

					<div>
						<label for="select-pause-buffer" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--accent-blue); margin-bottom: 0.2rem;">
							Marge pour Rires & Toasts
						</label>
						<select id="select-pause-buffer" style="width: 100%; box-sizing: border-box; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
							<option value="0">Aucune (Lecture brute)</option>
							<option value="30" selected>+30s (Rires et réactions modérés)</option>
							<option value="60">+60s (Beaucoup d'humour et d'applaudissements)</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Time Dashboard, Progress Bar & Live Stopwatch -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Timing Dashboard Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								⏱️ Estimation du Temps de Parole
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Calculé à <span id="display-wpm-rate">130</span> mots par minute
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Fiches PDF / Imprimer
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Big Estimated Time Display -->
					<div style="background: #f0fdf4; border: 2.5px solid #16a34a; border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.25rem;">
						<span style="font-size: 0.88rem; color: #16a34a; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
							Temps de Parole Estimé
						</span>
						<strong id="display-time-result" class="font-heading" style="font-size: 2.8rem; color: #166534; display: block; line-height: 1.15; margin: 0.2rem 0;">
							3m 45s
						</strong>
						<span id="display-speech-zone" style="font-size: 0.85rem; font-weight: bold; color: #15803d;">
							✅ Durée Idéale (Format parfait pour un mariage)
						</span>
					</div>

					<!-- Detailed Metric Numbers -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; text-align: center; margin-bottom: 1.25rem;">
						<div style="border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem; background: var(--bg-paper);">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Mots</span>
							<strong id="display-word-count" style="font-size: 1.2rem; color: var(--fg-pencil);">485</strong>
						</div>

						<div style="border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem; background: var(--bg-paper);">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Paragraphes</span>
							<strong id="display-paragraph-count" style="font-size: 1.2rem; color: var(--fg-pencil);">5</strong>
						</div>

						<div style="border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem; background: var(--bg-paper);">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Fiches Bristol</span>
							<strong id="display-cards-count" style="font-size: 1.2rem; color: var(--fg-pencil);">3 Fiches</strong>
						</div>
					</div>

					<!-- Speech Length Progress Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.25rem;">
							<span>0 min</span>
							<span style="color: #16a34a;">3 - 5 min (Idéal)</span>
							<span style="color: var(--accent-red);">7+ min (Trop long)</span>
						</div>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee; position: relative;">
							<div id="speech-gauge-bar" style="width: 50%; height: 100%; background: #16a34a; transition: width 0.3s ease, background-color 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Live Rehearsal Stopwatch Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem; text-align: center;">
						🎙️ Chronomètre de Répétition à Voix Haute
					</strong>
					<p style="font-size: 0.8rem; color: var(--text-secondary); margin: 0 0 0.75rem 0; text-align: center;">
						Lisez votre texte à voix haute pour comparer votre rythme réel à l'estimation :
					</p>

					<div style="display: flex; justify-content: center; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
						<span id="stopwatch-display" style="font-family: monospace; font-size: 2rem; font-weight: bold; color: var(--fg-pencil); background: #fff; padding: 0.3rem 0.8rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px;">
							00:00.0
						</span>
					</div>

					<div style="display: flex; justify-content: center; gap: 0.4rem;">
						<button type="button" id="btn-timer-start" class="hand-btn" style="padding: 0.35rem 0.85rem; font-size: 0.85rem; background: #dcfce7; color: #166534;">
							▶️ Lancer la Répétition
						</button>
						<button type="button" id="btn-timer-pause" class="hand-btn" style="padding: 0.35rem 0.85rem; font-size: 0.85rem; background: #fefce8; color: #854d0e; display: none;">
							⏸️ Pause
						</button>
						<button type="button" id="btn-timer-reset" class="hand-btn secondary" style="padding: 0.35rem 0.85rem; font-size: 0.85rem;">
							🔄 Réinitialiser
						</button>
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation (Cue Cards) -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Fiches Mémo Discours de Mariage (Manage.Wedding)</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Temps Estimé : <span id="print-est-time"></span> | Décompte : <span id="print-word-count"></span></p>
			</div>
			<div id="print-cue-cards-grid" style="display: flex; flex-direction: column; gap: 20px;"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Règle d'Or</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Guide Rapide : Durées et Nombre de Mots Recommandés
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>La Règle des 3 à 5 Minutes :</strong> Le format idéal pour captiver une salle est de <strong>3 à 5 minutes</strong>, ce qui correspond à <strong>390 à 650 mots</strong> à une cadence naturelle de <strong>130 mots par minute</strong>. En dessous de 2 minutes, le toast paraît expéditif ; au-delà de 6 minutes, l'assemblée décroche.
			</p>
			
			<!-- Benchmark Duration Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Durée du Discours</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Mots (130 mots/min Naturel)</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Mots (110 mots/min Posé)</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Rôle Recommandé</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Impact sur l'Auditoire</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">1 à 2 Minutes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">130 – 260 mots</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">110 – 220 mots</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Toast d'accueil / Témoin discret</td>
							<td style="padding: 0.6rem 0.8rem; color: var(--text-secondary);">Très court ; risque de paraître trop rapide</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #ecfdf5;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: #16a34a;">3 Minutes (Recommandé)</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: #16a34a;">390 mots</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: #16a34a;">330 mots</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Témoin / Demoiselle d'honneur</td>
							<td style="padding: 0.6rem 0.8rem; color: #16a34a; font-weight: 700;">⭐ Parfait : Émouvant, drôle et rythmé</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #ecfdf5;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: #16a34a;">4 à 5 Minutes (Sweet Spot)</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: #16a34a;">520 – 650 mots</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: #16a34a;">440 – 550 mots</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Parents de la Mariée ou du Marié</td>
							<td style="padding: 0.6rem 0.8rem; color: #16a34a; font-weight: 700;">⭐ Idéal : Permet de raconter une belle anecdote</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">6 Minutes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">780 mots</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">660 mots</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Vœux conjoints des Mariés</td>
							<td style="padding: 0.6rem 0.8rem; color: #d97706; font-weight: 600;">⚠️ Limite haute ; supprimer les blagues d'initiés</td>
						</tr>
						<tr>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red);">7+ Minutes</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; color: var(--accent-red);">900+ mots</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; color: var(--accent-red);">770+ mots</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; color: var(--accent-red);">Zone de Risque</td>
							<td style="padding: 0.6rem 0.8rem; color: var(--accent-red); font-weight: 700;">❌ Trop long : Les plats refroidissent, la salle s'impatiente</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/fr/wedding-speech-calculator" category="stationery" />

	</main>
</Layout>

<style>
	.print-only {
		display: none;
	}

	
</style>

<script is:inline>
	const sampleTemplates = {
		bestman: `Bonsoir à tous ! Pour ceux qui ne me connaissent pas, je m'appelle Julien, et j'ai l'immense honneur d'être le témoin et le meilleur ami d'Alexandre depuis nos années d'études.

Quand j'ai rencontré Alexandre pour la première fois, il m'avait confié ses trois grands rêves dans la vie : devenir un architecte reconnu, apprendre à cuisiner autre chose que des pâtes au beurre, et trouver une femme intelligente, rayonnante et surtout assez patiente pour supporter ses passions. Eh bien, en regardant la magnifique mariée ce soir, je dirais qu'il a réussi le plus beau des trois paris ! [Pause pour les rires]

Plus sérieusement, voir la façon dont ils se regardent est une véritable source d'inspiration. Éléonore apporte un calme, une joie et une tendresse dans sa vie qui le rendent profondément heureux. Vous formez un couple tout simplement parfait.

Je vous invite tous à lever vos verres avec moi : À une vie remplie de rires, d'aventures et d'un amour inconditionnel. Aux mariés ! Santé !`,

		moh: `Bonsoir tout le monde ! Je suis Camille, la sœur et témoin d'Éléonore. En la regardant ce soir, je suis tellement émue de la voir aussi rayonnante, heureuse et épanouie.

En grandissant ensemble, nous avons tout partagé : nos vêtements, nos confidences nocturnes et nos rêves sur ce que serait le grand jour. Quand elle m'a appelée après son deuxième rendez-vous avec Alexandre, elle ne m'a pas seulement dit qu'elle avait passé une bonne soirée... Elle m'a dit : 'Camille, je crois bien que je viens de rencontrer l'homme de ma vie.' [Pause pour les sourires]

Alexandre, merci de prendre soin de ma sœur comme de la reine qu'elle est au quotidien. La voir si heureuse à tes côtés est le plus beau cadeau pour notre famille.

Levons tous nos verres : Que votre mariage soit rempli d'une joie infinie, d'une grande complicité et de souvenirs magiques. Vive les mariés !`,

		parent: `Bienvenue à tous, famille et amis ! Au nom de nos deux familles, nous tenons à vous remercier chaleureusement d'avoir fait le voyage pour célébrer ce moment inoubliable avec nous.

Voir notre enfant grandir pour devenir la personne admirable, généreuse et aimante qui se tient devant nous aujourd'hui a été la plus grande fierté de notre vie. Et accueillir notre nouveau gendre dans notre famille nous comble de bonheur.

Le mariage est un choix de chaque jour : aimer, pardonner, s'épauler et rire ensemble à travers chaque saison de la vie. N'oubliez jamais les promesses que vous avez échangées aujourd'hui.

Levons nos verres : À l'amour, à la santé, au bonheur et à un avenir radieux ensemble ! Félicitations !`,

		couple: `Nous voulions prendre un court instant pour adresser un immense merci à chacun d'entre vous. Voir toutes les personnes qui comptent le plus pour nous réunies ce soir dans cette salle est un moment magique et inoubliable.

À nos parents : merci pour votre amour inconditionnel, vos sacrifices et le magnifique exemple de mariage que vous nous avez transmis. Nous ne serions pas là sans vous.

À nos témoins, demoiselles et garçons d'honneur, ainsi qu'à tous nos prestataires : merci d'avoir rendu cette journée fluide, festive et sans le moindre stress.

Et maintenant, place à la fête : le bar est ouvert, le DJ est prêt, enflammons la piste de danse ! Merci à tous ! [Levez vos verres]`
	};

	const speechEditor = document.getElementById('speech-editor');
	const paceSelect = document.getElementById('select-speaking-pace');
	const bufferSelect = document.getElementById('select-pause-buffer');
	const displayWpmRate = document.getElementById('display-wpm-rate');

	const displayTimeResult = document.getElementById('display-time-result');
	const displaySpeechZone = document.getElementById('display-speech-zone');
	const displayWordCount = document.getElementById('display-word-count');
	const displayParagraphCount = document.getElementById('display-paragraph-count');
	const displayCardsCount = document.getElementById('display-cards-count');
	const speechGaugeBar = document.getElementById('speech-gauge-bar');

	function calculateStats() {
		const text = speechEditor.value.trim();
		const wpm = parseInt(paceSelect.value) || 130;
		const bufferSec = parseInt(bufferSelect.value) || 30;

		displayWpmRate.textContent = wpm;

		let words = 0;
		let paragraphs = 0;

		if (text.length > 0) {
			words = text.split(/\s+/).filter(w => w.length > 0).length;
			paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0).length;
		}

		displayWordCount.textContent = words;
		displayParagraphCount.textContent = paragraphs;

		const estimatedCards = Math.max(1, Math.ceil(words / 150));
		displayCardsCount.textContent = `${estimatedCards} Fiche${estimatedCards > 1 ? 's' : ''}`;

		let totalSeconds = 0;
		if (words > 0) {
			totalSeconds = Math.round((words / wpm) * 60) + bufferSec;
		}

		const mins = Math.floor(totalSeconds / 60);
		const secs = totalSeconds % 60;
		displayTimeResult.textContent = `${mins}m ${secs}s`;

		const totalMins = totalSeconds / 60;
		const pct = Math.min(100, Math.max(5, (totalMins / 8) * 100));
		speechGaugeBar.style.width = `${words === 0 ? 0 : pct}%`;

		if (words === 0) {
			displaySpeechZone.textContent = "Commencez à écrire ou chargez un modèle ci-dessus";
			displaySpeechZone.style.color = "var(--text-secondary)";
			speechGaugeBar.style.backgroundColor = "#ccc";
		} else if (totalMins < 2.5) {
			displaySpeechZone.textContent = "⚡ Court & Rapide (Envisagez d'ajouter une anecdote)";
			displaySpeechZone.style.color = "var(--accent-blue)";
			speechGaugeBar.style.backgroundColor = "var(--accent-blue)";
		} else if (totalMins >= 2.5 && totalMins <= 5.5) {
			displaySpeechZone.textContent = "✅ Durée Idéale (Le format parfait pour captiver la salle)";
			displaySpeechZone.style.color = "#15803d";
			speechGaugeBar.style.backgroundColor = "#16a34a";
		} else if (totalMins > 5.5 && totalMins <= 7.0) {
			displaySpeechZone.textContent = "⚠️ Un peu long (Coupez quelques détails ou blagues privées)";
			displaySpeechZone.style.color = "#ca8a04";
			speechGaugeBar.style.backgroundColor = "#eab308";
		} else {
			displaySpeechZone.textContent = "🛑 Trop long (Réduisez de 30% pour ne pas retarder le traiteur)";
			displaySpeechZone.style.color = "var(--accent-red)";
			speechGaugeBar.style.backgroundColor = "var(--accent-red)";
		}
	}

	document.querySelectorAll('.btn-load-template').forEach(btn => {
		btn.addEventListener('click', () => {
			const type = btn.getAttribute('data-type');
			if (sampleTemplates[type]) {
				speechEditor.value = sampleTemplates[type];
				calculateStats();
			}
		});
	});

	document.getElementById('btn-clear-speech').addEventListener('click', () => {
		speechEditor.value = '';
		calculateStats();
	});

	speechEditor.addEventListener('input', calculateStats);
	paceSelect.addEventListener('change', calculateStats);
	bufferSelect.addEventListener('change', calculateStats);

	let timerInterval = null;
	let startTime = 0;
	let elapsedTime = 0;
	let isRunning = false;

	const stopwatchDisplay = document.getElementById('stopwatch-display');
	const btnTimerStart = document.getElementById('btn-timer-start');
	const btnTimerPause = document.getElementById('btn-timer-pause');
	const btnTimerReset = document.getElementById('btn-timer-reset');

	function formatStopwatch(ms) {
		const totalSec = Math.floor(ms / 1000);
		const m = Math.floor(totalSec / 60).toString().padStart(2, '0');
		const s = (totalSec % 60).toString().padStart(2, '0');
		const tenth = Math.floor((ms % 1000) / 100);
		return `${m}:${s}.${tenth}`;
	}

	btnTimerStart.addEventListener('click', () => {
		if (!isRunning) {
			isRunning = true;
			startTime = Date.now() - elapsedTime;
			timerInterval = setInterval(() => {
				elapsedTime = Date.now() - startTime;
				stopwatchDisplay.textContent = formatStopwatch(elapsedTime);
			}, 100);
			btnTimerStart.style.display = 'none';
			btnTimerPause.style.display = 'inline-block';
		}
	});

	btnTimerPause.addEventListener('click', () => {
		if (isRunning) {
			isRunning = false;
			clearInterval(timerInterval);
			btnTimerStart.style.display = 'inline-block';
			btnTimerStart.textContent = '▶️ Reprendre';
			btnTimerPause.style.display = 'none';
		}
	});

	btnTimerReset.addEventListener('click', () => {
		isRunning = false;
		clearInterval(timerInterval);
		elapsedTime = 0;
		stopwatchDisplay.textContent = '00:00.0';
		btnTimerStart.style.display = 'inline-block';
		btnTimerStart.textContent = '▶️ Lancer la Répétition';
		btnTimerPause.style.display = 'none';
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const text = speechEditor.value.trim() || 'Aucun texte de discours saisi.';
		const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);

		let pTags = '';
		paragraphs.forEach((p, idx) => {
			pTags += `<p style="font-size:16pt; line-height:1.7; margin-bottom:18pt; color:#111;"><strong>[${idx + 1}]</strong> ${p}</p>`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Fiches Discours de Mariage</title>
				<style>
					body { font-family: 'Segoe UI', Calibri, Arial, sans-serif; padding: 30px; font-size: 16pt; }
					h1 { color: #1e3a8a; font-size: 22pt; margin-bottom: 5pt; }
					.meta-box { border: 1pt solid #ccc; background: #f8fafc; padding: 10pt; font-size: 11pt; margin-bottom: 25pt; color: #475569; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Fiches Mémo Discours</h1>
				<div class="meta-box">
					<strong>Temps Estimé :</strong> ${displayTimeResult.textContent} | 
					<strong>Décompte :</strong> ${displayWordCount.textContent} mots | 
					<strong>Débit :</strong> ${displayWpmRate.textContent} mots/min
				</div>
				${pTags}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `fiches-discours-mariage-${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-est-time').textContent = displayTimeResult.textContent;
		document.getElementById('print-word-count').textContent = `${displayWordCount.textContent} mots`;

		const grid = document.getElementById('print-cue-cards-grid');
		grid.innerHTML = '';

		const text = speechEditor.value.trim() || 'Aucun texte de discours saisi.';
		const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);

		for (let i = 0; i < paragraphs.length; i += 2) {
			const cardNum = Math.floor(i / 2) + 1;
			const totalCards = Math.ceil(paragraphs.length / 2);

			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 25px; page-break-inside: avoid; font-family: 'Times New Roman', serif; background: #fff; margin-bottom: 20px;`;
			
			let inner = `<div style="display:flex; justify-content:space-between; border-bottom:1px solid #000; padding-bottom:5px; margin-bottom:15px; font-size:12px; font-weight:bold;"><span>FICHE ${cardNum} SUR ${totalCards}</span><span>TEMPS : ${displayTimeResult.textContent}</span></div>`;
			
			inner += `<p style="font-size:16px; line-height:1.6; margin-bottom:12px;"><strong>[${i + 1}]</strong> ${paragraphs[i]}</p>`;
			if (paragraphs[i + 1]) {
				inner += `<p style="font-size:16px; line-height:1.6; margin-bottom:0;"><strong>[${i + 2}]</strong> ${paragraphs[i + 1]}</p>`;
			}

			card.innerHTML = inner;
			grid.appendChild(card);
		}

		window.print();
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Métrique,Valeur\n";
		csv += `"Temps de Parole Estimé","${displayTimeResult.textContent}"\n`;
		csv += `"Nombre de Mots","${displayWordCount.textContent}"\n`;
		csv += `"Nombre de Paragraphes","${displayParagraphCount.textContent}"\n`;
		csv += `"Débit de Parole","${displayWpmRate.textContent} mots/min"\n`;
		csv += `"Zone de Durée","${displaySpeechZone.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `duree-discours-mariage.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	speechEditor.value = sampleTemplates.bestman;
	calculateStats();
</script>
