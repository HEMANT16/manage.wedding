<script is:inline>
	let currencySymbol = '€';

	const currencySelect = document.getElementById('currency-select');
	const chkCatererIncluded = document.getElementById('chk-caterer-included');
	const inputCatererBill = document.getElementById('input-caterer-bill');
	const selectCatererRate = document.getElementById('select-caterer-rate');

	const inputBeautyBill = document.getElementById('input-beauty-bill');
	const selectBeautyRate = document.getElementById('select-beauty-rate');

	const selectPhotoLead = document.getElementById('select-photo-lead');
	const selectPhotoSecond = document.getElementById('select-photo-second');

	const selectDjTip = document.getElementById('select-dj-tip');
	const selectBandTip = document.getElementById('select-band-tip');

	const selectPlannerTip = document.getElementById('select-planner-tip');
	const selectDriverTip = document.getElementById('select-driver-tip');
	const selectOfficiantTip = document.getElementById('select-officiant-tip');
	const selectDeliveryTip = document.getElementById('select-delivery-tip');
	const selectCakeTip = document.getElementById('select-cake-tip');

	// Result Elements
	const resTotalGratuity = document.getElementById('res-total-gratuity');
	const resEnvelopeCount = document.getElementById('res-envelope-count');
	const resCatererTip = document.getElementById('res-caterer-tip');
	const resBeautyTip = document.getElementById('res-beauty-tip');
	const resPhotoTip = document.getElementById('res-photo-tip');
	const resDjTip = document.getElementById('res-dj-tip');
	const resPlannerTip = document.getElementById('res-planner-tip');
	const resLogisticsTip = document.getElementById('res-logistics-tip');
	const resDeliveryTip = document.getElementById('res-delivery-tip');

	const barCaterer = document.getElementById('bar-caterer');
	const barBeauty = document.getElementById('bar-beauty');
	const barPhoto = document.getElementById('bar-photo');
	const barDj = document.getElementById('bar-dj');
	const barPlanner = document.getElementById('bar-planner');
	const barOther = document.getElementById('bar-other');

	function formatMoney(amount) {
		return `${Math.round(amount).toLocaleString('fr-FR')} ${currencySymbol}`;
	}

	function calculateTips() {
		currencySymbol = currencySelect.value;

		// 1. Caterer
		let catererTip = 0;
		if (!chkCatererIncluded.checked) {
			const bill = parseFloat(inputCatererBill.value) || 0;
			const rate = selectCatererRate.value;
			if (rate === 'flat') {
				catererTip = 30 * 8; // Approx 8 serveurs
			} else if (rate === '150') {
				catererTip = 150;
			} else {
				catererTip = bill * parseFloat(rate);
			}
		}

		// 2. Beauty
		const beautyBill = parseFloat(inputBeautyBill.value) || 0;
		const beautyRateVal = selectBeautyRate.value;
		let beautyTip = 0;
		if (beautyRateVal === '50') {
			beautyTip = 50;
		} else {
			beautyTip = beautyBill * (parseFloat(beautyRateVal) || 0);
		}

		// 3. Photo / Video
		const photoLead = parseFloat(selectPhotoLead.value) || 0;
		const photoSecond = parseFloat(selectPhotoSecond.value) || 0;
		const photoTotal = photoLead + photoSecond;

		// 4. DJ & Band
		const djTip = parseFloat(selectDjTip.value) || 0;
		const bandTip = parseFloat(selectBandTip.value) || 0;
		const musicTotal = djTip + bandTip;

		// 5. Planner
		const plannerTip = parseFloat(selectPlannerTip.value) || 0;

		// 6. Drivers & Officiant
		const driverTip = parseFloat(selectDriverTip.value) || 0;
		const officiantTip = parseFloat(selectOfficiantTip.value) || 0;
		const logisticsTotal = driverTip + officiantTip;

		// 7. Delivery Crews
		const deliveryTip = parseFloat(selectDeliveryTip.value) || 0;
		const cakeTip = parseFloat(selectCakeTip.value) || 0;
		const deliveryTotal = deliveryTip + cakeTip;

		const grandTotal = catererTip + beautyTip + photoTotal + musicTotal + plannerTip + logisticsTotal + deliveryTotal;

		// Count active envelopes
		let count = 0;
		if (catererTip > 0) count++;
		if (beautyTip > 0) count++;
		if (photoLead > 0) count++;
		if (photoSecond > 0) count++;
		if (djTip > 0) count++;
		if (bandTip > 0) count++;
		if (plannerTip > 0) count++;
		if (driverTip > 0) count++;
		if (officiantTip > 0) count++;
		if (deliveryTotal > 0) count++;

		// Update UI
		resTotalGratuity.textContent = formatMoney(grandTotal);
		resEnvelopeCount.textContent = `Répartis dans ${count} Enveloppe${count > 1 ? 's' : ''} Nominative${count > 1 ? 's' : ''}`;
		resCatererTip.textContent = formatMoney(catererTip);
		resBeautyTip.textContent = formatMoney(beautyTip);
		resPhotoTip.textContent = formatMoney(photoTotal);
		resDjTip.textContent = formatMoney(musicTotal);
		resPlannerTip.textContent = formatMoney(plannerTip);
		resLogisticsTip.textContent = formatMoney(logisticsTotal);
		resDeliveryTip.textContent = formatMoney(deliveryTotal);

		// Bar Chart
		if (grandTotal > 0) {
			barCaterer.style.width = `${Math.round((catererTip / grandTotal) * 100)}%`;
			barBeauty.style.width = `${Math.round((beautyTip / grandTotal) * 100)}%`;
			barPhoto.style.width = `${Math.round((photoTotal / grandTotal) * 100)}%`;
			barDj.style.width = `${Math.round((musicTotal / grandTotal) * 100)}%`;
			barPlanner.style.width = `${Math.round((plannerTip / grandTotal) * 100)}%`;
			barOther.style.width = `${Math.round(((logisticsTotal + deliveryTotal) / grandTotal) * 100)}%`;
		}
	}

	// Listeners
	document.querySelectorAll('.tip-input, #chk-caterer-included').forEach(el => {
		el.addEventListener('input', calculateTips);
		el.addEventListener('change', calculateTips);
	});
	document.querySelectorAll('.tip-select, #currency-select').forEach(el => {
		el.addEventListener('change', calculateTips);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let rows = '';
		if (parseFloat(resCatererTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Équipe Service Traiteur</strong></td><td>Fin de Soirée</td><td>Témoin / Coordinatrice</td><td style="text-align:right; font-weight:bold;">${resCatererTip.textContent}</td></tr>`;
		}
		if (parseFloat(resBeautyTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Coiffure & Maquillage</strong></td><td>Fin des Préparatifs</td><td>Témoin / Mariée</td><td style="text-align:right; font-weight:bold;">${resBeautyTip.textContent}</td></tr>`;
		}
		if (parseFloat(selectPhotoLead.value) > 0) {
			rows += `<tr><td><strong>Photographe Principal</strong></td><td>Fin du Reportage</td><td>Témoin / Marié</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPhotoLead.value)}</td></tr>`;
		}
		if (parseFloat(selectPhotoSecond.value) > 0) {
			rows += `<tr><td><strong>Second Photographe / Assistant</strong></td><td>Fin du Reportage</td><td>Témoin</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPhotoSecond.value)}</td></tr>`;
		}
		if (parseFloat(selectDjTip.value) > 0) {
			rows += `<tr><td><strong>DJ de Soirée</strong></td><td>Fin de Soirée</td><td>Témoin</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectDjTip.value)}</td></tr>`;
		}
		if (parseFloat(selectPlannerTip.value) > 0) {
			rows += `<tr><td><strong>Wedding Planner / Coordinatrice</strong></td><td>Fin de Réception</td><td>Parents / Mariés</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPlannerTip.value)}</td></tr>`;
		}
		if (parseFloat(selectDriverTip.value) > 0) {
			rows += `<tr><td><strong>Chauffeur</strong></td><td>Après le Dernier Trajet</td><td>Témoin</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectDriverTip.value)}</td></tr>`;
		}
		if (parseFloat(selectOfficiantTip.value) > 0) {
			rows += `<tr><td><strong>Célébrant / Quête Paroisse</strong></td><td>Avant la Cérémonie</td><td>Témoin</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectOfficiantTip.value)}</td></tr>`;
		}
		if (parseFloat(resDeliveryTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Livreurs Déco & Pièce Montée</strong></td><td>Lors de la Livraison</td><td>Coordinatrice</td><td style="text-align:right; font-weight:bold;">${resDeliveryTip.textContent}</td></tr>`;
		}

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Planning des Pourboires Prestataires</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Planning de Remise des Pourboires</h1>
				<p>Généré le ${new Date().toLocaleDateString('fr-FR')} | Total Espèces : <strong>${resTotalGratuity.textContent}</strong> (${resEnvelopeCount.textContent})</p>
				
				<h3>Tableau des Enveloppes par Prestataire :</h3>
				<table>
					<thead>
						<tr>
							<th>Prestataire & Rôle</th>
							<th>Moment Conseillé</th>
							<th>Personne Déléguée</th>
							<th style="text-align:right;">Montant Espèces</th>
						</tr>
					</thead>
					<tbody>
						${rows}
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;">
							<td colspan="3">Total Espèces à Prévoir</td>
							<td style="text-align:right; color:#b91c1c;">${resTotalGratuity.textContent}</td>
						</tr>
					</tbody>
				</table>

				<h3 style="margin-top:25px;">Conseils pour le Jour J :</h3>
				<p>• Préparez les enveloppes nominatives fermées 3 jours avant le mariage.</p>
				<p>• Confiez l'ensemble des enveloppes à votre témoin principal le matin même.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Pourboires_Prestataires_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('fr-FR');
		document.getElementById('print-total').textContent = resTotalGratuity.textContent;

		const tbody = document.getElementById('print-tipping-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Équipe Service Traiteur</td><td style="border:1px solid #ccc; padding:6px;">Fin de Soirée</td><td style="border:1px solid #ccc; padding:6px;">Témoin / Coordinatrice</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resCatererTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Coiffure & Maquillage</td><td style="border:1px solid #ccc; padding:6px;">Fin des Préparatifs</td><td style="border:1px solid #ccc; padding:6px;">Témoin / Mariée</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBeautyTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Photographe & Vidéaste</td><td style="border:1px solid #ccc; padding:6px;">Fin du Reportage</td><td style="border:1px solid #ccc; padding:6px;">Témoin</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPhotoTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">DJ & Musiciens</td><td style="border:1px solid #ccc; padding:6px;">Fin de Soirée</td><td style="border:1px solid #ccc; padding:6px;">Témoin</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDjTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Wedding Planner / Coordinatrice</td><td style="border:1px solid #ccc; padding:6px;">Fin de Réception</td><td style="border:1px solid #ccc; padding:6px;">Parents / Mariés</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPlannerTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Chauffeur & Célébrant</td><td style="border:1px solid #ccc; padding:6px;">Après la Prestation</td><td style="border:1px solid #ccc; padding:6px;">Témoin</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resLogisticsTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Livreurs Déco & Pièce Montée</td><td style="border:1px solid #ccc; padding:6px;">À la Livraison</td><td style="border:1px solid #ccc; padding:6px;">Coordinatrice</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDeliveryTip.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td colspan="3" style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Total Gratifications Prévues</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#b91c1c;">${resTotalGratuity.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Prestataire & Role,Moment de Remise,Delegue Responsable,Montant Especes\n";
		csv += `"Equipe Service Traiteur","Fin de Soiree","Temoin / Coordinatrice","${resCatererTip.textContent}"\n`;
		csv += `"Coiffure & Maquillage","Fin des Preparatifs","Temoin / Mariee","${resBeautyTip.textContent}"\n`;
		csv += `"Photographe & Videaste","Fin du Reportage","Temoin","${resPhotoTip.textContent}"\n`;
		csv += `"DJ & Musiciens","Fin de Soiree","Temoin","${resDjTip.textContent}"\n`;
		csv += `"Wedding Planner","Fin de Reception","Parents / Maries","${resPlannerTip.textContent}"\n`;
		csv += `"Chauffeur & Celebrant","Apres Prestation","Temoin","${resLogisticsTip.textContent}"\n`;
		csv += `"Livreurs Deco & Gateau","A la Livraison","Coordinatrice","${resDeliveryTip.textContent}"\n`;
		csv += `"Total Gratifications","--","--","${resTotalGratuity.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Pourboires_Prestataires_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateTips();
</script>
