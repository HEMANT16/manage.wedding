---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/vendor-tipping-calculator/#webapp",
      "name": "Calculateur de Pourboires & Enveloppes Prestataires de Mariage",
      "url": "https://manage.wedding/fr/vendor-tipping-calculator",
      "description": "Calculateur gratuit de pourboires pour prestataires de mariage. Calculez les gratifications d'usage pour le traiteur, le DJ, le photographe, la wedding planner et la mise en beauté. Export d'enveloppes au format Word, PDF et CSV.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Calculer et Distribuer les Pourboires aux Prestataires de Mariage",
      "description": "Guide d'étiquette pour gratifier les équipes le jour J et préparer les enveloppes nominatives.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Vérifier les Contrats Traiteur et Lieu",
          "text": "Vérifiez si le service ou les frais de personnel incluent déjà une gratification obligatoire pour les serveurs et barmans."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Définir les Pourboires aux Prestataires Clés",
          "text": "Fixez un montant forfaitaire (50 € à 150 €) pour le DJ, le photographe, la maquilleuse ou la coordinatrice en cas d'implication exceptionnelle."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Préparer les Enveloppes d'Espèces à l'Avance",
          "text": "Glissez les espèces dans des enveloppes étiquetées nominativement 3 jours avant le mariage."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Déléguer la Remise au Témoin ou à la Wedding Planner",
          "text": "Confiez les enveloppes à un témoin de confiance pour les distribuer en fin de prestation sans perturber votre soirée."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Le pourboire est-il obligatoire pour les prestataires de mariage en France ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Non, en France et en Europe, le pourboire reste facultatif et constitue une marque d'appréciation pour un service exceptionnel (notamment pour l'équipe de service du traiteur ou les livreurs)."
          }
        },
        {
          "@type": "Question",
          "name": "Faut-il donner un pourboire à un prestataire qui est le gérant de son entreprise ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Selon la coutume, un artisan indépendant ou gérant (comme un photographe indépendant) fixe librement ses tarifs. Un pourboire en espèces n'est pas attendu, mais un avis 5 étoiles élogieux ou un cadeau symbolique est toujours très apprécié."
          }
        },
        {
          "@type": "Question",
          "name": "Qui doit remettre les enveloppes de pourboires le jour J ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les mariés ne doivent pas s'encombrer d'espèces le jour du mariage. Confiez toutes les enveloppes étiquetées au témoin principal ou à votre coordinatrice le matin même."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Guide & Calculateur de Pourboires Prestataires de Mariage (Enveloppes Jour J) | Manage.Wedding"
	description="Calculez les pourboires d'usage pour vos prestataires de mariage : traiteur, DJ, photographe, wedding planner, coiffure et maquillage. Export PDF et Word."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Pourboires & Enveloppes Prestataires" category="budget-finance" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculateur de Pourboires Prestataires
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Estimez les gratifications d'usage pour remercier vos professionnels du mariage. Personnalisez les montants et exportez vos <strong>Enveloppes d'Espèces</strong> vers <strong>Word (.doc)</strong> ou <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Organiser les Pourboires en 3 Étapes Simples
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Indiquez vos Prestataires
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Sélectionnez les professionnels engagés (traiteur, DJ, photographe, mise en beauté, chauffeur).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Ajustez les Montants Conseillés
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						L'outil applique les forfaits d'usage (30 € à 100 € par équipe ou 5% à 10% selon l'engagement).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Imprimez la Fiche de Remise Jour J
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Exportez le tableau récapitulatif pour votre témoin avec les heures recommandées de remise des enveloppes.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="tipping-calc-grid">
			
			<!-- Left Column: 10+ Vendor Categories Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							💵 Prestataires & Équipes
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Configurez les gratifications prévues
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Devise :</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="$">$ (USD/CAD)</option>
							<option value="£">£ (GBP)</option>
							<option value="CHF">CHF (Suisse)</option>
						</select>
					</div>
				</div>

				<form id="tipping-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Catering & Bartenders -->
					<div class="vendor-input-group">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
							<label class="font-heading" style="font-size: 1rem; color: var(--accent-red);">
								🍽️ Maître d'Hôtel & Équipe de Service Traiteur
							</label>
							<label style="font-size: 0.78rem; display: flex; align-items: center; gap: 0.3rem; cursor: pointer; color: var(--text-secondary);">
								<input type="checkbox" id="chk-caterer-included"> Pourboire déjà inclus au devis
							</label>
						</div>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Montant Total Traiteur (€)</span>
								<input type="number" id="input-caterer-bill" value="6500" min="0" step="100" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Mode de Gratification</span>
								<select id="select-caterer-rate" class="tip-select">
									<option value="flat" selected>Forfait 30 € par serveur (~8 serveurs : 240 €)</option>
									<option value="0.05">5% de la facture globale</option>
									<option value="0.08">8% de la facture globale</option>
									<option value="150">Forfait global d'équipe (150 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 2. Hair & Makeup (HMUA) -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: var(--accent-blue); display: block; margin-bottom: 0.3rem;">
							💄 Coiffure & Maquillage (Mise en Beauté)
						</label>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Facture Totale Beauté (€)</span>
								<input type="number" id="input-beauty-bill" value="450" min="0" step="50" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Pourcentage / Forfait</span>
								<select id="select-beauty-rate" class="tip-select">
									<option value="0.10" selected>10% du montant (45 €)</option>
									<option value="0.15">15% (Prestation haut de gamme)</option>
									<option value="50">Forfait fixe (50 €)</option>
									<option value="0">Aucun pourboire (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 3. Photography & Videography -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #16a34a; display: block; margin-bottom: 0.3rem;">
							📸 Photographe & Vidéaste
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Photographe Principal</span>
								<select id="select-photo-lead" class="tip-select">
									<option value="80" selected>Photographe Principal (80 € forfait)</option>
									<option value="100">Photographe Principal (100 €)</option>
									<option value="50">Photographe Principal (50 €)</option>
									<option value="0">Indépendant / Sans pourboire (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Second Photographe / Assistant</span>
								<select id="select-photo-second" class="tip-select">
									<option value="40" selected>Second Photographe (40 €)</option>
									<option value="50">Second Photographe (50 €)</option>
									<option value="0">Pas de second shooter (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 4. DJ & Entertainment -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #7c3aed; display: block; margin-bottom: 0.3rem;">
							🎵 DJ & Musiciens du Vin d'Honneur
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">DJ de Soirée</span>
								<select id="select-dj-tip" class="tip-select">
									<option value="80" selected>DJ Principal (80 € forfait)</option>
									<option value="100">DJ Principal (100 €)</option>
									<option value="50">DJ Principal (50 €)</option>
									<option value="0">Sans pourboire (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Groupe Live / Musiciens</span>
								<select id="select-band-tip" class="tip-select">
									<option value="30" selected>Musiciens (30 € / membre)</option>
									<option value="50">Musiciens (50 € / membre)</option>
									<option value="0">Pas de musiciens live (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 5. Wedding Planner & Coordinator -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #d97706; display: block; margin-bottom: 0.3rem;">
							📋 Wedding Planner / Coordinatrice Jour J
						</label>
						<div>
							<select id="select-planner-tip" class="tip-select">
								<option value="100" selected>Coordinatrice Jour J (100 € forfait)</option>
								<option value="150">Wedding Planner Complète (150 €)</option>
								<option value="50">Coordinatrice Jour J (50 €)</option>
								<option value="0">Gérante indépendante / Cadeau personnalisé (0 €)</option>
							</select>
						</div>
					</div>

					<!-- 6. Drivers, Officiant & Delivery Setup Crew -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block; text-align: center;">
							🚐 Chauffeur, Célébrant & Livreurs
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Chauffeur de Mariage</span>
								<select id="select-driver-tip" class="tip-select">
									<option value="40" selected>Chauffeur (40 € forfait)</option>
									<option value="60">Chauffeur navette (60 €)</option>
									<option value="0">Inclus dans la location (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Officiant / Don Église</span>
								<select id="select-officiant-tip" class="tip-select">
									<option value="50" selected>Officiant laïque / Quête église (50 €)</option>
									<option value="100">Don Paroisse / Célébrant (100 €)</option>
									<option value="0">Honoraires déjà réglés (0 €)</option>
								</select>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Livreurs Fleurs & Mobilier</span>
								<select id="select-delivery-tip" class="tip-select">
									<option value="30" selected>Équipe d'installation (30 €)</option>
									<option value="50">Installation complexe (50 €)</option>
									<option value="0">Sans pourboire (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Livreur Pièce Montée</span>
								<select id="select-cake-tip" class="tip-select">
									<option value="20" selected>Livreur Pâtisserie (20 €)</option>
									<option value="0">Sans pourboire (0 €)</option>
								</select>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Gratuity Breakdown & Cash Envelope Planner -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Gratuity Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								✉️ Budget Total Pourboires
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Espèces à prévoir pour les enveloppes Jour J
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimer PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Gratuity Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Montant Total d'Espèces à Retirer</span>
						<strong id="res-total-gratuity" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">685 €</strong>
						<span id="res-envelope-count" style="font-size: 0.8rem; color: var(--accent-red);">Répartis dans 8 Enveloppes Nominatives</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Récapitulatif par Prestataire
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Équipe Service Traiteur :</td>
									<td id="res-caterer-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">240 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">💄 Coiffure & Maquillage :</td>
									<td id="res-beauty-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">45 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📸 Photographe & Vidéaste :</td>
									<td id="res-photo-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">120 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🎵 DJ & Musiciens :</td>
									<td id="res-dj-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">110 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📋 Wedding Planner / Coordinatrice :</td>
									<td id="res-planner-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">100 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🚐 Chauffeur & Célébrant :</td>
									<td id="res-logistics-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">90 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0;">🌸 Livreurs Déco & Gâteau :</td>
									<td id="res-delivery-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">50 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Gratuity Distribution Bar Chart -->
					<div>
						<span class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.3rem; text-align: center;">
							Répartition des Pourboires
						</span>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; display: flex; background: #eee;">
							<div id="bar-caterer" style="width: 40%; background: var(--accent-red); transition: width 0.3s ease;"></div>
							<div id="bar-beauty" style="width: 10%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-photo" style="width: 15%; background: #16a34a; transition: width 0.3s ease;"></div>
