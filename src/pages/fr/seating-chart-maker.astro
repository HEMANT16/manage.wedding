---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/seating-chart-maker/#webapp",
      "name": "Créateur de Plan de Table de Mariage",
      "url": "https://manage.wedding/fr/seating-chart-maker",
      "description": "Créez votre plan de table de mariage par glisser-déposer. Organisez vos tables rondes, rectangulaires et table d'honneur, suivez les capacités et exportez en Word, PDF ou Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Créer son Plan de Table de Mariage en 4 Étapes",
      "description": "Méthode pour disposer ses tables de réception, placer ses invités et exporter le document pour le traiteur.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Configurer les Tables de Réception",
          "text": "Ajoutez des tables rondes (150 cm ou 180 cm), rectangulaires ou une table d'honneur et définissez le nombre de chaises."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Regrouper par Cercles d'Affinités",
          "text": "Rassemblez les invités par liens de parenté, groupes d'amis, collègues ou générations pour favoriser une ambiance chaleureuse."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Assigner les Places",
          "text": "Glissez-déposez les cartes d'invités ou utilisez le sélecteur rapide pour placer chaque convive à sa table."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Exporter le Récapitulatif",
          "text": "Téléchargez le plan de table finalisé en Word (.doc), PDF ou Excel pour votre traiteur et votre décorateur."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien d'invités peut-on installer par table ronde ou rectangulaire ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Une table ronde standard de 150 cm accueille confortablement 8 personnes (max 10). Une table ronde de 180 cm accueille 10 personnes (max 12). Une table rectangulaire de 2 mètres accueille 6 à 8 personnes."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre table d'honneur et table des mariés (Sweetheart table) ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La table des mariés (Sweetheart table) réunit uniquement le couple pour un moment intime, laissant les témoins dîner avec leurs conjoints. La table d'honneur traditionnelle réunit les mariés, les témoins et la famille très proche."
          }
        },
        {
          "@type": "Question",
          "name": "Quand faut-il finaliser le plan de table de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le plan de table se finalise généralement 10 à 15 jours avant le mariage, une fois toutes les réponses RSVP reçues et le nombre de repas validé avec le traiteur."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Créateur de Plan de Table Mariage Gratuit (Glisser-Déposer) | Manage.Wedding"
	description="Créez votre plan de table de mariage en ligne gratuitement. Placez vos convives sur des tables rondes ou rectangulaires et exportez en Word (.doc), PDF ou Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Plan de Table" category="guests" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(30px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.15;">
					Créateur de Plan <span class="accent-italic">de Table de Mariage</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Placez vos invités confirmés sur des tables rondes, rectangulaires ou d'honneur. Contrôlez les capacités et exportez en <strong>Word (.doc)</strong>, <strong>PDF</strong> ou <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- 💡 3-Step Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
				<strong class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem;">
					<span>💡</span> Comment utiliser l'outil en 3 étapes simples
				</strong>
				<span style="font-size: 0.85rem; color: var(--fg-pencil); font-family: var(--font-body); font-style: italic;">
					Prise en main immédiate !
				</span>
			</div>
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: var(--accent-blue); display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						1️⃣ Créer les Tables
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Cliquez sur <strong>"+ Nouvelle Table"</strong>. Choisissez la forme (⭕ Ronde, ▭ Rectangulaire, ❤️ Table d'Honneur) et le nombre de chaises.
					</p>
				</div>

				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: #15803d; display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						2️⃣ Placer les Invités
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Glissez les cartes depuis la colonne <strong>Non assignés</strong>, ou utilisez le bouton <strong>"⚡ Remplissage Auto"</strong>.
					</p>
				</div>

				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: var(--accent-red); display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						3️⃣ Exporter le Plan
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Téléchargez le document propre en <strong>Word</strong> ou <strong>PDF</strong> pour le remettre à votre traiteur et coordinateur.
					</p>
				</div>
			</div>
		</div>

		<!-- Overview Dashboard & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						🪑 Progression du Placement en Salle
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Synchronisé avec votre Liste d'Invités et Suivi RSVP
					</span>
				</div>

				<!-- Export & Control Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Export Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Export PDF / Imprimer
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Export Excel (.csv)
					</button>
					<button type="button" id="btn-add-table" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Nouvelle Table
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						🔄 Exemple
					</button>
					<button type="button" id="btn-clear-seating" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🧹 Réinitialiser
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Invités Présents</span>
					<strong id="stat-total-attending" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Places à Assigner</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Invités Placés</span>
					<strong id="stat-seated-count" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-seated-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% placés</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Non Assignés</span>
					<strong id="stat-unassigned-count" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span style="font-size: 0.75rem; color: #854d0e; display: block;">En attente de table</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Tables en Salle</span>
					<strong id="stat-table-count" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">0</strong>
					<span id="stat-capacity-total" style="font-size: 0.75rem; color: #1e40af; display: block;">0 Chaises Totales</span>
				</div>
			</div>

			<!-- Dynamic Seating Progress Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Progression du Placement</span>
					<span id="progress-text" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">0% Placé</span>
				</div>
				<div style="height: 24px; border: 2px solid var(--fg-pencil); border-radius: 12px; overflow: hidden; background: #e5e0d8;">
					<div id="progress-bar-fill" style="height: 100%; width: 0%; background-color: #22c55e; transition: width 0.3s ease;"></div>
				</div>
			</div>
		</div>

		<!-- Interactive Seating Studio Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="seating-workspace-grid">
			
			<!-- Left Column: Unassigned Guests Tray + Quick Add -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						👥 Non Assignés (<span id="unassigned-badge-count">0</span>)
					</h3>
					<button type="button" id="btn-auto-assign" class="hand-btn secondary" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">
						⚡ Remplissage Auto
					</button>
				</div>

				<!-- Search Unassigned -->
				<div style="margin-bottom: 0.75rem;">
					<input type="text" id="unassigned-search" placeholder="🔍 Filtrer les non assignés..." style="width: 100%; box-sizing: border-box; padding: 0.55rem 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: var(--bg-paper); color: var(--fg-pencil);">
				</div>

				<!-- Drop Zone for Unassigned -->
				<div id="unassigned-dropzone" class="drop-zone" data-table-id="unassigned" style="min-height: 240px; max-height: 480px; overflow-y: auto; padding: 0.5rem; border: 2px dashed var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); display: flex; flex-direction: column; gap: 0.5rem;">
				</div>

				<!-- Quick Add Guest Directly -->
				<div style="margin-top: 1.25rem; border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
					<label for="quick-guest-name" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						➕ Ajout Rapide d'un Invité :
					</label>
					<form id="quick-add-guest-form" style="display: flex; gap: 0.4rem; align-items: center;">
						<input type="text" id="quick-guest-name" required placeholder="Nom de l'invité..." style="flex: 1; min-width: 0; padding: 0.55rem 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: var(--bg-paper); color: var(--fg-pencil);">
						<select id="quick-guest-party" title="Nombre de places" style="width: 80px; padding: 0.55rem 0.25rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff; color: var(--fg-pencil);">
							<option value="1">1 Place</option>
							<option value="2" selected>2 Places</option>
							<option value="3">3 Places</option>
							<option value="4">4 Places</option>
							<option value="5">5 Places</option>
						</select>
						<button type="submit" class="hand-btn" style="padding: 0.55rem 0.85rem; font-size: 0.95rem; white-space: nowrap;">
							➕ Ajouter
						</button>
					</form>
				</div>

			</div>

			<!-- Right Column: Interactive Reception Tables Layout Grid -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h3 class="font-heading" style="font-size: 1.4rem; margin: 0; color: var(--fg-pencil);">
							🍽️ Tables de la Salle de Réception
						</h3>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
							Glissez les cartes d'invités sur les tables ou utilisez le menu déroulant
						</span>
					</div>
					
					<button type="button" id="btn-add-table-top" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
						➕ Nouvelle Table
					</button>
				</div>

				<!-- Tables Grid Container -->
				<div id="tables-grid-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;">
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Plan de Table Officiel</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Généré le : <span id="print-date"></span> | Total Invités Placés : <span id="print-seated-count"></span></p>
			</div>
			<div id="print-tables-content"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Repères & Dimensions des Tables de Réception
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					Guide Pratique
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Capacités Idéales par Format de Table :</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Ronde 150 cm (5ft) = 8 à 10 Personnes</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Ronde 180 cm (6ft) = 10 à 12 Personnes</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Banquet Rectangulaire (2 m) = 6 à 8 Personnes</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Espace de Circulation :</strong> Conservez au minimum <strong>1,50 mètre</strong> de distance entre les bords des tables pour permettre le recul des chaises et le passage fluide des serveurs avec les plateaux.
				</p>
			</div>
		</div>

		<RelatedTools currentPath="/fr/seating-chart-maker" category="guests" />

	</main>
</Layout>

<style>
	.seating-workspace-grid {
		display: grid;
		grid-template-columns: 1fr;
	}
	@media (min-width: 992px) {
		.seating-workspace-grid {
			grid-template-columns: 340px 1fr;
		}
	}

	.table-box-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 6px;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		box-shadow: 3px 3px 0px var(--fg-pencil);
	}

	.table-header-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 0.5rem;
		border-bottom: 1px dashed var(--fg-pencil);
		padding-bottom: 0.5rem;
	}

	.cap-badge {
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
		font-size: 0.85rem;
		font-weight: bold;
		border: 1px solid var(--fg-pencil);
		background: #f0fdf4;
		color: #166534;
	}
	.cap-full {
		background: #eff6ff;
		color: #1e40af;
	}
	.cap-over {
		background: #fee2e2;
		color: #991b1b;
	}

	.seat-dot {
		display: inline-block;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		margin-right: 4px;
		border: 1px solid var(--fg-pencil);
	}
	.seat-dot.filled {
		background-color: var(--accent-blue);
	}
	.seat-dot.empty {
		background-color: #fff;
	}

	.drop-zone {
		border: 1.5px dashed #ccc;
		border-radius: 4px;
		padding: 0.4rem;
		min-height: 80px;
		background: #faf8f5;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		transition: background 0.15s ease;
	}
	.drop-zone.drag-over {
		background: #eff6ff;
		border-color: var(--accent-blue);
	}

	.guest-drag-card {
		background: #fff;
		border: 1px solid var(--fg-pencil);
		border-radius: 4px;
		padding: 0.45rem 0.6rem;
		cursor: grab;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		box-shadow: 2px 2px 0px rgba(0,0,0,0.06);
	}
	.guest-drag-card:active {
		cursor: grabbing;
	}

	.seated-guest-row {
		background: #fff;
		border: 1px solid #ddd;
		border-radius: 3px;
		padding: 0.35rem 0.5rem;
		cursor: grab;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.85rem;
	}

	.unseat-btn {
		background: none;
		border: none;
		color: var(--accent-red);
		cursor: pointer;
		font-size: 0.85rem;
		padding: 0 0.2rem;
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 20px;
		}
	}
</style>

<script is:inline>
	const GUEST_STORAGE_KEY = 'manage_wedding_guests';
	const TABLE_STORAGE_KEY = 'manage_wedding_tables';

	const defaultTables = [
		{ id: 'table-1', name: 'Table 1 (Famille Mariée)', capacity: 8, shape: 'Round' },
		{ id: 'table-2', name: 'Table 2 (Famille Marié)', capacity: 8, shape: 'Round' },
		{ id: 'table-3', name: 'Table 3 (Amis Promo)', capacity: 8, shape: 'Round' },
		{ id: 'table-head', name: 'Table des Mariés', capacity: 2, shape: 'Sweetheart' }
	];

	const defaultSampleGuests = [
		{ id: '1', name: 'Éléonore & Marc Vaneau', group: "Famille de la Mariée", partySize: 2, rsvpStatus: 'Attending', dietary: 'Bœuf / Viande', tableId: 'table-1' },
		{ id: '2', name: 'Julien Sterling', group: "Famille du Marié", partySize: 2, rsvpStatus: 'Attending', dietary: 'Poisson', tableId: 'table-2' },
		{ id: '3', name: 'Maya Lin', group: "Témoins / Cortège / VIP", partySize: 1, rsvpStatus: 'Attending', dietary: 'Végétarien', tableId: 'table-head' },
		{ id: '4', name: 'Sarah & Thomas Wilson', group: "Amis Communs", partySize: 2, rsvpStatus: 'Attending', dietary: 'Bœuf / Viande', tableId: 'table-3' },
		{ id: '5', name: 'David Meunier', group: "Amis du Marié", partySize: 2, rsvpStatus: 'Attending', dietary: 'Volaille', tableId: 'table-3' },
		{ id: '6', name: 'Chloé Bernard', group: "Amis de la Mariée", partySize: 2, rsvpStatus: 'Attending', dietary: 'Sans Gluten', tableId: null },
		{ id: '7', name: 'Tante Claire', group: "Famille de la Mariée", partySize: 1, rsvpStatus: 'Attending', dietary: 'Volaille', tableId: 'table-1' },
		{ id: '8', name: 'Marc Brossard', group: "Collègues", partySize: 1, rsvpStatus: 'Attending', dietary: 'Aucun', tableId: null }
	];

	let guests = [];
	let tables = [];

	function loadData() {
		const rawGuests = localStorage.getItem(GUEST_STORAGE_KEY);
		if (rawGuests) {
			try {
				const all = JSON.parse(rawGuests);
				guests = all.filter(g => (g.rsvpStatus === 'Attending' || g.status === 'attending'));
				guests.forEach(g => {
					if (!g.partySize) g.partySize = 1;
				});
			} catch (e) {
				guests = [];
			}
		} else {
			guests = JSON.parse(JSON.stringify(defaultSampleGuests));
			saveGuestsData();
		}

		const rawTables = localStorage.getItem(TABLE_STORAGE_KEY);
		if (rawTables) {
			try {
				tables = JSON.parse(rawTables);
			} catch (e) {
				tables = JSON.parse(JSON.stringify(defaultTables));
			}
		} else {
			tables = JSON.parse(JSON.stringify(defaultTables));
			saveTablesData();
		}
	}

	function saveGuestsData() {
		const rawGuests = localStorage.getItem(GUEST_STORAGE_KEY);
		let all = [];
		if (rawGuests) {
			try { all = JSON.parse(rawGuests); } catch (e) { all = []; }
		} else {
			all = JSON.parse(JSON.stringify(defaultSampleGuests));
		}

		guests.forEach(g => {
			const found = all.find(ag => ag.id === g.id);
			if (found) {
				found.tableId = g.tableId;
			}
		});

		localStorage.setItem(GUEST_STORAGE_KEY, JSON.stringify(all));
		updateProgressAndStats();
	}

	function saveTablesData() {
		localStorage.setItem(TABLE_STORAGE_KEY, JSON.stringify(tables));
		updateProgressAndStats();
	}

	const unassignedDropzone = document.getElementById('unassigned-dropzone');
	const tablesContainer = document.getElementById('tables-grid-container');
	const unassignedBadgeCount = document.getElementById('unassigned-badge-count');
	const unassignedSearch = document.getElementById('unassigned-search');

	const statTotalAttending = document.getElementById('stat-total-attending');
	const statSeatedCount = document.getElementById('stat-seated-count');
	const statSeatedPct = document.getElementById('stat-seated-pct');
	const statUnassignedCount = document.getElementById('stat-unassigned-count');
	const statTableCount = document.getElementById('stat-table-count');
	const statCapacityTotal = document.getElementById('stat-capacity-total');

	const progressBarFill = document.getElementById('progress-bar-fill');
	const progressText = document.getElementById('progress-text');

	function handleAddNewTable() {
		const newId = 'table-' + Date.now();
		const num = tables.length + 1;
		tables.push({
			id: newId,
			name: `Table ${num}`,
			capacity: 8,
			shape: 'Round'
		});
		saveTablesData();
		renderTables();
		renderGuests();
	}

	document.getElementById('btn-add-table').addEventListener('click', handleAddNewTable);
	document.getElementById('btn-add-table-top').addEventListener('click', handleAddNewTable);

	document.getElementById('quick-add-guest-form').addEventListener('submit', (e) => {
		e.preventDefault();
		const nameInput = document.getElementById('quick-guest-name');
		const partySelect = document.getElementById('quick-guest-party');

		const name = nameInput.value.trim();
		const partySize = parseInt(partySelect.value) || 1;

		if (!name) return;

		const newG = {
			id: Date.now().toString(),
			name,
			group: 'Général',
			partySize,
			rsvpStatus: 'Attending',
			dietary: 'Aucun',
			tableId: null
		};

		guests.unshift(newG);
		saveGuestsData();
		nameInput.value = '';
		renderGuests();
	});

	document.getElementById('btn-clear-seating').addEventListener('click', () => {
		if (confirm("Réinitialiser le placement ? (Tous les invités retourneront dans Non assignés)")) {
			guests.forEach(g => { g.tableId = null; });
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	});

	document.getElementById('btn-sample-data').addEventListener('click', () => {
		guests = JSON.parse(JSON.stringify(defaultSampleGuests));
		tables = JSON.parse(JSON.stringify(defaultTables));
		saveTablesData();
		saveGuestsData();
		renderTables();
		renderGuests();
	});

	document.getElementById('btn-auto-assign').addEventListener('click', () => {
		const unassigned = guests.filter(g => !g.tableId);
		if (unassigned.length === 0) {
			alert("Tous les invités confirmés sont déjà placés !");
			return;
		}

		tables.forEach(t => {
			const currentSeated = guests.filter(g => g.tableId === t.id).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
			let space = t.capacity - currentSeated;

			unassigned.forEach(g => {
				const seats = parseInt(g.partySize) || 1;
				if (!g.tableId && seats <= space) {
					g.tableId = t.id;
					space -= seats;
				}
			});
		});

		saveGuestsData();
		renderTables();
		renderGuests();
	});

	unassignedSearch.addEventListener('input', renderGuests);

	window.handleDragStart = function(e) {
		e.dataTransfer.setData('text/plain', e.target.getAttribute('data-guest-id'));
	};

	window.handleDragOver = function(e) {
		e.preventDefault();
		const dropzone = e.target.closest('.drop-zone');
		if (dropzone) dropzone.classList.add('drag-over');
	};

	window.handleDragLeave = function(e) {
		const dropzone = e.target.closest('.drop-zone');
		if (dropzone) dropzone.classList.remove('drag-over');
	};

	window.handleDrop = function(e) {
		e.preventDefault();
		const dropzone = e.target.closest('.drop-zone');
		if (!dropzone) return;
		dropzone.classList.remove('drag-over');

		const guestId = e.dataTransfer.getData('text/plain');
		const targetTableId = dropzone.getAttribute('data-table-id');

		const g = guests.find(item => item.id === guestId);
		if (g) {
			g.tableId = targetTableId === 'unassigned' ? null : targetTableId;
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.moveGuestToTable = function(guestId, targetTableId) {
		const g = guests.find(item => item.id === guestId);
		if (g) {
			g.tableId = targetTableId === 'unassigned' ? null : targetTableId;
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.assignUnassignedGuestToTable = function(tableId, guestId) {
		if (!guestId) return;
		const g = guests.find(item => item.id === guestId);
		if (g) {
			g.tableId = tableId;
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.removeTable = function(tableId) {
		if (confirm("Supprimer cette table ? Les invités assignés retourneront dans Non assignés.")) {
			tables = tables.filter(t => t.id !== tableId);
			guests.forEach(g => {
				if (g.tableId === tableId) g.tableId = null;
			});
			saveTablesData();
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.updateTableName = function(tableId, newName) {
		const t = tables.find(item => item.id === tableId);
		if (t && newName.trim()) {
			t.name = newName.trim();
			saveTablesData();
		}
	};

	window.updateTableCapacity = function(tableId, newCap) {
		const t = tables.find(item => item.id === tableId);
		if (t) {
			t.capacity = parseInt(newCap) || 8;
			saveTablesData();
			renderTables();
			renderGuests();
		}
	};

	window.updateTableShape = function(tableId, newShape) {
		const t = tables.find(item => item.id === tableId);
		if (t) {
			t.shape = newShape;
			saveTablesData();
			renderTables();
			renderGuests();
		}
	};

	function renderTables() {
		tablesContainer.innerHTML = '';

		if (tables.length === 0) {
			tablesContainer.innerHTML = `
				<div style="grid-column: 1 / -1; text-align: center; padding: 2.5rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🍽️</div>
					<h4 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">Aucune Table Créée</h4>
					<p class="font-body" style="font-size: 0.95rem; margin-bottom: 1rem;">Cliquez sur "+ Nouvelle Table" pour créer votre première table.</p>
					<button type="button" class="hand-btn" onclick="handleAddNewTable()">➕ Ajouter une Première Table</button>
				</div>
			`;
			return;
		}

		tables.forEach(table => {
			const tableDiv = document.createElement('div');
			tableDiv.className = 'table-box-card';

			const tableGuests = guests.filter(g => g.tableId === table.id);
			const seatedSeats = tableGuests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

			let capClass = '';
			if (seatedSeats === table.capacity) capClass = 'cap-full';
			else if (seatedSeats > table.capacity) capClass = 'cap-over';

			let dotsHtml = '';
			for (let i = 0; i < table.capacity; i++) {
				if (i < seatedSeats) {
					dotsHtml += '<span class="seat-dot filled" title="Place occupée"></span>';
				} else {
					dotsHtml += '<span class="seat-dot empty" title="Place libre"></span>';
				}
			}
			if (seatedSeats > table.capacity) {
				dotsHtml += `<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold; margin-left: 3px;">+${seatedSeats - table.capacity} Trop !</span>`;
			}

			let shapeIcon = '⭕ Ronde';
			if (table.shape === 'Rectangular') shapeIcon = '▭ Rectangulaire';
			if (table.shape === 'Sweetheart') shapeIcon = '❤️ Mariés';

			const unassignedGuests = guests.filter(g => !g.tableId);
			let quickAssignOptions = '<option value="">➕ Placer un invité ici...</option>';
			unassignedGuests.forEach(ug => {
				quickAssignOptions += `<option value="${ug.id}">${ug.name} (${ug.partySize || 1} place${(ug.partySize || 1) > 1 ? 's' : ''})</option>`;
			});

			tableDiv.innerHTML = `
				<div class="table-header-row">
					<div style="flex: 1; min-width: 0; margin-right: 0.5rem;">
						<strong contenteditable="true" style="font-family: var(--font-heading); font-size: 1.15rem; color: var(--fg-pencil); outline: none; border-bottom: 1px dotted var(--fg-pencil); display: inline-block; max-width: 100%;" onblur="updateTableName('${table.id}', this.innerText)" title="Cliquer pour renommer">${table.name}</strong>
						<span style="display: block; font-size: 0.8rem; color: var(--text-secondary); margin-top: 2px;">
							${shapeIcon}
						</span>
					</div>
					<div style="display: flex; align-items: center; gap: 0.4rem;">
						<span class="cap-badge ${capClass}" title="Places occupées / Capacité table">
							${seatedSeats} / ${table.capacity}
						</span>
						<button type="button" style="background:none; border:none; color: var(--accent-red); cursor:pointer; font-size: 1.1rem; padding: 2px 4px;" title="Supprimer la table" onclick="removeTable('${table.id}')">✖</button>
					</div>
				</div>

				<div style="margin-bottom: 0.75rem; display: flex; align-items: center; flex-wrap: wrap;">
					${dotsHtml}
				</div>

				<div style="display: flex; gap: 0.5rem; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.03); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.35rem 0.5rem; margin-bottom: 0.75rem; font-size: 0.8rem;">
					<label style="display: flex; align-items: center; gap: 0.3rem;">
						<span>Chaises :</span>
						<input type="number" min="1" max="30" value="${table.capacity}" style="width: 42px; padding: 2px; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.85rem;" onchange="updateTableCapacity('${table.id}', this.value)">
					</label>
					<label style="display: flex; align-items: center; gap: 0.3rem;">
						<span>Forme :</span>
						<select style="padding: 2px 4px; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.8rem; background: #fff;" onchange="updateTableShape('${table.id}', this.value)">
							<option value="Round" ${table.shape === 'Round' ? 'selected' : ''}>Ronde</option>
							<option value="Rectangular" ${table.shape === 'Rectangular' ? 'selected' : ''}>Rectangulaire</option>
							<option value="Sweetheart" ${table.shape === 'Sweetheart' ? 'selected' : ''}>Mariés</option>
						</select>
					</label>
				</div>

				<div class="drop-zone" data-table-id="${table.id}" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)" style="flex: 1; min-height: 90px; margin-bottom: 0.75rem;">
				</div>

				<div style="margin-top: auto;">
					<select style="width: 100%; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;" onchange="assignUnassignedGuestToTable('${table.id}', this.value); this.value='';">
						${quickAssignOptions}
					</select>
				</div>
			`;

			tablesContainer.appendChild(tableDiv);
		});
	}

	function renderGuests() {
		unassignedDropzone.innerHTML = '';

		tables.forEach(t => {
			const zone = document.querySelector(`.drop-zone[data-table-id="${t.id}"]`);
			if (zone) zone.innerHTML = '';
		});

		let unassignedCount = 0;
		const query = unassignedSearch.value.toLowerCase().trim();

		guests.forEach(g => {
			const isAssigned = !!(g.tableId && document.querySelector(`.drop-zone[data-table-id="${g.tableId}"]`));

			if (isAssigned) {
				const targetZone = document.querySelector(`.drop-zone[data-table-id="${g.tableId}"]`);
				const row = document.createElement('div');
				row.className = 'seated-guest-row';
				row.draggable = true;
				row.setAttribute('data-guest-id', g.id);
				row.ondragstart = handleDragStart;

				row.innerHTML = `
					<div style="flex: 1; min-width: 0; padding-right: 0.25rem;">
						<strong style="display: block; font-size: 0.95rem; color: var(--fg-pencil); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${g.name}</strong>
						<span style="font-size: 0.75rem; color: var(--text-secondary);">
							${g.partySize > 1 ? `(${g.partySize} places) ` : ''}${g.dietary && g.dietary !== 'Aucun' && g.dietary !== 'None' ? `🍽️ ${g.dietary}` : ''}
						</span>
					</div>
					<button type="button" class="unseat-btn" title="Retirer de la table" onclick="moveGuestToTable('${g.id}', 'unassigned')">✖</button>
				`;
				targetZone.appendChild(row);

			} else {
				g.tableId = null;
				unassignedCount += (parseInt(g.partySize) || 1);

				const matchesSearch = !query || g.name.toLowerCase().includes(query) || (g.dietary && g.dietary.toLowerCase().includes(query)) || (g.group && g.group.toLowerCase().includes(query));

				if (matchesSearch) {
					const card = document.createElement('div');
					card.className = 'guest-drag-card';
					card.draggable = true;
					card.setAttribute('data-guest-id', g.id);
					card.ondragstart = handleDragStart;

					let optionsHtml = `<option value="unassigned" selected>🪑 Placer à...</option>`;
					tables.forEach(t => {
						optionsHtml += `<option value="${t.id}">${t.name}</option>`;
					});

					card.innerHTML = `
						<div style="flex: 1; min-width: 0;">
							<strong style="display: block; font-size: 0.95rem; color: var(--fg-pencil); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${g.name}</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">
								${g.partySize > 1 ? `(${g.partySize} places) ` : ''}${g.dietary && g.dietary !== 'Aucun' && g.dietary !== 'None' ? `🍽️ ${g.dietary}` : ''}
							</span>
						</div>
						<select style="font-size: 0.8rem; border: 1px solid var(--fg-pencil); border-radius: 3px; padding: 2px 4px; background: #fff;" onchange="moveGuestToTable('${g.id}', this.value)">
							${optionsHtml}
						</select>
					`;

					unassignedDropzone.appendChild(card);
				}
			}
		});

		tables.forEach(t => {
			const zone = document.querySelector(`.drop-zone[data-table-id="${t.id}"]`);
			if (zone && zone.children.length === 0) {
				zone.innerHTML = '<div style="text-align: center; padding: 1.25rem 0.5rem; color: var(--text-secondary); font-size: 0.8rem; font-style: italic;">Déposez les invités ici</div>';
			}
		});

		if (unassignedDropzone.children.length === 0) {
			if (guests.length === 0) {
				unassignedDropzone.innerHTML = '<div style="text-align: center; padding: 2rem 0.5rem; color: var(--text-secondary); font-size: 0.9rem;">Aucun invité. Cliquez sur "Exemple" pour débuter !</div>';
			} else if (unassignedCount === 0) {
				unassignedDropzone.innerHTML = '<div style="text-align: center; padding: 2rem 0.5rem; color: #15803d; font-size: 0.95rem; font-weight: bold;">🎉 Tous les invités sont placés !</div>';
			} else {
				unassignedDropzone.innerHTML = '<div style="text-align: center; padding: 1.5rem 0.5rem; color: var(--text-secondary); font-size: 0.85rem; font-style: italic;">Aucun invité ne correspond à la recherche.</div>';
			}
		}

		unassignedBadgeCount.textContent = unassignedCount;
		updateProgressAndStats();
	}

	function updateProgressAndStats() {
		const totalAttendingSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const seatedSeats = guests.filter(g => g.tableId).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const unassignedSeats = totalAttendingSeats - seatedSeats;
		const totalTableCapacity = tables.reduce((sum, t) => sum + (parseInt(t.capacity) || 8), 0);

		statTotalAttending.textContent = totalAttendingSeats;
		statSeatedCount.textContent = seatedSeats;
		statSeatedPct.textContent = totalAttendingSeats > 0 ? `${Math.round((seatedSeats / totalAttendingSeats) * 100)}% placés` : '0%';
		statUnassignedCount.textContent = unassignedSeats;
		statTableCount.textContent = tables.length;
		statCapacityTotal.textContent = `${totalTableCapacity} Chaises Totales`;

		const pct = totalAttendingSeats > 0 ? Math.round((seatedSeats / totalAttendingSeats) * 100) : 0;
		progressBarFill.style.width = `${pct}%`;
		progressText.textContent = `${pct}% Placé (${seatedSeats}/${totalAttendingSeats} Places)`;
	}

	// Export Word
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		if (tables.length === 0) {
			alert("Aucune table configurée !");
			return;
		}

		let tablesHtml = '';
		tables.forEach((t, idx) => {
			const tGuests = guests.filter(g => g.tableId === t.id);
			const seatedSeats = tGuests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

			let guestRows = '';
			if (tGuests.length === 0) {
				guestRows = '<tr><td colspan="4" style="border:1px solid #ccc; padding:6px; font-style:italic; color:#777;">Aucun invité assigné</td></tr>';
			} else {
				tGuests.forEach((g, gIdx) => {
					guestRows += `
						<tr>
							<td style="border:1px solid #ccc; padding:6px;">${gIdx + 1}</td>
							<td style="border:1px solid #ccc; padding:6px; font-weight:bold;">${g.name}</td>
							<td style="border:1px solid #ccc; padding:6px; text-align:center;">${g.partySize || 1}</td>
							<td style="border:1px solid #ccc; padding:6px;">${g.dietary || 'Aucun'}</td>
						</tr>
					`;
				});
			}

			tablesHtml += `
				<div style="margin-bottom: 24px;">
					<h3 style="background:#f2f2f2; border:1px solid #ccc; padding:8px; margin:0;">
						${t.name} — ${seatedSeats} / ${t.capacity} Places (${t.shape})
					</h3>
					<table style="width:100%; border-collapse:collapse; font-size:13px;">
						<thead>
							<tr style="background:#fafafa;">
								<th style="border:1px solid #ccc; padding:6px; width:30px;">#</th>
								<th style="border:1px solid #ccc; padding:6px; text-align:left;">Nom de l'Invité</th>
								<th style="border:1px solid #ccc; padding:6px; width:60px; text-align:center;">Places</th>
								<th style="border:1px solid #ccc; padding:6px; text-align:left;">Régime / Menu</th>
							</tr>
						</thead>
						<tbody>
							${guestRows}
						</tbody>
					</table>
				</div>
			`;
		});

		const totalAttendingSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const seatedSeats = guests.filter(g => g.tableId).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Manage.Wedding — Plan de Table Officiel</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Plan de Table Officiel</h1>
				<p>Généré le ${new Date().toLocaleDateString('fr-FR')} | Total Tables : ${tables.length} | Invités Placés : ${seatedSeats} sur ${totalAttendingSeats}</p>
				${tablesHtml}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Plan_de_Table_Mariage_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Export PDF
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const printDate = document.getElementById('print-date');
		const printSeatedCount = document.getElementById('print-seated-count');
		const printContent = document.getElementById('print-tables-content');

		printDate.textContent = new Date().toLocaleDateString('fr-FR');
		const totalAttendingSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const seatedSeats = guests.filter(g => g.tableId).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		printSeatedCount.textContent = `${seatedSeats} sur ${totalAttendingSeats} Invités Placés (${tables.length} Tables)`;

		let out = '';
		tables.forEach(t => {
			const tGuests = guests.filter(g => g.tableId === t.id);
			const seated = tGuests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

			let rows = '';
			tGuests.forEach(g => {
				rows += `<tr>
					<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">${g.name}</td>
					<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${g.partySize || 1}</td>
					<td style="border: 1px solid #ccc; padding: 6px;">${g.dietary || 'Aucun'}</td>
				</tr>`;
			});

			out += `
				<div style="margin-bottom: 20px; page-break-inside: avoid;">
					<h3 style="background:#f2f2f2; border:1px solid #ccc; padding: 6px 10px; margin: 0 0 5px 0; font-size: 14px;">
						${t.name} (${seated} / ${t.capacity} places)
					</h3>
					<table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 10px;">
						<thead>
							<tr style="background:#fafafa;">
								<th style="border:1px solid #ccc; padding:5px; text-align:left;">Nom Invité</th>
								<th style="border:1px solid #ccc; padding:5px; width:60px; text-align:center;">Places</th>
								<th style="border:1px solid #ccc; padding:5px; text-align:left;">Régime / Menu</th>
							</tr>
						</thead>
						<tbody>
							${rows || '<tr><td colspan="3" style="border:1px solid #ccc; padding:6px; font-style:italic;">Aucun invité assigné</td></tr>'}
						</tbody>
					</table>
				</div>
			`;
		});

		printContent.innerHTML = out;
		window.print();
	});

	// Export CSV
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Nom de Table,Capacite Table,Nom Invite,Nombre de Places,Groupe,Regime & Allergies\n";
		tables.forEach(t => {
			const tGuests = guests.filter(g => g.tableId === t.id);
			if (tGuests.length === 0) {
				csv += `"${t.name}",${t.capacity},"Aucun Assigné",0,"-","-"\n`;
			} else {
				tGuests.forEach(g => {
					csv += `"${t.name}",${t.capacity},"${(g.name||'').replace(/"/g, '""')}",${g.partySize || 1},"${g.group||''}","${(g.dietary||'').replace(/"/g, '""')}"\n`;
				});
			}
		});

		const unassigned = guests.filter(g => !g.tableId);
		unassigned.forEach(g => {
			csv += `"Non Assigné",-,"${(g.name||'').replace(/"/g, '""')}",${g.partySize || 1},"${g.group||''}","${(g.dietary||'').replace(/"/g, '""')}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Plan_de_Table_Mariage_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	loadData();
	renderTables();
	renderGuests();
</script>
