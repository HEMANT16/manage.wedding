---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/guest-list-manager/#webapp",
      "name": "Gestionnaire de Liste d'Invités de Mariage et Suivi RSVP",
      "url": "https://manage.wedding/fr/guest-list-manager",
      "description": "Outil gratuit de gestion de liste d'invités de mariage. Suivez les accompagnants, les régimes alimentaires, les tables et exportez en Word (.doc), PDF ou Excel (.csv).",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Organiser et Gérer sa Liste d'Invités de Mariage",
      "description": "Méthode pas à pas pour structurer sa liste d'invités, gérer les cercles familiaux et exporter les données pour le traiteur.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Définir la Capacité et les Quotas d'Envois",
          "text": "Divisez votre nombre cible d'invités assis par le taux moyen de présence (80-85 %) pour déterminer le nombre de faire-part à envoyer."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Regrouper les Invités par Foyer et Affinité",
          "text": "Renseignez les noms principaux, les conjoints (+1) et les groupes (Famille de la mariée, Amis du marié, Cortège) pour comptabiliser les places."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Noter les Régimes Alimentaires et Réponses",
          "text": "Enregistrez au fur et à mesure les statuts (présent, en attente, absent) et les régimes spécifiques (végétarien, sans gluten, allergies)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Exporter la Liste Finale pour les Prestataires",
          "text": "Téléchargez votre récapitulatif en Word (.doc), PDF imprimable ou CSV Excel pour votre traiteur et wedding planner."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Comment exporter ma liste d'invités de mariage en Word ou PDF ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cliquez sur 'Export Word (.doc)' pour télécharger un tableau éditable ou sur 'Export PDF / Imprimer' pour générer une liste imprimable prête à être remise à votre coordinateur de mariage."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle est la règle d'étiquette pour les accompagnants (+1) ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La bienséance veut que l'on accorde un +1 aux invités mariés, pacsés, fiancés ou vivant en couple. Pour les témoins et demoiselles d'honneur, le +1 est systématique. Pour les célibataires, cela dépend de votre budget et de la capacité de la salle."
          }
        },
        {
          "@type": "Question",
          "name": "Mes données d'invités sont-elles synchronisées avec le plan de table ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui ! Toutes les données sont enregistrées localement dans votre navigateur. Les invités ajoutés ici apparaissent automatiquement dans le Créateur de Plan de Table, le Suivi RSVP et le Générateur de Marques-Places."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Gestionnaire de Liste d'Invités Mariage | CRM Gratuit avec Export Word & PDF"
	description="Gérez facilement vos invités de mariage : accompagnants, régimes alimentaires, statut RSVP, numéros de table. Export Word (.doc), PDF et Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Liste d'Invités" category="guests" />

		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(30px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.15;">
					Gestionnaire de Liste <span class="accent-italic">d'Invités de Mariage</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Suivez les RSVP, les accompagnants, les régimes alimentaires et l'attribution des tables. Exportez votre liste en <strong>Word (.doc)</strong>, <strong>PDF</strong> ou <strong>Excel (.csv)</strong> en un clic.
				</p>
			</div>
		</section>

		<!-- Overview Metrics & Dashboard -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						📊 Tableau de Bord des Invités
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Synchronisé en direct avec votre Plan de Table et Suivi RSVP
					</span>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Export Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Export PDF / Imprimer
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Export Excel (.csv)
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Exemple
					</button>
					<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🗑️ Effacer
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;" class="stats-counter-grid">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total Places Assises</span>
					<strong id="stat-total-seats" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(<span id="stat-total-parties">0</span> faire-part)</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Présents Confirmés</span>
					<strong id="stat-attending" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-attending-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% du total</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">En Attente RSVP</span>
					<strong id="stat-pending" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span id="stat-pending-pct" style="font-size: 0.75rem; color: #854d0e; display: block;">0% du total</span>
				</div>
				<div style="background: #fef2f2; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #991b1b; display: block;">Désistements</span>
					<strong id="stat-declined" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red);">0</strong>
					<span id="stat-declined-pct" style="font-size: 0.75rem; color: #991b1b; display: block;">0% du total</span>
				</div>
				<div style="background: #faf5ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #6b21a8; display: block;">Régimes Spécifiques</span>
					<strong id="stat-dietary" class="font-heading" style="font-size: 1.8rem; color: #7e22ce;">0</strong>
					<span style="font-size: 0.75rem; color: #6b21a8; display: block;">Repas Traiteur Particuliers</span>
				</div>
			</div>

			<!-- Dynamic Visual Stacked Group Distribution Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Répartition par Groupe / Affinité</span>
					<span id="group-balance-indicator" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">Groupes équilibrés</span>
				</div>
				<div id="chart-container" style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: var(--bg-paper); margin-bottom: 0.75rem;">
				</div>
				<div id="chart-legend" style="display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.85rem; color: var(--fg-pencil);">
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Add Guest Form + Searchable Filterable List -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="guest-workspace-grid">
			
			<!-- Left Column: Add Guest Card -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.4rem; margin-bottom: 1.25rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>➕</span> Ajouter un Invité
				</h2>

				<form id="guest-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Primary Guest Name -->
					<div>
						<label for="guest-name" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Nom Complet / Famille *
						</label>
						<input type="text" id="guest-name" required placeholder="ex. Sarah Bernard" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1.05rem;">
					</div>

					<!-- Group Category -->
					<div>
						<label for="guest-group" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Côté / Groupe
						</label>
						<select id="guest-group" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
							<option value="Famille de la Mariée">Famille de la Mariée</option>
							<option value="Famille du Marié">Famille du Marié</option>
							<option value="Amis de la Mariée">Amis de la Mariée</option>
							<option value="Amis du Marié">Amis du Marié</option>
							<option value="Amis Communs">Amis Communs</option>
							<option value="Témoins / Cortège / VIP">Témoins / Cortège / VIP</option>
							<option value="Collègues">Collègues</option>
						</select>
					</div>

					<!-- Party Size & Plus-One -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="guest-party" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Nombre de Places
							</label>
							<select id="guest-party" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="1">1 (Solo)</option>
								<option value="2" selected>2 (Couple / +1)</option>
								<option value="3">3 (Famille 3 pers.)</option>
								<option value="4">4 (Famille 4 pers.)</option>
								<option value="5">5+ (Grande Famille)</option>
							</select>
						</div>
						<div>
							<label for="guest-rsvp" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Statut RSVP
							</label>
							<select id="guest-rsvp" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="Pending">⏳ En Attente</option>
								<option value="Attending">✅ Présent</option>
								<option value="Declined">❌ Absent</option>
							</select>
						</div>
					</div>

					<!-- Dietary Restrictions -->
					<div>
						<label for="guest-dietary" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Régimes Alimentaires / Allergies
						</label>
						<input type="text" id="guest-dietary" placeholder="ex. Végétarien, Sans Gluten, Allergie Fruits à Coque" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						<!-- Quick Dietary Tags -->
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem;">
							<button type="button" class="diet-quick-btn" data-val="Végétarien" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Végétarien</button>
							<button type="button" class="diet-quick-btn" data-val="Végétalien/Vegan" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Vegan</button>
							<button type="button" class="diet-quick-btn" data-val="Sans Gluten" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Sans Gluten</button>
							<button type="button" class="diet-quick-btn" data-val="Fruits à Coque" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Fruits à Coque</button>
						</div>
					</div>

					<!-- Optional Table & Contact Notes -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="guest-table" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Table n° (Facultatif)
							</label>
							<input type="text" id="guest-table" placeholder="ex. Table 4" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						</div>
						<div>
							<label for="guest-email" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Email / Tél (Facultatif)
							</label>
							<input type="text" id="guest-email" placeholder="sarah@exemple.fr" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						</div>
					</div>

					<button type="submit" class="hand-btn" style="width: 100%; padding: 0.85rem; font-size: 1.15rem; margin-top: 0.5rem;">
						✨ Ajouter à la Liste
					</button>

				</form>
			</div>

			<!-- Right Column: Interactive Searchable Table & Filter Bar -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Filter Bar -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
					
					<!-- Search Input -->
					<div style="flex: 1; min-width: 180px;">
						<input type="text" id="search-input" placeholder="🔍 Rechercher par nom, régime, groupe..." class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem;">
					</div>

					<!-- Group Filter -->
					<div>
						<select id="filter-group" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Tous les Groupes</option>
							<option value="Famille de la Mariée">Famille de la Mariée</option>
							<option value="Famille du Marié">Famille du Marié</option>
							<option value="Amis de la Mariée">Amis de la Mariée</option>
							<option value="Amis du Marié">Amis du Marié</option>
							<option value="Amis Communs">Amis Communs</option>
							<option value="Témoins / Cortège / VIP">Témoins / Cortège / VIP</option>
							<option value="Collègues">Collègues</option>
						</select>
					</div>

					<!-- RSVP Filter -->
					<div>
						<select id="filter-rsvp" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Tous les Statuts</option>
							<option value="Attending">Confirmés (Présents)</option>
							<option value="Pending">En Attente</option>
							<option value="Declined">Désistements (Absents)</option>
						</select>
					</div>
				</div>

				<!-- Guest List Table Container -->
				<div id="guest-list-table-wrap" style="overflow-x: auto; max-height: 550px;">
					<table id="guest-table-elem" style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 1rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil); position: sticky; top: 0; z-index: 1;">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Invité / Foyer</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Groupe</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">RSVP</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Régime</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Table</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Actions</th>
							</tr>
						</thead>
						<tbody id="guest-table-body">
						</tbody>
					</table>
				</div>

				<!-- Empty State Note -->
				<div id="empty-state-box" style="display: none; text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💌</div>
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">Votre liste d'invités est vide</h3>
					<p class="font-body" style="font-size: 1.05rem; margin-bottom: 1.25rem;">Ajoutez un invité à gauche ou chargez un exemple pour tester les fonctionnalités.</p>
					<button type="button" id="btn-empty-sample" class="hand-btn" style="padding: 0.5rem 1.25rem; font-size: 1rem;">
						➕ Charger 8 Invités d'Exemple
					</button>
				</div>

			</div>
		</div>

		<!-- Hidden Printable Sheet Container for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Liste Principale des Invités</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Généré le : <span id="print-date"></span> | Total Places : <span id="print-total-seats"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Nom de l'Invité</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Groupe</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">Places</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">RSVP</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Régime Alimentaire</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">Table n°</th>
					</tr>
				</thead>
				<tbody id="print-table-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Règle d'Or des Quotas d'Invitations
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					Repères Clés
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Formule du Nombre de Faire-Part :</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Objectif Invités Assis ÷ 0,83 (80% à 85% de Présence) = Nombre Total d'Invités à Convier</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Foyers vs Nombre d'Invités :</strong> La majorité des faire-part s'adressent à des couples ou des familles (~1,8 à 2,0 personnes par enveloppe). Pour réunir <strong>100 convives</strong>, prévoyez environ <strong>55 à 60 faire-part postaux</strong>.
				</p>
			</div>
		</div>

		<RelatedTools currentPath="/fr/guest-list-manager" category="guests" />

	</main>
</Layout>

<style>
	.guest-workspace-grid {
		display: grid;
		grid-template-columns: 1fr;
	}
	@media (min-width: 992px) {
		.guest-workspace-grid {
			grid-template-columns: 360px 1fr;
		}
	}

	.status-badge {
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		font-size: 0.85rem;
		font-weight: bold;
		display: inline-block;
		cursor: pointer;
		user-select: none;
		border: 1px solid var(--fg-pencil);
	}
	.status-attending {
		background: #dcfce7;
		color: #15803d;
	}
	.status-pending {
		background: #fef9c3;
		color: #a16207;
	}
	.status-declined {
		background: #fee2e2;
		color: #b91c1c;
	}

	.group-pill {
		font-size: 0.8rem;
		padding: 0.1rem 0.5rem;
		border-radius: 4px;
		border: 1px solid var(--fg-pencil);
		display: inline-block;
		white-space: nowrap;
	}

	.action-icon-btn {
		background: none;
		border: none;
		cursor: pointer;
		font-size: 1rem;
		padding: 0.25rem;
		border-radius: 3px;
		transition: background 0.1s ease;
	}
	.action-icon-btn:hover {
		background: var(--muted-paper);
	}

	.print-only {
		display: none;
	}

	
</style>

<script is:inline>
	const STORAGE_KEY = 'manage_wedding_guests';

	const sampleGuests = [
		{ id: '1', name: 'Éléonore & Marc Vaneau', group: "Famille de la Mariée", partySize: 2, rsvpStatus: 'Attending', dietary: 'Aucun', table: 'Table 1', email: 'eleonore@exemple.fr' },
		{ id: '2', name: 'Julien Sterling', group: "Famille du Marié", partySize: 2, rsvpStatus: 'Attending', dietary: 'Sans Gluten', table: 'Table 1', email: 'julien@exemple.fr' },
		{ id: '3', name: 'Maya Lin', group: "Témoins / Cortège / VIP", partySize: 1, rsvpStatus: 'Attending', dietary: 'Végétalien/Vegan', table: 'Table d\'Honneur', email: 'maya@exemple.fr' },
		{ id: '4', name: 'David Meunier', group: "Amis du Marié", partySize: 2, rsvpStatus: 'Pending', dietary: 'Aucun', table: 'Table 2', email: 'david@exemple.fr' },
		{ id: '5', name: 'Chloé & Thomas Bernard', group: "Amis de la Mariée", partySize: 2, rsvpStatus: 'Pending', dietary: 'Fruits à Coque', table: 'Table 3', email: 'chloe@exemple.fr' },
		{ id: '6', name: 'Marc Brossard', group: "Collègues", partySize: 1, rsvpStatus: 'Declined', dietary: 'Aucun', table: '', email: 'marc@exemple.fr' },
		{ id: '7', name: 'Sarah & Thomas Wilson', group: "Amis Communs", partySize: 2, rsvpStatus: 'Attending', dietary: 'Végétarien', table: 'Table 2', email: 'wilson@exemple.fr' },
		{ id: '8', name: 'Tante Claire', group: "Famille de la Mariée", partySize: 1, rsvpStatus: 'Attending', dietary: 'Sans Lactose', table: 'Table 1', email: 'claire@exemple.fr' }
	];

	const groupColors = {
		"Famille de la Mariée": "#ffb3ba",
		"Famille du Marié": "#bae1ff",
		"Amis de la Mariée": "#ffdfba",
		"Amis du Marié": "#baffc9",
		"Amis Communs": "#ffffba",
		"Témoins / Cortège / VIP": "#fbcfe8",
		"Collègues": "#e8baff",
		"Bride's Family": "#ffb3ba",
		"Groom's Family": "#bae1ff",
		"Bride's Friends": "#ffdfba",
		"Groom's Friends": "#baffc9",
		"Mutual Friends": "#ffffba",
		"Wedding Party / VIP": "#fbcfe8",
		"Coworkers": "#e8baff"
	};

	let guests = [];

	function loadStoredGuests() {
		const raw = localStorage.getItem(STORAGE_KEY);
		if (raw) {
			try {
				guests = JSON.parse(raw);
				guests.forEach(g => {
					if (!g.partySize) g.partySize = 1;
					if (!g.rsvpStatus) g.rsvpStatus = 'Pending';
					if (!g.dietary) g.dietary = 'Aucun';
				});
			} catch (e) {
				guests = [];
			}
		} else {
			guests = [...sampleGuests];
			saveGuests();
		}
	}

	function saveGuests() {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(guests));
		render();
	}

	const form = document.getElementById('guest-form');
	const tableBody = document.getElementById('guest-table-body');
	const emptyStateBox = document.getElementById('empty-state-box');
	const tableWrap = document.getElementById('guest-list-table-wrap');

	const statTotalSeats = document.getElementById('stat-total-seats');
	const statTotalParties = document.getElementById('stat-total-parties');
	const statAttending = document.getElementById('stat-attending');
	const statAttendingPct = document.getElementById('stat-attending-pct');
	const statPending = document.getElementById('stat-pending');
	const statPendingPct = document.getElementById('stat-pending-pct');
	const statDeclined = document.getElementById('stat-declined');
	const statDeclinedPct = document.getElementById('stat-declined-pct');
	const statDietary = document.getElementById('stat-dietary');

	const chartContainer = document.getElementById('chart-container');
	const chartLegend = document.getElementById('chart-legend');

	const searchInput = document.getElementById('search-input');
	const filterGroup = document.getElementById('filter-group');
	const filterRsvp = document.getElementById('filter-rsvp');

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const name = document.getElementById('guest-name').value.trim();
		const group = document.getElementById('guest-group').value;
		const partySize = parseInt(document.getElementById('guest-party').value) || 1;
		const rsvpStatus = document.getElementById('guest-rsvp').value;
		const dietary = document.getElementById('guest-dietary').value.trim() || 'Aucun';
		const table = document.getElementById('guest-table').value.trim();
		const email = document.getElementById('guest-email').value.trim();

		if (!name) return;

		const newGuest = {
			id: Date.now().toString(),
			name,
			group,
			partySize,
			rsvpStatus,
			dietary,
			table: table || '',
			email: email || ''
		};

		guests.unshift(newGuest);
		saveGuests();
		form.reset();
		document.getElementById('guest-dietary').value = '';
	});

	document.querySelectorAll('.diet-quick-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			const input = document.getElementById('guest-dietary');
			const val = btn.getAttribute('data-val');
			if (!input.value || input.value === 'Aucun' || input.value === 'None') {
				input.value = val;
			} else if (!input.value.includes(val)) {
				input.value += `, ${val}`;
			}
		});
	});

	window.deleteGuestItem = function(id) {
		if (confirm("Supprimer cet invité de votre liste ?")) {
			guests = guests.filter(g => g.id !== id);
			saveGuests();
		}
	};

	window.cycleRsvpStatus = function(id) {
		const g = guests.find(item => item.id === id);
		if (!g) return;
		if (g.rsvpStatus === 'Pending') g.rsvpStatus = 'Attending';
		else if (g.rsvpStatus === 'Attending') g.rsvpStatus = 'Declined';
		else g.rsvpStatus = 'Pending';
		saveGuests();
	};

	searchInput.addEventListener('input', render);
	filterGroup.addEventListener('change', render);
	filterRsvp.addEventListener('change', render);

	document.getElementById('btn-sample-data').addEventListener('click', () => {
		guests = JSON.parse(JSON.stringify(sampleGuests));
		saveGuests();
	});
	document.getElementById('btn-empty-sample').addEventListener('click', () => {
		guests = JSON.parse(JSON.stringify(sampleGuests));
		saveGuests();
	});
	document.getElementById('btn-clear-all').addEventListener('click', () => {
		if (confirm("Êtes-vous sûr de vouloir effacer l'intégralité de la liste ?")) {
			guests = [];
			saveGuests();
		}
	});

	// Export Word
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		if (guests.length === 0) {
			alert("Votre liste d'invités est vide !");
			return;
		}

		let tableRows = '';
		guests.forEach((g, idx) => {
			const statusFr = g.rsvpStatus === 'Attending' ? 'Présent' : (g.rsvpStatus === 'Declined' ? 'Absent' : 'En attente');
			tableRows += `
				<tr>
					<td style="border:1px solid #ccc; padding:8px;">${idx + 1}</td>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold;">${g.name}</td>
					<td style="border:1px solid #ccc; padding:8px;">${g.group}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center;">${g.partySize || 1}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center;">${statusFr}</td>
					<td style="border:1px solid #ccc; padding:8px;">${g.dietary}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center;">${g.table || '-'}</td>
					<td style="border:1px solid #ccc; padding:8px;">${g.email || '-'}</td>
				</tr>
			`;
		});

		const totalSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const attendingSeats = guests.filter(g => g.rsvpStatus === 'Attending').reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Manage.Wedding — Liste Principale des Invités</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Liste Principale des Invités</h1>
				<p>Généré le ${new Date().toLocaleDateString('fr-FR')} | Total Faire-part : ${guests.length} | Total Places Assises : ${totalSeats} | Confirmés Présents : ${attendingSeats}</p>
				<table>
					<thead>
						<tr>
							<th>#</th>
							<th>Nom Invité / Foyer</th>
							<th>Groupe</th>
							<th>Places</th>
							<th>Statut RSVP</th>
							<th>Régime & Allergies</th>
							<th>Table</th>
							<th>Contact</th>
						</tr>
					</thead>
					<tbody>
						${tableRows}
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Liste_Invites_Mariage_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Export PDF
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		if (guests.length === 0) {
			alert("Votre liste d'invités est vide !");
			return;
		}

		const printDate = document.getElementById('print-date');
		const printTotalSeats = document.getElementById('print-total-seats');
		const printTbody = document.getElementById('print-table-body');

		printDate.textContent = new Date().toLocaleDateString('fr-FR');
		const totalSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		printTotalSeats.textContent = `${totalSeats} places (${guests.length} foyers)`;

		printTbody.innerHTML = '';
		guests.forEach(g => {
			const statusFr = g.rsvpStatus === 'Attending' ? 'Présent' : (g.rsvpStatus === 'Declined' ? 'Absent' : 'En attente');
			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">${g.name}</td>
				<td style="border: 1px solid #ccc; padding: 6px;">${g.group}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center;">${g.partySize || 1}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center;">${statusFr}</td>
				<td style="border: 1px solid #ccc; padding: 6px;">${g.dietary}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center;">${g.table || '-'}</td>
			`;
			printTbody.appendChild(tr);
		});

		window.print();
	});

	// Export CSV
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		if (guests.length === 0) {
			alert("Votre liste d'invités est vide !");
			return;
		}

		let csv = "Nom Invité,Groupe,Nombre de Places,Statut RSVP,Régime & Allergies,Table,Contact\n";
		guests.forEach(g => {
			const statusFr = g.rsvpStatus === 'Attending' ? 'Présent' : (g.rsvpStatus === 'Declined' ? 'Absent' : 'En attente');
			const safeName = `"${(g.name || '').replace(/"/g, '""')}"`;
			const safeGroup = `"${(g.group || '').replace(/"/g, '""')}"`;
			const safeDiet = `"${(g.dietary || '').replace(/"/g, '""')}"`;
			const safeTable = `"${(g.table || '').replace(/"/g, '""')}"`;
			const safeEmail = `"${(g.email || '').replace(/"/g, '""')}"`;
			csv += `${safeName},${safeGroup},${g.partySize || 1},${statusFr},${safeDiet},${safeTable},${safeEmail}\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Liste_Invites_Mariage_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	function render() {
		const q = searchInput.value.toLowerCase().trim();
		const selGroup = filterGroup.value;
		const selRsvp = filterRsvp.value;

		const filtered = guests.filter(g => {
			const matchesQuery = !q || g.name.toLowerCase().includes(q) || (g.dietary && g.dietary.toLowerCase().includes(q)) || g.group.toLowerCase().includes(q) || (g.table && g.table.toLowerCase().includes(q));
			const matchesGroup = selGroup === 'all' || g.group === selGroup;
			const matchesRsvp = selRsvp === 'all' || g.rsvpStatus === selRsvp;
			return matchesQuery && matchesGroup && matchesRsvp;
		});

		const totalParties = guests.length;
		const totalSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		
		const attendingList = guests.filter(g => g.rsvpStatus === 'Attending');
		const attendingSeats = attendingList.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const pendingList = guests.filter(g => g.rsvpStatus === 'Pending');
		const pendingSeats = pendingList.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const declinedList = guests.filter(g => g.rsvpStatus === 'Declined');
		const declinedSeats = declinedList.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const dietaryCount = guests.filter(g => g.dietary && g.dietary.toLowerCase() !== 'aucun' && g.dietary.toLowerCase() !== 'none' && g.dietary.trim() !== '').length;

		statTotalSeats.textContent = totalSeats;
		statTotalParties.textContent = totalParties;
		statAttending.textContent = attendingSeats;
		statAttendingPct.textContent = totalSeats > 0 ? `${Math.round((attendingSeats / totalSeats) * 100)}% du total` : '0%';
		
		statPending.textContent = pendingSeats;
		statPendingPct.textContent = totalSeats > 0 ? `${Math.round((pendingSeats / totalSeats) * 100)}% du total` : '0%';

		statDeclined.textContent = declinedSeats;
		statDeclinedPct.textContent = totalSeats > 0 ? `${Math.round((declinedSeats / totalSeats) * 100)}% du total` : '0%';

		statDietary.textContent = dietaryCount;

		tableBody.innerHTML = '';
		if (filtered.length === 0 && guests.length === 0) {
			tableWrap.style.display = 'none';
			emptyStateBox.style.display = 'block';
		} else {
			tableWrap.style.display = 'block';
			emptyStateBox.style.display = 'none';

			if (filtered.length === 0) {
				tableBody.innerHTML = `<tr><td colspan="6" style="padding: 2rem; text-align: center; color: var(--text-secondary); font-style: italic;">Aucun invité ne correspond à vos filtres.</td></tr>`;
			} else {
				filtered.forEach((g, idx) => {
					const tr = document.createElement('tr');
					tr.style.borderBottom = '1px solid var(--muted-paper)';
					tr.style.background = idx % 2 === 0 ? '#fff' : '#faf8f5';

					let rsvpBadgeClass = 'status-pending';
					let rsvpIcon = '⏳ En attente';
					if (g.rsvpStatus === 'Attending') {
						rsvpBadgeClass = 'status-attending';
						rsvpIcon = '✅ Présent';
					} else if (g.rsvpStatus === 'Declined') {
						rsvpBadgeClass = 'status-declined';
						rsvpIcon = '❌ Absent';
					}

					const isDietSpecial = g.dietary && g.dietary.toLowerCase() !== 'aucun' && g.dietary.toLowerCase() !== 'none' && g.dietary.trim() !== '';
					const dietBadge = isDietSpecial 
						? `<span style="color: var(--accent-red); font-weight: bold; background: #fee2e2; padding: 0.1rem 0.4rem; border-radius: 3px; font-size: 0.85rem;">⚠️ ${g.dietary}</span>`
						: `<span style="color: var(--text-secondary); font-size: 0.85rem;">Aucun</span>`;

					tr.innerHTML = `
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							<strong style="display: block; font-size: 1.05rem; color: var(--fg-pencil);">${g.name}</strong>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">
								Foyer : <strong>${g.partySize || 1} place${(g.partySize || 1) > 1 ? 's' : ''}</strong> ${g.email ? `• ${g.email}` : ''}
							</span>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							<span class="group-pill" style="background: ${groupColors[g.group] || '#e5e0d8'};">${g.group}</span>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							<span class="status-badge ${rsvpBadgeClass}" title="Cliquer pour changer le statut" onclick="cycleRsvpStatus('${g.id}')">
								${rsvpIcon}
							</span>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							${dietBadge}
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper); text-align: center;">
							<span style="font-size: 0.9rem; font-weight: bold; color: var(--fg-pencil);">${g.table || '-'}</span>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper); text-align: center;">
							<button type="button" class="action-icon-btn" title="Supprimer cet invité" onclick="deleteGuestItem('${g.id}')">
								🗑️
							</button>
						</td>
					`;
					tableBody.appendChild(tr);
				});
			}
		}

		chartContainer.innerHTML = '';
		chartLegend.innerHTML = '';

		if (guests.length > 0) {
			const groupCounts = {};
			guests.forEach(g => {
				const seats = parseInt(g.partySize) || 1;
				groupCounts[g.group] = (groupCounts[g.group] || 0) + seats;
			});

			Object.entries(groupCounts).forEach(([grp, count]) => {
				const pct = (count / totalSeats) * 100;
				const segment = document.createElement('div');
				segment.style.cssText = `height: 100%; width: ${pct}%; background-color: ${groupColors[grp] || '#e5e0d8'}; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;`;
				segment.title = `${grp}: ${count} places (${pct.toFixed(1)}%)`;
				chartContainer.appendChild(segment);

				const legItem = document.createElement('div');
				legItem.style.cssText = `display: flex; align-items: center; gap: 0.25rem;`;
				legItem.innerHTML = `
					<div style="width: 12px; height: 12px; background-color: ${groupColors[grp] || '#e5e0d8'}; border: 1px solid var(--fg-pencil); border-radius: 2px;"></div>
					<span><strong>${grp}:</strong> ${count} (${Math.round(pct)}%)</span>
				`;
				chartLegend.appendChild(legItem);
			});

			if (chartContainer.lastChild) {
				chartContainer.lastChild.style.borderRight = 'none';
			}
		} else {
			chartContainer.innerHTML = '<div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; color: var(--text-secondary); font-style: italic;">Aucun invité enregistré</div>';
		}
	}

	loadStoredGuests();
	render();
</script>
