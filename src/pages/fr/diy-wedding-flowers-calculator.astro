---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calculateur de Fleurs et Tiges de Mariage DIY",
      "url": "https://manage.wedding/fr/diy-wedding-flowers-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calculez le nombre exact de tiges de fleurs en gros, bottes, bouquets, centres de table, répartition fleurs/feuillage et seaux d'hydratation pour un mariage DIY.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calculateur de Fleurs & Tiges de Mariage DIY — Commande en Gros"
	description="Calculez le nombre exact de tiges de fleurs en gros, bottes, ratios de fleurs principales et feuillages, centres de table et marge de sécurité."
	lang="fr"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Fil d'Ariane" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/fr/" style="color: var(--text-secondary); text-decoration: none;">Accueil</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/fr/budget" style="color: var(--text-secondary); text-decoration: none;">Budget</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Fleurs de Mariage DIY</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🌸</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Formule Fleuriste & Convertisseur de Bottes en Gros</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calculateur de Fleurs & Tiges de Mariage DIY
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Transformez vos créations florales en <strong>Nombre Exact de Tiges et de Bottes</strong>. Calculez les proportions (fleurs maîtresses, secondaires, garniture et feuillage), appliquez 15% de marge de casse et estimez les seaux d'eau.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Controls -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>💐</span> 1. Compositions & Style Floral
				</h2>

				<!-- Floral Density & Style -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label for="select-floral-style" style="display: block; font-weight: 700; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						Densité et Style Floral :
					</label>
					<select id="select-floral-style" class="hand-input" style="width: 100%; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 6px; font-size: 0.9rem; background: #fff;">
						<option value="wildflower">🌿 Champêtre & Aérien (Plus de feuillage, 20 tiges/bouquet mariée)</option>
						<option value="classic" selected>🌸 Romantique & Généreux (Standard, 32 tiges/bouquet)</option>
						<option value="luxury">👑 Grand Luxe Haute Densité (50 tiges/bouquet mariée)</option>
					</select>
				</div>

				<!-- Personals Inputs -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.25rem;">
					<strong style="color: var(--fg-pencil); display: block; font-size: 0.9rem; margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
						Bouquets & Accessoires
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
						<div>
							<label for="input-bridal-bouquet" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155;">Bouquets de Mariée :</label>
							<input type="number" id="input-bridal-bouquet" min="0" max="5" value="1" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
						</div>
						<div>
							<label for="input-bridesmaid-bouquets" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155;">Bouquets Demoiselles :</label>
							<input type="number" id="input-bridesmaid-bouquets" min="0" max="15" value="4" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
						</div>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-boutonnieres" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155;">Boutonnières :</label>
							<input type="number" id="input-boutonnieres" min="0" max="25" value="6" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
						</div>
						<div>
							<label for="input-corsages" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155;">Bracelets Floraux / Corsages :</label>
							<input type="number" id="input-corsages" min="0" max="15" value="4" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
						</div>
					</div>
				</div>

				<!-- Reception Decor Inputs -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.25rem;">
					<strong style="color: var(--fg-pencil); display: block; font-size: 0.9rem; margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
						Centres de Table & Cérémonie
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
						<div>
							<label for="input-centerpieces-low" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155;">Centres de Table Bas :</label>
							<input type="number" id="input-centerpieces-low" min="0" max="40" value="8" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
						</div>
						<div>
							<label for="input-bud-vases" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155;">Soliflores / Fiolles (3 tiges) :</label>
							<input type="number" id="input-bud-vases" min="0" max="100" value="15" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
						</div>
					</div>

					<div style="margin-bottom: 0.75rem;">
						<label for="select-arch-install" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Arche de Cérémonie :</label>
						<select id="select-arch-install" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="none">Aucune</option>
							<option value="corner" selected>2 Coins Floraux (~70 tiges)</option>
							<option value="lush">Demi-Arche / Compositions au Sol (~140 tiges)</option>
							<option value="grand">Grande Arche Complète (~240 tiges)</option>
						</select>
					</div>

					<div>
						<label for="input-cake-bar-florals" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Fleurs pour Pièce Montée & Bar :</label>
						<input type="number" id="input-cake-bar-florals" min="0" max="30" value="8" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
				</div>

				<!-- Safety Margin Buffer -->
				<div class="form-group" style="margin-bottom: 1rem;">
					<label for="select-buffer-margin" style="display: block; font-weight: 700; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						Marge de Sécurité & Casse :
					</label>
					<select id="select-buffer-margin" class="hand-input" style="width: 100%; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 6px; font-size: 0.9rem; background: #fff;">
						<option value="1.15" selected>⭐ Recommandé +15% (Standard pour le transport)</option>
						<option value="1.10">🌱 Serré +10% (Pour personnes expérimentées)</option>
						<option value="1.20">🛡️ Sérénité +20% (Recommandé pour pivoines et dahlias)</option>
					</select>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Récapitulatif de Commande</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Commande en Gros de Fleurs
						</h2>
					</div>
					<span id="badge-total-bunches" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">24 Bottes</span>
				</div>

				<!-- Big Stem & Cost Highlight -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Total des Tiges à Acheter</span>
						<strong id="stat-total-stems" style="font-size: 2rem; font-weight: 900; color: #1e40af; line-height: 1.1;">438</strong>
						<span id="stat-stems-buffer-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(381 exactes + 57 marge)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Coût Estimé en Gros</span>
						<strong id="stat-total-flower-cost" style="font-size: 2rem; font-weight: 900; color: #15803d; line-height: 1.1;">657 €</strong>
						<span style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">Moyenne ~1,50 € / tige</span>
					</div>
				</div>

				<!-- Category Stem Count Breakdown -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<strong style="color: var(--fg-pencil); display: block; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;">
						Répartition Botanique par Type
					</strong>

					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🌹 <strong>Fleurs Maîtresses (35%)</strong> (Roses, Pivoines, Dahlias) :</span>
						<strong id="stat-focal-stems" style="color: #b91c1c;">153 tiges (~6 bottes)</strong>
					</div>

					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🌸 <strong>Fleurs Secondaires (30%)</strong> (Renoncules, Œillets) :</span>
						<strong id="stat-secondary-stems" style="color: #c026d3;">131 tiges (~13 bottes)</strong>
					</div>

					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🌾 <strong>Fleurs de Remplissage (15%)</strong> (Gypsophile, Wax) :</span>
						<strong id="stat-filler-stems" style="color: #d97706;">66 tiges (~7 bottes)</strong>
					</div>

					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0;">
						<span style="color: #475569;">🌿 <strong>Feuillages et Verdures (20%)</strong> (Eucalyptus, Ruscus, Olivier) :</span>
						<strong id="stat-greenery-stems" style="color: #15803d;">88 tiges (~9 bottes)</strong>
					</div>
				</div>

				<!-- Prep & Logistics Hardware Matrix -->
				<div style="background: #fef08a; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: var(--fg-pencil); display: block; margin-bottom: 0.25rem;">🪣 Matériel & Hydratation :</strong>
					<span id="stat-prep-hardware" style="color: #334155;">
						Nécessite <strong>12 à 14 seaux de 20 litres</strong>, conservateur floral et livraison le <strong>mercredi matin</strong>.
					</span>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-export-pdf" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Imprimer PDF
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Exporter Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/fr/diy-wedding-flowers-calculator" category="budget" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-order-sheet-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Bon de Commande : Fleurs de Mariage en Gros DIY</h1>
				<p id="print-floral-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Plan Floral DIY | Généré par Manage.Wedding</p>
			</div>
			<div id="print-floral-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const selectFloralStyle = document.getElementById('select-floral-style');
	const inputBridalBouquet = document.getElementById('input-bridal-bouquet');
	const inputBridesmaidBouquets = document.getElementById('input-bridesmaid-bouquets');
	const inputBoutonnieres = document.getElementById('input-boutonnieres');
	const inputCorsages = document.getElementById('input-corsages');
	const inputCenterpiecesLow = document.getElementById('input-centerpieces-low');
	const inputBudVases = document.getElementById('input-bud-vases');
	const selectArchInstall = document.getElementById('select-arch-install');
	const inputCakeBarFlorals = document.getElementById('input-cake-bar-florals');
	const selectBufferMargin = document.getElementById('select-buffer-margin');

	const badgeTotalBunches = document.getElementById('badge-total-bunches');
	const statTotalStems = document.getElementById('stat-total-stems');
	const statStemsBufferSub = document.getElementById('stat-stems-buffer-sub');
	const statTotalFlowerCost = document.getElementById('stat-total-flower-cost');
	const statFocalStems = document.getElementById('stat-focal-stems');
	const statSecondaryStems = document.getElementById('stat-secondary-stems');
	const statFillerStems = document.getElementById('stat-filler-stems');
	const statGreeneryStems = document.getElementById('stat-greenery-stems');
	const statPrepHardware = document.getElementById('stat-prep-hardware');

	function calculateFlorals() {
		const style = selectFloralStyle.value;
		let mult = 1.0;
		if (style === 'wildflower') mult = 0.75;
		else if (style === 'luxury') mult = 1.5;

		const bridal = (parseInt(inputBridalBouquet.value, 10) || 0) * (32 * mult);
		const bridesmaids = (parseInt(inputBridesmaidBouquets.value, 10) || 0) * (18 * mult);
		const bouts = (parseInt(inputBoutonnieres.value, 10) || 0) * 3;
		const corsages = (parseInt(inputCorsages.value, 10) || 0) * 4;
		const centerpieces = (parseInt(inputCenterpiecesLow.value, 10) || 0) * (24 * mult);
		const budVases = (parseInt(inputBudVases.value, 10) || 0) * 3;
		const cakeBar = (parseInt(inputCakeBarFlorals.value, 10) || 0) * 2;

		let archStems = 0;
		const archType = selectArchInstall.value;
		if (archType === 'corner') archStems = 70 * mult;
		else if (archType === 'lush') archStems = 140 * mult;
		else if (archType === 'grand') archStems = 240 * mult;

		const rawStemCount = Math.round(bridal + bridesmaids + bouts + corsages + centerpieces + budVases + cakeBar + archStems);
		const bufferFactor = parseFloat(selectBufferMargin.value) || 1.15;
		const totalWithBuffer = Math.round(rawStemCount * bufferFactor);
		const bufferStems = totalWithBuffer - rawStemCount;

		statTotalStems.textContent = totalWithBuffer;
		statStemsBufferSub.textContent = `(${rawStemCount} exactes + ${bufferStems} de marge)`;

		const focalStems = Math.round(totalWithBuffer * 0.35);
		const secondaryStems = Math.round(totalWithBuffer * 0.30);
		const fillerStems = Math.round(totalWithBuffer * 0.15);
		const greeneryStems = Math.round(totalWithBuffer * 0.20);

		const focalBunches = Math.ceil(focalStems / 25);
		const secondaryBunches = Math.ceil(secondaryStems / 10);
		const fillerBunches = Math.ceil(fillerStems / 10);
		const greeneryBunches = Math.ceil(greeneryStems / 10);

		const totalBunches = focalBunches + secondaryBunches + fillerBunches + greeneryBunches;
		badgeTotalBunches.textContent = `${totalBunches} Bottes en gros`;

		statFocalStems.innerHTML = `${focalStems} tiges <em>(~${focalBunches} bottes de 25)</em>`;
		statSecondaryStems.innerHTML = `${secondaryStems} tiges <em>(~${secondaryBunches} bottes de 10)</em>`;
		statFillerStems.innerHTML = `${fillerStems} tiges <em>(~${fillerBunches} bottes de 10)</em>`;
		statGreeneryStems.innerHTML = `${greeneryStems} tiges <em>(~${greeneryBunches} bottes de 10)</em>`;

		const estimatedCost = Math.round(totalWithBuffer * 1.50);
		statTotalFlowerCost.textContent = `${estimatedCost.toLocaleString('fr-FR')} €`;

		const bucketsCount = Math.max(4, Math.ceil(totalWithBuffer / 32));
		statPrepHardware.innerHTML = `Nécessite <strong>${bucketsCount} seaux de 20L</strong>, conservateur et livraison le <strong>mercredi matin</strong>.`;

		document.getElementById('print-floral-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Classification Botanique</th>
						<th style="padding:6pt; text-align:center;">Total Tiges</th>
						<th style="padding:6pt; text-align:center;">Bottes en Gros</th>
						<th style="padding:6pt;">Variétés Recommandées</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">🌹 Fleurs Principales (35%)</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#1e40af;">${focalStems} tiges</td>
						<td style="padding:6pt; text-align:center;">~${focalBunches} bottes (25/botte)</td>
						<td style="padding:6pt;">Roses de Jardin, Roses Standard, Dahlias, Pivoines, Hortensias</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">🌸 Fleurs Secondaires (30%)</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#c026d3;">${secondaryStems} tiges</td>
						<td style="padding:6pt; text-align:center;">~${secondaryBunches} bottes (10/botte)</td>
						<td style="padding:6pt;">Renoncules, Lisianthus, Roses Branchues, Œillets</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">🌾 Remplissage & Texture (15%)</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#d97706;">${fillerStems} tiges</td>
						<td style="padding:6pt; text-align:center;">~${fillerBunches} bottes (10/botte)</td>
						<td style="padding:6pt;">Wax, Astilbe, Véronique, Gypsophile, Chardon Bleu</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">🌿 Feuillages & Verdures (20%)</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#15803d;">${greeneryStems} tiges</td>
						<td style="padding:6pt; text-align:center;">~${greeneryBunches} bottes (10/botte)</td>
						<td style="padding:6pt;">Eucalyptus Dollar, Ruscus Italien, Salal, Feuilles d'Olivier</td>
					</tr>
					<tr style="background:#f8fafc; font-weight:bold;">
						<td style="padding:8pt;">TOTAL COMMANDE :</td>
						<td style="padding:8pt; text-align:center; font-size:12pt; color:#1e40af;">${totalWithBuffer} tiges</td>
						<td style="padding:8pt; text-align:center; font-size:12pt; color:#15803d;">${totalBunches} Bottes</td>
						<td style="padding:8pt;">Coût estimé : ~${estimatedCost.toLocaleString('fr-FR')} € (${bucketsCount} seaux d'hydratation)</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	const allInputs = [
		selectFloralStyle, inputBridalBouquet, inputBridesmaidBouquets,
		inputBoutonnieres, inputCorsages, inputCenterpiecesLow,
		inputBudVases, selectArchInstall, inputCakeBarFlorals, selectBufferMargin
	];
	allInputs.forEach(input => {
		input.addEventListener('input', calculateFlorals);
		input.addEventListener('change', calculateFlorals);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		calculateFlorals();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateFlorals();
		const totalStems = statTotalStems.textContent;
		const totalCost = statTotalFlowerCost.textContent;
		const bunches = badgeTotalBunches.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Bon de Commande Fleurs DIY</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Bon de Commande : Fleurs de Mariage en Gros DIY</h1>
				<p><strong>Total des Tiges :</strong> ${totalStems} tiges | <strong>Bottes :</strong> ${bunches} | <strong>Budget Estimé :</strong> ${totalCost}</p>
				<hr/>
				<h2>Détail Botanique</h2>
				<table>
					<tr style="background:#f1f5f9;">
						<th>Rôle Botanique</th><th>Nombre de Tiges</th><th>Variétés</th>
					</tr>
					<tr><td><strong>Fleurs Principales (35%) :</strong></td><td>${statFocalStems.textContent}</td><td>Roses de Jardin, Pivoines, Dahlias</td></tr>
					<tr><td><strong>Secondaires (30%) :</strong></td><td>${statSecondaryStems.textContent}</td><td>Renoncules, Lisianthus, Œillets</td></tr>
					<tr><td><strong>Remplissage (15%) :</strong></td><td>${statFillerStems.textContent}</td><td>Wax, Astilbe, Gypsophile</td></tr>
					<tr><td><strong>Feuillages (20%) :</strong></td><td>${statGreeneryStems.textContent}</td><td>Eucalyptus, Ruscus, Olivier</td></tr>
				</table>
				<hr/>
				<p><em>Généré par Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Fleurs-Mariage-DIY-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateFlorals();
</script>
