---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/digital-invitations/#webapp",
      "name": "Générateur de Faire-Part Numériques et E-Invitations de Mariage",
      "url": "https://manage.wedding/fr/digital-invitations",
      "description": "Créez gratuitement vos faire-part numériques de mariage. Générez des invitations e-invites personnalisées avec messages WhatsApp/SMS, téléchargement d'images PNG HD et exports Word et PDF.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Créer et Envoyer des Faire-Part Numériques de Mariage",
      "description": "Méthode pas à pas pour concevoir ses cartons d'invitation virtuels, rédiger les textes WhatsApp et gérer les réponses en ligne.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Renseigner les Détails du Mariage",
          "text": "Indiquez les prénoms des mariés, la date, l'heure, le lieu de réception, le dress code, la date limite RSVP et le lien du site de mariage."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Choisir le Thème Graphique",
          "text": "Sélectionnez le style artistique : Calligraphie Classique, Feuillage Botanique, Arche Romantique ou Moderne Prestige."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Synchroniser la Liste des Invités",
          "text": "Connectez votre liste d'invités pour générer automatiquement une invitation nominative et chaleureuse pour chaque convive."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Exporter les Images PNG et Messages WhatsApp",
          "text": "Téléchargez les cartes en haute résolution et exportez les messages textes préformatés prêts à être envoyés sur WhatsApp et par SMS."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Le faire-part numérique est-il bien perçu par les invités ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oui, plus de 65 % des couples adoptent aujourd'hui le faire-part numérique ou hybride. C'est une solution écologique et économique (qui économise 800 € à 2 500 € en papeterie, calligraphie et timbres) tout en offrant un suivi RSVP instantané en un clic."
          }
        },
        {
          "@type": "Question",
          "name": "Quand envoyer ses faire-part de mariage numériques ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Envoyez vos e-invitations 6 à 8 semaines avant un mariage local, et 10 à 14 semaines à l'avance pour un mariage à l'étranger. L'envoi étant instantané, vos invités reçoivent leur carton sans délai postal."
          }
        },
        {
          "@type": "Question",
          "name": "Peut-on imprimer ce faire-part pour les grands-parents ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolument ! Cliquez sur 'Imprimer les Faire-Part (PDF)' pour imprimer des cartons haute résolution au format standard 13 × 18 cm à remettre en main propre aux aînés de la famille."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Générateur de Faire-Part Numériques Mariage (E-Invites WhatsApp & SMS) | Manage.Wedding"
	description="Créez et exportez des faire-part numériques personnalisés pour vos invités. Textes WhatsApp et SMS prêts à l'envoi, cartes PNG HD, exports Word et PDF."
	schema={schema}
>
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Faire-Part Numériques" category="stationery" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(30px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Générateur de Faire-Part <span class="accent-italic">Numériques & E-Invites</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Créez des invitations de mariage virtuelles personnalisées pour chaque invité. Téléchargez vos <strong>Cartes PNG HD</strong>, planches <strong>PDF Imprimables</strong> ou exportez vos <strong>Messages WhatsApp / SMS Word (.doc)</strong> prêts à l'envoi.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Créer et Envoyer ses E-Invitations en 3 Étapes Simples
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Renseigner les Détails & le Style
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Prénoms des mariés, date, lieu de réception, dress code, date limite de réponse et choix du thème de bordure.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Synchroniser la Liste d'Invités
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Vos invités enregistrés sont automatiquement synchronisés pour personnaliser le message d'invitation avec leur prénom.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporter Images & Textes WhatsApp
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Téléchargez l'image PNG haute résolution ou le document Word contenant tous les textes personnalisés à copier-coller.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Controls + Live Preview & Generated Roster -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="invitations-calc-grid">
			
			<!-- Left Column: Wedding Details Form & Guest Sync -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💌 Contenu & Graphisme du Faire-Part
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Personnalisez les textes, dates et styles visuels
					</span>
				</div>

				<form id="invite-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Theme Style Selector -->
					<div>
						<label for="select-card-theme" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-red); margin-bottom: 0.25rem;">
							Thème Graphique de la Carte
						</label>
						<select id="select-card-theme" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="classic" selected>✒️ Encre & Calligraphie Classique (Élégant Minimaliste)</option>
							<option value="botanical">🌿 Végétal Botanique & Rameaux d'Olivier</option>
							<option value="romantic">🏛️ Arche Romantique Toscane & Papier Chaud</option>
							<option value="modern">✨ Cadre Moderne Prestige Black-Tie</option>
						</select>
					</div>

					<!-- Couple's Names -->
					<div>
						<label for="input-couples-names" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Prénoms des Mariés *
						</label>
						<input type="text" id="input-couples-names" value="Éléonore & Alexandre" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-heading); font-size: 1.1rem; background: #fff;">
					</div>

					<!-- Wedding Date & Time -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="input-wedding-date" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Date & Heure *
							</label>
							<input type="text" id="input-wedding-date" value="Samedi 17 Octobre 2026 à 16h30" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
						</div>
						<div>
							<label for="input-rsvp-deadline" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Date Limite RSVP
							</label>
							<input type="text" id="input-rsvp-deadline" value="15 Septembre 2026" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
						</div>
					</div>

					<!-- Location & Dress Code -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.6rem;">
						<div>
							<label for="input-wedding-location" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Lieu & Ville de Réception *
							</label>
							<input type="text" id="input-wedding-location" value="Domaine des Oliviers, Saint-Rémy-de-Provence" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
						</div>
						<div>
							<label for="input-dress-code" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Dress Code
							</label>
							<select id="input-dress-code" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.85rem;">
								<option value="Tenue de Soirée / Black-Tie" selected>Tenue de Soirée / Black-Tie</option>
								<option value="Tenue Cocktail">Tenue Cocktail</option>
								<option value="Champêtre Chic">Champêtre Chic</option>
								<option value="Élégant / Semi-Formel">Élégant / Semi-Formel</option>
								<option value="Décontracté & Convivial">Décontracté & Convivial</option>
							</select>
						</div>
					</div>

					<!-- RSVP Website & Short Message -->
					<div>
						<label for="input-rsvp-link" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Lien du Site Mariage / Formulaire RSVP
						</label>
						<input type="text" id="input-rsvp-link" value="https://manage.wedding/rsvp" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff;">
					</div>

					<div>
						<label for="input-wedding-message" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Message d'Accueil / Note aux Invités
						</label>
						<textarea id="input-wedding-message" rows="2" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.85rem; background: #fff; resize: vertical;">Le vin d'honneur et le dîner suivront la cérémonie religieuse et laïque !</textarea>
					</div>

					<!-- Guest Personalization Toggle & Management Toolbar -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.6rem;">
						
						<div style="display: flex; justify-content: space-between; align-items: center; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem 0.75rem;">
							<div>
								<strong class="font-heading" style="font-size: 0.92rem; color: var(--fg-pencil); display: block;">
									Personnaliser avec les Noms des Invités
								</strong>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">
									Décochez pour une carte universelle sans nom (idéal pour groupes WhatsApp)
								</span>
							</div>
							<label style="display: flex; align-items: center; cursor: pointer;">
								<input type="checkbox" id="chk-include-guest-name" checked style="width: 20px; height: 20px; accent-color: var(--accent-blue); cursor: pointer;">
							</label>
						</div>

						<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
							<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
								👥 Destinataires : <strong id="guest-count-badge">0 Invités</strong>
							</span>
							<div style="display: flex; gap: 0.3rem;">
								<button type="button" id="btn-load-sample-guests" class="hand-btn" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; background: #eff6ff;">
									✨ Exemple
								</button>
								<button type="button" id="btn-clear-all-guests" class="hand-btn secondary" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; color: #b91c1c;">
									🗑️ Effacer
								</button>
							</div>
						</div>

						<div style="display: flex; gap: 0.4rem;">
							<input type="text" id="input-quick-add-guest" placeholder="Nom de l'invité..." style="flex: 1; padding: 0.35rem 0.5rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<button type="button" id="btn-quick-add-guest" class="hand-btn" style="padding: 0.35rem 0.65rem; font-size: 0.85rem;">
								+ Ajouter
							</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Card Preview & Batch Generation Export Box -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Card Preview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖼️ Aperçu Direct de Votre Faire-Part
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Rendu en temps réel de votre e-invitation
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Textes WhatsApp & SMS (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimer les Faire-Part (PDF)
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- The Interactive Preview Canvas Card -->
					<div id="preview-invite-card" class="theme-classic" style="border: 2.5px solid var(--fg-pencil); border-radius: 6px; padding: 2rem 1.5rem; background: var(--bg-paper); text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.5rem;">
						
						<!-- Corner Markers -->
						<div style="position: absolute; top: 6px; left: 6px; width: 16px; height: 16px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 6px; right: 6px; width: 16px; height: 16px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; left: 6px; width: 16px; height: 16px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; right: 6px; width: 16px; height: 16px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<p style="font-family: var(--font-body); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 2.5px; color: var(--accent-red); margin: 0 0 0.5rem 0; font-weight: bold;">
							VOUS ÊTES INVITÉ(E) À CÉLÉBRER LE MARIAGE DE
						</p>

						<h3 id="prev-guest-name" class="font-heading" style="font-size: 1.4rem; color: var(--accent-blue); margin: 0 0 0.75rem 0;">
							Chère Éléonore & Cher Marc,
						</h3>

						<p style="font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-secondary); margin: 0 0 0.4rem 0;">
							Avec la bénédiction de leurs familles
						</p>

						<h2 id="prev-couples-names" class="font-heading" style="font-size: 2.4rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; line-height: 1.15;">
							Éléonore & Alexandre
						</h2>

						<div style="width: 50px; height: 2px; background: var(--fg-pencil); margin: 0.6rem auto;"></div>

						<p id="prev-wedding-message" class="font-body" style="font-size: 0.95rem; font-style: italic; color: var(--fg-pencil); margin: 0.5rem 0 1rem 0; line-height: 1.4;">
							"Le vin d'honneur et le dîner suivront la cérémonie !"
						</p>

						<div style="border-top: 1.5px dashed var(--fg-pencil); border-bottom: 1.5px dashed var(--fg-pencil); padding: 0.75rem 0; margin: 1rem 0;">
							<p id="prev-wedding-date" class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.25rem 0; font-weight: bold;">
								Samedi 17 Octobre 2026 à 16h30
							</p>
							<p id="prev-wedding-location" class="font-body" style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
								Domaine des Oliviers, Saint-Rémy-de-Provence
							</p>
						</div>

						<div style="display: flex; justify-content: space-around; font-size: 0.8rem; font-family: var(--font-body); color: var(--fg-pencil); margin-top: 0.75rem;">
							<span>👔 Dress Code : <strong id="prev-dress-code">Tenue de Soirée</strong></span>
							<span>📅 Réponse souhaitée : <strong id="prev-rsvp-deadline">15 Sept. 2026</strong></span>
						</div>

						<p id="prev-rsvp-link" style="font-family: var(--font-body); font-size: 0.78rem; color: var(--accent-blue); margin: 0.75rem 0 0 0; text-decoration: underline;">
							Confirmation & Liste : https://manage.wedding/rsvp
						</p>
					</div>

					<button type="button" id="btn-download-sample-png" class="hand-btn" style="width: 100%; text-align: center; font-size: 1rem; padding: 0.65rem; background: #f0fdf4;">
						📸 Télécharger cette Carte en Image PNG HD
					</button>

				</div>

				<!-- Generated Guest Cards Stream Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 450px; overflow-y: auto;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						📥 Liste des Cartes Prêtes à l'Envoi
					</h3>
					<div id="invites-stream-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Faire-Part Officiels de Mariage</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Généré le : <span id="print-date"></span> | Mariés : <span id="print-couple"></span></p>
			</div>
			<div id="print-invites-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Calendrier d'Envoi des Faire-Part Virtuels
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					Étiquette & Bonnes Pratiques
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Calendrier de Diffusion Digitale :</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Save-the-Date Virtuel = 6 à 8 Mois Avant</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Faire-Part Officiel = 6 à 8 Semaines Avant</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Relance RSVP Amicale = 2 Semaines Avant Clôture</span>
				</p>
			</div>
		</div>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/fr/digital-invitations" category="stationery" />

	</main>
</Layout>

<style>
	.invitations-calc-grid {
		display: grid;
		grid-template-columns: 1fr;
	}
	@media (min-width: 992px) {
		.invitations-calc-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	.theme-classic {
		background: #faf8f5 !important;
	}
	.theme-botanical {
		background: #f4f8f3 !important;
		border-color: #2d5a27 !important;
	}
	.theme-romantic {
		background: #fdf5f2 !important;
		border-color: #9f4d36 !important;
	}
	.theme-modern {
		background: #ffffff !important;
		border-color: #000000 !important;
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 20px;
		}
	}
</style>

<script is:inline>
	let guestList = [];

	const couplesNamesInput = document.getElementById('input-couples-names');
	const weddingDateInput = document.getElementById('input-wedding-date');
	const weddingLocationInput = document.getElementById('input-wedding-location');
	const rsvpDeadlineInput = document.getElementById('input-rsvp-deadline');
	const dressCodeSelect = document.getElementById('input-dress-code');
	const rsvpLinkInput = document.getElementById('input-rsvp-link');
	const weddingMessageInput = document.getElementById('input-wedding-message');
	const cardThemeSelect = document.getElementById('select-card-theme');

	const prevGuestName = document.getElementById('prev-guest-name');
	const prevCouplesNames = document.getElementById('prev-couples-names');
	const prevWeddingDate = document.getElementById('prev-wedding-date');
	const prevWeddingLocation = document.getElementById('prev-wedding-location');
	const prevWeddingMessage = document.getElementById('prev-wedding-message');
	const prevDressCode = document.getElementById('prev-dress-code');
	const prevRsvpDeadline = document.getElementById('prev-rsvp-deadline');
	const prevRsvpLink = document.getElementById('prev-rsvp-link');
	const previewCard = document.getElementById('preview-invite-card');

	const guestCountBadge = document.getElementById('guest-count-badge');
	const invitesStreamContainer = document.getElementById('invites-stream-container');

	const chkIncludeGuestName = document.getElementById('chk-include-guest-name');

	function loadGuests() {
		try {
			const saved = localStorage.getItem('manage_wedding_guests');
			if (saved) {
				guestList = JSON.parse(saved);
			}
		} catch (e) {
			guestList = [];
		}

		if (!guestList || guestList.length === 0) {
			guestList = [
				{ name: "Éléonore & Marc Vaneau", group: "Famille de la Mariée" },
				{ name: "Julien Sterling", group: "Famille du Marié" },
				{ name: "Maya Lin", group: "Témoins / VIP" },
				{ name: "David Meunier", group: "Amis du Marié" }
			];
		}
		renderAll();
	}

	function renderAll() {
		const names = couplesNamesInput.value || 'Éléonore & Alexandre';
		const date = weddingDateInput.value || 'Samedi 17 Octobre 2026 à 16h30';
		const location = weddingLocationInput.value || 'Domaine des Oliviers, Saint-Rémy-de-Provence';
		const rsvpDeadline = rsvpDeadlineInput.value || '15 Septembre 2026';
		const dressCode = dressCodeSelect.value || 'Tenue de Soirée / Black-Tie';
		const rsvpLink = rsvpLinkInput.value || 'https://manage.wedding/rsvp';
		const msg = weddingMessageInput.value || 'Le vin d\'honneur et le dîner suivront la cérémonie !';
		const theme = cardThemeSelect.value || 'classic';
		const isPersonalized = chkIncludeGuestName.checked;

		prevCouplesNames.textContent = names;
		prevWeddingDate.textContent = date;
		prevWeddingLocation.textContent = location;
		prevRsvpDeadline.textContent = rsvpDeadline;
		prevDressCode.textContent = dressCode;
		prevRsvpLink.textContent = `Confirmation & Infos : ${rsvpLink}`;
		prevWeddingMessage.textContent = msg ? `"${msg}"` : '';

		if (isPersonalized && guestList.length > 0) {
			prevGuestName.style.display = 'block';
			if (!prevGuestName.textContent.startsWith('Chère ') && !prevGuestName.textContent.startsWith('Cher ')) {
				prevGuestName.textContent = `Chère / Cher ${guestList[0].name},`;
			}
		} else {
			prevGuestName.style.display = 'none';
		}

		previewCard.className = `theme-${theme}`;
		guestCountBadge.textContent = `${guestList.length} Destinataires`;

		invitesStreamContainer.innerHTML = '';
		if (guestList.length === 0) {
			invitesStreamContainer.innerHTML = `
				<div style="text-align: center; padding: 1rem; color: var(--text-secondary); font-style: italic; font-size: 0.9rem;">
					Aucun invité individuel. Carte en <strong>Mode Diffusion Universelle</strong> (Parfait pour groupes WhatsApp ou Instagram).
				</div>
			`;
		} else {
			guestList.forEach((guest, idx) => {
				const item = document.createElement('div');
				item.style.cssText = `display: flex; justify-content: space-between; align-items: center; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.5rem 0.75rem;`;
				item.innerHTML = `
					<div>
						<strong class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">${guest.name}</strong>
						<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">${guest.group || 'Invité'}</span>
					</div>
					<div style="display: flex; gap: 0.25rem;">
						<button type="button" class="btn-preview-guest hand-btn" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #eff6ff;" title="Aperçu">
							👁️ Voir
						</button>
						<button type="button" class="btn-download-guest hand-btn" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #f0fdf4;" title="Télécharger PNG">
							📸 PNG
						</button>
						<button type="button" class="btn-delete-guest hand-btn secondary" data-idx="${idx}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; color: #b91c1c;" title="Supprimer">
							🗑️
						</button>
					</div>
				`;
				invitesStreamContainer.appendChild(item);
			});
		}

		document.querySelectorAll('.btn-preview-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				if (guestList[idx]) {
					chkIncludeGuestName.checked = true;
					prevGuestName.style.display = 'block';
					prevGuestName.textContent = `Chère / Cher ${guestList[idx].name},`;
				}
			});
		});

		document.querySelectorAll('.btn-download-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				if (guestList[idx]) {
					chkIncludeGuestName.checked = true;
					prevGuestName.style.display = 'block';
					prevGuestName.textContent = `Chère / Cher ${guestList[idx].name},`;
					captureCardPNG(guestList[idx].name);
				}
			});
		});

		document.querySelectorAll('.btn-delete-guest').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-idx'));
				guestList.splice(idx, 1);
				renderAll();
			});
		});
	}

	function captureCardPNG(filenamePrefix) {
		if (window.html2canvas) {
			window.html2canvas(previewCard, {
				scale: 3,
				backgroundColor: null,
				useCORS: true
			}).then(canvas => {
				const link = document.createElement('a');
				const safeName = (filenamePrefix || 'faire-part-mariage').replace(/[^a-z0-9]/gi, '_').toLowerCase();
				link.download = `Faire_Part_${safeName}.png`;
				link.href = canvas.toDataURL("image/png");
				link.click();
			});
		} else {
			alert("Génération de l'image en cours, veuillez réessayer dans 2 secondes.");
		}
	}

	document.getElementById('btn-quick-add-guest').addEventListener('click', () => {
		const input = document.getElementById('input-quick-add-guest');
		const val = input.value.trim();
		if (val) {
			guestList.push({ name: val, group: 'Invité Ajouté' });
			input.value = '';
			renderAll();
		}
	});

	document.getElementById('btn-clear-all-guests').addEventListener('click', () => {
		guestList = [];
		renderAll();
	});

	document.getElementById('btn-load-sample-guests').addEventListener('click', () => {
		guestList = [
			{ name: "Éléonore & Marc Vaneau", group: "Famille de la Mariée" },
			{ name: "Julien Sterling", group: "Famille du Marié" },
			{ name: "Maya Lin", group: "Témoins / VIP" },
			{ name: "David Meunier", group: "Amis du Marié" }
		];
		chkIncludeGuestName.checked = true;
		renderAll();
	});

	[couplesNamesInput, weddingDateInput, weddingLocationInput, rsvpDeadlineInput, dressCodeSelect, rsvpLinkInput, weddingMessageInput, cardThemeSelect, chkIncludeGuestName].forEach(el => {
		el.addEventListener('input', renderAll);
		el.addEventListener('change', renderAll);
	});

	document.getElementById('btn-download-sample-png').addEventListener('click', () => {
		captureCardPNG('Modele_Faire_Part');
	});

	// Export Word
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let sections = '';
		guestList.forEach(guest => {
			sections += `
				<div style="margin-bottom: 25px; padding: 15px; border: 1px solid #ccc; background: #fafafa;">
					<h3 style="margin: 0 0 8px 0; color: #1e3a8a;">Message d'invitation personnalisé pour : ${guest.name}</h3>
					<p style="margin: 0; font-family: monospace; font-size: 13px; line-height: 1.5; color: #333;">
						"Chère / Cher ${guest.name}, ${couplesNamesInput.value} ont la joie de vous convier à la célébration de leur mariage le ${weddingDateInput.value} au ${weddingLocationInput.value} ! Le dress code est : ${dressCodeSelect.value}. Découvrez votre carton d'invitation officiel et confirmez votre présence avant le ${rsvpDeadlineInput.value} sur notre espace en ligne : ${rsvpLinkInput.value}"
					</p>
				</div>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Textes d'Invitations et Faire-Part WhatsApp & SMS</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Messages d'Invitation WhatsApp & SMS</h1>
				<p>Généré le ${new Date().toLocaleDateString('fr-FR')} | Mariés : <strong>${couplesNamesInput.value}</strong> | Total Destinataires : <strong>${guestList.length}</strong></p>
				
				<h2>Textes d'Invitations Prêts à l'Envoi :</h2>
				${sections}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Messages_Faire_Part_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Export PDF
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('fr-FR');
		document.getElementById('print-couple').textContent = couplesNamesInput.value;

		const grid = document.getElementById('print-invites-grid');
		grid.innerHTML = '';

		guestList.forEach(guest => {
			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 20px; text-align: center; font-family: 'Times New Roman', serif; margin-bottom: 15px;`;
			card.innerHTML = `
				<p style="font-size: 10px; letter-spacing: 2px; text-transform: uppercase; margin: 0 0 5px 0;">Vous êtes convié(e) au mariage de</p>
				<h3 style="font-size: 18px; margin: 0 0 10px 0;">Chère / Cher ${guest.name},</h3>
				<h2 style="font-size: 26px; margin: 0 0 10px 0;">${couplesNamesInput.value}</h2>
				<p style="font-size: 14px; font-weight: bold; margin: 10px 0 5px 0;">${weddingDateInput.value}</p>
				<p style="font-size: 12px; color: #444; margin: 0 0 10px 0;">${weddingLocationInput.value}</p>
				<p style="font-size: 11px; margin: 0;">Dress Code : ${dressCodeSelect.value} | Confirmation : ${rsvpLinkInput.value}</p>
			`;
			grid.appendChild(card);
		});

		window.print();
	});

	// Export CSV
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Nom Invite,Groupe,Lien RSVP,Statut\n";
		guestList.forEach(guest => {
			csv += `"${guest.name}","${guest.group || 'Général'}","${rsvpLinkInput.value}","Prêt à l'envoi"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Destinataires_Faire_Part_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	loadGuests();
</script>
