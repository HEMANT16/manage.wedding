---
import Layout from '../../layouts/Layout.astro';

const title = "Outils de Papeterie, Faire-part & Créations de Mariage (Gratuits)";
const description = "Outils gratuits de papeterie de mariage : calligraphie d'enveloppes, formats d'invitations (A5/A6), affranchissement postal, marque-places et chronomètre de discours.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/fr/stationery/#collection",
      "name": "Outils de Papeterie, Faire-part et Créations de Mariage",
      "url": "https://manage.wedding/fr/stationery",
      "inLanguage": "fr",
      "description": "Suite complète d'outils pour formater les adresses d'enveloppes, dimensionner vos cartons d'invitation, calculer l'affranchissement postal, créer vos marque-places et chronométrer vos discours.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Adressage & Calligraphie d'Enveloppes", "url": "https://manage.wedding/fr/wedding-envelope-addressing" },
        { "@type": "WebApplication", "name": "Dimensions Faire-part & Cartons", "url": "https://manage.wedding/fr/wedding-invitation-suite-sizer" },
        { "@type": "WebApplication", "name": "Calculateur d'Affranchissement Postal", "url": "https://manage.wedding/fr/wedding-invitation-postage-calculator" },
        { "@type": "WebApplication", "name": "Marque-places & Numéros de Table", "url": "https://manage.wedding/fr/table-place-cards" },
        { "@type": "WebApplication", "name": "Modèles de Remerciements", "url": "https://manage.wedding/fr/wedding-thank-you-cards" },
        { "@type": "WebApplication", "name": "Créateur de Faire-part Digitaux", "url": "https://manage.wedding/fr/digital-invitations" },
        { "@type": "WebApplication", "name": "Chronomètre de Discours & Vœux", "url": "https://manage.wedding/fr/wedding-speech-calculator" },
        { "@type": "WebApplication", "name": "Générateur de Hashtags de Mariage", "url": "https://manage.wedding/fr/wedding-hashtag-generator" },
        { "@type": "WebApplication", "name": "Numérologie de la Date de Mariage", "url": "https://manage.wedding/fr/wedding-date-numerology" },
        { "@type": "WebApplication", "name": "Guide des Noces & Anniversaires", "url": "https://manage.wedding/fr/anniversary-gift-finder" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelles sont les dimensions standards pour un ensemble de faire-part de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Les formats européens les plus répandus sont : le carton d'invitation principal A5 (148 × 210 mm) ou 130 × 180 mm (équivalent 5x7\"), le carton-réponse RSVP A6 (105 × 148 mm), le carton d'information/hébergement (100 × 150 mm) et l'enveloppe C5 ou B6 assortie."
          }
        },
        {
          "@type": "Question",
          "name": "Quel timbre prévoir pour expédier un faire-part avec ruban ou cachet de cire ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Une enveloppe standard de moins de 20g nécessite un timbre standard (Lettre Verte). En cas de pochette lourde (300 g/m²), cartons multiples ou cachet de cire portant le poids entre 21g et 100g et créant une surépaisseur, prévoyez un affranchissement 100g ou timbre personnalisé pour éviter les taxes postales."
          }
        },
        {
          "@type": "Question",
          "name": "Combien de temps doit durer un discours de témoin ou de parent ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La durée idéale est de 3 à 5 minutes (soit environ 450 à 650 mots à un rythme naturel de 120 à 130 mots par minute). Au-delà de 6 minutes, l'attention des convives diminue rapidement."
          }
        }
      ]
    }
  ]
};

const stationeryTools = [
  {
    title: "Calculateur de Durée de Playlist",
    url: "/fr/wedding-playlist-duration-calculator",
    icon: "🎵",
    badge: "Planning Musical",
    desc: "Calculez le nombre de morceaux par temps fort (cocktail, dîner, ouverture de bal, soirée). Brief DJ et liste noire inclus.",
    tags: ["Musique de Mariage", "Titres par Heure", "Brief DJ"]
  },

  {
    title: "Adressage & Calligraphie d'Enveloppes",
    url: "/fr/wedding-envelope-addressing",
    icon: "✉️",
    badge: "Étiquette & CSV",
    desc: "Mettez en page vos enveloppes C5, C6 et formats carrés avec formules de politesse pour couples, familles et invités individuels. Export Word et PDF.",
    tags: ["Enveloppes C5/C6", "Export PDF", "Formules de Politesse"]
  },
  {
    title: "Dimensions Faire-part & Cartons (A5/A6/DL)",
    url: "/fr/wedding-invitation-suite-sizer",
    icon: "📐",
    badge: "Marges Canva 300 DPI",
    desc: "Calculez les dimensions exactes en millimètres, fonds perdus d'impression de 3mm et formats d'enveloppes assorties.",
    tags: ["Formats A5 & A6", "Fonds Perdus 3mm", "Specs Canva 300 DPI"]
  },
  {
    title: "Calculateur d'Affranchissement Postal",
    url: "/fr/wedding-invitation-postage-calculator",
    icon: "📮",
    badge: "Poids & Tarifs Postaux",
    desc: "Pesez virtuellement vos faire-part : grammage de papier (250-350 g/m²), sceaux de cire, cartons d'appoint et tarifs postaux en vigueur.",
    tags: ["Sceaux de Cire", "Tranche 20g vs 100g", "Tarifs Postaux"]
  },
  {
    title: "Marque-places & Numéros de Table",
    url: "/fr/table-place-cards",
    icon: "🏷️",
    badge: "Prêt à Imprimer",
    desc: "Générez des chevalets de table pliables en PDF avec noms des convives, numéro de table et pictogrammes de menu pour les serveurs.",
    tags: ["Chevalets Pliables", "PDF Vectoriel", "Repères Menu"]
  },
  {
    title: "Modèles de Cartes de Remerciement",
    url: "/fr/wedding-thank-you-cards",
    icon: "✍️",
    badge: "Idées de Textes",
    desc: "Générez des formules de remerciement personnalisées pour l'urne de mariage, les cadeaux de liste, la présence des invités et vos témoins.",
    tags: ["Textes Remerciements", "Urne de Mariage", "Formules Chaleureuses"]
  },
  {
    title: "Créateur de Faire-part Digitaux",
    url: "/fr/digital-invitations",
    icon: "💌",
    badge: "Faire-part Électroniques",
    desc: "Créez des invitations numériques adaptées aux smartphones avec bouton d'ajout au calendrier et formulaire RSVP synchronisé.",
    tags: ["E-Invites", "Save-the-Date", "Confirmation Digitale"]
  },
  {
    title: "Chronomètre de Discours & Vœux",
    url: "/fr/wedding-speech-calculator",
    icon: "🎙️",
    badge: "Métronome & Fiches",
    desc: "Collez votre texte pour mesurer la durée exacte de lecture (110–130 mots/min), intégrer les pauses et imprimer des fiches aide-mémoire.",
    tags: ["Rythme de Parole", "Fiches Imprimables (16pt)", "Minuteur Vœux"]
  },
  {
    title: "Générateur de Hashtags de Mariage",
    url: "/fr/wedding-hashtag-generator",
    icon: "#️⃣",
    badge: "50+ Idées Créatives",
    desc: "Générez plus de 50 hashtags romantiques, festifs ou décalés avec les prénoms des mariés et créez vos affiches de table pour photos.",
    tags: ["Hashtags Instagram", "Affiches de Table", "Jeux de Mots"]
  },
  {
    title: "Numérologie de la Date de Mariage",
    url: "/fr/wedding-date-numerology",
    icon: "✨",
    badge: "Sens & Symbolique",
    desc: "Calculez le chiffre de chemin de vie de votre couple, la compatibilité vibratoire de la date et la symbolique de votre union.",
    tags: ["Chemin de Vie", "Compatibilité Date", "Symbolisme"]
  },
  {
    title: "Guide des Noces & Anniversaires de Mariage",
    url: "/fr/anniversary-gift-finder",
    icon: "💎",
    badge: "De l'An 1 à 60",
    desc: "Découvrez les matières traditionnelles (Coton, Bois, Étain, Argent, Or, Diamant), pierres précieuses et textes de vœux par année.",
    tags: ["Noces de Coton/Or", "Cadeaux par Année", "Idées Romantiques"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Pôle Papeterie & Créatif</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Outils de <span class="accent-italic">Papeterie & Créations</span> de Mariage
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Formatez l'adressage de vos enveloppes, dimensionnez vos cartons d'invitation, calculez les frais d'affranchissement et chronométrez vos discours.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Catégories :</span>
      <a href="/fr/budget" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Budget</a>
      <a href="/fr/dining" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Réception & Bar</a>
      <a href="/fr/guests" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">👥 Invités & Logistique</a>
      <a href="/fr/stationery" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">💌 Papeterie (Actif)</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {stationeryTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
            Ouvrir l'Outil →
          </a>
        </div>
      ))}
    </div>

    <!-- In-Depth Stationery Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Étiquette & Formats</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          Comment Réussir l'Envoi et le Formatage de Vos Faire-part
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Normes métriques des cartons d'invitation, marges de coupe et surépaisseurs postales pour les sceaux de cire.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. Hiérarchie des Formats Standards de Faire-part
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Pour que tous les cartons s'insèrent harmonieusement dans l'enveloppe sans forcer, respectez un décalage de taille progressif :
        </p>
        
        <div style="overflow-x: auto; margin-top: 1rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Élément de la Suite</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Format Standard (mm)</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Format Canva 300 DPI (avec 3mm de bord)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Enveloppe C5 (ou A7)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">162 × 229 mm (ou 133 × 184 mm)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">Support d'envoi principal</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Faire-part Principal</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">A5 (148 × 210 mm) ou 127 × 178 mm</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">154 × 216 mm (1819 × 2551 px)</td>
              </tr>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Carton-Réponse (RSVP)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">A6 (105 × 148 mm) ou 89 × 127 mm</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">111 × 154 mm (1311 × 1819 px)</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Enveloppe Retour RSVP (C6)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">114 × 162 mm</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">Pré-timbrée pour les invités</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Foire Aux Questions
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Quelles sont les dimensions standards pour un ensemble de faire-part ?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Les formats les plus courants sont le carton d'invitation A5 (148 × 210 mm) ou 130 × 180 mm, le carton RSVP A6 (105 × 148 mm) et l'enveloppe C5 ou B6.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Quel timbre prévoir pour un faire-part avec sceau de cire ?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Un sceau de cire et une cartoline épaisse de 300 g/m² dépassent souvent les 20g : optez pour un timbre 100g pour éviter toute surtaxe postale.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              Combien de temps doit durer un discours de mariage ?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              La durée recommandée est de 3 à 5 minutes (environ 450 à 650 mots). Au-delà de 6 minutes, le public a tendance à décrocher.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
