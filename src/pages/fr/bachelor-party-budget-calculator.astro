		function calculateBachelor() {
			const guys = parseInt(guysCountInput.value, 10) || 1;
			const nights = parseInt(tripNightsInput.value, 10) || 1;
			const coverGroom = toggleCoverGroom.checked;
			const groom = groomNameInput.value.trim() || 'Alexandre';

			// Group Category Sums
			const lodgingTotal = (parseFloat(expAirbnb.value) || 0) + (parseFloat(expCleaning.value) || 0);
			const activitiesTotal = (parseFloat(expBoat.value) || 0) + (parseFloat(expShooting.value) || 0) + (parseFloat(expTours.value) || 0) + (parseFloat(expGolf.value) || 0);
			const foodTotal = (parseFloat(expDinners.value) || 0) + (parseFloat(expGroceries.value) || 0) + (parseFloat(expBrunch.value) || 0);
			const nightlifeTotal = (parseFloat(expBars.value) || 0) + (parseFloat(expVip.value) || 0) + (parseFloat(expBooze.value) || 0);
			const transportTotal = (parseFloat(expRental.value) || 0) + (parseFloat(expUber.value) || 0);
			const swagTotal = (parseFloat(expShirts.value) || 0) + (parseFloat(expKits.value) || 0);

			const grandTotal = lodgingTotal + activitiesTotal + foodTotal + nightlifeTotal + transportTotal + swagTotal;
			
			// Headcount Division
			const totalHeadcount = guys + 1; // guys + groom
			const payingCount = coverGroom ? guys : totalHeadcount;

			const perPersonTotal = grandTotal / payingCount;
			const perPersonPerNight = perPersonTotal / Math.max(nights, 1);

			// Groom subsidy calculation
			const baseEqualSplit = grandTotal / totalHeadcount;
			const subsidyPerGuy = coverGroom ? (perPersonTotal - baseEqualSplit) : 0;

			// Category Shares
			const lodgingShare = lodgingTotal / payingCount;
			const activityShare = activitiesTotal / payingCount;
			const foodShare = foodTotal / payingCount;
			const nightlifeShare = nightlifeTotal / payingCount;
			const transportShare = transportTotal / payingCount;
			const swagShare = swagTotal / payingCount;

			// Update Subtotals
			subLodging.textContent = `${Math.round(lodgingTotal).toLocaleString('fr-FR')}€`;
			subActivities.textContent = `${Math.round(activitiesTotal).toLocaleString('fr-FR')}€`;
			subFood.textContent = `${Math.round(foodTotal).toLocaleString('fr-FR')}€`;
			subNightlife.textContent = `${Math.round(nightlifeTotal).toLocaleString('fr-FR')}€`;
			subTransport.textContent = `${Math.round(transportTotal).toLocaleString('fr-FR')}€`;
			subSwag.textContent = `${Math.round(swagTotal).toLocaleString('fr-FR')}€`;

