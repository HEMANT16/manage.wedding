---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/bachelor-party-budget-calculator/#webapp",
      "name": "Calculateur de Budget EVG et Partage des Frais (Enterrement de Vie de Garçon)",
      "url": "https://manage.wedding/fr/bachelor-party-budget-calculator",
      "inLanguage": "fr",
      "description": "Calculateur gratuit de budget EVG (Enterrement de Vie de Garçon). Calculez la part exacte par participant pour le logement, les activités, les repas et les soirées en invitant le futur marié. Générateur de message Lydia, Tricount, Word et PDF.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Établir et Partager le Budget d'un EVG Équitablement",
      "description": "Le guide étape par étape pour le témoin ou l'organisateur pour budgétiser un EVG, collecter les fonds et inviter le marié sans stress financier.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Fixer le Nombre de Participants et Inviter le Marié",
          "text": "Comptez les potes présents et appliquez la formule N-1 : les dépenses d'hébergement, de repas et d'activités du futur marié sont partagées équitablement entre tous les participants."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Verrouiller le Logement et le Transport de Groupe",
          "text": "Estimez les frais fixes communs : location de la villa, Airbnb ou gîte, caution, minibus ou carburant et péages."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Budgétiser les Activités et les Soirées",
          "text": "Intégrez le karting, la location de bateau, les dégustations de bières, le grand restaurant et les consos en club."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Collecter l'Acompte via Cagnotte Lydia / Tricount",
          "text": "Envoyez le récapitulatif sur WhatsApp : encaissez 50% d'acompte 3 à 5 mois avant pour bloquer les réservations et le solde 2 semaines avant le départ."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Le futur marié doit-il payer son EVG ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Non. Selon la tradition d'usage, le futur marié est entièrement invité : ses témoins et amis se répartissent l'ensemble de ses frais de logement, de nourriture, d'activités et de boissons (règle N-1). Le marié ne paie généralement que son propre billet de transport individuel (billet de train ou d'avion)."
          }
        },
        {
          "@type": "Question",
          "name": "Combien coûte en moyenne un week-end d'EVG par personne ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un week-end d'EVG à l'étranger ou dans une grande ville festive (ex. Budapest, Prague, Barcelone, Montpellier) coûte en moyenne entre 250€ et 450€ par participant tout compris (logement, activités, restos, soirées et part du marié). Un week-end au vert dans un gîte avec barbecue oscille entre 130€ et 220€ par personne."
          }
        },
        {
          "@type": "Question",
          "name": "Quand le témoin doit-il récolter l'argent de l'EVG ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Collectez le premier acompte (50% du total estimé pour réserver le logement et les activités majeures) 3 à 5 mois avant le voyage. Récoltez le solde final (courses, restos et boissons) 2 à 3 semaines avant le départ. N'avancez jamais des milliers d'euros sur votre compte personnel sans garantie."
          }
        },
        {
          "@type": "Question",
          "name": "Comment gérer un ami qui a un budget limité ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lancez un sondage anonyme de budget avant de choisir la destination. Si un participant ne peut pas assumer tout le séjour, proposez-lui de venir uniquement pour une journée clé (ex. le samedi soir pour le restaurant et la soirée) ou de verser une participation symbolique pour offrir une tournée au marié."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculateur de Budget EVG & Partage des Frais (Inviter le Marié) | Manage.Wedding"
	description="Calculateur gratuit pour budget EVG et partage des frais. Calculez le coût exact par participant pour le logement Airbnb, les activités, les repas et les soirées en invitant le futur marié. Exportez pour Lydia, Tricount, Word et PDF."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Calculateur Budget EVG" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Inviter le Marié & Cagnotte Lydia</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Calculateur Budget EVG <span class="accent-italic">& Partage des Frais</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calculez la part exacte par pote pour le logement, les activités à sensations, les grands repas et les tournées de bars. Offrez automatiquement le week-end au marié et exportez le récapitulatif pour Lydia et WhatsApp.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Config & Expense Categories -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						Paramètres du Séjour & Participants
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Formule N-1
					</span>
				</div>

				<!-- Destination / Preset Picker -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="destination-preset" style="font-weight: 700;">Destination / Style de Séjour</label>
					<select id="destination-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; padding: 0.65rem;">
						<option value="budapest" selected>🍻 Budapest / Prague (Bains thermaux, Tournée des bars, Clubbing / 280€/pote)</option>
						<option value="barcelone">🏖️ Barcelone / Valence (Catamaran, Tapas & Rooftops / 340€/pote)</option>
						<option value="sud">🏎️ Montpellier / Sud de la France (Karting, Paillote & Plage / 260€/pote)</option>
						<option value="amsterdam">🧇 Bruxelles / Amsterdam (Bière craft, Escape game & Soirées / 300€/pote)</option>
						<option value="gite">🏡 Gîte au vert avec Piscine (Grand Barbecue & Détente / 150€/pote)</option>
						<option value="custom">✏️ Configuration Personnalisée</option>
					</select>
				</div>

				<!-- Nom du Marié, Potes qui payent, Nuits -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label class="form-label" for="groom-name" style="font-size: 0.9rem; font-weight: 600;">Prénom du Marié</label>
						<input type="text" id="groom-name" class="form-input" value="Alexandre" placeholder="ex. Alexandre" />
					</div>
					<div>
						<label class="form-label" for="guys-count" style="font-size: 0.9rem; font-weight: 600;">Potes Payants</label>
						<input type="number" id="guys-count" class="form-input" value="7" min="1" max="40" />
					</div>
					<div>
						<label class="form-label" for="trip-nights" style="font-size: 0.9rem; font-weight: 600;">Nuits</label>
						<input type="number" id="trip-nights" class="form-input" value="2" min="1" max="30" />
					</div>
				</div>

				<!-- Toggle Inviter le Marié -->
				<div class="form-group" style="background: #fffcf5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem;">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 0.98rem; margin: 0;">
						<input type="checkbox" id="toggle-cover-groom" checked style="width: 18px; height: 18px; cursor: pointer;" />
						<span>Inviter le Marié à 100% (Le Marié Paie 0€)</span>
					</label>
					<span style="font-size: 0.82rem; color: #64748b; display: block; margin-top: 4px; margin-left: 26px;">
						Règle d'or : Les 7 participants divisent l'intégralité du séjour à parts égales.
					</span>
				</div>

				<!-- Catégories de Dépenses -->
				
				<!-- Catégorie 1 : Logement -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏡 1. Hébergement & Logement (€)
						</strong>
						<span id="subtotal-lodging" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">850€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-airbnb" style="font-size: 0.85rem;">Airbnb / Gîte / Appartement</label>
							<input type="number" id="exp-airbnb" class="form-input" value="750" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-cleaning" style="font-size: 0.85rem;">Frais de ménage & Taxes</label>
							<input type="number" id="exp-cleaning" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Catégorie 2 : Activités -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏎️ 2. Activités & Excursions (€)
						</strong>
						<span id="subtotal-activities" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">500€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-boat" style="font-size: 0.85rem;">Location Bateau / Catamaran</label>
							<input type="number" id="exp-boat" class="form-input" value="250" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-shooting" style="font-size: 0.85rem;">Karting / Paintball / Quad</label>
							<input type="number" id="exp-shooting" class="form-input" value="150" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-tours" style="font-size: 0.85rem;">Dégustation Bières / Bains thermaux</label>
							<input type="number" id="exp-tours" class="form-input" value="100" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-golf" style="font-size: 0.85rem;">Autres Activités / Aventure</label>
							<input type="number" id="exp-golf" class="form-input" value="0" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Catégorie 3 : Repas & Restos -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🥩 3. Repas, Restos & Courses (€)
						</strong>
						<span id="subtotal-food" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">480€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-dinners" style="font-size: 0.85rem;">Grand Restaurant / Steakhouse</label>
							<input type="number" id="exp-dinners" class="form-input" value="280" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-groceries" style="font-size: 0.85rem;">Courses Maison & Barbecue</label>
							<input type="number" id="exp-groceries" class="form-input" value="120" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-brunch" style="font-size: 0.85rem;">Brunchs, Petits-déjeuners & Snacks</label>
						<input type="number" id="exp-brunch" class="form-input" value="80" min="0" step="10" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Catégorie 4 : Soirées & Alcool -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🍻 4. Soirées, Bars & Boîtes (€)
						</strong>
						<span id="subtotal-nightlife" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">420€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-bars" style="font-size: 0.85rem;">Tournée des Bars & Pintes</label>
							<input type="number" id="exp-bars" class="form-input" value="200" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-vip" style="font-size: 0.85rem;">Entrées Club / Table VIP</label>
							<input type="number" id="exp-vip" class="form-input" value="120" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-booze" style="font-size: 0.85rem;">Alcool & Softs pour le Logement</label>
						<input type="number" id="exp-booze" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Catégorie 5 : Transport -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🚗 5. Transport & Carburant (€)
						</strong>
						<span id="subtotal-transport" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">140€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-rental" style="font-size: 0.85rem;">Minibus / Carburant / Péages</label>
							<input type="number" id="exp-rental" class="form-input" value="90" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-uber" style="font-size: 0.85rem;">Taxis & VTC (Uber, Bolt)</label>
							<input type="number" id="exp-uber" class="form-input" value="50" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Catégorie 6 : Déguisements & Goodies -->
				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🧢 6. T-shirts, Déguisements & Goodies (€)
						</strong>
						<span id="subtotal-swag" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">90€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-shirts" style="font-size: 0.85rem;">T-shirts / Déguisement du Marié</label>
							<input type="number" id="exp-shirts" class="form-input" value="60" min="0" step="5" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-kits" style="font-size: 0.85rem;">Kit Anti-gueule de bois & Gobelets</label>
							<input type="number" id="exp-kits" class="form-input" value="30" min="0" step="5" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Résultats, Cagnotte et Exports -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Cost Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.25rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Coût Total par Participant
						</span>
						<span id="groom-status-badge" style="font-size: 0.85rem; font-weight: 800; background: #16a34a; color: #fff; padding: 3px 8px; border-radius: 4px;">
							🤵 Alexandre Paie : 0€
						</span>
					</div>

					<div id="display-per-person" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						354€
					</div>

					<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.25rem; font-size: 0.95rem; color: var(--text-secondary); flex-wrap: wrap;">
						<span>🌙 <strong id="display-per-night" style="color: var(--fg-pencil);">177€</strong> / nuit</span>
						<span>•</span>
						<span>🎁 Cadeau au marié : <strong id="display-groom-subsidy" style="color: var(--accent-red); font-weight: 700;">+44€</strong> / pote</span>
					</div>

					<p style="font-size: 0.92rem; color: var(--text-secondary); margin: 0 0 1.25rem 0; padding-bottom: 1rem; border-bottom: 1px dashed #cbd5e1;">
						Budget total du groupe : <strong id="display-trip-grand-total" style="color: var(--fg-pencil); font-weight: 700;">2.480€</strong> pour <span id="display-headcount-text">7 potes</span> (+ futur marié).
					</p>

					<!-- Itemized Per-Person Split Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏡 Hébergement (Airbnb / Gîte) :</span>
							<strong id="item-lodging-share">121€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏎️ Activités & Excursions :</span>
							<strong id="item-activity-share">71€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🥩 Repas, Restos & Courses :</span>
							<strong id="item-food-share">69€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🍻 Soirées, Bars & Boîtes :</span>
							<strong id="item-nightlife-share">60€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🚗 Transport & Carburant :</span>
							<strong id="item-transport-share">20€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.9rem;">
							<span>🧢 Déguisements & Goodies :</span>
							<strong id="item-swag-share">13€</strong>
						</div>
					</div>

					<!-- Suggested Payment Schedule -->
					<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.25rem; font-size: 0.88rem; line-height: 1.5;">
