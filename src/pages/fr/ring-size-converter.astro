---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/ring-size-converter/#webapp",
      "name": "Convertisseur International de Tailles de Bagues & Tour de Doigt",
      "url": "https://manage.wedding/fr/ring-size-converter",
      "description": "Convertisseur gratuit de taille de bague et tour de doigt. Convertissez instantanément entre les tailles France/Europe (44 à 75), US, UK, Japon, diamètre et circonférence en millimètres. Baguier imprimable 1:1 inclus.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Comment convertir une taille de bague américaine (US) en taille française ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La taille française correspond directement à la circonférence intérieure en millimètres. Par exemple, une taille US 7 équivaut exactement à une taille française 54 (circonférence de 54,4 mm et diamètre intérieur de 17,3 mm)."
          }
        },
        {
          "@type": "Question",
          "name": "Comment la largeur d'une alliance influence-t-elle la taille ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Une alliance large (6 mm à 8 mm+) couvre une plus grande surface de peau et serre davantage qu'un anneau fin de 2 mm. Les bijoutiers recommandent d'ajouter une demi-taille (+0,5 US ou +1 taille FR) pour les anneaux larges."
          }
        },
        {
          "@type": "Question",
          "name": "Que faire si ma mesure se situe entre deux tailles de bague ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choisissez toujours la taille supérieure. Les doigts ont tendance à gonfler légèrement en été, après un effort physique ou en fin de journée."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Comment Mesurer son Tour de Doigt et Choisir la Bonne Taille d'Alliance",
      "description": "Méthode pas-à-pas pour mesurer votre circonférence en millimètres et trouver votre équivalence exacte chez le bijoutier.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Enrouler une Bandelette de Papier",
          "text": "Enroulez une bande de papier non élastique autour de la base de votre annulaire et vérifiez qu'elle passe la phalange."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Mesurer la Circonférence en Millimètres",
          "text": "Marquez le point de jonction avec un crayon et mesurez la longueur à plat avec une règle graduée."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Ajuster selon la Largeur de l'Anneau",
          "text": "Prévoyez +1 taille pour les anneaux larges de 6 mm ou plus, ou conservez la taille exacte pour les anneaux confort bombés."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Exporter Votre Fiche Bijoutier",
          "text": "Téléchargez votre fiche récapitulative en Word ou PDF pour commander sereinement vos alliances."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Convertisseur Taille de Bague & Tour de Doigt (France, US, UK & mm) | Manage.Wedding"
	description="Convertisseur universel de tailles de bague : France/Europe (44-75), US, UK, Japon, diamètre et circonférence en mm. Baguier imprimable 1:1, export Word et PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Convertisseur de Tailles de Bagues" category="floral-attire" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Convertisseur de Tailles de Bagues
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Convertissez instantanément votre tour de doigt entre les standards <strong>France/Europe, US, UK, Japon, Diamètre et Circonférence (mm)</strong>. Exportez votre <strong>Fiche Bijoutier</strong> en <strong>Word (.doc)</strong> ou <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Trouver sa Taille d'Alliance en 3 Étapes
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Choisir le Système Connu
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indiquez votre taille française (ex. 52), américaine (ex. 6), ou votre circonférence en millimètres.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Ajuster la Largeur de l'Alliance
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Sélectionnez la largeur de l'anneau (solitaire fin 2 mm vs alliance large 7 mm) pour compenser les frottements.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Fiche & Baguier 1:1
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Téléchargez votre fiche récapitulative ou imprimez votre baguier physique à l'échelle 1:1.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Converter Form + Live Results & Circle Sizer -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="ring-grid">
			
			<!-- Left Column: Sizing Controls & Width Adjustments -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💍 Configurateur de Taille de Bague
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Conversion entre standards français, européens, américains, britanniques et millimètres
					</span>
				</div>

				<form id="ring-converter-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- 1. Known System & Size Picker -->
					<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.6rem;">
						<div>
							<label for="select-system" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Système de Départ *
							</label>
							<select id="select-system" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.92rem;">
								<option value="eu" selected>🇫🇷 🇪🇺 France / Europe</option>
								<option value="us">🇺🇸 🇨🇦 US / Canada</option>
								<option value="uk">🇬🇧 🇦🇺 UK / Australie</option>
								<option value="jp">🇯🇵 🇨🇳 Japon / Asie</option>
								<option value="mm">📏 Circonférence (mm)</option>
							</select>
						</div>

						<div>
							<label for="select-ring-val" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Sélectionnez la Taille *
							</label>
							<select id="select-ring-val" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-heading); font-size: 1rem;">
								<!-- Populated via JS -->
							</select>
						</div>
					</div>

					<!-- 2. Band Width Setting (Crucial for Jeweler Accuracy) -->
					<div>
						<label for="select-band-width" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
							Largeur de l'Anneau (Correction Bijoutier)
						</label>
						<select id="select-band-width" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
							<option value="0" selected>Anneau Fin Standard (1,5 mm - 3 mm) — Taille Normale</option>
							<option value="0.25">Anneau Moyen (4 mm - 5 mm) — Décalage +0,25</option>
							<option value="0.5">Alliance Large (6 mm - 8 mm+) — Majoration +0,5 Conseillée</option>
						</select>
					</div>

					<!-- 3. Comfort-Fit vs Standard-Fit Interior -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.88rem; color: var(--fg-pencil); display: block;">
							⚙️ Profil Intérieur de l'Alliance :
						</span>
						<div style="display: flex; gap: 1rem; flex-wrap: wrap;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="radio" name="interior-fit" value="standard" checked style="accent-color: var(--fg-pencil);">
								<span>Intérieur Plat Classique</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="radio" name="interior-fit" value="comfort" style="accent-color: var(--fg-pencil);">
								<span>Finition Confort (Intérieur Bombé)</span>
							</label>
						</div>
					</div>

					<!-- Quick Sizing Advice Note -->
					<div id="band-advice-box" style="background: #eff6ff; border: 1px solid var(--accent-blue); border-radius: 4px; padding: 0.65rem; font-size: 0.82rem; color: #1e3a8a; line-height: 1.4;">
						💡 <strong>Règle Bijoutier :</strong> Un anneau fin de 2 mm correspond à votre taille mesurée exacte. Pour une alliance large homme ou femme (6 mm+), prévoir une demi-taille supplémentaire évite toute sensation de serrement.
					</div>

				</form>
			</div>

			<!-- Right Column: Live International Matrix & Visual Scale Circle -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main International Matrix Result Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🌐 Équivalences Internationales
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Correspondance exacte sur tous les marchés
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Fiche Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimer PDF / Baguier
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- 4-System Big Highlight Grid -->
					<div style="display: grid; grid-template-columns: repeat(2, 1fr); sm:grid-template-columns: repeat(4, 1fr); gap: 0.6rem; text-align: center; margin-bottom: 1.25rem;">
						<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: #16a34a; font-weight: bold; text-transform: uppercase;">France / Europe</span>
							<strong id="res-eu" class="font-heading" style="font-size: 1.9rem; color: #16a34a; display: block; line-height: 1.2;">54</strong>
						</div>

						<div style="background: #fdf2f8; border: 1.5px solid var(--accent-red); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold; text-transform: uppercase;">US / Canada</span>
							<strong id="res-us" class="font-heading" style="font-size: 1.9rem; color: var(--accent-red); display: block; line-height: 1.2;">7</strong>
						</div>

						<div style="background: #eff6ff; border: 1.5px solid var(--accent-blue); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--accent-blue); font-weight: bold; text-transform: uppercase;">UK / Australie</span>
							<strong id="res-uk" class="font-heading" style="font-size: 1.9rem; color: var(--accent-blue); display: block; line-height: 1.2;">N 1/2</strong>
						</div>

						<div style="background: #fafaf9; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--fg-pencil); font-weight: bold; text-transform: uppercase;">Japon / Asie</span>
							<strong id="res-jp" class="font-heading" style="font-size: 1.9rem; color: var(--fg-pencil); display: block; line-height: 1.2;">14</strong>
						</div>
					</div>

					<!-- Exact Millimeter & Inch Dimensions -->
					<div style="display: flex; justify-content: space-around; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem; font-size: 0.85rem; margin-bottom: 1.25rem;">
						<span>📏 Diamètre Intérieur : <strong id="res-dia">17,3 mm</strong> (<span id="res-dia-in">0.68 po</span>)</span>
						<span>📐 Circonférence : <strong id="res-circ">54,4 mm</strong> (<span id="res-circ-in">2.14 po</span>)</span>
					</div>

					<!-- Visual Scaled Ring Sizer Frame -->
					<div style="text-align: center; border-top: 1.5px dashed #ccc; padding-top: 1rem;">
						<span class="font-heading" style="font-size: 0.92rem; color: var(--fg-pencil); display: block; margin-bottom: 0.5rem;">
							🔍 Aperçu Visuel du Diamètre :
						</span>
						<div style="display: flex; justify-content: center; align-items: center; min-height: 130px;">
							<div id="visual-ring-circle" style="width: 104px; height: 104px; border: 5px solid var(--accent-red); border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; box-shadow: 0 0 10px rgba(0,0,0,0.05); background: #fff;">
								<span id="visual-ring-text" style="font-family: monospace; font-size: 0.82rem; font-weight: bold; color: var(--fg-pencil);">
									Ø 17,3 mm
								</span>
							</div>
						</div>
						<p style="font-size: 0.75rem; color: var(--text-secondary); margin: 0.4rem 0 0 0;">
							*Échelle d'écran indicative. Utilisez notre export PDF pour une impression à l'échelle physique 1:1 exacte.
						</p>
					</div>

				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation (1:1 Scale Sizer) -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 20px; margin: 0 0 4px 0;">Manage.Wedding — Fiche Bijoutier & Baguier Imprimable 1:1</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exporté le : <span id="print-date"></span> | Taille Française : <span id="print-eu-size"></span></p>
			</div>

			<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
				<h3 style="margin:0 0 10px 0;">Spécifications Exactes de l'Alliance :</h3>
				<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
					<tr><td><strong>France / Europe :</strong></td><td id="p-eu">54</td><td><strong>US / Canada :</strong></td><td id="p-us">7</td></tr>
					<tr><td><strong>UK / Australie :</strong></td><td id="p-uk">N 1/2</td><td><strong>Japon / Asie :</strong></td><td id="p-jp">14</td></tr>
					<tr><td><strong>Diamètre Intérieur :</strong></td><td id="p-dia">17,3 mm</td><td><strong>Circonférence Intérieure :</strong></td><td id="p-circ">54,4 mm</td></tr>
				</table>
			</div>

			<div style="border: 2px dashed #000; padding: 25px; text-align: center;">
				<h3 style="margin:0 0 10px 0;">Baguier Papier Imprimable à l'Échelle 1:1</h3>
				<p style="font-size: 12px; margin-bottom: 15px;">Découpez cette réglette, pratiquez une fente au point (A), enroulez autour du doigt et passez l'extrémité dans la fente pour lire votre taille.</p>
				<div style="border: 1px solid #000; height: 35px; width: 100%; max-width: 500px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; font-size: 11px;">
					<span>[FENTE A]</span>
					<span>48</span><span>50</span><span>52</span><span>54</span><span>56</span><span>58</span><span>60</span><span>62</span><span>64</span><span>66</span><span>68</span><span>70</span>
					<span>[TIREZ]</span>
				</div>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Repères Rapides</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Correspondance des Tailles de Bagues & Diamètre
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>La formule essentielle :</strong> La taille de bague en France correspond exactement à la <strong>circonférence en millimètres</strong> (ex. taille 54 = 54,4 mm de tour de doigt = 17,3 mm de diamètre intérieur = taille US 7). La taille moyenne pour une femme en France est le <strong>52–54</strong>, et pour un homme le <strong>60–62</strong>.
			</p>
			
			<!-- Benchmark Ring Conversion Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">France / Europe</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">US / Canada</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">UK / Australie</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Japon / Asie</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Diamètre (mm)</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Circonférence (mm)</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Taille 48</td>
