<script is:inline>
	let currencySymbol = '€';

	const tierSelect = document.getElementById('select-floral-tier');
	const currencySelect = document.getElementById('currency-select');
	const deliveryCurrSym = document.getElementById('delivery-curr-sym');

	// Inputs
	const bridalInput = document.getElementById('qty-bridal-bouquet');
	const bridesmaidInput = document.getElementById('qty-bridesmaid-bouquets');
	const boutonniereInput = document.getElementById('qty-boutonnieres');
	const corsageInput = document.getElementById('qty-corsages');

	const archSelect = document.getElementById('select-arch');
	const aisleInput = document.getElementById('qty-aisle-posies');
	const welcomeInput = document.getElementById('qty-welcome-sign');

	const lowCenterpieceInput = document.getElementById('qty-low-centerpieces');
	const tallCenterpieceInput = document.getElementById('qty-tall-centerpieces');
	const sweetheartInput = document.getElementById('qty-sweetheart-garland');
	const cakeInput = document.getElementById('qty-cake-flowers');

	const laborPctInput = document.getElementById('input-labor-pct');
	const deliveryFeeInput = document.getElementById('input-delivery-fee');

	// Result Displays
	const resGrandTotal = document.getElementById('res-grand-total');
	const resTierSummary = document.getElementById('res-tier-summary');
	const resPersonalSubtotal = document.getElementById('res-personal-subtotal');
	const resCeremonySubtotal = document.getElementById('res-ceremony-subtotal');
	const resReceptionSubtotal = document.getElementById('res-reception-subtotal');
	const resStemsSubtotal = document.getElementById('res-stems-subtotal');
	const resLaborAmount = document.getElementById('res-labor-amount');
	const resDeliveryAmount = document.getElementById('res-delivery-amount');

	const barPersonal = document.getElementById('bar-personal');
	const barCeremony = document.getElementById('bar-ceremony');
	const barReception = document.getElementById('bar-reception');
	const barLabor = document.getElementById('bar-labor');

	function formatMoney(amount) {
		return `${Math.round(amount).toLocaleString('fr-FR')} ${currencySymbol}`;
	}

	function calculateFlorals() {
		currencySymbol = currencySelect.value;
		deliveryCurrSym.textContent = currencySymbol;

		const tierMult = parseFloat(tierSelect.value) || 1.0;
		const laborPct = (parseFloat(laborPctInput.value) || 0) / 100;
		const deliveryFee = parseFloat(deliveryFeeInput.value) || 0;

		// 1. Personal
		const bridalCost = (parseInt(bridalInput.value) || 0) * 130 * tierMult;
		const bridesmaidCost = (parseInt(bridesmaidInput.value) || 0) * 65 * tierMult;
		const boutonniereCost = (parseInt(boutonniereInput.value) || 0) * 18 * tierMult;
		const corsageCost = (parseInt(corsageInput.value) || 0) * 25 * tierMult;
		const personalSubtotal = bridalCost + bridesmaidCost + boutonniereCost + corsageCost;

		// 2. Ceremony
		const archCost = (parseFloat(archSelect.value) || 0) * tierMult;
		const aisleCost = (parseInt(aisleInput.value) || 0) * 45 * tierMult;
		const welcomeCost = (parseInt(welcomeInput.value) || 0) * 55 * tierMult;
		const ceremonySubtotal = archCost + aisleCost + welcomeCost;

		// 3. Reception
		const lowCenterCost = (parseInt(lowCenterpieceInput.value) || 0) * 80 * tierMult;
		const tallCenterCost = (parseInt(tallCenterpieceInput.value) || 0) * 190 * tierMult;
		const sweetheartCost = (parseInt(sweetheartInput.value) || 0) * 150 * tierMult;
		const cakeCost = (parseInt(cakeInput.value) || 0) * 35 * tierMult;
		const receptionSubtotal = lowCenterCost + tallCenterCost + sweetheartCost + cakeCost;

		// Stems subtotal
		const stemsSubtotal = personalSubtotal + ceremonySubtotal + receptionSubtotal;
		const laborCost = stemsSubtotal * laborPct;
		const grandTotal = stemsSubtotal + laborCost + deliveryFee;

		// Update UI
		resGrandTotal.textContent = formatMoney(grandTotal);
		resTierSummary.textContent = `${tierSelect.options[tierSelect.selectedIndex].text.split('(')[0]}`;

		resPersonalSubtotal.textContent = formatMoney(personalSubtotal);
		resCeremonySubtotal.textContent = formatMoney(ceremonySubtotal);
		resReceptionSubtotal.textContent = formatMoney(receptionSubtotal);
		resStemsSubtotal.textContent = formatMoney(stemsSubtotal);
		resLaborAmount.textContent = formatMoney(laborCost);
		resDeliveryAmount.textContent = formatMoney(deliveryFee);

		// Proportions
		if (grandTotal > 0) {
			barPersonal.style.width = `${(personalSubtotal / grandTotal) * 100}%`;
			barCeremony.style.width = `${(ceremonySubtotal / grandTotal) * 100}%`;
			barReception.style.width = `${(receptionSubtotal / grandTotal) * 100}%`;
			barLabor.style.width = `${((laborCost + deliveryFee) / grandTotal) * 100}%`;
		}
	}

	// Listeners
	document.querySelectorAll('.floral-input, #input-labor-pct, #input-delivery-fee').forEach(el => {
		el.addEventListener('input', calculateFlorals);
	});
	[tierSelect, archSelect, currencySelect].forEach(el => {
		el.addEventListener('change', calculateFlorals);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const tierName = tierSelect.options[tierSelect.selectedIndex].text;
		const tierMult = parseFloat(tierSelect.value) || 1.0;

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Devis Estimatif Décoration Florale</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Devis Estimatif Décoration Florale</h1>
				<p>Généré le ${new Date().toLocaleDateString('fr-FR')} | Gamme : <strong>${tierName}</strong> | Total Estimé : <strong>${resGrandTotal.textContent}</strong></p>
				
				<h3>Détail des Compositions Florales :</h3>
				<table>
					<thead>
						<tr><th>Élément Floral</th><th style="text-align:center;">Quantité</th><th style="text-align:right;">Sous-total</th></tr>
					</thead>
					<tbody>
						<tr><td>Bouquet de Mariée</td><td style="text-align:center;">${bridalInput.value}</td><td style="text-align:right;">${formatMoney(bridalInput.value * 130 * tierMult)}</td></tr>
						<tr><td>Bouquets Demoiselles d'Honneur</td><td style="text-align:center;">${bridesmaidInput.value}</td><td style="text-align:right;">${formatMoney(bridesmaidInput.value * 65 * tierMult)}</td></tr>
						<tr><td>Boutonnières Hommes</td><td style="text-align:center;">${boutonniereInput.value}</td><td style="text-align:right;">${formatMoney(boutonniereInput.value * 18 * tierMult)}</td></tr>
						<tr><td>Corsages / Bracelets Mères & Témoins</td><td style="text-align:center;">${corsageInput.value}</td><td style="text-align:right;">${formatMoney(corsageInput.value * 25 * tierMult)}</td></tr>
						<tr><td>Arche de Cérémonie Laïque</td><td style="text-align:center;">1</td><td style="text-align:right;">${formatMoney(archSelect.value * tierMult)}</td></tr>
						<tr><td>Bouts de Bancs / Allée</td><td style="text-align:center;">${aisleInput.value}</td><td style="text-align:right;">${formatMoney(aisleInput.value * 45 * tierMult)}</td></tr>
						<tr><td>Panneau de Bienvenue</td><td style="text-align:center;">${welcomeInput.value}</td><td style="text-align:right;">${formatMoney(welcomeInput.value * 55 * tierMult)}</td></tr>
						<tr><td>Centres de Table Bas</td><td style="text-align:center;">${lowCenterpieceInput.value}</td><td style="text-align:right;">${formatMoney(lowCenterpieceInput.value * 80 * tierMult)}</td></tr>
						<tr><td>Compositions Hautes sur Pied</td><td style="text-align:center;">${tallCenterpieceInput.value}</td><td style="text-align:right;">${formatMoney(tallCenterpieceInput.value * 190 * tierMult)}</td></tr>
						<tr><td>Guirlande Table d'Honneur</td><td style="text-align:center;">${sweetheartInput.value}</td><td style="text-align:right;">${formatMoney(sweetheartInput.value * 150 * tierMult)}</td></tr>
						<tr><td>Fleurs Pièce Montée</td><td style="text-align:center;">${cakeInput.value}</td><td style="text-align:right;">${formatMoney(cakeInput.value * 35 * tierMult)}</td></tr>
						<tr style="background:#f9f9f9; font-weight:bold;"><td>Sous-total Compositions</td><td style="text-align:center;">-</td><td style="text-align:right;">${resStemsSubtotal.textContent}</td></tr>
						<tr><td>Main-d'Œuvre & Montage (${laborPctInput.value}%)</td><td style="text-align:center;">-</td><td style="text-align:right;">${resLaborAmount.textContent}</td></tr>
						<tr><td>Livraison Camionnette Climatée</td><td style="text-align:center;">-</td><td style="text-align:right;">${resDeliveryAmount.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;"><td>Total Devis Fleurs Estimé</td><td style="text-align:center;">-</td><td style="text-align:right; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Devis_Fleurs_Mariage_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('fr-FR');
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tierMult = parseFloat(tierSelect.value) || 1.0;
		const tbody = document.getElementById('print-floral-body');

		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Bouquet de Mariée</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${bridalInput.value}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(bridalInput.value * 130 * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Bouquets Demoiselles d'Honneur</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${bridesmaidInput.value}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(bridesmaidInput.value * 65 * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Boutonnières & Corsages</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(boutonniereInput.value) + parseInt(corsageInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((boutonniereInput.value * 18 + corsageInput.value * 25) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Arche de Cérémonie Laïque</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">1</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(archSelect.value * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Allée de Cérémonie & Panneau</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(aisleInput.value) + parseInt(welcomeInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((aisleInput.value * 45 + welcomeInput.value * 55) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Centres de Table Bas & Hauts</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(lowCenterpieceInput.value) + parseInt(tallCenterpieceInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((lowCenterpieceInput.value * 80 + tallCenterpieceInput.value * 190) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Table d'Honneur & Pièce Montée</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(sweetheartInput.value) + parseInt(cakeInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((sweetheartInput.value * 150 + cakeInput.value * 35) * tierMult)}</td></tr>
			<tr style="background:#fafafa;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Sous-total Compositions</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resStemsSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Main-d'Œuvre & Montage (${laborPctInput.value}%)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resLaborAmount.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Livraison Camionnette Climatée</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDeliveryAmount.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:14px;">Total Devis Fleurs Estimé</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:14px;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const tierMult = parseFloat(tierSelect.value) || 1.0;
		let csv = "Element Floral,Quantite,Sous-total\n";
		csv += `"Bouquet de Mariee",${bridalInput.value},"${formatMoney(bridalInput.value * 130 * tierMult)}"\n`;
		csv += `"Bouquets Demoiselles d'Honneur",${bridesmaidInput.value},"${formatMoney(bridesmaidInput.value * 65 * tierMult)}"\n`;
		csv += `"Boutonnieres",${boutonniereInput.value},"${formatMoney(boutonniereInput.value * 18 * tierMult)}"\n`;
		csv += `"Corsages / Bracelets",${corsageInput.value},"${formatMoney(corsageInput.value * 25 * tierMult)}"\n`;
		csv += `"Arche de Ceremonie Laique",1,"${formatMoney(archSelect.value * tierMult)}"\n`;
		csv += `"Bouts de Bancs / Allee",${aisleInput.value},"${formatMoney(aisleInput.value * 45 * tierMult)}"\n`;
		csv += `"Panneau de Bienvenue",${welcomeInput.value},"${formatMoney(welcomeInput.value * 55 * tierMult)}"\n`;
		csv += `"Centres de Table Bas",${lowCenterpieceInput.value},"${formatMoney(lowCenterpieceInput.value * 80 * tierMult)}"\n`;
		csv += `"Compositions Hautes sur Pied",${tallCenterpieceInput.value},"${formatMoney(tallCenterpieceInput.value * 190 * tierMult)}"\n`;
		csv += `"Guirlande Table d'Honneur",${sweetheartInput.value},"${formatMoney(sweetheartInput.value * 150 * tierMult)}"\n`;
		csv += `"Fleurs Piece Montee",${cakeInput.value},"${formatMoney(cakeInput.value * 35 * tierMult)}"\n`;
		csv += `"Sous-total Compositions",-,"${resStemsSubtotal.textContent}"\n`;
		csv += `"Main-d'Oeuvre & Montage",-,"${resLaborAmount.textContent}"\n`;
		csv += `"Livraison",-,"${resDeliveryAmount.textContent}"\n`;
		csv += `"Total Devis Fleurs Estime",-,"${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Devis_Fleurs_Mariage_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateFlorals();
</script>
