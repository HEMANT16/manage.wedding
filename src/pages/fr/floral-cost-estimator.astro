---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/floral-cost-estimator/#webapp",
      "name": "Estimateur de Budget Fleurs & Décoration Florale de Mariage",
      "url": "https://manage.wedding/fr/floral-cost-estimator",
      "description": "Estimateur gratuit de budget fleurs de mariage. Calculez les tarifs détaillés pour le bouquet de mariée, demoiselles d'honneur, boutonnières, centres de table, arche de cérémonie et frais d'installation. Export devis Word, PDF et Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Estimer le Budget Floral d'un Mariage",
      "description": "Guide pas à pas pour chiffrer les bouquets, la cérémonie laïque, les tables de réception et la prestation fleuriste.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Recenser les Fleurs du Cortège",
          "text": "Comptez le bouquet de mariée, les bouquets des demoiselles d'honneur, les boutonnières pour le marié et les témoins, et les corsages des mamans."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Chiffrer la Cérémonie",
          "text": "Choisissez entre une arche épurée, une demi-arche fleurie ou une arche complète de cérémonie laïque avec décors d'allée."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Calculer les Centres de Table",
          "text": "Multipliez le nombre de tables par le prix des compositions basses (70 € - 140 €) ou hautes sur pied (180 € - 350 €)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Ajouter la Main-d'Œuvre et la Livraison",
          "text": "Prévoyez 20% à 25% pour le travail de préparation en atelier, le transport en véhicule réfrigéré et le montage sur le lieu."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quel est le budget moyen pour les fleurs de mariage en France ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En moyenne, les couples consacrent entre 1 500 € et 4 500 € pour les fleurs de mariage, ce qui représente environ 8% à 12% du budget global selon le standing choisi et l'ampleur de l'arche de cérémonie."
          }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un bouquet de mariée chez un fleuriste professionnel ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un bouquet de mariée classique de saison coûte entre 120 € et 180 €. Pour un bouquet cascade élaboré ou composé de variétés nobles (pivoines hors saison, roses de jardin parfumées, orchidées), comptez entre 200 € et 320 €."
          }
        },
        {
          "@type": "Question",
          "name": "Pourquoi les fleuristes facturent-ils des frais d'installation et de livraison ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le travail commence 3 jours avant le mariage : nettoyage des tiges, effeuillage, hydratation en chambre froide, confection minutieuse et transport en camionnette climatisée pour monter l'arche sur place le matin même."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Estimateur de Budget Floral Mariage (Calcul Fleurs, Arche & Devis) | Manage.Wedding"
	description="Estimez précisément le coût de vos fleurs de mariage : bouquet de mariée, centres de table, arche de cérémonie et frais d'installation. Export Word et PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Estimateur de Budget Floral" category="floral-attire" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Estimateur de Budget Floral
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Chiffrez vos compositions florales tige par tige. Bouquets du cortège, arche de cérémonie, centres de table et montage sur place. Exportez votre <strong>Demande de Devis Fleuriste</strong> en <strong>Word (.doc)</strong> ou <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="floral-calc-grid">
			
			<!-- Left Column: Itemized Floral Quantities -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							🌸 Sélection des Compositions
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Cortège, cérémonie laïque et tables de réception
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Devise :</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="$">$ (USD/CAD)</option>
							<option value="CHF">CHF (Suisse)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="floral-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- Floral Density & Bloom Quality Tier -->
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<label for="select-floral-tier" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem; text-align: center;">
							✨ Gamme & Variétés Florales
						</label>
						<select id="select-floral-tier" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="1.0">Standard / Saison (Roses classiques, œillets, gypsophile, eucalyptus) (1.0x)</option>
							<option value="1.4" selected>Romantique & Champêtre (Roses de jardin, renoncules, hortensias, lisianthus) (1.4x)</option>
							<option value="2.0">Haute Création / Prestige (Pivoines nobles, anémones, orchidées, pois de senteur) (2.0x)</option>
						</select>
					</div>

					<!-- Category 1: Personal Wedding Party Flowers -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							👰 1. Cortège & Accessoires Floraux
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="qty-bridal-bouquet" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Bouquet de Mariée (130 €/u)</label>
								<input type="number" id="qty-bridal-bouquet" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-bridesmaid-bouquets" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Bouquets Demoiselles (65 €/u)</label>
								<input type="number" id="qty-bridesmaid-bouquets" value="3" min="0" max="20" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-boutonnieres" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Boutonnières Hommes (18 €/u)</label>
								<input type="number" id="qty-boutonnieres" value="5" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-corsages" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Bracelets / Corsages (25 €/u)</label>
								<input type="number" id="qty-corsages" value="3" min="0" max="20" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Category 2: Ceremony Florals -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-blue); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							⛪ 2. Cérémonie Laïque ou Religieuse
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="select-arch" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Arche de Cérémonie</label>
								<select id="select-arch" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="0">Aucune / Décor épuré (0 €)</option>
									<option value="350" selected>Demi-Arche Fleurie / Deux Coins (350 €)</option>
									<option value="750">Arche Fleurie Complète (750 €)</option>
									<option value="1200">Colonnes Florales & Luxuriantes (1 200 €)</option>
								</select>
							</div>
							<div>
								<label for="qty-aisle-posies" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Bouts de Bancs / Allée (45 €/u)</label>
								<input type="number" id="qty-aisle-posies" value="6" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div style="grid-column: span 2;">
								<label for="qty-welcome-sign" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Décor Chevalet & Panneau de Bienvenue (55 €/u)</label>
								<input type="number" id="qty-welcome-sign" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Category 3: Reception Table Florals -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: #16a34a; margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							🍽️ 3. Tables de Réception & Dîner
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="qty-low-centerpieces" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Centres de Table Bas (80 €/u)</label>
								<input type="number" id="qty-low-centerpieces" value="8" min="0" max="40" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-tall-centerpieces" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Compositions Hautes sur Pied (190 €/u)</label>
								<input type="number" id="qty-tall-centerpieces" value="2" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-sweetheart-garland" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Guirlande Table d'Honneur (150 €/u)</label>
								<input type="number" id="qty-sweetheart-garland" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-cake-flowers" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Fleurs Pièce Montée (35 €/u)</label>
								<input type="number" id="qty-cake-flowers" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Delivery & Labor Settings -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-labor-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Main-d'Œuvre & Montage
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-labor-pct" value="20" min="0" max="35" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>

						<div>
							<label for="input-delivery-fee" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Livraison Camionnette
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<span id="delivery-curr-sym" style="font-weight: bold;">€</span>
								<input type="number" id="input-delivery-fee" value="100" min="0" max="1000" step="25" style="width: 70px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Line-Item Invoice -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Floral Invoice Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								💐 Synthèse du Devis Fleurs
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Tiges, compositions, montage & livraison
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Devis Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimer PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Grand Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Montant Total Estimé</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">3 240 €</strong>
						<span id="res-tier-summary" style="font-size: 0.8rem; color: var(--accent-red);">Gamme Romantique & Champêtre (1.4x)</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Répartition Détaillée
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">👰 Cortège & Accessoires :</td>
									<td id="res-personal-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">686,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">⛪ Cérémonie Laïque / Arche :</td>
									<td id="res-ceremony-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">945,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍽️ Tables de Réception :</td>
									<td id="res-reception-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1 687,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Total Compositions Florales :</td>
									<td id="res-stems-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">3 318,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-blue);">
									<td style="padding: 0.4rem 0;">🛠️ Main-d'Œuvre & Montage (20%) :</td>
									<td id="res-labor-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">663,60 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil);">
									<td style="padding: 0.4rem 0;">🚚 Livraison Camionnette :</td>
									<td id="res-delivery-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">100,00 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Category Distribution Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Cortège</span>
							<span>Cérémonie</span>
							<span>Tables</span>
							<span style="color: var(--accent-blue);">Installation</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-personal" style="width: 20%; background: var(--accent-red); transition: width 0.3s ease;" title="Cortège"></div>
							<div id="bar-ceremony" style="width: 25%; background: var(--accent-blue); transition: width 0.3s ease;" title="Cérémonie"></div>
							<div id="bar-reception" style="width: 40%; background: #16a34a; transition: width 0.3s ease;" title="Tables"></div>
							<div id="bar-labor" style="width: 15%; background: #d97706; transition: width 0.3s ease;" title="Montage & Livraison"></div>
						</div>
					</div>

				</div>

				<!-- Florist Tip Alert Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						💡 Astuce : Réutiliser les Fleurs de Cérémonie
					</strong>
					<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; color: var(--fg-pencil);">
						Demandez à votre fleuriste de concevoir les arrangements de l'arche afin qu'ils soient déplacés devant la table des mariés ou le buffet du vin d'honneur pendant le cocktail. Économie immédiate de 400 € à 800 € !
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
