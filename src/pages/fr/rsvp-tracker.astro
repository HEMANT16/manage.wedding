---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/fr/rsvp-tracker/#webapp",
      "name": "Suivi des Réponses RSVP et Décompte des Invités de Mariage",
      "url": "https://manage.wedding/fr/rsvp-tracker",
      "description": "Outil gratuit de suivi des réponses RSVP de mariage. Suivez les confirmations, désistements, choix de menus et régimes alimentaires. Export Word, PDF et Excel.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "inLanguage": "fr",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Comment Suivre et Relancer les Réponses RSVP de Mariage",
      "description": "Méthode pas à pas pour suivre les retours de faire-part, comptabiliser les menus et transmettre le décompte final au traiteur.",
      "inLanguage": "fr",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Étape 1 : Fixer la Date Limite et Importer la Liste des Invités",
          "text": "Définissez une date limite de réponse 3 à 4 semaines avant le jour J et enregistrez vos faire-part envoyés."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 2 : Enregistrer les Réponses et Choix de Menus",
          "text": "Notez les présences (Oui), désistements (Non), accompagnants et choix de plats (viande, poisson, végétarien, sans gluten)."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 3 : Relancer Courtoisement les Invités en Attente",
          "text": "Filtrez les réponses 'En attente' 48 à 72 heures après la date butoir pour envoyer un SMS bienveillant aux retardataires."
        },
        {
          "@type": "HowToStep",
          "name": "Étape 4 : Valider le Décompte Final pour le Traiteur",
          "text": "Exportez votre liste récapitulative au format Word (.doc), PDF ou Excel (.csv) pour la remettre au traiteur 15 jours avant la réception."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle date limite de réponse (RSVP) indiquer sur le faire-part de mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La date limite idéale se situe entre 3 et 4 semaines avant le mariage. Cela vous laisse 7 à 10 jours pour relancer les retardataires et transmettre le nombre définitif de repas au traiteur 15 jours à l'avance."
          }
        },
        {
          "@type": "Question",
          "name": "Quel est le pourcentage moyen de désistements à un mariage ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En moyenne, 15 % à 20 % des invités locaux déclinent l'invitation. Pour un mariage nécessitant un long trajet ou en destination lointaine, le taux de désistement grimpe entre 30 % et 40 %."
          }
        },
        {
          "@type": "Question",
          "name": "Comment relancer poliment les invités en retard sans être insistant ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Attendez 2 ou 3 jours après la date limite, puis envoyez un SMS amical : 'Bonjour [Prénom] ! Nous finalisons le décompte des repas pour le traiteur cette semaine. Pouvez-vous nous confirmer votre présence d'ici vendredi ? Au plaisir de fêter ça avec vous !'"
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Suivi des Réponses RSVP Mariage (Outil Gratuit & Export PDF/Word) | Manage.Wedding"
	description="Suivez facilement les réponses RSVP de votre mariage : présents, en attente, désistements, choix de repas et allergies. Export Word (.doc), PDF et Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Suivi RSVP" category="guests" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(30px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.15;">
					Suivi des Réponses <span class="accent-italic">RSVP de Mariage</span>
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Gestion en direct du décompte des invités, suivi des choix de menus et taux de réponse. Exportez votre liste finale en <strong>Word (.doc)</strong>, <strong>PDF</strong> ou <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Overview Stats & Export Dashboard -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						📈 Tableau de Bord & Statistiques des Réponses
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Synchronisé avec votre liste d'invités et votre plan de table
					</span>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Export Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Export PDF / Imprimer
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Export Excel (.csv)
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Exemple
					</button>
					<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🗑️ Effacer
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total Invités</span>
					<strong id="stat-total" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(<span id="stat-parties">0</span> faire-part)</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Présents (Oui)</span>
					<strong id="stat-attending" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-attending-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% du total</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">En Attente</span>
					<strong id="stat-pending" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span id="stat-pending-pct" style="font-size: 0.75rem; color: #854d0e; display: block;">0% du total</span>
				</div>
				<div style="background: #fef2f2; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #991b1b; display: block;">Absents (Non)</span>
					<strong id="stat-declined" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red);">0</strong>
					<span id="stat-declined-pct" style="font-size: 0.75rem; color: #991b1b; display: block;">0% du total</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Taux de Réponse</span>
					<strong id="stat-response-rate" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">0%</strong>
					<span style="font-size: 0.75rem; color: #1e40af; display: block;">Objectif : 95%+</span>
				</div>
			</div>

			<!-- Dynamic Visual Attendance Progress Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Progression des Réponses</span>
					<span id="stat-summary-note" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">Prêt à suivre</span>
				</div>
				<div style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #e5e0d8; margin-bottom: 0.75rem;">
					<div id="bar-attending" style="height: 100%; width: 0%; background-color: #22c55e; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;" title="Présents"></div>
					<div id="bar-pending" style="height: 100%; width: 0%; background-color: #eab308; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;" title="En attente"></div>
					<div id="bar-declined" style="height: 100%; width: 0%; background-color: var(--accent-red); transition: width 0.3s ease;" title="Absents"></div>
				</div>
				<div style="display: flex; justify-content: space-between; font-family: var(--font-body); font-size: 0.85rem;">
					<span style="color: #15803d; font-weight: bold;">🟢 Confirmés (<span id="legend-attending">0</span>)</span>
					<span style="color: #a16207; font-weight: bold;">🟡 En attente (<span id="legend-pending">0</span>)</span>
					<span style="color: var(--accent-red); font-weight: bold;">🔴 Désistements (<span id="legend-declined">0</span>)</span>
				</div>
			</div>
		</div>

		<!-- Workspace Grid: Add / Edit RSVP + Filterable Guest List -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="rsvp-workspace-grid">
			
			<!-- Left Column: Add / Log RSVP Response -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.4rem; margin-bottom: 1.25rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>📬</span> Enregistrer une Réponse RSVP
				</h2>

				<form id="rsvp-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Guest Full Name -->
					<div>
						<label for="rsvp-name" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Nom de l'Invité / Famille *
						</label>
						<input type="text" id="rsvp-name" required placeholder="ex. Oncle Robert & Tante Marie" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1.05rem;">
					</div>

					<!-- Group -->
					<div>
						<label for="rsvp-group" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Groupe / Côté
						</label>
						<select id="rsvp-group" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
							<option value="Famille de la Mariée">Famille de la Mariée</option>
							<option value="Famille du Marié">Famille du Marié</option>
							<option value="Amis de la Mariée">Amis de la Mariée</option>
							<option value="Amis du Marié">Amis du Marié</option>
							<option value="Amis Communs">Amis Communs</option>
							<option value="Témoins / Cortège / VIP">Témoins / Cortège / VIP</option>
							<option value="Collègues">Collègues</option>
						</select>
					</div>

					<!-- Party Size & RSVP Selection -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="rsvp-party" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Nombre de Places
							</label>
							<select id="rsvp-party" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="1">1 (Solo)</option>
								<option value="2" selected>2 (Couple / +1)</option>
								<option value="3">3 (Famille 3 pers.)</option>
								<option value="4">4 (Famille 4 pers.)</option>
								<option value="5">5+ (Groupe)</option>
							</select>
						</div>
						<div>
							<label for="rsvp-status" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Statut de la Réponse
							</label>
							<select id="rsvp-status" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="Attending">✅ Présent (Oui)</option>
								<option value="Pending">⏳ En Attente</option>
								<option value="Declined">❌ Absent (Non)</option>
							</select>
						</div>
					</div>

					<!-- Meal Selection / Dietary -->
					<div>
						<label for="rsvp-dietary" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Choix de Menu / Régimes & Allergies
						</label>
						<input type="text" id="rsvp-dietary" placeholder="ex. Filet de bœuf, Végétarien, Sans Gluten" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem;">
							<button type="button" class="meal-tag-btn" data-val="Bœuf / Viande" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🥩 Bœuf</button>
							<button type="button" class="meal-tag-btn" data-val="Volaille" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🍗 Volaille</button>
							<button type="button" class="meal-tag-btn" data-val="Poisson" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🐟 Poisson</button>
							<button type="button" class="meal-tag-btn" data-val="Végétarien" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🥗 Végé</button>
							<button type="button" class="meal-tag-btn" data-val="Sans Gluten" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🌾 Sans Gluten</button>
						</div>
					</div>

					<button type="submit" class="hand-btn" style="width: 100%; padding: 0.85rem; font-size: 1.15rem; margin-top: 0.5rem;">
						✨ Enregistrer la Réponse
					</button>

				</form>

				<!-- Follow-Up Message Copy Box -->
				<div style="margin-top: 1.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
					<strong class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
						💬 Modèle de Relance SMS pour Retardataires :
					</strong>
					<p id="copy-template-text" class="font-body" style="font-size: 0.9rem; line-height: 1.4; margin-bottom: 0.5rem; color: var(--fg-pencil);">
						"Bonjour ! Nous finalisons le décompte des repas pour le traiteur cette semaine. Peux-tu nous confirmer ta présence d'ici vendredi ? Au plaisir de fêter ça ensemble ! ❤️"
					</p>
					<button type="button" id="btn-copy-template" class="hand-btn secondary" style="padding: 0.25rem 0.6rem; font-size: 0.8rem; width: 100%;">
						📋 Copier le Message de Relance
					</button>
				</div>
			</div>

			<!-- Right Column: Searchable, Filterable RSVP Registry Table -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Filter & Search Bar -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
					
					<!-- Search -->
					<div style="flex: 1; min-width: 180px;">
						<input type="text" id="search-input" placeholder="🔍 Rechercher un invité ou un régime..." class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem;">
					</div>

					<!-- RSVP Status Filter -->
					<div>
						<select id="filter-status" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Tous les Statuts</option>
							<option value="Attending">✅ Présents Uniquement</option>
							<option value="Pending">⏳ En Attente Uniquement</option>
							<option value="Declined">❌ Absents Uniquement</option>
						</select>
					</div>

					<!-- Group Filter -->
					<div>
						<select id="filter-group" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Tous les Groupes</option>
							<option value="Famille de la Mariée">Famille de la Mariée</option>
							<option value="Famille du Marié">Famille du Marié</option>
							<option value="Amis de la Mariée">Amis de la Mariée</option>
							<option value="Amis du Marié">Amis du Marié</option>
							<option value="Amis Communs">Amis Communs</option>
							<option value="Témoins / Cortège / VIP">Témoins / Cortège / VIP</option>
							<option value="Collègues">Collègues</option>
						</select>
					</div>
				</div>

				<!-- Table Container -->
				<div id="rsvp-table-wrap" style="overflow-x: auto; max-height: 550px;">
					<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 1rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil); position: sticky; top: 0; z-index: 1;">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Invité</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Groupe</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Places</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Réponse</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Menu / Régime</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Actions</th>
							</tr>
						</thead>
						<tbody id="rsvp-table-body">
							<!-- Injected via JS -->
						</tbody>
					</table>
				</div>

				<!-- Empty State Box -->
				<div id="empty-state-box" style="display: none; text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💌</div>
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">Aucune Réponse RSVP Enregistrée</h3>
					<p class="font-body" style="font-size: 1.05rem; margin-bottom: 1.25rem;">Ajoutez des réponses via le formulaire à gauche ou chargez des données d'exemple.</p>
					<button type="button" id="btn-empty-sample" class="hand-btn" style="padding: 0.5rem 1.25rem; font-size: 1rem;">
						➕ Charger des Exemples
					</button>
				</div>

			</div>
		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Récapitulatif Officiel des Réponses RSVP</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Généré le : <span id="print-date"></span> | Décompte Confirmé : <span id="print-attending-headcount"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Nom de l'Invité</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Groupe</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">Places</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">Statut</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Choix de Menu / Régime</th>
					</tr>
				</thead>
				<tbody id="print-table-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Repères Statistiques RSVP
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					Normes & Moyennes Françaises
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Taux de Présence Moyens :</strong> 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Invités Proches / Locaux : 80% à 85% Présents (15% à 20% Désistements)</span> · 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Invités Venant de Loin : 60% à 70% Présents</span> · 
					<span style="display: inline-block; background: #fdf2f8; border: 1px solid #ec4899; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #9d174d; margin: 2px 4px;">Mariage à l'Étranger : 45% à 55% Présents</span>
				</p>
			</div>
		</div>

		<RelatedTools currentPath="/fr/rsvp-tracker" category="guests" />

	</main>
</Layout>

<style>
	.rsvp-workspace-grid {
		display: grid;
		grid-template-columns: 1fr;
	}
	@media (min-width: 992px) {
		.rsvp-workspace-grid {
			grid-template-columns: 360px 1fr;
		}
	}

	.btn-status-toggle {
		cursor: pointer;
		padding: 0.2rem 0.5rem;
		border: 2px solid var(--fg-pencil);
		border-radius: 4px;
		font-family: var(--font-heading);
		font-size: 0.8rem;
		transition: all 0.15s ease;
		white-space: nowrap;
	}

	.btn-status-toggle.active-attending {
		background: #22c55e !important;
		color: #fff !important;
		border-color: #15803d !important;
		font-weight: bold;
	}
	.btn-status-toggle.active-pending {
		background: #eab308 !important;
		color: #000 !important;
		border-color: #a16207 !important;
		font-weight: bold;
	}
	.btn-status-toggle.active-declined {
		background: var(--accent-red) !important;
		color: #fff !important;
		border-color: #991b1b !important;
		font-weight: bold;
	}

	.action-icon-btn {
		background: none;
		border: none;
		cursor: pointer;
		font-size: 1.1rem;
		padding: 0.25rem;
		border-radius: 3px;
	}
	.action-icon-btn:hover {
		background: var(--muted-paper);
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 20px;
		}
	}
</style>

<script is:inline>
	const STORAGE_KEY = 'manage_wedding_guests';

	const sampleRSVPs = [
		{ id: '1', name: 'Éléonore & Marc Vaneau', group: "Famille de la Mariée", partySize: 2, rsvpStatus: 'Attending', dietary: 'Bœuf / Viande' },
		{ id: '2', name: 'Julien Sterling', group: "Famille du Marié", partySize: 2, rsvpStatus: 'Attending', dietary: 'Poisson' },
		{ id: '3', name: 'Maya Lin', group: "Témoins / Cortège / VIP", partySize: 1, rsvpStatus: 'Attending', dietary: 'Végétarien' },
		{ id: '4', name: 'David Meunier', group: "Amis du Marié", partySize: 2, rsvpStatus: 'Pending', dietary: 'Volaille' },
		{ id: '5', name: 'Chloé & Thomas Bernard', group: "Amis de la Mariée", partySize: 2, rsvpStatus: 'Pending', dietary: 'Sans Gluten' },
		{ id: '6', name: 'Marc Brossard', group: "Collègues", partySize: 1, rsvpStatus: 'Declined', dietary: 'Aucun' },
		{ id: '7', name: 'Sarah & Thomas Wilson', group: "Amis Communs", partySize: 2, rsvpStatus: 'Attending', dietary: 'Bœuf / Viande' }
	];

	let guests = [];

	function loadGuests() {
		const raw = localStorage.getItem(STORAGE_KEY);
		if (raw) {
			try {
				guests = JSON.parse(raw);
				guests.forEach(g => {
					if (!g.rsvpStatus) {
						if (g.status === 'attending') g.rsvpStatus = 'Attending';
						else if (g.status === 'declined') g.rsvpStatus = 'Declined';
						else g.rsvpStatus = 'Pending';
					}
					if (!g.partySize) g.partySize = 1;
					if (!g.dietary) g.dietary = 'Aucun';
				});
			} catch (e) {
				guests = [];
			}
		} else {
			guests = JSON.parse(JSON.stringify(sampleRSVPs));
			saveGuests();
		}
	}

	function saveGuests() {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(guests));
		render();
	}

	const form = document.getElementById('rsvp-form');
	const tableBody = document.getElementById('rsvp-table-body');
	const emptyStateBox = document.getElementById('empty-state-box');
	const tableWrap = document.getElementById('rsvp-table-wrap');

	const statTotal = document.getElementById('stat-total');
	const statParties = document.getElementById('stat-parties');
	const statAttending = document.getElementById('stat-attending');
	const statAttendingPct = document.getElementById('stat-attending-pct');
	const statPending = document.getElementById('stat-pending');
	const statPendingPct = document.getElementById('stat-pending-pct');
	const statDeclined = document.getElementById('stat-declined');
	const statDeclinedPct = document.getElementById('stat-declined-pct');
	const statResponseRate = document.getElementById('stat-response-rate');
	const statSummaryNote = document.getElementById('stat-summary-note');

	const barAttending = document.getElementById('bar-attending');
	const barPending = document.getElementById('bar-pending');
	const barDeclined = document.getElementById('bar-declined');

	const legendAttending = document.getElementById('legend-attending');
	const legendPending = document.getElementById('legend-pending');
	const legendDeclined = document.getElementById('legend-declined');

	const searchInput = document.getElementById('search-input');
	const filterStatus = document.getElementById('filter-status');
	const filterGroup = document.getElementById('filter-group');

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const name = document.getElementById('rsvp-name').value.trim();
		const group = document.getElementById('rsvp-group').value;
		const partySize = parseInt(document.getElementById('rsvp-party').value) || 1;
		const rsvpStatus = document.getElementById('rsvp-status').value;
		const dietary = document.getElementById('rsvp-dietary').value.trim() || 'Aucun';

		if (!name) return;

		const newEntry = {
			id: Date.now().toString(),
			name,
			group,
			partySize,
			rsvpStatus,
			dietary
		};

		guests.unshift(newEntry);
		saveGuests();
		form.reset();
		document.getElementById('rsvp-dietary').value = '';
	});

	document.querySelectorAll('.meal-tag-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			const input = document.getElementById('rsvp-dietary');
			const val = btn.getAttribute('data-val');
			if (!input.value || input.value === 'Aucun' || input.value === 'None') {
				input.value = val;
			} else if (!input.value.includes(val)) {
				input.value += `, ${val}`;
			}
		});
	});

	document.getElementById('btn-copy-template').addEventListener('click', () => {
		const text = document.getElementById('copy-template-text').textContent.trim();
		navigator.clipboard.writeText(text).then(() => {
			const btn = document.getElementById('btn-copy-template');
			btn.textContent = '✅ Message copié !';
			setTimeout(() => { btn.textContent = '📋 Copier le Message de Relance'; }, 2000);
		});
	});

	window.deleteRsvpItem = function(id) {
		if (confirm("Supprimer cet invité du suivi RSVP ?")) {
			guests = guests.filter(g => g.id !== id);
			saveGuests();
		}
	};

	window.setRsvpStatus = function(id, status) {
		const g = guests.find(item => item.id === id);
		if (g) {
			g.rsvpStatus = status;
			saveGuests();
		}
	};

	searchInput.addEventListener('input', render);
	filterStatus.addEventListener('change', render);
	filterGroup.addEventListener('change', render);

	document.getElementById('btn-sample-data').addEventListener('click', () => {
		guests = JSON.parse(JSON.stringify(sampleRSVPs));
		saveGuests();
	});
	document.getElementById('btn-empty-sample').addEventListener('click', () => {
		guests = JSON.parse(JSON.stringify(sampleRSVPs));
		saveGuests();
	});
	document.getElementById('btn-clear-all').addEventListener('click', () => {
		if (confirm("Effacer toutes les réponses enregistrées ?")) {
			guests = [];
			saveGuests();
		}
	});

	// Export Word
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		if (guests.length === 0) {
			alert("Votre suivi RSVP est vide. Ajoutez des invités au préalable !");
			return;
		}

		let tableRows = '';
		guests.forEach((g, idx) => {
			const statusFr = g.rsvpStatus === 'Attending' ? 'Présent' : (g.rsvpStatus === 'Declined' ? 'Absent' : 'En attente');
			tableRows += `
				<tr>
					<td style="border:1px solid #ccc; padding:8px;">${idx + 1}</td>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold;">${g.name}</td>
					<td style="border:1px solid #ccc; padding:8px;">${g.group || "Général"}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center;">${g.partySize || 1}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center; font-weight:bold;">${statusFr}</td>
					<td style="border:1px solid #ccc; padding:8px;">${g.dietary || 'Aucun'}</td>
				</tr>
			`;
		});

		const totalSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const attendingSeats = guests.filter(g => g.rsvpStatus === 'Attending').reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const declinedSeats = guests.filter(g => g.rsvpStatus === 'Declined').reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const pendingSeats = guests.filter(g => g.rsvpStatus === 'Pending').reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Manage.Wedding — Décompte RSVP</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Récapitulatif Officiel des Réponses RSVP</h1>
				<p>Généré le ${new Date().toLocaleDateString('fr-FR')} | Total Invités : ${totalSeats} | <strong>Présents Confirmés : ${attendingSeats}</strong> | En Attente : ${pendingSeats} | Absents : ${declinedSeats}</p>
				<table>
					<thead>
						<tr>
							<th>#</th>
							<th>Nom de l'Invité</th>
							<th>Groupe</th>
							<th>Places</th>
							<th>Statut RSVP</th>
							<th>Menu / Régime Alimentaire</th>
						</tr>
					</thead>
					<tbody>
						${tableRows}
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Decompte_RSVP_Mariage_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Export PDF
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		if (guests.length === 0) {
			alert("Votre suivi RSVP est vide. Ajoutez des invités au préalable !");
			return;
		}

		const printDate = document.getElementById('print-date');
		const printHeadcount = document.getElementById('print-attending-headcount');
		const printTbody = document.getElementById('print-table-body');

		printDate.textContent = new Date().toLocaleDateString('fr-FR');
		const attendingSeats = guests.filter(g => g.rsvpStatus === 'Attending').reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const totalSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		printHeadcount.textContent = `${attendingSeats} places confirmées (sur ${totalSeats} invités)`;

		printTbody.innerHTML = '';
		guests.forEach(g => {
			const statusFr = g.rsvpStatus === 'Attending' ? 'Présent' : (g.rsvpStatus === 'Declined' ? 'Absent' : 'En attente');
			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">${g.name}</td>
				<td style="border: 1px solid #ccc; padding: 6px;">${g.group || '-'}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center;">${g.partySize || 1}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center; font-weight: bold;">${statusFr}</td>
				<td style="border: 1px solid #ccc; padding: 6px;">${g.dietary || 'Aucun'}</td>
			`;
			printTbody.appendChild(tr);
		});

		window.print();
	});

	// Export CSV
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		if (guests.length === 0) {
			alert("Votre suivi RSVP est vide. Ajoutez des invités au préalable !");
			return;
		}

		let csv = "Nom Invité,Groupe,Nombre de Places,Statut RSVP,Choix de Menu & Régime\n";
		guests.forEach(g => {
			const statusFr = g.rsvpStatus === 'Attending' ? 'Présent' : (g.rsvpStatus === 'Declined' ? 'Absent' : 'En attente');
			const safeName = `"${(g.name || '').replace(/"/g, '""')}"`;
			const safeGroup = `"${(g.group || '').replace(/"/g, '""')}"`;
			const safeDiet = `"${(g.dietary || '').replace(/"/g, '""')}"`;
			csv += `${safeName},${safeGroup},${g.partySize || 1},${statusFr},${safeDiet}\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Suivi_RSVP_Mariage_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	function render() {
		const q = searchInput.value.toLowerCase().trim();
		const selStatus = filterStatus.value;
		const selGroup = filterGroup.value;

		const filtered = guests.filter(g => {
			const matchesQuery = !q || g.name.toLowerCase().includes(q) || (g.dietary && g.dietary.toLowerCase().includes(q)) || (g.group && g.group.toLowerCase().includes(q));
			const matchesStatus = selStatus === 'all' || g.rsvpStatus === selStatus;
			const matchesGroup = selGroup === 'all' || g.group === selGroup;
			return matchesQuery && matchesStatus && matchesGroup;
		});

		const totalParties = guests.length;
		const totalSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		
		const attendingSeats = guests.filter(g => g.rsvpStatus === 'Attending').reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const pendingSeats = guests.filter(g => g.rsvpStatus === 'Pending').reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const declinedSeats = guests.filter(g => g.rsvpStatus === 'Declined').reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const respondedSeats = attendingSeats + declinedSeats;
		const responsePct = totalSeats > 0 ? Math.round((respondedSeats / totalSeats) * 100) : 0;

		statTotal.textContent = totalSeats;
		statParties.textContent = totalParties;
		statAttending.textContent = attendingSeats;
		statAttendingPct.textContent = totalSeats > 0 ? `${Math.round((attendingSeats / totalSeats) * 100)}% du total` : '0%';
		
		statPending.textContent = pendingSeats;
		statPendingPct.textContent = totalSeats > 0 ? `${Math.round((pendingSeats / totalSeats) * 100)}% du total` : '0%';

		statDeclined.textContent = declinedSeats;
		statDeclinedPct.textContent = totalSeats > 0 ? `${Math.round((declinedSeats / totalSeats) * 100)}% du total` : '0%';

		statResponseRate.textContent = `${responsePct}%`;

		if (totalSeats > 0) {
			const attPct = (attendingSeats / totalSeats) * 100;
			const penPct = (pendingSeats / totalSeats) * 100;
			const decPct = (declinedSeats / totalSeats) * 100;

			barAttending.style.width = `${attPct}%`;
			barPending.style.width = `${penPct}%`;
			barDeclined.style.width = `${decPct}%`;

			legendAttending.textContent = attendingSeats;
			legendPending.textContent = pendingSeats;
			legendDeclined.textContent = declinedSeats;

			statSummaryNote.textContent = `${attendingSeats} convives confirmés • ${pendingSeats} en attente`;
		} else {
			barAttending.style.width = '0%';
			barPending.style.width = '0%';
			barDeclined.style.width = '0%';
			legendAttending.textContent = '0';
			legendPending.textContent = '0';
			legendDeclined.textContent = '0';
			statSummaryNote.textContent = 'Ajoutez des réponses pour voir la répartition';
		}

		tableBody.innerHTML = '';
		if (filtered.length === 0 && guests.length === 0) {
			tableWrap.style.display = 'none';
			emptyStateBox.style.display = 'block';
		} else {
			tableWrap.style.display = 'block';
			emptyStateBox.style.display = 'none';

			if (filtered.length === 0) {
				tableBody.innerHTML = `<tr><td colspan="6" style="padding: 2rem; text-align: center; color: var(--text-secondary); font-style: italic;">Aucun invité ne correspond à vos filtres.</td></tr>`;
			} else {
				filtered.forEach((g, idx) => {
					const tr = document.createElement('tr');
					tr.style.borderBottom = '1px solid var(--muted-paper)';
					tr.style.background = idx % 2 === 0 ? '#fff' : '#faf8f5';

					tr.innerHTML = `
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							<strong style="display: block; font-size: 1.05rem; color: var(--fg-pencil);">${g.name}</strong>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							<span style="font-size: 0.85rem; color: var(--text-secondary);">${g.group || 'Général'}</span>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper); text-align: center; font-weight: bold;">
							${g.partySize || 1}
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper); text-align: center;">
							<div style="display: flex; justify-content: center; gap: 0.25rem;">
								<button type="button" class="btn-status-toggle ${g.rsvpStatus === 'Attending' ? 'active-attending' : ''}" onclick="setRsvpStatus('${g.id}', 'Attending')">✓ Oui</button>
								<button type="button" class="btn-status-toggle ${g.rsvpStatus === 'Pending' ? 'active-pending' : ''}" onclick="setRsvpStatus('${g.id}', 'Pending')">? Attente</button>
								<button type="button" class="btn-status-toggle ${g.rsvpStatus === 'Declined' ? 'active-declined' : ''}" onclick="setRsvpStatus('${g.id}', 'Declined')">✗ Non</button>
							</div>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper);">
							<span style="font-size: 0.9rem; ${g.dietary && g.dietary !== 'Aucun' && g.dietary !== 'None' ? 'color: var(--accent-blue); font-weight: bold;' : 'color: var(--text-secondary);'}">
								${g.dietary || 'Aucun'}
							</span>
						</td>
						<td style="padding: 0.6rem; border: 1px solid var(--muted-paper); text-align: center;">
							<button type="button" class="action-icon-btn" title="Supprimer cet invité" onclick="deleteRsvpItem('${g.id}')">
								🗑️
							</button>
						</td>
					`;
					tableBody.appendChild(tr);
				});
			}
		}
	}

	loadGuests();
	render();
</script>
