---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "How Much Alcohol for Wedding: Exact Beer, Wine & Liquor Ratios (Free Buying Checklist)",
      "description": "Get exact shopping bottle counts for beer, wine, and liquor handles for 50, 100, 150, and 200 guests with real bar ratios and printable buying checklists.",
      "datePublished": "2026-08-18T00:00:00+00:00",
      "dateModified": "2026-08-18T00:00:00+00:00",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding",
        "logo": {
          "@type": "ImageObject",
          "url": "https://manage.wedding/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://manage.wedding/how-much-alcohol-for-wedding-ratios"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the best ratio of beer, wine, and liquor for a wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a standard full open bar, the proven distribution is 40% wine (5 glasses per 750ml bottle), 30% beer (individual cans or bottles), and 30% liquor (16 cocktails per 750ml bottle or 39 cocktails per 1.75L handle)."
          }
        },
        {
          "@type": "Question",
          "name": "Should you buy 750ml fifths or 1.75L handles for a wedding bar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Buy 1.75L handle bottles for high-volume well liquors like vodka, bourbon, and tequila to save 20% to 30% per ounce. Reserve 750ml fifths for specialty spirits like gin, spiced rum, and scotch."
          }
        },
        {
          "@type": "Question",
          "name": "How many cases of beer do you need for 100 wedding guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a 100-guest 5-hour reception with a full open bar, you will need approximately 150 beers, which equals 6 to 7 standard 24-pack cases split between light lagers and craft beers."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="How Much Alcohol for Wedding: Exact Beer, Wine & Liquor Ratios (Free Buying Checklist)"
  description="Get exact shopping bottle counts for beer, wine, and liquor handles for 50, 100, 150, and 200 guests with real bar ratios and printable buying checklists."
  schema={schema}
>
  <main class="container" style="padding-top: 2rem; padding-bottom: 4rem; max-width: 900px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
        { name: "Alcohol Ratios & Buying Checklist" }
      ]}
    />

    <!-- Header Section -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #fef3c7; color: #92400e; padding: 4px 12px; border-radius: 20px; border: 1.5px solid #d97706; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <span>🍾</span>
        <span>Bar Stocking & Shopping Blueprint</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
        How Much Alcohol for Wedding: Exact Beer, Wine & Liquor Ratios <span style="color: #b45309; font-style: italic;">(Free Buying Checklist)</span>
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;">
        <span>Published: August 2026</span>
        <span>•</span>
        <span>7 min read</span>
        <span>•</span>
        <span>By Manage.Wedding Editorial Team</span>
      </div>
    </header>

    <!-- AI Direct Citation Callout (BLUF) -->
    <div style="background: #f0fdf4; border: 2px solid #16a34a; border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: 3px 3px 0px #16a34a;">
      <div style="font-size: 0.82rem; font-weight: 800; color: #15803d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem;">
        🎯 Quick Answer Shopping Formula
      </div>
      <p class="font-body" style="font-size: 1.15rem; color: #14532d; font-weight: 600; line-height: 1.5; margin: 0;">
        For a 100-guest 5-hour wedding (500 total drinks), buy <strong>40 bottles of wine</strong> (24 red, 16 white), <strong>150 beers</strong> (7 cases of 24), and <strong>10 fifths (750ml) or 4 large handles (1.75L) of liquor</strong>, plus 150 lbs of ice and 35 liters of mixers.
      </p>
    </div>

    <!-- Interactive Tool Callout Hero -->
    <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
          Get Your Custom Liquor & Spirits Breakdown
        </h3>
        <p class="font-body" style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
          Calculate handles vs 750ml fifths, Costco case discounts, and retail cost estimates.
        </p>
      </div>
      <a href="/liquor-wedding-calculator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 10px 22px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.5rem;">
        <span>Open Liquor Sizer</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Main Content Body -->
    <article class="font-body" style="font-size: 1.1rem; line-height: 1.7; color: var(--fg-pencil);">
      
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2rem 0 1rem;">
        The Real-World Liquor Split: What Guests Actually Drink
      </h2>
      <p>
        Most generic wedding planning spreadsheets make a dangerous mistake: they assume all spirits are consumed equally. If you buy 3 bottles of vodka, 3 bottles of gin, 3 bottles of tequila, and 3 bottles of scotch, you will run out of vodka and tequila during cocktail hour and get stuck with unopened scotch at midnight.
      </p>
      <p>
        Decades of banquet catering records reveal that hard liquor consumption strictly follows this tier distribution:
      </p>

      <ul style="padding-left: 1.5rem; margin-bottom: 1.5rem;">
        <li style="margin-bottom: 0.5rem;"><strong>Vodka (35% of all liquor):</strong> The universal highball spirit. Goes into Tito's & Soda, Moscow Mules, and Espresso Martinis.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Tequila (25% of all liquor):</strong> Driven heavily by Margaritas and Palomas. Highly popular across spring and summer receptions.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Whiskey & Bourbon (20% of all liquor):</strong> Old Fashioneds, whiskey gingers, and neat pours.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Gin (10% of all liquor):</strong> Gin & Tonics, French 75s.</li>
        <li style="margin-bottom: 0.5rem;"><strong>Rum (10% of all liquor):</strong> Mojitos and rum & cokes.</li>
      </ul>

      <!-- 750ml vs 1.75L Table -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        750ml Fifths vs 1.75L Handles: The Costco Savings Math
      </h2>
      <p>
        If your venue allows BYOB (bring your own beverage), buying 1.75L "handle" bottles at Costco, Total Wine, or Sam's Club can slash your liquor bill by 25% to 35%. Here is how the bottle math compares:
      </p>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Bottle Size</th>
              <th style="padding: 12px 14px; font-weight: 800;">Volume in Oz</th>
              <th style="padding: 12px 14px; font-weight: 800;">Drinks (1.5 oz pour)</th>
              <th style="padding: 12px 14px; font-weight: 800;">Average Price</th>
              <th style="padding: 12px 14px; font-weight: 800;">Cost Per Drink</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Standard 750ml Fifth</td>
              <td style="padding: 12px 14px;">25.4 oz</td>
              <td style="padding: 12px 14px;">16 cocktails</td>
              <td style="padding: 12px 14px;">$24.00</td>
              <td style="padding: 12px 14px; font-weight: 600;">$1.50 / drink</td>
            </tr>
            <tr style="background: #f0fdf4;">
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">Large 1.75L Handle</td>
              <td style="padding: 12px 14px;">59.2 oz</td>
              <td style="padding: 12px 14px; font-weight: 800;">39 cocktails</td>
              <td style="padding: 12px 14px;">$38.00</td>
              <td style="padding: 12px 14px; font-weight: 800; color: #16a34a;">$0.97 / drink (35% Savings)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Master Shopping Checklist: Wine, Beer, Spirits & Mixers
      </h2>

      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; margin-bottom: 2rem;">
        <h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 1rem;">
          📋 100 Guests (5-Hour Open Bar) Complete Shopping List
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
          <div>
            <strong style="color: #92400e;">🍷 Wine (40 Bottles Total):</strong>
            <ul style="padding-left: 1.25rem; font-size: 0.95rem; margin-top: 0.25rem;">
              <li>14 bottles Cabernet Sauvignon or Pinot Noir</li>
              <li>10 bottles Red Blend or Malbec</li>
              <li>10 bottles Sauvignon Blanc or Pinot Grigio</li>
              <li>6 bottles Chardonnay or Rosé</li>
            </ul>
          </div>
          <div>
            <strong style="color: #0369a1;">🍺 Beer (150 Cans/Bottles):</strong>
            <ul style="padding-left: 1.25rem; font-size: 0.95rem; margin-top: 0.25rem;">
              <li>4 cases (96 cans) Light Lager (Corona, Stella, Miller)</li>
              <li>2 cases (48 cans) Craft IPA or Hazy Pale Ale</li>
              <li>1 case (24 cans) Hard Seltzer or Cider</li>
            </ul>
          </div>
          <div>
            <strong style="color: #15803d;">🍸 Spirits (If Using 1.75L Handles):</strong>
            <ul style="padding-left: 1.25rem; font-size: 0.95rem; margin-top: 0.25rem;">
              <li>2 handles Vodka (Tito's / Kirkland)</li>
              <li>1 handle Blanco/Reposado Tequila</li>
              <li>1 handle Bourbon (Maker's / Buffalo Trace)</li>
              <li>1 fifth (750ml) Gin</li>
            </ul>
          </div>
          <div>
            <strong style="color: #7c3aed;">🍋 Mixers, Ice & Garnishes:</strong>
            <ul style="padding-left: 1.25rem; font-size: 0.95rem; margin-top: 0.25rem;">
              <li>150 lbs Ice (15 x 10lb bags)</li>
              <li>12 liters Club Soda & Tonic Water</li>
              <li>8 liters Ginger Beer & Cola</li>
              <li>6 liters Cranberry Juice & Sour Mix</li>
              <li>15 Lemons + 15 Limes (sliced)</li>
            </ul>
          </div>
        </div>
      </div>

      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        State Return Laws: How to Protect Your Budget
      </h2>
      <p>
        In many US states (including California, New York, Washington, and Florida), alcohol retailers are legally permitted to accept returns on unopened, unchilled cases of wine and liquor with intact seals. 
      </p>
      <p>
        <strong>Rules for returning alcohol after a wedding:</strong>
      </p>
      <ol style="padding-left: 1.25rem; margin-bottom: 2rem; line-height: 1.6;">
        <li><strong>Never ice what you might return:</strong> Once wine labels become waterlogged in ice troughs, retailers will refuse them. Keep reserve cases in a dry, air-conditioned back room.</li>
        <li><strong>Keep the original receipt:</strong> Big-box stores like Total Wine require the exact itemized receipt within 30 to 90 days.</li>
        <li><strong>Check county restrictions:</strong> In ABC "control states" (e.g., Pennsylvania, North Carolina, Virginia), state-run liquor stores have strict return authorization windows.</li>
      </ol>

      <!-- Bottom Interactive CTA Section -->
      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 2rem; box-shadow: 4px 4px 0px var(--fg-pencil); text-align: center; margin: 3rem 0;">
        <h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
          Calculate Your Exact Bar Quantities
        </h3>
        <p class="font-body" style="font-size: 1.05rem; max-width: 600px; margin: 0 auto 1.5rem; color: var(--text-secondary);">
          Customize guest counts, drinking intensity, and export a printable shopping checklist for Total Wine or Costco.
        </p>
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="/liquor-wedding-calculator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 12px 24px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Open Liquor & Spirits Calculator &rarr;
          </a>
          <a href="/wedding-drink-calculator" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 12px 20px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            General Drink Calculator &rarr;
          </a>
        </div>
      </div>

    </article>

    <RelatedTools currentPath="/how-much-alcohol-for-wedding-ratios" category="food-beverage" />
  </main>
</Layout>
