---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Diseñador de Minutas de Boda Gratis para Imprimir (Textos y Tipografías Elegantes)";
const description = "Crea y personaliza minutas de boda para imprimir en minutos. Platos, alérgenos y dietas, tipografías prémium, formatos DL (10x21cm) y A5. Descarga en PDF vectorial y Word.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/reception-menu-maker/#webapp",
      "name": "Creador y Diseñador de Minutas de Boda",
      "url": "https://manage.wedding/es/reception-menu-maker",
      "inLanguage": "es",
      "description": "Diseña e imprime minutas de banquete de boda elegantes al instante. Personaliza tiempos del menú, tipografías clásicas y caligráficas, formatos DL para servilleta y descarga en PDF vectorial para imprenta.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Diseñar e Imprimir las Minutas del Menú de Boda",
      "description": "Guía paso a paso para redactar, maquetar e imprimir las minutas y cartas del banquete nupcial.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Revisa Alergias y Dietas de los Invitados",
          "text": "Comprueba las confirmaciones de asistencia para señalar platos vegetarianos (V), veganos (VG), sin gluten (SG) o sin lactosa (SL)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Elige el Estilo Visual y Tipografía",
          "text": "Selecciona un estilo botánico, black-tie sobrio, romántico o rústico con tipografías serif o caligráficas."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Redacta los Platos con Redacción Gastronómica",
          "text": "Describe los platos con técnicas culinarias (ej. solomillo a baja temperatura con reducción de Pedro Ximénez y parmentier trufada)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Elige el Formato de Tarjeta",
          "text": "Selecciona formato DL alargado (10 × 21 cm para colocar sobre la servilleta) o 13 × 18 cm para peana central de mesa."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 5: Descarga el PDF Vectorial e Imprime en Papel Texturado",
          "text": "Descarga el archivo vectorial e imprime en cartulina verjurada o papel de algodón de 250g–300g."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuál es el tamaño estándar de una minuta de boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El tamaño más popular en bodas es el formato DL alargado de 10 × 21 cm (9,9 × 21 cm), ideal para deslizar dentro de la servilleta doblada o colocar sobre el bajoplato. Otro tamaño habitual para mesas compartidas es 13 × 18 cm (A5)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué gramaje de papel se recomienda para imprimir minutas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se recomienda cartulina de entre 250 g/m² y 350 g/m². Los acabados con textura de lino, algodón verjurado o papel kraft aportan cuerpo, elegancia y evitan que la tarjeta se curve."
          }
        },
        {
          "@type": "Question",
          "name": "¿Debe colocarse una minuta individual para cada comensal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En banquetes servidos en mesa, la etiqueta nupcial marca una minuta individual por persona sobre el plato o servilleta. En mesas tipo buffet o cóctel, bastan 2 minutas dobles con soporte por mesa o un cartel vertical en caballete a la entrada."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo indicar alérgenos y opciones vegetarianas en la minuta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se añaden iconos o siglas estandarizadas al final del nombre del plato: (V) Vegetariano, (VG) Vegano, (SG) Sin Gluten, (SL) Sin Lactosa, acompañadas de una breve leyenda al pie de la minuta."
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} schema={schema}>
  <!-- Import Elegant Wedding Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    <Breadcrumb title="Diseñador de Minutas de Boda" category="food-dining" />
    
    <!-- Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">PDF Vectorial y Tipografías Nupciales</span>
      <h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Diseñador de <span class="accent-italic">Minutas de Boda</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 760px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Diseña minutas de banquete elegantes y listas para imprenta en segundos. Tipografías prémium, marcos botánicos, formato servilleta DL (10×21 cm) o A5 y descarga gratis en PDF vectorial.
      </p>
    </header>

    <!-- Main Studio Grid -->
    <div id="app-area" class="fade-in" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2.5rem; align-items: start; margin-bottom: 3.5rem;">

      <!-- Hidden images used for jsPDF generation -->
      <img id="floral-tl" src="/images/floral-tl.webp" alt="Botanical corner top left" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-tr" src="/images/floral-tr.webp" alt="Botanical corner top right" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-bl" src="/images/floral-bl.webp" alt="Botanical corner bottom left" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />
      <img id="floral-br" src="/images/floral-br.webp" alt="Botanical corner bottom right" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="display: none;" crossorigin="anonymous" />

      <!-- ===== LEFT COLUMN: DESIGN CONTROLS & EDITOR ===== -->
      <div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
          <h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
            1. Diseño y Tipografía de la Minuta
          </h2>
          <span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
            Editor en Vivo
          </span>
        </div>

        <!-- Design Theme Selector -->
        <div class="form-group" style="margin-bottom: 1.2rem;">
          <label class="form-label" for="themePicker" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Estilo Visual y Fondo</label>
          <select id="themePicker" class="form-input" style="width: 100%; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 600; background: #f8fafc;">
            <option value="botanical" selected>🌿 Jardín Botánico (Pergamino, Marcos y Esquinas Florales)</option>
            <option value="black-tie">👑 Black-Tie Sobrio (Blanco Puro y Marco Fino Negro)</option>
            <option value="romantic">🌸 Caligrafía Romántica y Tonos Rosa Empolvado</option>
            <option value="rustic">📜 Papel Kraft Rústico y Tipografía Toscana</option>
            <option value="minimalist">✨ Escandinavo Minimalista (Limpio y Sin Marco)</option>
          </select>
        </div>

        <!-- Typography / Font Pairings -->
        <div class="form-group" style="margin-bottom: 1.2rem;">
          <label class="form-label" for="fontPicker" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Combinación de Fuentes</label>
          <select id="fontPicker" class="form-input" style="width: 100%; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 600; background: #f8fafc;">
            <option value="playfair" selected>🏛️ Playfair Display (Serif Clásica Editorial)</option>
            <option value="cinzel">👑 Cinzel / Romana Imperial (Solemne y Distinguida)</option>
            <option value="cormorant">📜 Cormorant Garamond (Serif Fina Tradicional)</option>
            <option value="script">✍️ Alex Brush Caligrafía (Fluida y Elegante)</option>
            <option value="modern">📐 Montserrat Contemporánea (Moderna y Minimalista)</option>
          </select>
        </div>

        <!-- Card Dimensions / Format -->
        <div class="form-group" style="margin-bottom: 1.2rem;">
          <label class="form-label" for="sizePicker" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Tamaño de la Tarjeta / Minuta</label>
          <select id="sizePicker" class="form-input" style="width: 100%; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 600;">
            <option value="dl" selected>📇 DL Alargado 10 × 21 cm (Para Servilleta o Bajoplato — Más Popular)</option>
            <option value="a5">📜 13 × 18 cm / A5 (Tarjetón de Mesa o Soporte Central)</option>
            <option value="a4">📄 A4 Vertical (Cartel para Entrada de Buffet o Cóctel)</option>
          </select>
        </div>

        <!-- Header Names & Date -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil); margin-bottom: 1.2rem;">
          <div>
            <label class="form-label" for="coupleNames" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Nombres de los Novios</label>
            <input id="coupleNames" class="form-input" type="text" value="Lucía & Alejandro" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-weight: 600;" />
          </div>
          <div>
            <label class="form-label" for="weddingDate" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Fecha del Enlace</label>
            <input id="weddingDate" class="form-input" type="text" value="18 de Octubre de 2026" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-weight: 600;" />
          </div>
        </div>

        <!-- Header Title Text -->
        <div class="form-group" style="margin-bottom: 1.2rem;">
          <label class="form-label" for="menuTitle" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Título Superior</label>
          <input id="menuTitle" class="form-input" type="text" value="MENÚ DE BODA" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-weight: 700; letter-spacing: 2px;" />
        </div>

        <!-- Courses Section Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin: 1.5rem 0 0.75rem 0; border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
          <h3 class="font-heading" style="font-size: 1.25rem; margin: 0; color: var(--fg-pencil);">
            2. Platos y Tiempos del Banquete
          </h3>
          <span style="font-size: 0.8rem; color: var(--text-secondary);">Un plato por línea</span>
        </div>

        <!-- Dynamic courses list -->
        <div id="course-list"></div>

        <!-- Add Course Button -->
        <button id="addCourseBtn" type="button" class="menu-add-btn" style="margin-bottom: 1.5rem;">
          + Añadir Otro Plato o Sección del Menú
        </button>

        <!-- Dietary Key Toggle -->
        <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1.5rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.92rem; font-weight: 600;">
            <input type="checkbox" id="check-dietary-key" checked style="width: 18px; height: 18px;" />
            <span>Mostrar Leyenda de Alérgenos al Pie (V, VG, SG, SL)</span>
          </label>
        </div>

        <!-- Download & Export Actions -->
        <div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
          <button id="printMenuBtn" class="hand-btn" style="width: 100%; padding: 12px; font-size: 1.05rem; gap: 0.5rem;">
            <span>🖨️</span> Imprimir Minuta (PDF Alta Resolución)
          </button>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
            <button id="downloadVectorPdfBtn" class="hand-btn secondary" style="padding: 10px; font-size: 0.92rem; gap: 0.35rem;">
              <span>📥</span> Descargar PDF Vectorial
            </button>
            <button id="exportDocBtn" class="hand-btn secondary" style="padding: 10px; font-size: 0.92rem; gap: 0.35rem;">
              <span>📄</span> Exportar a Word (.doc)
            </button>
          </div>
        </div>

      </div>

      <!-- ===== RIGHT COLUMN: STICKY LIVE PREVIEW ===== -->
      <div style="position: sticky; top: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <span style="font-family: var(--font-heading); font-size: 1.1rem; color: var(--fg-pencil); font-weight: 700;">
            Vista Previa en Vivo
          </span>
          <span id="preview-size-tag" style="font-size: 0.82rem; font-weight: 700; background: #e2e8f0; padding: 2px 8px; border-radius: 4px;">
            DL Alargado (10 × 21 cm)
          </span>
        </div>

        <div style="display: flex; justify-content: center;">
          
          <!-- Outer Card Container -->
          <div id="menuPreview" class="menu-preview-box" style="
            width: 100%;
            max-width: 400px;
            background: #fdfbf7;
            border: 2px solid #2d2d2d;
            box-shadow: 6px 6px 0px rgba(0,0,0,0.15);
            padding: 40px 32px;
            position: relative;
            min-height: 600px;
            box-sizing: border-box;
            transition: all 0.25s ease;
          ">
            
            <!-- Outer Frame Border -->
            <div id="frame-outer" style="position: absolute; top: 10px; bottom: 10px; left: 10px; right: 10px; border: 1.5px solid #2d2d2d; pointer-events: none; z-index: 1;"></div>
            
            <!-- Inner Frame Border -->
            <div id="frame-inner" style="position: absolute; top: 14px; bottom: 14px; left: 14px; right: 14px; border: 0.75px solid #94a3b8; pointer-events: none; z-index: 1;"></div>

            <!-- Floral Corners -->
            <img id="prev-floral-tl" src="/images/floral-tl.webp" alt="Floral frame top left" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; top: 15px; left: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-tr" src="/images/floral-tr.webp" alt="Floral frame top right" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; top: 15px; right: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-bl" src="/images/floral-bl.webp" alt="Floral frame bottom left" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; bottom: 15px; left: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />
            <img id="prev-floral-br" src="/images/floral-br.webp" alt="Floral frame bottom right" width="60" height="60" loading="lazy" decoding="async" aria-hidden="true" style="position: absolute; bottom: 15px; right: 15px; width: 60px; height: 60px; opacity: 0.85; pointer-events: none; z-index: 2;" />

            <!-- Live Menu Typography Content -->
            <div id="menuContent" style="position: relative; z-index: 3; text-align: center;"></div>

          </div>

        </div>
      </div>

    </div>

    <!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
    <div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
      <div class="tape" style="margin: 0 auto 0.75rem;"></div>
      
      <div style="text-align: center; margin-bottom: 1.25rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumen Rápido (Regla de Oro)</span>
        <h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
          Guía de Medidas e Impresión de Minutas de Boda
        </h2>
      </div>

      <!-- Formula Highlight Box -->
      <div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
        <p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.6; text-align: center; font-weight: 600;">
          <strong>Minutas Individuales:</strong> Formato DL 10 × 21 cm (Papel Verjurado 250–300 g) • <strong>Mesa Compartida:</strong> 13 × 18 cm con Peana (2 por mesa).
        </p>
      </div>

      <!-- Semantic Benchmark Table -->
      <div style="overflow-x: auto; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 650px;">
          <thead>
            <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Formato de Minuta</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Dimensiones</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Cantidad a Imprimir</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Gramaje Recomendado</th>
              <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Ubicación en Mesa</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-red);">DL Alargado Individual</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">10 × 21 cm (99 × 210 mm)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">1 por invitado (+10% margen)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">250g–300g Verjurado o Algodón</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Dentro de servilleta o sobre bajoplato</td>
            </tr>
            <tr style="background: #faf8f5;">
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--fg-pencil);">Tarjetón Clásico A5</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">13 × 18 cm (127 × 178 mm)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">1 por comensal</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">300g Mate Satinado</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Servicio emplatado de alta cocina</td>
            </tr>
            <tr>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">Peana / Soporte Doble</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">13 × 18 cm (Caballete)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">2 tarjetas por mesa (8-10 pax)</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600; color: var(--accent-red);">350g Cartulina Rígida</td>
              <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Centro de mesa junto a las flores</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Related Planning Tools -->
    <RelatedTools currentPath="/es/reception-menu-maker" category="dining" />

  </main>
</Layout>

<style>
  .menu-add-btn {
    width: 100%;
    padding: 0.75rem;
    border: 2px dashed var(--fg-pencil);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--fg-pencil);
    border-radius: 4px;
    transition: background 0.15s;
  }
  .menu-add-btn:hover { background: #f5f1e8; }

  .course-block {
    border: 1.5px solid var(--fg-pencil);
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1rem;
    background: #fdfbf7;
  }
  .course-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .course-block-label {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
    color: var(--fg-pencil);
  }
  .course-rm-btn {
    background: #fee2e2;
    border: 1px solid #ef4444;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    color: #b91c1c;
    font-weight: bold;
    padding: 2px 6px;
  }
  .course-rm-btn:hover { background: #fecaca; }

  .dietary-tag-pill {
    display: inline-block;
    font-size: 0.70rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 4px;
    vertical-align: middle;
  }
</style>

<script>
  let courses: { title: string; items: string }[] = [
    { 
      title: 'ENTRANTE', 
      items: 'Burrata con Tomates de Huerta, Pesto de Albahaca y Piñones Tostados [V, SG]\nCarpaccio de Ternera Gallega con Lascas de Parmesano y Aceite de Trufa' 
    },
    { 
      title: 'PLATO PRINCIPAL', 
      items: 'Solomillo de Ternera al Pedro Ximénez con Parmentier Trufada [SG]\nLomo de Lubina Salvaje sobre Cama de Verduras Asadas y Salsa de Cítricos\nRisotto de Boletus y Setas Silvestres con Crujiente de Salvia [V, VG, SG]' 
    },
    { 
      title: 'POSTRE Y BRINDIS', 
      items: 'Tarta Nupcial de Frutos Rojos y Crema Diplomática\nCafé de Especialidad, Licores Artesanales y Copa de Cava' 
    },
  ];

  function renderEditor() {
    const list = document.getElementById('course-list');
    if (!list) return;
    list.innerHTML = '';

    courses.forEach((c, i) => {
      const div = document.createElement('div');
      div.className = 'course-block';
      div.innerHTML = `
        <div class="course-block-header">
          <p class="course-block-label">Tiempo / Sección ${i + 1}</p>
          ${courses.length > 1 ? `<button class="course-rm-btn" data-rm="${i}" title="Eliminar Sección">✕ Eliminar</button>` : ''}
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <div>
            <label class="form-label" style="font-size: 0.85rem; display: block; font-weight: bold; margin-bottom: 0.2rem;">Título de la Sección (ej. Entrantes, Pescados, Postre)</label>
            <input class="form-input ci-t" data-i="${i}" type="text" value="${c.title}" style="width: 100%; box-sizing: border-box; padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
          </div>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
              <label class="form-label" style="font-size: 0.85rem; margin: 0; font-weight: bold;">Platos (Uno por línea • usa [V], [SG], [VG], [SL])</label>
              <div style="display: flex; gap: 3px;">
                <button type="button" class="btn-tag" data-tag="[SG]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+SG</button>
                <button type="button" class="btn-tag" data-tag="[V]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+V</button>
                <button type="button" class="btn-tag" data-tag="[VG]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+VG</button>
                <button type="button" class="btn-tag" data-tag="[SL]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+SL</button>
              </div>
            </div>
            <textarea class="form-input ci-v" data-i="${i}" style="width: 100%; box-sizing: border-box; min-height: 75px; resize: vertical; padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.92rem;">${c.items}</textarea>
          </div>
        </div>
      `;
      list.appendChild(div);
    });

    list.querySelectorAll('[data-rm]').forEach(b =>
      b.addEventListener('click', e => {
        courses.splice(+(e.currentTarget as HTMLElement).getAttribute('data-rm')!, 1);
        renderEditor();
        renderPreview();
      })
    );
    list.querySelectorAll('.ci-t').forEach(el =>
      el.addEventListener('input', e => {
        courses[+(e.currentTarget as HTMLInputElement).getAttribute('data-i')!].title = (e.currentTarget as HTMLInputElement).value;
        renderPreview();
      })
    );
    list.querySelectorAll('.ci-v').forEach(el =>
      el.addEventListener('input', e => {
        courses[+(e.currentTarget as HTMLTextAreaElement).getAttribute('data-i')!].items = (e.currentTarget as HTMLTextAreaElement).value;
        renderPreview();
      })
    );
    list.querySelectorAll('.btn-tag').forEach(b =>
      b.addEventListener('click', e => {
        const tag = (e.currentTarget as HTMLElement).getAttribute('data-tag');
        const idx = +(e.currentTarget as HTMLElement).getAttribute('data-i')!;
        const textarea = list.querySelector(`.ci-v[data-i="${idx}"]`) as HTMLTextAreaElement;
        if (textarea && tag) {
          textarea.value += ` ${tag}`;
          courses[idx].items = textarea.value;
          renderPreview();
        }
      })
    );
  }

  function formatDishWithBadges(text: string): string {
    let formatted = text.trim();
    formatted = formatted.replace(/\[(SG|GF)\]/gi, '<span class="dietary-tag-pill" style="background:#e0f2fe; color:#0369a1; border:1px solid #7dd3fc;">SG</span>');
    formatted = formatted.replace(/\[V\]/gi, '<span class="dietary-tag-pill" style="background:#f0fdf4; color:#15803d; border:1px solid #86efac;">V</span>');
    formatted = formatted.replace(/\[VG\]/gi, '<span class="dietary-tag-pill" style="background:#fefce8; color:#a16207; border:1px solid #fef08a;">VG</span>');
    formatted = formatted.replace(/\[(SL|DF)\]/gi, '<span class="dietary-tag-pill" style="background:#fdf2f8; color:#be185d; border:1px solid #fbcfe8;">SL</span>');
    formatted = formatted.replace(/\[(SF|NF)\]/gi, '<span class="dietary-tag-pill" style="background:#fff7ed; color:#c2410c; border:1px solid #fdba74;">SF</span>');
    return formatted;
  }

  function renderPreview() {
    const el = document.getElementById('menuContent');
    const previewBox = document.getElementById('menuPreview');
    const frameOuter = document.getElementById('frame-outer');
    const frameInner = document.getElementById('frame-inner');
    const floralCorners = [
      document.getElementById('prev-floral-tl'),
      document.getElementById('prev-floral-tr'),
      document.getElementById('prev-floral-bl'),
      document.getElementById('prev-floral-br'),
    ];

    if (!el || !previewBox || !frameOuter || !frameInner) return;

    const theme = (document.getElementById('themePicker') as HTMLSelectElement)?.value || 'botanical';
    const font = (document.getElementById('fontPicker') as HTMLSelectElement)?.value || 'playfair';
    const size = (document.getElementById('sizePicker') as HTMLSelectElement)?.value || 'dl';
    const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Lucía & Alejandro';
    const date = (document.getElementById('weddingDate') as HTMLInputElement)?.value || '18 de Octubre de 2026';
    const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'MENÚ DE BODA';
    const showDietary = (document.getElementById('check-dietary-key') as HTMLInputElement)?.checked ?? true;

    const sizeTag = document.getElementById('preview-size-tag');
    if (sizeTag) {
      if (size === 'dl') sizeTag.textContent = 'DL Alargado (10 × 21 cm)';
      else if (size === 'a5') sizeTag.textContent = '13 × 18 cm / A5';
      else sizeTag.textContent = 'A4 Vertical';
    }

    if (size === 'dl') {
      previewBox.style.maxWidth = '360px';
      previewBox.style.minHeight = '640px';
    } else if (size === 'a5') {
      previewBox.style.maxWidth = '420px';
      previewBox.style.minHeight = '560px';
    } else {
      previewBox.style.maxWidth = '460px';
      previewBox.style.minHeight = '620px';
    }

    if (theme === 'botanical') {
      previewBox.style.background = '#fdfbf7';
      previewBox.style.color = '#1e293b';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '1.5px solid #2d2d2d';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.75px solid #94a3b8';
      floralCorners.forEach(img => { if (img) img.style.display = 'block'; });
    } else if (theme === 'black-tie') {
      previewBox.style.background = '#ffffff';
      previewBox.style.color = '#0f172a';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '2px solid #0f172a';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.5px solid #0f172a';
      floralCorners.forEach(img => { if (img) img.style.display = 'none'; });
    } else if (theme === 'romantic') {
      previewBox.style.background = '#fff9f8';
      previewBox.style.color = '#3b1c1c';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '1.5px solid #c48b71';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.75px dashed #c48b71';
      floralCorners.forEach(img => { if (img) img.style.display = 'block'; });
    } else if (theme === 'rustic') {
      previewBox.style.background = '#f5ecd7';
      previewBox.style.color = '#2c1810';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '2px solid #5c3a21';
      frameInner.style.display = 'block';
      frameInner.style.border = '1px dashed #8c5a31';
      floralCorners.forEach(img => { if (img) img.style.display = 'none'; });
    } else if (theme === 'minimalist') {
      previewBox.style.background = '#ffffff';
      previewBox.style.color = '#1e293b';
      frameOuter.style.display = 'none';
      frameInner.style.display = 'none';
      floralCorners.forEach(img => { if (img) img.style.display = 'none'; });
    }

    let headerFontFamily = "'Playfair Display', serif";
    let bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
    let titleLetterSpacing = "3px";
    let namesStyle = "font-style: italic;";

    if (font === 'playfair') {
      headerFontFamily = "'Playfair Display', serif";
      bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
      titleLetterSpacing = "3px";
    } else if (font === 'cinzel') {
      headerFontFamily = "'Cinzel', serif";
      bodyFontFamily = "'Cormorant Garamond', serif";
      titleLetterSpacing = "4px";
      namesStyle = "font-weight: 600; letter-spacing: 2px;";
    } else if (font === 'cormorant') {
      headerFontFamily = "'Cormorant Garamond', serif";
      bodyFontFamily = "'Cormorant Garamond', serif";
      titleLetterSpacing = "3px";
      namesStyle = "font-style: italic; font-size: 1.25rem;";
    } else if (font === 'script') {
      headerFontFamily = "'Alex Brush', cursive";
      bodyFontFamily = "'Playfair Display', serif";
      titleLetterSpacing = "1px";
      namesStyle = "font-family: 'Alex Brush', cursive; font-size: 1.85rem; line-height: 1.1;";
    } else if (font === 'modern') {
      headerFontFamily = "'Montserrat', sans-serif";
      bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
      titleLetterSpacing = "5px";
      namesStyle = "font-family: 'Montserrat', sans-serif; font-size: 0.95rem; letter-spacing: 2px; text-transform: uppercase;";
    }

    let html = `
      <div style="margin-bottom: 12px;">
        <h3 style="font-family: ${headerFontFamily}; font-size: ${font === 'script' ? '2.4rem' : '1.7rem'}; letter-spacing: ${titleLetterSpacing}; text-transform: ${font === 'script' ? 'none' : 'uppercase'}; margin: 0 0 4px 0; font-weight: 700;">
          ${menuTitle}
        </h3>
        <p style="${namesStyle} margin: 0 0 2px 0;">
          ${names}
        </p>
        <p style="font-size: 0.80rem; letter-spacing: 1.5px; opacity: 0.7; margin: 0; font-family: 'Montserrat', sans-serif;">
          ${date}
        </p>
        <div style="width: 40px; border-top: 1.5px solid currentColor; margin: 12px auto; opacity: 0.6;"></div>
      </div>
    `;

    courses.forEach((c, i) => {
      if (i > 0) {
        html += `<div style="width: 24px; border-top: 1px dashed currentColor; margin: 12px auto; opacity: 0.4;"></div>`;
      }
      
      const rawDishes = c.items.split('\n').filter(l => l.trim());
      const formattedDishes = rawDishes.map(d => `<div style="margin-bottom: 4px; line-height: 1.45;">${formatDishWithBadges(d)}</div>`).join('');

      html += `
        <div style="margin-bottom: 8px;">
          <h4 style="font-family: ${headerFontFamily}; font-size: 1.05rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin: 0 0 4px 0; color: var(--accent-red);">
            ${c.title}
          </h4>
          <div style="font-family: ${bodyFontFamily}; font-size: 0.88rem; opacity: 0.9;">
            ${formattedDishes || '<span style="opacity: 0.4; font-style: italic;">Introduce platos...</span>'}
          </div>
        </div>
      `;
    });

    if (showDietary) {
      html += `
        <div style="margin-top: 18px; padding-top: 8px; border-top: 0.5px solid currentColor; opacity: 0.65; font-size: 0.72rem; font-family: 'Montserrat', sans-serif; letter-spacing: 0.5px;">
          (V) Vegetariano • (VG) Vegano • (SG) Sin Gluten • (SL) Sin Lactosa
        </div>
      `;
    }

    el.innerHTML = html;
  }

  function printHighResMenu() {
    const theme = (document.getElementById('themePicker') as HTMLSelectElement)?.value || 'botanical';
    const font = (document.getElementById('fontPicker') as HTMLSelectElement)?.value || 'playfair';
    const size = (document.getElementById('sizePicker') as HTMLSelectElement)?.value || 'dl';
    const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Lucía & Alejandro';
    const date = (document.getElementById('weddingDate') as HTMLInputElement)?.value || '18 de Octubre de 2026';
    const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'MENÚ DE BODA';
    const showDietary = (document.getElementById('check-dietary-key') as HTMLInputElement)?.checked ?? true;

    let cardW = '100mm';
    let cardH = '210mm';
    if (size === 'a5') { cardW = '130mm'; cardH = '180mm'; }
    else if (size === 'a4') { cardW = '210mm'; cardH = '297mm'; }

    let bgStyle = '#fdfbf7';
    let textColor = '#1e293b';
    let borderColor = '#2d2d2d';
    let innerBorderColor = '#94a3b8';

    if (theme === 'black-tie') {
      bgStyle = '#ffffff'; textColor = '#0f172a'; borderColor = '#0f172a'; innerBorderColor = '#0f172a';
    } else if (theme === 'romantic') {
      bgStyle = '#fff9f8'; textColor = '#3b1c1c'; borderColor = '#c48b71'; innerBorderColor = '#c48b71';
    } else if (theme === 'rustic') {
      bgStyle = '#f5ecd7'; textColor = '#2c1810'; borderColor = '#5c3a21'; innerBorderColor = '#8c5a31';
    } else if (theme === 'minimalist') {
      bgStyle = '#ffffff'; textColor = '#1e293b'; borderColor = 'transparent'; innerBorderColor = 'transparent';
    }

    let headerFontFamily = "'Playfair Display', serif";
    let bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
    if (font === 'cinzel') { headerFontFamily = "'Cinzel', serif"; bodyFontFamily = "'Cormorant Garamond', serif"; }
    else if (font === 'cormorant') { headerFontFamily = "'Cormorant Garamond', serif"; bodyFontFamily = "'Cormorant Garamond', serif"; }
    else if (font === 'script') { headerFontFamily = "'Alex Brush', cursive"; bodyFontFamily = "'Playfair Display', serif"; }
    else if (font === 'modern') { headerFontFamily = "'Montserrat', sans-serif"; bodyFontFamily = "'Plus Jakarta Sans', sans-serif"; }

    let coursesHtml = '';
    courses.forEach((c, i) => {
      if (i > 0) coursesHtml += `<div style="width: 25px; border-top: 1px dashed currentColor; margin: 10px auto; opacity: 0.4;"></div>`;
      const dishes = c.items.split('\n').filter(l => l.trim()).map(d => `<div style="margin-bottom: 4px; font-size: 10pt; line-height: 1.45;">${formatDishWithBadges(d)}</div>`).join('');
      coursesHtml += `
        <div style="margin-bottom: 8px;">
          <h4 style="font-family: ${headerFontFamily}; font-size: 13pt; margin: 0 0 3px 0; font-weight: 700; text-transform: uppercase; color: #b91c1c;">${c.title}</h4>
          <div style="font-family: ${bodyFontFamily};">${dishes}</div>
        </div>
      `;
    });

    const printWin = window.open('', '_blank');
    if (!printWin) return;

    printWin.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>${menuTitle} — ${names}</title>
        <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
        <style>
          @page { size: auto; margin: 0.25in; }
          body { margin: 0; padding: 20px; display: flex; justify-content: center; background: #eaedf0; font-family: ${bodyFontFamily}; }
          .menu-card {
            width: ${cardW};
            height: ${cardH};
            background: ${bgStyle};
            color: ${textColor};
            padding: 35px 25px;
            box-sizing: border-box;
            position: relative;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
          }
          .dietary-tag-pill { display: inline-block; font-size: 7.5pt; font-weight: bold; padding: 1px 4px; border-radius: 2px; margin-left: 3px; border: 1px solid #94a3b8; }
          @media print {
            body { background: transparent; padding: 0; }
            .menu-card { box-shadow: none; page-break-inside: avoid; }
          }
        </style>
      </head>
      <body>
        <div class="menu-card">
          <div style="position: absolute; top: 8px; bottom: 8px; left: 8px; right: 8px; border: 1.5px solid ${borderColor}; pointer-events: none;"></div>
          <div style="position: absolute; top: 12px; bottom: 12px; left: 12px; right: 12px; border: 0.75px solid ${innerBorderColor}; pointer-events: none;"></div>
          
          <div style="margin-bottom: 12px;">
            <h1 style="font-family: ${headerFontFamily}; font-size: ${font === 'script' ? '28pt' : '20pt'}; margin: 0 0 2px 0; font-weight: 700; text-transform: ${font === 'script' ? 'none' : 'uppercase'};">${menuTitle}</h1>
            <p style="font-size: 13pt; font-style: italic; margin: 0 0 2px 0;">${names}</p>
            <p style="font-size: 9pt; opacity: 0.7; margin: 0; font-family: 'Montserrat', sans-serif;">${date}</p>
            <div style="width: 40px; border-top: 1.5px solid currentColor; margin: 10px auto; opacity: 0.6;"></div>
          </div>

          <div>${coursesHtml}</div>

          ${showDietary ? `
            <div style="margin-top: 15px; padding-top: 8px; border-top: 0.5px solid currentColor; opacity: 0.65; font-size: 8pt; font-family: 'Montserrat', sans-serif;">
              (V) Vegetariano • (VG) Vegano • (SG) Sin Gluten • (SL) Sin Lactosa
            </div>
          ` : ''}
        </div>
        <script>window.onload = function() { window.print(); };<\/script>
      </body>
      </html>
    `);
    printWin.document.close();
  }

  function exportWordDoc() {
    const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Lucía & Alejandro';
    const date = (document.getElementById('weddingDate') as HTMLInputElement)?.value || '18 de Octubre de 2026';
    const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'MENÚ DE BODA';

    let coursesContent = '';
    courses.forEach(c => {
      coursesContent += `<h3 style="color:#b91c1c; margin-top:15px; text-transform:uppercase;">${c.title}</h3><ul>`;
      c.items.split('\n').filter(l => l.trim()).forEach(item => {
        coursesContent += `<li style="margin-bottom:4px;">${item}</li>`;
      });
      coursesContent += `</ul>`;
    });

    const content = `
      <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
      <head><title>${menuTitle}</title>
      <style>body { font-family: 'Georgia', serif; font-size: 11pt; } h1, h2 { text-align: center; } ul { list-style-type: square; }</style>
      </head>
      <body>
        <h1 style="letter-spacing: 2px;">${menuTitle}</h1>
        <h2 style="font-weight:normal; font-style:italic;">${names}</h2>
        <p style="text-align:center; color:#666;">${date}</p>
        <hr/>
        ${coursesContent}
        <br/><hr/>
        <p style="font-size:9pt; text-align:center; color:#888;">Manage.Wedding — Diseñador de Minutas de Boda</p>
      </body></html>
    `;

    const blob = new Blob([content], { type: 'application/msword' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'minuta-banquete-boda.doc';
    link.click();
  }

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) { resolve(); return; }
      const s = document.createElement('script');
      s.src = src; s.onload = () => resolve(); s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  async function downloadVectorPdf() {
    const btn = document.getElementById('downloadVectorPdfBtn') as HTMLButtonElement;
    if (btn) { btn.textContent = 'Generando PDF…'; btn.disabled = true; }

    try {
      await loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js');

      const names = (document.getElementById('coupleNames') as HTMLInputElement)?.value || 'Lucía & Alejandro';
      const date  = (document.getElementById('weddingDate')  as HTMLInputElement)?.value || '18 de Octubre de 2026';
      const menuTitle = (document.getElementById('menuTitle') as HTMLInputElement)?.value || 'MENÚ DE BODA';
      const size = (document.getElementById('sizePicker') as HTMLSelectElement)?.value || 'dl';

      const { jsPDF } = (window as any).jspdf;
      
      let W = 100;
      let H = 210;
      if (size === 'a5') { W = 130; H = 180; }
      else if (size === 'a4') { W = 210; H = 297; }

      const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: [W, H] });
      const cx = W / 2;

      pdf.setFillColor(253, 251, 247);
      pdf.rect(0, 0, W, H, 'F');

      pdf.setDrawColor(45, 45, 45);
      pdf.setLineWidth(0.5);
      pdf.rect(6, 6, W - 12, H - 12);

      pdf.setDrawColor(180, 180, 180);
      pdf.setLineWidth(0.2);
      pdf.rect(8, 8, W - 16, H - 16);

      let y = size === 'dl' ? 24 : 20;

      pdf.setFont('times', 'bold');
      pdf.setFontSize(size === 'dl' ? 18 : 16);
      pdf.setTextColor(30, 30, 30);
      pdf.text(menuTitle, cx, y, { align: 'center' });
      y += 7;

      pdf.setFont('times', 'italic');
      pdf.setFontSize(size === 'dl' ? 13 : 12);
      pdf.setTextColor(50, 50, 50);
      pdf.text(names, cx, y, { align: 'center' });
      y += 5;

      pdf.setFont('helvetica', 'normal');
      pdf.setFontSize(8);
      pdf.setTextColor(120, 120, 120);
      pdf.text(date, cx, y, { align: 'center' });
      y += 5;

      pdf.setDrawColor(80, 80, 80);
      pdf.setLineWidth(0.3);
      pdf.line(cx - 15, y, cx + 15, y);
      y += 8;

      courses.forEach((course, i) => {
        if (i > 0) {
          pdf.setDrawColor(180, 180, 180);
          pdf.setLineDashPattern([1, 1], 0);
          pdf.line(cx - 8, y, cx + 8, y);
          pdf.setLineDashPattern([], 0);
          y += 6;
        }

        pdf.setFont('times', 'bold');
        pdf.setFontSize(size === 'dl' ? 11 : 10);
        pdf.setTextColor(180, 45, 35);
        pdf.text(course.title, cx, y, { align: 'center' });
        y += 5;

        pdf.setFont('times', 'normal');
        pdf.setFontSize(size === 'dl' ? 9.5 : 8.5);
        pdf.setTextColor(50, 50, 50);
        const rawItems = course.items.split('\n').filter(l => l.trim());
        rawItems.forEach(item => {
          const cleanItem = item.replace(/\[(GF|SG|V|VG|DF|SL|NF|SF)\]/g, '($1)');
          pdf.text(cleanItem, cx, y, { align: 'center' });
          y += 4.5;
        });
        y += 3;
      });

      pdf.save('minuta-boda.pdf');
    } catch (err) {
      console.error('PDF error:', err);
      alert('No se pudo generar el PDF. Utiliza el botón de imprimir en el navegador.');
    } finally {
      if (btn) { btn.textContent = 'Descargar PDF Vectorial'; btn.disabled = false; }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderEditor();
    renderPreview();

    ['themePicker', 'fontPicker', 'sizePicker', 'coupleNames', 'weddingDate', 'menuTitle', 'check-dietary-key'].forEach(id => {
      const el = document.getElementById(id);
      el?.addEventListener('input', renderPreview);
      el?.addEventListener('change', renderPreview);
    });

    document.getElementById('addCourseBtn')?.addEventListener('click', () => {
      courses.push({ title: 'NUEVO PLATO', items: 'Descripción del plato o sorbete [SG]' });
      renderEditor();
      renderPreview();
      document.getElementById('course-list')?.lastElementChild?.scrollIntoView({ behavior: 'smooth' });
    });

    document.getElementById('printMenuBtn')?.addEventListener('click', printHighResMenu);
    document.getElementById('downloadVectorPdfBtn')?.addEventListener('click', downloadVectorPdf);
    document.getElementById('exportDocBtn')?.addEventListener('click', exportWordDoc);
  });
</script>
