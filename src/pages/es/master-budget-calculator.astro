---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Calculadora de Presupuesto Maestro de Boda",
      "url": "https://manage.wedding/es/master-budget-calculator",
      "inLanguage": "es",
      "description": "Calculadora de presupuesto de boda gratuita: reparte gastos de banquete, fotografía, vestido, música y decoración con cálculo de coste por comensal y exportación a Word, PDF y Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Crear y Distribuir el Presupuesto de tu Boda",
      "description": "Guía paso a paso para calcular y repartir los fondos de tu boda entre espacio, banquete, fotografía, vestuario y fondo de imprevistos.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Establece el Presupuesto Total Disponible",
          "text": "Suma los ahorros personales, la aportación mensual prevista y la ayuda confirmada de las familias para fijar el límite máximo de gasto."
        },
        {
          "@type": "HowToStep",
          "name": "Asigna el 45% al 50% para Espacio y Banquete",
          "text": "Reserva aproximadamente la mitad de tu presupuesto para alquiler de finca, cóctel de bienvenida, menú principal, barra libre y menaje."
        },
        {
          "@type": "HowToStep",
          "name": "Dedica del 12% al 15% para Fotografía y Vídeo",
          "text": "Presupuesta fotógrafo profesional, segundo operador, vídeo resumen cinematográfico y álbum impreso."
        },
        {
          "@type": "HowToStep",
          "name": "Distribuye Vestuario, Flores y Música",
          "text": "Asigna entre un 8% y 10% para vestidos/trajes y peluquería, 8% para flores y decoración, y 8% para DJ, grupo o música en vivo."
        },
        {
          "@type": "HowToStep",
          "name": "Reserva un 5% para Fondo de Emergencia e IVA",
          "text": "Mantén un cojín de seguridad del 5% para imprevistos como carpas por lluvia, menús de proveedores, horas extra y propinas."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuál es el desglose porcentual recomendado para el presupuesto de una boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La distribución estándar recomendada en el sector nupcial es: 45-50% para Finca y Banquete, 12-15% para Fotografía y Vídeo, 8-10% para Vestuario y Belleza, 8-10% para Flores y Decoración, 8-10% para Música y DJ, 3% para Papelería e Invitaciones, 2% para Detalles y Regalos, y 5% de Fondo de Imprevistos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo influye el número de invitados en el coste total de la boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aproximadamente el 55% al 60% de todos los gastos de una boda son variables por persona (menú, barra libre, alquiler de sillas, tarta, minutas y centros de mesa). Reducir la lista de invitados en 20 personas supone un ahorro directo de 3.000€ a 5.000€ sin renunciar a calidad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué gastos imprevistos suelen pasarse por alto en el presupuesto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es imprescindible contemplar: suplementos de IVA (10% o 21%), comidas de fotógrafo y DJ (30€-50€), canon de corte de tarta o descorche, arreglos de modista para el vestido (250€-600€), horas extra de barra libre y propinas al equipo de servicio."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo puedo exportar mi presupuesto a Word, PDF o Excel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Haz clic en los botones 'Exportar Word (.doc)', 'Imprimir / PDF' o 'Exportar Excel (.csv)' situados en la parte superior para descargar tu desglose financiero completo."
          }
        }
      ]
    }
  ]
};

const defaultCategories = [
  { id: 'venue', name: 'Espacio y Banquete', defaultPct: 48, color: '#ffb3ba', desc: 'Alquiler de finca, cóctel, menú, barra libre y servicio' },
  { id: 'photo', name: 'Fotografía y Vídeo', defaultPct: 13, color: '#bae1ff', desc: 'Cobertura completa, segundo fotógrafo, vídeo y preboda' },
  { id: 'attire', name: 'Vestuario y Belleza', defaultPct: 9, color: '#ffdfba', desc: 'Vestido de novia, traje, arreglos, peinado y maquillaje' },
  { id: 'florals', name: 'Flores y Decoración', defaultPct: 8, color: '#baffc9', desc: 'Ramo de novia, arco de ceremonia, centros de mesa y luces' },
  { id: 'entertain', name: 'Música y Animación', defaultPct: 7, color: '#ffffba', desc: 'DJ, sonido para ceremonia, música en vivo o banda' },
  { id: 'rings', name: 'Alianzas y Trámites', defaultPct: 4, color: '#fbcfe8', desc: 'Alianzas de boda, expediente matrimonial y oficiante' },
  { id: 'stationery', name: 'Papelería y Envíos', defaultPct: 3, color: '#e8baff', desc: 'Invitaciones, Save-the-Date, minutas, sellos y cartelería' },
  { id: 'favors', name: 'Detalles de Invitados', defaultPct: 2, color: '#fed7aa', desc: 'Regalos para invitados, detalles de testigos y padres' },
  { id: 'transport', name: 'Transporte y Autobuses', defaultPct: 2, color: '#ccfbf1', desc: 'Autobús para invitados y coche nupcial de novios' },
  { id: 'buffer', name: 'Fondo de Imprevistos e IVA', defaultPct: 4, color: '#e5e7eb', desc: 'IVA, horas extra, menús de proveedores e imprevistos' }
];
---

<Layout 
	title="Calculadora de Presupuesto Maestro de Boda (Gratis con Excel y PDF) | Manage.Wedding"
	description="Calcula y reparte el presupuesto de tu boda fácilmente. Desglosa gastos de banquete, foto, vestido, flores y música con descarga en Word, PDF y CSV."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Presupuesto Maestro de Boda" category="budget-finance" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de Presupuesto Maestro de Boda
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Reparte los fondos de tu boda de forma inteligente entre finca, banquete, fotografía y vestuario. Controla el coste por comensal y exporta en <strong>Word (.doc)</strong>, <strong>PDF</strong> o <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Budget Overview Dashboard & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div style="flex: 1; min-width: 250px;">
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💰 Planificador Financiero de Boda
					</h2>
					<p class="font-body" style="color: var(--text-secondary); font-size: 0.9rem; margin: 0.2rem 0 0 0; text-align: center;">
						Ajusta los porcentajes y descarga tu presupuesto personalizado
					</p>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; width: 100%;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Exportar Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Imprimir / PDF
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Exportar Excel (.csv)
					</button>
					<button type="button" id="btn-reset-defaults" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						🔄 Ratios Estándar
					</button>
				</div>
			</div>

			<!-- Preset Budget Tiers -->
			<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
				<span class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
					⚡ Rangos de Presupuesto Habituales:
				</span>
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center;">
					<button type="button" class="tier-btn" data-amt="12000" data-guests="40">🪙 Boda Íntima (12.000€ • 40 Invitados)</button>
					<button type="button" class="tier-btn active-tier" data-amt="25000" data-guests="100">💎 Media Estándar (25.000€ • 100 Invitados)</button>
					<button type="button" class="tier-btn" data-amt="45000" data-guests="150">👑 Elegante y Completa (45.000€ • 150 Invitados)</button>
					<button type="button" class="tier-btn" data-amt="80000" data-guests="200">✨ Gran Boda Premium (80.000€ • 200 Invitados)</button>
				</div>
			</div>

			<!-- Core Global Inputs: Total Budget, Currency & Guest Count -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
				
				<!-- Total Budget -->
				<div>
					<label for="total-budget-input" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Presupuesto Total de la Boda
					</label>
					<div style="display: flex; align-items: center; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; overflow: hidden;">
						<span id="currency-symbol-display" style="padding: 0.6rem 0.8rem; background: var(--bg-paper); border-right: 1px solid var(--fg-pencil); font-weight: bold; font-family: var(--font-heading);">€</span>
						<input type="number" id="total-budget-input" value="25000" min="500" step="500" style="flex: 1; border: none; padding: 0.6rem; font-family: var(--font-body); font-size: 1.2rem; font-weight: bold; outline: none; background: transparent;">
					</div>
				</div>

				<!-- Currency Selector -->
				<div>
					<label for="currency-select" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Moneda
					</label>
					<select id="currency-select" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff;">
						<option value="€" selected>€ (EUR - Euro España / Europa)</option>
						<option value="$">$ (USD / MXN / Latam)</option>
						<option value="£">£ (GBP - Libra Esterlina)</option>
						<option value="R$">R$ (BRL - Real Brasileño)</option>
					</select>
				</div>

				<!-- Estimated Guest Count -->
				<div>
					<label for="guest-count-input" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Número Estimado de Invitados
					</label>
					<input type="number" id="guest-count-input" value="100" min="5" max="1000" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: #fff;">
				</div>

			</div>

			<!-- Dynamic Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Presupuesto Total</span>
					<strong id="stat-total-display" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">25.000€</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">100% Asignado</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Coste por Invitado</span>
					<strong id="stat-per-guest" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">250,00€</strong>
					<span id="stat-guest-count-note" style="font-size: 0.75rem; color: #1e40af; display: block;">Para 100 invitados</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Finca y Banquete (48%)</span>
					<strong id="stat-venue-amt" class="font-heading" style="font-size: 1.8rem; color: #15803d;">12.000€</strong>
					<span style="font-size: 0.75rem; color: #166534; display: block;">Principal partida fija</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Fondo Imprevistos (4%)</span>
					<strong id="stat-buffer-amt" class="font-heading" style="font-size: 1.8rem; color: #a16207;">1.000€</strong>
					<span style="font-size: 0.75rem; color: #854d0e; display: block;">Cojín de seguridad</span>
				</div>
			</div>

			<!-- Visual Stacked Expense Distribution Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Distribución Visual del Gasto</span>
					<span id="pct-warning" class="font-body" style="font-size: 0.85rem; color: #15803d; font-weight: bold;">100% Asignado (Presupuesto Equilibrado)</span>
				</div>
				<div id="stacked-budget-bar" style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #e5e0d8; margin-bottom: 0.75rem;">
					<!-- Injected via JS -->
				</div>
			</div>

		</div>

		<!-- Interactive Category Allocation Grid -->
		<section style="margin-bottom: 3.5rem;">
			<h2 class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); text-align: center; margin-bottom: 0.5rem;">
				📊 Desglose por Partidas y Porcentajes
			</h2>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); text-align: center; max-width: 600px; margin: 0 auto 1.75rem;">
				Mueve los deslizadores de porcentaje o edita los importes directamente. Todas las partidas se recalculan en tiempo real.
			</p>

			<div id="categories-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem;">
				<!-- Injected via JS -->
			</div>
		</section>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Presupuesto Oficial Maestro de Boda</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado el: <span id="print-date"></span> | Presupuesto Total: <span id="print-total"></span> | Por Invitado: <span id="print-per-guest"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Partida de Gasto</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 60px; text-align: center;">% Cuota</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 100px; text-align: right;">Presupuesto Asignado</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Conceptos y Servicios Incluidos</th>
					</tr>
				</thead>
				<tbody id="print-table-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 2.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumen Ejecutivo Rápido</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Regla Práctica: Desglose del Presupuesto de Boda
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 750px; margin: 0 auto; font-weight: 500;">
					¿Poco tiempo? Aquí tienes la fórmula estándar en 1 minuto y la tabla comparativa para presupuestos de 20.000€, 35.000€ y 50.000€.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 La Fórmula Base en 1 Minuto:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					48% Finca y Banquete + 13% Foto y Vídeo + 9% Vestuario y Belleza + 8% Flores y Deco + 7% Música y DJ + 11% Alianzas, Papelería y Detalles + 4% Fondo Imprevistos = 100% Total
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 580px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Categoría de Gasto</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">% Objetivo</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Boda 20.000€</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Boda 35.000€</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Boda 50.000€</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Espacio y Banquete</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">48%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">9.600€</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">16.800€</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">24.000€</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Fotografía y Vídeo</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">13%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">2.600€</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">4.550€</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">6.500€</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #d97706;">Vestuario y Belleza</td>
