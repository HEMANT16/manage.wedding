---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-thank-you-cards/#webapp",
      "name": "Generador de Textos para Tarjetas de Agradecimiento de Boda",
      "url": "https://manage.wedding/es/wedding-thank-you-cards",
      "inLanguage": "es",
      "description": "Generador gratuito de textos para tarjetas de agradecimiento de boda. Redacta notas personalizadas y emotivas para regalos en efectivo, aportaciones a la luna de miel, lista de boda, asistencia y proveedores. Exporta a PDF y Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Escribir una Nota de Agradecimiento de Boda Perfecta",
      "description": "La fórmula de 4 frases protocolarias para redactar notas de agradecimiento sinceras y elegantes.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Frase 1: Agradece la Asistencia o Compañía",
          "text": "Da las gracias por haber compartido vuestro gran día o por haber viajado para acompañaros."
        },
        {
          "@type": "HowToStep",
          "name": "Frase 2: Menciona el Regalo con Delicadeza",
          "text": "Agradece el detalle recibido ('vuestro generoso regalo' o 'la preciosa vajilla') sin mencionar nunca la cantidad exacta de dinero en euros."
        },
        {
          "@type": "HowToStep",
          "name": "Frase 3: Explica en Qué lo Vais a Disfrutar",
          "text": "Comparte en qué proyecto o experiencia lo utilizaréis ('nos servirá para nuestra aventura en Japón' o 'para amueblar nuestro nuevo hogar')."
        },
        {
          "@type": "HowToStep",
          "name": "Frase 4: Despedida Afectuosa y Futuro Encuentro",
          "text": "Cierra con una frase cálida expresando vuestras ganas de veros pronto."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto tiempo hay para enviar las tarjetas de agradecimiento de boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El protocolo actual recomienda enviar las tarjetas de agradecimiento dentro de los 3 meses posteriores al regreso del viaje de novios. Si recibís regalos antes del enlace, enviad la nota en un plazo de 2 a 3 semanas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo agradecer el dinero en efectivo o transferencia bancaria?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nunca se debe escribir la cifra exacta en euros. Utilizad fórmulas como 'vuestra gran generosidad' o 'vuestro generoso regalo' y explicad en qué lo destinaréis (el viaje de luna de miel, reformas o el futuro hogar)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Las notas de agradecimiento deben escribirse a mano?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, el protocolo nupcial valora enormemente que las tarjetas se escriban a mano de puño y letra de los novios, ya que demuestra un aprecio sincero y personal."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Generador de Textos para Tarjetas de Agradecimiento de Boda | Manage.Wedding"
	description="Genera textos personalizados para tarjetas de agradecimiento de boda. Frases para regalos en efectivo, luna de miel, lista de regalos y proveedores. Exporta a PDF y Word."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Tarjetas de Agradecimiento" category="stationery-creative" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Más de 14.800 Notas Redactadas</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Generador de Notas <span class="accent-italic">de Agradecimiento</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Genera redacciones elegantes y emotivas para agradecer transferencias, regalos físicos, luna de miel y asistencia. Copia en 1 clic o imprime directamente en cartulina.
			</p>
		</header>

		<!-- Main Interactive Generator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Input Form -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Personalizar Nota
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Fórmulas de Protocolo
					</span>
				</div>

				<!-- Recipient Name -->
				<div class="form-group">
					<label class="form-label" for="guest-names">Nombre(s) del Invitado / Destinatario</label>
					<input type="text" id="guest-names" class="form-input" value="Tía Carmen y Tío Antonio" placeholder="ej. Tía Carmen y Tío Antonio, Laura y David" />
				</div>

				<!-- Relationship to Couple -->
				<div class="form-group">
					<label class="form-label" for="relationship">Relación o Parentesco</label>
					<select id="relationship" class="form-input" style="cursor: pointer;">
						<option value="family-close">Familia Muy Cercana (Padres, Abuelos, Hermanos)</option>
						<option value="family-extended" selected>Familiares (Tíos, Primos, Sobrinos)</option>
						<option value="friends-close">Amigos Íntimos / Testigos</option>
						<option value="friends-casual">Compañeros de Trabajo / Amigos</option>
						<option value="absent">Persona que no Pudo Asistir (Envió Regalo)</option>
						<option value="vendor">Proveedor de Boda (Fotógrafo, Wedding Planner, Catering)</option>
					</select>
				</div>

				<!-- Gift Category -->
				<div class="form-group">
					<label class="form-label" for="gift-type">Tipo de Regalo Recibido</label>
					<select id="gift-type" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="cash" selected>💵 Regalo Económico / Transferencia / Efectivo</option>
						<option value="honeymoon">🏝️ Aportación al Viaje de Novios / Luna de Miel</option>
						<option value="registry">🎁 Regalo de la Lista de Bodas (Hogar, Cocina, Decoración)</option>
						<option value="attendance">✨ Asistencia y Compañía (Sin Regalo Material)</option>
						<option value="group">👥 Regalo Conjunto / En Grupo</option>
						<option value="giftcard">💳 Tarjeta Regalo</option>
					</select>
				</div>

				<!-- Gift Specific Item / Detail -->
				<div class="form-group" id="gift-detail-group">
					<label class="form-label" for="gift-detail">Detalle del Regalo o Destino del Dinero</label>
					<input type="text" id="gift-detail" class="form-input" value="nuestro viaje de luna de miel a Japón y el nuevo hogar" placeholder="ej. la excursión en barco en Bali, la vajilla de porcelana" />
				</div>

				<!-- Tone / Style Selector -->
				<div class="form-group">
					<label class="form-label">Tono y Estilo de Redacción</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="tone-btn hand-btn is-active" data-tone="heartfelt" style="padding: 8px; font-size: 0.88rem;">
							💖 Emotivo y Cercano
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="formal" style="padding: 8px; font-size: 0.88rem;">
							🏛️ Formal y Elegante
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="casual" style="padding: 8px; font-size: 0.88rem;">
							✨ Moderno y Dinámico
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="short" style="padding: 8px; font-size: 0.88rem;">
							⚡ Breve y Conciso (3 Frases)
						</button>
					</div>
				</div>

				<!-- Personal Memory (Optional) -->
				<div class="form-group">
					<label class="form-label" for="personal-memory">Recuerdo Especial / Anécdota (Opcional)</label>
					<input type="text" id="personal-memory" class="form-input" value="¡Nos encantó veros dándolo todo en la pista de baile!" placeholder="ej. ¡Muchas gracias por viajar desde tan lejos para estar con nosotros!" />
				</div>

				<!-- Sign-off Names -->
				<div class="form-group">
					<label class="form-label" for="signoff-names">Vuestros Nombres (Firma)</label>
					<input type="text" id="signoff-names" class="form-input" value="Elena & Alejandro" placeholder="ej. Elena & Alejandro" />
				</div>

				<button id="btn-generate-notes" class="hand-btn" style="width: 100%; padding: 14px; font-size: 1.1rem; margin-top: 0.5rem; justify-content: center;">
					<span>✨</span> Generar 3 Opciones de Texto
				</button>

			</div>

			<!-- Right Column: 3 Generated Options & Tracker -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Results Header -->
				<div style="display: flex; justify-content: space-between; align-items: center;">
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						Opciones de Texto Redactadas
					</h3>
					<span id="word-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
						~45-65 palabras | 1,5 min de escritura
					</span>
				</div>

				<!-- Option 1 Card (Recommended) -->
				<div class="hand-card" style="padding: 1.5rem; background: #fffcf5; border-left: 6px solid var(--accent-red); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Opción 1: Recomendación Principal
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-1" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copiar Texto
						</button>
					</div>
					<p id="note-opt-1" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
Queridos Tía Carmen y Tío Antonio,

¡Muchísimas gracias por acompañarnos en el día de nuestra boda! Teneros con nosotros significó muchísimo para ambos. Os estamos profundamente agradecidos por vuestro generoso regalo para nuestro viaje de luna de miel a Japón y el nuevo hogar. ¡Nos encantó veros dándolo todo en la pista de baile! Tenemos muchísimas ganas de vernos pronto.

Con todo nuestro cariño,
Elena & Alejandro
					</p>
				</div>

				<!-- Option 2 Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid var(--accent-blue); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-blue); letter-spacing: 0.05em;">
							Opción 2: Redacción Alternativa
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-2" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copiar Texto
						</button>
					</div>
					<p id="note-opt-2" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
Queridos Tía Carmen y Tío Antonio,

No tenemos palabras para agradeceros vuestro cariño y compañía en nuestra boda. Vuestra presencia llenó de alegría nuestra celebración. Muchísimas gracias de corazón por vuestro detalle tan especial para nuestro viaje de luna de miel a Japón y el nuevo hogar. ¡Nos ayuda a comenzar esta nueva etapa juntos de la manera más bonita!

Un abrazo muy fuerte,
Elena & Alejandro
					</p>
				</div>

				<!-- Option 3 Card (Short & Sweet) -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid #16a34a; position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #16a34a; letter-spacing: 0.05em;">
							Opción 3: Breve y Directa
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-3" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copiar Texto
						</button>
					</div>
					<p id="note-opt-3" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;">
Queridos Tía Carmen y Tío Antonio,

Gracias por formar parte de un día tan especial y por vuestra enorme generosidad. Vuestro regalo para nuestro viaje de luna de miel a Japón y el nuevo hogar nos hace muchísima ilusión como recién casados. ¡Gracias por vuestro cariño incondicional!

Con cariño,
Elena & Alejandro
					</p>
				</div>

				<!-- Action Bar -->
				<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
					<button id="btn-print-note" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>🖨️</span> Imprimir Tarjeta (PDF)
					</button>
					<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>📄</span> Exportar a Word (.doc)
					</button>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Guía Rápida de Redacción</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Estructura y Reglas para Escribir Notas de Agradecimiento
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					La fórmula de 4 frases y los plazos recomendados para enviar las tarjetas a tus invitados.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📝 La Fórmula de 4 Frases para el Agradecimiento:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					[1. Agradece la Asistencia/Compañía] + [2. Menciona el Regalo sin dar cifras exactas] + [3. Explica en qué lo vais a disfrutar] + [4. Despedida cálida y encuentro futuro] • ⏰ Plazo: Hasta 3 meses tras el regreso de la luna de miel.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Tipo de Regalo</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Frase Aconsejada de Protocolo</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Qué Evitar</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Dinero / Transferencia</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Muchísimas gracias por vuestro generoso regalo para nuestra luna de miel en Italia / entrada de nuestra casa."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Nunca mencionar la cantidad en euros (ej. "Gracias por los 200 €").</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Regalo Físico / Lista de Boda</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Muchísimas gracias por la preciosa vajilla. ¡Ya la hemos estrenado en nuestra primera comida familiar de domingo!"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Evitar frases genéricas como "Gracias por el objeto".</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Experiencia de Luna de Miel</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"¡Muchísimas gracias por regalarnos esa increíble excursión en catamarán al atardecer en Maui!"</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">No olvidar mencionar la actividad concreta financiada.</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Persona que no Pudo Asistir</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"Os echamos muchísimo de menos en nuestro gran día, pero sentimos todo vuestro cariño a través de vuestro regalo."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">No hacer reproches por no haber asistido.</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #d97706);">Solo Asistencia (Sin Regalo)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">"¡Muchísimas gracias por estar a nuestro lado! Verte disfrutar en la pista de baile hizo nuestro día inolvidable."</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; color: #dc2626;">Nunca aludir a la ausencia de regalo material.</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guía Completa de Agradecimientos de Boda
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Escribir más de 100 tarjetas a mano no tiene por qué ser agotador. Sigue un ritmo de 10 tarjetas diarias en pareja para completarlas en solo 10 días.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. El Plazo de los 3 Meses
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Existe el mito popular de que se dispone de un año entero. En el protocolo actual, demorarse más de tres meses tras el regreso de la luna de miel resulta descortés.
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Regalos Recibidos Antes de la Boda:</strong> Enviar la nota en <strong>2 a 3 semanas</strong> para confirmar al remitente que ha llegado bien antes de los preparativos finales.</li>
					<li><strong>Regalos del Día de la Boda:</strong> Enviar todas las notas en un plazo de <strong>3 meses</strong> tras volver del viaje.</li>
				</ul>
			</section>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Firma Conjunta de la Pareja
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Aunque solo uno de los dos se encargue de la caligrafía, el texto debe redactarse siempre en plural (<em>"Nos ha encantado"</em>, <em>"Os estamos muy agradecidos"</em>) y firmado con los nombres de ambos cónyuges.
				</p>
			</section>

			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Preguntas Frecuentes
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Hay que agradecer también a los proveedores?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Enviar un breve mensaje de agradecimiento al fotógrafo, wedding planner, florista o chef del catering junto con una reseña online de 5 estrellas es el mejor reconocimiento profesional a su trabajo.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Se pueden enviar agradecimientos por WhatsApp o email?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Para amigos muy jóvenes o compañeros de trabajo un mensaje digital puede ser un complemento rápido, pero para familiares y padrinos la tarjeta física en cartulina sigue siendo insustituible.
					</p>
				</details>
			</section>

		</article>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/es/wedding-thank-you-cards" category="stationery" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const guestNamesInput = document.getElementById('guest-names');
		const relationshipSelect = document.getElementById('relationship');
		const giftTypeSelect = document.getElementById('gift-type');
		const giftDetailInput = document.getElementById('gift-detail');
		const giftDetailGroup = document.getElementById('gift-detail-group');
		const memoryInput = document.getElementById('personal-memory');
		const signoffInput = document.getElementById('signoff-names');
		const toneButtons = document.querySelectorAll('.tone-btn');
		const btnGenerate = document.getElementById('btn-generate-notes');

		const noteOpt1 = document.getElementById('note-opt-1');
		const noteOpt2 = document.getElementById('note-opt-2');
		const noteOpt3 = document.getElementById('note-opt-3');
		const wordCountBadge = document.getElementById('word-count-badge');
		const btnPrint = document.getElementById('btn-print-note');
		const btnDoc = document.getElementById('btn-export-doc');

		let currentTone = 'heartfelt';

		toneButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				toneButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentTone = btn.getAttribute('data-tone');
				generateNotes();
			});
		});

		giftTypeSelect.addEventListener('change', () => {
			const type = giftTypeSelect.value;
			if (type === 'attendance') {
				giftDetailGroup.style.display = 'none';
			} else {
				giftDetailGroup.style.display = 'block';
				if (type === 'cash') giftDetailInput.placeholder = 'ej. nuestra luna de miel en Japón y el nuevo hogar';
				else if (type === 'honeymoon') giftDetailInput.placeholder = 'ej. la excursión en barco al atardecer';
				else if (type === 'registry') giftDetailInput.placeholder = 'ej. la vajilla de porcelana';
				else if (type === 'group') giftDetailInput.placeholder = 'ej. la cafetera espresso';
				else if (type === 'giftcard') giftDetailInput.placeholder = 'ej. la tarjeta para decorar el jardín';
			}
			generateNotes();
		});

		function generateNotes() {
			const names = guestNamesInput.value.trim() || 'Estimados Amigos';
			const gift = giftTypeSelect.value;
			const detail = giftDetailInput.value.trim() || 'vuestro maravilloso regalo';
			const memory = memoryInput.value.trim();
			const signoff = signoffInput.value.trim() || 'Elena & Alejandro';

			let opt1 = '', opt2 = '', opt3 = '';
			const memoryClause = memory ? ` ${memory}` : '';

			if (currentTone === 'heartfelt') {
				if (gift === 'cash') {
					opt1 = `Queridos ${names},\n\n¡Muchísimas gracias por celebrar el día de nuestra boda con nosotros! Teneros allí significó muchísimo para ambos. Os estamos profundamente agradecidos por vuestro generoso regalo para ${detail}.${memoryClause} ¡Tenemos muchísimas ganas de vernos pronto!\n\nCon todo nuestro cariño,\n${signoff}`;
					opt2 = `Queridos ${names},\n\nNo tenemos palabras para agradeceros vuestro cariño y compañía en nuestra boda. Vuestra presencia llenó de alegría nuestra celebración. Muchísimas gracias de corazón por vuestro detalle para ${detail}. ¡Nos ayuda a comenzar esta nueva etapa juntos de la manera más especial!${memoryClause}\n\nUn abrazo muy fuerte,\n${signoff}`;
					opt3 = `Queridos ${names},\n\nGracias por formar parte de un día tan especial y por vuestra enorme generosidad. Vuestro detalle para ${detail} nos emociona enormemente como recién casados.${memoryClause} ¡Gracias por vuestro cariño incondicional!\n\nCon cariño,\n${signoff}`;
				} else if (gift === 'honeymoon') {
					opt1 = `Queridos ${names},\n\n¡Muchísimas gracias por acompañarnos en nuestra boda! Estamos sumamente agradecidos por vuestra aportación para ${detail}. Hizo que nuestra luna de miel fuera inolvidable.${memoryClause}\n\nCon cariño y gratitud,\n${signoff}`;
					opt2 = `Queridos ${names},\n\nCompartir nuestro gran día con vosotros fue un regalo único. Gracias de corazón por hacernos disfrutar de ${detail} durante el viaje.${memoryClause}\n\nUn abrazo con cariño,\n${signoff}`;
					opt3 = `Queridos ${names},\n\n¡Gracias por vuestro amor y por vuestro fantástico detalle para ${detail}! Vuestro cariño hizo que nuestro viaje de novios fuera extraordinario.${memoryClause}\n\nCon todo nuestro amor,\n${signoff}`;
				} else if (gift === 'registry') {
					opt1 = `Queridos ${names},\n\n¡Muchas gracias por celebrar nuestro gran día con nosotros! Nos encanta el detalle de ${detail} que elegisteis de nuestra lista. ¡Ya tiene su rincón perfecto en casa!${memoryClause}\n\nCon cariño,\n${signoff}`;
					opt2 = `Queridos ${names},\n\nFue maravilloso veros en nuestra boda. Muchísimas gracias por vuestro regalo de ${detail}. ¡Lo disfrutaremos en muchísimas reuniones familiares!${memoryClause}\n\nUn fuerte abrazo,\n${signoff}`;
					opt3 = `Queridos ${names},\n\nGracias por compartir nuestra felicidad y por el detalle de ${detail}. Vuestra generosidad significa muchísimo para nosotros mientras creamos nuestro hogar.${memoryClause}\n\nCon todo nuestro afecto,\n${signoff}`;
				} else {
					opt1 = `Queridos ${names},\n\n¡Muchísimas gracias por celebrar el día de nuestra boda con nosotros! Vuestra presencia, risas y cariño hicieron que la fiesta fuera inolvidable.${memoryClause} ¡Nos sentimos muy afortunados de teneros en nuestras vidas!\n\nCon mucho cariño,\n${signoff}`;
					opt2 = `Queridos ${names},\n\n¡Nos hizo inmensamente felices veros en nuestra boda! Gracias por acompañarnos y arroparnos en el comienzo de nuestro matrimonio.${memoryClause} ¡Nos vemos muy pronto!\n\nUn abrazo cálido,\n${signoff}`;
					opt3 = `Queridos ${names},\n\n¡Gracias por haber formado parte del mejor día de nuestras vidas! Vuestro apoyo y alegría significaron todo para nosotros cuando dimos el 'sí, quiero'.${memoryClause}\n\nCon todo nuestro cariño,\n${signoff}`;
				}
			} else if (currentTone === 'formal') {
				opt1 = `Estimados ${names},\n\nQueremos expresarles nuestro más sincero agradecimiento por honrarnos con su presencia en el enlace de nuestra boda. Apreciamos profundamente su generoso obsequio para ${detail}.${memoryClause} Su aprecio y consideración en el inicio de nuestra vida matrimonial son un verdadero privilegio.\n\nAtentamente,\n${signoff}`;
				opt2 = `Estimados ${names},\n\nDeseamos transmitirles nuestro afectuoso agradecimiento por acompañarnos en esta celebración tan señalada. Muchas gracias por su generoso regalo de ${detail}.${memoryClause} Fue un inmenso honor contar con su distinguida presencia.\n\nCon nuestro más distinguido saludo,\n${signoff}`;
				opt3 = `Estimados ${names},\n\nMuchas gracias por compartir la alegría de nuestro matrimonio. Les agradecemos de corazón su valiosa aportación para ${detail} y su constante apoyo a nuestra nueva familia.${memoryClause}\n\nCon sincero respeto y afecto,\n${signoff}`;
			} else if (currentTone === 'casual') {
				opt1 = `¡Hola ${names}!\n\n¡Muchísimas gracias por venir a darlo todo con nosotros! ¡Hicisteis que la boda fuera divertidísima! Nos hace una ilusión tremenda ${detail}.${memoryClause} ¡Tenemos que quedar muy pronto!\n\n¡Un abrazo enorme!\n${signoff}`;
				opt2 = `Queridos ${names},\n\n¡Gracias por poner tanta energía y fiesta a nuestra boda! Nos chifla ${detail}.${memoryClause} ¡Sois los mejores!\n\nBesos y abrazos,\n${signoff}`;
				opt3 = `¡Hola ${names}!\n\n¡Un millón de gracias por acompañarnos y por el regalazo de ${detail}! Nos hace una ilusión bárbara.${memoryClause} ¡Nos vemos ya mismo!\n\nCon mucho amor,\n${signoff}`;
			} else {
				opt1 = `Queridos ${names},\n\nMuchas gracias por acompañarnos en el día de nuestra boda y por vuestro generoso detalle para ${detail}.${memoryClause} ¡Os queremos mucho!\n\nCon cariño,\n${signoff}`;
				opt2 = `Queridos ${names},\n\n¡Nos encantó veros en nuestra boda! Muchísimas gracias por vuestro regalo de ${detail}.${memoryClause} Os estamos muy agradecidos.\n\nUn fuerte abrazo,\n${signoff}`;
				opt3 = `Queridos ${names},\n\nGracias por hacer inolvidable nuestra boda y por vuestro maravilloso detalle para ${detail}.${memoryClause} ¡Todo nuestro cariño!\n\nCon amor,\n${signoff}`;
			}

			noteOpt1.textContent = opt1;
			noteOpt2.textContent = opt2;
			noteOpt3.textContent = opt3;

			const words = opt1.split(/\s+/).length;
			wordCountBadge.textContent = `~${words} palabras | ~1,5 min de escritura`;
		}

		[guestNamesInput, relationshipSelect, giftDetailInput, memoryInput, signoffInput].forEach(inp => {
			inp.addEventListener('input', generateNotes);
		});
		btnGenerate.addEventListener('click', generateNotes);

		document.querySelectorAll('.copy-note-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				const targetId = btn.getAttribute('data-target');
				const text = document.getElementById(targetId).textContent;
				navigator.clipboard.writeText(text).then(() => {
					const orig = btn.textContent;
					btn.textContent = '✅ ¡Copiado!';
					setTimeout(() => { btn.textContent = orig; }, 2000);
				});
			});
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Imprimir Nota de Agradecimiento — Manage.Wedding</title>
					<style>
						@page { size: 15cm 10cm; margin: 10mm; }
						body { font-family: Georgia, serif; font-size: 11pt; line-height: 1.6; color: #1e293b; padding: 5mm; }
					</style>
				</head>
				<body>
					<div>${noteText}</div>
					<script>window.onload = function() { window.print(); };<\/script>
				</body>
				</html>
			`);
			printWindow.document.close();
		});

		btnDoc.addEventListener('click', () => {
			const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Nota de Agradecimiento de Boda</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 12pt; line-height: 1.6; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Borrador de Nota de Agradecimiento</h2>
					<p>${noteText}</p>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = `agradecimiento-${guestNamesInput.value.replace(/[^a-zA-Z0-9]/g, '_')}.doc`;
			link.click();
		});

		generateNotes();
	</script>
</Layout>
