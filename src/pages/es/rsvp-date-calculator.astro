---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Calculadora de Fechas de Invitaciones de Boda y RSVP (Plazos Exactos)";
const description = "Calcula cuándo enviar el Save the Date, las invitaciones de boda y fijar la fecha límite de confirmación (RSVP) con nuestra calculadora gratuita.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/rsvp-date-calculator/#webapp",
      "name": "Calculadora de Fechas de RSVP e Invitaciones de Boda",
      "url": "https://manage.wedding/es/rsvp-date-calculator",
      "inLanguage": "es",
      "description": "Calcula las fechas exactas de envío para tu Save the Date, invitaciones formales y plazo límite de confirmación de asistencia (RSVP).",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular los Plazos de Envío de Invitaciones y Confirmación RSVP",
      "description": "Determina las fechas hito para el Save the Date, el reparto de invitaciones y el plazo límite de confirmación.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Introduce la Fecha de la Boda",
          "text": "Selecciona el día exacto de la celebración en el selector de fecha."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Indica si es Boda de Destino",
          "text": "Marca la casilla si los invitados necesitan reservar vuelos y noches de hotel."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Consulta el Cronograma de Envíos",
          "text": "Comprueba las fechas recomendadas para enviar el Save the Date (6-8 meses antes), las invitaciones (6-8 semanas antes) y la fecha tope de RSVP (3-4 semanas antes)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Guarda Margen para el Catering",
          "text": "Asegúrate de que la fecha límite de RSVP quede al menos entre 7 y 14 días antes de la fecha en que la finca exige el recuento definitivo de cubiertos."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo calcula los plazos la calculadora de fechas RSVP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Toma la fecha de tu enlace y resta los plazos protocolarios del sector: para bodas locales, 6 meses para el Save the Date, 8 semanas para las invitaciones y 4 semanas para el plazo límite de confirmación. Para bodas de destino, amplía automáticamente los plazos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo poner la fecha límite de RSVP si el catering me pide el número 2 semanas antes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La calculadora sitúa la fecha límite 4 semanas antes del enlace. Esto te otorga 2 semanas de margen para contactar a los rezagados antes de entregar la lista definitiva al catering."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es necesario enviar Save the Date?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si te casas en temporada alta (junio a septiembre), fin de semana largo o en otra provincia/país, es altamente recomendable para que tus invitados reserven la fecha en su calendario."
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
    <Breadcrumb title="Calculadora de Fechas RSVP" category="stationery" />

    <div class="home-grid" style="display: block; max-width: 800px; margin: 0 auto;">
      
      <div class="hand-card wobbly-border fade-in">
        <div class="tape"></div>
        <div class="badge-postit">Herramienta Gratuita</div>
        <h1 class="font-heading" style="font-size: 2.5rem; color: var(--accent-red); margin-bottom: 0.5rem; text-align: center;">Calculadora de Fechas de Invitaciones y RSVP</h1>
        <p style="text-align: center; margin-bottom: 2rem;">¡Descubre exactamente cuándo enviar tus invitaciones y fijar la fecha límite de confirmación sin estrés!</p>

        <form id="calculator-form">
          <div class="form-group">
            <label for="wedding-date" class="form-label">¿Qué día os casáis? (Fecha de la Boda)</label>
            <input type="date" id="wedding-date" class="form-input" required />
          </div>

          <div class="form-group" style="display: flex; align-items: center; gap: 1rem; margin-top: 2rem; margin-bottom: 2rem;">
            <input type="checkbox" id="destination-wedding" style="width: 24px; height: 24px; cursor: pointer; accent-color: var(--accent-blue);" />
            <label for="destination-wedding" class="form-label" style="margin: 0; cursor: pointer;">¿Es una Boda de Destino / con Viaje? (Marca si es que sí)</label>
          </div>

          <div style="text-align: center;">
            <button type="submit" class="hand-btn">¡Calcular Mis Fechas!</button>
          </div>
        </form>

        <div id="result-box" class="result-box wobbly-border-dashed" style="margin-top: 3rem;">
          <h3 class="font-heading" style="text-align: center; font-size: 2rem; margin-bottom: 1.5rem; color: var(--fg-pencil);">Tu Calendario de Envíos</h3>
          
          <div class="result-item">
            <div class="item-label">Enviar Save the Date (Reserva de Fecha)</div>
            <div class="item-value" id="res-std">--</div>
          </div>
          <div class="result-item">
            <div class="item-label">Repartir / Enviar Invitaciones Formales</div>
            <div class="item-value" id="res-inv">--</div>
          </div>
          <div class="result-item">
            <div class="item-label">Fecha Límite de Confirmación (RSVP)</div>
            <div class="item-value" id="res-rsvp">--</div>
          </div>

          <!-- Dynamic Graph -->
          <div style="margin-top: 3rem; position: relative; padding-top: 2rem;">
            <div style="position: absolute; top: 0; left: 0; right: 0; border-top: 2px dashed var(--fg-pencil);"></div>
            <h4 class="font-heading" style="text-align: center; margin-bottom: 1rem; color: var(--fg-pencil);">Línea Temporal Visual</h4>
            <div style="display: flex; height: 40px; border: 3px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #fff;">
              <div id="bar-std" style="width: 33.3%; background-color: var(--post-it); border-right: 3px solid var(--fg-pencil); transition: width 0.5s ease; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 0.9rem;" title="Save the Date">Save the Date</div>
              <div id="bar-inv" style="width: 33.3%; background-color: var(--accent-blue); color: white; border-right: 3px solid var(--fg-pencil); transition: width 0.5s ease; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 0.9rem;" title="Invitaciones">Invitaciones</div>
              <div id="bar-rsvp" style="width: 33.4%; background-color: var(--accent-red); color: white; transition: width 0.5s ease; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 0.9rem;" title="Límite RSVP">Límite RSVP</div>
            </div>
          </div>
        </div>

      </div>

      <!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
      <div class="hand-card" style="margin: 3rem auto 0 auto; max-width: 800px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
        <div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
          <h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
            <span>⚡</span> Regla de Oro en Plazos de Papelería
          </h2>
          <span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
            Calendario de Envíos
          </span>
        </div>
        
        <!-- Core Formula Banner -->
        <div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
          <p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
            <strong>Fórmula Estándar de Plazos:</strong> 
            <span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Save the Date = 6–8 Meses Antes</span> · 
            <span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Invitaciones = 6–8 Semanas Antes</span> · 
            <span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Plazo Límite RSVP = 3–4 Semanas Antes</span>
          </p>
          <p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
            <strong>Bodas de Destino:</strong> Envía el Save the Date con <strong>8–12 meses</strong> de antelación, las invitaciones <strong>12–16 semanas</strong> antes y fija el límite de confirmación <strong>6–8 semanas</strong> antes de los vuelos.
          </p>
        </div>

        <!-- Semantic Benchmark Table -->
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Hito de Envío</th>
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Boda Local</th>
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Boda de Destino</th>
                <th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Objetivo</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Save the Date</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">6–8 Meses Antes</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">9–12 Meses Antes</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Bloqueo de agenda por los invitados</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Invitaciones Formales</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">6–8 Semanas Antes</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">12–16 Semanas Antes</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Detalles de ceremonia, banquete y autobús</td>
              </tr>
              <tr>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Fecha Límite RSVP</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">3–4 Semanas Antes</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">6–8 Semanas Antes</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Cierre de cubiertos y dietas especiales</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Entrega al Catering</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">10–14 Días Antes</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">21–30 Días Antes</td>
                <td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Número final inamovible de platos</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Related Tools -->
      <div style="margin-top: 3rem;">
        <RelatedTools currentPath="/es/rsvp-date-calculator" category="stationery" />
      </div>

    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('calculator-form');
    const resStd = document.getElementById('res-std');
    const resInv = document.getElementById('res-inv');
    const resRsvp = document.getElementById('res-rsvp');
    const barStd = document.getElementById('bar-std');
    const barInv = document.getElementById('bar-inv');
    const barRsvp = document.getElementById('bar-rsvp');

    if(form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const dateInput = (document.getElementById('wedding-date') as HTMLInputElement).value;
        const isDestination = (document.getElementById('destination-wedding') as HTMLInputElement).checked;
        
        if (!dateInput) return;

        const parts = dateInput.split('-');
        const weddingDate = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
        
        let stdDate = new Date(weddingDate.getTime());
        let invDate = new Date(weddingDate.getTime());
        let rsvpDate = new Date(weddingDate.getTime());

        if (isDestination) {
          stdDate.setMonth(stdDate.getMonth() - 9);
          invDate.setDate(invDate.getDate() - (12 * 7));
          rsvpDate.setDate(rsvpDate.getDate() - (6 * 7));
        } else {
          stdDate.setMonth(stdDate.getMonth() - 6);
          invDate.setDate(invDate.getDate() - (8 * 7));
          rsvpDate.setDate(rsvpDate.getDate() - (4 * 7));
        }

        const options: Intl.DateTimeFormatOptions = { weekday: 'short', year: 'numeric', month: 'long', day: 'numeric' };
        
        resStd!.textContent = stdDate.toLocaleDateString('es-ES', options);
        resInv!.textContent = invDate.toLocaleDateString('es-ES', options);
        resRsvp!.textContent = rsvpDate.toLocaleDateString('es-ES', options);

        const totalDuration = weddingDate.getTime() - stdDate.getTime();
        if (totalDuration > 0) {
          const stdToInv = invDate.getTime() - stdDate.getTime();
          const invToRsvp = rsvpDate.getTime() - invDate.getTime();
          const rsvpToWed = weddingDate.getTime() - rsvpDate.getTime();

          const stdPct = (stdToInv / totalDuration) * 100;
          const invPct = (invToRsvp / totalDuration) * 100;
          const rsvpPct = (rsvpToWed / totalDuration) * 100;
          
          barStd!.style.width = `${stdPct}%`;
          barInv!.style.width = `${invPct}%`;
          barRsvp!.style.width = `${rsvpPct}%`;
        }
      });
    }
  });
</script>
