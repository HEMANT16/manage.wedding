---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-processional-order/#webapp",
      "name": "Organizador de Cortejo Nupcial y Orden de Entrada a la Ceremonia",
      "url": "https://manage.wedding/es/wedding-processional-order",
      "inLanguage": "es",
      "description": "Generador de orden de entrada y salida del cortejo nupcial. Diseña el protocolo de entrada para bodas civiles, católicas, judías e íntimas. Exporta guías de bolsillo en PDF para la wedding planner y copia para WhatsApp.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Organizar el Cortejo Nupcial y el Orden de Entrada a la Ceremonia",
      "description": "Guía paso a paso para coordinar la entrada, distancias de paso y salida triunfal de los novios.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Colocación de Invitados y Familiares",
          "text": "Los invitados acceden y toman asiento en el templo o zona de ceremonia antes de la llegada de los novios."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Entrada del Novio con la Madrina",
          "text": "El novio entra del brazo de su madre o madrina y se sitúa en el lado derecho del altar esperando a la novia."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Entrada de Damas de Honor, Testigos y Niños de Arras",
          "text": "Desfilan los testigos, damas de honor y los niños/pajes portadores de alianzas y arras con una distancia de 4 a 6 pasos."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Entrada Triunfal de la Novia con el Padrino",
          "text": "Suena la marcha nupcial o canción elegida. La novia entra del brazo de su padre o padrino caminando despacio hacia el altar."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuál es el orden tradicional de entrada en una boda en España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En el protocolo tradicional español, primero entra el novio del brazo de su madre (madrina) y espera en el altar. Luego entran los testigos y pajes de arras, y finalmente la novia del brazo de su padre (padrino)."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué lado del altar se colocan la novia y el novio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la tradición cristiana y occidental, la novia se coloca en el lado izquierdo (mirando hacia el altar) y el novio en el lado derecho. En ceremonias judías es a la inversa: la novia a la derecha y el novio a la izquierda bajo la Jupá."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es el orden de salida tras la ceremonia (Recesión)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La salida es el inverso exacto: primero salen los recién casados bajo la lluvia de arroz o pétalos, seguidos de los pajes, los padrinos, los padres de ambos contrayentes, los testigos y finalmente el resto de invitados."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Organizador de Cortejo Nupcial y Orden de Entrada a la Ceremonia | Manage.Wedding"
	description="Organiza el cortejo nupcial y el orden de entrada a la ceremonia de boda. Protocolo civil, católico y moderno. Exporta guía de bolsillo en PDF y WhatsApp."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Orden del Cortejo Nupcial" category="guests-logistics" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Más de 4.400 Ensayos de Boda Coordinados</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Orden de Entrada y Cortejo <span class="accent-italic">de la Ceremonia</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Personaliza el orden de entrada, acompañantes, pajes de arras y la salida triunfal de los recién casados. Exporta la chuleta para el sacerdote, oficiante y wedding planner.
			</p>
		</header>

		<!-- Main Interactive Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Ceremony Configuration & Lineup Builder -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Configurar Ceremonia
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Todos los Protocolos
					</span>
				</div>

				<!-- Tradition Selector -->
				<div class="form-group">
					<label class="form-label" for="ceremony-tradition">Tipo de Ceremonia o Protocolo</label>
					<select id="ceremony-tradition" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="catholic" selected>⛪ Ceremonia Católica / Tradicional Española</option>
						<option value="nondenom">✨ Boda Civil / Simbólica Moderna</option>
						<option value="christian">✝️ Ceremonia Cristiana / Occidental</option>
						<option value="jewish">✡️ Ceremonia Judía (Bajo la Jupá)</option>
						<option value="lgbtq">🌈 Entrada Conjunta / Parejas Igualitarias</option>
						<option value="minimalist">🌿 Ceremonia Íntima / Minimalista</option>
					</select>
				</div>

				<!-- Mode Selector (Processional vs Recessional vs Altar) -->
				<div class="form-group">
					<label class="form-label">Fase del Desfile Nupcial</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="phase-btn hand-btn is-active" data-phase="processional" style="padding: 8px; font-size: 0.9rem;">
							🚶‍♂️ 1. Entrada (Cortejo)
						</button>
						<button type="button" class="phase-btn hand-btn" data-phase="recessional" style="padding: 8px; font-size: 0.9rem;">
							🎉 2. Salida (Recesión)
						</button>
					</div>
				</div>

				<!-- Couple Names -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="partner1-name">Novia / Contrayente 1</label>
						<input type="text" id="partner1-name" class="form-input" value="Elena" placeholder="ej. Elena" />
					</div>
					<div>
						<label class="form-label" for="partner2-name">Novio / Contrayente 2</label>
						<input type="text" id="partner2-name" class="form-input" value="Alejandro" placeholder="ej. Alejandro" />
					</div>
				</div>

				<!-- Escort Selection -->
				<div class="form-group">
					<label class="form-label" for="escort-style">Acompañante de la Novia</label>
					<select id="escort-style" class="form-input" style="cursor: pointer;">
						<option value="father" selected>Acompañada por su Padre (Padrino)</option>
						<option value="both-parents">Acompañada por Padre y Madre</option>
						<option value="mother">Acompañada por su Madre</option>
						<option value="sibling">Acompañada por Hermano / Familiar</option>
						<option value="solo">Entrada en Solitario</option>
						<option value="together">Entrada Conjunta de la Pareja</option>
					</select>
				</div>

				<!-- Quick Add Custom Attendant -->
				<div class="form-group" style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label class="form-label">Añadir Participante Personalizado</label>
					<div style="display: flex; gap: 0.5rem;">
						<input type="text" id="custom-member-input" class="form-input" placeholder="ej. Mascota con Anillos, Hermano Menor" style="flex: 1;" />
						<button id="btn-add-custom-member" type="button" class="hand-btn secondary" style="padding: 8px 14px; font-size: 0.9rem;">
							+ Añadir
						</button>
					</div>
				</div>

			</div>

			<!-- Right Column: Interactive Lineup Cards & Coordinator Pocket Sheet -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Lineup Card Container -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 id="lineup-heading" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							1. Orden de Entrada (Cortejo Nupcial)
						</h3>
						<span id="lineup-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							8 Pasos | ~4-6 pasos de separación
						</span>
					</div>

					<!-- Visual Lineup Cards List -->
					<div id="lineup-list-container" style="display: flex; flex-direction: column; gap: 0.6rem; max-height: 520px; overflow-y: auto; padding-right: 4px;">
						<!-- Dynamic Step Rows Rendered Here -->
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-pocket-sheet" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Guía para Coordinador (PDF)
						</button>
						<button id="btn-export-text" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📲</span> Copiar para WhatsApp
						</button>
					</div>

				</div>

				<!-- Music Transition & Timing Cue Box -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						🎵 Pistas y Cues Musicales para la Entrada:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Canción 1 (Entrada del Novio y Cortejo):</strong> Melodía instrumental elegante para la llegada del novio, madrina, testigos y pajes.</li>
						<li><strong>Pausa de Silencio (10-15s):</strong> Silencio breve mientras se cierran las puertas para que todos los invitados se pongan en pie.</li>
						<li><strong>Canción 2 (Marcha Nupcial / Entrada de la Novia):</strong> Momento cumbre de máxima emoción al desfile de la novia con el padrino.</li>
						<li><strong>Canción 3 (Salida Triunfal):</strong> Tema alegre y festivo para la salida de los recién casados bajo la lluvia de arroz o confeti.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Guía Rápida de Protocolo</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Tabla Resumen: Órdenes de Entrada según la Tradición
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Comparativa de entradas y posiciones en el altar para ceremonias civiles, católicas y modernas.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					🚶‍♂️ La Regla Universal del Cortejo:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Entrada: [Novio + Madrina → Testigos / Damas → Pajes de Arras y Anillos → Novia + Padrino] • Salida: [Recién Casados PRIMERO → Pajes → Padrinos → Padres → Invitados].
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Tipo de Ceremonia</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Estilo de Entrada</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Lado en el Altar</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Detalle Clave</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Católica / Española Tradicional</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Novio con la Madrina; Novia con el Padrino.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Novia a la IZQUIERDA, Novio a la DERECHA</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Los padrinos se sientan junto a los novios en el altar</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Civil / Simbólica Moderna</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Flexible: entrada con padres, padrinos o juntos.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Novia a la IZQ, Novio a la DER</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Mayor protagonismo de lecturas de amigos y testigos</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Judía (Bajo la Jupá)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Novio con ambos padres; Novia con ambos padres.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Novia a la DERECHA, Novio a la IZQUIERDA</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Ambos padres permanecen bajo la Jupá durante el rito</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Igualitaria / LGBTQ+</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Entrada conjunta por el pasillo o doble pasillo lateral.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Elección libre de la pareja</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Entrada simétrica celebrando la unión en igualdad</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guía Completa de Coordinación del Cortejo de Boda
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Cómo sincronizar la música, el paso de los testigos y la colocación sin tropiezos ni nervios de última hora.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. La Regla del 'Medio Pasillo' para la Separación
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					El error más habitual en los ensayos es que los participantes caminan pegados unos detrás de otros. Para que el fotógrafo pueda captar retratos limpios e individuales:
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>📏 Regla del Medio Pasillo:</strong><br />
					Cada pareja o dama de honor NO debe empezar a caminar hasta que la persona que le precede haya alcanzado al menos la mitad del pasillo. Esto garantiza fotos perfectas sin nadie tapando el encuadre detrás.
				</div>
			</section>

			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Preguntas Frecuentes
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Quién lleva las alianzas y las arras?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Tradicionalmente los pajes o damitas de honor (sobrinos o hijos de amigos cercanos). Si son muy pequeños (menores de 4 años), sitúa a sus padres en la primera fila para que caminen hacia ellos con seguridad.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Puede la novia entrar con ambos padres?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						¡Por supuesto! Cada vez más novias deciden caminar del brazo de su padre y su madre para honrar a ambos por igual en el momento más emotivo de la ceremonia.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/es/wedding-processional-order" category="logistics" />

	</main>

	<!-- Interactive Script -->
	<script is:inline>
		const traditionSelect = document.getElementById('ceremony-tradition');
		const partner1Input = document.getElementById('partner1-name');
		const partner2Input = document.getElementById('partner2-name');
		const escortSelect = document.getElementById('escort-style');
		const phaseButtons = document.querySelectorAll('.phase-btn');
		const lineupContainer = document.getElementById('lineup-list-container');
		const lineupHeading = document.getElementById('lineup-heading');
		const lineupCountBadge = document.getElementById('lineup-count-badge');
		const customInput = document.getElementById('custom-member-input');
		const btnAddCustom = document.getElementById('btn-add-custom-member');
		const btnPrint = document.getElementById('btn-print-pocket-sheet');
		const btnCopyText = document.getElementById('btn-export-text');

		let currentPhase = 'processional';
		let lineupData = [];

		const presets = {
			catholic: [
				{ role: "Entrada del Sacerdote / Oficiante", names: "Sacerdote y Monaguillos", cue: "Ocupan el presbiterio" },
				{ role: "Entrada del Novio y la Madrina", names: "Novio (Alejandro) del brazo de su Madre", cue: "🎵 Canción 1 (Entrada Novio)" },
				{ role: "Entrada de la Madre de la Novia y Padre del Novio", names: "Madre de la Novia y Padre del Novio", cue: "Toman asiento en 1ª fila" },
				{ role: "Testigos y Damas de Honor", names: "Testigos y Damas de Honor", cue: "Separación de 6 pasos" },
				{ role: "Pajes de Arras y Alianzas", names: "Niños de arras y anillos", cue: "Portan bastidor y cofre" },
				{ role: "Entrada de la Novia y el Padrino", names: "Novia (Elena) del brazo de su Padre", cue: "🎵 Canción 2 (Marcha Nupcial)" }
			],
			nondenom: [
				{ role: "Acomodación de Familiares Directos", names: "Padres y Abuelos en primera fila", cue: "Música instrumental de fondo" },
				{ role: "Entrada del Oficiante / Maestro de Ceremonias", names: "Oficiante", cue: "Toma posición central" },
				{ role: "Entrada del Novio / Pareja 2", names: "Novio (Alejandro) con su Madrina o Acompañante", cue: "🎵 Canción 1" },
				{ role: "Cortejo de Testigos y Amigos Íntimos", names: "Testigos y Best Friends", cue: "Regla del medio pasillo" },
				{ role: "Portador de Alianzas / Arras", names: "Pajes o Amigos con Alianzas", cue: "" },
				{ role: "Entrada de la Novia / Pareja 1", names: "Novia (Elena) con su Acompañante", cue: "🎵 Canción 2 (Entrada Principal)" }
			],
			christian: [
				{ role: "Entrada de Abuelos", names: "Abuelos de ambos novios", cue: "Música de preludio" },
				{ role: "Entrada de Padres", names: "Padres del Novio y Madre de la Novia", cue: "" },
				{ role: "Oficiante y Novio", names: "Oficiante y Novio (Alejandro)", cue: "Entran por el lateral del altar" },
				{ role: "Damas de Honor y Best Man", names: "Cortejo nupcial", cue: "4 a 6 pasos de distancia" },
				{ role: "Niña de las Flores y Paje", names: "Niños con pétalos y anillos", cue: "" },
				{ role: "Entrada de la Novia", names: "Novia (Elena) con su Padre", cue: "🎵 Marcha Nupcial" }
			],
			jewish: [
				{ role: "Rabino y Cantante Litúrgico", names: "Rabino y Jazán", cue: "Se sitúan bajo la Jupá" },
				{ role: "Abuelos de la Pareja", names: "Abuelos de ambos", cue: "" },
				{ role: "Testigos y Padrinos", names: "Groomsmen y Damas", cue: "" },
				{ role: "Entrada del Novio con Ambos Padres", names: "Novio (Alejandro) escoltado por Padre y Madre", cue: "Lado derecho de la Jupá" },
				{ role: "Niños de Anillos", names: "Portadores de alianzas", cue: "" },
				{ role: "Entrada de la Novia con Ambos Padres", names: "Novia (Elena) escoltada por Padre y Madre", cue: "🎵 Entrada nupcial bajo la Jupá" }
			],
			lgbtq: [
				{ role: "Acomodación de Familias", names: "Padres y Familiares Directos", cue: "Música ambiental" },
				{ role: "Oficiante de Ceremonia", names: "Celebrante", cue: "Centro del altar" },
				{ role: "Cortejo de Amigos y Testigos", names: "Testigos de Honor", cue: "Disposición simétrica" },
				{ role: "Entrada Conjunta de la Pareja", names: "Elena & Alejandro entran de la mano", cue: "🎵 Desfile conjunto por el pasillo central" }
			],
			minimalist: [
				{ role: "Oficiante y Pareja 2", names: "Oficiante y Alejandro", cue: "Toman posición" },
				{ role: "Testigos de Honor", names: "Dos Testigos Principales", cue: "" },
				{ role: "Entrada de Pareja 1", names: "Elena y Acompañante", cue: "🎵 Entrada de Ceremonia" }
			]
		};

		function loadTradition() {
			const t = traditionSelect.value;
			const raw = presets[t] || presets.catholic;
			lineupData = JSON.parse(JSON.stringify(raw));
			applyCustomNames();
		}

		function applyCustomNames() {
			const p1 = partner1Input.value.trim() || 'Elena';
			const p2 = partner2Input.value.trim() || 'Alejandro';
			const escort = escortSelect.options[escortSelect.selectedIndex].text;

			lineupData.forEach(item => {
				item.role = item.role.replace(/Elena/g, p1).replace(/Alejandro/g, p2);
				item.names = item.names.replace(/Elena/g, p1).replace(/Alejandro/g, p2);
				if (item.role.includes('Entrada de la Novia') || item.role.includes('Entrada de Pareja 1')) {
					item.names = `${p1} (${escort})`;
				}
			});
			renderLineup();
		}

		function renderLineup() {
			lineupContainer.innerHTML = '';

			let displayList = [...lineupData];
			if (currentPhase === 'recessional') {
				lineupHeading.textContent = '2. Orden de Salida (Recesión Triunfal)';
				displayList = [
					{ role: "Salida Triunfal de los Recién Casados (¡Primeros!)", names: `${partner1Input.value || 'Elena'} & ${partner2Input.value || 'Alejandro'} (¡Recién Casados!)`, cue: "🎵 Canción Festiva de Salida y Arroz" },
					{ role: "Pajes de Arras y Alianzas", names: "Niños de arras", cue: "Inmediatamente tras los novios" },
					{ role: "Padrinos de Boda", names: "Padrino y Madrina", cue: "" },
					{ role: "Padres de Ambos Cónyuges", names: "Padres y Madres", cue: "" },
					{ role: "Testigos y Damas de Honor", names: "Cortejo de Honor", cue: "" },
					{ role: "Abuelos y Familiares Cercanos", names: "Abuelos", cue: "" },
					{ role: "Salida del Resto de Invitados", names: "Desalojo ordenado fila por fila", cue: "Hacia el aperitivo de bienvenida" }
				];
			} else {
				lineupHeading.textContent = '1. Orden de Entrada (Cortejo Nupcial)';
			}

			lineupCountBadge.textContent = `${displayList.length} Pasos | ~4-6 pasos de distancia`;

			displayList.forEach((item, idx) => {
				const row = document.createElement('div');
				row.style.cssText = "display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; gap: 0.75rem;";
				
				row.innerHTML = `
					<div style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">
						<span style="font-weight: 800; font-size: 1.1rem; color: var(--accent-red); width: 24px; text-align: center;">${idx + 1}</span>
						<div>
							<strong style="font-size: 0.98rem; color: var(--fg-pencil); display: block;">${item.role}</strong>
							<span style="font-size: 0.88rem; color: #475569;">${item.names}</span>
							${item.cue ? `<span style="display: block; font-size: 0.78rem; font-weight: 700; color: var(--accent-blue); margin-top: 2px;">⚡ Cue: ${item.cue}</span>` : ''}
						</div>
					</div>
					<div style="display: flex; gap: 4px;">
						<button type="button" class="btn-move-up hand-btn secondary" data-index="${idx}" style="padding: 3px 7px; font-size: 0.75rem;" ${idx === 0 ? 'disabled' : ''}>▲</button>
						<button type="button" class="btn-move-down hand-btn secondary" data-index="${idx}" style="padding: 3px 7px; font-size: 0.75rem;" ${idx === displayList.length - 1 ? 'disabled' : ''}>▼</button>
					</div>
				`;
				lineupContainer.appendChild(row);
			});

			if (currentPhase === 'processional') {
				document.querySelectorAll('.btn-move-up').forEach(b => {
					b.addEventListener('click', () => {
						const idx = parseInt(b.getAttribute('data-index'), 10);
						if (idx > 0) {
							const temp = lineupData[idx];
							lineupData[idx] = lineupData[idx - 1];
							lineupData[idx - 1] = temp;
							renderLineup();
						}
					});
				});
				document.querySelectorAll('.btn-move-down').forEach(b => {
					b.addEventListener('click', () => {
						const idx = parseInt(b.getAttribute('data-index'), 10);
						if (idx < lineupData.length - 1) {
							const temp = lineupData[idx];
							lineupData[idx] = lineupData[idx + 1];
							lineupData[idx + 1] = temp;
							renderLineup();
						}
					});
				});
			}
		}

		phaseButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				phaseButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentPhase = btn.getAttribute('data-phase');
				renderLineup();
			});
		});

		btnAddCustom.addEventListener('click', () => {
			const val = customInput.value.trim();
			if (!val) return;
			lineupData.splice(lineupData.length - 1, 0, {
				role: val,
				names: val,
				cue: "Participante añadido"
			});
			customInput.value = '';
			renderLineup();
		});

		traditionSelect.addEventListener('change', loadTradition);
		[partner1Input, partner2Input, escortSelect].forEach(inp => {
			inp.addEventListener('input', applyCustomNames);
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			let html = `
				<!DOCTYPE html>
				<html>
				<head>
					<title>Guía de Cortejo Nupcial — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						h2 { font-size: 14pt; margin-top: 18px; margin-bottom: 6px; border-bottom: 2px solid #0f172a; padding-bottom: 3px; }
						table { width: 100%; border-collapse: collapse; margin-top: 8px; }
						th, td { border: 1px solid #cbd5e1; padding: 6px 10px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
					</style>
				</head>
				<body>
					<h1>Guía de Cortejo Nupcial: ${partner1Input.value || 'Elena'} & ${partner2Input.value || 'Alejandro'}</h1>
					<p style="font-size: 10pt; color: #64748b; margin-top: 0;">Protocolo: ${traditionSelect.options[traditionSelect.selectedIndex].text} | Distancia: 4-6 pasos</p>
					
					<h2>1. Orden de Entrada (Cortejo)</h2>
					<table>
						<thead><tr><th style="width: 40px;">#</th><th>Momento / Rol</th><th>Participantes</th><th>Cue Musical</th></tr></thead>
						<tbody>
			`;

			lineupData.forEach((item, idx) => {
				html += `
					<tr>
						<td><strong>${idx + 1}</strong></td>
						<td><strong>${item.role}</strong></td>
						<td>${item.names}</td>
						<td>${item.cue || '—'}</td>
					</tr>
				`;
			});

			html += `
						</tbody>
					</table>

					<h2>2. Orden de Salida (Recesión)</h2>
					<table>
						<thead><tr><th style="width: 40px;">#</th><th>Orden</th><th>Participantes</th></tr></thead>
						<tbody>
							<tr><td>1</td><td><strong>Recién Casados (Salida Primeros)</strong></td><td>${partner1Input.value || 'Elena'} & ${partner2Input.value || 'Alejandro'}</td></tr>
							<tr><td>2</td><td>Pajes de Arras</td><td>Pajes y Damitas</td></tr>
							<tr><td>3</td><td>Padrinos de Boda</td><td>Padrino y Madrina</td></tr>
							<tr><td>4</td><td>Padres de Ambos</td><td>Padres y Madres</td></tr>
							<tr><td>5</td><td>Testigos de Honor</td><td>Testigos</td></tr>
							<tr><td>6</td><td>Familiares y Amigos</td><td>Resto de Invitados</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`;
			printWindow.document.write(html);
			printWindow.document.close();
		});

		btnCopyText.addEventListener('click', () => {
			let text = `⛪ *Orden de Cortejo Nupcial — ${partner1Input.value || 'Elena'} & ${partner2Input.value || 'Alejandro'}*\n\n`;
			text += `*🚶‍♂️ Orden de Entrada:*\n`;
			lineupData.forEach((item, idx) => {
				text += `${idx + 1}. ${item.role} (${item.names})${item.cue ? ` - _Cue: ${item.cue}_` : ''}\n`;
			});
			text += `\n*🎉 Orden de Salida:*\n1. ¡Recién Casados Primeros!\n2. Pajes de Arras\n3. Padrinos de Boda\n4. Padres\n5. Testigos e Invitados`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnCopyText.textContent;
				btnCopyText.textContent = '✅ ¡Copiado para WhatsApp!';
				setTimeout(() => { btnCopyText.textContent = orig; }, 2500);
			});
		});

		loadTradition();
	</script>
</Layout>
