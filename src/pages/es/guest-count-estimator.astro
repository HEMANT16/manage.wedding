---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/guest-count-estimator/#webapp",
      "name": "Estimador de Número de Invitados según Presupuesto",
      "url": "https://manage.wedding/es/guest-count-estimator",
      "inLanguage": "es",
      "description": "Calcula a cuántos invitados puedes invitar a tu boda según tu presupuesto total, alquiler de finca y precio del cubierto y barra libre.",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Estimar el Número Máximo de Invitados según el Presupuesto",
      "description": "Calcula el número viable de comensales y el aforo seguro para el banquete nupcial.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Fija el Presupuesto Total y Resta los Costes Fijos",
          "text": "Identifica tu presupuesto global y resta los gastos fijos como alquiler de la finca, fotografía, música y vestidos."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Suma el Precio por Cubierto y la Barra Libre",
          "text": "Combina el menú por comensal del catering con la barra libre e impuestos (IVA 10%) para obtener el coste real por persona."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Divide el Presupuesto Variable entre el Coste por Comensal",
          "text": "Divide los fondos disponibles restantes entre el coste por persona para conocer el número máximo de comensales viables."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Aplica la Regla de Seguridad del 90% del Aforo",
          "text": "Multiplica la capacidad máxima legal de la finca por 0,90 para asegurar espacio suficiente para pista de baile y mesas de apoyo."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo funciona el estimador de número de invitados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Resta los costes fijos (alquiler de finca, fotógrafo, música) de tu presupuesto total. El remanente se divide entre el coste por cubierto y barra libre para darte el número máximo de comensales que puedes asumir."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué gastos deben incluirse en los costes fijos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los costes fijos engloban el alquiler del espacio, fotógrafo, videógrafo, DJ o grupo en directo, vestido y traje, flores y decoración. Son partidas que no varían si tienes 60 o 140 invitados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto suele costar un cubierto de boda en España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El precio medio del menú de boda en España oscila entre 110 € y 180 € por comensal (incluyendo cóctel de bienvenida, primero, segundo, postre y barra libre estándar de 3 a 4 horas)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Estimador de Número de Invitados de Boda (Según Presupuesto) | Manage.Wedding"
	description="Calcula exactamente a cuántos invitados puedes invitar a tu boda según tu presupuesto total, alquiler de finca y precio por cubierto de catering."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<Breadcrumb title="Estimador de Número de Invitados" category="guests-logistics" />

		<section class="section-paper" style="padding: 3rem 2rem; margin-bottom: 3rem;">
			<div style="max-width: 1000px; margin: 0 auto;">
				
				<div style="text-align: center; margin-bottom: 3rem;">
					<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 60px); color: var(--fg-pencil); transform: rotate(-1deg);">
						Estimador de <span class="accent-italic">Invitados</span>
					</h1>
					<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 0 auto; margin-top: 1rem;">
						¿Cuántos amigos y familiares puedes invitar sin salirte del presupuesto? Introduce tus números y calcula el aforo ideal.
					</p>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; align-items: start;">
					
					<!-- Form Column -->
					<div class="hand-card">
						<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">Tu Presupuesto</h2>
						<form id="guest-form" style="display: flex; flex-direction: column; gap: 1.5rem;">
							
							<div class="input-group">
								<label for="total-budget" style="display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--fg-pencil);">Presupuesto Total de la Boda (€)</label>
								<input type="number" id="total-budget" value="25000" min="0" step="100" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: transparent; font-family: inherit; font-size: 1.1rem; color: var(--fg-pencil);" />
								<small style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">Presupuesto global disponible.</small>
							</div>

							<div class="input-group">
								<label for="fixed-costs" style="display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--fg-pencil);">Finca y Gastos Fijos (€)</label>
								<input type="number" id="fixed-costs" value="10000" min="0" step="100" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: transparent; font-family: inherit; font-size: 1.1rem; color: var(--fg-pencil);" />
								<small style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">Alquiler espacio, fotógrafo, música, vestidos, etc.</small>
							</div>

							<div class="input-group">
								<label for="catering-ph" style="display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--fg-pencil);">Menú / Cubierto por Persona (€)</label>
								<input type="number" id="catering-ph" value="110" min="0" step="1" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: transparent; font-family: inherit; font-size: 1.1rem; color: var(--fg-pencil);" />
								<small style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">Cóctel y banquete por comensal.</small>
							</div>

							<div class="input-group">
								<label for="bar-ph" style="display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--fg-pencil);">Barra Libre por Persona (€)</label>
								<input type="number" id="bar-ph" value="25" min="0" step="1" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: transparent; font-family: inherit; font-size: 1.1rem; color: var(--fg-pencil);" />
								<small style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">Barra libre y resopón por persona.</small>
							</div>

							<button type="submit" class="hand-btn" style="width: 100%; font-size: 1.25rem; margin-top: 1rem;">Calcular Invitados Viables</button>
						</form>
					</div>

					<!-- Results Column -->
					<div class="hand-card" id="results-container">
						<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">Tu Estimación</h2>
						
						<div style="text-align: center; margin-bottom: 2rem;">
							<div style="font-size: 1.2rem; color: var(--text-secondary); margin-bottom: 0.5rem;">Máximo de Invitados Viables</div>
							<div id="max-guests" class="font-heading" style="font-size: 4rem; color: var(--accent-red); line-height: 1;">111</div>
							<div style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 0.5rem;">personas</div>
						</div>

						<div style="margin-bottom: 1.5rem;">
							<h3 class="font-heading" style="font-size: 1.2rem; margin-bottom: 1rem;">Distribución del Presupuesto</h3>
							
							<!-- Dynamic CSS Chart -->
							<div style="width: 100%; height: 40px; border: 2px solid var(--fg-pencil); border-radius: 4px; display: flex; overflow: hidden; margin-bottom: 0.5rem;">
								<div id="chart-fixed" style="width: 40%; background-color: var(--fg-pencil); display: flex; align-items: center; justify-content: center; color: var(--bg-paper); font-weight: bold; font-size: 0.8rem; transition: width 0.3s ease;">40%</div>
								<div id="chart-variable" style="width: 60%; background-color: var(--accent-blue); display: flex; align-items: center; justify-content: center; color: var(--bg-paper); font-weight: bold; font-size: 0.8rem; transition: width 0.3s ease;">60%</div>
							</div>
							
							<div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
								<div style="display: flex; align-items: center; gap: 0.5rem;">
									<div style="width: 12px; height: 12px; background-color: var(--fg-pencil);"></div>
									<span>Costes Fijos</span>
								</div>
								<div style="display: flex; align-items: center; gap: 0.5rem;">
									<div style="width: 12px; height: 12px; background-color: var(--accent-blue);"></div>
									<span>Costes de Comensales</span>
								</div>
							</div>
						</div>

						<div style="background-color: rgba(0,0,0,0.03); padding: 1rem; border: 1px dashed var(--fg-pencil);">
							<div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
								<span>Presupuesto Total:</span>
								<strong id="display-total">25.000 €</strong>
							</div>
							<div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
								<span>Gastos Fijos:</span>
								<strong id="display-fixed">-10.000 €</strong>
							</div>
							<div style="display: flex; justify-content: space-between; border-top: 1px solid var(--fg-pencil); padding-top: 0.5rem;">
								<span>Disponible para Catering:</span>
								<strong id="display-remaining">15.000 €</strong>
							</div>
							<div style="display: flex; justify-content: space-between; margin-top: 0.5rem; color: var(--accent-red);">
								<span>Coste por Persona:</span>
								<strong id="display-perhead">135 €</strong>
							</div>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- SEO Article Section -->
		<section class="section-muted" style="padding: 2rem 1rem;">
			<div style="max-width: 900px; margin: 0 auto;">
				
				<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
				<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
					<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
					<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
							<span>⚡</span> Regla de Oro en Capacidad y Presupuesto
						</h2>
						<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
							Fórmula de Comensales
						</span>
					</div>
					
					<!-- Core Formula Banner -->
					<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
						<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
							<strong>Regla del Aforo de Seguridad (90%):</strong> 
							<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Aforo Cómodo = Capacidad Máxima de la Finca × 0,90</span>
						</p>
						<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
							<strong>Fórmula de Viabilidad Económica:</strong> Invitados Máximos = <code>(Presupuesto Total − Gastos Fijos) ÷ (Menú + Barra Libre por persona)</code>.
						</p>
					</div>

					<!-- Semantic Benchmark Table -->
					<div style="overflow-x: auto;">
						<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
							<thead>
								<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
									<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Presupuesto Total</th>
									<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Costes Fijos (40%)</th>
									<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Restante Catering</th>
									<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">A 110 €/persona</th>
									<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: #d97706;">A 140 €/persona</th>
									<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">A 180 €/persona</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">15.000 € (Íntima / DIY)</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">6.000 €</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">9.000 €</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">81 pax</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: #d97706; font-weight: 600;">64 pax</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">50 pax</td>
								</tr>
								<tr style="background: #faf8f5;">
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">25.000 € (Media Estándar)</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">10.000 €</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">15.000 €</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">136 pax</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: #d97706; font-weight: 600;">107 pax</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">83 pax</td>
								</tr>
								<tr>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">35.000 € (Gran Banquete)</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">14.000 €</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">21.000 €</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">190 pax</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: #d97706; font-weight: 600;">150 pax</td>
									<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">116 pax</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

			</div>
		</section>

		<RelatedTools currentPath="/es/guest-count-estimator" category="guests" />

	</main>
</Layout>

<script>
	function calculateGuests() {
		const budget = parseFloat((document.getElementById('total-budget') as HTMLInputElement).value) || 0;
		const fixed = parseFloat((document.getElementById('fixed-costs') as HTMLInputElement).value) || 0;
		const catering = parseFloat((document.getElementById('catering-ph') as HTMLInputElement).value) || 0;
		const bar = parseFloat((document.getElementById('bar-ph') as HTMLInputElement).value) || 0;
		
		const perHead = catering + bar;
		const remaining = budget - fixed;
		
		let maxGuests = 0;
		if (perHead > 0 && remaining > 0) {
			maxGuests = Math.floor(remaining / perHead);
		} else if (remaining < 0) {
			maxGuests = 0;
		} else if (perHead === 0 && remaining >= 0) {
			maxGuests = 999;
		}

		document.getElementById('max-guests')!.innerText = maxGuests.toString();
		document.getElementById('display-total')!.innerText = `${budget.toLocaleString('es-ES')} €`;
		document.getElementById('display-fixed')!.innerText = `-${fixed.toLocaleString('es-ES')} €`;
		document.getElementById('display-remaining')!.innerText = `${remaining.toLocaleString('es-ES')} €`;
		document.getElementById('display-perhead')!.innerText = `${perHead.toLocaleString('es-ES')} €`;

		let fixedPct = 0;
		let varPct = 0;
		
		if (budget > 0) {
			if (fixed >= budget) {
				fixedPct = 100;
				varPct = 0;
			} else {
				fixedPct = (fixed / budget) * 100;
				varPct = 100 - fixedPct;
			}
		}

		document.getElementById('chart-fixed')!.style.width = `${fixedPct}%`;
		document.getElementById('chart-fixed')!.innerText = `${Math.round(fixedPct)}%`;
		document.getElementById('chart-variable')!.style.width = `${varPct}%`;
		document.getElementById('chart-variable')!.innerText = `${Math.round(varPct)}%`;
	}

	document.getElementById('guest-form')?.addEventListener('submit', (e) => {
		e.preventDefault();
		calculateGuests();
	});

	document.getElementById('guest-form')?.addEventListener('input', calculateGuests);
	calculateGuests();
</script>

<style>
	details > summary::-webkit-details-marker {
		display: none;
	}
	details > summary {
		list-style: none;
		position: relative;
		padding-left: 1.5rem;
	}
	details > summary::before {
		content: '▶';
		position: absolute;
		left: 0;
		top: 2px;
		font-size: 0.8rem;
		transition: transform 0.2s;
	}
	details[open] > summary::before {
		transform: rotate(90deg);
	}
</style>
