</style>

<script is:inline>
	let timelineEvents = [];
	let activeRoleFilter = 'all';

	const ceremonyInput = document.getElementById('ceremony-time');
	const firstLookInput = document.getElementById('first-look');
	const travelInput = document.getElementById('travel-time');
	const receptionHoursInput = document.getElementById('reception-hours');
	const timelineStream = document.getElementById('timeline-stream');

	function parseTimeToMinutes(timeStr) {
		const [h, m] = timeStr.split(':').map(Number);
		return h * 60 + m;
	}

	function minutesToFormattedTime(totalMinutes) {
		let normalized = (totalMinutes % 1440 + 1440) % 1440;
		let hours = Math.floor(normalized / 60);
		let minutes = normalized % 60;
		const hStr = hours < 10 ? '0' + hours : hours;
		const minStr = minutes < 10 ? '0' + minutes : minutes;
		return `${hStr}:${minStr} h`;
	}

	function calculateTimeline() {
		const ceremonyMins = parseTimeToMinutes(ceremonyInput.value);
		const firstLook = firstLookInput.value;
		const travelMins = parseInt(travelInput.value) || 0;
		const receptionLengthMins = Math.round(parseFloat(receptionHoursInput.value) * 60);

		timelineEvents = [];

		if (firstLook === 'yes') {
			timelineEvents.push({
				id: 'evt-1',
				minutes: ceremonyMins - travelMins - 120 - 150,
				name: 'Peluquería y Maquillaje / Preparativos Novios',
				role: 'wedding-party',
				description: 'Sesión de estilismo, batas nupciales y brindis previo'
			});
			timelineEvents.push({
				id: 'evt-2',
				minutes: ceremonyMins - travelMins - 120 - 45,
				name: 'Llegada de Fotógrafo y Vídeo (Detalles y Vestido)',
				role: 'photo',
				description: 'Fotos de accesorios, alianzas, zapatos, vestido y traje'
			});
			timelineEvents.push({
				id: 'evt-3',
				minutes: ceremonyMins - travelMins - 120 - 15,
				name: 'Vestirse y Retoques Finales',
				role: 'wedding-party',
				description: 'Ayuda de la madre, padrinos y damas de honor'
			});
			timelineEvents.push({
				id: 'evt-4',
				minutes: ceremonyMins - travelMins - 120,
				name: 'First Look (Encuentro a Solas) y Fotos de Pareja',
				role: 'photo',
				description: 'Momento íntimo de los novios a solas y reportaje previo'
			});
			timelineEvents.push({
				id: 'evt-5',
				minutes: ceremonyMins - travelMins - 60,
				name: 'Fotos con Familia Cercana y Testigos',
				role: 'photo',
				description: 'Retratos con padres, hermanos y cortejo nupcial'
			});
			if (travelMins > 0) {
				timelineEvents.push({
					id: 'evt-6',
					minutes: ceremonyMins - travelMins - 15,
					name: 'Desplazamiento al Lugar de la Ceremonia',
					role: 'wedding-party',
					description: `${travelMins} minutos de trayecto con margen de seguridad`
				});
			}
			timelineEvents.push({
				id: 'evt-7',
				minutes: ceremonyMins - 20,
				name: 'Llegada de Invitados y Música de Bienvenida',
				role: 'wedding-party',
				description: 'Acomodación de invitados y música ambiental previa'
			});
		} else {
			timelineEvents.push({
				id: 'evt-1',
				minutes: ceremonyMins - travelMins - 180,
				name: 'Peluquería, Maquillaje y Preparativos',
				role: 'wedding-party',
				description: 'Preparativos en suite con familiares y testigos'
			});
			timelineEvents.push({
				id: 'evt-2',
				minutes: ceremonyMins - travelMins - 75,
				name: 'Llegada de Fotógrafo (Preparativos por Separado)',
				role: 'photo',
				description: 'Fotos de la novia y novio por separado en sus habitaciones'
			});
			if (travelMins > 0) {
				timelineEvents.push({
					id: 'evt-3',
					minutes: ceremonyMins - travelMins - 15,
					name: 'Salida hacia la Ceremonia',
					role: 'wedding-party',
					description: `${travelMins} minutos de trayecto`
				});
			}
			timelineEvents.push({
				id: 'evt-4',
				minutes: ceremonyMins - 20,
				name: 'Llegada de Invitados al Lugar del Enlace',
				role: 'wedding-party',
				description: 'Música de ambiente y colocación de asistentes'
			});
		}

		timelineEvents.push({
			id: 'evt-ceremony',
			minutes: ceremonyMins,
			name: 'Inicio de la Ceremonia y ' + (firstLook === 'yes' ? 'Entrada Nupcial' : 'Entrada y Votos'),
			role: 'ceremony',
			description: 'Entrada, lecturas, intercambio de alianzas, arras y salida triunfal'
		});

		const cocktailMins = ceremonyMins + 45;
		timelineEvents.push({
			id: 'evt-cocktail',
			minutes: cocktailMins,
			name: firstLook === 'yes' ? 'Cóctel de Bienvenida (Novios con Invitados)' : 'Cóctel de Bienvenida y Sesión Fotográfica',
			role: 'reception',
			description: firstLook === 'yes' ? 'Aperitivos, cortador de jamón y brindis con los invitados' : 'Aperitivos para invitados mientras se realiza el reportaje de pareja'
		});

		const dinnerMins = cocktailMins + 75;
		timelineEvents.push({
			id: 'evt-dinner',
			minutes: dinnerMins,
			name: 'Entrada al Salón del Banquete y Comida / Cena',
			role: 'reception',
			description: 'Entrada con música festiva y servicio del menú del banquete'
		});

		const toastsMins = dinnerMins + 60;
		timelineEvents.push({
			id: 'evt-toasts',
			minutes: toastsMins,
			name: 'Brindis, Discursos y Entrega de Regalos',
			role: 'reception',
			description: 'Entrega del ramo, detalles a padres y testigos, y palabras de agradecimiento'
		});

		const cakeMins = dinnerMins + 90;
		timelineEvents.push({
			id: 'evt-cake',
			minutes: cakeMins,
			name: 'Corte de Tarta y Apertura del Baile Nupcial',
			role: 'reception',
			description: 'Corte de la tarta nupcial seguido del primer baile de los recién casados'
		});

		const dancingMins = cakeMins + 15;
		timelineEvents.push({
			id: 'evt-dance',
			minutes: dancingMins,
			name: 'Barra Libre, Fiesta y Recena Caliente',
			role: 'reception',
			description: 'Música en directo o DJ, barra libre de combinados y recena'
		});

		const exitMins = ceremonyMins + 45 + receptionLengthMins;
		timelineEvents.push({
			id: 'evt-exit',
			minutes: exitMins,
			name: 'Fin de Fiesta / Despedida con Bengalas',
			role: 'reception',
			description: 'Última canción, túnel de bengalas o salida de autobuses'
		});

		timelineEvents.sort((a, b) => a.minutes - b.minutes);
		renderTimeline();
	}

	function renderTimeline() {
		timelineStream.innerHTML = '';

		const filtered = timelineEvents.filter(evt => {
			if (activeRoleFilter === 'all') return true;
			if (activeRoleFilter === 'wedding-party') return evt.role === 'wedding-party' || evt.role === 'ceremony';
			if (activeRoleFilter === 'photo') return evt.role === 'photo' || evt.role === 'ceremony';
			if (activeRoleFilter === 'reception') return evt.role === 'reception';
			return true;
		});

		if (filtered.length === 0) {
			timelineStream.innerHTML = '<p style="color: var(--text-secondary); font-style: italic;">No hay momentos con este filtro.</p>';
			return;
		}

		filtered.forEach(evt => {
			const card = document.createElement('div');
			card.className = 'timeline-event-card';

			let tagClass = 'tag-wedding-party';
			let tagLabel = '👰 Novios y Familia';
			if (evt.role === 'photo') { tagClass = 'tag-photo'; tagLabel = '📸 Foto y Vídeo'; }
			else if (evt.role === 'reception') { tagClass = 'tag-reception'; tagLabel = '🍽️ Banquete y Fiesta'; }
			else if (evt.role === 'ceremony') { tagClass = 'tag-ceremony'; tagLabel = '⛪ Ceremonia'; }

			const formattedTime = minutesToFormattedTime(evt.minutes);

			card.innerHTML = `
				<div class="timeline-bullet-dot"></div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.3rem;">
					<strong class="font-heading" style="font-size: 1.3rem; color: var(--accent-blue);">${formattedTime}</strong>
					<span class="event-tag ${tagClass}">${tagLabel}</span>
				</div>
				<h4 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.3rem 0;">
					${evt.name}
				</h4>
				<p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); margin: 0; line-height: 1.4;">
					${evt.description || ''}
				</p>
				<div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.4rem;">
					<button type="button" style="background:none; border:none; color: var(--accent-red); cursor:pointer; font-size: 0.8rem; font-weight:bold;" onclick="removeTimelineEvent('${evt.id}')">Eliminar</button>
				</div>
			`;

			timelineStream.appendChild(card);
		});
	}

	window.removeTimelineEvent = function(id) {
		timelineEvents = timelineEvents.filter(e => e.id !== id);
		renderTimeline();
	};

	ceremonyInput.addEventListener('change', calculateTimeline);
	firstLookInput.addEventListener('change', calculateTimeline);
	travelInput.addEventListener('input', calculateTimeline);
	receptionHoursInput.addEventListener('change', calculateTimeline);

	document.querySelectorAll('.preset-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active-preset'));
			btn.classList.add('active-preset');

			ceremonyInput.value = btn.getAttribute('data-ceremony');
			firstLookInput.value = btn.getAttribute('data-firstlook');
			travelInput.value = btn.getAttribute('data-travel');
			receptionHoursInput.value = btn.getAttribute('data-reception');

			calculateTimeline();
		});
	});

	document.querySelectorAll('.role-pill-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.role-pill-btn').forEach(b => b.classList.remove('active-role'));
			btn.classList.add('active-role');
			activeRoleFilter = btn.getAttribute('data-role');
			renderTimeline();
		});
	});

	document.getElementById('add-custom-event-form').addEventListener('submit', (e) => {
		e.preventDefault();
		const name = document.getElementById('custom-event-name').value.trim();
		const timeStr = document.getElementById('custom-event-time').value;
		const role = document.getElementById('custom-event-role').value;

		if (!name || !timeStr) return;

		timelineEvents.push({
			id: 'custom-' + Date.now(),
			minutes: parseTimeToMinutes(timeStr),
			name,
			role,
			description: 'Hito personalizado añadido'
		});

		timelineEvents.sort((a, b) => a.minutes - b.minutes);
		renderTimeline();
		document.getElementById('custom-event-name').value = '';
	});

	document.getElementById('btn-copy-summary').addEventListener('click', () => {
		if (timelineEvents.length === 0) return;
		let text = `💍 CRONOGRAMA DEL DÍA DE LA BODA (Ceremonia: ${minutesToFormattedTime(parseTimeToMinutes(ceremonyInput.value))})\n\n`;
		timelineEvents.forEach(evt => {
			text += `• ${minutesToFormattedTime(evt.minutes)} — ${evt.name}\n`;
		});

		navigator.clipboard.writeText(text).then(() => {
			const btn = document.getElementById('btn-copy-summary');
			btn.textContent = '✅ ¡Copiado al Portapapeles!';
			setTimeout(() => { btn.textContent = '📋 Copiar Resumen'; }, 2000);
		});
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		if (timelineEvents.length === 0) return;

		let rows = '';
		timelineEvents.forEach(evt => {
			rows += `
				<tr>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold; width:100px;">${minutesToFormattedTime(evt.minutes)}</td>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold;">${evt.name}</td>
					<td style="border:1px solid #ccc; padding:8px; width:130px;">${evt.role.toUpperCase()}</td>
					<td style="border:1px solid #ccc; padding:8px; color:#555;">${evt.description || '-'}</td>
				</tr>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Cronograma del Día de la Boda</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Horarios del Día de la Boda</h1>
				<p>Generado el: ${new Date().toLocaleDateString('es-ES')} | Ceremonia: ${minutesToFormattedTime(parseTimeToMinutes(ceremonyInput.value))}</p>
				<table>
					<thead>
						<tr>
							<th>Hora</th>
							<th>Hito / Momento</th>
							<th>Categoría</th>
							<th>Notas Logísticas</th>
						</tr>
					</thead>
					<tbody>
						${rows}
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Cronograma_Boda_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const printDate = document.getElementById('print-date');
		const printCeremony = document.getElementById('print-ceremony-time');
		const printTbody = document.getElementById('print-timeline-body');

		printDate.textContent = new Date().toLocaleDateString('es-ES');
		printCeremony.textContent = minutesToFormattedTime(parseTimeToMinutes(ceremonyInput.value));

		printTbody.innerHTML = '';
		timelineEvents.forEach(evt => {
			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">${minutesToFormattedTime(evt.minutes)}</td>
				<td style="border: 1px solid #ccc; padding: 6px;">
					<strong>${evt.name}</strong>
					<div style="font-size: 11px; color: #555;">${evt.description || ''}</div>
				</td>
				<td style="border: 1px solid #ccc; padding: 6px;">${evt.role.toUpperCase()}</td>
			`;
			printTbody.appendChild(tr);
		});

		window.print();
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Hora,Hito,Categoría,Notas\n";
		timelineEvents.forEach(evt => {
			csv += `"${minutesToFormattedTime(evt.minutes)}","${(evt.name||'').replace(/"/g, '""')}","${evt.role}","${(evt.description||'').replace(/"/g, '""')}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Cronograma_Boda_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateTimeline();
</script>
