		border-radius: 6px;
		padding: 0.75rem 1rem;
		box-shadow: 2px 2px 0 var(--fg-pencil);
		transition: transform 0.15s ease;
	}
	.timeline-event-card:hover {
		transform: translateX(4px);
	}

	.timeline-bullet-dot {
		position: absolute;
		left: -2.85rem;
		top: 1rem;
		width: 14px;
		height: 14px;
		background: #fff;
		border: 2.5px solid var(--fg-pencil);
		border-radius: 50%;
		box-shadow: 0 0 0 3px var(--bg-paper);
	}

	.event-tag {
		font-size: 0.75rem;
		padding: 0.1rem 0.45rem;
		border-radius: 3px;
		border: 1px solid var(--fg-pencil);
		font-weight: bold;
		display: inline-block;
	}
	.tag-wedding-party {
		background: #ffdfba;
	}
	.tag-photo {
		background: #baffc9;
	}
	.tag-reception {
