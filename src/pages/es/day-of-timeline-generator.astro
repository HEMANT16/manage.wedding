---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/day-of-timeline-generator/#webapp",
      "name": "Generador de Cronograma y Horarios del Día de la Boda (Timing Nupcial)",
      "url": "https://manage.wedding/es/day-of-timeline-generator",
      "inLanguage": "es",
      "description": "Generador gratuito del cronograma y timing del día de la boda. Calcula los horarios minuto a minuto desde peluquería y maquillaje hasta el baile y la recena. Exporta a Word, PDF y Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo funciona el generador de cronograma para el día de la boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Indica la hora de inicio de la ceremonia, si haréis First Look (encuentro previo) y el tiempo de desplazamiento. La herramienta calcula automáticamente el timing completo hacia atrás y hacia adelante (preparativos, sesión de fotos, cóctel, banquete y fiesta)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es el 'First Look' y cómo afecta a los horarios de la boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El First Look es el encuentro íntimo de los novios a solas antes de la ceremonia. Permite realizar las fotos de pareja y con los testigos antes del 'sí, quiero', de modo que tras la ceremonia podáis disfrutar del 100% del cóctel con los invitados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto margen de seguridad (buffer) conviene añadir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se recomienda dejar un colchón de 15 minutos en peluquería y maquillaje, 15 minutos adicionales al trayecto en coche y prever que la ceremonia suele empezar entre 5 y 10 minutos tarde mientras se sientan los invitados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo exportar el timing a Word o PDF para los proveedores?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, puedes descargar el cronograma completo en formato Word (.doc), imprimirlo en PDF para los padrinos y fotógrafo o exportarlo a Excel (.csv)."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Cómo Planificar el Timing y Horarios del Día de la Boda",
      "description": "Guía maestra paso a paso para cuadrar todos los momentos del día sin estrés ni retrasos.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Fija la Hora de la Ceremonia como Eje Central",
          "text": "Establece la hora de la ceremonia (ej. 18:00 h). Todos los preparativos previos y los hitos posteriores se calculan a partir de este punto."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Decide si Habrá First Look o Reportaje Tradicional",
          "text": "Elige si haréis las fotos de pareja 1,5 h antes de la ceremonia o durante la primera media hora del cóctel."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Calcula el Tiempo de Maquillaje y Peluquería",
          "text": "Calcula 45 minutos por invitada/dama y entre 60 y 90 minutos para la novia, terminando siempre 45 minutos antes de salir de casa."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Cuadra los Tiempos de Cóctel, Banquete y Baile",
          "text": "Reserva entre 60 y 75 minutos para el cóctel de bienvenida, 90 minutos para la comida o cena y entre 2,5 y 4 horas para la barra libre y baile."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 5: Exporta y Entrega Copias a los Proveedores",
          "text": "Exporta el itinerario a Word o PDF y entrégalo al fotógrafo, DJ, maitre del catering y wedding planner."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Generador de Cronograma y Timing del Día de la Boda | Manage.Wedding"
	description="Crea el cronograma y horarios del día de tu boda en segundos. Ajusta ceremonia, First Look, fotos, banquete y baile. Exporta a Word, PDF o Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Cronograma del Día de la Boda" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Cronograma y Timing <span class="accent-italic">del Día de la Boda</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Organiza cada minuto de tu gran día sin agobios. Cuadra peluquería, maquillaje, fotos, banquete, barra libre y exporta en <strong>Word (.doc)</strong>, <strong>PDF</strong> o <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Timeline Builder Controls & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						⏱️ Generador de Horarios y Guion del Evento
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Calculado hacia atrás y hacia adelante a partir de la ceremonia
					</span>
				</div>

				<!-- Export & Control Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Exportar a Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Imprimir / PDF
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Exportar Excel (.csv)
					</button>
					<button type="button" id="btn-copy-summary" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📋 Copiar Resumen
					</button>
				</div>
			</div>

			<!-- Preset Timeline Quick Switcher -->
			<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
				<span class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
					⚡ Elige una Plantilla de Horarios Típica:
				</span>
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" id="preset-buttons-container">
					<button type="button" class="preset-btn active-preset" data-ceremony="18:00" data-firstlook="yes" data-travel="15" data-reception="5">
						🌅 Boda de Tarde Clásica (18:00 h • Con First Look)
					</button>
					<button type="button" class="preset-btn" data-ceremony="19:00" data-firstlook="yes" data-travel="10" data-reception="4.5">
						🌇 Atardecer de Verano (19:00 h • Golden Hour)
					</button>
					<button type="button" class="preset-btn" data-ceremony="12:30" data-firstlook="no" data-travel="20" data-reception="5">
						⛪ Boda de Mañana / Mediodía (12:30 h • Tradicional)
					</button>
					<button type="button" class="preset-btn" data-ceremony="13:00" data-firstlook="yes" data-travel="10" data-reception="4">
						🥂 Almuerzo & Fiesta de Día (13:00 h)
					</button>
				</div>
			</div>

			<!-- Core Configuration Form Inputs -->
			<form id="timeline-form" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; align-items: end;">
				<div>
					<label for="ceremony-time" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						Hora de Inicio de Ceremonia
					</label>
					<input type="time" id="ceremony-time" value="18:00" required style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: var(--bg-paper);">
				</div>

				<div>
					<label for="first-look" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						¿Hacer First Look (Encuentro Previo)?
					</label>
					<select id="first-look" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: #fff;">
						<option value="yes" selected>Sí (Fotos de pareja antes de la ceremonia)</option>
						<option value="no">No (Fotos durante el cóctel)</option>
					</select>
				</div>

				<div>
					<label for="travel-time" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						Desplazamiento al Lugar (Minutos)
					</label>
					<input type="number" id="travel-time" min="0" max="180" value="15" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: var(--bg-paper);">
				</div>

				<div>
					<label for="reception-hours" class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--fg-pencil);">
						Duración del Banquete y Fiesta (Horas)
					</label>
					<select id="reception-hours" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: #fff;">
						<option value="3.5">3,5 Horas</option>
						<option value="4">4,0 Horas</option>
						<option value="4.5">4,5 Horas</option>
						<option value="5" selected>5,0 Horas (Estándar Cóctel + Cena + Barra Libre)</option>
						<option value="6">6,0 Horas (Boda Larga con Recena)</option>
					</select>
				</div>
			</form>
		</div>

		<!-- Main Workspace Grid: Interactive Timeline Stream + Custom Milestone Adder -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 340px; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="timeline-workspace-grid">
			
			<!-- Left: Master Visual Vertical Timeline Stream -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Header & Audience Filter Tabs -->
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h3 class="font-heading" style="font-size: 1.4rem; margin: 0; color: var(--fg-pencil);">
							📋 Itinerario Maestro del Gran Día
						</h3>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
							Edita, añade o elimina momentos según vuestra boda
						</span>
					</div>

					<!-- Role Filter Pills -->
					<div style="display: flex; gap: 0.3rem; flex-wrap: wrap;" id="role-filter-group">
						<button type="button" class="role-pill-btn active-role" data-role="all">Todos los Hitos</button>
						<button type="button" class="role-pill-btn" data-role="wedding-party">👰 Novios y Familia</button>
						<button type="button" class="role-pill-btn" data-role="photo">📸 Foto y Vídeo</button>
						<button type="button" class="role-pill-btn" data-role="reception">🍽️ Banquete y Fiesta</button>
					</div>
				</div>

				<!-- Vertical Timeline Container -->
				<div id="timeline-stream" class="timeline-stream-box" style="position: relative; padding-left: 2.25rem; border-left: 3px solid var(--fg-pencil); margin-left: 1rem;">
					<!-- Injected via JS -->
				</div>

			</div>

			<!-- Right: Custom Milestone Adder & Day-Of Buffer Checklist -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Add Custom Milestone Card -->
				<div class="hand-card" style="padding: 1.25rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
						<span>➕</span> Añadir Momento Personalizado
					</h3>
					
					<form id="add-custom-event-form" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<div>
							<label for="custom-event-name" class="font-heading" style="display: block; font-size: 0.85rem; margin-bottom: 0.2rem;">Nombre del Hito o Momento</label>
							<input type="text" id="custom-event-name" required placeholder="ej. Recena de Mini Hamburguesas, Entrega de Ramos" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.95rem; background: var(--bg-paper);">
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<label for="custom-event-time" class="font-heading" style="display: block; font-size: 0.85rem; margin-bottom: 0.2rem;">Hora</label>
								<input type="time" id="custom-event-time" required value="23:30" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.9rem; background: var(--bg-paper);">
							</div>
							<div>
								<label for="custom-event-role" class="font-heading" style="display: block; font-size: 0.85rem; margin-bottom: 0.2rem;">Categoría</label>
								<select id="custom-event-role" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
									<option value="reception">Banquete y Fiesta</option>
									<option value="wedding-party">Novios y Familia</option>
									<option value="photo">Foto y Vídeo</option>
								</select>
							</div>
						</div>

						<button type="submit" class="hand-btn" style="padding: 0.5rem; font-size: 0.95rem; margin-top: 0.25rem;">
							✨ Añadir al Cronograma
						</button>
					</form>
				</div>

				<!-- Essential Day-Of Timing Rules Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.5rem;">
						📌 Regla de Oro del Margen de 15 Minutos:
					</strong>
					<ul class="font-body" style="font-size: 0.85rem; line-height: 1.5; padding-left: 1.1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Maquillaje y Peinado:</strong> Concluir 45 min antes de vestirse y salir.</li>
						<li><strong>Trayecto en Coche:</strong> Suma +15 min a la ruta prevista en Google Maps.</li>
						<li><strong>Ceremonia:</strong> Asume 5-10 min de cortesía para sentar a los invitados.</li>
						<li><strong>Puesta de Sol:</strong> Programa las fotos de pareja 45 min antes del atardecer.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Cronograma Oficial del Día de la Boda</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Fecha de Generación: <span id="print-date"></span> | Hora Ceremonia: <span id="print-ceremony-time"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; width: 90px; text-align: left;">Hora</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Hito / Momento</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 120px; text-align: left;">Categoría</th>
					</tr>
				</thead>
				<tbody id="print-timeline-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Regla de Oro del Timing</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Tiempos Estándar de Referencia para una Boda
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>La Fórmula Central:</strong> Fija la <strong>Hora de Inicio de la Ceremonia</strong> como punto cero. Calcula <strong>45 min por persona</strong> para peluquería/maquillaje (60–90 min para la novia), programa el reportaje de pareja <strong>1,5 a 2 horas antes</strong> (si hacéis First Look), reserva <strong>60 a 75 minutos para el cóctel</strong> y <strong>90 minutos para la comida o cena</strong>.
			</p>
			
			<!-- Benchmark Milestone Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Hito del Día</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Duración Recomendada</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Momento Ideal</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Consejo de Coordinación</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Peluquería y Maquillaje</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">45 min/acompañante; 60–90 min novia</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Terminar 1 hora antes de las fotos</td>
							<td style="padding: 0.6rem 0.8rem;">La novia se maquilla la penúltima para no ir con prisas</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">First Look y Fotos de Pareja</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">45–60 minutos</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">2 a 2,5 horas antes de la ceremonia</td>
							<td style="padding: 0.6rem 0.8rem;">Momento íntimo a solas sin invitados presentes</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Ceremonia (Civil o Religiosa)</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">25–35 min (civil) / 45–60 min (religiosa)</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Hora fijada en la invitación</td>
							<td style="padding: 0.6rem 0.8rem;">Música de bienvenida 20 min antes para acomodar invitados</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Cóctel de Bienvenida</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">60–75 minutos</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Justo tras la ceremonia</td>
							<td style="padding: 0.6rem 0.8rem;">Apertura inmediata de estaciones de aperitivos y bebidas</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">Banquete (Comida o Cena)</td>
