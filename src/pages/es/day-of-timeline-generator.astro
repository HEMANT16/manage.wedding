	}
	.preset-btn.active-preset {
		background: var(--accent-blue) !important;
		color: #fff !important;
		border-color: #1e40af !important;
	}

	.role-pill-btn {
		background: #fff;
		border: 1px solid var(--fg-pencil);
		border-radius: 20px;
		padding: 0.2rem 0.6rem;
		font-size: 0.8rem;
		cursor: pointer;
		font-family: var(--font-body);
		transition: all 0.15s ease;
	}
	.role-pill-btn.active-role {
		background: var(--fg-pencil) !important;
		color: #fff !important;
	}

	.timeline-event-card {
		position: relative;
		margin-bottom: 1.75rem;
		background: var(--bg-paper);
