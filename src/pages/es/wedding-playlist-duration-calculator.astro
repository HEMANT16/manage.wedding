	function updateAllCalculations() {
		const mPrelude = parseInt(sliderPrelude.value) || 30;
		const mCocktail = parseInt(sliderCocktail.value) || 60;
		const mDinner = parseInt(sliderDinner.value) || 90;
		const mDance = parseInt(sliderDance.value) || 180;
		const mAfterparty = parseInt(sliderAfterparty.value) || 0;

		valPrelude.textContent = `${mPrelude} min`;
		valCocktail.textContent = `${mCocktail} min`;
		valDinner.textContent = `${mDinner} min`;
		valDance.textContent = `${mDance} min (${(mDance/60).toFixed(1)}h)`;
		valAfterparty.textContent = mAfterparty === 0 ? "0 min (Sin after)" : `${mAfterparty} min`;

		const pace = selectMixPacing.value;
		let avgSongMins = 3.5;
		let danceSongMins = 3.0;

		if (pace === 'quickmix') {
			avgSongMins = 3.0;
			danceSongMins = 2.6;
		} else if (pace === 'lounge') {
			avgSongMins = 4.2;
			danceSongMins = 3.8;
		}

		const sPrelude = Math.round(mPrelude / 3.3);
		const sCocktail = Math.round(mCocktail / avgSongMins);
		const sDinner = Math.round(mDinner / avgSongMins);
		const sDance = Math.round(mDance / danceSongMins);
		const sAfterparty = Math.round(mAfterparty / danceSongMins);

		songsPrelude.textContent = `~${sPrelude} temas (60-80 BPM)`;
		songsCocktail.textContent = `~${sCocktail} temas (90-115 BPM)`;
		songsDinner.textContent = `~${sDinner} temas (70-95 BPM)`;
		songsDance.textContent = `~${sDance} temas (118-132 BPM)`;
		songsAfterparty.textContent = mAfterparty === 0 ? "0 temas" : `~${sAfterparty} temas (120-130 BPM)`;

		const totalMinutes = mPrelude + mCocktail + mDinner + mDance + mAfterparty;
		const hPart = Math.floor(totalMinutes / 60);
		const mPart = totalMinutes % 60;
		const totalPlayedSongs = sPrelude + sCocktail + sDinner + sDance + sAfterparty;
		const bufferedSongs = Math.round(totalPlayedSongs * 1.20);

		displayTotalRuntime.textContent = `${hPart}h ${mPart > 0 ? mPart + 'm' : '00m'} (${totalMinutes} min)`;
		displayExactTracks.textContent = `~${totalPlayedSongs} Temas`;
		displayBufferedTracks.textContent = `~${bufferedSongs} Temas`;
		displayDanceTracks.textContent = `~${sDance} Temas`;

		updateLiveBriefPreview(totalMinutes, hPart, mPart, totalPlayedSongs, bufferedSongs);
	}

	function renderMustPlayList() {
		const listContainer = document.getElementById('must-play-list');
		const counter = document.getElementById('must-play-counter');
		counter.textContent = `${mustPlayList.length} / 20 Temas`;

