---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-playlist-duration-calculator/#webapp",
      "name": "Calculadora de Playlist de Boda, Canciones para DJ y Duración",
      "url": "https://manage.wedding/es/wedding-playlist-duration-calculator",
      "inLanguage": "es",
      "description": "Calculadora gratuita de música y lista de canciones para bodas. Calcula el número exacto de temas para ceremonia, cóctel, banquete y barra libre, planifica bailes especiales y genera el briefing para el DJ en PDF y Word.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántas canciones se necesitan para una boda de 5 o 6 horas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para una boda completa de 6 horas (360 minutos), se reproducen entre 100 y 120 canciones (a una media de 3,5 minutos por tema en radio o 2,5 minutos en transiciones rápidas de DJ). Se recomienda preparar una lista total con un 20% de margen (unas 130 a 140 canciones) para que el DJ tenga flexibilidad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas canciones imprescindibles (Must-Play) se deben dar al DJ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los DJs profesionales recomiendan limitar la lista de temas imprescindibles a un máximo de 15 o 20 canciones. Entregar listas rígidas de más de 50 temas impide al DJ leer las reacciones de los invitados y ajustar la energía de la pista de baile."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto debe durar el primer baile de recién casados y el baile con los padres?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La duración ideal del primer baile y los bailes familiares es de 2:30 a 3 minutos. Los temas completos de 4 a 5 minutos se hacen eternos para la pareja y desconectan a los invitados. Se aconseja pedir al DJ un desvanecimiento suave (fade out) a los 2 minutos y medio."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Cómo Planificar la Playlist y la Ficha de Música para el DJ de tu Boda",
      "description": "Guía paso a paso para calcular el número de canciones por fase, asignar cortes de audio y exportar la ficha del DJ.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Ajusta los Tiempos de Cada Fase",
          "text": "Indica los minutos de duración del preludio, cóctel de bienvenida, banquete y barra libre para calcular el número de canciones necesarias."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Asigna Momentos Clave e Instrucciones de Audio",
          "text": "Selecciona las canciones y minutos exactos de corte para la entrada de la novia, salida de la ceremonia, primer baile, tarta y ramo."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Crea tu Lista Imprescindible y Lista Negra",
          "text": "Añade hasta 20 temas favoritos y bloquea géneros no deseados o canciones prohibidas."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Exporta la Ficha Técnica para el DJ (PDF y Word)",
          "text": "Descarga el briefing musical completo para entregarlo al profesional en la reunión previa a la boda."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Playlist de Boda, Canciones DJ y Duración (PDF y Word Gratis) | Manage.Wedding"
	description="Calcula el número exacto de canciones por fase de boda, planifica bailes especiales con cortes de audio, crea listas imprescindibles y prohibidas, y descarga la ficha para DJ."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Calculadora de Playlist y Música DJ" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🎵</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratis • Privado en tu Navegador • Exportación a PDF y Word</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de Playlist de Boda y Música DJ
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 740px; margin: 0 auto; text-align: center;">
					Calcula el número exacto de temas para cada fase, planifica bailes especiales con minutos de corte exactos, crea tu <strong>Lista Imprescindible y Lista Negra</strong>, y exporta el <strong>Briefing Técnico para el DJ o Grupo Musical</strong> en PDF y Word.
				</p>
			</div>
		</section>

		<!-- Guía Rápida en 3 Pasos -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>🎧</span> Cómo Organizar la Música de tu Boda en 3 Pasos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Duraciones y Ritmo BPM
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Ajusta los minutos para ceremonia, cóctel, banquete y barra libre para calcular el número de temas.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Momentos Especiales
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Selecciona canciones y notas de corte para la entrada, primer baile nupcial, tarta y ramo.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Listas y Ficha DJ
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Añade hasta 20 imprescindibles, veta canciones y descarga el PDF técnico para tu DJ.
					</p>
				</div>
			</div>
		</div>

		<!-- Espacio de Trabajo Interactivo -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SECCIÓN 1: Duraciones de Fases y Resumen Numérico -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🎚️ 1. Duración de Fases y Cálculo de Canciones
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Estima el número de temas según el tiempo y el estilo de transición del DJ
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center;">
						<label for="select-mix-pacing" class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil);">
							Estilo DJ:
						</label>
						<select id="select-mix-pacing" style="padding: 0.35rem 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem; font-weight: 600;">
							<option value="radio" selected>Canciones Completas Radio (~3.5 min / 17 temas/h)</option>
							<option value="quickmix">Transiciones DJ / Quick Mix (~2.7 min / 22 temas/h)</option>
							<option value="lounge">Acústico & Lounge Extendido (~4.2 min / 14 temas/h)</option>
						</select>
					</div>
				</div>

				<!-- Grid Deslizadores -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
					
					<!-- Preludio -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-prelude" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🎻</span> Preludio Ceremonia
							</label>
							<span id="val-prelude" class="font-heading" style="font-size: 1rem; color: var(--accent-red); font-weight: 700;">30 min</span>
						</div>
						<input type="range" id="slider-prelude" min="15" max="60" step="5" value="30" style="width: 100%; accent-color: var(--accent-red);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>15 min</span>
							<span id="songs-prelude" style="font-weight: 600; color: var(--fg-pencil);">~9 temas (60-80 BPM)</span>
							<span>60 min</span>
						</div>
					</div>

					<!-- Cóctel -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-cocktail" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍸</span> Cóctel / Bienvenida
							</label>
							<span id="val-cocktail" class="font-heading" style="font-size: 1rem; color: var(--accent-blue); font-weight: 700;">60 min</span>
						</div>
						<input type="range" id="slider-cocktail" min="30" max="120" step="5" value="60" style="width: 100%; accent-color: var(--accent-blue);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>30 min</span>
							<span id="songs-cocktail" style="font-weight: 600; color: var(--fg-pencil);">~17 temas (90-115 BPM)</span>
							<span>120 min</span>
						</div>
					</div>

					<!-- Banquete -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dinner" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍽️</span> Comida / Banquete
							</label>
							<span id="val-dinner" class="font-heading" style="font-size: 1rem; color: #d97706; font-weight: 700;">90 min</span>
						</div>
						<input type="range" id="slider-dinner" min="45" max="150" step="5" value="90" style="width: 100%; accent-color: #d97706;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>45 min</span>
							<span id="songs-dinner" style="font-weight: 600; color: var(--fg-pencil);">~25 temas (70-95 BPM)</span>
							<span>150 min</span>
						</div>
					</div>

					<!-- Fiesta / Barra Libre -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dance" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🕺</span> Fiesta / Barra Libre
							</label>
							<span id="val-dance" class="font-heading" style="font-size: 1rem; color: #16a34a; font-weight: 700;">180 min (3.0h)</span>
						</div>
						<input type="range" id="slider-dance" min="60" max="360" step="15" value="180" style="width: 100%; accent-color: #16a34a;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>1 hora</span>
							<span id="songs-dance" style="font-weight: 600; color: var(--fg-pencil);">~52-60 temas (118-132 BPM)</span>
							<span>6 horas</span>
						</div>
					</div>

					<!-- Afterparty Opcional -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-afterparty" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🌙</span> Recena / Afterparty
							</label>
							<span id="val-afterparty" class="font-heading" style="font-size: 1rem; color: #7c3aed; font-weight: 700;">0 min</span>
						</div>
						<input type="range" id="slider-afterparty" min="0" max="120" step="15" value="0" style="width: 100%; accent-color: #7c3aed;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>0 min (Sin after)</span>
							<span id="songs-afterparty" style="font-weight: 600; color: var(--fg-pencil);">0 temas</span>
							<span>120 min</span>
						</div>
					</div>

				</div>

				<!-- Resumen de Métricas -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; background: var(--muted-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; text-align: center;">
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Tiempo Total de Música</span>
						<strong id="display-total-runtime" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil);">6h 00m (360 min)</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Canciones Sonadas</span>
						<strong id="display-exact-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue);">~103 Temas</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Playlist Recomendada (+20% Margen)</span>
						<strong id="display-buffered-tracks" class="font-heading" style="font-size: 1.6rem; color: #16a34a;">~125 Temas</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Temas para Fiesta / Baile</span>
						<strong id="display-dance-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red);">~52 Temas</strong>
					</div>
				</div>

			</div>

			<!-- SECCIÓN 2: Momentos Especiales y Cortes de Audio -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							💃 2. Momentos Especiales y Notas de Corte de Audio
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Elige entre canciones populares o personaliza con minutos exactos de fundido y entrada
						</span>
					</div>
					<button type="button" id="btn-autofill-special" class="hand-btn" style="padding: 0.3rem 0.7rem; font-size: 0.8rem; background: #eff6ff;">
						✨ Cargar Selección Clásica
					</button>
				</div>

				<div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" id="special-moments-container">
					<!-- Generado por JS -->
				</div>
			</div>

			<!-- SECCIÓN 3: Lista Imprescindible y Lista Negra -->
			<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 1fr; gap: 1.5rem;">
				
				<!-- Caja Imprescindibles -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.25rem; color: #16a34a; margin: 0;">
								⭐ Canciones Imprescindibles (Must-Play)
							</h3>
							<span class="font-body" style="font-size: 0.8rem; color: var(--text-secondary);">
								Objetivo: 10–20 temas (permite al DJ leer la pista)
							</span>
						</div>
						<span id="must-play-counter" class="badge-postit" style="font-size: 0.85rem;">0 / 20 Temas</span>
					</div>

					<!-- Añadido Rápido -->
					<div style="margin-bottom: 1rem; background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<span class="font-heading" style="font-size: 0.8rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem;">
							⚡ Éxitos Infalibles de Pista:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;" id="quick-must-pills">
							<button type="button" class="btn-quick-add hand-btn" data-title="Vivir Mi Vida" data-artist="Marc Anthony" data-phase="Fiesta" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Marc Anthony</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Danza Kuduro" data-artist="Don Omar" data-phase="Fiesta" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Danza Kuduro</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="September" data-artist="Earth, Wind & Fire" data-phase="Fiesta" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ September</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Bailando" data-artist="Enrique Iglesias" data-phase="Fiesta" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Bailando</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="La Gozadera" data-artist="Gente de Zona" data-phase="Fiesta" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ La Gozadera</button>
						</div>
					</div>

					<!-- Formulario Añadir -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 0.9fr auto; gap: 0.4rem; margin-bottom: 1rem;">
						<input type="text" id="input-must-title" placeholder="Título (ej. Despacito)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<input type="text" id="input-must-artist" placeholder="Artista (ej. Luis Fonsi)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<select id="select-must-phase" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.8rem; background: #fff;">
							<option value="Fiesta / Barra Libre">Fiesta</option>
							<option value="Cóctel de Bienvenida">Cóctel</option>
							<option value="Banquete">Banquete</option>
							<option value="Himno de Fin de Fiesta">Fin Fiesta</option>
						</select>
						<button type="button" id="btn-add-must" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background: #16a34a; color: #fff;">+ Añadir</button>
					</div>

					<!-- Lista -->
					<div id="must-play-list" style="max-height: 280px; overflow-y: auto; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #faf8f5; padding: 0.5rem;">
						<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin: 1rem 0;">Aún no has añadido temas imprescindibles.</p>
					</div>
				</div>

				<!-- Caja Lista Negra -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
