						</label>
						<input type="text" id="input-wedding-date" value="Sábado 12 de Septiembre — Finca Los Olivos" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.9rem;" />
					</div>

					<div>
						<label for="select-mc-style" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--accent-blue); margin-bottom: 0.2rem;">
