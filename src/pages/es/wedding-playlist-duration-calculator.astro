	const displayExactTracks = document.getElementById('display-exact-tracks');
	const displayBufferedTracks = document.getElementById('display-buffered-tracks');
	const displayDanceTracks = document.getElementById('display-dance-tracks');

	const specialContainer = document.getElementById('special-moments-container');
	function renderSpecialMoments() {
		specialContainer.innerHTML = '';
		specialMomentConfigs.forEach(moment => {
			const card = document.createElement('div');
			card.style.cssText = 'background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;';
			
			let presetOptions = `<option value="">-- Selección Recomendada --</option>`;
			moment.presets.forEach(p => {
				presetOptions += `<option value="${p.title}|${p.artist}|${p.cue}">${p.title} — ${p.artist}</option>`;
			});

			card.innerHTML = `
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.6rem;">
					<strong class="font-heading" style="font-size: 1rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.35rem;">
						<span>${moment.icon}</span> ${moment.label}
					</strong>
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.75rem; color: var(--text-secondary);">Sugerencia:</span>
						<select class="special-preset-select" data-id="${moment.id}" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.8rem; background: #fff;">
							${presetOptions}
						</select>
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1.2fr 1fr 1.5fr; gap: 0.5rem;" class="moment-inputs-grid">
					<div>
						<label style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Título de la Canción</label>
						<input type="text" id="special-title-${moment.id}" value="${moment.defaultTitle}" style="width: 100%; padding: 0.35rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Artista</label>
						<input type="text" id="special-artist-${moment.id}" value="${moment.defaultArtist}" style="width: 100%; padding: 0.35rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Notas de Entrada / Corte de Audio</label>
						<input type="text" id="special-cue-${moment.id}" value="${moment.defaultCue}" style="width: 100%; padding: 0.35rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>
			`;
			specialContainer.appendChild(card);
		});

		document.querySelectorAll('.special-preset-select').forEach(sel => {
			sel.addEventListener('change', (e) => {
				const id = e.target.getAttribute('data-id');
				const val = e.target.value;
				if (val) {
					const [t, a, c] = val.split('|');
					document.getElementById(`special-title-${id}`).value = t;
