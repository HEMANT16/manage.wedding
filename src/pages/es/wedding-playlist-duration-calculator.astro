		} else {
			counter.style.background = 'var(--post-it)';
			counter.style.color = 'var(--fg-pencil)';
		}

		if (mustPlayList.length === 0) {
			listContainer.innerHTML = '<p style="font-size:0.85rem; color:var(--text-secondary); text-align:center; margin:1rem 0;">Aún no has añadido temas imprescindibles.</p>';
			return;
