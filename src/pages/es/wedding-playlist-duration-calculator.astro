			return;
		}

		let html = '<ul style="margin:0; padding-left:1.2rem; font-size:0.85rem;">';
		bannedSongsList.forEach((item, idx) => {
			html += `
				<li style="margin-bottom:0.25rem;">
					<strong>${item.song}</strong> ${item.reason ? `<span style="color:var(--text-secondary); font-size:0.78rem;">(${item.reason})</span>` : ''}
					<button type="button" class="btn-del-banned" data-index="${idx}" style="background:none; border:none; color:var(--accent-red); cursor:pointer; font-weight:bold; font-size:0.8rem; margin-left:0.5rem;">✕</button>
				</li>
			`;
		});
		html += '</ul>';
		listContainer.innerHTML = html;

		document.querySelectorAll('.btn-del-banned').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-index'));
				bannedSongsList.splice(idx, 1);
				renderBlacklist();
				updateAllCalculations();
			});
		});
	}

	function updateLiveBriefPreview(totalMin, hPart, mPart, totalSongs, buffSongs) {
		const previewBox = document.getElementById('brief-preview-box');
		const coupleNames = document.getElementById('input-couple-names').value.trim() || 'Lucía & Carlos';
		const weddingDate = document.getElementById('input-wedding-date').value.trim() || '12 de Septiembre';
		const mcStyle = document.getElementById('select-mc-style').value;
		const reqPolicy = document.getElementById('select-guest-requests').value;
		const audioNotes = document.getElementById('input-audio-notes').value.trim() || 'Sin notas técnicas especiales.';

		let specialRowsHtml = '';
		let printSpecialRows = '';
		specialMomentConfigs.forEach(m => {
			const t = document.getElementById(`special-title-${m.id}`)?.value || m.defaultTitle;
			const a = document.getElementById(`special-artist-${m.id}`)?.value || m.defaultArtist;
			const c = document.getElementById(`special-cue-${m.id}`)?.value || m.defaultCue;

			specialRowsHtml += `
				<tr style="border-bottom:1px solid #e2e8f0;">
					<td style="padding:6px 8px; font-weight:700;">${m.icon} ${m.label.split('. ')[1]}</td>
					<td style="padding:6px 8px; font-weight:600; color:var(--accent-blue);">${t}</td>
					<td style="padding:6px 8px; color:var(--text-secondary);">${a}</td>
					<td style="padding:6px 8px; font-style:italic; font-size:0.82rem;">${c}</td>
				</tr>
			`;

			printSpecialRows += `
				<tr style="border-bottom:1px solid #cbd5e1;">
					<td style="padding:6px 8px; font-weight:bold;">${m.label.split('. ')[1]}</td>
					<td style="padding:6px 8px; font-weight:bold; color:#1e40af;">${t}</td>
					<td style="padding:6px 8px;">${a}</td>
					<td style="padding:6px 8px; font-style:italic;">${c}</td>
				</tr>
			`;
		});

		let mustHtml = '<ol style="margin:0; padding-left:1.2rem; font-size:0.85rem;">';
		mustPlayList.forEach(m => {
			mustHtml += `<li><strong>${m.title}</strong> — ${m.artist} <span style="font-size:0.75rem; color:var(--text-secondary);">[${m.phase}]</span></li>`;
		});
		if (mustPlayList.length === 0) mustHtml += '<li><em>Ninguna indicada</em></li>';
		mustHtml += '</ol>';

		const checkedGenres = Array.from(document.querySelectorAll('.chk-banned-genre:checked')).map(c => c.value);
		let banHtml = '<ul style="margin:0; padding-left:1.2rem; font-size:0.85rem;">';
		if (checkedGenres.length > 0) {
			banHtml += `<li><strong>Géneros Vetados:</strong> ${checkedGenres.join(', ')}</li>`;
		}
		bannedSongsList.forEach(b => {
			banHtml += `<li><strong>${b.song}</strong> ${b.reason ? `<em>(${b.reason})</em>` : ''}</li>`;
		});
		if (checkedGenres.length === 0 && bannedSongsList.length === 0) banHtml += '<li><em>Sin restricciones</em></li>';
		banHtml += '</ul>';

		previewBox.innerHTML = `
			<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:2px solid var(--fg-pencil); padding-bottom:8px; margin-bottom:12px;">
				<div>
					<h3 class="font-heading" style="margin:0; font-size:1.3rem; color:var(--fg-pencil);">🎵 Ficha Técnica para DJ de Boda</h3>
					<span style="font-size:0.85rem; color:var(--text-secondary);">${coupleNames} • ${weddingDate}</span>
				</div>
				<span class="badge-postit" style="font-size:0.8rem;">Duración: ${hPart}h ${mPart}m (~${totalSongs} Temas)</span>
			</div>

			<div style="margin-bottom:1rem; overflow-x:auto;">
				<table style="width:100%; border-collapse:collapse; font-size:0.85rem; text-align:left;">
					<thead>
						<tr style="background:var(--muted-paper); border-bottom:1.5px solid var(--fg-pencil);">
							<th style="padding:6px 8px; font-family:var(--font-heading);">Momento</th>
							<th style="padding:6px 8px; font-family:var(--font-heading);">Canción</th>
							<th style="padding:6px 8px; font-family:var(--font-heading);">Artista</th>
							<th style="padding:6px 8px; font-family:var(--font-heading);">Instrucciones de Audio</th>
						</tr>
					</thead>
					<tbody>
						${specialRowsHtml}
					</tbody>
				</table>
			</div>

			<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem;">
				<div style="background:var(--bg-paper); border:1.5px solid var(--fg-pencil); border-radius:4px; padding:0.75rem;">
					<strong class="font-heading" style="color:#16a34a; font-size:0.9rem; display:block; margin-bottom:0.3rem;">⭐ Imprescindibles (${mustPlayList.length})</strong>
					${mustHtml}
				</div>
				<div style="background:var(--bg-paper); border:1.5px solid var(--fg-pencil); border-radius:4px; padding:0.75rem;">
					<strong class="font-heading" style="color:var(--accent-red); font-size:0.9rem; display:block; margin-bottom:0.3rem;">🚫 Lista Negra / Prohibidas</strong>
					${banHtml}
				</div>
			</div>

			<div style="font-size:0.82rem; color:var(--text-secondary); border-top:1px dashed var(--fg-pencil); padding-top:6px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:0.5rem;">
				<span><strong>Locución:</strong> ${mcStyle}</span>
				<span><strong>Peticiones:</strong> ${reqPolicy}</span>
			</div>
		`;

		document.getElementById('print-header-meta').textContent = `Pareja: ${coupleNames} | Fecha: ${weddingDate}`;
		document.getElementById('print-total-time').textContent = `${hPart}h ${mPart}m (${totalMin} min)`;
		document.getElementById('print-total-songs').textContent = `~${totalSongs} temas (+20%: ${buffSongs})`;
		document.getElementById('print-mc-style').textContent = mcStyle.split(' (')[0];
		document.getElementById('print-request-policy').textContent = reqPolicy.split(' (')[0];
		document.getElementById('print-special-tbody').innerHTML = printSpecialRows;
		document.getElementById('print-must-count').textContent = mustPlayList.length;
		document.getElementById('print-must-list').innerHTML = mustHtml;
		document.getElementById('print-ban-count').textContent = checkedGenres.length + bannedSongsList.length;
		document.getElementById('print-ban-list').innerHTML = banHtml;
		document.getElementById('print-audio-notes').textContent = audioNotes;
	}

	document.querySelectorAll('.btn-quick-add').forEach(btn => {
		btn.addEventListener('click', () => {
			const title = btn.getAttribute('data-title');
			const artist = btn.getAttribute('data-artist');
			const phase = "Fiesta / Barra Libre";
			if (!mustPlayList.some(m => m.title === title)) {
				mustPlayList.push({ title, artist, phase });
				renderMustPlayList();
				updateAllCalculations();
			}
		});
	});

	document.getElementById('btn-add-must').addEventListener('click', () => {
		const tInput = document.getElementById('input-must-title');
		const aInput = document.getElementById('input-must-artist');
		const pInput = document.getElementById('select-must-phase');
		const title = tInput.value.trim();
		const artist = aInput.value.trim() || 'Varios';
		const phase = pInput.value;

		if (title) {
			mustPlayList.push({ title, artist, phase });
			tInput.value = '';
			aInput.value = '';
			renderMustPlayList();
			updateAllCalculations();
		}
	});

	document.getElementById('btn-add-banned').addEventListener('click', () => {
		const sInput = document.getElementById('input-banned-song');
		const rInput = document.getElementById('input-banned-reason');
		const song = sInput.value.trim();
		const reason = rInput.value.trim();

		if (song) {
			bannedSongsList.push({ song, reason });
			sInput.value = '';
			rInput.value = '';
			renderBlacklist();
			updateAllCalculations();
		}
	});

	document.querySelectorAll('.chk-banned-genre').forEach(chk => {
		chk.addEventListener('change', () => {
			renderBlacklist();
			updateAllCalculations();
		});
	});

	document.getElementById('btn-autofill-special').addEventListener('click', () => {
		specialMomentConfigs.forEach(m => {
			document.getElementById(`special-title-${m.id}`).value = m.defaultTitle;
			document.getElementById(`special-artist-${m.id}`).value = m.defaultArtist;
			document.getElementById(`special-cue-${m.id}`).value = m.defaultCue;
		});
		updateAllCalculations();
	});

	sliderPrelude.addEventListener('input', updateAllCalculations);
	sliderCocktail.addEventListener('input', updateAllCalculations);
	sliderDinner.addEventListener('input', updateAllCalculations);
	sliderDance.addEventListener('input', updateAllCalculations);
	sliderAfterparty.addEventListener('input', updateAllCalculations);
	selectMixPacing.addEventListener('change', updateAllCalculations);

	document.getElementById('input-couple-names').addEventListener('input', updateAllCalculations);
	document.getElementById('input-wedding-date').addEventListener('input', updateAllCalculations);
	document.getElementById('select-mc-style').addEventListener('change', updateAllCalculations);
	document.getElementById('select-guest-requests').addEventListener('change', updateAllCalculations);
	document.getElementById('input-audio-notes').addEventListener('input', updateAllCalculations);

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const coupleNames = document.getElementById('input-couple-names').value.trim() || 'Lucía & Carlos';
		const weddingDate = document.getElementById('input-wedding-date').value.trim() || '12 de Septiembre';
		const mcStyle = document.getElementById('select-mc-style').value;
		const reqPolicy = document.getElementById('select-guest-requests').value;
		const audioNotes = document.getElementById('input-audio-notes').value.trim() || 'Sin notas especiales.';

		let specialRowsDoc = '';
		specialMomentConfigs.forEach(m => {
			const t = document.getElementById(`special-title-${m.id}`)?.value || m.defaultTitle;
			const a = document.getElementById(`special-artist-${m.id}`)?.value || m.defaultArtist;
			const c = document.getElementById(`special-cue-${m.id}`)?.value || m.defaultCue;
			specialRowsDoc += `
				<tr>
					<td style="padding:6pt; border:1pt solid #cbd5e1; font-weight:bold;">${m.label}</td>
					<td style="padding:6pt; border:1pt solid #cbd5e1; color:#1e40af; font-weight:bold;">${t}</td>
					<td style="padding:6pt; border:1pt solid #cbd5e1;">${a}</td>
					<td style="padding:6pt; border:1pt solid #cbd5e1; font-style:italic;">${c}</td>
				</tr>
			`;
		});

		let mustDoc = '<ol>';
		mustPlayList.forEach(m => {
			mustDoc += `<li><strong>${m.title}</strong> — ${m.artist} [${m.phase}]</li>`;
		});
		mustDoc += '</ol>';

		const checkedGenres = Array.from(document.querySelectorAll('.chk-banned-genre:checked')).map(c => c.value);
		let banDoc = '<ul>';
		if (checkedGenres.length > 0) banDoc += `<li><strong>Géneros Prohibidos:</strong> ${checkedGenres.join(', ')}</li>`;
		bannedSongsList.forEach(b => {
			banDoc += `<li><strong>${b.song}</strong> ${b.reason ? `(${b.reason})` : ''}</li>`;
		});
		banDoc += '</ul>';

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Ficha Técnica Musical para DJ — ${coupleNames}</title>
				<style>
					body { font-family: 'Segoe UI', Calibri, Arial, sans-serif; padding: 25pt; font-size: 11pt; color: #1e293b; }
					h1 { color: #0f172a; font-size: 20pt; margin-bottom: 4pt; border-bottom: 2pt solid #0f172a; padding-bottom: 4pt; }
					h2 { color: #1e40af; font-size: 14pt; margin-top: 18pt; margin-bottom: 6pt; border-bottom: 1pt solid #94a3b8; padding-bottom: 2pt; }
					.meta-box { background: #f8fafc; border: 1pt solid #cbd5e1; padding: 10pt; margin-bottom: 15pt; border-radius: 4pt; }
					table { width: 100%; border-collapse: collapse; margin-bottom: 15pt; }
					th { background: #e2e8f0; padding: 6pt; border: 1pt solid #cbd5e1; text-align: left; }
				</style>
			</head>
			<body>
				<h1>Ficha Técnica y Musical para DJ de Boda</h1>
				<div class="meta-box">
					<strong>Pareja:</strong> ${coupleNames} | 
					<strong>Fecha y Finca:</strong> ${weddingDate}<br/>
					<strong>Duración Total:</strong> ${displayTotalRuntime.textContent} | 
					<strong>Canciones Estimadas:</strong> ${displayExactTracks.textContent} (Lista recomendada: ${displayBufferedTracks.textContent})<br/>
					<strong>Estilo de Animación:</strong> ${mcStyle}<br/>
					<strong>Política de Peticiones:</strong> ${reqPolicy}
				</div>

				<h2>1. Momentos Clave e Instrucciones de Audio</h2>
				<table>
					<thead>
						<tr>
							<th style="width:25%;">Momento</th>
							<th style="width:25%;">Canción</th>
							<th style="width:20%;">Artista</th>
							<th style="width:30%;">Instrucciones de Corte</th>
						</tr>
					</thead>
					<tbody>
						${specialRowsDoc}
					</tbody>
				</table>

				<h2>2. Canciones Imprescindibles (${mustPlayList.length})</h2>
				${mustDoc}

				<h2>3. Lista Negra / Canciones Vetadas</h2>
				${banDoc}

				<h2>4. Notas Técnicas y Montaje de Sonido</h2>
				<p>${audioNotes}</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Ficha_DJ_Boda_${coupleNames.replace(/[^a-zA-Z0-9]/g, '_')}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Categoría,Fase o Momento,Canción,Artista,Notas de Corte\n";
		
		specialMomentConfigs.forEach(m => {
			const t = (document.getElementById(`special-title-${m.id}`)?.value || m.defaultTitle).replace(/"/g, '""');
			const a = (document.getElementById(`special-artist-${m.id}`)?.value || m.defaultArtist).replace(/"/g, '""');
			const c = (document.getElementById(`special-cue-${m.id}`)?.value || m.defaultCue).replace(/"/g, '""');
			csv += `"Momento Especial","${m.label.replace(/"/g, '""')}","${t}","${a}","${c}"\n`;
		});

		mustPlayList.forEach(item => {
			csv += `"Imprescindible","${item.phase.replace(/"/g, '""')}","${item.title.replace(/"/g, '""')}","${item.artist.replace(/"/g, '""')}","Tema prioritario"\n`;
		});

		bannedSongsList.forEach(item => {
			csv += `"Lista Negra","Vetada","${item.song.replace(/"/g, '""')}","Prohibida","${item.reason.replace(/"/g, '""')}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Lista_Musica_Boda.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-copy-clipboard').addEventListener('click', () => {
		const coupleNames = document.getElementById('input-couple-names').value.trim() || 'Lucía & Carlos';
		const weddingDate = document.getElementById('input-wedding-date').value.trim() || '12 de Septiembre';
		const mcStyle = document.getElementById('select-mc-style').value;
		const reqPolicy = document.getElementById('select-guest-requests').value;

		let summary = `FICHA TÉCNICA Y MUSICAL PARA DJ DE BODA\n`;
		summary += `=======================================\n`;
		summary += `Pareja: ${coupleNames}\n`;
		summary += `Fecha: ${weddingDate}\n`;
		summary += `Duración: ${displayTotalRuntime.textContent}\n`;
		summary += `Animación: ${mcStyle}\n`;
		summary += `Peticiones: ${reqPolicy}\n\n`;

		summary += `MOMENTOS ESPECIALES:\n`;
		specialMomentConfigs.forEach(m => {
			const t = document.getElementById(`special-title-${m.id}`)?.value || m.defaultTitle;
			const a = document.getElementById(`special-artist-${m.id}`)?.value || m.defaultArtist;
			const c = document.getElementById(`special-cue-${m.id}`)?.value || m.defaultCue;
			summary += `- ${m.label.split('. ')[1]}: "${t}" de ${a} (Corte: ${c})\n`;
		});

		summary += `\nIMPRESCINDIBLES (${mustPlayList.length}):\n`;
		mustPlayList.forEach((m, idx) => {
			summary += `${idx + 1}. "${m.title}" de ${m.artist} [${m.phase}]\n`;
		});

		const checkedGenres = Array.from(document.querySelectorAll('.chk-banned-genre:checked')).map(c => c.value);
		summary += `\nLISTA NEGRA / VETADAS:\n`;
		if (checkedGenres.length > 0) summary += `- Géneros Vetados: ${checkedGenres.join(', ')}\n`;
		bannedSongsList.forEach(b => {
			summary += `- "${b.song}" (${b.reason || 'Vetada'})\n`;
		});

		navigator.clipboard.writeText(summary).then(() => {
			const btn = document.getElementById('btn-copy-clipboard');
			const orig = btn.textContent;
			btn.textContent = '✅ ¡Copiado al Portapapeles!';
			setTimeout(() => { btn.textContent = orig; }, 2000);
		});
	});

	renderSpecialMoments();
	renderMustPlayList();
	renderBlacklist();
	updateAllCalculations();
</script>
