		let html = '<table style="width:100%; border-collapse:collapse; font-size:0.85rem; text-align:left;">';
		html += '<thead><tr style="border-bottom:1.5px solid var(--fg-pencil); color:var(--fg-pencil); font-family:var(--font-heading);"><th style="padding:4px;">#</th><th style="padding:4px;">Título</th><th style="padding:4px;">Artista</th><th style="padding:4px;">Fase</th><th style="padding:4px; text-align:right;">Quitar</th></tr></thead><tbody>';
		
		mustPlayList.forEach((item, idx) => {
			html += `
				<tr style="border-bottom: 1px solid #e2e8f0;">
					<td style="padding: 4px; font-weight: 700; color: #16a34a;">${idx + 1}</td>
					<td style="padding: 4px; font-weight: 600;">${item.title}</td>
					<td style="padding: 4px; color: var(--text-secondary);">${item.artist}</td>
					<td style="padding: 4px;"><span style="background:#e0f2fe; color:#0369a1; padding:2px 6px; border-radius:3px; font-size:0.75rem;">${item.phase}</span></td>
					<td style="padding: 4px; text-align: right;">
						<button type="button" class="btn-del-must" data-index="${idx}" style="background:none; border:none; color:var(--accent-red); cursor:pointer; font-weight:bold; font-size:0.9rem;">✕</button>
					</td>
				</tr>
			`;
		});
		html += '</tbody></table>';
		listContainer.innerHTML = html;

		document.querySelectorAll('.btn-del-must').forEach(btn => {
			btn.addEventListener('click', () => {
				const idx = parseInt(btn.getAttribute('data-index'));
				mustPlayList.splice(idx, 1);
				renderMustPlayList();
				updateAllCalculations();
			});
		});
	}

	function renderBlacklist() {
		const listContainer = document.getElementById('blacklist-songs-list');
