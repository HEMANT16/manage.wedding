<script is:inline>
	const sampleTemplates = {
		bestman: `¡Buenas noches a todos! Para quienes no me conozcan, soy Alejandro, y he tenido el enorme privilegio (y algún que otro dolor de cabeza) de ser el mejor amigo del novio desde nuestros años de universidad.

Cuando lo conocí, me confesó que sus tres grandes metas en la vida eran triunfar en su trabajo, aprender a cocinar algo que no fuera pasta con tomate y encontrar a una mujer inteligente, brillante y con la paciencia suficiente para aguantar sus manías. Bueno, viendo a la espectacular novia esta noche, ¡creo que al menos ha acertado en la más importante! [Pausa para risas]

Ya en serio, ver cómo os miráis es una auténtica inspiración. Aportas una serenidad, una alegría y una luz en él que jamás le había visto. Hacéis un equipo insuperable.

Por favor, alzad vuestras copas conmigo: ¡Por una vida repleta de risas, aventuras compartidas y amor incondicional! ¡Por los recién casados! ¡Salud!`,

		moh: `¡Hola a todos! Soy Laura, la hermana de la novia. Mirándola esta noche, no puedo evitar emocionarme al ver lo radiante, feliz y deslumbrante que está.

De pequeñas lo compartíamos todo: la ropa, confidencias hasta las tantas y sueños sobre cómo sería este día. Cuando me llamó tras su segunda cita con el novio, no me dijo simplemente que se lo había pasado bien; me dijo: 'Laura, creo que acabo de conocer al hombre con el que me voy a casar'. [Pausa para sonrisas]

A mi cuñado: gracias por cuidarla y quererla como se merece cada día. Verte así de feliz es el mayor regalo para toda la familia.

¡Alcemos las copas por un matrimonio lleno de complicidad, risas y momentos inolvidables! ¡Vivan los novios!`,

		parent: `¡Bienvenidos a todos, familiares y amigos! En nombre de nuestras familias, queremos agradeceros de corazón que hayáis venido desde tan cerca y tan lejos para celebrar con nosotros este día tan especial.

Ver crecer a nuestra hija hasta convertirse en la mujer generosa, valiente y maravillosa que tenemos delante ha sido la mayor alegría de nuestras vidas. Y dar hoy la bienvenida a su marido a nuestra familia se siente como colocar la última pieza perfecta del puzle.

El matrimonio es una decisión diaria de quererse, perdonarse, apoyarse y reír juntos en cada etapa. No olvidéis nunca la ilusión con la que os habéis mirado hoy.

¡Brindemos por su felicidad, salud y un futuro maravilloso juntos! ¡Salud!`,

		couple: `Solo queremos robaros un minuto para daros las gracias de todo corazón a cada una de las personas que estáis hoy aquí. Mirar alrededor y ver a toda nuestra gente favorita junta en un mismo lugar es algo verdaderamente mágico.

A nuestros padres: gracias por vuestro amor incondicional, por vuestro ejemplo y por estar siempre a nuestro lado. No estaríamos aquí sin vosotros.

Y a nuestros amigos y testigos: gracias por arroparnos y hacer de este día una fiesta inolvidable.

Ahora, ¡se acabaron los discursos! La barra libre está abierta y la música lista, así que... ¡a darlo todo en la pista de baile! ¡Muchas gracias a todos! [Brindis]`
	};

	const speechEditor = document.getElementById('speech-editor');
	const paceSelect = document.getElementById('select-speaking-pace');
	const bufferSelect = document.getElementById('select-pause-buffer');
	const displayWpmRate = document.getElementById('display-wpm-rate');

	const displayTimeResult = document.getElementById('display-time-result');
	const displaySpeechZone = document.getElementById('display-speech-zone');
	const displayWordCount = document.getElementById('display-word-count');
	const displayParagraphCount = document.getElementById('display-paragraph-count');
	const displayCardsCount = document.getElementById('display-cards-count');
	const speechGaugeBar = document.getElementById('speech-gauge-bar');

	function calculateStats() {
		const text = speechEditor.value.trim();
		const wpm = parseInt(paceSelect.value) || 130;
		const bufferSec = parseInt(bufferSelect.value) || 30;

		displayWpmRate.textContent = wpm;

		let words = 0;
		let paragraphs = 0;

		if (text.length > 0) {
			words = text.split(/\s+/).filter(w => w.length > 0).length;
			paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0).length;
		}

		displayWordCount.textContent = words;
		displayParagraphCount.textContent = paragraphs;

		const estimatedCards = Math.max(1, Math.ceil(words / 150));
		displayCardsCount.textContent = `${estimatedCards} Ficha${estimatedCards !== 1 ? 's' : ''}`;

		let totalSeconds = 0;
		if (words > 0) {
			totalSeconds = Math.round((words / wpm) * 60) + bufferSec;
		}

		const mins = Math.floor(totalSeconds / 60);
		const secs = totalSeconds % 60;
		displayTimeResult.textContent = `${mins} min ${secs} seg`;

		const totalMins = totalSeconds / 60;
		const pct = Math.min(100, Math.max(5, (totalMins / 8) * 100));
		speechGaugeBar.style.width = `${words === 0 ? 0 : pct}%`;

		if (words === 0) {
			displaySpeechZone.textContent = "Escribe tu texto o carga una plantilla";
			displaySpeechZone.style.color = "var(--text-secondary)";
			speechGaugeBar.style.backgroundColor = "#ccc";
		} else if (totalMins < 2.5) {
			displaySpeechZone.textContent = "⚡ Breve y Rápido (Puedes añadir 1 anécdota)";
			displaySpeechZone.style.color = "var(--accent-blue)";
			speechGaugeBar.style.backgroundColor = "var(--accent-blue)";
		} else if (totalMins >= 2.5 && totalMins <= 5.5) {
			displaySpeechZone.textContent = "✅ Duración Perfecta (Ideal para no aburrir)";
			displaySpeechZone.style.color = "#15803d";
			speechGaugeBar.style.backgroundColor = "#16a34a";
		} else if (totalMins > 5.5 && totalMins <= 7.0) {
			displaySpeechZone.textContent = "⚠️ Algo Largo (Recorta detalles menores)";
			displaySpeechZone.style.color = "#ca8a04";
			speechGaugeBar.style.backgroundColor = "#eab308";
		} else {
			displaySpeechZone.textContent = "🛑 Demasiado Largo (Recorta un 30% para no enfriar el banquete)";
			displaySpeechZone.style.color = "var(--accent-red)";
			speechGaugeBar.style.backgroundColor = "var(--accent-red)";
		}
	}

	document.querySelectorAll('.btn-load-template').forEach(btn => {
		btn.addEventListener('click', () => {
			const type = btn.getAttribute('data-type');
			if (sampleTemplates[type]) {
				speechEditor.value = sampleTemplates[type];
				calculateStats();
			}
		});
	});

	document.getElementById('btn-clear-speech').addEventListener('click', () => {
		speechEditor.value = '';
		calculateStats();
	});

	speechEditor.addEventListener('input', calculateStats);
	paceSelect.addEventListener('change', calculateStats);
	bufferSelect.addEventListener('change', calculateStats);

	let timerInterval = null;
	let startTime = 0;
	let elapsedTime = 0;
	let isRunning = false;

	const stopwatchDisplay = document.getElementById('stopwatch-display');
	const btnTimerStart = document.getElementById('btn-timer-start');
	const btnTimerPause = document.getElementById('btn-timer-pause');
	const btnTimerReset = document.getElementById('btn-timer-reset');

	function formatStopwatch(ms) {
		const totalSec = Math.floor(ms / 1000);
		const m = Math.floor(totalSec / 60).toString().padStart(2, '0');
		const s = (totalSec % 60).toString().padStart(2, '0');
		const tenth = Math.floor((ms % 1000) / 100);
		return `${m}:${s}.${tenth}`;
	}

	btnTimerStart.addEventListener('click', () => {
		if (!isRunning) {
			isRunning = true;
			startTime = Date.now() - elapsedTime;
			timerInterval = setInterval(() => {
				elapsedTime = Date.now() - startTime;
				stopwatchDisplay.textContent = formatStopwatch(elapsedTime);
			}, 100);
			btnTimerStart.style.display = 'none';
			btnTimerPause.style.display = 'inline-block';
		}
	});

	btnTimerPause.addEventListener('click', () => {
		if (isRunning) {
			isRunning = false;
			clearInterval(timerInterval);
			btnTimerStart.style.display = 'inline-block';
			btnTimerStart.textContent = '▶️ Reanudar';
			btnTimerPause.style.display = 'none';
		}
	});

	btnTimerReset.addEventListener('click', () => {
		isRunning = false;
		clearInterval(timerInterval);
		elapsedTime = 0;
		stopwatchDisplay.textContent = '00:00.0';
		btnTimerStart.style.display = 'inline-block';
		btnTimerStart.textContent = '▶️ Empezar Ensayo';
		btnTimerPause.style.display = 'none';
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const text = speechEditor.value.trim() || 'Sin texto de discurso introducido.';
		const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);

		let pTags = '';
		paragraphs.forEach((p, idx) => {
			pTags += `<p style="font-size:16pt; line-height:1.7; margin-bottom:18pt; color:#111;"><strong>[${idx + 1}]</strong> ${p}</p>`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Guion para Discurso de Boda</title>
				<style>
					body { font-family: 'Segoe UI', Calibri, Arial, sans-serif; padding: 30px; font-size: 16pt; }
					h1 { color: #1e3a8a; font-size: 22pt; margin-bottom: 5pt; }
					.meta-box { border: 1pt solid #ccc; background: #f8fafc; padding: 10pt; font-size: 11pt; margin-bottom: 25pt; color: #475569; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Guion para Atril de Discurso</h1>
				<div class="meta-box">
					<strong>Tiempo Estimado:</strong> ${displayTimeResult.textContent} | 
					<strong>Palabras:</strong> ${displayWordCount.textContent} palabras | 
					<strong>Ritmo:</strong> ${displayWpmRate.textContent} PPM
				</div>
				${pTags}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Discurso_Boda_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-est-time').textContent = displayTimeResult.textContent;
		document.getElementById('print-word-count').textContent = `${displayWordCount.textContent} palabras`;

		const grid = document.getElementById('print-cue-cards-grid');
		grid.innerHTML = '';

		const text = speechEditor.value.trim() || 'Sin texto de discurso.';
		const paragraphs = text.split(/\n+/).filter(p => p.trim().length > 0);

		for (let i = 0; i < paragraphs.length; i += 2) {
			const cardNum = Math.floor(i / 2) + 1;
			const totalCards = Math.ceil(paragraphs.length / 2);

			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 25px; page-break-inside: avoid; font-family: 'Times New Roman', serif; background: #fff; margin-bottom: 20px;`;
			
			let inner = `<div style="display:flex; justify-content:space-between; border-bottom:1px solid #000; padding-bottom:5px; margin-bottom:15px; font-size:12px; font-weight:bold;"><span>FICHA ${cardNum} DE ${totalCards}</span><span>TIEMPO ESTIMADO: ${displayTimeResult.textContent}</span></div>`;
			
			inner += `<p style="font-size:16px; line-height:1.6; margin-bottom:12px;"><strong>[${i + 1}]</strong> ${paragraphs[i]}</p>`;
			if (paragraphs[i + 1]) {
				inner += `<p style="font-size:16px; line-height:1.6; margin-bottom:0;"><strong>[${i + 2}]</strong> ${paragraphs[i + 1]}</p>`;
			}

			card.innerHTML = inner;
			grid.appendChild(card);
		}

		window.print();
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Métrica,Valor\n";
		csv += `"Tiempo Estimado","${displayTimeResult.textContent}"\n`;
		csv += `"Número de Palabras","${displayWordCount.textContent}"\n`;
		csv += `"Párrafos","${displayParagraphCount.textContent}"\n`;
		csv += `"Ritmo de Lectura","${displayWpmRate.textContent} PPM"\n`;
		csv += `"Valoración","${displaySpeechZone.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Metricas_Discurso_Boda.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	speechEditor.value = sampleTemplates.bestman;
	calculateStats();
</script>
