---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-loan-calculator/#webapp",
      "name": "Simulador de Préstamos de Boda y Cuadro de Amortización",
      "url": "https://manage.wedding/es/wedding-loan-calculator",
      "inLanguage": "es",
      "description": "Calculadora gratuita de préstamos para bodas: calcula la cuota mensual, intereses totales (TIN/TAE), comisión de apertura y cuadro de amortización completo con exportación a Word, PDF y Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular las Cuotas y Amortización de un Préstamo de Boda",
      "description": "Guía paso a paso para simular cuotas mensuales, intereses y plazos de amortización para financiar los gastos de la boda.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Calcula tu Déficit Financiero Real",
          "text": "Resta tus ahorros confirmados y regalos familiares del presupuesto total para solicitar únicamente la cantidad imprescindible."
        },
        {
          "@type": "HowToStep",
          "name": "Introduce el Importe y el Tipo de Interés (TAE %)",
          "text": "Indica el capital a financiar y el tipo de interés anual ofertado por la entidad bancaria (habitualmente entre un 6% y un 12%)."
        },
        {
          "@type": "HowToStep",
          "name": "Selecciona el Plazo de Devolución",
          "text": "Elige un plazo de 12 a 60 meses para equilibrar una cuota mensual asumible con el total de intereses generados."
        },
        {
          "@type": "HowToStep",
          "name": "Simula Amortizaciones Anticipadas",
          "text": "Comprueba cuánto tiempo e intereses ahorras aportando cantidades extra cada mes o amortizando con los regalos tras la boda."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuál es el tipo de interés medio (TAE) para un préstamo personal de boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En España y Europa, los préstamos personales suelen oscilar entre el 6,5% y el 11% TAE para solicitantes con solvencia y contrato indefinido. Es fundamental comparar ofertas en varias entidades antes de firmar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es aconsejable pedir un préstamo para pagar la boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los expertos financieros recomiendan financiar la boda con ahorros previos y los regalos de los invitados para no iniciar el matrimonio con deudas. Sin embargo, un crédito personal puntual a corto plazo (12 a 24 meses) puede servir de puente para pagar fianzas iniciales de proveedores."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo reduce los intereses hacer pagos extraordinarios?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aportar solo 50€ o 100€ adicionales al mes al capital principal reduce de inmediato la base sobre la que se calculan los intereses, permitiendo liquidar el préstamo meses antes y ahorrando cientos de euros."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo exportar el cuadro de amortización mes a mes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Puedes descargar el calendario completo con el desglose mensual de capital e intereses en formato Word (.doc), PDF para imprimir o tabla Excel (.csv)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Simulador de Préstamos para Bodas (Cuota Mensual y Amortización) | Manage.Wedding"
	description="Calcula la cuota mensual, intereses y cuadro de amortización de préstamos para bodas. Simula amortizaciones anticipadas y exporta a Word, PDF y Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Simulador de Préstamo de Boda" category="budget-finance" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Simulador de <span class="accent-italic">Préstamos para Bodas</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calcula tu cuota mensual, el total de intereses y el calendario de devolución. Simula amortizaciones extra, comisiones de apertura y exporta tu <strong>Cuadro de Amortización</strong> a <strong>Word</strong> o <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Cómo Simular tu Financiación en 3 Sencillos Pasos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Indica Capital y Tipo de Interés (TAE)
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Introduce la cantidad que necesitas financiar y el tipo de interés anual, o elige una de las opciones preconfiguradas.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Ajusta Plazo y Pagos Extra
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Elige el plazo (de 12 a 60 meses) y desliza la cuota extra para comprobar cuántos intereses y meses de deuda te ahorras.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Descarga el Cuadro de Amortización
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Haz clic en <strong>"📝 Exportar a Word"</strong> o <strong>"🖨️ Imprimir PDF"</strong> para obtener el plan detallado mes a mes.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="loan-calc-grid">
			
			<!-- Left Column: Input Form & Presets -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div style="width: 100%;">
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							🏦 Condiciones del Préstamo
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Configura el capital, tipo de interés, plazo y comisiones
						</span>
					</div>
				</div>

				<!-- Quick Presets -->
				<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; text-align: center;">
					<span class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.4rem; text-align: center;">
						⚡ Opciones Habituales de Financiación:
					</span>
					<div style="display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center;">
						<button type="button" class="loan-preset-btn" data-amt="5000" data-apr="7.5" data-term="24">💵 5.000 € (24 meses • 7,5%)</button>
						<button type="button" class="loan-preset-btn active-preset" data-amt="12000" data-apr="8.5" data-term="36">💳 12.000 € (36 meses • 8,5%)</button>
						<button type="button" class="loan-preset-btn" data-amt="20000" data-apr="9.5" data-term="48">💎 20.000 € (48 meses • 9,5%)</button>
						<button type="button" class="loan-preset-btn" data-amt="30000" data-apr="10.5" data-term="60">👑 30.000 € (60 meses • 10,5%)</button>
					</div>
				</div>

				<form id="loan-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Loan Amount & Currency -->
					<div style="display: grid; grid-template-columns: 1.4fr 0.8fr; gap: 0.75rem;">
						<div>
							<label for="input-loan-amount" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Capital a Solicitar (€) *
							</label>
							<div style="display: flex; align-items: center; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; overflow: hidden;">
								<span id="currency-symbol-display" style="padding: 0.55rem 0.75rem; background: var(--bg-paper); border-right: 1px solid var(--fg-pencil); font-weight: bold; font-family: var(--font-heading);">€</span>
								<input type="number" id="input-loan-amount" value="12000" min="500" max="150000" step="500" required style="flex: 1; border: none; padding: 0.55rem; font-family: var(--font-body); font-size: 1.1rem; font-weight: bold; outline: none; background: transparent;">
							</div>
						</div>

						<div>
							<label for="currency-select" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Moneda
							</label>
							<select id="currency-select" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
								<option value="€" selected>€ (EUR)</option>
								<option value="$">$ (USD/CAD/AUD)</option>
								<option value="£">£ (GBP)</option>
								<option value="₹">₹ (INR)</option>
							</select>
						</div>
					</div>

					<!-- APR % & Term Months -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-apr" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Tipo de Interés (TAE %) *
							</label>
							<div style="display: flex; align-items: center; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; overflow: hidden;">
								<input type="number" id="input-apr" value="8.5" min="0" max="36" step="0.25" required style="flex: 1; border: none; padding: 0.55rem; font-family: var(--font-body); font-size: 1.1rem; outline: none; background: transparent;">
								<span style="padding: 0.55rem 0.75rem; background: var(--bg-paper); border-left: 1px solid var(--fg-pencil); font-weight: bold;">%</span>
							</div>
						</div>

						<div>
							<label for="select-loan-term" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Plazo de Amortización
							</label>
							<select id="select-loan-term" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
								<option value="12">12 Meses (1 Año)</option>
								<option value="24">24 Meses (2 Años)</option>
								<option value="36" selected>36 Meses (3 Años)</option>
								<option value="48">48 Meses (4 Años)</option>
								<option value="60">60 Meses (5 Años)</option>
							</select>
						</div>
					</div>

					<!-- Origination Fee & Extra Monthly Payment -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-origination-pct" class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil);">
									Comisión de Apertura (%)
								</label>
								<span id="origination-fee-display" style="font-size: 0.8rem; color: var(--accent-red); font-weight: bold;">0 €</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.5rem;">
								<input type="range" id="input-origination-pct" min="0" max="8" step="0.5" value="0" style="flex: 1; accent-color: var(--fg-pencil);">
								<span id="origination-pct-label" style="font-size: 0.85rem; font-weight: bold; width: 35px;">0%</span>
							</div>
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-extra-payment" class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil);">
									Amortización Mensual Extra (Capital)
								</label>
								<span id="extra-payment-display" style="font-size: 0.85rem; color: var(--accent-blue); font-weight: bold;">+0 €/mes</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.5rem;">
								<input type="range" id="input-extra-payment" min="0" max="500" step="25" value="0" style="flex: 1; accent-color: var(--accent-blue);">
								<span id="extra-payment-label" style="font-size: 0.85rem; font-weight: bold; width: 45px;">0 €</span>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Surcharge Comparison -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Monthly Payment Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								💳 Cuota Mensual Estimada
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Capital + Intereses al mes
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar a Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimir PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Monthly Payment Highlight -->
					<div style="background: #eff6ff; border: 2.5px solid var(--accent-blue); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-blue); display: block; font-weight: bold;">Cuota Mensual a Pagar</span>
						<strong id="res-monthly-payment" class="font-heading" style="font-size: 2.6rem; color: var(--accent-blue); display: block; line-height: 1.2;">378,81 €</strong>
						<span id="res-term-note" style="font-size: 0.8rem; color: var(--accent-blue);">Durante 36 Meses al 8,5% TAE</span>
					</div>

					<!-- Line-Item Totals Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Coste Total de la Financiación
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">💵 Capital Solicitado:</td>
									<td id="res-principal-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">12.000,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-red);">
									<td style="padding: 0.4rem 0;">📈 Total Intereses Generados:</td>
									<td id="res-interest-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.637,16 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🏷️ Comisión de Apertura:</td>
									<td id="res-origination-fee" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">0,00 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa; font-size: 1.05rem;">
									<td style="padding: 0.45rem 0; font-weight: bold;">Total a Devolver:</td>
									<td id="res-grand-total-paid" style="padding: 0.45rem 0; text-align: right; font-weight: bold; color: var(--accent-red);">13.637,16 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Principal vs Interest Visual Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span style="color: var(--accent-blue);">Capital (<span id="bar-principal-pct">88%</span>)</span>
							<span style="color: var(--accent-red);">Intereses (<span id="bar-interest-pct">12%</span>)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-principal" style="width: 88%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-interest" style="width: 12%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Extra Payment Interest Savings Alert Card -->
				<div id="extra-savings-card" class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil); display: none;">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						🎉 ¡Ahorro por Amortización Extra!
					</strong>
					<p id="extra-savings-text" class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; color: var(--fg-pencil); text-align: center;">
						Al aportar capital extra cada mes, ahorras intereses y liquidas tu préstamo antes de tiempo.
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Cuadro de Amortización del Préstamo de Boda</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado el: <span id="print-date"></span> | Capital: <span id="print-principal"></span> | Cuota Mensual: <span id="print-monthly"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 5px; text-align: center;">Mes</th>
						<th style="border: 1px solid #ccc; padding: 5px; text-align: right;">Cuota</th>
						<th style="border: 1px solid #ccc; padding: 5px; text-align: right;">Capital Amortizado</th>
						<th style="border: 1px solid #ccc; padding: 5px; text-align: right;">Intereses</th>
						<th style="border: 1px solid #ccc; padding: 5px; text-align: right;">Capital Pendiente</th>
					</tr>
				</thead>
				<tbody id="print-schedule-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 2.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="text-align: center; margin-bottom: 1.25rem;">
