---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/seating-clearance-calculator/#webapp",
      "name": "Calculadora de Espacio de Salón, Pista de Baile y Pasillos de Boda",
      "url": "https://manage.wedding/es/seating-clearance-calculator",
      "inLanguage": "es",
      "description": "Calcula las dimensiones exactas de la pista de baile, mesas redondas de 150 y 180 cm, separación de pasillos de servicio y metros cuadrados (m²) necesarios para el banquete nupcial.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular el Tamaño de la Pista de Baile y Metros Cuadrados del Salón",
      "description": "Fórmula paso a paso para dimensionar la pista de baile y el espacio total de banquete para una boda.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Estima los Bailarines Simultáneos (Regla del 40-45%)",
          "text": "Multiplica el número total de invitados por 45% (0,45) para prever el pico máximo de personas en la pista de baile."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Calcula la Pista de Baile en Metros Cuadrados",
          "text": "Asigna 0,45 m² por persona bailando (ej. 68 bailarines × 0,45 m² = 30 m², aproximadamente 5 × 6 metros)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Asigna el Espacio de Mesas y Pasillos (1,3–1,5 m² por comensal)",
          "text": "Para mesas redondas de 150 cm con 8 comensales, calcula 1,4 m² por invitado incluyendo el pasillo de 1,5 metros entre mesas."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Suma Barras, Buffet y Escenario",
          "text": "Añade superficie extra para la cabina del DJ o escenario (15–25 m²), barras de bebida (15–20 m² cada una) y mesa presidencial."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué tamaño de pista de baile se necesita para 100 a 150 invitados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para 100 invitados, se recomienda una pista de baile de unos 20 a 25 m² (aprox. 4,5 × 5 metros). Para 150 invitados, la pista ideal oscila entre 28 y 35 m² (aprox. 5 × 6 metros o 30 a 35 losetas modulares de 1×1 m)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto espacio debe dejarse entre mesa y mesa en un banquete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La regla de oro de la hostelería exige dejar un mínimo de 150 cm (1,5 metros) de borde a borde entre mesas. Esto permite a los comensales levantarse con comodidad y deja un pasillo libre para que los camareros sirvan los platos con seguridad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos metros cuadrados totales se necesitan por invitado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para un banquete sentado con cóctel, pista de baile y barras libres, se recomienda entre 1,6 y 2,0 m² por comensal. Una boda de 150 invitados requiere un salón o carpa de entre 250 y 300 m² útiles."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Espacio de Salón, Pista de Baile y Pasillos de Boda | Manage.Wedding"
	description="Calcula los metros cuadrados (m²) necesarios para el salón de boda, dimensiones de la pista de baile y número de mesas redondas para 50 a 300 comensales."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Espacio de Salón y Pista de Baile" category="guests-logistics" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Aforo del Salón y Pista de Baile</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Espacio de Salón y <span class="accent-italic">Pista de Baile</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcula las dimensiones ideales de la pista de baile, número de mesas redondas de 150 y 180 cm, pasillos de 1,5 metros y metros cuadrados totales antes de contratar la finca.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Guest Count, Table Style & Room Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Escala del Evento y Salón
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Normativa de Pasillos
					</span>
				</div>

				<!-- Venue Layout Presets -->
				<div class="form-group">
					<label class="form-label" for="layout-preset">Espacio o Finca Tipo</label>
					<select id="layout-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="ballroom-150" selected>🏨 Salón de Finca / Hotel (150 Invitados / Redondas 150 cm / DJ)</option>
						<option value="tent-200">🎪 Carpa Exterior de Boda (200 Invitados / 12×25 m / Escenario Banda)</option>
						<option value="barn-120">🌾 Finca Rústica / Cortijo (120 Invitados / Mesas Imperiales de Madera)</option>
						<option value="intimate-75">🏛️ Palacete / Banquete Íntimo (75 Invitados)</option>
						<option value="custom">✏️ Personalizar Medidas e Invitados</option>
					</select>
				</div>

				<!-- Guest Count & Dancing Participation -->
				<div style="display: grid; grid-template-columns: 1.1fr 1.3fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="input-guests">Número de Invitados</label>
						<input type="number" id="input-guests" class="form-input" value="150" min="20" max="600" step="5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
					<div>
						<label class="form-label" for="dance-participation">Ambiente / % Bailarines</label>
						<select id="dance-participation" class="form-input" style="cursor: pointer; font-size: 0.95rem;">
							<option value="0.33">Tranquilo / Mayoría Familiar (33% en pista)</option>
							<option value="0.45" selected>Estándar Muy Animado (45% en pista)</option>
							<option value="0.60">¡Fiesta Total y Joven! (60% en pista)</option>
						</select>
					</div>
				</div>

				<!-- Table Shape & Seating Density -->
				<div class="form-group">
					<label class="form-label" for="table-style">Formato de Mesas del Banquete</label>
					<select id="table-style" class="form-input" style="cursor: pointer;">
						<option value="round-60" selected>Mesas Redondas 150 cm (8 personas cómodas / 9 máx)</option>
						<option value="round-72">Mesas Redondas 180 cm (10 personas cómodas / 11 máx)</option>
						<option value="rect-8ft">Mesas Imperiales / Rectangulares 240 cm (8 personas)</option>
					</select>
				</div>

				<!-- Venue Dimensions (Optional Check) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Dimensiones del Salón Disponible (Opcional)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="room-length" style="font-size: 0.9rem;">Largo del Salón (metros)</label>
							<input type="number" id="room-length" class="form-input" value="18" min="5" step="1" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="room-width" style="font-size: 0.9rem;">Ancho del Salón (metros)</label>
							<input type="number" id="room-width" class="form-input" value="15" min="5" step="1" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Entertainment & Service Buffers -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Estaciones de Servicio y Animación
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-band" style="width: 18px; height: 18px;" />
							<span>Escenario para Música en Directo (20 m²) vs Cabina DJ (10 m²)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-buffet" checked style="width: 18px; height: 18px;" />
							<span>Estaciones de Buffet / Mesa de Postres (15 m²)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-bar-stations" checked style="width: 18px; height: 18px;" />
							<span>Dos Barras Libres de Coctelería (20 m²)</span>
						</label>
					</div>
				</div>

			</div>

			<!-- Right Column: Results, Dance Floor Sizing & Capacity Check -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Clearance & Dance Floor Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Pista de Baile Recomendada
						</span>
						<span id="dance-tile-count-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							30 Losetas Modulares (1×1 m)
						</span>
					</div>

					<div id="display-dance-dimensions" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						5 × 6 m (30 m²)
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Calculada para un pico de <strong id="display-peak-dancers" style="color: var(--fg-pencil);">68 personas bailando</strong> (45% de 150 invitados @ 0,45 m²/persona).
					</p>

					<!-- Itemized Space Breakdown Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<strong style="display: block; font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--fg-pencil);">
							📐 Distribución Completa del Espacio:
						</strong>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span>Banquete y Mesas (<strong id="display-tables-needed">19 Mesas</strong>):</span>
							<strong id="display-dining-sqft">195 m²</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span>Pista de Baile:</span>
							<strong id="display-dance-sqft">30 m²</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span>Barras, Buffet y Música/DJ:</span>
							<strong id="display-production-sqft">45 m²</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.5rem 0 0 0; font-size: 1.05rem; font-weight: 700; color: var(--accent-red);">
							<span>ESPACIO TOTAL MÍNIMO:</span>
							<strong id="display-total-room-needed">270 m²</strong>
						</div>
					</div>

					<!-- Venue Room Fit Evaluation Alert -->
					<div id="room-capacity-alert" style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem; font-size: 0.9rem; color: #166534; line-height: 1.5;">
						<strong id="alert-fit-title">✅ Capacidad Óptima (270 m² disponibles):</strong><br />
						<span id="alert-fit-body">Tu salón de 18 × 15 metros ofrece espacio holgado para 19 mesas, la pista de baile y pasillos cómodos de 1,5 metros para camareros.</span>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-floorplan" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Ficha Técnica (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar a Word (.doc)
						</button>
					</div>

				</div>

				<!-- Table Clearance & ADA Rules Card -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						📏 La Regla de los 1,5 Metros entre Mesas:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>De Borde a Borde:</strong> Deja al menos <strong>1,5 metros (150 cm)</strong> entre mesas redondas para que los comensales se sienten cómodos y los camareros puedan pasar con bandejas calientes.</li>
						<li><strong>Paredes Perimetrales:</strong> Coloca las mesas a <strong>1 metro</strong> de ventanas o muros para evitar agobios.</li>
						<li><strong>Mesa Presidencial:</strong> Sitúala a unos <strong>3 a 4 metros</strong> de la pista de baile para tener visión completa y facilitar las fotos.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Regla Rápida de Salón</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Guía Rápida: Pistas de Baile y Metros Cuadrados por Invitado
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Tabla de referencia rápida que relaciona número de invitados (50 a 300) con medidas de pista y superficie total del salón o carpa.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					🕺 Fórmula Universal de Pista de Baile:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Superficie Pista (m²) = [Invitados × 0,45 (Pico Bailarines)] × 0,45 m² • Superficie Total del Salón = 1,6 a 2,0 m² por comensal.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Invitados</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Pista de Baile</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Losetas (1×1 m)</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Mesas Ø 150 cm</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Salón / Carpa Mínima</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">50 – 75 Invitados</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">4 × 4 m (16 m²)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">16 Losetas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">7 – 10 Mesas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">120 – 150 m²</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">100 – 125 Invitados</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">5 × 5 m (25 m²)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">25 Losetas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">13 – 16 Mesas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">180 – 220 m²</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">150 – 175 Invitados</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">5 × 6 m (30 m²)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">30 Losetas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">19 – 22 Mesas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">250 – 300 m²</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">200 – 250 Invitados</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">6 × 7 m (42 m²)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">42 Losetas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">25 – 32 Mesas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">340 – 420 m²</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/es/seating-clearance-calculator" category="guests" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('layout-preset');
		const guestsInput = document.getElementById('input-guests');
		const dancePartSelect = document.getElementById('dance-participation');
		const tableStyleSelect = document.getElementById('table-style');

		const roomLengthInput = document.getElementById('room-length');
		const roomWidthInput = document.getElementById('room-width');

		const checkBand = document.getElementById('check-band');
		const checkBuffet = document.getElementById('check-buffet');
		const checkBars = document.getElementById('check-bar-stations');

		const danceTileBadge = document.getElementById('dance-tile-count-badge');
		const displayDanceDimensions = document.getElementById('display-dance-dimensions');
		const displayPeakDancers = document.getElementById('display-peak-dancers');

		const displayTablesNeeded = document.getElementById('display-tables-needed');
		const displayDiningSqft = document.getElementById('display-dining-sqft');
		const displayDanceSqft = document.getElementById('display-dance-sqft');
		const displayProductionSqft = document.getElementById('display-production-sqft');
		const displayTotalRoomNeeded = document.getElementById('display-total-room-needed');

		const roomCapacityAlert = document.getElementById('room-capacity-alert');
		const alertFitTitle = document.getElementById('alert-fit-title');
		const alertFitBody = document.getElementById('alert-fit-body');

		const btnPrint = document.getElementById('btn-print-floorplan');
		const btnDoc = document.getElementById('btn-export-doc');

		function calculateFloorPlan() {
			const guests = parseInt(guestsInput.value, 10) || 1;
			const dancerPct = parseFloat(dancePartSelect.value) || 0.45;
			const tableStyle = tableStyleSelect.value;

			// Dance Floor Math in Metric (m²)
			const peakDancers = Math.round(guests * dancerPct);
			const danceM2 = Math.round(peakDancers * 0.45);
			const side = Math.round(Math.sqrt(danceM2));
			const danceL = Math.max(4, side);
			const danceW = Math.max(4, Math.round(danceM2 / danceL));
			const actualDanceM2 = danceL * danceW;
			const tileCount = actualDanceM2; // 1x1 m tiles

			// Table Math
			let seatsPerTable = 8;
			let m2PerGuest = 1.3;
			let tableTypeName = 'Mesas Ø 150 cm';

			if (tableStyle === 'round-60') {
				seatsPerTable = 8;
				m2PerGuest = 1.3;
				tableTypeName = 'Mesas Ø 150 cm (8 personas)';
			} else if (tableStyle === 'round-72') {
				seatsPerTable = 10;
				m2PerGuest = 1.5;
				tableTypeName = 'Mesas Ø 180 cm (10 personas)';
			} else if (tableStyle === 'rect-8ft') {
				seatsPerTable = 8;
				m2PerGuest = 1.2;
				tableTypeName = 'Mesas Imperiales 240 cm (8 personas)';
			}

			const tablesCount = Math.ceil(guests / seatsPerTable);
			const diningM2 = Math.round(guests * m2PerGuest);

			// Production & Buffers
			let productionM2 = 0;
			if (checkBand.checked) productionM2 += 20;
			else productionM2 += 10;

			if (checkBuffet.checked) productionM2 += 15;
			if (checkBars.checked) productionM2 += 20;

			const totalRoomNeeded = diningM2 + actualDanceM2 + productionM2;

			// Room Fit Evaluation
			const rLength = parseFloat(roomLengthInput.value) || 0;
			const rWidth = parseFloat(roomWidthInput.value) || 0;
			const roomAvailableM2 = rLength * rWidth;

			// Update UI
			danceTileBadge.textContent = `${tileCount} Losetas (1×1 m)`;
			displayDanceDimensions.textContent = `${danceL} × ${danceW} m (${actualDanceM2} m²)`;
			displayPeakDancers.textContent = `${peakDancers} personas bailando`;

			displayTablesNeeded.textContent = `${tablesCount} ${tableTypeName}`;
			displayDiningSqft.textContent = `${diningM2.toLocaleString('es-ES')} m²`;
			displayDanceSqft.textContent = `${actualDanceM2.toLocaleString('es-ES')} m²`;
			displayProductionSqft.textContent = `${productionM2.toLocaleString('es-ES')} m²`;
			displayTotalRoomNeeded.textContent = `${totalRoomNeeded.toLocaleString('es-ES')} m²`;

			if (roomAvailableM2 > 0) {
				if (roomAvailableM2 >= totalRoomNeeded) {
					const surplus = roomAvailableM2 - totalRoomNeeded;
					roomCapacityAlert.style.display = 'block';
					roomCapacityAlert.style.background = '#f0fdf4';
					roomCapacityAlert.style.borderColor = '#16a34a';
					roomCapacityAlert.style.color = '#166534';
					alertFitTitle.textContent = `✅ Capacidad Óptima (${roomAvailableM2.toLocaleString('es-ES')} m² disponibles):`;
					alertFitBody.textContent = `Tu espacio de ${rLength} × ${rWidth} metros acoge perfectamente las ${tablesCount} mesas, la pista de baile y deja un margen de ${surplus.toLocaleString('es-ES')} m² para pasillos de servicio y libre circulación.`;
				} else {
					const deficit = totalRoomNeeded - roomAvailableM2;
					roomCapacityAlert.style.display = 'block';
					roomCapacityAlert.style.background = '#fef2f2';
					roomCapacityAlert.style.borderColor = '#ef4444';
					roomCapacityAlert.style.color = '#991b1b';
					alertFitTitle.textContent = `⚠️ Espacio Justo (Faltan ${deficit.toLocaleString('es-ES')} m²):`;
					alertFitBody.textContent = `Tu salón de ${rLength} × ${rWidth} m (${roomAvailableM2.toLocaleString('es-ES')} m²) puede resultar algo apretado. Considera usar mesas de 180 cm (10 personas/mesa) para reducir el número de mesas o ajustar el tamaño de la pista.`;
				}
			} else {
				roomCapacityAlert.style.display = 'none';
			}
		}

		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'ballroom-150') {
				guestsInput.value = 150;
				dancePartSelect.value = '0.45';
				tableStyleSelect.value = 'round-60';
				roomLengthInput.value = 18;
				roomWidthInput.value = 15;
				checkBand.checked = false;
				checkBuffet.checked = true;
				checkBars.checked = true;
			} else if (p === 'tent-200') {
				guestsInput.value = 200;
				dancePartSelect.value = '0.45';
				tableStyleSelect.value = 'round-60';
				roomLengthInput.value = 25;
				roomWidthInput.value = 12;
				checkBand.checked = true;
				checkBuffet.checked = true;
				checkBars.checked = true;
			} else if (p === 'barn-120') {
				guestsInput.value = 120;
				dancePartSelect.value = '0.45';
				tableStyleSelect.value = 'rect-8ft';
				roomLengthInput.value = 18;
				roomWidthInput.value = 12;
				checkBand.checked = false;
				checkBuffet.checked = true;
				checkBars.checked = true;
			} else if (p === 'intimate-75') {
				guestsInput.value = 75;
				dancePartSelect.value = '0.33';
				tableStyleSelect.value = 'round-60';
				roomLengthInput.value = 14;
				roomWidthInput.value = 11;
				checkBand.checked = false;
				checkBuffet.checked = false;
				checkBars.checked = true;
			}
			calculateFloorPlan();
		});

		[guestsInput, dancePartSelect, tableStyleSelect, roomLengthInput, roomWidthInput, checkBand, checkBuffet, checkBars].forEach(inp => {
			inp.addEventListener('input', calculateFloorPlan);
			inp.addEventListener('change', calculateFloorPlan);
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Ficha Técnica del Salón de Boda — Manage.Wedding</title>
					<style>
						@page { size: A4; margin: 15mm; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 20pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Ficha de Distribución de Salón y Pista de Baile</h1>
					<p>Invitados: ${guestsInput.value} | Espacio Mínimo Necesario: ${displayTotalRoomNeeded.textContent}</p>
					
					<table>
						<thead><tr><th>Elemento de Distribución</th><th>Especificaciones</th><th>Superficie</th></tr></thead>
						<tbody>
							<tr><td><strong>Pista de Baile</strong></td><td>${displayDanceDimensions.textContent} (${danceTileBadge.textContent})</td><td>${displayDanceSqft.textContent}</td></tr>
							<tr><td><strong>Zona de Mesas y Comensales</strong></td><td>${displayTablesNeeded.textContent}</td><td>${displayDiningSqft.textContent}</td></tr>
							<tr><td><strong>Barras y Escenario</strong></td><td>Cabina/Banda, Buffet y Barras Libres</td><td>${displayProductionSqft.textContent}</td></tr>
							<tr class="total-row"><td>TOTAL SUPERFICIE MÍNIMA</td><td>—</td><td>${displayTotalRoomNeeded.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Ficha Técnica del Salón de Boda</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Ficha Técnica de Salón y Pista de Baile</h2>
					<p>Invitados: ${guestsInput.value} | <strong>Superficie Total Necesaria: ${displayTotalRoomNeeded.textContent}</strong></p>
					<table>
						<thead><tr><th>Componente</th><th>Detalles</th><th>Superficie</th></tr></thead>
						<tbody>
							<tr><td>Pista de Baile</td><td>${displayDanceDimensions.textContent} (${danceTileBadge.textContent})</td><td>${displayDanceSqft.textContent}</td></tr>
							<tr><td>Mesas del Banquete</td><td>${displayTablesNeeded.textContent}</td><td>${displayDiningSqft.textContent}</td></tr>
							<tr><td>Barras y Música</td><td>Barras, Buffet, Escenario</td><td>${displayProductionSqft.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL</td><td>—</td><td>${displayTotalRoomNeeded.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'ficha-tecnica-salon-boda.doc';
			link.click();
		});

		calculateFloorPlan();
	</script>
</Layout>
