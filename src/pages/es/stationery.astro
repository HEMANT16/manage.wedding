---
import Layout from '../../layouts/Layout.astro';

const title = "Herramientas de Papelería, Invitaciones y Creatividad para Bodas (Gratis)";
const description = "Herramientas gratuitas de papelería nupcial: rotulación de sobres, franqueo postal y sellos de lacre, dimensiones de invitaciones A7/A6 y temporizador de discursos.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/es/stationery/#collection",
      "name": "Herramientas de Papelería, Invitaciones y Creatividad para Bodas",
      "url": "https://manage.wedding/es/stationery",
      "inLanguage": "es",
      "description": "Suite de herramientas para formatear la dirección de sobres, dimensionar invitaciones y tarjetones, calcular sellos de correos y cronometrar discursos de boda.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Rotulación y Caligrafía de Sobres", "url": "https://manage.wedding/es/wedding-envelope-addressing" },
        { "@type": "WebApplication", "name": "Dimensiones de Invitaciones y Tarjetones", "url": "https://manage.wedding/es/wedding-invitation-suite-sizer" },
        { "@type": "WebApplication", "name": "Calculadora de Franqueo Postal y Sellos", "url": "https://manage.wedding/es/wedding-invitation-postage-calculator" },
        { "@type": "WebApplication", "name": "Marcasitios y Tarjetas de Mesa Plegables", "url": "https://manage.wedding/es/table-place-cards" },
        { "@type": "WebApplication", "name": "Generador de Tarjetas de Agradecimiento", "url": "https://manage.wedding/es/wedding-thank-you-cards" },
        { "@type": "WebApplication", "name": "Creador de Invitaciones Digitales", "url": "https://manage.wedding/es/digital-invitations" },
        { "@type": "WebApplication", "name": "Temporizador de Discursos y Brindis", "url": "https://manage.wedding/es/wedding-speech-calculator" },
        { "@type": "WebApplication", "name": "Generador de Hashtags de Boda", "url": "https://manage.wedding/es/wedding-hashtag-generator" },
        { "@type": "WebApplication", "name": "Numerología de la Fecha de Boda", "url": "https://manage.wedding/es/wedding-date-numerology" },
        { "@type": "WebApplication", "name": "Buscador de Aniversarios y Bodas de Plata/Oro", "url": "https://manage.wedding/es/anniversary-gift-finder" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuáles son las medidas estándar para las invitaciones de boda (A7 / A6 / B6)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las medidas estándar más utilizadas son: Tarjetón principal A7 (12,7 × 17,8 cm) con sobre exterior (13,3 × 18,4 cm), o formato europeo A6 (10,5 × 14,8 cm) con sobre C6 (11,4 × 16,2 cm). El tarjetón de confirmación (RSVP) suele medir 9 × 13 cm."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto peso añade un sello de lacre en el sobre de invitación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un sello de lacre tradicional añade entre 4 y 7 gramos de peso al sobre, además de aumentar el grosor total en unos 3 milímetros. Por ello, conviene pesar el conjunto en la oficina de correos para evitar recargos por exceso de peso o clasificación manual."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto debe durar un discurso o brindis de boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La duración ideal para el discurso del padrino, madrina, testigos o novios es de 3 a 5 minutos (aproximadamente entre 400 y 600 palabras a un ritmo conversacional pausado de 120 palabras por minuto). Discursos superiores a 6 minutos tienden a perder la atención de los comensales."
          }
        }
      ]
    }
  ]
};

const stationeryTools = [
  {
    title: "Calculadora de Duración de Playlist",
    url: "/es/wedding-playlist-duration-calculator",
    icon: "🎵",
    badge: "Minutaje Musical",
    desc: "Calcula canciones necesarias por bloque (cóctel, banquete, baile nupcial y fiesta). Incluye cronograma para el DJ y listas 'No Tocar'.",
    tags: ["Música de Boda", "Canciones por Hora", "Guía para el DJ"]
  },

  {
    title: "Rotulación y Caligrafía de Sobres",
    url: "/es/wedding-envelope-addressing",
    icon: "✉️",
    badge: "Etiqueta y Formato",
    desc: "Formatea sobres de invitación con las fórmulas de cortesía adecuadas (Familias, Parejas, Títulos) y exporta en PDF o Word para imprimir.",
    tags: ["Sobres C6 / A7", "Exportar PDF", "Guía de Protocolo"]
  },
  {
    title: "Dimensiones de Invitaciones (A7/A6)",
    url: "/es/wedding-invitation-suite-sizer",
    icon: "📐",
    badge: "Medidas Canva 300 DPI",
    desc: "Calcula las medidas exactas de cada tarjetón, márgenes de sangrado y holguras de sobre con especificaciones a 300 DPI.",
    tags: ["Medidas A7 y A6", "Capas de Papel", "Sangrado 300 DPI"]
  },
  {
    title: "Franqueo Postal y Sellos de Lacre",
    url: "/es/wedding-invitation-postage-calculator",
    icon: "📮",
    badge: "Tarifas de Correos",
    desc: "Calcula el peso exacto del sobre y la tarifa postal necesaria. Incluye el impacto de sellos de lacre, lazos de seda y gramajes pesados.",
    tags: ["Sellos de Lacre", "Peso en Gramos", "Tarifas Postales"]
  },
  {
    title: "Marcasitios y Tarjetas de Asiento",
    url: "/es/table-place-cards",
    icon: "🏷️",
    badge: "Listos para Imprimir",
    desc: "Genera marcasitios plegables de sobremesa con el nombre del comensal, número de mesa e iconos de menú (carne, pescado, vegetariano, celíaco).",
    tags: ["PDF Imprimible", "Cartulina Plegable", "Iconos de Menú"]
  },
  {
    title: "Tarjetas de Agradecimiento",
    url: "/es/wedding-thank-you-cards",
    icon: "✍️",
    badge: "Regalos y Presencia",
    desc: "Genera textos personalizados y emotivos para agradecer regalos en efectivo, transferencias bancarias, regalos de lista de boda y asistencia.",
    tags: ["Agradecimientos", "Regalos Dinero", "Textos Emotivos"]
  },
  {
    title: "Invitaciones de Boda Digitales",
    url: "/es/digital-invitations",
    icon: "💌",
    badge: "Web y Móvil",
    desc: "Diseña invitaciones digitales elegantes y Save-the-Date para WhatsApp con botón para añadir al calendario (.ics) y confirmación de asistencia.",
    tags: ["Invitaciones Móvil", "Save-the-Date", "Confirmación Online"]
  },
  {
    title: "Temporizador de Discursos y Brindis",
    url: "/es/wedding-speech-calculator",
    icon: "🎙️",
    badge: "Ritmo de Lectura",
    desc: "Pega el texto de tu brindis o votos nupciales para calcular el tiempo real de lectura (110–130 ppm), pausas dramáticas y tarjetas guía.",
    tags: ["Ritmo de Lectura", "Fichas Spickzettel", "Votos Nupciales"]
  },
  {
    title: "Generador de Hashtags de Boda",
    url: "/es/wedding-hashtag-generator",
    icon: "#️⃣",
    badge: "Más de 50 Estilos",
    desc: "Crea hashtags divertidos, románticos y creativos con los nombres de los novios y carteles decorativos para las mesas y photocall.",
    tags: ["Hashtags Instagram", "Carteles Photocall", "Juegos de Palabras"]
  },
  {
    title: "Numerología de la Fecha de Boda",
    url: "/es/wedding-date-numerology",
    icon: "✨",
    badge: "Significado Especial",
    desc: "Calcula el número del camino de vida matrimonial y la vibración espiritual de vuestra fecha elegida para contraer matrimonio.",
    tags: ["Número de Destino", "Compatibilidad", "Significado"]
  },
  {
    title: "Guía de Bodas y Aniversarios",
    url: "/es/anniversary-gift-finder",
    icon: "💎",
    badge: "Del Año 1 al 60",
    desc: "Descubre los nombres tradicionales y modernos de cada aniversario (Bodas de Papel, Plata, Oro, Diamante) e ideas de regalos y dedicatorias.",
    tags: ["Bodas de Plata", "Bodas de Oro", "Ideas de Regalo"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Centro Creativo y de Papelería</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Herramientas de <span class="accent-italic">Papelería, Invitaciones y Detalles</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Formatea sobres según el protocolo de etiqueta, dimensiona tus invitaciones en capas, calcula el franqueo postal con sellos de lacre y cronometra los discursos.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Explorar Categorías:</span>
      <a href="/es/budget" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Presupuesto</a>
      <a href="/es/dining" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Banquete y Barra</a>
      <a href="/es/guests" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">👥 Invitados y Logística</a>
      <a href="/es/stationery" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">💌 Papelería (Activo)</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {stationeryTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
            Abrir Herramienta →
          </a>
        </div>
      ))}
    </div>

    <!-- In-Depth Stationery Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Protocolo de Papelería</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          Cómo Formatear, Medir y Enviar tus Invitaciones de Boda
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Todo lo que necesitas saber sobre formatos estándar, holguras de corte y cálculo de peso postal para evitar sorpresas.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. Jerarquía y Dimensiones de la Suite de Invitación
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Para que todos los tarjetones se deslicen suavemente dentro del sobre sin atascarse, respeta el escalonado de medidas:
        </p>
        
        <div style="overflow-x: auto; margin-top: 1rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Elemento de la Suite</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Medida Estándar (cm)</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Resolución Canva (300 DPI)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Sobre Exterior (A7 / C6)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">13,3 × 18,4 cm</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1575 × 2175 px</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Tarjetón Principal de Invitación</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">12,7 × 17,8 cm (o A6 10,5×14,8)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1538 × 2138 px (con sangrado de 3mm)</td>
              </tr>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Tarjeta de Confirmación (RSVP)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">8,9 × 12,7 cm</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1088 × 1538 px</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Tarjeta de Información / Plano</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">10 × 15 cm</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1200 × 1800 px</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Preguntas Frecuentes sobre Papelería Nupcial
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              ¿Cuáles son las medidas estándar para las invitaciones de boda (A7 / A6 / B6)?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Las medidas estándar más utilizadas son: Tarjetón principal A7 (12,7 × 17,8 cm) con sobre exterior (13,3 × 18,4 cm), o formato europeo A6 (10,5 × 14,8 cm) con sobre C6 (11,4 × 16,2 cm). El tarjetón de confirmación (RSVP) suele medir 9 × 13 cm.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              ¿Cuánto peso añade un sello de lacre en el sobre de invitación?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              Un sello de lacre tradicional añade entre 4 y 7 gramos de peso al sobre, además de aumentar el grosor total en unos 3 milímetros. Por ello, conviene pesar el conjunto en la oficina de correos para evitar recargos por exceso de peso o clasificación manual.
            </p>
          </details>

          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); outline: none;">
              ¿Cuánto debe durar un discurso o brindis de boda?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6;">
              La duración ideal para el discurso del padrino, madrina, testigos o novios es de 3 a 5 minutos (aproximadamente entre 400 y 600 palabras a un ritmo conversacional pausado de 120 palabras por minuto). Discursos superiores a 6 minutos tienden a perder la atención de los comensales.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
