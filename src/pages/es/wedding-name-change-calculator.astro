---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-name-change-calculator/#webapp",
      "name": "Calculadora de Trámites y Cambio de Apellido tras la Boda",
      "url": "https://manage.wedding/es/wedding-name-change-calculator",
      "inLanguage": "es",
      "description": "Calculadora interactiva de trámites, cambio de apellido y costes tras el matrimonio. Personaliza tu combinación de apellidos, calcula tasas oficiales (DNI, Pasaporte, DGT, Registro Civil) y exporta tu plan de acción en PDF y Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Gestionar los Trámites y Cambio de Apellidos tras el Matrimonio",
      "description": "Guía paso a paso en el orden legal correcto para actualizar tus documentos oficiales, DNI, pasaporte y cuentas bancarias tras casarte.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Solicitar Certificados Literales de Matrimonio",
          "text": "Pide 3 a 4 copias del Certificado Literal de Matrimonio en el Registro Civil o sede electrónica del Ministerio de Justicia (0€ en España, 15€–30€ con Apostilla de La Haya para trámites internacionales)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Actualizar el DNI / NIE en Policía Nacional",
          "text": "Acude a la Comisaría de Policía con tu certificado de matrimonio y volante de empadronamiento si también cambiaste de domicilio (12€ o gratuito por cambio de datos de residencia)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Renovar el Pasaporte Oficial",
          "text": "Renueva el pasaporte en Comisaría para que coincida con tu nuevo estado o combinación de apellidos (Tasa oficial: 30€)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Notificar a DGT (Carnet de Conducir) y Seguridad Social",
          "text": "Actualiza tus datos en la DGT (gratuito para cambio de datos) y en la Tesorería General de la Seguridad Social (INSS) y Tarjeta Sanitaria."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 5: Notificar a Hacienda (Modelo 030), Bancos y Recursos Humanos",
          "text": "Comunica la variación a la Agencia Tributaria (Hacienda - Modelo 030), a tu empresa para el IRPF, a tus entidades bancarias y compañías de seguros."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es obligatorio cambiar de apellido al casarse en España o Latinoamérica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En España y la gran mayoría de países de habla hispana, NO se pierde ningún apellido al casarse: cada cónyuge mantiene legalmente su primer apellido paterno y materno. No obstante, las parejas pueden optar por unir apellidos con guion, añadir 'de + apellido', cambiar el orden de los apellidos en el Registro Civil o formalizar el apellido matrimonial en trámites internacionales y consulares."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuestan los trámites administrativos tras la boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En España, la mayoría de trámites civiles son gratuitos (Registro Civil, Seguridad Social, Hacienda Modelo 030 y DGT por cambio de datos). Las únicas tasas oficiales habituales son la expedición del DNI (12€), la renovación del Pasaporte (30€) y posibles legalizaciones con Apostilla de La Haya (15€–30€ por documento)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo viajar de luna de miel con billetes a nombre de casada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "¡Peligro! Los billetes de avión DEBEN coincidir exactamente letra por letra con el pasaporte físico que lleves en la mano en el momento de embarcar. Como los trámites tras la boda tardan varias semanas, reserva siempre todos los billetes de la luna de miel con tus apellidos de soltera actuales."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué orden se deben hacer los trámites legales?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El orden estricto es: 1º Obtener el Certificado Literal de Matrimonio en el Registro Civil; 2º Actualizar DNI / NIE; 3º Renovar Pasaporte; 4º DGT y Seguridad Social; 5º Hacienda (Modelo 030); 6º Bancos, nómina laboral (IRPF) y seguros."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Trámites y Cambio de Apellido tras la Boda: Calculadora de Gastos y Checklist"
	description="Calculadora interactiva de trámites, cambio de apellido y costes tras el matrimonio. Personaliza tu combinación de apellidos, calcula tasas oficiales (DNI, Pasaporte, DGT, Registro Civil) y exporta tu plan de acción en PDF y Word."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Trámites y Cambio de Apellido" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Orden Legal de Trámites & Estimador de Tasas</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Trámites & Cambio de Apellido <span class="accent-italic">tras la Boda</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Formatea tu nueva combinación de apellidos, calcula las tasas administrativas oficiales (DNI, Pasaporte, DGT, Registro) y completa los trámites en el orden legal correcto. Exporta tu plan de acción en 1 clic.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; margin-bottom: 3rem; align-items: start;">
			
			<!-- Left Column: Formateador de Apellidos & Identidad -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						1. Estudio de Apellidos & Nueva Identidad
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Vista Previa
					</span>
				</div>

				<!-- Datos Cónyuge 1 -->
				<div style="margin-bottom: 1.25rem;">
					<label class="form-label" style="font-weight: 700; font-size: 0.95rem;">Tus Nombres y Apellidos Actuales</label>
					<div style="display: grid; grid-template-columns: 1fr 1.1fr 1.1fr; gap: 0.5rem;">
						<div>
							<input type="text" id="p1-first" class="form-input" value="María" placeholder="Nombre" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Nombre</span>
						</div>
						<div>
							<input type="text" id="p1-middle" class="form-input" value="García" placeholder="1º Apellido" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">1º Apellido</span>
						</div>
						<div>
							<input type="text" id="p1-maiden" class="form-input" value="López" placeholder="2º Apellido" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">2º Apellido</span>
						</div>
					</div>
				</div>

				<!-- Datos Cónyuge 2 -->
				<div style="margin-bottom: 1.25rem;">
					<label class="form-label" style="font-weight: 700; font-size: 0.95rem;">Nombre y Apellido de tu Pareja</label>
					<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.5rem;">
						<div>
							<input type="text" id="p2-first" class="form-input" value="Carlos" placeholder="Nombre Pareja" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Nombre</span>
						</div>
						<div>
							<input type="text" id="p2-surname" class="form-input" value="Fernández" placeholder="Apellido Pareja" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Apellido Principal</span>
						</div>
					</div>
				</div>

				<!-- Opciones de Estructura -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="naming-format-select" style="font-weight: 700;">Opción de Estructura de Apellidos</label>
					<select id="naming-format-select" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; padding: 0.65rem; width: 100%;">
						<option value="keep-maiden" selected>🇪🇸 Tradición Española: Mantener Apellidos de Nacimiento (María García López - 0€)</option>
						<option value="take-spouse">💍 Adición de Casada: de + Apellido Pareja (María García de Fernández)</option>
						<option value="hyphenated-1">🔗 Unión con Guion: Paterno-Pareja (María García-Fernández)</option>
						<option value="hyphenated-2">🔗 Ambos Apellidos Unidos: (María García López-Fernández)</option>
						<option value="take-full-spouse">🌍 Estilo Internacional: Adoptar Apellido Cónyuge (María Fernández)</option>
						<option value="blended">✨ Combinación / Creación Libre (Requiere Expediente Registral)</option>
					</select>
				</div>

				<!-- Campo Personalizado -->
				<div id="custom-surname-container" style="display: none; margin-bottom: 1.25rem;">
					<label class="form-label" for="custom-surname" style="font-weight: 700;">Apellido Combinado Personalizado</label>
					<input type="text" id="custom-surname" class="form-input" value="Garzández" placeholder="ej. Garzández" style="width: 100%; padding: 0.5rem;" />
					<small style="color: var(--accent-red); font-size: 0.8rem;">⚠️ Nota: Una alteración sustancial requiere expediente en el Registro Civil / Ministerio de Justicia.</small>
				</div>

				<!-- Tarjeta de Vista Previa -->
				<div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; box-shadow: 3px 3px 0 var(--fg-pencil); margin-top: 1rem;">
					<div style="font-size: 0.8rem; text-transform: uppercase; font-weight: 800; color: var(--accent-red); letter-spacing: 0.05em; margin-bottom: 0.35rem;">
						Tu Identidad y Nombre Oficial
					</div>
					
					<div id="preview-full-legal" class="font-heading" style="font-size: 1.55rem; color: var(--fg-pencil); line-height: 1.2; margin-bottom: 0.75rem;">
						María García López
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.88rem; padding-top: 0.75rem; border-top: 1px dashed #cbd5e1;">
						<div>
							<span style="color: var(--text-secondary); display: block; font-size: 0.75rem;">Monograma / Iniciales:</span>
							<strong id="preview-monogram" style="font-family: var(--font-hand); font-size: 1.3rem; color: var(--accent-blue);">M G L</strong>
						</div>
						<div>
							<span style="color: var(--text-secondary); display: block; font-size: 0.75rem;">Vía Administrativa:</span>
							<strong id="preview-route-badge" style="color: #16a34a; font-size: 0.82rem;">✅ Registro Civil Directo</strong>
						</div>
						<div style="grid-column: span 2;">
							<span style="color: var(--text-secondary); display: block; font-size: 0.75rem;">Email Profesional Estimado:</span>
							<code id="preview-email" style="background: #e2e8f0; padding: 2px 6px; border-radius: 3px; font-size: 0.85rem;">maria.garcia@empresa.com</code>
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Resumen de Tasas & Cronograma -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						2. Tasas Totales y Tiempo de Trámites
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: #e0f2fe; border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						En Tiempo Real
					</span>
				</div>

				<!-- Big Metric Hero Cards -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
					
					<!-- Métrica 1: Coste Total -->
					<div style="background: #fef08a; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; text-align: center; box-shadow: 3px 3px 0 var(--fg-pencil);">
						<span style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: var(--fg-pencil); display: block;">
							Coste Estimado Tasas
						</span>
						<div id="display-total-fee" class="font-heading" style="font-size: 2.2rem; color: var(--fg-pencil); line-height: 1.1; margin: 0.25rem 0;">
							42,00 €
						</div>
						<span id="display-fee-range" style="font-size: 0.8rem; color: var(--text-secondary);">
							Tasas públicas oficiales
						</span>
					</div>

					<!-- Métrica 2: Semanas de Trámites -->
					<div style="background: #e0e7ff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; text-align: center; box-shadow: 3px 3px 0 var(--fg-pencil);">
						<span style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: var(--fg-pencil); display: block;">
							Plazo Secuencial
						</span>
						<div id="display-total-weeks" class="font-heading" style="font-size: 2.2rem; color: var(--accent-blue); line-height: 1.1; margin: 0.25rem 0;">
							3–6 Sem.
						</div>
						<span style="font-size: 0.8rem; color: var(--text-secondary);">
							Orden administrativo
						</span>
					</div>

				</div>

				<!-- Barra de Progreso -->
				<div style="margin-bottom: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<div style="display: flex; justify-content: space-between; font-size: 0.88rem; font-weight: 700; margin-bottom: 0.4rem;">
						<span>Progreso de Trámites:</span>
						<span id="progress-text">0 de 16 Trámites Realizados (0%)</span>
					</div>
					<div style="width: 100%; height: 16px; background: #e2e8f0; border-radius: 8px; border: 1.5px solid var(--fg-pencil); overflow: hidden;">
						<div id="progress-bar-fill" style="width: 0%; height: 100%; background: #22c55e; transition: width 0.3s ease;"></div>
					</div>
				</div>

				<!-- Filtros Rápidos -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
					<button type="button" id="btn-filter-all" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem; background: var(--fg-pencil); color: #fff;">
						Todos los Trámites
					</button>
					<button type="button" id="btn-filter-vital" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem;">
						DNI y Registro
					</button>
					<button type="button" id="btn-filter-travel" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem;">
						Pasaporte y Viaje
					</button>
					<button type="button" id="btn-check-all" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem; margin-left: auto;">
						Reiniciar
					</button>
				</div>

				<!-- Botones de Exportación -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<button type="button" id="btn-export-pdf" class="hand-btn" style="background: #fecdd3; border-color: var(--fg-pencil); color: var(--fg-pencil); font-size: 0.95rem; padding: 10px;">
						🖨️ Imprimir / PDF
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="background: #dbeafe; border-color: var(--fg-pencil); color: var(--fg-pencil); font-size: 0.95rem; padding: 10px;">
						📄 Exportar Word (.doc)
					</button>
					<button type="button" id="btn-copy-checklist" class="hand-btn" style="grid-column: span 2; background: #dcfce7; border-color: var(--fg-pencil); color: var(--fg-pencil); font-size: 0.95rem; padding: 10px;">
						📋 Copiar Lista de Trámites
					</button>
				</div>

			</div>

		</div>

		<!-- Checklist Interactivo por Fases -->
		<section class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.5rem); background: #fff; margin-bottom: 3.5rem;">
			
			<div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
				<div>
					<span class="badge-postit" style="font-size: 0.85rem;">Plan de Acción por Fases</span>
					<h2 class="font-heading" style="font-size: 1.85rem; margin: 0.35rem 0 0 0; color: var(--fg-pencil);">
						El Orden Legal Estricto de los Trámites
					</h2>
				</div>
				<p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0; max-width: 480px;">
					Marca los trámites a medida que los completes y ajusta las tasas según tu comunidad autónoma o país.
				</p>
			</div>

			<!-- FASE 1: Registro Civil y Libro de Familia -->
			<div class="checklist-stage" data-stage="vital" style="margin-bottom: 2rem;">
				<div style="background: #f1f5f9; border-left: 5px solid var(--accent-red); padding: 0.75rem 1rem; border-radius: 0 6px 6px 0; margin-bottom: 1rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						Fase 1: Registro Civil y Certificados de Matrimonio
					</h3>
					<p style="margin: 0; font-size: 0.88rem; color: var(--text-secondary);">
						Paso imprescindible antes de acudir a comisarías, bancos o agencias tributarias.
					</p>
				</div>

				<!-- Trámite 1: Certificado Literal de Matrimonio -->
				<div class="checklist-item hand-card" style="padding: 1rem; margin-bottom: 0.85rem; background: #fafafa; border: 1.5px solid var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
						<div style="display: flex; align-items: flex-start; gap: 0.75rem; flex: 1; min-width: 260px;">
							<input type="checkbox" id="chk-item-1" class="task-checkbox" style="width: 20px; height: 20px; margin-top: 3px; cursor: pointer;" />
							<div>
								<label for="chk-item-1" style="font-weight: 700; font-size: 1.05rem; color: var(--fg-pencil); cursor: pointer;">
									1. Certificados Literales de Matrimonio y Libro de Familia
								</label>
								<div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
									Solicítalos en el Registro Civil o con certificado digital en la Sede del Ministerio de Justicia. Recomendado: 3 copias.
								</div>
								<div style="margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
									<span style="font-size: 0.85rem;">Copias:</span>
									<input type="number" id="input-cert-copies" min="1" max="10" value="3" style="width: 55px; padding: 3px 6px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
									<span style="font-size: 0.85rem;">Tasa Registro:</span>
									<span style="font-size: 0.85rem; font-weight: 700; color: #16a34a;">0,00 € (Gratuito)</span>
								</div>
							</div>
						</div>
						<div style="text-align: right; min-width: 110px;">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Tasa Oficial:</span>
							<strong id="fee-item-1" class="item-cost-display" style="font-size: 1.2rem; color: #16a34a;">0,00 €</strong>
							<span style="display: block; font-size: 0.75rem; color: #16a34a; font-weight: 600;">⏱️ 1–2 Semanas</span>
						</div>
					</div>
				</div>

				<!-- Trámite 2: DNI / NIE -->
				<div class="checklist-item hand-card" style="padding: 1rem; margin-bottom: 0.85rem; background: #fafafa; border: 1.5px solid var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
						<div style="display: flex; align-items: flex-start; gap: 0.75rem; flex: 1; min-width: 260px;">
							<input type="checkbox" id="chk-item-2" class="task-checkbox" style="width: 20px; height: 20px; margin-top: 3px; cursor: pointer;" />
							<div>
								<label for="chk-item-2" style="font-weight: 700; font-size: 1.05rem; color: var(--fg-pencil); cursor: pointer;">
									2. Actualización de DNI / NIE (Policía Nacional)
								</label>
								<div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
									Cita previa en Comisaría. Aporta certificado de matrimonio y volante de empadronamiento si cambiaste de domicilio.
								</div>
								<div style="margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
