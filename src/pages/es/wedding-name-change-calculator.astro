	<script is:inline>
		const p1First = document.getElementById('p1-first');
		const p1Middle = document.getElementById('p1-middle');
		const p1Maiden = document.getElementById('p1-maiden');
		const p2First = document.getElementById('p2-first');
		const p2Surname = document.getElementById('p2-surname');
		const namingFormatSelect = document.getElementById('naming-format-select');
		const customSurnameContainer = document.getElementById('custom-surname-container');
		const customSurname = document.getElementById('custom-surname');

		const previewFullLegal = document.getElementById('preview-full-legal');
		const previewMonogram = document.getElementById('preview-monogram');
		const previewRouteBadge = document.getElementById('preview-route-badge');
		const previewEmail = document.getElementById('preview-email');

		const displayTotalFee = document.getElementById('display-total-fee');
		const displayTotalWeeks = document.getElementById('display-total-weeks');
		const progressText = document.getElementById('progress-text');
		const progressBarFill = document.getElementById('progress-bar-fill');

		const inputDniFee = document.getElementById('input-dni-fee');
		const feeItem2 = document.getElementById('fee-item-2');
		const inputPasaporteFee = document.getElementById('input-pasaporte-fee');
		const feeItem3 = document.getElementById('fee-item-3');

		const taskCheckboxes = document.querySelectorAll('.task-checkbox');

		const btnFilterAll = document.getElementById('btn-filter-all');
		const btnFilterVital = document.getElementById('btn-filter-vital');
		const btnFilterTravel = document.getElementById('btn-filter-travel');
		const btnCheckAll = document.getElementById('btn-check-all');

		const btnExportPdf = document.getElementById('btn-export-pdf');
		const btnExportDoc = document.getElementById('btn-export-doc');
		const btnCopyChecklist = document.getElementById('btn-copy-checklist');

		function cap(str) {
			if (!str) return '';
			return str.trim().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ');
		}

		function sanitizeForEmail(str) {
			return str.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]/g, '');
		}

		function updatePersona() {
			const f1 = cap(p1First.value) || 'María';
			const ap1 = cap(p1Middle.value) || 'García';
			const ap2 = cap(p1Maiden.value) || 'López';
			const sp = cap(p2Surname.value) || 'Fernández';
			const cust = cap(customSurname.value) || 'Garzández';
			const format = namingFormatSelect.value;

			let newFullName = '';
			let newSurname = '';
			let monogram = '';
			let isExpediente = false;

			if (format === 'blended') {
				customSurnameContainer.style.display = 'block';
			} else {
				customSurnameContainer.style.display = 'none';
			}

			switch (format) {
				case 'keep-maiden':
					newSurname = `${ap1} ${ap2}`;
					newFullName = `${f1} ${ap1} ${ap2}`;
					monogram = `${f1.charAt(0)} ${ap1.charAt(0)} ${ap2.charAt(0)}`;
					break;
				case 'take-spouse':
					newSurname = `${ap1} de ${sp}`;
					newFullName = `${f1} ${ap1} de ${sp}`;
					monogram = `${f1.charAt(0)} ${ap1.charAt(0)} ${sp.charAt(0)}`;
					break;
				case 'hyphenated-1':
					newSurname = `${ap1}-${sp}`;
					newFullName = `${f1} ${ap1}-${sp}`;
					monogram = `${f1.charAt(0)} ${ap1.charAt(0)} ${sp.charAt(0)}`;
					break;
				case 'hyphenated-2':
					newSurname = `${ap1} ${ap2}-${sp}`;
					newFullName = `${f1} ${ap1} ${ap2}-${sp}`;
					monogram = `${f1.charAt(0)} ${ap1.charAt(0)} ${sp.charAt(0)}`;
					break;
				case 'take-full-spouse':
					newSurname = sp;
					newFullName = `${f1} ${sp}`;
					monogram = `${f1.charAt(0)} ${sp.charAt(0)} ${ap1.charAt(0)}`;
					break;
				case 'blended':
					newSurname = cust;
					newFullName = `${f1} ${cust}`;
					monogram = `${f1.charAt(0)} ${cust.charAt(0)} ${ap1.charAt(0)}`;
					isExpediente = true;
					break;
			}

			previewFullLegal.textContent = newFullName;
			previewMonogram.textContent = monogram.toUpperCase();

			if (isExpediente) {
				previewRouteBadge.textContent = '⚖️ Requiere Expediente Registro';
				previewRouteBadge.style.color = '#dc2626';
			} else {
				previewRouteBadge.textContent = '✅ Registro Civil Directo';
				previewRouteBadge.style.color = '#16a34a';
			}

			const cleanFirst = sanitizeForEmail(f1);
			const cleanLast = sanitizeForEmail(ap1);
			previewEmail.textContent = `${cleanFirst}.${cleanLast}@empresa.com`;
		}

		function calculateFees() {
			const dniFee = parseFloat(inputDniFee.value) || 0;
			feeItem2.textContent = `${dniFee.toFixed(2).replace('.', ',')} €`;

			const pasaporteFee = parseFloat(inputPasaporteFee.value) || 0;
			feeItem3.textContent = `${pasaporteFee.toFixed(2).replace('.', ',')} €`;

			const total = dniFee + pasaporteFee;
			displayTotalFee.textContent = `${total.toFixed(2).replace('.', ',')} €`;

			let checkedCount = 0;
			taskCheckboxes.forEach(chk => { if (chk.checked) checkedCount++; });

			const totalTasks = taskCheckboxes.length;
			const pct = Math.round((checkedCount / totalTasks) * 100);
			progressText.textContent = `${checkedCount} de ${totalTasks} Trámites Realizados (${pct}%)`;
			progressBarFill.style.width = `${pct}%`;
		}

		btnFilterAll.addEventListener('click', () => {
			document.querySelectorAll('.checklist-stage').forEach(st => st.style.display = 'block');
			btnFilterAll.style.background = 'var(--fg-pencil)';
			btnFilterAll.style.color = '#fff';
			btnFilterVital.style.background = '#fff';
			btnFilterVital.style.color = 'var(--fg-pencil)';
			btnFilterTravel.style.background = '#fff';
			btnFilterTravel.style.color = 'var(--fg-pencil)';
		});

		btnFilterVital.addEventListener('click', () => {
			document.querySelectorAll('.checklist-stage').forEach(st => {
				st.style.display = st.getAttribute('data-stage') === 'vital' ? 'block' : 'none';
			});
			btnFilterVital.style.background = 'var(--fg-pencil)';
			btnFilterVital.style.color = '#fff';
			btnFilterAll.style.background = '#fff';
			btnFilterAll.style.color = 'var(--fg-pencil)';
			btnFilterTravel.style.background = '#fff';
			btnFilterTravel.style.color = 'var(--fg-pencil)';
		});

		btnFilterTravel.addEventListener('click', () => {
			document.querySelectorAll('.checklist-stage').forEach(st => {
				st.style.display = st.getAttribute('data-stage') === 'travel' ? 'block' : 'none';
			});
			btnFilterTravel.style.background = 'var(--fg-pencil)';
			btnFilterTravel.style.color = '#fff';
			btnFilterAll.style.background = '#fff';
			btnFilterAll.style.color = 'var(--fg-pencil)';
			btnFilterVital.style.background = '#fff';
			btnFilterVital.style.color = 'var(--fg-pencil)';
		});

		btnCheckAll.addEventListener('click', () => {
			taskCheckboxes.forEach(chk => { chk.checked = false; });
			calculateFees();
		});

		btnCopyChecklist.addEventListener('click', () => {
			const legalName = previewFullLegal.textContent;
			const totalCost = displayTotalFee.textContent;

			let text = `💍 PLAN DE ACCIÓN Y TRÁMITES TRAS LA BODA\n`;
			text += `=======================================\n`;
			text += `Nombre / Identidad: ${legalName}\n`;
			text += `Tasas Oficiales Estimadas: ${totalCost}\n\n`;
			text += `[ ] 1. Certificados Literales de Matrimonio (Registro Civil)\n`;
			text += `[ ] 2. Actualización de DNI / NIE (Policía Nacional)\n`;
			text += `[ ] 3. Renovación de Pasaporte Oficial\n`;
			text += `[ ] 4. DGT Permiso de Conducir y Circulación\n`;
			text += `[ ] 5. Seguridad Social (INSS) y Tarjeta Sanitaria\n`;
			text += `[ ] 6. Agencia Tributaria (Hacienda - Modelo 030)\n`;
			text += `[ ] 7. Empresa y Recursos Humanos (Modelo 145)\n`;
			text += `[ ] 8. Bancos, Hipotecas y Seguros\n\n`;
			text += `Generado en Manage.Wedding`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnCopyChecklist.innerHTML;
				btnCopyChecklist.innerHTML = '<span>✅</span> ¡Copiado al Portapapeles!';
				setTimeout(() => { btnCopyChecklist.innerHTML = orig; }, 2500);
			});
		});

		btnExportDoc.addEventListener('click', () => {
			const legalName = previewFullLegal.textContent;
			const totalCost = displayTotalFee.textContent;
			const dateStr = new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

			const html = `
				<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
				<head><meta charset="utf-8"><title>Trámites tras la Boda — ${legalName}</title></head>
				<body style="font-family: Calibri, sans-serif; padding: 24px;">
					<h1>💍 Plan de Trámites y Gestión de Apellidos tras el Matrimonio</h1>
					<p>Generado el ${dateStr} • Manage.Wedding</p>
					<p><strong>Nombre / Identidad:</strong> ${legalName}</p>
					<p><strong>Tasas Estimadas:</strong> ${totalCost}</p>
					<h3>Lista de Pasos Obligatorios:</h3>
					<ol>
						<li>Certificado Literal de Matrimonio en Registro Civil (0€)</li>
						<li>DNI / NIE en Comisaría de Policía (${feeItem2.textContent})</li>
						<li>Pasaporte Oficial (${feeItem3.textContent})</li>
						<li>DGT Carnet de Conducir (Gratis)</li>
						<li>Seguridad Social y Centro de Salud (Gratis)</li>
						<li>Hacienda Modelo 030 (Gratis)</li>
						<li>Empresa / RRHH Modelo 145</li>
						<li>Bancos y Seguros</li>
					</ol>
				</body></html>
			`;

			const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = `Tramites_Boda_${sanitizeForEmail(legalName)}.doc`;
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(url);
		});

		btnExportPdf.addEventListener('click', () => {
			window.print();
		});

		[p1First, p1Middle, p1Maiden, p2First, p2Surname, namingFormatSelect, customSurname, inputDniFee, inputPasaporteFee].forEach(el => {
			if (el) {
				el.addEventListener('input', () => { updatePersona(); calculateFees(); });
				el.addEventListener('change', () => { updatePersona(); calculateFees(); });
			}
		});

		taskCheckboxes.forEach(chk => { chk.addEventListener('change', calculateFees); });

		updatePersona();
		calculateFees();
	</script>
</Layout>
