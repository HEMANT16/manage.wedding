<script is:inline>
	let seatedGuestList = [{ name: "Carmen García", table: "1", meal: "🥩 Carne" }];
	let selectedGuestIndex = 0;

	const selectCardType = document.getElementById('select-card-type');
	const selectBorderTheme = document.getElementById('select-border-theme');
	const chkShowMealIcons = document.getElementById('chk-show-meal-icons');
	const chkShowTableBadge = document.getElementById('chk-show-table-badge');
	const previewCanvas = document.getElementById('preview-placecard-canvas');
	const previewScaleLabel = document.getElementById('preview-scale-label');
	const assignedCountBadge = document.getElementById('assigned-count-badge');
	const tableCardsStream = document.getElementById('table-cards-stream');
	const inputGuestName = document.getElementById('input-new-guest-name');
	const inputTableNum = document.getElementById('input-new-table-num');
	const selectMeal = document.getElementById('select-new-meal');

	function loadSeatedGuests() {
		try {
			const saved = localStorage.getItem('manage_wedding_guests_es');
			if (saved) {
				const all = JSON.parse(saved);
				if (all.length > 0) seatedGuestList = all;
			}
		} catch (e) {}
		renderPlaceCards();
	}

	function loadSampleTables() {
		seatedGuestList = [
			{ name: "Carmen García", table: "1", meal: "🥩 Carne" },
			{ name: "Alejandro Ruiz", table: "1", meal: "🐟 Pescado" },
			{ name: "Lucía Fernández", table: "2", meal: "🍗 Pollo" },
			{ name: "Hugo Morales", table: "2", meal: "🥦 Vegetariano" },
			{ name: "Abuela Teresa", table: "Mesa Presidencial", meal: "🐟 Pescado" }
		];
		selectedGuestIndex = 0;
		renderPlaceCards();
	}

	function renderPlaceCards() {
		const cardType = selectCardType.value;
		const theme = selectBorderTheme.value;
		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;

		if (selectedGuestIndex >= seatedGuestList.length) selectedGuestIndex = Math.max(0, seatedGuestList.length - 1);
		const currentGuest = seatedGuestList[selectedGuestIndex] || {
			name: inputGuestName.value.trim() || "Nombre Invitado",
			table: inputTableNum.value.trim() || "1",
			meal: selectMeal.value || "🥩 Carne"
		};

		previewCanvas.className = `card-format-${cardType} theme-${theme}`;
		if (cardType === 'tent') previewScaleLabel.textContent = "Marcasitio Plegable (9x5 cm Vista Frontal)";
		else if (cardType === 'flat') previewScaleLabel.textContent = "Marcasitio Plano Horizontal (9x5 cm)";
		else previewScaleLabel.textContent = "Número de Mesa para Centro (13x18 cm)";

		const botanicalSvg = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C8 6 4 10 4 15a8 8 0 0 0 16 0c0-5-4-9-8-13z"></path><path d="M12 2v20"></path></svg>`;
		const crestCornerSvg = `<svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M2 2h6v2H4v4H2V2zm16 0h-6v2h4v4h2V2zM2 18h6v-2H4v-4H2v6zm16 0h-6v-2h4v-4h2v6z"/></svg>`;

		if (cardType === 'tent') {
			previewCanvas.innerHTML = `
				<div style="flex: 1; border-bottom: 1.5px dashed #94a3b8; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.02);">
					<span style="font-size: 0.72rem; letter-spacing: 2px; text-transform: uppercase; opacity: 0.6; font-family: sans-serif;">✂️ LÍNEA DE HENDIDO • SOPORTE</span>
				</div>
				<div style="flex: 1.25; padding: 0.75rem 1rem; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative;">
					<div class="card-inner-border" style="position: absolute; inset: 4px; border-radius: 2px; pointer-events: none;"></div>
					${theme === 'botanical' ? `<div style="position: absolute; top: 4px; left: 4px; color: #234e32;">${botanicalSvg}</div><div style="position: absolute; top: 4px; right: 4px; transform: scaleX(-1); color: #234e32;">${botanicalSvg}</div>` : ''}
					${theme === 'crest' ? `<div style="position: absolute; top: 4px; left: 4px; color: #b45309;">${crestCornerSvg}</div><div style="position: absolute; top: 4px; right: 4px; transform: scaleX(-1); color: #b45309;">${crestCornerSvg}</div>` : ''}
					<h2 style="font-size: 1.35rem; margin: 0 0 0.2rem 0; line-height: 1.2; font-weight: 600; text-align: center;">${currentGuest.name}</h2>
					<div class="divider-line" style="width: 32px; height: 1.5px; margin: 0.2rem auto;"></div>
					${showTable ? `<p class="accent-color" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; margin: 0.2rem 0 0 0; font-weight: bold;">Mesa ${currentGuest.table}</p>` : ''}
					${showMeal ? `<div style="position: absolute; bottom: 6px; right: 8px; font-size: 1.1rem;">${currentGuest.meal.split(' ')[0] || '🥩'}</div>` : ''}
				</div>
			`;
		} else if (cardType === 'flat') {
			previewCanvas.innerHTML = `
				<div style="flex: 1; padding: 1.25rem; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative;">
					<div class="card-inner-border" style="position: absolute; inset: 6px; border-radius: 2px; pointer-events: none;"></div>
					<h2 style="font-size: 1.45rem; margin: 0 0 0.25rem 0; font-weight: 600; text-align: center;">${currentGuest.name}</h2>
					<div class="divider-line" style="width: 40px; height: 1.5px; margin: 0.25rem auto;"></div>
					${showTable ? `<p class="accent-color" style="font-size: 0.92rem; text-transform: uppercase; letter-spacing: 2px; margin: 0.25rem 0 0 0; font-weight: bold;">Mesa ${currentGuest.table}</p>` : ''}
					${showMeal ? `<div style="position: absolute; bottom: 8px; right: 10px; font-size: 1.15rem;">${currentGuest.meal.split(' ')[0] || '🥩'}</div>` : ''}
				</div>
			`;
		} else {
			const tbl = currentGuest.table ? currentGuest.table.toString() : "1";
			previewCanvas.innerHTML = `
				<div style="flex: 1; padding: 2rem 1.5rem; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; text-align: center;">
					<div class="card-inner-border" style="position: absolute; inset: 8px; border-radius: 4px; pointer-events: none;"></div>
					<p style="font-size: 0.95rem; letter-spacing: 4px; text-transform: uppercase; margin: 0 0 0.5rem 0;">MESA</p>
					<div style="font-size: 3.8rem; font-weight: 700; line-height: 1; margin: 0.25rem 0 0.5rem 0;" class="accent-color">${tbl.replace(/[^0-9]/g, '') || tbl}</div>
					<div class="divider-line" style="width: 50px; height: 2px; margin: 0.5rem auto 1rem;"></div>
					<p style="font-size: 0.88rem; font-style: italic; opacity: 0.8; margin: 0;">Sean Bienvenidos</p>
				</div>
			`;
		}

		assignedCountBadge.textContent = `${seatedGuestList.length} ${seatedGuestList.length === 1 ? 'Invitado' : 'Invitados'}`;

		const grouped = {};
		seatedGuestList.forEach((g, idx) => {
			const tbl = g.table || 'Sin mesa';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push({ ...g, originalIndex: idx });
		});

		tableCardsStream.innerHTML = '';
		Object.keys(grouped).forEach(tbl => {
			const block = document.createElement('div');
			block.style.cssText = `background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;`;
			let html = '';
			grouped[tbl].forEach(g => {
				const isSelected = g.originalIndex === selectedGuestIndex;
				html += `
					<div class="guest-item-row ${isSelected ? 'selected-guest-row' : ''}" data-idx="${g.originalIndex}" style="display: flex; justify-content: space-between; align-items: center; padding: 0.35rem 0.5rem; border-bottom: 1px dotted #ccc; font-size: 0.9rem; cursor: pointer;">
						<span style="font-weight: ${isSelected ? '700' : '500'};">${isSelected ? '👉 ' : ''}${g.name} <small style="color:#64748b;">(${g.meal || 'Carne'})</small></span>
						<button type="button" class="btn-del-seat hand-btn secondary" data-name="${g.name}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; color: #b91c1c;">🗑️</button>
					</div>
				`;
			});
			block.innerHTML = `
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
					<strong class="font-heading" style="color: var(--accent-red); font-size: 1.05rem;">Mesa: ${tbl}</strong>
					<span style="font-size: 0.8rem; font-weight: bold; background: #fff; border: 1px solid var(--fg-pencil); padding: 1px 6px; border-radius: 3px;">${grouped[tbl].length} Comensales</span>
				</div>
				<div>${html}</div>
			`;
			tableCardsStream.appendChild(block);
		});

		document.querySelectorAll('.btn-del-seat').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const gName = btn.getAttribute('data-name');
				seatedGuestList = seatedGuestList.filter(g => g.name !== gName);
				if (selectedGuestIndex >= seatedGuestList.length) selectedGuestIndex = Math.max(0, seatedGuestList.length - 1);
				renderPlaceCards();
			});
		});

		document.querySelectorAll('.guest-item-row').forEach(row => {
			row.addEventListener('click', () => {
				const idx = parseInt(row.getAttribute('data-idx'), 10);
				if (!isNaN(idx)) { selectedGuestIndex = idx; renderPlaceCards(); }
			});
		});
	}

	document.getElementById('btn-download-sample-png').addEventListener('click', () => {
		if (window.html2canvas) {
			window.html2canvas(previewCanvas, { scale: 3, backgroundColor: null, useCORS: true }).then(canvas => {
				const link = document.createElement('a');
				link.download = `Marcasitio_${seatedGuestList[selectedGuestIndex]?.name?.replace(/\s+/g, '_') || 'Muestra'}.png`;
				link.href = canvas.toDataURL("image/png");
				link.click();
			});
		}
	});

	document.getElementById('btn-add-guest').addEventListener('click', () => {
		const name = inputGuestName.value.trim();
		const table = inputTableNum.value.trim() || '1';
		const meal = selectMeal.value;
		if (name) {
			seatedGuestList.push({ name, table, meal });
			selectedGuestIndex = seatedGuestList.length - 1;
			inputGuestName.value = '';
			renderPlaceCards();
		}
	});

	document.getElementById('btn-load-samples').addEventListener('click', loadSampleTables);
	document.getElementById('btn-clear-all').addEventListener('click', () => { seatedGuestList = []; selectedGuestIndex = 0; renderPlaceCards(); });
	[selectCardType, selectBorderTheme, chkShowMealIcons, chkShowTableBadge].forEach(el => el.addEventListener('change', renderPlaceCards));

	function generatePrintDocHtml(cardsHtml, cardType, theme) {
		let borderColor = theme === 'botanical' ? '#234e32' : theme === 'crest' ? '#b45309' : '#111827';
		let bgStyle = theme === 'botanical' ? '#fcfbf7' : theme === 'crest' ? '#fdfaf4' : '#ffffff';
		let fontFamily = theme === 'crest' ? "'Cinzel', serif" : theme === 'botanical' ? "'Cormorant Garamond', serif" : "'Playfair Display', serif";

		return `
			<!DOCTYPE html>
			<html>
			<head>
				<meta charset="utf-8">
				<title>Marcasitios de Boda — Hoja Imprimible</title>
				<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Cormorant+Garamond:wght@600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
				<style>
					@page { size: A4 portrait; margin: 10mm; }
					* { box-sizing: border-box; }
					body { margin: 0; padding: 0; font-family: ${fontFamily}; background: #fff; }
					.header-info { border-bottom: 2px solid #333; padding-bottom: 6px; margin-bottom: 16px; text-align: center; }
					.cards-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; }
					.card-item { background: ${bgStyle}; border: 1.5px solid ${borderColor}; position: relative; page-break-inside: avoid; break-inside: avoid; display: flex; flex-direction: column; box-sizing: border-box; }
					.tent-card { height: 95mm; }
					.tent-top-flap { flex: 1; border-bottom: 1px dashed #888; display: flex; align-items: center; justify-content: center; font-size: 8pt; color: #666; font-family: sans-serif; text-transform: uppercase; }
					.tent-bottom-face { flex: 1.25; padding: 12px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; position: relative; }
					.flat-card { height: 50mm; padding: 12px; justify-content: center; align-items: center; text-align: center; }
					.tablenum-card { height: 130mm; padding: 20px; justify-content: center; align-items: center; text-align: center; }
					.guest-name { font-size: 15pt; margin: 0 0 2px 0; font-weight: 700; }
					.divider { width: 32px; height: 1.5px; background: ${borderColor}; margin: 4px auto; }
					.table-num { font-size: 9.5pt; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin: 2px 0 0 0; color: ${borderColor}; }
					.meal-badge { position: absolute; bottom: 6px; right: 8px; font-size: 13pt; }
					@media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .card-item { page-break-inside: avoid !important; } }
				</style>
			</head>
			<body>
				<div class="header-info">
					<h1 style="font-size:16pt; margin:0;">Marcasitios de Boda — Manage.Wedding</h1>
					<p style="margin:0; font-size:8.5pt; color:#555;">Total comensales: ${seatedGuestList.length}</p>
				</div>
				<div class="cards-grid">${cardsHtml}</div>
			</body>
			</html>
		`;
	}

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const cardType = selectCardType.value;
		const theme = selectBorderTheme.value;
		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;
		let cardsHtml = '';

		if (cardType === 'tablenum') {
			const uniqueTables = [...new Set(seatedGuestList.map(g => g.table))];
			if (uniqueTables.length === 0) uniqueTables.push("1");
			uniqueTables.forEach(tbl => {
				cardsHtml += `
					<div class="card-item tablenum-card">
						<p style="font-size:11pt; letter-spacing:4px; margin:0 0 4px 0;">MESA</p>
						<div style="font-size:46pt; font-weight:bold; margin:4px 0;">${tbl.replace(/[^0-9]/g, '') || tbl}</div>
						<div class="divider"></div>
						<p style="font-size:9.5pt; font-style:italic; margin:4px 0 0 0;">Sean Bienvenidos</p>
					</div>
				`;
			});
		} else if (cardType === 'tent') {
			seatedGuestList.forEach(g => {
				cardsHtml += `
					<div class="card-item tent-card">
						<div class="tent-top-flap"><span>✂️ LÍNEA DE HENDIDO</span></div>
						<div class="tent-bottom-face">
							<h2 class="guest-name">${g.name}</h2>
							<div class="divider"></div>
							${showTable ? `<p class="table-num">MESA ${g.table}</p>` : ''}
							${showMeal ? `<div class="meal-badge">${g.meal.split(' ')[0] || '🥩'}</div>` : ''}
						</div>
					</div>
				`;
			});
		} else {
			seatedGuestList.forEach(g => {
				cardsHtml += `
					<div class="card-item flat-card">
						<h2 class="guest-name">${g.name}</h2>
						<div class="divider"></div>
						${showTable ? `<p class="table-num">MESA ${g.table}</p>` : ''}
						${showMeal ? `<div class="meal-badge">${g.meal.split(' ')[0] || '🥩'}</div>` : ''}
					</div>
				`;
			});
		}

		const fullHtml = generatePrintDocHtml(cardsHtml, cardType, theme);
		const printWin = window.open('', '_blank');
		if (printWin) {
			printWin.document.open();
			printWin.document.write(fullHtml);
			printWin.document.close();
			printWin.focus();
			setTimeout(() => printWin.print(), 350);
		}
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const grouped = {};
		seatedGuestList.forEach(g => {
			const tbl = g.table || 'Sin mesa';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push(g);
		});

		let tablesHtml = '';
		Object.keys(grouped).forEach(tbl => {
			let rows = '';
			grouped[tbl].forEach(g => {
				rows += `<tr><td style="padding:6px; border:1px solid #cbd5e1;">${g.name}</td><td style="padding:6px; border:1px solid #cbd5e1;">${g.meal || 'Estándar'}</td></tr>`;
			});
			tablesHtml += `
				<h3 style="color:#1e3a8a; margin-top:20px;">Mesa: ${tbl} (${grouped[tbl].length} Comensales)</h3>
				<table style="width:100%; border-collapse:collapse; margin-bottom:15px; font-size:12px;">
					<thead><tr style="background:#f1f5f9;"><th style="border:1px solid #cbd5e1; padding:6px; text-align:left;">Invitado</th><th style="border:1px solid #cbd5e1; padding:6px; text-align:left;">Plato</th></tr></thead>
					<tbody>${rows}</tbody>
				</table>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head><meta charset="utf-8"><title>Manifiesto de Mesas</title></head>
			<body style="font-family:Arial, sans-serif; padding:20px;">
				<h1>Manage.Wedding — Protocolo de Mesas y Menús</h1>
				<p>Fecha: ${new Date().toLocaleDateString()} | Total Invitados: <strong>${seatedGuestList.length}</strong></p>
				${tablesHtml}
			</body>
			</html>
		`;
		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Marcasitios_Manifiesto_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Nombre Invitado,Mesa,Menu\n";
		seatedGuestList.forEach(g => { csv += `"${g.name}","Mesa ${g.table}","${g.meal || 'Estándar'}"\n`; });
		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Marcasitios_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	loadSeatedGuests();
</script>
