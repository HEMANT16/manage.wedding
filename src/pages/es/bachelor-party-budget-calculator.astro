---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/bachelor-party-budget-calculator/#webapp",
      "name": "Calculadora de Presupuesto de Despedida de Soltero y Reparto de Gastos",
      "url": "https://manage.wedding/es/bachelor-party-budget-calculator",
      "inLanguage": "es",
      "description": "Calculadora gratuita de despedida de soltero y división de gastos. Calcula el coste exacto por amigo para casa rural, Airbnb, barco, cenas, copas y fiesta cubriendo la parte del novio. Genera mensajes de Bizum, Word y PDF.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Organizar y Repartir los Gastos de una Despedida de Soltero",
      "description": "Guía paso a paso para el organizador o padrino: planifica el presupuesto, reparte los costes entre los amigos e invita al novio sin perder dinero.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Define los Amigos que Pagan e Invita al Novio",
          "text": "Establece el número de asistentes y aplica la fórmula N-1: el alojamiento, las comidas y las actividades del novio se dividen a partes iguales entre los amigos."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Reserva Alojamiento y Furgoneta de Grupo",
          "text": "Suma los costes fijos no negociables: reserva de casa rural o Airbnb, fianza, limpieza y furgoneta o gasolina compartida."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Presupuesta Actividades, Cenas y Fiesta",
          "text": "Añade estimaciones para karts o barco, cata de cervezas, cena de asador, compras de barbacoa y reservados o copas en discoteca."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Recauda la Fianza Inicial por Bizum",
          "text": "Envía un mensaje detallado a WhatsApp: recauda el 50% de fianza entre 2 y 4 meses antes para asegurar las reservas y el resto 2 semanas antes."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿El novio paga algo en su despedida de soltero?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En la tradición moderna de las despedidas de soltero, el novio está completamente invitado: sus amigos se reparten a partes iguales su parte del alojamiento, actividades, comidas y copas (fórmula N-1). El novio únicamente suele pagar su propio billete de avión o transporte individual si es un viaje al extranjero."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta de media una despedida de soltero por persona en España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un fin de semana completo fuera (ej. Ibiza, Salamanca, Benidorm, Oporto) suele costar entre 220€ y 450€ por amigo, incluyendo alojamiento, comidas, actividades, copas y cubrir al novio. Una escapada a una casa rural con barbacoa oscila entre 130€ y 220€ por persona."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo debe recaudar el dinero el organizador de la despedida?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Recauda el primer pago (50% de fianza para bloquear el Airbnb o casa rural y actividades clave) entre 2 y 4 meses antes. El segundo pago (el 50% restante para compra del supermercado, cenas y copas) debe recaudarse 2 semanas antes del evento. Nunca adelantes grandes sumas con tu tarjeta personal sin recibir antes la fianza."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hacer si un amigo tiene un presupuesto muy ajustado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pasa una encuesta anónima de presupuesto antes de elegir ciudad. Si un amigo no puede permitirse el viaje completo, permítele sumarse a planes puntuales (por ejemplo, venir solo a la cena del sábado) o contribuir con una pequeña aportación simbólica (20-30€) para invitar a la ronda del novio."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Presupuesto de Despedida de Soltero (Reparto de Gastos) | Manage.Wedding"
	description="Calculadora gratis de despedida de soltero y división de gastos. Calcula el coste exacto por amigo para casa rural, Airbnb, barco, cenas, copas y fiesta cubriendo la parte del novio. Genera mensajes de Bizum, Word y PDF."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Presupuesto Despedida de Soltero" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Invitar al Novio & Reparto Bizum</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Presupuesto Despedida de Soltero <span class="accent-italic">& Reparto de Gastos</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcula el importe exacto por amigo para casa rural, Airbnb, paseo en barco, cenas de asador y fiesta. Cubre automáticamente la parte del novio y genera mensajes para Bizum y WhatsApp en 1 clic.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Configuración y Categorías -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						Datos del Viaje y Asistentes
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Fórmula N-1
					</span>
				</div>

				<!-- Destination / Preset Picker -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="destination-preset" style="font-weight: 700;">Destino / Tipo de Plan</label>
					<select id="destination-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; padding: 0.65rem;">
						<option value="ibiza" selected>🏖️ Ibiza / Mallorca (Barco, Beach Club & Discotecas / 420€/amigo)</option>
						<option value="salamanca">🏰 Salamanca / Granada (Tapas, Cañas & Fiesta Universitaria / 190€/amigo)</option>
						<option value="costa">🏄 Benidorm / Costa del Sol (Karts, Escape Room, Playa / 250€/amigo)</option>
						<option value="porto">🍷 Oporto / Lisboa (Cata de Vinos, Paseo en Barco, Cenas / 290€/amigo)</option>
						<option value="rural">🏡 Casa Rural con Piscina (Barbacoa & Fin de Semana Relax / 150€/amigo)</option>
						<option value="custom">✏️ Configuración Personalizada</option>
					</select>
				</div>

				<!-- Nombre del Novio, Amigos que pagan, Noches -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label class="form-label" for="groom-name" style="font-size: 0.9rem; font-weight: 600;">Nombre del Novio</label>
						<input type="text" id="groom-name" class="form-input" value="Carlos" placeholder="ej. Carlos" />
					</div>
					<div>
						<label class="form-label" for="guys-count" style="font-size: 0.9rem; font-weight: 600;">Amigos que Pagan</label>
						<input type="number" id="guys-count" class="form-input" value="7" min="1" max="40" />
					</div>
					<div>
						<label class="form-label" for="trip-nights" style="font-size: 0.9rem; font-weight: 600;">Noches</label>
						<input type="number" id="trip-nights" class="form-input" value="2" min="1" max="30" />
					</div>
				</div>

				<!-- Toggle Cubrir al Novio -->
				<div class="form-group" style="background: #fffcf5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem;">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 0.98rem; margin: 0;">
						<input type="checkbox" id="toggle-cover-groom" checked style="width: 18px; height: 18px; cursor: pointer;" />
						<span>Invitar al Novio 100% (El Novio Paga 0€)</span>
					</label>
					<span style="font-size: 0.82rem; color: #64748b; display: block; margin-top: 4px; margin-left: 26px;">
						Costumbre habitual: Los 7 amigos dividen a partes iguales el total de la despedida.
					</span>
				</div>

				<!-- Categorías de Gastos -->
				
				<!-- Categoría 1: Alojamiento -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏡 1. Alojamiento y Fianza (€)
						</strong>
						<span id="subtotal-lodging" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">1.100€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-airbnb" style="font-size: 0.85rem;">Airbnb / Casa Rural / Hotel</label>
							<input type="number" id="exp-airbnb" class="form-input" value="950" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-cleaning" style="font-size: 0.85rem;">Limpieza y Gastos de Gestión</label>
							<input type="number" id="exp-cleaning" class="form-input" value="150" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Categoría 2: Actividades y Aventura -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏄 2. Actividades y Excursiones (€)
						</strong>
						<span id="subtotal-activities" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">650€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-boat" style="font-size: 0.85rem;">Paseo en Barco / Catamarán</label>
							<input type="number" id="exp-boat" class="form-input" value="450" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-shooting" style="font-size: 0.85rem;">Karts / Paintball / Humor Amarillo</label>
							<input type="number" id="exp-shooting" class="form-input" value="0" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-tours" style="font-size: 0.85rem;">Cata de Cervezas / Bodega</label>
							<input type="number" id="exp-tours" class="form-input" value="200" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-golf" style="font-size: 0.85rem;">Otras Actividades / Aventura</label>
							<input type="number" id="exp-golf" class="form-input" value="0" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Categoría 3: Comidas y Cenas -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🥩 3. Comidas, Asador y Súper (€)
						</strong>
						<span id="subtotal-food" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">600€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-dinners" style="font-size: 0.85rem;">Cenas de Grupo / Asador</label>
							<input type="number" id="exp-dinners" class="form-input" value="350" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-groceries" style="font-size: 0.85rem;">Compra Supermercado & Barbacoa</label>
							<input type="number" id="exp-groceries" class="form-input" value="150" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-brunch" style="font-size: 0.85rem;">Desayunos, Tapas y Almuerzos</label>
						<input type="number" id="exp-brunch" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Categoría 4: Fiesta y Bebidas -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🍻 4. Fiesta, Copas y Discotecas (€)
						</strong>
						<span id="subtotal-nightlife" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">450€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-bars" style="font-size: 0.85rem;">Copas y Bares</label>
							<input type="number" id="exp-bars" class="form-input" value="200" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-vip" style="font-size: 0.85rem;">Reservado / Entradas Club</label>
							<input type="number" id="exp-vip" class="form-input" value="150" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-booze" style="font-size: 0.85rem;">Bebidas y Alcohol para el Alojamiento</label>
						<input type="number" id="exp-booze" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Categoría 5: Transporte -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🚗 5. Transporte y Gasolina (€)
						</strong>
						<span id="subtotal-transport" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">120€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-rental" style="font-size: 0.85rem;">Furgoneta Alquiler / Gasolina / Peajes</label>
							<input type="number" id="exp-rental" class="form-input" value="80" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-uber" style="font-size: 0.85rem;">Taxis / VTC (Cabify, Uber)</label>
							<input type="number" id="exp-uber" class="form-input" value="40" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Categoría 6: Camisetas y Disfraces -->
				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🧢 6. Camisetas, Disfraces y Detalles (€)
						</strong>
						<span id="subtotal-swag" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">90€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-shirts" style="font-size: 0.85rem;">Camisetas / Disfraz del Novio</label>
							<input type="number" id="exp-shirts" class="form-input" value="60" min="0" step="5" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-kits" style="font-size: 0.85rem;">Kit Antiresaca y Vasos</label>
							<input type="number" id="exp-kits" class="form-input" value="30" min="0" step="5" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Resultados, Bizum y Exportaciones -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Cost Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.25rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Coste Total por Amigo
						</span>
						<span id="groom-status-badge" style="font-size: 0.85rem; font-weight: 800; background: #16a34a; color: #fff; padding: 3px 8px; border-radius: 4px;">
							🤵 Carlos Paga: 0€
						</span>
					</div>

					<div id="display-per-person" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						430€
					</div>

					<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.25rem; font-size: 0.95rem; color: var(--text-secondary); flex-wrap: wrap;">
						<span>🌙 <strong id="display-per-night" style="color: var(--fg-pencil);">215€</strong> / noche</span>
						<span>•</span>
						<span>🎁 Parte del novio: <strong id="display-groom-subsidy" style="color: var(--accent-red); font-weight: 700;">+54€</strong> / amigo</span>
					</div>

					<p style="font-size: 0.92rem; color: var(--text-secondary); margin: 0 0 1.25rem 0; padding-bottom: 1rem; border-bottom: 1px dashed #cbd5e1;">
						Gasto total de la despedida: <strong id="display-trip-grand-total" style="color: var(--fg-pencil); font-weight: 700;">3.010€</strong> entre <span id="display-headcount-text">7 amigos</span> (+ novio).
					</p>

					<!-- Itemized Per-Person Split Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏡 Alojamiento y Fianza:</span>
							<strong id="item-lodging-share">157€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏄 Actividades y Aventura:</span>
							<strong id="item-activity-share">93€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🥩 Comidas, Cenas y Asador:</span>
							<strong id="item-food-share">86€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🍻 Fiesta, Copas y Discotecas:</span>
							<strong id="item-nightlife-share">64€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🚗 Transporte y Gasolina:</span>
							<strong id="item-transport-share">17€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.9rem;">
							<span>🧢 Camisetas y Detalles:</span>
							<strong id="item-swag-share">13€</strong>
						</div>
					</div>

					<!-- Suggested Payment Schedule -->
