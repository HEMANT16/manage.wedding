---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-date-numerology/#webapp",
      "name": "Calculadora de Numerología para la Fecha de la Boda y Compatibilidad",
      "url": "https://manage.wedding/es/wedding-date-numerology",
      "inLanguage": "es",
      "description": "Calculadora gratuita de numerología para la fecha de boda. Calcula el sendero de vida de ambos cónyuges, reduce la fecha del enlace a su vibración espiritual y descubre vuestro porcentaje de afinidad cósmica.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es la numerología de la fecha de la boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es la disciplina que suma los dígitos del día, mes y año del enlace hasta reducirlos a un solo número raíz (del 1 al 9 o números maestros 11, 22, 33). Revela la energía predominante, fortalezas y propósito espiritual del matrimonio."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuáles son los números más afortunados para casarse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los números más populares para bodas son el 2 (armonía, unión y reciprocidad) y el 6 (familia, calidez y devoción). Cada dígito aporta dones específicos a la pareja."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se calcula el número de sendero de vida de cada contrayente?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se suman todos los dígitos de la fecha de nacimiento (día + mes + año) y se reducen de forma continua hasta obtener un único dígito del 1 al 9."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular la Numerología y Compatibilidad de tu Boda",
      "description": "Paso a paso para reducir fechas de nacimiento y fecha de matrimonio a sus dígitos raíz.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Introduce la Fecha de Nacimiento del Primer Contrayente",
          "text": "Suma los dígitos de día, mes y año hasta reducir a un número entre 1 y 9."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Introduce la Fecha de Nacimiento del Segundo Contrayente",
          "text": "Calcula el número de sendero de vida del segundo miembro de la pareja."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Introduce la Fecha Prevista de la Boda",
          "text": "Suma los dígitos de la fecha del enlace (ej. 14 de octubre de 2026 = 1+0+1+4+2+0+2+6 = 16 → 1+6 = 7)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Descubre el Arquetipo y Porcentaje de Compatibilidad",
          "text": "Lee la interpretación del significado espiritual y la puntuación armónica de vuestra unión."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Numerología de Boda y Compatibilidad | Manage.Wedding"
	description="Descubre la numerología de la fecha de tu boda y el porcentaje de compatibilidad de pareja. Calcula el sendero de vida y el arquetipo de vuestro matrimonio."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<Breadcrumb title="Numerología de la Fecha de Boda" category="stationery-creative" />

		<section class="section-paper fade-in" style="min-height: 100vh; padding: 2.5rem 1rem;">
			<div style="max-width: 800px; margin: 0 auto;">
				
				<div class="hand-card" style="margin-bottom: 2rem;">
					<h1 class="font-heading" style="text-align: center; color: var(--fg-pencil); font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1rem;">
						Calculadora de Numerología <span class="accent-italic">de Boda</span>
					</h1>
					<p class="font-body" style="text-align: center; color: var(--text-secondary); margin-bottom: 2rem;">
						Introduce vuestras fechas de nacimiento y el día de la boda para revelar vuestro sendero de vida y compatibilidad cósmica.
					</p>
					
					<form id="numerology-form" style="display: flex; flex-direction: column; gap: 1.5rem;">
						<div>
							<label for="partner1" class="font-heading" style="display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">Fecha de Nacimiento - Contrayente 1</label>
							<input type="date" id="partner1" required style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: transparent; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<div>
							<label for="partner2" class="font-heading" style="display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">Fecha de Nacimiento - Contrayente 2</label>
							<input type="date" id="partner2" required style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: transparent; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<div>
							<label for="wedding-date" class="font-heading" style="display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">Fecha Prevista de la Boda</label>
							<input type="date" id="wedding-date" required style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: transparent; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<button type="submit" class="hand-btn" style="width: 100%; font-size: 1.25rem; margin-top: 1rem;">✨ Revelar Compatibilidad y Lectura</button>
					</form>
				</div>

				<div id="result-box" class="hand-card" style="margin-bottom: 3rem;">
					<h2 class="font-heading" style="color: var(--fg-pencil); margin-bottom: 1rem; font-size: 2rem;">Lectura Numerológica</h2>
					<div id="initial-message" class="font-body" style="color: var(--text-secondary); font-style: italic;">
						Completa el formulario para descubrir los números y la energía detrás de vuestro gran día.
					</div>
					
					<div id="results-content" style="display: none;">
						<div style="margin-bottom: 1.5rem;">
							<h3 class="font-heading" style="color: var(--accent-blue); font-size: 1.25rem;">Sendero de Vida - Contrayente 1: <span id="p1-number"></span></h3>
							<p id="p1-desc" class="font-body" style="color: var(--fg-pencil); margin-top: 0.5rem;"></p>
						</div>
						
						<div style="margin-bottom: 1.5rem;">
							<h3 class="font-heading" style="color: var(--accent-red); font-size: 1.25rem;">Sendero de Vida - Contrayente 2: <span id="p2-number"></span></h3>
							<p id="p2-desc" class="font-body" style="color: var(--fg-pencil); margin-top: 0.5rem;"></p>
						</div>
						
						<div style="margin-bottom: 2rem;">
							<h3 class="font-heading" style="color: var(--fg-pencil); font-size: 1.25rem;">Vibración de la Fecha de Boda: <span id="wd-number"></span></h3>
							<p id="wd-desc" class="font-body" style="color: var(--fg-pencil); margin-top: 0.5rem;"></p>
						</div>
						
						<div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1.5rem;">
							<h3 class="font-heading" style="text-align: center; color: var(--fg-pencil); font-size: 1.5rem;">Afinidad de la Pareja: <span id="comp-score"></span>%</h3>
							
							<div style="width: 100%; height: 24px; border: 2px solid var(--fg-pencil); border-radius: 12px; overflow: hidden; margin: 1rem 0; position: relative;">
								<div id="gauge-fill" style="width: 0%; height: 100%; background: repeating-linear-gradient(45deg, transparent, transparent 5px, var(--accent-blue) 5px, var(--accent-blue) 10px); transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);"></div>
							</div>
							
							<p id="comp-desc" class="font-body" style="text-align: center; font-style: italic; color: var(--fg-pencil);"></p>
						</div>
					</div>
				</div>

				<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
				<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
					<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Fórmula Numerológica</div>
					<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
						<span>⚡</span> Cómo se Reduce la Fecha de Boda
					</h3>
					<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
						<strong>La Fórmula:</strong> Se suman todos los dígitos de la fecha <strong>(Día D+D + Mes M+M + Año A+A+A+A)</strong> de forma sucesiva hasta llegar a un <strong>dígito único (del 1 al 9)</strong>. Por ejemplo, el <em>14 de octubre de 2026</em>: <code style="background: rgba(255,255,255,0.7); padding: 2px 6px; border-radius: 3px; font-weight: bold;">(1+4) + (1+0) + (2+0+2+6) = 5 + 1 + 10 = 16 → 1 + 6 = 7 (El Buscador de Sabiduría)</code>.
					</p>
					
					<!-- Benchmark Numerology Chart Table -->
					<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
							<thead>
								<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
									<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Número</th>
									<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Arquetipo Espiritual</th>
									<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Fortalezas de la Unión</th>
									<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Estilo de Boda Ideal</th>
								</tr>
							</thead>
							<tbody>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 1</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">El Pionero / Líder</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Nuevos comienzos, independencia mutua y ambición</td>
									<td style="padding: 0.6rem 0.8rem;">Boda urbana moderna, líneas arquitectónicas depuradas</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 2 (Favorito)</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">La Pareja / Pacificador</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Armonía, profunda intimidad y conexión de almas</td>
									<td style="padding: 0.6rem 0.8rem; color: #16a34a; font-weight: 600;">Ceremonia a la luz de las velas en jardín romántico</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 3</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">El Creador / Alegría</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Risas compartidas, optimismo y expresión artística</td>
									<td style="padding: 0.6rem 0.8rem;">Boda tipo cóctel desenfadada con banda en directo</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 4</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">El Constructor</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Estabilidad inquebrantable, lealtad y raíces sólidas</td>
									<td style="padding: 0.6rem 0.8rem;">Finca histórica señorial y banquete clásico formal</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 5</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">El Aventurero</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Viajes, libertad compartida y espontaneidad continua</td>
									<td style="padding: 0.6rem 0.8rem;">Boda de destino en playa o montaña</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 6 (Favorito)</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">El Protector / Amor</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Devoción familiar, ternura y calidez hogareña</td>
									<td style="padding: 0.6rem 0.8rem; color: #16a34a; font-weight: 600;">Pazo o masía rústica con mesas largas de madera</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 7</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">El Buscador</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Profundidad espiritual y complicidad silenciosa</td>
									<td style="padding: 0.6rem 0.8rem;">Monasterio íntimo o jardín botánico recogido</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 8</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">El Triunfador</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Abundancia material, metas compartidas y legado</td>
									<td style="padding: 0.6rem 0.8rem;">Gran salón de hotel de lujo, torre de champán y etiqueta</td>
								</tr>
								<tr style="border-bottom: 1px solid #e2e8f0;">
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue);">Número 9</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600;">El Humanitario</td>
									<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Generosidad, empatía universal y altruismo</td>
									<td style="padding: 0.6rem 0.8rem;">Boda ecológica sostenible o donaciones solidarias</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

				<article class="hand-card" style="margin-bottom: 2rem;">
					<h2 class="font-heading" style="color: var(--fg-pencil); font-size: 2rem; margin-bottom: 1.5rem;">El Significado de la Numerología en tu Boda</h2>
					
					<div class="font-body" style="color: var(--fg-pencil); line-height: 1.6; display: flex; flex-direction: column; gap: 1rem;">
						<p>Elegir la fecha de tu boda va más allá de la disponibilidad de la finca o la estación del año. Al explorar la <strong>numerología del matrimonio</strong>, descubres el patrón energético y la vibración de vuestra unión como pareja.</p>
						<p>Nuestra calculadora gratuita realiza la reducción de dígitos al instante. Compara varias fechas potenciales para encontrar la que mejor resuene con vuestro sendero de vida y metas compartidas.</p>
					</div>

					<h3 class="font-heading" style="margin-top: 3rem; margin-bottom: 1.5rem; font-size: 1.75rem;">Preguntas Frecuentes</h3>
					
					<div style="display: flex; flex-direction: column; gap: 1rem;">
						<details style="border: 2px solid var(--fg-pencil); padding: 1rem; border-radius: 4px;">
							<summary class="font-heading" style="cursor: pointer; font-size: 1.1rem; outline: none; list-style: none;">¿Qué es la numerología de la fecha de la boda?</summary>
							<p class="font-body" style="margin-top: 1rem; color: var(--text-secondary);">Es la reducción de los dígitos del día, mes y año del enlace a un único número raíz del 1 al 9, revelando el arquetipo de vuestro futuro como matrimonio.</p>
						</details>
						
						<details style="border: 2px solid var(--fg-pencil); padding: 1rem; border-radius: 4px;">
							<summary class="font-heading" style="cursor: pointer; font-size: 1.1rem; outline: none; list-style: none;">¿Podemos probar varias fechas para comparar?</summary>
							<p class="font-body" style="margin-top: 1rem; color: var(--text-secondary);">¡Por supuesto! Puedes calcular todas las fechas tentativas que estéis barajando para ver cuál ofrece una mayor sintonía con vuestros senderos de vida.</p>
						</details>
					</div>
				</article>

			</div>
		</section>

		<RelatedTools currentPath="/es/wedding-date-numerology" category="stationery" />

	</main>
</Layout>

<script>
	const descriptions: Record<number, string> = {
		1: "El Líder: Energía de independencia, originalidad y comienzos sólidos. Un camino donde ambos construyen juntos un destino valiente y lleno de iniciativa.",
		2: "La Pareja: Armonía, diplomacia y complicidad. Un equilibrio perfecto de energías con una profunda conexión emocional y entendimiento mutuo.",
		3: "El Creador: Alegría, comunicación y creatividad. Un matrimonio repleto de risas, vida social activa y una infinita inspiración compartida.",
		4: "El Constructor: Estabilidad, constancia y raíces profundas. Una unión capaz de edificar un futuro sólido y seguro con lealtad incondicional.",
		5: "El Aventurero: Libertad, entusiasmo y dinamismo. Un viaje emocionante lleno de viajes, descubrimientos y nuevas experiencias juntos.",
		6: "El Protector: Amor incondicional, calidez y devoción familiar. Un número centrado en el hogar, el cuidado mutuo y la ternura cotidiana.",
		7: "El Buscador: Profundidad espiritual, sabiduría y serenidad. Una conexión íntima de almas que trasciende lo cotidiano.",
		8: "El Triunfador: Ambición, prosperidad y metas elevadas. Un equipo imparable capaz de alcanzar gran seguridad y dejar una huella duradera.",
		9: "El Humanitario: Compasión, generosidad y amor universal. Vuestra unión irradia luz, empatía y entrega hacia los demás."
	};

	function reduceDate(dateString: string): number {
		if (!dateString) return 0;
		let sum = dateString.replace(/\D/g, '').split('').reduce((acc, digit) => acc + parseInt(digit), 0);
		while (sum > 9) {
			sum = sum.toString().split('').reduce((acc, digit) => acc + parseInt(digit), 0);
		}
		return sum || 1; 
	}

	const form = document.getElementById('numerology-form');
	if (form) {
		form.addEventListener('submit', function(e) {
			e.preventDefault();
			
			const p1Input = document.getElementById('partner1') as HTMLInputElement;
			const p2Input = document.getElementById('partner2') as HTMLInputElement;
			const wdInput = document.getElementById('wedding-date') as HTMLInputElement;
			
			if (!p1Input.value || !p2Input.value || !wdInput.value) return;
			
			const p1Num = reduceDate(p1Input.value);
			const p2Num = reduceDate(p2Input.value);
			const wdNum = reduceDate(wdInput.value);
			
			const initialMsg = document.getElementById('initial-message');
			const resultsContent = document.getElementById('results-content');
			
			if (initialMsg) initialMsg.style.display = 'none';
			if (resultsContent) resultsContent.style.display = 'block';
			
			document.getElementById('p1-number')!.textContent = p1Num.toString();
			document.getElementById('p1-desc')!.textContent = descriptions[p1Num];
			
			document.getElementById('p2-number')!.textContent = p2Num.toString();
			document.getElementById('p2-desc')!.textContent = descriptions[p2Num];
			
			document.getElementById('wd-number')!.textContent = wdNum.toString();
			document.getElementById('wd-desc')!.textContent = descriptions[wdNum];
			
			const seed = (p1Num * 3 + p2Num * 7 + wdNum * 5);
			const score = Math.floor((seed % 26) + 75);
			
			document.getElementById('comp-score')!.textContent = score.toString();
			
			const gaugeFill = document.getElementById('gauge-fill');
			if (gaugeFill) {
				gaugeFill.style.width = '0%';
				setTimeout(() => {
					gaugeFill.style.width = score + '%';
				}, 50);
			}
			
			const compDesc = document.getElementById('comp-desc');
			if (compDesc) {
				if (score >= 95) {
					compDesc.textContent = "¡Una conexión extraordinaria! Vuestras energías se alinean a la perfección.";
				} else if (score >= 85) {
					compDesc.textContent = "Una sintonía maravillosa con profunda armonía, alegría y complicidad.";
				} else {
					compDesc.textContent = "Un vínculo sólido y complementario con energías que se enriquecen mutuamente.";
				}
			}
		});
	}
