---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/anniversary-gift-finder/#webapp",
      "name": "Buscador de Regalos de Aniversario de Boda por Año",
      "url": "https://manage.wedding/es/anniversary-gift-finder",
      "inLanguage": "es",
      "description": "Buscador gratuito de regalos de aniversario de boda por año. Descubre los materiales tradicionales y modernos (Bodas de Papel, Algodón, Cuero, Madera, Plata, Oro), flores y piedras preciosas simbólicas, y exporta ideas personalizadas a Word y PDF.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuáles son los regalos de aniversario tradicionales según los años casados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La lista tradicional incluye: 1º Año (Bodas de Papel), 2º (Algodón), 3º (Cuero), 4º (Fruta/Flores o Seda), 5º (Madera), 6º (Hierro), 7º (Lana/Cobre), 8º (Bronce/Barro), 9º (Arcilla), 10º (Estaño/Aluminio), 15º (Cristal), 20º (Porcelana), 25º (Bodas de Plata), 30º (Bodas de Perla), 40º (Bodas de Rubí), 50º (Bodas de Oro) y 60º (Bodas de Diamante)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo calcula la herramienta los años de aniversario a partir de la fecha de boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Introduce la fecha en la que os casasteis y el buscador calculará automáticamente los años transcurridos, mostrándote los materiales y regalos recomendados para vuestro próximo aniversario."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué regalar en el primer aniversario de boda (Bodas de Papel)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Opciones populares incluyen láminas enmarcadas con los votos matrimoniales o la partitura del primer baile, billetes de avión para una escapada romántica, entradas de concierto o un libro de fotos encuadernado del primer año de casados."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Cómo Elegir el Regalo de Aniversario Tradicional y Moderno",
      "description": "Guía paso a paso para acertar con el regalo de aniversario según el año de celebración.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Selecciona el Año de Aniversario o Fecha de Boda",
          "text": "Elige el año (del 1º al 60º) o introduce el día de vuestra boda para calcularlo de forma automática."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Compara los Materiales Tradicionales y Modernos",
          "text": "Revisa los materiales históricos (ej. Papel en el 1º año, Madera en el 5º, Plata en el 25º) y sus alternativas contemporáneas."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Descubre las Flores y Joyas Simbólicas",
          "text": "Consulta la flor y gema oficial asignada a cada hito matrimonial."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Filtra Ideas según los Gustos de tu Pareja",
          "text": "Encuentra experiencias románticas, detalles gastronómicos, viajes o recuerdos personalizados según tu presupuesto."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 5: Exporta la Propuesta y Dedicatoria",
          "text": "Descarga tu selección y dedicatoria romántica en Word o PDF."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Buscador de Regalos de Aniversario de Boda por Año | Manage.Wedding"
	description="Encuentra el regalo de aniversario perfecto por año (Bodas de Papel, Madera, Plata, Oro). Ideas tradicionales y modernas con exportación a Word y PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Buscador de Regalos de Aniversario" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Buscador de Regalos <span class="accent-italic">de Aniversario</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Descubre los materiales oficiales tradicionales y modernos, piedras preciosas, flores simbólicas y <strong>recomendaciones de regalos</strong> para cada año de matrimonio.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Cómo Elegir el Regalo de Aniversario en 3 Pasos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Elige el Año o Fecha de Boda
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Selecciona el año de aniversario (1º, 2º, 5º, 10º, 25º, 50º) o introduce vuestra fecha de boda.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Personaliza Estilo y Presupuesto
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Elige el perfil de tu pareja (Romántico, Experiencias, Gourmet o Hogar) y el rango de precio.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Inspírate y Exporta tu Carta
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Consulta ideas curadas y exporta una propuesta en Word o PDF con dedicatorias listas para escribir.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Quiz Form + Themes & Curated Gift Stream -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="gift-finder-grid">
			
			<!-- Left Column: Interactive Questionnaire -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🎁 Selector de Aniversario
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Selecciona el año celebrado o calcúlalo por la fecha del matrimonio
					</span>
				</div>

				<form id="gift-quiz-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- 1. Milestone Year Dropdown -->
					<div>
						<label for="select-anniversary-year" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--accent-red); margin-bottom: 0.25rem;">
							1. Selecciona el Año de Aniversario *
						</label>
						<select id="select-anniversary-year" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-heading); font-size: 1.05rem; background: #fff;">
							<option value="1" selected>1º Año — Bodas de Papel (Moderno: Relojes)</option>
							<option value="2">2º Año — Bodas de Algodón (Moderno: Porcelana)</option>
							<option value="3">3º Año — Bodas de Cuero (Moderno: Cristal / Vidrio)</option>
							<option value="4">4º Año — Bodas de Frutas y Flores (Moderno: Electrodomésticos)</option>
							<option value="5">5º Año — Bodas de Madera (Moderno: Cubertería)</option>
							<option value="6">6º Año — Bodas de Hierro / Dulce (Moderno: Objetos de Madera)</option>
							<option value="7">7º Año — Bodas de Lana / Cobre (Moderno: Accesorios de Escritorio)</option>
							<option value="8">8º Año — Bodas de Bronce / Cerámica (Moderno: Ropa de Hogar)</option>
							<option value="9">9º Año — Bodas de Arcilla / Sauce (Moderno: Artículos de Piel)</option>
							<option value="10">10º Año — Bodas de Estaño / Aluminio (Moderno: Joyería con Diamantes)</option>
							<option value="11">11º Año — Bodas de Acero (Moderno: Joyería de Moda)</option>
							<option value="12">12º Año — Bodas de Seda / Lino (Moderno: Perlas)</option>
							<option value="13">13º Año — Bodas de Encaje (Moderno: Textiles Finos)</option>
							<option value="14">14º Año — Bodas de Marfil / Hueso (Moderno: Joyas de Oro)</option>
							<option value="15">15º Año — Bodas de Cristal (Moderno: Relojes de Alta Gama)</option>
							<option value="20">20º Año — Bodas de Porcelana (Moderno: Platino)</option>
							<option value="25">25º Año — Bodas de Plata (Jubileo de Plata)</option>
							<option value="30">30º Año — Bodas de Perla (Moderno: Diamante)</option>
							<option value="35">35º Año — Bodas de Coral (Moderno: Jade)</option>
							<option value="40">40º Año — Bodas de Rubí (Jubileo de Rubí)</option>
							<option value="45">45º Año — Bodas de Zafiro</option>
							<option value="50">50º Año — Bodas de Oro (Jubileo de Oro)</option>
							<option value="55">55º Año — Bodas de Esmeralda</option>
							<option value="60">60º Año — Bodas de Diamante (Jubileo de Diamante)</option>
						</select>
					</div>

					<!-- Optional Date Calculator Accordion -->
					<details style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<summary style="font-size: 0.88rem; font-family: var(--font-heading); color: var(--accent-blue); cursor: pointer;">
							📅 O Calcular Automáticamente por la Fecha de Boda
						</summary>
						<div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.3rem;">
							<span style="font-size: 0.78rem; color: var(--text-secondary);">Indica la fecha en la que os casasteis:</span>
							<input type="date" id="input-wedding-date" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</details>

					<!-- 2. Partner's Personality Vibe -->
					<div>
						<label for="select-partner-vibe" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							2. Gustos e Intereses de tu Pareja
						</label>
						<select id="select-partner-vibe" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="sentimental" selected>💖 Sentimental y Romántico (Recuerdos, votos enmarcados, álbumes)</option>
							<option value="experiences">✈️ Experiencias y Aventura (Escapadas rurales, catas, spa)</option>
							<option value="foodie">🍷 Gourmet y Enología (Cestas gourmet, suscripción de vinos)</option>
							<option value="practical">⚡ Práctico y Tecnología (Relojes, hogar inteligente, accesorios)</option>
							<option value="home">🏡 Hogar Acogedor y Decoración (Mantas de lana, plantas, vajilla)</option>
						</select>
					</div>

					<!-- 3. Target Budget & Recipient -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="select-gift-budget" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								3. Presupuesto Objetivo
							</label>
							<select id="select-gift-budget" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="under50">Menos de 50 € (Detalle Simbólico)</option>
								<option value="50to150" selected>50 € - 150 € (Equilibrado)</option>
								<option value="150to300">150 € - 300 € (Recuerdo Especial)</option>
								<option value="300plus">Más de 300 € (Joyería / Gran Escapada)</option>
							</select>
						</div>

						<div>
							<label for="select-recipient" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								4. ¿Para Quién es el Regalo?
							</label>
							<select id="select-recipient" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="couple" selected>Para Ambos (Compartido)</option>
								<option value="her">Para Ella (Esposa / Pareja)</option>
								<option value="him">Para Él (Esposo / Pareja)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Themes & Curated Gift Stream -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Theme Overview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🎉 <span id="res-year-title">1º Aniversario de Boda</span>
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Símbolos oficiales tradicionales y modernos
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Propuesta (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimir / PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Dual Themes Comparison Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
						<div style="background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-red); font-weight: bold; display: block;">
								Materia Tradicional
							</span>
							<strong id="theme-traditional-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Papel
							</strong>
							<p id="theme-traditional-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Simboliza las páginas en blanco sobre las que escribir vuestra nueva historia juntos.
							</p>
						</div>

						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-blue); font-weight: bold; display: block;">
								Opción Moderna
							</span>
							<strong id="theme-modern-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Relojes
							</strong>
							<p id="theme-modern-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Representa el paso del tiempo y los recuerdos compartidos a lo largo de los años.
							</p>
						</div>
					</div>

					<!-- Gemstone & Flower Sub-Themes -->
					<div style="display: flex; justify-content: space-around; font-size: 0.85rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.5rem; margin-bottom: 1.25rem;">
						<span>💎 Piedra Preciosa: <strong id="theme-gemstone">Oro / Peridoto</strong></span>
						<span>🌸 Flor Simbólica: <strong id="theme-flower">Clavel</strong></span>
					</div>

					<!-- 60-Year Milestone Progress Gauge -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.25rem;">
							<span>1º (Papel)</span>
							<span>25º (Plata)</span>
							<span>50º (Oro)</span>
							<span>60º (Diamante)</span>
						</div>
						<div style="width: 100%; height: 16px; border: 1.5px solid var(--fg-pencil); border-radius: 8px; overflow: hidden; background: #eee;">
							<div id="gauge-milestone-bar" style="width: 5%; height: 100%; background: var(--accent-red); transition: width 0.4s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Curated Gift Recommendations Stream -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						🛍️ Ideas Curadas y Experiencias
					</h3>
					<div id="curated-gifts-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<!-- Injected via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Guía de Aniversario de Boda y Propuesta de Regalos</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exportado el: <span id="print-date"></span> | Aniversario: <span id="print-milestone"></span></p>
			</div>
			<div id="print-content-body"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Tabla Resumen</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Materiales Tradicionales vs. Modernos por Año
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>La Progresión del Matrimonio:</strong> Los materiales evolucionan con la fortaleza de la pareja: comienzan con elementos frágiles (<strong>1º Papel</strong>, <strong>2º Algodón</strong>, <strong>3º Cuero</strong>), avanzan a estructuras firmes (<strong>5º Madera</strong>, <strong>10º Estaño</strong>) y culminan en metales y gemas eternas (<strong>25º Plata</strong>, <strong>50º Oro</strong>, <strong>60º Diamante</strong>).
			</p>
			
			<!-- Benchmark Anniversary Milestones Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Año de Aniversario</th>
