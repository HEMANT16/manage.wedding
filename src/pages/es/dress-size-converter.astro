<script is:inline>
	const sizeChartInches = [
		{ street: '34', bridal: 2, bust: 32.0, waist: 24.0, hip: 34.5 },
		{ street: '34', bridal: 4, bust: 33.0, waist: 25.0, hip: 35.5 },
		{ street: '36', bridal: 6, bust: 34.0, waist: 26.0, hip: 36.5 },
		{ street: '38', bridal: 8, bust: 35.5, waist: 27.5, hip: 38.0 },
		{ street: '40', bridal: 10, bust: 36.5, waist: 28.5, hip: 39.5 },
		{ street: '42', bridal: 12, bust: 38.0, waist: 30.0, hip: 41.0 },
		{ street: '44', bridal: 14, bust: 39.5, waist: 31.5, hip: 42.5 },
		{ street: '46', bridal: 16, bust: 41.5, waist: 33.5, hip: 44.5 },
		{ street: '48', bridal: 18, bust: 43.5, waist: 35.5, hip: 46.5 },
		{ street: '50', bridal: 20, bust: 45.5, waist: 37.5, hip: 48.5 },
		{ street: '52', bridal: 22, bust: 47.5, waist: 39.5, hip: 50.5 },
		{ street: '54', bridal: 24, bust: 49.5, waist: 41.5, hip: 52.5 },
		{ street: '56', bridal: 26, bust: 52.0, waist: 44.0, hip: 55.0 }
	];

	let currentUnit = 'cm'; // default cm

	const bustInput = document.getElementById('input-bust');
	const waistInput = document.getElementById('input-waist');
	const hipsInput = document.getElementById('input-hips');
	const designerSelect = document.getElementById('input-designer');

	const resStreet = document.getElementById('res-street-size');
	const resBridal = document.getElementById('res-bridal-size');
	const resBodyShape = document.getElementById('res-body-shape');
	const resShapeDesc = document.getElementById('res-shape-desc');

	const barStreet = document.getElementById('bar-street');
	const barBridal = document.getElementById('bar-bridal');
	const barLabelStreet = document.getElementById('bar-label-street');
	const barLabelBridal = document.getElementById('bar-label-bridal');
	const sizeDiffNote = document.getElementById('size-diff-note');

	const matrixUs = document.getElementById('matrix-us');
	const matrixUk = document.getElementById('matrix-uk');
	const matrixEu = document.getElementById('matrix-eu');
	const matrixAu = document.getElementById('matrix-au');
	const matrixIt = document.getElementById('matrix-it');

	const alterationText = document.getElementById('alteration-advice-text');
	const silhouetteContainer = document.getElementById('silhouette-cards-container');

	function toInches(val) {
		return currentUnit === 'cm' ? val / 2.54 : val;
	}

	function calculateSizing() {
		let rawB = parseFloat(bustInput.value) || 92;
		let rawW = parseFloat(waistInput.value) || 72;
		let rawH = parseFloat(hipsInput.value) || 100;

		const bIn = toInches(rawB);
		const wIn = toInches(rawW);
		const hIn = toInches(rawH);

		let bustSizeObj = sizeChartInches.find(s => bIn <= s.bust) || sizeChartInches[sizeChartInches.length - 1];
		let waistSizeObj = sizeChartInches.find(s => wIn <= s.waist) || sizeChartInches[sizeChartInches.length - 1];
		let hipSizeObj = sizeChartInches.find(s => hIn <= s.hip) || sizeChartInches[sizeChartInches.length - 1];

		const maxBridalSize = Math.max(bustSizeObj.bridal, waistSizeObj.bridal, hipSizeObj.bridal);
		const matchedObj = sizeChartInches.find(s => s.bridal === maxBridalSize) || sizeChartInches[sizeChartInches.length - 1];

		let adjustedBridal = maxBridalSize;
		const designer = designerSelect.value;
		if (designer === 'couture') {
			adjustedBridal = Math.min(30, maxBridalSize + 2);
		} else if (designer === 'davids') {
			adjustedBridal = Math.max(2, maxBridalSize - 2);
		}

		const euBridalSize = adjustedBridal + 30; // US 10 = EU 40
		const euStreetSize = parseInt(matchedObj.street) || 38;

		let shape = 'Reloj de Arena';
		let shapeDetail = 'Pecho y cadera equilibrados con cintura definida';
		let silhouettes = [
			{ name: 'Corte Sirena / Tubo', desc: 'Realza las curvas y las proporciones armónicas de la figura.' },
			{ name: 'Corte en A Clásico', desc: 'Ceñido favorecedor a la cintura que estiliza cualquier silueta.' }
		];

		if (hIn >= bIn + 2 && (hIn - wIn) >= 8) {
			shape = 'Pera / Triangular';
			shapeDetail = 'Caderas más anchas que el pecho con cintura fina';
			silhouettes = [
				{ name: 'Princesa / Ballgown', desc: 'Falda con volumen que disimula caderas y centra la atención en el talle.' },
				{ name: 'Corte Imperio', desc: 'Caída fluida desde debajo del pecho con gran comodidad.' }
			];
		} else if (bIn >= hIn + 2) {
			shape = 'Triángulo Invertido';
			shapeDetail = 'Espalda y pecho más anchos que la cadera';
			silhouettes = [
				{ name: 'Corte A con Escote en V', desc: 'Alarga el cuello y equilibra visualmente los hombros.' },
				{ name: 'Falda con Pliegues o Volantes', desc: 'Aporta volumen a la parte inferior para lograr simetría.' }
			];
		} else if (Math.abs(bIn - hIn) <= 2 && (bIn - wIn) <= 6) {
			shape = 'Rectangular / Atlética';
			shapeDetail = 'Medidas homogéneas con cintura poco marcada';
			silhouettes = [
				{ name: 'Fit-and-Flare', desc: 'Crea el efecto visual de curvas en cintura y cadera.' },
				{ name: 'Vestido con Corsé Estructurado', desc: 'Define y esculpe el talle con varillas internas.' }
			];
		}

		resStreet.textContent = `EU ${euStreetSize}`;
		resBridal.textContent = `EU ${euBridalSize}`;
		resBodyShape.textContent = shape;
		resShapeDesc.textContent = shapeDetail;

		const maxScale = 56;
		const streetPct = Math.min(100, Math.round((euStreetSize / maxScale) * 100));
		const bridalPct = Math.min(100, Math.round((euBridalSize / maxScale) * 100));

		barStreet.style.width = `${streetPct}%`;
		barBridal.style.width = `${bridalPct}%`;
		barLabelStreet.textContent = `EU ${euStreetSize}`;
		barLabelBridal.textContent = `EU ${euBridalSize}`;

		const diff = euBridalSize - euStreetSize;
		sizeDiffNote.textContent = diff > 0 ? `+${diff / 2} Tallas arriba de la de calle` : 'Equivalente a talla de calle';

		matrixEu.textContent = `${euBridalSize}`;
		matrixUk.textContent = `${adjustedBridal + 2}`;
		matrixUs.textContent = `${adjustedBridal}`;
		matrixIt.textContent = `${adjustedBridal + 34}`;
		matrixAu.textContent = `${euBridalSize + 2}`;

		let anchor = 'cadera';
		if (bustSizeObj.bridal >= waistSizeObj.bridal && bustSizeObj.bridal >= hipSizeObj.bridal) anchor = 'pecho';
		else if (waistSizeObj.bridal >= bustSizeObj.bridal && waistSizeObj.bridal >= hipSizeObj.bridal) anchor = 'cintura';

		alterationText.innerHTML = `
			Tu contorno más amplio corresponde a <strong>${anchor} (Talla EU ${maxBridalSize + 30})</strong>. Pide la <strong>Talla EU ${euBridalSize}</strong> para que el vestido cierre con total holgura. La modista ajustará el resto de zonas en las pruebas.
		`;

		silhouetteContainer.innerHTML = '';
		silhouettes.forEach(s => {
			const div = document.createElement('div');
			div.className = 'silhouette-card';
			div.innerHTML = `
				<h5>✨ ${s.name}</h5>
				<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">${s.desc}</p>
			`;
			silhouetteContainer.appendChild(div);
		});
	}

	document.getElementById('unit-in').addEventListener('click', () => {
		if (currentUnit === 'in') return;
		currentUnit = 'in';
		document.getElementById('unit-in').classList.add('active-unit');
		document.getElementById('unit-cm').classList.remove('active-unit');
		document.querySelectorAll('.unit-label').forEach(el => el.textContent = 'pulgadas');

		bustInput.value = (parseFloat(bustInput.value) / 2.54).toFixed(1);
		waistInput.value = (parseFloat(waistInput.value) / 2.54).toFixed(1);
		hipsInput.value = (parseFloat(hipsInput.value) / 2.54).toFixed(1);
		calculateSizing();
	});

	document.getElementById('unit-cm').addEventListener('click', () => {
		if (currentUnit === 'cm') return;
		currentUnit = 'cm';
		document.getElementById('unit-cm').classList.add('active-unit');
		document.getElementById('unit-in').classList.remove('active-unit');
		document.querySelectorAll('.unit-label').forEach(el => el.textContent = 'cm');

		bustInput.value = (parseFloat(bustInput.value) * 2.54).toFixed(1);
		waistInput.value = (parseFloat(waistInput.value) * 2.54).toFixed(1);
		hipsInput.value = (parseFloat(hipsInput.value) * 2.54).toFixed(1);
		calculateSizing();
	});

	document.querySelectorAll('.preset-meas-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			let b = parseFloat(btn.getAttribute('data-b'));
			let w = parseFloat(btn.getAttribute('data-w'));
			let h = parseFloat(btn.getAttribute('data-h'));

			if (currentUnit === 'in') {
				b = (b / 2.54).toFixed(1);
				w = (w / 2.54).toFixed(1);
				h = (h / 2.54).toFixed(1);
			}

			bustInput.value = b;
			waistInput.value = w;
			hipsInput.value = h;
			calculateSizing();
		});
	});

	bustInput.addEventListener('input', calculateSizing);
	waistInput.addEventListener('input', calculateSizing);
	hipsInput.addEventListener('input', calculateSizing);
	designerSelect.addEventListener('change', calculateSizing);

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const rawB = bustInput.value;
		const rawW = waistInput.value;
		const rawH = hipsInput.value;
		const unit = currentUnit === 'in' ? 'pulgadas' : 'cm';

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Ficha de Medidas de Vestido de Novia</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Ficha Técnica de Medidas de Novia</h1>
				<p>Generada el ${new Date().toLocaleDateString('es-ES')} | Para Modista y Asesora de Atelier</p>
				
				<h3>Medidas de la Novia:</h3>
				<table>
					<thead>
						<tr><th>Zona Corporal</th><th>Medida</th><th>Observaciones</th></tr>
					</thead>
					<tbody>
						<tr><td><strong>Pecho</strong></td><td>${rawB} ${unit}</td><td>Medido con la lencería nupcial</td></tr>
						<tr><td><strong>Cintura</strong></td><td>${rawW} ${unit}</td><td>Medido en el punto natural más estrecho</td></tr>
						<tr><td><strong>Cadera</strong></td><td>${rawH} ${unit}</td><td>Medido en el punto máximo de los glúteos</td></tr>
					</tbody>
				</table>

				<h3 style="margin-top:20px;">Recomendación de Talla:</h3>
				<table>
					<thead>
						<tr><th>Estándar</th><th>Talla</th><th>Detalle</th></tr>
					</thead>
					<tbody>
						<tr><td><strong>Talla Novia Recomendada</strong></td><td><strong>${resBridal.textContent}</strong></td><td>Ajustada a la medida mayor</td></tr>
						<tr><td><strong>Talla de Calle</strong></td><td>${resStreet.textContent}</td><td>Ropa comercial</td></tr>
						<tr><td><strong>Talla UK</strong></td><td>${matrixUk.textContent}</td><td>Reino Unido / Australia</td></tr>
						<tr><td><strong>Talla US</strong></td><td>${matrixUs.textContent}</td><td>Estados Unidos</td></tr>
						<tr><td><strong>Silueta Recomendada</strong></td><td>${resBodyShape.textContent}</td><td>${resShapeDesc.textContent}</td></tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Ficha_Medidas_Novia_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const printDate = document.getElementById('print-date');
		const printMeasBody = document.getElementById('print-meas-body');
		const printRecSize = document.getElementById('print-rec-size');
		const printStreetSize = document.getElementById('print-street-size');
		const printBodyShape = document.getElementById('print-body-shape');
		const printAlterationNote = document.getElementById('print-alteration-note');

		printDate.textContent = new Date().toLocaleDateString('es-ES');
		const unit = currentUnit === 'in' ? 'pulgadas' : 'cm';

		printMeasBody.innerHTML = `
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">1. Contorno de Pecho</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${bustInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Con lencería nupcial</td>
			</tr>
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">2. Cintura Natural</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${waistInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Punto más estrecho del torso</td>
			</tr>
			<tr>
				<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">3. Cadera Completa</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${hipsInput.value} ${unit}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">Zona más ancha de glúteos</td>
			</tr>
		`;

		printRecSize.textContent = `${resBridal.textContent} (UK ${matrixUk.textContent} / US ${matrixUs.textContent})`;
		printStreetSize.textContent = resStreet.textContent;
		printBodyShape.textContent = `${resBodyShape.textContent} (${resShapeDesc.textContent})`;
		printAlterationNote.textContent = alterationText.textContent;

		window.print();
	});

	calculateSizing();
</script>
