---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/dress-size-converter/#webapp",
      "name": "Conversor de Tallas de Vestido de Novia y Calculadora de Medidas",
      "url": "https://manage.wedding/es/dress-size-converter",
      "inLanguage": "es",
      "description": "Calculadora gratuita de tallas de vestido de novia. Convierte tus medidas de pecho, cintura y cadera a tallas españolas/europeas (EU), UK y US. Descubre siluetas favorecedoras y exporta tu ficha técnica de medidas para la modista.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Por qué la talla de novia suele ser más grande que la talla de calle habitual?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las firmas nupciales siguen utilizando tablas de patronaje de alta costura tradicional con tejidos rígidos y sin elastano. A lo largo de las décadas, la moda urbana adoptó el vanity sizing (etiquetar tallas más pequeñas para las mismas medidas), mientras que la moda nupcial se mantuvo fiel al patronaje clásico. Por ello, la talla de novia suele ser de 1 a 2 números mayor que la ropa de calle."
          }
        },
        {
          "@type": "Question",
          "name": "¿A qué medida debo hacer caso al encargar mi vestido de novia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Encarga siempre la talla que corresponda a tu medida corporal más grande (entre pecho, cintura y cadera). Para una modista es una operación estándar meter costados o entallar, pero sacar tela resulta muy difícil o imposible debido a los márgenes de costura mínimos (de 1 a 1,5 cm)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo tomarse las medidas correctamente en casa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usa una cinta métrica flexible de costura. 1) Pecho: rodea la parte más voluminosa del pecho llevando la ropa interior prevista para la boda. 2) Cintura: rodea tu cintura natural (la zona más estrecha, 2-3 cm sobre el ombligo). 3) Cadera: rodea la parte más ancha de los glúteos con los pies juntos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Utilizan todas las marcas nupciales la misma tabla de tallas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Las casas de alta costura españolas y europeas (como Pronovias o Rosa Clará) suelen tener un patronaje entallado en caja torácica y cadera alta, mientras que las marcas americanas se aproximan más a las tallas comerciales."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Cómo Medirte y Convertir tu Talla de Vestido de Novia",
      "description": "Instrucciones paso a paso para medirte y convertir tus medidas a tallas de novia de España (EU), Reino Unido y Estados Unidos.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Toma las 3 Medidas Clave",
          "text": "Con una cinta métrica de sastre, mide el contorno de pecho en su punto máximo, cintura natural y cadera completa en la parte más ancha de los glúteos."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Compara con la Tabla Nupcial",
          "text": "Compara tus centímetros con las tablas oficiales de confección nupcial europea e internacional."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Elige la Talla de tu Medida Mayor",
          "text": "Selecciona la talla que cubra tu contorno más amplio. Ajustar y entallar el resto del vestido en las pruebas es sencillo y habitual."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Exporta tu Ficha de Medidas",
          "text": "Descarga la ficha técnica en Word o PDF para llevarla a tu cita en la tienda de novias o atelier de costura."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Conversor de Tallas de Vestido de Novia y Medidas | Manage.Wedding"
	description="Calcula tu talla exacta de vestido de novia en España (EU), UK y US a partir de tus medidas de pecho, cintura y cadera. Exporta tu ficha para la modista."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Conversor de Tallas de Vestido de Novia" category="attire-rings" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Tallas de Vestido de Novia y <span class="accent-italic">Medidas</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Encuentra tu talla nupcial exacta en estándares de España/Europa (EU), Reino Unido (UK) y EE. UU. (US). Compara tu talla de calle con la de novia y exporta tu <strong>Ficha Técnica de Medidas</strong>.
				</p>
			</div>
		</section>

		<!-- Main Interactive Sizing Studio Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 380px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="dress-calc-grid">
			
			<!-- Left Column: Input Form Card -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						📏 Medidas Corporales
					</h2>
					
					<!-- Unit Switcher -->
					<div style="display: flex; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden;">
						<button type="button" id="unit-cm" class="unit-toggle-btn active-unit">cm</button>
						<button type="button" id="unit-in" class="unit-toggle-btn">Pulgadas (in)</button>
					</div>
				</div>

				<form id="dress-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Bust -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-bust" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								1. Contorno de Pecho (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Punto más amplio con sujetador</span>
						</div>
						<input type="number" step="0.5" id="input-bust" value="92" min="50" max="180" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Waist -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-waist" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								2. Cintura Natural (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Zona más estrecha del torso</span>
						</div>
						<input type="number" step="0.5" id="input-waist" value="72" min="40" max="160" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Hips -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-hips" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								3. Cadera Completa (<span class="unit-label">cm</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Punto más ancho de glúteos</span>
						</div>
						<input type="number" step="0.5" id="input-hips" value="100" min="50" max="200" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Designer Preference -->
					<div>
						<label for="input-designer" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							Patronaje del Diseñador / Firma
						</label>
						<select id="input-designer" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="standard" selected>Patronaje Estándar Nupcial Europeo (Media)</option>
							<option value="couture">Alta Costura Española / Europea (Pronovias, Rosa Clará - Talla Ajustada)</option>
							<option value="davids">Moda Nupcial Prêt-à-Porter (David's Bridal, BHLDN)</option>
							<option value="maggie">Maggie Sottero / Diseñadores Internacionales</option>
						</select>
					</div>

					<!-- Sample Presets -->
					<div style="margin-top: 0.5rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
						<span class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							⚡ Medidas de Ejemplo Rápido:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem;">
							<button type="button" class="preset-meas-btn" data-b="86" data-w="66" data-h="94">Talla 36/38 (86-66-94)</button>
							<button type="button" class="preset-meas-btn" data-b="95" data-w="75" data-h="103">Talla 40/42 (95-75-103)</button>
							<button type="button" class="preset-meas-btn" data-b="110" data-w="90" data-h="118">Talla 46/48 (110-90-118)</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Interactive Results, Sizing Badges, International Matrix & Silhouette Guide -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Sizing Results Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								👗 Tu Talla Nupcial Recomendada
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								Calculada para encajar con tu medida corporal mayor
							</span>
						</div>

						<!-- Exports -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar a Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Ficha en PDF
							</button>
						</div>
					</div>

					<!-- Side by Side Sizing Comparison Boxes -->
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Street Size -->
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Talla de Calle Habitual</span>
							<strong id="res-street-size" class="font-heading" style="font-size: 2.2rem; color: var(--accent-blue); display: block; line-height: 1.2;">EU 38</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Ropa comercial diaria</span>
						</div>

						<!-- Primary Bridal Size -->
						<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1rem; text-align: center; position: relative;">
							<span style="position: absolute; top: -10px; right: 10px; background: var(--accent-red); color: #fff; font-size: 0.7rem; font-weight: bold; padding: 2px 6px; border-radius: 10px;">PEDIR ESTA</span>
							<span class="font-body" style="font-size: 0.85rem; color: var(--accent-red); display: block; font-weight: bold;">Talla de Novia Recomendada</span>
							<strong id="res-bridal-size" class="font-heading" style="font-size: 2.2rem; color: var(--accent-red); display: block; line-height: 1.2;">EU 40</strong>
							<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold;">+1 talla (Estándar)</span>
						</div>

						<!-- Body Shape Archetype -->
						<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Silueta Corporal</span>
							<strong id="res-body-shape" class="font-heading" style="font-size: 1.25rem; color: #15803d; display: block; line-height: 1.3; margin: 0.4rem 0;">Reloj de Arena</strong>
							<span id="res-shape-desc" style="font-size: 0.75rem; color: #166534; display: block;">Pecho y cadera equilibrados</span>
						</div>

					</div>

					<!-- Visual Comparison Bar -->
					<div style="margin-bottom: 1.5rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
							<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Diferencia: Ropa de Calle vs. Vestido de Novia</span>
							<span id="size-diff-note" class="font-body" style="font-size: 0.85rem; color: var(--accent-red); font-weight: bold;">+1 Talla Nupcial</span>
						</div>
						<div style="display: flex; flex-direction: column; gap: 0.5rem;">
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="width: 80px; font-size: 0.85rem; font-weight: bold;">Calle:</span>
								<div style="flex: 1; height: 18px; background: #e5e7eb; border-radius: 4px; border: 1px solid var(--fg-pencil); overflow: hidden;">
									<div id="bar-street" style="height: 100%; width: 30%; background: var(--accent-blue); transition: width 0.4s ease;"></div>
								</div>
								<span id="bar-label-street" style="width: 60px; font-size: 0.9rem; font-weight: bold;">EU 38</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="width: 80px; font-size: 0.85rem; font-weight: bold; color: var(--accent-red);">Novia:</span>
								<div style="flex: 1; height: 18px; background: #e5e7eb; border-radius: 4px; border: 1px solid var(--fg-pencil); overflow: hidden;">
									<div id="bar-bridal" style="height: 100%; width: 45%; background: var(--accent-red); transition: width 0.4s ease;"></div>
								</div>
								<span id="bar-label-bridal" style="width: 60px; font-size: 0.9rem; font-weight: bold; color: var(--accent-red);">EU 40</span>
							</div>
						</div>
					</div>

					<!-- International Conversion Matrix Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🌐 Tabla de Equivalencia Internacional de Tallas
						</h4>
						<div style="overflow-x: auto;">
							<table style="width: 100%; border-collapse: collapse; text-align: center; font-size: 0.95rem; font-family: var(--font-body);">
								<thead>
									<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Región</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--accent-red);">España / EU</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">UK Novia</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">US Novia</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Italia (IT)</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Francia (FR)</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">Tu Talla</td>
										<td id="matrix-eu" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">40</td>
										<td id="matrix-uk" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">12</td>
										<td id="matrix-us" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">10</td>
										<td id="matrix-it" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">44</td>
										<td id="matrix-au" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">42</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>

					<!-- Measurement Anchor Alert & Alteration Guidance -->
					<div style="background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<strong class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							✂️ Consejo de Modista para el Pedido:
						</strong>
						<p id="alteration-advice-text" class="font-body" style="font-size: 0.95rem; margin: 0; line-height: 1.5; color: var(--fg-pencil);">
							Tu medida más amplia corresponde a la cadera (Talla EU 40). Pide siempre la talla 40 para que el vestido cierre con soltura; la modista entallará fácilmente el pecho y cintura durante las pruebas.
						</p>
					</div>

				</div>

				<!-- Flattering Gown Silhouette Recommendations Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
						<span>✨</span> Siluetas de Vestido más Favorecedoras para tu Figura
					</h3>
					<div id="silhouette-cards-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;"></div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Ficha Oficial de Medidas de Novia</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado el: <span id="print-date"></span> | Para Modista y Asesora de Atelier</p>
			</div>
			
			<table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 8px; text-align: left;">Zona Corporal</th>
						<th style="border: 1px solid #ccc; padding: 8px; text-align: center;">Medida de la Novia</th>
						<th style="border: 1px solid #ccc; padding: 8px; text-align: center;">Observaciones</th>
					</tr>
				</thead>
				<tbody id="print-meas-body"></tbody>
			</table>

			<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px; background: #fafafa;">
				<h3 style="margin: 0 0 8px 0; font-size: 15px;">Resumen de Talla Recomendada:</h3>
				<p style="margin: 4px 0;">• <strong>Talla Nupcial a Encargar:</strong> <span id="print-rec-size"></span></p>
				<p style="margin: 4px 0;">• <strong>Talla de Calle Habitual:</strong> <span id="print-street-size"></span></p>
				<p style="margin: 4px 0;">• <strong>Morfología Corporal:</strong> <span id="print-body-shape"></span></p>
				<p style="margin: 4px 0;">• <strong>Nota para Arreglos:</strong> <span id="print-alteration-note"></span></p>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Regla de Oro</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Tabla Resumen: Talla de Calle vs. Talla de Novia (España y Europa)
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
