---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-sparkler-calculator/#webapp",
      "name": "Calculadora de Bengalas de Boda y Carteles Imprimibles Gratis",
      "url": "https://manage.wedding/es/wedding-sparkler-calculator",
      "inLanguage": "es",
      "description": "Calcula bengalas exactas para tu boda (50cm vs 90cm), ventana de fotos, sopletes de butano y cubos de arena. Incluye carteles imprimibles 'Que el Amor Brille' y fichas de seguridad gratis.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Organizar una Despedida con Bengalas de Boda Segura y Espectacular",
      "description": "Guía paso a paso para coordinadores y novios para sincronizar el encendido en cadena y crear un pasillo de luz inolvidable.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Calcula los Invitados Reales y el Tamaño de la Bengala",
          "text": "Ten en cuenta que entre un 25% y 35% de invitados se marchan antes del final de la fiesta. Escoge bengalas de 50 cm (90-120s de duración) o 90 cm (210-240s) con alma metálica sin humo."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Prepara Cubos Metálicos con Arena o Agua",
          "text": "Coloca cubos de zinc con arena húmeda o agua al inicio y al final del pasillo para que los invitados apaguen las varillas calientes de inmediato."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Forma Dos Filas Paralelas con 3 Metros de Separación",
          "text": "Coloca a los invitados en dos líneas dejando al menos 3 a 3,5 metros de pasillo central para proteger el vestido de novia, velo y peinado de las chispas."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Ejecuta la Ola de Encendido en Cadena",
          "text": "Asigna 1 responsable con soplete de butano por cada 8-10 invitados. Enciende la primera bengala de cada grupo y haz que los invitados se pasen el fuego punta con punta en 20 segundos."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 5: Paseo Lento, Beso en el Centro y Apagado Inmediato",
          "text": "Los novios caminan despacio, se detienen en el centro para las fotos y beso, y al terminar todos clavan las bengalas en la arena."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué tamaño de bengalas es el mejor para una boda: 25cm, 50cm o 90cm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las bengalas de 50 cm (20 pulgadas, duración de 90 a 120 segundos) son el estándar de oro para bodas de 50 a 150 invitados. Las de 90 cm (36 pulgadas, 3,5 a 4 minutos) son ideales para bodas grandes de más de 150 invitados o escalinatas largas. Las bengalas pequeñas de 25 cm (10 pulgadas) solo duran 30-40 segundos y NO se recomiendan para salidas de boda porque se apagan las primeras antes de encender las últimas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué las fincas y salones exigen bengalas sin humo con alma de alambre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las bengalas sin humo de alambre de acero no producen ceniza que caiga ardiendo ni humo denso. Las bengalas con varilla de madera o bambú generan una humareda gris asfixiante que arruina las fotos, sueltan ascuas que queman los vestidos y activan las alarmas de incendios."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas bengalas se deben comprar por invitado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para bengalas de 50 cm o 90 cm, 1 bengala por invitado presente más un 15% de margen de seguridad para pruebas y fotos es suficiente. Si usas bengalas de 25 cm o tu grupo es muy animado, calcula 2 bengalas por persona."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo encender 100 bengalas a la vez sin que se apaguen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nunca uses cerillas ni mecheros normales. Asigna capitanes de fuego equipados con sopletes de butano antiviento (de cocina). Cada soplete enciende una bengala y los invitados tocan punta con punta en efecto dominó. Todo el pasillo se enciende en apenas 20 segundos."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Bengalas de Boda — Carteles Imprimibles Gratis «Que el Amor Brille» & Guía"
	description="Calcula bengalas necesarias (50cm vs 90cm), ventana de fotos, mecheros de butano y cubos de arena. Incluye carteles imprimibles 'Que el Amor Brille' y tarjetas de seguridad gratis."
	lang="es"
	schema={schema}
>
	<!-- Include html2canvas for instant image capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Calculadora de Bengalas de Boda" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center; position: relative;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.25rem 1rem 1.75rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratis • Bengalas de Alambre Sin Humo • Carteles Imprimibles en PDF y Word</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(28px, 4.5vw, 50px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de Bengalas <span class="accent-italic" style="color: #b45309; text-shadow: 1px 1px 0px #fef08a;">y Carteles Imprimibles</span>
				</h1>
				<p class="font-body" style="font-size: 1.125rem; color: var(--text-secondary); max-width: 820px; margin: 0 auto; line-height: 1.6;">
					Calcula el número exacto de bengalas (50cm vs 90cm), ventana de fotos según la combustión, sopletes de butano antiviento y cubos de arena. Incluye guión para el coordinador y <strong>carteles decorativos imprimibles «Que el Amor Brille»</strong>.
				</p>
			</div>
		</section>

		<!-- Visual Step-by-Step "How to Use This Tool" Guide -->
		<section class="hand-card" style="padding: 1.5rem; background: #fffdfa; margin-bottom: 2.5rem; border: 2px solid var(--fg-pencil);">
			<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
				<span style="font-size: 1.4rem;">💡</span>
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0;">
					Cómo Usar Esta Calculadora (En 3 Sencillos Pasos)
				</h2>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
				
				<!-- Guide Step 1 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">1</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Número de Invitados y Horario</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Introduce tus invitados confirmados y la hora de la salida. Si es muy tarde (23:00+), un ~30% se marcha antes; la herramienta ajusta las unidades para no gastar de más.
					</p>
				</div>

				<!-- Guide Step 2 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">2</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Elige Bengalas de 50cm o 90cm</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Elige <strong>50 cm (2 min de luz)</strong> para bodas estándar (40–150 invitados) o <strong>90 cm (4 min)</strong> para más de 150 personas y fotos con calma.
					</p>
				</div>

				<!-- Guide Step 3 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">3</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Lista de Compra y Carteles</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Obtén los paquetes exactos, sopletes y cubos de arena. Personaliza vuestros nombres para imprimir el <strong>cartel de mesa enmarcable y tarjetas de seguridad</strong> en 1 clic.
					</p>
				</div>

			</div>
		</section>

		<!-- Main Interactive Calculator Studio -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; margin-bottom: 3rem; align-items: start;">
			
			<!-- Left Column: Inputs & Configuration -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #ffffff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.35rem; margin: 0; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
						<span>⚙️</span> Configuración de la Salida
					</h2>
					<span style="font-size: 0.78rem; font-weight: 700; background: #fef08a; border: 1.5px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
						Cálculo en Vivo
					</span>
				</div>

				<!-- Step 1: Total Invited Guests Headcount -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem;">
						<label class="form-label" for="slider-guests" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							1. Total de Invitados Confirmados:
						</label>
						<span id="label-guest-count" style="font-weight: 800; font-size: 1.15rem; color: #b45309; background: #fef3c7; border: 1.5px solid #d97706; padding: 2px 10px; border-radius: 6px;">
							120 invitados
						</span>
					</div>
					<input type="range" id="slider-guests" min="15" max="400" value="120" step="5" style="width: 100%; accent-color: #b45309; cursor: pointer;" />
					<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.2rem;">
						<span>15 (Íntima)</span>
						<span>75 (Pequeña)</span>
						<span>120 (Media)</span>
						<span>250 (Grande)</span>
						<span>400+</span>
					</div>
				</div>

				<!-- Step 2: Send-Off Timing -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label class="form-label" for="select-timing-preset" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem; margin-bottom: 0.3rem; display: block;">
						2. ¿A Qué Hora Será la Despedida con Bengalas?
					</label>
					<select id="select-timing-preset" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc; border: 2px solid var(--fg-pencil); width: 100%; padding: 0.6rem; border-radius: 6px; font-size: 0.9rem;">
						<option value="late-night" selected>🌙 Final de Fiesta de Noche (23:00+) — ~70% de Invitados Siguen</option>
						<option value="staged">🍰 Salida Simulada Temprana (21:30 tras la Tarta) — ~95% Presentes</option>
						<option value="ceremony">🌅 Salida de Ceremonia / Atardecer — 100% Presentes</option>
						<option value="custom">🎛️ Porcentaje Personalizado</option>
					</select>
					
					<div id="custom-retention-box" style="display: none; margin-top: 0.75rem; padding: 0.75rem; background: #fffbeb; border: 1.5px dashed #d97706; border-radius: 6px;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
							<label style="font-size: 0.85rem; font-weight: 700; color: #92400e;">Tasa de Asistencia:</label>
							<span id="label-retention-val" style="font-weight: 800; color: #92400e;">70%</span>
						</div>
						<input type="range" id="slider-retention" min="40" max="100" value="70" step="5" style="width: 100%; accent-color: #d97706;" />
					</div>

					<div style="background: #f8fafc; border-left: 3px solid #b45309; padding: 0.5rem 0.75rem; margin-top: 0.5rem; border-radius: 0 4px 4px 0;">
						<p style="font-size: 0.82rem; color: #475569; margin: 0; line-height: 1.45;">
							👥 <strong>Asistencia Real:</strong> <strong id="retention-summary-text" style="color: #b45309;">84 invitados</strong> presentes (<span id="attrition-summary-text">36 invitados</span> se marchan antes por cansancio o niños).
						</p>
					</div>
				</div>

				<!-- Step 3: Sparkler Length & Burn Time Selector -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label class="form-label" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem; margin-bottom: 0.4rem; display: block;">
						3. Elige el Tamaño de las Bengalas:
					</label>
					
					<div class="sparkler-size-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem;">
						<!-- 50 cm / 20-inch option -->
						<label class="size-pill active" id="card-len-20" style="border: 2px solid #b45309; background: #fffbeb; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative; box-shadow: 0 0 0 1px #b45309;">
							<input type="radio" name="sparkler-len" value="20" checked style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 800; color: #92400e; background: #fef08a; border: 1px solid #d97706; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">⭐ Ideal</span>
							<strong style="display: block; font-size: 0.9rem; color: #92400e; line-height: 1.15;">50 cm (20")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #b45309; margin-top: 1px;">2 Min Fuego</span>
							<span style="display: block; font-size: 0.67rem; color: #78350f; margin-top: 1px;">40–150 Invitados</span>
						</label>

						<!-- 90 cm / 36-inch option -->
						<label class="size-pill" id="card-len-36" style="border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative;">
							<input type="radio" name="sparkler-len" value="36" style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 700; color: #0369a1; background: #e0f2fe; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">👑 Gran Formato</span>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil); line-height: 1.15;">90 cm (36")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #0369a1; margin-top: 1px;">4 Min Fuego</span>
							<span style="display: block; font-size: 0.67rem; color: #64748b; margin-top: 1px;">150+ Invitados</span>
						</label>

						<!-- 25 cm / 10-inch option -->
						<label class="size-pill" id="card-len-10" style="border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative;">
							<input type="radio" name="sparkler-len" value="10" style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 700; color: #991b1b; background: #fee2e2; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">⚠️ Cortas</span>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil); line-height: 1.15;">25 cm (10")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #dc2626; margin-top: 1px;">35s Fuego</span>
							<span style="display: block; font-size: 0.67rem; color: #64748b; margin-top: 1px;">&lt;25 Invitados</span>
						</label>
					</div>
				</div>

				<!-- Sparklers Per Guest & Buffer Options -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem;">
					<div>
						<label class="form-label" for="select-sparklers-per-guest" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.85rem;">
							Bengalas por Invitado:
						</label>
						<select id="select-sparklers-per-guest" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<option value="1" selected>1 Bengala (Estándar)</option>
							<option value="2">2 Bengalas (Doble Luz / Repuesto)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="select-buffer-pct" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.85rem;">
							Margen de Seguridad:
						</label>
						<select id="select-buffer-pct" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<option value="15" selected>+15% Margen (Recomendado)</option>
							<option value="10">+10% Margen</option>
							<option value="20">+20% Margen Extra</option>
							<option value="0">0% Justo</option>
						</select>
					</div>
				</div>

				<!-- Step 4: Couple Names & Target Send-Off Time -->
				<div style="border-top: 1.5px dashed #cbd5e1; padding-top: 1.25rem;">
					<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
						<h3 class="font-heading" style="font-size: 1.05rem; margin: 0; color: var(--fg-pencil);">
							4. Personaliza Carteles Imprimibles y Horario:
						</h3>
						<span style="font-size: 0.72rem; color: #166534; background: #dcfce7; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Actualiza el Cartel Abajo ⬇️</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="input-couple-names" style="font-size: 0.82rem; font-weight: 600;">Nombres de los Novios:</label>
							<input type="text" id="input-couple-names" class="form-input" value="Elena & Marcos" placeholder="ej. Lucía y Carlos" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						</div>
						<div>
							<label class="form-label" for="input-exit-time" style="font-size: 0.82rem; font-weight: 600;">Hora Prevista:</label>
							<input type="text" id="input-exit-time" class="form-input" value="23:45" placeholder="ej. 23:45" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Results & Equipment Blueprint -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Metric Hero Card -->
				<div class="hand-card shadow-hard" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fffdfa; border: 3px solid var(--fg-pencil); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
						<div>
							<span style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #92400e;">
								Recomendación de Compra
							</span>
							<h3 class="font-heading" style="font-size: 1.35rem; margin: 0.2rem 0 0; color: var(--fg-pencil);">
								Total de Bengalas a Pedir
							</h3>
						</div>
						<div id="badge-pack-size" style="background: #fef08a; border: 2px solid var(--fg-pencil); padding: 4px 10px; border-radius: 6px; font-weight: 800; font-size: 0.85rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
							~12 Packs (8 uds)
						</div>
					</div>

					<div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.5rem;">
						<span id="res-total-sparklers" style="font-size: clamp(3rem, 6vw, 4.2rem); font-weight: 900; color: #b45309; line-height: 1; font-family: var(--font-heading);">
							97
