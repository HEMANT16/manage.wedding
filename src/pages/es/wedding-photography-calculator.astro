---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calculadora de Horas de Fotografía para Boda",
      "url": "https://manage.wedding/es/wedding-photography-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calcula el paquete exacto de horas de fotografía para boda (6h, 8h, 10h o 12h), necesidad de segundo fotógrafo, fotos editadas entregadas y lista de tomas.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calculadora de Horas de Fotografía para Boda — Paquetes y Cronograma"
	description="Calcula cuántas horas de fotógrafo contratar (6h, 8h, 10h o 12h), necesidad de segundo fotógrafo, fotos entregadas, presupuesto y lista de tomas imprimible."
	lang="es"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Miga de pan" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href=""" style="color: var(--text-secondary); text-decoration: none;">Inicio</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/es/budget" style="color: var(--text-secondary); text-decoration: none;">Presupuesto</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Fotografía de Boda</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>📸</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Planificador de Paquetes y Cronograma de Tomas</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calculadora de Horas de Fotografía para Boda
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Descubre si necesitas un paquete de <strong>6, 8, 10 o 12 horas</strong>, si es imprescindible un segundo fotógrafo, el número de fotos editadas que recibirás y exporta tu lista de tomas familiares.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Checklist -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>⏱️</span> 1. Momentos Clave del Día
				</h2>

				<!-- Headcount & General Parameters -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-guest-count" style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.2rem;">
							Número de Invitados:
						</label>
						<input type="number" id="input-guest-count" min="10" max="600" value="120" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="select-venue-locations" style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.2rem;">
							Ubicaciones / Trayectos:
						</label>
						<select id="select-venue-locations" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="single" selected>1 Finca Todo Incluido (0 min)</option>
							<option value="two">2 Ubicaciones (Hotel -> Finca, +30 min)</option>
							<option value="three">3 Ubicaciones (Hotel -> Iglesia -> Finca, +60 min)</option>
						</select>
					</div>
				</div>

				<!-- Milestones Checkboxes -->
				<div style="display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.25rem;">
					
					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-prep-details" checked data-minutes="90" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Preparativos y Detalles (+1,5 h)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Vestido, anillos, zapatos, maquillaje, brindis inicial.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-first-look" checked data-minutes="45" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">First Look / Primer Encuentro (+45 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Encuentro íntimo de la pareja antes de la ceremonia y fotos a solas.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-wedding-party" checked data-minutes="35" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Damas de Honor y Padrinos (+35 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Fotos de grupo del cortejo con peinados y maquillaje intactos.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-family-formals" checked data-minutes="40" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Fotos Familiares Formales (+40 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">10–12 combinaciones familiares (padres, hermanos, abuelos).</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #fef08a;" class="milestone-label">
						<input type="checkbox" id="chk-ceremony" checked disabled data-minutes="60" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Ceremonia Nuzial (+60 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Entrada, votos, anillos, primer beso, salida con arroz.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-cocktail-details" checked data-minutes="45" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Cóctel de Bienvenida y Decoración Salón (+45 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Fotos espontáneas de invitados y salón antes de que se sienten.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-reception-events" checked data-minutes="90" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Entrada al Banquete, Discursos y Cena (+1,5 h)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Entrada triunfal, brindis, corte de tarta y mesas.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-sunset-portraits" checked data-minutes="20" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Sesión Golden Hour / Atardecer (+20 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Retratos de pareja con luz dorada antes de anochecer.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-dancing" checked data-minutes="45" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Primer Baile y Fiesta Inicial (+45 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Baile nupcial, baile con padres y euforia en la pista.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-grand-exit" data-minutes="30" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Despedida con Bengalas / Salida Final (+30 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Pasillo de bengalas o fuegos artificiales al final de la noche.</span>
						</div>
					</label>

				</div>

				<!-- Hourly Rate Sizer -->
				<div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
					<label for="input-hourly-rate" style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.25rem;">
						Tarifa Estimada del Fotógrafo (€/hora):
					</label>
					<div style="display: flex; gap: 0.5rem; align-items: center;">
						<input type="number" id="input-hourly-rate" min="100" max="1500" step="50" value="250" style="width: 120px; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
						<span style="font-size: 0.8rem; color: var(--text-muted);">(Media habitual: 200 € a 400 € / hora)</span>
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Recomendación</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Paquete Fotográfico Ideal
						</h2>
					</div>
					<span id="badge-package-tier" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">Paquete 8 Horas</span>
				</div>

				<!-- Big Number Highlights -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Horas a Contratar</span>
						<strong id="stat-package-hours" style="font-size: 2rem; font-weight: 900; color: #1e40af; line-height: 1.1;">8 Horas</strong>
						<span id="stat-exact-time-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(7 h 25 min tiempo total)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Presupuesto Estimado</span>
						<strong id="stat-estimated-budget" style="font-size: 2rem; font-weight: 900; color: #15803d; line-height: 1.1;">2.000 €</strong>
						<span id="stat-budget-subtext" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">Basado en 250 €/hora</span>
					</div>
				</div>

				<!-- Secondary Details & Second Shooter Matrix -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">📷 Segundo Fotógrafo:</span>
						<strong id="stat-second-shooter" style="color: #1e40af;">Muy Recomendado</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🖼️ Fotos Editadas Estimadas:</span>
						<strong id="stat-gallery-yield" style="color: #15803d;">450 a 600 Fotos</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🚗 Trayectos y Desplazamientos:</span>
						<strong id="stat-travel-time" style="color: var(--fg-pencil);">0 min (Mismo lugar)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0;">
						<span style="color: #475569;">🛡️ Margen de Seguridad:</span>
						<strong id="stat-overtime-buffer" style="color: #16a34a;">Tranquilo (35 min de margen)</strong>
					</div>
				</div>

				<!-- Second Shooter Decision Box -->
				<div style="background: #fef08a; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; margin-bottom: 1.25rem; font-size: 0.85rem;" id="box-second-shooter-reason">
					<strong style="color: var(--fg-pencil); display: block; margin-bottom: 0.25rem;">📸 Necesidad de Segundo Fotógrafo:</strong>
					<span id="stat-shooter-reason" style="color: #334155;">
						Con <strong>más de 120 invitados</strong>, un segundo fotógrafo captura el cóctel mientras se hacen las fotos familiares y capta ángulos dobles en la ceremonia.
					</span>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-export-pdf" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Imprimir PDF
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Exportar Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/es/wedding-photography-calculator" category="budget" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-photo-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Plan de Cobertura y Cronograma Fotográfico</h1>
				<p id="print-photo-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Resumen del Paquete de Fotografía | Generado por Manage.Wedding</p>
			</div>
			<div id="print-photo-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const inputGuestCount = document.getElementById('input-guest-count');
	const selectVenueLocations = document.getElementById('select-venue-locations');
	const inputHourlyRate = document.getElementById('input-hourly-rate');

	const checkboxes = [
		document.getElementById('chk-prep-details'),
		document.getElementById('chk-first-look'),
		document.getElementById('chk-wedding-party'),
		document.getElementById('chk-family-formals'),
		document.getElementById('chk-ceremony'),
		document.getElementById('chk-cocktail-details'),
		document.getElementById('chk-reception-events'),
		document.getElementById('chk-sunset-portraits'),
		document.getElementById('chk-dancing'),
		document.getElementById('chk-grand-exit')
	];

	const badgePackageTier = document.getElementById('badge-package-tier');
	const statPackageHours = document.getElementById('stat-package-hours');
	const statExactTimeSub = document.getElementById('stat-exact-time-sub');
	const statEstimatedBudget = document.getElementById('stat-estimated-budget');
	const statBudgetSubtext = document.getElementById('stat-budget-subtext');
	const statSecondShooter = document.getElementById('stat-second-shooter');
	const statGalleryYield = document.getElementById('stat-gallery-yield');
	const statTravelTime = document.getElementById('stat-travel-time');
	const statOvertimeBuffer = document.getElementById('stat-overtime-buffer');
	const statShooterReason = document.getElementById('stat-shooter-reason');

	function calculateCoverage() {
		let totalMinutes = 0;
		checkboxes.forEach(chk => {
			if (chk.checked) {
				totalMinutes += parseInt(chk.getAttribute('data-minutes'), 10) || 0;
			}
		});

		const venueType = selectVenueLocations.value;
		let travelMins = 0;
		if (venueType === 'two') travelMins = 30;
		else if (venueType === 'three') travelMins = 60;
		totalMinutes += travelMins;

		statTravelTime.textContent = travelMins > 0 ? `${travelMins} min trayecto` : '0 min (Mismo lugar)';

		const calculatedHours = totalMinutes / 60;
		const hrs = Math.floor(totalMinutes / 60);
		const mins = totalMinutes % 60;
		statExactTimeSub.textContent = `(${hrs} h ${mins} min tiempo total)`;

		let packageHours = 8;
		if (calculatedHours <= 6.25) packageHours = 6;
		else if (calculatedHours <= 8.5) packageHours = 8;
		else if (calculatedHours <= 10.5) packageHours = 10;
		else packageHours = 12;

		badgePackageTier.textContent = `Paquete ${packageHours} Horas`;
		statPackageHours.textContent = `${packageHours} Horas`;

		const bufferDiffMins = (packageHours * 60) - totalMinutes;
		if (bufferDiffMins >= 0) {
			statOvertimeBuffer.textContent = `Tranquilo (${bufferDiffMins} min de margen)`;
			statOvertimeBuffer.style.color = '#16a34a';
		} else {
			statOvertimeBuffer.textContent = `Ajustado (${Math.abs(bufferDiffMins)} min sobre 8h — valorar 10h)`;
			statOvertimeBuffer.style.color = '#dc2626';
		}

		const rate = parseFloat(inputHourlyRate.value) || 250;
		const totalSpend = packageHours * rate;
		statEstimatedBudget.textContent = `${totalSpend.toLocaleString('es-ES')} €`;
		statBudgetSubtext.textContent = `Basado en ${rate} €/hora`;

		const minPhotos = packageHours * 50;
		const maxPhotos = packageHours * 75;
		statGalleryYield.textContent = `${minPhotos} a ${maxPhotos} Fotos`;

		const guests = parseInt(inputGuestCount.value, 10) || 120;
		const hasMultipleLocations = venueType !== 'single';
		const needsSecond = guests > 120 || hasMultipleLocations || packageHours >= 10;

		if (needsSecond) {
			statSecondShooter.textContent = 'Muy Recomendado';
			statSecondShooter.style.color = '#1e40af';
			statShooterReason.innerHTML = `Con <strong>${guests} invitados</strong> y <strong>${packageHours}h de cobertura</strong>, un segundo fotógrafo cubre el cóctel mientras se hacen las fotos de familia y capta ángulos dobles en la ceremonia.`;
		} else {
			statSecondShooter.textContent = 'Opcional (1 fotógrafo es suficiente)';
			statSecondShooter.style.color = '#15803d';
			statShooterReason.innerHTML = `Para una boda de <strong>${guests} invitados</strong> en una sola finca, un único fotógrafo profesional cubrirá perfectamente todos los momentos seleccionados.`;
		}

		document.getElementById('print-photo-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Bloque de Cobertura</th>
						<th style="padding:6pt; text-align:center;">Duración</th>
						<th style="padding:6pt;">Detalles y Notas</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Paquete Recomendado</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; font-size:12pt; color:#1e40af;">${packageHours} Horas</td>
						<td style="padding:6pt;">Presupuesto estimado: ${totalSpend.toLocaleString('es-ES')} € (${rate} €/h) | Galería: ${minPhotos}–${maxPhotos} fotos</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Segundo Fotógrafo</td>
						<td style="padding:6pt; text-align:center;">${statSecondShooter.textContent}</td>
						<td style="padding:6pt;">${needsSecond ? 'Recomendado para preparativos del novio y cóctel' : 'Un fotógrafo principal es suficiente'}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Desplazamientos</td>
						<td style="padding:6pt; text-align:center;">${travelMins} min</td>
						<td style="padding:6pt;">${venueType === 'single' ? 'Mismo lugar todo incluido (0 min de viaje)' : 'Incluye margen de recogida de equipo y conducción'}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Tiempo Total de Momentos</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#15803d;">${hrs}h ${mins}m</td>
						<td style="padding:6pt;">Margen de seguridad: ${bufferDiffMins >= 0 ? `${bufferDiffMins} minutos` : '0 min'}</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	inputGuestCount.addEventListener('input', calculateCoverage);
	selectVenueLocations.addEventListener('change', calculateCoverage);
	inputHourlyRate.addEventListener('input', calculateCoverage);

	checkboxes.forEach(chk => {
		chk.addEventListener('change', calculateCoverage);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		calculateCoverage();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateCoverage();
		const pkg = statPackageHours.textContent;
		const spend = statEstimatedBudget.textContent;
		const shooter = statSecondShooter.textContent;
		const yieldPhotos = statGalleryYield.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Resumen de Fotografía de Boda</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Resumen de Cobertura y Cronograma Fotográfico</h1>
				<p><strong>Paquete Ideal:</strong> ${pkg} | <strong>Presupuesto:</strong> ${spend} | <strong>Segundo Fotógrafo:</strong> ${shooter}</p>
				<hr/>
				<h2>Detalles del Paquete</h2>
				<table>
					<tr style="background:#f1f5f9;">
						<th>Parámetro</th><th>Información</th>
					</tr>
					<tr><td><strong>Horas de Cobertura:</strong></td><td><strong>${pkg}</strong></td></tr>
					<tr><td><strong>Fotos Entregadas:</strong></td><td>${yieldPhotos}</td></tr>
					<tr><td><strong>Segundo Fotógrafo:</strong></td><td>${shooter}</td></tr>
					<tr><td><strong>Coste Estimado:</strong></td><td>${spend}</td></tr>
				</table>
				<hr/>
				<p><em>Generado por Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Fotografia-Boda-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateCoverage();
</script>
