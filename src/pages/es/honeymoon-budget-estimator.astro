<script is:inline>
	let currencySymbol = '€';

	const tierRates = {
		tier1: {
			flightsBase: 1300,
			lodging: { boutique: 80, resort4: 150, luxury5: 290, overwater: 580 },
			dining: { budget: 45, moderate: 80, fine_dining: 140, michelin: 250 },
			excursions: { light: 25, moderate: 60, heavy: 140 }
		},
		tier2: {
			flightsBase: 1800,
			lodging: { boutique: 160, resort4: 310, luxury5: 580, overwater: 980 },
			dining: { budget: 80, moderate: 150, fine_dining: 230, michelin: 400 },
			excursions: { light: 45, moderate: 100, heavy: 220 }
		},
		tier3: {
			flightsBase: 2800,
			lodging: { boutique: 320, resort4: 580, luxury5: 1100, overwater: 1700 },
			dining: { budget: 120, moderate: 220, fine_dining: 380, michelin: 680 },
			excursions: { light: 80, moderate: 180, heavy: 400 }
		},
		tier4: {
			flightsBase: 3400,
			lodging: { boutique: 400, resort4: 750, luxury5: 1350, overwater: 2100 },
			dining: { budget: 140, moderate: 250, fine_dining: 400, michelin: 720 },
			excursions: { light: 100, moderate: 250, heavy: 540 }
		},
		domestic: {
			flightsBase: 400,
			lodging: { boutique: 130, resort4: 240, luxury5: 480, overwater: 780 },
			dining: { budget: 70, moderate: 130, fine_dining: 210, michelin: 380 },
			excursions: { light: 35, moderate: 80, heavy: 180 }
		}
	};

	const countryTierSelect = document.getElementById('select-country-tier');
	const tripDaysSlider = document.getElementById('input-trip-days');
	const tripDaysNum = document.getElementById('input-trip-days-num');
	const tripDaysDisplay = document.getElementById('trip-days-display');

	const flightClassSelect = document.getElementById('select-flight-class');
	const lodgingStyleSelect = document.getElementById('select-lodging-style');
	const diningStyleSelect = document.getElementById('select-dining-style');
	const excursionsStyleSelect = document.getElementById('select-excursions-style');

	const chkInsurance = document.getElementById('chk-travel-insurance');
	const chkBuffer = document.getElementById('chk-shopping-buffer');
	const currencySelect = document.getElementById('currency-select');

	const resGrandTotal = document.getElementById('res-grand-total');
	const resPerDayNote = document.getElementById('res-per-day-note');
	const resFlightTotal = document.getElementById('res-flight-total');
	const resHotelTotal = document.getElementById('res-hotel-total');
	const resFoodTotal = document.getElementById('res-food-total');
	const resExcursionsTotal = document.getElementById('res-excursions-total');
	const resExtrasTotal = document.getElementById('res-extras-total');
	const resNightsCount = document.getElementById('res-nights-count');

	const barFlights = document.getElementById('bar-flights');
	const barHotel = document.getElementById('bar-hotel');
	const barFood = document.getElementById('bar-food');
	const barExcursions = document.getElementById('bar-excursions');

	const pctFlights = document.getElementById('pct-flights');
	const pctHotel = document.getElementById('pct-hotel');
	const pctFood = document.getElementById('pct-food');
	const pctExcursions = document.getElementById('pct-excursions');

	function formatMoney(amount) {
		return `${Math.round(amount).toLocaleString('es-ES')} ${currencySymbol}`;
	}

	function calculateHoneymoon() {
		currencySymbol = currencySelect.value;
		const tierKey = countryTierSelect.value;
		const tier = tierRates[tierKey] || tierRates.tier2;

		const days = parseInt(tripDaysSlider.value) || 10;
		tripDaysNum.value = days;
		tripDaysDisplay.textContent = `${days} Días / ${days} Noches`;
		resNightsCount.textContent = days;

		let flightCost = tier.flightsBase;
		const flightClass = flightClassSelect.value;
		if (flightClass === 'premium') flightCost *= 1.4;
		else if (flightClass === 'business') flightCost *= 2.5;
		else if (flightClass === 'points') flightCost = 150;

		const lodgingPerNight = tier.lodging[lodgingStyleSelect.value] || tier.lodging.resort4;
		const hotelCost = lodgingPerNight * days;

		const diningPerDay = tier.dining[diningStyleSelect.value] || tier.dining.fine_dining;
		const foodCost = diningPerDay * days;

		const excursionsPerDay = tier.excursions[excursionsStyleSelect.value] || tier.excursions.moderate;
		const excursionsCost = excursionsPerDay * days;

		let extrasCost = 0;
		if (chkInsurance.checked) extrasCost += 220;
		if (chkBuffer.checked) extrasCost += 300;

		const grandTotal = flightCost + hotelCost + foodCost + excursionsCost + extrasCost;
		const perDayCost = Math.round(grandTotal / days);

		resGrandTotal.textContent = formatMoney(grandTotal);
		resPerDayNote.textContent = `Aprox. ${formatMoney(perDayCost)} / Día para la Pareja`;
		resFlightTotal.textContent = formatMoney(flightCost);
		resHotelTotal.textContent = formatMoney(hotelCost);
		resFoodTotal.textContent = formatMoney(foodCost);
		resExcursionsTotal.textContent = formatMoney(excursionsCost);
		resExtrasTotal.textContent = formatMoney(extrasCost);

		if (grandTotal > 0) {
			const pF = Math.round((flightCost / grandTotal) * 100);
			const pH = Math.round((hotelCost / grandTotal) * 100);
			const pD = Math.round((foodCost / grandTotal) * 100);
			const pE = 100 - pF - pH - pD;

			barFlights.style.width = `${pF}%`;
			barHotel.style.width = `${pH}%`;
			barFood.style.width = `${pD}%`;
			barExcursions.style.width = `${Math.max(2, pE)}%`;

			pctFlights.textContent = `${pF}%`;
			pctHotel.textContent = `${pH}%`;
			pctFood.textContent = `${pD}%`;
			pctExcursions.textContent = `${Math.max(2, pE)}%`;
		}
	}

	tripDaysSlider.addEventListener('input', () => {
		tripDaysNum.value = tripDaysSlider.value;
		calculateHoneymoon();
	});
	tripDaysNum.addEventListener('input', () => {
		tripDaysSlider.value = tripDaysNum.value;
		calculateHoneymoon();
	});

	[countryTierSelect, flightClassSelect, lodgingStyleSelect, diningStyleSelect, excursionsStyleSelect, chkInsurance, chkBuffer, currencySelect].forEach(el => {
		el.addEventListener('change', calculateHoneymoon);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Presupuesto de Luna de Miel</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Presupuesto Oficial de Luna de Miel</h1>
				<p>Generado el ${new Date().toLocaleDateString('es-ES')} | Destino: <strong>${countryTierSelect.options[countryTierSelect.selectedIndex].text.split('(')[0]}</strong> | Duración: <strong>${tripDaysSlider.value} Días</strong> | Presupuesto Total: <strong>${resGrandTotal.textContent}</strong> (${resPerDayNote.textContent})</p>
				
				<h3>Desglose de Gastos del Viaje:</h3>
				<table>
					<thead>
						<tr>
							<th>Partida del Viaje</th>
							<th style="text-align:right;">Coste Estimado (€)</th>
						</tr>
					</thead>
					<tbody>
						<tr><td>Vuelos de Ida y Vuelta para Dos (${flightClassSelect.options[flightClassSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resFlightTotal.textContent}</td></tr>
						<tr><td>Alojamiento (${tripDaysSlider.value} Noches en ${lodgingStyleSelect.options[lodgingStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resHotelTotal.textContent}</td></tr>
						<tr><td>Comidas y Cenas Románticas (${diningStyleSelect.options[diningStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resFoodTotal.textContent}</td></tr>
						<tr><td>Excursiones y Actividades (${excursionsStyleSelect.options[excursionsStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resExcursionsTotal.textContent}</td></tr>
						<tr><td>Seguro Médico, Traslados y Fondo de Compras</td><td style="text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;">
							<td>Presupuesto Total del Viaje</td>
							<td style="text-align:right; color:#16a34a;">${resGrandTotal.textContent}</td>
						</tr>
					</tbody>
				</table>

				<h3 style="margin-top:25px;">Consejos Prácticos:</h3>
				<p>• Comprueba la caducidad del pasaporte (mínimo 6 meses de vigencia).</p>
				<p>• Avisa a tu banco de los pagos en el extranjero para evitar bloqueos en tarjetas.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Presupuesto_Luna_de_Miel_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('es-ES');
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-honeymoon-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Vuelos de Ida y Vuelta para Dos</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFlightTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Alojamiento y Resorts (${tripDaysSlider.value} Noches)</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resHotelTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Comidas y Cenas Románticas</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFoodTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Excursiones y Actividades</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExcursionsTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Seguro de Viaje, Traslados y Extras</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Presupuesto Total de la Luna de Miel</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#16a34a;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Partida,Importe Estimado\n";
		csv += `"Vuelos Ida y Vuelta (2 Personas)","${resFlightTotal.textContent}"\n`;
		csv += `"Alojamiento (${tripDaysSlider.value} Noches)","${resHotelTotal.textContent}"\n`;
		csv += `"Restauracion y Cenas","${resFoodTotal.textContent}"\n`;
		csv += `"Excursiones y Ocio","${resExcursionsTotal.textContent}"\n`;
		csv += `"Seguro y Traslados","${resExtrasTotal.textContent}"\n`;
		csv += `"Total Luna de Miel","${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Presupuesto_Luna_Miel_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateHoneymoon();
</script>
