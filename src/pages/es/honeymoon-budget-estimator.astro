---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/honeymoon-budget-estimator/#webapp",
      "name": "Estimador de Presupuesto de Luna de Miel por Destino y Tipo de Viaje",
      "url": "https://manage.wedding/es/honeymoon-budget-estimator",
      "inLanguage": "es",
      "description": "Calculadora gratuita de viaje de novios y luna de miel: estima costes para vuelos de pareja, hoteles de 5 estrellas, villas sobre el agua, cenas románticas, excursiones y seguro con exportación en Word y PDF.",
      "applicationCategory": "TravelApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Presupuestar y Planificar el Viaje de Luna de Miel",
      "description": "Guía paso a paso para estimar los costes de vuelos, resorts, gastronomía y actividades según el país de destino.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Elige la Categoría del Destino",
          "text": "Selecciona entre destinos tropicales económicos (Sudeste Asiático), grandes clásicos internacionales (Japón, Costa Amalfitana) o viajes de ultra lujo (Maldivas, Bora Bora)."
        },
        {
          "@type": "HowToStep",
          "name": "Destina el 50% al Alojamiento y Resorts",
          "text": "Reserva la mitad de tu presupuesto de viaje para hoteles con encanto, resorts frente al mar o cabañas sobre el agua."
        },
        {
          "@type": "HowToStep",
          "name": "Asigna el 25% a Vuelos y Traslados",
          "text": "Calcula vuelos de ida y vuelta para dos, ferrys entre islas, trenes panorámicos y traslados privados."
        },
        {
          "@type": "HowToStep",
          "name": "Destina el 15% a Cenas Románticas y 10% a Excursiones",
          "text": "Planifica cenas a la luz de las velas, catas de vino, masajes en pareja, snorkel y recuerdos de viaje."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta de media una luna de miel para dos personas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El coste medio de un viaje de novios oscila entre 4.000€ y 8.000€ para una estancia de 10 a 14 días. Sin embargo, varía mucho según el destino: un viaje a Bali o Tailandia ronda los 3.000€ a 5.000€, una ruta por Japón o la Costa Amalfitana se sitúa entre 6.000€ y 9.500€, mientras que villas sobre el agua en Maldivas o Polinesia alcanzan los 10.000€ a 20.000€+."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué el poder adquisitivo del país cambia tanto el presupuesto del viaje?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Porque el coste de vida local es muy dispar. En países con moneda favorable (como Tailandia o Vietnam), una villa de lujo con piscina privada y cenas de autor cuesta una fracción (120€–200€/día) de lo que cuesta el mismo estándar en Suiza, Maldivas o Hawái (600€–1.500€/día)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Con cuánta antelación se debe reservar el viaje de novios?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para vuelos transcontinentales y hoteles exclusivos en temporada alta, lo ideal es reservar entre 6 y 9 meses antes para asegurar las mejores tarifas aéreas y habitaciones con mejores vistas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Podemos financiar la luna de miel con los regalos de los invitados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "¡Por supuesto! La gran mayoría de parejas actuales financian su luna de miel mediante transferencias de los invitados o listas de boda con experiencias concretas (vuelos, cenas románticas, excursiones de buceo o masajes)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Presupuesto de Luna de Miel y Viaje de Novios | Manage.Wedding"
	description="Calcula el presupuesto de tu luna de miel según el país de destino. Estima vuelos para dos, hoteles de lujo, cenas y excursiones con exportación a Word y PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Presupuesto de Luna de Miel" category="budget-finance" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Presupuesto de <span class="accent-italic">Luna de Miel</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calcula el presupuesto realista de vuestro viaje según el <strong>nivel de coste del destino</strong>, tipo de resort, clase de vuelo y días de viaje. Exporta vuestro plan a <strong>Word (.doc)</strong> o <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Cómo Planificar la Luna de Miel en 3 Sencillos Pasos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Selecciona el Tipo de Destino
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Elige el nivel de precio del destino: desde paraísos tropicales asequibles (Bali, Tailandia) hasta clásicos mediterráneos o villas sobre el agua (Maldivas, Bora Bora).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Personaliza Alojamiento y Vuelos
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Ajusta la clase de vuelo, categoría de hotel (boutique, 5 estrellas o villa privada), cenas románticas y duración total del viaje para dos personas.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporta vuestro Plan de Viaje
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Haz clic en <strong>"📝 Exportar a Word"</strong> o <strong>"🖨️ Imprimir PDF"</strong> para guardar el desglose de costes o incluir experiencias en vuestra lista de bodas.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="honeymoon-calc-grid">
			
			<!-- Left Column: Travel Parameters Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							✈️ Parámetros del Destino y Viaje
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Todos los cálculos incluyen el importe conjunto para dos personas
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Moneda:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="$">$ (USD/CAD/AUD)</option>
							<option value="£">£ (GBP)</option>
							<option value="₹">₹ (INR)</option>
						</select>
					</div>
				</div>

				<form id="honeymoon-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Destination Country Tier -->
					<div>
						<label for="select-country-tier" class="font-heading" style="display: block; font-size: 1rem; color: var(--accent-red); margin-bottom: 0.3rem;">
							1. Destino y Nivel de Coste *
						</label>
						<select id="select-country-tier" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="tier1">🌴 Nivel 1: Tropical Económico y Cultura (Bali, Tailandia, Vietnam, Costa Rica, Portugal)</option>
							<option value="tier2" selected>🏖️ Nivel 2: Clásicos Mediterráneos y Resorts (Riviera Maya, Italia, Japón, Hawái, Grecia)</option>
							<option value="tier3">💎 Nivel 3: Ultra Lujo y Cabañas sobre el Agua (Maldivas, Bora Bora, Costa Amalfitana, Suiza)</option>
							<option value="tier4">🦁 Nivel 4: Grandes Viajes Exclusivos (Safari en Kenia/Tanzania, Galápagos, Isla Privada)</option>
							<option value="domestic">🚗 Nivel 5: Escapadas Nacionales y Rutas en Coche (Baleares, Costa Brava, Asturias, Paradores)</option>
						</select>
					</div>

					<!-- 2. Trip Duration & Flight Class -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;">
						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-trip-days" class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
									Duración (Días / Noches)
								</label>
								<span id="trip-days-display" style="font-size: 0.95rem; font-weight: bold; color: var(--accent-blue);">10 Días</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.5rem;">
								<input type="range" id="input-trip-days" min="3" max="28" value="10" step="1" style="flex: 1; accent-color: var(--accent-blue);">
								<input type="number" id="input-trip-days-num" value="10" min="3" max="28" style="width: 50px; padding: 0.3rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center; font-weight: bold;">
							</div>
						</div>

						<div>
							<label for="select-flight-class" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Vuelos para Dos (Ida y Vuelta)
							</label>
							<select id="select-flight-class" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
								<option value="economy" selected>Clase Turista Estándar</option>
								<option value="premium">Turista Premium (+40%)</option>
								<option value="business">Clase Business / Preferente (2,5×)</option>
								<option value="points">Canje de Millas / Puntos (Tasas 150€)</option>
							</select>
						</div>
					</div>

					<!-- 3. Resort & Lodging Standard -->
					<div>
						<label for="select-lodging-style" class="font-heading" style="display: block; font-size: 1rem; color: var(--accent-blue); margin-bottom: 0.3rem;">
							2. Categoría de Alojamiento (Por Noche para 2)
						</label>
						<select id="select-lodging-style" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="boutique">Hotel Boutique con Encanto / Apartamento Premium</option>
							<option value="resort4" selected>Resort 4 Estrellas Frente al Mar / Hotel Histórico</option>
							<option value="luxury5">Resort 5 Estrellas Gran Lujo / Villa con Piscina Privada</option>
							<option value="overwater">Villa Sobre el Agua / Lodge Safari de Lujo</option>
						</select>
					</div>

					<!-- 4. Dining, Excursions & Extras -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<span class="font-heading" style="font-size: 0.95rem; color: #16a34a; display: block;">
							3. Gastronomía, Excursiones e Imprevistos (Pareja)
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">Estilo de Restauración</span>
								<select id="select-dining-style" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="moderate">Combinación de Restaurantes Locales y Cenas Románticas</option>
									<option value="fine_dining" selected>Alta Gastronomía y Cócteles al Atardecer a Diario</option>
									<option value="budget">Comida Tradicional, Mercados y Trattorias</option>
									<option value="michelin">Menús Degustación con Estrella Michelin y Cenas Privadas</option>
								</select>
							</div>

							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">Actividades y Excursiones</span>
								<select id="select-excursions-style" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="moderate" selected>Masaje en Pareja, Catamarán y Visitas Guiadas</option>
									<option value="light">Días Relajados de Playa y Paseos por Libre</option>
									<option value="heavy">Aventura Diaria (Helicóptero, Buceo, Guías Privados)</option>
								</select>
							</div>
						</div>

						<div style="display: flex; gap: 1rem; flex-wrap: wrap; padding-top: 0.3rem;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-travel-insurance" checked style="accent-color: var(--fg-pencil);">
								<span>Seguro Médico de Viaje y Traslados Privados (220 €)</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-shopping-buffer" checked style="accent-color: var(--fg-pencil);">
								<span>Fondo para Recuerdos y Compras (300 €)</span>
							</label>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Cost Breakdown -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Honeymoon Total Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🏖️ Presupuesto Total de la Luna de Miel
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Previsión completa todo incluido para los novios
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar a Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimir PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Budget Total Highlight -->
					<div style="background: #f0fdf4; border: 2.5px solid #16a34a; border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: #16a34a; display: block; font-weight: bold;">Presupuesto Total Estimado</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: #16a34a; display: block; line-height: 1.2;">7.620 €</strong>
						<span id="res-per-day-note" style="font-size: 0.8rem; color: #16a34a;">Aprox. 762 € / Día para la Pareja</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Desglose de Gastos del Viaje
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">✈️ Vuelos de Ida y Vuelta (2 Personas):</td>
									<td id="res-flight-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">2.000,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🏨 Alojamiento (<span id="res-nights-count">10</span> Noches):</td>
									<td id="res-hotel-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">3.500,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Restauración y Cenas Románticas:</td>
									<td id="res-food-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">1.500,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🏄 Excursiones, Buceo y Spa:</td>
									<td id="res-excursions-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">1.100,00 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0;">🛡️ Seguro Médico y Extras:</td>
									<td id="res-extras-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">520,00 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Travel Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span style="color: var(--accent-red);">Vuelos (<span id="pct-flights">26%</span>)</span>
							<span style="color: var(--accent-blue);">Hotel (<span id="pct-hotel">46%</span>)</span>
							<span style="color: #16a34a;">Comidas (<span id="pct-food">20%</span>)</span>
							<span style="color: #7c3aed;">Planes (<span id="pct-excursions">14%</span>)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-flights" style="width: 26%; background: var(--accent-red); transition: width 0.3s ease;"></div>
							<div id="bar-hotel" style="width: 46%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-food" style="width: 20%; background: #16a34a; transition: width 0.3s ease;"></div>
							<div id="bar-excursions" style="width: 14%; background: #7c3aed; transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Registry Cash Fund Tip Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						💡 Consejo para la Lista de Bodas:
					</strong>
					<p class="font-body" style="font-size: 0.85rem; line-height: 1.5; margin: 0; color: var(--fg-pencil); text-align: center;">
