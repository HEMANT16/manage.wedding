---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/rsvp-tracker/#webapp",
      "name": "Gestor y Rastreador de Confirmaciones de Asistencia (RSVP)",
      "url": "https://manage.wedding/es/rsvp-tracker",
      "inLanguage": "es",
      "description": "Herramienta online gratuita para gestionar confirmaciones de asistencia a la boda (RSVP). Controla invitados confirmados, pendientes y que no asisten, menús especiales, alérgenos y exporta a Word, PDF o Excel.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Gestionar y Controlar las Confirmaciones de Asistencia (RSVP)",
      "description": "Guía paso a paso para registrar confirmaciones, controlar menús y cerrar el recuento final para el catering.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Fija la Fecha Límite de Confirmación",
          "text": "Establece la fecha límite entre 3 y 4 semanas antes de la boda para tener margen de maniobra con los rezagados."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Registra Respuestas y Menús Especiales",
          "text": "Anota a cada comensal confirmado junto a su preferencia de plato principal y alertas de alergias o intolerancias."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Envía Recordatorios a los Pendientes",
          "text": "Filtra los invitados 'Pendientes' 48-72 horas tras el plazo límite para enviar un mensaje amable por WhatsApp."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Exporta la Lista Final para el Catering",
          "text": "Genera el informe definitivo en Word, PDF o Excel para entregarlo a la finca y al jefe de sala 14 días antes del enlace."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuándo se debe fijar la fecha límite de confirmación (RSVP)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La fecha límite ideal es entre 3 y 4 semanas antes del enlace. Esto te deja 1 semana para contactar a quienes no hayan respondido y entregar el número exacto de cubiertos al catering 14 o 21 días antes."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo exportar la lista de confirmados a Word, PDF o Excel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Haz clic en los botones superiores 'Exportar a Word (.doc)', 'Exportar PDF / Imprimir' o 'Exportar Excel (.csv)' para descargar al instante un documento maquetado con todos los datos y dietas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué porcentaje de invitados suele declinar la invitación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En bodas locales, suele declinar entre un 15% y un 20% de los invitados. En bodas de destino o con invitados que deben desplazarse de otras ciudades, el porcentaje de bajas sube habitualmente al 30%–40%."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo reclamar la confirmación a los invitados rezagados sin resultar incómodo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Espera 2 o 3 días tras el plazo límite y envía un mensaje afectuoso por WhatsApp: '¡Hola [Nombre]! Estamos cerrando los números finales con la finca y el catering esta semana. ¿Podrás acompañarnos el gran día? ¡Confírmanos antes del viernes para reservarte el cubierto! ❤️'"
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Gestor de Confirmaciones de Boda RSVP (Control de Menús y Lista) | Manage.Wedding"
	description="Controla las confirmaciones de asistencia a tu boda en tiempo real. Gestiona invitados confirmados, pendientes, alérgenos y menús. Exporta a Word, PDF y Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Gestor de Confirmaciones RSVP" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Confirmaciones de Asistencia <span class="accent-italic">RSVP</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Control de comensales en tiempo real, registro de menús y tasas de respuesta. Exporta tu lista definitiva a <strong>Word (.doc)</strong>, <strong>PDF</strong> o <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Overview Stats & Export Dashboard -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						📈 Progreso de Confirmaciones y Métricas
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Sincronizado automáticamente con tu navegador
					</span>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Exportar a Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Exportar PDF / Imprimir
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Exportar Excel (.csv)
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Cargar Ejemplo
					</button>
					<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🗑️ Vaciar Lista
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Pases Invitados</span>
					<strong id="stat-total" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(<span id="stat-parties">0</span> invitaciones)</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Confirmados (Sí)</span>
					<strong id="stat-attending" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-attending-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% del total</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Pendientes (Duda)</span>
					<strong id="stat-pending" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span id="stat-pending-pct" style="font-size: 0.75rem; color: #854d0e; display: block;">0% del total</span>
				</div>
				<div style="background: #fef2f2; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #991b1b; display: block;">Declinados (No)</span>
					<strong id="stat-declined" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red);">0</strong>
					<span id="stat-declined-pct" style="font-size: 0.75rem; color: #991b1b; display: block;">0% del total</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Tasa de Respuesta</span>
					<strong id="stat-response-rate" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">0%</strong>
					<span style="font-size: 0.75rem; color: #1e40af; display: block;">Objetivo: 95%+</span>
				</div>
			</div>

			<!-- Dynamic Visual Attendance Progress Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Desglose Visual de Asistencia</span>
					<span id="stat-summary-note" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">Listo para registrar</span>
				</div>
				<div style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #e5e0d8; margin-bottom: 0.75rem;">
					<div id="bar-attending" style="height: 100%; width: 0%; background-color: #22c55e; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;" title="Confirmados"></div>
					<div id="bar-pending" style="height: 100%; width: 0%; background-color: #eab308; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;" title="Pendientes"></div>
					<div id="bar-declined" style="height: 100%; width: 0%; background-color: var(--accent-red); transition: width 0.3s ease;" title="Declinados"></div>
				</div>
				<div style="display: flex; justify-content: space-between; font-family: var(--font-body); font-size: 0.85rem;">
					<span style="color: #15803d; font-weight: bold;">🟢 Confirmados (<span id="legend-attending">0</span>)</span>
					<span style="color: #a16207; font-weight: bold;">🟡 Pendientes (<span id="legend-pending">0</span>)</span>
					<span style="color: var(--accent-red); font-weight: bold;">🔴 Declinados (<span id="legend-declined">0</span>)</span>
				</div>
			</div>
		</div>

		<!-- Workspace Grid: Add / Edit RSVP + Filterable Guest List -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 360px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="rsvp-workspace-grid">
			
			<!-- Left Column: Add / Log RSVP Response -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.25rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>📬</span> Registrar Respuesta RSVP
				</h2>

				<form id="rsvp-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Guest Full Name -->
					<div>
						<label for="rsvp-name" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Nombre del Invitado o Familia *
						</label>
						<input type="text" id="rsvp-name" required placeholder="ej. Tío Roberto o Familia Gómez" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1.05rem;">
					</div>

					<!-- Group -->
					<div>
						<label for="rsvp-group" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Grupo / Vínculo
						</label>
						<select id="rsvp-group" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
							<option value="Familia de la Novia">Familia de la Novia</option>
							<option value="Familia del Novio">Familia del Novio</option>
							<option value="Amigos de la Novia">Amigos de la Novia</option>
							<option value="Amigos del Novio">Amigos del Novio</option>
							<option value="Amigos en Común">Amigos en Común</option>
							<option value="Testigos / Cortejo VIP">Testigos / Cortejo VIP</option>
							<option value="Compañeros de Trabajo">Compañeros de Trabajo</option>
						</select>
					</div>

					<!-- Party Size & RSVP Selection -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="rsvp-party" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Pases / Comensales
							</label>
							<select id="rsvp-party" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="1">1 (Individual)</option>
								<option value="2" selected>2 (Pareja / +1)</option>
								<option value="3">3 (Familia)</option>
								<option value="4">4 (Familia de 4)</option>
								<option value="5">5+ (Grupo Grande)</option>
							</select>
						</div>
						<div>
							<label for="rsvp-status" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Estado de Asistencia
							</label>
							<select id="rsvp-status" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="Attending">✅ Asiste (Confirmado)</option>
								<option value="Pending">⏳ Pendiente (Duda)</option>
								<option value="Declined">❌ No Asiste (Declina)</option>
							</select>
						</div>
					</div>

					<!-- Meal Selection / Dietary -->
					<div>
						<label for="rsvp-dietary" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Preferencia de Menú / Alergias
						</label>
						<input type="text" id="rsvp-dietary" placeholder="ej. Solomillo, Vegano, Celíaco" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem;">
							<button type="button" class="meal-tag-btn" data-val="Carne / Solomillo" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🥩 Carne</button>
							<button type="button" class="meal-tag-btn" data-val="Pescado / Lubina" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🐟 Pescado</button>
							<button type="button" class="meal-tag-btn" data-val="Vegetariano" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🥗 Vegetariano</button>
							<button type="button" class="meal-tag-btn" data-val="Vegano" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🌱 Vegano</button>
							<button type="button" class="meal-tag-btn" data-val="Sin Gluten / Celíaco" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🌾 Sin Gluten</button>
							<button type="button" class="meal-tag-btn" data-val="Sin Lactosa" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">🥛 Sin Lactosa</button>
						</div>
					</div>

					<button type="submit" class="hand-btn" style="width: 100%; padding: 0.85rem; font-size: 1.15rem; margin-top: 0.5rem;">
						✨ Guardar Respuesta
					</button>

				</form>

				<!-- Follow-Up Message Copy Box -->
				<div style="margin-top: 1.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
					<strong class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
						💬 Plantilla de WhatsApp para Rezagados:
					</strong>
					<p id="copy-template-text" class="font-body" style="font-size: 0.9rem; line-height: 1.4; margin-bottom: 0.5rem; color: var(--fg-pencil);">
						"¡Hola! Estamos cerrando los números con la finca y el catering esta semana y nos encantaría saber si podrás acompañarnos. ¿Nos confirmas antes del viernes si vienes? ¡Un abrazo grande! ❤️"
					</p>
					<button type="button" id="btn-copy-template" class="hand-btn secondary" style="padding: 0.25rem 0.6rem; font-size: 0.8rem; width: 100%;">
						📋 Copiar Mensaje
					</button>
				</div>
			</div>

			<!-- Right Column: Searchable, Filterable RSVP Registry Table -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Filter & Search Bar -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
					
					<!-- Search -->
					<div style="flex: 1; min-width: 180px;">
						<input type="text" id="search-input" placeholder="🔍 Buscar por nombre o tipo de plato..." class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem;">
					</div>

					<!-- RSVP Status Filter -->
					<div>
						<select id="filter-status" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Todas las Respuestas</option>
							<option value="Attending">✅ Solo Confirmados</option>
							<option value="Pending">⏳ Solo Pendientes</option>
							<option value="Declined">❌ Solo Declinados</option>
						</select>
					</div>

					<!-- Group Filter -->
					<div>
						<select id="filter-group" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Todos los Grupos</option>
							<option value="Familia de la Novia">Familia de la Novia</option>
							<option value="Familia del Novio">Familia del Novio</option>
							<option value="Amigos de la Novia">Amigos de la Novia</option>
							<option value="Amigos del Novio">Amigos del Novio</option>
							<option value="Amigos en Común">Amigos en Común</option>
							<option value="Testigos / Cortejo VIP">Testigos / Cortejo VIP</option>
							<option value="Compañeros de Trabajo">Compañeros de Trabajo</option>
						</select>
					</div>
				</div>

				<!-- Table Container -->
				<div id="rsvp-table-wrap" style="overflow-x: auto; max-height: 550px;">
					<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 1rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil); position: sticky; top: 0; z-index: 1;">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Invitado</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Grupo</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Pases</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Estado</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Menú / Dieta</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Acciones</th>
							</tr>
						</thead>
						<tbody id="rsvp-table-body"></tbody>
					</table>
				</div>

				<!-- Empty State Box -->
				<div id="empty-state-box" style="display: none; text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💌</div>
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">No hay respuestas registradas</h3>
					<p class="font-body" style="font-size: 1.05rem; margin-bottom: 1.25rem;">Añade respuestas desde el formulario de la izquierda o carga datos de ejemplo.</p>
					<button type="button" id="btn-empty-sample" class="hand-btn" style="padding: 0.5rem 1.25rem; font-size: 1rem;">
