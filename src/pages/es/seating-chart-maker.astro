		</div>

		<RelatedTools currentPath="/es/seating-chart-maker" category="guests" />

	</main>
</Layout>

<style>
	.seating-workspace-grid {
		display: grid;
		grid-template-columns: 1fr;
	}
	@media (min-width: 992px) {
		.seating-workspace-grid {
			grid-template-columns: 340px 1fr;
		}
	}

	.drop-zone {
		min-height: 100px;
		border: 2px dashed var(--fg-pencil);
		border-radius: 4px;
		padding: 0.5rem;
		background: rgba(0,0,0,0.02);
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		transition: background 0.15s ease;
	}
	.drop-zone.drag-over {
		background: #fef9c3 !important;
		border-style: solid;
	}

	.guest-drag-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 4px;
		padding: 0.45rem 0.6rem;
		cursor: grab;
		box-shadow: 2px 2px 0 var(--fg-pencil);
		display: flex;
		justify-content: space-between;
		align-items: center;
		user-select: none;
		transition: transform 0.1s ease, box-shadow 0.1s ease;
	}
	.guest-drag-card:hover {
		box-shadow: 3px 3px 0 var(--fg-pencil);
	}
	.guest-drag-card:active {
		cursor: grabbing;
		transform: scale(0.98);
	}

	.table-box-card {
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		padding: 1.1rem;
		background: var(--bg-paper);
		box-shadow: 3px 3px 0 var(--fg-pencil);
		display: flex;
		flex-direction: column;
		transition: all 0.2s ease;
	}
	.table-box-card:hover {
		box-shadow: 5px 5px 0 var(--fg-pencil);
	}

	.table-header-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 2px solid var(--fg-pencil);
		padding-bottom: 0.5rem;
		margin-bottom: 0.6rem;
	}

	.seat-dot {
		display: inline-block;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		border: 1.5px solid var(--fg-pencil);
		margin-right: 2px;
	}
	.seat-dot.filled {
		background: #22c55e;
	}
	.seat-dot.empty {
		background: #fff;
	}

	.cap-badge {
		font-size: 0.8rem;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		border: 1px solid var(--fg-pencil);
		background: #fff;
		font-weight: bold;
	}
	.cap-full {
		background: #dcfce7 !important;
		color: #15803d;
	}
	.cap-over {
		background: #fee2e2 !important;
		color: #b91c1c;
	}

	.seated-guest-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: #fff;
		border: 1px solid var(--fg-pencil);
		border-radius: 4px;
		padding: 0.35rem 0.5rem;
		font-size: 0.9rem;
	}

	.unseat-btn {
		background: none;
		border: none;
		color: var(--accent-red);
		cursor: pointer;
		font-size: 0.85rem;
		padding: 0.1rem 0.3rem;
		border-radius: 3px;
		font-weight: bold;
	}
	.unseat-btn:hover {
		background: #fee2e2;
	}

	.print-only {
		display: none;
	}

	
</style>

<script is:inline>
	const GUEST_STORAGE_KEY = 'manage_wedding_guests_es';
	const TABLE_STORAGE_KEY = 'manage_wedding_tables_es';

	const defaultTables = [
		{ id: 'table-1', name: 'Mesa 1 (Familia Novia)', capacity: 8, shape: 'Round' },
		{ id: 'table-2', name: 'Mesa 2 (Familia Novio)', capacity: 8, shape: 'Round' },
		{ id: 'table-3', name: 'Mesa 3 (Amigos Universidad)', capacity: 8, shape: 'Round' },
		{ id: 'table-head', name: 'Mesa Presidencial', capacity: 6, shape: 'Sweetheart' }
	];

	const defaultSampleGuests = [
		{ id: '1', name: 'Elena García', group: "Familia de la Novia", partySize: 2, rsvpStatus: 'Attending', dietary: 'Carne / Solomillo', tableId: 'table-1' },
		{ id: '2', name: 'Javier Navarro', group: "Familia del Novio", partySize: 2, rsvpStatus: 'Attending', dietary: 'Pescado / Lubina', tableId: 'table-2' },
		{ id: '3', name: 'Lucía Santos', group: "Testigos / Cortejo VIP", partySize: 1, rsvpStatus: 'Attending', dietary: 'Vegetariano', tableId: 'table-head' },
		{ id: '4', name: 'Sara y Tomás Morales', group: "Amigos en Común", partySize: 2, rsvpStatus: 'Attending', dietary: 'Carne / Solomillo', tableId: 'table-3' },
		{ id: '5', name: 'David Millán', group: "Amigos del Novio", partySize: 2, rsvpStatus: 'Attending', dietary: 'Carne / Solomillo', tableId: 'table-3' },
		{ id: '6', name: 'Clara Benítez', group: "Amigos de la Novia", partySize: 2, rsvpStatus: 'Attending', dietary: 'Sin Gluten / Celíaco', tableId: null },
		{ id: '7', name: 'Tía Carmen', group: "Familia de la Novia", partySize: 1, rsvpStatus: 'Attending', dietary: 'Pescado / Lubina', tableId: 'table-1' },
		{ id: '8', name: 'Marcos Rubio', group: "Compañeros de Trabajo", partySize: 1, rsvpStatus: 'Attending', dietary: 'Ninguna', tableId: null }
	];

	let guests = [];
	let tables = [];

	function loadData() {
		const rawGuests = localStorage.getItem(GUEST_STORAGE_KEY);
		if (rawGuests) {
			try {
				const all = JSON.parse(rawGuests);
				guests = all.filter(g => (g.rsvpStatus === 'Attending' || g.status === 'attending'));
				guests.forEach(g => {
					if (!g.partySize) g.partySize = 1;
				});
			} catch (e) {
				guests = [];
			}
		} else {
			guests = JSON.parse(JSON.stringify(defaultSampleGuests));
			saveGuestsData();
		}

		const rawTables = localStorage.getItem(TABLE_STORAGE_KEY);
		if (rawTables) {
			try {
				tables = JSON.parse(rawTables);
			} catch (e) {
				tables = JSON.parse(JSON.stringify(defaultTables));
			}
		} else {
			tables = JSON.parse(JSON.stringify(defaultTables));
			saveTablesData();
		}
	}

	function saveGuestsData() {
		const rawGuests = localStorage.getItem(GUEST_STORAGE_KEY);
		let all = [];
		if (rawGuests) {
			try { all = JSON.parse(rawGuests); } catch (e) { all = []; }
		} else {
			all = JSON.parse(JSON.stringify(defaultSampleGuests));
		}

		guests.forEach(g => {
			const found = all.find(ag => ag.id === g.id);
			if (found) {
				found.tableId = g.tableId;
			}
		});

		localStorage.setItem(GUEST_STORAGE_KEY, JSON.stringify(all));
		updateProgressAndStats();
	}

	function saveTablesData() {
		localStorage.setItem(TABLE_STORAGE_KEY, JSON.stringify(tables));
		updateProgressAndStats();
	}

	const unassignedDropzone = document.getElementById('unassigned-dropzone');
	const tablesContainer = document.getElementById('tables-grid-container');
	const unassignedBadgeCount = document.getElementById('unassigned-badge-count');
	const unassignedSearch = document.getElementById('unassigned-search');

	const statTotalAttending = document.getElementById('stat-total-attending');
	const statSeatedCount = document.getElementById('stat-seated-count');
	const statSeatedPct = document.getElementById('stat-seated-pct');
	const statUnassignedCount = document.getElementById('stat-unassigned-count');
	const statTableCount = document.getElementById('stat-table-count');
	const statCapacityTotal = document.getElementById('stat-capacity-total');

	const progressBarFill = document.getElementById('progress-bar-fill');
	const progressText = document.getElementById('progress-text');

	function handleAddNewTable() {
		const newId = 'table-' + Date.now();
		const num = tables.length + 1;
		tables.push({
			id: newId,
			name: `Mesa ${num}`,
			capacity: 8,
			shape: 'Round'
		});
		saveTablesData();
		renderTables();
		renderGuests();
	}

	document.getElementById('btn-add-table').addEventListener('click', handleAddNewTable);
	document.getElementById('btn-add-table-top').addEventListener('click', handleAddNewTable);

	document.getElementById('quick-add-guest-form').addEventListener('submit', (e) => {
		e.preventDefault();
		const nameInput = document.getElementById('quick-guest-name');
		const partySelect = document.getElementById('quick-guest-party');

		const name = nameInput.value.trim();
		const partySize = parseInt(partySelect.value) || 1;

		if (!name) return;

		const newG = {
			id: Date.now().toString(),
			name,
			group: 'General',
			partySize,
			rsvpStatus: 'Attending',
			dietary: 'Ninguna',
			tableId: null
		};

		guests.unshift(newG);
		saveGuestsData();
		nameInput.value = '';
		renderGuests();
	});

	document.getElementById('btn-clear-seating').addEventListener('click', () => {
		if (confirm("¿Desasignar a todos los invitados de sus mesas? (Volverán a la lista de 'Sin Asignar')")) {
			guests.forEach(g => { g.tableId = null; });
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	});

	document.getElementById('btn-sample-data').addEventListener('click', () => {
		guests = JSON.parse(JSON.stringify(defaultSampleGuests));
		tables = JSON.parse(JSON.stringify(defaultTables));
		saveTablesData();
		saveGuestsData();
		renderTables();
		renderGuests();
	});

	document.getElementById('btn-auto-assign').addEventListener('click', () => {
		const unassigned = guests.filter(g => !g.tableId);
		if (unassigned.length === 0) {
			alert("¡Todos los invitados confirmados ya están sentados en una mesa!");
			return;
		}

		tables.forEach(t => {
			const currentSeated = guests.filter(g => g.tableId === t.id).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
			let space = t.capacity - currentSeated;

			unassigned.forEach(g => {
				const seats = parseInt(g.partySize) || 1;
				if (!g.tableId && seats <= space) {
					g.tableId = t.id;
					space -= seats;
				}
			});
		});

		saveGuestsData();
		renderTables();
		renderGuests();
	});

	unassignedSearch.addEventListener('input', renderGuests);

	window.handleDragStart = function(e) {
		e.dataTransfer.setData('text/plain', e.target.getAttribute('data-guest-id'));
	};

	window.handleDragOver = function(e) {
		e.preventDefault();
		const dropzone = e.target.closest('.drop-zone');
		if (dropzone) dropzone.classList.add('drag-over');
	};

	window.handleDragLeave = function(e) {
		const dropzone = e.target.closest('.drop-zone');
		if (dropzone) dropzone.classList.remove('drag-over');
	};

	window.handleDrop = function(e) {
		e.preventDefault();
		const dropzone = e.target.closest('.drop-zone');
		if (!dropzone) return;
		dropzone.classList.remove('drag-over');

		const guestId = e.dataTransfer.getData('text/plain');
		const targetTableId = dropzone.getAttribute('data-table-id');

		const g = guests.find(item => item.id === guestId);
		if (g) {
			g.tableId = targetTableId === 'unassigned' ? null : targetTableId;
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.moveGuestToTable = function(guestId, targetTableId) {
		const g = guests.find(item => item.id === guestId);
		if (g) {
			g.tableId = targetTableId === 'unassigned' ? null : targetTableId;
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.assignUnassignedGuestToTable = function(tableId, guestId) {
		if (!guestId) return;
		const g = guests.find(item => item.id === guestId);
		if (g) {
			g.tableId = tableId;
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.removeTable = function(tableId) {
		if (confirm("¿Eliminar esta mesa? Los invitados asignados volverán a 'Sin Asignar'.")) {
			tables = tables.filter(t => t.id !== tableId);
			guests.forEach(g => {
				if (g.tableId === tableId) g.tableId = null;
			});
			saveTablesData();
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.updateTableName = function(tableId, newName) {
		const t = tables.find(item => item.id === tableId);
		if (t && newName.trim()) {
			t.name = newName.trim();
			saveTablesData();
		}
	};

	window.updateTableCapacity = function(tableId, newCap) {
		const t = tables.find(item => item.id === tableId);
		if (t) {
			t.capacity = parseInt(newCap) || 8;
			saveTablesData();
			renderTables();
			renderGuests();
		}
	};

	window.updateTableShape = function(tableId, newShape) {
		const t = tables.find(item => item.id === tableId);
		if (t) {
			t.shape = newShape;
			saveTablesData();
			renderTables();
			renderGuests();
		}
	};

	function renderTables() {
		tablesContainer.innerHTML = '';

		if (tables.length === 0) {
			tablesContainer.innerHTML = `
				<div style="grid-column: 1 / -1; text-align: center; padding: 2.5rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🍽️</div>
					<h4 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">No hay mesas creadas</h4>
					<p class="font-body" style="font-size: 0.95rem; margin-bottom: 1rem;">Pulsa "+ Añadir Mesa" para crear tu primera mesa redonda o imperial.</p>
					<button type="button" class="hand-btn" onclick="handleAddNewTable()">➕ Añadir Tu Primera Mesa</button>
				</div>
			`;
			return;
		}

		tables.forEach(table => {
			const tableDiv = document.createElement('div');
			tableDiv.className = 'table-box-card';

			const tableGuests = guests.filter(g => g.tableId === table.id);
			const seatedSeats = tableGuests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

			let capClass = '';
			if (seatedSeats === table.capacity) capClass = 'cap-full';
			else if (seatedSeats > table.capacity) capClass = 'cap-over';

			let dotsHtml = '';
			for (let i = 0; i < table.capacity; i++) {
				if (i < seatedSeats) {
					dotsHtml += '<span class="seat-dot filled" title="Silla Ocupada"></span>';
				} else {
					dotsHtml += '<span class="seat-dot empty" title="Silla Disponible"></span>';
				}
			}
			if (seatedSeats > table.capacity) {
				dotsHtml += `<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold; margin-left: 3px;">+${seatedSeats - table.capacity} ¡Superado!</span>`;
			}

			let shapeIcon = '⭕ Redonda';
			if (table.shape === 'Rectangular') shapeIcon = '▭ Imperial / Rectangular';
			if (table.shape === 'Sweetheart') shapeIcon = '❤️ Presidencial';

			const unassignedGuests = guests.filter(g => !g.tableId);
			let quickAssignOptions = '<option value="">➕ Asignar Invitado Aquí...</option>';
			unassignedGuests.forEach(ug => {
				quickAssignOptions += `<option value="${ug.id}">${ug.name} (${ug.partySize || 1} pase${(ug.partySize || 1) > 1 ? 's' : ''})</option>`;
			});

			tableDiv.innerHTML = `
				<div class="table-header-row">
					<div style="flex: 1; min-width: 0; margin-right: 0.5rem;">
						<strong contenteditable="true" style="font-family: var(--font-heading); font-size: 1.15rem; color: var(--fg-pencil); outline: none; border-bottom: 1px dotted var(--fg-pencil); display: inline-block; max-width: 100%;" onblur="updateTableName('${table.id}', this.innerText)" title="Haz clic para renombrar la mesa">${table.name}</strong>
						<span style="display: block; font-size: 0.8rem; color: var(--text-secondary); margin-top: 2px;">
							${shapeIcon}
						</span>
					</div>
					<div style="display: flex; align-items: center; gap: 0.4rem;">
						<span class="cap-badge ${capClass}" title="Comensales / Capacidad">
							${seatedSeats} / ${table.capacity}
						</span>
						<button type="button" style="background:none; border:none; color: var(--accent-red); cursor:pointer; font-size: 1.1rem; padding: 2px 4px;" title="Eliminar Mesa" onclick="removeTable('${table.id}')">✖</button>
					</div>
				</div>

				<div style="margin-bottom: 0.75rem; display: flex; align-items: center; flex-wrap: wrap;">
					${dotsHtml}
				</div>

				<div style="display: flex; gap: 0.5rem; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.03); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.35rem 0.5rem; margin-bottom: 0.75rem; font-size: 0.8rem;">
					<label style="display: flex; align-items: center; gap: 0.3rem;">
						<span>Sillas:</span>
						<input type="number" min="1" max="30" value="${table.capacity}" style="width: 42px; padding: 2px; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.85rem;" onchange="updateTableCapacity('${table.id}', this.value)">
					</label>
					<label style="display: flex; align-items: center; gap: 0.3rem;">
						<span>Tipo:</span>
						<select style="padding: 2px 4px; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.8rem; background: #fff;" onchange="updateTableShape('${table.id}', this.value)">
							<option value="Round" ${table.shape === 'Round' ? 'selected' : ''}>Redonda</option>
							<option value="Rectangular" ${table.shape === 'Rectangular' ? 'selected' : ''}>Imperial</option>
							<option value="Sweetheart" ${table.shape === 'Sweetheart' ? 'selected' : ''}>Presidencial</option>
						</select>
					</label>
				</div>

				<div class="drop-zone" data-table-id="${table.id}" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)" style="flex: 1; min-height: 90px; margin-bottom: 0.75rem;">
				</div>

				<div style="margin-top: auto;">
					<select style="width: 100%; box-sizing: border-box; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;" onchange="assignUnassignedGuestToTable('${table.id}', this.value); this.value='';">
						${quickAssignOptions}
					</select>
				</div>
			`;

			tablesContainer.appendChild(tableDiv);
		});
	}

	function renderGuests() {
		unassignedDropzone.innerHTML = '';

		tables.forEach(t => {
			const zone = document.querySelector(`.drop-zone[data-table-id="${t.id}"]`);
			if (zone) zone.innerHTML = '';
		});

		let unassignedCount = 0;
		const query = unassignedSearch.value.toLowerCase().trim();

		guests.forEach(g => {
			const isAssigned = !!(g.tableId && document.querySelector(`.drop-zone[data-table-id="${g.tableId}"]`));

			if (isAssigned) {
				const targetZone = document.querySelector(`.drop-zone[data-table-id="${g.tableId}"]`);
				const row = document.createElement('div');
				row.className = 'seated-guest-row';
				row.draggable = true;
				row.setAttribute('data-guest-id', g.id);
				row.ondragstart = handleDragStart;

				row.innerHTML = `
					<div style="flex: 1; min-width: 0; padding-right: 0.25rem;">
						<strong style="display: block; font-size: 0.95rem; color: var(--fg-pencil); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${g.name}</strong>
						<span style="font-size: 0.75rem; color: var(--text-secondary);">
							${g.partySize > 1 ? `(${g.partySize} pases) ` : ''}${g.dietary && g.dietary !== 'Ninguna' && g.dietary !== 'None' ? `🍽️ ${g.dietary}` : ''}
						</span>
					</div>
					<button type="button" class="unseat-btn" title="Desasignar invitado" onclick="moveGuestToTable('${g.id}', 'unassigned')">✖</button>
				`;
				targetZone.appendChild(row);

			} else {
				g.tableId = null;
				unassignedCount += (parseInt(g.partySize) || 1);

				const matchesSearch = !query || g.name.toLowerCase().includes(query) || (g.dietary && g.dietary.toLowerCase().includes(query)) || (g.group && g.group.toLowerCase().includes(query));

				if (matchesSearch) {
					const card = document.createElement('div');
					card.className = 'guest-drag-card';
					card.draggable = true;
					card.setAttribute('data-guest-id', g.id);
					card.ondragstart = handleDragStart;

					let optionsHtml = `<option value="unassigned" selected>🪑 Asignar en...</option>`;
					tables.forEach(t => {
						optionsHtml += `<option value="${t.id}">${t.name}</option>`;
					});

					card.innerHTML = `
						<div style="flex: 1; min-width: 0;">
							<strong style="display: block; font-size: 0.95rem; color: var(--fg-pencil); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${g.name}</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">
								${g.partySize > 1 ? `(${g.partySize} pases) ` : ''}${g.dietary && g.dietary !== 'Ninguna' && g.dietary !== 'None' ? `🍽️ ${g.dietary}` : ''}
							</span>
						</div>
						<select style="font-size: 0.8rem; border: 1px solid var(--fg-pencil); border-radius: 3px; padding: 2px 4px; background: #fff;" onchange="moveGuestToTable('${g.id}', this.value)">
							${optionsHtml}
						</select>
					`;

					unassignedDropzone.appendChild(card);
				}
			}
		});

		tables.forEach(t => {
			const zone = document.querySelector(`.drop-zone[data-table-id="${t.id}"]`);
			if (zone && zone.children.length === 0) {
				zone.innerHTML = '<div style="text-align: center; padding: 1.25rem 0.5rem; color: var(--text-secondary); font-size: 0.8rem; font-style: italic;">Arrastra aquí o usa el desplegable</div>';
			}
		});

		if (unassignedDropzone.children.length === 0) {
			if (guests.length === 0) {
				unassignedDropzone.innerHTML = '<div style="text-align: center; padding: 2rem 0.5rem; color: var(--text-secondary); font-size: 0.9rem;">No hay invitados confirmados. ¡Pulsa "Cargar Ejemplo" para empezar!</div>';
			} else if (unassignedCount === 0) {
				unassignedDropzone.innerHTML = '<div style="text-align: center; padding: 2rem 0.5rem; color: #15803d; font-size: 0.95rem; font-weight: bold;">🎉 ¡Todos los comensales tienen mesa!</div>';
			} else {
				unassignedDropzone.innerHTML = '<div style="text-align: center; padding: 1.5rem 0.5rem; color: var(--text-secondary); font-size: 0.85rem; font-style: italic;">Ningún comensal coincide con la búsqueda.</div>';
			}
		}

		unassignedBadgeCount.textContent = unassignedCount;
		updateProgressAndStats();
	}

	function updateProgressAndStats() {
		const totalAttendingSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const seatedSeats = guests.filter(g => g.tableId).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const unassignedSeats = totalAttendingSeats - seatedSeats;
		const totalTableCapacity = tables.reduce((sum, t) => sum + (parseInt(t.capacity) || 8), 0);

		statTotalAttending.textContent = totalAttendingSeats;
		statSeatedCount.textContent = seatedSeats;
		statSeatedPct.textContent = totalAttendingSeats > 0 ? `${Math.round((seatedSeats / totalAttendingSeats) * 100)}% ubicados` : '0%';
		statUnassignedCount.textContent = unassignedSeats;
		statTableCount.textContent = tables.length;
		statCapacityTotal.textContent = `${totalTableCapacity} Sillas Totales`;

		const pct = totalAttendingSeats > 0 ? Math.round((seatedSeats / totalAttendingSeats) * 100) : 0;
		progressBarFill.style.width = `${pct}%`;
		progressText.textContent = `${pct}% Asignado (${seatedSeats}/${totalAttendingSeats} Comensales)`;
	}

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		if (tables.length === 0) {
			alert("No hay mesas configuradas.");
			return;
		}

		let tablesHtml = '';
		tables.forEach((t) => {
			const tGuests = guests.filter(g => g.tableId === t.id);
			const seatedSeats = tGuests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

			let guestRows = '';
			if (tGuests.length === 0) {
				guestRows = '<tr><td colspan="4" style="border:1px solid #ccc; padding:6px; font-style:italic; color:#777;">Sin comensales asignados</td></tr>';
			} else {
				tGuests.forEach((g, gIdx) => {
					guestRows += `
						<tr>
							<td style="border:1px solid #ccc; padding:6px;">${gIdx + 1}</td>
							<td style="border:1px solid #ccc; padding:6px; font-weight:bold;">${g.name}</td>
							<td style="border:1px solid #ccc; padding:6px; text-align:center;">${g.partySize || 1}</td>
							<td style="border:1px solid #ccc; padding:6px;">${g.dietary || 'Ninguna'}</td>
						</tr>
					`;
				});
			}

			tablesHtml += `
				<div style="margin-bottom: 24px;">
					<h3 style="background:#f2f2f2; border:1px solid #ccc; padding:8px; margin:0;">
						${t.name} — ${seatedSeats} / ${t.capacity} Comensales (${t.shape === 'Round' ? 'Redonda' : (t.shape === 'Rectangular' ? 'Imperial' : 'Presidencial')})
					</h3>
					<table style="width:100%; border-collapse:collapse; font-size:13px;">
						<thead>
							<tr style="background:#fafafa;">
								<th style="border:1px solid #ccc; padding:6px; width:30px;">#</th>
								<th style="border:1px solid #ccc; padding:6px; text-align:left;">Comensal</th>
								<th style="border:1px solid #ccc; padding:6px; width:60px; text-align:center;">Pases</th>
								<th style="border:1px solid #ccc; padding:6px; text-align:left;">Menú / Dieta</th>
							</tr>
						</thead>
						<tbody>
							${guestRows}
						</tbody>
					</table>
				</div>
			`;
		});

		const totalAttendingSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const seatedSeats = guests.filter(g => g.tableId).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Plano Oficial de Mesas de Boda</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Plano Oficial de Mesas del Banquete</h1>
				<p>Generado el ${new Date().toLocaleDateString('es-ES')} | Mesas Totales: ${tables.length} | Comensales Sentados: ${seatedSeats} de ${totalAttendingSeats}</p>
				${tablesHtml}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Plano_Mesas_Boda_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const printDate = document.getElementById('print-date');
		const printSeatedCount = document.getElementById('print-seated-count');
		const printContent = document.getElementById('print-tables-content');

		printDate.textContent = new Date().toLocaleDateString('es-ES');
		const totalAttendingSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const seatedSeats = guests.filter(g => g.tableId).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		printSeatedCount.textContent = `${seatedSeats} de ${totalAttendingSeats} Comensales Confirmados (${tables.length} Mesas)`;

		let out = '';
		tables.forEach(t => {
			const tGuests = guests.filter(g => g.tableId === t.id);
			const seated = tGuests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

			let rows = '';
			tGuests.forEach(g => {
				rows += `<tr>
					<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">${g.name}</td>
					<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${g.partySize || 1}</td>
					<td style="border: 1px solid #ccc; padding: 6px;">${g.dietary || 'Ninguna'}</td>
				</tr>`;
			});

			out += `
				<div style="margin-bottom: 20px; page-break-inside: avoid;">
					<h3 style="background:#f2f2f2; border:1px solid #ccc; padding: 6px 10px; margin: 0 0 5px 0; font-size: 14px;">
						${t.name} (${seated} / ${t.capacity} comensales)
					</h3>
					<table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 10px;">
						<thead>
							<tr style="background:#fafafa;">
								<th style="border:1px solid #ccc; padding:5px; text-align:left;">Comensal</th>
								<th style="border:1px solid #ccc; padding:5px; width:60px; text-align:center;">Pases</th>
								<th style="border:1px solid #ccc; padding:5px; text-align:left;">Menú / Dieta</th>
							</tr>
						</thead>
						<tbody>
							${rows || '<tr><td colspan="3" style="border:1px solid #ccc; padding:6px; font-style:italic;">Sin comensales asignados</td></tr>'}
						</tbody>
					</table>
				</div>
			`;
		});

		printContent.innerHTML = out;
		window.print();
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Mesa,Capacidad,Comensal,Pases,Grupo,Dietas\n";
		tables.forEach(t => {
			const tGuests = guests.filter(g => g.tableId === t.id);
			if (tGuests.length === 0) {
				csv += `"${t.name}",${t.capacity},"Sin Asignar",0,"-","-"\n`;
			} else {
				tGuests.forEach(g => {
					csv += `"${t.name}",${t.capacity},"${(g.name||'').replace(/"/g, '""')}",${g.partySize || 1},"${g.group||''}","${(g.dietary||'').replace(/"/g, '""')}"\n`;
				});
			}
		});

		const unassigned = guests.filter(g => !g.tableId);
		unassigned.forEach(g => {
			csv += `"Sin Asignar",-,"${(g.name||'').replace(/"/g, '""')}",${g.partySize || 1},"${g.group||''}","${(g.dietary||'').replace(/"/g, '""')}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Plano_Mesas_Boda_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	loadData();
	renderTables();
	renderGuests();
</script>
