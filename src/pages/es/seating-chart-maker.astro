---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/seating-chart-maker/#webapp",
      "name": "Organizador de Mesas y Distribución de Invitados de Boda",
      "url": "https://manage.wedding/es/seating-chart-maker",
      "inLanguage": "es",
      "description": "Herramienta online gratuita para organizar las mesas del banquete de boda. Asigna comensales a mesas redondas, rectangulares, imperiales o mesa presidencial y exporta el plano a Word, PDF o Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Organizar la Distribución de Mesas del Banquete de Boda",
      "description": "Guía en 4 pasos para configurar mesas, asignar invitados y exportar el plano definitivo para el jefe de sala.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Configura las Mesas del Salón",
          "text": "Añade mesas redondas (150 cm para 8-9 comensales o 180 cm para 10-11), rectangulares o mesa presidencial."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Agrupa a los Invitados por Afinidad",
          "text": "Organiza a los comensales por círculos cercanos (familia directa, amigos de la universidad, compañeros de trabajo) para asegurar una sobremesa amena."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Asigna los Asientos o Usa el Autocompletado",
          "text": "Arrastra las tarjetas a cada mesa o utiliza el selector rápido para ubicar a los invitados, situando a la familia directa más cerca de la mesa presidencial."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Exporta el Plano Definitivo para Finca y Catering",
          "text": "Descarga el listado completo en Word (.doc), PDF listo para imprimir o Excel (.csv) para entregarlo al metre y al diseñador de la cartelería."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos comensales caben en una mesa redonda de boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una mesa redonda estándar de 150 cm (5 pies) acoge cómodamente a 8 comensales (máximo 9 apretados). Una mesa de 180 cm (6 pies) acoge con holgura a 10 comensales (máximo 11-12 con montaje reducido)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo exportar el plano de mesas a Word o PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Haz clic en 'Exportar Word (.doc)' o 'Exportar PDF / Imprimir' en la barra superior. Se generará de inmediato un documento desglosado mesa por mesa con nombres, dietas y número de sillas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Mesa Presidencial o Mesa de los Novios a Solas (Sweetheart)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mesa presidencial tradicional española reúne a los novios con los padres de ambos y padrinos. La mesa a solas (Sweetheart) es una opción moderna e íntima que permite a los padres sentarse como anfitriones en sus respectivas mesas familiares."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Organizador de Mesas de Boda (Seating Chart Interactivo) | Manage.Wedding"
	description="Organiza las mesas del banquete de tu boda online y gratis. Distribuye comensales en mesas redondas e imperiales y exporta a Word, PDF y Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Organizador de Mesas" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Organizador de Mesas <span class="accent-italic">Seating Chart</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Distribuye a tus invitados en mesas redondas, imperiales o mesa presidencial. Controla aforos y exporta a <strong>Word (.doc)</strong>, <strong>PDF</strong> o <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- 💡 3-Step Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
				<strong class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem;">
					<span>💡</span> Cómo Organizar el Plano de Mesas en 3 Pasos
				</strong>
				<span style="font-size: 0.85rem; color: var(--fg-pencil); font-family: var(--font-body); font-style: italic;">
					¡Rápido e intuitivo!
				</span>
			</div>
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: var(--accent-blue); display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						1️⃣ Crea las Mesas
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Pulsa <strong>"+ Añadir Mesa"</strong>. Elige el tipo (⭕ Redonda, ▭ Imperial, ❤️ Presidencial) y la capacidad (ej. 8 o 10 sillas).
					</p>
				</div>

				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: #15803d; display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						2️⃣ Asigna Invitados
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Arrastra las tarjetas o usa el desplegable <strong>"🪑 Asignar"</strong> en cada comensal. ¡O haz clic en <strong>"⚡ Auto-Rellenar"</strong>!
					</p>
				</div>

				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: var(--accent-red); display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						3️⃣ Exporta el Plano
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Pulsa <strong>"Exportar Word"</strong> o <strong>"Exportar PDF"</strong> para entregar el listado de sala a la finca y al catering.
					</p>
				</div>
			</div>
		</div>

		<!-- Overview Dashboard & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						🪑 Progreso de Asignación de Mesas
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Sincronizado con la lista de invitados y confirmaciones RSVP
					</span>
				</div>

				<!-- Export & Control Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Exportar Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Exportar PDF / Imprimir
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Exportar Excel (.csv)
					</button>
					<button type="button" id="btn-add-table" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Añadir Mesa
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						🔄 Cargar Ejemplo
					</button>
					<button type="button" id="btn-clear-seating" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🧹 Desasignar Todo
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Invitados Confirmados</span>
					<strong id="stat-total-attending" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Comensales a Sentar</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Sentados en Mesa</span>
					<strong id="stat-seated-count" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-seated-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% ubicados</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Sin Asignar (Pendientes)</span>
					<strong id="stat-unassigned-count" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span style="font-size: 0.75rem; color: #854d0e; display: block;">Faltan por Colocar</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Mesas Creadas</span>
					<strong id="stat-table-count" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">0</strong>
					<span id="stat-capacity-total" style="font-size: 0.75rem; color: #1e40af; display: block;">0 Sillas Totales</span>
				</div>
			</div>

			<!-- Dynamic Seating Progress Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Progreso de Asignación de Sala</span>
					<span id="progress-text" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">0% Asignado</span>
				</div>
				<div style="height: 24px; border: 2px solid var(--fg-pencil); border-radius: 12px; overflow: hidden; background: #e5e0d8;">
					<div id="progress-bar-fill" style="height: 100%; width: 0%; background-color: #22c55e; transition: width 0.3s ease;"></div>
				</div>
			</div>
		</div>

		<!-- Interactive Seating Studio Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 340px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="seating-workspace-grid">
			
			<!-- Left Column: Unassigned Guests Tray + Quick Add -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						👥 Sin Asignar (<span id="unassigned-badge-count">0</span>)
					</h3>
					<button type="button" id="btn-auto-assign" class="hand-btn secondary" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">
						⚡ Auto-Rellenar
					</button>
				</div>

				<!-- Search Unassigned -->
				<div style="margin-bottom: 0.75rem;">
					<input type="text" id="unassigned-search" placeholder="🔍 Buscar invitados sin mesa..." style="width: 100%; box-sizing: border-box; padding: 0.55rem 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: var(--bg-paper); color: var(--fg-pencil);">
				</div>

				<!-- Drop Zone for Unassigned -->
				<div id="unassigned-dropzone" class="drop-zone" data-table-id="unassigned" style="min-height: 240px; max-height: 480px; overflow-y: auto; padding: 0.5rem; border: 2px dashed var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); display: flex; flex-direction: column; gap: 0.5rem;">
				</div>

				<!-- Quick Add Guest Directly -->
				<div style="margin-top: 1.25rem; border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
					<label for="quick-guest-name" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						➕ Añadir Invitado Rápido:
					</label>
					<form id="quick-add-guest-form" style="display: flex; gap: 0.4rem; align-items: center;">
						<input type="text" id="quick-guest-name" required placeholder="Nombre de invitado..." style="flex: 1; min-width: 0; padding: 0.55rem 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: var(--bg-paper); color: var(--fg-pencil);">
						<select id="quick-guest-party" title="Pases" style="width: 80px; padding: 0.55rem 0.25rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff; color: var(--fg-pencil);">
							<option value="1">1 Pase</option>
							<option value="2" selected>2 Pases</option>
							<option value="3">3 Pases</option>
							<option value="4">4 Pases</option>
							<option value="5">5+ Pases</option>
						</select>
						<button type="submit" class="hand-btn" style="padding: 0.55rem 0.85rem; font-size: 0.95rem; white-space: nowrap;">
							➕
						</button>
					</form>
				</div>

			</div>

			<!-- Right Column: Interactive Reception Tables Layout Grid -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h3 class="font-heading" style="font-size: 1.4rem; margin: 0; color: var(--fg-pencil);">
							🍽️ Salón del Banquete y Mesas
						</h3>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
							Arrastra comensales a las mesas o usa <strong>"➕ Asignar"</strong> en cada tarjeta
						</span>
					</div>
					
					<button type="button" id="btn-add-table-top" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
						➕ Nueva Mesa
					</button>
				</div>

				<!-- Tables Grid Container -->
				<div id="tables-grid-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;">
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Plano Oficial de Mesas del Banquete</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado el: <span id="print-date"></span> | Total Sentados: <span id="print-seated-count"></span></p>
			</div>
			<div id="print-tables-content"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Regla de Oro en Medidas y Aforos de Mesas
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					Dimensiones de Hostelería
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Capacidades Estándar de Mesas de Boda:</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Redonda 150 cm = 8–9 Comensales</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Redonda 180 cm = 10–11 Comensales</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Imperial 240 cm = 8–10 Comensales</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Paso de Camareros:</strong> Deja al menos <strong>150 cm (1,5 metros)</strong> de separación entre bordes de mesa para permitir el retroceso de las sillas y el paso fluido del servicio.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Tipo de Mesa</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Dimensiones</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Capacidad Ideal</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Capacidad Máxima</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Mantel Recomendado</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Mesa Presidencial Novios</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">240 cm frontal / 150 cm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">6 Pax (Novios + Padres)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">8 Pax</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Falda de gala hasta el suelo</td>
						</tr>
						<tr style="background: #faf8f3;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Redonda 150 cm (5 Pies)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Ø 152 cm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">8 Comensales</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">9 Comensales</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mantel Ø 300 cm</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Redonda 180 cm (6 Pies)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Ø 183 cm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">10 Comensales</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">11–12 Comensales</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mantel Ø 330 cm</td>
						</tr>
						<tr style="background: #faf8f3;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Rectangular / Imperial 240 cm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">90 × 244 cm</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">8 Comensales (4 por lado)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">10 (+2 cabeceras)</td>
