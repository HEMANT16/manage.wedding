---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/liquor-wedding-calculator/#webapp",
      "name": "Calculadora de Licores y Destilados para Barra Libre de Boda",
      "url": "https://manage.wedding/es/liquor-wedding-calculator",
      "inLanguage": "es",
      "description": "Calcula el número exacto de botellas de ginebra, ron, whisky, vodka, tequila, vino, cerveza, refrescos, fruta y hielo para la barra libre de tu boda. Incluye formatos de 750 ml y 1,75 L y presupuesto estimado.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular Licores y Destilados para la Barra Libre de una Boda",
      "description": "Guía paso a paso para desglosar botellas de alcohol de 750 ml y 1,75 L, refrescos y cítricos para una barra libre.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Introduce Invitados y Horas de Celebración",
          "text": "Indica el total de invitados adultos mayores de 18 años y la duración de la barra libre (habitualmente 4 a 5 horas)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Ajusta la Proporción entre Vino, Cerveza y Copas",
          "text": "Elige la distribución de consumo según el estilo de tus invitados (Estándar: 40% Vino, 40% Combinados/Copas, 20% Cerveza)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Personaliza los Tipos de Licores",
          "text": "Modifica los porcentajes de Ginebra (Gin Tonics), Ron (Cubatas/Mojitos), Whisky, Vodka y Tequila según vuestras preferencias."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Exporta la Lista de Compra para Bodegas o Mayoristas",
          "text": "Obtén el desglose detallado de botellas, botellas de 2L de refrescos, piezas de lima/limón/naranja, kilos de hielo y coste aproximado."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántas copas o combinados rinde una botella de licor de 750 ml frente a una de 1,75 L?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una botella de 750 ml rinde aproximadamente 15 a 16 copas o combinados (con un servicio de 50 ml de alcohol). Una botella formato grande de 1,75 L rinde unas 38 a 39 copas y suele abaratar el coste entre un 20% y un 30% en compras al por mayor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la proporción habitual de licores en una boda española?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En las bodas en España y Europa, la distribución más habitual es: Ginebra (30%–35% por el auge del Gin Tonic), Ron (25%), Whisky (20%), Vodka (15%) y Tequila o licores digestivos (10%)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto hielo se necesita para combinados y cócteles?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para una barra libre completa se calcula aproximadamente 1 kg de hielo por invitado, necesario tanto para enfriar botellas en cubiteras como para llenar los vasos de tubo o copas de balón."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos refrescos se necesitan por botella de destilado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se calculan entre 3 y 4 botellas de refresco de 2 litros (o unas 8 a 10 latas de 33cl) por cada 2 botellas de 750 ml de destilado (Tónica, Cola, Limón, Naranja y Soda)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Licores y Barra Libre para Bodas (Lista de Compra) | Manage.Wedding"
	description="Calcula botellas de ginebra, ron, whisky, vodka, cerveza, vino, refrescos y hielo para la barra libre de tu boda. Exporta a Word y PDF."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Licores y Barra Libre de Boda" category="food-dining" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Destilados, Refrescos y Hielo</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Calculadora de Licores <span class="accent-italic">y Barra Libre</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcula el número exacto de botellas de Ginebra, Whisky, Tequila, Ron y Vodka (formatos 750 ml y 1,75 L), refrescos, fruta cortada y hielo para tu barra libre.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Inputs & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Configuración de la Barra
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Cálculo en Tiempo Real
					</span>
				</div>

				<!-- Signature Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="bar-preset">Tipo de Barra y Preferencias</label>
					<select id="bar-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="classic-open-bar" selected>🍸 Barra Libre Clásica (40% Vino, 40% Copas/Licores, 20% Cerveza)</option>
						<option value="cocktail-heavy">🍹 Boda Fiestera / Más Copas (50% Licores, 30% Vino, 20% Cerveza)</option>
						<option value="margarita-bourbon">🌵 Ginebra, Ron y Whisky (Especial Gin Tonics y Combinados)</option>
						<option value="beer-wine-light-liquor">🍺 Preferencia Cerveza y Vino (45% Vino, 35% Cerveza, 20% Licores)</option>
						<option value="custom">✏️ Ajuste Personalizado</option>
					</select>
				</div>

				<!-- Guest Count & Duration -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="guests">Invitados Mayores de 18 Años</label>
						<input type="number" id="guests" class="form-input" value="120" min="10" max="600" step="5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
					<div>
						<label class="form-label" for="hours">Horas de Barra Libre</label>
						<input type="number" id="hours" class="form-input" value="4" min="1" max="10" step="0.5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
				</div>

				<!-- Crowd Drinking Vibe & Bottle Size Format -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="vibe">Ritmo de Consumo</label>
						<select id="vibe" class="form-input" style="cursor: pointer;">
							<option value="light">Moderado (-25% Bebidas)</option>
							<option value="average" selected>Estándar (1 Copa / Hora)</option>
							<option value="heavy">Fiestero (+25% Bebidas)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="bottle-size">Formato de Botella</label>
						<select id="bottle-size" class="form-input" style="cursor: pointer; font-weight: 600;">
							<option value="750" selected>Estándar 750 ml (16 copas)</option>
							<option value="1750">Formato Grande 1,75 L (39 copas)</option>
						</select>
					</div>
				</div>

				<!-- Category Preference Sliders (Beer / Wine / Liquor) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil);">
							Reparto por Categorías (%)
						</strong>
						<span id="sum-pref-check" style="font-size: 0.82rem; font-weight: 700; color: #16a34a; background: #f0fdf4; padding: 2px 6px; border-radius: 4px;">
							Total: 100%
						</span>
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍷 Vino y Cava</span>
							<span id="val-pref-wine">40%</span>
						</div>
						<input type="range" id="pref-wine" min="0" max="100" value="40" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍸 Licores y Combinados</span>
							<span id="val-pref-liquor">40%</span>
						</div>
						<input type="range" id="pref-liquor" min="0" max="100" value="40" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.85rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍺 Cerveza y Refrescos</span>
							<span id="val-pref-beer">20%</span>
						</div>
						<input type="range" id="pref-beer" min="0" max="100" value="20" style="width: 100%; cursor: pointer;" />
					</div>
				</div>

				<!-- Spirit Type Allocation Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.75rem;">
						Desglose por Tipo de Destilado (%)
					</strong>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌿 Ginebra (Gin Tonic, Cítricos)</span>
							<span id="val-liq-gin">30%</span>
						</div>
						<input type="range" id="liq-gin" min="0" max="100" value="30" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌴 Ron (Cubalibre, Mojito, Añejo)</span>
							<span id="val-liq-rum">25%</span>
						</div>
						<input type="range" id="liq-rum" min="0" max="100" value="25" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🥃 Whisky / Bourbon (Con Cola, Ginger Ale o Solo)</span>
							<span id="val-liq-whiskey">20%</span>
						</div>
						<input type="range" id="liq-whiskey" min="0" max="100" value="20" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🍸 Vodka (Con Naranja, Tónica, Limón)</span>
							<span id="val-liq-vodka">15%</span>
						</div>
						<input type="range" id="liq-vodka" min="0" max="100" value="15" style="width: 100%; cursor: pointer;" />
					</div>

					<div class="form-group" style="margin-bottom: 0.75rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.2rem;">
							<span>🌵 Tequila / Licores Digestivos (Chupitos, Hierbas)</span>
							<span id="val-liq-tequila">10%</span>
						</div>
						<input type="range" id="liq-tequila" min="0" max="100" value="10" style="width: 100%; cursor: pointer;" />
					</div>
				</div>

				<!-- Champagne Toast Option -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.95rem; font-weight: 600;">
						<input type="checkbox" id="check-champagne-toast" checked style="width: 18px; height: 18px;" />
						<span>Incluir Brindis con Cava / Champán (+1 copa / invitado)</span>
					</label>
				</div>

			</div>

			<!-- Right Column: Results & Shopping List -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Primary Results Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Total Consumiciones Estimadas
						</span>
						<span id="vibe-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							Ritmo Estándar
						</span>
					</div>

					<div id="res-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						480 Bebidas
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.25rem 0;">
						Estimado para <strong id="res-guest-count-label" style="color: var(--fg-pencil);">120 invitados</strong> durante <strong id="res-hours-label" style="color: var(--fg-pencil);">4 horas</strong> de barra libre.
					</p>

					<!-- Visual Split Bar -->
					<div style="display: flex; height: 28px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; margin-bottom: 1.5rem; font-size: 0.82rem; font-weight: 800; color: #fff; text-align: center; line-height: 28px;">
						<div id="chart-wine" style="background-color: var(--accent-red); width: 40%; transition: width 0.2s;">Vino (40%)</div>
						<div id="chart-liquor" style="background-color: var(--fg-pencil); width: 40%; transition: width 0.2s;">Copas (40%)</div>
						<div id="chart-beer" style="background-color: var(--accent-blue); width: 20%; transition: width 0.2s;">Cerveza (20%)</div>
					</div>

					<!-- Estimated Retail Cost Callout -->
					<div style="background: #fdf6e2; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
						<div>
							<strong style="display: block; font-size: 0.92rem; color: var(--fg-pencil);">Presupuesto Estimado de Compra:</strong>
							<span style="font-size: 0.82rem; color: #64748b;">(Precios medios en distribuidoras y mayoristas)</span>
						</div>
						<span id="res-est-cost" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red); font-weight: 800;">
							1.350 €
						</span>
					</div>

					<!-- Itemized Shopping List Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Spirits Section -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin-bottom: 0.6rem;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🥃 Licores y Destilados (<span id="bottle-size-label">750 ml</span>)
							</strong>
							<strong id="res-total-liquor-bottles" style="color: var(--accent-red);">12 Botellas</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Ginebra (Gin Tonics):</span>
							<strong id="res-gin">4 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Ron (Añejo / Blanco):</span>
							<strong id="res-rum">3 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Whisky / Bourbon:</span>
							<strong id="res-whiskey">3 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Vodka:</span>
							<strong id="res-vodka">2 btls</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Tequila / Hierbas:</span>
							<strong id="res-tequila">1 btl</strong>
						</div>

						<!-- Wine & Beer Section -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin: 1rem 0 0.6rem 0;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🍷 Vino, Cerveza y Cava
							</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Vino de Mesa (750 ml):</span>
							<strong id="res-wine">38 btls (22 Tinto / 16 Blanco)</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Cerveza (Cajas de 24 uds):</span>
							<strong id="res-beer">4 Cajas (96 Cervezas)</strong>
						</div>
						<div id="row-champagne" style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Brindis con Cava (750 ml):</span>
							<strong id="res-champagne" style="color: var(--accent-red);">20 btls</strong>
						</div>

						<!-- Mixers & Garnishes -->
						<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--fg-pencil); padding-bottom: 0.4rem; margin: 1rem 0 0.6rem 0;">
							<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
								🍋 Refrescos, Cítricos y Hielo
							</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Refrescos 2L (Tónica, Cola, Limón, Naranja):</span>
							<strong id="res-mixers">24 Botellas (2L)</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>Cítricos (Limones, Limas, Naranjas):</span>
							<strong id="res-garnishes">30 Limones • 25 Limas • 15 Naranjas</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.92rem;">
							<span>Hielo Necesario:</span>
							<strong id="res-ice">100 kg (25 bolsas de 4 kg)</strong>
						</div>

					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-shopping-list" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Lista (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar a Word (.doc)
						</button>
					</div>

				</div>

				<!-- Bartending Pro Tip Callout -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						💡 Consejo Profesional para la Barra Libre:
					</strong>
					<p style="margin: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<strong>Botellas Grandes de 1,75 L:</strong> El formato de 1,75 L ahorra hasta un 25% respecto a las botellas clásicas de 750 ml y facilita el trabajo a los camareros en barras concurridas. ¡Pregunta a tu distribuidor si disponen de este formato para Ginebra y Ron!
					</p>
				</div>

			</div>

		</div>

