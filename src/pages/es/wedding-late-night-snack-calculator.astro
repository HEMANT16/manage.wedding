---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calculadora de Recena de Boda y Pizzas Nocturnas",
      "url": "https://manage.wedding/es/wedding-late-night-snack-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calcula el número exacto de pizzas, hamburguesas o tacos para la recena de boda según los invitados que se quedan de fiesta y el consumo de barra libre.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calculadora de Recena de Boda y Pizzas — Cantidades y Horarios"
	description="Calcula cuántas pizzas, hamburguesas o porciones pedir para la recena de la boda según los invitados nocturnos, la barra libre y el horario de entrega."
	lang="es"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Miga de pan" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href=""" style="color: var(--text-secondary); text-decoration: none;">Inicio</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/es/dining" style="color: var(--text-secondary); text-decoration: none;">Banquete y Catering</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Calculadora de Recena</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🍕</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Energía para la Pista de Baile & Recena de Boda</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calculadora de Recena de Boda y Pizzas
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Evita quedarte corto en la fiesta o tirar cajas enteras de comida. Calcula el <strong>número real de invitados que se quedan hasta tarde</strong>, cajas de pizza por sabor, miniburgers y el horario de entrega.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Inputs -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>👥</span> 1. Invitados y Nivel de Fiesta
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-total-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Invitados en Banquete:</label>
						<input type="number" id="input-total-guests" min="20" max="500" value="120" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="select-crowd-stay" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">% que se queda hasta el final:</label>
						<select id="select-crowd-stay" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="0.55">Boda Tranquila / Mayoría Familiar (55%)</option>
							<option value="0.65" selected>Boda Estándar (65%)</option>
							<option value="0.80">Boda Muy Festera / Amigos Jóvenes (80%)</option>
						</select>
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🍔 2. Tipo de Recena y Barra Libre
				</h2>

				<div style="margin-bottom: 1rem;">
					<label for="select-snack-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Opción de Recena:</label>
					<select id="select-snack-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="pizza" selected>🍕 Pizzas Familiares (8 porciones grandes por caja)</option>
						<option value="sliders">🍔 Mini Hamburguesas & Cucuruchos de Patatas</option>
						<option value="tacos">🌮 Tacos Mexicanos (Carne, Pollo, Vegetariano)</option>
						<option value="pretzels">🥨 Pretzels Horneados con Queso Caliente</option>
						<option value="donuts">🍩 Churros con Chocolate / Mesa de Donuts</option>
					</select>
				</div>

				<div style="margin-bottom: 1rem;">
					<label for="select-bar-factor" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Intensidad de Barra Libre:</label>
					<select id="select-bar-factor" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="1.0">🍺 Consumo Moderado / Vino y Cerveza (1,8 - 2 porciones/pers.)</option>
						<option value="1.15" selected>🍸 Barra Libre Activa / Mucho Baile (2,2 - 2,5 porciones/pers.)</option>
						<option value="1.30">🔥 Barra Libre Intensa / After-Party (2,8 - 3 porciones/pers.)</option>
					</select>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					⏰ 3. Fin de Fiesta y Presupuesto
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="input-reception-end" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Hora de Fin de Fiesta:</label>
						<select id="input-reception-end" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="03:00">03:00 AM</option>
							<option value="04:00">04:00 AM</option>
							<option value="05:00" selected>05:00 AM</option>
							<option value="06:00">06:00 AM</option>
						</select>
					</div>
					<div>
						<label for="input-unit-cost" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Precio Estimado (€/pizza o €/pers.):</label>
						<input type="number" id="input-unit-cost" min="1" max="100" value="18" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Cálculo de Recena</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Pedido Recomendado
						</h2>
					</div>
					<span id="badge-night-guests" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">78 Invitados Recena</span>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Cantidad a Pedir</span>
						<strong id="stat-primary-quantity" style="font-size: 2rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">22 Pizzas</strong>
						<span id="stat-primary-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(176 porciones totales)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Coste Estimado</span>
						<strong id="stat-total-cost" style="font-size: 2rem; font-weight: 900; color: #1e40af; line-height: 1.1;">396 €</strong>
						<span id="stat-cost-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">~5,08 € por persona en recena</span>
					</div>
				</div>

				<div id="box-pizza-breakdown" style="background: #fef3c7; border: 1.5px solid #d97706; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #92400e; display: block; margin-bottom: 0.35rem;">🍕 Distribución de Sabores de Pizza:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #78350f;">
						<div>• <strong id="stat-top-pep">11 Jamón / Barbacoa / Pepperoni</strong></div>
						<div>• <strong id="stat-top-cheese">7 4 Quesos / Margarita</strong></div>
						<div>• <strong id="stat-top-veg">3 Vegetariana / Champiñones</strong></div>
						<div>• <strong id="stat-top-gf">1 Sin Gluten / Sin Lactosa</strong></div>
					</div>
				</div>

				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🚚 Llegada Repartidor / Food Truck:</span>
						<strong id="stat-time-delivery" style="color: #1e40af;">03:30 AM</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🛎️ Servir en Pista de Baile:</span>
						<strong id="stat-time-serve" style="color: #b91c1c;">03:45 AM</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">🎆 Fin de Fiesta / Cierre:</span>
						<strong id="stat-time-exit" style="color: var(--fg-pencil);">05:00 AM</strong>
					</div>
				</div>

				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Imprimir Hoja Pedido (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Exportar Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/es/wedding-late-night-snack-calculator" category="dining" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-snack-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Hoja de Pedido de Recena de Boda y Pizzas</h1>
				<p id="print-snack-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Coordinación Catering y Entrega | Manage.Wedding</p>
			</div>
			<div id="print-snack-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const inputTotalGuests = document.getElementById('input-total-guests');
	const selectCrowdStay = document.getElementById('select-crowd-stay');
	const selectSnackType = document.getElementById('select-snack-type');
	const selectBarFactor = document.getElementById('select-bar-factor');
	const inputReceptionEnd = document.getElementById('input-reception-end');
	const inputUnitCost = document.getElementById('input-unit-cost');

	const badgeNightGuests = document.getElementById('badge-night-guests');
	const statPrimaryQuantity = document.getElementById('stat-primary-quantity');
	const statPrimarySub = document.getElementById('stat-primary-sub');
	const statTotalCost = document.getElementById('stat-total-cost');
	const statCostSub = document.getElementById('stat-cost-sub');

	const boxPizzaBreakdown = document.getElementById('box-pizza-breakdown');
	const statTopPep = document.getElementById('stat-top-pep');
	const statTopCheese = document.getElementById('stat-top-cheese');
	const statTopVeg = document.getElementById('stat-top-veg');
	const statTopGf = document.getElementById('stat-top-gf');

	const statTimeDelivery = document.getElementById('stat-time-delivery');
	const statTimeServe = document.getElementById('stat-time-serve');
	const statTimeExit = document.getElementById('stat-time-exit');

	function calculateSnacks() {
		const totalGuests = Math.max(10, parseInt(inputTotalGuests.value, 10) || 120);
		const stayRate = parseFloat(selectCrowdStay.value) || 0.65;
		const lateGuests = Math.round(totalGuests * stayRate);
		const barMultiplier = parseFloat(selectBarFactor.value) || 1.15;
		const unitCost = parseFloat(inputUnitCost.value) || 18;
		const snackType = selectSnackType.value;

		badgeNightGuests.textContent = `${lateGuests} Invitados Recena`;

		let totalCost = 0;

		if (snackType === 'pizza') {
			boxPizzaBreakdown.style.display = 'block';
			const slicesPerPerson = 2.25 * barMultiplier;
			const totalSlices = Math.round(lateGuests * slicesPerPerson);
			const totalPies = Math.ceil(totalSlices / 8);

			statPrimaryQuantity.textContent = `${totalPies} Pizzas Familiares`;
			statPrimarySub.textContent = `(${totalSlices} porciones de 8 cortes)`;

			const pepPies = Math.round(totalPies * 0.50);
			const cheesePies = Math.round(totalPies * 0.30);
			const vegPies = Math.max(1, Math.round(totalPies * 0.15));
			const gfPies = Math.max(1, totalPies - pepPies - cheesePies - vegPies);

			statTopPep.textContent = `${pepPies} Jamón / Barbacoa / Pepperoni`;
			statTopCheese.textContent = `${cheesePies} 4 Quesos / Margarita`;
			statTopVeg.textContent = `${vegPies} Vegetariana / Champiñones`;
			statTopGf.textContent = `${gfPies} Sin Gluten / Sin Lactosa`;

			totalCost = totalPies * unitCost;
		} else if (snackType === 'sliders') {
			boxPizzaBreakdown.style.display = 'none';
			const slidersPerPerson = Math.round(2.3 * barMultiplier);
			const totalSliders = lateGuests * slidersPerPerson;
			const fryCones = Math.round(lateGuests * 0.9);

			statPrimaryQuantity.textContent = `${totalSliders} Mini Burgers`;
			statPrimarySub.textContent = `+ ${fryCones} Cucuruchos Patatas`;
			totalCost = lateGuests * unitCost;
		} else if (snackType === 'tacos') {
			boxPizzaBreakdown.style.display = 'none';
			const tacosPerPerson = Math.round(2.6 * barMultiplier);
			const totalTacos = lateGuests * tacosPerPerson;

			statPrimaryQuantity.textContent = `${totalTacos} Tacos`;
			statPrimarySub.textContent = `(~${tacosPerPerson} tacos por invitado)`;
			totalCost = lateGuests * unitCost;
		} else if (snackType === 'pretzels') {
			boxPizzaBreakdown.style.display = 'none';
			const totalPretzels = Math.round(lateGuests * 1.15);

			statPrimaryQuantity.textContent = `${totalPretzels} Pretzels`;
			statPrimarySub.textContent = `+ Queso fundido caliente`;
			totalCost = lateGuests * unitCost;
		} else {
			boxPizzaBreakdown.style.display = 'none';
			const totalDonuts = Math.round(lateGuests * 1.5);

			statPrimaryQuantity.textContent = `${totalDonuts} Churros / Donuts`;
			statPrimarySub.textContent = `(~1,5 dulces por persona)`;
			totalCost = lateGuests * unitCost;
		}

		statTotalCost.textContent = `${Math.round(totalCost).toLocaleString()} €`;
		statCostSub.textContent = `~${(totalCost / lateGuests).toFixed(2)} € por invitado nocturno`;

		const endTime = inputReceptionEnd.value;
		let [endH, endM] = endTime.split(':').map(Number);

		const formatTime = (h, m) => {
			return `${h < 10 ? '0' : ''}${h}:${m < 10 ? '0' : ''}${m}`;
		};

		let serveH = (endH - 1 + 24) % 24;
		let serveM = (endM - 15 + 60) % 60;
		if (endM < 15) serveH = (serveH - 1 + 24) % 24;

		let delivH = (serveH + 24) % 24;
		let delivM = (serveM - 15 + 60) % 60;
		if (serveM < 15) delivH = (delivH - 1 + 24) % 24;

		statTimeDelivery.textContent = formatTime(delivH, delivM);
		statTimeServe.textContent = formatTime(serveH, serveM);
		statTimeExit.textContent = formatTime(endH, endM);

		document.getElementById('print-snack-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Concepto</th>
						<th style="padding:6pt;">Detalle</th>
						<th style="padding:6pt; text-align:right;">Cantidad a Pedir</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Invitados en Recena</td>
						<td style="padding:6pt;">${totalGuests} total x ${Math.round(stayRate * 100)}% de permanencia</td>
						<td style="padding:6pt; text-align:right;"><strong>${lateGuests} invitados</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Pedido de Recena</td>
						<td style="padding:6pt;">${selectSnackType.options[selectSnackType.selectedIndex].text}</td>
						<td style="padding:6pt; text-align:right; font-weight:bold; color:#b91c1c;">${statPrimaryQuantity.textContent}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Hora Llegada Repartidor</td>
						<td style="padding:6pt;">Ventana de entrega comida caliente</td>
						<td style="padding:6pt; text-align:right; font-weight:bold; color:#1e40af;">${statTimeDelivery.textContent}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Hora de Servir en Pista</td>
						<td style="padding:6pt;">75 min antes del fin de fiesta</td>
						<td style="padding:6pt; text-align:right; font-weight:bold;">${statTimeServe.textContent}</td>
					</tr>
					<tr style="background:#f0fdf4; font-weight:bold; font-size:11pt; border-top:2pt solid #15803d;">
						<td style="padding:8pt; color:#15803d;">COSTE ESTIMADO</td>
						<td style="padding:8pt; color:#15803d;">Total Pedido / Food Truck</td>
						<td style="padding:8pt; text-align:right; color:#15803d;">${Math.round(totalCost)} €</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	[inputTotalGuests, selectCrowdStay, selectSnackType, selectBarFactor, inputReceptionEnd, inputUnitCost].forEach(el => {
		el.addEventListener('input', calculateSnacks);
		el.addEventListener('change', calculateSnacks);
	});

	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateSnacks();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateSnacks();
		const totalCost = statTotalCost.textContent;
		const quantity = statPrimaryQuantity.textContent;
		const lateGuests = badgeNightGuests.textContent;
		const deliveryTime = statTimeDelivery.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Recena de Boda</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Pedido de Recena de Boda</h1>
				<p><strong>Invitados Recena:</strong> ${lateGuests} | <strong>Cantidad:</strong> ${quantity} | <strong>Hora de Entrega:</strong> ${deliveryTime} | <strong>Coste:</strong> ${totalCost}</p>
				<hr/>
				<p><em>Generado por Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Recena-Boda-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateSnacks();
</script>
