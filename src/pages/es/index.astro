---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://manage.wedding/es/#website",
      "name": "Manage.Wedding — Suite de Calculadoras y Planificación de Bodas",
      "url": "https://manage.wedding/es/",
      "inLanguage": "es",
      "description": "Suite privada de calculadoras interactivas para bodas: cálculo de bebidas y barra libre, presupuestos reales, plano de mesas y papelería imprimible.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://manage.wedding/es/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Todas las calculadoras de Manage.Wedding son totalmente gratuitas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, 100% gratuitas, sin necesidad de registro, sin tarjetas de crédito y sin límites de uso. Todos los cálculos y descargas en PDF y Word se generan al instante en tu dispositivo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Manage.Wedding recopila o vende mis datos de invitados y presupuesto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Manage.Wedding funciona con una arquitectura de privacidad local (Local-First). Tu lista de invitados, presupuestos y direcciones se guardan exclusivamente en la memoria de tu navegador y nunca se envían a servidores externos ni a directorios comerciales."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuáles son las 4 fases principales para organizar una boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. Presupuesto y Finanzas (Distribución porcentual y revisión de costos de salón), 2. Banquete, Barra y Repostería (Cálculo de botellas para la barra libre y porciones de pastel), 3. Invitados y Logística (Plano de distribución de mesas y cronograma del gran día), y 4. Papelería y Detalles (Rotulación de sobres, minutas de menú y tiempos de discursos)."
          }
        }
      ]
    }
  ]
};

const searchIndex = [
  // Presupuesto (Budget)
  { title: "Calculadora de Presupuesto Maestro", url: "/es/master-budget-calculator", category: "Presupuesto", desc: "Distribuye tu gasto total con la regla 50/15/10/10/10/5." },
  { title: "Calculadora de Costo Real del Salón", url: "/es/wedding-venue-cost-calculator", category: "Presupuesto", desc: "Calcula consumo mínimo, cargos por servicio y cargos ocultos." },
  { title: "¿Quién Paga Qué en la Boda?", url: "/es/who-pays-for-what-wedding", category: "Presupuesto", desc: "Compara el protocolo tradicional con la división moderna entre familias y padrinos." },
  { title: "Presupuesto de Despedida de Soltera", url: "/es/bachelorette-budget-calculator", category: "Presupuesto", desc: "Divide hospedaje, comidas y actividades cubriendo la parte de la novia." },
  { title: "Guía de Propinas para Proveedores", url: "/es/vendor-tipping-calculator", category: "Presupuesto", desc: "Montos sugeridos y formato para sobres de agradecimiento." },
  { title: "Presupuesto de Luna de Miel", url: "/es/honeymoon-budget-estimator", category: "Presupuesto", desc: "Estima vuelos, hotel, cenas románticas, excursiones y lista de equipaje." },
  { title: "Simulador de Préstamo para Boda", url: "/es/wedding-loan-calculator", category: "Presupuesto", desc: "Calcula mensualidades, tasas de interés y tabla de amortización." },
  { title: "Calculadora de Regalo en Efectivo", url: "/es/gift-cash-calculator", category: "Presupuesto", desc: "Cuánto dinero obsequiar según cercanía, acompañante y viaje." },

  // Banquete (Dining)
  { title: "Calculadora de Bebidas y Barra Libre", url: "/es/wedding-drink-calculator", category: "Banquete", desc: "Estima botellas de vino, cerveza, licores, champaña y hielo." },
  { title: "Calculadora de Licores y Botellas Grandes", url: "/es/liquor-wedding-calculator", category: "Banquete", desc: "Optimiza botellas de 750ml vs 1.75L para cócteles y barra." },
  { title: "Calculadora de Precio de Pastel de Boda", url: "/es/cake-pricing-calculator", category: "Banquete", desc: "Cálculo de costo por rebanada, horas de elaboración y margen." },
  { title: "Dimensiones y Porciones de Pastel", url: "/es/cake-serving-calculator", category: "Banquete", desc: "Pisos redondos y cuadrados para 50 a 300+ invitados." },
  { title: "Diseñador de Minutas y Menús de Boda", url: "/es/reception-menu-maker", category: "Banquete", desc: "Crea menús elegantes en formato 4x9 y 5x7 listos para imprimir en PDF." },
  { title: "Estimador de Costos de Banquete y Catering", url: "/es/catering-cost-estimator", category: "Banquete", desc: "Compara menú emplatado vs buffet y estaciones de comida." },
  { title: "Calculadora de Dilución de Alcohol y Cócteles", url: "/es/alcohol-dilution-calculator", category: "Banquete", desc: "Graduación alcohólica y proporciones para cócteles por lote." },
  { title: "Estimador de Flores y Arreglos Florales", url: "/es/floral-cost-estimator", category: "Banquete", desc: "Ramos de novia, centros de mesa, boutonnières y arcos florales." },

  // Invitados (Guests)
  { title: "Creador de Plano y Distribución de Mesas", url: "/es/seating-chart-maker", category: "Invitados", desc: "Organizador interactivo de mesas con arrastrar y soltar." },
  { title: "Calculadora de Espacio y Pista de Baile", url: "/es/seating-clearance-calculator", category: "Invitados", desc: "Dimensiones de pista y pasillos de 1.5m para servicio de meseros." },
  { title: "Orden de Cortejo y Entrada Nupcial", url: "/es/wedding-processional-order", category: "Invitados", desc: "Guía de entrada y salida para ceremonias religiosas y civiles." },
  { title: "Generador de Cronograma del Día de la Boda", url: "/es/day-of-timeline-generator", category: "Invitados", desc: "Itinerario minuto a minuto desde el maquillaje hasta el baile final." },
  { title: "Planificador de Cena de Ensayo", url: "/es/rehearsal-dinner-planner", category: "Invitados", desc: "Lista de asistentes, presupuesto y horario de la noche previa." },
  { title: "Administrador de Lista de Invitados", url: "/es/guest-list-manager", category: "Invitados", desc: "Control de acompañantes, direcciones postales y platillos." },
  { title: "Controlador de Asistencia (RSVP Tracker)", url: "/es/rsvp-tracker", category: "Invitados", desc: "Conteo en vivo de confirmados, cancelaciones y restricciones de menú." },
  { title: "Estimador de Asistencia Real", url: "/es/guest-count-estimator", category: "Invitados", desc: "Porcentajes de asistencia según invitados locales vs foráneos." },
  { title: "Calculadora de Fechas de Envío de Invitaciones", url: "/es/rsvp-date-calculator", category: "Invitados", desc: "Fechas límite para Save the Date, invitaciones y confirmación." },
  { title: "Checklist de 12 Meses para la Boda", url: "/es/wedding-checklist", category: "Invitados", desc: "Lista de tareas interactivas mes a mes con guardado automático." },
  { title: "Estimador de Ajustes de Vestido de Novia", url: "/es/dress-alterations-estimator", category: "Invitados", desc: "Costos de bastillas, ajustes de corsé y tipos de recogido de cola." },
  { title: "Conversor de Tallas de Vestido de Novia", url: "/es/dress-size-converter", category: "Invitados", desc: "Conversión de medidas en cm a tallas US, UK, Europa e Italia." },
  { title: "Conversor de Talla de Anillo de Compromiso", url: "/es/ring-size-converter", category: "Invitados", desc: "Guía en milímetros para tallas de anillos US, UK, Europa y Asia." },

  // Papelería (Stationery)
  { title: "Rotulador de Sobres de Invitación", url: "/es/wedding-envelope-addressing", category: "Papelería", desc: "Formato de sobres con títulos de cortesía y exportación a PDF." },
  { title: "Dimensiones y Capas de Invitaciones", url: "/es/wedding-invitation-suite-sizer", category: "Papelería", desc: "Medidas exactas para invitaciones A7, A6 y tarjetas de recepción." },
  { title: "Calculadora de Franqueo y Envío Postal", url: "/es/wedding-invitation-postage-calculator", category: "Papelería", desc: "Cálculo de peso de sobres, sellos de cera y tarifas de envío." },
  { title: "Marcadores de Asiento y Números de Mesa", url: "/es/table-place-cards", category: "Papelería", desc: "Tarjetas dobladas imprimibles con iconos de menú para meseros." },
  { title: "Generador de Cartas de Agradecimiento", url: "/es/wedding-thank-you-cards", category: "Papelería", desc: "Textos emotivos de agradecimiento por regalos en efectivo y asistencia." },
  { title: "Creador de Invitaciones Digitales", url: "/es/digital-invitations", category: "Papelería", desc: "Tarjetas digitales con enlace para agregar a calendario y confirmación." },
  { title: "Calculadora de Tiempo para Discursos y Brindis", url: "/es/wedding-speech-calculator", category: "Papelería", desc: "Conteo de palabras, ritmo de lectura y fichas de apoyo imprimibles." },
  { title: "Generador de Hashtags para Boda", url: "/es/wedding-hashtag-generator", category: "Papelería", desc: "Ideas originales y carteles para mesas con fotos de los novios." },
  { title: "Numerología de Fecha de Boda", url: "/es/wedding-date-numerology", category: "Papelería", desc: "Descubre el número de camino de vida y compatibilidad de tu fecha." },
  { title: "Guía de Regalos de Aniversario", url: "/es/anniversary-gift-finder", category: "Papelería", desc: "Regalos tradicionales y modernos del año 1 al 60." }
];
---

<Layout 
	title="Manage.Wedding — Suite de Calculadoras y Planificación de Bodas"
	description="Suite privada de calculadoras interactivas para bodas, distribución de mesas, estimador de barra libre y papelería imprimible. 100% gratis y sin registros."
	schema={schema}
>
	<main>
		<!-- 1. Hero: Digital Sketchbook & Live Instant Search -->
		<section class="section-paper fade-in" style="padding: 4rem 1.5rem 3rem; position: relative; overflow: hidden; border-bottom: 3px solid var(--fg-pencil);">
			
			<div class="tape" style="top: -10px;"></div>
			
			<div style="max-width: 1050px; margin: 0 auto; text-align: center; position: relative; z-index: 10;">
				
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 6px 16px; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-1deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.95rem; font-weight: 700; color: var(--fg-pencil);">100% Gratis • Privacidad Total • Descargas Instantáneas</span>
				</div>

				<h1 class="font-heading" style="font-size: clamp(36px, 6.5vw, 68px); line-height: 1.15; color: var(--fg-pencil); margin-bottom: 1.25rem;">
					Organiza los números de tu boda <br class="hidden sm:inline" />
					<span style="color: var(--accent-blue); text-decoration: underline; text-decoration-style: wavy;">sin complicaciones.</span>
				</h1>

				<p style="font-size: clamp(1.1rem, 2.5vw, 1.3rem); color: var(--text-secondary); max-width: 760px; margin: 0 auto 2rem; line-height: 1.6;">
					Tu libreta digital privada para calcular la barra libre, evitar costos ocultos del lugar, organizar el plano de mesas y diseñar papelería imprimible.
				</p>

				<!-- Live Instant Search Bar with Dynamic Dropdown -->
				<div style="position: relative; max-width: 650px; margin: 0 auto 2rem;">
					<div class="search-hero-box" style="margin-bottom: 0;">
						<span style="font-size: 1.3rem; color: #64748b;">🔍</span>
						<input 
							type="text" 
							id="home-tool-search" 
							class="search-hero-input" 
							placeholder="Busca herramientas: bebidas, lugar, mesas, discursos, pastel..."
							aria-label="Buscar calculadoras para bodas"
							autocomplete="off"
						/>
						<button id="clear-search-btn" style="display: none; background: none; border: none; font-size: 1.1rem; color: #94a3b8; cursor: pointer; padding: 0 0.5rem;">✕</button>
					</div>

					<!-- Search Results Live Dropdown Popup -->
					<div id="search-dropdown-results" style="display: none; position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 4px 4px 0px var(--fg-pencil); max-height: 380px; overflow-y: auto; z-index: 100; text-align: left; padding: 0.5rem;">
						<!-- Injected by JavaScript -->
					</div>
				</div>

				<!-- Fast Shortcut Chips -->
				<div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; max-width: 800px; margin: 0 auto 2rem;">
					<span style="font-size: 0.88rem; font-weight: 600; color: #64748b; align-self: center;">Herramientas Populares:</span>
					<a href="/es/wedding-drink-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Barra Libre</a>
					<a href="/es/wedding-venue-cost-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🏰 Costos del Lugar</a>
					<a href="/es/seating-chart-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🪑 Plano de Mesas</a>
					<a href="/es/reception-menu-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">📜 Creador de Menús</a>
					<a href="/es/wedding-envelope-addressing" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">✉️ Rotulación de Sobres</a>
				</div>

				<!-- Main Hero CTAs -->
				<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
					<a href="#featured-favorites" class="hand-btn" style="padding: 14px 30px; font-size: 1.15rem;">
						Ver Calculadoras Principales ↓
					</a>
					<a href="/es/about" class="hand-btn secondary" style="padding: 14px 26px; font-size: 1.15rem;">
						¿Por qué Manage.Wedding?
					</a>
				</div>

			</div>
		</section>

		<!-- 2. Spotlight "Crowd Favorites" (4 Illustrated Cards) -->
		<section id="featured-favorites" style="padding: 4rem 1.5rem; max-width: 1200px; margin: 0 auto;">
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil);">
					⭐ Las Herramientas Favoritas
				</h2>
				<p style="font-size: 1.1rem; color: var(--text-secondary); max-width: 600px; margin: 0.25rem auto 0;">
					Las calculadoras preferidas por miles de parejas y coordinadores de eventos.
				</p>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 2rem;">
				
				<!-- Featured 1: Open Bar -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/wedding_bar_sketch.webp" 
						alt="Calculadora de Bebidas y Barra Libre para Bodas" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #fef08a; border-color: var(--fg-pencil); color: var(--fg-pencil);">Más Popular</span>
						<span class="tool-time">⏱️ 2 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Calculadora de Bebidas y Barra Libre</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Calcula con exactitud botellas de vino, cerveza, licores, champaña y hielo para tu fiesta.
					</p>
					<a href="/es/wedding-drink-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Calcular Barra Libre →
					</a>
				</div>

				<!-- Featured 2: Master Budget -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/calculator_sketch.webp" 
						alt="Calculadora de Presupuesto Maestro de Boda" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dbeafe; border-color: #93c5fd; color: #1e40af;">Finanzas</span>
						<span class="tool-time">⏱️ 3 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Presupuesto Maestro de Boda</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Distribuye cualquier presupuesto total con los porcentajes reales de la industria nupcial.
					</p>
					<a href="/es/master-budget-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Distribuir Presupuesto →
					</a>
				</div>

				<!-- Featured 3: Day-Of Timeline -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/pocket-watch-sketch.webp" 
						alt="Generador de Cronograma del Día de la Boda" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dcfce7; border-color: #86efac; color: #166534;">Logística</span>
						<span class="tool-time">⏱️ 3 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Cronograma del Día de la Boda</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Genera un itinerario minuto a minuto para fotógrafos, maquillistas y coordinadores.
					</p>
					<a href="/es/day-of-timeline-generator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Crear Cronograma →
					</a>
				</div>

				<!-- Featured 4: Seating Chart -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/seating_chart_sketch.webp" 
						alt="Creador de Plano y Distribución de Mesas" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #f3e8ff; border-color: #d8b4fe; color: #6b21a8;">Interactivo</span>
						<span class="tool-time">⏱️ 5 mins</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Distribución y Plano de Mesas</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Organiza mesas redondas y rectangulares, asigna invitados y descarga el plano imprimible.
					</p>
					<a href="/es/seating-chart-maker" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Crear Plano de Mesas →
					</a>
				</div>

			</div>
		</section>

		<!-- 3. The 4-Phase Wedding Planning Master Roadmap -->
		<section style="background: var(--muted-paper); padding: 4.5rem 1.5rem; border-top: 3px dashed var(--fg-pencil); border-bottom: 3px dashed var(--fg-pencil);">
			<div style="max-width: 1100px; margin: 0 auto;">
				
				<div style="text-align: center; margin-bottom: 3rem;">
					<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Guía Paso a Paso</span>
					<h2 class="font-heading" style="font-size: clamp(28px, 4.5vw, 44px); color: var(--fg-pencil);">
						La Guía Maestra de Planificación
					</h2>
					<p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 650px; margin: 0.25rem auto 0;">
						Qué calcular, dimensionar y confirmar en cada etapa rumbo al gran día.
					</p>
				</div>

				<div style="display: flex; flex-direction: column; gap: 1.75rem;">
					
					<!-- Roadmap Step 1 -->
					<div class="hand-card" style="padding: 1.75rem; background: #fff; border-left: 6px solid var(--accent-red);">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								Fase 1: Presupuesto Real y Reserva del Lugar (12 a 9 Meses Antes)
							</h3>
							<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
								Paso 01
							</span>
						</div>
						<p class="font-body" style="font-size: 1rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 1rem 0;">
							Define tu límite total de gasto antes de visitar salones y haciendas. Revisa cotizaciones para detectar consumos mínimos obligatorios, cargos de servicio e impuestos. Clarifica la aportación de familias y padrinos sin conversaciones incómodas.
						</p>
						<div style="display: flex; gap: 0.75rem; flex-wrap: wrap; font-size: 0.88rem;">
