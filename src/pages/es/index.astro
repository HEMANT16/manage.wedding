	<!-- Live Instant Search Dropdown Script (Spanish) -->
	<script is:inline define:vars={{ searchIndex }}>
		const searchInput = document.getElementById('home-tool-search');
		const clearBtn = document.getElementById('clear-search-btn');
		const dropdown = document.getElementById('search-dropdown-results');

		function handleSearch() {
			const query = (searchInput?.value || '').trim().toLowerCase();

			if (clearBtn) {
				clearBtn.style.display = query.length > 0 ? 'inline-block' : 'none';
			}

			if (!query || query.length === 0) {
				if (dropdown) dropdown.style.display = 'none';
				return;
			}

			const results = searchIndex.filter(item => 
				item.title.toLowerCase().includes(query) || 
				item.desc.toLowerCase().includes(query) ||
				item.category.toLowerCase().includes(query)
			);

			if (!dropdown) return;

			if (results.length === 0) {
				dropdown.innerHTML = `
					<div style="padding: 1rem; text-align: center; color: #64748b; font-size: 0.95rem;">
						No se encontraron calculadoras para "<strong>${query}</strong>".<br/>
						<span style="font-size: 0.82rem;">Prueba buscando bebidas, lugar, pastel o mesas.</span>
					</div>
				`;
				dropdown.style.display = 'block';
				return;
			}

			let html = '';
			results.slice(0, 7).forEach(r => {
				html += `
					<a href="${r.url}" style="display: block; padding: 0.65rem 0.85rem; border-radius: 4px; text-decoration: none; color: inherit; border-bottom: 1px solid #f1f5f9; transition: background 0.15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
						<div style="display: flex; justify-content: space-between; align-items: center;">
							<strong style="font-size: 0.95rem; color: #1e293b;">${r.title}</strong>
							<span style="font-size: 0.72rem; font-weight: 700; background: #fef08a; border: 1px solid #1e293b; padding: 1px 6px; border-radius: 3px;">${r.category}</span>
						</div>
						<p style="margin: 2px 0 0 0; font-size: 0.82rem; color: #64748b; line-height: 1.4;">${r.desc}</p>
					</a>
				`;
			});

			dropdown.innerHTML = html;
			dropdown.style.display = 'block';
		}

		if (searchInput) {
			searchInput.addEventListener('input', handleSearch);
			searchInput.addEventListener('focus', () => {
				if (searchInput.value.trim().length > 0) handleSearch();
			});
		}

		if (clearBtn) {
			clearBtn.addEventListener('click', () => {
				if (searchInput) {
					searchInput.value = '';
					handleSearch();
					searchInput.focus();
				}
			});
		}

		// Close dropdown on click outside
		document.addEventListener('click', (e) => {
			if (dropdown && !dropdown.contains(e.target) && e.target !== searchInput) {
				dropdown.style.display = 'none';
			}
		});
	</script>
