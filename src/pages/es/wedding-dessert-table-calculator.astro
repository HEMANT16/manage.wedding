---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-dessert-table-calculator/#webapp",
      "name": "Calculadora de Mesa de Postres, Candy Bar y Galletas para Bodas",
      "url": "https://manage.wedding/es/wedding-dessert-table-calculator",
      "description": "Calculadora interactiva gratuita para mesa de postres, mesa dulce, candy bar y galletas de boda. Calcula bocaditos por invitado, docenas de repostería, kilos de golosinas y descarga carteles imprimibles 8x10 'El Amor es Dulce' y hojas de pedido para pastelería en PDF y Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular las Cantidades de Postres, Bocaditos y Dulces para una Boda",
      "description": "Guía paso a paso para calcular el número de bocaditos dulces, kilos de golosinas para candy bar, frascos y pedidos por docenas para bodas.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Elige el formato de servicio de postres",
          "text": "Define si los postres acompañan al pastel nupcial tradicional (2 a 3 bocaditos por persona), sustituyen al pastel (4 a 6 bocaditos por persona), mesa de galletas tradicionales o candy bar por peso (115g a 170g por persona)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Selecciona la variedad de postres y auto-equilibra las porciones",
          "text": "Elige de 4 a 8 variedades (macarons, tartaletas, vasitos de mousse, mini cupcakes, trufas, donas) y convierte las unidades en docenas comerciales de pastelería."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Dimensiona frascos, palas y bolsitas de recuerdo",
          "text": "Calcula el peso total de golosinas en kilos y libras, organiza frascos de cristal en diferentes alturas y calcula bolsitas de recuerdo con un margen del 15%."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Exporta carteles imprimibles y hoja de pedido para pastelería",
          "text": "Genera carteles decorativos para enmarcar (8x10 / 5x7), tarjetas identificadoras con alérgenos (Sin Gluten, Vegano) y descarga la orden de pastelería en PDF y Word."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuántos postres individuales o bocaditos se calculan por persona en una boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si se sirve pastel de boda tradicional además de la mesa de postres, se calculan de 2 a 3 bocaditos por invitado. Si la mesa de postres o mesa dulce sustituye completamente al pastel, calcula de 4 a 6 bocaditos por invitado para que cada persona pueda degustar distintas variedades."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántas variedades de postres se deben ofrecer según el número de invitados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para 50–75 invitados, ofrece de 3 a 4 variedades. Para 75–125 invitados, de 4 a 5 variedades. Para 125–200 invitados, de 5 a 7 variedades. Para más de 200 invitados, un máximo de 6 a 8 variedades. Ofrecer demasiados tipos genera colas y hace que los más populares se agoten rápidamente."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuántos kilos de dulces o golosinas se necesitan para un Candy Bar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se recomiendan entre 115g y 170g (0.25 a 0.35 libras) de dulces por invitado. Para 100 invitados, esto equivale a unos 12 a 16 kg (25 a 35 lbs) repartidos en 6 a 8 frascos de cristal o bomboneras de diferentes alturas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué postres se derriten o estropean con el calor en bodas al aire libre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La crema de mantequilla (buttercream) comienza a ablandarse a 24°C y se derrite a 28°C. Las trufas de chocolate, tartaletas de ganache y vasitos de mousse no deben exponerse al sol directo ni a temperaturas superiores a 22°C. Los macarons absorben la humedad ambiente y pierden su textura crocante. Para bodas de verano en exteriores, opta por galletas decoradas, cake pops, brownies y golosinas secas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se deben señalizar las alergias e intolerancias en la mesa dulce?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Coloca tarjetas plegables tipo carpa delante de cada bandeja indicando claramente el nombre del dulce y etiquetas dietéticas: Sin Gluten (GF), Vegano (V), Sin Lácteos (DF) y Sin Frutos Secos (NF). Es aconsejable reservar bandejas elevadas exclusivas para las opciones sin alérgenos con sus propias pinzas de servicio."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Mesa de Postres, Candy Bar & Galletas para Bodas (PDF Gratis) | Manage.Wedding"
	description="Calcula cantidades exactas de bocaditos dulces, docenas para pastelería, kilos de golosinas para candy bar y frascos. Genera carteles 8x10 'El Amor es Dulce', tarjetas de alérgenos y pedidos en PDF y Word."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Mesa de Postres & Candy Bar" category="food-dining" />
		
		<!-- Hero Section -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🧁</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratis • Cálculo Interactivo • Carteles y Pedido de Pastelería en PDF</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de Mesa de Postres, Candy Bar y Galletas
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 760px; margin: 0 auto; text-align: center;">
					Calcula las cantidades exactas de bocaditos dulces, kilos de golosinas para candy bar, frascos de cristal y docenas de repostería. Personaliza la variedad, diseña <strong>Carteles Imprimibles 8x10 "El Amor es Dulce"</strong>, tarjetas de alérgenos y descarga tu <strong>Orden para Pastelería</strong> en PDF y Word.
				</p>
			</div>
		</section>

		<!-- 3-Step Guide -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>✨</span> Cómo Planificar tu Mesa Dulce en 3 Sencillos Pasos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Selecciona el Formato
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indica si los postres acompañan al pastel (2–3 uds/persona), lo sustituyen (4–6 uds/persona), mesa de galletas o candy bar por peso.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Equilibra Variedad y Docenas
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Elige tus postres favoritos (macarons, vasitos, tartaletas, trufas) y calcula automáticamente las docenas exactas para tu proveedor.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Imprime Carteles y Pedido
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Genera carteles decorativos enmarcables (8x10 / 5x7), tarjetas identificadoras de alérgenos y descarga el pedido en PDF y Word.
					</p>
				</div>
			</div>
		</div>

		<!-- Interactive Application Workspace -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SECCIÓN 1: Formato e Invitados -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🍰 1. Configuración del Evento y Formato de Mesa
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Ajusta el número de invitados confirmados, el apetito y el estilo de servicio
						</span>
					</div>
					<span id="badge-variety-rec" class="badge-postit" style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); padding: 4px 10px; border: 1.5px solid var(--fg-pencil); border-radius: 6px;">
						Recomendado: 4–5 Variedades
					</span>
				</div>

				<!-- Selector de Formato de Mesa -->
				<div style="margin-bottom: 1.5rem;">
					<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1rem; color: var(--fg-pencil);">
						Selecciona el Tipo de Mesa Dulce:
					</label>
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.75rem;" id="format-tabs-container">
						
						<label class="format-tab active" data-format="with-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fef08a; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="with-cake" checked style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🎂 + 🧁</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Junto al Pastel</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">2–3 bocaditos/invitado</span>
						</label>

						<label class="format-tab" data-format="no-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="no-cake" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🧁✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Sin Pastel (Principal)</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">4–6 bocaditos/invitado</span>
						</label>

						<label class="format-tab" data-format="cookie-table" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="cookie-table" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍪📦</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Mesa de Galletas</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">6–8 galletas + cajitas</span>
						</label>

						<label class="format-tab" data-format="candy-buffet" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="candy-buffet" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍬🍭</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Candy Bar / Chuches</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">120g–160g / invitado</span>
						</label>

						<label class="format-tab" data-format="hybrid" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="hybrid" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">👑✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Mesa Dulce Completa</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">Postres + Candy + Recuerdos</span>
						</label>
					</div>
				</div>

				<!-- Control de Invitados y Apetito -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
					
					<!-- Deslizador de Invitados -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="input-guests" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								👥 Número de Invitados:
							</label>
							<span id="badge-guests" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 2px 10px; border-radius: 12px; font-size: 0.9rem;">
								100 Invitados
							</span>
						</div>
						<input type="range" id="slider-guests" min="20" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="input-guests" min="10" max="1000" value="100" class="form-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 1rem; font-weight: 600; background: #fff;">
						</div>
					</div>

					<!-- Contexto y Apetito -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<label for="select-appetite" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🍽️ Apetito y Tipo de Banquete:
						</label>
						<select id="select-appetite" style="width: 100%; padding: 0.6rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.95rem; font-weight: 600; background: #fff; margin-bottom: 0.5rem;">
							<option value="light">Ligero (Tras menú abundante de 4 tiempos y barra libre)</option>
							<option value="standard" selected>Estándar (Equilibrado: 2.5 bocaditos / 135g dulces)</option>
							<option value="generous">Golosos / Fiesta Extensa (Amantes del dulce y recena)</option>
						</select>
						<div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
							<input type="checkbox" id="chk-takeaway-favors" style="width: 18px; height: 18px; accent-color: var(--accent-blue);">
							<label for="chk-takeaway-favors" class="font-body" style="font-size: 0.85rem; color: var(--fg-pencil); cursor: pointer;">
								<strong>Incluir Cajitas / Bolsitas de Regalo</strong> (+2 bocaditos / +80g dulces por persona)
							</label>
						</div>
					</div>

				</div>

				<!-- Estadísticas Principales -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
					
					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Total Bocaditos</span>
						<strong id="stat-total-pieces" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red); line-height: 1.2;">250</strong>
						<span id="stat-pieces-per-guest" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(2.5 uds / persona)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Docenas Comerciales</span>
						<strong id="stat-total-dozens" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); line-height: 1.2;">21 Doc</strong>
						<span id="stat-exact-dozens" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(252 uds totales)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Kilos de Candy Bar</span>
						<strong id="stat-total-candy" class="font-heading" style="font-size: 1.8rem; color: #16a34a; line-height: 1.2;">12.7 kg</strong>
						<span id="stat-candy-kg" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(28 lbs / 6–8 Frascos)</span>
					</div>

					<div style="text-align: center; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Montaje de Mesa</span>
						<strong id="stat-table-size" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); line-height: 1.2;">Mesa 2.0–2.4m</strong>
						<span id="stat-napkins-count" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">150 servilletas de cóctel</span>
					</div>

				</div>
			</div>

			<!-- SECCIÓN 2: Variedades de Postres y Docenas -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🧁 2. Variedades de Postres y Asignación por Docenas
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Ajusta unidades por tipo de dulce y revisa las docenas exactas para tu obrador o pastelería
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
						<button type="button" id="btn-auto-balance" class="hand-btn" style="background: var(--post-it); font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 700; display: inline-flex; align-items: center; gap: 0.3rem;">
							<span>⚖️</span> Auto-Equilibrar Variedad
						</button>
						<button type="button" id="btn-reset-varieties" class="hand-btn" style="background: #fff; font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 600;">
							🔄 Restablecer
						</button>
					</div>
				</div>

				<!-- Barra de Progreso de Asignación -->
				<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; font-size: 0.85rem;">
						<span><strong>Unidades Asignadas:</strong> <span id="label-allocated-pieces">250</span> / <span id="label-target-pieces">250</span> Objetivo</span>
						<span id="label-allocation-status" style="font-weight: 700; color: #16a34a;">✅ Perfectamente Equilibrado</span>
					</div>
					<div style="width: 100%; height: 10px; background: #e2e8f0; border-radius: 5px; overflow: hidden; border: 1px solid var(--fg-pencil);">
						<div id="bar-allocation-progress" style="width: 100%; height: 100%; background: #16a34a; transition: width 0.3s ease, background-color 0.3s ease;"></div>
					</div>
