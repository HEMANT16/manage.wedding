---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-envelope-addressing/#webapp",
      "name": "Generador de Direcciones y Protocolo para Sobres de Boda",
      "url": "https://manage.wedding/es/wedding-envelope-addressing",
      "inLanguage": "es",
      "description": "Generador online y formateador de protocolo para rotular sobres de boda. Aplica tratamientos formales (D. y Dña., parejas, familias, doctores) con vista previa de caligrafía y exportación a PDF para imprimir en sobres, Word y CSV.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Rotular Sobres de Invitación de Boda con Protocolo",
      "description": "Guía paso a paso para maquetar el destinatario, tratamientos de cortesía y remitente en la solapa.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Selecciona el Tamaño de Sobre (C5, B6 o Cuadrado)",
          "text": "Elige sobre C5 (162×229 mm) para tarjetas A5, B6 (135×185 mm) para tarjetas 13×18 cm o C6 para el sobre de vuelta RSVP."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Aplica el Tratamiento de Cortesía Adecuado",
          "text": "Usa fórmulas formales como 'D. y Dña.', nombres de pareja unidos o fórmulas familiares ('Familia García Santos')."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Escribe la Dirección Completa sin Abreviaturas",
          "text": "El protocolo elegante recomienda escribir 'Calle', 'Avenida', 'Paseo' y el nombre de la provincia completo."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Coloca el Remitente en la Solapa Trasera",
          "text": "Imprime o estampa con sello de caucho los nombres de los novios y dirección de retorno centrados en la solapa posterior del sobre."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo dirigirse a una pareja casada en el sobre de boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En el protocolo tradicional formal español se escribe 'D. Juan García y Dña. Elena Morales' (o 'D. y Dña. García Morales'). En un estilo moderno y cercano se puede optar por 'Juan y Elena García'."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo rotular el sobre si se invita a una persona con acompañante?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si se conoce el nombre de la pareja, lo correcto es escribir ambos nombres. Si no se conoce, se rotula 'D. Alejandro Martínez y Acompañante' (o 'Alejandro y Acompañante')."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde se coloca el remitente en los sobres de boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Por tradición y estética nupcial, el remitente se coloca centrado en la solapa trasera del sobre exterior. En el sobre de confirmación RSVP, se imprime en el centro del anverso."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Generador de Direcciones y Protocolo para Sobres de Boda | Manage.Wedding"
	description="Formatea y rotula sobres de boda con protocolo formal. Vista previa de caligrafía, tratamientos para parejas y familias, e impresión directa en PDF y Word."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Rotulación de Sobres" category="stationery-creative" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Protocolo y Rotulación en PDF Imprimible</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Rotulación y Protocolo <span class="accent-italic">de Sobres de Boda</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 700px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Aplica el protocolo adecuado para matrimonios, parejas, doctores, familias y acompañantes. Previsualiza estilos de caligrafía e imprime sobres en PDF o Word con un solo clic.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Controls & Formatter Input -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Formato y Protocolo
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						C5 / B6 / Cuadrado
					</span>
				</div>

				<!-- Envelope Size Selector -->
				<div class="form-group">
					<label class="form-label" for="env-size">Formato y Tamaño de Sobre</label>
					<select id="env-size" class="form-input" style="cursor: pointer;">
						<option value="a7" selected>Sobre C5 / B6 (162×229 mm o 135×185 mm — Estándar)</option>
						<option value="a2">Sobre C6 de Respuesta RSVP (114×162 mm)</option>
						<option value="inner">Sobre Interior (130×178 mm — Solo Nombres)</option>
						<option value="square">Sobre Cuadrado (160×160 mm)</option>
						<option value="dl">Sobre Alargado / Americano (110×220 mm)</option>
					</select>
				</div>

				<!-- Etiquette Preset Quick-Pick -->
				<div class="form-group">
					<label class="form-label" for="etiquette-preset">
						Plantilla de Protocolo
					</label>
					<select id="etiquette-preset" class="form-input" style="background: #f8fafc; font-weight: 600; cursor: pointer;">
						<option value="married-same" selected>👫 Matrimonio Formal — ej. D. y Dña. Juan García</option>
						<option value="married-modern">👫 Matrimonio Moderno — ej. Elena y Juan García</option>
						<option value="married-diff">👫 Pareja con Apellidos Distintos — ej. Dña. Sara Morales y D. Juan García</option>
						<option value="doctor-wife">🩺 Doctor / Doctora — ej. Dra. Carmen Santos y D. Roberto Morales</option>
						<option value="doctor-both">🩺 Ambos Doctores — ej. Dres. Carmen Santos y Roberto Morales</option>
						<option value="unmarried">💑 Pareja que Convive — (En dos líneas)</option>
						<option value="single-guest">👤 Invitado con Acompañante — ej. D. Alejandro Clark y Acompañante</option>
						<option value="family">👨‍👩‍👧‍👦 Familia Completa — ej. Familia García Santos</option>
						<option value="custom">✏️ Personalizado Manual</option>
					</select>
				</div>

				<!-- Recipient Name Line 1 -->
				<div class="form-group">
					<label class="form-label" for="rec-name-1">Nombre(s) del Destinatario — Línea 1</label>
					<input type="text" id="rec-name-1" class="form-input" value="D. y Dña. Juan García" placeholder="ej. D. y Dña. Juan García" />
				</div>

				<!-- Recipient Name Line 2 (Optional for unmarried/plus-ones) -->
				<div class="form-group" id="rec-name-2-group" style="display: none;">
					<label class="form-label" for="rec-name-2">Nombre Destinatario (Línea 2 — Opcional)</label>
					<input type="text" id="rec-name-2" class="form-input" value="" placeholder="ej. Dña. Laura Sánchez" />
				</div>

				<!-- Street Address -->
				<div class="form-group">
					<label class="form-label" for="rec-street">Dirección y Calle</label>
					<input type="text" id="rec-street" class="form-input" value="Calle Gran Vía 42, 3º Dcha" placeholder="ej. Paseo de la Castellana 120, 4º B" />
				</div>

				<!-- City, State & Zip -->
				<div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="rec-city">Ciudad / Localidad</label>
						<input type="text" id="rec-city" class="form-input" value="Madrid" placeholder="Ciudad" />
					</div>
					<div>
						<label class="form-label" for="rec-state">Provincia</label>
						<input type="text" id="rec-state" class="form-input" value="Madrid" placeholder="Provincia" />
					</div>
					<div>
						<label class="form-label" for="rec-zip">C. Postal</label>
						<input type="text" id="rec-zip" class="form-input" value="28013" placeholder="28013" />
					</div>
				</div>

				<!-- Return Address Toggle & Inputs -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.75rem;">
						<input type="checkbox" id="toggle-return-addr" checked style="width: 18px; height: 18px;" />
						<span>Incluir Dirección de Remitente</span>
					</label>

					<div id="return-addr-fields">
						<div class="form-group">
							<label class="form-label" for="ret-names" style="font-size: 0.95rem;">Nombres de los Novios (Remitente)</label>
							<input type="text" id="ret-names" class="form-input" value="Elena & Alejandro" style="font-size: 0.95rem; padding: 0.6rem 0.75rem;" />
						</div>
						<div class="form-group">
							<label class="form-label" for="ret-street" style="font-size: 0.95rem;">Dirección y Ciudad de Remite</label>
							<input type="text" id="ret-street" class="form-input" value="Calle Velázquez 15, 28001 Madrid" style="font-size: 0.95rem; padding: 0.6rem 0.75rem;" />
						</div>
					</div>
				</div>

				<!-- Style Customization -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label class="form-label">Estilo Tipográfico y Caligrafía</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="font-style-btn hand-btn is-active" data-font="script" style="padding: 8px; font-size: 0.9rem; font-family: 'Kalam', cursive;">
							✒️ Caligrafía Moderna
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="serif" style="padding: 8px; font-size: 0.9rem; font-family: Georgia, serif;">
							🏛️ Romana Clásica Formal
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="sans" style="padding: 8px; font-size: 0.9rem; font-family: var(--font-body);">
							✨ Sans-Serif Minimalista
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="hand" style="padding: 8px; font-size: 0.9rem; font-family: 'Caveat', cursive;">
							✏️ Letra Manuscrita
						</button>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Envelope Visual Canvas & Batch Export -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Canvas Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Vista Previa del Sobre
						</h3>
						<span id="env-size-tag" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							C5: 162 × 229 mm
						</span>
					</div>

					<!-- The Realistic Envelope Box -->
					<div id="envelope-canvas" style="width: 100%; aspect-ratio: 7.25 / 5.25; background: #fffcf5; border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 6px 6px 0px var(--fg-pencil); position: relative; padding: clamp(1rem, 3vw, 2rem); display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; transition: all 0.2s ease;">
						
						<!-- Return Address on Front Top-Left -->
						<div id="canvas-return-addr" style="position: absolute; top: clamp(0.75rem, 2vw, 1.25rem); left: clamp(0.75rem, 2vw, 1.25rem); font-size: clamp(0.68rem, 1.2vw, 0.82rem); line-height: 1.35; color: var(--fg-pencil); max-width: 45%;">
							<strong id="canvas-ret-name" style="display: block;">Elena & Alejandro</strong>
							<span id="canvas-ret-full">Calle Velázquez 15<br/>28001 Madrid</span>
						</div>

						<!-- Postage Stamp Placeholder Stamp Outline -->
						<div style="position: absolute; top: clamp(0.75rem, 2vw, 1.25rem); right: clamp(0.75rem, 2vw, 1.25rem); width: clamp(40px, 7vw, 55px); height: clamp(50px, 8.5vw, 68px); border: 1.5px dashed #94a3b8; border-radius: 3px; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; color: #94a3b8; text-align: center; text-transform: uppercase; font-weight: 700; padding: 2px;">
							Sello Correos
						</div>

						<!-- Main Recipient Address Block (Centered) -->
						<div id="canvas-recipient-block" style="text-align: center; margin-top: clamp(1rem, 2.5vw, 2rem);">
							<div id="canvas-rec-name-1" style="font-size: clamp(1.2rem, 2.5vw, 1.85rem); font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem; line-height: 1.25;">
								D. y Dña. Juan García
							</div>
							<div id="canvas-rec-name-2" style="font-size: clamp(1.1rem, 2.2vw, 1.65rem); font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem; display: none; line-height: 1.25;"></div>
							<div id="canvas-rec-street" style="font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: #334155; margin-bottom: 0.2rem; line-height: 1.4;">
								Calle Gran Vía 42, 3º Dcha
							</div>
							<div id="canvas-rec-city-state-zip" style="font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: #334155; line-height: 1.4;">
								28013 Madrid
							</div>
						</div>

					</div>

					<!-- Quick Formatting Audit Checklist -->
					<div style="margin-top: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<strong style="font-size: 0.95rem; display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">
							✅ Comprobación de Protocolo y Formato:
						</strong>
						<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
							<li>Nombre completo con tratamiento protocolario respetado.</li>
							<li>Dirección clara con código postal y provincia para entrega garantizada.</li>
							<li>Medidas adaptadas a la tarjeta de invitación con margen para cierre.</li>
						</ul>
					</div>

					<!-- Export Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-envelope" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Sobres (PDF)
						</button>
						<button id="btn-export-word" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar a Word (.doc)
						</button>
					</div>

				</div>

				<!-- Batch Guest List Address Importer -->
				<div class="hand-card" style="padding: 1.75rem; background: var(--bg-paper);">
					<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
						Importador Masivo de Direcciones (CSV o Pegar Texto)
					</h3>
					<p style="font-size: 0.92rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
						Pega las direcciones (una por línea: <em>Nombre, Calle y Número, Ciudad, Provincia, Código Postal</em>) para rotular toda tu lista de una vez.
					</p>

					<textarea id="batch-paste-input" rows="4" class="hand-input" style="font-size: 0.88rem; line-height: 1.4; margin-bottom: 0.75rem;" placeholder="D. y Dña. Roberto Davis, Calle Alcalá 102, Madrid, Madrid, 28009&#10;Dra. Carmen Santos, Avenida Diagonal 440, Barcelona, Barcelona, 08037&#10;D. Alejandro Clark y Acompañante, Calle Sierpes 55, Sevilla, Sevilla, 41004"></textarea>

					<div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
						<button id="btn-load-batch" class="hand-btn" style="padding: 8px 16px; font-size: 0.9rem;">
							Cargar Direcciones
						</button>
						<span id="batch-count-tag" style="font-size: 0.85rem; font-weight: 700; color: #64748b;">1 Dirección Lista</span>
					</div>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Guía Rápida de Protocolo</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Tabla Resumen: Protocolo para Nombres y Tratamientos en Sobres
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Consulta las fórmulas de cortesía para cada caso familiar o profesional.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 Reglas de Oro de la Rotulación de Sobres:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					1. Sobre Exterior: Tratamiento Formal + Sin Abreviaturas • 2. Parejas que conviven: Nombres completos en líneas separadas • 3. Remitente: Centrado en la solapa trasera del sobre.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Caso / Relación</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Sobre Exterior (Formal)</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Sobre Interior / Cercano</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Regla de Protocolo</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Matrimonio Tradicional</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">D. y Dña. Juan García<br><span style="font-size: 0.8rem; color: #64748b;">(o D. Juan García y Dña. Elena Morales)</span></td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Juan y Elena</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Fórmula tradicional o nombres de pila cercanos</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Pareja que Convive</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Dña. Sara Morales<br>D. Juan García</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Sara y Juan</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Nombres en dos líneas separadas por orden alfabético</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Títulos Médicos / Doctor</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Dra. Carmen Santos y D. Roberto Morales</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Carmen y Roberto</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">El título profesional precede al tratamiento civil</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Familia con Hijos</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Familia García Santos<br><span style="font-size: 0.8rem; color: #64748b;">(o D. Juan García y Familia)</span></td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Juan, Elena, Lucas y Clara</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">En sobre interior se detallan los nombres de los hijos</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #d97706);">Invitado con Acompañante</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">D. Alejandro Clark y Acompañante</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Alejandro y Acompañante</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Indica claramente que dispone de pase doble</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide & Etiquette Rules -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guía Completa de Caligrafía y Protocolo de Sobres
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					El sobre es la primera impresión tangible que recibirán vuestros invitados. Domina los tratamientos y la colocación sin errores.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Consejos de Caligrafía y Rotulado
				</h3>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Tinta Resistente:</strong> Si vas a caligrafiar a mano o contratar un calígrafo profesional, utiliza tinta impermeable para evitar manchas en caso de lluvia durante el reparto postal.</li>
					<li><strong>Plantilla de Luz o Falsa Línea:</strong> Utiliza una regla guía o mesa de luz para asegurar que los renglones queden perfectamente horizontales.</li>
					<li><strong>Caligrafía Impresa:</strong> Puedes alimentar sobres directamente en impresoras de inyección con alimentación trasera seleccionando el tamaño de papel personalizado.</li>
				</ul>
			</section>

			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Preguntas Frecuentes
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Se deben abreviar las direcciones en los sobres de boda?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						En la correspondencia nupcial de gala se recomienda no abreviar (escribir 'Calle' en lugar de 'C/' y 'Avenida' en lugar de 'Avda.').
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Cómo imprimir múltiples sobres en Word?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Haz clic en 'Exportar a Word (.doc)'. La herramienta generará un documento con la tabla de destinatarios lista para usar con la función de 'Combinar correspondencia' de Word o imprimirla directamente.
					</p>
				</details>
			</section>

		</article>

		<!-- Related Planning Tools -->
		<RelatedTools currentPath="/es/wedding-envelope-addressing" category="stationery" />

	</main>

	<!-- Interactive Live Script -->
	<script is:inline>
		const envSizeSelect = document.getElementById('env-size');
		const presetSelect = document.getElementById('etiquette-preset');
		const recName1 = document.getElementById('rec-name-1');
		const recName2 = document.getElementById('rec-name-2');
		const recName2Group = document.getElementById('rec-name-2-group');
		const recStreet = document.getElementById('rec-street');
		const recCity = document.getElementById('rec-city');
		const recState = document.getElementById('rec-state');
		const recZip = document.getElementById('rec-zip');

		const toggleReturnAddr = document.getElementById('toggle-return-addr');
		const returnAddrFields = document.getElementById('return-addr-fields');
		const retNames = document.getElementById('ret-names');
		const retStreet = document.getElementById('ret-street');

		const envelopeCanvas = document.getElementById('envelope-canvas');
		const canvasSizeTag = document.getElementById('env-size-tag');
		const canvasRetAddr = document.getElementById('canvas-return-addr');
		const canvasRetName = document.getElementById('canvas-ret-name');
		const canvasRetFull = document.getElementById('canvas-ret-full');
		const canvasRecName1 = document.getElementById('canvas-rec-name-1');
		const canvasRecName2 = document.getElementById('canvas-rec-name-2');
		const canvasRecStreet = document.getElementById('canvas-rec-street');
		const canvasRecCityStateZip = document.getElementById('canvas-rec-city-state-zip');

		const fontButtons = document.querySelectorAll('.font-style-btn');
		const batchInput = document.getElementById('batch-paste-input');
		const btnLoadBatch = document.getElementById('btn-load-batch');
		const batchCountTag = document.getElementById('batch-count-tag');
		const btnPrint = document.getElementById('btn-print-envelope');
		const btnWord = document.getElementById('btn-export-word');

		let currentFont = 'script';
		let batchAddresses = [];

		function updateCanvas() {
			canvasRecName1.textContent = recName1.value || 'Nombre del Destinatario';
			
			if (recName2.value.trim().length > 0) {
				canvasRecName2.style.display = 'block';
				canvasRecName2.textContent = recName2.value.trim();
			} else {
				canvasRecName2.style.display = 'none';
			}

			canvasRecStreet.textContent = recStreet.value || 'Calle Ejemplo 12, 3º A';
			canvasRecCityStateZip.textContent = `${recZip.value || '28001'} ${recCity.value || 'Madrid'} (${recState.value || 'Madrid'})`;

			if (toggleReturnAddr.checked) {
				canvasRetAddr.style.display = 'block';
				canvasRetName.textContent = retNames.value || '';
				canvasRetFull.textContent = retStreet.value || '';
			} else {
				canvasRetAddr.style.display = 'none';
			}

			const size = envSizeSelect.value;
			if (size === 'a7') {
				envelopeCanvas.style.aspectRatio = '7.25 / 5.25';
				canvasSizeTag.textContent = 'C5 / B6: 162 × 229 mm';
			} else if (size === 'a2') {
				envelopeCanvas.style.aspectRatio = '5.75 / 4.375';
				canvasSizeTag.textContent = 'C6 RSVP: 114 × 162 mm';
			} else if (size === 'inner') {
				envelopeCanvas.style.aspectRatio = '7 / 5.125';
				canvasSizeTag.textContent = 'Sobre Interior: 130 × 178 mm';
				canvasRetAddr.style.display = 'none';
			} else if (size === 'square') {
				envelopeCanvas.style.aspectRatio = '1 / 1';
				canvasSizeTag.textContent = 'Cuadrado: 160 × 160 mm';
			} else if (size === 'dl') {
				envelopeCanvas.style.aspectRatio = '9.5 / 4.125';
				canvasSizeTag.textContent = 'Americano DL: 110 × 220 mm';
			}

			if (currentFont === 'script') {
				canvasRecName1.style.fontFamily = "'Kalam', 'Caveat', cursive";
				canvasRecName2.style.fontFamily = "'Kalam', 'Caveat', cursive";
				canvasRecName1.style.letterSpacing = '0.02em';
				canvasRecStreet.style.fontFamily = "var(--font-body)";
				canvasRecCityStateZip.style.fontFamily = "var(--font-body)";
			} else if (currentFont === 'serif') {
				canvasRecName1.style.fontFamily = "Georgia, 'Times New Roman', serif";
				canvasRecName2.style.fontFamily = "Georgia, 'Times New Roman', serif";
				canvasRecName1.style.letterSpacing = '0.05em';
				canvasRecStreet.style.fontFamily = "Georgia, serif";
				canvasRecCityStateZip.style.fontFamily = "Georgia, serif";
			} else if (currentFont === 'sans') {
				canvasRecName1.style.fontFamily = "var(--font-body)";
				canvasRecName2.style.fontFamily = "var(--font-body)";
				canvasRecName1.style.letterSpacing = '0.04em';
				canvasRecStreet.style.fontFamily = "var(--font-body)";
				canvasRecCityStateZip.style.fontFamily = "var(--font-body)";
			} else if (currentFont === 'hand') {
				canvasRecName1.style.fontFamily = "'Caveat', cursive";
				canvasRecName2.style.fontFamily = "'Caveat', cursive";
				canvasRecName1.style.letterSpacing = '0.01em';
				canvasRecStreet.style.fontFamily = "'Caveat', cursive";
				canvasRecCityStateZip.style.fontFamily = "'Caveat', cursive";
			}
		}

		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'married-same') {
				recName1.value = 'D. y Dña. Juan García';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'married-modern') {
				recName1.value = 'Elena y Juan García';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'married-diff') {
				recName1.value = 'Dña. Sara Morales y D. Juan García';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'doctor-wife') {
				recName1.value = 'Dra. Carmen Santos y D. Roberto Morales';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'doctor-both') {
				recName1.value = 'Dres. Carmen Santos y Roberto Morales';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'unmarried') {
				recName1.value = 'Dña. Laura Sánchez';
				recName2.value = 'D. David Millán';
				recName2Group.style.display = 'block';
			} else if (p === 'single-guest') {
				recName1.value = 'D. Alejandro Clark y Acompañante';
				recName2.value = '';
				recName2Group.style.display = 'none';
			} else if (p === 'family') {
				recName1.value = 'Familia García Santos';
				recName2.value = '';
				recName2Group.style.display = 'none';
			}
			updateCanvas();
		});

		[recName1, recName2, recStreet, recCity, recState, recZip, retNames, retStreet, envSizeSelect].forEach(input => {
			input.addEventListener('input', updateCanvas);
		});

		toggleReturnAddr.addEventListener('change', () => {
			returnAddrFields.style.display = toggleReturnAddr.checked ? 'block' : 'none';
			updateCanvas();
		});

		fontButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				fontButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentFont = btn.getAttribute('data-font');
				updateCanvas();
			});
		});

		btnLoadBatch.addEventListener('click', () => {
			const text = batchInput.value.trim();
			if (!text) return;
			const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 0);
			if (lines.length === 0) return;

			batchAddresses = lines.map(line => {
				const parts = line.split(',').map(p => p.trim());
				return {
					name: parts[0] || 'Invitado',
					street: parts[1] || 'Dirección',
					city: parts[2] || 'Ciudad',
					state: parts[3] || 'Provincia',
					zip: parts[4] || 'CP'
				};
			});

			batchCountTag.textContent = `${batchAddresses.length} Direcciones Cargadas`;

			if (batchAddresses.length > 0) {
				const first = batchAddresses[0];
				recName1.value = first.name;
				recName2.value = '';
				recStreet.value = first.street;
				recCity.value = first.city;
				recState.value = first.state;
				recZip.value = first.zip;
				updateCanvas();
			}
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			const printDoc = printWindow.document;

			const addressesToPrint = batchAddresses.length > 0 ? batchAddresses : [{
				name: recName1.value + (recName2.value ? '<br>' + recName2.value : ''),
				street: recStreet.value,
				city: recCity.value,
				state: recState.value,
				zip: recZip.value
			}];

			const returnHTML = toggleReturnAddr.checked ? `
				<div style="position: absolute; top: 15mm; left: 15mm; font-size: 10pt; line-height: 1.3; font-family: sans-serif; color: #1e293b;">
					<strong>${retNames.value}</strong><br/>
					${retStreet.value}
				</div>
			` : '';

			let pagesHTML = '';
			addressesToPrint.forEach(addr => {
				pagesHTML += `
					<div class="envelope-page" style="width: 229mm; height: 162mm; position: relative; page-break-after: always; box-sizing: border-box; padding: 40mm 20mm 20mm; text-align: center;">
						${returnHTML}
						<div style="margin-top: 30mm;">
							<div style="font-size: 18pt; font-weight: bold; margin-bottom: 6px; font-family: ${currentFont === 'serif' ? 'Georgia, serif' : currentFont === 'sans' ? 'sans-serif' : "'Caveat', cursive"}; color: #1e293b;">
								${addr.name}
							</div>
							<div style="font-size: 12pt; color: #334155; font-family: sans-serif; line-height: 1.4;">
								${addr.street}<br/>
								${addr.zip} ${addr.city} (${addr.state})
							</div>
						</div>
					</div>
				`;
			});

			printDoc.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Imprimir Sobres de Boda — Manage.Wedding</title>
					<style>
						@page { size: 229mm 162mm; margin: 0; }
						body { margin: 0; padding: 0; background: #fff; }
						.envelope-page { width: 229mm; height: 162mm; page-break-after: always; position: relative; box-sizing: border-box; }
					</style>
				</head>
				<body>
					${pagesHTML}
					<script>
						window.onload = function() { window.print(); };
					<\/script>
				</body>
				</html>
			`);
			printDoc.close();
		});

		btnWord.addEventListener('click', () => {
			const addressesToExport = batchAddresses.length > 0 ? batchAddresses : [{
				name: recName1.value + (recName2.value ? ' & ' + recName2.value : ''),
				street: recStreet.value,
				city: recCity.value,
				state: recState.value,
				zip: recZip.value
			}];

			let content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Lista de Direcciones para Sobres</title>
				<style>
					body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; }
					table { width: 100%; border-collapse: collapse; margin-top: 15px; }
					th, td { border: 1px solid #999; padding: 8px 12px; text-align: left; }
					th { background-color: #f2f2f2; font-weight: bold; }
				</style>
				</head>
				<body>
					<h2>Manage.Wedding — Lista de Direcciones de Boda</h2>
					<p>Generado el: ${new Date().toLocaleDateString('es-ES')} | Remitente: ${retNames.value}, ${retStreet.value}</p>
					<table>
						<thead>
							<tr>
								<th>#</th>
								<th>Destinatario</th>
								<th>Dirección</th>
								<th>Localidad</th>
								<th>Provincia</th>
								<th>C. Postal</th>
							</tr>
						</thead>
						<tbody>
			`;

			addressesToExport.forEach((addr, idx) => {
				content += `
					<tr>
						<td>${idx + 1}</td>
						<td><strong>${addr.name}</strong></td>
						<td>${addr.street}</td>
						<td>${addr.city}</td>
						<td>${addr.state}</td>
						<td>${addr.zip}</td>
					</tr>
				`;
			});

			content += `</tbody></table></body></html>`;

			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'direcciones-sobres-boda.doc';
			link.click();
		});

		updateCanvas();
	</script>
</Layout>
