---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/ring-size-converter/#webapp",
      "name": "Conversor Internacional de Tallas de Anillo y Medidor Imprimible",
      "url": "https://manage.wedding/es/ring-size-converter",
      "inLanguage": "es",
      "description": "Conversor gratuito de tallas de anillo de compromiso y alianzas. Convierte al instante entre España/Europa (EU), Reino Unido (UK), Estados Unidos (US), Japón, diámetro y circunferencia en milímetros. Incluye ajuste por anchura de alianza y medidor imprimible a escala 1:1 en PDF.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo saber la talla de anillo en España y convertirla a tallas internacionales?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En España y Europa la talla coincide habitualmente con la circunferencia interior en milímetros (ej. Talla Tatum 14 = 54 mm de perímetro = 17,3 mm de diámetro = Talla US 7 = UK N 1/2). Nuestro conversor traduce al instante entre todos los sistemas joyeros mundiales."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo influye el ancho de la alianza en la talla?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las alianzas anchas (de 6 mm a 8 mm o más) abarcan más superficie del dedo y ejercen mayor fricción. Los joyeros recomiendan pedir media talla más (+0,5) en alianzas gruesas respecto a un solitario fino de 2 mm."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay entre un anillo Comfort-Fit y uno Standard-Fit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los anillos Comfort-Fit tienen el interior abombado y redondeado, lo que permite deslizar el anillo sobre los nudillos con suavidad y resulta más holgado en el dedo. Los Standard-Fit tienen el interior completamente plano."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hacer si la medida queda entre dos tallas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Elige siempre la talla superior. Los dedos se dilatan con el calor, tras hacer ejercicio o al final del día. Un anillo ligeramente holgado es mucho más cómodo que uno que corte la circulación o cueste sacar."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Cómo Medir tu Dedo y Saber tu Talla de Anillo",
      "description": "Instrucciones de joyería para medir la circunferencia del dedo y calcular el diámetro interior para alianzas y anillos de pedida.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Rodea el Dedo con una Tira de Papel",
          "text": "Corta una tira de papel fino y rodea la base del dedo anular y la parte más ancha del nudillo."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Mide la Longitud en Milímetros",
          "text": "Marca el punto de cruce con un bolígrafo y mide la longitud en plano con una regla milimétrica para obtener la circunferencia."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Calcula el Diámetro Interior (Perímetro ÷ π)",
          "text": "Divide los milímetros entre pi (3,1416) o comprueba la equivalencia directa en nuestra tabla."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Aplica la Corrección por Grosor",
          "text": "Suma media talla si vas a comprar una alianza ancha de 6 mm a 8 mm."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 5: Descarga el Medidor a Escala 1:1",
          "text": "Imprime la plantilla circular y la tira calibradora en PDF para verificar el ajuste exacto antes de comprar."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Conversor de Tallas de Anillo (España, US, UK, Diámetro y mm) | Manage.Wedding"
	description="Calcula tu talla exacta de anillo de compromiso y alianzas en España (Tatum/EU), UK, US y Japón. Incluye medidor interactivo en pantalla y plantilla PDF 1:1 para imprimir."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Conversor de Tallas de Anillo" category="attire-rings" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Tallas de Anillo y <span class="accent-italic">Alianzas</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Convierte al instante entre tallas de <strong>España/Europa (EU / Tatum), EE. UU. (US), Reino Unido (UK), Japón, Diámetro y Perímetro en mm</strong>. Incluye corrección por anchura de alianza y <strong>Medidor 1:1 en PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Cómo Averiguar tu Talla de Anillo en 3 Pasos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Selecciona la Talla Conocida o mm
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Elige el sistema de medida que conozcas (España/EU, US, UK) o introduce los milímetros de perímetro del dedo.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Ajusta por Ancho de la Alianza
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indica si es un solitario fino de 2 mm o una alianza ancha de 6 mm+ para aplicar la corrección de joyería.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporta la Ficha o Imprime en PDF
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Guarda la ficha técnica en Word o imprime la plantilla a escala real 1:1 para comprobar el ajuste sobre el papel.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Converter Form + Live Results & Circle Sizer -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="ring-grid">
			
			<!-- Left Column: Sizing Controls & Width Adjustments -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💍 Configuración de Medida de Anillo
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Conversión entre España, Europa, EE. UU., Reino Unido, Asia y milímetros
					</span>
				</div>

				<form id="ring-converter-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- 1. Known System & Size Picker -->
					<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.6rem;">
						<div>
							<label for="select-system" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Sistema de Origen *
							</label>
							<select id="select-system" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.92rem;">
								<option value="eu" selected>🇪🇸 🇪🇺 España / Europa (EU)</option>
								<option value="us">🇺🇸 🇨🇦 EE. UU. / Canadá (US)</option>
								<option value="uk">🇬🇧 🇦🇺 Reino Unido / Australia (UK)</option>
								<option value="jp">🇯🇵 🇨🇳 Japón / Asia</option>
								<option value="mm">📏 Perímetro en milímetros (mm)</option>
							</select>
						</div>

						<div>
							<label for="select-ring-val" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Selecciona tu Talla *
							</label>
							<select id="select-ring-val" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-heading); font-size: 1rem;">
							</select>
						</div>
					</div>

					<!-- 2. Band Width Setting -->
					<div>
						<label for="select-band-width" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
							Anchura de la Alianza (Compensación de Joyería)
						</label>
						<select id="select-band-width" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
							<option value="0" selected>Alianza Fina Estándar (1,5 mm – 3 mm) — Talla Real</option>
							<option value="0.25">Alianza Media (4 mm – 5 mm) — +0,25 Talla</option>
							<option value="0.5">Alianza Ancha (6 mm – 8 mm+) — +0,50 Talla Recomendada</option>
						</select>
					</div>

					<!-- 3. Comfort-Fit vs Standard-Fit Interior -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.88rem; color: var(--fg-pencil); display: block;">
							⚙️ Perfil Interior del Anillo:
						</span>
						<div style="display: flex; gap: 1rem; flex-wrap: wrap;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="radio" name="interior-fit" value="standard" checked style="accent-color: var(--fg-pencil);">
								<span>Interior Plano Estándar</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="radio" name="interior-fit" value="comfort" style="accent-color: var(--fg-pencil);">
								<span>Comfort-Fit (Interior Abombado)</span>
							</label>
						</div>
					</div>

					<!-- Quick Sizing Advice Note -->
					<div id="band-advice-box" style="background: #eff6ff; border: 1px solid var(--accent-blue); border-radius: 4px; padding: 0.65rem; font-size: 0.82rem; color: #1e3a8a; line-height: 1.4;">
						💡 <strong>Regla de Joyero:</strong> Los anillos finos (2 mm) coinciden con la medida exacta del dedo. Si compras una alianza ancha (6 mm+), subir media talla evita que quede excesivamente apretada.
					</div>

				</form>
			</div>

			<!-- Right Column: Live International Matrix & Visual Scale Circle -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main International Matrix Result Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🌐 Equivalencia Internacional de Tallas
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Talla equivalente en los principales mercados de joyería
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Ficha Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Medidor PDF 1:1
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- 4-System Big Highlight Grid -->
					<div style="display: grid; grid-template-columns: repeat(2, 1fr); sm:grid-template-columns: repeat(4, 1fr); gap: 0.6rem; text-align: center; margin-bottom: 1.25rem;">
						<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: #16a34a; font-weight: bold; text-transform: uppercase;">España / Europa</span>
							<strong id="res-eu" class="font-heading" style="font-size: 1.9rem; color: #16a34a; display: block; line-height: 1.2;">54</strong>
						</div>

						<div style="background: #fdf2f8; border: 1.5px solid var(--accent-red); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold; text-transform: uppercase;">US / Canadá</span>
							<strong id="res-us" class="font-heading" style="font-size: 1.9rem; color: var(--accent-red); display: block; line-height: 1.2;">7</strong>
						</div>

						<div style="background: #eff6ff; border: 1.5px solid var(--accent-blue); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--accent-blue); font-weight: bold; text-transform: uppercase;">UK / Australia</span>
							<strong id="res-uk" class="font-heading" style="font-size: 1.9rem; color: var(--accent-blue); display: block; line-height: 1.2;">O</strong>
						</div>

						<div style="background: #fafaf9; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--fg-pencil); font-weight: bold; text-transform: uppercase;">Japón / Asia</span>
							<strong id="res-jp" class="font-heading" style="font-size: 1.9rem; color: var(--fg-pencil); display: block; line-height: 1.2;">14</strong>
						</div>
					</div>

					<!-- Exact Millimeter & Inch Dimensions -->
					<div style="display: flex; justify-content: space-around; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem; font-size: 0.85rem; margin-bottom: 1.25rem;">
						<span>📏 Diámetro Interior: <strong id="res-dia">17,3 mm</strong></span>
						<span>📐 Perímetro: <strong id="res-circ">54,4 mm</strong></span>
					</div>

					<!-- Visual Scaled Ring Sizer Frame -->
					<div style="text-align: center; border-top: 1.5px dashed #ccc; padding-top: 1rem;">
						<span class="font-heading" style="font-size: 0.92rem; color: var(--fg-pencil); display: block; margin-bottom: 0.5rem;">
							🔍 Previsualización de Diámetro en Pantalla:
						</span>
						<div style="display: flex; justify-content: center; align-items: center; min-height: 130px;">
							<div id="visual-ring-circle" style="width: 104px; height: 104px; border: 5px solid var(--accent-red); border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; box-shadow: 0 0 10px rgba(0,0,0,0.05); background: #fff;">
								<span id="visual-ring-text" style="font-family: monospace; font-size: 0.82rem; font-weight: bold; color: var(--fg-pencil);">
									Ø 17,3 mm
								</span>
							</div>
						</div>
						<p style="font-size: 0.75rem; color: var(--text-secondary); margin: 0.4rem 0 0 0;">
							*Escala relativa. Descarga el PDF imprimible para calibrar el tamaño exacto al 100% en papel.
						</p>
					</div>

				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation (1:1 Scale Sizer) -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 4px 0;">Ficha Técnica Oficial y Medidor de Anillo</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado el: <span id="print-date"></span> | Talla España/EU: <span id="print-us-size"></span></p>
			</div>

			<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
				<h3 style="margin:0 0 10px 0;">Especificaciones de Talla de Anillo:</h3>
				<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
					<tr><td><strong>España / Europa (EU):</strong></td><td id="p-eu">54</td><td><strong>EE. UU. / Canadá (US):</strong></td><td id="p-us">7</td></tr>
					<tr><td><strong>Reino Unido / Australia (UK):</strong></td><td id="p-uk">O</td><td><strong>Japón / Asia:</strong></td><td id="p-jp">14</td></tr>
					<tr><td><strong>Diámetro Interior:</strong></td><td id="p-dia">17,3 mm</td><td><strong>Circunferencia Interior:</strong></td><td id="p-circ">54,4 mm</td></tr>
				</table>
			</div>

			<div style="border: 2px dashed #000; padding: 25px; text-align: center;">
				<h3 style="margin:0 0 10px 0;">Medidor de Dedo Imprimible a Escala 1:1</h3>
				<p style="font-size: 12px; margin-bottom: 15px;">Recorta esta tira, haz un pequeño corte en (A), rodea el dedo y pasa la lengüeta para leer tu talla directamente.</p>
				<div style="border: 1px solid #000; height: 35px; width: 100%; max-width: 500px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; font-size: 11px;">
					<span>[CORTE A]</span>
					<span>6</span><span>8</span><span>10</span><span>12</span><span>14</span><span>16</span><span>18</span><span>20</span><span>22</span><span>24</span><span>26</span><span>28</span>
					<span>[TIRAR]</span>
				</div>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Regla de Joyero</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Tabla de Equivalencias de Tallas de Anillo (España, US, UK y mm)
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>Fórmula Matemática de Joyería:</strong> Diámetro Interior (mm) × π (3,1416) = Perímetro Interior (mm). Cada incremento de talla equivale a unos <strong>+0,8 mm de diámetro interior</strong> y <strong>+2,5 mm de circunferencia</strong>. En alianzas anchas (6 mm o más), <strong>pide media talla más</strong>.
			</p>
			
			<!-- Benchmark Ring Conversion Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--accent-red);">España / Europa (EU)</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">US / Canadá</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">UK / Australia</th>
