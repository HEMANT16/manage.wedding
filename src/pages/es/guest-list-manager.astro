---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/guest-list-manager/#webapp",
      "name": "Gestor de Lista de Invitados de Boda y CRM Nupcial",
      "url": "https://manage.wedding/es/guest-list-manager",
      "inLanguage": "es",
      "description": "Organizador y gestor de lista de invitados de boda gratuito. Controla acompañantes, alergias alimentarias, estados de confirmación RSVP y exporta a Word, PDF o Excel al instante.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Organizar y Gestionar la Lista de Invitados de Boda",
      "description": "Metodología paso a paso para confeccionar la lista de boda, agrupar por familias, controlar confirmaciones y exportar el listado final.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Calcula el Cupo Total de Invitaciones",
          "text": "Divide la capacidad del salón o tu objetivo de comensales entre la tasa histórica de asistencia del 80-85% para saber a cuántas personas invitar."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Clasifica por Unidades Familiares y Grupos",
          "text": "Añade a los invitados principales, sus acompañantes (+1) y asígnalos a su grupo correspondiente (Familia Novia, Familia Novio, Amigos, Trabajo)."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Registra Dietas Especiales y Estados de Asistencia",
          "text": "Anota las confirmaciones (Asiste, Pendiente, No Asiste) y especifica celiaquías, alergias o menús veganos conforme recibas las respuestas."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Exporta el Informe Definitivo para Proveedores",
          "text": "Descarga el listado completo en Word (.doc), PDF listo para imprimir o Excel (.csv) para entregarlo al catering, wedding planner y floristería."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo exportar la lista de invitados a Word, PDF o Excel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pulsa en los botones superiores 'Exportar a Word (.doc)', 'Exportar PDF / Imprimir' o 'Exportar Excel (.csv)' para descargar de inmediato un documento estructurado con todos los nombres, grupos, dietas y mesas asignadas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la regla de protocolo para los acompañantes (+1)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El protocolo habitual concede pase doble (+1 con nombre) a quienes estén casados, comprometidos, conviviendo juntos o en relaciones estables de más de 1 año. Para los testigos y cortejo VIP el pase doble es de cortesía obligada. Para solteros es opcional según el aforo de la finca y el presupuesto."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo funciona la estrategia de Lista A y Lista B en bodas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La Lista A agrupa a familiares directos y amigos imprescindibles, a quienes se entrega la invitación 8-10 semanas antes. Conforme se reciben bajas de la Lista A, se envían invitaciones discretas a la Lista B (5-6 semanas antes) sin que sospechen que estaban en una segunda tanda."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se sincroniza esta lista con el Organizador de Mesas y el Diseñador de Minutas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, Manage.Wedding almacena todos los datos en tu propio navegador de forma segura. Cualquier invitado registrado aquí se refleja automáticamente en el Organizador de Mesas, Marcadores de Sitio y Minutas de Boda."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Gestor de Lista de Invitados de Boda (CRM con Exportación Word y PDF) | Manage.Wedding"
	description="Organiza tu lista de invitados de boda fácilmente. Gestiona acompañantes, alergias, confirmaciones RSVP y exporta a Word, PDF o Excel al instante."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Gestor de Lista de Invitados" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Gestor de Lista de <span class="accent-italic">Invitados</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Controla confirmaciones, acompañantes, dietas especiales y asignación de mesas. Exporta a <strong>Word (.doc)</strong>, <strong>PDF</strong> o <strong>Excel (.csv)</strong> en un clic.
				</p>
			</div>
		</section>

		<!-- Overview Metrics & Dashboard -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						📊 Panel de Control de Invitados
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Sincronizado con tu Organizador de Mesas y Gestor de RSVP
					</span>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Exportar Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Exportar PDF / Imprimir
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Exportar Excel (.csv)
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Cargar Ejemplo
					</button>
					<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🗑️ Vaciar Todo
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;" class="stats-counter-grid">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Pases Invitados</span>
					<strong id="stat-total-seats" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(<span id="stat-total-parties">0</span> invitaciones)</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Confirmados (Sí)</span>
					<strong id="stat-attending" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-attending-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% del total</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Pendientes (Duda)</span>
					<strong id="stat-pending" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span id="stat-pending-pct" style="font-size: 0.75rem; color: #854d0e; display: block;">0% del total</span>
				</div>
				<div style="background: #fef2f2; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #991b1b; display: block;">Declinados (Bajas)</span>
					<strong id="stat-declined" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red);">0</strong>
					<span id="stat-declined-pct" style="font-size: 0.75rem; color: #991b1b; display: block;">0% del total</span>
				</div>
				<div style="background: #faf5ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #6b21a8; display: block;">Dietas Especiales</span>
					<strong id="stat-dietary" class="font-heading" style="font-size: 1.8rem; color: #7e22ce;">0</strong>
					<span style="font-size: 0.75rem; color: #6b21a8; display: block;">Requieren Catering</span>
				</div>
			</div>

			<!-- Dynamic Visual Stacked Group Distribution Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Distribución de Invitados por Grupos</span>
					<span id="group-balance-indicator" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">Equilibrio de familias</span>
				</div>
				<div id="chart-container" style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: var(--bg-paper); margin-bottom: 0.75rem;"></div>
				<div id="chart-legend" style="display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.85rem; color: var(--fg-pencil);"></div>
			</div>
		</div>

		<!-- Main Workspace Grid: Add Guest Form + Searchable Filterable List -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 360px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="guest-workspace-grid">
			
			<!-- Left Column: Add Guest Card -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.25rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>➕</span> Añadir Invitado o Familia
				</h2>

				<form id="guest-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Primary Guest Name -->
					<div>
						<label for="guest-name" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Nombre Completo o Familia *
						</label>
						<input type="text" id="guest-name" required placeholder="ej. Sara Jenkins o Familia García" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1.05rem;">
					</div>

					<!-- Group Category -->
					<div>
						<label for="guest-group" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Grupo / Vínculo
						</label>
						<select id="guest-group" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
							<option value="Familia de la Novia">Familia de la Novia</option>
							<option value="Familia del Novio">Familia del Novio</option>
							<option value="Amigos de la Novia">Amigos de la Novia</option>
							<option value="Amigos del Novio">Amigos del Novio</option>
							<option value="Amigos en Común">Amigos en Común</option>
							<option value="Testigos / Cortejo VIP">Testigos / Cortejo VIP</option>
							<option value="Compañeros de Trabajo">Compañeros de Trabajo</option>
						</select>
					</div>

					<!-- Party Size & Plus-One -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="guest-party" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Pases / Comensales
							</label>
							<select id="guest-party" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="1">1 (Individual)</option>
								<option value="2" selected>2 (Pareja / +1)</option>
								<option value="3">3 (Familia)</option>
								<option value="4">4 (Familia de 4)</option>
								<option value="5">5+ (Grupo Grande)</option>
							</select>
						</div>
						<div>
							<label for="guest-rsvp" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Estado RSVP
							</label>
							<select id="guest-rsvp" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="Pending">⏳ Pendiente</option>
								<option value="Attending">✅ Asiste</option>
								<option value="Declined">❌ No Asiste</option>
							</select>
						</div>
					</div>

					<!-- Dietary Restrictions -->
					<div>
						<label for="guest-dietary" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Alergias / Intolerancias / Dieta
						</label>
						<input type="text" id="guest-dietary" placeholder="ej. Celíaco, Vegetariano, Alergia Frutos Secos" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						<!-- Quick Dietary Tags -->
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem;">
							<button type="button" class="diet-quick-btn" data-val="Vegetariano" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Vegetariano</button>
							<button type="button" class="diet-quick-btn" data-val="Vegano" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Vegano</button>
							<button type="button" class="diet-quick-btn" data-val="Sin Gluten / Celíaco" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Sin Gluten</button>
							<button type="button" class="diet-quick-btn" data-val="Sin Lactosa" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Sin Lactosa</button>
						</div>
					</div>

					<!-- Optional Table & Contact Notes -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="guest-table" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Mesa Asignada (Opcional)
							</label>
							<input type="text" id="guest-table" placeholder="ej. Mesa 4 o Presidencial" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						</div>
						<div>
							<label for="guest-email" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Teléfono / Email (Opcional)
							</label>
							<input type="text" id="guest-email" placeholder="600 000 000 / email" class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						</div>
					</div>

					<button type="submit" class="hand-btn" style="width: 100%; padding: 0.85rem; font-size: 1.15rem; margin-top: 0.5rem;">
						✨ Añadir a la Lista
					</button>

				</form>
			</div>

			<!-- Right Column: Interactive Searchable Table & Filter Bar -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Filter Bar -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
					
					<!-- Search Input -->
					<div style="flex: 1; min-width: 180px;">
						<input type="text" id="search-input" placeholder="🔍 Buscar por nombre, grupo, dieta o mesa..." class="form-input" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem;">
					</div>

					<!-- Group Filter -->
					<div>
						<select id="filter-group" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Todos los Grupos</option>
							<option value="Familia de la Novia">Familia de la Novia</option>
							<option value="Familia del Novio">Familia del Novio</option>
							<option value="Amigos de la Novia">Amigos de la Novia</option>
							<option value="Amigos del Novio">Amigos del Novio</option>
							<option value="Amigos en Común">Amigos en Común</option>
							<option value="Testigos / Cortejo VIP">Testigos / Cortejo VIP</option>
							<option value="Compañeros de Trabajo">Compañeros de Trabajo</option>
						</select>
					</div>

					<!-- RSVP Filter -->
					<div>
						<select id="filter-rsvp" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">Todos los Estados</option>
							<option value="Attending">Confirmados (Asiste)</option>
							<option value="Pending">Pendientes (Duda)</option>
							<option value="Declined">Bajas (No Asiste)</option>
						</select>
					</div>
				</div>

				<!-- Guest List Table Container -->
				<div id="guest-list-table-wrap" style="overflow-x: auto; max-height: 550px;">
					<table id="guest-table-elem" style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 1rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil); position: sticky; top: 0; z-index: 1;">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Invitado</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Grupo</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">RSVP</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Dieta / Alérgenos</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Mesa</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Acciones</th>
							</tr>
						</thead>
						<tbody id="guest-table-body"></tbody>
					</table>
				</div>

				<!-- Empty State Note -->
				<div id="empty-state-box" style="display: none; text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💌</div>
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">Tu lista de invitados está vacía</h3>
					<p class="font-body" style="font-size: 1.05rem; margin-bottom: 1.25rem;">Añade a tu primer invitado a la izquierda o pulsa "Cargar Ejemplo" para probar las exportaciones.</p>
					<button type="button" id="btn-empty-sample" class="hand-btn" style="padding: 0.5rem 1.25rem; font-size: 1rem;">
						➕ Cargar 8 Invitados de Ejemplo
					</button>
				</div>

			</div>
		</div>

		<!-- Hidden Printable Sheet Container for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Lista Maestra de Invitados</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exportado el: <span id="print-date"></span> | Total Pases: <span id="print-total-seats"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
