---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-venue-cost-calculator/#webapp",
      "name": "Calculadora de Costes Reales y Suplementos Ocultos de Fincas y Salones",
      "url": "https://manage.wedding/es/wedding-venue-cost-calculator",
      "inLanguage": "es",
      "description": "Calcula el coste real de una finca o salón de boda. Incluye alquiler base, mínimos de banquete, IVA (10% y 21%), tasas de servicio, limpieza, seguridad, descorche y alquiler de carpas.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular el Coste Total Real de una Finca de Boda",
      "description": "Fórmula paso a paso para auditar el presupuesto de un espacio nupcial más allá del precio de alquiler anunciado.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Introduce el Alquiler Base del Espacio",
          "text": "Indica la tarifa fija de alquiler de las instalaciones para la ceremonia y la fiesta."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Suma el Mínimo de Banquete y Barra Libre",
          "text": "Verifica si el salón exige un gasto mínimo de comida y bebida o un número mínimo de comensales garantizados."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Aplica el IVA y Tasas de Servicio",
          "text": "Añade el IVA (10% restauración, 21% alquiler de espacio) y el porcentaje de servicio o canon exigido por la finca."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Incluye Gastos de Instalación, Seguridad y Horas Extra",
          "text": "Suma personal de seguridad, fianza de limpieza, seguro de responsabilidad civil, horas extra de barra libre y cánones por proveedores ajenos."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Por qué el coste final de una finca es mucho mayor que el alquiler inicial anunciado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Porque el precio de alquiler básico suele excluir el banquete, la barra libre, el IVA (10% en menús y 21% en alquileres), las tasas de personal, las horas extra a partir de medianoche, la tasa de ceremonia civil y los cánones por traer fotógrafos o DJs ajenos a la finca."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es más económica una finca rústica sin servicios que un hotel con todo incluido?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Generalmente no. Aunque la finca rústica anuncie un alquiler bajo (ej. 3.000€–5.000€), los novios deben contratar por separado catering externo, generador de corriente, aseos portátiles de lujo (1.200€+), carpa por lluvia, menaje completo y transporte para invitados, encareciendo el coste final."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué gastos imprevistos suelen cobrar las fincas de boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los más habituales son: canon de exclusividad por fotógrafo/DJ externo (300€–800€), canon de corte de tarta exterior (2€–4€/comensal), descorche de vino o champán (10€–20€/botella), montaje de ceremonia civil (600€–1.500€), horas extra nocturnas y fianza de limpieza."
          }
        },
        {
          "@type": "Question",
          "name": "¿Las tasas de servicio de la finca sustituyen a la propina de los camareros?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Revisa bien el contrato: el suplemento de gestión suele ser un coste administrativo que se queda la empresa y no siempre llega a los camareros. Si el servicio ha sido excelente, es habitual entregar un sobre con 20€ a 50€ por camarero o bartender."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Costes Ocultos y Precio Real de Fincas de Boda | Manage.Wedding"
	description="Calcula el coste real de tu finca o salón de boda. Incluye alquiler, mínimos de banquete, IVA (10% y 21%), tasas de servicio, seguridad y horas extra."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Costes Ocultos de Finca y Salón" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Evita Sorpresas de 3.000€ a 10.000€</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Calculadora de <span class="accent-italic">Coste Real de la Finca</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Ese presupuesto de 4.000€ de alquiler a menudo se convierte en 20.000€+ al sumar mínimos de comensales, IVA, horas extra, ceremonia civil y cánones. ¡Calcula tu gasto real antes de firmar!
			</p>
		</header>

		<!-- Main Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Controls & Line-Item Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Datos del Contrato del Espacio
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Motor de Suplementos e IVA
					</span>
				</div>

				<!-- Venue Archetype Presets -->
				<div class="form-group">
					<label class="form-label" for="venue-preset">Tipo de Espacio / Modelo de Contrato</label>
					<select id="venue-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="hotel" selected>🏨 Hotel / Salón con Todo Incluido (3.500€ Base + 12.000€ Banquete + 10% IVA)</option>
						<option value="barn">🌾 Finca Rústica / Alquiler Solo Espacio (5.000€ Base + Carpas + Generador + Catering)</option>
						<option value="estate">🏰 Pazo / Castillo Señorial (7.500€ Base + 1.200€ Ceremonia + Catering Exclusivo)</option>
						<option value="winery">🍇 Bodega / Viñedos (4.500€ Base + Mínimo de Botellas Propias + Autobús)</option>
						<option value="custom">✏️ Personalizar Todos los Datos</option>
					</select>
				</div>

				<!-- Base Rental Fee & Ceremony Fee -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="base-rental">Alquiler Base del Espacio (€)</label>
						<input type="number" id="base-rental" class="form-input" value="3500" min="0" step="250" />
					</div>
					<div>
						<label class="form-label" for="ceremony-fee">Montaje Ceremonia Civil (€)</label>
						<input type="number" id="ceremony-fee" class="form-input" value="900" min="0" step="100" />
					</div>
				</div>

				<!-- Guest Count & F&B Minimum -->
				<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="guest-count">Nº de Invitados</label>
						<input type="number" id="guest-count" class="form-input" value="100" min="10" max="600" />
					</div>
					<div>
						<label class="form-label" for="fb-spend">Total Banquete y Barra (€)</label>
						<input type="number" id="fb-spend" class="form-input" value="12000" min="0" step="500" />
					</div>
				</div>

				<!-- Plus-Plus Rates (Service Charge & Tax) -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="service-charge-rate">Tasa de Servicio / Canon (%)</label>
						<input type="number" id="service-charge-rate" class="form-input" value="10" min="0" max="35" step="1" />
					</div>
					<div>
						<label class="form-label" for="tax-rate">Tipo de IVA Aplicable (%)</label>
						<input type="number" id="tax-rate" class="form-input" value="10" min="0" max="21" step="0.5" />
					</div>
				</div>

				<!-- Hidden Facility Surcharges -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Suplementos de Instalaciones y Personal (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="cleaning-fee" style="font-size: 0.9rem;">Fianza / Limpieza</label>
							<input type="number" id="cleaning-fee" class="form-input" value="400" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="security-fee" style="font-size: 0.9rem;">Personal de Seguridad</label>
							<input type="number" id="security-fee" class="form-input" value="350" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="insurance-fee" style="font-size: 0.9rem;">Seguro RC Evento</label>
							<input type="number" id="insurance-fee" class="form-input" value="150" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="overtime-fee" style="font-size: 0.9rem;">Horas Extra Barra Libre</label>
							<input type="number" id="overtime-fee" class="form-input" value="500" min="0" step="100" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Vendor Friction Add-ons (Cake Cutting / Corkage / Infrastructure) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Cánones y Logística Adicional (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="cake-cutting-rate" style="font-size: 0.9rem;">Corte Tarta / Descorche (€/pers)</label>
							<input type="number" id="cake-cutting-rate" class="form-input" value="2.50" min="0" step="0.50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="infrastructure-fee" style="font-size: 0.9rem;">Generador / Carpa / Aseos</label>
							<input type="number" id="infrastructure-fee" class="form-input" value="0" min="0" step="250" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Real Total & Price Shock Breakdown -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- True Cost Summary Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Coste Total Real de Bolsillo
						</span>
						<span id="markup-multiplier-tag" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							5,6× Alquiler Base
						</span>
					</div>

					<div id="display-real-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.5rem;">
						19.770 €
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						El alquiler anunciado era de <strong id="display-quoted-base" style="color: var(--fg-pencil);">3.500 €</strong>. Coste real por comensal: <strong id="display-per-guest" style="color: var(--fg-pencil);">198 €/persona</strong>.
					</p>

					<!-- Itemized Cost Breakdown Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Alquiler Base + Ceremonia Civil:</span>
							<strong id="item-base-total">4.400 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Gasto de Banquete y Barra Libre:</span>
							<strong id="item-fb-spend">12.000 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem; color: var(--accent-red);">
							<span>Tasa de Servicio / Canon Finca:</span>
							<strong id="item-service-charge">1.200 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem; color: var(--accent-blue);">
							<span>IVA Aplicable (10%):</span>
							<strong id="item-sales-tax">1.320 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Instalaciones (Limpieza, Seguridad, Horas Extra):</span>
							<strong id="item-facility-total">1.400 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.95rem;">
							<span>Corte de Tarta / Cánones Extra:</span>
							<strong id="item-addons-total">250 €</strong>
						</div>
					</div>

					<!-- Export Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-audit" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Auditoría (PDF)
						</button>
						<button id="btn-export-word" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar a Word
						</button>
					</div>

				</div>

				<!-- Contract Warning Callout Box -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						🚨 3 Cláusulas Clave a Revisar Antes de Firmar:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>IVA Incluido vs No Incluido:</strong> Comprueba si el presupuesto de banquete lleva el 10% de IVA y si el alquiler de finca aplica el 21%.</li>
						<li><strong>Límite de Horario y Música Nocturna:</strong> Confirma a qué hora debe cesar la música en exteriores y cuánto cuesta cada hora extra de discoteca (300€–600€/h).</li>
						<li><strong>Cánones por Proveedores Externos:</strong> Algunas fincas cobran una penalización de 500€ a 1.500€ si contratas a un fotógrafo o catering diferente al recomendado.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumen Rápido</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Fórmula y Comparativa de Coste Real por Tipo de Espacio
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					¿Poco tiempo? Aquí tienes la fórmula universal para auditar cualquier espacio nupcial y comparar presupuestos reales.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					💰 La Fórmula del Coste Real de la Finca:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Gasto Real = Alquiler Base + Ceremonia + [Banquete × (1 + Tasa% + IVA%)] + Seguridad + Limpieza + Horas Extra + Cánones • Multiplicador Medio: ¡de 3,5× a 5,5× el precio de alquiler base!
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Tipo de Espacio</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Alquiler Base Inicial</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Suplementos y Gastos Obligatorios</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Coste Total Real de Bolsillo</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Hotel / Salón Todo Incluido</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">2.500 € – 4.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mínimo banquete 12k€, 10% IVA, ceremonia civil y aparcacoches</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">18.000 € – 28.000 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Finca Rústica (Solo Espacio)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">4.000 € – 7.000 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Aseos portátiles (1.200€), generador (700€), carpa y catering externo</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">19.000 € – 30.000 €</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Pazo / Finca Señorial</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">6.000 € – 12.000 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Montaje de ceremonia (1.500€), seguridad, catering premium y horas extra</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">26.000 € – 45.000 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Bodega / Viñedo</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">4.500 € – 8.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Compra obligatoria de vino de la bodega, autobús para invitados y canon</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">22.000 € – 35.000 €</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Cómo Auditar el Contrato de la Finca y Negociar sin Sorpresas
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					El espacio y el banquete absorben entre el 45% y el 50% de vuestro presupuesto. Aprende a detectar suplementos ocultos y a blindar vuestro acuerdo.
				</p>
			</div>

			<!-- Section 1: Decoding Plus-Plus -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. El Desglose Real de un Menú de Boda
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Cuando un comercial indica que el menú cuesta "120€ por comensal", es fundamental verificar si incluye el IVA, la barra libre y los suplementos de personal.
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>🧮 Ejemplo Real para 100 Invitados con Menú de 120€:</strong><br />
					• Banquete Base: 120€ × 100 = <strong>12.000 €</strong><br />
					• Tasa de Servicio / Personal de Barra: <strong>+1.200 €</strong><br />
					• Subtotal antes de impuestos: <strong>13.200 €</strong><br />
					• 10% IVA de Restauración: <strong>+1.320 €</strong><br />
					• <strong>Total Real de Banquete: 14.520 €</strong> (El coste real por persona es de <strong>145,20 €</strong>, no 120 €).
				</div>
			</section>

			<!-- Section 2: Questions to Ask -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. 10 Preguntas Imprescindibles Antes de Firmar la Finca
				</h3>
				<ol class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li>¿Los precios facilitados incluyen el IVA (10% en banquete / 21% en alquiler)?</li>
					<li>¿Cuál es el número mínimo de comensales exigido para la fecha elegida?</li>
					<li>¿Están incluidas las mesas, sillas de ceremonia, mantelería y vajilla?</li>
					<li>¿Cuántas horas de montaje previo tienen los proveedores (florista, fotomatón, DJ)?</li>
					<li>¿Cuál es el precio por cada hora extra de barra libre a partir del horario pactado?</li>
					<li>¿Existe canon o penalización por contratar a un fotógrafo o grupo de música externo?</li>
					<li>¿Cuánto cobran por el servicio de corte de tarta o descorche de botellas traídas por nosotros?</li>
					<li>¿Exige la finca la contratación de un seguro de responsabilidad civil para el evento?</li>
					<li>¿Hay límite de decibelios o toque de queda para apagar la música en jardines exteriores?</li>
					<li>¿Cuál es la política de cancelación y aplazamiento de fecha con respecto a la fianza inicial?</li>
				</ol>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Preguntas Frecuentes sobre Espacios de Boda
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Por qué el coste final de una finca es mucho mayor que el alquiler inicial anunciado?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Porque el alquiler de instalaciones solo cubre el uso del espacio físico. Al añadir banquete, IVA, camareros, ceremonia civil y horas extra de barra libre, el presupuesto real se multiplica.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Es más económica una finca rústica sin servicios que un hotel con todo incluido?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Normalmente no. La necesidad de alquilar aseos de lujo, generadores, carpas por plan B de lluvia y transporte suele igualar o superar el precio de un hotel o salón con cocina propia.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Las tasas de servicio sustituyen a la propina de los camareros?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						El suplemento de gestión suele ser un recargo operativo de la empresa. Si el trato del equipo ha sido excepcional, es costumbre entregar una gratificación voluntaria a los camareros y maîtres.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/es/wedding-venue-cost-calculator" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('venue-preset');
		const baseRentalInput = document.getElementById('base-rental');
		const ceremonyFeeInput = document.getElementById('ceremony-fee');
		const guestCountInput = document.getElementById('guest-count');
		const fbSpendInput = document.getElementById('fb-spend');
		const serviceRateInput = document.getElementById('service-charge-rate');
		const taxRateInput = document.getElementById('tax-rate');
		const cleaningFeeInput = document.getElementById('cleaning-fee');
		const securityFeeInput = document.getElementById('security-fee');
		const insuranceFeeInput = document.getElementById('insurance-fee');
		const overtimeFeeInput = document.getElementById('overtime-fee');
		const cakeRateInput = document.getElementById('cake-cutting-rate');
		const infraFeeInput = document.getElementById('infrastructure-fee');

		const displayRealTotal = document.getElementById('display-real-total');
		const displayQuotedBase = document.getElementById('display-quoted-base');
		const displayPerGuest = document.getElementById('display-per-guest');
		const markupTag = document.getElementById('markup-multiplier-tag');

		const itemBaseTotal = document.getElementById('item-base-total');
		const itemFbSpend = document.getElementById('item-fb-spend');
		const itemServiceCharge = document.getElementById('item-service-charge');
		const itemSalesTax = document.getElementById('item-sales-tax');
		const itemFacilityTotal = document.getElementById('item-facility-total');
		const itemAddonsTotal = document.getElementById('item-addons-total');

		const btnPrint = document.getElementById('btn-print-audit');
		const btnWord = document.getElementById('btn-export-word');

		function formatEUR(num) {
			return `${Math.round(num).toLocaleString('es-ES')} €`;
		}

		function calculateVenueCost() {
			const base = parseFloat(baseRentalInput.value) || 0;
			const ceremony = parseFloat(ceremonyFeeInput.value) || 0;
			const guests = parseInt(guestCountInput.value, 10) || 1;
			const fb = parseFloat(fbSpendInput.value) || 0;
			const serviceRate = (parseFloat(serviceRateInput.value) || 0) / 100;
			const taxRate = (parseFloat(taxRateInput.value) || 0) / 100;
			const cleaning = parseFloat(cleaningFeeInput.value) || 0;
			const security = parseFloat(securityFeeInput.value) || 0;
			const insurance = parseFloat(insuranceFeeInput.value) || 0;
			const overtime = parseFloat(overtimeFeeInput.value) || 0;
			const cakeRate = parseFloat(cakeRateInput.value) || 0;
			const infra = parseFloat(infraFeeInput.value) || 0;

			const serviceCharge = fb * serviceRate;
			const subtotalBeforeTax = fb + serviceCharge;
			const salesTax = subtotalBeforeTax * taxRate;

			const facilityTotal = cleaning + security + insurance + overtime;
			const cakeTotal = cakeRate * guests;
			const addonsTotal = cakeTotal + infra;

			const grandTotal = base + ceremony + fb + serviceCharge + salesTax + facilityTotal + addonsTotal;
			const perGuest = grandTotal / guests;
			const multiplier = base > 0 ? (grandTotal / base).toFixed(1).replace('.', ',') : '1';

			displayRealTotal.textContent = formatEUR(grandTotal);
			displayQuotedBase.textContent = formatEUR(base);
			displayPerGuest.textContent = `${Math.round(perGuest).toLocaleString('es-ES')} €/persona`;
			markupTag.textContent = `${multiplier}× Alquiler Base`;

			itemBaseTotal.textContent = formatEUR(base + ceremony);
			itemFbSpend.textContent = formatEUR(fb);
			itemServiceCharge.textContent = formatEUR(serviceCharge);
			itemSalesTax.textContent = formatEUR(salesTax);
			itemFacilityTotal.textContent = formatEUR(facilityTotal);
			itemAddonsTotal.textContent = formatEUR(addonsTotal);
		}

		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'hotel') {
				baseRentalInput.value = 3500;
				ceremonyFeeInput.value = 900;
				guestCountInput.value = 100;
				fbSpendInput.value = 12000;
				serviceRateInput.value = 10;
				taxRateInput.value = 10;
				cleaningFeeInput.value = 400;
				securityFeeInput.value = 350;
				insuranceFeeInput.value = 150;
				overtimeFeeInput.value = 500;
				cakeRateInput.value = 2.50;
				infraFeeInput.value = 0;
			} else if (p === 'barn') {
				baseRentalInput.value = 5500;
				ceremonyFeeInput.value = 600;
				guestCountInput.value = 100;
				fbSpendInput.value = 10500;
				serviceRateInput.value = 10;
				taxRateInput.value = 10;
				cleaningFeeInput.value = 500;
				securityFeeInput.value = 400;
				insuranceFeeInput.value = 200;
				overtimeFeeInput.value = 700;
				cakeRateInput.value = 0;
				infraFeeInput.value = 2200;
			} else if (p === 'estate') {
				baseRentalInput.value = 7500;
				ceremonyFeeInput.value = 1200;
				guestCountInput.value = 100;
				fbSpendInput.value = 14000;
				serviceRateInput.value = 12;
				taxRateInput.value = 10;
				cleaningFeeInput.value = 600;
				securityFeeInput.value = 500;
				insuranceFeeInput.value = 250;
				overtimeFeeInput.value = 900;
				cakeRateInput.value = 3.00;
				infraFeeInput.value = 400;
			} else if (p === 'winery') {
				baseRentalInput.value = 4500;
				ceremonyFeeInput.value = 800;
				guestCountInput.value = 100;
				fbSpendInput.value = 13000;
				serviceRateInput.value = 10;
				taxRateInput.value = 10;
				cleaningFeeInput.value = 450;
				securityFeeInput.value = 350;
				insuranceFeeInput.value = 180;
				overtimeFeeInput.value = 600;
				cakeRateInput.value = 2.00;
				infraFeeInput.value = 1000;
			}
			calculateVenueCost();
		});

		[baseRentalInput, ceremonyFeeInput, guestCountInput, fbSpendInput, serviceRateInput, taxRateInput, cleaningFeeInput, securityFeeInput, insuranceFeeInput, overtimeFeeInput, cakeRateInput, infraFeeInput].forEach(inp => {
			inp.addEventListener('input', calculateVenueCost);
		});

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Auditoría de Costes de Finca — Manage.Wedding</title>
					<style>
						@page { size: 8.5in 11in; margin: 0.5in; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 20pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 13pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Auditoría de Costes Reales de Finca y Salón</h1>
					<p>Calculado para ${guestCountInput.value} invitados | Fecha: ${new Date().toLocaleDateString('es-ES')}</p>
					
					<table>
						<thead>
							<tr><th>Partida de Gasto</th><th>Detalles del Concepto</th><th>Importe (€)</th></tr>
						</thead>
						<tbody>
							<tr><td>Alquiler Base y Ceremonia</td><td>Alquiler (${baseRentalInput.value} €) + Ceremonia Civil (${ceremonyFeeInput.value} €)</td><td>${itemBaseTotal.textContent}</td></tr>
							<tr><td>Gasto en Banquete y Barra</td><td>Compromiso de Comida y Bebida</td><td>${itemFbSpend.textContent}</td></tr>
							<tr><td>Tasa de Servicio / Canon</td><td>${serviceRateInput.value}% suplemento de gestión</td><td>${itemServiceCharge.textContent}</td></tr>
							<tr><td>IVA Aplicable</td><td>${taxRateInput.value}% IVA</td><td>${itemSalesTax.textContent}</td></tr>
							<tr><td>Gastos de Instalaciones</td><td>Limpieza (${cleaningFeeInput.value} €) + Seguridad (${securityFeeInput.value} €) + Seguro (${insuranceFeeInput.value} €) + Horas Extra (${overtimeFeeInput.value} €)</td><td>${itemFacilityTotal.textContent}</td></tr>
							<tr><td>Cánones y Extras</td><td>Corte de Tarta + Descorche / Generadores</td><td>${itemAddonsTotal.textContent}</td></tr>
							<tr class="total-row"><td>TOTAL REAL DE BOLSILLO</td><td>Coste definitivo del espacio y banquete (${markupTag.textContent})</td><td>${displayRealTotal.textContent}</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		btnWord.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Auditoría de Costes de Finca</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Auditoría de Costes de Finca</h2>
					<p>Alquiler Base Inicial: ${baseRentalInput.value} € | <strong>Coste Total Real: ${displayRealTotal.textContent}</strong> (${displayPerGuest.textContent})</p>
					<table>
						<thead><tr><th>Concepto</th><th>Importe (€)</th></tr></thead>
						<tbody>
							<tr><td>Alquiler Base + Ceremonia</td><td>${itemBaseTotal.textContent}</td></tr>
							<tr><td>Banquete y Barra Libre</td><td>${itemFbSpend.textContent}</td></tr>
							<tr><td>Tasa de Servicio (${serviceRateInput.value}%)</td><td>${itemServiceCharge.textContent}</td></tr>
							<tr><td>IVA (${taxRateInput.value}%)</td><td>${itemSalesTax.textContent}</td></tr>
							<tr><td>Instalaciones (Limpieza, Seguridad, Seguro)</td><td>${itemFacilityTotal.textContent}</td></tr>
							<tr><td>Cánones y Logística</td><td>${itemAddonsTotal.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL</td><td>${displayRealTotal.textContent}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'auditoria-coste-finca-boda.doc';
			link.click();
		});

		calculateVenueCost();
	</script>
</Layout>
