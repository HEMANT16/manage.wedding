<script is:inline>
	let currencySymbol = '€';

	const currencySelect = document.getElementById('currency-select');
	const chkCatererIncluded = document.getElementById('chk-caterer-included');
	const inputCatererBill = document.getElementById('input-caterer-bill');
	const selectCatererRate = document.getElementById('select-caterer-rate');

	const inputBeautyBill = document.getElementById('input-beauty-bill');
	const selectBeautyRate = document.getElementById('select-beauty-rate');

	const selectPhotoLead = document.getElementById('select-photo-lead');
	const selectPhotoSecond = document.getElementById('select-photo-second');

	const selectDjTip = document.getElementById('select-dj-tip');
	const selectBandTip = document.getElementById('select-band-tip');

	const selectPlannerTip = document.getElementById('select-planner-tip');
	const selectDriverTip = document.getElementById('select-driver-tip');
	const selectOfficiantTip = document.getElementById('select-officiant-tip');
	const selectDeliveryTip = document.getElementById('select-delivery-tip');
	const selectCakeTip = document.getElementById('select-cake-tip');

	// Result Elements
	const resTotalGratuity = document.getElementById('res-total-gratuity');
	const resEnvelopeCount = document.getElementById('res-envelope-count');
	const resCatererTip = document.getElementById('res-caterer-tip');
	const resBeautyTip = document.getElementById('res-beauty-tip');
	const resPhotoTip = document.getElementById('res-photo-tip');
	const resDjTip = document.getElementById('res-dj-tip');
	const resPlannerTip = document.getElementById('res-planner-tip');
	const resLogisticsTip = document.getElementById('res-logistics-tip');
	const resDeliveryTip = document.getElementById('res-delivery-tip');

	const barCaterer = document.getElementById('bar-caterer');
	const barBeauty = document.getElementById('bar-beauty');
	const barPhoto = document.getElementById('bar-photo');
	const barDj = document.getElementById('bar-dj');
	const barPlanner = document.getElementById('bar-planner');
	const barOther = document.getElementById('bar-other');

	function formatMoney(amount) {
		return `${Math.round(amount).toLocaleString('es-ES')} ${currencySymbol}`;
	}

	function calculateTips() {
		currencySymbol = currencySelect.value;

		// 1. Caterer
		let catererTip = 0;
		if (!chkCatererIncluded.checked) {
			const bill = parseFloat(inputCatererBill.value) || 0;
			const rate = selectCatererRate.value;
			if (rate === 'flat') {
				catererTip = 30 * 10;
			} else {
				catererTip = bill * parseFloat(rate);
			}
		}

		// 2. Beauty
		const beautyBill = parseFloat(inputBeautyBill.value) || 0;
		const beautyRate = parseFloat(selectBeautyRate.value) || 0.10;
		const beautyTip = beautyBill * beautyRate;

		// 3. Photo / Video
		const photoLead = parseFloat(selectPhotoLead.value) || 0;
		const photoSecond = parseFloat(selectPhotoSecond.value) || 0;
		const photoTotal = photoLead + photoSecond;

		// 4. DJ & Band
		const djTip = parseFloat(selectDjTip.value) || 0;
		const bandTip = parseFloat(selectBandTip.value) || 0;
		const musicTotal = djTip + bandTip;

		// 5. Planner
		const plannerTip = parseFloat(selectPlannerTip.value) || 0;

		// 6. Drivers & Officiant
		const driverTip = parseFloat(selectDriverTip.value) || 0;
		const officiantTip = parseFloat(selectOfficiantTip.value) || 0;
		const logisticsTotal = driverTip + officiantTip;

		// 7. Delivery Crews
		const deliveryTip = parseFloat(selectDeliveryTip.value) || 0;
		const cakeTip = parseFloat(selectCakeTip.value) || 0;
		const deliveryTotal = deliveryTip + cakeTip;

		const grandTotal = catererTip + beautyTip + photoTotal + musicTotal + plannerTip + logisticsTotal + deliveryTotal;

		let count = 0;
		if (catererTip > 0) count++;
		if (beautyTip > 0) count++;
		if (photoLead > 0) count++;
		if (photoSecond > 0) count++;
		if (djTip > 0) count++;
		if (bandTip > 0) count++;
		if (plannerTip > 0) count++;
		if (driverTip > 0) count++;
		if (officiantTip > 0) count++;
		if (deliveryTotal > 0) count++;

		resTotalGratuity.textContent = formatMoney(grandTotal);
		resEnvelopeCount.textContent = `Repartido en ${count} Sobres de Efectivo`;
		resCatererTip.textContent = formatMoney(catererTip);
		resBeautyTip.textContent = formatMoney(beautyTip);
		resPhotoTip.textContent = formatMoney(photoTotal);
		resDjTip.textContent = formatMoney(musicTotal);
		resPlannerTip.textContent = formatMoney(plannerTip);
		resLogisticsTip.textContent = formatMoney(logisticsTotal);
		resDeliveryTip.textContent = formatMoney(deliveryTotal);

		if (grandTotal > 0) {
			barCaterer.style.width = `${Math.round((catererTip / grandTotal) * 100)}%`;
			barBeauty.style.width = `${Math.round((beautyTip / grandTotal) * 100)}%`;
			barPhoto.style.width = `${Math.round((photoTotal / grandTotal) * 100)}%`;
			barDj.style.width = `${Math.round((musicTotal / grandTotal) * 100)}%`;
			barPlanner.style.width = `${Math.round((plannerTip / grandTotal) * 100)}%`;
			barOther.style.width = `${Math.round(((logisticsTotal + deliveryTotal) / grandTotal) * 100)}%`;
		}
	}

	document.querySelectorAll('.tip-input, #chk-caterer-included').forEach(el => {
		el.addEventListener('input', calculateTips);
		el.addEventListener('change', calculateTips);
	});
	document.querySelectorAll('.tip-select, #currency-select').forEach(el => {
		el.addEventListener('change', calculateTips);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let rows = '';
		if (parseFloat(resCatererTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Catering y Camareros</strong></td><td>Al finalizar el baile</td><td>Padrino / Coordinadora</td><td style="text-align:right; font-weight:bold;">${resCatererTip.textContent}</td></tr>`;
		}
		if (parseFloat(resBeautyTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Peluquería y Maquillaje</strong></td><td>Tras finalizar en habitación</td><td>Dama de Honor / Novia</td><td style="text-align:right; font-weight:bold;">${resBeautyTip.textContent}</td></tr>`;
		}
		if (parseFloat(selectPhotoLead.value) > 0) {
			rows += `<tr><td><strong>Fotógrafo Principal</strong></td><td>Al terminar cobertura</td><td>Padrino</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPhotoLead.value)}</td></tr>`;
		}
		if (parseFloat(selectPhotoSecond.value) > 0) {
			rows += `<tr><td><strong>Segundo Fotógrafo / Asistente</strong></td><td>Al terminar cobertura</td><td>Padrino</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPhotoSecond.value)}</td></tr>`;
		}
		if (parseFloat(selectDjTip.value) > 0) {
			rows += `<tr><td><strong>DJ de la Boda</strong></td><td>Al cierre de la fiesta</td><td>Padrino</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectDjTip.value)}</td></tr>`;
		}
		if (parseFloat(selectPlannerTip.value) > 0) {
			rows += `<tr><td><strong>Wedding Planner / Coordinadora</strong></td><td>Al cierre de la fiesta</td><td>Madre de la Novia / Padrino</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPlannerTip.value)}</td></tr>`;
		}
		if (parseFloat(selectDriverTip.value) > 0) {
			rows += `<tr><td><strong>Chóferes</strong></td><td>Tras el último viaje</td><td>Padrino</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectDriverTip.value)}</td></tr>`;
		}
		if (parseFloat(selectOfficiantTip.value) > 0) {
			rows += `<tr><td><strong>Oficiante de Ceremonia</strong></td><td>Antes / Tras la ceremonia</td><td>Padrino</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectOfficiantTip.value)}</td></tr>`;
		}
		if (parseFloat(resDeliveryTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Montaje Floral y Tarta</strong></td><td>En la entrega matinal</td><td>Coordinadora de Finca</td><td style="text-align:right; font-weight:bold;">${resDeliveryTip.textContent}</td></tr>`;
		}

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Cuadrante de Propinas de Boda</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Cuadrante Oficial de Sobres de Propina</h1>
				<p>Generado el ${new Date().toLocaleDateString('es-ES')} | Total Propinas en Efectivo: <strong>${resTotalGratuity.textContent}</strong> (${resEnvelopeCount.textContent})</p>
				
				<h3>Cuadrante de Entrega de Sobres:</h3>
				<table>
					<thead>
						<tr>
							<th>Proveedor / Profesional</th>
							<th>Momento de Entrega</th>
							<th>Persona Asignada</th>
							<th style="text-align:right;">Importe (€)</th>
						</tr>
					</thead>
					<tbody>
						${rows}
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;">
							<td colspan="3">Total Propinas Preparadas</td>
							<td style="text-align:right; color:#b91c1c;">${resTotalGratuity.textContent}</td>
						</tr>
					</tbody>
				</table>

				<h3 style="margin-top:25px;">Consejos para el Día B:</h3>
				<p>• Cierra y rotula los sobres en efectivo 3 días antes de la boda.</p>
				<p>• Entrega todos los sobres al padrino o coordinadora el día previo.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Sobres_Propinas_Boda_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('es-ES');
		document.getElementById('print-total').textContent = resTotalGratuity.textContent;

		const tbody = document.getElementById('print-tipping-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Catering y Camareros</td><td style="border:1px solid #ccc; padding:6px;">Al finalizar el banquete</td><td style="border:1px solid #ccc; padding:6px;">Padrino / Coordinadora</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resCatererTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Peluquería y Maquillaje</td><td style="border:1px solid #ccc; padding:6px;">Tras peinado en suite</td><td style="border:1px solid #ccc; padding:6px;">Dama de Honor</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBeautyTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Equipo Foto y Vídeo</td><td style="border:1px solid #ccc; padding:6px;">Al finalizar cobertura</td><td style="border:1px solid #ccc; padding:6px;">Padrino</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPhotoTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">DJ y Músicos</td><td style="border:1px solid #ccc; padding:6px;">Al cierre de barra libre</td><td style="border:1px solid #ccc; padding:6px;">Padrino</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDjTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Wedding Planner</td><td style="border:1px solid #ccc; padding:6px;">Al cierre de la fiesta</td><td style="border:1px solid #ccc; padding:6px;">Madre de la Novia</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPlannerTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Chóferes y Oficiante</td><td style="border:1px solid #ccc; padding:6px;">Al terminar el servicio</td><td style="border:1px solid #ccc; padding:6px;">Padrino</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resLogisticsTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Montaje y Reparto Tarta</td><td style="border:1px solid #ccc; padding:6px;">Al terminar la entrega</td><td style="border:1px solid #ccc; padding:6px;">Coordinadora Finca</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDeliveryTip.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td colspan="3" style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Total Propinas Preparadas</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#b91c1c;">${resTotalGratuity.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Proveedor,Momento Entrega,Responsable,Importe\n";
		csv += `"Catering y Camareros","Al finalizar el banquete","Padrino / Coordinadora","${resCatererTip.textContent}"\n`;
		csv += `"Peluqueria y Maquillaje","Tras finalizar peinado","Dama de Honor","${resBeautyTip.textContent}"\n`;
		csv += `"Foto y Video","Al finalizar cobertura","Padrino","${resPhotoTip.textContent}"\n`;
		csv += `"DJ y Musicos","Al cierre de fiesta","Padrino","${resDjTip.textContent}"\n`;
		csv += `"Wedding Planner","Al cierre de fiesta","Madre de la Novia","${resPlannerTip.textContent}"\n`;
		csv += `"Choferes y Oficiante","Al terminar servicio","Padrino","${resLogisticsTip.textContent}"\n`;
		csv += `"Montaje y Tarta","En la entrega matinal","Coordinadora Finca","${resDeliveryTip.textContent}"\n`;
		csv += `"Total Propinas","--","--","${resTotalGratuity.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Propinas_Proveedores_Boda_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateTips();
</script>
