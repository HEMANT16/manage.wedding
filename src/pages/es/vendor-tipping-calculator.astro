---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/vendor-tipping-calculator/#webapp",
      "name": "Calculadora de Propinas a Proveedores de Boda y Generador de Sobres",
      "url": "https://manage.wedding/es/vendor-tipping-calculator",
      "inLanguage": "es",
      "description": "Calculadora gratuita de propinas para proveedores de boda. Calcula gratificaciones exactas para camareros, DJs, fotógrafos, wedding planners, peluquería, chóferes y montadores. Exporta sobres de efectivo a Word, PDF y Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular las Propinas para los Proveedores de tu Boda",
      "description": "Guía completa para calcular gratificaciones según la costumbre actual, identificar suplementos de servicio en contrato y preparar los sobres de dinero.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Revisa los Contratos para Detectar Propinas Incluidas",
          "text": "Comprueba si el contrato de catering o de transporte ya incluye una tasa de servicio o gratificación obligatoria."
        },
        {
          "@type": "HowToStep",
          "name": "Calcula Propinas Porcentuales",
          "text": "Aplica entre un 10% y un 15% sobre servicios de belleza (peluquería y maquillaje) y banquetes si el servicio ha sido sobresaliente."
        },
        {
          "@type": "HowToStep",
          "name": "Asigna Gratificaciones Fijas por Profesional",
          "text": "Asigna importes fijos habituales: 50€-100€ para fotógrafo/videógrafo, 50€-100€ para DJ/músicos y 20€-40€ por camarero o chófer."
        },
        {
          "@type": "HowToStep",
          "name": "Prepara y Delega los Sobres de Efectivo",
          "text": "Rotula los sobres con antelación y entrégaselos al padrino, dama de honor o wedding planner para repartirlos durante el evento."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Es obligatorio dar propina a los proveedores que son dueños de su propio negocio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No es obligatorio. Tradicionalmente los profesionales autónomos fijan sus tarifas comerciales y no esperan propina. No obstante, si el fotógrafo o la wedding planner han realizado un trabajo excepcional, una gratificación de 50€ a 150€ o una reseña excelente de 5 estrellas es un gesto de gran agradecimiento."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la diferencia entre canon de servicio y propina directa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El canon o tasa de servicio suele ser un recargo operativo que retiene la empresa para gastos de gestión y personal. Pregunta siempre al catering si ese suplemento llega íntegramente a los camareros; si no es así, es habitual entregar un sobre con 20€ a 40€ por camarero."
          }
        },
        {
          "@type": "Question",
          "name": "¿Quién debe encargarse de repartir los sobres de propina el día de la boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los novios nunca deben llevar dinero encima durante la boda. Prepara sobres rotulados y delega la entrega en el padrino, la dama de honor o el coordinador de la boda al finalizar el servicio de cada proveedor."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto se suele dar de propina a peluqueros y maquilladores de boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se suele dar entre un 10% y un 15% del coste total del servicio. Si el equipo se desplazó a primera hora de la mañana al hotel o domicilio de la novia, un 15% a 20% es el estándar habitual."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Propinas a Proveedores de Boda (Guía y Sobres en PDF) | Manage.Wedding"
	description="Calcula las propinas para los profesionales de tu boda. Guía de gratificaciones para camareros, DJs, fotógrafos y peluquería con exportación a Word y PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Propinas a Proveedores" category="budget-finance" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calculadora de <span class="accent-italic">Propinas a Proveedores</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calcula las gratificaciones exactas según la costumbre actual. Desglosa partidas para más de 10 proveedores y genera tus <strong>Sobres de Efectivo</strong> en <strong>Word (.doc)</strong> o <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Cómo Organizar las Propinas en 3 Sencillos Pasos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Introduce los Costes de Contrato
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indica los importes de tus proveedores contratados. Desmarca aquellos que no hayas contratado o cuyo contrato ya incluya servicio.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Revisa los Importes Sugeridos
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						La calculadora aplica porcentajes recomendados (10-15%) o importes fijos habituales (50€–100€) para fotógrafos, DJs y oficiantes.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Exporta tus Sobres Imprimibles
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Haz clic en <strong>"📝 Exportar a Word"</strong> o <strong>"🖨️ Imprimir PDF"</strong> para obtener las etiquetas de sobres y el calendario de entrega para el padrino.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="tipping-calc-grid">
			
			<!-- Left Column: 10+ Vendor Categories Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							💵 Proveedores y Personal
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Configura los importes y servicios contratados
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Moneda:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="$">$ (USD/CAD/AUD)</option>
							<option value="£">£ (GBP)</option>
							<option value="₹">₹ (INR)</option>
						</select>
					</div>
				</div>

				<form id="tipping-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Catering & Bartenders -->
					<div class="vendor-input-group">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
							<label class="font-heading" style="font-size: 1rem; color: var(--accent-red);">
								🍽️ Catering, Camareros y Barra Libre
							</label>
							<label style="font-size: 0.78rem; display: flex; align-items: center; gap: 0.3rem; cursor: pointer; color: var(--text-secondary);">
								<input type="checkbox" id="chk-caterer-included"> Servicio incluido en contrato
							</label>
						</div>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Gasto Total en Banquete (€)</span>
								<input type="number" id="input-caterer-bill" value="6500" min="0" step="100" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Tipo de Propina</span>
								<select id="select-caterer-rate" class="tip-select">
									<option value="0.05" selected>5% del Banquete (325 €)</option>
									<option value="0.08">8% del Banquete (520 €)</option>
									<option value="0.10">10% del Banquete (650 €)</option>
									<option value="flat">Fijo 30 € por Camarero</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 2. Hair & Makeup (HMUA) -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: var(--accent-blue); display: block; margin-bottom: 0.3rem;">
							💄 Maquillaje y Peluquería (Novia e Invitadas)
						</label>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Total Factura Belleza (€)</span>
								<input type="number" id="input-beauty-bill" value="550" min="0" step="50" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Porcentaje de Propina</span>
								<select id="select-beauty-rate" class="tip-select">
									<option value="0.10" selected>10% (Estándar)</option>
									<option value="0.15">15% (Servicio a Domicilio Excelente)</option>
									<option value="0.20">20% (Servicio Excepcional)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 3. Photography & Videography -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #16a34a; display: block; margin-bottom: 0.3rem;">
							📸 Fotógrafo y Videógrafo Principal / Asistente
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Fotógrafo Principal</span>
								<select id="select-photo-lead" class="tip-select">
									<option value="75" selected>Fotógrafo Principal (75 €)</option>
									<option value="100">Fotógrafo Principal (100 €)</option>
									<option value="50">Fotógrafo Principal (50 €)</option>
									<option value="0">Sin Propina / Dueño Empresa (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Segundo Fotógrafo / Asistente</span>
								<select id="select-photo-second" class="tip-select">
									<option value="50" selected>Segundo Operador (50 €)</option>
									<option value="35">Segundo Operador (35 €)</option>
									<option value="75">Segundo Operador (75 €)</option>
									<option value="0">Sin Segundo Operador (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 4. DJ & Entertainment -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #7c3aed; display: block; margin-bottom: 0.3rem;">
							🎵 DJ de la Fiesta y Músicos en Directo
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">DJ Principal / Animador</span>
								<select id="select-dj-tip" class="tip-select">
									<option value="60" selected>DJ Principal (60 €)</option>
									<option value="100">DJ Principal (100 €)</option>
									<option value="40">DJ Principal (40 €)</option>
									<option value="0">Sin Propina (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Músicos de Ceremonia / Cóctel</span>
								<select id="select-band-tip" class="tip-select">
									<option value="30" selected>Músicos (30 € / miembro)</option>
									<option value="50">Músicos (50 € / miembro)</option>
									<option value="0">Sin Músicos en Directo (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 5. Wedding Planner & Coordinator -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #d97706; display: block; margin-bottom: 0.3rem;">
							📋 Wedding Planner / Coordinación Día B
						</label>
						<div>
							<select id="select-planner-tip" class="tip-select">
								<option value="100" selected>Coordinadora Día B (100 €)</option>
								<option value="180">Wedding Planner Integral (180 €)</option>
								<option value="60">Coordinadora Día B (60 €)</option>
								<option value="0">Sin Propina / Dueño Empresa (0 €)</option>
							</select>
						</div>
					</div>

					<!-- 6. Drivers, Officiant & Delivery Setup Crew -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block; text-align: center;">
							🚐 Logística, Oficiante y Personal de Montaje
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Chófer de Autobús / Coche</span>
								<select id="select-driver-tip" class="tip-select">
									<option value="40" selected>Chófer (40 €)</option>
									<option value="70">Varios Chóferes (70 € total)</option>
									<option value="0">Incluido en Factura (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Oficiante de Ceremonia</span>
								<select id="select-officiant-tip" class="tip-select">
									<option value="50" selected>Gratificación / Donativo (50 €)</option>
									<option value="80">Donativo Parroquia (80 €)</option>
									<option value="0">Tarifa Oficial Cubierta (0 €)</option>
								</select>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Montaje Floral y Decoración</span>
								<select id="select-delivery-tip" class="tip-select">
									<option value="30" selected>Equipo de Montaje (30 €)</option>
									<option value="50">Gran Montaje Floral (50 €)</option>
									<option value="0">Sin Propina (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Reparto de Tarta Nupcial</span>
								<select id="select-cake-tip" class="tip-select">
									<option value="15" selected>Repartidor de Tarta (15 €)</option>
									<option value="25">Montaje Complejo Tarta (25 €)</option>
									<option value="0">Sin Propina (0 €)</option>
								</select>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Gratuity Breakdown & Cash Envelope Planner -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Gratuity Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								✉️ Presupuesto de Propinas
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Efectivo necesario para los sobres de boda
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar a Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimir PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Gratuity Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Total Propinas a Preparar</span>
						<strong id="res-total-gratuity" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">745 €</strong>
						<span id="res-envelope-count" style="font-size: 0.8rem; color: var(--accent-red);">Repartido en 8 Sobres de Efectivo</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Desglose de Sobres Individuales
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Catering y Camareros:</td>
									<td id="res-caterer-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">325,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">💄 Peluquería y Maquillaje:</td>
									<td id="res-beauty-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">55,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📸 Equipo de Fotografía y Vídeo:</td>
									<td id="res-photo-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">125,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🎵 DJ y Músicos:</td>
									<td id="res-dj-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">90,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📋 Wedding Planner / Coordinadora:</td>
									<td id="res-planner-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">100,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🚐 Chóferes y Oficiante:</td>
									<td id="res-logistics-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">90,00 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0;">🌸 Montaje y Entrega de Tarta:</td>
									<td id="res-delivery-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">45,00 €</td>
								</tr>
