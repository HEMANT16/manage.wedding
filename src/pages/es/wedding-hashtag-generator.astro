---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/wedding-hashtag-generator/#webapp",
      "name": "Generador de Hashtags de Boda y Carteles para Mesas",
      "url": "https://manage.wedding/es/wedding-hashtag-generator",
      "inLanguage": "es",
      "description": "Generador gratuito de hashtags de boda originales y personalizados. Crea más de 50 ideas románticas, divertidas y fiesteras con tus nombres y exporta carteles imprimibles en PDF y Word para las mesas y el fotomatón.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cómo crea este generador hashtags de boda únicos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Combina los nombres de pila, apellidos, apodo conjunto de la pareja, año de la boda y juegos de palabras en 5 categorías (Románticos, Divertidos/Juegos de Palabras, Fiesta y Brindis, Destino, y Cortos)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué usar mayúsculas en cada palabra (CamelCase) en el hashtag?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usar CamelCase (ej. #BodaLauraYMarcos2026 en lugar de #bodalauraymarcos2026) hace que la etiqueta sea infinitamente más fácil de leer en los carteles de mesa, evita confusiones de lectura y garantiza que los lectores de pantalla para personas con discapacidad visual lo pronuncien correctamente."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo comprobar si nuestro hashtag de boda ya está pillado en redes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Búscalo directamente en Instagram o TikTok. Si hay menos de 5 o 10 fotos antiguas, es seguro usarlo. Si hay miles de publicaciones, añade el año de la boda o la ciudad (ej. #BodaGarciaPerez2026) para que sea 100% exclusivo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Dónde debemos colocar el hashtag durante la boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En las invitaciones o Save the Date, en la web de boda, en el photocall/fotomatón, en la barra libre y en carteles elegantes en cada mesa. ¡Puedes imprimir tu cartel enmarcable directamente desde esta herramienta!"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Cómo Crear y Utilizar un Hashtag Personalizado para tu Boda",
      "description": "Guía paso a paso para crear un hashtag original y conseguir que todos los invitados compartan sus fotos.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Introduce los Nombres y Apellidos",
          "text": "Escribe los nombres de ambos novios, apellidos, apodo de pareja y año de celebración."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Elige el Estilo o Tono Deseado",
          "text": "Filtra entre ideas románticas, divertidas, fiesteras o directas y selecciona tu favorita."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Comprueba la Disponibilidad en Instagram",
          "text": "Verifica que no esté saturado de fotos ajenas para crear un álbum digital limpio."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Exporta e Imprime el Cartel para la Boda",
          "text": "Genera el cartel oficial en PDF o Word e imprímelo para colocarlo en marcos decorativos en las mesas y la barra."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Generador de Hashtags de Boda y Carteles para Mesas | Manage.Wedding"
	description="Genera hashtags de boda originales, románticos y divertidos. Copia en 1 clic y exporta carteles imprimibles para las mesas y la barra libre en Word y PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Generador de Hashtags de Boda" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Generador de Hashtags <span class="accent-italic">de Boda</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Crea más de 50 hashtags románticos, ingeniosos y festivos. Cópialos al instante, compruébalos en Instagram y exporta <strong>Carteles Imprimibles de Mesa</strong> en Word o PDF.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Cómo Crear el Hashtag Perfecto en 3 Pasos
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Introduce Nombres y Apellidos
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indica vuestros nombres, apellidos, apodo de la pareja y el año de la boda o ciudad del enlace.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Filtra por Estilo y Elige tu Favorito
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Explora por categorías (Románticos, Divertidos, Fiesta o Cortos) y pulsa sobre el que más os guste.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Imprime el Cartel para las Mesas
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Haz clic en <strong>"🖨️ Imprimir Cartel / PDF"</strong> para colocarlo en marcos en la barra, photocall y mesas.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Generator Form + Live Results & Sign Mockup -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="hashtag-grid">
			
			<!-- Left Column: Couple Details Form & Filter Tabs -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💍 Datos de la Pareja y Juegos de Palabras
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Escribe vuestros datos para generar decenas de combinaciones exclusivas
					</span>
				</div>

				<form id="hashtag-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Partner 1 -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p1-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Nombre Contrayente 1 *
							</label>
							<input type="text" id="p1-first" value="Laura" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p1-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Apellido Contrayente 1 *
							</label>
							<input type="text" id="p1-last" value="García" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Partner 2 -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p2-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Nombre Contrayente 2 *
							</label>
							<input type="text" id="p2-first" value="Marcos" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p2-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Apellido Contrayente 2 *
							</label>
							<input type="text" id="p2-last" value="Pérez" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Nickname, Year, Destination -->
					<div style="display: grid; grid-template-columns: 1.2fr 0.8fr 1fr; gap: 0.6rem;">
						<div>
							<label for="couple-nickname" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Apodo Conjunto (Opcional)
							</label>
							<input type="text" id="couple-nickname" value="LauyMarcos" placeholder="ej. LauyMarcos" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-year" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Año
							</label>
							<input type="number" id="wedding-year" value="2026" min="2024" max="2035" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-city" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Ciudad / Finca (Opcional)
							</label>
							<input type="text" id="wedding-city" placeholder="ej. Madrid / Mallorca" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</div>

					<!-- Vibe Filter Selector -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
							🎨 Filtrar por Estilo de Hashtag:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
							<button type="button" class="filter-tab-btn active-tab hand-btn" data-vibe="all" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">✨ Todas las Ideas (50+)</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="romantic" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">💖 Románticos</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="funny" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">😂 Divertidos</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="party" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">🥂 Fiesta y Brindis</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="short" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">⚡ Cortos y Directos</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Hashtag Cards Stream & Printable Sign Mockup -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Printable Table Sign Mockup Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖨️ Vista Previa del Cartel de Mesa
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Diseño listo para enmarcar en formato 13×18 cm o A5 en la barra y fotomatón
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar Cartel en Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimir Cartel / PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Table Sign Mockup Box -->
					<div id="table-sign-mockup" style="border: 2.5px solid var(--fg-pencil); border-radius: 6px; padding: 2rem 1.5rem; background: var(--bg-paper); text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1rem;">
						
						<div style="position: absolute; top: 6px; left: 6px; width: 14px; height: 14px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 6px; right: 6px; width: 14px; height: 14px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; left: 6px; width: 14px; height: 14px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; right: 6px; width: 14px; height: 14px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<p style="font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; color: var(--accent-red); margin: 0 0 0.5rem 0; font-weight: bold;">
							¡AYÚDANOS A GUARDAR CADA RECUERDO!
						</p>

						<h2 style="font-family: var(--font-heading); font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0;">
							Etiqueta tus fotos y vídeos en Instagram:
						</h2>

						<div style="background: #fff; border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem 1rem; margin: 1rem 0; display: inline-block;">
							<strong id="display-selected-hashtag" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); word-break: break-word;">
								#BodaLauraYMarcos2026
							</strong>
						</div>

						<p style="font-family: var(--font-body); font-size: 0.88rem; color: var(--text-secondary); margin: 0.5rem 0 0 0; font-style: italic;">
							¡Para que podamos revivir juntos cada momento de este día inolvidable!
						</p>
					</div>

					<span style="font-size: 0.78rem; color: var(--text-secondary); text-align: center; display: block;">
						💡 Consejo: Haz clic en cualquier tarjeta de abajo para destacarla en el cartel de mesa.
					</span>

				</div>

				<!-- Generated Hashtags Stream Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 480px; overflow-y: auto;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0;">
							🏷️ Lista de Hashtags Generados (<span id="tags-count-badge">50+</span>)
						</h3>
						<span style="font-size: 0.78rem; color: var(--accent-red); font-weight: bold;">
							Clic para Copiar y Ver
						</span>
					</div>

					<div id="hashtags-stream-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem;">
						<!-- Populated via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border: 4px solid #000; padding: 50px 30px; text-align: center; font-family: 'Times New Roman', serif; max-width: 600px; margin: 0 auto;">
				<p style="font-size: 16px; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 15px 0;">¡Ayúdanos a guardar cada recuerdo!</p>
				<h1 style="font-size: 32px; margin: 0 0 25px 0;">Etiqueta tus Fotos y Reels</h1>
				<div style="border: 2px dashed #000; padding: 20px; margin: 25px 0; background: #fafafa;">
					<h2 id="print-hashtag-display" style="font-size: 36px; margin: 0; color: #000;">#BodaLauraYMarcos2026</h2>
				</div>
				<p style="font-size: 16px; font-style: italic; color: #444; margin: 20px 0 0 0;">¡Gracias por celebrar este día tan especial con nosotros!</p>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ Regla de Oro</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Fórmulas de Éxito para un Hashtag de Boda
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>La Regla de Oro:</strong> Los mejores hashtags combinan: <strong>[Nombres / Apellidos] + [Concepto / Año]</strong>. Utiliza siempre <strong>CamelCase</strong> (mayúscula inicial en cada palabra) para que sea instantáneamente legible en cartelería y accesible para lectores de pantalla.
			</p>
			
			<!-- Benchmark Hashtag Formulas Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Estilo de Hashtag</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Estructura</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Ejemplo</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Ideal Para</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">1. Romántico Tradicional</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#JuntosParaSiempre[Apellidos]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: var(--accent-blue);">#BodaGarciaPerez</td>
							<td style="padding: 0.6rem 0.8rem;">Bodas elegantes, clásicas y atemporales</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">2. Juego de Palabras Ingenioso</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#ElSiDe[Nombres]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: var(--accent-red);">#ElGranDiaDeLaurayMarcos</td>
							<td style="padding: 0.6rem 0.8rem;">Parejas alegres que buscan un toque simpático</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">3. Apodo de Pareja</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#[Apodo]SeCasan</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: #16a34a;">#LauyMarcos2026</td>
							<td style="padding: 0.6rem 0.8rem;">Parejas conocidas por un apodo cariñoso conjunto</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">4. Fiesta y Barra Libre</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#Fieston[Apellidos]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: #d97706;">#ElFiestonDeLosPerez</td>
							<td style="padding: 0.6rem 0.8rem;">Ambiente festivo, coctelería y mucho baile</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">5. Destino y Lugar</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#BodaEn[Ciudad]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: #7c3aed;">#GarciaPerezEnMallorca</td>
							<td style="padding: 0.6rem 0.8rem;">Bodas de destino en islas o entornos rurales</td>
						</tr>
						<tr>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">6. Minimalista con Año</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#[Iniciales][Año]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: var(--fg-pencil);">#LyM26</td>
							<td style="padding: 0.6rem 0.8rem;">Carteles pequeños, fotomatón y detalles discretos</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- SEO Article & Comprehensive Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Guía de Redes Sociales y Fotografía</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					Cómo Sacar el Máximo Partido al Hashtag de tu Boda
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					Crea un álbum digital espontáneo con las fotos y vídeos de todos los invitados en un solo lugar.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. Consejos para que los Invitados lo Utilicen
				</h3>
				<div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.5rem;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-red); margin-bottom: 0.4rem;">
							Elige Solo 1 Hashtag Principal
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Tener varios hashtags dispersa las publicaciones. Céntrate en uno solo que sea fácil de recordar y escribir.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-blue); margin-bottom: 0.4rem;">
							Colócalo en Lugares Estratégicos
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							La barra de bebidas, el fotomatón y las mesas del banquete son los puntos donde los invitados más fotos suben a sus historias y reels.
						</p>
					</div>
				</div>
			</section>

			<section>
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Preguntas Frecuentes
				</h3>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						¿Se pueden usar tildes o caracteres especiales en un hashtag?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						En Instagram y TikTok las tildes pueden romper el enlace o crear etiquetas separadas según el teclado del usuario. Es preferible omitir tildes y símbolos para garantizar que todas las fotos se agrupen correctamente (ej. #BodaGarciaPerez en lugar de #BodaGarcíaPérez).
					</p>
				</details>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						¿Cómo imprimo el cartel para la barra?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Selecciona el hashtag deseado y pulsa en <strong>"🖨️ Imprimir Cartel / PDF"</strong>. Puedes imprimirlo en cartulina blanca o papel kraft y colocarlo en un marco de sobremesa de 13×18 cm o A5.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/es/wedding-hashtag-generator" category="stationery" />

	</main>
</Layout>

<style>
	.filter-tab-btn.active-tab {
		background: var(--fg-pencil) !important;
		color: #fff !important;
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 40px;
		}
	}
</style>

<script is:inline>
	let selectedFeaturedTag = '#BodaLauraYMarcos2026';
	let currentVibeFilter = 'all';

	const p1FirstInput = document.getElementById('p1-first');
	const p1LastInput = document.getElementById('p1-last');
	const p2FirstInput = document.getElementById('p2-first');
	const p2LastInput = document.getElementById('p2-last');
	const nicknameInput = document.getElementById('couple-nickname');
	const yearInput = document.getElementById('wedding-year');
	const cityInput = document.getElementById('wedding-city');

	const displaySelectedHashtag = document.getElementById('display-selected-hashtag');
	const printHashtagDisplay = document.getElementById('print-hashtag-display');
	const tagsCountBadge = document.getElementById('tags-count-badge');
	const hashtagsStreamContainer = document.getElementById('hashtags-stream-container');

	function cap(str) {
		if (!str) return '';
		return str.charAt(0).toUpperCase() + str.slice(1);
	}

	function clean(str) {
		return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-zA-Z0-9]/g, '');
	}

	function generateAllTags() {
		const f1 = cap(clean(p1FirstInput.value.trim())) || 'Laura';
		const l1 = cap(clean(p1LastInput.value.trim())) || 'Garcia';
		const f2 = cap(clean(p2FirstInput.value.trim())) || 'Marcos';
		const l2 = cap(clean(p2LastInput.value.trim())) || 'Perez';
		const nick = cap(clean(nicknameInput.value.trim())) || `${f1}Y${f2}`;
		const yr = clean(yearInput.value.trim()) || '2026';
		const y2 = yr.slice(-2);
		const city = cap(clean(cityInput.value.trim())) || 'Espana';

		const allTags = [
			// Románticos
			{ tag: `#Boda${f1}Y${f2}${yr}`, vibe: 'romantic', score: '99%' },
			{ tag: `#JuntosParaSiempre${l2}`, vibe: 'romantic', score: '98%' },
			{ tag: `#${f1}Y${f2}ParaSiempre`, vibe: 'romantic', score: '97%' },
			{ tag: `#ElGranDiaDe${nick}`, vibe: 'romantic', score: '96%' },
			{ tag: `#ElSiQuieroDe${nick}`, vibe: 'romantic', score: '95%' },
			{ tag: `#ParaTodaLaVida${l1}${l2}`, vibe: 'romantic', score: '94%' },
			{ tag: `#ElAmorDe${f1}Y${f2}`, vibe: 'romantic', score: '92%' },
			{ tag: `#Boda${l1}${l2}`, vibe: 'romantic', score: '96%' },
			{ tag: `#HistoriaDeAmor${nick}`, vibe: 'romantic', score: '91%' },
			
			// Divertidos
			{ tag: `#${f1}AtrapoA${f2}`, vibe: 'funny', score: '99%' },
			{ tag: `#PorFinSeCasan${nick}`, vibe: 'funny', score: '98%' },
			{ tag: `#${nick}YaNoHayVueltaAtras`, vibe: 'funny', score: '97%' },
			{ tag: `#${l2}PusoElAnillo`, vibe: 'funny', score: '95%' },
			{ tag: `#MenudoLioDe${nick}`, vibe: 'funny', score: '94%' },
			{ tag: `#DosMenosEnElMercado${yr}`, vibe: 'funny', score: '93%' },
			{ tag: `#OperacionBoda${nick}`, vibe: 'funny', score: '92%' },

			// Fiesta y Brindis
			{ tag: `#ElFiestonDe${nick}`, vibe: 'party', score: '99%' },
			{ tag: `#BrindisPor${f1}Y${f2}`, vibe: 'party', score: '97%' },
			{ tag: `#BarraLibre${l1}${l2}`, vibe: 'party', score: '96%' },
			{ tag: `#HastaQueSalgaElSol${nick}`, vibe: 'party', score: '98%' },
			{ tag: `#QueVivaElAmor${nick}`, vibe: 'party', score: '95%' },
			{ tag: `#VivanLosNovios${yr}`, vibe: 'party', score: '96%' },
			{ tag: `#NocheDeBoda${nick}`, vibe: 'party', score: '94%' },

			// Cortos y Directos
			{ tag: `#${f1}Y${f2}${yr}`, vibe: 'short', score: '98%' },
			{ tag: `#${f1}Y${f2}${y2}`, vibe: 'short', score: '95%' },
			{ tag: `#${nick}${yr}`, vibe: 'short', score: '97%' },
			{ tag: `#Boda${l2}${yr}`, vibe: 'short', score: '96%' },
			{ tag: `#${f1[0]}Y${f2[0]}${y2}`, vibe: 'short', score: '94%' },

			// Destino
			{ tag: `#Boda${nick}En${city}`, vibe: 'romantic', score: '97%' },
			{ tag: `#${l1}${l2}En${city}`, vibe: 'party', score: '95%' }
		];

		return allTags;
	}

	function renderTags() {
		const allTags = generateAllTags();
		
		const filtered = currentVibeFilter === 'all' 
			? allTags 
			: allTags.filter(t => t.vibe === currentVibeFilter);

		tagsCountBadge.textContent = `${filtered.length} Tags`;

		hashtagsStreamContainer.innerHTML = '';
		filtered.forEach(item => {
			const card = document.createElement('div');
			card.className = 'hand-card';
			card.style.cssText = `padding: 0.75rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.15s ease;`;
			
			const isFeatured = item.tag === selectedFeaturedTag;
			if (isFeatured) {
				card.style.borderColor = 'var(--accent-blue)';
				card.style.background = '#eff6ff';
			}

			const igSearchUrl = `https://www.instagram.com/explore/tags/${item.tag.replace('#', '')}/`;

			card.innerHTML = `
				<div style="margin-bottom: 0.5rem;">
					<strong class="font-heading tag-title" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; word-break: break-word;">${item.tag}</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">Estilo: ${item.vibe}</span>
				</div>
				<div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed #ddd; padding-top: 0.4rem; gap: 0.3rem;">
					<button type="button" class="btn-copy-tag hand-btn" data-tag="${item.tag}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #f0fdf4;">
						📋 Copiar
					</button>
					<a href="${igSearchUrl}" target="_blank" rel="noopener noreferrer nofollow" class="hand-btn secondary" style="padding: 0.2rem 0.45rem; font-size: 0.72rem; text-decoration: none;">
						🔍 IG
					</a>
				</div>
			`;

			card.addEventListener('click', (e) => {
				if (e.target.tagName === 'BUTTON' || e.target.tagName === 'A') return;
				selectedFeaturedTag = item.tag;
				displaySelectedHashtag.textContent = selectedFeaturedTag;
				printHashtagDisplay.textContent = selectedFeaturedTag;
				renderTags();
			});

			hashtagsStreamContainer.appendChild(card);
		});

		document.querySelectorAll('.btn-copy-tag').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const tag = btn.getAttribute('data-tag');
				navigator.clipboard.writeText(tag).then(() => {
					const oldText = btn.textContent;
					btn.textContent = '¡Copiado! ✅';
					btn.style.background = '#dcfce7';
					setTimeout(() => {
						btn.textContent = oldText;
						btn.style.background = '#f0fdf4';
					}, 1500);
				});
			});
		});
	}

	document.querySelectorAll('.filter-tab-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.filter-tab-btn').forEach(b => {
				b.classList.remove('active-tab');
				b.classList.add('secondary');
			});
			btn.classList.add('active-tab');
			btn.classList.remove('secondary');
			currentVibeFilter = btn.getAttribute('data-vibe');
			renderTags();
		});
	});

	[p1FirstInput, p1LastInput, p2FirstInput, p2LastInput, nicknameInput, yearInput, cityInput].forEach(el => {
		el.addEventListener('input', () => {
			const all = generateAllTags();
			selectedFeaturedTag = all[0].tag;
			displaySelectedHashtag.textContent = selectedFeaturedTag;
			printHashtagDisplay.textContent = selectedFeaturedTag;
			renderTags();
		});
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const allTags = generateAllTags();
		let tagsHtml = '';
		allTags.forEach(t => {
			tagsHtml += `<li style="font-size:14px; font-weight:bold; color:#1e3a8a; margin-bottom:4px;">${t.tag} <span style="font-size:11px; color:#666; font-weight:normal;">(${t.vibe})</span></li>`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Cartel y Hashtags de Boda</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					.sign-box { border: 2px solid #333; background: #fafafa; padding: 25px; text-align: center; margin-bottom: 25px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Cartel y Hashtags de Boda</h1>
				<p>Generado el: ${new Date().toLocaleDateString('es-ES')} | Hashtag Principal: <strong>${selectedFeaturedTag}</strong></p>
				
				<div class="sign-box">
					<p style="text-transform:uppercase; letter-spacing:2px; font-size:12px; margin:0 0 10px 0;">¡Ayúdanos a guardar cada recuerdo!</p>
					<h2 style="font-size:24px; margin:0 0 15px 0;">Etiqueta tus Fotos y Reels en Instagram</h2>
					<h1 style="font-size:32px; color:#1e3a8a; margin:10px 0;">${selectedFeaturedTag}</h1>
					<p style="font-style:italic; font-size:13px; margin:15px 0 0 0;">¡Gracias por celebrar este día tan especial con nosotros!</p>
				</div>

				<h3>Más Ideas de Hashtags:</h3>
				<ul>${tagsHtml}</ul>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hashtag_Boda_${clean(selectedFeaturedTag)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		printHashtagDisplay.textContent = selectedFeaturedTag;
		window.print();
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const allTags = generateAllTags();
		let csv = "Hashtag,Estilo,Puntuacion\n";
		allTags.forEach(t => {
			csv += `"${t.tag}","${t.vibe}","${t.score}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Hashtags_Boda.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	renderTags();
</script>
