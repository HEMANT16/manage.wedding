---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calculadora de Barra de Café y Estación de Espresso para Bodas",
      "url": "https://manage.wedding/es/wedding-coffee-bar-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calcula los kilos de café en grano, proporción de descafeinado, litros de leche entera y vegetal (avena), siropes, vasos y costes de barista.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calculadora de Barra de Café para Bodas — Café, Leche y Espresso"
	description="Calcula cuánto café en grano comprar para la boda, desglose de café normal y descafeinado, litros de leche de avena/entera, vasos y termos."
	lang="es"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Miga de pan" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/es/" style="color: var(--text-secondary); text-decoration: none;">Inicio</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/es/dining" style="color: var(--text-secondary); text-decoration: none;">Banquete y Bebidas</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Barra de Café</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>☕</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Café en Grano, Leches Especiales & Coffee Bar DIY</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calculadora de Barra de Café para Bodas
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Calcula los <strong>kilos de café en grano, proporción de descafeinado</strong>, litros de leche entera y vegetal (avena), siropes, vasos y compara <strong>autoservicio DIY vs Carrito de Barista</strong>.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Inputs -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>👥</span> 1. Invitados y Formato de Café
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-coffee-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Total Invitados Boda:</label>
						<input type="number" id="input-coffee-guests" min="20" max="500" value="130" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="select-coffee-setup" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Estación de Café:</label>
						<select id="select-coffee-setup" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="diy-urn" selected>🫖 Termos Autoservicio / Cafeteras Percoladoras</option>
							<option value="espresso-cart">☕ Carrito Espresso con Barista Profesional</option>
							<option value="drip-caterer">🍽️ Servicio de Café Incluido del Catering</option>
							<option value="iced-bar">🧊 Barra de Cold Brew y Café Helado</option>
						</select>
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🕒 2. Momento del Día y Temporada
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label for="select-coffee-timing" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Momento del Servicio:</label>
						<select id="select-coffee-timing" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="evening" selected>Tarde-Noche con Tarta (70% Normal / 30% Descafeinado)</option>
							<option value="late-night">Recena / Fiesta Nocturna (85% Normal)</option>
							<option value="brunch">Boda de Mañana / Brunch (90% Normal)</option>
						</select>
					</div>
					<div>
						<label for="select-coffee-season" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Temporada / Clima:</label>
						<select id="select-coffee-season" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="fall-winter" selected>🍂 Otoño / Invierno (Alta demanda: 75% toma café)</option>
							<option value="spring-summer">☀️ Primavera / Verano (Demanda moderada: 55%)</option>
						</select>
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🍯 3. Siropes Gourmet y Vasos
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="select-syrup-tier" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Variedad de Siropes:</label>
						<select id="select-syrup-tier" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="standard" selected>Trío Clásico (Vainilla, Caramelo, Avellana)</option>
							<option value="deluxe">Pack Deluxe 5 Sabores (Moka, Chai, Canela)</option>
							<option value="none">Sencillo (Solo azúcar y leche)</option>
						</select>
					</div>
					<div>
						<label for="select-cup-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Tipo de Vasos:</label>
						<select id="select-cup-type" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="insulated" selected>Vasos Térmicos Personalizados con Tapa</option>
							<option value="ceramic">Tazas de Porcelana Alquiladas</option>
							<option value="clear-iced">Vasos Transparentes para Frío con Pajita</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Previsión de Café y Leche</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Materiales y Café
						</h2>
					</div>
					<span id="badge-total-cups" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">135 Tazas</span>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Café en Grano</span>
						<strong id="stat-coffee-lbs" style="font-size: 1.8rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">2,1 kg</strong>
						<span id="stat-coffee-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(1,5 kg Normal / 0,6 kg Descafeinado)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Coste Estimado</span>
						<strong id="stat-total-cost" style="font-size: 1.8rem; font-weight: 900; color: #1e40af; line-height: 1.1;">140 € DIY</strong>
						<span id="stat-cost-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(Ahorra 650 € vs Carrito Barista)</span>
					</div>
				</div>

				<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #166534; display: block; margin-bottom: 0.35rem;">🥛 Leches y Endulzantes:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #14532d;">
						<div>• <strong id="stat-whole-milk">8 Litros</strong> Leche Entera / Sin Lactosa</div>
						<div>• <strong id="stat-oat-milk">6 Litros</strong> Bebida de Avena Barista</div>
						<div>• <strong id="stat-sugar-lbs">1,5 kg</strong> Azúcar Moreno y Sacarina</div>
						<div>• <strong id="stat-syrup-bottles">3 Botellas (750ml)</strong> Siropes</div>
					</div>
				</div>

				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🫖 Termos / Cafeteras:</span>
						<strong id="stat-urn-req" style="color: var(--fg-pencil);">2 Termos Dispensadores de 8L</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🥤 Vasos y Tapas:</span>
						<strong id="stat-cups-count" style="color: var(--fg-pencil);">155 Sets (+15% margen)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">🥢 Removedores y Servilletas:</span>
						<strong id="stat-stirrers-count" style="color: #15803d;">200 Removedores de madera y servilletas</strong>
					</div>
				</div>

				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Imprimir Lista de Compra (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Exportar Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/es/wedding-coffee-bar-calculator" category="dining" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-coffee-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Lista de Compra para Barra de Café de Boda</h1>
				<p id="print-coffee-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Café en Grano, Leches, Siropes y Termos | Manage.Wedding</p>
			</div>
			<div id="print-coffee-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const inputCoffeeGuests = document.getElementById('input-coffee-guests');
	const selectCoffeeSetup = document.getElementById('select-coffee-setup');
	const selectCoffeeTiming = document.getElementById('select-coffee-timing');
	const selectCoffeeSeason = document.getElementById('select-coffee-season');
	const selectSyrupTier = document.getElementById('select-syrup-tier');
	const selectCupType = document.getElementById('select-cup-type');

	const badgeTotalCups = document.getElementById('badge-total-cups');
	const statCoffeeLbs = document.getElementById('stat-coffee-lbs');
	const statCoffeeSub = document.getElementById('stat-coffee-sub');
	const statTotalCost = document.getElementById('stat-total-cost');
	const statCostSub = document.getElementById('stat-cost-sub');

	const statWholeMilk = document.getElementById('stat-whole-milk');
	const statOatMilk = document.getElementById('stat-oat-milk');
	const statSugarLbs = document.getElementById('stat-sugar-lbs');
	const statSyrupBottles = document.getElementById('stat-syrup-bottles');

	const statUrnReq = document.getElementById('stat-urn-req');
	const statCupsCount = document.getElementById('stat-cups-count');
	const statStirrersCount = document.getElementById('stat-stirrers-count');

	function calculateCoffee() {
		const guests = Math.max(10, parseInt(inputCoffeeGuests.value, 10) || 130);
		const setup = selectCoffeeSetup.value;
		const timing = selectCoffeeTiming.value;
		const season = selectCoffeeSeason.value;

		let drinkRate = 0.70;
		if (season === 'spring-summer') drinkRate = 0.55;
		if (timing === 'brunch') drinkRate = 0.85;

		const coffeeDrinkers = Math.round(guests * drinkRate);
		const avgCupsPerPerson = timing === 'brunch' ? 1.7 : 1.4;
		const totalCups = Math.round(coffeeDrinkers * avgCupsPerPerson);

		badgeTotalCups.textContent = `${totalCups} Tazas de Café`;

		let regRatio = 0.70;
		let decafRatio = 0.30;
		if (timing === 'late-night') {
			regRatio = 0.85;
			decafRatio = 0.15;
		} else if (timing === 'brunch') {
			regRatio = 0.90;
			decafRatio = 0.10;
		}

		// 1 kg café = ~70 tazas
		const totalKg = (totalCups / 65).toFixed(1);
		const regKg = (totalKg * regRatio).toFixed(1);
		const decafKg = (totalKg * decafRatio).toFixed(1);

		statCoffeeLbs.textContent = `${totalKg} kg Café`;
		statCoffeeSub.textContent = `(${regKg} kg Normal / ${decafKg} kg Descafeinado)`;

		const totalLitersMilk = Math.round(totalCups * 0.09);
		const wholeMilkLit = Math.round(totalLitersMilk * 0.60);
		const oatMilkLit = Math.round(totalLitersMilk * 0.40);

		statWholeMilk.textContent = `${Math.max(4, wholeMilkLit)} Litros Leche Entera/Desnatada`;
		statOatMilk.textContent = `${Math.max(3, oatMilkLit)} Litros Bebida de Avena Barista`;

		const sugarWeight = Math.max(1, (totalCups * 0.012).toFixed(1));
		statSugarLbs.textContent = `${sugarWeight} kg Azúcar y Edulcorantes`;

		const syrupTier = selectSyrupTier.value;
		let syrupText = '3 Botellas (750ml)';
		if (syrupTier === 'deluxe') syrupText = '5 Botellas (750ml) Deluxe';
		else if (syrupTier === 'none') syrupText = '0 (Solo leche y azúcar)';
		statSyrupBottles.textContent = syrupText;

		const cupsTotal = Math.ceil(totalCups * 1.15);
		statCupsCount.textContent = `${cupsTotal} Sets (${selectCupType.options[selectCupType.selectedIndex].text})`;
		statStirrersCount.textContent = `${cupsTotal + 50} Removedores de madera y servilletas`;

		if (setup === 'espresso-cart') {
			statUrnReq.textContent = 'Cafetera Espresso Doble Grupo Profesional';
		} else if (totalCups <= 80) {
			statUrnReq.textContent = '2 Termos de 5L (1 Normal / 1 Descafeinado)';
		} else {
			statUrnReq.textContent = '2 Termos Dispensadores de 8L';
		}

		let cost = 140;

		if (setup === 'diy-urn') {
			cost = Math.round((totalKg * 22) + (wholeMilkLit * 1.2) + (oatMilkLit * 2.2) + 35 + 25);
			statTotalCost.textContent = `${cost} € DIY`;
			const savings = Math.max(300, 800 - cost);
			statCostSub.textContent = `(Ahorra ~${savings} € vs Carrito Barista)`;
		} else if (setup === 'espresso-cart') {
			cost = 750 + (guests > 150 ? 150 : 0);
			statTotalCost.textContent = `${cost} € Carrito`;
			statCostSub.textContent = 'Incluye Barista y Latte Art';
		} else if (setup === 'drip-caterer') {
			cost = Math.round(guests * 2.80);
			statTotalCost.textContent = `${cost} € Catering`;
			statCostSub.textContent = 'Servicio con el postre';
		} else {
			cost = Math.round(110 + (totalCups * 0.70));
			statTotalCost.textContent = `${cost} € Cold Brew`;
			statCostSub.textContent = 'Barril frío y crema dulce';
		}

		document.getElementById('print-coffee-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Ingrediente / Material</th>
						<th style="padding:6pt;">Detalles</th>
						<th style="padding:6pt; text-align:right;">Cantidad Necesaria</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Café en Grano Especialidad</td>
						<td style="padding:6pt;">${regKg} kg Normal + ${decafKg} kg Descafeinado</td>
						<td style="padding:6pt; text-align:right; font-weight:bold; color:#b91c1c;">${totalKg} kg Café</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Leches y Bebidas Vegetales</td>
						<td style="padding:6pt;">60% Leche entera, 40% Bebida de avena especial barista</td>
						<td style="padding:6pt; text-align:right;">${statWholeMilk.textContent} + ${statOatMilk.textContent}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Siropes y Azúcares</td>
						<td style="padding:6pt;">${syrupText}, sobres de azúcar moreno y sacarina</td>
						<td style="padding:6pt; text-align:right;">${statSugarLbs.textContent}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Menaje y Vasos</td>
						<td style="padding:6pt;">${statUrnReq.textContent}</td>
						<td style="padding:6pt; text-align:right;"><strong>${statCupsCount.textContent}</strong></td>
					</tr>
					<tr style="background:#eff6ff; font-weight:bold; font-size:11pt; border-top:2pt solid #000;">
						<td style="padding:8pt;">PRESUPUESTO TOTAL ESTIMADO</td>
						<td style="padding:8pt;">${selectCoffeeSetup.options[selectCoffeeSetup.selectedIndex].text}</td>
						<td style="padding:8pt; text-align:right; color:#1e40af;">${statTotalCost.textContent}</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	[inputCoffeeGuests, selectCoffeeSetup, selectCoffeeTiming, selectCoffeeSeason, selectSyrupTier, selectCupType].forEach(el => {
		el.addEventListener('input', calculateCoffee);
		el.addEventListener('change', calculateCoffee);
	});

	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateCoffee();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateCoffee();
		const coffee = statCoffeeLbs.textContent;
		const cost = statTotalCost.textContent;
		const cups = badgeTotalCups.textContent;
		const guests = inputCoffeeGuests.value;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Materiales Barra de Café</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Lista de Compra para Barra de Café de Boda</h1>
				<p><strong>Invitados:</strong> ${guests} | <strong>Tazas:</strong> ${cups} | <strong>Café en Grano:</strong> ${coffee} | <strong>Coste:</strong> ${cost}</p>
				<hr/>
				<p><em>Generado por Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Barra-Cafe-Boda-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateCoffee();
</script>
