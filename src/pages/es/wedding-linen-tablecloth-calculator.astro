---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calculadora de Mantelería y Medidas de Manteles para Boda",
      "url": "https://manage.wedding/es/wedding-linen-tablecloth-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calcula el tamaño exacto de manteles para mesas redondas, rectangulares y altas de cóctel para conseguir una caída perfecta hasta el suelo.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calculadora de Medidas de Manteles y Mantelería para Boda"
	description="Calcula las medidas exactas de manteles para mesas redondas, rectangulares y altas de cóctel, caída hasta el suelo, servilletas y costes de alquiler."
	lang="es"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Miga de pan" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/es/" style="color: var(--text-secondary); text-decoration: none;">Inicio</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/es/dining" style="color: var(--text-secondary); text-decoration: none;">Banquete y Decoración</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Calculadora de Mantelería</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🧺</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Medidas de Mesas & Inventario de Alquiler de Mantelería</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calculadora de Medidas de Manteles para Boda
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Calcula las <strong>medidas exactas de manteles</strong> para cada tipo de mesa, asegura una caída elegante hasta el suelo sin arrastrar, calcula servilletas y compara <strong>alquiler frente a compra</strong>.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Inputs -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>📐</span> 1. Mesas de Invitados
				</h2>

				<div style="margin-bottom: 1rem;">
					<label for="select-table-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Forma y Medida de Mesa:</label>
					<select id="select-table-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="round-60" selected>⚪ Redonda 150 cm / 60" (8 comensales — Altura estándar 75 cm)</option>
						<option value="round-72">⚪ Redonda 180 cm / 72" (10-12 comensales — Altura 75 cm)</option>
						<option value="round-48">⚪ Redonda 120 cm / 48" (6 comensales / Tarta)</option>
						<option value="rect-8ft">📏 Rectangular 240 x 75 cm / 8 ft Banquete</option>
						<option value="rect-6ft">📏 Rectangular 180 x 75 cm / 6 ft Banquete</option>
						<option value="highboy-30">🍸 Mesa Alta de Cóctel 80 cm (110 cm altura)</option>
					</select>
				</div>

				<div style="margin-bottom: 1rem;">
					<label for="select-drop-style" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Tipo de Caída del Mantel:</label>
					<select id="select-drop-style" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="floor" selected>✨ Caída Completa al Suelo (Elegancia formal 75 cm caída)</option>
						<option value="lap">🪑 Caída Media / Informal (35-40 cm caída)</option>
						<option value="puddle">👑 Caída Arrastrada / Puddle (+8 cm en suelo)</option>
					</select>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-table-count" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Número de Mesas Invitados:</label>
						<input type="number" id="input-table-count" min="1" max="100" value="15" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="input-guests-count" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Total Invitados (Servilletas):</label>
						<input type="number" id="input-guests-count" min="10" max="600" value="120" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🏷️ 2. Mesas Especiales y Auxiliares
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
					<div>
						<label for="input-head-tables" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Mesa Presidencial:</label>
						<input type="number" id="input-head-tables" min="0" max="10" value="2" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="input-cocktail-tables" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Mesas Altas Cóctel:</label>
						<input type="number" id="input-cocktail-tables" min="0" max="25" value="6" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="input-service-tables" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Tarta / Libro / DJ / Regalos:</label>
						<input type="number" id="input-service-tables" min="0" max="15" value="4" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="select-pricing-mode" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Comparar Costes:</label>
						<select id="select-pricing-mode" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="both" selected>Alquilar vs Comprar</option>
							<option value="rent">Sólo Alquiler (16 €/mantel)</option>
							<option value="buy">Sólo Compra (10 €/mantel)</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Medida Exacta Recomendada</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Medida de Mantel
						</h2>
					</div>
					<span id="badge-drop-tag" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">Caída hasta el Suelo</span>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Mantel Mesas Invitados</span>
						<strong id="stat-linen-dimension" style="font-size: 1.7rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">300 cm Redondo</strong>
						<span id="stat-linen-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(Caída exacta 75 cm suelo)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Total Manteles</span>
						<strong id="stat-total-linens" style="font-size: 1.7rem; font-weight: 900; color: #1e40af; line-height: 1.1;">27 Manteles</strong>
						<span id="stat-tables-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">Para todas las mesas</span>
					</div>
				</div>

				<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #166534; display: block; margin-bottom: 0.35rem;">✨ Servilletas y Caminos de Mesa:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #14532d;">
						<div>• <strong id="stat-napkins-count">138 Servilletas</strong> (+15% margen)</div>
						<div>• <strong id="stat-runner-length">Caminos 270 cm</strong> (30 cm caída)</div>
						<div>• <strong id="stat-highboy-linens">6 x 300 cm</strong> Mesas Cóctel</div>
						<div>• <strong id="stat-banquet-linens">6 x 230x390 cm</strong> Rectangulares</div>
					</div>
				</div>

				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🏷️ Coste Alquiler:</span>
						<strong id="stat-rent-cost" style="color: #b91c1c;">486 € (Lavado y Planchado)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🛒 Coste Compra:</span>
						<strong id="stat-buy-cost" style="color: #1e40af;">297 € (Mayorista)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">💡 Conclusión:</span>
						<strong id="stat-verdict" style="color: #15803d;">Comprar ahorra 189 € (Requiere plancha)</strong>
					</div>
				</div>

				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Imprimir Pedido (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Exportar Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/es/wedding-linen-tablecloth-calculator" category="dining" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-linen-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Ficha de Pedido de Mantelería para Boda</h1>
				<p id="print-linen-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Especificación de Alquiler de Manteles | Manage.Wedding</p>
			</div>
			<div id="print-linen-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const selectTableType = document.getElementById('select-table-type');
	const selectDropStyle = document.getElementById('select-drop-style');
	const inputTableCount = document.getElementById('input-table-count');
	const inputGuestsCount = document.getElementById('input-guests-count');
	const inputHeadTables = document.getElementById('input-head-tables');
	const inputCocktailTables = document.getElementById('input-cocktail-tables');
	const inputServiceTables = document.getElementById('input-service-tables');

	const statLinenDimension = document.getElementById('stat-linen-dimension');
	const statLinenSub = document.getElementById('stat-linen-sub');
	const statTotalLinens = document.getElementById('stat-total-linens');
	const badgeDropTag = document.getElementById('badge-drop-tag');

	const statNapkinsCount = document.getElementById('stat-napkins-count');
	const statRunnerLength = document.getElementById('stat-runner-length');
	const statHighboyLinens = document.getElementById('stat-highboy-linens');
	const statBanquetLinens = document.getElementById('stat-banquet-linens');

	const statRentCost = document.getElementById('stat-rent-cost');
	const statBuyCost = document.getElementById('stat-buy-cost');
	const statVerdict = document.getElementById('stat-verdict');

	function calculateLinens() {
		const tableType = selectTableType.value;
		const dropStyle = selectDropStyle.value;
		const guestTables = parseInt(inputTableCount.value, 10) || 15;
		const guests = parseInt(inputGuestsCount.value, 10) || 120;
		const headTables = parseInt(inputHeadTables.value, 10) || 2;
		const cocktailTables = parseInt(inputCocktailTables.value, 10) || 6;
		const serviceTables = parseInt(inputServiceTables.value, 10) || 4;

		let dimension = '300 cm Redondo (120")';
		let subText = 'Caída 75 cm hasta el suelo';
		let runnerLen = 'Caminos 270 cm';

		if (tableType === 'round-60') {
			if (dropStyle === 'floor') { dimension = '300 cm Redondo (120")'; subText = 'Caída exacta 75 cm suelo'; }
			else if (dropStyle === 'lap') { dimension = '230 cm Redondo (90")'; subText = 'Caída media 40 cm'; }
			else { dimension = '335 cm Redondo (132")'; subText = 'Efecto arrastrado en suelo'; }
			runnerLen = 'Caminos 270 cm';
		} else if (tableType === 'round-72') {
			if (dropStyle === 'floor') { dimension = '335 cm Redondo (132")'; subText = 'Caída exacta 75 cm suelo'; }
			else if (dropStyle === 'lap') { dimension = '275 cm Redondo (108")'; subText = 'Caída 45 cm'; }
			else { dimension = '365 cm Redondo'; subText = 'Efecto arrastrado'; }
			runnerLen = 'Caminos 300 cm';
		} else if (tableType === 'round-48') {
			if (dropStyle === 'floor') { dimension = '275 cm Redondo (108")'; subText = 'Caída exacta 75 cm suelo'; }
			else if (dropStyle === 'lap') { dimension = '230 cm Redondo (90")'; subText = 'Caída media'; }
			else { dimension = '300 cm Redondo'; subText = 'Efecto arrastrado'; }
			runnerLen = 'Caminos 230 cm';
		} else if (tableType === 'rect-8ft') {
			if (dropStyle === 'floor') { dimension = '230 x 390 cm (90x156")'; subText = 'Caída suelo 4 lados'; }
			else if (dropStyle === 'lap') { dimension = '150 x 320 cm'; subText = 'Caída lateral 38 cm'; }
			else { dimension = '275 x 390 cm'; subText = 'Caída profunda'; }
			runnerLen = 'Caminos 300 cm';
		} else if (tableType === 'rect-6ft') {
			if (dropStyle === 'floor') { dimension = '230 x 335 cm (90x132")'; subText = 'Caída suelo 4 lados'; }
			else if (dropStyle === 'lap') { dimension = '150 x 260 cm'; subText = 'Caída lateral'; }
			else { dimension = '230 x 390 cm'; subText = 'Caída arrastrada'; }
			runnerLen = 'Caminos 240 cm';
		} else if (tableType === 'highboy-30') {
			if (dropStyle === 'floor') { dimension = '300 cm Redondo (120")'; subText = 'Caída limpia 110 cm'; }
			else { dimension = '335 cm Redondo'; subText = 'Con lazo/cinta central'; }
			runnerLen = 'Sin camino (usar lazo)';
		}

		statLinenDimension.textContent = dimension;
		statLinenSub.textContent = `(${subText})`;

		const totalLinens = guestTables + headTables + cocktailTables + serviceTables;
		statTotalLinens.textContent = `${totalLinens} Manteles`;

		const totalNapkins = Math.round(guests * 1.15);
		statNapkinsCount.textContent = `${totalNapkins} Servilletas`;
		statRunnerLength.textContent = runnerLen;
		statHighboyLinens.textContent = `${cocktailTables} x 300 cm Cóctel`;
		statBanquetLinens.textContent = `${headTables + serviceTables} x 230x390 cm Banquete`;

		const avgRentRate = 18;
		const avgBuyRate = 11;
		const totalRent = totalLinens * avgRentRate + totalNapkins * 0.75;
		const totalBuy = totalLinens * avgBuyRate + totalNapkins * 0.45;
		const diff = totalRent - totalBuy;

		statRentCost.textContent = `${Math.round(totalRent)} € (Lavado y Planchado)`;
		statBuyCost.textContent = `${Math.round(totalBuy)} € (Mayorista)`;
		statVerdict.textContent = `Comprar ahorra ${Math.round(diff)} € (Requiere plancha)`;

		document.getElementById('print-linen-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Tipo de Mesa</th>
						<th style="padding:6pt;">Dimensiones Mesa</th>
						<th style="padding:6pt;">Medida de Mantel</th>
						<th style="padding:6pt; text-align:right;">Cantidad</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Mesas de Invitados</td>
						<td style="padding:6pt;">${selectTableType.options[selectTableType.selectedIndex].text}</td>
						<td style="padding:6pt; font-weight:bold; color:#b91c1c;">${dimension}</td>
						<td style="padding:6pt; text-align:right;"><strong>${guestTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Mesa Presidencial</td>
						<td style="padding:6pt;">Rectangular 240 x 75 cm</td>
						<td style="padding:6pt;">230 x 390 cm Rectangular</td>
						<td style="padding:6pt; text-align:right;"><strong>${headTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Mesas Altas Cóctel</td>
						<td style="padding:6pt;">80 cm Diám. x 110 cm Altura</td>
						<td style="padding:6pt;">300 cm Redondo (con lazo)</td>
						<td style="padding:6pt; text-align:right;"><strong>${cocktailTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Mesas Auxiliares (Tarta/DJ)</td>
						<td style="padding:6pt;">Banquete 180 / 240 cm</td>
						<td style="padding:6pt;">230 x 335 / 230 x 390 cm</td>
						<td style="padding:6pt; text-align:right;"><strong>${serviceTables}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Servilletas de Tela</td>
						<td style="padding:6pt;">50 x 50 cm Algodón/Poliéster</td>
						<td style="padding:6pt;">Doblado / Nudo clásico</td>
						<td style="padding:6pt; text-align:right; font-weight:bold; color:#166534;"><strong>${totalNapkins}</strong></td>
					</tr>
					<tr style="background:#eff6ff; font-weight:bold; font-size:11pt; border-top:2pt solid #000;">
						<td style="padding:8pt;">TOTAL MANTELES</td>
						<td style="padding:8pt;">Todas las mesas</td>
						<td style="padding:8pt;">Caída hasta el suelo</td>
						<td style="padding:8pt; text-align:right; color:#b91c1c;">${totalLinens} Manteles</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	[selectTableType, selectDropStyle, inputTableCount, inputGuestsCount, inputHeadTables, inputCocktailTables, inputServiceTables].forEach(el => {
		el.addEventListener('input', calculateLinens);
		el.addEventListener('change', calculateLinens);
	});

	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateLinens();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateLinens();
		const dimension = statLinenDimension.textContent;
		const totalLinens = statTotalLinens.textContent;
		const napkins = statNapkinsCount.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Mantelería de Boda</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Pedido de Mantelería para Boda</h1>
				<p><strong>Mantel Invitados:</strong> ${dimension} | <strong>Total Manteles:</strong> ${totalLinens} | <strong>Servilletas:</strong> ${napkins}</p>
				<hr/>
				<p><em>Generado por Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Manteleria-Boda-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateLinens();
</script>
