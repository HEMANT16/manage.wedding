---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/cake-serving-calculator/#webapp",
      "name": "Calculadora de Raciones y Pisos de Tarta Nupcial",
      "url": "https://manage.wedding/es/cake-serving-calculator",
      "inLanguage": "es",
      "description": "Calcula el número exacto de raciones, diámetro de pisos, tartas redondas vs cuadradas y tartas de apoyo en plancha para bodas. Incluye simulador visual 2D y guía de corte.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular las Raciones y Medidas de una Tarta de Boda",
      "description": "Guía paso a paso para elegir el número de pisos, dimensiones de corte y raciones de tarta nupcial.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Elige la Forma de la Tarta",
          "text": "Selecciona pisos redondos clásicos o pisos cuadrados (que rinden un 25% más de porciones por piso)."
        },
        {
          "@type": "HowToStep",
          "name": "Define el Tamaño de la Ración",
          "text": "Elige porciones estándar de boda (2,5 × 5 cm para banquetes de varios platos) o raciones de fiesta más generosas (5 × 5 cm)."
        },
        {
          "@type": "HowToStep",
          "name": "Configura los Pisos o Introduce Invitados",
          "text": "Explora combinaciones populares de 2, 3 o 4 pisos (ej. 15/23/30 cm para 100 invitados) o deja que la herramienta ajuste la escala exacta."
        },
        {
          "@type": "HowToStep",
          "name": "Añade una Tarta de Apoyo en Cocina",
          "text": "Combina una tarta decorada pequeña de 2 pisos para el corte y fotos con una plancha de repostería en cocina para ahorrar hasta un 50%."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué tamaño de tarta de boda se necesita para 100 invitados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para 100 comensales, la opción clásica es una tarta redonda de 3 pisos de 15 cm (6\"), 23 cm (9\") y 30 cm (12\") de diámetro, que rinde exactamente 100 raciones estándar de boda (2,5 x 5 cm)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué diferencia hay entre una porción de boda y una de fiesta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La ración de boda (2,5 x 5 x 10 cm de alto) está pensada para servirse como broche final tras un banquete completo de 3 platos. La porción de fiesta o cumpleaños (5 x 5 x 10 cm) tiene el doble de volumen."
          }
        },
        {
          "@type": "Question",
          "name": "¿Se debe contabilizar el piso superior en las raciones de los invitados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si los novios desean mantener la tradición de congelar el piso superior (de 15 cm) para su primer aniversario de boda, deben restarse unas 12 raciones del total de la tarta para no dejar a comensales sin postre."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué es el truco de la 'tarta de cocina' o plancha auxiliar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Consiste en encargar una tarta pequeña y elegante de 2 pisos para el momento de cortar la tarta y las fotos, y encargar al mismo pastelero una plancha auxiliar sin decoración para servir a la mayoría de invitados desde la cocina a mitad de precio."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Raciones y Pisos de Tarta Nupcial | Manage.Wedding"
	description="Calcula raciones, número de pisos y medidas para tu tarta de boda. Compara tartas redondas, cuadradas y planchas auxiliares con simulador visual 2D."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Raciones de Tarta Nupcial" category="food-dining" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2.5rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 3rem 1.5rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Raciones y Pisos de <span class="accent-italic">Tarta Nupcial</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Calcula el tamaño exacto de tarta para tu boda. Selecciona forma de pisos, tamaño de porción y visualiza el montaje en tiempo real.
				</p>
			</div>
		</section>

		<!-- Interactive Calculator & Visual Studio Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; margin-bottom: 3.5rem;" class="calc-container-grid">
			
			<!-- Left Column: Controls & Inputs -->
			<div class="hand-card" style="padding: 2rem;">
				<h2 class="font-heading" style="font-size: 1.8rem; margin-bottom: 1.5rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>🎂</span> Especificaciones de la Tarta
				</h2>

				<form id="cake-calc-form">
					
					<!-- Calculation Mode -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Estilo de Tarta / Modo:
						</label>
						<div class="mode-select-grid">
							<label class="mode-tab active" id="tab-tiered">
								<input type="radio" name="cakeMode" value="tiered" checked style="display: none;"> Tarta de Pisos
							</label>
							<label class="mode-tab" id="tab-sheet">
								<input type="radio" name="cakeMode" value="sheet" style="display: none;"> Plancha / Bandeja
							</label>
							<label class="mode-tab" id="tab-combo">
								<input type="radio" name="cakeMode" value="combo" style="display: none;"> Pisos + Plancha
							</label>
						</div>
					</div>

					<!-- Guest Count -->
					<div style="margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label class="font-heading" for="guest-count" style="font-size: 1.15rem; color: var(--fg-pencil);">
								Número de Invitados:
							</label>
							<span id="guest-badge" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.9rem;">100 Invitados</span>
						</div>
						<input type="range" id="guest-slider" min="10" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="guest-count" class="form-input" min="1" max="1000" value="100" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem;">
						</div>
					</div>

					<!-- Cake Shape -->
					<div id="shape-group" style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Forma de los Pisos:
						</label>
						<select id="cake-shape" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem; background: #fff;">
							<option value="round">Redonda (Clásica y Elegante)</option>
							<option value="square">Cuadrada (~25% más raciones por piso)</option>
							<option value="heart">Forma de Corazón (Romántica y Tendencia)</option>
						</select>
					</div>

					<!-- Slice / Portion Size -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Tamaño de la Ración:
						</label>
						<select id="portion-size" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem; background: #fff;">
							<option value="wedding">Ración de Boda (2,5 × 5 cm — Estándar post-banquete)</option>
							<option value="party">Ración de Fiesta / Cumpleaños (5 × 5 cm — Ración doble)</option>
							<option value="dessert">Ración Intermedia (3,8 × 5 cm — Postre único)</option>
						</select>
						<small class="font-body" style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">
							*La ración de boda es el estándar internacional tras un menú de 3 platos.
						</small>
					</div>

					<!-- Tier Preference (Tiered Mode) -->
					<div id="tier-pref-group" style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Configuración de Pisos:
						</label>
						<select id="tier-count-pref" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem; background: #fff;">
							<option value="auto">Recomendación Automática de Proporción</option>
							<option value="1">1 Solo Piso (Íntima)</option>
							<option value="2">2 Pisos (30 a 65 Invitados)</option>
							<option value="3">3 Pisos (75 a 130 Invitados - Clásica)</option>
							<option value="4">4 Pisos (130 a 220 Invitados)</option>
							<option value="5">5 Pisos (220+ Invitados - Boda Monumental)</option>
						</select>
					</div>

					<!-- Anniversary Top Tier Checkbox -->
					<div style="margin-bottom: 1.5rem; padding: 0.75rem; background: var(--bg-paper); border: 2px dashed var(--fg-pencil); border-radius: 4px;">
						<label style="display: flex; align-items: flex-start; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="save-top-tier" style="margin-top: 0.3rem; transform: scale(1.2);">
							<span class="font-body" style="font-size: 1.05rem; color: var(--fg-pencil); line-height: 1.4;">
								<strong>¿Guardar el piso superior para el 1er Aniversario?</strong><br>
								<span style="color: var(--text-secondary); font-size: 0.9rem;">Resta ~12 raciones del piso superior para asegurar que todos los invitados coman.</span>
							</span>
						</label>
					</div>

					<!-- Cake Height Preference -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Altura de Cada Piso:
						</label>
						<div class="height-select-grid">
							<label class="height-opt active">
								<input type="radio" name="cakeHeight" value="4" checked style="display: none;"> 10 cm (3 capas de bizcocho)
							</label>
							<label class="height-opt">
								<input type="radio" name="cakeHeight" value="5" style="display: none;"> 12,5 cm (Piso Alto)
							</label>
							<label class="height-opt">
								<input type="radio" name="cakeHeight" value="6" style="display: none;"> 15 cm (Double Barrel)
							</label>
						</div>
					</div>

					<button type="button" id="recalc-btn" class="hand-btn" style="width: 100%; padding: 1rem; font-size: 1.25rem;">
						✨ Actualizar Cálculo de Tarta
					</button>

				</form>
			</div>

			<!-- Right Column: Interactive Visuals & Results -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Results Summary Card -->
				<div class="hand-card" style="background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
						<h2 class="font-heading" style="font-size: 1.8rem; color: var(--accent-red); margin: 0;">
							Esquema de la Tarta
						</h2>
						<span id="match-status" class="font-heading" style="background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem;">
							Ajuste Exacto
						</span>
					</div>

					<!-- Big Stats -->
					<div class="cake-stats-grid">
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total Raciones</span>
							<strong id="res-total-servings" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue); display: block;">100</strong>
							<span id="res-servings-diff" style="font-size: 0.75rem; color: var(--text-secondary);">Exacto para 100</span>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Pisos / Altura</span>
							<strong id="res-tier-count" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); display: block;">3 Pisos</strong>
							<span id="res-tier-detail" style="font-size: 0.75rem; color: var(--text-secondary);">15, 23, 30 cm</span>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Superficie Cobertura</span>
							<strong id="res-cake-area" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); display: block;">1.320 cm²</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Fondant / Crema</span>
						</div>
					</div>

					<!-- Visual Cake Tier Render Container -->
					<div id="visual-cake-studio" style="border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 1.5rem 0.5rem 0.5rem; background: var(--bg-paper); min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; position: relative; overflow: hidden; max-width: 100%;">
						<div style="position: absolute; top: 8px; left: 10px; font-size: 0.8rem; color: var(--text-secondary); font-family: var(--font-heading);">
							📐 Escala Visual de Pisos
						</div>
						<div id="tiers-render-box" style="display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 100%;"></div>
						<div id="cake-stand-plate" style="width: min(240px, 90%); height: 10px; background: #e5e0d8; border: 2px solid var(--fg-pencil); border-radius: 10px; margin-top: -2px;"></div>
						<div id="cake-stand-stem" style="width: 50px; height: 20px; background: #dcd6cc; border: 2px solid var(--fg-pencil); border-top: none; margin-bottom: 4px;"></div>
						<div id="cake-stand-foot" style="width: 100px; height: 8px; background: #dcd6cc; border: 2px solid var(--fg-pencil); border-radius: 4px;"></div>
					</div>

					<!-- Breakdown List per Tier -->
					<div id="tier-breakdown-list" style="margin-top: 1.5rem; font-family: var(--font-body); font-size: 1rem;"></div>

					<!-- Pro-Tip Callout Box -->
					<div id="pro-tip-box" style="margin-top: 1.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
						<div class="font-heading" style="font-size: 1.1rem; margin-bottom: 0.25rem; color: var(--fg-pencil);">
							💡 Estrategia para Ahorrar en la Tarta:
						</div>
						<p id="pro-tip-text" class="font-body" style="font-size: 0.95rem; margin: 0; line-height: 1.4;">
							Encarga una tarta decorada pequeña de 2 pisos para las fotos y el corte simbólico, acompañada de una plancha auxiliar en cocina para servir a los invitados ahorrando hasta un 50% en mano de obra.
						</p>
					</div>

				</div>

				<!-- Visual Slice Scale Comparison Card -->
				<div class="hand-card" style="padding: 1.5rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin-bottom: 1rem; color: var(--fg-pencil);">
						📏 Comparativa Visual del Corte
					</h3>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; text-align: center;">
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
							<div class="font-heading" style="font-size: 1.1rem; color: var(--accent-blue); margin-bottom: 0.5rem;">Ración de Boda</div>
							<div style="width: 40px; height: 80px; background: #ffeaa7; border: 2px solid var(--fg-pencil); margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
								2,5 × 5 cm
							</div>
							<div class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								12,5 cm² de base<br>Estándar tras banquete completo
							</div>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
							<div class="font-heading" style="font-size: 1.1rem; color: var(--accent-red); margin-bottom: 0.5rem;">Ración de Fiesta</div>
							<div style="width: 80px; height: 80px; background: #fab1a0; border: 2px solid var(--fg-pencil); margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
								5 × 5 cm
							</div>
							<div class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								25 cm² de base<br>Ración doble de cumpleaños/fiesta
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 3.5rem auto 2.5rem; max-width: 900px; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape"></div>
			
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: gap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Resumen Rápido (Regla de Oro)
				</h3>
				<span style="background: #fff; border: 1.5px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700; color: var(--accent-red);">
					Medidas de Repostería
				</span>
			</div>

			<!-- Formula Highlight Box -->
			<div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<div style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--accent-red); margin-bottom: 0.35rem; font-weight: 700;">
					📐 La Fórmula de Porciones de Tarta:
				</div>
				<p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.5;">
					<strong>Ración Estándar de Boda = 2,5 × 5 × 10 cm de alto</strong><br />
					<strong>Ración Generosa de Fiesta = 5 × 5 × 10 cm de alto (el doble de volumen)</strong>
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; margin-bottom: 1rem; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 600px;">
					<thead>
						<tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil);">Montaje de Pisos</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil); text-align: center;">Diámetros (Pulgadas / cm)</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red); text-align: center;">Raciones Boda (2,5×5cm)</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue); text-align: center;">Raciones Fiesta (5×5cm)</th>
							<th style="padding: 0.6rem 0.75rem; font-weight: 700; color: var(--fg-pencil); text-align: right;">Invitados Recomendados</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">2 Pisos Pequeña</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">6" + 8" (15 + 20 cm)</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-red);">36 raciones</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">18 raciones</td>
