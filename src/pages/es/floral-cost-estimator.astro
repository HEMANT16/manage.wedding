<script is:inline>
	let currencySymbol = '€';

	const tierSelect = document.getElementById('select-floral-tier');
	const currencySelect = document.getElementById('currency-select');
	const deliveryCurrSym = document.getElementById('delivery-curr-sym');

	// Inputs
	const bridalInput = document.getElementById('qty-bridal-bouquet');
	const bridesmaidInput = document.getElementById('qty-bridesmaid-bouquets');
	const boutonniereInput = document.getElementById('qty-boutonnieres');
	const corsageInput = document.getElementById('qty-corsages');

	const archSelect = document.getElementById('select-arch');
	const aisleInput = document.getElementById('qty-aisle-posies');
	const welcomeInput = document.getElementById('qty-welcome-sign');

	const lowCenterpieceInput = document.getElementById('qty-low-centerpieces');
	const tallCenterpieceInput = document.getElementById('qty-tall-centerpieces');
	const sweetheartInput = document.getElementById('qty-sweetheart-garland');
	const cakeInput = document.getElementById('qty-cake-flowers');

	const laborPctInput = document.getElementById('input-labor-pct');
	const deliveryFeeInput = document.getElementById('input-delivery-fee');

	// Result Displays
	const resGrandTotal = document.getElementById('res-grand-total');
	const resTierSummary = document.getElementById('res-tier-summary');
	const resPersonalSubtotal = document.getElementById('res-personal-subtotal');
	const resCeremonySubtotal = document.getElementById('res-ceremony-subtotal');
	const resReceptionSubtotal = document.getElementById('res-reception-subtotal');
	const resStemsSubtotal = document.getElementById('res-stems-subtotal');
	const resLaborAmount = document.getElementById('res-labor-amount');
	const resDeliveryAmount = document.getElementById('res-delivery-amount');

	const barPersonal = document.getElementById('bar-personal');
	const barCeremony = document.getElementById('bar-ceremony');
	const barReception = document.getElementById('bar-reception');
	const barLabor = document.getElementById('bar-labor');

	function formatMoney(amount) {
		return `${Math.round(amount).toLocaleString('es-ES')} ${currencySymbol}`;
	}

	function calculateFlorals() {
		currencySymbol = currencySelect.value;
		deliveryCurrSym.textContent = currencySymbol;

		const tierMult = parseFloat(tierSelect.value) || 1.4;
		const laborPct = (parseFloat(laborPctInput.value) || 0) / 100;
		const deliveryFee = parseFloat(deliveryFeeInput.value) || 0;

		// 1. Personal
		const bridalCost = (parseInt(bridalInput.value) || 0) * 140 * tierMult;
		const bridesmaidCost = (parseInt(bridesmaidInput.value) || 0) * 65 * tierMult;
		const boutonniereCost = (parseInt(boutonniereInput.value) || 0) * 16 * tierMult;
		const corsageCost = (parseInt(corsageInput.value) || 0) * 25 * tierMult;
		const personalSubtotal = bridalCost + bridesmaidCost + boutonniereCost + corsageCost;

		// 2. Ceremony
		const archCost = (parseFloat(archSelect.value) || 0) * tierMult;
		const aisleCost = (parseInt(aisleInput.value) || 0) * 45 * tierMult;
		const welcomeCost = (parseInt(welcomeInput.value) || 0) * 55 * tierMult;
		const ceremonySubtotal = archCost + aisleCost + welcomeCost;

		// 3. Reception
		const lowCenterCost = (parseInt(lowCenterpieceInput.value) || 0) * 80 * tierMult;
		const tallCenterCost = (parseInt(tallCenterpieceInput.value) || 0) * 180 * tierMult;
		const sweetheartCost = (parseInt(sweetheartInput.value) || 0) * 150 * tierMult;
		const cakeCost = (parseInt(cakeInput.value) || 0) * 35 * tierMult;
		const receptionSubtotal = lowCenterCost + tallCenterCost + sweetheartCost + cakeCost;

		// Stems subtotal
		const stemsSubtotal = personalSubtotal + ceremonySubtotal + receptionSubtotal;
		const laborCost = stemsSubtotal * laborPct;
		const grandTotal = stemsSubtotal + laborCost + deliveryFee;

		// Update UI
		resGrandTotal.textContent = formatMoney(grandTotal);
		resTierSummary.textContent = `${tierSelect.options[tierSelect.selectedIndex].text.split('(')[0]}`;

		resPersonalSubtotal.textContent = formatMoney(personalSubtotal);
		resCeremonySubtotal.textContent = formatMoney(ceremonySubtotal);
		resReceptionSubtotal.textContent = formatMoney(receptionSubtotal);
		resStemsSubtotal.textContent = formatMoney(stemsSubtotal);
		resLaborAmount.textContent = formatMoney(laborCost);
		resDeliveryAmount.textContent = formatMoney(deliveryFee);

		// Proportions
		if (grandTotal > 0) {
			barPersonal.style.width = `${(personalSubtotal / grandTotal) * 100}%`;
			barCeremony.style.width = `${(ceremonySubtotal / grandTotal) * 100}%`;
			barReception.style.width = `${(receptionSubtotal / grandTotal) * 100}%`;
			barLabor.style.width = `${((laborCost + deliveryFee) / grandTotal) * 100}%`;
		}
	}

	document.querySelectorAll('.floral-input, #input-labor-pct, #input-delivery-fee').forEach(el => {
		el.addEventListener('input', calculateFlorals);
	});
	[tierSelect, archSelect, currencySelect].forEach(el => {
		el.addEventListener('change', calculateFlorals);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const tierName = tierSelect.options[tierSelect.selectedIndex].text;
		const tierMult = parseFloat(tierSelect.value) || 1.4;

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Presupuesto Floral de Boda</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Presupuesto Oficial de Flores de Boda</h1>
				<p>Generado el ${new Date().toLocaleDateString('es-ES')} | Gama Floral: <strong>${tierName}</strong> | Presupuesto Total: <strong>${resGrandTotal.textContent}</strong></p>
				
				<h3>Desglose de Flores y Composiciones:</h3>
				<table>
					<thead>
						<tr><th>Elemento Floral</th><th style="text-align:center;">Cantidad</th><th style="text-align:right;">Subtotal (€)</th></tr>
					</thead>
					<tbody>
						<tr><td>Ramo de Novia</td><td style="text-align:center;">${bridalInput.value}</td><td style="text-align:right;">${formatMoney(bridalInput.value * 140 * tierMult)}</td></tr>
						<tr><td>Ramos Damas de Honor</td><td style="text-align:center;">${bridesmaidInput.value}</td><td style="text-align:right;">${formatMoney(bridesmaidInput.value * 65 * tierMult)}</td></tr>
						<tr><td>Prendidos (Boutonnières)</td><td style="text-align:center;">${boutonniereInput.value}</td><td style="text-align:right;">${formatMoney(boutonniereInput.value * 16 * tierMult)}</td></tr>
						<tr><td>Ramilletes Madrinas</td><td style="text-align:center;">${corsageInput.value}</td><td style="text-align:right;">${formatMoney(corsageInput.value * 25 * tierMult)}</td></tr>
						<tr><td>Arco de Ceremonia / Altar</td><td style="text-align:center;">1</td><td style="text-align:right;">${formatMoney(archSelect.value * tierMult)}</td></tr>
						<tr><td>Composiciones Pasillo</td><td style="text-align:center;">${aisleInput.value}</td><td style="text-align:right;">${formatMoney(aisleInput.value * 45 * tierMult)}</td></tr>
						<tr><td>Cartel de Bienvenida</td><td style="text-align:center;">${welcomeInput.value}</td><td style="text-align:right;">${formatMoney(welcomeInput.value * 55 * tierMult)}</td></tr>
						<tr><td>Centros Bajos con Velas</td><td style="text-align:center;">${lowCenterpieceInput.value}</td><td style="text-align:right;">${formatMoney(lowCenterpieceInput.value * 80 * tierMult)}</td></tr>
						<tr><td>Centros Altos en Soporte</td><td style="text-align:center;">${tallCenterpieceInput.value}</td><td style="text-align:right;">${formatMoney(tallCenterpieceInput.value * 180 * tierMult)}</td></tr>
						<tr><td>Guirnalda Mesa Presidencial</td><td style="text-align:center;">${sweetheartInput.value}</td><td style="text-align:right;">${formatMoney(sweetheartInput.value * 150 * tierMult)}</td></tr>
						<tr><td>Flores para Tarta Nupcial</td><td style="text-align:center;">${cakeInput.value}</td><td style="text-align:right;">${formatMoney(cakeInput.value * 35 * tierMult)}</td></tr>
						<tr style="background:#f9f9f9; font-weight:bold;"><td>Subtotal Tallos</td><td style="text-align:center;">-</td><td style="text-align:right;">${resStemsSubtotal.textContent}</td></tr>
						<tr><td>Montaje y Mano de Obra (${laborPctInput.value}%)</td><td style="text-align:center;">-</td><td style="text-align:right;">${resLaborAmount.textContent}</td></tr>
						<tr><td>Transporte y Furgoneta</td><td style="text-align:center;">-</td><td style="text-align:right;">${resDeliveryAmount.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;"><td>Presupuesto Total Florista</td><td style="text-align:center;">-</td><td style="text-align:right; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Presupuesto_Flores_Boda_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('es-ES');
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tierMult = parseFloat(tierSelect.value) || 1.4;
		const tbody = document.getElementById('print-floral-body');

		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Ramo de Novia</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${bridalInput.value}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(bridalInput.value * 140 * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Ramos Damas de Honor</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${bridesmaidInput.value}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(bridesmaidInput.value * 65 * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Prendidos y Ramilletes</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(boutonniereInput.value) + parseInt(corsageInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((boutonniereInput.value * 16 + corsageInput.value * 25) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Arco de Ceremonia / Altar</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">1</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(archSelect.value * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Pasillo y Cartel de Bienvenida</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(aisleInput.value) + parseInt(welcomeInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((aisleInput.value * 45 + welcomeInput.value * 55) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Centros Bajos y Altos</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(lowCenterpieceInput.value) + parseInt(tallCenterpieceInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((lowCenterpieceInput.value * 80 + tallCenterpieceInput.value * 180) * tierMult)}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Mesa Presidencial y Tarta</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">${parseInt(sweetheartInput.value) + parseInt(cakeInput.value)}</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney((sweetheartInput.value * 150 + cakeInput.value * 35) * tierMult)}</td></tr>
			<tr style="background:#fafafa;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Subtotal Tallos</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resStemsSubtotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Montaje in situ (${laborPctInput.value}%)</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resLaborAmount.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Transporte y Furgoneta</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDeliveryAmount.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:14px;">Presupuesto Total Estimado</td><td style="border:1px solid #ccc; padding:6px; text-align:center;">-</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:14px; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const tierMult = parseFloat(tierSelect.value) || 1.4;
		let csv = "Elemento Floral,Cantidad,Subtotal\n";
		csv += `"Ramo de Novia",${bridalInput.value},"${formatMoney(bridalInput.value * 140 * tierMult)}"\n`;
		csv += `"Ramos Damas",${bridesmaidInput.value},"${formatMoney(bridesmaidInput.value * 65 * tierMult)}"\n`;
		csv += `"Prendidos",${boutonniereInput.value},"${formatMoney(boutonniereInput.value * 16 * tierMult)}"\n`;
		csv += `"Ramilletes Madrinas",${corsageInput.value},"${formatMoney(corsageInput.value * 25 * tierMult)}"\n`;
		csv += `"Arco de Ceremonia",1,"${formatMoney(archSelect.value * tierMult)}"\n`;
		csv += `"Composiciones Pasillo",${aisleInput.value},"${formatMoney(aisleInput.value * 45 * tierMult)}"\n`;
		csv += `"Cartel Bienvenida",${welcomeInput.value},"${formatMoney(welcomeInput.value * 55 * tierMult)}"\n`;
		csv += `"Centros Bajos",${lowCenterpieceInput.value},"${formatMoney(lowCenterpieceInput.value * 80 * tierMult)}"\n`;
		csv += `"Centros Altos",${tallCenterpieceInput.value},"${formatMoney(tallCenterpieceInput.value * 180 * tierMult)}"\n`;
		csv += `"Guirnalda Presidencial",${sweetheartInput.value},"${formatMoney(sweetheartInput.value * 150 * tierMult)}"\n`;
		csv += `"Flores Tarta",${cakeInput.value},"${formatMoney(cakeInput.value * 35 * tierMult)}"\n`;
		csv += `"Subtotal Tallos",-,"${resStemsSubtotal.textContent}"\n`;
		csv += `"Montaje in situ",-,"${resLaborAmount.textContent}"\n`;
		csv += `"Transporte",-,"${resDeliveryAmount.textContent}"\n`;
		csv += `"Total Presupuesto Florista",-,"${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Presupuesto_Flores_Boda_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateFlorals();
</script>
