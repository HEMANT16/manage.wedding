---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/floral-cost-estimator/#webapp",
      "name": "Estimador de Presupuesto de Flores y Decoración Floral de Boda",
      "url": "https://manage.wedding/es/floral-cost-estimator",
      "inLanguage": "es",
      "description": "Calculadora gratuita de flores de boda: calcula precios exactos para ramos de novia, damas de honor, prendidos, centros de mesa, arcos de ceremonia, montaje y transporte con exportación a Word y PDF.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular el Presupuesto Floral de una Boda",
      "description": "Guía paso a paso para desglosar ramos, decoración de ceremonia, centros de mesa del banquete y mano de obra del florista.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Contabiliza las Flores Personales",
          "text": "Suma el ramo de novia, ramos de damas de honor, prendidos (boutonnières) para novio y padrinos, y ramilletes de muñeca."
        },
        {
          "@type": "HowToStep",
          "name": "Estima la Decoración de la Ceremonia",
          "text": "Elige entre columnas florales, arco de medio punto o arco floral completo para el altar, más flores para el pasillo nupcial."
        },
        {
          "@type": "HowToStep",
          "name": "Calcula los Centros de Mesa del Banquete",
          "text": "Multiplica el número de mesas por centros bajos (65€–120€) o composiciones altas elevadas (150€–280€)."
        },
        {
          "@type": "HowToStep",
          "name": "Añade Mano de Obra, Montaje y Transporte",
          "text": "Incluye entre un 15% y un 25% para el acondicionamiento previo, montaje in situ y desmontaje nocturno."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto cuestan de media las flores de una boda en España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El gasto medio en flores de boda oscila entre 1.500€ y 3.800€, lo que representa entre el 8% y el 12% del presupuesto global. Varía según la estacionalidad de las flores (peonías o flores importadas frente a rosas y verdes locales) y la cantidad de centros y estructuras."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta un ramo de novia profesional?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un ramo de novia estándar suele costar entre 120€ y 180€. Ramos más elaborados de estilo silvestre, cascada o con peonías, orquídeas y rosas de jardín alcanzan entre 200€ y 300€."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué cobran los floristas un porcentaje de montaje y transporte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La floristería para bodas requiere días de hidratación en cámaras frigoríficas, alambrado manual de tallos, transporte en furgonetas climatizadas y un equipo de floristas trabajando in situ 3 horas antes de la ceremonia para montar el arco antes de que lleguen los invitados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo reutilizar las flores de la ceremonia en el banquete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pide a tu florista que diseñe los arreglos del arco o del pasillo para que los camareros o coordinadores puedan trasladarlos a la mesa presidencial o a la zona del photocall durante el cóctel. ¡Permite ahorrar cientos de euros!"
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Presupuesto Floral de Boda (Ramos, Centros y Arcos) | Manage.Wedding"
	description="Calcula el coste de las flores de tu boda: ramos de novia, damas de honor, centros de mesa, arco de ceremonia, montaje y transporte. Exporta a Word y PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Presupuesto Floral de Boda" category="budget-finance" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Presupuesto <span class="accent-italic">Floral de Boda</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calcula el coste exacto de flores personales, arco de ceremonia, centros de mesa del banquete y montaje. Exporta tu <strong>Propuesta para Floristas</strong> a <strong>Word (.doc)</strong> o <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="floral-calc-grid">
			
			<!-- Left Column: Itemized Floral Quantities -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🌸 Selecciona Cantidades de Flores
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Flores personales, decoración de ceremonia y mesas del banquete
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Moneda:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="$">$ (USD/CAD/AUD)</option>
							<option value="£">£ (GBP)</option>
							<option value="₹">₹ (INR)</option>
						</select>
					</div>
				</div>

				<form id="floral-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- Floral Density & Bloom Quality Tier -->
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<label for="select-floral-tier" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem; text-align: center;">
							✨ Gama Floral y Densidad de Flor
						</label>
						<select id="select-floral-tier" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="1.0">Estándar / Flores de Temporada y Verdes (Rosas, Claveles, Eucalipto) (1,0x)</option>
							<option value="1.4" selected>Romántica Clásica (Rosas de Jardín, Ranúnculos, Hortensias) (1,4x)</option>
							<option value="2.0">Alta Floristería de Autor (Peonías, Anémonas, Orquídeas, Flor Importada) (2,0x)</option>
						</select>
					</div>

					<!-- Category 1: Personal Wedding Party Flowers -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							👰 1. Flores Personales y Cortejo
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="qty-bridal-bouquet" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Ramo de Novia (140 €)</label>
								<input type="number" id="qty-bridal-bouquet" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-bridesmaid-bouquets" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Ramos Damas de Honor (65 €)</label>
								<input type="number" id="qty-bridesmaid-bouquets" value="3" min="0" max="20" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-boutonnieres" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Prendidos / Boutonnières (16 €)</label>
								<input type="number" id="qty-boutonnieres" value="6" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-corsages" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Ramilletes Madrinas / Madres (25 €)</label>
								<input type="number" id="qty-corsages" value="2" min="0" max="20" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Category 2: Ceremony Florals -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-blue); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							⛪ 2. Decoración de Ceremonia y Altar
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="select-arch" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Arco / Estructura del Altar</label>
								<select id="select-arch" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="0">Sin Arco / Minimalista (0 €)</option>
									<option value="350" selected>Arco Floral en Esquina / Medallón (350 €)</option>
									<option value="750">Arco Floral Completo Circular / Circular Arch (750 €)</option>
									<option value="1200">Columnas Florales Exuberantes y Dosel (1.200 €)</option>
								</select>
							</div>
							<div>
								<label for="qty-aisle-posies" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Composiciones Pasillo / Sillas (45 €)</label>
								<input type="number" id="qty-aisle-posies" value="6" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div style="grid-column: span 2;">
								<label for="qty-welcome-sign" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Cartel de Bienvenida y Caballete (55 €)</label>
								<input type="number" id="qty-welcome-sign" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Category 3: Reception Table Florals -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: #16a34a; margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							🍽️ 3. Mesas del Banquete y Presidencial
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
							<div>
								<label for="qty-low-centerpieces" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Centros Bajos con Flores y Velas (80 €)</label>
								<input type="number" id="qty-low-centerpieces" value="8" min="0" max="40" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-tall-centerpieces" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Centros Altos en Soporte Elevado (180 €)</label>
								<input type="number" id="qty-tall-centerpieces" value="2" min="0" max="30" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-sweetheart-garland" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Guirnalda Mesa Presidencial (150 €)</label>
								<input type="number" id="qty-sweetheart-garland" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
							<div>
								<label for="qty-cake-flowers" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Detalles Tarta / Barra Dulce (35 €)</label>
								<input type="number" id="qty-cake-flowers" value="1" min="0" max="5" class="floral-input" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper);">
							</div>
						</div>
					</div>

					<!-- Delivery & Labor Settings -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-labor-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Mano de Obra y Montaje in situ
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-labor-pct" value="18" min="0" max="35" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>

						<div>
							<label for="input-delivery-fee" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Transporte / Furgoneta Climatizada
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-delivery-fee" value="110" min="0" max="1000" step="10" style="width: 70px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span id="delivery-curr-sym" style="font-weight: bold;">€</span>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Line-Item Invoice -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Floral Invoice Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								💐 Presupuesto Floral Estimado
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Tallos, arreglos, montaje in situ y transporte
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar a Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimir PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Grand Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Presupuesto Total del Florista</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">3.450 €</strong>
						<span id="res-tier-summary" style="font-size: 0.8rem; color: var(--accent-red);">Gama Romántica Clásica (1,4x)</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Desglose por Partidas Florales
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">👰 Flores Personales y Cortejo:</td>
									<td id="res-personal-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">673,40 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">⛪ Ceremonia, Altar y Pasillo:</td>
									<td id="res-ceremony-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">945,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍽️ Mesas y Presidencial del Banquete:</td>
									<td id="res-reception-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.659,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Subtotal Tallos y Composición:</td>
									<td id="res-stems-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">3.277,40 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-blue);">
									<td style="padding: 0.4rem 0;">🛠️ Montaje y Mano de Obra (18%):</td>
									<td id="res-labor-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">589,93 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil);">
									<td style="padding: 0.4rem 0;">🚚 Transporte y Furgoneta:</td>
									<td id="res-delivery-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">110,00 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Category Distribution Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Personal</span>
							<span>Ceremonia</span>
							<span>Banquete</span>
							<span style="color: var(--accent-blue);">Montaje</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-personal" style="width: 20%; background: var(--accent-red); transition: width 0.3s ease;" title="Personal"></div>
							<div id="bar-ceremony" style="width: 25%; background: var(--accent-blue); transition: width 0.3s ease;" title="Ceremonia"></div>
							<div id="bar-reception" style="width: 40%; background: #16a34a; transition: width 0.3s ease;" title="Banquete"></div>
							<div id="bar-labor" style="width: 15%; background: #d97706; transition: width 0.3s ease;" title="Montaje y Transporte"></div>
						</div>
					</div>

				</div>

				<!-- Florist Tip Alert Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						💡 Consejo: Reutiliza los Arreglos de la Ceremonia
					</strong>
					<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; color: var(--fg-pencil);">
