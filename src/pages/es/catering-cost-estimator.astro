---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/catering-cost-estimator/#webapp",
      "name": "Estimador de Coste de Catering y Precio por Cubierto de Boda",
      "url": "https://manage.wedding/es/catering-cost-estimator",
      "inLanguage": "es",
      "description": "Calculadora gratuita de catering para bodas: calcula el precio real por cubierto y el coste total de comida, barra libre, alquiler de menaje, menús de proveedores, servicio e IVA (10%). Exporta a Word, PDF y Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Calcular el Presupuesto Real de Catering y Banquete de Boda",
      "description": "Método paso a paso para desglosar el coste del menú, barra libre, alquiler de menaje, servicio e IVA del catering.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Elige el Tipo de Banquete y Gama del Menú",
          "text": "Selecciona Menú Tradicional Servido en Mesa (3 platos), Buffet Libre, Banquete Familiar o Estaciones Gastronómicas y Cóctel Largo."
        },
        {
          "@type": "HowToStep",
          "name": "Configura los Aperitivos del Cóctel y la Barra Libre",
          "text": "Añade estaciones de jamón ibérico/quesos, aperitivos pasados y horas de barra libre con bebidas de primeras marcas."
        },
        {
          "@type": "HowToStep",
          "name": "Incluye Menús de Proveedores y Menaje",
          "text": "Añade los menús de trabajo para fotógrafo, videógrafo y DJ (generalmente al 50% de coste) y alquileres de vajilla especial."
        },
        {
          "@type": "HowToStep",
          "name": "Aplica el IVA (10%) y Gastos de Servicio",
          "text": "Aplica el 10% de IVA de hostelería para obtener el precio final real por comensal con todos los costes cerrados."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta de media el cubierto de boda en España?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El precio medio del menú de boda oscila entre 90€ y 160€ por comensal (incluyendo cóctel de bienvenida, plato principal de carne o pescado, postre, bodega y café). Al sumar barra libre, menús de fotógrafos/DJ y el 10% de IVA, el coste real por invitado suele situarse entre 125€ y 195€."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es más barato un menú tipo buffet que un menú servido en mesa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No necesariamente. Aunque un buffet requiere menos camareros para el pase de platos, la cocina debe preparar entre un 20% y un 30% más de comida para que las bandejas nunca queden vacías. En banquetes de calidad, el precio por cubierto suele ser prácticamente idéntico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es obligatorio dar de comer a los proveedores (fotógrafo, DJ, wedding planner)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Todos los proveedores que trabajen más de 5 o 6 horas seguidas durante el evento deben recibir un menú caliente. La mayoría de caterings ofrecen 'Menús de Proveedor o Staff' a un 40%–50% del precio del menú de invitados."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué IVA se aplica al catering y banquete de bodas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En España, los servicios de comida y bebida de catering tributan al tipo reducido del 10% de IVA. El alquiler exclusivo de espacios o fincas sin servicio de hostelería tributa al 21%."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calculadora de Catering de Boda y Precio por Cubierto | Manage.Wedding"
	description="Calcula el precio real por comensal de tu banquete de boda: comida, aperitivos, barra libre, alquileres, IVA y menús de proveedores. Exporta a Word y PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Coste de Catering y Menús de Boda" category="food-dining" />
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Catering de Boda y <span class="accent-italic">Precio por Cubierto</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calcula el coste real con todo incluido: comida, cóctel, barra libre, menaje, menús de proveedores, servicio e IVA. Exporta a <strong>Word (.doc)</strong>, <strong>PDF</strong> o <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Main Workspace Grid: Configurator + Real-Time Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="catering-calc-grid">
			
			<!-- Left Column: Input Form & Package Controls -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							🍽️ Configura el Banquete y Menú
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Comida, aperitivos, barra libre, menaje e impuestos
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Moneda:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="$">$ (USD/CAD/AUD)</option>
							<option value="£">£ (GBP)</option>
							<option value="₹">₹ (INR)</option>
						</select>
					</div>
				</div>

				<form id="catering-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Guest Count & Vendor Meals -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
						<div>
							<label for="input-guest-count" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Número de Invitados *
							</label>
							<input type="number" id="input-guest-count" value="100" min="10" max="1000" required style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
						</div>

						<div>
							<label for="input-vendor-meals" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Menús Staff (Foto, DJ, WP)
							</label>
							<input type="number" id="input-vendor-meals" value="4" min="0" max="30" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
						</div>
					</div>

					<!-- Meal Service Style -->
					<div>
						<label for="select-meal-style" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Tipo de Servicio del Menú Principal
						</label>
						<select id="select-meal-style" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: #fff;">
							<option value="75" selected>Menú Tradicional Servido en Mesa (Entrante + Pescado/Carne + Postre) (75 € / comensal base)</option>
							<option value="60">Buffet Libre Gourmet (Varios platos principales y guarniciones) (60 € / comensal base)</option>
							<option value="68">Banquete Familiar (Fuentes al centro de mesa para compartir) (68 € / comensal base)</option>
							<option value="55">Cóctel Largo / Estaciones Gastronómicas y Showcooking (55 € / comensal base)</option>
							<option value="42">Puestos Callejeros / Food Trucks Temáticos (42 € / comensal base)</option>
							<option value="48">Brunch Nupcial / Barbacoa Rústica (48 € / comensal base)</option>
						</select>
					</div>

					<!-- Passed Appetizers / Cocktail Hour -->
					<div>
						<label for="select-appetizers" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Aperitivos y Cóctel de Bienvenida
						</label>
						<select id="select-appetizers" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="0">Incluido en el precio base del catering (0 €)</option>
							<option value="16" selected>Cóctel Estándar (8 a 10 canapés fríos y calientes) (16 € / comensal)</option>
							<option value="26">Cóctel Premium + Cortador de Jamón Ibérico y Mesa de Quesos (26 € / comensal)</option>
							<option value="36">Cóctel Exclusivo + Estación de Mariscos y Ostras en Directo (36 € / comensal)</option>
						</select>
					</div>

					<!-- Bar & Beverage Package -->
					<div>
						<label for="select-bar-package" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							Bebidas del Banquete y Barra Libre
						</label>
						<select id="select-bar-package" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="0">Sin Alcohol / Bebidas no incluidas (0 € / comensal)</option>
							<option value="10">Aportamos nosotros las botellas (Servicio de camarero y hielo) (10 € / comensal)</option>
							<option value="18">Bodega durante el banquete + Cerveza y Vino (18 € / comensal)</option>
							<option value="28" selected>Barra Libre Estándar (4 horas con primeras marcas) (28 € / comensal)</option>
							<option value="40">Barra Libre Premium + Coctelería de Autor (40 € / comensal)</option>
						</select>
					</div>

					<!-- Rentals & Dinnerware -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
						<div>
							<label for="select-rentals" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Menaje y Mantelería
							</label>
							<select id="select-rentals" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff;">
								<option value="0">Incluido en la Finca (0 €)</option>
								<option value="8" selected>Menaje Estándar (8 €/comensal)</option>
								<option value="18">Vajilla de Diseño y Cristalería Premium (18 €/comensal)</option>
							</select>
						</div>

						<div>
							<label for="select-dessert-fee" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Tarta Nupcial / Mesa Dulce
							</label>
							<select id="select-dessert-fee" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff;">
								<option value="0">Tarta incluida en el menú (0 €)</option>
								<option value="3" selected>Canon de corte / Servicio de tarta externa (3 €/comensal)</option>
								<option value="7">Candy Bar / Mesa Dulce Completa (7 €/comensal)</option>
							</select>
						</div>
					</div>

					<!-- Plus-Plus Fees (Service Charge & Tax) -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-service-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Montaje / Servicio Camareros
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-service-pct" value="5" min="0" max="25" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>

						<div>
							<label for="input-tax-pct" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Tipo de IVA (Hostelería)
							</label>
							<div style="display: flex; align-items: center; gap: 0.2rem;">
								<input type="number" id="input-tax-pct" value="10" min="0" max="21" step="0.5" style="width: 60px; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.9rem; text-align: center; background: #fff;">
								<span style="font-weight: bold; font-size: 0.9rem;">%</span>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Surcharge Comparison -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								📋 Presupuesto Estimado de Catering
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Todo incluido: comida, cóctel, barra libre, servicio e IVA
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Exportar a Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Imprimir PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Cost Per Head vs Total Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Grand Total Invoice -->
						<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--accent-red); display: block; font-weight: bold;">Factura Total Catering</span>
							<strong id="res-grand-total" class="font-heading" style="font-size: 2.2rem; color: var(--accent-red); display: block; line-height: 1.2;">15.185 €</strong>
							<span id="res-total-guest-note" style="font-size: 0.75rem; color: var(--accent-red);">Con IVA y servicio</span>
						</div>

						<!-- All-Inclusive Cost Per Head -->
						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block; font-weight: bold;">Coste Real / Cubierto</span>
							<strong id="res-per-head" class="font-heading" style="font-size: 2.2rem; color: var(--accent-blue); display: block; line-height: 1.2;">151,85 €</strong>
							<span id="res-base-diff-note" style="font-size: 0.75rem; color: #1e40af;">Menú base: 75,00 €</span>
						</div>

					</div>

					<!-- Itemized Invoice Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Desglose por Partidas del Banquete
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🥗 Menú Principal y Aperitivos:</td>
									<td id="res-food-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">9.100,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍷 Barra Libre y Bodega:</td>
									<td id="res-bar-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">2.800,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍽️ Menaje, Mantelería y Tarta:</td>
									<td id="res-rentals-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.100,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🍱 Menús Staff Proveedores (50% dto.):</td>
									<td id="res-vendor-meals-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">150,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Base Imponible (Comida + Bebida + Menaje):</td>
									<td id="res-pretax-subtotal" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">13.150,00 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-red);">
									<td style="padding: 0.4rem 0;">➕ Montaje y Servicio (5%):</td>
									<td id="res-service-charge" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">657,50 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil);">
									<td style="padding: 0.4rem 0;">🏛️ IVA Hostelería (10%):</td>
									<td id="res-sales-tax" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">1.380,75 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Proportional Cost Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Comida y Bebida (85%)</span>
							<span style="color: var(--accent-red);">Servicio e IVA (15%)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-food-portion" style="width: 85%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-fees-portion" style="width: 15%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Planner Surcharge Alert Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						⚠️ El Precio Real vs. Precio Publicitado:
					</strong>
					<p class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; color: var(--fg-pencil);">
						Fíjate en cómo un menú que se anuncia a <strong>75 €/cubierto</strong> sube hasta <strong>151,85 €/comensal</strong> al sumar el cóctel de aperitivos, la barra libre de 4 horas, el menaje y el 10% de IVA. ¡Compara presupuestos siempre con el total final!
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Presupuesto Oficial de Catering de Boda</h1>
