---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/es/who-pays-for-what-wedding/#webapp",
      "name": "¿Quién Paga Qué en la Boda? Divisor de Gastos y Protocolo",
      "url": "https://manage.wedding/es/who-pays-for-what-wedding",
      "inLanguage": "es",
      "description": "Calculadora gratuita para repartir los gastos de la boda: compara el protocolo tradicional con la división moderna equitativa entre familias y pareja con acuerdo descargable en PDF.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cómo Repartir los Gastos de Boda entre Familias y Pareja",
      "description": "Guía de protocolo para acordar y distribuir el presupuesto de la boda entre los novios y sus respectivas familias.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Paso 1: Fija el Presupuesto Total Objetivo",
          "text": "Calcula el importe global previsto para la boda (ej. 25.000€ o 35.000€) según el banquete y espacio elegidos."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 2: Elige el Modelo de Reparto",
          "text": "Decide si seguir el protocolo tradicional (familia de la novia asume banquete/vestido, familia del novio cubre preboda/viaje), división al 50/50 o aportación a tres bandas."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 3: Asigna Partidas Específicas a Cada Parte",
          "text": "Define la responsabilidad de cada bloque: Finca y Menú, Vestuario, Cena de Ensayo/Preboda, Luna de Miel, Flores y Alianzas."
        },
        {
          "@type": "HowToStep",
          "name": "Paso 4: Acuerda la Forma de Pago con las Familias",
          "text": "Acuerda si las aportaciones familiares se ingresarán como transferencia única en una cuenta de boda común o si pagarán facturas concretas directamente."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Quién paga tradicionalmente cada gasto de la boda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tradicionalmente, la familia de la novia pagaba el banquete, alquiler de finca, vestido de novia, fotografía, flores de ceremonia e invitaciones. La familia del novio pagaba la cena de ensayo o preboda, las tasas de ceremonia, el ramo de la novia, los prendidos y el viaje de novios (luna de miel)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Quién paga la cena de ensayo o cóctel de bienvenida de la víspera?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según el protocolo clásico, la familia del novio es la anfitriona y se hace cargo del 100% de la cena de ensayo. En las bodas actuales, muchas parejas lo financian conjuntamente o lo asumen al 50% entre ambas familias."
          }
        },
        {
          "@type": "Question",
          "name": "¿Quién paga el vestido de novia y los arreglos de costura?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tradicionalmente, la novia y su familia se encargan de adquirir el vestido, velo, zapatos, joyas y todos los arreglos de modistería."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo pagan las parejas su boda en la actualidad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hoy en día, más del 60% de las parejas asumen la mayor parte del presupuesto con sus propios ahorros y los regalos de los invitados. Cuando los padres colaboran, el modelo más extendido es la 'División a Tres Bandas': la pareja aporta entre el 40% y el 50%, y ambas familias aportan cantidades proporcionales."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="¿Quién Paga Qué en la Boda? Divisor de Gastos (Tradicional vs Moderno) | Manage.Wedding"
	description="Calculadora de división de gastos de boda. Compara el protocolo tradicional con la división equitativa familiar y descarga un acuerdo en PDF listo para imprimir."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="¿Quién Paga Qué en la Boda?" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Protocolo Tradicional vs Reparto Moderno a 3 Bandas</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				¿Quién Paga Qué en la Boda? <span class="accent-italic">Divisor de Gastos</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Compara el protocolo tradicional con la división equitativa moderna entre familias y pareja. Asigna responsabilidades para más de 20 partidas y descarga el acuerdo en 1 clic.
			</p>
		</header>

		<!-- Main Interactive Splitter Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Split Model Setup & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Modelo de Reparto y Presupuesto
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Motor de Protocolo
					</span>
				</div>

				<!-- Total Budget -->
				<div class="form-group">
					<label class="form-label" for="total-wedding-budget">Presupuesto Estimado Total (€)</label>
					<input type="number" id="total-wedding-budget" class="form-input" value="25000" min="5000" step="1000" style="font-size: 1.2rem; font-weight: 700;" />
				</div>

				<!-- Split Model Shortcut Selector -->
				<div class="form-group">
					<label class="form-label" for="split-model-preset">Modelo de Financiación</label>
					<select id="split-model-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="traditional" selected>📜 Protocolo Tradicional (Familia Novia 70% / Familia Novio 25% / Pareja 5%)</option>
						<option value="modern-3way">🤝 Reparto Moderno a 3 Bandas (Pareja 40% / Familia Novia 30% / Familia Novio 30%)</option>
						<option value="couple-100">💍 100% Autofinanciada por los Novios (Sin aportación familiar obligatoria)</option>
						<option value="couple-50-50">⚖️ Novios al 50/50 (Cada miembro de la pareja asume la mitad)</option>
						<option value="custom">✏️ Asignación Personalizada por Porcentajes</option>
					</select>
				</div>

				<!-- Visual Split Percentages Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Porcentaje de Aportación de Cada Parte (%)
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.85rem;">
						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-red);">👰 Familia de la Novia:</span>
								<span id="slider-bride-pct-val">70%</span>
							</div>
							<input type="range" id="slider-bride-pct" min="0" max="100" value="70" style="width: 100%; accent-color: var(--accent-red);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-blue);">🤵 Familia del Novio:</span>
								<span id="slider-groom-pct-val">25%</span>
							</div>
							<input type="range" id="slider-groom-pct" min="0" max="100" value="25" style="width: 100%; accent-color: var(--accent-blue);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: #16a34a;">💍 Aportación Propia de los Novios:</span>
								<span id="slider-couple-pct-val">5%</span>
							</div>
							<input type="range" id="slider-couple-pct" min="0" max="100" value="5" style="width: 100%; accent-color: #16a34a;" />
						</div>
					</div>
				</div>

				<!-- Quick Money Talk Guide -->
				<div style="margin-top: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
					<strong style="display: block; color: var(--fg-pencil); margin-bottom: 4px;">💬 Cómo Hablar de Dinero con los Padres de Forma Elegante:</strong>
					"¡Estamos empezando a presupuestar la boda! Nos encantaría saber si os gustaría participar en alguna partida concreta (como las flores o la música), o si preferís que planifiquemos todo de forma totalmente independiente."
				</div>

			</div>

			<!-- Right Column: Results Breakdown & Itemized Checklist -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Contribution Summary Cards -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Reparto Financiero Resultante
					</h3>

					<!-- 3 Contribution Summary Bars -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem; text-align: center;">
						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-red);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Familia Novia</span>
							<strong id="card-bride-amount" style="font-size: 1.2rem; color: var(--accent-red); display: block; margin-top: 2px;">17.500 €</strong>
							<span id="card-bride-pct" style="font-size: 0.75rem; color: #64748b;">(70%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-blue);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Familia Novio</span>
							<strong id="card-groom-amount" style="font-size: 1.2rem; color: var(--accent-blue); display: block; margin-top: 2px;">6.250 €</strong>
							<span id="card-groom-pct" style="font-size: 0.75rem; color: #64748b;">(25%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid #16a34a;">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Los Novios</span>
							<strong id="card-couple-amount" style="font-size: 1.2rem; color: #16a34a; display: block; margin-top: 2px;">1.250 €</strong>
							<span id="card-couple-pct" style="font-size: 0.75rem; color: #64748b;">(5%)</span>
						</div>
					</div>

					<!-- Itemized Traditional Responsibilities Table -->
					<div style="max-height: 280px; overflow-y: auto; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; margin-bottom: 1.5rem;">
						<table style="width: 100%; border-collapse: collapse; font-size: 0.86rem; text-align: left;">
							<thead>
								<tr style="background: var(--muted-paper); border-bottom: 1.5px solid var(--fg-pencil);">
									<th style="padding: 6px 8px;">Partida de Gasto</th>
									<th style="padding: 6px 8px; text-align: right;">Responsable Tradicional</th>
								</tr>
							</thead>
							<tbody>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Finca, Espacio y Banquete</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Familia de la Novia</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Barra Libre y Tarta Nupcial</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Familia de la Novia</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Vestido de Novia, Velo y Pruebas</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Familia de la Novia</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Fotografía y Vídeo Oficial</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Familia de la Novia</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Invitaciones y Papelería</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Familia de la Novia</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Cena de Ensayo / Preboda</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Familia del Novio</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Viaje de Novios (Luna de Miel)</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Familia del Novio</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Tasas de Ceremonia y Oficiante</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Familia del Novio</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Ramo de la Novia y Prendidos</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Familia del Novio</td></tr>
								<tr><td>Alianza de Boda del Novio</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">La Novia</td></tr>
							</tbody>
						</table>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-agreement" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Imprimir Acuerdo (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Exportar a Word
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Resumen Ejecutivo</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Guía Rápida: Protocolo Tradicional vs Reparto Moderno
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					¿Poco tiempo? Aquí tienes la síntesis del protocolo histórico frente a la realidad financiera actual.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📋 Resumen de Costumbres Tradicionales:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Familia Novia: [Vestido + Finca/Banquete + Fotógrafo + Flores + Tarta] • Familia Novio: [Preboda + Luna de Miel + Tasas/Oficiante + Ramo/Prendidos] • Testigos/Amigos: [Despedida de Soltero/a + Vestuario Propio].
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Modelo de Financiación</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Familia de la Novia</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Familia del Novio</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Aportación de los Novios</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Protocolo Tradicional</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">65% – 75% (Banquete, Vestido, Fotos)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">20% – 25% (Preboda, Luna de Miel)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">0% – 10% (Alianzas y regalos)</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Reparto Moderno a 3 Bandas</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">30% – 35% Aportación Fija</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">30% – 35% Aportación Fija</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">30% – 40% (Ahorros propios)</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Novios Autofinanciados (100%)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">0€ (Invitados de Honor)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">0€ (Invitados de Honor)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">100% Independencia Total</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guía Completa de Protocolo Financiero y Reparto Familiar
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Abordar las aportaciones familiares con diplomacia, claridad y respeto mutuo garantiza una planificación feliz y sin tensiones.
				</p>
			</div>

			<!-- Section 1: Traditional vs Modern Evolution -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. De la Antigua Dote al Acuerdo Moderno en Pareja
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Históricamente, la familia de la novia costeaba la boda como parte de las costumbres de dote social. Hoy en día, al casarse con mayor madurez y estabilidad laboral, el esquema ha evolucionado hacia la colaboración voluntaria:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>El Control de la Lista de Invitados:</strong> Tradicionalmente, quien financia el banquete tiene mayor capacidad de decisión sobre los compromisos familiares a invitar.</li>
					<li><strong>Aportación Global vs Pago Directo de Facturas:</strong> Para evitar discrepancias en la elección de proveedores, lo más recomendable es que las familias realicen un regalo conjunto en una cuenta común de los novios.</li>
				</ul>
			</section>

			<!-- Section 2: Rehearsal Dinner & Groomsmen Costs -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Eventos Previos: Despedidas, Preboda y Testigos
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Cada evento asociado tiene sus propios patrocinadores habituales:
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>🎩 Reparto por Momentos Clave:</strong><br />
					• <strong>Cena de Ensayo / Preboda:</strong> Costeada tradicionalmente por la familia del novio.<br />
					• <strong>Despedida de Soltera / Soltero:</strong> Organizada y dividida a partes iguales entre los amigos/as, cubriendo los gastos de los novios.<br />
					• <strong>Vestuario de Damas de Honor y Testigos:</strong> Cada dama y testigo suele costear su propio vestido o alquiler de traje.
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Preguntas Frecuentes sobre el Pago de la Boda
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Quién paga tradicionalmente el vestido de novia?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Tradicionalmente, la novia y su familia se hacen cargo del vestido de novia, velo, arreglos de modistería y complementos.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Qué gastos asume la familia del novio según el protocolo?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						La familia del novio suele cubrir la preboda, las tasas notariales/oficiante, el ramo de la novia, los prendidos florales y la luna de miel.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">¿Quién paga en las segundas nupcias?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						En segundas bodas, la norma unánime es que la pareja financie el 100% de la celebración de forma autónoma.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/es/who-pays-for-what-wedding" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const totalBudgetInput = document.getElementById('total-wedding-budget');
		const presetSelect = document.getElementById('split-model-preset');

		const sliderBride = document.getElementById('slider-bride-pct');
		const sliderGroom = document.getElementById('slider-groom-pct');
		const sliderCouple = document.getElementById('slider-couple-pct');

		const bridePctVal = document.getElementById('slider-bride-pct-val');
		const groomPctVal = document.getElementById('slider-groom-pct-val');
		const couplePctVal = document.getElementById('slider-couple-pct-val');

		const cardBrideAmount = document.getElementById('card-bride-amount');
		const cardBridePct = document.getElementById('card-bride-pct');
		const cardGroomAmount = document.getElementById('card-groom-amount');
		const cardGroomPct = document.getElementById('card-groom-pct');
		const cardCoupleAmount = document.getElementById('card-couple-amount');
		const cardCouplePct = document.getElementById('card-couple-pct');

		const btnPrint = document.getElementById('btn-print-agreement');
		const btnDoc = document.getElementById('btn-export-doc');

		function formatEUR(num) {
			return `${Math.round(num).toLocaleString('es-ES')} €`;
		}

		function calculateSplits() {
			const total = parseFloat(totalBudgetInput.value) || 0;
			const bPct = parseInt(sliderBride.value, 10);
			const gPct = parseInt(sliderGroom.value, 10);
			const cPct = parseInt(sliderCouple.value, 10);

			bridePctVal.textContent = `${bPct}%`;
			groomPctVal.textContent = `${gPct}%`;
			couplePctVal.textContent = `${cPct}%`;

			const bAmount = (total * bPct) / 100;
			const gAmount = (total * gPct) / 100;
			const cAmount = (total * cPct) / 100;

			cardBrideAmount.textContent = formatEUR(bAmount);
			cardBridePct.textContent = `(${bPct}%)`;
			cardGroomAmount.textContent = formatEUR(gAmount);
			cardGroomPct.textContent = `(${gPct}%)`;
			cardCoupleAmount.textContent = formatEUR(cAmount);
			cardCouplePct.textContent = `(${cPct}%)`;
		}

		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'traditional') {
				sliderBride.value = 70;
				sliderGroom.value = 25;
				sliderCouple.value = 5;
			} else if (p === 'modern-3way') {
				sliderBride.value = 30;
				sliderGroom.value = 30;
				sliderCouple.value = 40;
			} else if (p === 'couple-100') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			} else if (p === 'couple-50-50') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			}
			calculateSplits();
		});

		sliderBride.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderBride.value, 10);
			sliderGroom.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderGroom.value;
			calculateSplits();
		});
		sliderGroom.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderGroom.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderBride.value;
			calculateSplits();
		});
		sliderCouple.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderCouple.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderGroom.value = rem - sliderBride.value;
			calculateSplits();
		});

		totalBudgetInput.addEventListener('input', calculateSplits);

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Acuerdo de Reparto de Gastos de Boda — Manage.Wedding</title>
					<style>
						@page { size: 8.5in 11in; margin: 0.5in; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 20pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Acuerdo de Reparto de Gastos de Boda</h1>
					<p>Presupuesto Total Estimado: ${formatEUR(parseFloat(totalBudgetInput.value))} | Modelo: ${presetSelect.options[presetSelect.selectedIndex].text}</p>
					
					<table>
						<thead><tr><th>Parte Contribuyente</th><th>Porcentaje Acordado</th><th>Importe Asignado (€)</th><th>Principales Responsabilidades</th></tr></thead>
						<tbody>
							<tr><td><strong>Familia de la Novia</strong></td><td>${sliderBride.value}%</td><td><strong>${cardBrideAmount.textContent}</strong></td><td>Finca, Banquete, Vestido, Flores, Fotografía e Invitaciones</td></tr>
							<tr><td><strong>Familia del Novio</strong></td><td>${sliderGroom.value}%</td><td><strong>${cardGroomAmount.textContent}</strong></td><td>Preboda, Luna de Miel, Tasas/Oficiante, Ramo y Prendidos</td></tr>
							<tr><td><strong>Los Novios</strong></td><td>${sliderCouple.value}%</td><td><strong>${cardCoupleAmount.textContent}</strong></td><td>Alianzas, Detalles de Invitados y Saldo Restante</td></tr>
							<tr class="total-row"><td>TOTAL PRESUPUESTO</td><td>100%</td><td>${formatEUR(parseFloat(totalBudgetInput.value))}</td><td>Plan Financiero Global de la Boda</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Acuerdo de Reparto de Gastos de Boda</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Acuerdo de Reparto Financiero de Boda</h2>
					<p>Presupuesto Total: ${formatEUR(parseFloat(totalBudgetInput.value))}</p>
					<table>
						<thead><tr><th>Contribuyente</th><th>Cuota (%)</th><th>Importe (€)</th></tr></thead>
						<tbody>
							<tr><td>Familia de la Novia</td><td>${sliderBride.value}%</td><td>${cardBrideAmount.textContent}</td></tr>
							<tr><td>Familia del Novio</td><td>${sliderGroom.value}%</td><td>${cardGroomAmount.textContent}</td></tr>
							<tr><td>Los Novios</td><td>${sliderCouple.value}%</td><td>${cardCoupleAmount.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL</td><td>100%</td><td>${formatEUR(parseFloat(totalBudgetInput.value))}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'acuerdo-reparto-gastos-boda.doc';
			link.click();
		});

		calculateSplits();
	</script>
</Layout>
