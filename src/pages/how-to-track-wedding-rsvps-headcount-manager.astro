---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "How to Track Wedding RSVPs: Headcount & Meal Choices (Private Offline Manager)",
      "description": "The definitive guide to tracking wedding RSVPs. Learn how to manage acceptances and declines, track strict dietary restrictions (allergies, vegan, celiac), handle plus-ones, execute 3-phase follow-up cadences, and export catering manifests.",
      "datePublished": "2026-08-18T00:00:00+00:00",
      "dateModified": "2026-08-18T00:00:00+00:00",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding",
        "logo": {
          "@type": "ImageObject",
          "url": "https://manage.wedding/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://manage.wedding/how-to-track-wedding-rsvps-headcount-manager"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What essential columns should a wedding RSVP tracking spreadsheet contain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A complete RSVP tracking sheet must track: Household Name, Individual Guest Name, RSVP Status (Accepted/Declined/Pending), Entree Choice (Beef/Chicken/Fish/Vegan), Specific Medical Allergies (e.g., Celiac, Anaphylactic Peanut), Plus-One Full Legal Name, Table Number, and Lodging/Hotel Block confirmation."
          }
        },
        {
          "@type": "Question",
          "name": "Is an online wedding RSVP better than paper response cards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Online RSVPs via QR codes or custom forms reduce RSVP friction by 65%, save couples $180-$350 in return postage and printing, eliminate lost mail delays, and automatically enforce plus-one limits so uninvited guests cannot write in extra attendees."
          }
        },
        {
          "@type": "Question",
          "name": "How should couples organize dietary restrictions for their caterer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Submit a dedicated 'Dietary Exception Manifest' to the catering chef 14 days before the wedding that cross-references guest name, exact table number, seat position, and medical allergy severity to prevent cross-contamination in banquet kitchens."
          }
        },
        {
          "@type": "Question",
          "name": "What percentage of wedding guests fail to RSVP by the deadline?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Between 20% and 35% of invited guests miss the initial RSVP deadline. Implementing a structured 3-phase follow-up cadence (Day +2 text, Day +5 phone call, Day +8 final cutoff notice) recovers 95% of missing responses within one week."
          }
        },
        {
          "@type": "Question",
          "name": "How do you handle uninvited plus-ones written on RSVP cards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Call the guest immediately with warm but firm phrasing: 'We were so excited to receive your RSVP! Due to our venue's strict capacity restrictions, we are unfortunately unable to accommodate additional guests beyond those addressed on the invitation envelope. We can't wait to celebrate with you!'"
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="How to Track Wedding RSVPs: Headcount & Meal Choices (Private Offline Manager) | Manage.Wedding"
  description="Master wedding RSVP tracking. Organize meal choices, track strict dietary restrictions, manage plus-ones, and export catering manifests with private offline tools."
  schema={schema}
>
  <main class="container" style="padding-top: 2rem; padding-bottom: 5rem; max-width: 940px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
        { name: "How to Track Wedding RSVPs" }
      ]}
    />

    <!-- Header Section -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #eff6ff; color: #1e40af; padding: 4px 14px; border-radius: 20px; border: 1.5px solid #3b82f6; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <span>📝</span>
        <span>RSVP Logistics & Banquet Data Management</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2rem, 3.8vw, 2.85rem); color: var(--fg-pencil); line-height: 1.22; margin-bottom: 1rem;">
        How to Track Wedding RSVPs: Headcount & Meal Choices <span style="color: #1d4ed8; font-style: italic;">(Private Offline Manager)</span>
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600; flex-wrap: wrap;">
        <span>Published: August 2026</span>
        <span>•</span>
        <span>14 min read</span>
        <span>•</span>
        <span>Comprehensive Master Guide</span>
        <span>•</span>
        <span>By Manage.Wedding Editorial Team</span>
      </div>
    </header>

    <!-- AI Direct Citation Callout (BLUF) -->
    <div style="background: #eff6ff; border: 2px solid #2563eb; border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: 3px 3px 0px #2563eb;">
      <div style="font-size: 0.82rem; font-weight: 800; color: #1e40af; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem;">
        🎯 Standard RSVP Data Architecture (BLUF)
      </div>
      <p class="font-body" style="font-size: 1.15rem; color: #1e3a8a; font-weight: 600; line-height: 1.5; margin: 0;">
        Track wedding RSVPs using a standardized matrix with columns for Household Name, RSVP Status (Accepted/Declined), Meal Selection, Dietary Restrictions, and Plus-One names.
      </p>
    </div>

    <!-- Interactive Tool Callout Hero -->
    <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
          Track RSVPs & Meal Choices in Private Local Storage
        </h3>
        <p class="font-body" style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
          Add guests, log entree selections, filter dietary flags, and export complete CSV reports directly to your caterer.
        </p>
      </div>
      <a href="/rsvp-tracker" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 10px 22px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.5rem;">
        <span>Open RSVP Tracker</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Main Content Body -->
    <article class="font-body" style="font-size: 1.08rem; line-height: 1.8; color: var(--fg-pencil);">
      
      <!-- Section 1: The High-Cost Reality of Disorganized RSVPs -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2rem 0 1rem;">
        The Real Financial & Operational Cost of Disorganized RSVP Tracking
      </h2>
      <p>
        During the final 45 days leading up to a wedding, RSVPs arrive unpredictably across multiple fragmented channels. You might receive a formal paper response card in the mail on Tuesday, a casual text message to the groom's mother on Wednesday, an Instagram direct message from a college roommate on Friday, and a verbal confirmation over Sunday family dinner.
      </p>
      <p>
        When guest responses are scattered across inbox threads, phone notes, and paper scraps without a single authoritative database, catastrophic errors occur during the final week of planning:
      </p>
      <ul>
        <li>
          <strong>Paying for Phantom Guests ($1,200+ Waste):</strong> Plated wedding catering averages $110 to $185 per guest when tax, tip, and venue service fees are factored in. If eight guests casually text that they cannot attend but their declines are never recorded in your master spreadsheet, you will pay your caterer for eight empty chairs and untouched plates—costing you between $900 and $1,500 in wasted money.
        </li>
        <li>
          <strong>Catering Kitchen Line Stalls:</strong> Commercial banquet chefs operate on precision line prep. If your contract specifies 65 Filet Mignons and 45 Salmon filets, but five unlogged guests arrive demanding beef, the kitchen must scramble to thaw and sear emergency proteins. This delays dinner service by 30 to 45 minutes, compressing your dance floor timeline.
        </li>
        <li>
          <strong>Severe Allergy Liability:</strong> When guests with celiac disease, peanut allergies, or shellfish sensitivities submit notes casually, those notes frequently fail to reach the executive chef. In a banquet setting, cross-contamination is a serious medical emergency.
        </li>
        <li>
          <strong>Escort Card & Table Assignment Chaos:</strong> If unconfirmed plus-ones show up on the wedding day without an assigned table or escort card, your day-of coordinator must pull spare chairs from banquet storage, causing delays and visible awkwardness at the entrance.
        </li>
      </ul>

      <!-- Infographic Box: 4-Stage Lifecycle -->
      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 1.75rem; margin: 2.5rem 0; box-shadow: 4px 4px 0px var(--fg-pencil);">
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
          <span>📊</span>
          <span>The 4-Stage Wedding RSVP Lifecycle</span>
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem;">
          <div style="background: #fff; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 1.25rem; text-align: center;">
            <div style="font-weight: 800; font-size: 0.85rem; color: #1e40af; text-transform: uppercase;">Stage 1: Ingestion</div>
            <div style="font-size: 1.15rem; font-weight: 700; margin: 0.35rem 0;">Weeks -10 to -5</div>
            <div style="font-size: 0.85rem; color: #64748b; line-height: 1.5;">Invitations drop in mailboxes. Online QR portals go live. 60% to 70% of responses arrive.</div>
          </div>
          <div style="background: #fff; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 1.25rem; text-align: center;">
            <div style="font-weight: 800; font-size: 0.85rem; color: #d97706; text-transform: uppercase;">Stage 2: Chase Cadence</div>
            <div style="font-size: 1.15rem; font-weight: 700; margin: 0.35rem 0;">Weeks -4 to -3</div>
            <div style="font-size: 0.85rem; color: #64748b; line-height: 1.5;">RSVP deadline passes. 3-phase follow-up protocol tracks down the remaining 30% of guests.</div>
          </div>
          <div style="background: #fff; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 1.25rem; text-align: center;">
            <div style="font-weight: 800; font-size: 0.85rem; color: #dc2626; text-transform: uppercase;">Stage 3: Headcount Lock</div>
            <div style="font-size: 1.15rem; font-weight: 700; margin: 0.35rem 0;">Week -2 (14 Days)</div>
            <div style="font-size: 0.85rem; color: #64748b; line-height: 1.5;">Submit legally binding numbers to caterer. Meal breakdowns and dietary manifests locked.</div>
          </div>
          <div style="background: #fff; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 1.25rem; text-align: center;">
            <div style="font-weight: 800; font-size: 0.85rem; color: #16a34a; text-transform: uppercase;">Stage 4: Banquet Manifest</div>
            <div style="font-size: 1.15rem; font-weight: 700; margin: 0.35rem 0;">Week -1 (7 Days)</div>
            <div style="font-size: 0.85rem; color: #64748b; line-height: 1.5;">Print alphabetical escort cards, table charts, and chef allergy warning tickets.</div>
          </div>
        </div>
      </div>

      <!-- Section 2: The Standard 7-Field RSVP Tracking Schema -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The Master 7-Field RSVP Tracking Data Dictionary
      </h2>
      <p>
        To prevent miscommunication between your wedding planner, stationer, and catering banquet captain, every guest record in your database should track these seven standardized data points:
      </p>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Field Name</th>
              <th style="padding: 12px 14px; font-weight: 800;">Data Type & Format</th>
              <th style="padding: 12px 14px; font-weight: 800;">Example Record</th>
              <th style="padding: 12px 14px; font-weight: 800;">Operational Purpose</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">1. Household Unit</td>
              <td style="padding: 12px 14px; color: #475569;">Text (Formal)</td>
              <td style="padding: 12px 14px; font-family: monospace;">Miller, David & Sarah</td>
              <td style="padding: 12px 14px; color: #475569;">Groups couples/families for envelope addressing & postage</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700;">2. Guest Full Name</td>
              <td style="padding: 12px 14px; color: #475569;">Text (Individual)</td>
              <td style="padding: 12px 14px; font-family: monospace;">Sarah Miller</td>
              <td style="padding: 12px 14px; color: #475569;">Used for personalized place cards and escort board alphabetical lookup</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">3. RSVP Status</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">Enum (Accepted / Declined / Pending)</td>
              <td style="padding: 12px 14px; font-family: monospace; color: #16a34a;">Accepted</td>
              <td style="padding: 12px 14px; color: #475569;">Real-time headcount tallies and attrition forecasting</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700;">4. Entree Selection</td>
              <td style="padding: 12px 14px; color: #475569;">Menu Code / Text</td>
              <td style="padding: 12px 14px; font-family: monospace;">Braised Short Rib</td>
              <td style="padding: 12px 14px; color: #475569;">Submitted directly to banquet chef for meat orders</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #fef2f2;">
              <td style="padding: 12px 14px; font-weight: 700;">5. Medical Allergy Flag</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #dc2626;">Free Text / Category</td>
              <td style="padding: 12px 14px; font-family: monospace; color: #dc2626;">Strict Celiac (Gluten Free)</td>
              <td style="padding: 12px 14px; color: #7f1d1d;">Chef prepares dedicated sterilized cookware plate</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">6. Plus-One Status</td>
              <td style="padding: 12px 14px; color: #475569;">Boolean / Named Link</td>
              <td style="padding: 12px 14px; font-family: monospace;">Named (James Miller)</td>
              <td style="padding: 12px 14px; color: #475569;">Prevents unnamed '+1' placeholders on escort cards</td>
            </tr>
            <tr style="background: #eff6ff;">
              <td style="padding: 12px 14px; font-weight: 700;">7. Table Assignment</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #1e40af;">Integer / Table Name</td>
              <td style="padding: 12px 14px; font-family: monospace; color: #1e40af;">Table 4 (Round 60")</td>
              <td style="padding: 12px 14px; color: #1e40af;">Mapped into room clearance and banquet server stations</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 3: Paper Cards vs QR Codes vs Wedding Websites -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Paper Response Cards vs QR Codes vs Digital Portals: Complete Breakdown
      </h2>
      <p>
        Couples today have three distinct options for collecting RSVPs. Understanding the tradeoffs in response velocity, error rates, and costs ensures you pick the best system for your guest list demographics:
      </p>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Method</th>
              <th style="padding: 12px 14px; font-weight: 800;">Response Speed</th>
              <th style="padding: 12px 14px; font-weight: 800;">Data Error / Illegibility Rate</th>
              <th style="padding: 12px 14px; font-weight: 800;">Cost (100 Households)</th>
              <th style="padding: 12px 14px; font-weight: 800;">Best For</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">📬 Paper Response Card & Stamp</td>
              <td style="padding: 12px 14px; color: #475569;">18 – 28 Days</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #dc2626;">12% – 18% (Messy handwriting / no name written)</td>
              <td style="padding: 12px 14px; font-weight: 600;">$220 – $380</td>
              <td style="padding: 12px 14px; color: #475569;">Black-tie formal weddings; elderly guest lists</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f0fdf4;">
              <td style="padding: 12px 14px; font-weight: 700;">📱 QR Code on Enclosure Insert</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">4 – 10 Days</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">&lt;1% (Instant validation)</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">$35 – $65</td>
              <td style="padding: 12px 14px; color: #16a34a; font-weight: 600;">Fastest response rate; tech-friendly crowds</td>
            </tr>
            <tr style="background: #fff;">
              <td style="padding: 12px 14px; font-weight: 700;">💻 Direct URL Submission</td>
              <td style="padding: 12px 14px; color: #475569;">7 – 14 Days</td>
              <td style="padding: 12px 14px; color: #475569;">2% – 4% (Typos in URL)</td>
              <td style="padding: 12px 14px; font-weight: 600;">$0 (Free)</td>
              <td style="padding: 12px 14px; color: #475569;">Budget-conscious modern couples</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 4: Dietary Alert Protocol -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The 3-Tier Dietary Alert Protocol: Medical vs Lifestyle vs Religious
      </h2>
      <p>
        Banquet kitchens prepare hundreds of hot plates in tight 20-minute plating windows. To prevent life-threatening allergic reactions while avoiding unneeded special kitchen surcharges, classify guest dietary requests into three distinct tiers:
      </p>

      <div style="display: flex; flex-direction: column; gap: 1rem; margin: 1.5rem 0 2.5rem;">
        <div style="background: #fef2f2; border: 1.5px solid #ef4444; border-radius: 8px; padding: 1.25rem;">
          <h4 class="font-heading" style="font-size: 1.15rem; color: #991b1b; margin: 0 0 0.35rem;">
            🚨 Tier 1: Anaphylactic & Medical Safety (Critical Priority)
          </h4>
          <p style="font-size: 0.95rem; color: #7f1d1d; margin: 0; line-height: 1.6;">
            Includes diagnosed Celiac disease (zero gluten contact), airborne peanut/tree nut allergies, severe shellfish anaphylaxis, and dairy allergies. These require an isolated, sterilized prep surface in the kitchen. Place cards for these guests must have an explicit colored icon or sticker indicating medical clearance to servers.
          </p>
        </div>

        <div style="background: #f0fdf4; border: 1.5px solid #22c55e; border-radius: 8px; padding: 1.25rem;">
          <h4 class="font-heading" style="font-size: 1.15rem; color: #166534; margin: 0 0 0.35rem;">
            🌱 Tier 2: Lifestyle & Ethical Diets (Menu Substitutions)
          </h4>
          <p style="font-size: 0.95rem; color: #14532d; margin: 0; line-height: 1.6;">
            Includes Vegetarian, Vegan, Pescatarian, and Dairy-Free by choice. Most professional wedding caterers offer a dedicated vegan entree (e.g., roasted butternut squash risotto) that satisfies all Tier 2 guests uniformly without requiring custom individual plating.
          </p>
        </div>

        <div style="background: #eff6ff; border: 1.5px solid #3b82f6; border-radius: 8px; padding: 1.25rem;">
          <h4 class="font-heading" style="font-size: 1.15rem; color: #1e40af; margin: 0 0 0.35rem;">
            🕊️ Tier 3: Religious & Cultural Observances (Certified Sourcing)
          </h4>
          <p style="font-size: 0.95rem; color: #1e3a8a; margin: 0; line-height: 1.6;">
            Includes Glatt Kosher and Halal meal requests. Kosher meals are typically ordered from a certified external kosher catering kitchen and delivered double-wrapped with sealed disposable cutlery to maintain rabbinical dietary law.
          </p>
        </div>
      </div>

      <!-- Section 5: The 3-Phase Follow-Up Cadence & Scripts -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The 3-Phase Follow-Up Cadence: Word-for-Word Scripts
      </h2>
      <p>
        When your RSVP deadline passes, <strong>an average of 25% to 35% of guests will still have not responded</strong>. Chasing non-responders requires an escalating communication schedule that stays polite while maintaining strict deadlines:
      </p>

      <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 1.35rem; margin-bottom: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
          <span style="font-weight: 800; font-size: 0.9rem; color: #1e40af; text-transform: uppercase;">Phase 1: Casual Friendly Text (Day +2 Post-Deadline)</span>
          <span style="font-size: 0.8rem; background: #e0e7ff; color: #3730a3; padding: 2px 8px; border-radius: 12px; font-weight: 700;">Text / DM</span>
        </div>
        <p style="font-style: italic; margin: 0; font-size: 0.95rem; color: var(--fg-pencil); line-height: 1.6;">
          "Hey [Name]! Hope you're having a wonderful week. We're finalizing our catering and seating details and wanted to make sure our invitation didn't get lost in the mail. Are you able to make it to celebrate with us on [Date]? Let us know your meal selection by Friday at [Wedding URL] so we can make sure you're taken care of!"
        </p>
      </div>

      <div style="background: #fffbeb; border: 1.5px solid #fcd34d; border-radius: 8px; padding: 1.35rem; margin-bottom: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
          <span style="font-weight: 800; font-size: 0.9rem; color: #92400e; text-transform: uppercase;">Phase 2: Direct Phone Call / Parent Envoy (Day +5 Post-Deadline)</span>
          <span style="font-size: 0.8rem; background: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 12px; font-weight: 700;">Phone Call</span>
        </div>
        <p style="font-style: italic; margin: 0; font-size: 0.95rem; color: #78350f; line-height: 1.6;">
          "Hi [Name], I'm calling to check in on our wedding headcount. Our venue needs our final dinner numbers this week. Can I mark you down for attending, and did you prefer the salmon or the short rib?" <em>(Tip: For extended aunts, uncles, and family friends, have your parents place this call directly).</em>
        </p>
