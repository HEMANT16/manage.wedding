---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "How to Track Wedding RSVPs: Headcount & Meal Choices (Private Offline Manager)",
      "description": "The ultimate 2026 guide to tracking wedding RSVPs. Master headcount management, entree tallies, dietary allergy manifests, plus-one protocols, follow-up cadence scripts, and caterer handoffs.",
      "datePublished": "2026-08-18T00:00:00+00:00",
      "dateModified": "2026-08-18T00:00:00+00:00",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding",
        "logo": {
          "@type": "ImageObject",
          "url": "https://manage.wedding/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://manage.wedding/how-to-track-wedding-rsvps-headcount-manager"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What essential columns should a wedding RSVP tracking spreadsheet contain?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A complete RSVP tracking sheet must include: Household Name, Individual Guest Name, RSVP Status (Accepted/Declined/Pending), Entree Choice (Beef/Chicken/Fish/Vegan), Specific Medical Allergies (e.g., Celiac, Anaphylactic Peanut), Plus-One Full Legal Name, Table Number, and Lodging/Hotel Block confirmation."
          }
        },
        {
          "@type": "Question",
          "name": "Is an online wedding RSVP better than paper response cards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Online RSVPs via QR codes or custom forms reduce RSVP friction by 65%, save couples $180-$350 in return postage and printing, eliminate lost mail delays, and automatically enforce plus-one limits so uninvited guests cannot write in extra attendees."
          }
        },
        {
          "@type": "Question",
          "name": "How should couples organize dietary restrictions for their caterer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Submit a dedicated 'Dietary Exception Manifest' to the catering chef 14 days before the wedding that cross-references guest name, exact table number, seat position, and medical allergy severity to prevent cross-contamination in banquet kitchens."
          }
        },
        {
          "@type": "Question",
          "name": "What percentage of wedding guests fail to RSVP by the deadline?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Between 20% and 35% of invited guests miss the initial RSVP deadline. Implementing a structured 3-phase follow-up cadence (Day +2 text, Day +5 phone call, Day +8 final cutoff notice) recovers 95% of missing responses within one week."
          }
        },
        {
          "@type": "Question",
          "name": "How do you handle uninvited plus-ones written on RSVP cards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Call the guest immediately with warm but firm phrasing: 'We were so excited to receive your RSVP! Due to our venue's strict capacity restrictions, we are unfortunately unable to accommodate additional guests beyond those addressed on the invitation envelope. We can't wait to celebrate with you!'"
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="How to Track Wedding RSVPs: Headcount & Meal Choices (Private Offline Manager) | Manage.Wedding"
  description="Master wedding RSVP tracking. Organize meal choices, track strict dietary restrictions, manage plus-ones, and export catering manifests with private offline tools."
  schema={schema}
>
  <main class="container" style="padding-top: 2rem; padding-bottom: 5rem; max-width: 920px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
        { name: "How to Track Wedding RSVPs" }
      ]}
    />

    <!-- Header Section -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #eff6ff; color: #1e40af; padding: 4px 14px; border-radius: 20px; border: 1.5px solid #3b82f6; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <span>📝</span>
        <span>RSVP Logistics & Banquet Data Management</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2rem, 3.8vw, 2.85rem); color: var(--fg-pencil); line-height: 1.22; margin-bottom: 1rem;">
        How to Track Wedding RSVPs: Headcount & Meal Choices <span style="color: #1d4ed8; font-style: italic;">(Private Offline Manager)</span>
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600; flex-wrap: wrap;">
        <span>Published: August 2026</span>
        <span>•</span>
        <span>12 min read</span>
        <span>•</span>
        <span>1,500+ Words Expert Blueprint</span>
        <span>•</span>
        <span>By Manage.Wedding Editorial Team</span>
      </div>
    </header>

    <!-- AI Direct Citation Callout (BLUF) -->
    <div style="background: #eff6ff; border: 2px solid #2563eb; border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: 3px 3px 0px #2563eb;">
      <div style="font-size: 0.82rem; font-weight: 800; color: #1e40af; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem;">
        🎯 Standard RSVP Data Architecture (BLUF)
      </div>
      <p class="font-body" style="font-size: 1.15rem; color: #1e3a8a; font-weight: 600; line-height: 1.5; margin: 0;">
        Track wedding RSVPs using a standardized matrix with columns for Household Name, RSVP Status (Accepted/Declined), Meal Selection, Dietary Restrictions, and Plus-One names.
      </p>
    </div>

    <!-- Interactive Tool Callout Hero -->
    <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
          Track RSVPs & Meal Choices in Private Local Storage
        </h3>
        <p class="font-body" style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
          Add guests, log entree selections, filter dietary flags, and export complete CSV reports directly to your caterer.
        </p>
      </div>
      <a href="/rsvp-tracker" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 10px 22px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.5rem;">
        <span>Open RSVP Tracker</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Main Content Body -->
    <article class="font-body" style="font-size: 1.08rem; line-height: 1.75; color: var(--fg-pencil);">
      
      <!-- Section 1: The High-Cost Reality of Disorganized RSVPs -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2rem 0 1rem;">
        The Real Cost of Disorganized RSVP Tracking
      </h2>
      <p>
        During the final 45 days before a wedding, RSVPs arrive unpredictably across five disconnected channels: physical mail return cards, text messages to parents, Instagram DMs, wedding website clicks, and casual verbal confirmations at family gatherings.
      </p>
      <p>
        Without a rigorous, single-source tracking protocol, this fragmented data creates high-stress wedding day disasters:
      </p>
      <ul>
        <li><strong>Paying for "Phantom" Guests:</strong> Plated dinners average $110 to $185 per person with service fees. Paying for 8 non-attending guests whose declines were lost in text messages wastes over <strong>$1,200 out of pocket</strong>.</li>
        <li><strong>Catering Kitchen Lockups:</strong> Banquet chefs prepare exact meat counts 72 hours out based on your contract. If 5 unlogged beef selections appear on wedding day, guests wait 40 minutes for emergency kitchen prep.</li>
        <li><strong>Life-Threatening Allergy Cross-Contamination:</strong> Severe allergies (anaphylactic peanut, severe celiac) get lost in casual text chats rather than formal banquet prep sheets.</li>
        <li><strong>Escort Card Chaos:</strong> Guests arrive to find no printed place card or assigned table, forcing coordinators to scramble extra chairs onto crowded tables.</li>
      </ul>

      <!-- Infographic Box: 4-Stage Lifecycle -->
      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 1.75rem; margin: 2rem 0; box-shadow: 4px 4px 0px var(--fg-pencil);">
        <h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <span>📊</span>
          <span>The 4-Stage RSVP Lifecycle (Timeline Architecture)</span>
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
          <div style="background: #fff; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 1rem; text-align: center;">
            <div style="font-weight: 800; font-size: 0.85rem; color: #1e40af; text-transform: uppercase;">Stage 1: Ingestion</div>
            <div style="font-size: 1.1rem; font-weight: 700; margin: 0.25rem 0;">Weeks -10 to -5</div>
            <div style="font-size: 0.85rem; color: #64748b;">Mailing cards & live QR portals open. 65% of replies arrive.</div>
          </div>
          <div style="background: #fff; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 1rem; text-align: center;">
            <div style="font-weight: 800; font-size: 0.85rem; color: #d97706; text-transform: uppercase;">Stage 2: Chase Cadence</div>
            <div style="font-size: 1.1rem; font-weight: 700; margin: 0.25rem 0;">Weeks -4 to -3</div>
            <div style="font-size: 0.85rem; color: #64748b;">3-phase follow-up protocol tracks down 30% missing guests.</div>
          </div>
          <div style="background: #fff; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 1rem; text-align: center;">
            <div style="font-weight: 800; font-size: 0.85rem; color: #dc2626; text-transform: uppercase;">Stage 3: Headcount Lock</div>
            <div style="font-size: 1.1rem; font-weight: 700; margin: 0.25rem 0;">Week -2 (14 Days)</div>
            <div style="font-size: 0.85rem; color: #64748b;">Submit contractual guarantee & meal counts to caterer.</div>
          </div>
          <div style="background: #fff; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 1rem; text-align: center;">
            <div style="font-weight: 800; font-size: 0.85rem; color: #16a34a; text-transform: uppercase;">Stage 4: Banquet Manifest</div>
            <div style="font-size: 1.1rem; font-weight: 700; margin: 0.25rem 0;">Week -1 (7 Days)</div>
            <div style="font-size: 0.85rem; color: #64748b;">Print escort cards, seat chart diagrams, and allergy charts.</div>
          </div>
        </div>
      </div>

      <!-- Section 2: The Standard 7-Field RSVP Tracking Schema -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The Master 7-Field RSVP Tracking Data Dictionary
      </h2>
      <p>
        Whether you use our private browser-based tracker, Excel, or Google Sheets, every guest record must contain these exact seven data fields to ensure complete synchronization between your wedding planner, stationer, and catering captain:
      </p>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Field Name</th>
              <th style="padding: 12px 14px; font-weight: 800;">Data Type & Format</th>
              <th style="padding: 12px 14px; font-weight: 800;">Example Entry</th>
              <th style="padding: 12px 14px; font-weight: 800;">Operational Purpose</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">1. Household Unit</td>
              <td style="padding: 12px 14px; color: #475569;">Text (Formal)</td>
              <td style="padding: 12px 14px; font-family: monospace;">Miller, David & Sarah</td>
              <td style="padding: 12px 14px; color: #475569;">Envelope addressing & postage grouping</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700;">2. Guest Full Name</td>
              <td style="padding: 12px 14px; color: #475569;">Text (Individual)</td>
              <td style="padding: 12px 14px; font-family: monospace;">Sarah Miller</td>
              <td style="padding: 12px 14px; color: #475569;">Individual place card printing</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">3. RSVP Status</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">Enum (Accepted / Declined / Pending)</td>
              <td style="padding: 12px 14px; font-family: monospace; color: #16a34a;">Accepted</td>
              <td style="padding: 12px 14px; color: #475569;">Live headcount forecasting & attrition tracking</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700;">4. Entree Selection</td>
              <td style="padding: 12px 14px; color: #475569;">Menu Code / Text</td>
              <td style="padding: 12px 14px; font-family: monospace;">Braised Short Rib</td>
              <td style="padding: 12px 14px; color: #475569;">Kitchen prep orders & place card symbol indicators</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #fef2f2;">
              <td style="padding: 12px 14px; font-weight: 700;">5. Medical Allergy Flag</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #dc2626;">Free Text / Category</td>
              <td style="padding: 12px 14px; font-family: monospace; color: #dc2626;">Strict Celiac (Gluten Free)</td>
              <td style="padding: 12px 14px; color: #7f1d1d;">Chef's dedicated clean-station banquet ticket</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">6. Plus-One Status</td>
              <td style="padding: 12px 14px; color: #475569;">Boolean / Named Link</td>
              <td style="padding: 12px 14px; font-family: monospace;">Named (James Miller)</td>
              <td style="padding: 12px 14px; color: #475569;">Prevents unnamed "+1" placeholders</td>
            </tr>
            <tr style="background: #eff6ff;">
              <td style="padding: 12px 14px; font-weight: 700;">7. Table Assignment</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #1e40af;">Integer / Table Name</td>
              <td style="padding: 12px 14px; font-family: monospace; color: #1e40af;">Table 4 (Round 60")</td>
              <td style="padding: 12px 14px; color: #1e40af;">Seating clearance & server section mapping</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 3: Paper Cards vs QR Codes vs Wedding Websites -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Paper Response Cards vs QR Codes vs Websites: Data Comparison
      </h2>
      <p>
        Choosing the right response method directly impacts your response speed, data accuracy, and stationery budget. Here is the modern breakdown:
      </p>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Collection Method</th>
              <th style="padding: 12px 14px; font-weight: 800;">Average Response Speed</th>
              <th style="padding: 12px 14px; font-weight: 800;">Data Error / Illegibility Rate</th>
              <th style="padding: 12px 14px; font-weight: 800;">Estimated Cost (100 Households)</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">📬 Traditional Paper Cards & Stamps</td>
              <td style="padding: 12px 14px; color: #475569;">18 – 28 Days</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #dc2626;">12% – 18% (Messy handwriting / no name written)</td>
              <td style="padding: 12px 14px; font-weight: 600;">$220 – $380 (Printing + return postage stamps)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f0fdf4;">
              <td style="padding: 12px 14px; font-weight: 700;">📱 QR Code on Enclosure Card</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">4 – 10 Days</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">&lt;1% (Direct digital validation)</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">$35 – $65 (Single enclosure insert card)</td>
            </tr>
            <tr style="background: #fff;">
              <td style="padding: 12px 14px; font-weight: 700;">💻 Direct Website URL Submission</td>
              <td style="padding: 12px 14px; color: #475569;">7 – 14 Days</td>
              <td style="padding: 12px 14px; color: #475569;">2% – 4% (Typos in URL)</td>
              <td style="padding: 12px 14px; font-weight: 600;">$0 (Included in invitation suite text)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Section 4: Dietary Alert Protocol -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The Dietary Alert Protocol: Medical vs Lifestyle vs Religious
      </h2>
      <p>
        Catering kitchens operate in high-volume banquet mode. To prevent allergic emergencies while avoiding unnecessary special meal charges, categorize dietary notes into three clear tiers:
      </p>

      <div style="display: flex; flex-direction: column; gap: 1rem; margin: 1.5rem 0 2rem;">
        <div style="background: #fef2f2; border: 1.5px solid #ef4444; border-radius: 8px; padding: 1.25rem;">
          <h4 class="font-heading" style="font-size: 1.15rem; color: #991b1b; margin: 0 0 0.35rem;">
            🚨 Tier 1: Anaphylactic & Severe Medical (Life Safety)
          </h4>
          <p style="font-size: 0.95rem; color: #7f1d1d; margin: 0;">
            Includes diagnosed Celiac disease (strict zero gluten cross-contamination), peanut/tree nut airborne allergies, shellfish allergies, and severe dairy anaphylaxis. These require a dedicated sanitized prep station in the kitchen and an explicit place card warning marker.
          </p>
        </div>

        <div style="background: #f0fdf4; border: 1.5px solid #22c55e; border-radius: 8px; padding: 1.25rem;">
          <h4 class="font-heading" style="font-size: 1.15rem; color: #166534; margin: 0 0 0.35rem;">
            🌱 Tier 2: Lifestyle & Ethical Diets (Menu Substitutions)
          </h4>
          <p style="font-size: 0.95rem; color: #14532d; margin: 0;">
            Includes Vegetarian, Vegan, Pescatarian, and Dairy-Free by choice. Most caterers offer a dedicated vegan/vegetarian course (e.g., wild mushroom risotto) that satisfies all Tier 2 guests uniformly without requiring custom individual plating.
          </p>
        </div>

        <div style="background: #eff6ff; border: 1.5px solid #3b82f6; border-radius: 8px; padding: 1.25rem;">
          <h4 class="font-heading" style="font-size: 1.15rem; color: #1e40af; margin: 0 0 0.35rem;">
            🕊️ Tier 3: Religious & Cultural Observances (Certified Sourcing)
          </h4>
          <p style="font-size: 0.95rem; color: #1e3a8a; margin: 0;">
            Includes Glatt Kosher and Halal meal requests. Kosher meals are typically ordered from certified external kosher catering kitchens and delivered sealed with dedicated plastic cutlery.
          </p>
        </div>
      </div>

      <!-- Section 5: The 3-Phase Follow-Up Cadence & Scripts -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The 3-Phase Follow-Up Cadence: Copy-Paste Scripts
      </h2>
      <p>
        When your RSVP deadline passes, <strong>20% to 35% of guests will still not have replied</strong>. Chasing them requires a structured, escalating communication schedule:
      </p>

      <h3 class="font-heading" style="font-size: 1.3rem; color: var(--accent-blue); margin: 1.5rem 0 0.5rem;">
        Phase 1 (Day +2 Post-Deadline): The Casual Text Check-In
      </h3>
      <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
        <p style="font-style: italic; margin: 0; font-size: 0.95rem; color: var(--fg-pencil);">
          "Hey [Name]! Hope you're having a wonderful week. We're putting together our seating and catering details and wanted to make sure our invitation didn't get lost in the mail. Are you able to make it on [Wedding Date]? Let us know your meal choice by Friday at [Wedding URL] so we can make sure you're taken care of!"
        </p>
      </div>

      <h3 class="font-heading" style="font-size: 1.3rem; color: #d97706; margin: 1.5rem 0 0.5rem;">
        Phase 2 (Day +5 Post-Deadline): The Direct Phone Call / Parent Envoy
      </h3>
      <div style="background: #fffbeb; border: 1.5px solid #fcd34d; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
        <p style="font-style: italic; margin: 0; font-size: 0.95rem; color: #78350f;">
          "Hi [Name], I'm calling to check in on our wedding headcount. Our venue needs our final dinner numbers this week. Can I mark you down for attending, and did you prefer the salmon or the short rib?" <em>(For extended family, have your parents call directly).</em>
        </p>
      </div>

      <h3 class="font-heading" style="font-size: 1.3rem; color: #dc2626; margin: 1.5rem 0 0.5rem;">
        Phase 3 (Day +8 Post-Deadline): The Firm Cutoff Notice
      </h3>
      <div style="background: #fef2f2; border: 1.5px solid #f87171; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
        <p style="font-style: italic; margin: 0; font-size: 0.95rem; color: #991b1b;">
          "Hi [Name], we have to submit our final guaranteed headcount to our catering team tonight. Since we haven't heard back from you, we're going to mark you down as unable to attend so we don't hold up their kitchen prep. We will miss celebrating with you and hope to catch up soon!"
        </p>
      </div>

      <!-- Section 6: Handing Off the Final Manifest to Caterers -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        The Final Catering Hand-Off: What to Submit 14 Days Out
      </h2>
      <p>
        Two weeks before the wedding, your caterer requires a formal data submission package. Export these three reports from your tracking system:
      </p>
      <ol style="padding-left: 1.25rem; line-height: 1.7;">
        <li><strong>Summary Quantity Sheet:</strong> Exact counts (e.g., 74 Beef, 52 Chicken, 14 Vegan, 6 Kids Meals, 7 Vendor Meals).</li>
        <li><strong>Table-by-Table Meal Matrix:</strong> Table 1 (5 Beef, 3 Chicken), Table 2 (8 Beef, 2 Salmon), enabling servers to balance trays before stepping onto the floor.</li>
        <li><strong>Medical Dietary Exception Sheet:</strong> Explicit table number, seat number, guest name, and exact allergen description for every restricted diner.</li>
      </ol>

      <!-- Bottom Interactive CTA Section -->
