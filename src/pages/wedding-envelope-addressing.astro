---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/wedding-envelope-addressing/#webapp",
      "name": "Wedding Envelope Address Formatter & Etiquette Generator",
      "url": "https://manage.wedding/wedding-envelope-addressing",
      "description": "Free wedding envelope address generator and etiquette formatter. Format A7 outer envelopes, A2 RSVP envelopes, and inner envelopes with proper formal titles (doctors, plus-ones, families). Export to printable PDF, Word, and CSV.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Address Wedding Envelopes with Proper Etiquette",
      "description": "Step-by-step etiquette guide to addressing formal outer envelopes, inner envelopes, and RSVP reply cards.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Select Envelope Size (A7 vs A2)",
          "text": "Choose A7 (5.25\" x 7.25\") for standard 5\" x 7\" outer invitation envelopes, or A2 (4.375\" x 5.75\") for RSVP reply cards."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Apply Formal Title Etiquette",
          "text": "Select the correct social or professional honorific (e.g. Mr. and Mrs., Doctor and Mr., Ms. and Mr. for different last names, or and Guest for plus-ones)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Spell Out Full Street Names & State Names",
          "text": "Traditional formal wedding etiquette requires spelling out Street, Avenue, Boulevard, and full state names (e.g. California rather than CA)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Format Return Address on Back Flap or Top-Left",
          "text": "Print your return address centered on the back flap of outer envelopes, or in the upper-left corner for standard postal processing."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the standard size for a wedding invitation envelope?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The standard size for a wedding invitation outer envelope is A7, measuring 5.25 inches by 7.25 inches (133mm x 184mm). It is designed to hold a standard 5 inch by 7 inch wedding invitation card along with enclosures."
          }
        },
        {
          "@type": "Question",
          "name": "How do you address a wedding envelope to an unmarried couple living together?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Address each person on a separate line in alphabetical order by last name: 'Ms. Jessica Taylor' on line one, and 'Mr. David Miller' on line two, followed by their shared street address."
          }
        },
        {
          "@type": "Question",
          "name": "How do you address a wedding envelope when the wife is a doctor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because professional medical titles outrank social titles, the doctor's name is listed first: 'Doctor Katherine Evans and Mr. Robert Evans' (or 'Dr. Katherine Evans and Mr. Robert Evans'). If both are doctors, write 'The Doctors Evans' or 'Drs. Katherine and Robert Evans'."
          }
        },
        {
          "@type": "Question",
          "name": "Should states and street directions be abbreviated on wedding envelopes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In formal wedding etiquette, abbreviations should be avoided on outer envelopes. Spell out 'Street', 'Avenue', 'Boulevard', 'Apartment', 'Post Office Box', and the full state name (e.g., 'New York' instead of 'NY'). However, for casual modern weddings, two-letter postal state abbreviations are widely accepted."
          }
        },
        {
          "@type": "Question",
          "name": "How do you address an envelope with a plus-one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "On an outer envelope, formal etiquette prefers finding out the guest's actual name. If unknown, write 'Mr. Alexander Clark and Guest'. If using an inner envelope, write 'Mr. Clark' on the outer envelope and 'Alexander and Guest' on the inner envelope."
          }
        },
        {
          "@type": "Question",
          "name": "Where does the return address go on wedding envelopes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditionally, the wedding couple's return address is printed centered on the back flap of the outer envelope. For RSVP envelopes, the return address is printed on the front center of the A2 envelope."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Envelope Address Formatter & Etiquette Guide (Free Printable)"
	description="Free wedding envelope address generator and etiquette formatter. Format A7 outer envelopes, A2 RSVP envelopes, and inner envelopes with formal titles (doctors, plus-ones, families). Export to printable PDF, Word, and CSV."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Etiquette & Printable PDF Generator</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Wedding Envelope <span class="accent-italic">Address Formatter</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 700px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Ensure proper etiquette for married couples, doctors, plus-ones, and families. Preview live calligraphy styles and export 1-click printable PDF and Word envelope sheets.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Controls & Formatter Input -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Envelope Setup & Etiquette
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						A7 / A2 / Square
					</span>
				</div>

				<!-- Envelope Size Selector -->
				<div class="form-group">
					<label class="form-label" for="env-size">Envelope Dimension / Format</label>
					<select id="env-size" class="form-input" style="cursor: pointer;">
						<option value="a7" selected>A7 Outer Envelope (5.25" × 7.25" — Standard 5x7 Suites)</option>
						<option value="a2">A2 RSVP Reply Envelope (4.375" × 5.75" — 3.5x5 Cards)</option>
						<option value="inner">A7 Inner Envelope (5.125" × 7" — Named Guests Only)</option>
						<option value="square">Square 6" × 6" Envelope (Requires Extra Postage)</option>
						<option value="dl">Slim DL 4.125" × 9.5" Envelope (For 4x9 Long Menus/Cards)</option>
					</select>
				</div>

				<!-- Etiquette Preset Quick-Pick -->
				<div class="form-group">
					<label class="form-label" for="etiquette-preset">
						Etiquette Preset Shortcut
					</label>
					<select id="etiquette-preset" class="form-input" style="background: #f8fafc; font-weight: 600; cursor: pointer;">
						<option value="married-same" selected>👫 Married Couple (Same Last Name) — e.g. Mr. and Mrs. John Smith</option>
						<option value="married-modern">👫 Married Couple (Modern) — e.g. Sarah and John Smith</option>
						<option value="married-diff">👫 Married Couple (Different Last Names) — e.g. Ms. Sarah Davis & Mr. John Smith</option>
						<option value="doctor-wife">🩺 Doctor (Wife is Doctor) — e.g. Dr. Katherine Evans and Mr. Robert Evans</option>
						<option value="doctor-both">🩺 Doctors (Both are Doctors) — e.g. Drs. Katherine and Robert Evans</option>
						<option value="unmarried">💑 Unmarried Couple Living Together — (Stacked Two Lines)</option>
						<option value="single-guest">👤 Single Guest with Plus-One — e.g. Mr. Alexander Clark and Guest</option>
						<option value="family">👨‍👩‍👧‍👦 Family with Children — e.g. The Davis Family</option>
						<option value="custom">✏️ Custom Manual Input</option>
					</select>
				</div>

				<!-- Recipient Name Line 1 -->
				<div class="form-group">
					<label class="form-label" for="rec-name-1">Recipient Name(s) — Line 1</label>
					<input type="text" id="rec-name-1" class="form-input" value="Mr. and Mrs. John Smith" placeholder="e.g., Mr. and Mrs. John Smith" />
				</div>

				<!-- Recipient Name Line 2 (Optional for unmarried/plus-ones) -->
				<div class="form-group" id="rec-name-2-group" style="display: none;">
					<label class="form-label" for="rec-name-2">Recipient Name (Line 2 — Optional)</label>
					<input type="text" id="rec-name-2" class="form-input" value="" placeholder="e.g., Ms. Jane Doe" />
				</div>

				<!-- Street Address -->
				<div class="form-group">
					<label class="form-label" for="rec-street">Street Address</label>
					<input type="text" id="rec-street" class="form-input" value="742 Evergreen Terrace, Apt 4B" placeholder="e.g., 742 Evergreen Terrace, Suite 100" />
				</div>

				<!-- City, State & Zip -->
				<div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="rec-city">City</label>
						<input type="text" id="rec-city" class="form-input" value="Springfield" placeholder="City" />
					</div>
					<div>
						<label class="form-label" for="rec-state">State</label>
						<input type="text" id="rec-state" class="form-input" value="Oregon" placeholder="State" />
					</div>
					<div>
						<label class="form-label" for="rec-zip">ZIP</label>
						<input type="text" id="rec-zip" class="form-input" value="97477" placeholder="ZIP" />
					</div>
				</div>

				<!-- Return Address Toggle & Inputs -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.75rem;">
						<input type="checkbox" id="toggle-return-addr" checked style="width: 18px; height: 18px;" />
						<span>Include Return Address</span>
					</label>

					<div id="return-addr-fields">
						<div class="form-group">
							<label class="form-label" for="ret-names" style="font-size: 0.95rem;">Couple Return Names</label>
							<input type="text" id="ret-names" class="form-input" value="Alex & Jordan Taylor" style="font-size: 0.95rem; padding: 0.6rem 0.75rem;" />
						</div>
						<div class="form-group">
							<label class="form-label" for="ret-street" style="font-size: 0.95rem;">Return Street & City, State, ZIP</label>
							<input type="text" id="ret-street" class="form-input" value="1204 Rosewood Lane, Portland, Oregon 97201" style="font-size: 0.95rem; padding: 0.6rem 0.75rem;" />
						</div>
					</div>
				</div>

				<!-- Style Customization -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label class="form-label">Font & Calligraphy Style</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="font-style-btn hand-btn is-active" data-font="script" style="padding: 8px; font-size: 0.9rem; font-family: 'Kalam', cursive;">
							✒️ Modern Calligraphy
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="serif" style="padding: 8px; font-size: 0.9rem; font-family: Georgia, serif;">
							🏛️ Formal Roman Serif
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="sans" style="padding: 8px; font-size: 0.9rem; font-family: var(--font-body);">
							✨ Crisp Modern Sans
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="hand" style="padding: 8px; font-size: 0.9rem; font-family: 'Caveat', cursive;">
							✏️ Hand-Lettered Sketch
						</button>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Envelope Visual Canvas & Batch Export -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Canvas Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Live Envelope Preview
						</h3>
						<span id="env-size-tag" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							A7: 5.25" × 7.25"
						</span>
					</div>

					<!-- The Realistic Envelope Box -->
					<div id="envelope-canvas" style="width: 100%; aspect-ratio: 7.25 / 5.25; background: #fffcf5; border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 6px 6px 0px var(--fg-pencil); position: relative; padding: clamp(1rem, 3vw, 2rem); display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; transition: all 0.2s ease;">
						
						<!-- Return Address on Front Top-Left -->
						<div id="canvas-return-addr" style="position: absolute; top: clamp(0.75rem, 2vw, 1.25rem); left: clamp(0.75rem, 2vw, 1.25rem); font-size: clamp(0.68rem, 1.2vw, 0.82rem); line-height: 1.35; color: var(--fg-pencil); max-width: 45%;">
							<strong id="canvas-ret-name" style="display: block;">Alex & Jordan Taylor</strong>
							<span id="canvas-ret-full">1204 Rosewood Lane<br/>Portland, Oregon 97201</span>
						</div>

						<!-- Postage Stamp Placeholder Stamp Outline -->
						<div style="position: absolute; top: clamp(0.75rem, 2vw, 1.25rem); right: clamp(0.75rem, 2vw, 1.25rem); width: clamp(40px, 7vw, 55px); height: clamp(50px, 8.5vw, 68px); border: 1.5px dashed #94a3b8; border-radius: 3px; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; color: #94a3b8; text-align: center; text-transform: uppercase; font-weight: 700; padding: 2px;">
							USPS Stamp
						</div>

						<!-- Main Recipient Address Block (Centered) -->
						<div id="canvas-recipient-block" style="text-align: center; margin-top: clamp(1rem, 2.5vw, 2rem);">
							<div id="canvas-rec-name-1" style="font-size: clamp(1.2rem, 2.5vw, 1.85rem); font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem; line-height: 1.25;">
								Mr. and Mrs. John Smith
							</div>
							<div id="canvas-rec-name-2" style="font-size: clamp(1.1rem, 2.2vw, 1.65rem); font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem; display: none; line-height: 1.25;"></div>
							<div id="canvas-rec-street" style="font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: #334155; margin-bottom: 0.2rem; line-height: 1.4;">
								742 Evergreen Terrace, Apt 4B
							</div>
							<div id="canvas-rec-city-state-zip" style="font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: #334155; line-height: 1.4;">
								Springfield, Oregon 97477
							</div>
						</div>

					</div>

					<!-- Quick Formatting Audit Checklist -->
					<div style="margin-top: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<strong style="font-size: 0.95rem; display: block; margin-bottom: 0.5rem; color: var(--fg-pencil);">
							✅ Etiquette & Postal Compliance Check:
						</strong>
						<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
							<li>Outer envelope spells out full state and street names (no abbreviations).</li>
							<li>Standard A7 outer dimensions fit 5"x7" cards with up to 4 enclosure inserts.</li>
							<li>Under 1 oz qualifies for standard 1× USPS Forever Stamp (no non-machinable surcharge).</li>
						</ul>
					</div>

					<!-- Export Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-envelope" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Print Envelope (PDF)
						</button>
						<button id="btn-export-word" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Word (.doc)
						</button>
					</div>

				</div>

				<!-- Batch Guest List Address Importer -->
				<div class="hand-card" style="padding: 1.75rem; background: var(--bg-paper);">
					<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
						Batch Guest List Importer (CSV / Paste)
					</h3>
					<p style="font-size: 0.92rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
						Paste multiple addresses (one per line: <em>Name, Street, City, State, ZIP</em>) to format your entire wedding mail list at once.
					</p>

					<textarea id="batch-paste-input" rows="4" class="hand-input" style="font-size: 0.88rem; line-height: 1.4; margin-bottom: 0.75rem;" placeholder="Mr. and Mrs. Robert Davis, 102 Oak Lane, Austin, Texas, 78701&#10;Dr. Katherine Evans, 440 Bay Road, Miami, Florida, 33101&#10;Mr. Alexander Clark and Guest, 55 Elm St, Denver, Colorado, 80202"></textarea>

					<div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
						<button id="btn-load-batch" class="hand-btn" style="padding: 8px 16px; font-size: 0.9rem;">
							Load Batch Addresses
						</button>
						<span id="batch-count-tag" style="font-size: 0.85rem; font-weight: 700; color: #64748b;">1 Address Loaded</span>
					</div>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Bottom Line Up Front (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Quick Rule of Thumb: Wedding Envelope Etiquette & Sizes
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Short on time? Here is the 1-minute addressing cheat sheet and standard dimension matrix comparing married, unmarried, medical titles, and envelope paper sizes.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 The Golden Rules of Wedding Envelope Addressing:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					1. Outer Envelope: Formal titles + No Abbreviations (Spell out "Street", "Avenue", "California") • 2. Medical & Military Titles Outrank Social Titles ("Doctor" precedes "Mr.") • 3. Unmarried Couples = Stacked Lines Alphabetically • 4. A7 Size (5.25" × 7.25") is the Universal Standard for 5" × 7" Cards.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Guest Relationship / Scenario</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Formal Outer Envelope Standard</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Inner Envelope (Optional)</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Key Etiquette Rule</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Married Couple (Same Name)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Mr. and Mrs. John Smith<br><span style="font-size: 0.8rem; color: #64748b;">(or John and Sarah Smith)</span></td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Mr. and Mrs. Smith<br><span style="font-size: 0.8rem; color: #64748b;">(or John and Sarah)</span></td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Traditional husband first, or modern joined names</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Married Couple (Different Names)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Ms. Sarah Davis and Mr. John Smith</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Ms. Davis and Mr. Smith</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Join with "and" on one line (or stack if too long)</td>
						</tr>
						<tr>
