						<thead>
							<tr>
								<th>#</th>
								<th>Recipient Name(s)</th>
								<th>Street Address</th>
								<th>City</th>
								<th>State</th>
								<th>ZIP</th>
							</tr>
						</thead>
						<tbody>
			`;

			addressesToExport.forEach((addr, idx) => {
				content += `
					<tr>
						<td>${idx + 1}</td>
						<td><strong>${addr.name}</strong></td>
						<td>${addr.street}</td>
						<td>${addr.city}</td>
						<td>${addr.state}</td>
						<td>${addr.zip}</td>
					</tr>
				`;
			});

			content += `</tbody></table></body></html>`;

			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'wedding-envelope-addresses.doc';
			link.click();
		});

		// Initial Canvas Render
		updateCanvas();
	</script>
</Layout>
