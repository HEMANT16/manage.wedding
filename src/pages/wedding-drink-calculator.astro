---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Drink Calculator",
      "url": "https://manage.wedding/wedding-drink-calculator",
      "description": "Calculate exact quantities of wine, beer, liquor, mixers, champagne, and ice needed for your wedding reception bar.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate Wedding Drink & Bar Quantities",
      "description": "Step-by-step method to calculate wine, beer, liquor, and ice needs for your wedding reception.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Enter Guest Count & Reception Duration",
          "text": "Provide your confirmed adult guest count and the total number of hours your wedding bar will be open (standard receptions run 4 to 5 hours)."
        },
        {
          "@type": "HowToStep",
          "name": "Choose Bar Type & Drinking Crowd Vibe",
          "text": "Select Full Open Bar (Beer, Wine & Spirits) or Soft Bar (Beer & Wine only), and adjust the crowd vibe multiplier for light or heavy drinkers."
        },
        {
          "@type": "HowToStep",
          "name": "Optionally Add a Champagne Toast",
          "text": "Toggle champagne toast to calculate 1 flute per guest (6 glasses per 750ml bottle) for speeches and toasts."
        },
        {
          "@type": "HowToStep",
          "name": "Review Your Complete Bar Shopping List",
          "text": "Get exact bottle counts for wine and liquor, beer cases (24-packs), mixer liters, and pounds of ice needed to keep beverages chilled."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does a wedding drink calculator work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A wedding drink calculator uses your guest count, the duration of your reception, and the drinking habits of your crowd to generate an exact shopping list of beer, wine, and liquor."
          }
        },
        {
          "@type": "Question",
          "name": "Do I really need a wedding drink calculator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Using a wedding drink calculator prevents you from running out of alcohol early in the night, and stops you from overspending hundreds of dollars on excess bottles you don't need."
          }
        },
        {
          "@type": "Question",
          "name": "How many drinks are in a standard bottle of wine?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When using a wedding drink calculator, assume a standard 750ml wine bottle gets you exactly 5 glasses (using a standard 5 oz pour)."
          }
        },
        {
          "@type": "Question",
          "name": "How many drinks are in a bottle of liquor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard 750ml bottle of spirits (vodka, whiskey, gin) yields about 16 drinks (using a standard 1.5 oz pour)."
          }
        },
        {
          "@type": "Question",
          "name": "How many glasses do you get from a bottle of champagne?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Champagne flutes use smaller pours. Expect to get 6 glasses out of every bottle for your wedding toasts."
          }
        },
        {
          "@type": "Question",
          "name": "How many beers are in a case?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard case of beer holds exactly 24 bottles or cans."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Drink Calculator (Free & Instant Results)"
	description="Use our free wedding drink calculator to determine exactly how much beer, wine, liquor, and mixers you need for your wedding reception."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<Breadcrumb title="Wedding Drink Calculator" category="food-dining" />
		<header class="fade-in category-header" style="text-align: center;">
			<h1 class="font-heading" style="font-size: 3.5rem; margin-bottom: 0.5rem; font-weight: 500;">Wedding <span class="accent-italic">Drink Calculator</span></h1>
			<p class="font-body" style="color: var(--secondary-ink); max-width: 600px; margin: 0 auto;">Enter your wedding details to find out exactly how much alcohol, ice, and mixers you need to buy for your bar.</p>
		</header>

		<div class="home-grid fade-in" style="animation-delay: 0.2s; max-width: 800px;">
			<div class="hand-card">
				<form id="calc-form">
					<div class="form-group">
						<label class="form-label" for="guests">Number of Guests</label>
						<input type="number" id="guests" class="form-input" value="100" min="1" required />
					</div>

					<div class="form-group">
						<label class="form-label" for="hours">Event Duration (Hours)</label>
						<input type="number" id="hours" class="form-input" value="4" min="1" required />
					</div>

					<div class="form-group">
						<label class="form-label" for="barType">Bar Type</label>
						<select id="barType" class="form-input">
							<option value="open">Full Open Bar (Beer, Wine & Liquor)</option>
							<option value="soft">Soft Bar (Beer & Wine Only)</option>
						</select>
					</div>

					<div class="form-group">
						<label class="form-label" for="vibe">Drinking Crowd Vibe</label>
						<select id="vibe" class="form-input">
							<option value="average">Average (1 drink/hr)</option>
							<option value="light">Light (-25% drinks)</option>
							<option value="heavy">Heavy (+25% drinks)</option>
						</select>
					</div>

					<div class="form-group">
						<label class="form-label" for="champagne">Champagne Toast?</label>
						<select id="champagne" class="form-input">
							<option value="no">No</option>
							<option value="yes">Yes (1 glass per guest)</option>
						</select>
					</div>

					<button type="submit" id="calc-btn" class="hand-btn" style="width: 100%;">Calculate Drinks</button>
				</form>
			</div>

			<div class="hand-card result-box" id="result-container">
				<h3 class="font-heading" style="margin-bottom: 2rem;">Your Shopping List</h3>
				
				<div class="result-item">
					<span class="item-label">TOTAL</span>
					<span class="item-desc">Total drink servings required</span>
					<span class="item-value" id="res-total">0</span>
				</div>

				<div class="result-item">
					<span class="item-label">BEER</span>
					<span class="item-desc">Cases (24pk)</span>
					<span class="item-value" id="res-beer">0</span>
				</div>

				<div class="result-item">
					<span class="item-label">WINE</span>
					<span class="item-desc">Standard 750ml bottles</span>
					<span class="item-value" id="res-wine">0</span>
				</div>

				<div class="result-item" id="liquor-box">
					<span class="item-label">LIQUOR</span>
					<span class="item-desc">Standard 750ml bottles</span>
					<span class="item-value" id="res-liquor">0</span>
				</div>

				<div class="result-item" id="mixer-box">
					<span class="item-label">MIXERS</span>
					<span class="item-desc">Liters of soda, tonic, & juice</span>
					<span class="item-value" id="res-mixers">0</span>
				</div>

				<div class="result-item" id="champagne-box" style="display: none;">
					<span class="item-label">CHAMPAGNE</span>
					<span class="item-desc">Standard 750ml bottles</span>
					<span class="item-value" id="res-champagne">0</span>
				</div>

				<div class="result-item">
					<span class="item-label">ICE</span>
					<span class="item-desc">Pounds of ice</span>
					<span class="item-value" id="res-ice">0</span>
				</div>

				<div id="explanation-box" style="background-color: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 2px; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.1); margin-top: 2rem; padding: 1.5rem; text-align: left;">
					<strong class="font-heading" style="font-size: 1.2rem; display: block; margin-bottom: 0.5rem; color: var(--accent-red);">How we calculated this:</strong>
					<p id="explanation-text" class="font-body" style="font-size: 1.1rem; margin: 0; line-height: 1.5;">Calculated based on 1 drink per guest per hour.</p>
				</div>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 3.5rem auto 2.5rem; max-width: 800px; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape"></div>
			
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Quick Rule of Thumb (BLUF)
				</h3>
				<span style="background: #fff; border: 1.5px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700; color: var(--accent-red);">
					1-Minute Bar Formula
				</span>
			</div>

			<!-- Formula Highlight Box -->
			<div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<div style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--accent-red); margin-bottom: 0.35rem; font-weight: 700;">
					📐 The Core Bar Formula:
				</div>
				<p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.5;">
					<strong>1 Drink per Guest per Hour</strong> with a standard full bar allocation of <strong>40% Wine</strong> (5 glasses/bottle), <strong>30% Beer</strong> (24 cans/case), <strong>30% Liquor</strong> (16 drinks/750ml bottle), and <strong>1–1.5 lbs Ice per Guest</strong>.
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; margin-bottom: 1rem; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 560px;">
					<thead>
						<tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil);">Guests (4-Hr Bar)</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--fg-pencil); text-align: center;">Total Drinks</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red); text-align: center;">Wine (750ml)</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-blue); text-align: center;">Beer (24pk Cases)</th>
							<th style="padding: 0.6rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: #7c3aed; text-align: center;">Liquor (750ml)</th>
							<th style="padding: 0.6rem 0.75rem; font-weight: 700; color: var(--fg-pencil); text-align: right;">Ice Required</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">50 Guests</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">200 drinks</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">16 bottles</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">2.5 cases (60 beers)</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">4 bottles</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right;">50–75 lbs</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fffbeb;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 700; color: var(--accent-red);">⭐ 100 Guests</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">400 drinks</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-red);">32 bottles</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: var(--accent-blue);">5 cases (120 beers)</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700; color: #7c3aed;">8 bottles</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right; font-weight: 700;">100–150 lbs</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">150 Guests</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">600 drinks</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">48 bottles</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">7.5 cases (180 beers)</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">12 bottles</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right;">150–225 lbs</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; font-weight: 600;">200 Guests</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center;">800 drinks</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">64 bottles</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">10 cases (240 beers)</td>
							<td style="padding: 0.55rem 0.75rem; border-right: 1px solid #cbd5e1; text-align: center; font-weight: 700;">15 bottles</td>
							<td style="padding: 0.55rem 0.75rem; text-align: right;">200–300 lbs</td>
						</tr>
					</tbody>
				</table>
			</div>

			<p class="font-body" style="font-size: 0.85rem; color: var(--fg-pencil); margin: 0; line-height: 1.4;">
				💡 <strong>Champagne Toast Note:</strong> If hosting a dedicated toast, add <strong>1 bottle of champagne per 6 guests</strong> (e.g., 17 bottles for 100 guests).
			</p>
		</div>

		<!-- In-Depth Guide Interlink Banner -->
		<div class="hand-card" style="margin: 2.5rem auto; max-width: 800px; padding: 1.25rem 1.75rem; background: #fffbeb; border: 2px solid #d97706; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
			<div>
				<div style="font-size: 0.80rem; font-weight: 800; color: #b45309; text-transform: uppercase; letter-spacing: 0.5px;">📖 In-Depth Buying Guide & Formulas</div>
				<div class="font-heading" style="font-size: 1.2rem; font-weight: 700; color: var(--fg-pencil); margin-top: 0.2rem;">
					How Much Alcohol to Buy for 100, 150 & 200 Guests
				</div>
			</div>
			<a href="/wedding-drink-calculator-guest-formula" style="background: #d97706; color: #fff; text-decoration: none; font-weight: 700; padding: 8px 18px; border-radius: 6px; font-size: 0.90rem; display: inline-flex; align-items: center; gap: 0.35rem;">
				Read Full Guide &rarr;
			</a>
		</div>

		<article class="hand-card" style="margin: 4rem auto; max-width: 800px; padding: 3rem;">
			<h2 class="font-heading" style="font-size: 2.5rem; margin-bottom: 1.5rem; color: var(--fg-pencil);">How to Stock Your Bar With a Wedding Drink Calculator</h2>
			<p class="font-body" style="font-size: 1.2rem; margin-bottom: 2rem;">
				Let's be honest: doing the math for a wedding bar can feel like a nightmare. You don't want your guests staring at an empty bar two hours into the reception, but you also don't want to blow your entire budget on cases of wine that no one drinks. 
			</p>
			<p class="font-body" style="font-size: 1.2rem; margin-bottom: 2rem;">
				That's exactly why we ditched the complicated spreadsheets and built this visual <strong>wedding drink calculator</strong>. Just punch in your guest count and let us handle the heavy lifting.
			</p>

			<h3 class="font-heading" style="font-size: 2rem; margin-top: 2rem; margin-bottom: 1rem; color: var(--accent-red);">The "One Drink" Rule</h3>
			<p class="font-body" style="font-size: 1.2rem; margin-bottom: 2rem;">
				Bartenders and wedding planners rely on a very simple formula: expect each guest to have <strong>one drink per hour</strong>. While your college buddies might throw back three beers an hour, your grandparents might nurse a single glass of wine all night. It all averages out. Our wedding drink calculator uses this golden rule as a baseline, but gives you the power to bump the numbers up or down depending on your crowd.
			</p>

			<h3 class="font-heading" style="font-size: 2rem; margin-top: 2rem; margin-bottom: 1rem; color: var(--accent-blue);">Pro-Tips for a Better Bar</h3>
			<ul class="font-body" style="font-size: 1.2rem; margin-bottom: 2rem; padding-left: 1.5rem; line-height: 1.6;">
				<li style="margin-bottom: 0.5rem;"><strong>Keep Signature Cocktails Simple:</strong> Limit yourself to two signature drinks. If your bartenders are muddling fresh mint and shaking egg whites for every order, the line will stretch out the door.</li>
				<li style="margin-bottom: 0.5rem;"><strong>Know Your Crowd:</strong> The standard open bar splits the alcohol 40% wine, 30% liquor, and 30% beer. If you know your friends are craft beer snobs, buy extra kegs and skip the top-shelf tequila.</li>
				<li style="margin-bottom: 0.5rem;"><strong>Think About the Weather:</strong> Having a daytime summer wedding? Expect to burn through white wine and light beer. Hosting a winter evening reception? Stock up on heavy reds and whiskey.</li>
			</ul>

			<h3 class="font-heading" style="font-size: 2rem; margin-top: 3rem; margin-bottom: 1.5rem; color: var(--fg-pencil);">Wedding Drink Calculator FAQs</h3>
			
			<details style="margin-bottom: 1rem; cursor: pointer; padding: 1rem; border: 2px dashed var(--fg-pencil); border-radius: 4px;">
				<summary class="font-heading" style="font-size: 1.2rem; margin-bottom: 0.5rem; outline: none;">How does a wedding drink calculator work?</summary>
				<p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0;">A wedding drink calculator uses your guest count, the duration of your reception, and the drinking habits of your crowd to generate an exact shopping list of beer, wine, and liquor.</p>
			</details>

			<details style="margin-bottom: 1rem; cursor: pointer; padding: 1rem; border: 2px dashed var(--fg-pencil); border-radius: 4px;">
				<summary class="font-heading" style="font-size: 1.2rem; margin-bottom: 0.5rem; outline: none;">Do I really need a wedding drink calculator?</summary>
				<p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0;">Yes! Using a wedding drink calculator prevents you from running out of alcohol early in the night, and stops you from overspending hundreds of dollars on excess bottles you don't need.</p>
			</details>

			<details style="margin-bottom: 1rem; cursor: pointer; padding: 1rem; border: 2px dashed var(--fg-pencil); border-radius: 4px;">
				<summary class="font-heading" style="font-size: 1.2rem; margin-bottom: 0.5rem; outline: none;">How many drinks are in a standard bottle of wine?</summary>
				<p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0;">When using a wedding drink calculator, assume a standard 750ml wine bottle gets you exactly <strong>5 glasses</strong> (using a standard 5 oz pour).</p>
			</details>

			<details style="margin-bottom: 1rem; cursor: pointer; padding: 1rem; border: 2px dashed var(--fg-pencil); border-radius: 4px;">
				<summary class="font-heading" style="font-size: 1.2rem; margin-bottom: 0.5rem; outline: none;">How many drinks are in a bottle of liquor?</summary>
				<p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0;">A standard 750ml bottle of spirits (vodka, whiskey, gin) yields about <strong>16 drinks</strong> (using a standard 1.5 oz pour).</p>
			</details>

			<details style="margin-bottom: 1rem; cursor: pointer; padding: 1rem; border: 2px dashed var(--fg-pencil); border-radius: 4px;">
				<summary class="font-heading" style="font-size: 1.2rem; margin-bottom: 0.5rem; outline: none;">How many glasses do you get from a bottle of champagne?</summary>
				<p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0;">Champagne flutes use smaller pours. Expect to get <strong>6 glasses</strong> out of every bottle for your wedding toasts.</p>
			</details>

			<details style="margin-bottom: 1rem; cursor: pointer; padding: 1rem; border: 2px dashed var(--fg-pencil); border-radius: 4px;">
				<summary class="font-heading" style="font-size: 1.2rem; margin-bottom: 0.5rem; outline: none;">How many beers are in a case?</summary>
				<p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0;">A standard case of beer holds exactly <strong>24 bottles or cans</strong>.</p>
			</details>
		</article>

		<RelatedTools currentPath="/wedding-drink-calculator" category="food-beverage" />
	</main>

	<script>
		function calculateDrinks() {
			const guests = parseInt((document.getElementById('guests') as HTMLInputElement)?.value) || 0;
			const hours = parseInt((document.getElementById('hours') as HTMLInputElement)?.value) || 0;
			const barType = (document.getElementById('barType') as HTMLSelectElement)?.value || 'full';
			const vibe = (document.getElementById('vibe') as HTMLSelectElement)?.value || 'average';
			const champagne = (document.getElementById('champagne') as HTMLSelectElement)?.value || 'yes';

			// Base: 1 drink per person per hour
			let multiplier = 1.0;
			let vibeText = "average drinking crowd";
			if (vibe === 'light') {
				multiplier = 0.75;
				vibeText = "lighter drinking crowd (-25%)";
			} else if (vibe === 'heavy') {
				multiplier = 1.25;
				vibeText = "heavy drinking crowd (+25%)";
			}

			const totalServings = Math.ceil(guests * hours * multiplier);

			let beerRatio = 0.3;
			let wineRatio = 0.4;
			let liquorRatio = 0.3;

			if (barType === 'soft') {
				beerRatio = 0.5;
				wineRatio = 0.5;
				liquorRatio = 0;
			}

			const beerServings = totalServings * beerRatio;
			const wineServings = totalServings * wineRatio;
			const liquorServings = totalServings * liquorRatio;

			// 1 case of beer = 24 servings
			const beerCases = Math.ceil(beerServings / 24);
			// 1 bottle of wine = 5 servings
			const wineBottles = Math.ceil(wineServings / 5);
			// 1 bottle of liquor (750ml) = 16 servings
			const liquorBottles = Math.ceil(liquorServings / 16);

			// Champagne: 1 glass per guest, 6 glasses per bottle
			const champagneBottles = Math.ceil(guests / 6);

			// Ice: ~1.5 lbs per guest total
			const iceLbs = Math.ceil(guests * 1.5);
			// Mixers: 1 Liter per 3 guests for full bar
			const mixersLiters = barType === 'open' || barType === 'full' ? Math.ceil(guests / 3) : 0;

			// Update DOM
			const resTotal = document.getElementById('res-total');
			const resBeer = document.getElementById('res-beer');
			const resWine = document.getElementById('res-wine');
			const liquorBox = document.getElementById('liquor-box');
			const mixerBox = document.getElementById('mixer-box');
			const champagneBox = document.getElementById('champagne-box');
			const resLiquor = document.getElementById('res-liquor');
			const resMixers = document.getElementById('res-mixers');
			const resChampagne = document.getElementById('res-champagne');
			const resIce = document.getElementById('res-ice');
			const explText = document.getElementById('explanation-text');

			if (resTotal) resTotal.textContent = totalServings.toString();
			if (resBeer) resBeer.textContent = beerCases.toString();
			if (resWine) resWine.textContent = wineBottles.toString();
			
			if (liquorBox && mixerBox) {
				if (barType === 'soft') {
					liquorBox.style.display = 'none';
					mixerBox.style.display = 'none';
				} else {
					liquorBox.style.display = 'block';
					mixerBox.style.display = 'block';
					if (resLiquor) resLiquor.textContent = liquorBottles.toString();
					if (resMixers) resMixers.textContent = mixersLiters.toString();
				}
			}

			if (champagneBox) {
				if (champagne === 'yes') {
					champagneBox.style.display = 'block';
					if (resChampagne) resChampagne.textContent = champagneBottles.toString();
				} else {
					champagneBox.style.display = 'none';
				}
			}

			if (resIce) resIce.textContent = iceLbs.toString();

			// Update explanation text
			let expl = `We calculated a baseline of 1 drink per guest per hour, then adjusted it for your ${vibeText}.`;
			if (barType === 'soft') {
				expl += ` We split the servings 50/50 between beer and wine.`;
			} else {
				expl += ` We split the servings roughly 40% wine, 30% beer, and 30% liquor.`;
			}
			if (champagne === 'yes') {
				expl += ` We also added ${champagneBottles} bottles of champagne for a 1-glass-per-guest toast (6 glasses/bottle).`;
			}
			expl += ` We recommend ${iceLbs} lbs of ice (about 1.5 lbs per guest) to keep everything chilled.`;
			
			if (explText) explText.textContent = expl;
		}

		document.getElementById('calc-form')?.addEventListener('submit', function(e) {
			e.preventDefault();
			calculateDrinks();
		});

		['guests', 'hours', 'barType', 'vibe', 'champagne'].forEach(id => {
			const el = document.getElementById(id);
			if (el) {
				el.addEventListener('input', calculateDrinks);
				el.addEventListener('change', calculateDrinks);
			}
		});

		calculateDrinks();
	</script>
</Layout>
