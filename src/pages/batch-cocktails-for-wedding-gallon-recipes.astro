---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Batch Cocktails for Wedding: Gallon Recipes & Ratios (Alcohol Dilution Calculator)",
      "description": "Learn how to scale signature cocktails into 3-gallon and 5-gallon dispensers with the essential 20% water dilution rule and batch recipes.",
      "datePublished": "2026-08-18T00:00:00+00:00",
      "dateModified": "2026-08-18T00:00:00+00:00",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding",
        "logo": {
          "@type": "ImageObject",
          "url": "https://manage.wedding/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://manage.wedding/batch-cocktails-for-wedding-gallon-recipes"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why do batch cocktails need added water?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When a bartender shakes or stirs an individual cocktail with ice, 20% to 25% of the finished volume is melted ice water. If you scale a recipe for a dispenser without adding 20% filtered water, the cocktail will taste harsh, unbalanced, and overly boozy."
          }
        },
        {
          "@type": "Question",
          "name": "How many drinks are in a 3-gallon cocktail dispenser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard 3-gallon (384 oz) drink dispenser yields approximately 64 to 75 cocktail servings when served over fresh ice in 10 oz rocks glasses (5 to 6 oz pour per drink)."
          }
        },
        {
          "@type": "Question",
          "name": "Can you put ice inside a batch cocktail dispenser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Putting ice directly into a large beverage dispenser will continually melt over several hours, turning the bottom half into flavorless water. Instead, pre-chill the batch liquid and have bartenders pour over fresh ice in each guest's glass."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Batch Cocktails for Wedding: Gallon Recipes & Ratios (Alcohol Dilution Calculator)"
  description="Learn how to scale signature cocktails into 3-gallon and 5-gallon dispensers with the essential 20% water dilution rule and batch recipes."
  schema={schema}
>
  <main class="container" style="padding-top: 2rem; padding-bottom: 4rem; max-width: 900px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
        { name: "Batch Cocktails & Dilution Guide" }
      ]}
    />

    <!-- Header Section -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #fef3c7; color: #92400e; padding: 4px 12px; border-radius: 20px; border: 1.5px solid #d97706; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <span>🍹</span>
        <span>Signature Drink Scaling & Science</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
        Batch Cocktails for Wedding: Gallon Recipes & Ratios <span style="color: #b45309; font-style: italic;">(Alcohol Dilution Calculator)</span>
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;">
        <span>Published: August 2026</span>
        <span>•</span>
        <span>8 min read</span>
        <span>•</span>
        <span>By Manage.Wedding Editorial Team</span>
      </div>
    </header>

    <!-- AI Direct Citation Callout (BLUF) -->
    <div style="background: #f0fdf4; border: 2px solid #16a34a; border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: 3px 3px 0px #16a34a;">
      <div style="font-size: 0.82rem; font-weight: 800; color: #15803d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem;">
        🎯 The Golden 20% Dilution Rule
      </div>
      <p class="font-body" style="font-size: 1.15rem; color: #14532d; font-weight: 600; line-height: 1.5; margin: 0;">
        Whenever scaling a single-serving cocktail up to a 3-gallon or 5-gallon dispenser, you must add <strong>20% to 25% filtered water to the batch</strong>. This mimics the exact chilling dilution that occurs when a mixologist shakes an individual cocktail on ice, preventing the batch from tasting harsh and overly alcoholic.
      </p>
    </div>

    <!-- Interactive Tool Callout Hero -->
    <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
          Calculate Exact ABV & Water Dilution
        </h3>
        <p class="font-body" style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
          Enter any cocktail formula (spirits, liqueurs, juices) to find total ounces and dilution water.
        </p>
      </div>
      <a href="/alcohol-dilution-calculator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 10px 22px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.5rem;">
        <span>Open Dilution Calculator</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Main Content Body -->
    <article class="font-body" style="font-size: 1.1rem; line-height: 1.7; color: var(--fg-pencil);">
      
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2rem 0 1rem;">
        Why Most DIY Wedding Batches Fail
      </h2>
      <p>
        Signature cocktails ("His & Hers" drinks) are the highlight of modern wedding receptions. But when well-meaning couples try to make 5 gallons of Spicy Margaritas or French 75s in beverage dispensers by simply multiplying their single-drink shaker recipe by 100, the result is almost always a disaster:
      </p>
      <p>
        <strong>1. It burns going down:</strong> A cocktail shaken for 12 seconds gains 1.25 oz of melted water. Without that water, room-temperature batch liquor is 35% stronger than intended.<br />
        <strong>2. Ice in the dispenser ruins it:</strong> Adding 5 lbs of ice into the dispenser looks pretty for 20 minutes. By hour two, the ice melts, separating into watery syrup.<br />
        <strong>3. Fresh citrus turns bitter:</strong> Unpasteurized lime and lemon juices oxidize after 6 to 8 hours, turning brown and bitter.
      </p>

      <!-- Batch Scaling Table -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Batch Scaling Matrix: 1 Dispenser (3 Gallons) = 64 Servings
      </h2>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Ingredient Component</th>
              <th style="padding: 12px 14px; font-weight: 800;">Single Drink (Shaker)</th>
              <th style="padding: 12px 14px; font-weight: 800;">3-Gallon Batch (64 Drinks)</th>
              <th style="padding: 12px 14px; font-weight: 800;">5-Gallon Batch (105 Drinks)</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Base Spirit (Tequila / Vodka)</td>
              <td style="padding: 12px 14px;">2.0 oz</td>
              <td style="padding: 12px 14px; font-weight: 700;">128 oz (5 x 750ml bottles)</td>
              <td style="padding: 12px 14px; font-weight: 700;">210 oz (8.3 bottles)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Liqueur (Triple Sec / St-Germain)</td>
              <td style="padding: 12px 14px;">0.75 oz</td>
              <td style="padding: 12px 14px;">48 oz (2 x 750ml bottles)</td>
              <td style="padding: 12px 14px;">80 oz (3.2 bottles)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Fresh Citrus Juice (Lime/Lemon)</td>
              <td style="padding: 12px 14px;">1.0 oz</td>
              <td style="padding: 12px 14px;">64 oz (0.5 gallon)</td>
              <td style="padding: 12px 14px;">105 oz (0.8 gallon)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Simple Syrup / Agave</td>
              <td style="padding: 12px 14px;">0.75 oz</td>
              <td style="padding: 12px 14px;">48 oz</td>
              <td style="padding: 12px 14px;">80 oz</td>
            </tr>
            <tr style="background: #f0fdf4;">
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">Filtered Dilution Water</td>
              <td style="padding: 12px 14px; color: #16a34a;">1.25 oz (from ice melt)</td>
              <td style="padding: 12px 14px; font-weight: 800; color: #16a34a;">80 oz (0.62 gallon)</td>
              <td style="padding: 12px 14px; font-weight: 800; color: #16a34a;">135 oz (1.05 gallons)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        3 Battle-Tested Wedding Batch Recipes
      </h2>

      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; margin-bottom: 2rem;">
        <h3 class="font-heading" style="font-size: 1.3rem; color: #b45309; margin-bottom: 0.5rem;">
          1. The Smoked Spicy Paloma (3 Gallons)
        </h3>
        <p style="font-size: 0.95rem; margin-bottom: 0.75rem;">
          Combine 4 bottles (100 oz) Blanco Tequila, 1 bottle (25 oz) Mezcal, 90 oz Ruby Red Grapefruit Juice, 45 oz Fresh Lime Juice, 45 oz Jalapeño Simple Syrup, and <strong>75 oz Filtered Cold Water</strong>. Pour over ice with a chili-lime salt rim and fresh grapefruit wedge.
        </p>

        <h3 class="font-heading" style="font-size: 1.3rem; color: #b45309; margin-top: 1.25rem; margin-bottom: 0.5rem;">
          2. The Lavender French 75 (Still Base Batch)
        </h3>
        <p style="font-size: 0.95rem; margin-bottom: 0.75rem;">
          <strong>Never batch sparkling wine in advance</strong> or it will lose carbonation. Batch the still base: 4 bottles London Dry Gin, 48 oz Fresh Lemon Juice, 48 oz Lavender-Honey Syrup, and 40 oz Water. When serving, bartenders pour 3 oz of the chilled base into a flute and top with 3 oz of fresh chilled Prosecco.
        </p>
      </div>

      <!-- Bottom Interactive CTA Section -->
      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 2rem; box-shadow: 4px 4px 0px var(--fg-pencil); text-align: center; margin: 3rem 0;">
        <h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
          Calculate Your Cocktail ABV & Dilution Ratios
        </h3>
        <p class="font-body" style="font-size: 1.05rem; max-width: 600px; margin: 0 auto 1.5rem; color: var(--text-secondary);">
          Make sure your signature drinks are smooth, delicious, and perfectly balanced.
        </p>
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="/alcohol-dilution-calculator" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 12px 24px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Calculate Batch Dilution &rarr;
          </a>
          <a href="/wedding-drink-calculator" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 12px 20px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Calculate Full Bar Quantities &rarr;
          </a>
        </div>
      </div>

    </article>

    <RelatedTools currentPath="/batch-cocktails-for-wedding-gallon-recipes" category="food-beverage" />
  </main>
</Layout>
