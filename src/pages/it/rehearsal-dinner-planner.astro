---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/rehearsal-dinner-planner/#webapp",
      "name": "Pianificatore Cena della Vigilia e Welcome Dinner",
      "url": "https://manage.wedding/it/rehearsal-dinner-planner",
      "inLanguage": "it",
      "description": "Calcola il budget, la lista degli invitati e la scaletta oraria per la cena della vigilia, la prova cerimonia e il welcome party per gli ospiti da fuori città.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come organizzare la cena della vigilia e il welcome party di nozze",
      "description": "Guida passo dopo passo per selezionare gli invitati, scegliere la location e definire il budget prematrimoniale.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Definire i partecipanti alla prova cerimonia",
          "text": "Includi sposi, testimoni di nozze con accompagnatori, genitori, fratelli e celebrante."
        },
        {
          "@type": "HowToStep",
          "name": "2. Gestire gli ospiti arrivati da lontano",
          "text": "Scegli se invitarli alla cena servita oppure a un brindisi informale di benvenuto post-cena."
        },
        {
          "@type": "HowToStep",
          "name": "3. Scegliere la tipologia di cena",
          "text": "Opta per un pizza party informale, una trattoria tipica locale o un aperitivo rinforzato."
        },
        {
          "@type": "HowToStep",
          "name": "4. Impostare la scaletta e concludere presto",
          "text": "Pianifica la serata in modo da consentire a sposi e ospiti di riposare a sufficienza per il giorno del matrimonio."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Chi deve essere invitato alla cena della vigilia del matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Gli invitati indispensabili sono: gli sposi, i genitori, i fratelli/sorelle, i testimoni di nozze (con i rispettivi partner), il celebrante e i lettori. È consuetudine estendere l'invito anche ai nonni e a eventuali parenti stretti giunti da lontano il giorno prima."
          }
        },
        {
          "@type": "Question",
          "name": "A chi spetta pagare la cena della vigilia o il welcome dinner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tradizionalmente la cena della vigilia o il rinfresco pre-nozze viene offerto dagli sposi stessi o dalla famiglia dello sposo, come gesto di ospitalità e ringraziamento per i testimoni e i familiari più vicini."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Pianificatore Cena della Vigilia & Welcome Dinner Matrimonio | Manage.Wedding"
	description="Calcola il budget, il numero di invitati e la scaletta oraria per la cena della vigilia o il welcome party prematrimoniale con testimoni, genitori e ospiti da lontano."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Cena della Vigilia & Welcome Dinner" category="guests-logistics" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Galateo, Invitati & Scaletta Oraria</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Cena della Vigilia <span class="accent-italic">& Welcome Dinner Planner</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcola con precisione invitati e costi per la cena prematrimoniale o il welcome cocktail: testimoni, genitori, parenti stretti e ospiti giunti da lontano.
			</p>
		</header>

		<!-- Main Interactive Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Guest Tiers & Format Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Gruppi di Invitati & Coperti
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Lista Pre-Nozze
					</span>
				</div>

				<!-- Dining Style Presets -->
				<div class="form-group">
					<label class="form-label" for="dinner-style-preset">Tipologia di Cena o Evento</label>
					<select id="dinner-style-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="italian" selected>🍝 Trattoria Tipica / Menù Tradizionale (45 €/persona + Vino)</option>
						<option value="brewery">🍕 Pizza Party Informale & Birra Artigianale (30 €/persona)</option>
						<option value="steakhouse">🥩 Cena Gourmet Servita / Sala Riservata (75 €/persona)</option>
						<option value="taco">🍷 Aperitivo Rinforzato & Cocktail di Benvenuto (35 €/persona)</option>
						<option value="custom">✏️ Budget Personalizzato</option>
					</select>
				</div>

				<!-- Tier 1: Core Mandatory Ceremony Participants -->
				<div style="background: #faf8f5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.25rem;">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.5rem; color: var(--accent-red);">
						Gruppo 1: Protagonisti Cerimonia & Famiglia Stretta
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="count-attendants" style="font-size: 0.88rem;">Testimoni di Nozze</label>
							<input type="number" id="count-attendants" class="form-input" value="6" min="2" max="20" />
						</div>
						<div>
							<label class="form-label" for="count-plusones" style="font-size: 0.88rem;">Partner / Accompagnatori</label>
							<input type="number" id="count-plusones" class="form-input" value="6" min="0" max="20" />
						</div>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="count-immediate-family" style="font-size: 0.88rem;">Genitori & Fratelli</label>
							<input type="number" id="count-immediate-family" class="form-input" value="8" min="2" max="20" />
						</div>
						<div>
							<label class="form-label" for="count-officiant" style="font-size: 0.88rem;">Celebrante & Lettori</label>
							<input type="number" id="count-officiant" class="form-input" value="2" min="0" max="10" />
						</div>
					</div>
				</div>

				<!-- Tier 2: Extended Family & Out-of-Town Option -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.25rem;">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.5rem; color: var(--accent-blue);">
						Gruppo 2: Nonni & Ospiti Arrivati da Lontano
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="count-grandparents" style="font-size: 0.88rem;">Nonni</label>
							<input type="number" id="count-grandparents" class="form-input" value="4" min="0" max="12" />
						</div>
						<div>
							<label class="form-label" for="count-out-of-town" style="font-size: 0.88rem;">Ospiti Fuori Sede</label>
							<input type="number" id="count-out-of-town" class="form-input" value="6" min="0" max="80" />
						</div>
					</div>

					<div class="form-group" style="margin-top: 0.5rem;">
						<label class="form-label" for="out-of-town-mode" style="font-size: 0.88rem;">Formula per Ospiti Fuori Sede</label>
						<select id="out-of-town-mode" class="form-input" style="cursor: pointer; font-size: 0.9rem;">
							<option value="drinks-only" selected>🥂 Brindisi di Benvenuto post-cena (15 €/persona drink e stuzzichini)</option>
							<option value="full-dinner">🍽️ Inclusi alla Cena Servita Completa (Quota intera)</option>
							<option value="none">🚫 Solo Cena Ristretta con Familiari e Testimoni</option>
						</select>
					</div>
				</div>

				<!-- Pricing per Person & Room Rental -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="cost-per-head">Cena & Vino (€/persona)</label>
						<input type="number" id="cost-per-head" class="form-input" value="45" min="15" step="5" />
					</div>
					<div>
						<label class="form-label" for="room-fee">Sala Riservata (€)</label>
						<input type="number" id="room-fee" class="form-input" value="150" min="0" step="50" />
					</div>
				</div>

			</div>

			<!-- Right Column: Budget Breakdown & Timeline Generator -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Summary Budget Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Budget Stimato Cena della Vigilia
						</span>
						<span id="display-headcount-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							28 Ospiti
						</span>
					</div>

					<div id="display-grand-total" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.5rem;">
						1.500 €
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Ristorazione: <strong id="display-fb-subtotal" style="color: var(--fg-pencil);">1.260 €</strong> • Servizio & IVA: <strong id="display-tax-tip" style="color: var(--fg-pencil);">140 €</strong> • Sala: <strong id="display-room-cost" style="color: var(--fg-pencil);">150 €</strong>.
					</p>

					<!-- Itemized Headcount List -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Gli Sposi:</span>
							<strong>2</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Testimoni & Accompagnatori:</span>
							<strong id="item-attendant-total">12</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Genitori, Fratelli & Nonni:</span>
							<strong id="item-family-total">12</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.95rem;">
							<span>Celebrante & Lettori:</span>
							<strong id="item-officiant-total">2</strong>
						</div>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-timeline" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Stampa Scaletta (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Esporta Documento Word
						</button>
					</div>

				</div>

				<!-- Master Rehearsal Night Timeline Schedule -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.75rem;">
						🕒 Scaletta Oraria Consigliata (18:00 – 23:00):
					</strong>
					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.5;">
						<div><strong>18:00 – 19:00:</strong> Prova Cerimonia in Chiesa / Location (Ingresso, scambio fedi, letture).</div>
						<div><strong>19:30 – 20:15:</strong> Aperitivo e Accoglienza degli ospiti al locale.</div>
						<div><strong>20:15 – 21:45:</strong> Cena conviviale e brindisi di ringraziamento dei genitori.</div>
						<div><strong>21:45 – 22:30:</strong> Consegna regali ai testimoni e discorsi informali.</div>
						<div><strong>22:30 – 23:00:</strong> Dolce e conclusione per consentire agli sposi di riposare bene.</div>
					</div>
				</div>

			</div>

		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guida alla Cena della Vigilia e al Welcome Party
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Come gestire gli ospiti, ringraziare i testimoni e vivere una serata serena prima delle nozze.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. L'Atmosfera Giusta: Relax e Convivialità
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					La cena della vigilia deve essere volutamente più informale e rilassata rispetto al banchetto nuziale del giorno dopo. È l'occasione ideale per sciogliere le tensioni, far conoscere le rispettive famiglie e dedicare del tempo di qualità ai testimoni e agli amici più cari.
				</p>
			</section>
		</article>

		<RelatedTools currentPath="/it/rehearsal-dinner-planner" category="food-beverage" />
	</main>
</Layout>

<script is:inline>
	const presetSelect = document.getElementById('dinner-style-preset');
	const countAttendants = document.getElementById('count-attendants');
	const countPlusones = document.getElementById('count-plusones');
	const countFamily = document.getElementById('count-immediate-family');
	const countOfficiant = document.getElementById('count-officiant');
	const countGrandparents = document.getElementById('count-grandparents');
	const countOutOfTown = document.getElementById('count-out-of-town');
	const outOfTownMode = document.getElementById('out-of-town-mode');
	const costPerHeadInput = document.getElementById('cost-per-head');
	const roomFeeInput = document.getElementById('room-fee');

	function updateRehearsalCalc() {
		const att = parseInt(countAttendants.value, 10) || 0;
		const pls = parseInt(countPlusones.value, 10) || 0;
		const fam = parseInt(countFamily.value, 10) || 0;
		const off = parseInt(countOfficiant.value, 10) || 0;
		const grp = parseInt(countGrandparents.value, 10) || 0;
		const oot = parseInt(countOutOfTown.value, 10) || 0;

		const costHead = parseFloat(costPerHeadInput.value) || 45;
		const roomFee = parseFloat(roomFeeInput.value) || 0;
		const mode = outOfTownMode.value;

		const coreSeated = 2 + att + pls + fam + off + grp;
		let totalSeated = coreSeated;
		let outOfTownCost = 0;

		if (mode === 'full-dinner') {
			totalSeated += oot;
		} else if (mode === 'drinks-only') {
			outOfTownCost = oot * 15;
		}

		const foodBarSubtotal = (totalSeated * costHead) + outOfTownCost;
		const taxService = foodBarSubtotal * 0.10;
		const grandTotal = Math.round(foodBarSubtotal + taxService + roomFee);

		document.getElementById('display-headcount-badge').textContent = `${totalSeated} Ospiti`;
		document.getElementById('display-grand-total').textContent = `${grandTotal.toLocaleString('it-IT')} €`;
		document.getElementById('display-fb-subtotal').textContent = `${Math.round(foodBarSubtotal).toLocaleString('it-IT')} €`;
		document.getElementById('display-tax-tip').textContent = `${Math.round(taxService).toLocaleString('it-IT')} €`;
		document.getElementById('display-room-cost').textContent = `${Math.round(roomFee).toLocaleString('it-IT')} €`;

		document.getElementById('item-attendant-total').textContent = (att + pls).toString();
		document.getElementById('item-family-total').textContent = (fam + grp).toString();
		document.getElementById('item-officiant-total').textContent = off.toString();
	}

	[countAttendants, countPlusones, countFamily, countOfficiant, countGrandparents, countOutOfTown, outOfTownMode, costPerHeadInput, roomFeeInput].forEach(el => {
		el.addEventListener('input', updateRehearsalCalc);
		el.addEventListener('change', updateRehearsalCalc);
	});

	presetSelect.addEventListener('change', () => {
		const v = presetSelect.value;
		if (v === 'italian') { costPerHeadInput.value = 45; roomFeeInput.value = 150; }
		else if (v === 'brewery') { costPerHeadInput.value = 30; roomFeeInput.value = 50; }
		else if (v === 'steakhouse') { costPerHeadInput.value = 75; roomFeeInput.value = 250; }
		else if (v === 'taco') { costPerHeadInput.value = 35; roomFeeInput.value = 100; }
		updateRehearsalCalc();
	});

	document.getElementById('btn-print-timeline').addEventListener('click', () => window.print());

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head><meta charset="utf-8"><title>Programma Cena della Vigilia</title></head>
			<body style="font-family: Arial, sans-serif; padding: 20px;">
				<h1>Manage.Wedding — Programma e Budget Cena della Vigilia</h1>
				<p>Data: ${new Date().toLocaleDateString('it-IT')} | Ospiti previsti: ${document.getElementById('display-headcount-badge').textContent}</p>
				<h3>Dettaglio Spesa:</h3>
				<p>Ristorazione: ${document.getElementById('display-fb-subtotal').textContent} | Servizio & IVA: ${document.getElementById('display-tax-tip').textContent} | Sala: ${document.getElementById('display-room-cost').textContent}</p>
				<p><strong>Totale Stimato: ${document.getElementById('display-grand-total').textContent}</strong></p>
			</body>
			</html>
		`;
		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Cena_Vigilia_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	updateRehearsalCalc();
</script>
