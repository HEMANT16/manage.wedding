---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-name-change-calculator/#webapp",
      "name": "Cambio Cognome dopo il Matrimonio e Pratiche Burocratiche",
      "url": "https://manage.wedding/it/wedding-name-change-calculator",
      "inLanguage": "it",
      "description": "Calcolatore interattivo per il cognome maritale (art. 143 bis c.c.) e le pratiche burocratiche post-matrimonio in Italia. Calcola le marche da bollo per Passaporto, Carta d'Identità CIE, Estratti di matrimonio e genera il piano in PDF e Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Pratiche Burocratiche dopo il Matrimonio in Italia: La Guida Completa",
      "description": "L'ordine corretto per aggiornare i documenti anagrafici, richiedere il congedo matrimoniale di 15 giorni e aggiornare passaporto, patente e conti bancari.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Richiedere gli Estratti di Matrimonio all'Ufficio Anagrafe",
          "text": "Richiedi all'Ufficio di Stato Civile del Comune 3 o 4 copie dell'Estratto per riassunto dell'Atto di Matrimonio (Gratuito o marca da bollo da 16€ se ad uso legale)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Aggiornare la Carta d'Identità Elettronica (CIE)",
          "text": "Prenota l'appuntamento in Comune per la nuova CIE con annotazione dello stato civile o cambio residenza (Costo: 22,21€)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Rinnovo del Passaporto in Questura",
          "text": "Presenta richiesta in Questura per il nuovo passaporto elettronico (Bollettino postale 42,50€ + Contributo amministrativo 73,50€ = 116,00€)."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Congedo Matrimoniale di 15 Giorni al Lavoro",
          "text": "Presenta il certificato di matrimonio all'ufficio del personale (HR) per usufruire del congedo straordinario retribuito di 15 giorni di calendario."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 5: Notifica a Banche, Utenze e Agenzia delle Entrate",
          "text": "Comunica il cambio di stato civile e residenza all'Agenzia delle Entrate, alla banca per la cointestazione e alle compagnie di assicurazione."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "In Italia la donna perde il proprio cognome quando si sposa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Assolutamente no. In base all'art. 143-bis del Codice Civile, la moglie aggiunge al proprio cognome quello del marito a titolo di d'uso sociale, ma per lo Stato italiano, per l'Anagrafe, per il Codice Fiscale e per tutti i documenti legali primari mantiene sempre e solo il proprio cognome di nascita (da nubile)."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto costano le pratiche burocratiche post-matrimonio in Italia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "I certificati anagrafici sono quasi sempre gratuiti (salvo marca da bollo da 16€ in specifici casi legali). I costi principali sono: Carta d'Identità Elettronica CIE (22,21€) e il rilascio del Passaporto elettronico (116,00€: 42,50€ bollettino + 73,50€ marca da bollo + fototessere)."
          }
        },
        {
          "@type": "Question",
          "name": "Posso prenotare i voli per il viaggio di nozze con il cognome del marito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Attenzione pericolo! I biglietti aerei devono coincidere al 100% con il nome e cognome che compaiono sulla banda magnetica del passaporto che esibisci ai controlli di frontiera. Poiché in Italia il passaporto riporta il cognome da nubile, prenota sempre tutti i voli con il tuo cognome di nascita."
          }
        },
        {
          "@type": "Question",
          "name": "Come funziona il congedo matrimoniale in Italia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ai lavoratori dipendenti spettano 15 giorni consecutivi di congedo straordinario retribuito, concesso dal datore di lavoro entro 30 giorni dalla data del matrimonio. È sufficiente consegnare la copia dell'estratto di matrimonio."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Cambio Cognome dopo il Matrimonio e Pratiche Burocratiche (Checklist & Costi)"
	description="Calcolatore interattivo per il cognome maritale (art. 143 bis c.c.) e le pratiche burocratiche post-matrimonio in Italia. Calcola marche da bollo (Passaporto, CIE, Anagrafe) e genera il piano in PDF e Word."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Cognome e Pratiche Burocratiche" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Art. 143-bis C.C. & Calcolatore Marche da Bollo</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Cognome dopo il Matrimonio <span class="accent-italic">& Pratiche Burocratiche</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Configura il cognome maritale, calcola le marche da bollo ufficiali (Passaporto, CIE, Anagrafe) e organizza tutti i documenti nel corretto ordine temporale. Esporta il tuo dossier in 1 clic.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; margin-bottom: 3rem; align-items: start;">
			
			<!-- Left Column: Configurazione Cognome -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						1. Configurazione Cognome & Identità
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Anteprima
					</span>
				</div>

				<!-- Sposa Inputs -->
				<div style="margin-bottom: 1.25rem;">
					<label class="form-label" style="font-weight: 700; font-size: 0.95rem;">Tuo Nome e Cognome da Nubile</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr 1.2fr; gap: 0.5rem;">
						<div>
							<input type="text" id="p1-first" class="form-input" value="Chiara" placeholder="Nome" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Nome</span>
						</div>
						<div>
							<input type="text" id="p1-middle" class="form-input" value="Maria" placeholder="Secondo Nome" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Secondo Nome</span>
						</div>
						<div>
							<input type="text" id="p1-maiden" class="form-input" value="Rossi" placeholder="Cognome da nubile" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Cognome Nubile</span>
						</div>
					</div>
				</div>

				<!-- Sposo Inputs -->
				<div style="margin-bottom: 1.25rem;">
					<label class="form-label" style="font-weight: 700; font-size: 0.95rem;">Nome e Cognome dello Sposo</label>
					<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.5rem;">
						<div>
							<input type="text" id="p2-first" class="form-input" value="Lorenzo" placeholder="Nome Sposo" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Nome</span>
						</div>
						<div>
							<input type="text" id="p2-surname" class="form-input" value="Ferrari" placeholder="Cognome Sposo" style="width: 100%; font-size: 0.95rem; padding: 0.5rem;" />
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Cognome</span>
						</div>
					</div>
				</div>

				<!-- Opzioni di Struttura -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="naming-format-select" style="font-weight: 700;">Opzione d'Uso del Cognome</label>
					<select id="naming-format-select" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; padding: 0.65rem; width: 100%;">
						<option value="keep-maiden" selected>🇮🇹 Regola Italiana: Cognome da Nubile Immutato (Chiara Rossi - 0€)</option>
						<option value="take-spouse">💍 Aggiunta Maritale (art. 143 bis): Chiara Rossi in Ferrari</option>
						<option value="hyphenated-1">🔗 Doppio Cognome con Trattino: Chiara Rossi-Ferrari</option>
						<option value="take-full-spouse">🌍 Uso Sociale / Estero: Chiara Ferrari</option>
					</select>
				</div>

				<!-- Anteprima Documenti -->
				<div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; box-shadow: 3px 3px 0 var(--fg-pencil); margin-top: 1rem;">
					<div style="font-size: 0.8rem; text-transform: uppercase; font-weight: 800; color: var(--accent-red); letter-spacing: 0.05em; margin-bottom: 0.35rem;">
						Nome Ufficiale nei Registri Anagrafici
					</div>
					
					<div id="preview-full-legal" class="font-heading" style="font-size: 1.55rem; color: var(--fg-pencil); line-height: 1.2; margin-bottom: 0.75rem;">
						Chiara Maria Rossi
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.88rem; padding-top: 0.75rem; border-top: 1px dashed #cbd5e1;">
						<div>
							<span style="color: var(--text-secondary); display: block; font-size: 0.75rem;">Monogramma:</span>
							<strong id="preview-monogram" style="font-family: var(--font-hand); font-size: 1.3rem; color: var(--accent-blue);">C R F</strong>
						</div>
						<div>
							<span style="color: var(--text-secondary); display: block; font-size: 0.75rem;">Codice Fiscale:</span>
							<strong id="preview-route-badge" style="color: #16a34a; font-size: 0.82rem;">✅ Calcolato su Cognome Nubile</strong>
						</div>
						<div style="grid-column: span 2;">
							<span style="color: var(--text-secondary); display: block; font-size: 0.75rem;">Email di Lavoro Stimata:</span>
							<code id="preview-email" style="background: #e2e8f0; padding: 2px 6px; border-radius: 3px; font-size: 0.85rem;">chiara.rossi@azienda.it</code>
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Costi e Tempistiche -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						2. Marche da Bollo & Tempistiche
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: #e0f2fe; border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						In Tempo Reale
					</span>
				</div>

				<!-- Big Metric Hero Cards -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
					
					<!-- Metrica 1: Costo Totale -->
					<div style="background: #fef08a; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; text-align: center; box-shadow: 3px 3px 0 var(--fg-pencil);">
						<span style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: var(--fg-pencil); display: block;">
							Totale Spese Bolli
						</span>
						<div id="display-total-fee" class="font-heading" style="font-size: 2.2rem; color: var(--fg-pencil); line-height: 1.1; margin: 0.25rem 0;">
							138,21 €
						</div>
						<span id="display-fee-range" style="font-size: 0.8rem; color: var(--text-secondary);">
							Passaporto + Carta CIE
						</span>
					</div>

					<!-- Metrica 2: Tempistiche -->
					<div style="background: #e0e7ff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; text-align: center; box-shadow: 3px 3px 0 var(--fg-pencil);">
						<span style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: var(--fg-pencil); display: block;">
							Tempistica Questura
						</span>
						<div id="display-total-weeks" class="font-heading" style="font-size: 2.2rem; color: var(--accent-blue); line-height: 1.1; margin: 0.25rem 0;">
							2–4 Sett.
						</div>
						<span style="font-size: 0.8rem; color: var(--text-secondary);">
							Rilascio documenti
						</span>
					</div>

				</div>

				<!-- Barra di Progresso -->
				<div style="margin-bottom: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<div style="display: flex; justify-content: space-between; font-size: 0.88rem; font-weight: 700; margin-bottom: 0.4rem;">
						<span>Pratiche Concluse:</span>
						<span id="progress-text">0 di 14 Pratiche Completate (0%)</span>
					</div>
					<div style="width: 100%; height: 16px; background: #e2e8f0; border-radius: 8px; border: 1.5px solid var(--fg-pencil); overflow: hidden;">
						<div id="progress-bar-fill" style="width: 0%; height: 100%; background: #22c55e; transition: width 0.3s ease;"></div>
					</div>
				</div>

				<!-- Filtri Rapidi -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
					<button type="button" id="btn-filter-all" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem; background: var(--fg-pencil); color: #fff;">
						Tutte le Pratiche
					</button>
					<button type="button" id="btn-filter-vital" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem;">
						Comune & CIE
					</button>
					<button type="button" id="btn-filter-travel" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem;">
						Passaporto Questura
					</button>
					<button type="button" id="btn-check-all" class="hand-btn" style="padding: 6px 12px; font-size: 0.85rem; margin-left: auto;">
						Azzera
					</button>
				</div>

				<!-- Export-Buttons -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<button type="button" id="btn-export-pdf" class="hand-btn" style="background: #fecdd3; border-color: var(--fg-pencil); color: var(--fg-pencil); font-size: 0.95rem; padding: 10px;">
						🖨️ Stampa / PDF
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="background: #dbeafe; border-color: var(--fg-pencil); color: var(--fg-pencil); font-size: 0.95rem; padding: 10px;">
						📄 Esporta Word (.doc)
					</button>
					<button type="button" id="btn-copy-checklist" class="hand-btn" style="grid-column: span 2; background: #dcfce7; border-color: var(--fg-pencil); color: var(--fg-pencil); font-size: 0.95rem; padding: 10px;">
						📋 Copia Elenco delle Pratiche
					</button>
				</div>

			</div>

		</div>

		<!-- Checklist Interattiva per Fasi -->
		<section class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.5rem); background: #fff; margin-bottom: 3.5rem;">
			
			<div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
				<div>
					<span class="badge-postit" style="font-size: 0.85rem;">Sequenza Istituzionale</span>
					<h2 class="font-heading" style="font-size: 1.85rem; margin: 0.35rem 0 0 0; color: var(--fg-pencil);">
						L'Ordine Corretto delle Pratiche Burocratiche
					</h2>
				</div>
				<p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0; max-width: 480px;">
					Spunta i passaggi completati per monitorare lo stato di avanzamento anagrafico e lavorativo.
				</p>
			</div>

			<!-- FASE 1: Comune & Documenti d'Identità -->
			<div class="checklist-stage" data-stage="vital" style="margin-bottom: 2rem;">
				<div style="background: #f1f5f9; border-left: 5px solid var(--accent-red); padding: 0.75rem 1rem; border-radius: 0 6px 6px 0; margin-bottom: 1rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						Fase 1: Comune, Stato Civile e Carta d'Identità (CIE)
					</h3>
					<p style="margin: 0; font-size: 0.88rem; color: var(--text-secondary);">
						Il rilascio degli estratti di matrimonio per riassunto.
					</p>
				</div>

				<!-- Pratica 1: Estratti di Matrimonio -->
				<div class="checklist-item hand-card" style="padding: 1rem; margin-bottom: 0.85rem; background: #fafafa; border: 1.5px solid var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
						<div style="display: flex; align-items: flex-start; gap: 0.75rem; flex: 1; min-width: 260px;">
							<input type="checkbox" id="chk-item-1" class="task-checkbox" style="width: 20px; height: 20px; margin-top: 3px; cursor: pointer;" />
							<div>
								<label for="chk-item-1" style="font-weight: 700; font-size: 1.05rem; color: var(--fg-pencil); cursor: pointer;">
									1. Estratti per Riassunto dell'Atto di Matrimonio (Comune)
								</label>
								<div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
									Richiedi all'Ufficio di Stato Civile o scarica con SPID da ANPR (Anagrafe Nazionale Popolazione Residente).
								</div>
							</div>
						</div>
						<div style="text-align: right; min-width: 110px;">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Anagrafe / ANPR:</span>
							<strong class="item-cost-display" style="font-size: 1.2rem; color: #16a34a;">0,00 € (GRATIS)</strong>
							<span style="display: block; font-size: 0.75rem; color: #16a34a; font-weight: 600;">⏱️ Immediato online</span>
						</div>
					</div>
				</div>

				<!-- Pratica 2: Carta d'Identità Elettronica CIE -->
				<div class="checklist-item hand-card" style="padding: 1rem; margin-bottom: 0.85rem; background: #fafafa; border: 1.5px solid var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
						<div style="display: flex; align-items: flex-start; gap: 0.75rem; flex: 1; min-width: 260px;">
							<input type="checkbox" id="chk-item-2" class="task-checkbox" style="width: 20px; height: 20px; margin-top: 3px; cursor: pointer;" />
							<div>
								<label for="chk-item-2" style="font-weight: 700; font-size: 1.05rem; color: var(--fg-pencil); cursor: pointer;">
									2. Carta d'Identità Elettronica (CIE)
								</label>
								<div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
									Rilascio in Comune con foto tessera e rilevazione impronte digitali.
								</div>
								<div style="margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
									<span style="font-size: 0.85rem;">Costo Ministeriale CIE: </span>
									<input type="number" id="input-cie-fee" min="0" max="40" value="22.21" step="0.01" style="width: 70px; padding: 3px 6px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
									<span style="font-size: 0.85rem;">€</span>
								</div>
							</div>
						</div>
						<div style="text-align: right; min-width: 110px;">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Spesa CIE:</span>
							<strong id="fee-item-2" class="item-cost-display" style="font-size: 1.2rem; color: var(--accent-red);">22,21 €</strong>
							<span style="display: block; font-size: 0.75rem; color: #16a34a; font-weight: 600;">⏱️ 6 Giorni lavorativi</span>
						</div>
					</div>
				</div>

			</div>

			<!-- FASE 2: Passaporto & Questura -->
			<div class="checklist-stage" data-stage="travel" style="margin-bottom: 2rem;">
				<div style="background: #f1f5f9; border-left: 5px solid var(--accent-blue); padding: 0.75rem 1rem; border-radius: 0 6px 6px 0; margin-bottom: 1rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						Fase 2: Passaporto in Questura & Viaggi Internazionali
					</h3>
					<p style="margin: 0; font-size: 0.88rem; color: var(--text-secondary);">
						⚠️ <strong>Avvertenza Viaggio di Nozze:</strong> I biglietti aerei devono corrispondere al cognome di nascita presente sul passaporto!
					</p>
				</div>

				<!-- Pratica 3: Passaporto Elettronico -->
				<div class="checklist-item hand-card" style="padding: 1rem; margin-bottom: 0.85rem; background: #fafafa; border: 1.5px solid var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
						<div style="display: flex; align-items: flex-start; gap: 0.75rem; flex: 1; min-width: 260px;">
							<input type="checkbox" id="chk-item-3" class="task-checkbox" style="width: 20px; height: 20px; margin-top: 3px; cursor: pointer;" />
							<div>
								<label for="chk-item-3" style="font-weight: 700; font-size: 1.05rem; color: var(--fg-pencil); cursor: pointer;">
									3. Passaporto Elettronico (Libretto + Contributo Amministrativo)
								</label>
								<div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
									Bollettino postale da 42,50€ + Contributo amministrativo (marca da bollo) da 73,50€ = 116,00€.
								</div>
								<div style="margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
									<span style="font-size: 0.85rem;">Bolli + Libretto: </span>
									<input type="number" id="input-pass-fee" min="0" max="150" value="116" style="width: 65px; padding: 3px 6px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
									<span style="font-size: 0.85rem;">€</span>
								</div>
							</div>
						</div>
						<div style="text-align: right; min-width: 110px;">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Spesa Passaporto:</span>
							<strong id="fee-item-3" class="item-cost-display" style="font-size: 1.2rem; color: var(--accent-red);">116,00 €</strong>
							<span style="display: block; font-size: 0.75rem; color: #16a34a; font-weight: 600;">⏱️ 2–4 Settimane</span>
						</div>
					</div>
				</div>

			</div>

			<!-- FASE 3: Lavoro, Congedo & Enti Pubblici -->
			<div class="checklist-stage" data-stage="vital" style="margin-bottom: 2rem;">
				<div style="background: #f1f5f9; border-left: 5px solid #10b981; padding: 0.75rem 1rem; border-radius: 0 6px 6px 0; margin-bottom: 1rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						Fase 3: Congedo Matrimoniale, Datore di Lavoro & INPS
					</h3>
					<p style="margin: 0; font-size: 0.88rem; color: var(--text-secondary);">
						Diritti retribuiti del lavoratore e detrazioni fiscali per coniuge a carico.
					</p>
				</div>

				<!-- Pratica 4: Congedo Matrimoniale -->
				<div class="checklist-item hand-card" style="padding: 1rem; margin-bottom: 0.85rem; background: #fafafa; border: 1.5px solid var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
						<div style="display: flex; align-items: flex-start; gap: 0.75rem; flex: 1; min-width: 260px;">
							<input type="checkbox" id="chk-item-4" class="task-checkbox" style="width: 20px; height: 20px; margin-top: 3px; cursor: pointer;" />
							<div>
								<label for="chk-item-4" style="font-weight: 700; font-size: 1.05rem; color: var(--fg-pencil); cursor: pointer;">
									4. Congedo Matrimoniale Straordinario di 15 Giorni Retribuiti
								</label>
								<div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
									Consegna del certificato di matrimonio all'Ufficio Risorse Umane (HR) entro 30 giorni dall'evento.
								</div>
							</div>
						</div>
						<div style="text-align: right; min-width: 110px;">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Lavoro:</span>
							<strong class="item-cost-display" style="font-size: 1.2rem; color: #16a34a;">0,00 €</strong>
							<span style="display: block; font-size: 0.75rem; color: #16a34a; font-weight: 600;">⏱️ 15 Giorni Spettanti</span>
						</div>
					</div>
				</div>

				<!-- Pratica 5: Patente e Motorizzazione -->
				<div class="checklist-item hand-card" style="padding: 1rem; margin-bottom: 0.85rem; background: #fafafa; border: 1.5px solid var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
						<div style="display: flex; align-items: flex-start; gap: 0.75rem; flex: 1; min-width: 260px;">
							<input type="checkbox" id="chk-item-5" class="task-checkbox" style="width: 20px; height: 20px; margin-top: 3px; cursor: pointer;" />
							<div>
								<label for="chk-item-5" style="font-weight: 700; font-size: 1.05rem; color: var(--fg-pencil); cursor: pointer;">
									5. Patente di Guida & Libretto di Circolazione (Portale dell'Automobilista)
								</label>
								<div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
									La patente non deve essere ristampata se non vi è cambio di residenza. L'aggiornamento anagrafico della residenza è gratuito.
								</div>
							</div>
						</div>
						<div style="text-align: right; min-width: 110px;">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Motorizzazione:</span>
							<strong class="item-cost-display" style="font-size: 1.2rem; color: #16a34a;">0,00 €</strong>
							<span style="display: block; font-size: 0.75rem; color: #16a34a; font-weight: 600;">⏱️ Gratuito</span>
						</div>
					</div>
				</div>

			</div>

			<!-- FASE 4: Banche e Contratti -->
			<div class="checklist-stage" data-stage="finance" style="margin-bottom: 1rem;">
				<div style="background: #f1f5f9; border-left: 5px solid #d97706; padding: 0.75rem 1rem; border-radius: 0 6px 6px 0; margin-bottom: 1rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						Fase 4: Banche, Mutuo, Assicurazioni e Utenze
					</h3>
					<p style="margin: 0; font-size: 0.88rem; color: var(--text-secondary);">
						Aggiornamento del regime patrimoniale (comunione o separazione dei beni).
					</p>
				</div>

				<!-- Pratica 6: Banche e Cointestazioni -->
				<div class="checklist-item hand-card" style="padding: 1rem; margin-bottom: 0.85rem; background: #fafafa; border: 1.5px solid var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
						<div style="display: flex; align-items: flex-start; gap: 0.75rem; flex: 1; min-width: 260px;">
							<input type="checkbox" id="chk-item-6" class="task-checkbox" style="width: 20px; height: 20px; margin-top: 3px; cursor: pointer;" />
							<div>
								<label for="chk-item-6" style="font-weight: 700; font-size: 1.05rem; color: var(--fg-pencil); cursor: pointer;">
									6. Conti Correnti, Mutuo Bancario e Regime Patrimoniale
								</label>
								<div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.25rem;">
									Registrazione in filiale del regime scelto (separazione o comunione dei beni) ed eventuale apertura di conto cointestato.
								</div>
							</div>
						</div>
						<div style="text-align: right; min-width: 110px;">
							<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Banche:</span>
							<strong class="item-cost-display" style="font-size: 1.2rem; color: #16a34a;">0,00 €</strong>
							<span style="display: block; font-size: 0.75rem; color: #16a34a; font-weight: 600;">⏱️ In Filiale</span>
						</div>
					</div>
				</div>

			</div>

		</section>

		<!-- Guida Giuridica SEO -->
		<section class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.5rem); background: #fff; margin-bottom: 3.5rem;">
			<div class="tape" style="margin: 0 auto 1.5rem;"></div>
			<h2 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); text-align: center; margin-bottom: 1.5rem;">
				Guida Giuridica: Il Cognome e i Diritti dopo il Matrimonio
			</h2>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
				
				<div style="border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; background: #fffbeb;">
					<h3 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin-top: 0; display: flex; align-items: center; gap: 0.4rem;">
						<span>🏛️</span> 1. Art. 143-bis Codice Civile
					</h3>
					<p class="font-body" style="font-size: 0.95rem; color: var(--text-color); margin: 0;">
						In Italia la donna conserva a tutti gli effetti legali, anagrafici e fiscali il proprio cognome di nascita. L'aggiunta del cognome maritale è una facoltà d'uso sociale.
					</p>
				</div>

				<div style="border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; background: #fef2f2;">
					<h3 class="font-heading" style="font-size: 1.25rem; color: var(--accent-red); margin-top: 0; display: flex; align-items: center; gap: 0.4rem;">
						<span>✈️</span> 2. Biglietti Aerei e Viaggio di Nozze
					</h3>
					<p class="font-body" style="font-size: 0.95rem; color: var(--text-color); margin: 0;">
						Prenota sempre i biglietti aerei con il cognome da nubile che compare sul tuo passaporto italiano, altrimenti rischi il rifiuto dell'imbarco.
					</p>
				</div>

				<div style="border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; background: #f0fdf4;">
					<h3 class="font-heading" style="font-size: 1.25rem; color: #16a34a; margin-top: 0; display: flex; align-items: center; gap: 0.4rem;">
						<span>💼</span> 3. Congedo Straordinario di 15 Giorni
					</h3>
					<p class="font-body" style="font-size: 0.95rem; color: var(--text-color); margin: 0;">
						I 15 giorni di congedo matrimoniale sono retribuiti interamente e non scalano le ferie annuali ordinarie maturate.
					</p>
				</div>

			</div>

			<!-- FAQ -->
			<h3 class="font-heading" style="font-size: 1.45rem; color: var(--fg-pencil); margin-bottom: 1rem;">
				Domande Frequenti sui Documenti dopo le Nozze
			</h3>

			<div style="display: flex; flex-direction: column; gap: 0.85rem;">
				<details class="hand-card" style="padding: 1rem; background: #fafafa; border: 1.5px solid var(--fg-pencil); cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">
						In Italia la donna perde il proprio cognome quando si sposa?
					</summary>
					<p style="margin: 0.75rem 0 0 0; font-size: 0.95rem; color: var(--text-color); line-height: 1.6;">
						<strong>Assolutamente no.</strong> In base all'art. 143-bis del Codice Civile, la moglie aggiunge al proprio cognome quello del marito a titolo di d'uso sociale, ma per lo Stato italiano, per l'Anagrafe, per il Codice Fiscale e per tutti i documenti legali primari mantiene sempre e solo il proprio cognome di nascita (da nubile).
					</p>
				</details>

				<details class="hand-card" style="padding: 1rem; background: #fafafa; border: 1.5px solid var(--fg-pencil); cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">
						Quanto costano le pratiche burocratiche post-matrimonio in Italia?
					</summary>
					<p style="margin: 0.75rem 0 0 0; font-size: 0.95rem; color: var(--text-color); line-height: 1.6;">
						I certificati anagrafici sono quasi sempre gratuiti. I costi principali sono: Carta d'Identità Elettronica CIE (<strong>22,21€</strong>) e il rilascio del Passaporto elettronico (<strong>116,00€</strong>: 42,50€ bollettino + 73,50€ marca da bollo + fototessere).
					</p>
				</details>
			</div>

		</section>

		<!-- Strumenti Correlati -->
		<RelatedTools currentPath="/it/wedding-name-change-calculator" category="budget" />

	</main>

	<!-- Script di Calcolo -->
	<script is:inline>
		const p1First = document.getElementById('p1-first');
		const p1Middle = document.getElementById('p1-middle');
		const p1Maiden = document.getElementById('p1-maiden');
		const p2First = document.getElementById('p2-first');
		const p2Surname = document.getElementById('p2-surname');
		const namingFormatSelect = document.getElementById('naming-format-select');

		const previewFullLegal = document.getElementById('preview-full-legal');
		const previewMonogram = document.getElementById('preview-monogram');
		const previewEmail = document.getElementById('preview-email');

		const displayTotalFee = document.getElementById('display-total-fee');
		const progressText = document.getElementById('progress-text');
		const progressBarFill = document.getElementById('progress-bar-fill');

		const inputCieFee = document.getElementById('input-cie-fee');
		const feeItem2 = document.getElementById('fee-item-2');
		const inputPassFee = document.getElementById('input-pass-fee');
		const feeItem3 = document.getElementById('fee-item-3');

		const taskCheckboxes = document.querySelectorAll('.task-checkbox');

		const btnFilterAll = document.getElementById('btn-filter-all');
		const btnFilterVital = document.getElementById('btn-filter-vital');
		const btnFilterTravel = document.getElementById('btn-filter-travel');
		const btnCheckAll = document.getElementById('btn-check-all');

		const btnExportPdf = document.getElementById('btn-export-pdf');
		const btnExportDoc = document.getElementById('btn-export-doc');
		const btnCopyChecklist = document.getElementById('btn-copy-checklist');

		function cap(str) {
			if (!str) return '';
			return str.trim().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ');
		}

		function sanitizeForEmail(str) {
			return str.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]/g, '');
		}

		function updatePersona() {
			const f1 = cap(p1First.value) || 'Chiara';
			const m1 = cap(p1Middle.value) || 'Maria';
			const maid = cap(p1Maiden.value) || 'Rossi';
			const sp = cap(p2Surname.value) || 'Ferrari';
			const format = namingFormatSelect.value;

			let newFullName = '';
			let monogram = '';

			switch (format) {
				case 'keep-maiden':
					newFullName = `${f1} ${m1} ${maid}`;
					monogram = `${f1.charAt(0)} ${maid.charAt(0)} ${m1 ? m1.charAt(0) : 'R'}`;
					break;
				case 'take-spouse':
					newFullName = `${f1} ${maid} in ${sp}`;
					monogram = `${f1.charAt(0)} ${maid.charAt(0)} ${sp.charAt(0)}`;
					break;
				case 'hyphenated-1':
					newFullName = `${f1} ${maid}-${sp}`;
					monogram = `${f1.charAt(0)} ${maid.charAt(0)} ${sp.charAt(0)}`;
					break;
				case 'take-full-spouse':
					newFullName = `${f1} ${sp}`;
					monogram = `${f1.charAt(0)} ${sp.charAt(0)} ${maid.charAt(0)}`;
					break;
			}

			previewFullLegal.textContent = newFullName;
			previewMonogram.textContent = monogram.toUpperCase();

			const cleanFirst = sanitizeForEmail(f1);
			const cleanLast = sanitizeForEmail(maid);
			previewEmail.textContent = `${cleanFirst}.${cleanLast}@azienda.it`;
		}

		function calculateFees() {
			const cieFee = parseFloat(inputCieFee.value) || 0;
			feeItem2.textContent = `${cieFee.toFixed(2).replace('.', ',')} €`;

			const passFee = parseFloat(inputPassFee.value) || 0;
			feeItem3.textContent = `${passFee.toFixed(2).replace('.', ',')} €`;

			const total = cieFee + passFee;
			displayTotalFee.textContent = `${total.toFixed(2).replace('.', ',')} €`;

			let checkedCount = 0;
			taskCheckboxes.forEach(chk => { if (chk.checked) checkedCount++; });

			const totalTasks = taskCheckboxes.length;
			const pct = Math.round((checkedCount / totalTasks) * 100);
			progressText.textContent = `${checkedCount} di ${totalTasks} Pratiche Completate (${pct}%)`;
			progressBarFill.style.width = `${pct}%`;
		}

		btnFilterAll.addEventListener('click', () => {
			document.querySelectorAll('.checklist-stage').forEach(st => st.style.display = 'block');
			btnFilterAll.style.background = 'var(--fg-pencil)';
			btnFilterAll.style.color = '#fff';
			btnFilterVital.style.background = '#fff';
			btnFilterVital.style.color = 'var(--fg-pencil)';
			btnFilterTravel.style.background = '#fff';
			btnFilterTravel.style.color = 'var(--fg-pencil)';
		});

		btnFilterVital.addEventListener('click', () => {
			document.querySelectorAll('.checklist-stage').forEach(st => {
				st.style.display = st.getAttribute('data-stage') === 'vital' ? 'block' : 'none';
			});
			btnFilterVital.style.background = 'var(--fg-pencil)';
			btnFilterVital.style.color = '#fff';
			btnFilterAll.style.background = '#fff';
			btnFilterAll.style.color = 'var(--fg-pencil)';
			btnFilterTravel.style.background = '#fff';
			btnFilterTravel.style.color = 'var(--fg-pencil)';
		});

		btnFilterTravel.addEventListener('click', () => {
			document.querySelectorAll('.checklist-stage').forEach(st => {
				st.style.display = st.getAttribute('data-stage') === 'travel' ? 'block' : 'none';
			});
			btnFilterTravel.style.background = 'var(--fg-pencil)';
			btnFilterTravel.style.color = '#fff';
			btnFilterAll.style.background = '#fff';
			btnFilterAll.style.color = 'var(--fg-pencil)';
			btnFilterVital.style.background = '#fff';
			btnFilterVital.style.color = 'var(--fg-pencil)';
		});

		btnCheckAll.addEventListener('click', () => {
			taskCheckboxes.forEach(chk => { chk.checked = false; });
			calculateFees();
		});

		btnCopyChecklist.addEventListener('click', () => {
			const legalName = previewFullLegal.textContent;
			const totalCost = displayTotalFee.textContent;

			let text = `💍 DOSSIER DELLE PRATICHE POST-MATRIMONIO IN ITALIA\n`;
			text += `=================================================\n`;
			text += `Nome Anagrafico: ${legalName}\n`;
			text += `Spese Marche da Bollo: ${totalCost}\n\n`;
			text += `[ ] 1. Estratti di Matrimonio all'Ufficio Anagrafe\n`;
			text += `[ ] 2. Carta d'Identità Elettronica CIE (${feeItem2.textContent})\n`;
			text += `[ ] 3. Passaporto Elettronico in Questura (${feeItem3.textContent})\n`;
			text += `[ ] 4. Congedo Matrimoniale Straordinario (15 Giorni)\n`;
			text += `[ ] 5. Patente e Portale dell'Automobilista\n`;
			text += `[ ] 6. Cointestazione Conti Bancari e Utenze\n\n`;
			text += `Generato su Manage.Wedding`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnCopyChecklist.innerHTML;
				btnCopyChecklist.innerHTML = '<span>✅</span> Copiato negli Appunti!';
				setTimeout(() => { btnCopyChecklist.innerHTML = orig; }, 2500);
			});
		});

		btnExportDoc.addEventListener('click', () => {
			const legalName = previewFullLegal.textContent;
			const totalCost = displayTotalFee.textContent;
			const dateStr = new Date().toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' });

			const html = `
				<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
				<head><meta charset="utf-8"><title>Pratiche Matrimonio — ${legalName}</title></head>
				<body style="font-family: Calibri, sans-serif; padding: 24px;">
					<h1>💍 Piano delle Pratiche Burocratiche Post-Matrimonio</h1>
					<p>Generato il ${dateStr} • Manage.Wedding</p>
					<p><strong>Nome Registrato:</strong> ${legalName}</p>
					<p><strong>Totale Marche da Bollo:</strong> ${totalCost}</p>
					<h3>Elenco Pratiche:</h3>
					<ol>
						<li>Estratto di Matrimonio in Anagrafe (Gratuito)</li>
						<li>Carta d'Identità CIE (${feeItem2.textContent})</li>
						<li>Passaporto in Questura (${feeItem3.textContent})</li>
						<li>Congedo Matrimoniale 15 Giorni</li>
						<li>Patente e Motorizzazione</li>
						<li>Banche e Regime Patrimoniale</li>
					</ol>
				</body></html>
			`;

			const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = `Pratiche_Matrimonio_${sanitizeForEmail(legalName)}.doc`;
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(url);
		});

		btnExportPdf.addEventListener('click', () => { window.print(); });

		[p1First, p1Middle, p1Maiden, p2First, p2Surname, namingFormatSelect, inputCieFee, inputPassFee].forEach(el => {
			if (el) {
				el.addEventListener('input', () => { updatePersona(); calculateFees(); });
				el.addEventListener('change', () => { updatePersona(); calculateFees(); });
			}
		});

		taskCheckboxes.forEach(chk => { chk.addEventListener('change', calculateFees); });

		updatePersona();
		calculateFees();
	</script>
</Layout>
