---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calcolatore Bomboniere e Confetti Matrimonio",
      "url": "https://manage.wedding/it/wedding-favors-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calcola la quantità esatta di bomboniere di nozze (a persona o a coppia/famiglia), evita gli sprechi ai tavoli e calcola il tempo di confezionamento DIY.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calcolatore Bomboniere Matrimonio — Quantità, Costi & Confetti"
	description="Calcola quante bomboniere ordinare (a persona vs a coppia/famiglia), percentuale di bomboniere dimenticate, tempo di confezionamento DIY e cartelli da stampare."
	lang="it"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/it/" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/it/guests" style="color: var(--text-secondary); text-decoration: none;">Invitati & Logistica</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Bomboniere Matrimonio</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🎁</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Calcolo Preciso Bomboniere & Prevenzione Sprechi</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calcolatore Bomboniere e Pensieri di Nozze
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Calcola il numero esatto di bomboniere in base alla distribuzione <strong>Singola o per Coppia/Famiglia</strong>, evita il 20% di bomboniere dimenticate ai tavoli, stima le ore di confezionamento e stampa i cartelli.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Controls & Parameters -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>📋</span> 1. Numero Invitati & Distribuzione
				</h2>

				<!-- Headcount Slider -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
						<label for="slider-guests" style="font-weight: 700; font-size: 0.95rem; color: var(--fg-pencil);">
							Invitati Previsti:
						</label>
						<span id="badge-guests" class="badge-postit" style="font-weight: 700; font-size: 1.05rem; padding: 2px 8px; border-radius: 4px;">120 Invitati</span>
					</div>
					<input type="range" id="slider-guests" min="20" max="500" step="5" value="120" style="width: 100%; accent-color: var(--fg-pencil); cursor: pointer;" />
					<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
						<span>20 Intimo</span>
						<span>120 Medio</span>
						<span>250 Grande</span>
						<span>500 Molto Grande</span>
					</div>
				</div>

				<!-- Distribution Model -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label style="display: block; font-weight: 700; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						Modello di Distribuzione:
					</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<label style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.6rem; cursor: pointer; display: flex; flex-direction: column; gap: 0.2rem; background: #fef08a;" id="label-mode-individual">
							<div style="display: flex; align-items: center; gap: 0.35rem; font-weight: 700; font-size: 0.88rem;">
								<input type="radio" name="dist-mode" id="radio-mode-individual" value="individual" checked style="accent-color: var(--fg-pencil);" />
								<span>1 A Persona</span>
							</div>
							<span style="font-size: 0.75rem; color: #475569;">Dolci, mini liquori, occhiali</span>
						</label>

						<label style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.6rem; cursor: pointer; display: flex; flex-direction: column; gap: 0.2rem; background: #fff;" id="label-mode-couple">
							<div style="display: flex; align-items: center; gap: 0.35rem; font-weight: 700; font-size: 0.88rem;">
								<input type="radio" name="dist-mode" id="radio-mode-couple" value="couple" style="accent-color: var(--fg-pencil);" />
								<span>1 A Coppia / Famiglia</span>
							</div>
							<span style="font-size: 0.75rem; color: #475569;">Olio EVO, candele, oggetti casa</span>
						</label>
					</div>
				</div>

				<!-- Favor Category -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label for="select-favor-type" style="display: block; font-weight: 700; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						Tipo di Bomboniera (Incide sul Tasso di Ritiro):
					</label>
					<select id="select-favor-type" class="hand-input" style="width: 100%; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 6px; font-size: 0.9rem; background: #fff;">
						<option value="edible-packaged" selected>🍬 Dolci Confezionati (Macarons, Biscotti, Sacchetti Confetti) — 95% ritirate</option>
						<option value="edible-drink">🍾 Mini Bottiglie di Liquore / Amari Artigianali — 98% ritirate</option>
						<option value="edible-bulk">🍯 Vasetti di Miele, Marmellata o Olio Extravergine — 92% ritirate</option>
						<option value="keepsake-useful">🕯️ Oggetto Utile (Candele Profumate, Cavatappi) — 82% ritirate</option>
						<option value="keepsake-monogram">☕ Oggetti con Iniziali (Sottobicchieri, Tazze) — 75% ritirate</option>
						<option value="greenery-seed">🌱 Piantine Grasse & Bustine di Semi — 80% ritirate</option>
					</select>
				</div>

				<!-- Placement -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label for="select-placement" style="display: block; font-weight: 700; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						Posizionamento in Sala:
					</label>
					<select id="select-placement" class="hand-input" style="width: 100%; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 6px; font-size: 0.9rem; background: #fff;">
						<option value="place-setting" selected>🍽️ Al posto tavola (~18% dimenticate sul tavolo)</option>
						<option value="exit-table">🚪 Tavolo Bomboniere all'Uscita (~10% con cartello ben visibile)</option>
						<option value="greeter-station">🥂 Consegnate a mano dagli sposi al momento dei saluti (100% successo)</option>
					</select>
				</div>

				<!-- Buffer Strategy -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label for="select-buffer" style="display: block; font-weight: 700; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						Margine di Sicurezza & Ricordi:
					</label>
					<select id="select-buffer" class="hand-input" style="width: 100%; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 6px; font-size: 0.9rem; background: #fff;">
						<option value="recommended" selected>⭐ Consigliato (+5% extra + 3 per foto e sposi)</option>
						<option value="eco">🌱 Eco-Risparmio (-15% deducendo le dimenticanze)</option>
						<option value="generous">🎁 Generoso (+12% per ospiti extra e fornitori)</option>
					</select>
				</div>

				<!-- Cost & Assembly -->
				<div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1rem; margin-top: 1rem;">
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-item-cost" style="display: block; font-weight: 700; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Costo Unitario (€):
							</label>
							<input type="number" id="input-item-cost" min="0" step="0.25" value="3.50" style="width: 100%; padding: 0.45rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-weight: 700; font-size: 0.95rem;" />
						</div>
						<div>
							<label for="input-assembly-seconds" style="display: block; font-weight: 700; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Confezionamento Fai-da-te:
							</label>
							<select id="input-assembly-seconds" style="width: 100%; padding: 0.45rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
								<option value="0">0s (Già confezionate)</option>
								<option value="45" selected>45s (Nastrino e Tag)</option>
								<option value="120">2 min (Scatolina e Confetti)</option>
								<option value="240">4 min (Creazione Artigianale)</option>
							</select>
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Raccomandazione Esatta</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Piano di Acquisto Bomboniere
						</h2>
					</div>
					<span id="badge-dist-type" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">A Persona</span>
				</div>

				<!-- Big Number Highlights -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Totale da Ordinare</span>
						<strong id="stat-order-qty" style="font-size: 2rem; font-weight: 900; color: #1e40af; line-height: 1.1;">129</strong>
						<span id="stat-subtext-qty" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(120 base + 9 scorta)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Spesa Prevista</span>
						<strong id="stat-total-spend" style="font-size: 2rem; font-weight: 900; color: #15803d; line-height: 1.1;">451,50 €</strong>
						<span id="stat-per-guest-cost" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">3,76 € per invitato presente</span>
					</div>
				</div>

				<!-- Secondary Metrics Matrix -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">Famiglie / Coppie Stimate:</span>
						<strong id="stat-household-count" style="color: var(--fg-pencil);">67 Famiglie</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">Bomboniere Dimenticate ai Tavoli:</span>
						<strong id="stat-attrition-rate" style="color: #b91c1c;">~6 pz dimenticati (5%)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">Ricordi Sposi e Fotografo:</span>
						<strong id="stat-keepsake-margin" style="color: #1e40af;">+3 unità</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0;">
						<span style="color: #475569;">Tempo di Confezionamento DIY:</span>
						<strong id="stat-diy-hours" style="color: var(--fg-pencil);">1 h 37 min (1 persona)</strong>
					</div>
				</div>

				<!-- Quick Table Hardware Recommendation -->
				<div style="background: #fef08a; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: var(--fg-pencil); display: block; margin-bottom: 0.25rem;">📦 Allestimento Tavolo Bomboniere:</strong>
					<span id="stat-table-hardware" style="color: #334155;">
						Richiede <strong>3 o 4 vassoi o cassette decorative</strong> su un <strong>tavolo da 1,20 m</strong> con cornice e cartello.
					</span>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-export-pdf" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Stampa PDF
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Esporta Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Section: 1-Click Printable Sign Studio -->
		<section id="section-print-studio" class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<div style="text-align: center; margin-bottom: 1.5rem;">
				<span class="badge-postit" style="padding: 3px 10px; border-radius: 4px; font-size: 0.82rem; font-weight: 700;">Generatore di Cartelli</span>
				<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0.4rem 0 0.25rem;">
					Cartelli da Tavolo Stampabili "Prendete una Bomboniera"
				</h2>
				<p class="font-body" style="font-size: 0.9rem; color: var(--text-secondary); margin: 0;">
					Personalizza cartelli da tavolo in formato 20x25 cm o 13x18 cm con i vostri nomi e data delle nozze.
				</p>
			</div>

			<!-- Controls for Sign Studio -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
				<div>
					<label for="input-couple-names" style="display: block; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.25rem;">Nomi degli Sposi:</label>
					<input type="text" id="input-couple-names" value="Giulia & Marco" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 600;" />
				</div>
				<div>
					<label for="input-wedding-date" style="display: block; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.25rem;">Data delle Nozze:</label>
					<input type="text" id="input-wedding-date" value="18 Ottobre 2026" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 600;" />
				</div>
				<div>
					<label for="select-sign-template" style="display: block; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.25rem;">Testo del Cartello:</label>
					<select id="select-sign-template" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 600; background: #fff;">
						<option value="classic" selected>Con Amore e Gratitudine • Prendete un ricordo</option>
						<option value="couple">Per Voi • Uno per coppia con tutto il nostro affetto</option>
						<option value="sweet">Un Dolce Ricordo • Prendete un pensiero</option>
						<option value="seeds">Fate Crescere l'Amore • Prendete una piantina</option>
					</select>
				</div>
				<div>
					<label for="select-sign-size" style="display: block; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.25rem;">Formato Cornice:</label>
					<select id="select-sign-size" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 600; background: #fff;">
						<option value="8x10" selected>20 x 25 cm (Cornice da Tavolo Standard)</option>
						<option value="5x7">13 x 18 cm (Cavalletto Compatto)</option>
					</select>
				</div>
			</div>

			<!-- Live Rendered Framed Sign Canvas -->
			<div style="max-width: 500px; margin: 0 auto; background: #fff; border: 3px solid var(--fg-pencil); border-radius: 8px; padding: 2rem 1.5rem; text-align: center; box-shadow: 4px 4px 0px var(--fg-pencil);" id="sign-canvas-preview">
				<div style="border: 2px double #1e293b; padding: 2rem 1.25rem;">
					<span style="font-size: 1.5rem; display: block; margin-bottom: 0.5rem;">🎁</span>
					<h3 id="sign-preview-headline" class="font-heading" style="font-size: 1.8rem; color: #0f172a; margin: 0 0 0.5rem; line-height: 1.2;">
						Con Amore e Gratitudine
					</h3>
					<p id="sign-preview-subtext" style="font-size: 1.05rem; font-style: italic; color: #475569; margin: 0 0 1.25rem;">
						Prendete un ricordo per festeggiare il nostro giorno speciale!
					</p>
					<div style="width: 50px; height: 1.5px; background: #cbd5e1; margin: 0 auto 1.25rem;"></div>
					<h4 id="sign-preview-names" class="font-heading" style="font-size: 1.15rem; letter-spacing: 0.05em; text-transform: uppercase; color: #0f172a; margin: 0 0 0.25rem;">
						Giulia & Marco
					</h4>
					<span id="sign-preview-date" style="font-size: 0.85rem; color: #64748b;">18 Ottobre 2026</span>
				</div>
			</div>
		</section>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/it/wedding-favors-calculator" category="guests" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-sign-container" class="print-page" style="page-break-after: always; break-after: page; padding: 15mm; text-align: center;">
			<div style="border: 4px double #000; padding: 25mm 15mm; min-height: 190mm; display: flex; flex-direction: column; justify-content: center; align-items: center;">
				<h1 id="print-sign-title" style="font-size: 36pt; font-family: 'Georgia', serif; margin: 0 0 15pt 0; color: #000;">Con Amore e Gratitudine</h1>
				<p id="print-sign-sub" style="font-size: 18pt; font-style: italic; margin: 0 0 25pt 0; color: #333;">Prendete una bomboniera come ricordo!</p>
				<div style="width: 70mm; height: 1.5pt; background: #000; margin: 0 auto 20pt;"></div>
				<h2 id="print-sign-names" style="font-size: 18pt; letter-spacing: 2pt; text-transform: uppercase; margin: 0 0 8pt 0; color: #000;">Giulia & Marco</h2>
				<p id="print-sign-date" style="font-size: 13pt; color: #555; margin: 0;">18 Ottobre 2026</p>
			</div>
		</div>

		<div id="print-order-sheet-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Modulo d'Ordine: Bomboniere & Confetti Matrimonio</h1>
				<p id="print-order-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Sposi: Giulia & Marco | Data: 18 Ottobre 2026 | Invitati: 120</p>
			</div>
			<div id="print-order-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const sliderGuests = document.getElementById('slider-guests');
	const badgeGuests = document.getElementById('badge-guests');
	const radioModeIndividual = document.getElementById('radio-mode-individual');
	const radioModeCouple = document.getElementById('radio-mode-couple');
	const labelModeIndividual = document.getElementById('label-mode-individual');
	const labelModeCouple = document.getElementById('label-mode-couple');
	const selectFavorType = document.getElementById('select-favor-type');
	const selectPlacement = document.getElementById('select-placement');
	const selectBuffer = document.getElementById('select-buffer');
	const inputItemCost = document.getElementById('input-item-cost');
	const inputAssemblySeconds = document.getElementById('input-assembly-seconds');

	const badgeDistType = document.getElementById('badge-dist-type');
	const statOrderQty = document.getElementById('stat-order-qty');
	const statSubtextQty = document.getElementById('stat-subtext-qty');
	const statTotalSpend = document.getElementById('stat-total-spend');
	const statPerGuestCost = document.getElementById('stat-per-guest-cost');
	const statHouseholdCount = document.getElementById('stat-household-count');
	const statAttritionRate = document.getElementById('stat-attrition-rate');
	const statKeepsakeMargin = document.getElementById('stat-keepsake-margin');
	const statDiyHours = document.getElementById('stat-diy-hours');
	const statTableHardware = document.getElementById('stat-table-hardware');

	function calculateFavors() {
		const guests = parseInt(sliderGuests.value, 10) || 120;
		badgeGuests.textContent = `${guests} Invitati`;

		const isCouple = radioModeCouple.checked;
		const households = Math.ceil(guests * 0.56);
		statHouseholdCount.textContent = `${households} Famiglie`;

		const baseTarget = isCouple ? households : guests;
		badgeDistType.textContent = isCouple ? '1 A Coppia' : '1 A Persona';

		const bufferStrategy = selectBuffer.value;
		let bufferPercent = 0.05;
		let keepsakeExtra = 3;

		if (bufferStrategy === 'eco') {
			bufferPercent = -0.15;
			keepsakeExtra = 2;
		} else if (bufferStrategy === 'generous') {
			bufferPercent = 0.12;
			keepsakeExtra = 5;
		}

		let finalQty = Math.round(baseTarget * (1 + bufferPercent)) + keepsakeExtra;
		if (finalQty < 1) finalQty = 1;

		statOrderQty.textContent = finalQty;
		
		const extraCount = finalQty - baseTarget;
		const extraSign = extraCount >= 0 ? `+${extraCount}` : `${extraCount}`;
		statSubtextQty.textContent = `(${baseTarget} base ${extraSign} scorta/foto)`;

		const unitCost = parseFloat(inputItemCost.value) || 0;
		const totalSpend = (finalQty * unitCost).toFixed(2);
		statTotalSpend.textContent = `${Number(totalSpend).toLocaleString('it-IT', { minimumFractionDigits: 2 })} €`;
		
		const costPerAttending = (parseFloat(totalSpend) / guests).toFixed(2);
		statPerGuestCost.textContent = `${costPerAttending} € per invitato presente`;

		const favorType = selectFavorType.value;
		let attritionRateNum = 0.05;
		if (favorType.includes('monogram')) attritionRateNum = 0.25;
		else if (favorType.includes('seed') || favorType.includes('keepsake-useful')) attritionRateNum = 0.15;
		else if (favorType.includes('bulk')) attritionRateNum = 0.08;

		if (selectPlacement.value === 'place-setting') attritionRateNum += 0.05;
		
		const estimatedLeftovers = Math.round(finalQty * attritionRateNum);
		statAttritionRate.textContent = `~${estimatedLeftovers} pz dimenticati (${Math.round(attritionRateNum * 100)}%)`;
		statKeepsakeMargin.textContent = `+${keepsakeExtra} pz (Sposi e Foto)`;

		const assemblySecPerUnit = parseInt(inputAssemblySeconds.value, 10) || 0;
		const totalSec = finalQty * assemblySecPerUnit;
		if (totalSec === 0) {
			statDiyHours.textContent = '0 min (Pronte da esporre)';
		} else {
			const hrs = Math.floor(totalSec / 3600);
			const mins = Math.ceil((totalSec % 3600) / 60);
			statDiyHours.textContent = hrs > 0 ? `${hrs} h ${mins} min (1 persona)` : `${mins} min (1 persona)`;
		}

		const traysCount = Math.max(1, Math.ceil(finalQty / 35));
		const tableFootage = finalQty > 100 ? 'tavolo da 1,80 m' : 'tavolo da 1,20 m';
		statTableHardware.innerHTML = `Richiede <strong>${traysCount} vassoi/cassette</strong> su un <strong>${tableFootage}</strong> con cornice e cartello.`;

		const couple = document.getElementById('input-couple-names').value || 'Giulia & Marco';
		const date = document.getElementById('input-wedding-date').value || '18 Ottobre 2026';
		document.getElementById('print-order-meta').textContent = `Sposi: ${couple} | Data: ${date} | Invitati: ${guests} | Distribuzione: ${badgeDistType.textContent}`;

		document.getElementById('print-order-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Parametro Bomboniere</th>
						<th style="padding:6pt; text-align:center;">Quantità Calcolata</th>
						<th style="padding:6pt;">Note e Istruzioni</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Totale Bomboniere da Acquistare</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; font-size:12pt; color:#1e40af;">${finalQty} unità</td>
						<td style="padding:6pt;">Base (${baseTarget}) più ${extraSign} di scorta e foto di dettaglio.</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Budget Totale Stimato</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#15803d;">${Number(totalSpend).toLocaleString('it-IT', { minimumFractionDigits: 2 })} €</td>
						<td style="padding:6pt;">A ${unitCost.toFixed(2)} €/unità (${costPerAttending} €/invitato).</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Vassoi e Cassette Allestimento</td>
						<td style="padding:6pt; text-align:center;">${traysCount} Vassoi / Cassette</td>
						<td style="padding:6pt;">Posizionare su ${tableFootage} con cornice 20x25 cm.</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Lavoro di Confezionamento DIY</td>
						<td style="padding:6pt; text-align:center;">${statDiyHours.textContent}</td>
						<td style="padding:6pt;">Pianificare la sessione nastri e confetti 2 o 3 settimane prima.</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	function updateModeStyles() {
		if (radioModeIndividual.checked) {
			labelModeIndividual.style.background = '#fef08a';
			labelModeCouple.style.background = '#ffffff';
		} else {
			labelModeIndividual.style.background = '#ffffff';
			labelModeCouple.style.background = '#fef08a';
		}
		calculateFavors();
	}

	function updateSignPreview() {
		const couple = document.getElementById('input-couple-names').value || 'Giulia & Marco';
		const date = document.getElementById('input-wedding-date').value || '18 Ottobre 2026';
		const template = document.getElementById('select-sign-template').value;

		document.getElementById('sign-preview-names').textContent = couple;
		document.getElementById('sign-preview-date').textContent = date;
		
		const headline = document.getElementById('sign-preview-headline');
		const subtext = document.getElementById('sign-preview-subtext');

		if (template === 'couple') {
			headline.textContent = 'Per Voi';
			subtext.textContent = 'Prendetene una per coppia con tutto il nostro affetto!';
		} else if (template === 'sweet') {
			headline.textContent = 'Un Dolce Ricordo';
			subtext.textContent = 'Per un nuovo inizio! Prendete un dolce pensiero all\'uscita.';
		} else if (template === 'seeds') {
			headline.textContent = 'Fate Crescere l\'Amore';
			subtext.textContent = 'Piantate questi semi e fate fiorire la felicità!';
		} else {
			headline.textContent = 'Con Amore e Gratitudine';
			subtext.textContent = 'Prendete un ricordo per festeggiare il nostro giorno speciale!';
		}

		document.getElementById('print-sign-title').textContent = headline.textContent;
		document.getElementById('print-sign-sub').textContent = subtext.textContent;
		document.getElementById('print-sign-names').textContent = couple;
		document.getElementById('print-sign-date').textContent = date;
	}

	sliderGuests.addEventListener('input', calculateFavors);
	radioModeIndividual.addEventListener('change', updateModeStyles);
	radioModeCouple.addEventListener('change', updateModeStyles);
	selectFavorType.addEventListener('change', calculateFavors);
	selectPlacement.addEventListener('change', calculateFavors);
	selectBuffer.addEventListener('change', calculateFavors);
	inputItemCost.addEventListener('input', calculateFavors);
	inputAssemblySeconds.addEventListener('change', calculateFavors);

	document.getElementById('input-couple-names').addEventListener('input', updateSignPreview);
	document.getElementById('input-wedding-date').addEventListener('input', updateSignPreview);
	document.getElementById('select-sign-template').addEventListener('change', updateSignPreview);
	document.getElementById('select-sign-size').addEventListener('change', updateSignPreview);

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		calculateFavors();
		updateSignPreview();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const couple = document.getElementById('input-couple-names').value || 'Giulia & Marco';
		const date = document.getElementById('input-wedding-date').value || '18 Ottobre 2026';
		const guests = sliderGuests.value || '120';
		const finalQty = statOrderQty.textContent;
		const totalSpend = statTotalSpend.textContent;
		const diyHours = statDiyHours.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Riepilogo Ordine Bomboniere</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Riepilogo Ordine: Bomboniere e Confetti Matrimonio</h1>
				<p><strong>Sposi:</strong> ${couple} | <strong>Data:</strong> ${date} | <strong>Invitati:</strong> ${guests}</p>
				<hr/>
				<h2>Dettagli Quantità</h2>
				<table>
					<tr style="background:#f1f5f9;">
						<th>Parametro</th><th>Valore</th>
					</tr>
					<tr><td><strong>Totale da Ordinare:</strong></td><td><strong>${finalQty} unità</strong></td></tr>
					<tr><td><strong>Spesa Prevista:</strong></td><td><strong>${totalSpend}</strong></td></tr>
					<tr><td><strong>Distribuzione:</strong></td><td>${badgeDistType.textContent}</td></tr>
					<tr><td><strong>Tempo Confezionamento DIY:</strong></td><td>${diyHours}</td></tr>
				</table>
				<hr/>
				<p><em>Generato da Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Bomboniere-${couple.replace(/[^a-zA-Z0-9]/g, '-')}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateFavors();
	updateSignPreview();
</script>
