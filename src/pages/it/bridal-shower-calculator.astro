---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calcolatore Budget Bridal Shower e Festa della Sposa",
      "url": "https://manage.wedding/it/bridal-shower-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calcola il budget del bridal shower / addio al nubilato elegante, dividi le spese equamente tra damigelle e calcola cibo e mimosa bar.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calcolatore Budget Bridal Shower — Divisione Spese Damigelle"
	description="Calcola il budget per il bridal shower, dividi i costi tra le damigelle, organizza il buffet brunch e la quantità di prosecco per il mimosa bar."
	lang="it"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/it/" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/it/budget" style="color: var(--text-secondary); text-decoration: none;">Budget e Feste</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Calcolatore Bridal Shower</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🧁</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Pianificatore Damigelle d'Onore & Mimosa Bar</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calcolatore Budget Bridal Shower
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Calcola le spese totali per la festa della sposa, dimensiona il <strong>brunch e l'angolo mimosa bar</strong>, e ottieni la <strong>quota esatta a carico di ciascuna damigella</strong>.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Inputs -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>👥</span> 1. Invitate & Divisione Spese
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-shower-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Totale Invitate:</label>
						<input type="number" id="input-shower-guests" min="5" max="100" value="25" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="input-shower-hosts" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Damigelle che Pagano:</label>
						<input type="number" id="input-shower-hosts" min="1" max="12" value="5" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🥂 2. Location, Menu & Bevande
				</h2>

				<div style="margin-bottom: 1rem;">
					<label for="select-venue-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Location:</label>
					<select id="select-venue-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="home" selected>🏡 Casa / Giardino privato (0 €)</option>
						<option value="loft">🏛️ Sala da Tè / Spazio in Affitto (~350 €)</option>
						<option value="restaurant">🍽️ Ristorante Sala Privata (~45 € / ospite)</option>
					</select>
				</div>

				<div style="margin-bottom: 1rem;">
					<label for="select-food-tier" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Buffet / Brunch:</label>
					<select id="select-food-tier" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="light">🥐 Finger food leggero, frutta e canapè (18 € / pers.)</option>
						<option value="brunch" selected>🍳 Brunch Completo (Quiche, bagel, waffle, salumi - 30 € / pers.)</option>
						<option value="plated">🥗 Pranzo Servito 2 Portate (48 € / pers.)</option>
					</select>
				</div>

				<div style="margin-bottom: 1rem;">
					<label for="select-bar-package" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Mimosa Bar & Drink:</label>
					<select id="select-bar-package" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="full-mimosa" selected>🍾 Mimosa Bar Fai-da-te (Prosecco, succhi, frutti di bosco - 14 € / pers.)</option>
						<option value="wine-beer">🍷 Vino, Bollicine e Mocktail (20 € / pers.)</option>
						<option value="dry">☕ Caffè, Tè & Limonata fresca (6 € / pers.)</option>
					</select>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🎈 3. Torta, Decorazioni & Giochi
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="input-cake-cost" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Torta / Cupcake (€):</label>
						<input type="number" id="input-cake-cost" min="0" max="500" value="85" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="input-decor-cost" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Palloncini & Fiori (€):</label>
						<input type="number" id="input-decor-cost" min="0" max="1000" value="150" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0.75rem;">
					<div>
						<label for="input-favors-pp" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Pensierini (€ / invitata):</label>
						<input type="number" id="input-favors-pp" min="0" max="30" value="5" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="input-game-prizes" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Premi Giochi (€ totale):</label>
						<input type="number" id="input-game-prizes" min="0" max="300" value="60" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Riepilogo Spese</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Budget Bridal Shower
						</h2>
					</div>
					<span id="badge-guest-cost" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">59 € / pers.</span>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Costo Totale</span>
						<strong id="stat-total-budget" style="font-size: 2rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">1.470 €</strong>
						<span id="stat-total-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(Tutte le voci)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Quota per Damigella</span>
						<strong id="stat-host-share" style="font-size: 2rem; font-weight: 900; color: #1e40af; line-height: 1.1;">294 €</strong>
						<span id="stat-host-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">Diviso tra 5 damigelle</span>
					</div>
				</div>

				<div style="background: #eff6ff; border: 1.5px solid #1e40af; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #1e40af; display: block; margin-bottom: 0.35rem;">🍾 Spesa Mimosa Bar (25 invitate):</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #1e3a8a;">
						<div>• <strong id="stat-champagne-bottles">13 Bottiglie</strong> Prosecco</div>
						<div>• <strong id="stat-juice-carafes">4 Caraffe</strong> Succhi</div>
						<div>• <strong id="stat-berry-tubs">3 Vaschette</strong> Frutti di bosco</div>
						<div>• <strong id="stat-gift-time">~30 Min</strong> Apertura Regali</div>
					</div>
				</div>

				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🏛️ Spazio / Affitto:</span>
						<strong id="stat-line-venue" style="color: var(--fg-pencil);">0 €</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🥐 Cibo e Brunch:</span>
						<strong id="stat-line-food" style="color: var(--fg-pencil);">750 €</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🍾 Mimosa Bar:</span>
						<strong id="stat-line-bar" style="color: var(--fg-pencil);">350 €</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🎈 Torta, Fiori & Giochi:</span>
						<strong id="stat-line-decor" style="color: var(--fg-pencil);">295 €</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">🎁 Pensierini Invitate:</span>
						<strong id="stat-line-favors" style="color: var(--fg-pencil);">125 €</strong>
					</div>
				</div>

				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Stampa Divisione (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Esporta Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/it/bridal-shower-calculator" category="budget" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-shower-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Budget Bridal Shower & Quota per Damigella</h1>
				<p id="print-shower-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Organizzazione Damigelle d'Onore | Generato da Manage.Wedding</p>
			</div>
			<div id="print-shower-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const inputShowerGuests = document.getElementById('input-shower-guests');
	const inputShowerHosts = document.getElementById('input-shower-hosts');
	const selectVenueType = document.getElementById('select-venue-type');
	const selectFoodTier = document.getElementById('select-food-tier');
	const selectBarPackage = document.getElementById('select-bar-package');
	const inputCakeCost = document.getElementById('input-cake-cost');
	const inputDecorCost = document.getElementById('input-decor-cost');
	const inputFavorsPp = document.getElementById('input-favors-pp');
	const inputGamePrizes = document.getElementById('input-game-prizes');

	const statTotalBudget = document.getElementById('stat-total-budget');
	const statHostShare = document.getElementById('stat-host-share');
	const statHostSub = document.getElementById('stat-host-sub');
	const badgeGuestCost = document.getElementById('badge-guest-cost');

	const statLineVenue = document.getElementById('stat-line-venue');
	const statLineFood = document.getElementById('stat-line-food');
	const statLineBar = document.getElementById('stat-line-bar');
	const statLineDecor = document.getElementById('stat-line-decor');
	const statLineFavors = document.getElementById('stat-line-favors');

	const statChampagneBottles = document.getElementById('stat-champagne-bottles');
	const statJuiceCarafes = document.getElementById('stat-juice-carafes');
	const statBerryTubs = document.getElementById('stat-berry-tubs');
	const statGiftTime = document.getElementById('stat-gift-time');

	function calculateShower() {
		const guests = Math.max(1, parseInt(inputShowerGuests.value, 10) || 25);
		const hosts = Math.max(1, parseInt(inputShowerHosts.value, 10) || 5);

		let venueCost = 0;
		if (selectVenueType.value === 'loft') venueCost = 350;
		else if (selectVenueType.value === 'restaurant') venueCost = guests * 45;

		let foodRate = 30;
		if (selectFoodTier.value === 'light') foodRate = 18;
		else if (selectFoodTier.value === 'plated') foodRate = 48;
		const foodCost = guests * foodRate;

		let barRate = 14;
		if (selectBarPackage.value === 'wine-beer') barRate = 20;
		else if (selectBarPackage.value === 'dry') barRate = 6;
		const barCost = guests * barRate;

		const cakeCost = parseFloat(inputCakeCost.value) || 0;
		const decorCost = parseFloat(inputDecorCost.value) || 0;
		const favorsCost = guests * (parseFloat(inputFavorsPp.value) || 0);
		const prizesCost = parseFloat(inputGamePrizes.value) || 0;

		const totalBudget = venueCost + foodCost + barCost + cakeCost + decorCost + favorsCost + prizesCost;
		const perHost = totalBudget / hosts;
		const perGuest = totalBudget / guests;

		statTotalBudget.textContent = `${Math.round(totalBudget).toLocaleString()} €`;
		statHostShare.textContent = `${Math.round(perHost).toLocaleString()} €`;
		statHostSub.textContent = `Diviso tra ${hosts} damigelle`;
		badgeGuestCost.textContent = `${Math.round(perGuest)} € / pers.`;

		statLineVenue.textContent = `${Math.round(venueCost).toLocaleString()} €`;
		statLineFood.textContent = `${Math.round(foodCost).toLocaleString()} €`;
		statLineBar.textContent = `${Math.round(barCost).toLocaleString()} €`;
		statLineDecor.textContent = `${Math.round(cakeCost + decorCost + prizesCost).toLocaleString()} €`;
		statLineFavors.textContent = `${Math.round(favorsCost).toLocaleString()} €`;

		const champagneBottles = Math.ceil(guests / 2);
		const juiceCarafes = Math.max(2, Math.ceil(guests / 7));
		const berryTubs = Math.max(2, Math.ceil(guests / 9));
		const giftMins = Math.round(guests * 1.2);

		statChampagneBottles.textContent = `${champagneBottles} Bottiglie`;
		statJuiceCarafes.textContent = `${juiceCarafes} Caraffe`;
		statBerryTubs.textContent = `${berryTubs} Vaschette`;
		statGiftTime.textContent = `~${giftMins} Min`;

		document.getElementById('print-shower-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Voce di Spesa</th>
						<th style="padding:6pt;">Dettaglio</th>
						<th style="padding:6pt; text-align:right;">Subtotale</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Affitto Location</td>
						<td style="padding:6pt;">${selectVenueType.options[selectVenueType.selectedIndex].text}</td>
						<td style="padding:6pt; text-align:right;">${Math.round(venueCost)} €</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Buffet / Brunch</td>
						<td style="padding:6pt;">${guests} invitate @ ${foodRate} €/pers.</td>
						<td style="padding:6pt; text-align:right;">${Math.round(foodCost)} €</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Mimosa Bar & Bevande</td>
						<td style="padding:6pt;">${champagneBottles} bottiglie di prosecco, succhi e frutti</td>
						<td style="padding:6pt; text-align:right;">${Math.round(barCost)} €</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Torta, Fiori & Giochi</td>
						<td style="padding:6pt;">Torta pasticceria, centrotavola e premi giochi</td>
						<td style="padding:6pt; text-align:right;">${Math.round(cakeCost + decorCost + prizesCost)} €</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Pensierini Invitate</td>
						<td style="padding:6pt;">${guests} regalini @ ${inputFavorsPp.value} €/pers.</td>
						<td style="padding:6pt; text-align:right;">${Math.round(favorsCost)} €</td>
					</tr>
					<tr style="background:#eff6ff; font-weight:bold; font-size:11pt; border-top:2pt solid #000;">
						<td style="padding:8pt;">TOTALE BRIDAL SHOWER</td>
						<td style="padding:8pt;">${guests} Invitate</td>
						<td style="padding:8pt; text-align:right; color:#b91c1c;">${Math.round(totalBudget)} €</td>
					</tr>
					<tr style="background:#f0fdf4; font-weight:bold; font-size:12pt; border-top:1.5pt solid #15803d;">
						<td style="padding:8pt; color:#15803d;">QUOTA PER DAMIGELLA</td>
						<td style="padding:8pt; color:#15803d;">Diviso tra ${hosts} damigelle</td>
						<td style="padding:8pt; text-align:right; color:#15803d;">${Math.round(perHost)} € / damigella</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	[inputShowerGuests, inputShowerHosts, selectVenueType, selectFoodTier, selectBarPackage, inputCakeCost, inputDecorCost, inputFavorsPp, inputGamePrizes].forEach(el => {
		el.addEventListener('input', calculateShower);
		el.addEventListener('change', calculateShower);
	});

	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateShower();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateShower();
		const total = statTotalBudget.textContent;
		const perHost = statHostShare.textContent;
		const guests = inputShowerGuests.value;
		const hosts = inputShowerHosts.value;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Budget Bridal Shower</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Budget Bridal Shower e Divisione Quote</h1>
				<p><strong>Invitate:</strong> ${guests} | <strong>Damigelle:</strong> ${hosts} | <strong>Budget Totale:</strong> ${total} | <strong>A Testa:</strong> ${perHost}</p>
				<hr/>
				<h2>Lista Spesa Mimosa Bar</h2>
				<p>• ${statChampagneBottles.textContent} di Prosecco</p>
				<p>• ${statJuiceCarafes.textContent} di succo all'arancia, pesca e mirtillo</p>
				<p>• ${statBerryTubs.textContent} di fragole e lamponi freschi</p>
				<hr/>
				<p><em>Generato da Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Budget-Bridal-Shower-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateShower();
</script>
