---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/honeymoon-budget-estimator/#webapp",
      "name": "Calcolatore Budget Viaggio di Nozze per Destinazione",
      "url": "https://manage.wedding/it/honeymoon-budget-estimator",
      "inLanguage": "it",
      "description": "Calcola il costo reale della luna di miele per coppia: voli A/R, hotel e resort di lusso, overwater bungalow, cene a lume di candela, escursioni e assicurazione con export Word e PDF.",
      "applicationCategory": "TravelApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come calcolare e pianificare il budget per il viaggio di nozze",
      "description": "Guida passo-passo per stimare i costi della luna di miele tra voli, resort, ristoranti ed escursioni.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Scegliere la fascia della destinazione",
          "text": "Seleziona tra mete tropicali accessibili (Bali, Thailandia), itinerari classici (Giappone, Caraibi) o mete di lusso estremo (Maldive, Polinesia)."
        },
        {
          "@type": "HowToStep",
          "name": "2. Destinare il 45–50% a Resort e Alloggi",
          "text": "Riserva circa metà della spesa per hotel di charme, ville con piscina privata o overwater bungalow."
        },
        {
          "@type": "HowToStep",
          "name": "3. Assegnare il 25–30% a Voli e Trasferimenti",
          "text": "Calcola i biglietti aerei di andata e ritorno per la coppia, transfer in idrovolante o auto a noleggio."
        },
        {
          "@type": "HowToStep",
          "name": "4. Calcolare Cene Romantiche ed Escursioni",
          "text": "Pianifica cene a lume di candela, massaggi di coppia, crociere al tramonto e assicurazione sanitaria."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanto costa mediamente un viaggio di nozze per due persone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il costo medio di una luna di miele in Italia è compreso tra 5.000 € e 9.000 € per un viaggio di 10–14 giorni. Mete accessibili come Bali o Thailandia oscillano tra 3.500 € e 5.500 €, mete come Giappone o Stati Uniti tra 6.500 € e 10.000 €, mentre soggiorni di lusso alle Maldive o in Polinesia superano i 12.000 € – 20.000 €."
          }
        },
        {
          "@type": "Question",
          "name": "Con quanto anticipo bisogna prenotare la luna di miele?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per voli intercontinentali e resort esclusivi in alta stagione è consigliabile prenotare tra 6 e 9 mesi prima per usufruire delle migliori tariffe e garantirsi le tipologie di camera desiderate."
          }
        },
        {
          "@type": "Question",
          "name": "Come inserire il viaggio di nozze nella lista nozze per gli invitati?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Molte coppie aprono una lista nozze in agenzia o sul proprio sito web, permettendo agli invitati di regalare quote libere o singole esperienze tangibili (es. 'Cena a lume di candela sulla spiaggia: 150 €', 'Massaggio di coppia: 200 €', 'Volo interno: 250 €')."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Budget Viaggio di Nozze per Destinazione | Manage.Wedding"
	description="Calcola il costo della luna di miele in base alla destinazione: voli, resort, overwater bungalow, cene romantiche ed escursioni con export Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Budget Viaggio di Nozze" category="budget-finance" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calcolatore Budget <span class="accent-italic">Viaggio di Nozze</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calcola il preventivo realistico per la luna di miele per due: seleziona la <strong>fascia di destinazione</strong>, la classe di volo, la tipologia di resort ed esporta il piano in <strong>Word</strong> o <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Come Pianificare la Luna di Miele in 3 Passaggi
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Scegli la Destinazione
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Seleziona l'area geografica: dalle spiagge tropicali di Bali e Thailandia al tour del Giappone fino alle overwater villa delle Maldive.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Personalizza Stile & Comfort
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Imposta durata in giorni, classe aerea, categoria alberghiera (4 stelle, 5 stelle lusso o villa privata) e attività di coppia.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Esporta per la Lista Nozze
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Salva il preventivo per pianificare i risparmi o suddividere le singole voci in quote regalo per i vostri invitati.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="honeymoon-calc-grid">
			
			<!-- Left Column: Travel Parameters Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							✈️ Parametri di Viaggio (per la Coppia)
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Tutti i costi sono calcolati automaticamente per 2 viaggiatori
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Valuta:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="CHF">CHF (Franco Svizzero)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="honeymoon-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Destination Country Tier -->
					<div>
						<label for="select-country-tier" class="font-heading" style="display: block; font-size: 1rem; color: var(--accent-red); margin-bottom: 0.3rem;">
							1. Destinazione & Indice di Costo *
						</label>
						<select id="select-country-tier" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="tier1">🌴 Fascia 1: Tropicale & Culturale (Bali, Thailandia, Messico, Portogallo, Costa Rica)</option>
							<option value="tier2" selected>🏖️ Fascia 2: Classico Internazionale & Tour (Giappone, Caraibi, USA, Grecia, Spagna)</option>
							<option value="tier3">💎 Fascia 3: Lusso Esclusivo & Overwater (Maldive, Polinesia / Bora Bora, Seychelles)</option>
							<option value="tier4">🦁 Fascia 4: Grandi Avventure & Safari (Safari in Tanzania/Sudafrica, Galapagos)</option>
							<option value="domestic">🚗 Fascia 5: Itinerari in Italia & Vicinanze (Sardegna, Costiera Amalfitana, Dolomiti)</option>
						</select>
					</div>

					<!-- 2. Trip Duration & Flight Class -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;">
						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-trip-days" class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
									Durata Viaggio (Giorni / Notti)
								</label>
								<span id="trip-days-display" style="font-size: 0.95rem; font-weight: bold; color: var(--accent-blue);">10 Giorni</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.5rem;">
								<input type="range" id="input-trip-days" min="3" max="28" value="10" step="1" style="flex: 1; accent-color: var(--accent-blue);">
								<input type="number" id="input-trip-days-num" value="10" min="3" max="28" style="width: 50px; padding: 0.3rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center; font-weight: bold;">
							</div>
						</div>

						<div>
							<label for="select-flight-class" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Voli A/R per la Coppia
							</label>
							<select id="select-flight-class" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
								<option value="economy" selected>Classe Economy Standard</option>
								<option value="premium">Premium Economy (+40%)</option>
								<option value="business">Business Class (2,5x)</option>
								<option value="points">Miglia / Punti Fedeltà (solo tasse)</option>
							</select>
						</div>
					</div>

					<!-- 3. Resort & Lodging Standard -->
					<div>
						<label for="select-lodging-style" class="font-heading" style="display: block; font-size: 1rem; color: var(--accent-blue); margin-bottom: 0.3rem;">
							2. Categoria Struttura & Resort (a Notte)
						</label>
						<select id="select-lodging-style" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="boutique">Hotel Boutique di Charme / B&B Tipico</option>
							<option value="resort4" selected>Resort 4 Stelle Fronte Mare / Hotel Storico</option>
							<option value="luxury5">Resort 5 Stelle Lusso / Villa con Piscina Privata</option>
							<option value="overwater">Overwater Bungalow / Luxury Safari Lodge</option>
						</select>
					</div>

					<!-- 4. Dining, Excursions & Extras -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<span class="font-heading" style="font-size: 0.95rem; color: #16a34a; display: block;">
							3. Ristorazione, Escursioni & Servizi Extra
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">Stile Ristorazione</span>
								<select id="select-dining-style" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="moderate">Mix Trattorie Tipiche & Cene Romantiche</option>
									<option value="fine_dining" selected>Cene Gourmet & Cocktail al Tramonto</option>
									<option value="budget">Ristoranti Locali & Street Food</option>
									<option value="michelin">Ristoranti Stellati Michelin & Cene Private</option>
								</select>
							</div>

							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">Escursioni & Attività</span>
								<select id="select-excursions-style" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="moderate" selected>Massaggio di Coppia, Barca & Tour Guidati</option>
									<option value="light">Relax in Spiaggia & Visite in Autonomia</option>
									<option value="heavy">Esperienze Esclusive (Elicottero, Sub, Guida Privata)</option>
								</select>
							</div>
						</div>

						<div style="display: flex; gap: 1rem; flex-wrap: wrap; padding-top: 0.3rem;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-travel-insurance" checked style="accent-color: var(--fg-pencil);">
								<span>Assicurazione Sanitaria/Annullamento & Transfer (250 €)</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-shopping-buffer" checked style="accent-color: var(--fg-pencil);">
								<span>Fondo Souvenir & Shopping (350 €)</span>
							</label>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Honeymoon Total Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🏖️ Preventivo Totale Luna di Miele
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Stima completa all-inclusive per la coppia
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Esporta Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Stampa PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Budget Total Highlight -->
					<div style="background: #f0fdf4; border: 2.5px solid #16a34a; border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: #16a34a; display: block; font-weight: bold;">Budget Stimato Complessivo</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: #16a34a; display: block; line-height: 1.2;">7.850 €</strong>
						<span id="res-per-day-note" style="font-size: 0.8rem; color: #16a34a;">Circa 785 € / Giorno per la coppia</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Dettaglio Voci di Spesa
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">✈️ Voli A/R (2 persone):</td>
									<td id="res-flight-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">2.200 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🏨 Resort & Alloggi (<span id="res-nights-count">10</span> Notti):</td>
									<td id="res-hotel-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">3.200 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Cene, Pranzi & Drink:</td>
									<td id="res-food-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">1.400 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🏄 Escursioni & Attività di Coppia:</td>
									<td id="res-excursions-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">450 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0;">🛡️ Assicurazione, Transfer & Extra:</td>
									<td id="res-extras-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">600 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Travel Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span style="color: var(--accent-red);">Voli (<span id="pct-flights">28%</span>)</span>
							<span style="color: var(--accent-blue);">Resort (<span id="pct-hotel">41%</span>)</span>
							<span style="color: #16a34a;">Cibo (<span id="pct-food">18%</span>)</span>
							<span style="color: #7c3aed;">Attività (<span id="pct-excursions">13%</span>)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-flights" style="width: 28%; background: var(--accent-red); transition: width 0.3s ease;"></div>
							<div id="bar-hotel" style="width: 41%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-food" style="width: 18%; background: #16a34a; transition: width 0.3s ease;"></div>
							<div id="bar-excursions" style="width: 13%; background: #7c3aed; transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Registry Cash Fund Tip Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						💡 Idea per la Lista Nozze:
					</strong>
					<p class="font-body" style="font-size: 0.85rem; line-height: 1.5; margin: 0; color: var(--fg-pencil); text-align: center;">
						Trasforma le voci di questo preventivo in regali per gli invitati! Agli ospiti piace regalare esperienze concrete come <em>"Cena romantica al tramonto (150 €)"</em> o <em>"Massaggio di coppia in spa (180 €)"</em>.
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Preventivo Viaggio di Nozze</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Data: <span id="print-date"></span> | Budget Stimato: <span id="print-total"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Voce di Viaggio</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 120px; text-align: right;">Importo Stimato (€)</th>
					</tr>
				</thead>
				<tbody id="print-honeymoon-body"></tbody>
			</table>
		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guida Completa al Budget per il Viaggio di Nozze
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Dalle mete esotiche alle grandi capitali: come ottimizzare i costi della luna di miele.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. La Formula 50 / 25 / 15 / 10
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Gli esperti di viaggi di nozze consigliano di suddividere il budget in quattro quote principali: 50% per alloggi e resort, 25% per voli e trasporti, 15% per ristorazione e cene speciali, 10% per escursioni e ingressi.
				</p>
			</section>

			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Domande Frequenti (FAQ)
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">L'assicurazione sanitaria è indispensabile per la luna di miele?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Sì, soprattutto per mete extra-europee (Stati Uniti, Caraibi, Asia, Polinesia), una polizza sanitaria con massimali elevati e copertura annullamento è fondamentale per partire in totale tranquillità.
					</p>
				</details>
			</section>
		</article>

		<RelatedTools currentPath="/it/honeymoon-budget-estimator" category="budget" />

	</main>
</Layout>

<script is:inline>
	let currencySymbol = '€';

	const currencySelect = document.getElementById('currency-select');
	const selectCountryTier = document.getElementById('select-country-tier');
	const inputTripDays = document.getElementById('input-trip-days');
	const inputTripDaysNum = document.getElementById('input-trip-days-num');
	const tripDaysDisplay = document.getElementById('trip-days-display');
	const selectFlightClass = document.getElementById('select-flight-class');
	const selectLodgingStyle = document.getElementById('select-lodging-style');
	const selectDiningStyle = document.getElementById('select-dining-style');
	const selectExcursionsStyle = document.getElementById('select-excursions-style');
	const chkInsurance = document.getElementById('chk-travel-insurance');
	const chkShopping = document.getElementById('chk-shopping-buffer');

	const resGrandTotal = document.getElementById('res-grand-total');
	const resPerDayNote = document.getElementById('res-per-day-note');
	const resFlightTotal = document.getElementById('res-flight-total');
	const resHotelTotal = document.getElementById('res-hotel-total');
	const resFoodTotal = document.getElementById('res-food-total');
	const resExcursionsTotal = document.getElementById('res-excursions-total');
	const resExtrasTotal = document.getElementById('res-extras-total');
	const resNightsCount = document.getElementById('res-nights-count');

	const barFlights = document.getElementById('bar-flights');
	const barHotel = document.getElementById('bar-hotel');
	const barFood = document.getElementById('bar-food');
	const barExcursions = document.getElementById('bar-excursions');

	const pctFlights = document.getElementById('pct-flights');
	const pctHotel = document.getElementById('pct-hotel');
	const pctFood = document.getElementById('pct-food');
	const pctExcursions = document.getElementById('pct-excursions');

	function formatMoney(amount) {
		return `${Math.round(amount).toLocaleString('it-IT')} ${currencySymbol}`;
	}

	function calculateHoneymoon() {
		currencySymbol = currencySelect.value;
		const days = parseInt(inputTripDays.value, 10) || 1;
		tripDaysDisplay.textContent = `${days} Giorni`;
		inputTripDaysNum.value = days;
		resNightsCount.textContent = days;

		const tier = selectCountryTier.value;
		let baseFlight = 1600;
		let baseHotelPerNight = 250;
		let baseFoodPerDay = 120;
		let baseExcursionPerDay = 40;

		if (tier === 'tier1') { // Tropicale accessibile
			baseFlight = 1400;
			baseHotelPerNight = 160;
			baseFoodPerDay = 80;
			baseExcursionPerDay = 35;
		} else if (tier === 'tier2') { // Classico
			baseFlight = 1800;
			baseHotelPerNight = 260;
			baseFoodPerDay = 130;
			baseExcursionPerDay = 45;
		} else if (tier === 'tier3') { // Lusso / Maldive / Polinesia
			baseFlight = 2800;
			baseHotelPerNight = 650;
			baseFoodPerDay = 240;
			baseExcursionPerDay = 80;
		} else if (tier === 'tier4') { // Safari
			baseFlight = 2400;
			baseHotelPerNight = 500;
			baseFoodPerDay = 180;
			baseExcursionPerDay = 90;
		} else if (tier === 'domestic') { // Italia
			baseFlight = 300;
			baseHotelPerNight = 220;
			baseFoodPerDay = 120;
			baseExcursionPerDay = 30;
		}

		// Flight multiplier
		let flightCost = baseFlight;
		const flightClass = selectFlightClass.value;
		if (flightClass === 'premium') flightCost *= 1.4;
		else if (flightClass === 'business') flightCost *= 2.5;
		else if (flightClass === 'points') flightCost = 180;

		// Hotel multiplier
		let hotelCostPerNight = baseHotelPerNight;
		const lodging = selectLodgingStyle.value;
		if (lodging === 'boutique') hotelCostPerNight *= 0.75;
		else if (lodging === 'luxury5') hotelCostPerNight *= 1.6;
		else if (lodging === 'overwater') hotelCostPerNight *= 2.4;

		const totalHotel = hotelCostPerNight * days;

		// Dining multiplier
		let foodCostPerDay = baseFoodPerDay;
		const dining = selectDiningStyle.value;
		if (dining === 'budget') foodCostPerDay *= 0.6;
		else if (dining === 'fine_dining') foodCostPerDay *= 1.3;
		else if (dining === 'michelin') foodCostPerDay *= 2.2;

		const totalFood = foodCostPerDay * days;

		// Excursions multiplier
		let excursionCostPerDay = baseExcursionPerDay;
		const exc = selectExcursionsStyle.value;
		if (exc === 'light') excursionCostPerDay *= 0.5;
		else if (exc === 'heavy') excursionCostPerDay *= 2.0;

		const totalExcursions = excursionCostPerDay * days;

		let extras = 0;
		if (chkInsurance.checked) extras += 250;
		if (chkShopping.checked) extras += 350;

		const grandTotal = flightCost + totalHotel + totalFood + totalExcursions + extras;
		const perDayCost = grandTotal / days;

		resGrandTotal.textContent = formatMoney(grandTotal);
		resPerDayNote.textContent = `Circa ${formatMoney(perDayCost)} / Giorno per la coppia`;
		resFlightTotal.textContent = formatMoney(flightCost);
		resHotelTotal.textContent = formatMoney(totalHotel);
		resFoodTotal.textContent = formatMoney(totalFood);
		resExcursionsTotal.textContent = formatMoney(totalExcursions);
		resExtrasTotal.textContent = formatMoney(extras);

		if (grandTotal > 0) {
			const pF = Math.round((flightCost / grandTotal) * 100);
			const pH = Math.round((totalHotel / grandTotal) * 100);
			const pD = Math.round((totalFood / grandTotal) * 100);
			const pE = 100 - (pF + pH + pD);

			pctFlights.textContent = `${pF}%`;
			pctHotel.textContent = `${pH}%`;
			pctFood.textContent = `${pD}%`;
			pctExcursions.textContent = `${pE}%`;

			barFlights.style.width = `${pF}%`;
			barHotel.style.width = `${pH}%`;
			barFood.style.width = `${pD}%`;
			barExcursions.style.width = `${pE}%`;
		}
	}

	inputTripDays.addEventListener('input', () => {
		inputTripDaysNum.value = inputTripDays.value;
		calculateHoneymoon();
	});
	inputTripDaysNum.addEventListener('input', () => {
		inputTripDays.value = inputTripDaysNum.value;
		calculateHoneymoon();
	});

	[selectCountryTier, selectFlightClass, selectLodgingStyle, selectDiningStyle, selectExcursionsStyle, chkInsurance, chkShopping, currencySelect].forEach(el => {
		el.addEventListener('change', calculateHoneymoon);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const days = inputTripDays.value;
		const tierText = selectCountryTier.options[selectCountryTier.selectedIndex].text;

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Preventivo Viaggio di Nozze</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Preventivo Viaggio di Nozze Ufficiale</h1>
				<p>Data: ${new Date().toLocaleDateString('it-IT')} | Destinazione: ${tierText} | Durata: ${days} Giorni | Totale Stimato: <strong>${resGrandTotal.textContent}</strong></p>
				<table>
					<thead>
						<tr>
							<th>Voce di Viaggio</th>
							<th style="text-align:right;">Importo Stimato</th>
						</tr>
					</thead>
					<tbody>
						<tr><td>Voli A/R per la Coppia</td><td style="text-align:right; font-weight:bold;">${resFlightTotal.textContent}</td></tr>
						<tr><td>Resort & Alloggi (${days} Notti)</td><td style="text-align:right; font-weight:bold;">${resHotelTotal.textContent}</td></tr>
						<tr><td>Ristorazione & Cene Romantiche</td><td style="text-align:right; font-weight:bold;">${resFoodTotal.textContent}</td></tr>
						<tr><td>Escursioni & Attività di Coppia</td><td style="text-align:right; font-weight:bold;">${resExcursionsTotal.textContent}</td></tr>
						<tr><td>Assicurazione Sanitaria, Transfer & Shopping</td><td style="text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold;">
							<td>Budget Totale Luna di Miele</td>
							<td style="text-align:right; color:#16a34a;">${resGrandTotal.textContent}</td>
						</tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Viaggio_di_Nozze_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('it-IT');
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-honeymoon-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Voli A/R per la Coppia</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFlightTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Resort & Alloggi (${inputTripDays.value} Notti)</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resHotelTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Ristorazione & Cene Romantiche</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFoodTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Escursioni & Attività</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExcursionsTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Assicurazione, Transfer & Souvenir</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Totale Viaggio di Nozze</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#16a34a;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Voce di Viaggio,Importo Stimato\n";
		csv += `"Voli A/R per la Coppia","${resFlightTotal.textContent}"\n`;
		csv += `"Resort & Alloggi","${resHotelTotal.textContent}"\n`;
		csv += `"Ristorazione & Cene Romantiche","${resFoodTotal.textContent}"\n`;
		csv += `"Escursioni & Attività","${resExcursionsTotal.textContent}"\n`;
		csv += `"Assicurazione & Transfer","${resExtrasTotal.textContent}"\n`;
		csv += `"Totale Luna di Miele","${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Viaggio_di_Nozze_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateHoneymoon();
</script>
