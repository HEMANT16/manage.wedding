---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calcolatore Ore e Pacchetti Fotografo Matrimonio",
      "url": "https://manage.wedding/it/wedding-photography-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calcola le ore ideali di servizio fotografico per matrimonio (6h, 8h, 10h o 12h), necessità del secondo fotografo, numero di foto consegnate e timeline della giornata.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<Layout
	title="Calcolatore Ore Fotografo Matrimonio — Pacchetti e Timeline"
	description="Calcola quante ore di fotografo servono per il tuo matrimonio (6h, 8h, 10h o 12h), secondo fotografo, foto consegnate, budget e lista scatti di famiglia."
	lang="it"
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href=""" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/it/budget" style="color: var(--text-secondary); text-decoration: none;">Budget</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Fotografo Matrimonio</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>📸</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Pianificatore Pacchetti e Programma Scatti</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Calcolatore Ore Fotografo Matrimonio
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Determina il tuo pacchetto ottimale (<strong>6, 8, 10 o 12 ore</strong>), valuta l'esigenza di un secondo operatore, stima il numero di foto post-prodotte ed esporta il tuo programma scatti.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Checklist -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>⏱️</span> 1. Momenti Chiave dell'Evento
				</h2>

				<!-- Headcount & General Parameters -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-guest-count" style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.2rem;">
							Numero Invitati:
						</label>
						<input type="number" id="input-guest-count" min="10" max="600" value="120" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="select-venue-locations" style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.2rem;">
							Location / Spostamenti:
						</label>
						<select id="select-venue-locations" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="single" selected>1 Location Tutto Incluso (0 min)</option>
							<option value="two">2 Location (Hotel -> Villa, +30 min)</option>
							<option value="three">3 Location (Hotel -> Chiesa -> Villa, +60 min)</option>
						</select>
					</div>
				</div>

				<!-- Milestones Checkboxes -->
				<div style="display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.25rem;">
					
					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-prep-details" checked data-minutes="90" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Preparativi e Dettagli (+1,5 ore)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Abito, fedi, scarpe, trucco, parrucco e brindisi.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-first-look" checked data-minutes="45" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">First Look / Primo Incontro (+45 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Incontro intimo a due e ritratti di coppia prima della cerimonia.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-wedding-party" checked data-minutes="35" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Testimoni & Damigelle (+35 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Foto di gruppo del corteo nuziale con look freschi.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-family-formals" checked data-minutes="40" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Ritratti di Famiglia (+40 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">10–12 combinazioni con genitori, fratelli e nonni.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #fef08a;" class="milestone-label">
						<input type="checkbox" id="chk-ceremony" checked disabled data-minutes="60" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Cerimonia Nuziale (+60 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Ingresso, promesse, scambio anelli, bacio e lancio del riso.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-cocktail-details" checked data-minutes="45" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Aperitivo & Sala Ricevimento Intatta (+45 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Scatti spontanei agli ospiti e mise en place prima della cena.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-reception-events" checked data-minutes="90" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Ingresso Sala, Discorsi & Cena (+1,5 ore)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Ingresso trionfale, brindisi, taglio torta e servizio tavoli.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-sunset-portraits" checked data-minutes="20" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Sessione Tramonto / Golden Hour (+20 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Ritratti suggestivi di coppia con la luce calda del tramonto.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-dancing" checked data-minutes="45" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Primo Ballo & Festa (+45 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Primo ballo sposi, ballo genitori ed energia in pista.</span>
						</div>
					</label>

					<label style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.65rem 0.85rem; display: flex; align-items: flex-start; gap: 0.6rem; cursor: pointer; background: #f8fafc;" class="milestone-label">
						<input type="checkbox" id="chk-grand-exit" data-minutes="30" style="margin-top: 3px; accent-color: var(--fg-pencil);" />
						<div>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil);">Fontane Luminose / Uscita Notturna (+30 min)</strong>
							<span style="font-size: 0.78rem; color: #64748b;">Scintille luminose o fuochi d'artificio di fine serata.</span>
						</div>
					</label>

				</div>

				<!-- Hourly Rate Sizer -->
				<div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
					<label for="input-hourly-rate" style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.25rem;">
						Tariffa Oraria Media Fotografo (€/ora):
					</label>
					<div style="display: flex; gap: 0.5rem; align-items: center;">
						<input type="number" id="input-hourly-rate" min="100" max="1500" step="50" value="250" style="width: 120px; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
						<span style="font-size: 0.8rem; color: var(--text-muted);">(Fascia media: 200 € a 400 € / ora)</span>
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Raccomandazione</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Pacchetto Fotografico Ideale
						</h2>
					</div>
					<span id="badge-package-tier" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">Pacchetto 8 Ore</span>
				</div>

				<!-- Big Number Highlights -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Ore da Prenotare</span>
						<strong id="stat-package-hours" style="font-size: 2rem; font-weight: 900; color: #1e40af; line-height: 1.1;">8 Ore</strong>
						<span id="stat-exact-time-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(7 ore 25 min tempo totale)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Budget Stimato</span>
						<strong id="stat-estimated-budget" style="font-size: 2rem; font-weight: 900; color: #15803d; line-height: 1.1;">2.000 €</strong>
						<span id="stat-budget-subtext" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">Basato su 250 €/ora</span>
					</div>
				</div>

				<!-- Secondary Details & Second Shooter Matrix -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">📷 Secondo Fotografo:</span>
						<strong id="stat-second-shooter" style="color: #1e40af;">Molto Consigliato</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🖼️ Foto Post-prodotte:</span>
						<strong id="stat-gallery-yield" style="color: #15803d;">450 a 600 Foto</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🚗 Spostamenti & Viaggio:</span>
						<strong id="stat-travel-time" style="color: var(--fg-pencil);">0 min (Stessa location)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0;">
						<span style="color: #475569;">🛡️ Margine di Sicurezza:</span>
						<strong id="stat-overtime-buffer" style="color: #16a34a;">Tranquillo (35 min di scarto)</strong>
					</div>
				</div>

				<!-- Second Shooter Decision Box -->
				<div style="background: #fef08a; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; margin-bottom: 1.25rem; font-size: 0.85rem;" id="box-second-shooter-reason">
					<strong style="color: var(--fg-pencil); display: block; margin-bottom: 0.25rem;">📸 Analisi Secondo Operatore:</strong>
					<span id="stat-shooter-reason" style="color: #334155;">
						Con <strong>più di 120 invitati</strong>, un secondo fotografo immortala l'aperitivo mentre si svolgono i ritratti di famiglia e cattura due angolazioni alla cerimonia.
					</span>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-export-pdf" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Stampa PDF
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Esporta Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/it/wedding-photography-calculator" category="budget" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-photo-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Programma e Briefing Servizio Fotografico di Nozze</h1>
				<p id="print-photo-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Piano Servizio Fotografico | Generato da Manage.Wedding</p>
			</div>
			<div id="print-photo-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	const inputGuestCount = document.getElementById('input-guest-count');
	const selectVenueLocations = document.getElementById('select-venue-locations');
	const inputHourlyRate = document.getElementById('input-hourly-rate');

	const checkboxes = [
		document.getElementById('chk-prep-details'),
		document.getElementById('chk-first-look'),
		document.getElementById('chk-wedding-party'),
		document.getElementById('chk-family-formals'),
		document.getElementById('chk-ceremony'),
		document.getElementById('chk-cocktail-details'),
		document.getElementById('chk-reception-events'),
		document.getElementById('chk-sunset-portraits'),
		document.getElementById('chk-dancing'),
		document.getElementById('chk-grand-exit')
	];

	const badgePackageTier = document.getElementById('badge-package-tier');
	const statPackageHours = document.getElementById('stat-package-hours');
	const statExactTimeSub = document.getElementById('stat-exact-time-sub');
	const statEstimatedBudget = document.getElementById('stat-estimated-budget');
	const statBudgetSubtext = document.getElementById('stat-budget-subtext');
	const statSecondShooter = document.getElementById('stat-second-shooter');
	const statGalleryYield = document.getElementById('stat-gallery-yield');
	const statTravelTime = document.getElementById('stat-travel-time');
	const statOvertimeBuffer = document.getElementById('stat-overtime-buffer');
	const statShooterReason = document.getElementById('stat-shooter-reason');

	function calculateCoverage() {
		let totalMinutes = 0;
		checkboxes.forEach(chk => {
			if (chk.checked) {
				totalMinutes += parseInt(chk.getAttribute('data-minutes'), 10) || 0;
			}
		});

		const venueType = selectVenueLocations.value;
		let travelMins = 0;
		if (venueType === 'two') travelMins = 30;
		else if (venueType === 'three') travelMins = 60;
		totalMinutes += travelMins;

		statTravelTime.textContent = travelMins > 0 ? `${travelMins} min viaggio` : '0 min (Stessa location)';

		const calculatedHours = totalMinutes / 60;
		const hrs = Math.floor(totalMinutes / 60);
		const mins = totalMinutes % 60;
		statExactTimeSub.textContent = `(${hrs} ore ${mins} min tempo totale)`;

		let packageHours = 8;
		if (calculatedHours <= 6.25) packageHours = 6;
		else if (calculatedHours <= 8.5) packageHours = 8;
		else if (calculatedHours <= 10.5) packageHours = 10;
		else packageHours = 12;

		badgePackageTier.textContent = `Pacchetto ${packageHours} Ore`;
		statPackageHours.textContent = `${packageHours} Ore`;

		const bufferDiffMins = (packageHours * 60) - totalMinutes;
		if (bufferDiffMins >= 0) {
			statOvertimeBuffer.textContent = `Tranquillo (${bufferDiffMins} min di scarto)`;
			statOvertimeBuffer.style.color = '#16a34a';
		} else {
			statOvertimeBuffer.textContent = `Stretto (${Math.abs(bufferDiffMins)} min oltre le 8h — valutare 10h)`;
			statOvertimeBuffer.style.color = '#dc2626';
		}

		const rate = parseFloat(inputHourlyRate.value) || 250;
		const totalSpend = packageHours * rate;
		statEstimatedBudget.textContent = `${totalSpend.toLocaleString('it-IT')} €`;
		statBudgetSubtext.textContent = `Basato su ${rate} €/ora`;

		const minPhotos = packageHours * 50;
		const maxPhotos = packageHours * 75;
		statGalleryYield.textContent = `${minPhotos} a ${maxPhotos} Foto`;

		const guests = parseInt(inputGuestCount.value, 10) || 120;
		const hasMultipleLocations = venueType !== 'single';
		const needsSecond = guests > 120 || hasMultipleLocations || packageHours >= 10;

		if (needsSecond) {
			statSecondShooter.textContent = 'Molto Consigliato';
			statSecondShooter.style.color = '#1e40af';
			statShooterReason.innerHTML = `Con <strong>${guests} invitati</strong> e <strong>${packageHours}h di servizio</strong>, un secondo fotografo cattura l'aperitivo mentre si svolgono i ritratti di famiglia e offre due angoli di ripresa alla cerimonia.`;
		} else {
			statSecondShooter.textContent = 'Opzionale (1 fotografo è sufficiente)';
			statSecondShooter.style.color = '#15803d';
			statShooterReason.innerHTML = `Per un matrimonio di <strong>${guests} invitati</strong> in una sola location, un fotografo professionista esperto coprirà alla perfezione tutti i momenti previsti.`;
		}

		document.getElementById('print-photo-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Blocco di Copertura</th>
						<th style="padding:6pt; text-align:center;">Durata Prevista</th>
						<th style="padding:6pt;">Dettagli e Note</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Pacchetto Consigliato</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; font-size:12pt; color:#1e40af;">${packageHours} Ore</td>
						<td style="padding:6pt;">Budget stimato: ${totalSpend.toLocaleString('it-IT')} € (${rate} €/h) | Consegna: ${minPhotos}–${maxPhotos} foto</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Secondo Operatore</td>
						<td style="padding:6pt; text-align:center;">${statSecondShooter.textContent}</td>
						<td style="padding:6pt;">${needsSecond ? 'Consigliato per preparativi sposo e aperitivo' : 'Un singolo fotografo è sufficiente'}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Spostamenti</td>
						<td style="padding:6pt; text-align:center;">${travelMins} min</td>
						<td style="padding:6pt;">${venueType === 'single' ? 'Tutto in location (0 min di viaggio)' : 'Include riordino attrezzatura e viaggio'}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Tempo Totale Momenti</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#15803d;">${hrs}h ${mins}m</td>
						<td style="padding:6pt;">Margine di sicurezza: ${bufferDiffMins >= 0 ? `${bufferDiffMins} minuti` : '0 min'}</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	inputGuestCount.addEventListener('input', calculateCoverage);
	selectVenueLocations.addEventListener('change', calculateCoverage);
	inputHourlyRate.addEventListener('input', calculateCoverage);

	checkboxes.forEach(chk => {
		chk.addEventListener('change', calculateCoverage);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		calculateCoverage();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateCoverage();
		const pkg = statPackageHours.textContent;
		const spend = statEstimatedBudget.textContent;
		const shooter = statSecondShooter.textContent;
		const yieldPhotos = statGalleryYield.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Briefing Fotografo Matrimonio</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Briefing e Programma Servizio Fotografico Matrimonio</h1>
				<p><strong>Pacchetto Ideale:</strong> ${pkg} | <strong>Spesa Prevista:</strong> ${spend} | <strong>Secondo Fotografo:</strong> ${shooter}</p>
				<hr/>
				<h2>Dettagli del Servizio</h2>
				<table>
					<tr style="background:#f1f5f9;">
						<th>Parametro</th><th>Dettagli</th>
					</tr>
					<tr><td><strong>Ore di Copertura:</strong></td><td><strong>${pkg}</strong></td></tr>
					<tr><td><strong>Foto Post-prodotte:</strong></td><td>${yieldPhotos}</td></tr>
					<tr><td><strong>Secondo Fotografo:</strong></td><td>${shooter}</td></tr>
					<tr><td><strong>Budget Stimato:</strong></td><td>${spend}</td></tr>
				</table>
				<hr/>
				<p><em>Generato da Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Fotografo-Matrimonio-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateCoverage();
</script>
