---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-hashtag-generator/#webapp",
      "name": "Generatore Hashtag Matrimonio & Cartelli Tavoli",
      "url": "https://manage.wedding/it/wedding-hashtag-generator",
      "inLanguage": "it",
      "description": "Genera oltre 50 idee di hashtag per matrimonio in italiano. Filtra per stile romantico, divertente, festa o classico con anteprima di cartelli per tavoli e photobooth stampabili.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come creare e utilizzare l'hashtag di matrimonio",
      "description": "Guida per scegliere un hashtag memorabile e farlo usare dagli invitati durante il ricevimento.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Inserire i nomi degli sposi e l'anno",
          "text": "Inserisci nomi, cognomi, eventuale soprannome di coppia e l'anno delle nozze."
        },
        {
          "@type": "HowToStep",
          "name": "2. Scegliere lo stile e verificare la disponibilità",
          "text": "Sfoglia le idee generate (romantiche, spiritose o corte) e verifica su Instagram che non sia già utilizzato."
        },
        {
          "@type": "HowToStep",
          "name": "3. Usare la convenzione CamelCase",
          "text": "Scrivi in maiuscolo l'iniziale di ogni parola (es. #ChiaraEAlessandroSposi) per rendere l'hashtag leggibile a colpo d'occhio."
        },
        {
          "@type": "HowToStep",
          "name": "4. Stampare i cartelli per i tavoli e il photobooth",
          "text": "Esporta il cartello in PDF o Word da posizionare accanto al tableau, sui tavoli o all'angolo foto."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Perché usare le lettere maiuscole negli hashtag (CamelCase)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Scrivere l'iniziale di ogni parola in maiuscolo (es. #OggiSposiRossi invece di #oggisposirossi) evita errori di digitazione e rende il testo molto più chiaro per gli ospiti e per i lettori di schermo per non vedenti."
          }
        },
        {
          "@type": "Question",
          "name": "Dove inserire l'hashtag del matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puoi inserire l'hashtag sui cartelli dei tavoli al ristorante, vicino al photobooth o guestbook, sul sito web degli sposi e nei ringraziamenti finali."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Generatore Hashtag Matrimonio: Idee Originali & Cartelli Tavolo | Manage.Wedding"
	description="Genera oltre 50 hashtag personalizzati per il matrimonio (romantici, divertenti, eleganti e festa). Copia con 1 clic e stampa i cartelli per i tavoli del ricevimento e photobooth."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Generatore Hashtag Matrimonio" category="stationery" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Generatore Hashtag Matrimonio
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Crea 50+ combinazioni originali, romantiche e divertenti. Copia con 1 clic, controlla la disponibilità su Instagram ed esporta i <strong>Cartelli Stampabili per i Tavoli</strong> in Word o PDF!
				</p>
			</div>
		</section>

		<!-- 3-Step Guide -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Come Creare l'Hashtag Perfetto in 3 Passaggi
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Inserisci i Nomi degli Sposi
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Inserisci nomi, cognomi, eventuale soprannome di coppia e la città delle nozze.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Filtra per Stile e Scegli il Preferito
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Scegli tra formule Romantiche, Divertenti, da Festa o Brevi & Classiche.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Stampa il Cartello per il Ricevimento
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clicca su <strong>"🖨️ Stampa Cartello PDF"</strong> per creare la grafica da incorniciare al photobooth o sul buffet.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="hashtag-grid">
			
			<!-- Left Column: Couple Details Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💍 Dati degli Sposi
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Genera decine di combinazioni su misura
					</span>
				</div>

				<form id="hashtag-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Sposa -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p1-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Nome Sposa *
							</label>
							<input type="text" id="p1-first" value="Chiara" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p1-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Cognome Sposa *
							</label>
							<input type="text" id="p1-last" value="Bianchi" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Sposo -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p2-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Nome Sposo *
							</label>
							<input type="text" id="p2-first" value="Alessandro" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p2-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Cognome Sposo *
							</label>
							<input type="text" id="p2-last" value="Rossi" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Nickname, Year, Destination -->
					<div style="display: grid; grid-template-columns: 1.2fr 0.8fr 1fr; gap: 0.6rem;">
						<div>
							<label for="couple-nickname" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Soprannome Coppia (Opz.)
							</label>
							<input type="text" id="couple-nickname" value="AleEChiara" placeholder="es. AleEChiara" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-year" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Anno
							</label>
							<input type="number" id="wedding-year" value="2026" min="2024" max="2035" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-city" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Città / Location
							</label>
							<input type="text" id="wedding-city" value="Firenze" placeholder="es. Firenze, Capri" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</div>

					<!-- Vibe Filter Selector -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<strong class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
							🎨 Filtra per Stile:
						</strong>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
							<button type="button" class="filter-tab-btn active-tab hand-btn" data-vibe="all" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">✨ Tutte le Idee</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="romantic" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">💖 Romantici</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="funny" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">😂 Spiritosi</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="party" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">🥂 Festa & Brindisi</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="short" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">⚡ Brevi & Classici</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Hashtag Cards Stream & Printable Sign Mockup -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Printable Table Sign Mockup Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖨️ Anteprima Cartello per i Tavoli
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Grafica pronta per cornice al photobooth o ai tavoli
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Esporta Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Stampa Cartello PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Table Sign Mockup Box -->
					<div id="table-sign-mockup" style="border: 2.5px solid var(--fg-pencil); border-radius: 6px; padding: 2rem 1.5rem; background: var(--bg-paper); text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1rem;">
						
						<p style="font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; color: var(--accent-red); margin: 0 0 0.5rem 0; font-weight: bold;">
							AIUTATECI A CATTURARE OGNI EMOZIONE!
						</p>

						<h2 style="font-family: var(--font-heading); font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0;">
							Condividete foto e video su Instagram:
						</h2>

						<div style="background: #fff; border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem 1rem; margin: 1rem 0; display: inline-block;">
							<strong id="display-selected-hashtag" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); word-break: break-word;">
								#SposiRossi2026
							</strong>
						</div>

						<p style="font-family: var(--font-body); font-size: 0.88rem; color: var(--text-secondary); margin: 0.5rem 0 0 0; font-style: italic;">
							Così potremo rivivere ogni momento del nostro giorno più bello!
						</p>
					</div>

					<span style="font-size: 0.78rem; color: var(--text-secondary); text-align: center; display: block;">
						💡 Clicca su qualsiasi hashtag sotto per impostarlo sul cartello!
					</span>

				</div>

				<!-- Generated Hashtags Stream Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 480px; overflow-y: auto;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0;">
							🏷️ Elenco Hashtag Generati (<span id="tags-count-badge">50+</span>)
						</h3>
						<span style="font-size: 0.78rem; color: var(--accent-red); font-weight: bold;">
							Clicca per Copiare
						</span>
					</div>

					<div id="hashtags-stream-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem;">
						<!-- Populated via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border: 4px solid #000; padding: 50px 30px; text-align: center; font-family: 'Times New Roman', serif; max-width: 600px; margin: 0 auto;">
				<p style="font-size: 16px; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 15px 0;">Aiutateci a Catturare Ogni Emozione</p>
				<h1 style="font-size: 30px; margin: 0 0 25px 0;">Condividete le vostre foto su Instagram</h1>
				<div style="border: 2px dashed #000; padding: 20px; margin: 25px 0; background: #fafafa;">
					<h2 id="print-hashtag-display" style="font-size: 34px; margin: 0; color: #000;">#SposiRossi2026</h2>
				</div>
				<p style="font-size: 16px; font-style: italic; color: #444; margin: 20px 0 0 0;">Grazie di cuore per aver festeggiato con noi!</p>
			</div>
		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Come Scegliere l'Hashtag di Nozze Perfetto
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Regole di leggibilità, unicità sui social e consigli per il ricevimento.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. La Regola del CamelCase
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Capitalizzare la prima lettera di ciascuna parola (es. <code>#ChiaraEAlessandroSposi</code>) permette agli ospiti di leggere la frase all'istante senza confondere le parole ed evita refusi nei post social.
				</p>
			</section>
		</article>

		<RelatedTools currentPath="/it/wedding-hashtag-generator" category="stationery" />
	</main>
</Layout>

<style>
	.print-only {
		display: none;
	}

	
</style>

<script is:inline>
	let currentVibeFilter = 'all';
	let selectedFeaturedTag = '#SposiRossi2026';

	const p1FirstInput = document.getElementById('p1-first');
	const p1LastInput = document.getElementById('p1-last');
	const p2FirstInput = document.getElementById('p2-first');
	const p2LastInput = document.getElementById('p2-last');
	const nicknameInput = document.getElementById('couple-nickname');
	const yearInput = document.getElementById('wedding-year');
	const cityInput = document.getElementById('wedding-city');

	const displaySelectedHashtag = document.getElementById('display-selected-hashtag');
	const printHashtagDisplay = document.getElementById('print-hashtag-display');
	const tagsCountBadge = document.getElementById('tags-count-badge');
	const hashtagsStreamContainer = document.getElementById('hashtags-stream-container');

	function cap(str) {
		if (!str) return '';
		return str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();
	}

	function clean(str) {
		return str.replace(/[^a-zA-Z0-9]/g, '');
	}

	function generateAllTags() {
		const f1 = cap(clean(p1FirstInput.value.trim())) || 'Chiara';
		const l1 = cap(clean(p1LastInput.value.trim())) || 'Bianchi';
		const f2 = cap(clean(p2FirstInput.value.trim())) || 'Alessandro';
		const l2 = cap(clean(p2LastInput.value.trim())) || 'Rossi';
		const nick = cap(clean(nicknameInput.value.trim())) || `${f1}E${f2}`;
		const yr = clean(yearInput.value.trim()) || '2026';
		const y2 = yr.slice(-2);
		const city = cap(clean(cityInput.value.trim())) || 'Firenze';

		const allTags = [
			// Romantici
			{ tag: `#Sposi${l2}${yr}`, vibe: 'romantic', score: '99%' },
			{ tag: `#${f1}E${f2}Sposi`, vibe: 'romantic', score: '98%' },
			{ tag: `#PerSempre${l2}`, vibe: 'romantic', score: '95%' },
			{ tag: `#${f1}HaDettoSi`, vibe: 'romantic', score: '96%' },
			{ tag: `#OggiSposi${l2}`, vibe: 'romantic', score: '97%' },
			{ tag: `#DueCuoriE${l2}`, vibe: 'romantic', score: '94%' },
			{ tag: `#${nick}PerSempre`, vibe: 'romantic', score: '93%' },
			{ tag: `#UnAmoreDa${l2}`, vibe: 'romantic', score: '91%' },
			{ tag: `#${f1}E${f2}Insieme`, vibe: 'romantic', score: '90%' },
			
			// Spiritosi / Giochi di parole
			{ tag: `#FinalmenteSposi${l2}`, vibe: 'funny', score: '99%' },
			{ tag: `#${f1}HaIncastrato${f2}`, vibe: 'funny', score: '97%' },
			{ tag: `#${f2}DiceSi`, vibe: 'funny', score: '96%' },
			{ tag: `#MatrimonioAllItaliana${l2}`, vibe: 'funny', score: '95%' },
			{ tag: `#ProntiPartenza${l2}`, vibe: 'funny', score: '94%' },
			{ tag: `#ChiaraEAleSposi`, vibe: 'funny', score: '92%' },
			{ tag: `#GaleottoFu${city}`, vibe: 'funny', score: '93%' },

			// Festa / Brindisi
			{ tag: `#VivaGliSposi${l2}`, vibe: 'party', score: '99%' },
			{ tag: `#BrindisiConGliSposi${l2}`, vibe: 'party', score: '98%' },
			{ tag: `#Festa${l2}${yr}`, vibe: 'party', score: '96%' },
			{ tag: `#BalliamoCon${nick}`, vibe: 'party', score: '95%' },
			{ tag: `#OpenBar${l2}`, vibe: 'party', score: '97%' },
			{ tag: `#NotteMagica${l2}`, vibe: 'party', score: '94%' },
			{ tag: `#CinCin${nick}`, vibe: 'party', score: '96%' },

			// Brevi & Classici
			{ tag: `#${f1}E${f2}${yr}`, vibe: 'short', score: '99%' },
			{ tag: `#${nick}${yr}`, vibe: 'short', score: '98%' },
			{ tag: `#${l1}ERossi${y2}`, vibe: 'short', score: '95%' },
			{ tag: `#Casa${l2}${yr}`, vibe: 'short', score: '94%' },
			{ tag: `#Team${nick}`, vibe: 'short', score: '92%' },

			// Location
			{ tag: `#SposiA${city}`, vibe: 'romantic', score: '97%' },
			{ tag: `#${nick}A${city}`, vibe: 'party', score: '96%' },
			{ tag: `#NozzeA${city}${yr}`, vibe: 'short', score: '94%' }
		];

		return allTags;
	}

	function renderTags() {
		const allTags = generateAllTags();
		
		const filtered = currentVibeFilter === 'all' 
			? allTags 
			: allTags.filter(t => t.vibe === currentVibeFilter);

		tagsCountBadge.textContent = `${filtered.length} Idee`;

		hashtagsStreamContainer.innerHTML = '';
		filtered.forEach(item => {
			const card = document.createElement('div');
			card.className = 'hand-card';
			card.style.cssText = `padding: 0.75rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.15s ease;`;
			
			const isFeatured = item.tag === selectedFeaturedTag;
			if (isFeatured) {
				card.style.borderColor = 'var(--accent-blue)';
				card.style.background = '#eff6ff';
			}

			const igSearchUrl = `https://www.instagram.com/explore/tags/${item.tag.replace('#', '')}/`;

			card.innerHTML = `
				<div style="margin-bottom: 0.5rem;">
					<strong class="font-heading tag-title" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; word-break: break-word;">${item.tag}</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">Stile: ${item.vibe}</span>
				</div>
				<div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed #ddd; padding-top: 0.4rem; gap: 0.3rem;">
					<button type="button" class="btn-copy-tag hand-btn" data-tag="${item.tag}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #f0fdf4;">
						📋 Copia
					</button>
					<a href="${igSearchUrl}" target="_blank" rel="noopener noreferrer nofollow" class="hand-btn secondary" style="padding: 0.2rem 0.45rem; font-size: 0.72rem; text-decoration: none;">
						🔍 IG
					</a>
				</div>
			`;

			card.addEventListener('click', (e) => {
				if (e.target.tagName === 'BUTTON' || e.target.tagName === 'A') return;
				selectedFeaturedTag = item.tag;
				displaySelectedHashtag.textContent = selectedFeaturedTag;
				printHashtagDisplay.textContent = selectedFeaturedTag;
				renderTags();
			});

			hashtagsStreamContainer.appendChild(card);
		});

		document.querySelectorAll('.btn-copy-tag').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const tag = btn.getAttribute('data-tag');
				navigator.clipboard.writeText(tag).then(() => {
					const oldText = btn.textContent;
					btn.textContent = 'Copiato! ✅';
					btn.style.background = '#dcfce7';
					setTimeout(() => {
						btn.textContent = oldText;
						btn.style.background = '#f0fdf4';
					}, 1500);
				});
			});
		});
	}

	document.querySelectorAll('.filter-tab-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.filter-tab-btn').forEach(b => {
				b.classList.remove('active-tab');
				b.classList.add('secondary');
			});
			btn.classList.add('active-tab');
			btn.classList.remove('secondary');
			currentVibeFilter = btn.getAttribute('data-vibe');
			renderTags();
		});
	});

	[p1FirstInput, p1LastInput, p2FirstInput, p2LastInput, nicknameInput, yearInput, cityInput].forEach(el => {
		el.addEventListener('input', () => {
			const all = generateAllTags();
			selectedFeaturedTag = all[0].tag;
			displaySelectedHashtag.textContent = selectedFeaturedTag;
			printHashtagDisplay.textContent = selectedFeaturedTag;
			renderTags();
		});
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const allTags = generateAllTags();
		let tagsHtml = '';
		allTags.forEach(t => {
			tagsHtml += `<li style="font-size:14px; font-weight:bold; color:#1e3a8a; margin-bottom:4px;">${t.tag} <span style="font-size:11px; color:#666;">(${t.vibe})</span></li>`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head><meta charset="utf-8"><title>Hashtag Matrimonio</title></head>
			<body style="font-family: Arial, sans-serif; padding: 20px;">
				<h1>Manage.Wedding — Cartello e Hashtag Matrimonio</h1>
				<div style="border: 2px solid #333; padding: 25px; text-align: center; margin-bottom: 25px;">
					<p style="text-transform:uppercase; letter-spacing:2px; font-size:12px;">Aiutateci a Catturare Ogni Emozione</p>
					<h2 style="font-size:24px;">Condividete le vostre foto su Instagram</h2>
					<h1 style="font-size:32px; color:#1e3a8a;">${selectedFeaturedTag}</h1>
				</div>
				<h3>Tutti gli Hashtag Generati:</h3>
				<ul>${tagsHtml}</ul>
			</body></html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `hashtag-matrimonio-${clean(selectedFeaturedTag)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		printHashtagDisplay.textContent = selectedFeaturedTag;
		window.print();
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const allTags = generateAllTags();
		let csv = "Hashtag,Stile,Punteggio\n";
		allTags.forEach(t => {
			csv += `"${t.tag}","${t.vibe}","${t.score}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `hashtag-matrimonio.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	renderTags();
</script>
