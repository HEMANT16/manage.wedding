---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/seating-chart-maker/#webapp",
      "name": "Tableau de Mariage & Disposizione Tavoli Matrimonio",
      "url": "https://manage.wedding/it/seating-chart-maker",
      "inLanguage": "it",
      "description": "Strumento online gratuito per creare la disposizione dei tavoli del matrimonio e il Tableau de Mariage. Trascina gli invitati, controlla la capienza ed esporta in Word e PDF.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come creare il Tableau de Mariage e la disposizione dei tavoli",
      "description": "Guida per configurare i tavoli del ricevimento, assegnare gli invitati confermati ed esportare la piantina per il banqueting.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Configurare le tipologie di tavoli",
          "text": "Aggiungi tavoli rotondi (8–10 coperti), tavolo imperiale o tavolo d'onore per gli sposi."
        },
        {
          "@type": "HowToStep",
          "name": "2. Raggruppare gli invitati per affinità",
          "text": "Unisci nuclei familiari, amici di vecchia data e colleghi per favorire un'atmosfera conviviale."
        },
        {
          "@type": "HowToStep",
          "name": "3. Assegnare i posti con drag & drop",
          "text": "Trascina i cartellini degli invitati o usa l'assegnazione rapida a 1 clic."
        },
        {
          "@type": "HowToStep",
          "name": "4. Esportare il documento per il maître di sala",
          "text": "Scarica il piano tavoli definitivo in Word o PDF con il conteggio dei piatti speciali e vegetariani."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanti posti hanno i tavoli rotondi standard per matrimoni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "I tavoli rotondi da 150–160 cm di diametro ospitano comodamente 8 persone (massimo 9). I tavoli rotondi da 180 cm ospitano comodamente 10 persone (massimo 11-12)."
          }
        },
        {
          "@type": "Question",
          "name": "Quando va consegnata la disposizione dei tavoli alla location?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il piano definitivo dei tavoli (con nomi completi, intolleranze e seggioloni per bambini) va consegnato al maître di sala e al catering circa 10–14 giorni prima del matrimonio."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Tableau de Mariage & Disposizione Tavoli Matrimonio | Manage.Wedding"
	description="Crea gratis il tuo Tableau de Mariage e la disposizione dei tavoli online. Assegna gli invitati a tavoli rotondi, rettangolari o al tavolo d'onore ed esporta in Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Tableau de Mariage & Tavoli" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Tableau de Mariage <span class="accent-italic">& Piano Tavoli</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Organizza i tavoli del ricevimento (rotondi, imperiali, tavolo sposi). Monitora la capienza dei posti ed esporta in <strong>Word (.doc)</strong>, <strong>PDF</strong> o <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- 💡 3-Step Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
				<strong class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem;">
					<span>💡</span> Come Funziona (3 Semplici Passaggi)
				</strong>
				<span style="font-size: 0.85rem; color: var(--fg-pencil); font-family: var(--font-body); font-style: italic;">
					Nessuna registrazione richiesta
				</span>
			</div>
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: var(--accent-blue); display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						1️⃣ Configura i Tavoli
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clicca su <strong>"+ Aggiungi Tavolo"</strong>. Scegli la forma (⭕ Rotondo, ▭ Imperiale, ❤️ Tavolo Sposi) e imposta i posti a sedere.
					</p>
				</div>

				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: #15803d; display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						2️⃣ Assegna gli Invitati
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Trascina i cartellini da <strong>Non Assegnati</strong> a ciascun tavolo, oppure usa il menu a tendina o l'<strong>"⚡ Assegnazione Automatica"</strong>.
					</p>
				</div>

				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: var(--accent-red); display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						3️⃣ Esporta per il Maître
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Scarica il file <strong>Word (.doc)</strong> o <strong>PDF</strong> con la lista dei tavoli e le intolleranze per la cucina del catering.
					</p>
				</div>
			</div>
		</div>

		<!-- Overview Dashboard & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						🪑 Stato Avanzamento Posti & Tavoli
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Sincronizzato con la lista invitati e le conferme RSVP
					</span>
				</div>

				<!-- Export & Control Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Esporta Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Stampa PDF
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Excel (.csv)
					</button>
					<button type="button" id="btn-add-table" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Aggiungi Tavolo
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						🔄 Esempio
					</button>
					<button type="button" id="btn-clear-seating" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🧹 Azzera Posti
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Invitati Confermati</span>
					<strong id="stat-total-attending" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Totale Coperti</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Seduti ai Tavoli</span>
					<strong id="stat-seated-count" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-seated-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% assegnati</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Non Assegnati</span>
					<strong id="stat-unassigned-count" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span style="font-size: 0.75rem; color: #854d0e; display: block;">Da Posizionare</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Tavoli Creati</span>
					<strong id="stat-table-count" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">0</strong>
					<span id="stat-capacity-total" style="font-size: 0.75rem; color: #1e40af; display: block;">0 Sedie Totali</span>
				</div>
			</div>

			<!-- Dynamic Seating Progress Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Completamento Assegnazioni</span>
					<span id="progress-text" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">0% Assegnati</span>
				</div>
				<div style="height: 24px; border: 2px solid var(--fg-pencil); border-radius: 12px; overflow: hidden; background: #e5e0d8;">
					<div id="progress-bar-fill" style="height: 100%; width: 0%; background-color: #22c55e; transition: width 0.3s ease;"></div>
				</div>
			</div>
		</div>

		<!-- Interactive Seating Studio Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 340px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="seating-workspace-grid">
			
			<!-- Left Column: Unassigned Guests Tray + Quick Add -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						👥 Non Assegnati (<span id="unassigned-badge-count">0</span>)
					</h3>
					<button type="button" id="btn-auto-assign" class="hand-btn secondary" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">
						⚡ Auto-Assegna
					</button>
				</div>

				<!-- Search Unassigned -->
				<div style="margin-bottom: 0.75rem;">
					<input type="text" id="unassigned-search" placeholder="🔍 Cerca tra i non assegnati..." style="width: 100%; box-sizing: border-box; padding: 0.55rem 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: var(--bg-paper); color: var(--fg-pencil);">
				</div>

				<!-- Drop Zone for Unassigned -->
				<div id="unassigned-dropzone" class="drop-zone" data-table-id="unassigned" style="min-height: 240px; max-height: 480px; overflow-y: auto; padding: 0.5rem; border: 2px dashed var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); display: flex; flex-direction: column; gap: 0.5rem;"></div>

				<!-- Quick Add Guest Directly -->
				<div style="margin-top: 1.25rem; border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
					<label for="quick-guest-name" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						➕ Aggiunta Rapida Invitato:
					</label>
					<form id="quick-add-guest-form" style="display: flex; gap: 0.4rem; align-items: center;">
						<input type="text" id="quick-guest-name" required placeholder="Nome invitato..." style="flex: 1; min-width: 0; padding: 0.55rem 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: var(--bg-paper); color: var(--fg-pencil);">
						<select id="quick-guest-party" title="Posti" style="width: 82px; padding: 0.55rem 0.25rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff; color: var(--fg-pencil);">
							<option value="1">1 Posto</option>
							<option value="2" selected>2 Posti</option>
							<option value="3">3 Posti</option>
							<option value="4">4 Posti</option>
						</select>
						<button type="submit" class="hand-btn" style="padding: 0.55rem 0.85rem; font-size: 0.95rem; white-space: nowrap;">
							➕
						</button>
					</form>
				</div>

			</div>

			<!-- Right Column: Interactive Reception Tables Layout Grid -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h3 class="font-heading" style="font-size: 1.4rem; margin: 0; color: var(--fg-pencil);">
							🍽️ Sala Ricevimento & Tavoli
						</h3>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
							Trascina i cartellini o usa il menu di assegnazione rapida
						</span>
					</div>
					
					<button type="button" id="btn-add-table-top" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
						➕ Nuovo Tavolo
					</button>
				</div>

				<!-- Tables Grid Container -->
				<div id="tables-grid-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;"></div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Piano Ufficiale dei Tavoli (Tableau de Mariage)</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Data: <span id="print-date"></span> | Totale Invitati Seduti: <span id="print-seated-count"></span></p>
			</div>
			<div id="print-tables-content"></div>
		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Galateo & Organizzazione</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem;">
					Guida alla Creazione del Tableau de Mariage Perfetto
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 700px; margin: 0.5rem auto 0;">
					Come scegliere i nomi dei tavoli, evitare conflitti familiari e posizionare i tavoli in sala.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Tavolo Rotondo o Tavolo Imperiale?
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1rem;">
					Il <strong>tavolo rotondo</strong> (da 8 a 10 posti) è la soluzione più diffusa nei matrimoni italiani perché favorisce la conversazione tra tutti i commensali. Il <strong>tavolo imperiale</strong> (una lunga tavolata continua rettangolare) crea un impatto scenografico mozzafiato, perfetto per borghi storici, masserie e giardini all'aperto.
				</p>
			</section>
		</article>

		<RelatedTools currentPath="/it/seating-chart-maker" category="guests-logistics" />
	</main>
</Layout>

<style>
	.seating-workspace-grid {
		display: grid;
		grid-template-columns: 1fr;
	}
	@media (min-width: 992px) {
		.seating-workspace-grid {
			grid-template-columns: 340px 1fr;
		}
	}

	.drop-zone {
		min-height: 100px;
		border: 2px dashed var(--fg-pencil);
		border-radius: 4px;
		padding: 0.5rem;
		background: rgba(0,0,0,0.02);
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		transition: background 0.15s ease;
	}
	.drop-zone.drag-over {
		background: #fef9c3 !important;
		border-style: solid;
	}

	.guest-drag-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 4px;
		padding: 0.45rem 0.6rem;
		cursor: grab;
		box-shadow: 2px 2px 0 var(--fg-pencil);
		display: flex;
		justify-content: space-between;
		align-items: center;
		user-select: none;
		transition: transform 0.1s ease, box-shadow 0.1s ease;
	}
	.guest-drag-card:hover {
		box-shadow: 3px 3px 0 var(--fg-pencil);
	}
	.guest-drag-card:active {
		cursor: grabbing;
		transform: scale(0.98);
	}

	.table-box-card {
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		padding: 1.1rem;
		background: var(--bg-paper);
		box-shadow: 3px 3px 0 var(--fg-pencil);
		display: flex;
		flex-direction: column;
		transition: all 0.2s ease;
	}
	.table-box-card:hover {
		box-shadow: 5px 5px 0 var(--fg-pencil);
	}

	.table-header-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 2px solid var(--fg-pencil);
		padding-bottom: 0.5rem;
		margin-bottom: 0.6rem;
	}

	.seat-dot {
		display: inline-block;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		border: 1.5px solid var(--fg-pencil);
		margin-right: 2px;
	}
	.seat-dot.filled {
		background: #22c55e;
	}
	.seat-dot.empty {
		background: #fff;
	}

	.cap-badge {
		font-size: 0.8rem;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		border: 1px solid var(--fg-pencil);
		background: #fff;
		font-weight: bold;
	}
	.cap-full {
		background: #dcfce7 !important;
		color: #15803d;
	}
	.cap-over {
		background: #fee2e2 !important;
		color: #b91c1c;
	}

	.seated-guest-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: #fff;
		border: 1px solid var(--fg-pencil);
		border-radius: 4px;
		padding: 0.35rem 0.5rem;
		font-size: 0.9rem;
	}

	.unseat-btn {
		background: none;
		border: none;
		color: var(--accent-red);
		cursor: pointer;
		font-size: 0.85rem;
		padding: 0.1rem 0.3rem;
		border-radius: 3px;
		font-weight: bold;
	}
	.unseat-btn:hover {
		background: #fee2e2;
	}

	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 20px;
		}
	}
</style>

<script is:inline>
	const GUEST_STORAGE_KEY = 'manage_wedding_guests_it';
	const TABLE_STORAGE_KEY = 'manage_wedding_tables_it';

	const defaultTables = [
		{ id: 'table-head', name: 'Tavolo degli Sposi', capacity: 2, shape: 'Sweetheart' },
		{ id: 'table-1', name: 'Tavolo 1 — Famiglia Sposa', capacity: 8, shape: 'Round' },
		{ id: 'table-2', name: 'Tavolo 2 — Famiglia Sposo', capacity: 8, shape: 'Round' },
		{ id: 'table-3', name: 'Tavolo 3 — Amici Storici', capacity: 8, shape: 'Round' }
	];

	const defaultSampleGuests = [
		{ id: '1', name: 'Eleonora & Marco', group: "Famiglia Sposa", partySize: 2, rsvpStatus: 'Attending', dietary: 'Nessuna', tableId: 'table-1' },
		{ id: '2', name: 'Giacomo Bianchi', group: "Famiglia Sposo", partySize: 2, rsvpStatus: 'Attending', dietary: 'Senza Glutine', tableId: 'table-2' },
		{ id: '3', name: 'Marta De Luca', group: "Testimoni & VIP", partySize: 1, rsvpStatus: 'Attending', dietary: 'Vegano', tableId: 'table-head' },
		{ id: '4', name: 'Davide & Sara', group: "Amici Sposo", partySize: 2, rsvpStatus: 'Attending', dietary: 'Nessuna', tableId: 'table-3' },
		{ id: '5', name: 'Chiara Moretti', group: "Amici Sposa", partySize: 2, rsvpStatus: 'Attending', dietary: 'Senza Lattosio', tableId: 'table-3' },
		{ id: '6', name: 'Zia Rosa', group: "Famiglia Sposa", partySize: 1, rsvpStatus: 'Attending', dietary: 'Vegetariano', tableId: 'table-1' },
		{ id: '7', name: 'Federico & Giulia', group: "Amici Comuni", partySize: 2, rsvpStatus: 'Attending', dietary: 'Nessuna', tableId: null }
	];

	let guests = [];
	let tables = [];

	function loadData() {
		const rawGuests = localStorage.getItem(GUEST_STORAGE_KEY);
		if (rawGuests) {
			try {
				const all = JSON.parse(rawGuests);
				guests = all.filter(g => (g.rsvpStatus === 'Attending' || g.status === 'attending'));
				guests.forEach(g => {
					if (!g.partySize) g.partySize = 1;
				});
			} catch (e) {
				guests = [];
			}
		} else {
			guests = JSON.parse(JSON.stringify(defaultSampleGuests));
			saveGuestsData();
		}

		const rawTables = localStorage.getItem(TABLE_STORAGE_KEY);
		if (rawTables) {
			try {
				tables = JSON.parse(rawTables);
			} catch (e) {
				tables = JSON.parse(JSON.stringify(defaultTables));
			}
		} else {
			tables = JSON.parse(JSON.stringify(defaultTables));
			saveTablesData();
		}
	}

	function saveGuestsData() {
		const rawGuests = localStorage.getItem(GUEST_STORAGE_KEY);
		let all = [];
		if (rawGuests) {
			try { all = JSON.parse(rawGuests); } catch (e) { all = []; }
		} else {
			all = JSON.parse(JSON.stringify(defaultSampleGuests));
		}

		guests.forEach(g => {
			const found = all.find(ag => ag.id === g.id);
			if (found) {
				found.tableId = g.tableId;
			}
		});

		localStorage.setItem(GUEST_STORAGE_KEY, JSON.stringify(all));
		updateProgressAndStats();
	}

	function saveTablesData() {
		localStorage.setItem(TABLE_STORAGE_KEY, JSON.stringify(tables));
		updateProgressAndStats();
	}

	const unassignedDropzone = document.getElementById('unassigned-dropzone');
	const tablesContainer = document.getElementById('tables-grid-container');
	const unassignedBadgeCount = document.getElementById('unassigned-badge-count');
	const unassignedSearch = document.getElementById('unassigned-search');

	const statTotalAttending = document.getElementById('stat-total-attending');
	const statSeatedCount = document.getElementById('stat-seated-count');
	const statSeatedPct = document.getElementById('stat-seated-pct');
	const statUnassignedCount = document.getElementById('stat-unassigned-count');
	const statTableCount = document.getElementById('stat-table-count');
	const statCapacityTotal = document.getElementById('stat-capacity-total');

	const progressBarFill = document.getElementById('progress-bar-fill');
	const progressText = document.getElementById('progress-text');

	function handleAddNewTable() {
		const newId = 'table-' + Date.now();
		const num = tables.length + 1;
		tables.push({
			id: newId,
			name: `Tavolo ${num}`,
			capacity: 8,
			shape: 'Round'
		});
		saveTablesData();
		renderTables();
		renderGuests();
	}

	document.getElementById('btn-add-table').addEventListener('click', handleAddNewTable);
	document.getElementById('btn-add-table-top').addEventListener('click', handleAddNewTable);

	document.getElementById('quick-add-guest-form').addEventListener('submit', (e) => {
		e.preventDefault();
		const nameInput = document.getElementById('quick-guest-name');
		const partySelect = document.getElementById('quick-guest-party');

		const name = nameInput.value.trim();
		const partySize = parseInt(partySelect.value, 10) || 1;

		if (!name) return;

		const newG = {
			id: Date.now().toString(),
			name,
			group: 'Amici Comuni',
			partySize,
			rsvpStatus: 'Attending',
			dietary: 'Nessuna',
			tableId: null
		};

		guests.unshift(newG);
		saveGuestsData();
		nameInput.value = '';
		renderGuests();
	});

	document.getElementById('btn-clear-seating').addEventListener('click', () => {
		if (confirm("Azzerare tutte le assegnazioni? (Tutti gli invitati torneranno tra i non assegnati)")) {
			guests.forEach(g => { g.tableId = null; });
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	});

	document.getElementById('btn-sample-data').addEventListener('click', () => {
		guests = JSON.parse(JSON.stringify(defaultSampleGuests));
		tables = JSON.parse(JSON.stringify(defaultTables));
		saveTablesData();
		saveGuestsData();
		renderTables();
		renderGuests();
	});

	document.getElementById('btn-auto-assign').addEventListener('click', () => {
		const unassigned = guests.filter(g => !g.tableId);
		if (unassigned.length === 0) {
			alert("Tutti gli invitati confermati sono già seduti!");
			return;
		}

		tables.forEach(t => {
			const currentSeated = guests.filter(g => g.tableId === t.id).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
			let space = t.capacity - currentSeated;

			unassigned.forEach(g => {
				const seats = parseInt(g.partySize) || 1;
				if (!g.tableId && seats <= space) {
					g.tableId = t.id;
					space -= seats;
				}
			});
		});

		saveGuestsData();
		renderTables();
		renderGuests();
	});

	unassignedSearch.addEventListener('input', renderGuests);

	window.handleDragStart = function(e) {
		e.dataTransfer.setData('text/plain', e.target.getAttribute('data-guest-id'));
	};

	window.handleDragOver = function(e) {
		e.preventDefault();
		const dropzone = e.target.closest('.drop-zone');
		if (dropzone) dropzone.classList.add('drag-over');
	};

	window.handleDragLeave = function(e) {
		const dropzone = e.target.closest('.drop-zone');
		if (dropzone) dropzone.classList.remove('drag-over');
	};

	window.handleDrop = function(e) {
		e.preventDefault();
		const dropzone = e.target.closest('.drop-zone');
		if (!dropzone) return;
		dropzone.classList.remove('drag-over');

		const guestId = e.dataTransfer.getData('text/plain');
		const targetTableId = dropzone.getAttribute('data-table-id');

		const g = guests.find(item => item.id === guestId);
		if (g) {
			g.tableId = targetTableId === 'unassigned' ? null : targetTableId;
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.moveGuestToTable = function(guestId, targetTableId) {
		const g = guests.find(item => item.id === guestId);
		if (g) {
			g.tableId = targetTableId === 'unassigned' ? null : targetTableId;
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.assignUnassignedGuestToTable = function(tableId, guestId) {
		if (!guestId) return;
		const g = guests.find(item => item.id === guestId);
		if (g) {
			g.tableId = tableId;
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.removeTable = function(tableId) {
		if (confirm("Eliminare questo tavolo? Gli invitati assegnati torneranno tra i non assegnati.")) {
			tables = tables.filter(t => t.id !== tableId);
			guests.forEach(g => {
				if (g.tableId === tableId) g.tableId = null;
			});
			saveTablesData();
			saveGuestsData();
			renderTables();
			renderGuests();
		}
	};

	window.updateTableName = function(tableId, newName) {
		const t = tables.find(item => item.id === tableId);
		if (t && newName.trim()) {
			t.name = newName.trim();
			saveTablesData();
		}
	};

	window.updateTableCapacity = function(tableId, newCap) {
		const t = tables.find(item => item.id === tableId);
		if (t) {
			t.capacity = parseInt(newCap, 10) || 8;
			saveTablesData();
			renderTables();
			renderGuests();
		}
	};

	window.updateTableShape = function(tableId, newShape) {
		const t = tables.find(item => item.id === tableId);
		if (t) {
			t.shape = newShape;
			saveTablesData();
			renderTables();
			renderGuests();
		}
	};

	function renderTables() {
		tablesContainer.innerHTML = '';

		if (tables.length === 0) {
			tablesContainer.innerHTML = `
				<div style="grid-column: 1 / -1; text-align: center; padding: 2.5rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🍽️</div>
					<h4 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">Nessun tavolo creato</h4>
					<p class="font-body" style="font-size: 0.95rem; margin-bottom: 1rem;">Clicca su "+ Aggiungi Tavolo" per configurare la sala.</p>
					<button type="button" class="hand-btn" onclick="handleAddNewTable()">➕ Aggiungi il Primo Tavolo</button>
				</div>
			`;
			return;
		}

		tables.forEach(table => {
			const tableDiv = document.createElement('div');
			tableDiv.className = 'table-box-card';

			const tableGuests = guests.filter(g => g.tableId === table.id);
			const seatedSeats = tableGuests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

			let capClass = '';
			if (seatedSeats === table.capacity) capClass = 'cap-full';
			else if (seatedSeats > table.capacity) capClass = 'cap-over';

			let dotsHtml = '';
			for (let i = 0; i < table.capacity; i++) {
				if (i < seatedSeats) {
					dotsHtml += '<span class="seat-dot filled" title="Posto Occupato"></span>';
				} else {
					dotsHtml += '<span class="seat-dot empty" title="Posto Libero"></span>';
				}
			}
			if (seatedSeats > table.capacity) {
				dotsHtml += `<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold; margin-left: 3px;">+${seatedSeats - table.capacity} Sovrannumero!</span>`;
			}

			let shapeIcon = '⭕ Rotondo';
			if (table.shape === 'Rectangular') shapeIcon = '▭ Imperiale';
			if (table.shape === 'Sweetheart') shapeIcon = '❤️ Tavolo Sposi';

			const unassignedGuests = guests.filter(g => !g.tableId);
			let quickAssignOptions = '<option value="">➕ Assegna invitato qui...</option>';
			unassignedGuests.forEach(ug => {
				quickAssignOptions += `<option value="${ug.id}">${ug.name} (${ug.partySize || 1} post${(ug.partySize || 1) > 1 ? 'i' : 'o'})</option>`;
			});

			tableDiv.innerHTML = `
				<div class="table-header-row">
					<div style="flex: 1; min-width: 0; margin-right: 0.5rem;">
						<strong contenteditable="true" style="font-family: var(--font-heading); font-size: 1.15rem; color: var(--fg-pencil); outline: none; border-bottom: 1px dotted var(--fg-pencil); display: inline-block; max-width: 100%;" onblur="updateTableName('${table.id}', this.innerText)" title="Clicca per rinominare il tavolo">${table.name}</strong>
						<span style="display: block; font-size: 0.8rem; color: var(--text-secondary); margin-top: 2px;">
							${shapeIcon}
						</span>
					</div>
					<div style="display: flex; align-items: center; gap: 0.4rem;">
						<span class="cap-badge ${capClass}" title="Posti occupati / Capienza tavolo">
							${seatedSeats} / ${table.capacity}
						</span>
						<button type="button" style="background:none; border:none; color: var(--accent-red); cursor:pointer; font-size: 1.1rem; padding: 2px 4px;" title="Elimina Tavolo" onclick="removeTable('${table.id}')">✖</button>
					</div>
				</div>

				<div style="margin-bottom: 0.75rem; display: flex; align-items: center; flex-wrap: wrap;">
					${dotsHtml}
				</div>

				<div style="display: flex; gap: 0.5rem; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.03); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.35rem 0.5rem; margin-bottom: 0.75rem; font-size: 0.8rem;">
					<label style="display: flex; align-items: center; gap: 0.3rem;">
						<span>Sedie:</span>
						<input type="number" min="1" max="30" value="${table.capacity}" style="width: 42px; padding: 2px; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.85rem;" onchange="updateTableCapacity('${table.id}', this.value)">
					</label>
					<label style="display: flex; align-items: center; gap: 0.3rem;">
						<span>Forma:</span>
						<select style="padding: 2px 4px; border: 1px solid var(--fg-pencil); border-radius: 3px; font-size: 0.8rem; background: #fff;" onchange="updateTableShape('${table.id}', this.value)">
							<option value="Round" ${table.shape === 'Round' ? 'selected' : ''}>Rotondo</option>
							<option value="Rectangular" ${table.shape === 'Rectangular' ? 'selected' : ''}>Imperiale</option>
							<option value="Sweetheart" ${table.shape === 'Sweetheart' ? 'selected' : ''}>Sposi</option>
						</select>
					</label>
				</div>

				<div class="drop-zone" data-table-id="${table.id}" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)" style="flex: 1; min-height: 90px; margin-bottom: 0.75rem;"></div>

				<div style="margin-top: auto;">
					<select style="width: 100%; box-sizing: border-box; padding: 0.35rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;" onchange="assignUnassignedGuestToTable('${table.id}', this.value); this.value='';">
						${quickAssignOptions}
					</select>
				</div>
			`;

			tablesContainer.appendChild(tableDiv);
		});
	}

	function renderGuests() {
		unassignedDropzone.innerHTML = '';

		tables.forEach(t => {
			const zone = document.querySelector(`.drop-zone[data-table-id="${t.id}"]`);
			if (zone) zone.innerHTML = '';
		});

		let unassignedCount = 0;
		const query = unassignedSearch.value.toLowerCase().trim();

		guests.forEach(g => {
			const isAssigned = !!(g.tableId && document.querySelector(`.drop-zone[data-table-id="${g.tableId}"]`));

			if (isAssigned) {
				const targetZone = document.querySelector(`.drop-zone[data-table-id="${g.tableId}"]`);
				const row = document.createElement('div');
				row.className = 'seated-guest-row';
				row.draggable = true;
				row.setAttribute('data-guest-id', g.id);
				row.ondragstart = handleDragStart;

				row.innerHTML = `
					<div style="flex: 1; min-width: 0; padding-right: 0.25rem;">
						<strong style="display: block; font-size: 0.95rem; color: var(--fg-pencil); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${g.name}</strong>
						<span style="font-size: 0.75rem; color: var(--text-secondary);">
							${g.partySize > 1 ? `(${g.partySize} posti) ` : ''}${g.dietary && g.dietary !== 'Nessuna' ? `🍽️ ${g.dietary}` : ''}
						</span>
					</div>
					<button type="button" class="unseat-btn" title="Rimuovi dal tavolo" onclick="moveGuestToTable('${g.id}', 'unassigned')">✖</button>
				`;
				targetZone.appendChild(row);

			} else {
				g.tableId = null;
				unassignedCount += (parseInt(g.partySize) || 1);

				const matchesSearch = !query || g.name.toLowerCase().includes(query) || (g.dietary && g.dietary.toLowerCase().includes(query)) || (g.group && g.group.toLowerCase().includes(query));

				if (matchesSearch) {
					const card = document.createElement('div');
					card.className = 'guest-drag-card';
					card.draggable = true;
					card.setAttribute('data-guest-id', g.id);
					card.ondragstart = handleDragStart;

					let optionsHtml = `<option value="unassigned" selected>🪑 Assegna a...</option>`;
					tables.forEach(t => {
						optionsHtml += `<option value="${t.id}">${t.name}</option>`;
					});

					card.innerHTML = `
						<div style="flex: 1; min-width: 0;">
							<strong style="display: block; font-size: 0.95rem; color: var(--fg-pencil); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${g.name}</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">
								${g.partySize > 1 ? `(${g.partySize} posti) ` : ''}${g.dietary && g.dietary !== 'Nessuna' ? `🍽️ ${g.dietary}` : ''}
							</span>
						</div>
						<select style="font-size: 0.8rem; border: 1px solid var(--fg-pencil); border-radius: 3px; padding: 2px 4px; background: #fff;" onchange="moveGuestToTable('${g.id}', this.value)">
							${optionsHtml}
						</select>
					`;

					unassignedDropzone.appendChild(card);
				}
			}
		});

		tables.forEach(t => {
			const zone = document.querySelector(`.drop-zone[data-table-id="${t.id}"]`);
			if (zone && zone.children.length === 0) {
				zone.innerHTML = '<div style="text-align: center; padding: 1.25rem 0.5rem; color: var(--text-secondary); font-size: 0.8rem; font-style: italic;">Trascina qui o seleziona dal menu sotto</div>';
			}
		});

		if (unassignedDropzone.children.length === 0) {
			if (guests.length === 0) {
				unassignedDropzone.innerHTML = '<div style="text-align: center; padding: 2rem 0.5rem; color: var(--text-secondary); font-size: 0.9rem;">Nessun invitato trovato. Clicca "Esempio" per iniziare!</div>';
			} else if (unassignedCount === 0) {
				unassignedDropzone.innerHTML = '<div style="text-align: center; padding: 2rem 0.5rem; color: #15803d; font-size: 0.95rem; font-weight: bold;">🎉 Tutti gli invitati sono seduti!</div>';
			} else {
				unassignedDropzone.innerHTML = '<div style="text-align: center; padding: 1.5rem 0.5rem; color: var(--text-secondary); font-size: 0.85rem; font-style: italic;">Nessun invitato corrisponde alla ricerca.</div>';
			}
		}

		unassignedBadgeCount.textContent = unassignedCount;
		updateProgressAndStats();
	}

	function updateProgressAndStats() {
		const totalAttendingSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const seatedSeats = guests.filter(g => g.tableId).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const unassignedSeats = totalAttendingSeats - seatedSeats;
		const totalTableCapacity = tables.reduce((sum, t) => sum + (parseInt(t.capacity) || 8), 0);

		statTotalAttending.textContent = totalAttendingSeats;
		statSeatedCount.textContent = seatedSeats;
		statSeatedPct.textContent = totalAttendingSeats > 0 ? `${Math.round((seatedSeats / totalAttendingSeats) * 100)}% assegnati` : '0%';
		statUnassignedCount.textContent = unassignedSeats;
		statTableCount.textContent = tables.length;
		statCapacityTotal.textContent = `${totalTableCapacity} Sedie Totali`;

		const pct = totalAttendingSeats > 0 ? Math.round((seatedSeats / totalAttendingSeats) * 100) : 0;
		progressBarFill.style.width = `${pct}%`;
		progressText.textContent = `${pct}% Assegnati (${seatedSeats}/${totalAttendingSeats} Coperti)`;
	}

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		if (tables.length === 0) {
			alert("Nessun tavolo configurato!");
			return;
		}

		let tablesHtml = '';
		tables.forEach((t) => {
			const tGuests = guests.filter(g => g.tableId === t.id);
			const seatedSeats = tGuests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

			let guestRows = '';
			if (tGuests.length === 0) {
				guestRows = '<tr><td colspan="4" style="border:1px solid #ccc; padding:6px; font-style:italic; color:#777;">Nessun invitato assegnato</td></tr>';
			} else {
				tGuests.forEach((g, gIdx) => {
					guestRows += `
						<tr>
							<td style="border:1px solid #ccc; padding:6px;">${gIdx + 1}</td>
							<td style="border:1px solid #ccc; padding:6px; font-weight:bold;">${g.name}</td>
							<td style="border:1px solid #ccc; padding:6px; text-align:center;">${g.partySize || 1}</td>
							<td style="border:1px solid #ccc; padding:6px;">${g.dietary || 'Nessuna'}</td>
						</tr>
					`;
				});
			}

			tablesHtml += `
				<div style="margin-bottom: 24px;">
					<h3 style="background:#f2f2f2; border:1px solid #ccc; padding:8px; margin:0;">
						${t.name} — ${seatedSeats} / ${t.capacity} Posti (${t.shape === 'Round' ? 'Rotondo' : t.shape === 'Sweetheart' ? 'Sposi' : 'Imperiale'})
					</h3>
					<table style="width:100%; border-collapse:collapse; font-size:13px;">
						<thead>
							<tr style="background:#fafafa;">
								<th style="border:1px solid #ccc; padding:6px; width:30px;">#</th>
								<th style="border:1px solid #ccc; padding:6px; text-align:left;">Nome Invitato</th>
								<th style="border:1px solid #ccc; padding:6px; width:60px; text-align:center;">Posti</th>
								<th style="border:1px solid #ccc; padding:6px; text-align:left;">Intolleranze / Menù</th>
							</tr>
						</thead>
						<tbody>
							${guestRows}
						</tbody>
					</table>
				</div>
			`;
		});

		const totalAttendingSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const seatedSeats = guests.filter(g => g.tableId).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Piano Tavoli Ufficiale Matrimonio</title>
				<style>
					body { font-family: Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Piano Ufficiale dei Tavoli</h1>
				<p>Generato il ${new Date().toLocaleDateString('it-IT')} | Totale Tavoli: ${tables.length} | Invitati Seduti: ${seatedSeats} su ${totalAttendingSeats}</p>
				${tablesHtml}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Piano_Tavoli_Matrimonio_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('it-IT');
		const totalAttendingSeats = guests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		const seatedSeats = guests.filter(g => g.tableId).reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);
		document.getElementById('print-seated-count').textContent = `${seatedSeats} su ${totalAttendingSeats} (${tables.length} Tavoli)`;

		let out = '';
		tables.forEach(t => {
			const tGuests = guests.filter(g => g.tableId === t.id);
			const seated = tGuests.reduce((sum, g) => sum + (parseInt(g.partySize) || 1), 0);

			let rows = '';
			tGuests.forEach(g => {
				rows += `<tr>
					<td style="border: 1px solid #ccc; padding: 6px; font-weight:bold;">${g.name}</td>
					<td style="border: 1px solid #ccc; padding: 6px; text-align:center;">${g.partySize || 1}</td>
					<td style="border: 1px solid #ccc; padding: 6px;">${g.dietary || 'Nessuna'}</td>
				</tr>`;
			});

			out += `
				<div style="margin-bottom: 20px; page-break-inside: avoid;">
					<h3 style="background:#f2f2f2; border:1px solid #ccc; padding: 6px 10px; margin: 0 0 5px 0; font-size: 14px;">
						${t.name} (${seated} / ${t.capacity} posti)
					</h3>
					<table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 10px;">
						<thead>
							<tr style="background:#fafafa;">
								<th style="border:1px solid #ccc; padding:5px; text-align:left;">Nome Invitato</th>
								<th style="border:1px solid #ccc; padding:5px; width:60px; text-align:center;">Posti</th>
								<th style="border:1px solid #ccc; padding:5px; text-align:left;">Intolleranze</th>
							</tr>
						</thead>
						<tbody>
							${rows || '<tr><td colspan="3" style="border:1px solid #ccc; padding:6px; font-style:italic;">Nessun invitato assegnato</td></tr>'}
						</tbody>
					</table>
				</div>
			`;
		});

		document.getElementById('print-tables-content').innerHTML = out;
		window.print();
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Nome Tavolo,Capienza Tavolo,Nome Invitato,Posti,Gruppo,Intolleranze\n";
		tables.forEach(t => {
			const tGuests = guests.filter(g => g.tableId === t.id);
			if (tGuests.length === 0) {
				csv += `"${t.name}",${t.capacity},"Nessuno Assegnato",0,"-","-"\n`;
			} else {
				tGuests.forEach(g => {
					csv += `"${t.name}",${t.capacity},"${(g.name||'').replace(/"/g, '""')}",${g.partySize || 1},"${g.group||''}","${(g.dietary||'').replace(/"/g, '""')}"\n`;
				});
			}
		});

		const unassigned = guests.filter(g => !g.tableId);
		unassigned.forEach(g => {
			csv += `"Non Assegnati",-,"${(g.name||'').replace(/"/g, '""')}",${g.partySize || 1},"${g.group||''}","${(g.dietary||'').replace(/"/g, '""')}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Piano_Tavoli_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	loadData();
	renderTables();
	renderGuests();
</script>
