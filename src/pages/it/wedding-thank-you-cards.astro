---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-thank-you-cards/#webapp",
      "name": "Generatore Biglietti di Ringraziamento Matrimonio & Frasi Galateo",
      "url": "https://manage.wedding/it/wedding-thank-you-cards",
      "inLanguage": "it",
      "description": "Generatore gratuito di frasi e biglietti di ringraziamento per matrimonio. Testi personalizzati per regalo in busta, quota viaggio di nozze, testimoni e fornitori con esportazione in Word e PDF.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come scrivere un biglietto di ringraziamento per il matrimonio",
      "description": "La struttura ideale in 4 frasi secondo il galateo italiano per ringraziare gli invitati.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Ringraziare per la presenza e l'affetto",
          "text": "Ringrazia gli invitati per aver condiviso la gioia del matrimonio."
        },
        {
          "@type": "HowToStep",
          "name": "2. Citare il regalo ricevuto con eleganza",
          "text": "Nomina il regalo specifico o 'il vostro generoso pensiero' per il viaggio o la casa senza mai scrivere la somma di denaro ricevuta."
        },
        {
          "@type": "HowToStep",
          "name": "3. Raccontare come verrà utilizzato",
          "text": "Spiega brevemente come il dono contribuirà al viaggio di nozze o ai progetti futuri della nuova famiglia."
        },
        {
          "@type": "HowToStep",
          "name": "4. Saluto affettuoso e firma degli sposi",
          "text": "Concludi con una frase calorosa e le firme di entrambi gli sposi."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Entro quanto tempo vanno inviati i ringraziamenti di matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il galateo consiglia di inviare i biglietti di ringraziamento scritti a mano entro 1–3 mesi dal rientro dal viaggio di nozze."
          }
        },
        {
          "@type": "Question",
          "name": "Come ringraziare per i regali in denaro o la busta degli sposi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Non menzionare mai la cifra esatta. Esprimi gratitudine per il 'generoso pensiero' o il 'meraviglioso contributo' e racconta l'esperienza o il progetto che renderà possibile (es. il viaggio di nozze in Giappone o l'arredamento della casa)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Generatore Biglietti di Ringraziamento Matrimonio & Frasi Galateo | Manage.Wedding"
	description="Genera gratis testi e frasi di ringraziamento per il matrimonio secondo il galateo. Biglietti personalizzati per busta con soldi, viaggio di nozze, testimoni, genitori e bomboniere."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Biglietti di Ringraziamento Nozze" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Galateo Nozze & Frasi Personalizzate</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Biglietti di Ringraziamento <span class="accent-italic">& Frasi di Nozze</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Crea frasi sincere e impeccabili per ringraziare di regali in busta, quote viaggio di nozze, bomboniere e testimoni. Copia con 1 clic o esporta in PDF e Word.
			</p>
		</header>

		<!-- Main Interactive Generator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Input Form -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Personalizza il Messaggio
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Formula Galateo
					</span>
				</div>

				<!-- Recipient Name -->
				<div class="form-group">
					<label class="form-label" for="guest-names">Nome Invitato / Destinatario</label>
					<input type="text" id="guest-names" class="form-input" value="Zia Laura e Zio Mario" placeholder="es. Zia Laura e Zio Mario, Marco e Sara" />
				</div>

				<!-- Relationship to Couple -->
				<div class="form-group">
					<label class="form-label" for="relationship">Rapporto di Parentela / Amicizia</label>
					<select id="relationship" class="form-input" style="cursor: pointer;">
						<option value="family-close">Famiglia Stretta (Genitori, Fratelli, Nonni)</option>
						<option value="family-extended" selected>Parenti (Zii, Cugini)</option>
						<option value="witnesses">Testimoni di Nozze</option>
						<option value="friends-close">Amici Stretti</option>
						<option value="friends-casual">Colleghi di Lavoro / Conoscenti</option>
						<option value="absent">Invitato Assente (Che ha inviato un regalo)</option>
					</select>
				</div>

				<!-- Gift Category -->
				<div class="form-group">
					<label class="form-label" for="gift-type">Tipologia di Regalo Ricevuto</label>
					<select id="gift-type" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="cash" selected>💵 Busta con Denaro / Bonifico sul Conto</option>
						<option value="honeymoon">🏝️ Quota Viaggio di Nozze / Luna di Miele</option>
						<option value="registry">🎁 Oggetto Fisico / Lista Nozze Casa</option>
						<option value="attendance">✨ Solo Presenza e Affetto (Nessun regalo)</option>
						<option value="group">👥 Regalo di Gruppo (Colleghi o Amici)</option>
					</select>
				</div>

				<!-- Gift Specific Item / Detail -->
				<div class="form-group" id="gift-detail-group">
					<label class="form-label" for="gift-detail">Dettaglio Regalo o Progetto Futuro</label>
					<input type="text" id="gift-detail" class="form-input" value="il nostro viaggio di nozze in Giappone e la nuova casa" placeholder="es. il viaggio in Giappone, la splendida lampada di design" />
				</div>

				<!-- Tone / Style Selector -->
				<div class="form-group">
					<label class="form-label">Tono & Stile di Scrittura</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="tone-btn hand-btn is-active" data-tone="heartfelt" style="padding: 8px; font-size: 0.88rem;">
							💖 Affettuoso & Caldo
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="formal" style="padding: 8px; font-size: 0.88rem;">
							🏛️ Formale & Classico
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="casual" style="padding: 8px; font-size: 0.88rem;">
							✨ Spontaneo & Moderno
						</button>
						<button type="button" class="tone-btn hand-btn" data-tone="short" style="padding: 8px; font-size: 0.88rem;">
							⚡ Breve & Diretto
						</button>
					</div>
				</div>

				<!-- Personal Memory (Optional) -->
				<div class="form-group">
					<label class="form-label" for="personal-memory">Ricordo Speciale del Giorno (Opzionale)</label>
					<input type="text" id="personal-memory" class="form-input" value="È stato bellissimo vederti scatenare in pista durante la festa!" placeholder="es. Grazie per essere venuti da così lontano!" />
				</div>

				<!-- Sign-off Names -->
				<div class="form-group">
					<label class="form-label" for="signoff-names">Firma degli Sposi</label>
					<input type="text" id="signoff-names" class="form-input" value="Chiara & Alessandro" placeholder="es. Chiara & Alessandro" />
				</div>

				<button id="btn-generate-notes" class="hand-btn" style="width: 100%; padding: 14px; font-size: 1.1rem; margin-top: 0.5rem; justify-content: center;">
					<span>✨</span> Genera 3 Proposte di Testo
				</button>

			</div>

			<!-- Right Column: 3 Generated Options -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<div style="display: flex; justify-content: space-between; align-items: center;">
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						Frasi di Ringraziamento Generate
					</h3>
					<span id="word-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
						~45 parole | 1 minuto di scrittura
					</span>
				</div>

				<!-- Option 1 Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #fffcf5; border-left: 6px solid var(--accent-red); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Opzione 1: Consigliata (Equilibrata)
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-1" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copia Testo
						</button>
					</div>
					<p id="note-opt-1" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;"></p>
				</div>

				<!-- Option 2 Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid var(--accent-blue); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-blue); letter-spacing: 0.05em;">
							Opzione 2: Alternativa Elegante
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-2" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copia Testo
						</button>
					</div>
					<p id="note-opt-2" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;"></p>
				</div>

				<!-- Option 3 Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #ffffff; border-left: 6px solid #16a34a; position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #16a34a; letter-spacing: 0.05em;">
							Opzione 3: Sintetica
						</span>
						<button class="copy-note-btn hand-btn secondary" data-target="note-opt-3" style="padding: 4px 10px; font-size: 0.82rem;">
							📋 Copia Testo
						</button>
					</div>
					<p id="note-opt-3" class="font-body" style="font-size: 1.05rem; line-height: 1.65; color: var(--fg-pencil); margin: 0; font-style: italic; white-space: pre-wrap;"></p>
				</div>

				<!-- Action Bar -->
				<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
					<button id="btn-print-note" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>🖨️</span> Stampa Biglietto (PDF)
					</button>
					<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
						<span>📄</span> Esporta Documento Word
					</button>
				</div>

			</div>

		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Il Galateo dei Ringraziamenti di Matrimonio
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Tempistiche, regole per i regali in denaro e formule speciali per i testimoni.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. La Regola Fondamentale: Mai Citare la Cifra
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Anche se la maggior parte degli invitati nei matrimoni italiani regala la classica busta con contanti o un bonifico, il galateo impone di non scrivere mai la cifra esatta sul biglietto di ringraziamento. Si ringrazia sempre per il "generoso pensiero" e per l'affetto dimostrato.
				</p>
			</section>
		</article>

		<RelatedTools currentPath="/it/wedding-thank-you-cards" category="stationery" />
	</main>
</Layout>

<script is:inline>
	const guestNamesInput = document.getElementById('guest-names');
	const relationshipSelect = document.getElementById('relationship');
	const giftTypeSelect = document.getElementById('gift-type');
	const giftDetailGroup = document.getElementById('gift-detail-group');
	const giftDetailInput = document.getElementById('gift-detail');
	const memoryInput = document.getElementById('personal-memory');
	const signoffInput = document.getElementById('signoff-names');
	const toneButtons = document.querySelectorAll('.tone-btn');
	const btnGenerate = document.getElementById('btn-generate-notes');

	const noteOpt1 = document.getElementById('note-opt-1');
	const noteOpt2 = document.getElementById('note-opt-2');
	const noteOpt3 = document.getElementById('note-opt-3');
	const wordCountBadge = document.getElementById('word-count-badge');
	const btnPrint = document.getElementById('btn-print-note');
	const btnDoc = document.getElementById('btn-export-doc');

	let currentTone = 'heartfelt';

	toneButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			toneButtons.forEach(b => b.classList.remove('is-active'));
			btn.classList.add('is-active');
			currentTone = btn.getAttribute('data-tone');
			generateNotes();
		});
	});

	giftTypeSelect.addEventListener('change', () => {
		const type = giftTypeSelect.value;
		if (type === 'attendance') {
			giftDetailGroup.style.display = 'none';
		} else {
			giftDetailGroup.style.display = 'block';
			if (type === 'cash') giftDetailInput.placeholder = 'es. il viaggio di nozze in Giappone e la nostra casa';
			else if (type === 'honeymoon') giftDetailInput.placeholder = 'es. l\'escursione in barca alle Maldive';
			else if (type === 'registry') giftDetailInput.placeholder = 'es. lo splendido servizio di piatti';
			else if (type === 'group') giftDetailInput.placeholder = 'es. la macchina da caffè espresso';
		}
		generateNotes();
	});

	function generateNotes() {
		const names = guestNamesInput.value.trim() || 'Cari';
		const gift = giftTypeSelect.value;
		const detail = giftDetailInput.value.trim() || 'il vostro splendido regalo';
		const memory = memoryInput.value.trim();
		const signoff = signoffInput.value.trim() || 'Chiara & Alessandro';

		let opt1 = '', opt2 = '', opt3 = '';
		const memoryClause = memory ? ` ${memory}` : '';

		if (currentTone === 'heartfelt') {
			if (gift === 'cash') {
				opt1 = `Carissimi ${names},\n\nGrazie di vero cuore per aver condiviso con noi la gioia del nostro matrimonio! La vostra presenza ha reso questo giorno indimenticabile. Vi ringraziamo con affetto per il vostro generoso pensiero destinato a ${detail}.${memoryClause} Non vediamo l'ora di rivedervi presto!\n\nCon tanto affetto,\n${signoff}`;
				opt2 = `Cari ${names},\n\nNon troviamo parole sufficienti per ringraziarvi di essere stati con noi. Il vostro affetto è stato il dono più bello. Grazie di cuore per il vostro meraviglioso contributo per ${detail}: ci aiuterà a iniziare questo nuovo cammino insieme nel modo più dolce!${memoryClause}\n\nUn abbraccio immenso,\n${signoff}`;
				opt3 = `Carissimi ${names},\n\nGrazie per aver reso unico il nostro giorno speciale e per la vostra grande generosità. Il vostro regalo per ${detail} è per noi preziosissimo.${memoryClause} Grazie per il vostro costante affetto!\n\nCon affetto,\n${signoff}`;
			} else if (gift === 'honeymoon') {
				opt1 = `Carissimi ${names},\n\nGrazie per aver festeggiato con noi il nostro sì! Siamo infinitamente grati per il vostro regalo dedicato a ${detail}: ha reso il nostro viaggio di nozze un'esperienza magica che ricorderemo per sempre.${memoryClause}\n\nCon affetto e gratitudine,\n${signoff}`;
				opt2 = `Cari ${names},\n\nAvervi accanto nel giorno delle nostre nozze è stato bellissimo. Grazie di cuore per averci regalato ${detail} durante la nostra luna di miele: è stato uno dei momenti più emozionanti del viaggio!${memoryClause}\n\nUn caro saluto,\n${signoff}`;
				opt3 = `Carissimi ${names},\n\nGrazie per il vostro affetto e per il meraviglioso contributo per ${detail}. La vostra vicinanza ha reso la nostra prima avventura da marito e moglie ancora più speciale!${memoryClause}\n\nCon tanto affetto,\n${signoff}`;
			} else if (gift === 'registry') {
				opt1 = `Carissimi ${names},\n\nGrazie di cuore per aver festeggiato con noi! Adoriamo ${detail} che avete scelto per la nostra casa: ha già trovato il posto perfetto nel nostro nuovo nido!${memoryClause}\n\nCon affetto,\n${signoff}`;
				opt2 = `Cari ${names},\n\nÈ stato splendido avervi con noi al nostro matrimonio. Grazie mille per il regalo graditissimo di ${detail}: lo useremo con gioia pensando sempre a voi!${memoryClause}\n\nI nostri più cari saluti,\n${signoff}`;
				opt3 = `Carissimi ${names},\n\nGrazie per aver condiviso la nostra felicità e per lo splendido regalo di ${detail}. La vostra gentilezza significa davvero molto per noi.${memoryClause}\n\nCon affetto,\n${signoff}`;
			} else {
				opt1 = `Carissimi ${names},\n\nGrazie di cuore per aver festeggiato il nostro matrimonio con noi! La vostra presenza, il vostro sorriso e il vostro calore hanno reso la nostra giornata perfetta.${memoryClause} Siamo immensamente felici di avervi nella nostra vita.\n\nCon tanto affetto,\n${signoff}`;
				opt2 = `Cari ${names},\n\nSiamo felicissimi che abbiate partecipato alle nostre nozze. Grazie per aver viaggiato e condiviso con noi un momento così importante!${memoryClause} A prestissimo!\n\nUn abbraccio,\n${signoff}`;
				opt3 = `Carissimi ${names},\n\nGrazie per essere stati parte del giorno più bello della nostra vita! Il vostro affetto e il vostro entusiasmo hanno reso tutto speciale.${memoryClause}\n\nCon affetto sincero,\n${signoff}`;
			}
		} else if (currentTone === 'formal') {
			opt1 = `Gentilissimi ${names},\n\nDesideriamo ringraziarvi sentitamente per aver preso parte alla celebrazione del nostro matrimonio. Siamo profondamente grati per il vostro graditissimo e generoso dono per ${detail}.${memoryClause} Con viva riconoscenza.\n\nCordiali saluti,\n${signoff}`;
			opt2 = `Gentili ${names},\n\nVi ringraziamo di cuore per la gradita presenza e per il magnifico dono di ${detail} in occasione delle nostre nozze. È stato un vero onore condividere con voi un giorno così significativo.${memoryClause}\n\nI nostri più distinti saluti,\n${signoff}`;
			opt3 = `Gentilissimi ${names},\n\nNel ricordo della splendida giornata del nostro matrimonio, vi ringraziamo sinceramente per il vostro affetto e per il generoso regalo per ${detail}.${memoryClause}\n\nCon profonda stima,\n${signoff}`;
		} else if (currentTone === 'casual') {
			opt1 = `Ciao ${names}!\n\nGrazie mille per essere stati con noi, ci siamo divertiti tantissimo insieme a voi! Grazie di cuore per ${detail}.${memoryClause} Ci vediamo prestissimo per una cena insieme!\n\nUn abbraccio forte,\n${signoff}`;
			opt2 = `Carissimi ${names},\n\nGrazie per aver portato tanta allegria alla nostra festa! Adoriamo ${detail} e siamo davvero fortunati ad avervi come amici.${memoryClause}\n\nA presto,\n${signoff}`;
			opt3 = `Ciao ${names}!\n\nUn milione di grazie per aver festeggiato con noi e per lo splendido regalo per ${detail}! È stato bellissimo.${memoryClause}\n\nBaci,\n${signoff}`;
		} else {
			opt1 = `Carissimi ${names},\n\nGrazie di cuore per aver partecipato al nostro matrimonio e per il vostro generoso pensiero per ${detail}.${memoryClause} Vi vogliamo bene!\n\nCon affetto,\n${signoff}`;
			opt2 = `Cari ${names},\n\nÈ stato bellissimo avervi con noi nel nostro giorno speciale. Grazie mille per lo splendido dono di ${detail}.${memoryClause}\n\nUn abbraccio,\n${signoff}`;
			opt3 = `Carissimi ${names},\n\nGrazie per aver reso il nostro matrimonio indimenticabile e per il vostro graditissimo regalo per ${detail}.${memoryClause}\n\nCon affetto,\n${signoff}`;
		}

		noteOpt1.textContent = opt1;
		noteOpt2.textContent = opt2;
		noteOpt3.textContent = opt3;

		const words = opt1.split(/\s+/).length;
		wordCountBadge.textContent = `~${words} parole | ~1 minuto di scrittura`;
	}

	[guestNamesInput, relationshipSelect, giftDetailInput, memoryInput, signoffInput].forEach(inp => {
		inp.addEventListener('input', generateNotes);
	});
	btnGenerate.addEventListener('click', generateNotes);

	document.querySelectorAll('.copy-note-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			const targetId = btn.getAttribute('data-target');
			const text = document.getElementById(targetId).textContent;
			navigator.clipboard.writeText(text).then(() => {
				const orig = btn.textContent;
				btn.textContent = '✅ Copiato!';
				setTimeout(() => { btn.textContent = orig; }, 2000);
			});
		});
	});

	btnPrint.addEventListener('click', () => {
		const printWindow = window.open('', '_blank');
		const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
		printWindow.document.write(`
			<!DOCTYPE html>
			<html>
			<head>
				<title>Stampa Biglietto di Ringraziamento — Manage.Wedding</title>
				<style>
					@page { size: 15cm 10cm; margin: 1cm; }
					body { font-family: 'Times New Roman', Georgia, serif; font-size: 13pt; line-height: 1.6; color: #1e293b; padding: 10px; }
				</style>
			</head>
			<body>
				<div>${noteText}</div>
				<script>window.onload = function() { window.print(); };<\/script>
			</body>
			</html>
		`);
		printWindow.document.close();
	});

	btnDoc.addEventListener('click', () => {
		const noteText = noteOpt1.textContent.replace(/\n/g, '<br/>');
		const content = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset="utf-8"><title>Biglietto di Ringraziamento Matrimonio</title>
			<style>body { font-family: Arial, sans-serif; font-size: 12pt; line-height: 1.6; padding: 20px; }</style>
			</head>
			<body>
				<h2>Manage.Wedding — Biglietto di Ringraziamento</h2>
				<p>${noteText}</p>
			</body></html>
		`;
		const blob = new Blob(['\ufeff', content], { type: 'application/msword' });
		const link = document.createElement('a');
		link.href = URL.createObjectURL(blob);
		link.download = `ringraziamento-${guestNamesInput.value.replace(/[^a-zA-Z0-9]/g, '_')}.doc`;
		link.click();
	});

	generateNotes();
</script>
