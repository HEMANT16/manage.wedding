---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-playlist-duration-calculator/#webapp",
      "name": "Calcolatore Playlist Matrimonio, Brani per DJ e Durata",
      "url": "https://manage.wedding/it/wedding-playlist-duration-calculator",
      "inLanguage": "it",
      "description": "Calcolatore gratuito di musica e playlist di nozze. Calcola il numero esatto di brani per rito, aperitivo, pranzo/cena e festa serale, pianifica i balli speciali e genera il briefing per il DJ in PDF e Word.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanti brani servono per un matrimonio di 6 ore?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per un ricevimento completo di 6 ore (360 minuti), vengono riprodotti circa 100-120 brani (calcolando 3,5 minuti per canzone intera o 2,5 minuti nei cambi rapidi del DJ). Si raccomanda di preparare una playlist complessiva con un margine del 20% (circa 130-140 brani) per offrire al DJ la massima flessibilità."
          }
        },
        {
          "@type": "Question",
          "name": "Quante canzoni 'Must-Play' è consigliabile indicare al DJ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "I DJ professionisti consigliano di limitare la lista dei brani irrinunciabili a 15-20 canzoni al massimo. Una lista rigida di 50 o 100 brani toglie al DJ la possibilità di leggere le reazioni degli invitati e adattare il ritmo della pista."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto dovrebbe durare il primo ballo degli sposi e il ballo con i genitori?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La durata ideale del primo ballo è di 2:30 - 3 minuti. Oltre i 3 minuti al centro della pista l'attenzione degli ospiti tende a calare. Chiedete al DJ una sfumatura graduale (fade out) a 2 minuti e mezzo o invitate testimoni e amici a raggiungervi sulla pista."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Come Pianificare la Playlist e la Scheda Musicale per il DJ di Nozze",
      "description": "Metodo passo dopo passo per calcolare il numero di brani, programmare i momenti speciali e scaricare il briefing per il DJ.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Imposta le Durate delle Fasi",
          "text": "Regola i minuti per cerimonia, aperitivo di benvenuto, banchetto e festa serale per calcolare il numero di brani."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Assegna i Momenti Speciali e Indicazioni Audio",
          "text": "Seleziona i brani per l'ingresso sposi, primo ballo, taglio torta e lancio del bouquet con i relativi minuti di sfumatura."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Crea la Lista Must-Play e la Blacklist",
          "text": "Aggiungi fino a 20 brani preferiti ed escludi i generi e le canzoni non gradite."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Esporta la Scheda DJ (PDF e Word)",
          "text": "Scarica il documento completo pronto da consegnare al DJ o alla band per il briefing pre-matrimonio."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Playlist Matrimonio, Brani DJ e Durata (Briefing PDF & Word Gratis) | Manage.Wedding"
	description="Calcola il numero esatto di brani per il tuo matrimonio, imposta i balli speciali con indicazioni audio, crea la lista preferiti e blacklist, e scarica la scheda DJ."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Playlist & Musica DJ" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🎵</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratuito • Nel Tuo Browser • Download Immediato PDF & Word</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calcolatore Playlist Matrimonio & Musica DJ
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 740px; margin: 0 auto; text-align: center;">
					Calcola il numero esatto di brani per ogni momento, imposta i balli speciali con minutaggi di sfumatura, crea la tua <strong>Lista Must-Play & Blacklist</strong> ed esporta la <strong>Scheda Tecnica per il DJ o Musicisti</strong> in PDF e Word!
				</p>
			</div>
		</section>

		<!-- Guida in 3 Passaggi -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>🎧</span> Come Organizzare la Musica del Matrimonio in 3 Passi
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Durata e Ritmo BPM
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Regola i cursori per rito, aperitivo, banchetto e festa per calcolare il numero di brani necessari.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Momenti Speciali
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Scegli i brani per ingresso sposi, primo ballo, taglio torta e lancio del bouquet con note di sfumatura.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Liste & Briefing DJ
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Aggiungi fino a 20 brani del cuore, escludi i brani indesiderati e scarica il PDF pronto da stampare.
					</p>
				</div>
			</div>
		</div>

		<!-- Area di Lavoro Interattiva -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SEZIONE 1: Cursori di Durata & Conteggio Brani -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🎚️ 1. Durata delle Fasi & Calcolo Brani
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Calcola il volume di brani in base allo stile di missaggio del DJ
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center;">
						<label for="select-mix-pacing" class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil);">
							Stile DJ:
						</label>
						<select id="select-mix-pacing" style="padding: 0.35rem 0.6rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem; font-weight: 600;">
							<option value="radio" selected>Brani Radio Interi (~3.5 min / 17 brani/ora)</option>
							<option value="quickmix">Transizioni Rapide DJ (~2.7 min / 22 brani/ora)</option>
							<option value="lounge">Acustico & Lounge (~4.2 min / 14 brani/ora)</option>
						</select>
					</div>
				</div>

				<!-- Griglia Cursori -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem;">
					
					<!-- Preludio -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-prelude" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🎻</span> Preludio / Cerimonia
							</label>
							<span id="val-prelude" class="font-heading" style="font-size: 1rem; color: var(--accent-red); font-weight: 700;">30 min</span>
						</div>
						<input type="range" id="slider-prelude" min="15" max="60" step="5" value="30" style="width: 100%; accent-color: var(--accent-red);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>15 min</span>
							<span id="songs-prelude" style="font-weight: 600; color: var(--fg-pencil);">~9 brani (60-80 BPM)</span>
							<span>60 min</span>
						</div>
					</div>

					<!-- Aperitivo -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-cocktail" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍸</span> Aperitivo di Benvenuto
							</label>
							<span id="val-cocktail" class="font-heading" style="font-size: 1rem; color: var(--accent-blue); font-weight: 700;">60 min</span>
						</div>
						<input type="range" id="slider-cocktail" min="30" max="120" step="5" value="60" style="width: 100%; accent-color: var(--accent-blue);" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>30 min</span>
							<span id="songs-cocktail" style="font-weight: 600; color: var(--fg-pencil);">~17 brani (90-115 BPM)</span>
							<span>120 min</span>
						</div>
					</div>

					<!-- Banchetto -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dinner" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🍽️</span> Pranzo / Cena
							</label>
							<span id="val-dinner" class="font-heading" style="font-size: 1rem; color: #d97706; font-weight: 700;">90 min</span>
						</div>
						<input type="range" id="slider-dinner" min="45" max="150" step="5" value="90" style="width: 100%; accent-color: #d97706;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>45 min</span>
							<span id="songs-dinner" style="font-weight: 600; color: var(--fg-pencil);">~25 brani (70-95 BPM)</span>
							<span>150 min</span>
						</div>
					</div>

					<!-- Festa Serale / Open Bar -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-dance" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🕺</span> Festa & Pista da Ballo
							</label>
							<span id="val-dance" class="font-heading" style="font-size: 1rem; color: #16a34a; font-weight: 700;">180 min (3.0h)</span>
						</div>
						<input type="range" id="slider-dance" min="60" max="360" step="15" value="180" style="width: 100%; accent-color: #16a34a;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>1 ora</span>
							<span id="songs-dance" style="font-weight: 600; color: var(--fg-pencil);">~52-60 brani (118-132 BPM)</span>
							<span>6 ore</span>
						</div>
					</div>

					<!-- Afterparty -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="slider-afterparty" class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.3rem;">
								<span>🌙</span> Notte Fonda / After
							</label>
							<span id="val-afterparty" class="font-heading" style="font-size: 1rem; color: #7c3aed; font-weight: 700;">0 min</span>
						</div>
						<input type="range" id="slider-afterparty" min="0" max="120" step="15" value="0" style="width: 100%; accent-color: #7c3aed;" />
						<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.3rem;">
							<span>0 min (Off)</span>
							<span id="songs-afterparty" style="font-weight: 600; color: var(--fg-pencil);">0 brani</span>
							<span>120 min</span>
						</div>
					</div>

				</div>

				<!-- Riepilogo Numerico -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; background: var(--muted-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; text-align: center;">
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Durata Totale Musica</span>
						<strong id="display-total-runtime" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil);">6h 00m (360 min)</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Brani Suonati Effettivi</span>
						<strong id="display-exact-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue);">~103 Brani</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Playlist Consigliata (+20% Margine)</span>
						<strong id="display-buffered-tracks" class="font-heading" style="font-size: 1.6rem; color: #16a34a;">~125 Brani</strong>
					</div>
					<div>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Brani per la Festa Ballabile</span>
						<strong id="display-dance-tracks" class="font-heading" style="font-size: 1.6rem; color: var(--accent-red);">~52 Brani</strong>
					</div>
				</div>

			</div>

			<!-- SEZIONE 2: Momenti Speciali & Indicazioni Audio -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							💃 2. Momenti Speciali & Indicazioni di Minutaggio
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Scegli tra le proposte classiche o personalizza con i minuti esatti di sfumatura e ingresso
						</span>
					</div>
					<button type="button" id="btn-autofill-special" class="hand-btn" style="padding: 0.3rem 0.7rem; font-size: 0.8rem; background: #eff6ff;">
						✨ Carica Proposte Classiche
					</button>
				</div>

				<div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" id="special-moments-container">
					<!-- Generato da JS -->
				</div>
			</div>

			<!-- SEZIONE 3: Lista Must-Play & Blacklist -->
			<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1fr 1fr; gap: 1.5rem;">
				
				<!-- Box Must-Play -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.25rem; color: #16a34a; margin: 0;">
								⭐ Brani Irrinunciabili (Must-Play)
							</h3>
							<span class="font-body" style="font-size: 0.8rem; color: var(--text-secondary);">
								Obiettivo: 10–20 brani (lascia spazio al DJ)
							</span>
						</div>
						<span id="must-play-counter" class="badge-postit" style="font-size: 0.85rem;">0 / 20 Brani</span>
					</div>

					<!-- Aggiunta Rapida -->
					<div style="margin-bottom: 1rem; background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<span class="font-heading" style="font-size: 0.8rem; color: var(--fg-pencil); display: block; margin-bottom: 0.3rem;">
							⚡ Grandi Successi di Pista:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;" id="quick-must-pills">
							<button type="button" class="btn-quick-add hand-btn" data-title="Italodisco" data-artist="The Kolors" data-phase="Festa" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Italodisco</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="September" data-artist="Earth, Wind & Fire" data-phase="Festa" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ September</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Sarà perché ti amo" data-artist="Ricchi e Poveri" data-phase="Festa" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Ricchi e Poveri</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="Dancing Queen" data-artist="ABBA" data-phase="Festa" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ ABBA</button>
							<button type="button" class="btn-quick-add hand-btn" data-title="A te" data-artist="Jovanotti" data-phase="Festa" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">+ Jovanotti</button>
						</div>
					</div>

					<!-- Form Aggiunta -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 0.9fr auto; gap: 0.4rem; margin-bottom: 1rem;">
						<input type="text" id="input-must-title" placeholder="Titolo (es. Levitating)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<input type="text" id="input-must-artist" placeholder="Artista (es. Dua Lipa)" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						<select id="select-must-phase" style="padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.8rem; background: #fff;">
							<option value="Festa & Pista da Ballo">Festa</option>
							<option value="Aperitivo">Aperitivo</option>
							<option value="Pranzo / Cena">Banchetto</option>
							<option value="Gran Finale Cantato">Finale</option>
						</select>
						<button type="button" id="btn-add-must" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.85rem; background: #16a34a; color: #fff;">+ Aggiungi</button>
					</div>

					<!-- Lista -->
					<div id="must-play-list" style="max-height: 280px; overflow-y: auto; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #faf8f5; padding: 0.5rem;">
						<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin: 1rem 0;">Nessun brano irrinunciabile inserito.</p>
					</div>
				</div>

				<!-- Box Blacklist -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.25rem; color: var(--accent-red); margin: 0;">
								🚫 Blacklist (Brani Vietati)
