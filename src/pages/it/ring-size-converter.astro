---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/ring-size-converter/#webapp",
      "name": "Convertitore Misure Anelli e Fedi Nuziali",
      "url": "https://manage.wedding/it/ring-size-converter",
      "inLanguage": "it",
      "description": "Converti all'istante le misure di fedi nuziali e anelli di fidanzamento: Misura Italiana (IT), Diametro e Circonferenza in mm, US, UK ed EU con misuratore 1:1 stampabile in PDF.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "A cosa corrisponde la misura italiana degli anelli?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La misura italiana dell'anello si basa sulla circonferenza interna in millimetri meno 40. Ad esempio, una circonferenza di 54 mm corrisponde a una Misura Italiana 14 (diametro interno 17,2 mm, corrispondente alla taglia US 7)."
          }
        },
        {
          "@type": "Question",
          "name": "Qual è la differenza tra una fede classica e una fede comoda?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La fede classica ha l'interno piatto, mentre la fede comoda (comfort fit) ha una bombatura interna arrotondata che scivola meglio sulle nocche e offre una calzata più confortevole durante la giornata."
          }
        },
        {
          "@type": "Question",
          "name": "Cosa fare se la misura del dito cade a metà tra due taglie?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In caso di dubbio tra due misure, i gioiellieri consigliano sempre di scegliere la misura superiore, poiché le dita tendono a gonfiarsi leggermente con il calore estivo o la sera."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Come misurare il dito per la fede nuziale a casa",
      "description": "Istruzioni per rilevare la circonferenza del dito in millimetri e trovare la misura di fede nuziale perfetta.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Avvolgere una striscia di carta o filo attorno al dito",
          "text": "Avvolgi una strisciolina di carta attorno alla base dell'anulare sinistro e controlla che passi agevolmente anche sulla nocca."
        },
        {
          "@type": "HowToStep",
          "name": "2. Segnare e misurare la lunghezza in millimetri",
          "text": "Fai un segno con la penna nel punto di sovrapposizione e misura la striscia distesa su un righello millimetrato."
        },
        {
          "@type": "HowToStep",
          "name": "3. Considerare la larghezza della fede",
          "text": "Per fedi larghe oltre i 5–6 mm, ordina mezza misura in più per evitare che stringano la pelle."
        },
        {
          "@type": "HowToStep",
          "name": "4. Stampare la scheda di calibrazione 1:1",
          "text": "Esporta il documento PDF in scala 100% per appoggiare un anello già esistente sul cerchio di confronto."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Convertitore Misure Anelli e Fedi Nuziali (IT, mm, US, UK, EU) | Manage.Wedding"
	description="Converti le misure delle fedi nuziali tra Misura Italiana (IT), diametro in mm, circonferenza, US, UK ed EU. Include calibro stampabile 1:1 in PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Convertitore Misure Fedi e Anelli" category="budget-finance" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Convertitore Misure <span class="accent-italic">Anelli & Fedi</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Converti istantaneamente tra <strong>Misura Italiana (IT), Diametro e Circonferenza in mm, US, UK ed EU</strong>. Con compensazione per fedi comode e <strong>calibro stampabile 1:1 in PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Come Trovare la Misura Perfetta in 3 Passaggi
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Scegli la Misura o i Millimetri
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Inserisci la misura italiana nota (es. 12, 14, 20) o misura la circonferenza del dito con una strisciolina di carta.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Imposta Larghezza Fede & Bombatura
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indica se stai scegliendo una fede classica sottile (3 mm) o una fascia larga/comoda (5–7 mm).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Scarica la Scheda per l'Orefice
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Stampa il calibro a cerchi concentrici per confrontare un anello già in tuo possesso in scala reale.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Converter Form + Live Results & Circle Sizer -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="ring-grid">
			
			<!-- Left Column: Sizing Controls & Width Adjustments -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💍 Configura la Misura dell'Anello
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Conversione tra standard italiano, internazionale e millimetri esatti
					</span>
				</div>

				<form id="ring-converter-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- 1. Known System & Size Picker -->
					<div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.6rem;">
						<div>
							<label for="select-system" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Standard di Misura *
							</label>
							<select id="select-system" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.92rem;">
								<option value="it" selected>🇮🇹 Misura Italiana (IT)</option>
								<option value="mm">📏 Circonferenza (mm)</option>
								<option value="dia">📐 Diametro Interno (mm)</option>
								<option value="us">🇺🇸 US / Canada</option>
								<option value="uk">🇬🇧 UK / Australia</option>
								<option value="eu">🇪🇺 Europa / Francia</option>
							</select>
						</div>

						<div>
							<label for="select-ring-val" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Seleziona Valore *
							</label>
							<select id="select-ring-val" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-heading); font-size: 1rem;">
								<!-- Populated via JS -->
							</select>
						</div>
					</div>

					<!-- 2. Band Width Setting (Crucial for Jeweler Accuracy) -->
					<div>
						<label for="select-band-width" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
							Larghezza Fascia / Fede Nuziale
						</label>
						<select id="select-band-width" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
							<option value="0" selected>Fede Classica Sottile (2mm – 3.5mm) — Misura Reale</option>
							<option value="0.5">Fascia Media (4mm – 5mm) — +0.5 Misura Consigliata</option>
							<option value="1.0">Fascia Larga (6mm – 8mm+) — +1 Misura Consigliata</option>
						</select>
					</div>

					<!-- 3. Comfort-Fit vs Standard-Fit Interior -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.88rem; color: var(--fg-pencil); display: block;">
							⚙️ Tipologia Profilo Interno Fede:
						</span>
						<div style="display: flex; gap: 1rem; flex-wrap: wrap;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="radio" name="interior-fit" value="standard" checked style="accent-color: var(--fg-pencil);">
								<span>Fede Classica (Interno Piatto)</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="radio" name="interior-fit" value="comfort" style="accent-color: var(--fg-pencil);">
								<span>Fede Comoda (Interno Bombato)</span>
							</label>
						</div>
					</div>

					<!-- Quick Sizing Advice Note -->
					<div id="band-advice-box" style="background: #eff6ff; border: 1px solid var(--accent-blue); border-radius: 4px; padding: 0.65rem; font-size: 0.82rem; color: #1e3a8a; line-height: 1.4;">
						💡 <strong>Regola dell'Orefice:</strong> Le fedi sottili (3 mm) rispecchiano la misura esatta. Se scegli una fede larga oltre i 5 mm, ordinare mezza misura in più evita fastidiosi restringimenti quando le dita sono calde.
					</div>

				</form>
			</div>

			<!-- Right Column: Live International Matrix & Visual Scale Circle -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main International Matrix Result Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🌐 Tabella Misure Internazionali
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Equivalenze per gioiellerie italiane ed estere
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Esporta Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Stampa PDF 1:1
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- 4-System Big Highlight Grid -->
					<div style="display: grid; grid-template-columns: repeat(2, 1fr); sm:grid-template-columns: repeat(4, 1fr); gap: 0.6rem; text-align: center; margin-bottom: 1.25rem;">
						<div style="background: #fdf2f8; border: 1.5px solid var(--accent-red); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold; text-transform: uppercase;">Italia (IT)</span>
							<strong id="res-it" class="font-heading" style="font-size: 1.9rem; color: var(--accent-red); display: block; line-height: 1.2;">14</strong>
						</div>

						<div style="background: #eff6ff; border: 1.5px solid var(--accent-blue); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--accent-blue); font-weight: bold; text-transform: uppercase;">Europa (EU)</span>
							<strong id="res-eu" class="font-heading" style="font-size: 1.9rem; color: var(--accent-blue); display: block; line-height: 1.2;">54</strong>
						</div>

						<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: #16a34a; font-weight: bold; text-transform: uppercase;">US / Canada</span>
							<strong id="res-us" class="font-heading" style="font-size: 1.9rem; color: #16a34a; display: block; line-height: 1.2;">7</strong>
						</div>

						<div style="background: #fafaf9; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem;">
							<span style="font-size: 0.75rem; color: var(--fg-pencil); font-weight: bold; text-transform: uppercase;">UK / Australia</span>
							<strong id="res-uk" class="font-heading" style="font-size: 1.9rem; color: var(--fg-pencil); display: block; line-height: 1.2;">N 1/2</strong>
						</div>
					</div>

					<!-- Exact Millimeter Dimensions -->
					<div style="display: flex; justify-content: space-around; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem; font-size: 0.85rem; margin-bottom: 1.25rem;">
						<span>📏 Diametro Interno: <strong id="res-dia">17.2 mm</strong></span>
						<span>📐 Circonferenza: <strong id="res-circ">54.0 mm</strong></span>
					</div>

					<!-- Visual Scaled Ring Sizer Frame -->
					<div style="text-align: center; border-top: 1.5px dashed #ccc; padding-top: 1rem;">
						<span class="font-heading" style="font-size: 0.92rem; color: var(--fg-pencil); display: block; margin-bottom: 0.5rem;">
							🔍 Diametro Visivo Indicativo:
						</span>
						<div style="display: flex; justify-content: center; align-items: center; min-height: 130px;">
							<div id="visual-ring-circle" style="width: 104px; height: 104px; border: 5px solid var(--accent-red); border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; box-shadow: 0 0 10px rgba(0,0,0,0.05); background: #fff;">
								<span id="visual-ring-text" style="font-family: monospace; font-size: 0.82rem; font-weight: bold; color: var(--fg-pencil);">
									Ø 17.2 mm
								</span>
							</div>
						</div>
						<p style="font-size: 0.75rem; color: var(--text-secondary); margin: 0.4rem 0 0 0;">
							*Scala a schermo indicativa. Usa la stampa PDF per la calibrazione fisica 1:1 reale.
						</p>
					</div>

				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation (1:1 Scale Sizer) -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 4px 0;">Scheda Misura Anello & Calibro Fedi Nuziali</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Data: <span id="print-date"></span> | Misura Italiana: <span id="print-it-size"></span></p>
			</div>

			<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
				<h3 style="margin:0 0 10px 0;">Specifiche Tecniche Anello:</h3>
				<table style="width: 100%; border-collapse: collapse; font-size: 14px;">
					<tr><td><strong>Misura Italiana (IT):</strong></td><td id="p-it">14</td><td><strong>Europa (EU):</strong></td><td id="p-eu">54</td></tr>
					<tr><td><strong>US / Canada:</strong></td><td id="p-us">7</td><td><strong>UK / Australia:</strong></td><td id="p-uk">N 1/2</td></tr>
					<tr><td><strong>Diametro Interno:</strong></td><td id="p-dia">17.2 mm</td><td><strong>Circonferenza:</strong></td><td id="p-circ">54.0 mm</td></tr>
				</table>
			</div>
		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guida Completa alla Scelta delle Fedi Nuziali
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Fede classica vs comoda, metalli preziosi e come prendere la misura dell'anello in segreto.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Fede Classica vs Fede Comoda
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					La fede classica tradizionale presenta una sezione piatta all'interno e leggermente bombata all'esterno. La fede comoda (detta anche comfort fit) è invece bombata e smussata anche all'interno, risultando ideale per chi non è abituato a portare anelli quotidianamente.
				</p>
			</section>

			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Domande Frequenti (FAQ)
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">È possibile allargare o stringere una fede nuziale in seguito?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Le fedi lisce in oro giallo, bianco o rosa possono essere modificate di 1–2 misure da qualsiasi orafo. Al contrario, le verette con diamanti a giro completo (eternity) non possono essere ridimensionate.
					</p>
				</details>
			</section>
		</article>

		<RelatedTools currentPath="/it/ring-size-converter" category="budget" />

	</main>
</Layout>

<style>
	.print-only {
		display: none;
	}

	@media print {
		body * {
			visibility: hidden;
		}
		.print-only, .print-only * {
			visibility: visible;
		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 20px;
		}
	}
</style>

<script is:inline>
	const ringDatabase = [
		{ it: 6,  eu: 46, us: 3.5, uk: "G",     mm: 46.0, dia: 14.6 },
		{ it: 8,  eu: 48, us: 4.5, uk: "I 1/2", mm: 48.0, dia: 15.3 },
		{ it: 10, eu: 50, us: 5.2, uk: "K",     mm: 50.0, dia: 15.9 },
		{ it: 12, eu: 52, us: 6.0, uk: "M",     mm: 52.0, dia: 16.5 },
		{ it: 14, eu: 54, us: 7.0, uk: "O",     mm: 54.0, dia: 17.2 },
		{ it: 16, eu: 56, us: 7.8, uk: "P 1/2", mm: 56.0, dia: 17.8 },
		{ it: 18, eu: 58, us: 8.5, uk: "R",     mm: 58.0, dia: 18.5 },
		{ it: 20, eu: 60, us: 9.2, uk: "S 1/2", mm: 60.0, dia: 19.1 },
		{ it: 22, eu: 62, us: 10.0, uk: "T 1/2", mm: 62.0, dia: 19.7 },
		{ it: 24, eu: 64, us: 10.8, uk: "V",     mm: 64.0, dia: 20.4 },
		{ it: 26, eu: 66, us: 11.5, uk: "W 1/2", mm: 66.0, dia: 21.0 },
		{ it: 28, eu: 68, us: 12.5, uk: "Z",     mm: 68.0, dia: 21.6 },
		{ it: 30, eu: 70, us: 13.2, uk: "Z+2",   mm: 70.0, dia: 22.3 }
	];

	const selectSystem = document.getElementById('select-system');
	const selectRingVal = document.getElementById('select-ring-val');
	const selectBandWidth = document.getElementById('select-band-width');

	const resIt = document.getElementById('res-it');
	const resEu = document.getElementById('res-eu');
	const resUs = document.getElementById('res-us');
	const resUk = document.getElementById('res-uk');
	const resDia = document.getElementById('res-dia');
	const resCirc = document.getElementById('res-circ');

	const visualRingCircle = document.getElementById('visual-ring-circle');
	const visualRingText = document.getElementById('visual-ring-text');
	const bandAdviceBox = document.getElementById('band-advice-box');

	function populateOptions() {
		const sys = selectSystem.value;
		selectRingVal.innerHTML = '';

		ringDatabase.forEach((row, idx) => {
			const opt = document.createElement('option');
			opt.value = idx.toString();

			if (sys === 'it') opt.textContent = `Misura Italiana ${row.it}`;
			else if (sys === 'mm') opt.textContent = `${row.mm} mm (Circonferenza)`;
			else if (sys === 'dia') opt.textContent = `Ø ${row.dia} mm (Diametro)`;
			else if (sys === 'eu') opt.textContent = `Misura EU ${row.eu}`;
			else if (sys === 'us') opt.textContent = `US Size ${row.us}`;
			else if (sys === 'uk') opt.textContent = `UK Size ${row.uk}`;

			selectRingVal.appendChild(opt);
		});

		// Default to IT 14 (index 4)
		selectRingVal.value = "4";
		updateConversion();
	}

	function updateConversion() {
		const idx = parseInt(selectRingVal.value, 10) || 4;
		const baseData = ringDatabase[idx] || ringDatabase[4];
		const offset = parseFloat(selectBandWidth.value) || 0;

		let effectiveIdx = idx;
		if (offset > 0) {
			const targetIt = baseData.it + (offset * 2);
			const found = ringDatabase.findIndex(r => r.it >= targetIt);
			if (found !== -1) effectiveIdx = found;
		}

		const data = ringDatabase[effectiveIdx] || baseData;

		resIt.textContent = data.it.toString();
		resEu.textContent = data.eu.toString();
		resUs.textContent = data.us.toString();
		resUk.textContent = data.uk;
		resDia.textContent = `${data.dia} mm`;
		resCirc.textContent = `${data.mm} mm`;

		const pxSize = Math.round(data.dia * 6);
		visualRingCircle.style.width = `${pxSize}px`;
		visualRingCircle.style.height = `${pxSize}px`;
		visualRingText.textContent = `Ø ${data.dia} mm`;

		if (offset > 0) {
			bandAdviceBox.innerHTML = `💡 <strong>Compensazione Fascia Larga:</strong> Misura aumentata per garantire comfort. Ordinando la <strong>Misura IT ${data.it}</strong> calzerà come la tua abituale misura ${baseData.it}!`;
		} else {
			bandAdviceBox.innerHTML = `💡 <strong>Calzata Standard:</strong> Ideale per fedi nuziali classiche da 2 a 3.5 mm e anelli di fidanzamento solitario.`;
		}
	}

	selectSystem.addEventListener('change', populateOptions);
	selectRingVal.addEventListener('change', updateConversion);
	selectBandWidth.addEventListener('change', updateConversion);
	document.querySelectorAll('input[name="interior-fit"]').forEach(r => r.addEventListener('change', updateConversion));

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Scheda Misure Fede Nuziale</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					table { width: 100%; border-collapse: collapse; margin-top: 15px; }
					th, td { border: 1px solid #ccc; padding: 8px; text-align: left; font-size: 13px; }
					th { background: #f2f2f2; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Scheda Misura Fede Nuziale</h1>
				<p>Data: ${new Date().toLocaleDateString('it-IT')}</p>
				<table>
					<tr><th>Standard Gioielleria</th><th>Misura Rilevata</th></tr>
					<tr><td>Misura Italiana (IT)</td><td><strong>${resIt.textContent}</strong></td></tr>
					<tr><td>Misura Europa (EU)</td><td><strong>${resEu.textContent}</strong></td></tr>
					<tr><td>US / Canada</td><td><strong>US ${resUs.textContent}</strong></td></tr>
					<tr><td>UK / Australia</td><td><strong>UK ${resUk.textContent}</strong></td></tr>
					<tr><td>Diametro Interno</td><td>${resDia.textContent}</td></tr>
					<tr><td>Circonferenza Interna</td><td>${resCirc.textContent}</td></tr>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Misura_Fede_Nuziale_IT_${resIt.textContent}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / 1:1 Sizer
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('it-IT');
		document.getElementById('print-it-size').textContent = `IT ${resIt.textContent}`;
		
		document.getElementById('p-it').textContent = resIt.textContent;
		document.getElementById('p-eu').textContent = resEu.textContent;
		document.getElementById('p-us').textContent = resUs.textContent;
		document.getElementById('p-uk').textContent = resUk.textContent;
		document.getElementById('p-dia').textContent = resDia.textContent;
		document.getElementById('p-circ').textContent = resCirc.textContent;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Misura IT,Misura EU,Misura US,Misura UK,Diametro mm,Circonferenza mm\n";
		ringDatabase.forEach(r => {
			csv += `"${r.it}","${r.eu}","${r.us}","${r.uk}","${r.dia}","${r.mm}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Tabella_Misure_Anelli_IT.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	populateOptions();
</script>
