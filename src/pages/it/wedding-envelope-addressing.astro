---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-envelope-addressing/#webapp",
      "name": "Galateo Intestazione Buste Matrimonio & Formattatore Indirizzi",
      "url": "https://manage.wedding/it/wedding-envelope-addressing",
      "inLanguage": "it",
      "description": "Strumento per intestare le buste delle partecipazioni di nozze secondo il galateo italiano. Genera formule corrette per famiglie, coppie, titoli professionali e stampa in PDF e Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come intestare le buste delle partecipazioni secondo il galateo italiano",
      "description": "Guida alle formule di cortesia per scrivere i destinatari sulle buste nuziali.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Scegliere la formula di cortesia corretta",
          "text": "Usa 'Gent.mi' o 'Gentilissimi' per le coppie e le famiglie, oppure 'Carissimi' per amici e parenti molto stretti."
        },
        {
          "@type": "HowToStep",
          "name": "2. Indicare i nomi dei destinatari",
          "text": "Per una famiglia scrivi 'Gent.ma Famiglia Rossi' oppure 'Gent.mi Mario, Laura e figli'. Per le coppie non sposate indica entrambi i cognomi."
        },
        {
          "@type": "HowToStep",
          "name": "3. Scrivere l'indirizzo postale completo",
          "text": "Indica via/piazza per esteso, numero civico, CAP, comune e sigla della provincia tra parentesi."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Come si intesta la busta per una famiglia con figli?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il galateo consiglia 'Gent.ma Famiglia Rossi' se sono invitati tutti i membri conviventi, oppure 'Gentilissimi Mario, Laura e figli'. Se i figli sono adulti e non convivono più con i genitori, va inviata una partecipazione separata."
          }
        },
        {
          "@type": "Question",
          "name": "Come si scrive sulla busta per una persona single con accompagnatore?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se non si conosce ancora il nome dell'accompagnatore, si scrive 'Gent.mo Marco Rossi e gentile compagna/ospite'. Se il nome è noto, è sempre preferibile scrivere entrambi i nomi per esteso."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Galateo Intestazione Buste Matrimonio & Scrittura Indirizzi | Manage.Wedding"
	description="Guida ed etichettatore interattivo per intestare le buste delle partecipazioni di nozze secondo il galateo italiano (Gent.mi, Famiglia, Dottore, coppie non sposate, single con accompagnatore)."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Intestazione Buste & Galateo" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Galateo Nozze & Anteprima Buste</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Intestazione Buste <span class="accent-italic">& Galateo Nozze</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 700px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Formule di cortesia corrette per coppie sposate, famiglie, titoli professionali e accompagnatori. Anteprima grafica calligrafica e stampa in PDF o Word.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Controls & Formatter Input -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Formato Busta & Destinatario
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Formule Galateo
					</span>
				</div>

				<!-- Envelope Size Selector -->
				<div class="form-group">
					<label class="form-label" for="env-size">Formato Busta</label>
					<select id="env-size" class="form-input" style="cursor: pointer;">
						<option value="13x19" selected>Busta 13×19 cm (Formato Classico Italiano con patella a punta)</option>
						<option value="c5">Busta C5 162×229 mm (Per partecipazioni A5)</option>
						<option value="dl">Busta DL 110×220 mm (Rettangolare allungata)</option>
						<option value="square">Busta Quadrata 16×16 cm</option>
					</select>
				</div>

				<!-- Etiquette Preset Quick-Pick -->
				<div class="form-group">
					<label class="form-label" for="etiquette-preset">
						Formula di Cortesia Predefinita
					</label>
					<select id="etiquette-preset" class="form-input" style="background: #f8fafc; font-weight: 600; cursor: pointer;">
						<option value="married-classic" selected>👫 Coppia Sposata Classica — Gent.mi Mario e Laura Rossi</option>
						<option value="family">👨‍👩‍👧‍👦 Famiglia con Figli — Gent.ma Famiglia Rossi</option>
						<option value="cohabitation">💑 Coppia Convivente / Fidanzati — Gent.mi Mario Rossi e Laura Bianchi</option>
						<option value="doctor">🩺 Titolo Medico — Gent.mo Dott. Mario Rossi</option>
						<option value="lawyer">⚖️ Titolo Avvocato — Gent.ma Avv. Laura Bianchi</option>
						<option value="single-guest">👤 Persona Singola con Accompagnatore — Gent.mo Marco Rossi e gentile compagna</option>
						<option value="intimate">❤️ Parenti Stretti / Amici Intimi — Carissimi Zio Mario e Zia Laura</option>
						<option value="custom">✏️ Testo Personalizzato</option>
					</select>
				</div>

				<!-- Recipient Name Line 1 -->
				<div class="form-group">
					<label class="form-label" for="rec-name-1">Intestazione Destinatario — Riga 1</label>
					<input type="text" id="rec-name-1" class="form-input" value="Gent.mi Mario e Laura Rossi" placeholder="es. Gent.mi Mario e Laura Rossi" />
				</div>

				<!-- Recipient Name Line 2 (Optional) -->
				<div class="form-group" id="rec-name-2-group" style="display: none;">
					<label class="form-label" for="rec-name-2">Destinatario — Riga 2 (Opzionale)</label>
					<input type="text" id="rec-name-2" class="form-input" value="" placeholder="es. e gentile compagna" />
				</div>

				<!-- Street Address -->
				<div class="form-group">
					<label class="form-label" for="rec-street">Indirizzo (Via / Piazza e Numero Civico)</label>
					<input type="text" id="rec-street" class="form-input" value="Via dei Cipressi, 14" placeholder="es. Corso Vittorio Emanuele II, 45" />
				</div>

				<!-- City, State & Zip -->
				<div style="display: grid; grid-template-columns: 2fr 1fr 1fr;" class="form-group">
					<div>
						<label class="form-label" for="rec-city">Città</label>
						<input type="text" id="rec-city" class="form-input" value="Firenze" placeholder="Città" />
					</div>
					<div>
						<label class="form-label" for="rec-state">Provincia</label>
						<input type="text" id="rec-state" class="form-input" value="FI" placeholder="FI" />
					</div>
					<div>
						<label class="form-label" for="rec-zip">CAP</label>
						<input type="text" id="rec-zip" class="form-input" value="50121" placeholder="50121" />
					</div>
				</div>

				<!-- Return Address Toggle & Inputs -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.75rem;">
						<input type="checkbox" id="toggle-return-addr" checked style="width: 18px; height: 18px;" />
						<span>Includi Mittente (Sposi)</span>
					</label>

					<div id="return-addr-fields">
						<div class="form-group">
							<label class="form-label" for="ret-names" style="font-size: 0.95rem;">Nomi degli Sposi</label>
							<input type="text" id="ret-names" class="form-input" value="Chiara & Alessandro" style="font-size: 0.95rem; padding: 0.6rem 0.75rem;" />
						</div>
						<div class="form-group">
							<label class="form-label" for="ret-street" style="font-size: 0.95rem;">Indirizzo Mittente</label>
							<input type="text" id="ret-street" class="form-input" value="Via Garibaldi 28, 50123 Firenze (FI)" style="font-size: 0.95rem; padding: 0.6rem 0.75rem;" />
						</div>
					</div>
				</div>

				<!-- Style Customization -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label class="form-label">Stile Grafico Calligrafico</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="font-style-btn hand-btn is-active" data-font="script" style="padding: 8px; font-size: 0.9rem; font-family: 'Kalam', cursive;">
							✒️ Corsivo Calligrafico
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="serif" style="padding: 8px; font-size: 0.9rem; font-family: Georgia, serif;">
							🏛️ Classico con Grazie
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="sans" style="padding: 8px; font-size: 0.9rem; font-family: var(--font-body);">
							✨ Moderno Lineare
						</button>
						<button type="button" class="font-style-btn hand-btn" data-font="hand" style="padding: 8px; font-size: 0.9rem; font-family: 'Caveat', cursive;">
							✏️ Manoscritto Artistico
						</button>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Envelope Visual Canvas & Batch Export -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Canvas Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Anteprima Live Busta
						</h3>
						<span id="env-size-tag" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							13×19 cm
						</span>
					</div>

					<!-- Envelope Box -->
					<div id="envelope-canvas" style="width: 100%; aspect-ratio: 1.9 / 1.3; background: #fffcf5; border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 6px 6px 0px var(--fg-pencil); position: relative; padding: clamp(1rem, 3vw, 2rem); display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; transition: all 0.2s ease;">
						
						<!-- Return Address Top-Left -->
						<div id="canvas-return-addr" style="position: absolute; top: clamp(0.75rem, 2vw, 1.25rem); left: clamp(0.75rem, 2vw, 1.25rem); font-size: clamp(0.68rem, 1.2vw, 0.82rem); line-height: 1.35; color: var(--fg-pencil); max-width: 45%;">
							<strong id="canvas-ret-name" style="display: block;">Chiara & Alessandro</strong>
							<span id="canvas-ret-full">Via Garibaldi 28<br/>50123 Firenze (FI)</span>
						</div>

						<!-- Stamp Box -->
						<div style="position: absolute; top: clamp(0.75rem, 2vw, 1.25rem); right: clamp(0.75rem, 2vw, 1.25rem); width: clamp(40px, 7vw, 55px); height: clamp(50px, 8.5vw, 68px); border: 1.5px dashed #94a3b8; border-radius: 3px; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; color: #94a3b8; text-align: center; text-transform: uppercase; font-weight: 700; padding: 2px;">
							Poste Italiane
						</div>

						<!-- Recipient Address (Centered) -->
						<div id="canvas-recipient-block" style="text-align: center; margin-top: clamp(1rem, 2.5vw, 2rem);">
							<div id="canvas-rec-name-1" style="font-size: clamp(1.2rem, 2.5vw, 1.85rem); font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem; line-height: 1.25;">
								Gent.mi Mario e Laura Rossi
							</div>
							<div id="canvas-rec-name-2" style="font-size: clamp(1.1rem, 2.2vw, 1.65rem); font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem; display: none; line-height: 1.25;"></div>
							<div id="canvas-rec-street" style="font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: #334155; margin-bottom: 0.2rem; line-height: 1.4;">
								Via dei Cipressi, 14
							</div>
							<div id="canvas-rec-city-state-zip" style="font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: #334155; line-height: 1.4;">
								50121 Firenze (FI)
							</div>
						</div>

					</div>

					<!-- Export Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-envelope" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Stampa Busta (PDF)
						</button>
						<button id="btn-export-word" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Esporta Documento Word
						</button>
					</div>

				</div>

				<!-- Batch Guest List Address Importer -->
				<div class="hand-card" style="padding: 1.75rem; background: var(--bg-paper);">
					<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
						Importazione Multipla Indirizzi (Incolla / CSV)
					</h3>
					<p style="font-size: 0.92rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
						Incolla gli indirizzi degli invitati (uno per riga: <em>Nome, Indirizzo, Città, Provincia, CAP</em>) per formattare tutte le buste contemporaneamente.
					</p>

					<textarea id="batch-paste-input" rows="4" class="hand-input" style="font-size: 0.88rem; line-height: 1.4; margin-bottom: 0.75rem;" placeholder="Gent.ma Famiglia Rossi, Via Roma 10, Milano, MI, 20121&#10;Gent.mo Dott. Marco Bianchi, Corso Italia 5, Roma, RM, 00185&#10;Gent.mi Davide Ferri e gentile compagna, Via Dante 8, Torino, TO, 10121"></textarea>

					<div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
						<button id="btn-load-batch" class="hand-btn" style="padding: 8px 16px; font-size: 0.9rem;">
							Carica Indirizzi
						</button>
						<span id="batch-count-tag" style="font-size: 0.85rem; font-weight: 700; color: #64748b;">1 Indirizzo Caricato</span>
					</div>
				</div>

			</div>

		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Il Galateo delle Buste di Matrimonio: Regole & Formule
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Come scrivere a mano o stampare gli indirizzi senza errori di bon ton.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Le Formule di Cortesia Tradizionali
				</h3>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Gent.mo / Gent.ma:</strong> Abbreviazione di Gentilissimo/a, si usa per invitati singoli.</li>
					<li><strong>Gent.mi:</strong> Per coppie sposate, fidanzati o conviventi.</li>
					<li><strong>Famiglia:</strong> 'Gent.ma Famiglia Rossi' include automaticamente genitori e figli conviventi.</li>
					<li><strong>Carissimi:</strong> Riservato a parenti intimi (zii, nonni) o amici fraterni.</li>
				</ul>
			</section>
		</article>

		<RelatedTools currentPath="/it/wedding-envelope-addressing" category="stationery" />
	</main>
</Layout>

<script is:inline>
	const envSizeSelect = document.getElementById('env-size');
	const presetSelect = document.getElementById('etiquette-preset');
	const recName1 = document.getElementById('rec-name-1');
	const recName2 = document.getElementById('rec-name-2');
	const recName2Group = document.getElementById('rec-name-2-group');
	const recStreet = document.getElementById('rec-street');
	const recCity = document.getElementById('rec-city');
	const recState = document.getElementById('rec-state');
	const recZip = document.getElementById('rec-zip');

	const toggleReturnAddr = document.getElementById('toggle-return-addr');
	const retNames = document.getElementById('ret-names');
	const retStreet = document.getElementById('ret-street');

	const envelopeCanvas = document.getElementById('envelope-canvas');
	const canvasSizeTag = document.getElementById('env-size-tag');
	const canvasRetAddr = document.getElementById('canvas-return-addr');
	const canvasRetName = document.getElementById('canvas-ret-name');
	const canvasRetFull = document.getElementById('canvas-ret-full');
	const canvasRecName1 = document.getElementById('canvas-rec-name-1');
	const canvasRecName2 = document.getElementById('canvas-rec-name-2');
	const canvasRecStreet = document.getElementById('canvas-rec-street');
	const canvasRecCityStateZip = document.getElementById('canvas-rec-city-state-zip');

	const fontButtons = document.querySelectorAll('.font-style-btn');
	const batchInput = document.getElementById('batch-paste-input');
	const btnLoadBatch = document.getElementById('btn-load-batch');
	const batchCountTag = document.getElementById('batch-count-tag');
	const btnPrint = document.getElementById('btn-print-envelope');
	const btnWord = document.getElementById('btn-export-word');

	function updateCanvas() {
		canvasRecName1.textContent = recName1.value || 'Nome Destinatario';
		
		if (recName2.value.trim().length > 0) {
			canvasRecName2.style.display = 'block';
			canvasRecName2.textContent = recName2.value.trim();
		} else {
			canvasRecName2.style.display = 'none';
		}

		canvasRecStreet.textContent = recStreet.value || 'Via Roma, 10';
		canvasRecCityStateZip.textContent = `${recZip.value || '50121'} ${recCity.value || 'Firenze'} (${recState.value || 'FI'})`;

		if (toggleReturnAddr.checked) {
			canvasRetAddr.style.display = 'block';
			canvasRetName.textContent = retNames.value || '';
			canvasRetFull.textContent = retStreet.value || '';
		} else {
			canvasRetAddr.style.display = 'none';
		}

		const size = envSizeSelect.value;
		if (size === '13x19') {
			envelopeCanvas.style.aspectRatio = '1.9 / 1.3';
			canvasSizeTag.textContent = '13×19 cm';
		} else if (size === 'c5') {
			envelopeCanvas.style.aspectRatio = '2.29 / 1.62';
			canvasSizeTag.textContent = 'Busta C5 (162×229 mm)';
		} else if (size === 'dl') {
			envelopeCanvas.style.aspectRatio = '2.2 / 1.1';
			canvasSizeTag.textContent = 'Busta DL (110×220 mm)';
		} else if (size === 'square') {
			envelopeCanvas.style.aspectRatio = '1 / 1';
			canvasSizeTag.textContent = 'Busta Quadrata 16×16 cm';
		}
	}

	presetSelect.addEventListener('change', () => {
		const val = presetSelect.value;
		recName2Group.style.display = 'none';
		recName2.value = '';

		if (val === 'married-classic') {
			recName1.value = 'Gent.mi Mario e Laura Rossi';
		} else if (val === 'family') {
			recName1.value = 'Gent.ma Famiglia Rossi';
		} else if (val === 'cohabitation') {
			recName1.value = 'Gent.mo Mario Rossi';
			recName2Group.style.display = 'block';
			recName2.value = 'Gent.ma Laura Bianchi';
		} else if (val === 'doctor') {
			recName1.value = 'Gent.mo Dott. Mario Rossi';
		} else if (val === 'lawyer') {
			recName1.value = 'Gent.ma Avv. Laura Bianchi';
		} else if (val === 'single-guest') {
			recName1.value = 'Gent.mo Marco Rossi e gentile compagna';
		} else if (val === 'intimate') {
			recName1.value = 'Carissimi Zio Mario e Zia Laura';
		}
		updateCanvas();
	});

	fontButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			fontButtons.forEach(b => b.classList.remove('is-active'));
			btn.classList.add('is-active');
			const font = btn.getAttribute('data-font');
			if (font === 'script') {
				canvasRecName1.style.fontFamily = "'Kalam', cursive";
				canvasRecName2.style.fontFamily = "'Kalam', cursive";
			} else if (font === 'serif') {
				canvasRecName1.style.fontFamily = 'Georgia, serif';
				canvasRecName2.style.fontFamily = 'Georgia, serif';
			} else if (font === 'sans') {
				canvasRecName1.style.fontFamily = 'var(--font-body)';
				canvasRecName2.style.fontFamily = 'var(--font-body)';
			} else if (font === 'hand') {
				canvasRecName1.style.fontFamily = "'Caveat', cursive";
				canvasRecName2.style.fontFamily = "'Caveat', cursive";
			}
		});
	});

	[envSizeSelect, recName1, recName2, recStreet, recCity, recState, recZip, toggleReturnAddr, retNames, retStreet].forEach(el => {
		el.addEventListener('input', updateCanvas);
		el.addEventListener('change', updateCanvas);
	});

	btnLoadBatch.addEventListener('click', () => {
		const text = batchInput.value.trim();
		if (!text) return;
		const lines = text.split('\n').filter(l => l.trim().length > 0);
		batchCountTag.textContent = `${lines.length} Indirizzi Caricati`;
		if (lines.length > 0) {
			const parts = lines[0].split(',').map(s => s.trim());
			if (parts[0]) recName1.value = parts[0];
			if (parts[1]) recStreet.value = parts[1];
			if (parts[2]) recCity.value = parts[2];
			if (parts[3]) recState.value = parts[3];
			if (parts[4]) recZip.value = parts[4];
			updateCanvas();
		}
	});

	btnPrint.addEventListener('click', () => window.print());

	btnWord.addEventListener('click', () => {
		const text = batchInput.value.trim();
		let rowsHtml = '';
		if (text) {
			const lines = text.split('\n').filter(l => l.trim().length > 0);
			lines.forEach(l => {
				const parts = l.split(',').map(s => s.trim());
				rowsHtml += `
					<div style="margin-bottom: 30px; padding: 20px; border: 1px solid #999; page-break-inside: avoid;">
						<p style="font-size: 11px; margin: 0 0 15px 0;">${retNames.value} — ${retStreet.value}</p>
						<h2 style="text-align: center; margin: 20px 0 5px 0;">${parts[0] || ''}</h2>
						<p style="text-align: center; margin: 0; font-size: 14px;">${parts[1] || ''}</p>
						<p style="text-align: center; margin: 0; font-size: 14px;">${parts[4] || ''} ${parts[2] || ''} (${parts[3] || ''})</p>
					</div>
				`;
			});
		} else {
			rowsHtml = `
				<div style="margin-bottom: 30px; padding: 20px; border: 1px solid #999;">
					<p style="font-size: 11px; margin: 0 0 15px 0;">${retNames.value} — ${retStreet.value}</p>
					<h2 style="text-align: center; margin: 20px 0 5px 0;">${recName1.value}</h2>
					<p style="text-align: center; margin: 0; font-size: 14px;">${recStreet.value}</p>
					<p style="text-align: center; margin: 0; font-size: 14px;">${recZip.value} ${recCity.value} (${recState.value})</p>
				</div>
			`;
		}

		const content = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset="utf-8"><title>Intestazione Buste Matrimonio</title></head>
			<body style="font-family: Arial, sans-serif; padding: 20px;">
				<h1>Manage.Wedding — Elenco Buste Partecipazioni</h1>
				${rowsHtml}
			</body></html>
		`;
		const blob = new Blob(['\ufeff', content], { type: 'application/msword' });
		const link = document.createElement('a');
		link.href = URL.createObjectURL(blob);
		link.download = 'intestazioni-buste-nozze.doc';
		link.click();
	});

	updateCanvas();
</script>
