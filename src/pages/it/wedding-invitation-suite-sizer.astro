---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-invitation-suite-sizer/#webapp",
      "name": "Guida Dimensioni Partecipazioni Matrimonio & Formati Buste",
      "url": "https://manage.wedding/it/wedding-invitation-suite-sizer",
      "inLanguage": "it",
      "description": "Calcola le dimensioni millimetriche per partecipazioni di nozze, cartoncini d'invito al ricevimento, buste C5, C6, DL, margini di rifilatura e abbondanze a 300 DPI.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come calcolare le dimensioni della partecipazione e della busta",
      "description": "Regole per abbinare le buste con patella a punta, i cartoncini invito ristorante e i margini di taglio tipografici.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Scegliere il formato della partecipazione principale",
          "text": "I formati classici italiani sono A5 (148×210 mm), 120×180 mm o DL allungato (100×210 mm)."
        },
        {
          "@type": "HowToStep",
          "name": "2. Calcolare la tolleranza di inserimento nella busta",
          "text": "La busta deve essere più grande di almeno 5–10 mm per lato rispetto al cartoncino (es. cartoncino A5 va in busta C5 162×229 mm)."
        },
        {
          "@type": "HowToStep",
          "name": "3. Aggiungere 3 mm di abbondanza di stampa (Bleed)",
          "text": "Imposta su Canva o Photoshop un margine di abbondanza di 3 mm per lato per evitare bordi bianchi dopo il taglio con taglierina."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual è la misura standard per le partecipazioni di nozze in Italia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In Italia i formati più tradizionali ed eleganti sono il 12×18 cm (con busta 13×19 cm con patella a punta gommata o a ceralacca), l'A5 (14,8×21 cm con busta C5) e il formato DL (10×21 cm)."
          }
        },
        {
          "@type": "Question",
          "name": "Che grammatura deve avere la carta delle partecipazioni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La partecipazione principale richiede un cartoncino da 280 a 350 g/m² (es. carta cotone, carta Amalfi o martellata). Le buste hanno generalmente una grammatura di 120–140 g/m²."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Guida Dimensioni Partecipazioni Matrimonio & Formati Buste | Manage.Wedding"
	description="Calcola le dimensioni esatte in millimetri (mm) per partecipazioni di nozze, cartoncini d'invito al ristorante, buste C5, C6, DL, margini di rifilatura e abbondanze di stampa a 300 DPI."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Dimensioni Partecipazioni & Buste" category="stationery" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Specifiche Stampa & Taglio a 300 DPI</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Dimensioni Partecipazioni <span class="accent-italic">& Formati Buste</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcola al millimetro le misure di partecipazioni, cartoncini invito ristorante, talloncini lista nozze, buste con patella a punta e abbondanze tipografiche.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Suite Format Selector & Units -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Formato & Unità di Misura
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Standard Grafici
					</span>
				</div>

				<!-- Suite Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="suite-format-preset">Formato Suite Partecipazione</label>
					<select id="suite-format-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="classic-12x18" selected>💌 Classico Italiano 12×18 cm (Invito 120×180 mm / Busta 130×190 mm con patella a punta)</option>
						<option value="a5-c5">🏛️ Standard Europeo A5 / C5 (Partecipazione 148×210 mm / Busta C5 162×229 mm)</option>
						<option value="dl-format">🥂 Formato DL Allungato (Partecipazione 100×210 mm / Busta DL 110×220 mm)</option>
						<option value="square-15">🔲 Quadrato Moderno 15×15 cm (Invito 145×145 mm / Busta 160×160 mm)</option>
						<option value="a6-pocket">📜 Pocket / Tascabile A6 (Invito 105×148 mm / Busta C6 114×162 mm)</option>
					</select>
				</div>

				<!-- Measurement Unit Selector -->
				<div class="form-group">
					<label class="form-label" for="unit-selector">Unità di Misura Visualizzata</label>
					<select id="unit-selector" class="form-input" style="cursor: pointer; font-weight: 600;">
						<option value="mm" selected>Millimetri (es. 120 × 180 mm)</option>
						<option value="cm">Centimetri (es. 12,0 × 18,0 cm)</option>
						<option value="px">Pixel @ 300 DPI per Canva / Photoshop (es. 1417 × 2126 px)</option>
					</select>
				</div>

				<!-- Additional Components (Checkboxes) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Elementi Inclusi nella Suite
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-details" checked style="width: 18px; height: 18px;" />
							<span>Cartoncino Invito Ricevimento / Ristorante</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-rsvp" checked style="width: 18px; height: 18px;" />
							<span>Talloncino Lista Nozze / IBAN / RSVP</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="layer-bellyband" checked style="width: 18px; height: 18px;" />
							<span>Fascetta di Chiusura / Nastro / Sigillo Ceralacca</span>
						</label>
					</div>
				</div>

			</div>

			<!-- Right Column: Interactive Layering Canvas & Spec Sheet -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Spec Sheet Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Specifiche di Stampa & Taglio
						</span>
						<span id="format-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							Classico 12×18 cm
						</span>
					</div>

					<h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Dimensioni Strato per Strato
					</h3>

					<!-- Itemized Dimension Specs Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						
						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>1. Busta Esterna:</strong></span>
							<strong id="spec-outer-envelope" style="color: var(--accent-blue);">130 × 190 mm</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>2. Partecipazione Principale (Cerimonia):</strong></span>
							<strong id="spec-main-card" style="color: var(--accent-red);">120 × 180 mm</strong>
						</div>

						<div id="row-details" style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>3. Invito al Ricevimento / Ristorante:</strong></span>
							<strong id="spec-details-card">90 × 130 mm</strong>
						</div>

						<div id="row-rsvp" style="display: flex; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span><strong>4. Talloncino Lista Nozze / IBAN:</strong></span>
							<strong id="spec-rsvp-card">80 × 120 mm</strong>
						</div>

						<div id="row-belly" style="display: flex; justify-content: space-between; padding: 0.4rem 0; font-size: 0.92rem;">
							<span><strong>5. Fascetta di Chiusura:</strong></span>
							<strong id="spec-bellyband">40 × 300 mm</strong>
						</div>

					</div>

					<!-- Print Bleed Spec Box -->
					<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem; font-size: 0.88rem; color: var(--fg-pencil); line-height: 1.5;">
						<strong>📐 Abbondanza Tipografica (Bleed):</strong><br />
						Aggiungi <strong style="color: var(--accent-red);">+3 mm (circa 35 px @ 300 DPI)</strong> su tutti e 4 i lati nel tuo file grafico prima della stampa per evitare bordi bianchi indesiderati durante il taglio con ghigliottina!
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-specs" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Stampa Scheda Misure (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Esporta Documento Word
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guida ai Formati delle Partecipazioni e delle Buste in Italia
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Grammature consigliate, tipi di chiusura e galateo dell'inserimento degli inviti.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Grammature Consigliate (g/m²)
				</h3>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Cartoncino Partecipazione (280–350 g/m²):</strong> Lo spessore ideale per dare corpo ed eleganza all'annuncio di nozze (es. carta Amalfi, carta cotone o carta vergata).</li>
					<li><strong>Cartoncini d'Invito & Lista Nozze (250–300 g/m²):</strong> Fogli coordinati più piccoli da inserire nella stessa busta.</li>
					<li><strong>Buste (120–160 g/m²):</strong> Carta consistente con fodera interna decorata o patella a punta per sigillo in ceralacca.</li>
				</ul>
			</section>
		</article>

		<RelatedTools currentPath="/it/wedding-invitation-suite-sizer" category="stationery" />
	</main>
</Layout>

<script is:inline>
	const formatSelect = document.getElementById('suite-format-preset');
	const unitSelect = document.getElementById('unit-selector');

	const layerDetailsCheck = document.getElementById('layer-details');
	const layerRsvpCheck = document.getElementById('layer-rsvp');
	const layerBellyCheck = document.getElementById('layer-bellyband');

	const formatBadge = document.getElementById('format-badge');
	const specOuter = document.getElementById('spec-outer-envelope');
	const specMain = document.getElementById('spec-main-card');
	const specDetails = document.getElementById('spec-details-card');
	const specRsvp = document.getElementById('spec-rsvp-card');
	const specBelly = document.getElementById('spec-bellyband');

	const rowDetails = document.getElementById('row-details');
	const rowRsvp = document.getElementById('row-rsvp');
	const rowBelly = document.getElementById('row-belly');

	const btnPrint = document.getElementById('btn-print-specs');
	const btnDoc = document.getElementById('btn-export-doc');

	function formatDim(wMm, hMm, unit) {
		if (unit === 'mm') {
			return `${Math.round(wMm)} × ${Math.round(hMm)} mm`;
		} else if (unit === 'cm') {
			return `${(wMm / 10).toFixed(1)} × ${(hMm / 10).toFixed(1)} cm`;
		} else if (unit === 'px') {
			const wPx = Math.round((wMm / 25.4) * 300);
			const hPx = Math.round((hMm / 25.4) * 300);
			return `${wPx} × ${hPx} px`;
		}
	}

	function updateSuiteDimensions() {
		const fmt = formatSelect.value;
		const unit = unitSelect.value;

		let outerW = 130, outerH = 190, outerName = '13×19 cm';
		let mainW = 120, mainH = 180;
		let detailsW = 90, detailsH = 130;
		let rsvpW = 80, rsvpH = 120;
		let bellyW = 40, bellyL = 300;

		if (fmt === 'classic-12x18') {
			formatBadge.textContent = 'Classico Italiano 12×18 cm';
			outerW = 130; outerH = 190; outerName = '130×190 mm';
			mainW = 120; mainH = 180;
			detailsW = 90; detailsH = 130;
			rsvpW = 80; rsvpH = 120;
			bellyW = 40; bellyL = 300;
		} else if (fmt === 'a5-c5') {
			formatBadge.textContent = 'Standard Europeo A5 / C5';
			outerW = 162; outerH = 229; outerName = 'Busta C5';
			mainW = 148; mainH = 210; // A5
			detailsW = 105; detailsH = 148; // A6
			rsvpW = 85; rsvpH = 135;
			bellyW = 45; bellyL = 340;
		} else if (fmt === 'dl-format') {
			formatBadge.textContent = 'Formato DL Allungato';
			outerW = 110; outerH = 220; outerName = 'Busta DL';
			mainW = 100; mainH = 210;
			detailsW = 90; detailsH = 140;
			rsvpW = 80; rsvpH = 120;
			bellyW = 35; bellyL = 250;
		} else if (fmt === 'square-15') {
			formatBadge.textContent = 'Quadrato Moderno 15×15 cm';
			outerW = 160; outerH = 160; outerName = 'Busta 16×16 cm';
			mainW = 145; mainH = 145;
			detailsW = 100; detailsH = 100;
			rsvpW = 90; rsvpH = 90;
			bellyW = 40; bellyL = 340;
		} else if (fmt === 'a6-pocket') {
			formatBadge.textContent = 'Pocket / Tascabile A6';
			outerW = 114; outerH = 162; outerName = 'Busta C6';
			mainW = 105; mainH = 148;
			detailsW = 75; detailsH = 105;
			rsvpW = 70; rsvpH = 100;
			bellyW = 30; bellyL = 250;
		}

		specOuter.textContent = `${formatDim(outerW, outerH, unit)} (${outerName})`;
		specMain.textContent = formatDim(mainW, mainH, unit);
		specDetails.textContent = formatDim(detailsW, detailsH, unit);
		specRsvp.textContent = formatDim(rsvpW, rsvpH, unit);
		specBelly.textContent = formatDim(bellyW, bellyL, unit);

		rowDetails.style.display = layerDetailsCheck.checked ? 'flex' : 'none';
		rowRsvp.style.display = layerRsvpCheck.checked ? 'flex' : 'none';
		rowBelly.style.display = layerBellyCheck.checked ? 'flex' : 'none';
	}

	[formatSelect, unitSelect, layerDetailsCheck, layerRsvpCheck, layerBellyCheck].forEach(elem => {
		elem.addEventListener('change', updateSuiteDimensions);
	});

	btnPrint.addEventListener('click', () => window.print());

	btnDoc.addEventListener('click', () => {
		const content = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset="utf-8"><title>Specifiche Dimensioni Partecipazione</title></head>
			<body style="font-family: Arial, sans-serif; padding: 20px;">
				<h2>Manage.Wedding — Dimensioni Partecipazioni e Buste</h2>
				<p>Formato: ${formatBadge.textContent}</p>
				<table style="width:100%; border-collapse:collapse;" border="1">
					<tr><th>Elemento</th><th>Misura Finita</th></tr>
					<tr><td>Busta Esterna</td><td>${specOuter.textContent}</td></tr>
					<tr><td>Partecipazione Principale</td><td>${specMain.textContent}</td></tr>
					<tr><td>Invito Ricevimento</td><td>${specDetails.textContent}</td></tr>
					<tr><td>Talloncino Lista Nozze / RSVP</td><td>${specRsvp.textContent}</td></tr>
					<tr><td>Fascetta di Chiusura</td><td>${specBelly.textContent}</td></tr>
				</table>
			</body></html>
		`;
		const blob = new Blob(['\ufeff', content], { type: 'application/msword' });
		const link = document.createElement('a');
		link.href = URL.createObjectURL(blob);
		link.download = 'dimensioni-partecipazioni-nozze.doc';
		link.click();
	});

	updateSuiteDimensions();
</script>
