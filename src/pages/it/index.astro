---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://manage.wedding/it/#website",
      "name": "Manage.Wedding — Calcolatori Matrimonio & Budget Nozze Gratuiti",
      "url": "https://manage.wedding/it/",
      "inLanguage": "it",
      "description": "Suite privata di calcolatori interattivi per le nozze: calcolo open bar e prosecco, tableau de mariage, budget matrimonio e partecipazioni stampabili.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://manage.wedding/it/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Tutti i calcolatori su Manage.Wedding sono completamente gratuiti?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sì, 100% gratuiti, senza registrazione, senza carta di credito e senza costi nascosti. Tutti i calcoli e i download di file PDF e Word vengono generati istantaneamente nel tuo browser."
          }
        },
        {
          "@type": "Question",
          "name": "Manage.Wedding salva i miei dati personali o le liste degli invitati?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Manage.Wedding adotta un'architettura rigorosamente Local-First. Le tue liste di invitati, indirizzi e dati di budget rimangono memorizzati esclusivamente nella memoria locale del tuo dispositivo e non vengono mai inviati a server esterni o directory commerciali."
          }
        },
        {
          "@type": "Question",
          "name": "Quali sono le 4 fasi fondamentali per pianificare i costi del matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. Budget & Finanze (Ripartizione delle spese e analisi dei costi di location/villa), 2. Banchetto & Torta (Calcolo di prosecco, vino, open bar e piani torta), 3. Invitati & Logistica (Tableau de mariage e scaletta dettagliata del grande giorno), e 4. Partecipazioni & Ricordi (Intestazione buste, menù coordinati e timer per i discorsi)."
          }
        }
      ]
    }
  ]
};

const searchIndex = [
  // Budget & Finanze
  { title: "Calcolatore Budget Matrimonio", url: "/it/master-budget-calculator", category: "Budget", desc: "Ripartizione dei costi secondo la collaudata regola 50/15/10/10/10/5." },
  { title: "Costi Nascosti Location & Villa", url: "/it/wedding-venue-cost-calculator", category: "Budget", desc: "Calcola il costo effettivo con minimo garantito catering e costi di servizio." },
  { title: "Chi Paga Cosa al Matrimonio?", url: "/it/who-pays-for-what-wedding", category: "Budget", desc: "Confronta il galateo tradizionale con la suddivisione moderna tra famiglie." },
  { title: "Budget Addio al Nubilato & Celibato", url: "/it/bachelorette-budget-calculator", category: "Budget", desc: "Dividi le quote per alloggio e attività coprendo la parte della sposa." },
  { title: "Guida alle Mance per Fornitori", url: "/it/vendor-tipping-calculator", category: "Budget", desc: "Importi consigliati e creazione di buste per musicisti, fotografi e staff." },
  { title: "Budget Viaggio di Nozze", url: "/it/honeymoon-budget-estimator", category: "Budget", desc: "Voli, hotel, cene romantiche, escursioni e lista valigia." },
  { title: "Simulatore Prestito Matrimonio", url: "/it/wedding-loan-calculator", category: "Budget", desc: "Rata mensile, interessi totali e piano di ammortamento completo." },
  { title: "Busta Regalo in Denaro (Invitati)", url: "/it/gift-cash-calculator", category: "Budget", desc: "Quanto regalare agli sposi in base al grado di parentela e spostamento." },

  // Banchetto & Ristorazione (Dining)
  { title: "Calcolatore Open Bar & Prosecco", url: "/it/wedding-drink-calculator", category: "Banchetto", desc: "Stima bottiglie di prosecco, vino, birra, distillati e ghiaccio per il brindisi." },
  { title: "Distillati & Bottiglie per Cocktail", url: "/it/liquor-wedding-calculator", category: "Banchetto", desc: "Calcola bottiglie da 70cl e formati magnum per l'open bar serale." },
  { title: "Calcolatore Prezzo Torta Nuziale", url: "/it/cake-pricing-calculator", category: "Banchetto", desc: "Costo a porzione, ore di lavorazione e preventivo del pasticciere." },
  { title: "Piani e Porzioni Torta Nuziale", url: "/it/cake-serving-calculator", category: "Banchetto", desc: "Dimensioni dei piani tondi o quadrati da 50 a 300+ porzioni." },
  { title: "Crea Menù da Stampare (4x9 DL)", url: "/it/reception-menu-maker", category: "Banchetto", desc: "Impagina menù eleganti in formato DL 4x9 e 5x7 in PDF vettoriale." },
  { title: "Catering: Menù Servito vs Buffet", url: "/it/catering-cost-estimator", category: "Banchetto", desc: "Confronta il costo a persona tra servizio a tavola, buffet e isole gastronomiche." },
  { title: "Gradazione Alcolica & Diluizione", url: "/it/alcohol-dilution-calculator", category: "Banchetto", desc: "Bilancia il grado alcolico e l'aggiunta di liquidi per cocktail pre-miscelati." },
  { title: "Preventivo Fiori & Allestimenti", url: "/it/floral-cost-estimator", category: "Banchetto", desc: "Bouquet sposa, centrotavola, bottoniere e arco floreale per la cerimonia." },

  // Invitati & Logistica (Guests)
  { title: "Tableau de Mariage & Piantina Tavoli", url: "/it/seating-chart-maker", category: "Invitati", desc: "Disponi tavoli rotondi e imperiali col drag-and-drop e stampa la piantina." },
  { title: "Pista da Ballo & Distanze Tavoli", url: "/it/seating-clearance-calculator", category: "Invitati", desc: "Metri quadri per la pista da ballo e corridoi di passaggio da 1,5m per i camerieri." },
  { title: "Corteo Nuziale & Ingresso Sposi", url: "/it/wedding-processional-order", category: "Invitati", desc: "Ordine d'ingresso e uscita per rito religioso, civile e simbolico." },
  { title: "Timeline & Programma del Grande Giorno", url: "/it/day-of-timeline-generator", category: "Invitati", desc: "Programma minuto per minuto per trucco, foto, cerimonia e taglio torta." },
  { title: "Cena della Vigilia & Prova", url: "/it/rehearsal-dinner-planner", category: "Invitati", desc: "Lista partecipanti, budget ristorazione e orari per la sera prima." },
  { title: "Gestione Lista Invitati", url: "/it/guest-list-manager", category: "Invitati", desc: "Accompagnatori, indirizzi per le partecipazioni e intolleranze alimentari." },
  { title: "Tracciamento Conferme (RSVP)", url: "/it/rsvp-tracker", category: "Invitati", desc: "Monitoraggio in tempo reale di presenze, assenze e scelte del menù." },
  { title: "Stima Presenze Reali & Defezioni", url: "/it/guest-count-estimator", category: "Invitati", desc: "Percentuale di partecipazione per invitati locali e ospiti che viaggiano da lontano." },
  { title: "Scadenze Invio Partecipazioni", url: "/it/rsvp-date-calculator", category: "Invitati", desc: "Date ideali per Save-the-Date, spedizione inviti e termine per la conferma." },
  { title: "Checklist Matrimonio su 12 Mesi", url: "/it/wedding-checklist", category: "Invitati", desc: "Elenco interattivo delle cose da fare mese per mese con salvataggio automatico." },
  { title: "Preventivo Sartoria Abito da Sposa", url: "/it/dress-alterations-estimator", category: "Invitati", desc: "Orlo, regolazione corpetto e inserimento del punto di ancoraggio strascico." },
  { title: "Guida Taglie Abito da Sposa", url: "/it/dress-size-converter", category: "Invitati", desc: "Converti le tue misure in cm nelle taglie IT, US, UK ed europee." },
  { title: "Misuratore & Guida Taglie Anelli (mm)", url: "/it/ring-size-converter", category: "Invitati", desc: "Diametro e circonferenza millimetrica per fedi nuziali italiane e internazionali." },

  // Partecipazioni & Ricordi (Stationery)
  { title: "Intestazione Buste Partecipazioni", url: "/it/wedding-envelope-addressing", category: "Partecipazioni", desc: "Formattazione corretta delle formule di cortesia (Famiglie, Gent.mi) e stampa PDF." },
  { title: "Formati Partecipazioni (A7 / A6 / B6)", url: "/it/wedding-invitation-suite-sizer", category: "Partecipazioni", desc: "Dimensioni standard per inviti, cartoncino RSVP e margini di stampa 300 DPI." },
  { title: "Calcolo Spese Postali & Ceralacca", url: "/it/wedding-invitation-postage-calculator", category: "Partecipazioni", desc: "Peso dell'invito, sigilli in ceralacca e tariffe postali per inviti di nozze." },
  { title: "Segnaposto & Cavalieri da Tavolo", url: "/it/table-place-cards", category: "Partecipazioni", desc: "Cartoncini pieghevoli con icone di preferenza menù per i camerieri." },
  { title: "Testi Biglietti di Ringraziamento", url: "/it/wedding-thank-you-cards", category: "Partecipazioni", desc: "Frasi per busta regalo, lista nozze e partecipazione al matrimonio." },
  { title: "Partecipazioni di Nozze Digitali", url: "/it/digital-invitations", category: "Partecipazioni", desc: "Inviti digitali con aggiunta al calendario (.ics) e RSVP online." },
  { title: "Timer Discorso dei Testimoni & Sposi", url: "/it/wedding-speech-calculator", category: "Partecipazioni", desc: "Conteggio parole, velocità di lettura (120 WPM) e foglietti promemoria." },
  { title: "Generatore Hashtag Matrimonio", url: "/it/wedding-hashtag-generator", category: "Partecipazioni", desc: "Hashtag personalizzati e cartelli grafici per le foto degli ospiti." },
  { title: "Numerologia della Data di Nozze", url: "/it/wedding-date-numerology", category: "Partecipazioni", desc: "Numero del destino e significato numerologico della data del matrimonio." },
  { title: "Anniversari di Nozze & Idee Regalo", url: "/it/anniversary-gift-finder", category: "Partecipazioni", desc: "Nozze di Carta, Seta, Argento e Oro: idee regalo dal 1° al 60° anno." }
];
---

<Layout 
	title="Manage.Wedding — Calcolatori Matrimonio & Budget Nozze Gratuiti"
	description="Suite privata di calcolatori interattivi per le nozze: calcolo open bar e prosecco, tableau de mariage, budget matrimonio e partecipazioni stampabili. 100% gratuito e senza registrazione."
	schema={schema}
>
	<main>
		<!-- 1. Hero: Digital Sketchbook & Live Instant Search -->
		<section class="section-paper fade-in" style="padding: 4rem 1.5rem 3rem; position: relative; overflow: hidden; border-bottom: 3px solid var(--fg-pencil);">
			
			<div class="tape" style="top: -10px;"></div>
			
			<div style="max-width: 1050px; margin: 0 auto; text-align: center; position: relative; z-index: 10;">
				
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 6px 16px; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-1deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.95rem; font-weight: 700; color: var(--fg-pencil);">100% Gratuito • Privacy Totale • Download Immediati</span>
				</div>

				<h1 class="font-heading" style="font-size: clamp(36px, 6.5vw, 68px); line-height: 1.15; color: var(--fg-pencil); margin-bottom: 1.25rem;">
					Pianifica i numeri del tuo matrimonio <br class="hidden sm:inline" />
					<span style="color: var(--accent-blue); text-decoration: underline; text-decoration-style: wavy;">senza alcuno stress.</span>
				</h1>

				<p style="font-size: clamp(1.1rem, 2.5vw, 1.3rem); color: var(--text-secondary); max-width: 760px; margin: 0 auto 2rem; line-height: 1.6;">
					Il tuo taccuino digitale privato per calcolare open bar e prosecco, verificare i costi della villa, creare il tableau de mariage e stampare i menù.
				</p>

				<!-- Live Instant Search Bar with Dynamic Dropdown -->
				<div style="position: relative; max-width: 650px; margin: 0 auto 2rem;">
					<div class="search-hero-box" style="margin-bottom: 0;">
						<span style="font-size: 1.3rem; color: #64748b;">🔍</span>
						<input 
							type="text" 
							id="home-tool-search" 
							class="search-hero-input" 
							placeholder="Cerca uno strumento: open bar, catering, torta, tableau, discorsi..."
							aria-label="Cerca calcolatori di nozze"
							autocomplete="off"
						/>
						<button id="clear-search-btn" style="display: none; background: none; border: none; font-size: 1.1rem; color: #94a3b8; cursor: pointer; padding: 0 0.5rem;">✕</button>
					</div>

					<!-- Search Results Live Dropdown Popup -->
					<div id="search-dropdown-results" style="display: none; position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 4px 4px 0px var(--fg-pencil); max-height: 380px; overflow-y: auto; z-index: 100; text-align: left; padding: 0.5rem;">
						<!-- Injected by JavaScript -->
					</div>
				</div>

				<!-- Fast Shortcut Chips -->
				<div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; max-width: 800px; margin: 0 auto 2rem;">
					<span style="font-size: 0.88rem; font-weight: 600; color: #64748b; align-self: center;">Strumenti Popolari:</span>
					<a href="/it/wedding-drink-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Open Bar & Prosecco</a>
					<a href="/it/wedding-venue-cost-calculator" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🏰 Costi Location</a>
					<a href="/it/seating-chart-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">🪑 Tableau de Mariage</a>
					<a href="/it/reception-menu-maker" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">📜 Menù da Stampare</a>
					<a href="/it/wedding-envelope-addressing" class="tool-tag" style="text-decoration: none; padding: 5px 12px; font-size: 0.85rem; background: #fff; border: 1.5px solid var(--fg-pencil);">✉️ Buste Partecipazioni</a>
				</div>

				<!-- Main Hero CTAs -->
				<div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
					<a href="#featured-favorites" class="hand-btn" style="padding: 14px 30px; font-size: 1.15rem;">
						Scopri gli Strumenti Principali ↓
					</a>
					<a href="/it/about" class="hand-btn secondary" style="padding: 14px 26px; font-size: 1.15rem;">
						Perché Manage.Wedding?
					</a>
				</div>

			</div>
		</section>

		<!-- 2. Spotlight "Crowd Favorites" (4 Illustrated Cards) -->
		<section id="featured-favorites" style="padding: 4rem 1.5rem; max-width: 1200px; margin: 0 auto;">
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil);">
					⭐ Gli Strumenti Più Amati dagli Sposi
				</h2>
				<p style="font-size: 1.1rem; color: var(--text-secondary); max-width: 600px; margin: 0.25rem auto 0;">
					I calcolatori più utilizzati da migliaia di coppie e wedding planner in Italia.
				</p>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 2rem;">
				
				<!-- Featured 1: Open Bar -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/wedding_bar_sketch.webp" 
						alt="Calcolatore Bevande & Open Bar Nozze" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #fef08a; border-color: var(--fg-pencil); color: var(--fg-pencil);">Più Richiesto</span>
						<span class="tool-time">⏱️ 2 min</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Calcolatore Open Bar & Prosecco</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Calcola con precisione bottiglie di vino, prosecco, birra, distillati e ghiaccio per l'evento.
					</p>
					<a href="/it/wedding-drink-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Calcola Bevande →
					</a>
				</div>

				<!-- Featured 2: Master Budget -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/calculator_sketch.webp" 
						alt="Calcolatore Budget Matrimonio" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dbeafe; border-color: #93c5fd; color: #1e40af;">Finanze</span>
						<span class="tool-time">⏱️ 3 min</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Calcolatore Budget Matrimonio</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Ripartisci qualsiasi budget totale secondo le percentuali realistiche del settore nozze.
					</p>
					<a href="/it/master-budget-calculator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Ripartisci Budget →
					</a>
				</div>

				<!-- Featured 3: Day-Of Timeline -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/pocket-watch-sketch.webp" 
						alt="Timeline & Programma del Grande Giorno" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #dcfce7; border-color: #86efac; color: #166534;">Logistica</span>
						<span class="tool-time">⏱️ 3 min</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Timeline & Programma Nozze</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Genera una scaletta minuto per minuto per fotografi, truccatori e testimoni.
					</p>
					<a href="/it/day-of-timeline-generator" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Crea Timeline →
					</a>
				</div>

				<!-- Featured 4: Seating Chart -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<img 
						src="/images/seating_chart_sketch.webp" 
						alt="Tableau de Mariage & Piantina Tavoli" 
						loading="lazy"
						decoding="async"
						style="width: 100%; height: 160px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 4px; margin-bottom: 1rem;"
					/>
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span class="tool-tag" style="background: #f3e8ff; border-color: #d8b4fe; color: #6b21a8;">Interattivo</span>
						<span class="tool-time">⏱️ 5 min</span>
					</div>
					<h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-weight: 700; color: var(--fg-pencil);">Tableau de Mariage</h3>
					<p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">
						Organizza tavoli rotondi e imperiali, assegna i posti col drag & drop e stampa la piantina.
					</p>
					<a href="/it/seating-chart-maker" class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem;">
						Crea il Tableau →
					</a>
				</div>

			</div>
		</section>

		<!-- 3. The 4-Phase Wedding Planning Master Roadmap -->
		<section style="background: var(--muted-paper); padding: 4.5rem 1.5rem; border-top: 3px dashed var(--fg-pencil); border-bottom: 3px dashed var(--fg-pencil);">
			<div style="max-width: 1100px; margin: 0 auto;">
				
				<div style="text-align: center; margin-bottom: 3rem;">
					<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Passo dopo Passo</span>
					<h2 class="font-heading" style="font-size: clamp(28px, 4.5vw, 44px); color: var(--fg-pencil);">
						La Guida Completa per l'Organizzazione delle Nozze
					</h2>
					<p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 650px; margin: 0.25rem auto 0;">
						Cosa calcolare, definire e verificare in ogni fase dei preparativi.
					</p>
				</div>

				<div style="display: flex; flex-direction: column; gap: 1.75rem;">
					
					<!-- Roadmap Step 1 -->
					<div class="hand-card" style="padding: 1.75rem; background: #fff; border-left: 6px solid var(--accent-red);">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								Fase 1: Budget Reale e Scelta della Location (12 - 9 Mesi Prima)
							</h3>
							<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
								Fase 01
							</span>
						</div>
						<p class="font-body" style="font-size: 1rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 1rem 0;">
