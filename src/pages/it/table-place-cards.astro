---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/table-place-cards/#webapp",
      "name": "Generatore Segnaposto & Numeri Tavolo Matrimonio da Stampare",
      "url": "https://manage.wedding/it/table-place-cards",
      "inLanguage": "it",
      "description": "Generatore gratuito di segnaposto per matrimonio, cartoncini pieghevoli a cavalierino con icone menù e cartelli numeri tavolo per centrotavola pronti da stampare.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "Article",
      "headline": "Guida ai Segnaposto di Matrimonio e Segnatavolo: Misure, Grammature e Galateo",
      "description": "Scopri la differenza tra tableau de mariage e segnaposto, la grammatura ideale della carta e l'uso delle icone menù per i camerieri.",
      "inLanguage": "it",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come creare e stampare i segnaposto per il matrimonio",
      "description": "Istruzioni per comporre i cartellini da tavolo, inserire le intolleranze per i camerieri e stampare su cartoncino pregiato.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Scegliere il formato del segnaposto",
          "text": "Seleziona tra cavalierino pieghevole autoportante (9×5 cm piegato), cartoncino piatto o numero per centrotavola."
        },
        {
          "@type": "HowToStep",
          "name": "2. Assegnare nomi, tavoli e icone menù",
          "text": "Indica il nome dell'invitato, il tavolo di appartenenza e l'icona del menù (carne, pesce, vegetariano, celiachia)."
        },
        {
          "@type": "HowToStep",
          "name": "3. Stampare su cartoncino da 250–300 g/m²",
          "text": "Scarica il PDF impaginato pronto per la stampa fronte-retro su carta cotone o cartoncino martellato."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual è la differenza tra segnatavolo e segnaposto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il segnatavolo è il cartello posizionato al centro del tavolo con il numero. Il segnaposto è il cartoncino personalizzato con il nome del singolo invitato posizionato sopra il tovagliolo con l'indicazione del piatto."
          }
        },
        {
          "@type": "Question",
          "name": "Quale grammatura di carta usare per i segnaposto a cavalierino?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si consiglia una grammatura tra i 250 g/m² e i 300 g/m² (carta martellata, vergata o cotone) per garantire che il cavalierino stia perfettamente in piedi."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Generatore Segnaposto Matrimonio & Numeri Tavolo (PDF Gratis) | Manage.Wedding"
	description="Crea e stampa segnaposto a cavalierino con icone menù per il catering, cartoncini piatti e segnatavolo. Esporta in PDF, Word ed Excel all'istante."
	schema={schema}
>
	<!-- Include Google Wedding Typography Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

	<!-- Include html2canvas for preview card capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Generatore Segnaposto" category="stationery-creative" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Generatore Segnaposto & Numeri Tavolo
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Genera segnaposto a cavalierino pieghevole, cartellini piatti e numeri per centrotavola. Con <strong>icone menù per il catering</strong> e stampa immediata in <strong>PDF impaginato</strong> o <strong>Word (.doc)</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Come Creare Segnaposto Stampabili in 3 Passaggi
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Scegli Formato e Cornice
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Seleziona cavalierini pieghevoli (9x5 cm piegati), cartellini piatti o numeri per centrotavola.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Assegna Tavoli e Scelte Menù
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Aggiungi gli ospiti e attiva le icone dei piatti (Carne, Pesce, Vegetariano) per il personale di sala.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Esporta in PDF e File Word
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clicca su <strong>"🖨️ Esporta PDF / Stampa"</strong> per le schede di taglio o <strong>"📝 Esporta Word (.doc)"</strong> per il maître.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="placecards-calc-grid">
			
			<!-- Left Column -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🏷️ Opzioni di Stile e Disposizione
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Personalizza il formato del cartoncino, la cornice e l'assegnazione posti
					</span>
				</div>

				<form id="placecards-form" style="display: flex; flex-direction: column; gap: 1.2rem;">
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;">
						<div>
							<label for="select-card-type" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-red); margin-bottom: 0.35rem;">
								Formato Cartoncino *
							</label>
							<select id="select-card-type" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 6px; background: #fff; font-family: var(--font-body); font-size: 0.92rem; font-weight: 600; cursor: pointer;">
								<option value="tent" selected>🏷️ Cavalierino Pieghevole (9x5 cm piegato)</option>
								<option value="flat">🎴 Cartoncino Piatto (9x5 cm)</option>
								<option value="tablenum">🔢 Numero Segnatavolo per Centro (13x18 cm)</option>
							</select>
						</div>

						<div>
							<label for="select-border-theme" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-blue); margin-bottom: 0.35rem;">
								Cornice Artistica *
							</label>
							<select id="select-border-theme" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 6px; background: #fff; font-family: var(--font-body); font-size: 0.92rem; font-weight: 600; cursor: pointer;">
								<option value="botanical" selected>🌿 Bordo Botanico Floreale</option>
								<option value="classic">✒️ Doppia Linea Classica</option>
								<option value="crest">🏛️ Volute & Fregio Dorato</option>
							</select>
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 6px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block;">
							⚙️ Personalizzazioni Segnaposto
						</span>
						<div style="display: flex; gap: 1.25rem; flex-wrap: wrap;">
							<label style="font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-meal-icons" checked style="accent-color: var(--brand-primary, #dc2626); width: 16px; height: 16px;">
								<span>Mostra Icone Menù (🥩 / 🐟 / 🥦)</span>
							</label>
							<label style="font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-table-badge" checked style="accent-color: var(--brand-primary, #dc2626); width: 16px; height: 16px;">
								<span>Mostra Numero Tavolo</span>
							</label>
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
							<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">
								👥 Lista Ospiti: <strong id="assigned-count-badge" style="color: var(--accent-red);">1 Ospite</strong>
							</span>
							<div style="display: flex; gap: 0.4rem;">
								<button type="button" id="btn-load-samples" class="hand-btn" style="padding: 0.3rem 0.65rem; font-size: 0.8rem; background: #eff6ff;">
									✨ Carica Esempio
								</button>
								<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.3rem 0.65rem; font-size: 0.8rem; color: #b91c1c;">
									🗑️ Cancella Tutto
								</button>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1.4fr 0.8fr 0.9fr auto; gap: 0.4rem; align-items: center;">
							<input type="text" id="input-new-guest-name" placeholder="Nome (es. Marco Rossi)" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; font-family: var(--font-body);">
							<input type="text" id="input-new-table-num" placeholder="Tavolo #" value="1" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; font-family: var(--font-body);">
							<select id="select-new-meal" style="padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.88rem; background: #fff; font-family: var(--font-body);">
								<option value="🥩 Carne">🥩 Carne</option>
								<option value="🍗 Pollo">🍗 Pollo</option>
								<option value="🐟 Pesce">🐟 Pesce</option>
								<option value="🥦 Vegetariano">🥦 Vegetariano</option>
								<option value="🌱 Vegano">🌱 Vegano</option>
							</select>
							<button type="button" id="btn-add-guest" class="hand-btn" style="padding: 0.5rem 0.85rem; font-size: 0.88rem; background: var(--brand-primary, #dc2626); color: #fff;">
								+ Aggiungi
							</button>
						</div>
					</div>
				</form>
			</div>

			<!-- Right Column: Live Card Preview -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖼️ Anteprima in Tempo Reale
							</h3>
							<span id="preview-scale-label" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Cavalierino Pieghevole (9x5 cm Vista Frontale)
							</span>
						</div>

						<div style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.75rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.88rem; background: #eff6ff;">
								📝 Esporta Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.88rem; background: #fef2f2; color: var(--accent-red); font-weight: 700;">
								🖨️ Esporta PDF / Stampa
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.75rem; font-size: 0.88rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<div style="display: flex; justify-content: center; align-items: center; padding: 1.25rem 0; min-height: 240px; background: #f1f5f9; border-radius: 8px; border: 1.5px dashed #cbd5e1; margin-bottom: 1.25rem; overflow: hidden;">
						<div id="preview-placecard-canvas" class="card-format-tent theme-botanical"></div>
					</div>

					<button type="button" id="btn-download-sample-png" class="hand-btn" style="width: 100%; text-align: center; font-size: 0.95rem; padding: 0.6rem; background: #f0fdf4; border: 1.5px solid var(--fg-pencil);">
						📸 Salva Immagine PNG del Segnaposto
					</button>
				</div>

				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 420px; overflow-y: auto;">
					<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						📋 Ospiti per Tavolo <small style="font-size: 0.8rem; font-weight: normal; color: var(--text-secondary);">(Clicca per visualizzare)</small>
					</h3>
					<div id="table-cards-stream" style="display: flex; flex-direction: column; gap: 0.75rem;"></div>
				</div>
			</div>
		</div>

		<!-- SEO Article & Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem; line-height: 1.75; color: var(--fg-pencil); font-size: 1.05rem;">
			<header style="text-align: center; margin-bottom: 2.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1.5rem;">
				<span class="badge-postit">Coordinati Cartacei e Galateo del Ricevimento</span>
				<h2 class="font-heading" style="font-size: clamp(26px, 3.8vw, 38px); color: var(--fg-pencil); margin-top: 0.5rem; line-height: 1.25;">
					Guida Completa ai Segnaposto di Matrimonio e Segnatavolo
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0;">
					Misure consigliate, simboli grafici per il catering, tipi di carta e istruzioni per il fai-da-te.
				</p>
			</header>

			<section style="margin-bottom: 3rem;">
				<h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin-bottom: 1rem;">
					Tableau de Mariage vs. Segnaposto: Galateo e Funzioni
				</h2>
				<p>
					Il <strong>tableau de mariage</strong> accoglie gli invitati all'ingresso indicando loro il tavolo, mentre il <strong>segnaposto</strong> al singolo coperto definisce la sedia specifica ed esprime le preferenze alimentari per la sala.
				</p>
			</section>

			<section style="margin-bottom: 3rem;">
				<h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin-bottom: 1rem;">
					Icone Menù: Perfezionare il Servizio al Tavolo
				</h2>
				<p>
					Piccole icone discrete nell'angolo inferiore del segnaposto velocizzano le portate ed evitano errori da parte dei camerieri :
				</p>
				<ul>
					<li><strong>🥩 Carne :</strong> Indicatore per tagliate o arrosti.</li>
					<li><strong>🐟 Pesce :</strong> Simbolo marino per orata o salmone.</li>
					<li><strong>🥦 Vegetariano :</strong> Simbolo vegetale.</li>
					<li><strong>⚠️ Celiachia e Intolleranze :</strong> Indicato chiaramente in rosso (es. <em>"Senza Glutine"</em>).</li>
				</ul>
			</section>

			<section>
				<h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Domande Frequenti (FAQ)
				</h2>
				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.15rem; cursor: pointer; color: var(--accent-blue); font-weight: 700;">
						Come inviare la lista dei tavoli al catering?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1rem; margin-bottom: 0;">
						Clicca su <strong>"📝 Esporta Word (.doc)"</strong> per scaricare l'elenco completo suddiviso per tavolo con il conteggio dei piatti per la brigata di cucina.
					</p>
				</details>
			</section>
		</article>

		<RelatedTools currentPath="/it/table-place-cards" category="stationery" />
	</main>
</Layout>

<style>
	.card-format-tent { width: 320px; height: 220px; display: flex; flex-direction: column; box-shadow: 4px 4px 12px rgba(0,0,0,0.12); border-radius: 4px; transition: all 0.25s ease; }
	.card-format-flat { width: 320px; height: 180px; display: flex; flex-direction: column; box-shadow: 4px 4px 12px rgba(0,0,0,0.12); border-radius: 4px; transition: all 0.25s ease; }
	.card-format-tablenum { width: 250px; height: 350px; display: flex; flex-direction: column; box-shadow: 4px 4px 12px rgba(0,0,0,0.15); border-radius: 6px; transition: all 0.25s ease; }
	.theme-botanical { background: #fcfbf7 !important; border: 2px solid #234e32 !important; color: #1a3323 !important; font-family: 'Cormorant Garamond', serif !important; }
	.theme-botanical .card-inner-border { border: 1px dashed #4d7c5f; }
	.theme-botanical .accent-color { color: #2d6a4f !important; }
	.theme-botanical .divider-line { background: #2d6a4f !important; }
	.theme-classic { background: #ffffff !important; border: 2.5px solid #111827 !important; color: #111827 !important; font-family: 'Playfair Display', serif !important; }
	.theme-classic .card-inner-border { border: 1px solid #111827; }
	.theme-classic .accent-color { color: #111827 !important; }
	.theme-classic .divider-line { background: #111827 !important; }
	.theme-crest { background: #fdfaf4 !important; border: 2.5px solid #b45309 !important; color: #78350f !important; font-family: 'Cinzel', serif !important; }
	.theme-crest .card-inner-border { border: 1px solid #d97706; }
	.theme-crest .accent-color { color: #b45309 !important; }
	.theme-crest .divider-line { background: #b45309 !important; }
	.selected-guest-row { background: #eff6ff !important; border-left: 3px solid #2563eb !important; }
</style>

<script is:inline>
	let seatedGuestList = [{ name: "Marco Rossi", table: "1", meal: "🥩 Carne" }];
	let selectedGuestIndex = 0;

	const selectCardType = document.getElementById('select-card-type');
	const selectBorderTheme = document.getElementById('select-border-theme');
	const chkShowMealIcons = document.getElementById('chk-show-meal-icons');
	const chkShowTableBadge = document.getElementById('chk-show-table-badge');
	const previewCanvas = document.getElementById('preview-placecard-canvas');
	const previewScaleLabel = document.getElementById('preview-scale-label');
	const assignedCountBadge = document.getElementById('assigned-count-badge');
	const tableCardsStream = document.getElementById('table-cards-stream');
	const inputGuestName = document.getElementById('input-new-guest-name');
	const inputTableNum = document.getElementById('input-new-table-num');
	const selectMeal = document.getElementById('select-new-meal');

	function loadSeatedGuests() {
		try {
			const saved = localStorage.getItem('manage_wedding_guests_it');
			if (saved) {
				const all = JSON.parse(saved);
				if (all.length > 0) seatedGuestList = all;
			}
		} catch (e) {}
		renderPlaceCards();
	}

	function loadSampleTables() {
		seatedGuestList = [
			{ name: "Marco Rossi", table: "1", meal: "🥩 Carne" },
			{ name: "Giulia Bianchi", table: "1", meal: "🐟 Pesce" },
			{ name: "Andrea Conti", table: "2", meal: "🍗 Pollo" },
			{ name: "Chiara Ferrari", table: "2", meal: "🥦 Vegetariano" },
			{ name: "Nonna Maria", table: "Tavolo Sposi", meal: "🐟 Pesce" }
		];
		selectedGuestIndex = 0;
		renderPlaceCards();
	}

	function renderPlaceCards() {
		const cardType = selectCardType.value;
		const theme = selectBorderTheme.value;
		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;

		if (selectedGuestIndex >= seatedGuestList.length) selectedGuestIndex = Math.max(0, seatedGuestList.length - 1);
		const currentGuest = seatedGuestList[selectedGuestIndex] || {
			name: inputGuestName.value.trim() || "Nome Invitato",
			table: inputTableNum.value.trim() || "1",
			meal: selectMeal.value || "🥩 Carne"
		};

		previewCanvas.className = `card-format-${cardType} theme-${theme}`;
		if (cardType === 'tent') previewScaleLabel.textContent = "Cavalierino Pieghevole (9x5 cm Vista Frontale)";
		else if (cardType === 'flat') previewScaleLabel.textContent = "Cartoncino Piatto (9x5 cm)";
		else previewScaleLabel.textContent = "Numero Segnatavolo per Centro (13x18 cm)";

		const botanicalSvg = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C8 6 4 10 4 15a8 8 0 0 0 16 0c0-5-4-9-8-13z"></path><path d="M12 2v20"></path></svg>`;
		const crestCornerSvg = `<svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M2 2h6v2H4v4H2V2zm16 0h-6v2h4v4h2V2zM2 18h6v-2H4v-4H2v6zm16 0h-6v-2h4v-4h2v6z"/></svg>`;

		if (cardType === 'tent') {
			previewCanvas.innerHTML = `
				<div style="flex: 1; border-bottom: 1.5px dashed #94a3b8; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.02);">
					<span style="font-size: 0.72rem; letter-spacing: 2px; text-transform: uppercase; opacity: 0.6; font-family: sans-serif;">✂️ LINEA DI PIEGA • CAVALIERINO</span>
				</div>
				<div style="flex: 1.25; padding: 0.75rem 1rem; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative;">
					<div class="card-inner-border" style="position: absolute; inset: 4px; border-radius: 2px; pointer-events: none;"></div>
					${theme === 'botanical' ? `<div style="position: absolute; top: 4px; left: 4px; color: #234e32;">${botanicalSvg}</div><div style="position: absolute; top: 4px; right: 4px; transform: scaleX(-1); color: #234e32;">${botanicalSvg}</div>` : ''}
					${theme === 'crest' ? `<div style="position: absolute; top: 4px; left: 4px; color: #b45309;">${crestCornerSvg}</div><div style="position: absolute; top: 4px; right: 4px; transform: scaleX(-1); color: #b45309;">${crestCornerSvg}</div>` : ''}
					<h2 style="font-size: 1.35rem; margin: 0 0 0.2rem 0; line-height: 1.2; font-weight: 600; text-align: center;">${currentGuest.name}</h2>
					<div class="divider-line" style="width: 32px; height: 1.5px; margin: 0.2rem auto;"></div>
					${showTable ? `<p class="accent-color" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; margin: 0.2rem 0 0 0; font-weight: bold;">Tavolo ${currentGuest.table}</p>` : ''}
					${showMeal ? `<div style="position: absolute; bottom: 6px; right: 8px; font-size: 1.1rem;">${currentGuest.meal.split(' ')[0] || '🥩'}</div>` : ''}
				</div>
			`;
		} else if (cardType === 'flat') {
			previewCanvas.innerHTML = `
				<div style="flex: 1; padding: 1.25rem; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative;">
					<div class="card-inner-border" style="position: absolute; inset: 6px; border-radius: 2px; pointer-events: none;"></div>
					<h2 style="font-size: 1.45rem; margin: 0 0 0.25rem 0; font-weight: 600; text-align: center;">${currentGuest.name}</h2>
					<div class="divider-line" style="width: 40px; height: 1.5px; margin: 0.25rem auto;"></div>
					${showTable ? `<p class="accent-color" style="font-size: 0.92rem; text-transform: uppercase; letter-spacing: 2px; margin: 0.25rem 0 0 0; font-weight: bold;">Tavolo ${currentGuest.table}</p>` : ''}
					${showMeal ? `<div style="position: absolute; bottom: 8px; right: 10px; font-size: 1.15rem;">${currentGuest.meal.split(' ')[0] || '🥩'}</div>` : ''}
				</div>
			`;
		} else {
			const tbl = currentGuest.table ? currentGuest.table.toString() : "1";
			previewCanvas.innerHTML = `
				<div style="flex: 1; padding: 2rem 1.5rem; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; text-align: center;">
					<div class="card-inner-border" style="position: absolute; inset: 8px; border-radius: 4px; pointer-events: none;"></div>
					<p style="font-size: 0.95rem; letter-spacing: 4px; text-transform: uppercase; margin: 0 0 0.5rem 0;">TAVOLO</p>
					<div style="font-size: 3.8rem; font-weight: 700; line-height: 1; margin: 0.25rem 0 0.5rem 0;" class="accent-color">${tbl.replace(/[^0-9]/g, '') || tbl}</div>
					<div class="divider-line" style="width: 50px; height: 2px; margin: 0.5rem auto 1rem;"></div>
					<p style="font-size: 0.88rem; font-style: italic; opacity: 0.8; margin: 0;">Benvenuti</p>
				</div>
			`;
		}

		assignedCountBadge.textContent = `${seatedGuestList.length} ${seatedGuestList.length === 1 ? 'Ospite' : 'Ospiti'}`;

		const grouped = {};
		seatedGuestList.forEach((g, idx) => {
			const tbl = g.table || 'Senza Tavolo';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push({ ...g, originalIndex: idx });
		});

		tableCardsStream.innerHTML = '';
		Object.keys(grouped).forEach(tbl => {
			const block = document.createElement('div');
			block.style.cssText = `background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;`;
			let html = '';
			grouped[tbl].forEach(g => {
				const isSelected = g.originalIndex === selectedGuestIndex;
				html += `
					<div class="guest-item-row ${isSelected ? 'selected-guest-row' : ''}" data-idx="${g.originalIndex}" style="display: flex; justify-content: space-between; align-items: center; padding: 0.35rem 0.5rem; border-bottom: 1px dotted #ccc; font-size: 0.9rem; cursor: pointer;">
						<span style="font-weight: ${isSelected ? '700' : '500'};">${isSelected ? '👉 ' : ''}${g.name} <small style="color:#64748b;">(${g.meal || 'Carne'})</small></span>
						<button type="button" class="btn-del-seat hand-btn secondary" data-name="${g.name}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; color: #b91c1c;">🗑️</button>
					</div>
				`;
			});
			block.innerHTML = `
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
					<strong class="font-heading" style="color: var(--accent-red); font-size: 1.05rem;">Tavolo: ${tbl}</strong>
					<span style="font-size: 0.8rem; font-weight: bold; background: #fff; border: 1px solid var(--fg-pencil); padding: 1px 6px; border-radius: 3px;">${grouped[tbl].length} Ospiti</span>
				</div>
				<div>${html}</div>
			`;
			tableCardsStream.appendChild(block);
		});

		document.querySelectorAll('.btn-del-seat').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const gName = btn.getAttribute('data-name');
				seatedGuestList = seatedGuestList.filter(g => g.name !== gName);
				if (selectedGuestIndex >= seatedGuestList.length) selectedGuestIndex = Math.max(0, seatedGuestList.length - 1);
				renderPlaceCards();
			});
		});

		document.querySelectorAll('.guest-item-row').forEach(row => {
			row.addEventListener('click', () => {
				const idx = parseInt(row.getAttribute('data-idx'), 10);
				if (!isNaN(idx)) { selectedGuestIndex = idx; renderPlaceCards(); }
			});
		});
	}

	document.getElementById('btn-download-sample-png').addEventListener('click', () => {
		if (window.html2canvas) {
			window.html2canvas(previewCanvas, { scale: 3, backgroundColor: null, useCORS: true }).then(canvas => {
				const link = document.createElement('a');
				link.download = `Segnaposto_${seatedGuestList[selectedGuestIndex]?.name?.replace(/\s+/g, '_') || 'Campione'}.png`;
				link.href = canvas.toDataURL("image/png");
				link.click();
			});
		}
	});

	document.getElementById('btn-add-guest').addEventListener('click', () => {
		const name = inputGuestName.value.trim();
		const table = inputTableNum.value.trim() || '1';
		const meal = selectMeal.value;
		if (name) {
			seatedGuestList.push({ name, table, meal });
			selectedGuestIndex = seatedGuestList.length - 1;
			inputGuestName.value = '';
			renderPlaceCards();
		}
	});

	document.getElementById('btn-load-samples').addEventListener('click', loadSampleTables);
	document.getElementById('btn-clear-all').addEventListener('click', () => { seatedGuestList = []; selectedGuestIndex = 0; renderPlaceCards(); });
	[selectCardType, selectBorderTheme, chkShowMealIcons, chkShowTableBadge].forEach(el => el.addEventListener('change', renderPlaceCards));

	function generatePrintDocHtml(cardsHtml, cardType, theme) {
		let borderColor = theme === 'botanical' ? '#234e32' : theme === 'crest' ? '#b45309' : '#111827';
		let bgStyle = theme === 'botanical' ? '#fcfbf7' : theme === 'crest' ? '#fdfaf4' : '#ffffff';
		let fontFamily = theme === 'crest' ? "'Cinzel', serif" : theme === 'botanical' ? "'Cormorant Garamond', serif" : "'Playfair Display', serif";

		return `
			<!DOCTYPE html>
			<html>
			<head>
				<meta charset="utf-8">
				<title>Segnaposto Matrimonio — Foglio di Stampa</title>
				<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Cormorant+Garamond:wght@600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
				<style>
					@page { size: A4 portrait; margin: 10mm; }
					* { box-sizing: border-box; }
					body { margin: 0; padding: 0; font-family: ${fontFamily}; background: #fff; }
					.header-info { border-bottom: 2px solid #333; padding-bottom: 6px; margin-bottom: 16px; text-align: center; }
					.cards-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; }
					.card-item { background: ${bgStyle}; border: 1.5px solid ${borderColor}; position: relative; page-break-inside: avoid; break-inside: avoid; display: flex; flex-direction: column; box-sizing: border-box; }
					.tent-card { height: 95mm; }
					.tent-top-flap { flex: 1; border-bottom: 1px dashed #888; display: flex; align-items: center; justify-content: center; font-size: 8pt; color: #666; font-family: sans-serif; text-transform: uppercase; }
					.tent-bottom-face { flex: 1.25; padding: 12px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; position: relative; }
					.flat-card { height: 50mm; padding: 12px; justify-content: center; align-items: center; text-align: center; }
					.tablenum-card { height: 130mm; padding: 20px; justify-content: center; align-items: center; text-align: center; }
					.guest-name { font-size: 15pt; margin: 0 0 2px 0; font-weight: 700; }
					.divider { width: 32px; height: 1.5px; background: ${borderColor}; margin: 4px auto; }
					.table-num { font-size: 9.5pt; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin: 2px 0 0 0; color: ${borderColor}; }
					.meal-badge { position: absolute; bottom: 6px; right: 8px; font-size: 13pt; }
					@media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } .card-item { page-break-inside: avoid !important; } }
				</style>
			</head>
			<body>
				<div class="header-info">
					<h1 style="font-size:16pt; margin:0;">Segnaposto Matrimonio — Manage.Wedding</h1>
					<p style="margin:0; font-size:8.5pt; color:#555;">Totale ospiti: ${seatedGuestList.length}</p>
				</div>
				<div class="cards-grid">${cardsHtml}</div>
			</body>
			</html>
		`;
	}

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const cardType = selectCardType.value;
		const theme = selectBorderTheme.value;
		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;
		let cardsHtml = '';

		if (cardType === 'tablenum') {
			const uniqueTables = [...new Set(seatedGuestList.map(g => g.table))];
			if (uniqueTables.length === 0) uniqueTables.push("1");
			uniqueTables.forEach(tbl => {
				cardsHtml += `
					<div class="card-item tablenum-card">
						<p style="font-size:11pt; letter-spacing:4px; margin:0 0 4px 0;">TAVOLO</p>
						<div style="font-size:46pt; font-weight:bold; margin:4px 0;">${tbl.replace(/[^0-9]/g, '') || tbl}</div>
						<div class="divider"></div>
						<p style="font-size:9.5pt; font-style:italic; margin:4px 0 0 0;">Benvenuti</p>
					</div>
				`;
			});
		} else if (cardType === 'tent') {
			seatedGuestList.forEach(g => {
				cardsHtml += `
					<div class="card-item tent-card">
						<div class="tent-top-flap"><span>✂️ LINEA DI PIEGA</span></div>
						<div class="tent-bottom-face">
							<h2 class="guest-name">${g.name}</h2>
							<div class="divider"></div>
							${showTable ? `<p class="table-num">TAVOLO ${g.table}</p>` : ''}
							${showMeal ? `<div class="meal-badge">${g.meal.split(' ')[0] || '🥩'}</div>` : ''}
						</div>
					</div>
				`;
			});
		} else {
			seatedGuestList.forEach(g => {
				cardsHtml += `
					<div class="card-item flat-card">
						<h2 class="guest-name">${g.name}</h2>
						<div class="divider"></div>
						${showTable ? `<p class="table-num">TAVOLO ${g.table}</p>` : ''}
						${showMeal ? `<div class="meal-badge">${g.meal.split(' ')[0] || '🥩'}</div>` : ''}
					</div>
				`;
			});
		}

		const fullHtml = generatePrintDocHtml(cardsHtml, cardType, theme);
		const printWin = window.open('', '_blank');
		if (printWin) {
			printWin.document.open();
			printWin.document.write(fullHtml);
			printWin.document.close();
			printWin.focus();
			setTimeout(() => printWin.print(), 350);
		}
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const grouped = {};
		seatedGuestList.forEach(g => {
			const tbl = g.table || 'Senza Tavolo';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push(g);
		});

		let tablesHtml = '';
		Object.keys(grouped).forEach(tbl => {
			let rows = '';
			grouped[tbl].forEach(g => {
				rows += `<tr><td style="padding:6px; border:1px solid #cbd5e1;">${g.name}</td><td style="padding:6px; border:1px solid #cbd5e1;">${g.meal || 'Standard'}</td></tr>`;
			});
			tablesHtml += `
				<h3 style="color:#1e3a8a; margin-top:20px;">Tavolo: ${tbl} (${grouped[tbl].length} Ospiti)</h3>
				<table style="width:100%; border-collapse:collapse; margin-bottom:15px; font-size:12px;">
					<thead><tr style="background:#f1f5f9;"><th style="border:1px solid #cbd5e1; padding:6px; text-align:left;">Ospite</th><th style="border:1px solid #cbd5e1; padding:6px; text-align:left;">Scelta Menù</th></tr></thead>
					<tbody>${rows}</tbody>
				</table>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head><meta charset="utf-8"><title>Manifesto Tavoli e Menù</title></head>
			<body style="font-family:Arial, sans-serif; padding:20px;">
				<h1>Manage.Wedding — Manifesto Ufficiale Tavoli e Servizio Sala</h1>
				<p>Data: ${new Date().toLocaleDateString()} | Totale Ospiti: <strong>${seatedGuestList.length}</strong></p>
				${tablesHtml}
			</body>
			</html>
		`;
		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Segnaposto_Manifesto_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Nome Ospite,Tavolo,Menu\n";
		seatedGuestList.forEach(g => { csv += `"${g.name}","Tavolo ${g.table}","${g.meal || 'Standard'}"\n`; });
		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Segnaposto_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	loadSeatedGuests();
</script>
