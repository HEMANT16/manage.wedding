---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-dessert-table-calculator/#webapp",
      "name": "Calcolatore Tavolo dei Dolci, Confettata & Candy Bar Matrimonio",
      "url": "https://manage.wedding/it/wedding-dessert-table-calculator",
      "description": "Calcolatore interattivo gratuito per tavolo dei dolci di matrimonio, buffet di pasticceria mignon, confettata e candy bar. Calcola mignon per invitato, dozzine da ordinare in pasticceria, chili di confetti e scarica cartelli stampabili 8x10 'L'amore è dolce' e ordini pasticceria in PDF e Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come Calcolare Quantità di Dolci Mignon, Confettata e Pasticceria per Matrimonio",
      "description": "Guida passo dopo passo per calcolare pezzi di pasticceria mignon, chili di confetti per confettata, alzate e dozzine per pasticceria.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Fase 1: Scegli il formato del buffet di dolci",
          "text": "Definisci se i dolci mignon affiancano la torta nuziale tradizionale (2–3 pezzi a persona), sostituiscono la torta (4–6 pezzi a persona), tavolo dei biscotti tradizionali o confettata al chilo (120g–160g a persona)."
        },
        {
          "@type": "HowToStep",
          "name": "Fase 2: Bilancia varietà e dozzine di pasticceria",
          "text": "Seleziona da 4 a 8 varietà (cannoli mignon, macarons, tartellette, bicchierini di mousse, babà, bignè) e converti i pezzi in dozzine commerciali per il laboratorio di pasticceria."
        },
        {
          "@type": "HowToStep",
          "name": "Fase 3: Dimensiona vasi in vetro, palette e sacchetti",
          "text": "Calcola il peso totale dei confetti in kg, disponi le alzate in vetro su 3 livelli di altezza e calcola i coni o sacchettini con un margine del 15%."
        },
        {
          "@type": "HowToStep",
          "name": "Fase 4: Esporta cartelli cornice e foglio d'ordine per pasticceria",
          "text": "Genera cartelli per cornice (8x10 / 5x7), cavalieri segnagusto con allergeni (Senza Glutine, Vegano) e scarica il preventivo d'ordine in PDF e Word."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanti pezzi di pasticceria mignon si calcolano a persona per un matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Se il tavolo dei dolci accompagna la torta nuziale classica, si calcolano da 2 a 3 pezzi di pasticceria mignon per invitato. Se il buffet di dolci sostituisce la torta nuziale, calcola da 4 a 6 pezzi a persona per permettere agli invitati di assaggiare più gusti."
          }
        },
        {
          "@type": "Question",
          "name": "Quante varietà di dolci mignon bisogna scegliere?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per 50–75 invitati proponi 3 o 4 varietà. Per 75–125 invitati 4 o 5 varietà. Per 125–200 invitati 5 o 7 varietà. Oltre i 200 invitati massimo 6–8 varietà. Troppe varietà creano confusione e causano l'esaurimento lampo delle opzioni più amate."
          }
        },
        {
          "@type": "Question",
          "name": "Quanti chili di confetti servono per la confettata di matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Si calcolano da 120g a 160g di confetti per invitato (circa 10-15 confetti a persona). Per 100 invitati occorrono circa 12–15 kg di confetti divisi in 6–8 gusti differenti disposti in vasi e coppe di vetro."
          }
        },
        {
          "@type": "Question",
          "name": "Quali dolci soffrono il caldo nei matrimoni estivi all'aperto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La crema pasticcera e la panna fresca si deteriorano rapidamente con temperature superiori a 24°C. I cannoli mignon perdono croccantezza se farciti molte ore prima. I macarons temono l'umidità dell'aria. Per nozze estive prediligi crostate, sablé, mini capresi, cake pops e confetti classici."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Tavolo dei Dolci, Confettata & Candy Bar Matrimonio (PDF Gratis) | Manage.Wedding"
	description="Calcola le quantità esatte di pasticceria mignon, dozzine per la pasticceria, chili di confetti per confettata e vasi in vetro. Cartelli 8x10 'L'amore è dolce', cavalieri di buffet e ordini in PDF & Word."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Tavolo dei Dolci & Confettata" category="food-dining" />
		
		<!-- Hero Section -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🧁</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratuito • Calcolo Interattivo • Cartelli & Ordine Pasticceria in PDF</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calcolatore Tavolo dei Dolci, Confettata & Candy Bar
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 760px; margin: 0 auto; text-align: center;">
					Calcola le porzioni esatte di pasticceria mignon, i chili di confetti per la confettata, i vasi in vetro e le dozzine per la pasticceria. Personalizza le varietà, crea <strong>Cartelli Stampabili 8x10 "L'amore è dolce"</strong>, cavalieri segnagusto e scarica il tuo <strong>Ordine per la Pasticceria</strong> in PDF e Word!
				</p>
			</div>
		</section>

		<!-- Guida in 3 passi -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>✨</span> Come Dimensionare il Buffet dei Dolci in 3 Semplici Passi
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Scegli il Formato
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Insieme alla torta nuziale (2–3 pz/persona), in sostituzione della torta (4–6 pz/persona), o confettata con sacchetti al chilo.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Bilancia Varietà e Dozzine
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Scegli i tuoi mignon preferiti (cannoli, macarons, bicchierini, tartellette) e calcola automaticamente le dozzine per il pasticciere.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Stampa Cartelli e Ordine
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Genera cartelli con cornice (8x10 / 5x7), cavalieri di buffet con allergeni e scarica il foglio d'ordine in PDF e Word.
					</p>
				</div>
			</div>
		</div>

		<!-- Interactive Application Workspace -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SEZIONE 1: Invitati e Formato -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🍰 1. Configurazione Invitati & Formato Buffet
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Imposta il numero di ospiti confermati, l'appetito e lo stile di servizio
						</span>
					</div>
					<span id="badge-variety-rec" class="badge-postit" style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); padding: 4px 10px; border: 1.5px solid var(--fg-pencil); border-radius: 6px;">
						Consigliato: 4–5 Varietà
					</span>
				</div>

				<!-- Selettore Formato -->
				<div style="margin-bottom: 1.5rem;">
					<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1rem; color: var(--fg-pencil);">
						Seleziona il Tipo di Tavolo dei Dolci:
					</label>
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.75rem;" id="format-tabs-container">
						
						<label class="format-tab active" data-format="with-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fef08a; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="with-cake" checked style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🎂 + 🧁</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Insieme alla Torta</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">2–3 pezzi/invitato</span>
						</label>

						<label class="format-tab" data-format="no-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="no-cake" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🧁✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Al Posto della Torta</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">4–6 pezzi/invitato</span>
						</label>

						<label class="format-tab" data-format="cookie-table" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="cookie-table" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍪📦</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Buffet di Biscotti</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">6–8 biscotti + scatoline</span>
						</label>

						<label class="format-tab" data-format="candy-buffet" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="candy-buffet" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍬🍭</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Confettata & Candy Bar</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">120g–160g / invitato</span>
						</label>

						<label class="format-tab" data-format="hybrid" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="hybrid" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">👑✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Gran Buffet dei Dolci</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">Mignon + Confettata</span>
						</label>
					</div>
				</div>

				<!-- Invitati e Appetito -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
					
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="input-guests" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								👥 Numero di Invitati:
							</label>
							<span id="badge-guests" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 2px 10px; border-radius: 12px; font-size: 0.9rem;">
								100 Invitati
							</span>
						</div>
						<input type="range" id="slider-guests" min="20" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="input-guests" min="10" max="1000" value="100" class="form-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 1rem; font-weight: 600; background: #fff;">
						</div>
					</div>

					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<label for="select-appetite" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🍽️ Contesto del Banchetto & Appetito:
						</label>
						<select id="select-appetite" style="width: 100%; padding: 0.6rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.95rem; font-weight: 600; background: #fff; margin-bottom: 0.5rem;">
							<option value="light">Leggero (Dopo pranzo di 4 portate strutturato)</option>
							<option value="standard" selected>Standard (Equilibrato: 2.5 pezzi / 135g confetti)</option>
							<option value="generous">Golosi & Open Bar (Amanti dei dolci e festa notturna)</option>
						</select>
						<div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
							<input type="checkbox" id="chk-takeaway-favors" style="width: 18px; height: 18px; accent-color: var(--accent-blue);">
							<label for="chk-takeaway-favors" class="font-body" style="font-size: 0.85rem; color: var(--fg-pencil); cursor: pointer;">
								<strong>Includi Sacchettini / Scatoline Bomboniera</strong> (+2 pezzi / +80g confetti a testa)
							</label>
						</div>
					</div>

				</div>

				<!-- Statistiche Principali -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
					
					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Totale Mignon</span>
						<strong id="stat-total-pieces" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red); line-height: 1.2;">250</strong>
						<span id="stat-pieces-per-guest" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(2.5 pz / invitato)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Dozzine Pasticceria</span>
						<strong id="stat-total-dozens" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); line-height: 1.2;">21 Doz</strong>
						<span id="stat-exact-dozens" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(252 pezzi totali)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Chili di Confetti</span>
						<strong id="stat-total-candy" class="font-heading" style="font-size: 1.8rem; color: #16a34a; line-height: 1.2;">12.7 kg</strong>
						<span id="stat-candy-kg" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(28 lbs / 6–8 Vasi)</span>
					</div>

					<div style="text-align: center; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Allestimento Tavolo</span>
						<strong id="stat-table-size" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); line-height: 1.2;">Tavolo 2.0–2.4 m</strong>
						<span id="stat-napkins-count" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">150 tovagliolini cocktail</span>
					</div>

				</div>
			</div>

			<!-- SEZIONE 2: Varietà Mignon e Dozzine -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🧁 2. Varietà di Pasticceria & Dozzine da Ordinare
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Regola i quantitativi per gusto e visualizza le dozzine per il pasticciere
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
						<button type="button" id="btn-auto-balance" class="hand-btn" style="background: var(--post-it); font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 700; display: inline-flex; align-items: center; gap: 0.3rem;">
							<span>⚖️</span> Auto-Bilanciamento
						</button>
						<button type="button" id="btn-reset-varieties" class="hand-btn" style="background: #fff; font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 600;">
							🔄 Ripristina
						</button>
					</div>
				</div>

				<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; font-size: 0.85rem;">
						<span><strong>Pezzi Assegnati:</strong> <span id="label-allocated-pieces">250</span> / <span id="label-target-pieces">250</span> Obiettivo</span>
						<span id="label-allocation-status" style="font-weight: 700; color: #16a34a;">✅ Perfettamente Bilanciato</span>
					</div>
					<div style="width: 100%; height: 10px; background: #e2e8f0; border-radius: 5px; overflow: hidden; border: 1px solid var(--fg-pencil);">
						<div id="bar-allocation-progress" style="width: 100%; height: 100%; background: #16a34a; transition: width 0.3s ease, background-color 0.3s ease;"></div>
					</div>
				</div>

				<div id="dessert-items-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
				</div>

				<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 6px; padding: 1rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between;">
					<div style="display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 240px;">
						<span style="font-size: 1.2rem;">➕</span>
						<input type="text" id="input-new-item-name" placeholder="Nome Dolce Personalizzato (es. Babà Mignon)" class="form-input" style="flex: 1; padding: 0.5rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.9rem; background: #fff;">
