---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/master-budget-calculator/#webapp",
      "name": "Calcolatore Budget Matrimonio Master",
      "url": "https://manage.wedding/it/master-budget-calculator",
      "inLanguage": "it",
      "description": "Calcolatore gratuito per il budget di matrimonio: ripartizione percentuale delle spese tra location, catering, foto, abiti e allestimenti con export Word, PDF ed Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come creare e ripartire il budget del matrimonio",
      "description": "Guida passo-passo per calcolare e distribuire il fondo nozze tra location, banchetto, fotografo, abiti e fondo imprevisti.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Stabilire il budget totale complessivo",
          "text": "Somma i risparmi personali, il risparmio mensile programmato e gli eventuali contributi delle famiglie per definire il tetto massimo di spesa."
        },
        {
          "@type": "HowToStep",
          "name": "2. Destinare il 45–50% a Location e Banchetto",
          "text": "Riserva circa metà del budget per affitto della villa/castello, aperitivo a buffet, menù servito, torta e open bar."
        },
        {
          "@type": "HowToStep",
          "name": "3. Assegnare il 12–15% a Fotografia e Video",
          "text": "Pianifica la spesa per fotografo professionista, secondo operatore, video con drone e album di nozze."
        },
        {
          "@type": "HowToStep",
          "name": "4. Distribuire Abiti, Fiori e Musica",
          "text": "Assegna circa il 9% per abiti e trucco, l'8% per gli allestimenti floreali e il 7% per musica e diritti SIAE."
        },
        {
          "@type": "HowToStep",
          "name": "5. Mantenere un 4–5% per il Fondo Imprevisti",
          "text": "Conserva sempre una riserva liquida per spese extra dell'ultimo minuto, pasti per lo staff e imprevisti meteo."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual è la suddivisione percentuale ideale del budget di nozze?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La ripartizione standard consigliata è: 48% Location & Banchetto, 13% Foto & Video, 9% Abiti & Bellezza, 8% Fiori & Allestimenti, 7% Musica & SIAE, 4% Fedi Nuziali, 3% Partecipazioni, 2% Bomboniere & Confetti, 2% Trasporti, e 4% Fondo Imprevisti."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto incide il numero degli invitati sul costo totale del matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oltre il 55% delle spese totali di nozze è direttamente proporzionale al numero di persone (costo del menù a persona, open bar, bomboniere, partecipazioni e centrotavola). Ridurre la lista di soli 20 invitati può far risparmiare dai 2.500 € ai 4.500 €."
          }
        },
        {
          "@type": "Question",
          "name": "Come si esporta il budget calcolato in Excel, Word o PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Basta cliccare sui pulsanti 'Esporta Word (.doc)', 'Esporta PDF / Stampa' o 'Esporta Excel (.csv)' posizionati nella parte superiore della schermata per scaricare subito il riepilogo finanziario dettagliato."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Budget Matrimonio Master (Ripartizione Costi & Export Excel) | Manage.Wedding"
	description="Calcola e ripartisci facilmente il budget del tuo matrimonio: location, catering, foto, abiti e allestimenti con esportazione immediata in Word, PDF ed Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Calcolatore Budget Matrimonio" category="budget-finance" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calcolatore <span class="accent-italic">Budget Matrimonio</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Ripartisci i fondi per location, banchetto, fotografo e abiti. Calcola la spesa per singolo invitato ed esporta in <strong>Word (.doc)</strong>, <strong>PDF</strong> o <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- Budget Overview Dashboard & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div style="flex: 1; min-width: 250px;">
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💰 Pianificatore Finanziario Nozze
					</h2>
					<p class="font-body" style="color: var(--text-secondary); font-size: 0.9rem; margin: 0.2rem 0 0 0; text-align: center;">
						Modifica le percentuali ed esporta il tuo budget personalizzato
					</p>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; width: 100%;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Esporta Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Stampa / PDF
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Esporta Excel (.csv)
					</button>
					<button type="button" id="btn-reset-defaults" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						🔄 Valori Standard
					</button>
				</div>
			</div>

			<!-- Preset Budget Tiers -->
			<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
				<span class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
					⚡ Scenari di Budget Frequenti:
				</span>
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center;">
					<button type="button" class="tier-btn" data-amt="15000" data-guests="50">🪙 Nozze Intime (15.000 € • 50 Ospiti)</button>
					<button type="button" class="tier-btn active-tier" data-amt="35000" data-guests="120">💎 Media Italiana (35.000 € • 120 Ospiti)</button>
					<button type="button" class="tier-btn" data-amt="65000" data-guests="150">👑 Nozze Eleganti (65.000 € • 150 Ospiti)</button>
					<button type="button" class="tier-btn" data-amt="120000" data-guests="200">✨ Ricevimento Esclusivo (120.000 € • 200 Ospiti)</button>
				</div>
			</div>

			<!-- Core Global Inputs: Total Budget, Currency & Guest Count -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
				
				<!-- Total Budget -->
				<div>
					<label for="total-budget-input" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Budget Totale Matrimonio
					</label>
					<div style="display: flex; align-items: center; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; overflow: hidden;">
						<span id="currency-symbol-display" style="padding: 0.6rem 0.8rem; background: var(--bg-paper); border-right: 1px solid var(--fg-pencil); font-weight: bold; font-family: var(--font-heading);">€</span>
						<input type="number" id="total-budget-input" value="35000" min="500" step="500" style="flex: 1; border: none; padding: 0.6rem; font-family: var(--font-body); font-size: 1.2rem; font-weight: bold; outline: none; background: transparent;">
					</div>
				</div>

				<!-- Currency Selector -->
				<div>
					<label for="currency-select" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Valuta
					</label>
					<select id="currency-select" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.05rem; background: #fff;">
						<option value="€" selected>€ (EUR - Euro)</option>
						<option value="CHF">CHF (Franco Svizzero)</option>
						<option value="$">$ (USD / Dollaro)</option>
						<option value="£">£ (GBP - Sterlina)</option>
					</select>
				</div>

				<!-- Estimated Guest Count -->
				<div>
					<label for="guest-count-input" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
						Numero Stimato Invitati
					</label>
					<input type="number" id="guest-count-input" value="120" min="5" max="1000" style="width: 100%; box-sizing: border-box; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: #fff;">
				</div>

			</div>

			<!-- Dynamic Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Budget Totale</span>
					<strong id="stat-total-display" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">35.000 €</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">100% Ripartito</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Costo a Persona</span>
					<strong id="stat-per-guest" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">291,67 €</strong>
					<span id="stat-guest-count-note" style="font-size: 0.75rem; color: #1e40af; display: block;">Basato su 120 invitati</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Location & Banchetto (48%)</span>
					<strong id="stat-venue-amt" class="font-heading" style="font-size: 1.8rem; color: #15803d;">16.800 €</strong>
					<span style="font-size: 0.75rem; color: #166534; display: block;">Spesa principale</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Fondo Imprevisti (4%)</span>
					<strong id="stat-buffer-amt" class="font-heading" style="font-size: 1.8rem; color: #a16207;">1.400 €</strong>
					<span style="font-size: 0.75rem; color: #854d0e; display: block;">Riserva di sicurezza</span>
				</div>
			</div>

			<!-- Visual Stacked Expense Distribution Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Ripartizione Percentuale Visiva</span>
					<span id="pct-warning" class="font-body" style="font-size: 0.85rem; color: #15803d; font-weight: bold;">100% Ripartito (Perfetto)</span>
				</div>
				<div id="stacked-budget-bar" style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #e5e0d8; margin-bottom: 0.75rem;">
					<!-- Injected via JS -->
				</div>
			</div>

		</div>

		<!-- Interactive Category Allocation Grid -->
		<section style="margin-bottom: 3.5rem;">
			<h2 class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); text-align: center; margin-bottom: 0.5rem;">
				📊 Dettaglio delle Spese per Categoria
			</h2>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); text-align: center; max-width: 600px; margin: 0 auto 1.75rem;">
				Modifica i cursori percentuali o inserisci gli importi esatti. Tutte le categorie si aggiornano in tempo reale.
			</p>

			<div id="categories-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem;">
				<!-- Injected via JS -->
			</div>
		</section>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Prospetto Ufficiale Budget Matrimonio</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Data: <span id="print-date"></span> | Budget Totale: <span id="print-total"></span> | Quota per Invitato: <span id="print-per-guest"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Categoria</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 60px; text-align: center;">% Quota</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 100px; text-align: right;">Budget Assegnato</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Spese e Voci Incluse</th>
					</tr>
				</thead>
				<tbody id="print-table-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 2.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Regola a Colpo d'Occhio (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					La Formula di Ripartizione del Budget Nozze
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 750px; margin: 0 auto; font-weight: 500;">
					Ecco la formula di ripartizione rapida e la tabella comparativa per budget standard da 30.000 €, 50.000 € e 75.000 €.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 La Formula in 1 Minuto:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					48% Location & Banchetto + 13% Foto & Video + 9% Abiti & Bellezza + 8% Fiori & Allestimenti + 7% Musica & SIAE + 11% Fedi/Partecipazioni/Altro + 4% Fondo Imprevisti = 100% Budget
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 580px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Categoria di Spesa</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Quota %</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Budget 30.000 €</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Budget 50.000 €</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: right;">Budget 75.000 €</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Location & Banchetto</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">48%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">14.400 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">24.000 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">36.000 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Fotografia & Video</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">13%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">3.900 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">6.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">9.750 €</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #d97706;">Abiti & Bellezza</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">9%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">2.700 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">4.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">6.750 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a;">Fiori & Allestimenti</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">8%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">2.400 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">4.000 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">6.000 €</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed;">Musica, Intrattenimento & SIAE</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">7%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">2.100 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">3.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">5.250 €</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #475569;">Fedi, Partecipazioni & Bomboniere</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">11%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">3.300 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">5.500 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">8.250 €</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #0284c7;">Fondo Imprevisti & Extra</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: 600;">4%</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">1.200 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">2.000 €</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right;">3.000 €</td>
						</tr>
					</tbody>
					<tfoot>
						<tr style="background: var(--muted-paper); border-top: 2px solid var(--fg-pencil); font-weight: bold;">
							<td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Budget Totale Stimato</td>
							<td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">100%</td>
							<td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right; color: var(--accent-red);">30.000 €</td>
							<td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right; color: var(--accent-red);">50.000 €</td>
							<td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: right; color: var(--accent-red);">75.000 €</td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>

		<!-- SEO Article & Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Pianificazione Finanziaria</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					Guida Completa alla Ripartizione del Budget di Nozze
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					Come allocare ogni voce di spesa in modo realistico ed evitare debiti imprevisti.
				</p>
			</div>

			<!-- Section 1 -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. Perché il numero di invitati è la leva principale del budget
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1rem;">
					Molte coppie tentano di risparmiare riducendo le decorazioni floreali o rinunciando all'open bar. Tuttavia, <strong>oltre il 55% delle spese totali è strettamente legato al numero di persone</strong> (antipasti, primi e secondi serviti, bevande, bomboniere e coperti).
				</p>
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
					<p class="font-body" style="margin: 0; font-size: 1.05rem; line-height: 1.6;">
						💡 <strong>La Matematica:</strong> Con un costo medio di <strong>200 € – 300 € a persona</strong>, passare da 150 a 120 invitati genera un risparmio netto immediato di <strong>6.000 € – 9.000 €</strong>, senza dover rinunciare alla location o al fotografo dei propri sogni!
					</p>
				</div>
			</section>

			<!-- FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Domande Frequenti (FAQ)
				</h3>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						Come posso esportare questo budget in Excel o Word?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Basta cliccare su <strong>"📝 Esporta Word (.doc)"</strong> per scaricare una tabella formattata pronta per la stampa o su <strong>"📊 Esporta Excel (.csv)"</strong> per aprire i dati in Microsoft Excel o Fogli Google.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/it/master-budget-calculator" category="budget" />

	</main>
</Layout>

<style>
	.tier-btn {
		background: #fff;
		border: 1.5px solid var(--fg-pencil);
		border-radius: 4px;
		padding: 0.35rem 0.65rem;
		font-family: var(--font-heading);
		font-size: 0.85rem;
		cursor: pointer;
		transition: all 0.15s ease;
	}
	.tier-btn:hover {
		background: var(--muted-paper);
	}
	.tier-btn.active-tier {
		background: var(--accent-blue) !important;
		color: #fff !important;
		border-color: #1e40af !important;
	}

	.category-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 6px;
		padding: 1.1rem;
		box-shadow: 2px 2px 0 var(--fg-pencil);
		display: flex;
		flex-direction: column;
		transition: transform 0.15s ease;
	}
	.category-card:hover {
		transform: translateY(-2px);
		box-shadow: 4px 4px 0 var(--fg-pencil);
	}

	.print-only {
		display: none;
	}

	
</style>

<script is:inline>
	const categories = [
		{ id: 'venue', name: 'Location & Banchetto', defaultPct: 48, color: '#ffb3ba', desc: 'Affitto villa/castello, menù pranzo/cena, antipasti & open bar' },
		{ id: 'photo', name: 'Fotografia & Video', defaultPct: 13, color: '#bae1ff', desc: 'Servizio fotografico completo, video con drone & album' },
		{ id: 'attire', name: 'Abiti & Bellezza', defaultPct: 9, color: '#ffdfba', desc: 'Abito sposa, abito sposo, modifiche sartoriali, trucco & acconciatura' },
		{ id: 'florals', name: 'Fiori & Allestimenti', defaultPct: 8, color: '#baffc9', desc: 'Bouquet sposa, arco cerimonia, centrotavola & illuminazione' },
		{ id: 'entertain', name: 'Musica & Intrattenimento', defaultPct: 7, color: '#ffffba', desc: 'DJ set, musica cerimonia, band dal vivo & diritti SIAE' },
		{ id: 'rings', name: 'Fedi Nuziali & Celebrazione', defaultPct: 4, color: '#fbcfe8', desc: 'Fedi nuziali in oro, documenti & diritti comunali/religiosi' },
		{ id: 'stationery', name: 'Partecipazioni & Grafica', defaultPct: 3, color: '#e8baff', desc: 'Inviti, save-the-date, segnaposto, libretti messa & menù' },
		{ id: 'favors', name: 'Bomboniere & Confetti', defaultPct: 2, color: '#fed7aa', desc: 'Bomboniere per gli ospiti, sacchetti confetti & regali testimoni' },
		{ id: 'transport', name: 'Auto Sposi & Trasporti', defaultPct: 2, color: '#ccfbf1', desc: 'Noleggio auto d\'epoca o sportiva, navette per gli ospiti' },
		{ id: 'buffer', name: 'Fondo Imprevisti & Extra', defaultPct: 4, color: '#e5e7eb', desc: 'Spese impreviste dell\'ultimo minuto, pasti staff & mance' }
	];

	let userPcts = {};
	categories.forEach(c => { userPcts[c.id] = c.defaultPct; });

	let currencySymbol = '€';

	const totalBudgetInput = document.getElementById('total-budget-input');
	const guestCountInput = document.getElementById('guest-count-input');
	const currencySelect = document.getElementById('currency-select');
	const currencySymbolDisplay = document.getElementById('currency-symbol-display');

	const statTotalDisplay = document.getElementById('stat-total-display');
	const statPerGuest = document.getElementById('stat-per-guest');
	const statGuestCountNote = document.getElementById('stat-guest-count-note');
	const statVenueAmt = document.getElementById('stat-venue-amt');
	const statBufferAmt = document.getElementById('stat-buffer-amt');

	const pctWarning = document.getElementById('pct-warning');
	const stackedBudgetBar = document.getElementById('stacked-budget-bar');
	const categoriesGrid = document.getElementById('categories-grid');

	function formatMoney(amount) {
		return `${Math.round(amount).toLocaleString('it-IT')} ${currencySymbol}`;
	}

	function calculateBudget() {
		const total = parseFloat(totalBudgetInput.value) || 0;
		const guests = parseInt(guestCountInput.value) || 1;
		currencySymbol = currencySelect.value;
		currencySymbolDisplay.textContent = currencySymbol;

		let totalPct = 0;
		categories.forEach(c => {
			totalPct += (parseFloat(userPcts[c.id]) || 0);
		});

		statTotalDisplay.textContent = formatMoney(total);
		const perGuestCost = guests > 0 ? (total / guests) : 0;
		statPerGuest.textContent = `${perGuestCost.toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${currencySymbol}`;
		statGuestCountNote.textContent = `Basato su ${guests} invitati`;

		const venueAmt = total * ((parseFloat(userPcts['venue']) || 0) / 100);
		statVenueAmt.textContent = formatMoney(venueAmt);

		const bufferAmt = total * ((parseFloat(userPcts['buffer']) || 0) / 100);
		statBufferAmt.textContent = formatMoney(bufferAmt);

		if (Math.round(totalPct) === 100) {
			pctWarning.textContent = '100% Ripartito (Budget Perfetto)';
			pctWarning.style.color = '#15803d';
		} else if (totalPct > 100) {
			pctWarning.textContent = `⚠️ Ripartizione in eccesso (${totalPct}% - riduci del ${totalPct - 100}%)`;
			pctWarning.style.color = 'var(--accent-red)';
		} else {
			pctWarning.textContent = `Da assegnare (${totalPct}% - rimane il ${100 - totalPct}%)`;
			pctWarning.style.color = '#a16207';
		}

		stackedBudgetBar.innerHTML = '';
		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const displayPct = totalPct > 0 ? (pct / totalPct) * 100 : 0;

			if (displayPct > 0) {
				const seg = document.createElement('div');
				seg.style.cssText = `height: 100%; width: ${displayPct}%; background-color: ${c.color}; border-right: 1px solid var(--fg-pencil); transition: width 0.3s ease;`;
				seg.title = `${c.name}: ${pct}% (${formatMoney(total * (pct / 100))})`;
				stackedBudgetBar.appendChild(seg);
			}
		});

		if (stackedBudgetBar.lastChild) {
			stackedBudgetBar.lastChild.style.borderRight = 'none';
		}

		categories.forEach(c => {
			const amtEl = document.getElementById(`amt-${c.id}`);
			const pctInputEl = document.getElementById(`pct-input-${c.id}`);
			const rangeEl = document.getElementById(`range-${c.id}`);
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);

			if (amtEl) amtEl.textContent = formatMoney(amt);
			if (pctInputEl && document.activeElement !== pctInputEl) pctInputEl.value = pct;
			if (rangeEl && document.activeElement !== rangeEl) rangeEl.value = pct;
		});
	}

	function renderCategoryCards() {
		categoriesGrid.innerHTML = '';
		const total = parseFloat(totalBudgetInput.value) || 0;

		categories.forEach(c => {
			const card = document.createElement('div');
			card.className = 'category-card';

			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);

			card.innerHTML = `
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
					<div style="display: flex; align-items: center; gap: 0.4rem;">
						<span style="width: 14px; height: 14px; background-color: ${c.color}; border: 1.5px solid var(--fg-pencil); border-radius: 3px; display: inline-block;"></span>
						<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil);">${c.name}</strong>
					</div>
					<strong id="amt-${c.id}" class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil);">${formatMoney(amt)}</strong>
				</div>

				<p class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); margin: 0 0 0.75rem 0; line-height: 1.3;">
					${c.desc}
				</p>

				<div style="display: flex; align-items: center; gap: 0.75rem; margin-top: auto;">
					<input type="range" id="range-${c.id}" min="0" max="70" step="1" value="${pct}" style="flex: 1; accent-color: var(--fg-pencil); cursor: pointer;" oninput="updateCatPct('${c.id}', this.value)">
					<div style="display: flex; align-items: center; gap: 0.2rem;">
						<input type="number" id="pct-input-${c.id}" min="0" max="100" step="0.5" value="${pct}" style="width: 50px; padding: 3px 5px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; text-align: center;" oninput="updateCatPct('${c.id}', this.value)">
						<span style="font-size: 0.9rem; font-weight: bold;">%</span>
					</div>
				</div>
			`;

			categoriesGrid.appendChild(card);
		});
	}

	window.updateCatPct = function(id, val) {
		userPcts[id] = parseFloat(val) || 0;
		calculateBudget();
	};

	totalBudgetInput.addEventListener('input', calculateBudget);
	guestCountInput.addEventListener('input', calculateBudget);
	currencySelect.addEventListener('change', calculateBudget);

	document.querySelectorAll('.tier-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.tier-btn').forEach(b => b.classList.remove('active-tier'));
			btn.classList.add('active-tier');

			totalBudgetInput.value = btn.getAttribute('data-amt');
			guestCountInput.value = btn.getAttribute('data-guests');
			calculateBudget();
		});
	});

	document.getElementById('btn-reset-defaults').addEventListener('click', () => {
		categories.forEach(c => { userPcts[c.id] = c.defaultPct; });
		renderCategoryCards();
		calculateBudget();
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const total = parseFloat(totalBudgetInput.value) || 0;
		const guests = parseInt(guestCountInput.value) || 1;

		let rows = '';
		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);
			rows += `
				<tr>
					<td style="border:1px solid #ccc; padding:8px; font-weight:bold;">${c.name}</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:center;">${pct}%</td>
					<td style="border:1px solid #ccc; padding:8px; text-align:right; font-weight:bold;">${formatMoney(amt)}</td>
					<td style="border:1px solid #ccc; padding:8px; color:#555;">${c.desc}</td>
				</tr>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Prospetto Budget Matrimonio</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Prospetto Ufficiale Budget Matrimonio</h1>
				<p>Generato il ${new Date().toLocaleDateString('it-IT')} | Budget Totale: <strong>${formatMoney(total)}</strong> | Invitati: ${guests} | Costo a Persona: <strong>${formatMoney(total / guests)}</strong></p>
				<table>
					<thead>
						<tr>
							<th>Categoria</th>
							<th style="text-align:center;">% Quota</th>
							<th style="text-align:right;">Importo Assegnato</th>
							<th>Spese Incluse</th>
						</tr>
					</thead>
					<tbody>
						${rows}
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Budget_Matrimonio_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const total = parseFloat(totalBudgetInput.value) || 0;
		const guests = parseInt(guestCountInput.value) || 1;

		document.getElementById('print-date').textContent = new Date().toLocaleDateString('it-IT');
		document.getElementById('print-total').textContent = formatMoney(total);
		document.getElementById('print-per-guest').textContent = `${formatMoney(total / guests)} (${guests} Invitati)`;

		const tbody = document.getElementById('print-table-body');
		tbody.innerHTML = '';

		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);

			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="border: 1px solid #ccc; padding: 6px; font-weight: bold;">${c.name}</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: center;">${pct}%</td>
				<td style="border: 1px solid #ccc; padding: 6px; text-align: right; font-weight: bold;">${formatMoney(amt)}</td>
				<td style="border: 1px solid #ccc; padding: 6px; color: #555;">${c.desc}</td>
			`;
			tbody.appendChild(tr);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const total = parseFloat(totalBudgetInput.value) || 0;
		let csv = "Categoria,Quota Percentuale,Budget Assegnato,Spese Incluse\n";
		categories.forEach(c => {
			const pct = parseFloat(userPcts[c.id]) || 0;
			const amt = total * (pct / 100);
			csv += `"${c.name}",${pct}%,${Math.round(amt)},"${(c.desc||'').replace(/"/g, '""')}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Budget_Matrimonio_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	renderCategoryCards();
	calculateBudget();
</script>
