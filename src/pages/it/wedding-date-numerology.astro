---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-date-numerology/#webapp",
      "name": "Calcolatore Numerologia Data di Matrimonio & Affinità di Coppia",
      "url": "https://manage.wedding/it/wedding-date-numerology",
      "inLanguage": "it",
      "description": "Calcola la numerologia della data di matrimonio e il cammino di vita della coppia. Scopri l'archetipo simbolico delle nozze e il punteggio di affinità.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come calcolare la numerologia della data di matrimonio",
      "description": "Metodo per sommare le cifre di nascita e della data nuziale per ottenere i numeri radice.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Calcolare il Cammino di Vita dello Sposo e della Sposa",
          "text": "Somma tutte le cifre della data di nascita fino a ridurle a una singola cifra da 1 a 9."
        },
        {
          "@type": "HowToStep",
          "name": "2. Calcolare il Numero della Data di Matrimonio",
          "text": "Somma giorno, mese e anno delle nozze (es. 14 Ottobre 2026 = 1+4 + 1+0 + 2+0+2+6 = 16 = 1+6 = 7)."
        },
        {
          "@type": "HowToStep",
          "name": "3. Interpretare l'archetipo di coppia",
          "text": "Scopri i punti di forza energetici e l'atmosfera simbolica del vostro matrimonio."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Cos'è la numerologia della data di matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "È l'antica pratica che analizza l'energia simbolica della data nuziale riducendo giorno, mese e anno a un singolo numero radice da 1 a 9."
          }
        },
        {
          "@type": "Question",
          "name": "Quali sono i numeri più fortunati per sposarsi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "I numeri tradizionalmente più associati all'amore e all'armonia di coppia sono il 2 (unione e complicità) e il 6 (famiglia, dolcezza e protezione)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Numerologia Data di Matrimonio & Affinità di Coppia | Manage.Wedding"
	description="Scopri il significato numerologico della data delle tue nozze e il punteggio di affinità spirituale. Calcola il numero del cammino di vita degli sposi e l'archetipo del matrimonio."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Numerologia Data di Matrimonio" category="stationery" />
		
		<section class="section-paper fade-in" style="min-height: 100vh; padding: 2rem 1rem;">
			<div style="max-width: 800px; margin: 0 auto;">
				
				<div class="hand-card" style="margin-bottom: 2rem; background: #fff;">
					<div class="tape" style="margin: 0 auto 1rem;"></div>
					<h1 class="font-heading" style="text-align: center; color: var(--fg-pencil); font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 1rem;">
						Numerologia Data di Matrimonio
					</h1>
					<p class="font-body" style="text-align: center; color: var(--text-secondary); margin-bottom: 2rem; font-size: 1.15rem;">
						Inserisci le date di nascita degli sposi e la data programmata per le nozze per rivelare l'archetipo della vostra unione e il punteggio di affinità!
					</p>
					
					<form id="numerology-form" style="display: flex; flex-direction: column; gap: 1.5rem;">
						<div>
							<label for="partner1" class="font-heading" style="display: block; margin-bottom: 0.5rem; color: var(--accent-blue); font-size: 1.1rem;">Data di Nascita Sposo / Partner 1</label>
							<input type="date" id="partner1" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: transparent; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<div>
							<label for="partner2" class="font-heading" style="display: block; margin-bottom: 0.5rem; color: var(--accent-red); font-size: 1.1rem;">Data di Nascita Sposa / Partner 2</label>
							<input type="date" id="partner2" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: transparent; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<div>
							<label for="wedding-date" class="font-heading" style="display: block; margin-bottom: 0.5rem; color: var(--fg-pencil); font-size: 1.1rem;">Data Programmata delle Nozze</label>
							<input type="date" id="wedding-date" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); background: transparent; font-family: inherit; color: var(--fg-pencil); font-size: 1rem; border-radius: 4px;" />
						</div>
						<button type="submit" class="hand-btn" style="width: 100%; font-size: 1.25rem; margin-top: 1rem; justify-content: center; padding: 14px;">
							✨ Rivela l'Affinità Numerologica
						</button>
					</form>
				</div>

				<!-- Results Box -->
				<div id="result-box" class="hand-card" style="margin-bottom: 3rem; background: #fffcf5;">
					<h2 class="font-heading" style="color: var(--fg-pencil); margin-bottom: 1rem; font-size: 2rem; text-align: center;">
						Il Vostro Profilo Numerologico
					</h2>
					<div id="initial-message" class="font-body" style="color: var(--text-secondary); font-style: italic; text-align: center;">
						Compila il modulo sopra per calcolare i numeri della vostra data speciale!
					</div>
					
					<div id="results-content" style="display: none;">
						<div style="margin-bottom: 1.5rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<h3 class="font-heading" style="color: var(--accent-blue); font-size: 1.25rem; margin: 0 0 0.4rem 0;">Cammino di Vita Partner 1: Numero <span id="p1-number"></span></h3>
							<p id="p1-desc" class="font-body" style="color: var(--fg-pencil); margin: 0; line-height: 1.5;"></p>
						</div>
						
						<div style="margin-bottom: 1.5rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<h3 class="font-heading" style="color: var(--accent-red); font-size: 1.25rem; margin: 0 0 0.4rem 0;">Cammino di Vita Partner 2: Numero <span id="p2-number"></span></h3>
							<p id="p2-desc" class="font-body" style="color: var(--fg-pencil); margin: 0; line-height: 1.5;"></p>
						</div>
						
						<div style="margin-bottom: 2rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<h3 class="font-heading" style="color: #16a34a; font-size: 1.25rem; margin: 0 0 0.4rem 0;">Archetipo della Data di Nozze: Numero <span id="wd-number"></span></h3>
							<p id="wd-desc" class="font-body" style="color: var(--fg-pencil); margin: 0; line-height: 1.5;"></p>
						</div>
						
						<div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1.5rem; text-align: center;">
							<h3 class="font-heading" style="color: var(--fg-pencil); font-size: 1.6rem; margin-bottom: 0.5rem;">Punteggio di Affinità: <span id="comp-score"></span>%</h3>
							
							<div style="width: 100%; height: 24px; border: 2px solid var(--fg-pencil); border-radius: 12px; overflow: hidden; margin: 1rem 0; position: relative; background: #eee;">
								<div id="gauge-fill" style="width: 0%; height: 100%; background: var(--accent-blue); transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);"></div>
							</div>
							
							<p id="comp-desc" class="font-body" style="font-style: italic; color: var(--fg-pencil); font-size: 1.1rem; margin: 0.5rem 0 0 0;"></p>
						</div>
					</div>
				</div>

				<!-- SEO Article -->
				<article class="hand-card" style="margin-bottom: 2rem; padding: clamp(1.5rem, 4vw, 3rem);">
					<h2 class="font-heading" style="color: var(--fg-pencil); font-size: 2rem; margin-bottom: 1.5rem; text-align: center;">
						Il Significato Numerico della Data del Matrimonio
					</h2>
					<p class="font-body" style="line-height: 1.7; font-size: 1.05rem; margin-bottom: 1rem;">
						La numerologia analizza l'energia simbolica dei numeri per svelare l'atmosfera e le caratteristiche uniche di una coppia. Scegliere con consapevolezza la data delle nozze aggiunge un tocco romantico e poetico all'inizio di una nuova vita insieme.
					</p>
				</article>

			</div>
		</section>

		<RelatedTools currentPath="/it/wedding-date-numerology" category="stationery" />
	</main>
</Layout>

<script is:inline>
	const descriptions = {
		1: "Il Leader / Pioniere: Energia di indipendenza, determinazione e nuovi inizi. Una coppia forte e intraprendente che costruisce la propria strada con coraggio.",
		2: "L'Armonia / Il Partner: Armonia, intesa profonda, diplomazia ed empatia. Un legame d'anime sincero, sereno e fondato sul rispetto reciproco.",
		3: "La Creatività / La Gioia: Comunicazione vivace, risate contagiose e ottimismo. Una vita di coppia festosa e ricca di stimoli artistici.",
		4: "Il Costruttore / La Stabilità: Radici solide, lealtà indistruttibile e sicurezza. Una famiglia forte e protetta, duratura nel tempo.",
		5: "L'Avventuriero: Spirito libero, passione per i viaggi e continuo rinnovamento. Un'avventura entusiasmante e mai noiosa.",
		6: "Il Custode / L'Amore Familiare: Dolcezza, dedizione totale alla famiglia e calore domestico. L'archetipo ideale per un matrimonio ricco d'affetto.",
		7: "Il Saggio / La Spiritualità: Connessione profonda, complicità mentale e ricerca di significato autentico oltre le apparenze.",
		8: "Il Successo / La Prosperità: Ambizione condivisa, abbondanza, sicurezza economica e grandi traguardi raggiunti insieme.",
		9: "L'Umanitario / L'Amore Universale: Altruismo, grande generosità e amore incondizionato che ispira amici e parenti."
	};

	function reduceDate(dateString) {
		if (!dateString) return 0;
		let sum = dateString.replace(/\D/g, '').split('').reduce((acc, digit) => acc + parseInt(digit), 0);
		while (sum > 9) {
			sum = sum.toString().split('').reduce((acc, digit) => acc + parseInt(digit), 0);
		}
		return sum || 1; 
	}

	const form = document.getElementById('numerology-form');
	if (form) {
		form.addEventListener('submit', function(e) {
			e.preventDefault();
			
			const p1Input = document.getElementById('partner1');
			const p2Input = document.getElementById('partner2');
			const wdInput = document.getElementById('wedding-date');
			
			if (!p1Input.value || !p2Input.value || !wdInput.value) return;
			
			const p1Num = reduceDate(p1Input.value);
			const p2Num = reduceDate(p2Input.value);
			const wdNum = reduceDate(wdInput.value);
			
			const initialMsg = document.getElementById('initial-message');
			const resultsContent = document.getElementById('results-content');
			
			if (initialMsg) initialMsg.style.display = 'none';
			if (resultsContent) resultsContent.style.display = 'block';
			
			document.getElementById('p1-number').textContent = p1Num.toString();
			document.getElementById('p1-desc').textContent = descriptions[p1Num];
			
			document.getElementById('p2-number').textContent = p2Num.toString();
			document.getElementById('p2-desc').textContent = descriptions[p2Num];
			
			document.getElementById('wd-number').textContent = wdNum.toString();
			document.getElementById('wd-desc').textContent = descriptions[wdNum];
			
			const seed = (p1Num * 3 + p2Num * 7 + wdNum * 5);
			const score = Math.floor((seed % 26) + 75);
			
			document.getElementById('comp-score').textContent = score.toString();
			
			const gaugeFill = document.getElementById('gauge-fill');
			if (gaugeFill) {
				gaugeFill.style.width = '0%';
				setTimeout(() => {
					gaugeFill.style.width = score + '%';
				}, 50);
			}
			
			const compDesc = document.getElementById('comp-desc');
			if (compDesc) {
				if (score >= 95) {
					compDesc.textContent = "Un'affinità cosmica eccezionale! Le vostre energie sono in perfetta sintonia per un cammino meraviglioso insieme.";
				} else if (score >= 85) {
					compDesc.textContent = "Una splendida connessione basata su profonda armonia, allegria e comprensione reciproca.";
				} else {
					compDesc.textContent = "Un legame solido e autentico, con energie complementari che si arricchiscono a vicenda ogni giorno.";
				}
			}
		});
	}
</script>
