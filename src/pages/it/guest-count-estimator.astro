---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/guest-count-estimator/#webapp",
      "name": "Calcolatore Numero Invitati Matrimonio & Budget Coperti",
      "url": "https://manage.wedding/it/guest-count-estimator",
      "inLanguage": "it",
      "description": "Calcola quanti invitati puoi permetterti al matrimonio in base al budget complessivo, alle spese fisse e al costo per coperto del catering.",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come calcolare il numero ideale di invitati per il matrimonio",
      "description": "Metodo matematico per bilanciare budget totale, affitto location e quota a persona del banqueting.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Definire il budget totale e le spese fisse",
          "text": "Sottrai dal budget complessivo i costi indipendenti dal numero di persone (affitto villa, foto, musica, abiti)."
        },
        {
          "@type": "HowToStep",
          "name": "2. Stimare il costo a persona (Catering & Open Bar)",
          "text": "Somma la quota del menù a persona, open bar, IVA al 10% e coperto."
        },
        {
          "@type": "HowToStep",
          "name": "3. Dividere il budget variabile per la quota coperto",
          "text": "Ottieni il numero massimo sostenibile di invitati."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Come funziona il calcolo degli invitati rispetto al budget?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il calcolatore sottrae i costi fissi (affitto location, fotografo, DJ, abiti) dal budget complessivo. L'importo restante (budget variabile) viene diviso per il costo a persona del catering e delle bevande per indicare il numero massimo di invitati sostenibile."
          }
        },
        {
          "@type": "Question",
          "name": "Qual è il costo medio per coperto di un banchetto di nozze in Italia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In Italia il costo medio a persona per un menù nuziale completo (aperitivo a isole, due primi, secondo, buffet dolci e torta) varia mediamente tra 90 € e 160 € a persona a seconda della regione e della tipologia di pietanze (carne vs pesce pregiato)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Numero Invitati Matrimonio & Budget Coperti | Manage.Wedding"
	description="Calcola quanti invitati puoi accogliere al matrimonio in base al budget totale, ai costi fissi della location e al prezzo per coperto di catering e open bar."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<Breadcrumb title="Calcolatore Numero Invitati" category="budget-finance" />
		
		<section class="section-paper" style="padding: 3rem 1.5rem; min-height: 100vh;">
			<div style="max-width: 1000px; margin: 0 auto;">
				
				<div style="text-align: center; margin-bottom: 3rem;">
					<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 60px); color: var(--fg-pencil); transform: rotate(-1deg);">
						Calcolatore Numero Invitati <span class="accent-italic">& Budget</span>
					</h1>
					<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 0 auto; margin-top: 1rem;">
						Vuoi sapere quanti invitati puoi permetterti con il tuo budget? Inserisci i dati economici e scopri la capienza ottimale per il tuo banchetto.
					</p>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; align-items: start;">
					
					<!-- Form Column -->
					<div class="hand-card">
						<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
							Parametri Economici
						</h2>
						<form id="guest-form" style="display: flex; flex-direction: column; gap: 1.5rem;">
							
							<div class="input-group">
								<label for="total-budget" style="display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--fg-pencil);">Budget Totale Matrimonio (€)</label>
								<input type="number" id="total-budget" value="25000" min="0" step="100" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: transparent; font-family: inherit; font-size: 1.1rem; color: var(--fg-pencil);" />
								<small style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">Budget complessivo a disposizione.</small>
							</div>

							<div class="input-group">
								<label for="fixed-costs" style="display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--fg-pencil);">Spese Fisse: Location, Foto, Musica (€)</label>
								<input type="number" id="fixed-costs" value="10000" min="0" step="100" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: transparent; font-family: inherit; font-size: 1.1rem; color: var(--fg-pencil);" />
								<small style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">Affitto villa, fotografo, DJ, abiti e fiori.</small>
							</div>

							<div class="input-group">
								<label for="catering-ph" style="display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--fg-pencil);">Catering / Menù a Persona (€)</label>
								<input type="number" id="catering-ph" value="110" min="0" step="1" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: transparent; font-family: inherit; font-size: 1.1rem; color: var(--fg-pencil);" />
								<small style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">Costo cibo e servizio per singolo ospite.</small>
							</div>

							<div class="input-group">
								<label for="bar-ph" style="display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--fg-pencil);">Open Bar & Vini a Persona (€)</label>
								<input type="number" id="bar-ph" value="25" min="0" step="1" required style="width: 100%; box-sizing: border-box; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: transparent; font-family: inherit; font-size: 1.1rem; color: var(--fg-pencil);" />
								<small style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">Quota bevande e cocktail serali.</small>
							</div>

							<button type="submit" class="hand-btn" style="width: 100%; font-size: 1.25rem; margin-top: 1rem;">Calcola Numero Invitati</button>
						</form>
					</div>

					<!-- Results Column -->
					<div class="hand-card" id="results-container">
						<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
							Stima Invitati Sostenibili
						</h2>
						
						<div style="text-align: center; margin-bottom: 2rem;">
							<div style="font-size: 1.2rem; color: var(--text-secondary); margin-bottom: 0.5rem;">Massimo Numero di Ospiti</div>
							<div id="max-guests" class="font-heading" style="font-size: 4rem; color: var(--accent-red); line-height: 1;">111</div>
							<div style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 0.5rem;">persone / coperti</div>
						</div>

						<div style="margin-bottom: 1.5rem;">
							<h3 class="font-heading" style="font-size: 1.2rem; margin-bottom: 1rem;">Ripartizione Spesa</h3>
							
							<!-- Dynamic CSS Chart -->
							<div style="width: 100%; height: 40px; border: 2px solid var(--fg-pencil); border-radius: 4px; display: flex; overflow: hidden; margin-bottom: 0.5rem;">
								<div id="chart-fixed" style="width: 40%; background-color: var(--fg-pencil); display: flex; align-items: center; justify-content: center; color: var(--bg-paper); font-weight: bold; font-size: 0.8rem; transition: width 0.3s ease;">40%</div>
								<div id="chart-variable" style="width: 60%; background-color: var(--accent-blue); display: flex; align-items: center; justify-content: center; color: var(--bg-paper); font-weight: bold; font-size: 0.8rem; transition: width 0.3s ease;">60%</div>
							</div>
							
							<div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
								<div style="display: flex; align-items: center; gap: 0.5rem;">
									<div style="width: 12px; height: 12px; background-color: var(--fg-pencil);"></div>
									<span>Spese Fisse</span>
								</div>
								<div style="display: flex; align-items: center; gap: 0.5rem;">
									<div style="width: 12px; height: 12px; background-color: var(--accent-blue);"></div>
									<span>Banqueting Invitati</span>
								</div>
							</div>
						</div>

						<div style="background-color: rgba(0,0,0,0.03); padding: 1rem; border: 1px dashed var(--fg-pencil);">
							<div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
								<span>Budget Totale:</span>
								<strong id="display-total">25.000 €</strong>
							</div>
							<div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
								<span>Spese Fisse:</span>
								<strong id="display-fixed">-10.000 €</strong>
							</div>
							<div style="display: flex; justify-content: space-between; border-top: 1px solid var(--fg-pencil); padding-top: 0.5rem;">
								<span>Disponibile per gli Ospiti:</span>
								<strong id="display-remaining">15.000 €</strong>
							</div>
							<div style="display: flex; justify-content: space-between; margin-top: 0.5rem; color: var(--accent-red);">
								<span>Costo Complessivo per Persona:</span>
								<strong id="display-perhead">135 €</strong>
							</div>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- SEO Article Section -->
		<section class="section-muted" style="padding: 4rem 2rem;">
			<div style="max-width: 900px; margin: 0 auto;">
				
				<article class="hand-card" style="padding: 3rem;">
					<h2 class="font-heading" style="font-size: 2.5rem; margin-bottom: 1.5rem;">
						Come Gestire la Lista degli Invitati Senza Sforare il Budget
					</h2>
					
					<p class="font-body" style="font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.5rem;">
						Nel matrimonio italiano la voce di spesa più impattante è rappresentata dal ricevimento e dal catering. Ogni persona in più comporta un costo diretto per il menù, i vini, le bomboniere, la stampa dei segnaposto e il tableau de mariage.
					</p>

					<h3 class="font-heading" style="font-size: 1.8rem; margin-bottom: 1rem; margin-top: 2rem;">
						La Regola del 90% per la Capienza della Location
					</h3>
					<p class="font-body" style="font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.5rem;">
						Anche se una sala o una tensostruttura dichiara una capienza massima di 150 persone, è consigliabile calcolare un margine di sicurezza del 10% (massimo 135 invitati) per garantire spazio sufficiente alla pista da ballo, al tavolo dei musicisti e al buffet dei dolci.
					</p>
				</article>
			</div>
		</section>

		<RelatedTools currentPath="/it/guest-count-estimator" category="budget-finance" />
	</main>
</Layout>

<script is:inline>
	function calculateGuests() {
		const budget = parseFloat(document.getElementById('total-budget').value) || 0;
		const fixed = parseFloat(document.getElementById('fixed-costs').value) || 0;
		const catering = parseFloat(document.getElementById('catering-ph').value) || 0;
		const bar = parseFloat(document.getElementById('bar-ph').value) || 0;
		
		const perHead = catering + bar;
		const remaining = budget - fixed;
		
		let maxGuests = 0;
		if (perHead > 0 && remaining > 0) {
			maxGuests = Math.floor(remaining / perHead);
		} else if (remaining < 0) {
			maxGuests = 0;
		} else if (perHead === 0 && remaining >= 0) {
			maxGuests = 999;
		}

		document.getElementById('max-guests').innerText = maxGuests.toString();
		document.getElementById('display-total').innerText = `${budget.toLocaleString('it-IT')} €`;
		document.getElementById('display-fixed').innerText = `-${fixed.toLocaleString('it-IT')} €`;
		document.getElementById('display-remaining').innerText = `${remaining.toLocaleString('it-IT')} €`;
		document.getElementById('display-perhead').innerText = `${perHead.toLocaleString('it-IT')} €`;

		let fixedPct = 0;
		let varPct = 0;
		
		if (budget > 0) {
			if (fixed >= budget) {
				fixedPct = 100;
				varPct = 0;
			} else {
				fixedPct = (fixed / budget) * 100;
				varPct = 100 - fixedPct;
			}
		}

		document.getElementById('chart-fixed').style.width = `${fixedPct}%`;
		document.getElementById('chart-fixed').innerText = `${Math.round(fixedPct)}%`;
		document.getElementById('chart-variable').style.width = `${varPct}%`;
		document.getElementById('chart-variable').innerText = `${Math.round(varPct)}%`;
	}

	document.getElementById('guest-form')?.addEventListener('submit', (e) => {
		e.preventDefault();
		calculateGuests();
	});

	document.getElementById('guest-form')?.addEventListener('input', calculateGuests);
	calculateGuests();
</script>

<style>
	details > summary::-webkit-details-marker {
		display: none;
	}
	details > summary {
		list-style: none;
		position: relative;
		padding-left: 1.5rem;
	}
	details > summary::before {
		content: '▶';
		position: absolute;
		left: 0;
		top: 2px;
		font-size: 0.8rem;
		transition: transform 0.2s;
	}
	details[open] > summary::before {
		transform: rotate(90deg);
	}
</style>
