---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/bachelor-party-budget-calculator/#webapp",
      "name": "Calcolatore Budget Addio al Celibato e Divisione Spese",
      "url": "https://manage.wedding/it/bachelor-party-budget-calculator",
      "inLanguage": "it",
      "description": "Calcolatore gratuito per il budget dell'addio al celibato. Calcola la quota esatta a testa per villa/Airbnb, attività, cene di carne, discoteche e alcol offrendo la parte dello sposo. Esporta per Satispay, Revolut, Word e PDF.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come Pianificare e Dividere le Spese dell'Addio al Celibato",
      "description": "Guida pratica per il testimone di nozze: come calcolare il budget, raccogliere le quote dagli amici e offrire il viaggio allo sposo senza debiti.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Fissare i Partecipanti e Offrire allo Sposo",
          "text": "Conta gli amici confermati e applica la regola N-1: tutte le spese di alloggio, cibo, attività e drink dello sposo vengono divise equamente tra gli amici."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Bloccare Alloggio e Trasporto di Gruppo",
          "text": "Somma i costi fissi essenziali: affitto della villa, Airbnb o casale, caparra, pulizie e noleggio van 9 posti con benzina e pedaggi."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Stimare Attività, Cene e Serate",
          "text": "Inserisci le stime per noleggio barca, go-kart, degustazione birre, cena in braceria e tavolo con bottiglie in discoteca."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Raccogliere l'Acconto via Satispay / Bonifico",
          "text": "Invia il riepilogo su WhatsApp: raccogli un acconto del 50% tra 3 e 5 mesi prima per bloccare le strutture e il saldo 2 settimane prima del viaggio."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Lo sposo paga qualcosa durante il suo addio al celibato?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Secondo la tradizione del galateo moderno, lo sposo è completamente ospite: gli amici e i testimoni si dividono a parti uguali la sua quota per alloggio, cene, attività e bevande (formula N-1). Lo sposo paga esclusivamente il proprio biglietto aereo o treno individuale."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto costa in media un addio al celibato a persona in Italia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un weekend fuori porta o all'estero (es. Ibiza, Barcellona, Budapest, Gallipoli) costa mediamente tra 250€ e 450€ a persona tutto incluso (alloggio, cene, serate, attività e quota sposo). Un weekend in casale con piscina e grigliata varia tra 130€ e 200€ a testa."
          }
        },
        {
          "@type": "Question",
          "name": "Quando deve raccogliere i soldi il testimone di nozze?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Raccogli la prima quota (50% di acconto per bloccare villa e barca) 3-5 mesi prima dell'evento. Il secondo pagamento (il restante 50% per spesa, cene e locali) deve essere versato 2 settimane prima della partenza. Non anticipare mai migliaia di euro sulla tua carta personale senza caparre confermate."
          }
        },
        {
          "@type": "Question",
          "name": "Come comportarsi se un amico ha un budget limitato?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Invia un sondaggio anonimo di budget prima di scegliere la meta. Se un partecipante non può sostenere l'intero weekend, proponigli di partecipare solo a un evento clou (es. la cena e la serata del sabato) o di contribuire con una quota simbolica (20-30€) per il brindisi dello sposo."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Budget Addio al Celibato (Offrire allo Sposo) | Manage.Wedding"
	description="Calcolatore gratuito per il budget dell'addio al celibato. Calcola la quota esatta a testa per villa/Airbnb, attività, cene di carne, discoteche e alcol offrendo la parte dello sposo. Esporta per Satispay, Revolut, Word e PDF."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Budget Addio al Celibato" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Offrire allo Sposo & Colletta Satispay</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Budget Addio al Celibato <span class="accent-italic">& Divisione Spese</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcola la quota esatta a testa per villa, noleggio barca, braceria, serate in discoteca e fusti di birra. Offri automaticamente la vacanza allo sposo e genera messaggi per WhatsApp e Satispay in 1 clic.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Impostazioni e Categorie di Spesa -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						Dettagli del Viaggio & Partecipanti
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Formula N-1
					</span>
				</div>

				<!-- Destination / Preset Picker -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="destination-preset" style="font-weight: 700;">Destinazione / Tipologia Viaggio</label>
					<select id="destination-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; padding: 0.65rem;">
						<option value="ibiza" selected>🏖️ Ibiza / Mykonos (Barca, Beach Club, Discoteca VIP / 420€/amico)</option>
						<option value="barcellona">🏰 Barcellona / Madrid (Tapas, Movida & Rooftop / 330€/amico)</option>
						<option value="gallipoli">🏎️ Gallipoli / Versilia (Lido balneare, Grigliata, Serata / 260€/amico)</option>
						<option value="budapest">🍻 Budapest / Praga (Terme, Go-kart & Giro dei pub / 250€/amico)</option>
						<option value="casale">🏡 Casale con Piscina (Braciata gigante & Relax / 150€/amico)</option>
						<option value="custom">✏️ Configurazione Personalizzata</option>
					</select>
				</div>

				<!-- Nome Sposo, Amici Paganti, Notti -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label class="form-label" for="groom-name" style="font-size: 0.9rem; font-weight: 600;">Nome dello Sposo</label>
						<input type="text" id="groom-name" class="form-input" value="Marco" placeholder="es. Marco" />
					</div>
					<div>
						<label class="form-label" for="guys-count" style="font-size: 0.9rem; font-weight: 600;">Amici Paganti</label>
						<input type="number" id="guys-count" class="form-input" value="7" min="1" max="40" />
					</div>
					<div>
						<label class="form-label" for="trip-nights" style="font-size: 0.9rem; font-weight: 600;">Notti</label>
						<input type="number" id="trip-nights" class="form-input" value="2" min="1" max="30" />
					</div>
				</div>

				<!-- Toggle Offrire allo Sposo -->
				<div class="form-group" style="background: #fffcf5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem;">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 0.98rem; margin: 0;">
						<input type="checkbox" id="toggle-cover-groom" checked style="width: 18px; height: 18px; cursor: pointer;" />
						<span>Offrire 100% allo Sposo (Lo Sposo Paga 0€)</span>
					</label>
					<span style="font-size: 0.82rem; color: #64748b; display: block; margin-top: 4px; margin-left: 26px;">
						Regola standard: I 7 amici dividono l'intero costo totale a parti uguali.
					</span>
				</div>

				<!-- Categorie di Spesa -->
				
				<!-- Categoria 1: Alloggio -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏡 1. Alloggio e Caparra (€)
						</strong>
						<span id="subtotal-lodging" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">950€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-airbnb" style="font-size: 0.85rem;">Villa / Airbnb / Casale / Hotel</label>
							<input type="number" id="exp-airbnb" class="form-input" value="850" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-cleaning" style="font-size: 0.85rem;">Pulizie finali e Tassa di soggiorno</label>
							<input type="number" id="exp-cleaning" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Categoria 2: Attività ed Escursioni -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏄 2. Attività ed Escursioni (€)
						</strong>
						<span id="subtotal-activities" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">600€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-boat" style="font-size: 0.85rem;">Noleggio Barca / Gommone</label>
							<input type="number" id="exp-boat" class="form-input" value="350" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-shooting" style="font-size: 0.85rem;">Go-kart / Paintball / Quad</label>
							<input type="number" id="exp-shooting" class="form-input" value="150" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-tours" style="font-size: 0.85rem;">Degustazione Birre / Cantina</label>
							<input type="number" id="exp-tours" class="form-input" value="100" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-golf" style="font-size: 0.85rem;">Altre Attività / Avventura</label>
							<input type="number" id="exp-golf" class="form-input" value="0" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Categoria 3: Cene e Ristoranti -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🥩 3. Cene, Braceria e Spesa (€)
						</strong>
						<span id="subtotal-food" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">550€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-dinners" style="font-size: 0.85rem;">Cena di Carne / Braceria</label>
							<input type="number" id="exp-dinners" class="form-input" value="320" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-groceries" style="font-size: 0.85rem;">Spesa Supermercato & Grigliata</label>
							<input type="number" id="exp-groceries" class="form-input" value="150" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-brunch" style="font-size: 0.85rem;">Pranzi veloci, Focaccia e Colazioni</label>
						<input type="number" id="exp-brunch" class="form-input" value="80" min="0" step="10" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Categoria 4: Serate e Alcol -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🍻 4. Serate, Locali e Discoteche (€)
						</strong>
						<span id="subtotal-nightlife" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">480€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-bars" style="font-size: 0.85rem;">Giro dei Bar & Drink</label>
							<input type="number" id="exp-bars" class="form-input" value="200" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-vip" style="font-size: 0.85rem;">Tavolo VIP / Ingressi Club</label>
							<input type="number" id="exp-vip" class="form-input" value="180" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-booze" style="font-size: 0.85rem;">Alcolici e Birre per la Casa</label>
						<input type="number" id="exp-booze" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Categoria 5: Trasporto -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🚗 5. Trasporto e Carburante (€)
						</strong>
						<span id="subtotal-transport" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">140€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-rental" style="font-size: 0.85rem;">Noleggio Van / Benzina / Pedaggi</label>
							<input type="number" id="exp-rental" class="form-input" value="90" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-uber" style="font-size: 0.85rem;">Taxi & Uber</label>
							<input type="number" id="exp-uber" class="form-input" value="50" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Categoria 6: Magliette e Gadget -->
				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🧢 6. Magliette, Gadget e Kit (€)
						</strong>
						<span id="subtotal-swag" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">90€</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-shirts" style="font-size: 0.85rem;">Magliette / Travestimento Sposo</label>
							<input type="number" id="exp-shirts" class="form-input" value="60" min="0" step="5" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-kits" style="font-size: 0.85rem;">Kit Post-sbornia & Bicchieri</label>
							<input type="number" id="exp-kits" class="form-input" value="30" min="0" step="5" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Riepilogo & Colletta Satispay -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Cost Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.25rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Quota a Testa per Amico
						</span>
						<span id="groom-status-badge" style="font-size: 0.85rem; font-weight: 800; background: #16a34a; color: #fff; padding: 3px 8px; border-radius: 4px;">
							🤵 Marco Paga: 0€
						</span>
					</div>

					<div id="display-per-person" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						401€
					</div>

					<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.25rem; font-size: 0.95rem; color: var(--text-secondary); flex-wrap: wrap;">
						<span>🌙 <strong id="display-per-night" style="color: var(--fg-pencil);">201€</strong> / notte</span>
						<span>•</span>
						<span>🎁 Quota regalo sposo: <strong id="display-groom-subsidy" style="color: var(--accent-red); font-weight: 700;">+50€</strong> / amico</span>
					</div>

					<p style="font-size: 0.92rem; color: var(--text-secondary); margin: 0 0 1.25rem 0; padding-bottom: 1rem; border-bottom: 1px dashed #cbd5e1;">
						Spesa totale del gruppo: <strong id="display-trip-grand-total" style="color: var(--fg-pencil); font-weight: 700;">2.810€</strong> tra <span id="display-headcount-text">7 amici</span> (+ sposo).
					</p>

					<!-- Itemized Per-Person Split Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏡 Alloggio e Caparra:</span>
							<strong id="item-lodging-share">136€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏄 Attività ed Escursioni:</span>
							<strong id="item-activity-share">86€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🥩 Cene, Braceria e Spesa:</span>
							<strong id="item-food-share">79€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🍻 Serate, Locali e Alcol:</span>
							<strong id="item-nightlife-share">69€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🚗 Trasporto e Carburante:</span>
							<strong id="item-transport-share">20€</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.9rem;">
							<span>🧢 Magliette e Gadget:</span>
							<strong id="item-swag-share">13€</strong>
						</div>
					</div>

					<!-- Suggested Payment Schedule -->
