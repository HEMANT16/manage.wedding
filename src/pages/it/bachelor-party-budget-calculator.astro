			subActivities.textContent = `${Math.round(activitiesTotal).toLocaleString('it-IT')}€`;
			subFood.textContent = `${Math.round(foodTotal).toLocaleString('it-IT')}€`;
			subNightlife.textContent = `${Math.round(nightlifeTotal).toLocaleString('it-IT')}€`;
			subTransport.textContent = `${Math.round(transportTotal).toLocaleString('it-IT')}€`;
			subSwag.textContent = `${Math.round(swagTotal).toLocaleString('it-IT')}€`;

			// Update Summary Card
			displayPerPerson.textContent = `${Math.round(perPersonTotal).toLocaleString('it-IT')}€`;
