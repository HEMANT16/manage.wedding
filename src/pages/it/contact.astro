---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://manage.wedding/it/contact/#contact",
  "name": "Contatti | Manage.Wedding",
  "url": "https://manage.wedding/it/contact",
  "inLanguage": "it",
  "description": "Mettiti in contatto con il team di Manage.Wedding. Inviaci feedback sui calcolatori, suggerimenti per nuove funzionalità o domande all'indirizzo manage.weddingall@gmail.com."
};
---

<Layout 
	title="Contatti | Manage.Wedding — Scrivici Direttamente"
	description="Contatta il team di Manage.Wedding: suggerimenti per nuovi calcolatori, feedback sugli strumenti o richieste di supporto all'indirizzo manage.weddingall@gmail.com."
	schema={schema}
>
	<main style="max-width: 1050px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem); box-sizing: border-box;">
		
		<!-- Header -->
		<section class="section-paper" style="margin-bottom: 2.5rem; text-align: center; padding: 2.5rem 1rem;">
			<div class="tape" style="margin: 0 auto 1.25rem;"></div>
			<span class="badge-postit">Siamo qui per aiutarti</span>
			<h1 class="font-heading" style="font-size: clamp(34px, 5vw, 54px); color: var(--fg-pencil); line-height: 1.2; text-align: center; margin: 0.75rem 0;">
				Contatta Manage.Wedding
			</h1>
			<p style="font-size: 1.2rem; color: var(--text-secondary); max-width: 680px; margin: 0.5rem auto 0; text-align: center; line-height: 1.6;">
				Hai un'idea per un nuovo calcolatore, un suggerimento per migliorare uno strumento o una domanda sull'organizzazione delle nozze? Scrivici un messaggio!
			</p>
		</section>

		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; margin-bottom: 4rem; align-items: start;">
			
			<!-- Direct Contact Form Card -->
			<div class="hand-card" style="padding: clamp(1.75rem, 3.5vw, 2.75rem); background: #fff;">
				<h2 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; text-align: center;">
					Inviaci un Messaggio Diretto
				</h2>
				<p style="font-size: 1.05rem; color: var(--text-secondary); margin-bottom: 1.75rem; text-align: center; line-height: 1.5;">
					I messaggi arrivano direttamente nella nostra casella di posta: <strong style="color: var(--fg-pencil);">manage.weddingall@gmail.com</strong>.
				</p>

				<form id="contact-form" style="display: flex; flex-direction: column; gap: 1.35rem;">
					<!-- Hidden Honeypot Field for Spam Protection -->
					<input type="text" name="_honey" id="contact-honey" style="display: none;" tabindex="-1" autocomplete="off" />

					<div>
						<label for="contact-name" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Il Tuo Nome <span style="color: #dc2626;">*</span>
						</label>
						<input 
							type="text" 
							name="name"
							id="contact-name" 
							required 
							placeholder="es. Giulia & Marco" 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; font-size: 1.05rem; padding: 0.85rem 1rem;"
						/>
					</div>

					<div>
						<label for="contact-email" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Il Tuo Indirizzo Email <span style="color: #dc2626;">*</span>
						</label>
						<input 
							type="email" 
							name="email"
							id="contact-email" 
							required 
							placeholder="es. sposi@esempio.it" 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; font-size: 1.05rem; padding: 0.85rem 1rem;"
						/>
					</div>

					<div>
						<label for="contact-topic" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Argomento
						</label>
						<select name="topic" id="contact-topic" class="hand-input" style="width: 100%; box-sizing: border-box; background: #fff; font-size: 1.05rem; padding: 0.85rem 1rem; cursor: pointer;">
							<option value="Suggerisci uno strumento">💡 Suggerisci un nuovo calcolatore o funzionalità</option>
							<option value="Segnala un errore">🐛 Segnala un errore o problema di calcolo</option>
							<option value="Domanda generale">💬 Domanda generale sull'organizzazione nozze</option>
							<option value="Collaborazione / Stampa">🤝 Collaborazioni, stampa o wedding planner</option>
							<option value="Richiesta Privacy">🛡️ Domanda sulla privacy o sui dati</option>
						</select>
					</div>

					<div>
						<label for="contact-message" style="display: block; font-size: 1.05rem; font-weight: 600; color: var(--fg-pencil); margin-bottom: 0.4rem;">
							Messaggio <span style="color: #dc2626;">*</span>
						</label>
						<textarea 
							name="message"
							id="contact-message" 
							rows="5" 
							required 
							placeholder="Scrivici la tua richiesta, quale strumento stai utilizzando o quali formule vorresti aggiungere..." 
							class="hand-input" 
							style="width: 100%; box-sizing: border-box; resize: vertical; font-size: 1.05rem; line-height: 1.6; padding: 0.85rem 1rem;"
						></textarea>
					</div>

					<button 
						type="submit" 
						id="contact-submit-btn"
						class="hand-btn" 
						style="width: 100%; padding: 14px 20px; font-size: 1.15rem; cursor: pointer; margin-top: 0.5rem; display: flex; align-items: center; justify-content: center; gap: 0.6rem;"
					>
						<span>✉️</span>
						<span id="btn-text">Invia Messaggio</span>
					</button>
				</form>

				<!-- Success Status Box -->
				<div id="contact-success" style="display: none; background: #dcfce7; border: 2px solid #16a34a; border-radius: 6px; padding: 1.5rem; margin-top: 1.5rem; text-align: center; color: #166534;">
					<div style="font-size: 2rem; margin-bottom: 0.35rem;">🎉</div>
					<strong style="font-size: 1.2rem; display: block; margin-bottom: 0.5rem;">Grazie! Il tuo messaggio è stato inviato con successo.</strong>
					<p style="margin: 0; font-size: 1.02rem; line-height: 1.5;">
						È stato recapitato direttamente a <strong>manage.weddingall@gmail.com</strong>. Ti risponderemo entro 24–48 ore!
					</p>
				</div>

				<!-- Error Fallback Box -->
				<div id="contact-error" style="display: none; background: #fee2e2; border: 2px solid #dc2626; border-radius: 6px; padding: 1.5rem; margin-top: 1.5rem; text-align: center; color: #991b1b;">
					<strong style="font-size: 1.1rem; display: block; margin-bottom: 0.35rem;">Impossibile inviare il messaggio automaticamente.</strong>
					<p style="margin: 0; font-size: 1rem;">
						Scrivici direttamente a <a id="error-mailto-link" href="mailto:manage.weddingall@gmail.com" style="color: #991b1b; text-decoration: underline; font-weight: bold;">manage.weddingall@gmail.com</a>.
					</p>
				</div>
			</div>

			<!-- Direct Contact Info & FAQ Side Column -->
			<div style="display: flex; flex-direction: column; gap: 1.75rem;">
				
				<!-- Direct Channels -->
				<div class="hand-card" style="padding: 2rem; background: var(--bg-paper);">
					<h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
						Contatto Diretto & Dettagli
					</h3>
					
					<div style="display: flex; flex-direction: column; gap: 1.2rem; font-size: 1rem;">
						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); margin-bottom: 0.35rem; font-size: 1.05rem;">📬 Email Principale:</strong>
							<a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 700; text-decoration: underline; font-size: 1.1rem; word-break: break-all;">
								manage.weddingall@gmail.com
							</a>
						</div>

						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); font-size: 1.05rem;">💡 Per cosa scriverci:</strong>
							<ul style="margin: 0.5rem 0 0 1.25rem; padding: 0; color: var(--text-secondary); font-size: 0.98rem; line-height: 1.6;">
								<li>Suggerimenti per nuovi calcolatori di nozze</li>
								<li>Feedback o richieste di correzione formule</li>
								<li>Collaborazioni per wedding planner e fornitori</li>
							</ul>
						</div>

						<div style="padding: 1rem 1.15rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
							<strong style="display: block; color: var(--fg-pencil); font-size: 1.05rem;">🛡️ Privacy & Diritti sui Dati:</strong>
							<p style="margin: 0.35rem 0 0; color: var(--text-secondary); font-size: 0.98rem; line-height: 1.5;">
								Qualsiasi richiesta sulla privacy può essere inviata direttamente a <a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 600; text-decoration: underline;">manage.weddingall@gmail.com</a>.
							</p>
						</div>
					</div>
				</div>

				<!-- Quick Response Guarantee -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.45rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
						⚡ Risposta entro 24–48 Ore
					</h3>
					<p style="font-size: 1.02rem; color: var(--text-secondary); margin: 0; line-height: 1.6; text-align: center;">
						Leggiamo personalmente ogni messaggio inviato da sposi, testimoni e professionisti del settore.
					</p>
				</div>

				<!-- Quick FAQ -->
				<div class="hand-card" style="padding: 2rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 1rem; text-align: center;">
						Domande Frequenti
					</h3>
					<details style="margin-bottom: 0.75rem; cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Tutti gli strumenti sono davvero gratuiti?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Sì! Tutti i 38+ calcolatori e i modelli stampabili sono completamente gratuiti e utilizzabili senza abbonamenti né costi nascosti.</p>
					</details>
					<details style="margin-bottom: 0.75rem; cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Posso richiedere un nuovo calcolatore?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">Certamente! Invia il modulo qui sopra o scrivi a <a href="mailto:manage.weddingall@gmail.com" style="color: var(--accent-blue); font-weight: 600;">manage.weddingall@gmail.com</a> con l'idea che vorresti veder realizzata.</p>
					</details>
					<details style="cursor: pointer;">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.02rem;">Salvate le mie liste invitati o i testi dei discorsi?</summary>
						<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.5;">No. Tutto viene elaborato al 100% in locale nel browser del tuo dispositivo. Non memorizziamo mai i tuoi dati su server esterni.</p>
					</details>
				</div>

			</div>

		</div>

	</main>

	<script is:inline>
		const form = document.getElementById('contact-form');
		const submitBtn = document.getElementById('contact-submit-btn');
		const btnText = document.getElementById('btn-text');
		const successBox = document.getElementById('contact-success');
		const errorBox = document.getElementById('contact-error');
		const errorMailto = document.getElementById('error-mailto-link');

		if (form) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				const honey = document.getElementById('contact-honey').value;
				if (honey) {
					console.warn('Bot submission prevented');
					return;
				}

				const name = document.getElementById('contact-name').value.trim();
				const email = document.getElementById('contact-email').value.trim();
				const topic = document.getElementById('contact-topic').value;
				const message = document.getElementById('contact-message').value.trim();

				if (!name || !email || !message) return;

				submitBtn.disabled = true;
				btnText.innerText = 'Invio a manage.weddingall@gmail.com in corso...';
				if (successBox) successBox.style.display = 'none';
				if (errorBox) errorBox.style.display = 'none';

				try {
					const response = await fetch('https://formsubmit.co/ajax/75066fcb859af7eecff2fc720ba6dc94', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'Accept': 'application/json'
						},
						body: JSON.stringify({
							name: name,
							email: email,
							topic: topic,
							message: message,
							_subject: `[Manage.Wedding Contatto] ${topic} da ${name}`,
							_template: 'table'
						})
					});

					const result = await response.json();

					if (response.ok || result.success === 'true' || result.message) {
						form.reset();
						submitBtn.style.display = 'none';
						if (successBox) {
							successBox.style.display = 'block';
							successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
						}
					} else {
						throw new Error(result.message || 'Invio fallito');
					}
				} catch (err) {
					console.error('Errore invio:', err);
					submitBtn.disabled = false;
					btnText.innerText = 'Invia Messaggio';
					
					const subject = encodeURIComponent(`[Manage.Wedding] ${topic} - da ${name}`);
					const body = encodeURIComponent(`Nome: ${name}\nEmail: ${email}\nArgomento: ${topic}\n\nMessaggio:\n${message}`);
					if (errorMailto) {
						errorMailto.href = `mailto:manage.weddingall@gmail.com?subject=${subject}&body=${body}`;
					}
					if (errorBox) {
						errorBox.style.display = 'block';
						errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					}
				}
			});
		}
	</script>
</Layout>
