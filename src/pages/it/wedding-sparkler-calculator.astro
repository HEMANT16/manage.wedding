---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedTools from '../../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-sparkler-calculator/#webapp",
      "name": "Calcolatore Stelline Scintillanti & Cartelli Stampabili Gratis",
      "url": "https://manage.wedding/it/wedding-sparkler-calculator",
      "inLanguage": "it",
      "description": "Calcola il numero esatto di stelline scintillanti (50cm vs 90cm), durata per foto, cannelli a butano e secchi di sabbia. Include cartelli stampabili 'Che l'Amore Risplenda' e schede di sicurezza gratis.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come Organizzare un'Uscita Trionfale con Stelline Scintillanti per il Matrimonio",
      "description": "Guida per wedding planner e sposi per sincronizzare l'accensione a catena e formare un tunnel di luce sicuro e suggestivo.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Passo 1: Calcola gli Invitati Effettivi e la Lunghezza",
          "text": "Considera che il 25-35% degli ospiti parte prima della fine della festa. Scegli stelline da 50 cm (90-120s) o 90 cm (3,5-4 min) senza fumo con anima in filo metallico."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 2: Prepara Secchi di Metallo con Sabbia o Acqua",
          "text": "Posiziona secchi di zinco con sabbia all'inizio e alla fine del corridoio per spegnere immediatamente le bacchette incandescenti."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 3: Forma Due File Parallele Larghe 3 Metri",
          "text": "Disponi gli invitati su due linee parallele lasciando almeno 3-3,5 metri di passaggio centrale per salvaguardare abito da sposa, velo e acconciatura."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 4: Avvia l'Onda di Accensione a Catena",
          "text": "Assegna 1 responsabile dotato di cannello a butano ogni 8-10 invitati. Si accende la prima stellina e gli ospiti si passano il fuoco punta a punta in 20 secondi."
        },
        {
          "@type": "HowToStep",
          "name": "Passo 5: Camminata Lenta, Bacio al Centro e Spegnimento",
          "text": "Gli sposi attraversano il tunnel lentamente, si fermano per la foto del bacio e poi tutti infilano le bacchette nella sabbia."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quale misura di stelline scintillanti scegliere per il matrimonio: 25 cm, 50 cm o 90 cm?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le stelline da 50 cm (durata 90-120 secondi) sono lo standard d'oro per matrimoni tra 50 e 150 invitati, garantendo il tempo di accendere e sfilare con calma. Le stelline da 90 cm (3,5-4 minuti) sono perfette per matrimoni sopra i 150 invitati o scalinate monumentali. Le stelline da 25 cm durano solo 30-40 secondi e sono SCONSIGLIATE perché le prime si spengono prima che le ultime siano accese."
          }
        },
        {
          "@type": "Question",
          "name": "Perché le location richiedono stelline senza fumo con anima in metallo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le stelline in filo di ferro bruciano quasi senza fumo e non lasciano cadere tizzoni ardenti. I bastoncini in legno o bambù creano fumo denso e acre che rovina le fotografie, lasciano cadere brace che buca gli abiti da sposa e possono far scattare gli allarmi antincendio."
          }
        },
        {
          "@type": "Question",
          "name": "Quante stelline scintillanti comprare per ogni invitato?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per le misure da 50 cm e 90 cm è sufficiente 1 stellina per ospite presente, più un 15% di scorta per test fotografici e accenditori. Se usi stelline corte da 25 cm o hai un gruppo molto vivace, calcola 2 pezzi per invitato."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Stelline Scintillanti Matrimonio — Cartelli Stampabili Gratis «Che l'Amore Risplenda» & Schede di Sicurezza"
	description="Calcola stelline scintillanti (50cm vs 90cm), durata per foto, cannelli a butano e secchi di sabbia. Include cartelli stampabili 'Che l'Amore Risplenda' e schede di sicurezza gratis."
	lang="it"
	schema={schema}
>
	<!-- Include html2canvas for instant image capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Calcolatore Stelline Scintillanti" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center; position: relative;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.25rem 1rem 1.75rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Gratis • Filo d'Acciaio Senza Fumo • Cartelli Stampabili in PDF & Word</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(28px, 4.5vw, 50px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calcolatore Stelline Scintillanti <span class="accent-italic" style="color: #b45309; text-shadow: 1px 1px 0px #fef08a;">& Cartelli Stampabili</span>
				</h1>
				<p class="font-body" style="font-size: 1.125rem; color: var(--text-secondary); max-width: 820px; margin: 0 auto; line-height: 1.6;">
					Calcola il numero esatto di stelline (50cm vs 90cm), la durata per le pose fotografiche, i cannelli a butano e i secchi di sabbia. Include la scaletta oraria e i <strong>cartelli decorativi stampabili « Che l'Amore Risplenda »</strong>.
				</p>
			</div>
		</section>

		<!-- Visual Step-by-Step "How to Use This Tool" Guide -->
		<section class="hand-card" style="padding: 1.5rem; background: #fffdfa; margin-bottom: 2.5rem; border: 2px solid var(--fg-pencil);">
			<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
				<span style="font-size: 1.4rem;">💡</span>
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0;">
					Come Usare Questo Calcolatore (In 3 Semplici Passaggi)
				</h2>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
				
				<!-- Guide Step 1 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">1</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Numero di Invitati e Orario</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Inserisci gli invitati e l'orario. Se l'uscita è a notte fonda (23:30+), circa il 30% va via prima; il calcolatore evita di ordinare stelline sprecate.
					</p>
				</div>

				<!-- Guide Step 2 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">2</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Scegli 50 cm o 90 cm</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Scegli <strong>50 cm (2 min di durata)</strong> per matrimoni classici (40–150 invitati) o <strong>90 cm (4 min)</strong> per oltre 150 ospiti e foto con bacio senza fretta.
					</p>
				</div>

				<!-- Guide Step 3 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">3</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Lista Spesa & Cartelli</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Ottieni confezioni esatte, cannelli e secchi di sabbia. Inserisci i vostri nomi per stampare il <strong>cartello da tavolo e le schede di sicurezza</strong> in 1 clic.
					</p>
				</div>

			</div>
		</section>

		<!-- Main Interactive Calculator Studio -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; margin-bottom: 3rem; align-items: start;">
			
			<!-- Left Column: Inputs & Configuration -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #ffffff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.35rem; margin: 0; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
						<span>⚙️</span> Parametri dell'Uscita
					</h2>
					<span style="font-size: 0.78rem; font-weight: 700; background: #fef08a; border: 1.5px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
						Calcolo in Tempo Reale
					</span>
				</div>

				<!-- Step 1: Total Invited Guests Headcount -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem;">
						<label class="form-label" for="slider-guests" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							1. Totale Invitati Confermati:
						</label>
						<span id="label-guest-count" style="font-weight: 800; font-size: 1.15rem; color: #b45309; background: #fef3c7; border: 1.5px solid #d97706; padding: 2px 10px; border-radius: 6px;">
							120 invitati
						</span>
					</div>
					<input type="range" id="slider-guests" min="15" max="400" value="120" step="5" style="width: 100%; accent-color: #b45309; cursor: pointer;" />
					<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.2rem;">
						<span>15 (Intima)</span>
						<span>75 (Piccola)</span>
						<span>120 (Media)</span>
						<span>250 (Grande)</span>
						<span>400+</span>
					</div>
				</div>

				<!-- Step 2: Send-Off Timing -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label class="form-label" for="select-timing-preset" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem; margin-bottom: 0.3rem; display: block;">
						2. Quando si Svolgerà l'Uscita con le Stelline?
					</label>
					<select id="select-timing-preset" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc; border: 2px solid var(--fg-pencil); width: 100%; padding: 0.6rem; border-radius: 6px; font-size: 0.9rem;">
						<option value="late-night" selected>🌙 Gran Finale Notturno (23:30+) — ~70% degli Invitati Presenti</option>
						<option value="staged">🍰 Uscita Simulata dopo il Taglio Torta (22:00) — ~95% Presenti</option>
						<option value="ceremony">🌅 Uscita dalla Cerimonia / Tramonto — 100% Presenti</option>
						<option value="custom">🎛️ Percentuale Personalizzata</option>
					</select>
					
					<div id="custom-retention-box" style="display: none; margin-top: 0.75rem; padding: 0.75rem; background: #fffbeb; border: 1.5px dashed #d97706; border-radius: 6px;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
							<label style="font-size: 0.85rem; font-weight: 700; color: #92400e;">Percentuale Presenza:</label>
							<span id="label-retention-val" style="font-weight: 800; color: #92400e;">70%</span>
						</div>
						<input type="range" id="slider-retention" min="40" max="100" value="70" step="5" style="width: 100%; accent-color: #d97706;" />
					</div>

					<div style="background: #f8fafc; border-left: 3px solid #b45309; padding: 0.5rem 0.75rem; margin-top: 0.5rem; border-radius: 0 4px 4px 0;">
						<p style="font-size: 0.82rem; color: #475569; margin: 0; line-height: 1.45;">
							👥 <strong>Presenza Reale:</strong> <strong id="retention-summary-text" style="color: #b45309;">84 invitati</strong> presenti (<span id="attrition-summary-text">36 persone</span> partono prima per stanchezza o bambini).
						</p>
					</div>
				</div>

				<!-- Step 3: Sparkler Length & Burn Time Selector -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label class="form-label" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem; margin-bottom: 0.4rem; display: block;">
						3. Scegli la Misura delle Stelline:
					</label>
					
					<div class="sparkler-size-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem;">
						<!-- 50 cm option (Default Gold Standard) -->
						<label class="size-pill active" id="card-len-20" style="border: 2px solid #b45309; background: #fffbeb; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative; box-shadow: 0 0 0 1px #b45309;">
							<input type="radio" name="sparkler-len" value="20" checked style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 800; color: #92400e; background: #fef08a; border: 1px solid #d97706; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">⭐ Consigliato</span>
							<strong style="display: block; font-size: 0.9rem; color: #92400e; line-height: 1.15;">50 cm (20")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #b45309; margin-top: 1px;">2 Min Durata</span>
							<span style="display: block; font-size: 0.67rem; color: #78350f; margin-top: 1px;">40–150 Ospiti</span>
						</label>

						<!-- 90 cm option (Grand Exits) -->
						<label class="size-pill" id="card-len-36" style="border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative;">
							<input type="radio" name="sparkler-len" value="36" style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 700; color: #0369a1; background: #e0f2fe; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">👑 Grandi Uscite</span>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil); line-height: 1.15;">90 cm (36")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #0369a1; margin-top: 1px;">4 Min Durata</span>
							<span style="display: block; font-size: 0.67rem; color: #64748b; margin-top: 1px;">150+ Ospiti</span>
						</label>

						<!-- 25 cm option (Small/Risky) -->
						<label class="size-pill" id="card-len-10" style="border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative;">
							<input type="radio" name="sparkler-len" value="10" style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 700; color: #991b1b; background: #fee2e2; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">⚠️ Micro Solo</span>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil); line-height: 1.15;">25 cm (10")</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #dc2626; margin-top: 1px;">35s Durata</span>
							<span style="display: block; font-size: 0.67rem; color: #64748b; margin-top: 1px;">&lt;25 Ospiti</span>
						</label>
					</div>
				</div>

				<!-- Sparklers Per Guest & Buffer Options -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem;">
					<div>
						<label class="form-label" for="select-sparklers-per-guest" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.85rem;">
							Stelline per Invitato:
						</label>
						<select id="select-sparklers-per-guest" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<option value="1" selected>1 Stellina (Standard)</option>
							<option value="2">2 Stelline (Doppia Luce / Scorta)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="select-buffer-pct" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.85rem;">
							Margine di Sicurezza:
						</label>
						<select id="select-buffer-pct" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<option value="15" selected>+15% Margine (Consigliato)</option>
							<option value="10">+10% Margine</option>
							<option value="20">+20% Margine Extra</option>
							<option value="0">0% Esatto</option>
						</select>
					</div>
				</div>

				<!-- Step 4: Couple Names & Target Send-Off Time -->
				<div style="border-top: 1.5px dashed #cbd5e1; padding-top: 1.25rem;">
					<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
						<h3 class="font-heading" style="font-size: 1.05rem; margin: 0; color: var(--fg-pencil);">
							4. Personalizza i Cartelli e la Scaletta:
						</h3>
						<span style="font-size: 0.72rem; color: #166534; background: #dcfce7; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Aggiorna il Cartello ⬇️</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="input-couple-names" style="font-size: 0.82rem; font-weight: 600;">Nomi degli Sposi:</label>
							<input type="text" id="input-couple-names" class="form-input" value="Giulia & Matteo" placeholder="es. Chiara e Marco" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						</div>
						<div>
							<label class="form-label" for="input-exit-time" style="font-size: 0.82rem; font-weight: 600;">Orario Previsto:</label>
							<input type="text" id="input-exit-time" class="form-input" value="23:45" placeholder="es. 23:45" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Results & Equipment Blueprint -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Metric Hero Card -->
				<div class="hand-card shadow-hard" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fffdfa; border: 3px solid var(--fg-pencil); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
						<div>
							<span style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #92400e;">
								Consiglio d'Acquisto
							</span>
							<h3 class="font-heading" style="font-size: 1.35rem; margin: 0.2rem 0 0; color: var(--fg-pencil);">
								Totale Stelline da Ordinare
							</h3>
						</div>
						<div id="badge-pack-size" style="background: #fef08a; border: 2px solid var(--fg-pencil); padding: 4px 10px; border-radius: 6px; font-weight: 800; font-size: 0.85rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
							~12 Confezioni (8 pz)
						</div>
					</div>

					<div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.5rem;">
						<span id="res-total-sparklers" style="font-size: clamp(3rem, 6vw, 4.2rem); font-weight: 900; color: #b45309; line-height: 1; font-family: var(--font-heading);">
							97
						</span>
						<span style="font-size: 1.25rem; font-weight: 700; color: var(--fg-pencil);">Stelline Totali</span>
					</div>

					<div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
						<div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.35rem;">
