---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/dress-alterations-estimator/#webapp",
      "name": "Calcolatore Costi Modifiche Sartoriali Abito da Sposa",
      "url": "https://manage.wedding/it/dress-alterations-estimator",
      "inLanguage": "it",
      "description": "Calcola i costi delle modifiche sartoriali per l'abito da sposa: orlo gonna, strascico, ripresa bustino, coppe seno, allacciatura a corsetto e stiratura con export Word e PDF.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come pianificare e calcolare le modifiche sartoriali dell'abito da sposa",
      "description": "Guida alle 3 prove sartoriali e al calcolo dei costi per adattare l'abito da sposa su misura.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Valutare l'orlo e la complessità della gonna",
          "text": "Controlla il tipo di tessuto (raso liscio, tulle multistrato o pizzo smerlato) e il numero di strati di fodera da accorciare."
        },
        {
          "@type": "HowToStep",
          "name": "2. Definire le modifiche al bustino",
          "text": "Stabilisci se è necessario stringere o allargare il corpetto, accorciare le spalline o inserire le coppe seno preformate."
        },
        {
          "@type": "HowToStep",
          "name": "3. Scegliere il sistema per sollevare lo strascico",
          "text": "Scegli tra un punto singolo, un sistema a 3 punti alla francese o un ancoraggio a scomparsa per ballare comodamente."
        },
        {
          "@type": "HowToStep",
          "name": "4. Portare scarpe e intimo a tutte le prove",
          "text": "Indossa le scarpe con il tacco esatto e l'intimo scelto fin dalla prima prova sartoriale per garantire la corretta lunghezza a terra."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanto costano in media le modifiche sartoriali per un abito da sposa in Italia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il costo medio per i ritocchi sartoriali varia tra i 250 € e i 650 € per orlo, bustino e sistema di sollevamento strascico. Per abiti complessi con molti strati di tulle, pizzi applicati a mano o scollature da ridisegnare, la spesa può arrivare a 700 € – 1.000 €."
          }
        },
        {
          "@type": "Question",
          "name": "Quante prove sartoriali sono necessarie prima del matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Solitamente sono previste 3 prove: la prima prova a circa 8–10 settimane dalle nozze (imbastitura orlo e bustino), la seconda prova a 4–5 settimane (verifica rifiniture e strascico) e la prova finale di ritiro a 10–14 giorni con stiratura professionale a vapore."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Costi Modifiche Sartoriali Abito da Sposa | Manage.Wedding"
	description="Calcola il costo delle modifiche sartoriali per l'abito da sposa: orlo gonna, strascico, ripresa bustino, coppe seno, maniche e stiratura con export Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Modifiche Sartoriali Abito Sposa" category="budget-finance" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Costi Modifiche <span class="accent-italic">Abito da Sposa</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Stima i costi reali di sartoria per orlo gonna, ripresa bustino, coppe seno, gestione dello strascico e stiratura con esportazione in <strong>Word</strong> o <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Come Funziona il Calcolo Sartoriale in 3 Passaggi
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Scegli il Tipo di Orlo
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Indica la complessità del bordo (semplice, nastro rigido o pizzo smerlato staccato a mano) e il numero di sottogonne.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Imposta Ritocchi al Bustino & Strascico
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Seleziona ripresa fianchi, spalline, coppe seno imbottite e il sistema per tirare su lo strascico per il ballo.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Scarica la Scheda per la Sarta
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Salva o stampa la scheda riassuntiva da portare in atelier per confrontare il preventivo sartoriale.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="alterations-calc-grid">
			
			<!-- Left Column: Itemized Tailoring Services -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div style="width: 100%;">
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							✂️ Servizi & Lavorazioni Sartoriali
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Seleziona i ritocchi necessari sul tuo modello
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Valuta:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="CHF">CHF (Franco Svizzero)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="alterations-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Hemming & Skirt Layers -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							1. Orlo Gonna & Strati Sottogonna
						</h3>
						<div style="display: flex; flex-direction: column; gap: 0.5rem;">
							<div>
								<label for="select-hem-type" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
									Tipologia Orlo & Bordo Gonna
								</label>
								<select id="select-hem-type" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.9rem;">
								<option value="0">Nessun orlo necessario (0 €)</option>
								<option value="120" selected>Orlo Lineare Semplice (Crepe, Raso, Chiffon) (120 €)</option>
								<option value="180">Orlo con Bordo in Crine / Crinolina (180 €)</option>
								<option value="280">Orlo con Pizzo Smerlato (Stacco e ricucitura a mano) (280 €)</option>
							</select>
						</div>

						<div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-paper); padding: 0.5rem 0.75rem; border: 1px dashed var(--fg-pencil); border-radius: 4px;">
							<div>
								<label for="input-skirt-layers" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Strati Extra Sottogonna (Tulle / Fodere)</label>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">35 € a strato aggiuntivo oltre la gonna principale</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.3rem;">
								<input type="number" id="input-skirt-layers" value="2" min="0" max="10" style="width: 50px; padding: 0.3rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center; background: #fff;">
								<span style="font-size: 0.85rem;">strati</span>
							</div>
						</div>
					</div>
					</div>

					<!-- 2. Bodice, Straps & Bra Structure -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-blue); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							2. Bustino, Spalline & Modellazione Seno
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-take-in-bodice" value="100" checked class="alt-checkbox">
								<span>Stringere / Allargare Bustino (100 €)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-shorten-straps" value="40" checked class="alt-checkbox">
								<span>Accorciare Spalline / Maniche (40 €)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-sew-in-cups" value="35" checked class="alt-checkbox">
								<span>Inserimento Coppe Seno Preformate (35 €)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-reshape-neckline" value="110" class="alt-checkbox">
								<span>Modifica Scollatura o Schiena (110 €)</span>
							</label>

							<label class="service-checkbox-label" style="grid-column: span 2;">
								<input type="checkbox" id="chk-corset-back" value="150" class="alt-checkbox">
								<span>Conversione da Zip a Corsetto Stringato con Occhielli (150 €)</span>
							</label>
						</div>
					</div>

					<!-- 3. Bustle & Train Management -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: #16a34a; margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							3. Sistema Sollevamento Strascico (Bustle per il Ballo)
						</h3>
						<div>
							<label for="select-bustle-style" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
								Tipologia di Punto / Ancoraggio Strascico
							</label>
							<select id="select-bustle-style" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.9rem;">
								<option value="0">Nessun punto strascico / Abito senza strascico (0 €)</option>
								<option value="60">1 Punto Singolo con Asola e Bottone (60 €)</option>
								<option value="110" selected>Da 3 a 5 Punti alla Francese a Scomparsa (110 €)</option>
								<option value="180">Gran Galà Reale a 7-10 Punti (per strascichi molto lunghi) (180 €)</option>
							</select>
						</div>
					</div>

					<!-- 4. Embellishments, Steaming & Rush Surcharge -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<label class="service-checkbox-label" style="background:#fff;">
								<input type="checkbox" id="chk-beading-repair" value="80" class="alt-checkbox">
								<span>Applicazione Pizzo e Perline a Mano (80 €)</span>
							</label>

							<label class="service-checkbox-label" style="background:#fff;">
								<input type="checkbox" id="chk-steaming-press" value="75" checked class="alt-checkbox">
								<span>Stiratura Professionale a Vapore (75 €)</span>
							</label>
						</div>

						<div style="margin-top: 0.25rem;">
							<label for="select-timeline-rush" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Tempistiche Prove & Supplemento Urgenza
							</label>
							<select id="select-timeline-rush" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
								<option value="1.0" selected>Tempistiche Standard (8 - 12 settimane prima) (Nessun supplemento)</option>
								<option value="1.2">Consegna Espresso (4 - 6 settimane prima) (+20% di maggiorazione)</option>
								<option value="1.45">Urgenza Ultimo Minuto (Meno di 3 settimane) (+45% di maggiorazione)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Alteration Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								👗 Preventivo Sartoriale Stimato
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Prospetto indicativo per le 3 prove in atelier
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Esporta Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Stampa PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Estimated Range Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Totale Lavorazioni Sartoriali</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">480 €</strong>
						<span id="res-range-subtext" style="font-size: 0.8rem; color: var(--accent-red);">Range equilibrato: 420 € – 550 €</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Dettaglio Ritocchi
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">✂️ Orlo Gonna & Sottogonne:</td>
									<td id="res-hem-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">190 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🪡 Bustino, Spalline & Coppe:</td>
									<td id="res-bodice-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">175 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">👗 Sistema Sollevamento Strascico:</td>
									<td id="res-bustle-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">110 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">✨ Rifiniture & Stiratura Professionale:</td>
									<td id="res-extras-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">75 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Maggiorazione Urgenza:</td>
									<td id="res-rush-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">0 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Cost Scale Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Semplice (200 €)</span>
							<span>Media (500 €)</span>
							<span style="color: var(--accent-red);">Alta Sartoria (900 €+)</span>
						</div>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="cost-gauge-bar" style="width: 48%; height: 100%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Fitting Appointment Reminder Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						📌 Promemoria per le Prove in Atelier:
					</strong>
					<ul class="font-body" style="font-size: 0.85rem; line-height: 1.5; padding-left: 1.1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Scarpe del matrimonio:</strong> Devi portare l'altezza esatta del tacco per segnare l'orlo.</li>
						<li><strong>Intimo nuziale:</strong> Indossa lo stesso reggiseno/body modellante previsto per il grande giorno.</li>
						<li><strong>Accompagnatrice:</strong> Porta la testimone alla seconda prova per imparare ad agganciare lo strascico!</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Scheda Modifiche Sartoriali Sposa</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Data: <span id="print-date"></span> | Totale Preventivo: <span id="print-total"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Lavorazione Sartoriale</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 120px; text-align: right;">Costo Stimato (€)</th>
					</tr>
				</thead>
				<tbody id="print-alteration-body"></tbody>
			</table>
		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guida Completa alle Modifiche dell'Abito da Sposa
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					I segreti per una vestibilità impeccabile, il calendario delle prove e come evitare imprevisti.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Il Calendario delle 3 Prove
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					La prima prova fissa la lunghezza dell'orlo e l'aderenza del corsetto. La seconda prova serve per verificare le cuciture definitive e testare il movimento con lo strascico sollevato. La terza e ultima prova è il ritiro finale pochi giorni prima delle nozze.
				</p>
			</section>

			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Domande Frequenti (FAQ)
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Cosa succede se perdo o prendo peso prima del matrimonio?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Le sarte esperte lasciano sempre qualche centimetro di margine nelle cuciture interne del bustino per piccoli aggiustamenti dell'ultimo minuto durante la seconda o terza prova.
					</p>
				</details>
			</section>
		</article>

		<RelatedTools currentPath="/it/dress-alterations-estimator" category="budget" />

	</main>
</Layout>

<style>
	.service-checkbox-label {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		cursor: pointer;
		font-size: 0.88rem;
		background: var(--bg-paper);
		border: 1px solid var(--fg-pencil);
		border-radius: 4px;
		padding: 0.45rem 0.6rem;
	}

	.print-only {
		display: none;
	}

	
</style>

<script is:inline>
	let currencySymbol = '€';

	const currencySelect = document.getElementById('currency-select');
	const selectHemType = document.getElementById('select-hem-type');
	const inputSkirtLayers = document.getElementById('input-skirt-layers');

	const chkTakeIn = document.getElementById('chk-take-in-bodice');
	const chkShortenStraps = document.getElementById('chk-shorten-straps');
	const chkSewCups = document.getElementById('chk-sew-in-cups');
	const chkReshapeNeck = document.getElementById('chk-reshape-neckline');
	const chkCorsetBack = document.getElementById('chk-corset-back');

	const selectBustleStyle = document.getElementById('select-bustle-style');
	const chkBeading = document.getElementById('chk-beading-repair');
	const chkSteaming = document.getElementById('chk-steaming-press');
	const selectTimeline = document.getElementById('select-timeline-rush');

	const resGrandTotal = document.getElementById('res-grand-total');
	const resRangeSubtext = document.getElementById('res-range-subtext');
	const resHemTotal = document.getElementById('res-hem-total');
	const resBodiceTotal = document.getElementById('res-bodice-total');
	const resBustleTotal = document.getElementById('res-bustle-total');
	const resExtrasTotal = document.getElementById('res-extras-total');
	const resRushTotal = document.getElementById('res-rush-total');
	const costGaugeBar = document.getElementById('cost-gauge-bar');

	function formatMoney(amount) {
		return `${Math.round(amount).toLocaleString('it-IT')} ${currencySymbol}`;
	}

	function calculateAlterations() {
		currencySymbol = currencySelect.value;

		// 1. Hem
		const baseHem = parseFloat(selectHemType.value) || 0;
		const layers = parseInt(inputSkirtLayers.value, 10) || 0;
		const hemTotal = baseHem + (layers * 35);

		// 2. Bodice
		let bodiceTotal = 0;
		if (chkTakeIn.checked) bodiceTotal += parseFloat(chkTakeIn.value);
		if (chkShortenStraps.checked) bodiceTotal += parseFloat(chkShortenStraps.value);
		if (chkSewCups.checked) bodiceTotal += parseFloat(chkSewCups.value);
		if (chkReshapeNeck.checked) bodiceTotal += parseFloat(chkReshapeNeck.value);
		if (chkCorsetBack.checked) bodiceTotal += parseFloat(chkCorsetBack.value);

		// 3. Bustle
		const bustleTotal = parseFloat(selectBustleStyle.value) || 0;

		// 4. Extras
		let extrasTotal = 0;
		if (chkBeading.checked) extrasTotal += parseFloat(chkBeading.value);
		if (chkSteaming.checked) extrasTotal += parseFloat(chkSteaming.value);

		const subtotal = hemTotal + bodiceTotal + bustleTotal + extrasTotal;
		const rushMultiplier = parseFloat(selectTimeline.value) || 1.0;
		const rushFee = (subtotal * rushMultiplier) - subtotal;
		const grandTotal = subtotal + rushFee;

		const low = Math.round(grandTotal * 0.88);
		const high = Math.round(grandTotal * 1.15);

		resGrandTotal.textContent = formatMoney(grandTotal);
		resRangeSubtext.textContent = `Range equilibrato: ${formatMoney(low)} – ${formatMoney(high)}`;
		resHemTotal.textContent = formatMoney(hemTotal);
		resBodiceTotal.textContent = formatMoney(bodiceTotal);
		resBustleTotal.textContent = formatMoney(bustleTotal);
		resExtrasTotal.textContent = formatMoney(extrasTotal);
		resRushTotal.textContent = formatMoney(rushFee);

		const gaugePct = Math.min(100, Math.max(15, Math.round((grandTotal / 900) * 100)));
		costGaugeBar.style.width = `${gaugePct}%`;
	}

	document.querySelectorAll('.alt-checkbox, #input-skirt-layers').forEach(el => {
		el.addEventListener('input', calculateAlterations);
		el.addEventListener('change', calculateAlterations);
	});
	[selectHemType, selectBustleStyle, selectTimeline, currencySelect].forEach(el => {
		el.addEventListener('change', calculateAlterations);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Scheda Modifiche Sartoriali Sposa</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Scheda Modifiche Sartoriali Abito Sposa</h1>
				<p>Data: ${new Date().toLocaleDateString('it-IT')} | Totale Stimato: <strong>${resGrandTotal.textContent}</strong> (${resRangeSubtext.textContent})</p>
				<table>
					<thead>
						<tr>
							<th>Lavorazione Sartoriale</th>
							<th style="text-align:right;">Importo Stimato</th>
						</tr>
					</thead>
					<tbody>
						<tr><td>Orlo Gonna & Strati Fodera</td><td style="text-align:right; font-weight:bold;">${resHemTotal.textContent}</td></tr>
						<tr><td>Bustino, Spalline & Coppe Seno</td><td style="text-align:right; font-weight:bold;">${resBodiceTotal.textContent}</td></tr>
						<tr><td>Sistema Sollevamento Strascico</td><td style="text-align:right; font-weight:bold;">${resBustleTotal.textContent}</td></tr>
						<tr><td>Rifiniture Pizzo & Stiratura a Vapore</td><td style="text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
						<tr><td>Supplemento Urgenza</td><td style="text-align:right; font-weight:bold;">${resRushTotal.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold;">
							<td>Totale Lavorazioni Sartoriali</td>
							<td style="text-align:right; color:#b91c1c;">${resGrandTotal.textContent}</td>
						</tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Modifiche_Sartoria_Sposa_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('it-IT');
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-alteration-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Orlo Gonna & Sottogonne</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resHemTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Bustino, Spalline & Coppe Seno</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBodiceTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Sistema Sollevamento Strascico</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBustleTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Rifiniture & Stiratura Professionale</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Supplemento Urgenza</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resRushTotal.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Totale Preventivo Sartoria</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Lavorazione,Importo Stimato\n";
		csv += `"Orlo Gonna","${resHemTotal.textContent}"\n`;
		csv += `"Bustino e Coppe","${resBodiceTotal.textContent}"\n`;
		csv += `"Sollevamento Strascico","${resBustleTotal.textContent}"\n`;
		csv += `"Rifiniture e Stiratura","${resExtrasTotal.textContent}"\n`;
		csv += `"Supplemento Urgenza","${resRushTotal.textContent}"\n`;
		csv += `"Totale Sartoria","${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Modifiche_Sartoria_Sposa_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateAlterations();
</script>
