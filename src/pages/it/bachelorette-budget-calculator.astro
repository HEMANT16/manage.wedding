---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/bachelorette-budget-calculator/#webapp",
      "name": "Calcolatore Budget Addio al Nubilato & Ripartizione Quote",
      "url": "https://manage.wedding/it/bachelorette-budget-calculator",
      "inLanguage": "it",
      "description": "Calcolatore gratuito per l'addio al nubilato: calcola la quota a persona per hotel, cene, spa e gadget offrendo la parte della sposa con testo pronto per WhatsApp.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come dividere equamente le spese per l'addio al nubilato",
      "description": "Guida per le testimoni per calcolare il budget, dividere la quota della sposa e riscuotere i pagamenti.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Definire il numero di partecipanti e la quota della sposa",
          "text": "Conta le amiche partecipanti e stabilisci se la quota della sposa sarà offerta equamente da tutte le invitate (formula N-1)."
        },
        {
          "@type": "HowToStep",
          "name": "2. Raccogliere le spese fisse di gruppo",
          "text": "Somma il costo totale di alloggio (Airbnb/hotel), trasporti, benzina/pedaggi e decorazioni/gadget."
        },
        {
          "@type": "HowToStep",
          "name": "3. Stimare pasti, aperitivi e attività",
          "text": "Aggiungi le spese per cene, aperitivi con drink, ingressi spa o noleggio barca a vela."
        },
        {
          "@type": "HowToStep",
          "name": "4. Inviare la richiesta di pagamento su WhatsApp",
          "text": "Copia il messaggio con il dettaglio dei costi e le coordinate (Satispay/PayPal/IBAN) per raccogliere l'acconto."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "La sposa deve pagare per il proprio addio al nubilato?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Secondo la tradizione, la sposa è ospite d'onore e non paga per l'alloggio, le cene, i drink e le attività del weekend: la sua quota viene suddivisa equamente tra tutte le amiche partecipanti."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto costa mediamente un addio al nubilato a persona in Italia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un weekend fuori in una capitale europea o al mare costa mediamente tra i 250 € e i 450 € a partecipante (inclusa la quota della sposa). Una giornata singola con spa e cena oscilla tra gli 80 € e i 150 € a persona."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Budget Addio al Nubilato & Ripartizione Quote | Manage.Wedding"
	description="Calcola la quota a persona per l'addio al nubilato: hotel/Airbnb, cene, attività, gadget e regalo per la sposa con messaggio pronto per WhatsApp."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Quote Addio al Nubilato" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Offri la Quota alla Sposa & Invia su WhatsApp</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Calcolatore Budget <span class="accent-italic">Addio al Nubilato</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcola la spesa a testa per alloggio, cene, aperitivi, spa e gadget. Scorpora in automatico la quota della sposa ed esporta il messaggio per il gruppo WhatsApp in 1 click.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Trip Setup & Expense Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Dettagli Weekend & Spese
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Ripartizione Equa
					</span>
				</div>

				<!-- Destination / Preset Picker -->
				<div class="form-group">
					<label class="form-label" for="destination-preset">Tipologia di Addio al Nubilato</label>
					<select id="destination-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="spa" selected>🧖‍♀️ Weekend Relax & Terme (Saturnia/Bormio/Sirmione - 280 €/persona)</option>
						<option value="mare">⛵ Weekend al Mare & Barca (Salento/Ibiza/Riviera - 350 €/persona)</option>
						<option value="city">✈️ City Break Europeo (Barcellona/Lisbona/Madrid - 320 €/persona)</option>
						<option value="casale">🏡 Casale in Campagna con Piscina (Toscana/Umbria - 190 €/persona)</option>
						<option value="giornata">🍸 Giornata Singola: Spa, Aperitivo & Cena (110 €/persona)</option>
						<option value="custom">✏️ Inserimento Personalizzato</option>
					</select>
				</div>

				<!-- Bride Name & Total Attendees -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="bride-name">Nome della Sposa</label>
						<input type="text" id="bride-name" class="form-input" value="Giulia" placeholder="es. Giulia" />
					</div>
					<div>
						<label class="form-label" for="bridesmaid-count">Amiche Paganti</label>
						<input type="number" id="bridesmaid-count" class="form-input" value="6" min="1" max="30" />
					</div>
				</div>

				<!-- Cover the Bride Toggle -->
				<div class="form-group" style="background: #fffcf5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 0.98rem; margin: 0;">
						<input type="checkbox" id="toggle-cover-bride" checked style="width: 18px; height: 18px;" />
						<span>Offrire la Quota alla Sposa (La sposa paga 0 €)</span>
					</label>
					<span style="font-size: 0.82rem; color: #64748b; display: block; margin-top: 4px; margin-left: 26px;">
						Le 6 partecipanti si dividono equamente l'intero importo delle spese di gruppo.
					</span>
				</div>

				<!-- Shared Fixed Expenses -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Spese di Gruppo & Alloggio (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="airbnb-total" style="font-size: 0.9rem;">Airbnb / Hotel Totale</label>
							<input type="number" id="airbnb-total" class="form-input" value="800" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="transport-total" style="font-size: 0.9rem;">Benzina, Pedaggi & Navette</label>
							<input type="number" id="transport-total" class="form-input" value="150" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="decor-total" style="font-size: 0.9rem;">Gadget, Velo & Magliette</label>
							<input type="number" id="decor-total" class="form-input" value="120" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="grocery-total" style="font-size: 0.9rem;">Spesa Casa & Prosecco</label>
							<input type="number" id="grocery-total" class="form-input" value="160" min="0" step="20" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Dining & Group Activities -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Cene & Attività di Gruppo (€)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="dining-total" style="font-size: 0.9rem;">Cene, Pranzi & Aperitivi</label>
							<input type="number" id="dining-total" class="form-input" value="450" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="activities-total" style="font-size: 0.9rem;">Ingresso Terme / Barca</label>
							<input type="number" id="activities-total" class="form-input" value="300" min="0" step="30" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Results Card & WhatsApp Exporter -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Cost Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Quota a Partecipante
						</span>
						<span id="bride-status-badge" style="font-size: 0.85rem; font-weight: 800; background: #16a34a; color: #fff; padding: 3px 8px; border-radius: 4px;">
							👰 Giulia Paga: 0 €
						</span>
					</div>

					<div id="display-per-person" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.5rem;">
						330 €
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Spesa totale del weekend: <strong id="display-trip-grand-total" style="color: var(--fg-pencil);">1.980 €</strong> divisa tra <span id="display-headcount-text">6 amiche paganti</span>.
					</p>

					<!-- Itemized Per-Person Split Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Quota Alloggio (Hotel / Airbnb):</span>
							<strong id="item-lodging-share">133 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Cene, Aperitivi & Spesa Casa:</span>
							<strong id="item-food-share">102 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Attività (Terme / Barca / Tour):</span>
							<strong id="item-activity-share">50 €</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.95rem;">
							<span>Gadget, Velo, Magliette & Viaggio:</span>
							<strong id="item-decor-share">45 €</strong>
						</div>
					</div>

					<!-- Payment Schedule Recommendation -->
					<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem; font-size: 0.9rem; line-height: 1.5;">
						<strong style="display: block; color: var(--fg-pencil); margin-bottom: 4px;">📅 Calendario Quote Consigliato:</strong>
						• <strong>Acconto 1 (Subito):</strong> <span id="sched-dep-1" style="font-weight: 700; color: var(--accent-red);">165 €</span> (per bloccare alloggio ed esperienze)<br />
						• <strong>Saldo 2 (2 Settimane Prima):</strong> <span id="sched-dep-2" style="font-weight: 700; color: var(--accent-blue);">165 €</span> (per cene, spesa e gadget)
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-copy-venmo" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📲</span> Copia Messaggio WhatsApp
						</button>
						<button id="btn-print-itinerary" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Stampa Prospetto (PDF)
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Come Organizzare l'Addio al Nubilato Perfetto
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Consigli per le testimoni per gestire budget, date e prenotazioni senza litigi.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. La Regola d'Oro del Budget per le Amiche
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Crea un sondaggio anonimo iniziale per capire il range di spesa sostenibile da tutte le partecipanti. Richiedi l'acconto per l'alloggio con largo anticipo (2–4 mesi prima) per confermare le presenze reali.
				</p>
			</section>

			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Domande Frequenti (FAQ)
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Cosa fare se un'amica può partecipare solo a una parte del weekend?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Calcola per lei solo la quota della cena o dell'attività a cui prende parte, più un piccolo contributo simbolico per il regalo o il brindisi della sposa.
					</p>
				</details>
			</section>
		</article>

		<RelatedTools currentPath="/it/bachelorette-budget-calculator" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const presetSelect = document.getElementById('destination-preset');
		const brideNameInput = document.getElementById('bride-name');
		const bridesmaidCountInput = document.getElementById('bridesmaid-count');
		const toggleCoverBride = document.getElementById('toggle-cover-bride');

		const airbnbInput = document.getElementById('airbnb-total');
		const transportInput = document.getElementById('transport-total');
		const decorInput = document.getElementById('decor-total');
		const groceryInput = document.getElementById('grocery-total');
		const diningInput = document.getElementById('dining-total');
		const activitiesInput = document.getElementById('activities-total');

		const displayPerPerson = document.getElementById('display-per-person');
		const displayTripTotal = document.getElementById('display-trip-grand-total');
		const displayHeadcountText = document.getElementById('display-headcount-text');
		const brideStatusBadge = document.getElementById('bride-status-badge');

		const itemLodgingShare = document.getElementById('item-lodging-share');
		const itemFoodShare = document.getElementById('item-food-share');
		const itemActivityShare = document.getElementById('item-activity-share');
		const itemDecorShare = document.getElementById('item-decor-share');

		const schedDep1 = document.getElementById('sched-dep-1');
		const schedDep2 = document.getElementById('sched-dep-2');

		const btnVenmo = document.getElementById('btn-copy-venmo');
		const btnPrint = document.getElementById('btn-print-itinerary');

		function calculateBachelorette() {
			const brideName = brideNameInput.value.trim() || 'La Sposa';
			const payingCount = parseInt(bridesmaidCountInput.value, 10) || 1;
			const isCoveringBride = toggleCoverBride.checked;

			const airbnb = parseFloat(airbnbInput.value) || 0;
			const transport = parseFloat(transportInput.value) || 0;
			const decor = parseFloat(decorInput.value) || 0;
			const grocery = parseFloat(groceryInput.value) || 0;
			const dining = parseFloat(diningInput.value) || 0;
			const activities = parseFloat(activitiesInput.value) || 0;

			const grandTotal = airbnb + transport + decor + grocery + dining + activities;
			const perPersonTotal = grandTotal / payingCount;

			displayTripTotal.textContent = `${Math.round(grandTotal).toLocaleString('it-IT')} €`;
			displayPerPerson.textContent = `${Math.round(perPersonTotal).toLocaleString('it-IT')} €`;
			displayHeadcountText.textContent = `${payingCount} amiche paganti`;

			if (isCoveringBride) {
				brideStatusBadge.textContent = `👰 ${brideName} Paga: 0 €`;
				brideStatusBadge.style.backgroundColor = '#16a34a';
			} else {
				brideStatusBadge.textContent = `👰 ${brideName} Paga la Quota`;
				brideStatusBadge.style.backgroundColor = '#d97706';
			}

			itemLodgingShare.textContent = `${Math.round(airbnb / payingCount).toLocaleString('it-IT')} €`;
			itemFoodShare.textContent = `${Math.round((dining + grocery) / payingCount).toLocaleString('it-IT')} €`;
			itemActivityShare.textContent = `${Math.round(activities / payingCount).toLocaleString('it-IT')} €`;
			itemDecorShare.textContent = `${Math.round((decor + transport) / payingCount).toLocaleString('it-IT')} €`;

			const halfDeposit = Math.round(perPersonTotal / 2);
			schedDep1.textContent = `${halfDeposit.toLocaleString('it-IT')} €`;
			schedDep2.textContent = `${(Math.round(perPersonTotal) - halfDeposit).toLocaleString('it-IT')} €`;
		}

		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'spa') {
				airbnbInput.value = 800;
				transportInput.value = 150;
				decorInput.value = 120;
				groceryInput.value = 160;
				diningInput.value = 450;
				activitiesInput.value = 300;
			} else if (p === 'mare') {
				airbnbInput.value = 1000;
				transportInput.value = 200;
				decorInput.value = 150;
				groceryInput.value = 200;
				diningInput.value = 550;
				activitiesInput.value = 400;
			} else if (p === 'city') {
				airbnbInput.value = 900;
				transportInput.value = 250;
				decorInput.value = 100;
				groceryInput.value = 120;
				diningInput.value = 500;
				activitiesInput.value = 250;
			} else if (p === 'casale') {
				airbnbInput.value = 650;
				transportInput.value = 120;
				decorInput.value = 100;
				groceryInput.value = 220;
				diningInput.value = 300;
				activitiesInput.value = 150;
			} else if (p === 'giornata') {
				airbnbInput.value = 0;
				transportInput.value = 40;
				decorInput.value = 70;
				groceryInput.value = 50;
				diningInput.value = 300;
				activitiesInput.value = 200;
			}
			calculateBachelorette();
		});

		[brideNameInput, bridesmaidCountInput, toggleCoverBride, airbnbInput, transportInput, decorInput, groceryInput, diningInput, activitiesInput].forEach(inp => {
			inp.addEventListener('input', calculateBachelorette);
		});

		btnVenmo.addEventListener('click', () => {
			const bride = brideNameInput.value.trim() || 'la nostra sposa';
			const perPerson = displayPerPerson.textContent;
			const dep1 = schedDep1.textContent;
			const dep2 = schedDep2.textContent;

			const text = `🎉 Ragazze! Ecco il riepilogo delle quote per l'Addio al Nubilato di ${bride}! 👰✨\n\n💰 Quota totale a testa (inclusa la parte di ${bride}): ${perPerson}\n\n📅 Abbiamo diviso il pagamento in 2 quote:\n1️⃣ Acconto per bloccare alloggio & esperienze: ${dep1} (da versare subito)\n2️⃣ Saldo per cene, spesa & gadget: ${dep2} (2 settimane prima del weekend)\n\nPotete inviare la quota tramite Satispay / PayPal / Bonifico! Fateci sapere appena fatto 🍾🥳`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnVenmo.innerHTML;
				btnVenmo.innerHTML = '<span>✅</span> Messaggio Copiato!';
				setTimeout(() => { btnVenmo.innerHTML = orig; }, 2500);
			});
		});

		btnPrint.addEventListener('click', () => {
			window.print();
		});

		calculateBachelorette();
	</script>
</Layout>
