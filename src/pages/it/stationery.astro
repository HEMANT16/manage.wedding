---
import Layout from '../../layouts/Layout.astro';

const title = "Calcolatori Partecipazioni, Grafica Nozze & Idee Regalo (Gratuiti)";
const description = "Strumenti gratuiti per partecipazioni di matrimonio: intestazione buste con formule di cortesia, formati e margini di stampa 300 DPI, segnaposto e timer per discorsi.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/it/stationery/#collection",
      "name": "Calcolatori Partecipazioni & Grafica Nozze | Manage.Wedding",
      "url": "https://manage.wedding/it/stationery",
      "inLanguage": "it",
      "description": "Suite completa per la papeterie del matrimonio: intestazione buste partecipazioni, formati di stampa a 300 DPI, segnaposto pieghevoli, inviti digitali e timer discorsi.",
      "hasPart": [
        { "@type": "WebApplication", "name": "Intestazione Buste Partecipazioni", "url": "https://manage.wedding/it/wedding-envelope-addressing" },
        { "@type": "WebApplication", "name": "Formati Partecipazioni (A7 / A6)", "url": "https://manage.wedding/it/wedding-invitation-suite-sizer" },
        { "@type": "WebApplication", "name": "Calcolo Spese Postali & Ceralacca", "url": "https://manage.wedding/it/wedding-invitation-postage-calculator" },
        { "@type": "WebApplication", "name": "Segnaposto & Cavalieri da Tavolo", "url": "https://manage.wedding/it/table-place-cards" },
        { "@type": "WebApplication", "name": "Testi Biglietti di Ringraziamento", "url": "https://manage.wedding/it/wedding-thank-you-cards" },
        { "@type": "WebApplication", "name": "Partecipazioni di Nozze Digitali", "url": "https://manage.wedding/it/digital-invitations" },
        { "@type": "WebApplication", "name": "Timer Discorso dei Testimoni", "url": "https://manage.wedding/it/wedding-speech-calculator" },
        { "@type": "WebApplication", "name": "Generatore Hashtag Matrimonio", "url": "https://manage.wedding/it/wedding-hashtag-generator" },
        { "@type": "WebApplication", "name": "Numerologia della Data di Nozze", "url": "https://manage.wedding/it/wedding-date-numerology" },
        { "@type": "WebApplication", "name": "Anniversari di Nozze & Idee Regalo", "url": "https://manage.wedding/it/anniversary-gift-finder" }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Come si intestano correttamente le buste delle partecipazioni secondo il galateo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Secondo il galateo italiano: per un'intera famiglia si usa 'Famiglia [Cognome]' oppure 'Gentilissima Famiglia [Nome e Cognome]'; per una coppia sposata 'Gentilissimi [Nome di lui] e [Nome e Cognome di lei]'; per amici intimi o single 'Gentilissimo/a [Nome e Cognome]'."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto dura solitamente il discorso del testimone di nozze?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La durata ideale è tra i 3 e i 5 minuti (circa 400–600 parole a una velocità naturale di 120 parole al minuto). Discorsi oltre i 6 minuti rischiano di annoiare gli invitati."
          }
        }
      ]
    }
  ]
};

const stationeryTools = [
  {
    title: "Calcolatore Durata Playlist & Brani",
    url: "/it/wedding-playlist-duration-calculator",
    icon: "🎵",
    badge: "Timing Musicale",
    desc: "Calcola brani necessari per aperitivo, cena, primo ballo e festa dance. Include riepilogo per il DJ e lista brani vietati.",
    tags: ["Musica Matrimonio", "Brani per Ora", "Brief per il DJ"]
  },

  {
    title: "Intestazione Buste Partecipazioni",
    url: "/it/wedding-envelope-addressing",
    icon: "✉️",
    badge: "Galateo & Stampa",
    desc: "Formatta le formule di cortesia (Famiglie, Gent.mi, Dott./Ing.) per buste A7 e cartoncini RSVP con export in PDF pronto per la stampa.",
    tags: ["Formule di Cortesia", "Buste A7/C5", "Stampa PDF"]
  },
  {
    title: "Formati Partecipazioni (A7 / A6 / B6)",
    url: "/it/wedding-invitation-suite-sizer",
    icon: "📐",
    badge: "Misure 300 DPI",
    desc: "Calcola le dimensioni millimetriche perfette per invito principale, cartoncino RSVP, abbondanze di taglio e risoluzione 300 DPI per Canva.",
    tags: ["Formati A6 / A7 / B6", "Margini di Taglio", "Canva 300 DPI"]
  },
  {
    title: "Calcolo Spese Postali & Ceralacca",
    url: "/it/wedding-invitation-postage-calculator",
    icon: "📮",
    badge: "Tariffe Postali",
    desc: "Calcola il peso totale di cartoncini e buste, i supplementi per sigilli in ceralacca e le tariffe postali per invii ordinari e prioritari.",
    tags: ["Sigillo Ceralacca", "Grammatura Carta", "Tariffe Postali"]
  },
  {
    title: "Segnaposto & Cavalieri da Tavolo",
    url: "/it/table-place-cards",
    icon: "🏷️",
    badge: "Pronto da Stampare",
    desc: "Genera cartoncini segnaposto pieghevoli a cavalletto con nomi degli ospiti, numero del tavolo e icone di preferenza menù per i camerieri.",
    tags: ["Segnaposto Pieghevoli", "Icone Menù", "PDF Vettoriale"]
  },
  {
    title: "Testi Biglietti di Ringraziamento",
    url: "/it/wedding-thank-you-cards",
    icon: "✍️",
    badge: "Frasi & Formule",
    desc: "Genera frasi di ringraziamento eleganti e personalizzate per buste regalo in denaro, regali della lista nozze o contributi al viaggio.",
    tags: ["Busta in Denaro", "Lista Nozze", "Testi Ringraziamento"]
  },
  {
    title: "Partecipazioni di Nozze Digitali",
    url: "/it/digital-invitations",
    icon: "💌",
    badge: "Inviti WhatsApp & Web",
    desc: "Crea inviti digitali moderni con pulsante per confermare la presenza online (RSVP) e salvataggio automatico dell'evento nel calendario (.ics).",
    tags: ["Inviti WhatsApp", "RSVP Online", "File Calendario .ics"]
  },
  {
    title: "Timer Discorso dei Testimoni & Sposi",
    url: "/it/wedding-speech-calculator",
    icon: "🎙️",
    badge: "Cronometro & WPM",
    desc: "Incolla il testo del tuo discorso o delle promesse di matrimonio per calcolare i minuti di lettura (120 WPM) e stampare foglietti promemoria.",
    tags: ["Velocità di Lettura", "Foglietti Promemoria", "Promesse di Nozze"]
  },
  {
    title: "Generatore Hashtag Matrimonio",
    url: "/it/wedding-hashtag-generator",
    icon: "#️⃣",
    badge: "Social & Cartelli",
    desc: "Genera hashtag originali e divertenti per le foto Instagram dei tuoi ospiti, con cartello grafico coordinato da stampare per i tavoli.",
    tags: ["Hashtag Nozze", "Foto Instagram", "Cartelli Tavolo"]
  },
  {
    title: "Numerologia della Data di Nozze",
    url: "/it/wedding-date-numerology",
    icon: "✨",
    badge: "Significato Data",
    desc: "Calcola il numero del destino della coppia e scopri l'energia numerologica del giorno in cui pronuncerete il vostro sì.",
    tags: ["Numero del Destino", "Significato Data", "Armonia Coppia"]
  },
  {
    title: "Anniversari di Nozze & Idee Regalo",
    url: "/it/anniversary-gift-finder",
    icon: "💎",
    badge: "Dal 1° al 60° Anno",
    desc: "Nozze di Carta, Seta, Legno, Argento e Oro: scopri i simboli tradizionali, i fiori, le pietre preziose e i testi per i biglietti di auguri.",
    tags: ["Nozze d'Argento", "Nozze d'Oro", "Idee Regalo"]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    
    <!-- Hero Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">Hub Partecipazioni & Grafica</span>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Calcolatori <span class="accent-italic">Partecipazioni & Grafica</span> Nozze
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Formatta l'intestazione delle buste secondo il galateo, calcola i formati di stampa a 300 DPI, genera segnaposto pieghevoli e calcola i tempi dei discorsi dei testimoni.
      </p>
    </header>

    <!-- Category Nav Bar -->
    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: #64748b; align-self: center;">Categorie:</span>
      <a href="/it/budget" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">💰 Budget</a>
      <a href="/it/dining" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">🍾 Banchetto & Bar</a>
      <a href="/it/guests" class="tool-tag" style="text-decoration: none; padding: 6px 14px; background: #fff; border: 1.5px solid var(--fg-pencil);">👥 Invitati & Logistica</a>
      <a href="/it/stationery" class="tool-tag" style="background: var(--post-it); font-weight: 700; text-decoration: none; padding: 6px 14px; border: 2px solid var(--fg-pencil);">💌 Partecipazioni (Attivo)</a>
    </div>

    <!-- Tools Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 4rem;">
      {stationeryTools.map(tool => (
        <div class="hand-card" style="padding: 1.75rem; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span style="font-size: 2.2rem;">{tool.icon}</span>
              <span style="font-size: 0.78rem; font-weight: 700; background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
                {tool.badge}
              </span>
            </div>
            
            <h2 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
              {tool.title}
            </h2>
            
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 0.75rem;">
              {tool.tags.map(t => (
                <span class="tool-tag" style="font-size: 0.75rem; padding: 2px 6px;">{t}</span>
              ))}
            </div>

            <p class="font-body" style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 1.5rem;">
              {tool.desc}
            </p>
          </div>

          <a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; padding: 10px; font-size: 1rem; text-decoration: none; display: block; box-sizing: border-box;">
            Apri Strumento →
          </a>
        </div>
      ))}
    </div>

    <!-- In-Depth Stationery Guide -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">Galateo della Papeterie</span>
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          Guida ai Formati e all'Intestazione delle Partecipazioni
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Tutto quello che c'è da sapere sulle formule di cortesia, grammatura della carta e formati di stampa.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. I Formati Standard per gli Inviti di Nozze
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Per consentire a tutti i cartoncini di inserirsi agevolmente nella busta senza pieghe, rispetta le misure standard:
        </p>
        
        <div style="overflow-x: auto; margin-top: 1rem; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
            <thead>
              <tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Elemento della Suite</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Formato Standard</th>
                <th style="padding: 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Dimensioni in Pixel (300 DPI)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Busta Esterna (A7 / C5)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">13,3 × 18,4 cm</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1575 × 2175 px</td>
              </tr>
              <tr style="background: #faf8f5;">
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Partecipazione Principale</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">12,7 × 17,8 cm (5x7)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1500 × 2100 px (con 2mm abbondanza)</td>
              </tr>
              <tr>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Cartoncino RSVP / Invito Ricevimento</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">8,9 × 12,7 cm (A2 / A6)</td>
                <td style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil);">1050 × 1500 px</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      <section>
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
          Domande Frequenti (FAQ)
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <details style="cursor: pointer; padding: 1rem 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; background: #fff;">
            <summary class="font-heading" style="font-size: 1.1rem; color: var(--accent-blue); outline: none;">
              Le buste delle partecipazioni vanno chiuse o lasciate aperte se consegnate a mano?
            </summary>
            <p class="font-body" style="margin-top: 0.5rem; margin-bottom: 0; font-size: 0.95rem; color: var(--fg-pencil); line-height: 1.6;">
              Se la partecipazione viene consegnata a mano di persona, la busta non va sigillata (oppure va chiusa con un nastro o adesivo rimovibile). Va sigillata solo se spedita per posta.
            </p>
          </details>
        </div>
      </section>

    </article>

  </main>
</Layout>
