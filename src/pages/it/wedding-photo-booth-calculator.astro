<script is:inline>
	// Elements
	const selectBoothArchitecture = document.getElementById('select-booth-architecture');
	const selectMediaFormat = document.getElementById('select-media-format');
	const inputBoothGuests = document.getElementById('input-booth-guests');
	const selectParticipationRate = document.getElementById('select-participation-rate');
	const selectGuestbookMode = document.getElementById('select-guestbook-mode');
	const rangeWasteBuffer = document.getElementById('range-waste-buffer');
	const labelWasteBuffer = document.getElementById('label-waste-buffer');
	const selectTriggerType = document.getElementById('select-trigger-type');
	const selectPropsTier = document.getElementById('select-props-tier');

	const badgeTotalPrints = document.getElementById('badge-total-prints');
	const statFilmPacks = document.getElementById('stat-film-packs');
	const statFilmSub = document.getElementById('stat-film-sub');
	const statTotalCost = document.getElementById('stat-total-cost');
	const statCostSub = document.getElementById('stat-cost-sub');

	const statCameraSpec = document.getElementById('stat-camera-spec');
	const statTriggerSpec = document.getElementById('stat-trigger-spec');
	const statFrameSpec = document.getElementById('stat-frame-spec');
	const statGuestbookSpec = document.getElementById('stat-guestbook-spec');
	const statPensSpec = document.getElementById('stat-pens-spec');
	const statPropsSpec = document.getElementById('stat-props-spec');

	const statSpaceReq = document.getElementById('stat-space-req');
	const statPowerReq = document.getElementById('stat-power-req');
	const statSoftwareReq = document.getElementById('stat-software-req');

	// SVG Blueprint Tab switching
	const btnTabPvc = document.getElementById('btn-tab-pvc');
	const btnTabOpenair = document.getElementById('btn-tab-openair');
	const svgPvcBlueprint = document.getElementById('svg-pvc-blueprint');
	const svgOpenairBlueprint = document.getElementById('svg-openair-blueprint');

	if (btnTabPvc && btnTabOpenair && svgPvcBlueprint && svgOpenairBlueprint) {
		btnTabPvc.addEventListener('click', () => {
			btnTabPvc.style.background = 'var(--post-it)';
			btnTabOpenair.style.background = '#fff';
			svgPvcBlueprint.style.display = 'block';
			svgOpenairBlueprint.style.display = 'none';
		});

		btnTabOpenair.addEventListener('click', () => {
			btnTabOpenair.style.background = 'var(--post-it)';
			btnTabPvc.style.background = '#fff';
			svgPvcBlueprint.style.display = 'none';
			svgOpenairBlueprint.style.display = 'block';
		});
	}

	function calculateBooth() {
		const guests = Math.max(10, parseInt(inputBoothGuests.value, 10) || 125);
		const arch = selectBoothArchitecture.value;
		const format = selectMediaFormat.value;
		const participation = parseFloat(selectParticipationRate.value) || 0.75;
		const guestbookMode = selectGuestbookMode.value;
		const wasteBufferPercent = parseInt(rangeWasteBuffer.value, 10) || 15;

		labelWasteBuffer.textContent = `+${wasteBufferPercent}% Margine`;

		let printsPerUser = 1.0;
		if (guestbookMode === 'double') printsPerUser = 2.0;
		else if (guestbookMode === 'triple') printsPerUser = 2.8;

		const activeParticipants = Math.round(guests * participation);
		const basePrints = Math.round(activeParticipants * printsPerUser);
		const totalExposures = Math.round(basePrints * (1 + wasteBufferPercent / 100));

		badgeTotalPrints.textContent = `${totalExposures} Foto Totali`;

		let mediaPrimary = '';
		let mediaSub = '';
		let cost = 275;
		let cameraText = 'Fotocamera Reflex + Batteria Finta a Rete CA';
		let triggerText = selectTriggerType.options[selectTriggerType.selectedIndex].text;
		let frameText = 'Struttura PVC 3/4" (Smontabile in borsa)';
		let spaceText = '1,8 x 1 m Cabina (o 3x3 m Aperta)';
		let powerText = '1 Presa 220V + Nastro Gaffer Nero';
		let softwareText = 'DSLR Remote Pro / DSLRBooth (40-120 €)';

		// Media Sizing
		if (format === 'canon-selphy') {
			const boxes = Math.ceil(totalExposures / 108);
			mediaPrimary = `${boxes} Scatole Carta (108/scat)`;
			mediaSub = `(${boxes * 108} strisce pretagliate 10x15)`;
			cost = 45 + (boxes * 36) + 35 + (guestbookMode !== 'single' ? 45 : 0) + (arch === 'pvc-enclosed' ? 75 : 30);
		} else if (format === 'instax-mini') {
			const packs = Math.ceil(totalExposures / 20);
			mediaPrimary = `${packs} Twin Packs`;
			mediaSub = `(${packs * 20} foto Instax Mini)`;
			cost = (packs * 16) + 40 + (guestbookMode !== 'single' ? 45 : 0) + 35;
			cameraText = '2 Fotocamere Fujifilm Instax Mini';
		} else if (format === 'instax-wide') {
			const packs = Math.ceil(totalExposures / 20);
			mediaPrimary = `${packs} Twin Packs`;
			mediaSub = `(${packs * 20} foto Instax WIDE)`;
			cost = (packs * 21) + 40 + (guestbookMode !== 'single' ? 50 : 0) + 35;
			cameraText = '2 Fotocamere Fujifilm Instax WIDE';
		} else if (format === 'polaroid-itype') {
			const packs = Math.ceil(totalExposures / 8);
			mediaPrimary = `${packs} Pack (8/pack)`;
			mediaSub = `(${packs * 8} foto Polaroid Quadrate)`;
			cost = (packs * 18) + 40 + (guestbookMode !== 'single' ? 45 : 0) + 35;
			cameraText = '2 Fotocamere Polaroid Now / Go';
		} else if (format === 'dnp-pro') {
			const rolls = Math.ceil(totalExposures / 700);
			mediaPrimary = `${rolls} Rotolo Termico (700 stampe)`;
			mediaSub = 'Rotolo Professionale DNP a Sublimazione';
			cost = 50 + (rolls * 110) + 40 + 35;
		} else {
			mediaPrimary = '0 Carta Fisica';
			mediaSub = 'Galleria Cloud e AirDrop Illimitata';
			cost = 45 + 35;
		}

		if (arch === 'pvc-enclosed') {
			frameText = 'Struttura PVC 3/4" + Teli Stoffa + Cornice 30x40 cm';
			spaceText = '1,8 x 1 m (2 m² di ingombro)';
			powerText = '1 Presa (PC + Monitor + Stampante + Pulsante 12V)';
			softwareText = 'DSLR Remote Pro / Breeze (Interfaccia 4 Schermi)';
		} else if (arch === 'open-air-ipad') {
			frameText = 'Treppiede Rinforzato iPad + Ring Light LED 18"';
			spaceText = '3 x 3 m (9-10 m² di ingombro)';
			cameraText = 'iPad 10,2"+ in Modalità Kiosk';
			softwareText = 'LumaBooth / Simple Booth / Touchpix';
		} else if (arch === 'pro-rental') {
			cost = 950 + (guests > 150 ? 150 : 0);
			mediaPrimary = 'Stampe Illimitate dal Vivo';
			mediaSub = 'Gestito dal Tecnico del Noleggio';
			cameraText = 'Fotocamera Reflex + Flash da Studio';
			frameText = 'Struttura in Alluminio Professionale';
			softwareText = 'Gestito dall\'Azienda di Noleggio';
		}

		statFilmPacks.textContent = mediaPrimary;
		statFilmSub.textContent = mediaSub;
		statCameraSpec.textContent = cameraText;
		statTriggerSpec.textContent = triggerText;
		statFrameSpec.textContent = frameText;
		statSpaceReq.textContent = spaceText;
		statPowerReq.textContent = powerText;
		statSoftwareReq.textContent = softwareText;

		if (arch === 'pro-rental') {
			statTotalCost.textContent = `${cost} € Noleggio`;
			statCostSub.textContent = 'Include Operatore e Tutta l\'Attrezzatura';
		} else {
			statTotalCost.textContent = `${cost} € DIY`;
			const savings = Math.max(350, 950 - cost);
			statCostSub.textContent = `(Risparmi ~${savings} € vs Noleggio)`;
		}

		// Props & Scrapbook breakdown
		const propsTier = selectPropsTier.value;
		let propsText = '45 Gadget e Cartelli';
		if (propsTier === 'deluxe') propsText = '70 Gadget VIP in PVC, Boa e Occhiali LED';
		else if (propsTier === 'minimal') propsText = '20 Occhiali da Sole Veri e Lavagnette';
		statPropsSpec.textContent = propsText;

		if (guestbookMode !== 'single') {
			statGuestbookSpec.textContent = `1 Album + ${Math.ceil(totalExposures * 2.5)} Punti Colla`;
			statPensSpec.textContent = '6 Penne Gel Metallizzate (Oro/Argento/Bianco)';
		} else {
			statGuestbookSpec.textContent = 'N/A (Nessun album guestbook)';
			statPensSpec.textContent = '2 Pennarelli Indelebili';
		}

		// Printable Vector Table
		document.getElementById('print-booth-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Materiale / Attrezzatura</th>
						<th style="padding:6pt;">Specifica Tecnica</th>
						<th style="padding:6pt; text-align:right;">Quantità Necessaria</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Pellicole / Carta Fotografica</td>
						<td style="padding:6pt;">${selectMediaFormat.options[selectMediaFormat.selectedIndex].text}</td>
						<td style="padding:6pt; text-align:right; font-weight:bold; color:#b91c1c;">${mediaPrimary}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Fotocamera & Alimentazione</td>
						<td style="padding:6pt;">${cameraText}</td>
						<td style="padding:6pt; text-align:right;">Incluso</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Pulsante di Avvio</td>
						<td style="padding:6pt;">${triggerText}</td>
						<td style="padding:6pt; text-align:right;">1 Unità</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Struttura & Cabina</td>
						<td style="padding:6pt;">${frameText}</td>
						<td style="padding:6pt; text-align:right;">${spaceText}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Gadget & Cartelli</td>
						<td style="padding:6pt;">${selectPropsTier.options[selectPropsTier.selectedIndex].text}</td>
						<td style="padding:6pt; text-align:right;"><strong>${propsText}</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Angolo Guestbook Scrapbook</td>
						<td style="padding:6pt;">${statPensSpec.textContent}</td>
						<td style="padding:6pt; text-align:right;">${statGuestbookSpec.textContent}</td>
					</tr>
					<tr style="background:#eff6ff; font-weight:bold; font-size:11pt; border-top:2pt solid #000;">
						<td style="padding:8pt;">BUDGET TOTALE STIMATO</td>
						<td style="padding:8pt;">4 Ore di Festa (${guests} invitati)</td>
						<td style="padding:8pt; text-align:right; color:#1e40af;">${statTotalCost.textContent}</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	// Event Listeners
	[selectBoothArchitecture, selectMediaFormat, inputBoothGuests, selectParticipationRate, selectGuestbookMode, rangeWasteBuffer, selectTriggerType, selectPropsTier].forEach(el => {
		el.addEventListener('input', calculateBooth);
		el.addEventListener('change', calculateBooth);
	});

	// Print Action
	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateBooth();
		window.print();
	});

	// Word Export Action
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateBooth();
		const media = statFilmPacks.textContent;
		const cost = statTotalCost.textContent;
		const space = statSpaceReq.textContent;
		const guests = inputBoothGuests.value;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Planimetria Photo Booth DIY Matrimonio</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Lista Tagli e Materiali Photo Booth DIY Matrimonio</h1>
				<p><strong>Invitati:</strong> ${guests} | <strong>Carta Necessaria:</strong> ${media} | <strong>Spazio:</strong> ${space} | <strong>Budget:</strong> ${cost}</p>
				<hr/>
				<p><em>Generato da Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Photo-Booth-Matrimonio-Piano-Maestro-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateBooth();
</script>
