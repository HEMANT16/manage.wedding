						<td style="padding:6pt; text-align:center;">~${fillerBunches} mazzi (10/pz)</td>
						<td style="padding:6pt;">Waxflower, Astilbe, Veronica, Nebbiolina, Cardo Blu</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">🌿 Verde & Fogliame (20%)</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#15803d;">${greeneryStems} steli</td>
						<td style="padding:6pt; text-align:center;">~${greeneryBunches} mazzi (10/pz)</td>
