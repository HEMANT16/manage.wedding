				</tbody>
			</table>
		`;
	}

	const allInputs = [
		selectFloralStyle, inputBridalBouquet, inputBridesmaidBouquets,
		inputBoutonnieres, inputCorsages, inputCenterpiecesLow,
		inputBudVases, selectArchInstall, inputCakeBarFlorals, selectBufferMargin
	];
	allInputs.forEach(input => {
		input.addEventListener('input', calculateFlorals);
		input.addEventListener('change', calculateFlorals);
	});

	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		calculateFlorals();
		window.print();
	});

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateFlorals();
		const totalStems = statTotalStems.textContent;
		const totalCost = statTotalFlowerCost.textContent;
		const bunches = badgeTotalBunches.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Ordine Fiori Matrimonio DIY</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Modulo Ordine: Fiori Matrimonio all'Ingrosso DIY</h1>
				<p><strong>Totale Steli:</strong> ${totalStems} steli | <strong>Mazzi:</strong> ${bunches} | <strong>Spesa Stimata:</strong> ${totalCost}</p>
				<hr/>
				<h2>Dettaglio Botanico</h2>
				<table>
					<tr style="background:#f1f5f9;">
						<th>Ruolo Botanico</th><th>Numero Steli</th><th>Varietà</th>
					</tr>
					<tr><td><strong>Fiori Protagonisti (35%):</strong></td><td>${statFocalStems.textContent}</td><td>Rose da Giardino, Peonie, Dalie</td></tr>
					<tr><td><strong>Secondari (30%):</strong></td><td>${statSecondaryStems.textContent}</td><td>Ranuncoli, Lisianthus, Garofani</td></tr>
					<tr><td><strong>Riempitivo (15%):</strong></td><td>${statFillerStems.textContent}</td><td>Waxflower, Astilbe, Nebbiolina</td></tr>
					<tr><td><strong>Verde (20%):</strong></td><td>${statGreeneryStems.textContent}</td><td>Eucalipto, Ruscus, Olivo</td></tr>
				</table>
				<hr/>
				<p><em>Generato da Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Fiori-Matrimonio-DIY-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateFlorals();
</script>
