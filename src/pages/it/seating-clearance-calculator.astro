---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/seating-clearance-calculator/#webapp",
      "name": "Calcolatore Spazi Sala Ricevimenti, Pista da Ballo e Distanze Tavoli",
      "url": "https://manage.wedding/it/seating-clearance-calculator",
      "inLanguage": "it",
      "description": "Calcola la superficie in metri quadri (m²) della sala ricevimento, le dimensioni ideali della pista da ballo, il numero di tavoli rotondi o imperiali e le distanze minime di passaggio per i camerieri.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come calcolare la metratura della sala e le dimensioni della pista da ballo",
      "description": "Metodo per verificare la capienza reale della location e disporre i tavoli garantendo il corretto passaggio del personale di servizio.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Stimare i ballerini attivi in contemporanea (Regola del 45%)",
          "text": "Moltiplica il totale degli invitati per il 45% per stimare quanti ospiti saranno sulla pista da ballo nei momenti di picco."
        },
        {
          "@type": "HowToStep",
          "name": "2. Calcolare i metri quadri della pista da ballo",
          "text": "Assegna circa 0,45 m² per ballerino attivo (es. 68 ballerini × 0,45 m² = circa 30 m²)."
        },
        {
          "@type": "HowToStep",
          "name": "3. Calcolare la superficie per i tavoli",
          "text": "Calcola 1,3–1,5 m² per ogni invitato seduto a tavoli rotondi, considerando la distanza minima di 1,5 metri tra i tavoli."
        },
        {
          "@type": "HowToStep",
          "name": "4. Aggiungere le aree buffet, open bar e postazione DJ",
          "text": "Aggiungi circa 40–60 m² per postazione musicale, bar e buffet per ottenere la metratura minima totale richiesta."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quanti metri quadri servono per un ricevimento di nozze con 150 invitati?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Per 150 invitati con cena servita ai tavoli, pista da ballo e open bar, la superficie minima consigliata della sala o tensostruttura è compresa tra 240 m² e 280 m²."
          }
        },
        {
          "@type": "Question",
          "name": "Qual è la distanza minima raccomandata tra i tavoli rotondi del matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "È fondamentale mantenere almeno 150 cm (1,5 metri) di spazio tra i bordi dei tavoli rotondi (da schienale a schienale). Questo lascia circa 45 cm per l'arretramento della sedia dell'ospite e un corridoio centrale di 60 cm per il passaggio agevole dei camerieri con vassoi caldi."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Spazi Sala Ricevimenti, Pista da Ballo & Distanze Tavoli | Manage.Wedding"
	description="Calcola i metri quadri (m²) necessari per la sala ricevimenti del matrimonio, le dimensioni della pista da ballo, il numero di tavoli rotondi da 150/180 cm e i corridoi di servizio per i camerieri."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Calcolatore Spazi Sala & Pista da Ballo" category="guests-logistics" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Dimensionamento Metrico & Pista da Ballo</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Spazi Sala Ricevimento <span class="accent-italic">& Pista da Ballo</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calcola i metri quadri necessari, le dimensioni della pista da ballo, il numero di tavoli e le distanze minime di passaggio per i camerieri (regola dei 150 cm).
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Guest Count, Table Style & Room Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Dati Ospiti & Sala
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Calcolo Metrico (m²)
					</span>
				</div>

				<!-- Venue Layout Presets -->
				<div class="form-group">
					<label class="form-label" for="layout-preset">Tipologia di Location o Ricevimento</label>
					<select id="layout-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="ballroom-150" selected>🏨 Sala Hotel / Villa (150 Ospiti / Tavoli Rotondi Ø 150 cm / DJ)</option>
						<option value="tent-200">🎪 Tensostruttura Giardino (200 Ospiti / 12×24 m / Palco Band)</option>
						<option value="barn-120">🌾 Masseria / Rustico (120 Ospiti / Tavoli Misti)</option>
						<option value="intimate-75">🏛️ Dimora Storica / Cena Intima (75 Ospiti)</option>
						<option value="custom">✏️ Parametri Personalizzati</option>
					</select>
				</div>

				<!-- Guest Count & Dancing Participation -->
				<div style="display: grid; grid-template-columns: 1.1fr 1.3fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="input-guests">Numero Invitati</label>
						<input type="number" id="input-guests" class="form-input" value="150" min="20" max="600" step="5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
					<div>
						<label class="form-label" for="dance-participation">Coinvolgimento Ballo</label>
						<select id="dance-participation" class="form-input" style="cursor: pointer; font-size: 0.95rem;">
							<option value="0.33">Atmosfera Tranquilla (33% ballerini)</option>
							<option value="0.45" selected>Standard Festoso (45% ballerini)</option>
							<option value="0.60">Party Scatenato (60% ballerini)</option>
						</select>
					</div>
				</div>

				<!-- Table Shape & Seating Density -->
				<div class="form-group">
					<label class="form-label" for="table-style">Tipologia Tavoli da Pranzo / Cena</label>
					<select id="table-style" class="form-input" style="cursor: pointer;">
						<option value="round-60" selected>Tavoli Rotondi Ø 150 cm (8 persone comode / max 10)</option>
						<option value="round-72">Tavoli Rotondi Ø 180 cm (10 persone comode / max 12)</option>
						<option value="rect-8ft">Tavoli Rettangolari / Imperiali 240×90 cm (8 persone)</option>
					</select>
				</div>

				<!-- Venue Dimensions (Optional Check) -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Dimensioni della Tua Sala in Metri (Verifica Spazio)
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
						<div>
							<label class="form-label" for="room-length" style="font-size: 0.9rem;">Lunghezza Sala (m)</label>
							<input type="number" id="room-length" class="form-input" value="18" min="5" step="1" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="room-width" style="font-size: 0.9rem;">Larghezza Sala (m)</label>
							<input type="number" id="room-width" class="form-input" value="15" min="5" step="1" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Entertainment & Service Buffers -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Postazioni di Servizio & Intrattenimento
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.92rem;">
						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-band" style="width: 18px; height: 18px;" />
							<span>Palco Band dal Vivo (20 m²) vs Postazione DJ (10 m²)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-buffet" checked style="width: 18px; height: 18px;" />
							<span>Isole Buffet / Dolci a Vista (15 m²)</span>
						</label>

						<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="check-bar-stations" checked style="width: 18px; height: 18px;" />
							<span>Postazioni Open Bar & Cocktail (20 m²)</span>
						</label>
					</div>
				</div>

			</div>

			<!-- Right Column: Results, Dance Floor Sizing & Capacity Check -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Clearance & Dance Floor Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Dimensioni Consigliate Pista da Ballo
						</span>
						<span id="dance-tile-count-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							~30 m²
						</span>
					</div>

					<div id="display-dance-dimensions" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						5,5 × 5,5 m (30 m²)
					</div>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin: 0 0 1.5rem 0;">
						Dimensionata per <strong id="display-peak-dancers" style="color: var(--fg-pencil);">68 ballerini simultanei</strong> (45% di 150 invitati @ 0,45 m²/persona).
					</p>

					<!-- Itemized Space Breakdown Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem;">
						<strong style="display: block; font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--fg-pencil);">
							📐 Ripartizione Superficie Sala Necessaria:
						</strong>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span>Tavoli da Pranzo / Cena (<strong id="display-tables-needed">19 Tavoli</strong>):</span>
							<strong id="display-dining-sqft">170 m²</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span>Superficie Pista da Ballo:</span>
							<strong id="display-dance-sqft">30 m²</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.92rem;">
							<span>Open Bar, Isole Buffet & Postazione DJ:</span>
							<strong id="display-production-sqft">45 m²</strong>
						</div>

						<div style="display: flex; justify-content: space-between; padding: 0.5rem 0 0 0; font-size: 1.05rem; font-weight: 700; color: var(--accent-red);">
							<span>SUPERFICIE MINIMA TOTALE SALA:</span>
							<strong id="display-total-room-needed">245 m²</strong>
						</div>
					</div>

					<!-- Venue Room Fit Evaluation Alert -->
					<div id="room-capacity-alert" style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem; font-size: 0.9rem; color: #166534; line-height: 1.5;">
						<strong id="alert-fit-title">✅ Spazio Perfetto (270 m² Disponibili):</strong><br />
						<span id="alert-fit-body">La tua sala da 18 × 15 m offre spazio sufficiente per 19 tavoli, pista da ballo e comodi corridoi di servizio da 150 cm.</span>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-floorplan" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Stampa Specifiche Sala (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Esporta Documento Word
						</button>
					</div>

				</div>

				<!-- Table Clearance & Service Rules Card -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						📏 La Regola dei 150 cm di Distanza tra i Tavoli:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Da Schienale a Schienale:</strong> Mantieni almeno <strong>150 cm</strong> tra i bordi dei tavoli per garantire circa 45 cm di sedia arretrata e un corridoio centrale di 60 cm per i camerieri con vassoi.</li>
						<li><strong>Distanza dai Muri:</strong> Posiziona i tavoli ad almeno <strong>100–120 cm</strong> dalle pareti e vetrate per consentire il passaggio fluido degli ospiti.</li>
						<li><strong>Tavolo Sposi / d'Onore:</strong> Lascia almeno <strong>3–4 metri</strong> di spazio libero di fronte al tavolo degli sposi verso la pista da ballo per gli scatti fotografici.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guida al Layout della Sala Ricevimenti & Pista da Ballo
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Come calcolare i metri quadri effettivi e garantire comodità e sicurezza durante la festa.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. Dimensioni e Capienza dei Tavoli Rotondi
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Nei banchetti nuziali italiani la misura standard più diffusa per i tavoli rotondi è il diametro da 150 cm (ideale per 8 persone) o 180 cm (ideale per 10-11 persone). Sovraffollare i tavoli toglie spazio ai calici, al centrotavola floreale e al sottopiatto.
				</p>
			</section>
		</article>

		<RelatedTools currentPath="/it/seating-clearance-calculator" category="guests-logistics" />
	</main>
</Layout>

<script is:inline>
	const presetSelect = document.getElementById('layout-preset');
	const inputGuests = document.getElementById('input-guests');
	const danceParticipation = document.getElementById('dance-participation');
	const tableStyle = document.getElementById('table-style');
	const roomLengthInput = document.getElementById('room-length');
	const roomWidthInput = document.getElementById('room-width');
	const checkBand = document.getElementById('check-band');
	const checkBuffet = document.getElementById('check-buffet');
	const checkBar = document.getElementById('check-bar-stations');

	function calculateFloorSpace() {
		const guests = parseInt(inputGuests.value, 10) || 100;
		const dancePct = parseFloat(danceParticipation.value) || 0.45;
		const style = tableStyle.value;

		const peakDancers = Math.round(guests * dancePct);
		const danceSqM = Math.round(peakDancers * 0.45);
		const danceSide = Math.round(Math.sqrt(danceSqM) * 10) / 10;

		let seatsPerTable = 8;
		let sqMPerGuest = 1.15;
		if (style === 'round-72') {
			seatsPerTable = 10;
			sqMPerGuest = 1.25;
		} else if (style === 'rect-8ft') {
			seatsPerTable = 8;
			sqMPerGuest = 1.05;
		}

		const tablesNeeded = Math.ceil(guests / seatsPerTable);
		const diningSqM = Math.round(guests * sqMPerGuest);

		let productionSqM = 0;
		if (checkBand.checked) productionSqM += 20;
		else productionSqM += 10;

		if (checkBuffet.checked) productionSqM += 15;
		if (checkBar.checked) productionSqM += 20;

		const totalRoomNeededSqM = diningSqM + danceSqM + productionSqM;

		const roomL = parseFloat(roomLengthInput.value) || 0;
		const roomW = parseFloat(roomWidthInput.value) || 0;
		const roomAreaAvailable = Math.round(roomL * roomW);

		document.getElementById('dance-tile-count-badge').textContent = `~${danceSqM} m²`;
		document.getElementById('display-dance-dimensions').textContent = `${danceSide} × ${danceSide} m (${danceSqM} m²)`;
		document.getElementById('display-peak-dancers').textContent = `${peakDancers} ballerini`;
		document.getElementById('display-tables-needed').textContent = `${tablesNeeded} Tavoli`;
		document.getElementById('display-dining-sqft').textContent = `${diningSqM} m²`;
		document.getElementById('display-dance-sqft').textContent = `${danceSqM} m²`;
		document.getElementById('display-production-sqft').textContent = `${productionSqM} m²`;
		document.getElementById('display-total-room-needed').textContent = `${totalRoomNeededSqM} m²`;

		const alertBox = document.getElementById('room-capacity-alert');
		const alertTitle = document.getElementById('alert-fit-title');
		const alertBody = document.getElementById('alert-fit-body');

		if (roomAreaAvailable > 0) {
			if (roomAreaAvailable >= totalRoomNeededSqM) {
				alertBox.style.background = '#f0fdf4';
				alertBox.style.borderColor = '#16a34a';
				alertBox.style.color = '#166534';
				alertTitle.textContent = `✅ Spazio Perfetto (${roomAreaAvailable} m² Disponibili):`;
				alertBody.textContent = `La tua sala da ${roomL} × ${roomW} m offre spazio sufficiente per ${tablesNeeded} tavoli, pista da ballo e corridoi di servizio da 150 cm.`;
			} else {
				alertBox.style.background = '#fee2e2';
				alertBox.style.borderColor = '#ef4444';
				alertBox.style.color = '#991b1b';
				alertTitle.textContent = `⚠️ Spazio Insufficiente (${roomAreaAvailable} m² disponibili su ${totalRoomNeededSqM} m² necessari):`;
				alertBody.textContent = `Mancano circa ${totalRoomNeededSqM - roomAreaAvailable} m². Valuta tavoli da 10 persone o riduci la pista da ballo.`;
			}
		}
	}

	[inputGuests, danceParticipation, tableStyle, roomLengthInput, roomWidthInput, checkBand, checkBuffet, checkBar].forEach(el => {
		el.addEventListener('input', calculateFloorSpace);
		el.addEventListener('change', calculateFloorSpace);
	});

	presetSelect.addEventListener('change', () => {
		const v = presetSelect.value;
		if (v === 'ballroom-150') {
			inputGuests.value = 150;
			tableStyle.value = 'round-60';
			roomLengthInput.value = 18;
			roomWidthInput.value = 15;
			checkBand.checked = false;
			checkBuffet.checked = true;
			checkBar.checked = true;
		} else if (v === 'tent-200') {
			inputGuests.value = 200;
			tableStyle.value = 'round-72';
			roomLengthInput.value = 24;
			roomWidthInput.value = 12;
			checkBand.checked = true;
			checkBuffet.checked = true;
			checkBar.checked = true;
		} else if (v === 'barn-120') {
			inputGuests.value = 120;
			tableStyle.value = 'rect-8ft';
			roomLengthInput.value = 16;
			roomWidthInput.value = 14;
			checkBand.checked = false;
			checkBuffet.checked = true;
			checkBar.checked = true;
		} else if (v === 'intimate-75') {
			inputGuests.value = 75;
			tableStyle.value = 'round-60';
			roomLengthInput.value = 12;
			roomWidthInput.value = 10;
			checkBand.checked = false;
			checkBuffet.checked = false;
			checkBar.checked = true;
		}
		calculateFloorSpace();
	});

	document.getElementById('btn-print-floorplan').addEventListener('click', () => window.print());

	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head><meta charset="utf-8"><title>Specifiche Metratura Sala Matrimonio</title></head>
			<body style="font-family: Arial, sans-serif; padding: 20px;">
				<h1>Manage.Wedding — Dimensionamento Sala e Pista da Ballo</h1>
				<p>Data: ${new Date().toLocaleDateString('it-IT')} | Ospiti: ${inputGuests.value}</p>
				<h3>Riepilogo Spazi:</h3>
				<p>Pista da ballo: ${document.getElementById('display-dance-dimensions').textContent}</p>
				<p>Tavoli necessari: ${document.getElementById('display-tables-needed').textContent} (${document.getElementById('display-dining-sqft').textContent})</p>
				<p>Servizi & Open Bar: ${document.getElementById('display-production-sqft').textContent}</p>
				<p><strong>Superficie Totale Consigliata: ${document.getElementById('display-total-room-needed').textContent}</strong></p>
			</body>
			</html>
		`;
		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Specifiche_Sala_Nozze_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateFloorSpace();
</script>
