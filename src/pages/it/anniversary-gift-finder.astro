---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/anniversary-gift-finder/#webapp",
      "name": "Guida Regali Anniversario di Nozze per Anno",
      "url": "https://manage.wedding/it/anniversary-gift-finder",
      "inLanguage": "it",
      "description": "Trova il regalo perfetto per l'anniversario di matrimonio (nozze di carta, cotone, cuoio, legno, stagno, cristallo, argento 25 anni, oro 50 anni). Idee regalo romantiche, moderne ed esperienziali con stampa in PDF e Word.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come scegliere il regalo di anniversario di matrimonio",
      "description": "Guida ai materiali tradizionali, moderni, pietre e fiori simbolici per ogni anniversario di nozze.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Selezionare l'anno di anniversario o inserire la data di nozze",
          "text": "Scegli l'anno dal menu (1° anno nozze di carta, 5° legno, 10° stagno, 25° argento, 50° oro) o calcola gli anni trascorsi."
        },
        {
          "@type": "HowToStep",
          "name": "2. Confrontare la tradizione italiana con le varianti moderne",
          "text": "Scopri il significato simbolico del materiale tradizionale e delle alternative contemporanee."
        },
        {
          "@type": "HowToStep",
          "name": "3. Scegliere la pietra o il fiore simbolico",
          "text": "Abbina il gioiello o il mazzo di fiori ufficiale della ricorrenza."
        },
        {
          "@type": "HowToStep",
          "name": "4. Esportare la proposta e il messaggio augurale",
          "text": "Stampa il riepilogo in PDF o Word con una dedica romantica pronta per il biglietto d'auguri."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quali sono i principali anniversari di nozze secondo la tradizione italiana?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "I più celebri sono: 1° anno Nozze di Carta, 5° Nozze di Legno, 10° Nozze di Stagno, 25° Nozze d'Argento, 50° Nozze d'Oro e 60° Nozze di Diamante."
          }
        },
        {
          "@type": "Question",
          "name": "Cosa regalare per il 1° anniversario di nozze (Nozze di Carta)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Regali classici e romantici in carta includono un album fotografico stampato del primo anno di matrimonio, le promesse nuziali incorniciate, una mappa stellare personalizzata o i biglietti per un concerto o viaggio speciale."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Guida Regali Anniversario di Nozze per Anno: Idee Tradizionali & Moderne | Manage.Wedding"
	description="Trova il regalo perfetto per l'anniversario di matrimonio (nozze di carta, cotone, cuoio, legno, stagno, cristallo, argento 25 anni, oro 50 anni). Idee regalo romantiche, moderne ed esperienziali con stampa in PDF e Word."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Regali Anniversario di Matrimonio" category="stationery" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Guida Regali Anniversario di Nozze
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Scopri i materiali tradizionali e moderni, le pietre e i fiori simbolici, e <strong>idee regalo curate</strong> per ogni traguardo dal 1° al 60° anno di matrimonio!
				</p>
			</div>
		</section>

		<!-- 3-Step Guide -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Come Scegliere il Regalo di Anniversario in 3 Passaggi
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Seleziona l'Anno o la Data
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Scegli l'anno delle nozze (1°, 5°, 10°, 25°, 50°) oppure inserisci la data per il calcolo automatico.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Personalizza Stile e Budget
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Seleziona la personalità del partner (Romantico, Esperienze, Gourmet, Casa) e la fascia di spesa desiderata.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Visualizza Idee & Frasi Augurali
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Visualizza proposte regalo mirate, frasi d'amore per il biglietto ed esporta in Word o PDF!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="gift-finder-grid">
			
			<!-- Left Column: Quiz Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🎁 Selezione Traguardo & Preferenze
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Seleziona l'anniversario o calcola dalla data di matrimonio
					</span>
				</div>

				<form id="gift-quiz-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- 1. Milestone Year Dropdown -->
					<div>
						<label for="select-anniversary-year" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--accent-red); margin-bottom: 0.25rem;">
							1. Seleziona Anno di Anniversario *
						</label>
						<select id="select-anniversary-year" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-heading); font-size: 1rem; background: #fff;">
							<option value="1" selected>1° Anno — Nozze di Carta (Moderno: Orologi)</option>
							<option value="2">2° Anno — Nozze di Cotone (Moderno: Porcellana)</option>
							<option value="3">3° Anno — Nozze di Cuoio (Moderno: Cristallo / Vetro)</option>
							<option value="4">4° Anno — Nozze di Fiori / Frutta (Moderno: Casa)</option>
							<option value="5">5° Anno — Nozze di Legno (Moderno: Posate Argento)</option>
							<option value="6">6° Anno — Nozze di Ferro / Zucchero (Moderno: Oggetti Legno)</option>
							<option value="7">7° Anno — Nozze di Lana / Rame (Moderno: Scrivania)</option>
							<option value="8">8° Anno — Nozze di Bronzo / Ceramica (Moderno: Pizzo)</option>
							<option value="9">9° Anno — Nozze di Salice / Terracotta (Moderno: Cuoio)</option>
							<option value="10">10° Anno — Nozze di Stagno / Alluminio (Moderno: Diamanti)</option>
							<option value="11">11° Anno — Nozze di Acciaio (Moderno: Gioielli Moda)</option>
							<option value="12">12° Anno — Nozze di Seta / Lino (Moderno: Perle)</option>
							<option value="13">13° Anno — Nozze di Pizzo (Moderno: Tessuti di Pregio)</option>
							<option value="14">14° Anno — Nozze d'Avorio Ecologico (Moderno: Oro)</option>
							<option value="15">15° Anno — Nozze di Cristallo (Moderno: Orologi di Lusso)</option>
							<option value="20">20° Anno — Nozze di Porcellana (Moderno: Platino)</option>
							<option value="25">25° Anno — Nozze d'Argento (Giubileo d'Argento)</option>
							<option value="30">30° Anno — Nozze di Perla (Moderno: Diamante)</option>
							<option value="35">35° Anno — Nozze di Corallo (Moderno: Giada)</option>
							<option value="40">40° Anno — Nozze di Rubino (Giubileo di Rubino)</option>
							<option value="45">45° Anno — Nozze di Zaffiro</option>
							<option value="50">50° Anno — Nozze d'Oro (Giubileo d'Oro)</option>
							<option value="55">55° Anno — Nozze di Smeraldo</option>
							<option value="60">60° Anno — Nozze di Diamante (Giubileo di Diamante)</option>
						</select>
					</div>

					<!-- Date Calculator Accordion -->
					<details style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<summary style="font-size: 0.88rem; font-family: var(--font-heading); color: var(--accent-blue); cursor: pointer;">
							📅 Oppure Calcola Automaticamente dalla Data di Matrimonio
						</summary>
						<div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.3rem;">
							<span style="font-size: 0.78rem; color: var(--text-secondary);">Inserisci la data in cui vi siete sposati:</span>
							<input type="date" id="input-wedding-date" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</details>

					<!-- 2. Partner's Personality Vibe -->
					<div>
						<label for="select-partner-vibe" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							2. Gusti e Personalità del Partner
						</label>
						<select id="select-partner-vibe" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="sentimental" selected>💖 Sentimentale & Romantico (Cornici, promesse incise, foto ricordo)</option>
							<option value="experiences">✈️ Esperienze & Viaggi (Weekend benessere, terme, cene stellate)</option>
							<option value="foodie">🍷 Enogastronomia & Cucina (Degustazioni vino, cesti gourmet, chef a domicilio)</option>
							<option value="practical">⚡ Tecnologia, Orologi & Accessori (Orologi, valigie, accessori design)</option>
							<option value="home">🏡 Casa & Relax (Arredi di design, plaid in cashmere, candele)</option>
						</select>
					</div>

					<!-- 3. Target Budget & Recipient -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="select-gift-budget" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								3. Budget Previsto
							</label>
							<select id="select-gift-budget" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="under50">Meno di 50 € (Dolce pensiero)</option>
								<option value="50to150" selected>50 € - 150 € (Fascia ideale)</option>
								<option value="150to300">150 € - 300 € (Regalo di pregio)</option>
								<option value="300plus">300 €+ (Alta gioielleria o viaggio)</option>
							</select>
						</div>

						<div>
							<label for="select-recipient" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								4. Destinatario
							</label>
							<select id="select-recipient" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="couple" selected>Per la Coppia (Condiviso)</option>
								<option value="her">Per Lei (Moglie / Partner)</option>
								<option value="him">Per Lui (Marito / Partner)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Themes & Curated Gift Stream -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Theme Overview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🎉 <span id="res-year-title">1° Anniversario di Nozze</span>
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Simboli ufficiali tradizionali e moderni
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Esporta Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Stampa PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Dual Themes Comparison Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
						<div style="background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-red); font-weight: bold; display: block;">
								Tradizione Italiana
							</span>
							<strong id="theme-traditional-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Nozze di Carta
							</strong>
							<p id="theme-traditional-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Simboleggia la pagina bianca e pulita su cui scrivere la vostra nuova storia insieme.
							</p>
						</div>

						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-blue); font-weight: bold; display: block;">
								Variante Moderna
							</span>
							<strong id="theme-modern-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Orologi
							</strong>
							<p id="theme-modern-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Rappresenta il tempo prezioso trascorso insieme e i secondi indimenticabili che verranno.
							</p>
						</div>
					</div>

					<!-- Gemstone & Flower Sub-Themes -->
					<div style="display: flex; justify-content: space-around; font-size: 0.85rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.5rem; margin-bottom: 1.25rem;">
						<span>💎 Pietra / Metallo: <strong id="theme-gemstone">Oro</strong></span>
						<span>🌸 Fiore Simbolico: <strong id="theme-flower">Garofano</strong></span>
					</div>

					<!-- 60-Year Milestone Progress Gauge -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.25rem;">
							<span>1° Anno (Carta)</span>
							<span>25° (Argento)</span>
							<span>50° (Oro)</span>
							<span>60° (Diamante)</span>
						</div>
						<div style="width: 100%; height: 16px; border: 1.5px solid var(--fg-pencil); border-radius: 8px; overflow: hidden; background: #eee;">
							<div id="gauge-milestone-bar" style="width: 5%; height: 100%; background: var(--accent-red); transition: width 0.4s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Curated Gift Recommendations Stream -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						🛍️ Idee Regalo ed Esperienze Consigliate
					</h3>
					<div id="curated-gifts-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<!-- Injected via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Guida Regalo Anniversario di Nozze</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Esportato il: <span id="print-date"></span> | Traguardo: <span id="print-milestone"></span></p>
			</div>
			<div id="print-content-body"></div>
		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Il Significato degli Anniversari di Nozze
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Dalla delicatezza della carta alla preziosità indistruttibile del diamante: la tradizione italiana per celebrare ogni anno d'amore.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. I Grandi Traguardi: Nozze d'Argento e Nozze d'Oro
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					I 25 anni (Nozze d'Argento) e i 50 anni (Nozze d'Oro) rappresentano i cardini della tradizione nuziale in Italia, spesso festeggiati con una benedizione religiosa degli anelli o un banchetto intimo in famiglia con confetti argentati o dorati.
				</p>
			</section>
		</article>

		<RelatedTools currentPath="/it/anniversary-gift-finder" category="stationery" />
	</main>
</Layout>

<style>
	.print-only {
		display: none;
	}

	
</style>

<script is:inline>
	const milestoneDB = {
		1: { 
			traditional: "Nozze di Carta", 
			modern: "Orologi", 
			gemstone: "Oro / Gioielli", 
			flower: "Garofano", 
			tDesc: "Simboleggia la pagina bianca e pulita su cui scrivere la vostra nuova storia insieme.", 
			mDesc: "Rappresenta il tempo prezioso trascorso insieme e i ricordi futuri.",
			gift1: { title: "Promesse Nuziali o Spartito del Primo Ballo Incorniciato", tag: "Carta Tradizionale", price: "35 € - 90 €", desc: "Stampa d'arte su carta cotone con le vostre promesse o la mappa stellare della notte delle nozze." },
			gift2: { title: "Orologio Minimalista da Tavolo o da Polso con Incisione", tag: "Orologio Moderno", price: "50 € - 140 €", desc: "Incisione personalizzata con la data del vostro matrimonio sul fondello." },
			gift3: { title: "Fotolibro Pregiato del Primo Anno di Matrimonio", tag: "Ricordo Fotografico", price: "40 € - 80 €", desc: "Album fotografico con copertina rigida con tutti i momenti del primo anno insieme." }
		},
		2: { 
			traditional: "Nozze di Cotone", 
