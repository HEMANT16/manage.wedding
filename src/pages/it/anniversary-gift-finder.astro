	function getMilestone(year) {
		if (milestoneDB[year]) return milestoneDB[year];
		const keys = Object.keys(milestoneDB).map(Number).sort((a,b) => a-b);
		let closest = keys[0];
		for (let k of keys) {
			if (k <= year) closest = k;
		}
		return milestoneDB[closest];
	}

	const yearSelect = document.getElementById('select-anniversary-year');
	const dateInput = document.getElementById('input-wedding-date');
	const vibeSelect = document.getElementById('select-partner-vibe');
	const budgetSelect = document.getElementById('select-gift-budget');
	const recipientSelect = document.getElementById('select-recipient');

	const resYearTitle = document.getElementById('res-year-title');
	const themeTraditionalTitle = document.getElementById('theme-traditional-title');
	const themeTraditionalDesc = document.getElementById('theme-traditional-desc');
	const themeModernTitle = document.getElementById('theme-modern-title');
	const themeModernDesc = document.getElementById('theme-modern-desc');
	const themeGemstone = document.getElementById('theme-gemstone');
	const themeFlower = document.getElementById('theme-flower');
	const gaugeMilestoneBar = document.getElementById('gauge-milestone-bar');
	const curatedGiftsContainer = document.getElementById('curated-gifts-container');

	function calculateYearsFromDate(dateStr) {
		const wedding = new Date(dateStr);
		const now = new Date();
		let y = now.getFullYear() - wedding.getFullYear();
		if (now.getMonth() < wedding.getMonth() || (now.getMonth() === wedding.getMonth() && now.getDate() < wedding.getDate())) {
			y--;
		}
		return Math.max(1, y);
	}

	function renderGifts() {
		let yr = parseInt(yearSelect.value) || 1;
		const mData = getMilestone(yr);
		const recipient = recipientSelect.value;

		resYearTitle.textContent = `${yr}° Anniversario di Nozze`;
		themeTraditionalTitle.textContent = mData.traditional;
		themeTraditionalDesc.textContent = mData.tDesc;
		themeModernTitle.textContent = mData.modern;
		themeModernDesc.textContent = mData.mDesc;
		themeGemstone.textContent = mData.gemstone;
		themeFlower.textContent = mData.flower;

		const pct = Math.min(100, Math.max(5, (yr / 60) * 100));
		gaugeMilestoneBar.style.width = `${pct}%`;

		const gifts = [mData.gift1, mData.gift2, mData.gift3];

		curatedGiftsContainer.innerHTML = '';
		gifts.forEach(item => {
			if (!item) return;
			const card = document.createElement('div');
			card.style.cssText = `background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;`;
			
			const amazonQuery = encodeURIComponent(`regalo anniversario ${mData.traditional} ${recipient === 'her' ? 'per lei moglie' : recipient === 'him' ? 'per lui marito' : 'coppia'}`);
			const amazonUrl = `https://www.amazon.it/s?k=${amazonQuery}&tag=managewedding-21`;

			card.innerHTML = `
				<div style="flex: 1;">
					<div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem;">
						<span style="font-size: 0.75rem; font-weight: bold; background: #eff6ff; color: #1e3a8a; padding: 0.1rem 0.35rem; border-radius: 3px;">${item.tag}</span>
						<span style="font-size: 0.75rem; color: #16a34a; font-weight: bold;">${item.price}</span>
					</div>
					<strong class="font-heading" style="font-size: 0.98rem; color: var(--fg-pencil); display: block;">${item.title}</strong>
					<p class="font-body" style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.15rem 0 0 0; line-height: 1.3;">${item.desc}</p>
				</div>
				<div>
					<a href="${amazonUrl}" target="_blank" rel="noopener noreferrer nofollow" class="hand-btn" style="padding: 0.35rem 0.65rem; font-size: 0.8rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem; background: #fff;">
						<span>🛒 Cerca Idee</span>
					</a>
				</div>
			`;
			curatedGiftsContainer.appendChild(card);
		});
	}

	yearSelect.addEventListener('change', renderGifts);

	dateInput.addEventListener('change', () => {
		if (dateInput.value) {
			const calculatedYr = calculateYearsFromDate(dateInput.value);
			const options = Array.from(yearSelect.options).map(o => parseInt(o.value));
			let match = options[0];
			for (let opt of options) {
				if (opt <= calculatedYr) match = opt;
			}
			yearSelect.value = match.toString();
			renderGifts();
		}
	});

	[vibeSelect, budgetSelect, recipientSelect].forEach(el => {
		el.addEventListener('change', renderGifts);
	});

	// Word Export
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head><meta charset="utf-8"><title>Regalo Anniversario</title></head>
			<body style="font-family: Arial, sans-serif; padding: 20px;">
				<h1>Manage.Wedding — Proposta Regalo ${yr}° Anniversario</h1>
				<p>Materiale Tradizionale: <strong>${mData.traditional}</strong> | Moderno: <strong>${mData.modern}</strong></p>
				<p>• Pietra: <strong>${mData.gemstone}</strong> | Fiore: <strong>${mData.flower}</strong></p>
				<h3>Idee Regalo:</h3>
				<p>1. ${mData.gift1.title} (${mData.gift1.price})</p>
				<p>2. ${mData.gift2.title} (${mData.gift2.price})</p>
				<p>3. ${mData.gift3.title} (${mData.gift3.price})</p>
				<h3>Dedica per il Biglietto:</h3>
				<p style="font-style:italic;">"Buon ${yr}° Anniversario, amore mio! Rivedere il nostro giorno e tutto ciò che abbiamo costruito insieme rende il mio amore per te ogni anno più forte. Per sempre noi!"</p>
			</body></html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `regalo-anniversario-${yr}-anni.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// PDF Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		document.getElementById('print-date').textContent = new Date().toLocaleDateString('it-IT');
		document.getElementById('print-milestone').textContent = `${yr}° Anniversario (${mData.traditional} / ${mData.modern})`;

		const body = document.getElementById('print-content-body');
		body.innerHTML = `
			<div style="border:1px solid #ccc; padding:15px; margin-bottom:15px;">
				<h2 style="margin:0 0 5px 0;">${yr}° Anno: ${mData.traditional} & ${mData.modern}</h2>
				<p style="margin:5px 0;"><strong>Pietra:</strong> ${mData.gemstone} | <strong>Fiore:</strong> ${mData.flower}</p>
				<p style="font-size:13px; color:#444;">${mData.tDesc}</p>
			</div>
			<div style="border:1px solid #ccc; padding:15px;">
				<h3 style="margin:0 0 8px 0;">Messaggio Consigliato per il Biglietto:</h3>
				<p style="font-style:italic; font-size:13px; margin:0;">"Buon ${yr}° Anniversario! Grazie per essere la mia roccia, il mio amore e la mia persona preferita con cui condividere ogni avventura. Viva noi!"</p>
			</div>
		`;

		window.print();
	});

	// CSV Export
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		let csv = "Anno Anniversario,Tradizionale,Moderno,Pietra,Fiore,Stile,Budget\n";
		csv += `"${yr}","${mData.traditional}","${mData.modern}","${mData.gemstone}","${mData.flower}","${vibeSelect.value}","${budgetSelect.value}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `anniversario-${yr}-anni.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	renderGifts();
</script>
