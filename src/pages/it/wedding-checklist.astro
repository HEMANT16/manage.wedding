---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-checklist/#webapp",
      "name": "Checklist Matrimonio 12 Mesi Interattiva",
      "url": "https://manage.wedding/it/wedding-checklist",
      "inLanguage": "it",
      "description": "Checklist completa e interattiva per organizzare il matrimonio in 12 mesi. Scadenze burocratiche italiane (pubblicazioni in comune, corso prematrimoniale, prove sartoriali, bomboniere, catering) con salvataggio nel browser.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come organizzare un matrimonio in 12 mesi senza stress",
      "description": "Guida alle scadenze burocratiche e logistiche del matrimonio in Italia.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "12+ Mesi: Location, Chiesa e Budget",
          "text": "Definisci il budget complessivo, stima gli invitati e prenota la chiesa/comune e la location per il ricevimento."
        },
        {
          "@type": "HowToStep",
          "name": "9–10 Mesi: Fornitori Chiave e Abito da Sposa",
          "text": "Ingaggia fotografo, videomaker, catering e band/DJ, e inizia le prove in atelier per l'abito da sposa."
        },
        {
          "@type": "HowToStep",
          "name": "4–6 Mesi: Corso Prematrimoniale e Pubblicazioni in Comune",
          "text": "Concludi il corso fidanzati, richiedi i certificati e fai la promessa di matrimonio per le pubblicazioni al Comune."
        },
        {
          "@type": "HowToStep",
          "name": "2–3 Mesi: Inviti, Fedi e Prove Menù",
          "text": "Consegna le partecipazioni, acquista le fedi nuziali e fai la degustazione del menù con il catering."
        },
        {
          "@type": "HowToStep",
          "name": "1 Mese: Tableau de Mariage e SIAE",
          "text": "Raccogli le conferme RSVP definitive, componi il tableau de mariage e paga i diritti SIAE per la musica."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quando fare le pubblicazioni di matrimonio in Comune?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le pubblicazioni vanno richieste all'Ufficio di Stato Civile del Comune di residenza circa 3-6 mesi prima delle nozze. Hanno una validità legale di 180 giorni (6 mesi) dalla data di affissione."
          }
        },
        {
          "@type": "Question",
          "name": "Questa checklist salva i miei progressi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sì! La checklist salva automaticamente le caselle selezionate nella memoria locale del tuo browser. Quando riaprirai la pagina, ritroverai la percentuale di completamento esatta."
          }
        }
      ]
    }
  ]
};

const tasks = [
  {
    month: "12+ Mesi Prima (Le Fondamenta)",
    items: [
      "Definire il budget massimo complessivo delle nozze",
      "Stilare una bozza iniziale della lista invitati",
      "Scegliere la data orientativa del matrimonio",
      "Prenotare la Chiesa o la Casa Comunale",
      "Scegliere e bloccare la Location del ricevimento (Villa, Castello, Agriturismo)",
      "Contratto con Catering o Banqueting (se non interno alla struttura)"
    ]
  },
  {
    month: "10–11 Mesi Prima (Fornitori Chiave & Abito)",
    items: [
      "Scegliere e comunicare la data ai Testimoni di Nozze",
      "Ingaggiare il Fotografo e il Videomaker",
      "Iniziare la ricerca dell'Abito da Sposa e prove in Atelier",
      "Ingaggiare la Musica e l'Animazione (Band dal vivo / DJ set)"
    ]
  },
  {
    month: "8–9 Mesi Prima (Burocrazia & Allestimenti)",
    items: [
      "Iscriversi al Corso Prematrimoniale (per rito religioso concordatario)",
      "Scegliere il Flower Designer / Fiorista per allestimento cerimonia e tavoli",
      "Creare il sito web delle nozze con IBAN / lista nozze online",
      "Prenotare il Viaggio di Nozze (Luna di Miele)"
    ]
  },
  {
    month: "6–7 Mesi Prima (Save-the-Date & Abito Sposo)",
    items: [
      "Inviare i Save-the-Date agli ospiti lontani",
      "Scegliere l'Abito dello Sposo e relativi accessori",
      "Scegliere gli abiti per damigelle, paggetti e testimoni",
      "Bloccare camere d'albergo per gli ospiti fuori sede"
    ]
  },
  {
    month: "4–5 Mesi Prima (Pubblicazioni & Fedi)",
    items: [
      "Avviare le pratiche burocratiche per le Pubblicazioni di Matrimonio in Comune",
      "Scegliere e acquistare le Fedi Nuziali (misura italiana e incisione)",
      "Prenotare Hair Stylist e Make-up Artist (HMUA) per la sposa",
      "Scegliere Bomboniere, Sacchetti e Confetti artigianali",
      "Ordinare le Partecipazioni di nozze e la carta coordinata"
    ]
  },
  {
    month: "3 Mesi Prima (Inviti & Degustazione Menù)",
    items: [
      "Spedire o consegnare a mano le Partecipazioni di Nozze agli invitati",
      "Prova menù con il Catering e scelta della Torta Nuziale",
      "Prima prova sartoriale dell'abito da sposa con scarpe e intimo",
      "Prenotare il noleggio dell'Auto degli Sposi"
    ]
  },
  {
    month: "2 Mesi Prima (RSVP & Prove)",
    items: [
      "Sollecitare le conferme di presenza (RSVP)",
      "Definire e stampare i Libretti Messa o la scaletta per il rito civile",
      "Prova definitiva di trucco e acconciatura",
      "Acquistare i regali per i Testimoni di nozze"
    ]
  },
  {
    month: "1 Mese Prima (Tableau & SIAE)",
    items: [
      "Chiudere il numero definitivo degli ospiti e comunicarlo al catering",
      "Comporre il Tableau de Mariage, Segnaposto e Menù stampati",
      "Ultima prova sartoriale dell'abito con velo e gioielli",
      "Definire la scaletta musicale e pagare il permesso SIAE online"
    ]
  },
  {
    month: "2 Settimane Prima (Ritiro Abiti)",
    items: [
      "Ritirare gli abiti da sposa e da sposo in atelier",
      "Confermare la shot-list e i momenti chiave con il fotografo",
      "Taglio e cura dei capelli per sposo e sposa"
    ]
  },
  {
    month: "1 Settimana Prima (Ultime Cure)",
    items: [
      "Preparare le valigie per il viaggio di nozze",
      "Preparare le buste per il saldo finale dei fornitori e le mance",
      "Trattamenti benessere, manicure e pedicure per la sposa"
    ]
  },
  {
    month: "Il Giorno Prima (Consegne)",
    items: [
      "Consegnare in location bomboniere, tableau, coni riso e dettagli",
      "Prova generale del corteo d'ingresso (se prevista)",
      "Cena rilassante e buon riposo!"
    ]
  },
  {
    month: "Il Giorno del Matrimonio (Il Grande Giorno!)",
    items: [
      "Colazione sana e idratazione",
      "Affidare le fedi nuziali al testimone dello sposo",
      "Sorridere e godersi ogni singolo attimo del vostro matrimonio!"
    ]
  }
];
---

<Layout 
	title="Checklist Matrimonio 12 Mesi Interattiva: Cosa Fare e Quando | Manage.Wedding"
	description="Checklist completa e interattiva per organizzare il matrimonio in 12 mesi. Scadenze burocratiche italiane (pubblicazioni in comune, corso prematrimoniale, prove sartoriali, bomboniere, catering) con salvataggio nel browser."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Checklist Matrimonio 12 Mesi" category="logistics" />

		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Organizzazione Passo dopo Passo</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Checklist Matrimonio <span class="accent-italic">12 Mesi</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 680px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Tutte le scadenze e i compiti da completare, mese per mese: burocrazia in comune, abiti, catering, bomboniere e tableau. Salva i progressi nel browser!
			</p>
		</header>

		<div class="home-grid fade-in" style="animation-delay: 0.2s; max-width: 900px; margin: 0 auto;">
            
			<!-- Progress Bar Card -->
			<div class="hand-card result-box" style="margin-bottom: 2rem;">
				<h2 class="font-heading" style="margin-bottom: 1rem; text-align: center; font-size: 1.5rem;">
					Avanzamento Organizzazione Nozze
				</h2>
				
                <div style="width: 100%; border: 2px solid var(--fg-pencil); height: 32px; position: relative; overflow: hidden; background: var(--bg-paper); border-radius: 4px;">
                    <div id="progress-bar-fill" style="width: 0%; height: 100%; background-color: var(--accent-red); transition: width 0.3s ease;"></div>
                    <div id="progress-text" class="font-heading" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1rem; color: #111;">0%</div>
                </div>
			</div>

			<!-- Interactive Checklist Form -->
			<div class="hand-card">
				<form id="checklist-form">
                    {tasks.map((category, catIndex) => (
                        <div class="checklist-category" style="margin-bottom: 2rem;">
                            <h3 class="font-heading" style="margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; color: var(--accent-blue); font-size: 1.35rem;">
								{category.month}
							</h3>
                            {category.items.map((item, itemIndex) => (
                                <label style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.65rem; cursor: pointer; font-family: var(--font-body); font-size: 1rem;">
                                    <input 
                                        type="checkbox" 
                                        class="task-checkbox" 
                                        data-id={`task-${catIndex}-${itemIndex}`}
                                        style="width: 1.25rem; height: 1.25rem; accent-color: var(--accent-red); cursor: pointer;"
                                    />
                                    <span>{item}</span>
                                </label>
                            ))}
                        </div>
                    ))}
				</form>
			</div>

		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="max-width: 900px; margin: 3rem auto; padding: clamp(1.5rem, 4vw, 3.5rem);">
            <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.6rem); margin-bottom: 1.5rem; text-align: center;">
				Come Pianificare il Matrimonio in 12 Mesi in Italia
			</h2>
            
            <p class="font-body" style="margin-bottom: 1.5rem; line-height: 1.7; font-size: 1.05rem;">
				Organizzare un matrimonio richiede metodo e coordinamento. Suddividere il percorso in tappe mensili permette di gestire con serenità la burocrazia comunale, la scelta dei fornitori e le prove sartoriali.
			</p>
        </article>

		<RelatedTools currentPath="/it/wedding-checklist" category="logistics" />
	</main>
</Layout>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const checkboxes = document.querySelectorAll('.task-checkbox');
		const progressBarFill = document.getElementById('progress-bar-fill');
        const progressText = document.getElementById('progress-text');
        
        const STORAGE_KEY = 'manage_wedding_checklist_tasks_it';

        const loadState = () => {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    checkboxes.forEach((cb) => {
                        if (parsed.includes(cb.dataset.id)) {
                            cb.checked = true;
                        }
                    });
                } catch(e) {
                    console.error("Error parsing saved checklist tasks", e);
                }
            }
            updateProgress();
        };

        const saveState = () => {
            const checkedIds = Array.from(checkboxes)
                .filter(cb => cb.checked)
                .map(cb => cb.dataset.id);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(checkedIds));
        };

        const updateProgress = () => {
            const total = checkboxes.length;
            const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
            
            if (total === 0) return;

            const percentage = Math.round((checkedCount / total) * 100);
            
            if(progressBarFill) {
                progressBarFill.style.width = `${percentage}%`;
            }
            if(progressText) {
                progressText.textContent = `${percentage}% Completato (${checkedCount}/${total})`;
            }
        };

        checkboxes.forEach(cb => {
            cb.addEventListener('change', () => {
                saveState();
                updateProgress();
            });
        });

        loadState();
	});
</script>
