---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = "Creatore Menù di Nozze da Stampare & Ricevimento | Manage.Wedding";
const description = "Crea e stampa gratis i menù per il ricevimento di nozze. Personalizza portate (antipasti, primi, secondi, torta), intolleranze alimentari, font calligrafici, formati DL e A5 e scarica il PDF.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/reception-menu-maker/#webapp",
      "name": "Creatore Menù di Nozze da Stampare & Ricevimento",
      "url": "https://manage.wedding/it/reception-menu-maker",
      "inLanguage": "it",
      "description": "Disegna e stampa eleganti menù per il banchetto nuziale. Personalizza portate, caratteri tipografici, formati DL 10x21 cm e A5 e scarica il PDF vettoriale pronto per la stampa.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come creare e stampare il menù per il matrimonio",
      "description": "Guida per impostare la sequenza delle portate, le intolleranze alimentari e la grafica del menù nuziale.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Inserire nomi degli sposi e data",
          "text": "Intesta il menù con i nomi degli sposi e la data delle nozze."
        },
        {
          "@type": "HowToStep",
          "name": "2. Configurare le portate del banchetto",
          "text": "Aggiungi le sezioni (Aperitivo, Primi Piatti, Secondo, Torta Nuziale e Vini)."
        },
        {
          "@type": "HowToStep",
          "name": "3. Aggiungere i tag per intolleranze alimentari",
          "text": "Indica i piatti vegetariani (V), vegani (VG), senza glutine (GF) o senza lattosio (DF)."
        },
        {
          "@type": "HowToStep",
          "name": "4. Scegliere il formato e stampare su carta pregiata",
          "text": "Seleziona il formato DL (10x21 cm da inserire nel tovagliolo) o A5 da cavalletto e scarica il PDF vettoriale."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual è il formato standard per i menù del matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il formato più diffuso è il DL (circa 10 × 21 cm), ideale da infilare nel tovagliolo piegato o appoggiare sul sottopiatto. In alternativa, per i tavoli rotondi si usa spesso il formato A5 (15 × 21 cm) inserito in piccoli cavalletti o cornici al centro tavola (1 o 2 per tavolo)."
          }
        },
        {
          "@type": "Question",
          "name": "Che grammatura di carta è consigliata per stampare i menù di nozze?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "È consigliabile utilizzare cartoncino con grammatura compresa tra 250 g/m² e 350 g/m², preferibilmente con texture vergata, martellata, millerighe o carta cotone di Amalfi per una sensazione tattile di pregio."
          }
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} schema={schema}>
  <!-- Import Elegant Wedding Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

  <main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
    <Breadcrumb title="Creatore Menù di Nozze" category="food-dining" />
    
    <!-- Header -->
    <header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
      <div class="tape" style="margin: 0 auto 1rem;"></div>
      <span class="badge-postit">PDF Vettoriale & Tipografia Personalizzata</span>
      <h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
        Creatore Menù <span class="accent-italic">di Nozze & Ricevimento</span>
      </h1>
      <p class="font-body" style="color: var(--text-secondary); max-width: 760px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
        Componi e stampa il menù per il banchetto del tuo matrimonio in pochi secondi. Scegli font calligrafici, cornici botaniche, formati DL e scarica il file pronto per la tipografia.
      </p>
    </header>

    <!-- Main Studio Grid -->
    <div id="app-area" class="fade-in" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2.5rem; align-items: start; margin-bottom: 3.5rem;">

      <!-- ===== LEFT COLUMN: DESIGN CONTROLS & EDITOR ===== -->
      <div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
          <h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
            1. Grafica & Tipografia
          </h2>
          <span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
            Anteprima Live
          </span>
        </div>

        <!-- Design Theme Selector -->
        <div class="form-group">
          <label class="form-label" for="themePicker">Tema Grafico & Cornice</label>
          <select id="themePicker" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc;">
            <option value="botanical" selected>🌿 Giardino Botanico (Avorio & Bordi Classici)</option>
            <option value="black-tie">👑 Black-Tie Elegante (Bianco Puro & Doppio Filetto)</option>
            <option value="romantic">🌸 Romantico Calligrafico (Accenti Rosa Cipria)</option>
            <option value="rustic">📜 Rustico Country Chic (Effetto Carta Kraft)</option>
            <option value="minimalist">✨ Moderno Minimalista (Senza Bordi)</option>
          </select>
        </div>

        <!-- Typography / Font Pairings -->
        <div class="form-group">
          <label class="form-label" for="fontPicker">Stile Carattere (Font)</label>
          <select id="fontPicker" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc;">
            <option value="playfair" selected>🏛️ Playfair Display (Serif Elegante & Editoriale)</option>
            <option value="cinzel">👑 Cinzel / Lapidario Romano (Formale e Regale)</option>
            <option value="cormorant">📜 Cormorant Garamond (Corsivo d'Epoca)</option>
            <option value="script">✍️ Alex Brush Calligrafico (Corsivo a Mano Fluido)</option>
            <option value="modern">📐 Montserrat (Lineare & Contemporaneo)</option>
          </select>
        </div>

        <!-- Card Dimensions / Format -->
        <div class="form-group">
          <label class="form-label" for="sizePicker">Formato Cartoncino</label>
          <select id="sizePicker" class="form-input" style="cursor: pointer; font-weight: 600;">
            <option value="dl" selected>📇 Formato DL 10×21 cm (Per Tovagliolo o Sottopiatto)</option>
            <option value="a5">📜 Formato A5 15×21 cm (Segnatavolo da Cavalletto)</option>
            <option value="a4">📄 Formato A4 (Da Cornice per Buffet & Open Bar)</option>
          </select>
        </div>

        <!-- Header Names & Date -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
          <div>
            <label class="form-label" for="coupleNames">Nomi degli Sposi</label>
            <input id="coupleNames" class="form-input" type="text" value="Giulia & Matteo" style="font-weight: 600;" />
          </div>
          <div>
            <label class="form-label" for="weddingDate">Data delle Nozze</label>
            <input id="weddingDate" class="form-input" type="text" value="18 Settembre 2026" style="font-weight: 600;" />
          </div>
        </div>

        <!-- Header Title Text -->
        <div class="form-group" style="margin-top: 0.75rem;">
          <label class="form-label" for="menuTitle">Intestazione Menù</label>
          <input id="menuTitle" class="form-input" type="text" value="MENÙ DI NOZZE" style="font-weight: 700; letter-spacing: 2px;" />
        </div>

        <!-- Courses Section Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin: 1.5rem 0 0.75rem 0; border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
          <h3 class="font-heading" style="font-size: 1.25rem; margin: 0; color: var(--fg-pencil);">
            2. Portate del Banchetto
          </h3>
          <span style="font-size: 0.8rem; color: var(--text-secondary);">Un piatto per riga</span>
        </div>

        <!-- Dynamic courses list -->
        <div id="course-list"></div>

        <!-- Add Course Button -->
        <button id="addCourseBtn" type="button" class="menu-add-btn" style="margin-bottom: 1.5rem;">
          + Aggiungi un'Altra Portata
        </button>

        <!-- Dietary Key Toggle -->
        <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1.5rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.92rem; font-weight: 600;">
            <input type="checkbox" id="check-dietary-key" checked style="width: 18px; height: 18px;" />
            <span>Mostra Legenda Intolleranze in Calce (V, VG, GF, DF)</span>
          </label>
        </div>

        <!-- Download & Export Actions -->
        <div style="border-top: 2px dashed var(--fg-pencil); padding-top: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
          <button id="printMenuBtn" class="hand-btn" style="width: 100%; padding: 12px; font-size: 1.05rem; gap: 0.5rem;">
            <span>🖨️</span> Stampa Menù in Alta Risoluzione (PDF)
          </button>
          
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
            <button id="downloadVectorPdfBtn" class="hand-btn secondary" style="padding: 10px; font-size: 0.92rem; gap: 0.35rem;">
              <span>📥</span> Scarica PDF Vettoriale
            </button>
            <button id="exportDocBtn" class="hand-btn secondary" style="padding: 10px; font-size: 0.92rem; gap: 0.35rem;">
              <span>📄</span> Esporta Documento Word
            </button>
          </div>
          
          <p class="font-body" style="font-size: 0.82rem; color: var(--text-secondary); text-align: center; margin: 0;">
            Formattato per cartoncino vergato o carta cotone da 280–350 g/m²
          </p>
        </div>

      </div>

      <!-- ===== RIGHT COLUMN: STICKY LIVE PREVIEW ===== -->
      <div style="position: sticky; top: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <span style="font-family: var(--font-heading); font-size: 1.1rem; color: var(--fg-pencil); font-weight: 700;">
            Anteprima Visiva in Scala
          </span>
          <span id="preview-size-tag" style="font-size: 0.82rem; font-weight: 700; background: #e2e8f0; padding: 2px 8px; border-radius: 4px;">
            Formato DL (10×21 cm)
          </span>
        </div>

        <div style="display: flex; justify-content: center;">
          
          <!-- Outer Card Container -->
          <div id="menuPreview" class="menu-preview-box" style="
            width: 100%;
            max-width: 400px;
            background: #fdfbf7;
            border: 2px solid #2d2d2d;
            box-shadow: 6px 6px 0px rgba(0,0,0,0.15);
            padding: 40px 32px;
            position: relative;
            min-height: 600px;
            box-sizing: border-box;
            transition: all 0.25s ease;
          ">
            
            <!-- Outer Frame Border -->
            <div id="frame-outer" style="position: absolute; top: 10px; bottom: 10px; left: 10px; right: 10px; border: 1.5px solid #2d2d2d; pointer-events: none; z-index: 1;"></div>
            
            <!-- Inner Frame Border -->
            <div id="frame-inner" style="position: absolute; top: 14px; bottom: 14px; left: 14px; right: 14px; border: 0.75px solid #94a3b8; pointer-events: none; z-index: 1;"></div>

            <!-- Live Menu Typography Content -->
            <div id="menuContent" style="position: relative; z-index: 3; text-align: center;"></div>

          </div>

        </div>
      </div>

    </div>

    <!-- SEO Article -->
    <article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
        <h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
          Galateo e Guida alla Scrittura del Menù di Nozze
        </h2>
        <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
          Come descrivere le portate, gestire le intolleranze e abbinare i menù alla mise en place.
        </p>
      </div>

      <section style="margin-bottom: 3rem;">
        <h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
          1. La Struttura Tradizionale del Banchetto Italiano
        </h3>
        <p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
          Nel classico menù di nozze italiano le portate vengono elencate in ordine cronologico: Gran Buffet di Antipasti, Due Primi Piatti (di cui uno preferibilmente a base di risotto e uno di pasta fresca/ripiena), Secondo Piatto con contorni di stagione, Torta Nuziale e Brindisi di Spumante.
        </p>
      </section>
    </article>

    <RelatedTools currentPath="/it/reception-menu-maker" category="stationery" />
  </main>
</Layout>

<style>
  .menu-add-btn {
    width: 100%;
    padding: 0.75rem;
    border: 2px dashed var(--fg-pencil);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--fg-pencil);
    border-radius: 4px;
    transition: background 0.15s;
  }
  .menu-add-btn:hover { background: #f5f1e8; }

  .course-block {
    border: 1.5px solid var(--fg-pencil);
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1rem;
    background: #fdfbf7;
  }
  .course-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .course-block-label {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
    color: var(--fg-pencil);
  }
  .course-rm-btn {
    background: #fee2e2;
    border: 1px solid #ef4444;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.85rem;
    color: #b91c1c;
    font-weight: bold;
    padding: 2px 6px;
  }
  .course-rm-btn:hover { background: #fecaca; }

  .dietary-tag-pill {
    display: inline-block;
    font-size: 0.70rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 4px;
    vertical-align: middle;
  }
</style>

<script is:inline>
  let courses = [
    { 
      title: 'APERITIVO DI BENVENUTO', 
      items: 'Burrata pugliese con pomodorini confit e gocce di pesto [V, GF]\nFlan di zucca con fonduta di Parmigiano Reggiano 24 mesi [V]' 
    },
    { 
      title: 'I PRIMI PIATTI', 
      items: 'Risotto Carnaroli ai finferli di bosco mantecato al timo [V, GF]\nPaccheri di Gragnano con ragù bianco di cinta senese e scaglie di pecorino' 
    },
    { 
      title: 'IL SECONDO PIATTO', 
      items: 'Filetto di manzo al Chianti con patate novelle al rosmarino [GF]\nTurbante di branzino in crosta di mandorle e caponatina [GF]' 
    },
    { 
      title: 'DESSERT & BRINDISI', 
      items: 'Millefoglie con crema chantilly e frutti di bosco freschi\nSpumante Metodo Classico e Caffè' 
    },
  ];

  function renderEditor() {
    const list = document.getElementById('course-list');
    if (!list) return;
    list.innerHTML = '';

    courses.forEach((c, i) => {
      const div = document.createElement('div');
      div.className = 'course-block';
      div.innerHTML = `
        <div class="course-block-header">
          <p class="course-block-label">Portata ${i + 1}</p>
          ${courses.length > 1 ? `<button class="course-rm-btn" data-rm="${i}" title="Rimuovi Portata">✕ Elimina</button>` : ''}
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <div>
            <label class="form-label" style="font-size: 0.85rem;">Titolo Portata (es. Antipasti, Primi Piatti, Secondo, Dessert)</label>
            <input class="form-input ci-t" data-i="${i}" type="text" value="${c.title}" style="font-weight: 700;" />
          </div>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
              <label class="form-label" style="font-size: 0.85rem; margin: 0;">Piatti (Uno per riga • usa [V], [GF], [VG], [DF])</label>
              <div style="display: flex; gap: 3px;">
                <button type="button" class="btn-tag" data-tag="[GF]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+GF</button>
                <button type="button" class="btn-tag" data-tag="[V]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+V</button>
                <button type="button" class="btn-tag" data-tag="[VG]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+VG</button>
                <button type="button" class="btn-tag" data-tag="[DF]" data-i="${i}" style="font-size: 0.7rem; padding: 1px 4px; border: 1px solid #94a3b8; background: #fff; cursor: pointer; border-radius: 2px;">+DF</button>
              </div>
            </div>
            <textarea class="form-input ci-v" data-i="${i}" style="min-height: 75px; resize: vertical; font-size: 0.92rem;">${c.items}</textarea>
          </div>
        </div>
      `;
      list.appendChild(div);
    });

    list.querySelectorAll('[data-rm]').forEach(b =>
      b.addEventListener('click', e => {
        courses.splice(+e.currentTarget.getAttribute('data-rm'), 1);
        renderEditor();
        renderPreview();
      })
    );
    list.querySelectorAll('.ci-t').forEach(el =>
      el.addEventListener('input', e => {
        courses[+e.currentTarget.getAttribute('data-i')].title = e.currentTarget.value;
        renderPreview();
      })
    );
    list.querySelectorAll('.ci-v').forEach(el =>
      el.addEventListener('input', e => {
        courses[+e.currentTarget.getAttribute('data-i')].items = e.currentTarget.value;
        renderPreview();
      })
    );
    list.querySelectorAll('.btn-tag').forEach(b =>
      b.addEventListener('click', e => {
        const tag = e.currentTarget.getAttribute('data-tag');
        const idx = +e.currentTarget.getAttribute('data-i');
        const textarea = list.querySelector(`.ci-v[data-i="${idx}"]`);
        if (textarea && tag) {
          textarea.value += ` ${tag}`;
          courses[idx].items = textarea.value;
          renderPreview();
        }
      })
    );
  }

  function formatDishWithBadges(text) {
    let formatted = text.trim();
    formatted = formatted.replace(/\[GF\]/gi, '<span class="dietary-tag-pill" style="background:#e0f2fe; color:#0369a1; border:1px solid #7dd3fc;">GF</span>');
    formatted = formatted.replace(/\[V\]/gi, '<span class="dietary-tag-pill" style="background:#f0fdf4; color:#15803d; border:1px solid #86efac;">V</span>');
    formatted = formatted.replace(/\[VG\]/gi, '<span class="dietary-tag-pill" style="background:#fefce8; color:#a16207; border:1px solid #fef08a;">VG</span>');
    formatted = formatted.replace(/\[DF\]/gi, '<span class="dietary-tag-pill" style="background:#fdf2f8; color:#be185d; border:1px solid #fbcfe8;">DF</span>');
    return formatted;
  }

  function renderPreview() {
    const el = document.getElementById('menuContent');
    const previewBox = document.getElementById('menuPreview');
    const frameOuter = document.getElementById('frame-outer');
    const frameInner = document.getElementById('frame-inner');

    if (!el || !previewBox || !frameOuter || !frameInner) return;

    const theme = document.getElementById('themePicker').value || 'botanical';
    const font = document.getElementById('fontPicker').value || 'playfair';
    const size = document.getElementById('sizePicker').value || 'dl';
    const names = document.getElementById('coupleNames').value || 'Giulia & Matteo';
    const date = document.getElementById('weddingDate').value || '18 Settembre 2026';
    const menuTitle = document.getElementById('menuTitle').value || 'MENÙ DI NOZZE';
    const showDietary = document.getElementById('check-dietary-key').checked;

    const sizeTag = document.getElementById('preview-size-tag');
    if (sizeTag) {
      if (size === 'dl') sizeTag.textContent = 'Formato DL (10×21 cm)';
      else if (size === 'a5') sizeTag.textContent = 'Formato A5 (15×21 cm)';
      else sizeTag.textContent = 'Formato A4';
    }

    if (size === 'dl') {
      previewBox.style.maxWidth = '360px';
      previewBox.style.minHeight = '640px';
    } else if (size === 'a5') {
      previewBox.style.maxWidth = '420px';
      previewBox.style.minHeight = '560px';
    } else {
      previewBox.style.maxWidth = '460px';
      previewBox.style.minHeight = '620px';
    }

    if (theme === 'botanical') {
      previewBox.style.background = '#fdfbf7';
      previewBox.style.color = '#1e293b';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '1.5px solid #2d2d2d';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.75px solid #94a3b8';
    } else if (theme === 'black-tie') {
      previewBox.style.background = '#ffffff';
      previewBox.style.color = '#0f172a';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '2px solid #0f172a';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.5px solid #0f172a';
    } else if (theme === 'romantic') {
      previewBox.style.background = '#fff9f8';
      previewBox.style.color = '#3b1c1c';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '1.5px solid #c48b71';
      frameInner.style.display = 'block';
      frameInner.style.border = '0.75px dashed #c48b71';
    } else if (theme === 'rustic') {
      previewBox.style.background = '#f5ecd7';
      previewBox.style.color = '#2c1810';
      frameOuter.style.display = 'block';
      frameOuter.style.border = '2px solid #5c3a21';
      frameInner.style.display = 'block';
      frameInner.style.border = '1px dashed #8c5a31';
    } else if (theme === 'minimalist') {
      previewBox.style.background = '#ffffff';
      previewBox.style.color = '#1e293b';
      frameOuter.style.display = 'none';
      frameInner.style.display = 'none';
    }

    let headerFontFamily = "'Playfair Display', serif";
    let bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
    let titleLetterSpacing = "3px";
    let namesStyle = "font-style: italic;";

    if (font === 'cinzel') {
      headerFontFamily = "'Cinzel', serif";
      bodyFontFamily = "'Cormorant Garamond', serif";
      titleLetterSpacing = "4px";
      namesStyle = "font-weight: 600; letter-spacing: 2px;";
    } else if (font === 'cormorant') {
      headerFontFamily = "'Cormorant Garamond', serif";
      bodyFontFamily = "'Cormorant Garamond', serif";
      titleLetterSpacing = "3px";
      namesStyle = "font-style: italic; font-size: 1.25rem;";
    } else if (font === 'script') {
      headerFontFamily = "'Alex Brush', cursive";
      bodyFontFamily = "'Playfair Display', serif";
      titleLetterSpacing = "1px";
      namesStyle = "font-family: 'Alex Brush', cursive; font-size: 1.85rem; line-height: 1.1;";
    } else if (font === 'modern') {
      headerFontFamily = "'Montserrat', sans-serif";
      bodyFontFamily = "'Plus Jakarta Sans', sans-serif";
      titleLetterSpacing = "5px";
      namesStyle = "font-family: 'Montserrat', sans-serif; font-size: 0.95rem; letter-spacing: 2px; text-transform: uppercase;";
    }

    let html = `
      <div style="margin-bottom: 12px;">
        <h3 style="font-family: ${headerFontFamily}; font-size: ${font === 'script' ? '2.4rem' : '1.7rem'}; letter-spacing: ${titleLetterSpacing}; text-transform: ${font === 'script' ? 'none' : 'uppercase'}; margin: 0 0 4px 0; font-weight: 700;">
          ${menuTitle}
        </h3>
        <p style="${namesStyle} margin: 0 0 2px 0;">
          ${names}
        </p>
        <p style="font-size: 0.80rem; letter-spacing: 1.5px; opacity: 0.7; margin: 0; font-family: 'Montserrat', sans-serif;">
          ${date}
        </p>
        <div style="width: 40px; border-top: 1.5px solid currentColor; margin: 12px auto; opacity: 0.6;"></div>
      </div>
    `;

    courses.forEach((c, i) => {
      if (i > 0) {
        html += `<div style="width: 24px; border-top: 1px dashed currentColor; margin: 12px auto; opacity: 0.4;"></div>`;
      }
      
      const rawDishes = c.items.split('\n').filter(l => l.trim());
      const formattedDishes = rawDishes.map(d => `<div style="margin-bottom: 4px; line-height: 1.45;">${formatDishWithBadges(d)}</div>`).join('');

      html += `
        <div style="margin-bottom: 8px;">
          <h4 style="font-family: ${headerFontFamily}; font-size: 1.05rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin: 0 0 4px 0; color: var(--accent-red);">
            ${c.title}
          </h4>
          <div style="font-family: ${bodyFontFamily}; font-size: 0.88rem; opacity: 0.9;">
            ${formattedDishes || '<span style="opacity: 0.4; font-style: italic;">Inserisci i piatti...</span>'}
          </div>
        </div>
      `;
    });

    if (showDietary) {
      html += `
        <div style="margin-top: 18px; padding-top: 8px; border-top: 0.5px solid currentColor; opacity: 0.65; font-size: 0.72rem; font-family: 'Montserrat', sans-serif; letter-spacing: 0.5px;">
          (V) Vegetariano • (VG) Vegano • (GF) Senza Glutine • (DF) Senza Lattosio
        </div>
      `;
    }

    el.innerHTML = html;
  }

  function printHighResMenu() {
    window.print();
  }

  function exportWordDoc() {
    const names = document.getElementById('coupleNames').value || 'Giulia & Matteo';
    const date = document.getElementById('weddingDate').value || '18 Settembre 2026';
    const menuTitle = document.getElementById('menuTitle').value || 'MENÙ DI NOZZE';

    let coursesContent = '';
    courses.forEach(c => {
      coursesContent += `<h3 style="color:#b91c1c; margin-top:15px; text-transform:uppercase;">${c.title}</h3><ul>`;
      c.items.split('\n').filter(l => l.trim()).forEach(item => {
        coursesContent += `<li style="margin-bottom:4px;">${item}</li>`;
      });
      coursesContent += `</ul>`;
    });

    const content = `
      <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
      <head><meta charset="utf-8"><title>${menuTitle}</title>
      <style>body { font-family: 'Georgia', serif; font-size: 11pt; } h1, h2 { text-align: center; } ul { list-style-type: square; }</style>
      </head>
      <body>
        <h1 style="letter-spacing: 2px;">${menuTitle}</h1>
        <h2 style="font-weight:normal; font-style:italic;">${names}</h2>
        <p style="text-align:center; color:#666;">${date}</p>
        <hr/>
        ${coursesContent}
      </body></html>
    `;

    const blob = new Blob(['\ufeff', content], { type: 'application/msword' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `Menu_Nozze_${new Date().toISOString().slice(0, 10)}.doc`;
    link.click();
  }

  function downloadVectorPdf() {
    window.print();
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderEditor();
    renderPreview();

    ['themePicker', 'fontPicker', 'sizePicker', 'coupleNames', 'weddingDate', 'menuTitle', 'check-dietary-key'].forEach(id => {
      const el = document.getElementById(id);
      el?.addEventListener('input', renderPreview);
      el?.addEventListener('change', renderPreview);
    });

    document.getElementById('addCourseBtn')?.addEventListener('click', () => {
      courses.push({ title: 'NUOVA PORTATA', items: 'Descrizione Piatto Gourmet [GF]' });
      renderEditor();
      renderPreview();
    });

    document.getElementById('printMenuBtn')?.addEventListener('click', printHighResMenu);
    document.getElementById('downloadVectorPdfBtn')?.addEventListener('click', downloadVectorPdf);
    document.getElementById('exportDocBtn')?.addEventListener('click', exportWordDoc);
  });
</script>
