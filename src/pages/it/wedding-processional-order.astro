---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/wedding-processional-order/#webapp",
      "name": "Corteo Nuziale & Ordine di Ingresso Cerimonia Matrimonio",
      "url": "https://manage.wedding/it/wedding-processional-order",
      "inLanguage": "it",
      "description": "Strumento per organizzare l'ordine di ingresso del corteo nuziale secondo il galateo italiano (sposo con madre, paggetti con fedi, sposa con padre). Stampa la guida per i testimoni.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come organizzare il corteo nuziale secondo il galateo italiano",
      "description": "L'ordine corretto di entrata in chiesa o nella sala comunale.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Ingresso dello sposo con la madre",
          "text": "Lo sposo entra per primo offrendo il braccio sinistro alla madre e si posiziona a destra dell'altare."
        },
        {
          "@type": "HowToStep",
          "name": "2. Ingresso di genitori e testimoni",
          "text": "Entrano il padre dello sposo con la madre della sposa e i testimoni di nozze."
        },
        {
          "@type": "HowToStep",
          "name": "3. Paggetti e damigelline con le fedi",
          "text": "I paggetti precedono la sposa portando il cuscino portafedi o petali di fiori."
        },
        {
          "@type": "HowToStep",
          "name": "4. Ingresso solenne della sposa con il padre",
          "text": "La sposa entra al braccio sinistro del padre (o di entrambi i genitori) con la marcia nuziale."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Da che lato entra la sposa rispetto al padre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Secondo il galateo italiano, la sposa si posiziona sempre alla sinistra del padre (o di chi la accompagna), tenendogli il braccio sinistro. All'altare, la sposa siede a sinistra e lo sposo a destra."
          }
        },
        {
          "@type": "Question",
          "name": "I testimoni dove si posizionano durante la cerimonia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "I testimoni prendono posto ai lati degli sposi: i testimoni della sposa alla sua sinistra e i testimoni dello sposo alla sua destra."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Corteo Nuziale & Ingresso Sposi: Ordine di Entrata Cerimonia | Manage.Wedding"
	description="Crea e personalizza l'ordine di ingresso e uscita del corteo nuziale (religioso, civile, paggetti e damigelle). Genera la scaletta per il libretto di nozze o per i testimoni."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Corteo Nuziale & Ordine Ingresso" category="logistics" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Galateo Cerimonia & Corteo d'Onore</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Corteo Nuziale <span class="accent-italic">& Ordine di Ingresso</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Organizza la sequenza di entrata e uscita per chiesa, rito civile o simbolico: sposo con la mamma, testimoni, paggetti con cuscino portafedi e sposa con il papà.
			</p>
		</header>

		<!-- Main Interactive Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Configuration -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Configurazione Corteo
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Tradizione Italiana
					</span>
				</div>

				<!-- Tradition Selector -->
				<div class="form-group">
					<label class="form-label" for="ceremony-tradition">Tradizione / Tipo di Cerimonia</label>
					<select id="ceremony-tradition" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="italian-classic" selected>⛪ Corteo Classico Tradizionale Italiano (Galateo)</option>
						<option value="civil-modern">🏛️ Rito Civile / Moderno in Comune o Villa</option>
						<option value="together">❤️ Ingresso Insieme degli Sposi (Mano nella mano)</option>
						<option value="both-parents">👨‍👩‍👧 Accompagnamento con Entrambi i Genitori</option>
						<option value="minimalist">🌿 Cerimonia Intima & Minimale</option>
					</select>
				</div>

				<!-- Mode Selector -->
				<div class="form-group">
					<label class="form-label">Fase della Cerimonia</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="phase-btn hand-btn is-active" data-phase="processional" style="padding: 8px; font-size: 0.9rem;">
							🚶‍♂️ 1. Ingresso (Corteo)
						</button>
						<button type="button" class="phase-btn hand-btn" data-phase="recessional" style="padding: 8px; font-size: 0.9rem;">
							🎉 2. Uscita (Lancio Riso)
						</button>
					</div>
				</div>

				<!-- Couple Names -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="partner1-name">Nome Sposa</label>
						<input type="text" id="partner1-name" class="form-input" value="Chiara" placeholder="es. Chiara" />
					</div>
					<div>
						<label class="form-label" for="partner2-name">Nome Sposo</label>
						<input type="text" id="partner2-name" class="form-input" value="Alessandro" placeholder="es. Alessandro" />
					</div>
				</div>

				<!-- Escort Selection -->
				<div class="form-group">
					<label class="form-label" for="escort-style">Accompagnatore della Sposa</label>
					<select id="escort-style" class="form-input" style="cursor: pointer;">
						<option value="father" selected>Accompagnata dal Padre</option>
						<option value="both-parents">Accompagnata da Entrambi i Genitori</option>
						<option value="mother">Accompagnata dalla Madre</option>
						<option value="brother">Accompagnata dal Fratello / Parente</option>
						<option value="solo">Ingresso da Sola</option>
						<option value="together">Insieme allo Sposo</option>
					</select>
				</div>

			</div>

			<!-- Right Column: Interactive Lineup Cards -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 id="lineup-heading" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							1. Ordine di Ingresso del Corteo
						</h3>
						<span id="lineup-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							7 Passaggi
						</span>
					</div>

					<!-- Visual Lineup Cards List -->
					<div id="lineup-list-container" style="display: flex; flex-direction: column; gap: 0.6rem; max-height: 520px; overflow-y: auto; padding-right: 4px;">
						<!-- Dynamic Step Rows -->
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-pocket-sheet" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Stampa Guida per i Testimoni (PDF)
						</button>
						<button id="btn-export-text" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📲</span> Copia Scaletta WhatsApp
						</button>
					</div>

				</div>

				<!-- Music Cues Card -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						🎵 Spunti Musicali & Momenti Chiave:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Brano 1 (Ingresso Sposo):</strong> Melodia dolce per l'ingresso dello sposo con la madre.</li>
						<li><strong>Pausa & Silenzio (10s):</strong> Le porte si chiudono, gli invitati si alzano in piedi.</li>
						<li><strong>Brano 2 (Marcia Nuziale Sposa):</strong> Ingresso solenne della sposa con il papà.</li>
						<li><strong>Brano 3 (Uscita & Lancio Riso):</strong> Musica trionfale ed energica per gli sposi novelli!</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- SEO Article -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Il Galateo del Corteo Nuziale Italiano
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Come posizionarsi, il braccio corretto da offrire e l'ordine di entrata e uscita.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. La Regola del Lato Sinistro
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Nel matrimonio tradizionale italiano:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li>Lo sposo offre il braccio sinistro alla madre durante l'ingresso.</li>
					<li>La sposa cammina alla sinistra del padre, tenendo con la mano sinistra il suo braccio e con la destra il bouquet.</li>
					<li>Davanti all'altare la sposa siede a sinistra e lo sposo a destra (guardando il sacerdote o celebrante).</li>
				</ul>
			</section>
		</article>

		<RelatedTools currentPath="/it/wedding-processional-order" category="logistics" />
	</main>
</Layout>

<script is:inline>
	const traditionSelect = document.getElementById('ceremony-tradition');
	const phaseButtons = document.querySelectorAll('.phase-btn');
	const partner1Input = document.getElementById('partner1-name');
	const partner2Input = document.getElementById('partner2-name');
	const escortSelect = document.getElementById('escort-style');

	const lineupHeading = document.getElementById('lineup-heading');
	const lineupCountBadge = document.getElementById('lineup-count-badge');
	const lineupContainer = document.getElementById('lineup-list-container');
	const btnPrint = document.getElementById('btn-print-pocket-sheet');
	const btnCopyText = document.getElementById('btn-export-text');

	let currentPhase = 'processional';
	let lineupData = [];

	const presets = {
		'italian-classic': [
			{ role: "1. Ingresso dello Sposo", names: "Sposo (Alessandro) al braccio della Madre", cue: "Musica di benvenuto d'organo / archi" },
			{ role: "2. Ingresso Genitori", names: "Padre dello Sposo al braccio della Madre della Sposa", cue: "Prendono posto nelle prime file" },
			{ role: "3. Ingresso dei Testimoni", names: "Testimoni dello Sposo e della Sposa", cue: "Si posizionano ai lati dell'altare" },
			{ role: "4. Damigelle d'Onore", names: "Damigelle (Bridesmaids)", cue: "Ingresso a distanza di 4-5 passi" },
			{ role: "5. Paggetti & Damigelline", names: "Paggetto con cuscino portafedi e damigelline con petali", cue: "Precedono l'arrivo della sposa" },
			{ role: "6. Ingresso Solenne della Sposa", names: "Sposa (Chiara) al braccio del Padre", cue: "🎵 Marcia Nuziale (Tutti in piedi)" }
		],
		'civil-modern': [
			{ role: "1. Presa posto degli Ospiti", names: "Tutti gli invitati prendono posto nella sala", cue: "Musica di sottofondo" },
			{ role: "2. Ingresso Sposo & Testimoni", names: "Sposo (Alessandro) e Testimoni", cue: "Accoglienza al tavolo delle firme" },
			{ role: "3. Paggetto con le Fedi", names: "Paggetto / Bambini di famiglia", cue: "Portano le fedi nuziali" },
			{ role: "4. Ingresso della Sposa", names: "Sposa (Chiara) con accompagnatore", cue: "🎵 Brano scelto per l'ingresso" }
		],
		'together': [
			{ role: "1. Ingresso Famiglie e Testimoni", names: "Genitori e Testimoni prendono posto", cue: "Musica d'atmosfera" },
			{ role: "2. Paggetti con le Fedi", names: "Bambini con cuscino portafedi", cue: "Aprono il corteo" },
			{ role: "3. Ingresso Insieme degli Sposi", names: "Chiara & Alessandro mano nella mano", cue: "🎵 Marcia trionfale di coppia" }
		],
		'both-parents': [
			{ role: "1. Sposo con Entrambi i Genitori", names: "Alessandro accompagnato da Madre e Padre", cue: "Ingresso caloroso" },
			{ role: "2. Testimoni e Damigelle", names: "Testimoni di nozze", cue: "Presa posto ai lati" },
			{ role: "3. Paggetti", names: "Paggetti con le fedi", cue: "Precedono la sposa" },
			{ role: "4. Sposa con Entrambi i Genitori", names: "Chiara accompagnata da Mamma e Papà", cue: "🎵 Marcia Nuziale" }
		],
		'minimalist': [
			{ role: "1. Sposo e Testimoni", names: "Alessandro e i testimoni all'altare", cue: "Attesa della sposa" },
			{ role: "2. Ingresso della Sposa", names: "Chiara con il Padre", cue: "🎵 Ingresso nuziale" }
		]
	};

	function loadTradition() {
		const t = traditionSelect.value;
		const raw = presets[t] || presets['italian-classic'];
		lineupData = JSON.parse(JSON.stringify(raw));
		applyCustomNames();
	}

	function applyCustomNames() {
		const p1 = partner1Input.value.trim() || 'Chiara';
		const p2 = partner2Input.value.trim() || 'Alessandro';
		const escort = escortSelect.options[escortSelect.selectedIndex].text;

		lineupData.forEach(item => {
			item.names = item.names.replace(/Chiara/g, p1).replace(/Alessandro/g, p2);
			if (item.role.includes('Sposa') && !item.role.includes('Insieme')) {
				item.names = `${p1} (${escort})`;
			}
		});
		renderLineup();
	}

	function renderLineup() {
		lineupContainer.innerHTML = '';

		let displayList = [...lineupData];
		if (currentPhase === 'recessional') {
			lineupHeading.textContent = '2. Ordine di Uscita (Recessionale & Lancio Riso)';
			displayList = [
				{ role: "1. Gli Sposi Novelli (Primi)", names: `${partner1Input.value || 'Chiara'} & ${partner2Input.value || 'Alessandro'} (Marito & Moglie!)`, cue: "🎵 Marcia Nuziale d'Uscita & Lancio del Riso" },
				{ role: "2. Paggetti e Damigelline", names: "Bambini con cesti per petali o riso", cue: "Seguono subito gli sposi" },
				{ role: "3. Genitori degli Sposi", names: "Mamma sposa con papà sposo, mamma sposo con papà sposa", cue: "A braccetto" },
				{ role: "4. Testimoni di Nozze", names: "Testimoni a coppie", cue: "" },
				{ role: "5. Damigelle & Parenti Stretti", names: "Familiari e amici", cue: "Raggiungono il sagrato per gli auguri" },
				{ role: "6. Tutti gli Invitati", names: "Ospiti per il brindisi e le foto all'uscita", cue: "" }
			];
		} else {
			lineupHeading.textContent = '1. Ordine di Ingresso del Corteo';
		}

		lineupCountBadge.textContent = `${displayList.length} Passaggi`;

		displayList.forEach((item, idx) => {
			const row = document.createElement('div');
			row.style.cssText = "display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; gap: 0.75rem;";
			
			row.innerHTML = `
				<div style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">
					<span style="font-weight: 800; font-size: 1.1rem; color: var(--accent-red); width: 24px; text-align: center;">${idx + 1}</span>
					<div>
						<strong style="font-size: 0.98rem; color: var(--fg-pencil); display: block;">${item.role}</strong>
						<span style="font-size: 0.88rem; color: #475569;">${item.names}</span>
						${item.cue ? `<span style="display: block; font-size: 0.78rem; font-weight: 700; color: var(--accent-blue); margin-top: 2px;">⚡ Momento: ${item.cue}</span>` : ''}
					</div>
				</div>
			`;
			lineupContainer.appendChild(row);
		});
	}

	phaseButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			phaseButtons.forEach(b => b.classList.remove('is-active'));
			btn.classList.add('is-active');
			currentPhase = btn.getAttribute('data-phase');
			renderLineup();
		});
	});

	traditionSelect.addEventListener('change', loadTradition);
	[partner1Input, partner2Input, escortSelect].forEach(inp => {
		inp.addEventListener('input', applyCustomNames);
	});

	btnPrint.addEventListener('click', () => {
		const printWindow = window.open('', '_blank');
		let html = `
			<!DOCTYPE html>
			<html>
			<head>
				<meta charset="utf-8">
				<title>Guida Corteo Nuziale — Manage.Wedding</title>
				<style>
					@page { size: A4; margin: 1.5cm; }
					body { font-family: Arial, sans-serif; font-size: 11pt; color: #1e293b; }
					h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
					h2 { font-size: 14pt; margin-top: 18px; margin-bottom: 6px; border-bottom: 2px solid #0f172a; padding-bottom: 3px; }
					table { width: 100%; border-collapse: collapse; margin-top: 8px; }
					th, td { border: 1px solid #cbd5e1; padding: 6px 10px; text-align: left; }
					th { background-color: #f1f5f9; font-weight: bold; }
				</style>
			</head>
			<body>
				<h1>Corteo Nuziale: ${partner1Input.value || 'Chiara'} & ${partner2Input.value || 'Alessandro'}</h1>
				<p style="color: #64748b;">Tradizione: ${traditionSelect.options[traditionSelect.selectedIndex].text}</p>
				
				<h2>1. Ordine di Ingresso (Corteo)</h2>
				<table>
					<thead><tr><th>#</th><th>Gruppo / Ruolo</th><th>Partecipanti</th><th>Musica / Indicazioni</th></tr></thead>
					<tbody>
		`;

		lineupData.forEach((item, idx) => {
			html += `<tr><td><strong>${idx + 1}</strong></td><td><strong>${item.role}</strong></td><td>${item.names}</td><td>${item.cue || '—'}</td></tr>`;
		});

		html += `
					</tbody>
				</table>
				<script>window.onload = function() { window.print(); };<\/script>
			</body></html>
		`;
		printWindow.document.write(html);
		printWindow.document.close();
	});

	btnCopyText.addEventListener('click', () => {
		let text = `⛪ *Corteo Nuziale per ${partner1Input.value || 'Chiara'} & ${partner2Input.value || 'Alessandro'}*\n\n`;
		text += `*🚶‍♂️ Ordine di Ingresso:*\n`;
		lineupData.forEach((item, idx) => {
			text += `${idx + 1}. ${item.role} (${item.names})\n`;
		});
		text += `\n*🎉 Uscita e Lancio del Riso:*\n1. Sposi novelli a braccetto!\n2. Paggetti e damigelline\n3. Genitori degli sposi\n4. Testimoni di nozze`;

		navigator.clipboard.writeText(text).then(() => {
			const orig = btnCopyText.textContent;
			btnCopyText.textContent = '✅ Copiato per WhatsApp!';
			setTimeout(() => { btnCopyText.textContent = orig; }, 2500);
		});
	});

	loadTradition();
</script>
