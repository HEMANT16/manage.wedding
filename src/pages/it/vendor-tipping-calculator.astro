<style>
	.vendor-input-group {
		background: var(--bg-paper);
		border: 1.5px solid var(--fg-pencil);
		border-radius: 4px;
		padding: 0.75rem;
	}
	.tip-input {
		width: 100%;
		box-sizing: border-box;
		padding: 0.45rem;
		border: 1.5px solid var(--fg-pencil);
		border-radius: 4px;
		background: #fff;
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: bold;
	}
	.tip-select {
		width: 100%;
		box-sizing: border-box;
		padding: 0.45rem;
		border: 1.5px solid var(--fg-pencil);
		border-radius: 4px;
		background: #fff;
		font-family: var(--font-body);
		font-size: 0.85rem;
	}

	.print-only {
		display: none;
	}

	
</style>

<script is:inline>
	let currencySymbol = '€';

	const currencySelect = document.getElementById('currency-select');
	const chkCatererIncluded = document.getElementById('chk-caterer-included');
	const inputCatererBill = document.getElementById('input-caterer-bill');
	const selectCatererRate = document.getElementById('select-caterer-rate');

	const inputBeautyBill = document.getElementById('input-beauty-bill');
	const selectBeautyRate = document.getElementById('select-beauty-rate');

	const selectPhotoLead = document.getElementById('select-photo-lead');
	const selectPhotoSecond = document.getElementById('select-photo-second');

	const selectDjTip = document.getElementById('select-dj-tip');
	const selectBandTip = document.getElementById('select-band-tip');

	const selectPlannerTip = document.getElementById('select-planner-tip');
	const selectDriverTip = document.getElementById('select-driver-tip');
	const selectOfficiantTip = document.getElementById('select-officiant-tip');
	const selectDeliveryTip = document.getElementById('select-delivery-tip');
	const selectCakeTip = document.getElementById('select-cake-tip');

	const resTotalGratuity = document.getElementById('res-total-gratuity');
	const resEnvelopeCount = document.getElementById('res-envelope-count');
	const resCatererTip = document.getElementById('res-caterer-tip');
	const resBeautyTip = document.getElementById('res-beauty-tip');
	const resPhotoTip = document.getElementById('res-photo-tip');
	const resDjTip = document.getElementById('res-dj-tip');
	const resPlannerTip = document.getElementById('res-planner-tip');
	const resLogisticsTip = document.getElementById('res-logistics-tip');
	const resDeliveryTip = document.getElementById('res-delivery-tip');

	const barCaterer = document.getElementById('bar-caterer');
	const barBeauty = document.getElementById('bar-beauty');
	const barPhoto = document.getElementById('bar-photo');
	const barDj = document.getElementById('bar-dj');
	const barPlanner = document.getElementById('bar-planner');
	const barOther = document.getElementById('bar-other');

	function formatMoney(amount) {
		return `${Math.round(amount).toLocaleString('it-IT')} ${currencySymbol}`;
	}

	function calculateTips() {
		currencySymbol = currencySelect.value;

		let catererTip = 0;
		if (!chkCatererIncluded.checked) {
			const bill = parseFloat(inputCatererBill.value) || 0;
			const rate = selectCatererRate.value;
			if (rate === 'flat') {
				catererTip = 30 * 10; // 10 camerieri
			} else if (rate === 'maitre') {
				catererTip = 150 + (20 * 10);
			} else {
				catererTip = bill * parseFloat(rate);
			}
		}

		const beautyBill = parseFloat(inputBeautyBill.value) || 0;
		const beautyVal = selectBeautyRate.value;
		let beautyTip = 0;
		if (beautyVal === '50') {
			beautyTip = 50;
		} else if (beautyVal === '0') {
			beautyTip = 0;
		} else {
			beautyTip = beautyBill * parseFloat(beautyVal);
		}

		const photoLead = parseFloat(selectPhotoLead.value) || 0;
		const photoSecond = parseFloat(selectPhotoSecond.value) || 0;
		const photoTotal = photoLead + photoSecond;

		const djTip = parseFloat(selectDjTip.value) || 0;
		const bandTip = parseFloat(selectBandTip.value) || 0;
		const musicTotal = djTip + bandTip;

		const plannerTip = parseFloat(selectPlannerTip.value) || 0;

		const driverTip = parseFloat(selectDriverTip.value) || 0;
		const officiantTip = parseFloat(selectOfficiantTip.value) || 0;
		const logisticsTotal = driverTip + officiantTip;

		const deliveryTip = parseFloat(selectDeliveryTip.value) || 0;
		const cakeTip = parseFloat(selectCakeTip.value) || 0;
		const deliveryTotal = deliveryTip + cakeTip;

		const grandTotal = catererTip + beautyTip + photoTotal + musicTotal + plannerTip + logisticsTotal + deliveryTotal;

		let count = 0;
		if (catererTip > 0) count++;
		if (beautyTip > 0) count++;
		if (photoLead > 0) count++;
		if (photoSecond > 0) count++;
		if (djTip > 0) count++;
		if (bandTip > 0) count++;
		if (plannerTip > 0) count++;
		if (driverTip > 0) count++;
		if (officiantTip > 0) count++;
		if (deliveryTotal > 0) count++;

		resTotalGratuity.textContent = formatMoney(grandTotal);
		resEnvelopeCount.textContent = `Ripartite su ${count} Buste Intestate`;
		resCatererTip.textContent = formatMoney(catererTip);
		resBeautyTip.textContent = formatMoney(beautyTip);
		resPhotoTip.textContent = formatMoney(photoTotal);
		resDjTip.textContent = formatMoney(musicTotal);
		resPlannerTip.textContent = formatMoney(plannerTip);
		resLogisticsTip.textContent = formatMoney(logisticsTotal);
		resDeliveryTip.textContent = formatMoney(deliveryTotal);

		if (grandTotal > 0) {
			barCaterer.style.width = `${Math.round((catererTip / grandTotal) * 100)}%`;
			barBeauty.style.width = `${Math.round((beautyTip / grandTotal) * 100)}%`;
			barPhoto.style.width = `${Math.round((photoTotal / grandTotal) * 100)}%`;
			barDj.style.width = `${Math.round((musicTotal / grandTotal) * 100)}%`;
			barPlanner.style.width = `${Math.round((plannerTip / grandTotal) * 100)}%`;
			barOther.style.width = `${Math.round(((logisticsTotal + deliveryTotal) / grandTotal) * 100)}%`;
		}
	}

	document.querySelectorAll('.tip-input, #chk-caterer-included').forEach(el => {
		el.addEventListener('input', calculateTips);
		el.addEventListener('change', calculateTips);
	});
	document.querySelectorAll('.tip-select, #currency-select').forEach(el => {
		el.addEventListener('change', calculateTips);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let rows = '';
		if (parseFloat(resCatererTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Personale di Sala & Catering</strong></td><td>Fine Ricevimento</td><td>Testimone dello Sposo</td><td style="text-align:right; font-weight:bold;">${resCatererTip.textContent}</td></tr>`;
		}
		if (parseFloat(resBeautyTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Make-up Artist & Parrucchiera</strong></td><td>Dopo la preparazione</td><td>Damigella d'Onore / Sposa</td><td style="text-align:right; font-weight:bold;">${resBeautyTip.textContent}</td></tr>`;
		}
		if (parseFloat(selectPhotoLead.value) > 0) {
			rows += `<tr><td><strong>Fotografo Principale</strong></td><td>Fine Servizio</td><td>Testimone / Sposo</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPhotoLead.value)}</td></tr>`;
		}
		if (parseFloat(selectPhotoSecond.value) > 0) {
			rows += `<tr><td><strong>Secondo Fotografo / Assistente</strong></td><td>Fine Servizio</td><td>Testimone</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPhotoSecond.value)}</td></tr>`;
		}
		if (parseFloat(selectDjTip.value) > 0) {
			rows += `<tr><td><strong>DJ Set Ricevimento</strong></td><td>Fine Festa</td><td>Testimone</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectDjTip.value)}</td></tr>`;
		}
		if (parseFloat(selectPlannerTip.value) > 0) {
			rows += `<tr><td><strong>Wedding Planner / Coordinatore</strong></td><td>Fine Ricevimento</td><td>Genitori Sposi</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPlannerTip.value)}</td></tr>`;
		}
		if (parseFloat(selectDriverTip.value) > 0) {
			rows += `<tr><td><strong>Autista Auto Sposi</strong></td><td>Dopo l'arrivo in location</td><td>Testimone</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectDriverTip.value)}</td></tr>`;
		}
		if (parseFloat(selectOfficiantTip.value) > 0) {
			rows += `<tr><td><strong>Offerta Celebrante / Chiesa</strong></td><td>Prima della Cerimonia</td><td>Testimone</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectOfficiantTip.value)}</td></tr>`;
		}
		if (parseFloat(resDeliveryTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Consegna Torta & Allestimento Fiori</strong></td><td>Alla Consegna Mattutina</td><td>Coordinatore</td><td style="text-align:right; font-weight:bold;">${resDeliveryTip.textContent}</td></tr>`;
		}

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Prospetto Mance Fornitori Nozze</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Prospetto Mance Fornitori Nozze</h1>
				<p>Data: ${new Date().toLocaleDateString('it-IT')} | Totale Contanti: <strong>${resTotalGratuity.textContent}</strong> (${resEnvelopeCount.textContent})</p>
				<table>
					<thead>
						<tr>
							<th>Fornitore / Ruolo</th>
							<th>Momento di Consegna</th>
							<th>Incaricato alla Consegna</th>
							<th style="text-align:right;">Importo Mancia</th>
						</tr>
					</thead>
					<tbody>
						${rows}
						<tr style="background:#f2f2f2; font-weight:bold;">
							<td colspan="3">Totale Contanti da Preparare</td>
							<td style="text-align:right; color:#b91c1c;">${resTotalGratuity.textContent}</td>
						</tr>
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Mance_Fornitori_Nozze_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString('it-IT');
		document.getElementById('print-total').textContent = resTotalGratuity.textContent;

		const tbody = document.getElementById('print-tipping-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Personale di Sala & Catering</td><td style="border:1px solid #ccc; padding:6px;">Fine Ricevimento</td><td style="border:1px solid #ccc; padding:6px;">Testimone dello Sposo</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resCatererTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Make-up & Acconciatura Sposa</td><td style="border:1px solid #ccc; padding:6px;">Dopo la preparazione</td><td style="border:1px solid #ccc; padding:6px;">Damigella d'Onore</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBeautyTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Fotografo & Videomaker</td><td style="border:1px solid #ccc; padding:6px;">Fine Servizio</td><td style="border:1px solid #ccc; padding:6px;">Testimone</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPhotoTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">DJ & Musicisti Cerimonia</td><td style="border:1px solid #ccc; padding:6px;">Fine Festa</td><td style="border:1px solid #ccc; padding:6px;">Testimone</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDjTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Wedding Planner / Coordinatore</td><td style="border:1px solid #ccc; padding:6px;">Fine Ricevimento</td><td style="border:1px solid #ccc; padding:6px;">Genitori Sposi</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPlannerTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Autista & Offerta Celebrante</td><td style="border:1px solid #ccc; padding:6px;">Al termine del servizio</td><td style="border:1px solid #ccc; padding:6px;">Testimone</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resLogisticsTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Allestimento Fiori & Torta</td><td style="border:1px solid #ccc; padding:6px;">Alla Consegna</td><td style="border:1px solid #ccc; padding:6px;">Coordinatore</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDeliveryTip.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td colspan="3" style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Totale Contanti da Preparare</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#b91c1c;">${resTotalGratuity.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Fornitore,Momento Consegna,Incaricato,Importo Mancia\n";
		csv += `"Personale di Sala","Fine Ricevimento","Testimone Sposo","${resCatererTip.textContent}"\n`;
		csv += `"Make-up & Acconciatura","Dopo preparazione","Damigella","${resBeautyTip.textContent}"\n`;
		csv += `"Fotografo & Video","Fine Servizio","Testimone","${resPhotoTip.textContent}"\n`;
		csv += `"DJ & Musica","Fine Festa","Testimone","${resDjTip.textContent}"\n`;
		csv += `"Wedding Planner","Fine Ricevimento","Genitori","${resPlannerTip.textContent}"\n`;
		csv += `"Autista & Celebrante","Al termine","Testimone","${resLogisticsTip.textContent}"\n`;
		csv += `"Allestimenti & Torta","Alla consegna","Coordinatore","${resDeliveryTip.textContent}"\n`;
		csv += `"Totale Mance","--","--","${resTotalGratuity.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Mance_Fornitori_Nozze_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateTips();
</script>
