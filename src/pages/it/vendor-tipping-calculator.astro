---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/vendor-tipping-calculator/#webapp",
      "name": "Calcolatore Mance Fornitori Matrimonio & Buste Contanti",
      "url": "https://manage.wedding/it/vendor-tipping-calculator",
      "inLanguage": "it",
      "description": "Calcola le mance per i fornitori del matrimonio: camerieri, maître, DJ, fotografo, truccatrice, autista e staff con stampa delle buste promemoria in Word e PDF.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come calcolare e distribuire le mance ai fornitori di nozze",
      "description": "Guida al galateo italiano delle mance per lo staff del banchetto, musicisti, autisti e fotografi.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Verificare il contratto del catering",
          "text": "Controlla se la quota coperto/servizio è già inclusa o se è consigliato destinare una busta per la brigata di sala."
        },
        {
          "@type": "HowToStep",
          "name": "2. Calcolare le quote fisse per i professionisti",
          "text": "Assegna i riconoscimenti standard: 50 € – 100 € per il maître/caposala, 30 € – 50 € per l'autista e 20 € – 40 € per ciascun cameriere."
        },
        {
          "@type": "HowToStep",
          "name": "3. Preparare le buste intestate in anticipo",
          "text": "Inserisci le banconote contanti in buste etichettate qualche giorno prima dell'evento."
        },
        {
          "@type": "HowToStep",
          "name": "4. Delegare la consegna a un testimone",
          "text": "Affida le buste al testimone dello sposo o al coordinatore per consegnarle al termine dei rispettivi servizi."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "In Italia è obbligatorio dare la mancia ai fornitori del matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, in Italia la mancia non è un obbligo di legge o contrattuale, ma rappresenta un gesto di cortesia e gratitudine molto apprezzato per camerieri, maître, autisti e collaboratori che hanno reso speciale la giornata."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto si dà di mancia ai camerieri del catering di nozze?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La consuetudine prevede una quota forfettaria tra i 20 € e i 40 € per ciascun cameriere di sala, oppure una busta unica da consegnare al maître (es. 150 € – 300 €) da ripartire tra tutta la brigata."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Calcolatore Mance Fornitori Matrimonio & Buste Contanti | Manage.Wedding"
	description="Calcola le mance per i fornitori del matrimonio: camerieri, maître, DJ, fotografo, truccatrice, autista e staff con stampa delle buste promemoria in Word e PDF."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Calcolatore Mance Fornitori" category="budget-finance" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Calcolatore Mance <span class="accent-italic">Fornitori Nozze</span>
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calcola le mance e i riconoscimenti per catering, camerieri, DJ, autisti e fotografi secondo il galateo italiano ed esporta le <strong>Buste Promemoria</strong> in <strong>Word</strong> o <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> Come Organizzare le Mance in 3 Semplici Passaggi
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Seleziona i Fornitori Ingaggiati
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Inserisci i preventivi di banchetto, trucco e musica, escludendo i servizi non previsti o con mance già contrattualizzate.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Consulta le Quote Consigliate
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Il calcolatore applica i valori tradizionali del settore (20–40 € per cameriere, 50–100 € per maître e DJ).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Stampa il Piano di Consegna
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Clicca su <strong>"📝 Esporta Word"</strong> o <strong>"🖨️ Stampa PDF"</strong> per consegnare il promemoria delle buste al testimone di nozze.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="tipping-calc-grid">
			
			<!-- Left Column: Vendor Categories Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							💵 Fornitori & Personale di Servizio
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Configura i professionisti e le quote
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Valuta:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="€" selected>€ (EUR)</option>
							<option value="CHF">CHF (Franco Svizzero)</option>
							<option value="$">$ (USD)</option>
							<option value="£">£ (GBP)</option>
						</select>
					</div>
				</div>

				<form id="tipping-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Catering & Waitstaff -->
					<div class="vendor-input-group">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
							<label class="font-heading" style="font-size: 1rem; color: var(--accent-red);">
								🍽️ Personale di Sala & Catering
							</label>
							<label style="font-size: 0.78rem; display: flex; align-items: center; gap: 0.3rem; cursor: pointer; color: var(--text-secondary);">
								<input type="checkbox" id="chk-caterer-included"> Mancia già inclusa nel coperto
							</label>
						</div>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Preventivo Banchetto (€)</span>
								<input type="number" id="input-caterer-bill" value="12000" min="0" step="500" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Modalità Mancia</span>
								<select id="select-caterer-rate" class="tip-select">
									<option value="flat" selected>Busta Fissa: 30 € a cameriere (~300 €)</option>
									<option value="0.03">3% del Totale Banchetto (360 €)</option>
									<option value="0.05">5% del Totale Banchetto (600 €)</option>
									<option value="maitre">150 € al Maître + 20 €/cameriere</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 2. Hair & Makeup -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: var(--accent-blue); display: block; margin-bottom: 0.3rem;">
							💄 Make-up Artist & Acconciatura Sposa
						</label>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Preventivo Bellezza (€)</span>
								<input type="number" id="input-beauty-bill" value="650" min="0" step="50" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Mancia Riconoscimento</span>
								<select id="select-beauty-rate" class="tip-select">
									<option value="0.10" selected>10% del servizio (65 €)</option>
									<option value="50">50 € forfettari</option>
									<option value="0">Nessuna mancia (Titolare studio)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 3. Photography & Videography -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #16a34a; display: block; margin-bottom: 0.3rem;">
							📸 Fotografo Principale & Secondo Operatore
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Primo Fotografo</span>
								<select id="select-photo-lead" class="tip-select">
									<option value="50" selected>50 € o Regalo simbolico</option>
									<option value="100">100 € per servizio eccezionale</option>
									<option value="0">Titolare studio (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Secondo Fotografo / Assistente</span>
								<select id="select-photo-second" class="tip-select">
									<option value="40" selected>40 € Assistente</option>
									<option value="50">50 € Assistente</option>
									<option value="0">Nessun secondo operatore (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 4. DJ & Entertainment -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #7c3aed; display: block; margin-bottom: 0.3rem;">
							🎵 DJ & Musicisti dal Vivo
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">DJ Set Ricevimento</span>
								<select id="select-dj-tip" class="tip-select">
									<option value="50" selected>50 € al DJ</option>
									<option value="100">100 € al DJ</option>
									<option value="0">Nessuna mancia (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Musicisti Cerimonia</span>
								<select id="select-band-tip" class="tip-select">
									<option value="30" selected>30 € a musicista (es. duo = 60 €)</option>
									<option value="50">50 € a musicista</option>
									<option value="0">Nessun musicista dal vivo (0 €)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 5. Wedding Planner & Coordinator -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #d97706; display: block; margin-bottom: 0.3rem;">
							📋 Wedding Planner / Coordinatore del Giorno
						</label>
						<div>
							<select id="select-planner-tip" class="tip-select">
								<option value="100" selected>100 € o Regalo personalizzato</option>
								<option value="150">150 € per coordinamento completo</option>
								<option value="0">Nessuna mancia (Titolare agenzia)</option>
							</select>
						</div>
					</div>

					<!-- 6. Drivers & Logistics -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex-direction: column; gap: 0.6rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block; text-align: center; margin-bottom: 0.5rem;">
							🚐 Autista Auto Sposi, Celebrante & Consegne
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Autista Auto d'Epoca / Navetta</span>
								<select id="select-driver-tip" class="tip-select">
									<option value="40" selected>40 € Autista</option>
									<option value="60">60 € Autista</option>
									<option value="0">Incluso nel noleggio (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Offerta Chiesa / Celebrante</span>
								<select id="select-officiant-tip" class="tip-select">
									<option value="50" selected>50 € Offerta libera</option>
									<option value="100">100 € Offerta</option>
									<option value="0">Già versata (0 €)</option>
								</select>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Staff Allestimento Fiorista</span>
								<select id="select-delivery-tip" class="tip-select">
									<option value="30" selected>30 € Consegna/Allestimento</option>
									<option value="0">Nessuna mancia (0 €)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Consegna Torta Pasticceria</span>
								<select id="select-cake-tip" class="tip-select">
									<option value="20" selected>20 € Consegna</option>
									<option value="0">Nessuna mancia (0 €)</option>
								</select>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Gratuity Breakdown & Cash Envelope Planner -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Gratuity Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								✉️ Budget Totale Mance
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Contanti da preparare nelle buste per il grande giorno
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Esporta Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Stampa PDF
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Gratuity Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Totale Mance in Contanti da Preparare</span>
						<strong id="res-total-gratuity" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">745 €</strong>
						<span id="res-envelope-count" style="font-size: 0.8rem; color: var(--accent-red);">Ripartite su 7 Buste Intestate</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Dettaglio Buste per Fornitore
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Personale di Sala & Catering:</td>
									<td id="res-caterer-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">300 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">💄 Make-up & Acconciatura Sposa:</td>
									<td id="res-beauty-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">65 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📸 Fotografo & Assistente:</td>
									<td id="res-photo-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">90 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🎵 DJ & Musicisti Cerimonia:</td>
									<td id="res-dj-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">110 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📋 Wedding Planner / Coordinatore:</td>
									<td id="res-planner-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">100 €</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🚐 Autista & Offerta Celebrante:</td>
									<td id="res-logistics-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">90 €</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0;">🌸 Consegna Fiori & Torta:</td>
									<td id="res-delivery-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">50 €</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Gratuity Distribution Bar Chart -->
					<div>
						<span class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.3rem; text-align: center;">
							Ripartizione Percentuale delle Mance
						</span>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; display: flex; background: #eee;">
							<div id="bar-caterer" style="width: 40%; background: var(--accent-red); transition: width 0.3s ease;"></div>
							<div id="bar-beauty" style="width: 10%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-photo" style="width: 12%; background: #16a34a; transition: width 0.3s ease;"></div>
							<div id="bar-dj" style="width: 15%; background: #7c3aed; transition: width 0.3s ease;"></div>
							<div id="bar-planner" style="width: 13%; background: #d97706; transition: width 0.3s ease;"></div>
							<div id="bar-other" style="width: 10%; background: #64748b; transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Envelope Delegation Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						📌 Regola d'Oro per il Giorno del Matrimonio:
					</strong>
					<ul class="font-body" style="font-size: 0.85rem; line-height: 1.5; padding-left: 1.1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Non portare contanti con te:</strong> Affida tutte le buste chiuse e intestate al testimone o alla damigella d'onore.</li>
						<li><strong>Momento di consegna:</strong> Truccatrice e parrucchiera prima di uscire di casa; DJ e sala durante l'ultima mezz'ora prima dei saluti.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Prospetto Mance Fornitori Nozze</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Data: <span id="print-date"></span> | Totale Contanti: <span id="print-total"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 15px;">
				<thead>
