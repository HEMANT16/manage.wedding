---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/it/who-pays-for-what-wedding/#webapp",
      "name": "Chi Paga Cosa nel Matrimonio? Ripartizione Spese Famiglie & Sposi",
      "url": "https://manage.wedding/it/who-pays-for-what-wedding",
      "inLanguage": "it",
      "description": "Calcolatore gratuito per dividere le spese del matrimonio: confronta la tradizione del galateo con i modelli moderni di compartecipazione a 3 vie tra sposi e genitori.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      }
    },
    {
      "@type": "HowTo",
      "name": "Come dividere le spese del matrimonio tra famiglie e sposi",
      "description": "Guida alle regole del galateo italiano e alle soluzioni moderne per ripartire i costi tra famiglia della sposa, famiglia dello sposo e coppia.",
      "inLanguage": "it",
      "step": [
        {
          "@type": "HowToStep",
          "name": "1. Fissare il budget totale di spesa",
          "text": "Stabilisci il tetto massimo del matrimonio (es. 35.000 €) sommando i risparmi personali e i contributi familiari."
        },
        {
          "@type": "HowToStep",
          "name": "2. Scegliere il modello di ripartizione",
          "text": "Decidi se seguire il galateo tradizionale (famiglia sposa riceve il banchetto, famiglia sposo fedi e viaggio), il modello a 3 vie o l'autonomia totale al 100%."
        },
        {
          "@type": "HowToStep",
          "name": "3. Assegnare le singole voci ai pagatori",
          "text": "Attribuisci la responsabilità per location, abiti, bomboniere, fiori e viaggio di nozze."
        },
        {
          "@type": "HowToStep",
          "name": "4. Esportare l'accordo economico",
          "text": "Stampa o esporta in Word il riepilogo con le quote concordate per una gestione trasparente e senza malintesi."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "inLanguage": "it",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Secondo il galateo italiano, cosa paga tradizionalmente la famiglia della sposa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tradizionalmente, la famiglia della sposa paga: l'abito da sposa e gli accessori, il ricevimento e il banchetto nuziale, le partecipazioni e gli inviti, il servizio fotografico, le bomboniere, i confetti e gli allestimenti floreali."
          }
        },
        {
          "@type": "Question",
          "name": "Cosa paga tradizionalmente la famiglia dello sposo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La famiglia dello sposo tradizionalmente copre: l'abito dello sposo, l'acquisto delle fedi nuziali (qualora non siano donate dai testimoni), il bouquet della sposa (recapitato a casa sua la mattina delle nozze), l'offerta per la chiesa o i diritti comunali e il viaggio di nozze."
          }
        },
        {
          "@type": "Question",
          "name": "Chi compra tradizionalmente le fedi nuziali in Italia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nella consuetudine italiana le fedi nuziali in oro vengono regalate dai testimoni di nozze (o acquistate dallo sposo e dalla sua famiglia se i testimoni scelgono un altro dono)."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Chi Paga Cosa nel Matrimonio? Ripartizione Spese Famiglie & Sposi | Manage.Wedding"
	description="Suddividi i costi del matrimonio secondo la tradizione del galateo o i modelli moderni a 3 vie: famiglia sposa, famiglia sposo e coppia con accordo stampabile."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Chi Paga Cosa nel Matrimonio?" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Galateo Tradizionale vs Modelli Moderni</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Chi Paga Cosa? <span class="accent-italic">Ripartizione Spese Nozze</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Confronta le regole del galateo classico italiano con i modelli moderni di compartecipazione a 3 vie. Assegna ogni spesa con trasparenza ed esporta un accordo chiaro in 1 click.
			</p>
		</header>

		<!-- Main Interactive Splitter Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Split Model Setup & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Budget & Modello di Spesa
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Galateo & Quote
					</span>
				</div>

				<!-- Total Budget -->
				<div class="form-group">
					<label class="form-label" for="total-wedding-budget">Budget Totale Matrimonio (€)</label>
					<input type="number" id="total-wedding-budget" class="form-input" value="35000" min="5000" step="1000" style="font-size: 1.2rem; font-weight: 700;" />
				</div>

				<!-- Split Model Shortcut Selector -->
				<div class="form-group">
					<label class="form-label" for="split-model-preset">Modello di Ripartizione</label>
					<select id="split-model-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="traditional" selected>📜 Galateo Tradizionale (Famiglia Sposa 65% / Famiglia Sposo 25% / Sposi 10%)</option>
						<option value="modern-3way">🤝 Modello Moderno a 3 Vie (Sposi 40% / Famiglia Sposa 30% / Famiglia Sposo 30%)</option>
						<option value="couple-100">💍 Interamente a Carico degli Sposi (Sposi 100% / Nessun Contributo)</option>
						<option value="couple-50-50">⚖️ Coppia 50/50 (50% Sposo / 50% Sposa)</option>
						<option value="custom">✏️ Personalizzazione Manuale</option>
					</select>
				</div>

				<!-- Visual Split Percentages Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Percentuali di Contribuzione (%)
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.85rem;">
						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-red);">👰 Famiglia della Sposa:</span>
								<span id="slider-bride-pct-val">65%</span>
							</div>
							<input type="range" id="slider-bride-pct" min="0" max="100" value="65" style="width: 100%; accent-color: var(--accent-red);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-blue);">🤵 Famiglia dello Sposo:</span>
								<span id="slider-groom-pct-val">25%</span>
							</div>
							<input type="range" id="slider-groom-pct" min="0" max="100" value="25" style="width: 100%; accent-color: var(--accent-blue);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: #16a34a;">💍 Quota Diretta degli Sposi:</span>
								<span id="slider-couple-pct-val">10%</span>
							</div>
							<input type="range" id="slider-couple-pct" min="0" max="100" value="10" style="width: 100%; accent-color: #16a34a;" />
						</div>
					</div>
				</div>

				<!-- Money Talk Guide -->
				<div style="margin-top: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
					<strong style="display: block; color: var(--fg-pencil); margin-bottom: 4px;">💬 Come parlare di budget con i genitori:</strong>
					"Stiamo definendo il budget delle nozze! Ci farebbe piacere sapere se desiderate contribuire a una voce specifica (come il banchetto, i fiori o la musica) oppure se preferite fare un regalo libero."
				</div>

			</div>

			<!-- Right Column: Results Breakdown & Itemized Checklist -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Contribution Summary Cards -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Riepilogo Quote Assegnate
					</h3>

					<!-- 3 Contribution Summary Bars -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem; text-align: center;">
						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-red);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Famiglia Sposa</span>
							<strong id="card-bride-amount" style="font-size: 1.2rem; color: var(--accent-red); display: block; margin-top: 2px;">22.750 €</strong>
							<span id="card-bride-pct" style="font-size: 0.75rem; color: #64748b;">(65%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-blue);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Famiglia Sposo</span>
							<strong id="card-groom-amount" style="font-size: 1.2rem; color: var(--accent-blue); display: block; margin-top: 2px;">8.750 €</strong>
							<span id="card-groom-pct" style="font-size: 0.75rem; color: #64748b;">(25%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid #16a34a;">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Gli Sposi</span>
							<strong id="card-couple-amount" style="font-size: 1.2rem; color: #16a34a; display: block; margin-top: 2px;">3.500 €</strong>
							<span id="card-couple-pct" style="font-size: 0.75rem; color: #64748b;">(10%)</span>
						</div>
					</div>

					<!-- Itemized Traditional Responsibilities Table -->
					<div style="max-height: 280px; overflow-y: auto; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; margin-bottom: 1.5rem;">
						<table style="width: 100%; border-collapse: collapse; font-size: 0.86rem; text-align: left;">
							<thead>
								<tr style="background: var(--muted-paper); border-bottom: 1.5px solid var(--fg-pencil);">
									<th style="padding: 6px 8px;">Voce di Spesa</th>
									<th style="padding: 6px 8px; text-align: right;">Secondo il Galateo</th>
								</tr>
							</thead>
							<tbody>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Ricevimento & Banchetto Nuziale</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Famiglia Sposa</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Abito da Sposa, Velo & Trucco</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Famiglia Sposa</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Servizio Fotografico & Video</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Famiglia Sposa</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Partecipazioni, Bomboniere & Confetti</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Famiglia Sposa</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Addobbi Floreali in Chiesa & Sala</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Famiglia Sposa</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Abito dello Sposo</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Famiglia Sposo</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Bouquet della Sposa & Boutonnière</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Famiglia Sposo</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Offerta Cerimonia / Diritti Comunali</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Famiglia Sposo</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Viaggio di Nozze (o Lista Nozze)</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Famiglia Sposo / Invitati</td></tr>
								<tr><td>Fedi Nuziali in Oro</td><td style="text-align: right; font-weight: bold; color: #16a34a;">Testimoni di Nozze</td></tr>
							</tbody>
						</table>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-agreement" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Stampa Accordo (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Esporta Documento Word
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- SEO Article & Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Guida al Galateo delle Spese Matrimoniali
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Dalle tradizioni storiche alle abitudini contemporanee delle coppie italiane.
				</p>
			</div>

			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. La Ripartizione Tradizionale vs Moderne Nozze Autonome
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					In passato, le famiglie degli sposi sostenevano la quasi totalità dei costi. Oggi la maggior parte delle coppie convive già da anni e preferisce finanziare autonomamente il matrimonio o accogliere un contributo forfettario dai genitori, mantenendo la piena libertà di scelta su fornitori e stile della festa.
				</p>
			</section>

			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Domande Frequenti (FAQ)
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Cosa regalano tradizionalmente i testimoni agli sposi?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Nella tradizione italiana, i testimoni acquistano le fedi nuziali oppure offrono un regalo importante dalla lista nozze, accompagnato da una quota generosa nella classica busta.
					</p>
				</details>
			</section>
		</article>

		<RelatedTools currentPath="/it/who-pays-for-what-wedding" category="budget" />

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const totalBudgetInput = document.getElementById('total-wedding-budget');
		const presetSelect = document.getElementById('split-model-preset');

		const sliderBride = document.getElementById('slider-bride-pct');
		const sliderGroom = document.getElementById('slider-groom-pct');
		const sliderCouple = document.getElementById('slider-couple-pct');

		const bridePctVal = document.getElementById('slider-bride-pct-val');
		const groomPctVal = document.getElementById('slider-groom-pct-val');
		const couplePctVal = document.getElementById('slider-couple-pct-val');

		const cardBrideAmount = document.getElementById('card-bride-amount');
		const cardBridePct = document.getElementById('card-bride-pct');
		const cardGroomAmount = document.getElementById('card-groom-amount');
		const cardGroomPct = document.getElementById('card-groom-pct');
		const cardCoupleAmount = document.getElementById('card-couple-amount');
		const cardCouplePct = document.getElementById('card-couple-pct');

		const btnPrint = document.getElementById('btn-print-agreement');
		const btnDoc = document.getElementById('btn-export-doc');

		function calculateSplits() {
			const total = parseFloat(totalBudgetInput.value) || 0;
			const bPct = parseInt(sliderBride.value, 10);
			const gPct = parseInt(sliderGroom.value, 10);
			const cPct = parseInt(sliderCouple.value, 10);

			bridePctVal.textContent = `${bPct}%`;
			groomPctVal.textContent = `${gPct}%`;
			couplePctVal.textContent = `${cPct}%`;

			const bAmount = (total * bPct) / 100;
			const gAmount = (total * gPct) / 100;
			const cAmount = (total * cPct) / 100;

			cardBrideAmount.textContent = `${Math.round(bAmount).toLocaleString('it-IT')} €`;
			cardBridePct.textContent = `(${bPct}%)`;
			cardGroomAmount.textContent = `${Math.round(gAmount).toLocaleString('it-IT')} €`;
			cardGroomPct.textContent = `(${gPct}%)`;
			cardCoupleAmount.textContent = `${Math.round(cAmount).toLocaleString('it-IT')} €`;
			cardCouplePct.textContent = `(${cPct}%)`;
		}

		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'traditional') {
				sliderBride.value = 65;
				sliderGroom.value = 25;
				sliderCouple.value = 10;
			} else if (p === 'modern-3way') {
				sliderBride.value = 30;
				sliderGroom.value = 30;
				sliderCouple.value = 40;
			} else if (p === 'couple-100') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			} else if (p === 'couple-50-50') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			}
			calculateSplits();
		});

		sliderBride.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderBride.value, 10);
			sliderGroom.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderGroom.value;
			calculateSplits();
		});
		sliderGroom.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderGroom.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderBride.value;
			calculateSplits();
		});
		sliderCouple.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderCouple.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderGroom.value = rem - sliderBride.value;
			calculateSplits();
		});

		totalBudgetInput.addEventListener('input', calculateSplits);

		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			if (!printWindow) { window.print(); return; }
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Accordo Ripartizione Spese Nozze — Manage.Wedding</title>
					<style>
						@page { size: 8.5in 11in; margin: 0.5in; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 20pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Prospetto Ripartizione Costi Matrimonio</h1>
					<p>Budget Totale Stimato: ${parseFloat(totalBudgetInput.value).toLocaleString('it-IT')} € | Modello: ${presetSelect.options[presetSelect.selectedIndex].text}</p>
					
					<table>
						<thead><tr><th>Parte Contribuente</th><th>Quota Concordata</th><th>Importo Assegnato (€)</th><th>Principali Spese di Competenza</th></tr></thead>
						<tbody>
							<tr><td><strong>Famiglia della Sposa</strong></td><td>${sliderBride.value}%</td><td><strong>${cardBrideAmount.textContent}</strong></td><td>Ricevimento, Banchetto, Abito Sposa, Fiori, Fotografo</td></tr>
							<tr><td><strong>Famiglia dello Sposo</strong></td><td>${sliderGroom.value}%</td><td><strong>${cardGroomAmount.textContent}</strong></td><td>Abito Sposo, Bouquet, Offerta Cerimonia, Viaggio di Nozze</td></tr>
							<tr><td><strong>Gli Sposi</strong></td><td>${sliderCouple.value}%</td><td><strong>${cardCoupleAmount.textContent}</strong></td><td>Fedi (o testimoni), Regali Testimoni, Spese Extra</td></tr>
							<tr class="total-row"><td>BUDGET TOTALE</td><td>100%</td><td>${parseFloat(totalBudgetInput.value).toLocaleString('it-IT')} €</td><td>Piano Finanziario Completo</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Accordo Ripartizione Spese Matrimonio</title>
