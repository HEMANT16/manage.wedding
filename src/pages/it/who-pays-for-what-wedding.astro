				</head>
				<body>
					<h2>Manage.Wedding — Accordo Ripartizione Spese Matrimonio</h2>
					<p>Budget Totale: ${parseFloat(totalBudgetInput.value).toLocaleString('it-IT')} €</p>
					<table>
						<thead><tr><th>Contribuente</th><th>Quota (%)</th><th>Importo (€)</th></tr></thead>
						<tbody>
							<tr><td>Famiglia della Sposa</td><td>${sliderBride.value}%</td><td>${cardBrideAmount.textContent}</td></tr>
							<tr><td>Famiglia dello Sposo</td><td>${sliderGroom.value}%</td><td>${cardGroomAmount.textContent}</td></tr>
							<tr><td>Gli Sposi</td><td>${sliderCouple.value}%</td><td>${cardCoupleAmount.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTALE</td><td>100%</td><td>${parseFloat(totalBudgetInput.value).toLocaleString('it-IT')} €</td></tr>
						</tbody>
