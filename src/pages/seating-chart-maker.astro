---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/seating-chart-maker/#webapp",
      "name": "Wedding Seating Chart Maker & Table Planner",
      "url": "https://manage.wedding/seating-chart-maker",
      "description": "Free drag-and-drop wedding seating chart maker. Assign attending guests to round, rectangular, and sweetheart tables, track capacities, and export to Word, PDF, or Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Create a Wedding Seating Chart in 4 Easy Steps",
      "description": "A step-by-step method to organize guest tables, balance party dynamics, and export a finalized floor plan.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Configure Reception Tables",
          "text": "Add 60-inch round, 72-inch round, or rectangular banquet tables to your chart and set seat capacity limits (typically 8 to 10 guests per table)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Group Guests by Social Dynamics",
          "text": "Group guests by relationship circles such as immediate family, college friends, coworkers, and plus-ones to foster organic conversation."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Seat Guests and Assign Sweetheart Table",
          "text": "Drag guest cards or use the seat selector to place attendees at designated tables, placing VIPs and immediate family closest to the newlyweds."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Export Table Roster for Caterers and Coordinator",
          "text": "Download the completed seating plan as a formatted Word (.doc), PDF, or CSV file for your caterer, venue planner, and stationer."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I use this wedding seating chart maker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1) Add tables and set capacities (e.g. 8 or 10 seats). 2) Assign guests by dragging their cards or tapping the '🪑 Seat' dropdown button on each guest card. 3) Export your completed seating plan to Word (.doc), PDF, or Excel (.csv) with one click."
          }
        },
        {
          "@type": "Question",
          "name": "How many guests fit at standard round and rectangular wedding tables?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard 60-inch (5ft) round table comfortably seats 8 guests (max 9). A 72-inch (6ft) round table seats 10 guests (max 11). Standard 6-foot rectangular banquet tables seat 6 guests (3 per side), and 8-foot rectangular tables seat 8 guests (4 per side)."
          }
        },
        {
          "@type": "Question",
          "name": "How do I export my finalized seating chart to Word or PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Click the 'Export Word (.doc)' or 'Export PDF / Print' button at the top of the seating dashboard. The tool will instantly generate an organized document grouped by table number with guest names, meal choices, and seating counts ready for your caterer and coordinator."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a Head Table and a Sweetheart Table?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Sweetheart Table is an intimate table set exclusively for the newlyweds, allowing the wedding party to sit with their own dates and families. A traditional Head Table seats the bride, groom, bridesmaids, and groomsmen in a long single-sided row facing the reception room."
          }
        },
        {
          "@type": "Question",
          "name": "When should you finalize the wedding seating chart?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Finalize your seating chart approximately 10 to 14 days before your wedding, once all RSVP deadlines have passed and catering headcounts are confirmed. This provides ample time to print escort cards and large entrance display boards."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Seating Chart Maker (Free Drag & Drop Table Planner) | Manage.Wedding"
	description="Create your wedding seating chart online for free. Drag and drop guests into custom tables, track capacities, and export to Word (.doc), PDF, or Excel instantly."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Wedding Seating Chart Maker
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Assign attending guests into round, rectangular, or sweetheart tables. Monitor table capacity limits and export to <strong>Word (.doc)</strong>, <strong>PDF</strong>, or <strong>Excel (.csv)</strong>.
				</p>
			</div>
		</section>

		<!-- 💡 3-Step Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
				<strong class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem;">
					<span>💡</span> How This Tool Works (3 Simple Steps)
				</strong>
				<span style="font-size: 0.85rem; color: var(--fg-pencil); font-family: var(--font-body); font-style: italic;">
					No complicated setup required!
				</span>
			</div>
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: var(--accent-blue); display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						1️⃣ Setup Tables
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Click <strong>"+ Add Table"</strong>. Select table type (⭕ Round, ▭ Banquet, ❤️ Sweetheart) and set seat capacity (e.g. 8 or 10).
					</p>
				</div>

				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: #15803d; display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						2️⃣ Seat Guests
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Drag cards from <strong>Unassigned</strong> to any table, or click <strong>"🪑 Seat"</strong> on mobile. Or hit <strong>"⚡ Auto-Fill"</strong>!
					</p>
				</div>

				<div style="background: rgba(255,255,255,0.7); border: 1px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
					<strong class="font-heading" style="color: var(--accent-red); display: block; font-size: 1.05rem; margin-bottom: 0.2rem;">
						3️⃣ Export Chart
					</strong>
					<p class="font-body" style="font-size: 0.9rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Click <strong>"Export Word"</strong> or <strong>"Export PDF"</strong> to download a clean table checklist for caterers & coordinators.
					</p>
				</div>
			</div>
		</div>

		<!-- Overview Dashboard & Actions Toolbar -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						🪑 Floor Plan & Seating Progress
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Auto-synced with Guest List Manager & RSVP Tracker
					</span>
				</div>

				<!-- Export & Control Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Export Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Export PDF / Print
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Export Excel (.csv)
					</button>
					<button type="button" id="btn-add-table" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Add Table
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						🔄 Load Sample
					</button>
					<button type="button" id="btn-clear-seating" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🧹 Reset Seats
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Attending Guests</span>
					<strong id="stat-total-attending" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">Total Seats to Place</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Seated at Tables</span>
					<strong id="stat-seated-count" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-seated-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% seated</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Unassigned Guests</span>
					<strong id="stat-unassigned-count" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span style="font-size: 0.75rem; color: #854d0e; display: block;">Needs Placement</span>
				</div>
				<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #1e40af; display: block;">Tables Configured</span>
					<strong id="stat-table-count" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue);">0</strong>
					<span id="stat-capacity-total" style="font-size: 0.75rem; color: #1e40af; display: block;">0 Total Chairs</span>
				</div>
			</div>

			<!-- Dynamic Seating Progress Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Seating Completion</span>
					<span id="progress-text" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">0% Assigned</span>
				</div>
				<div style="height: 24px; border: 2px solid var(--fg-pencil); border-radius: 12px; overflow: hidden; background: #e5e0d8;">
					<div id="progress-bar-fill" style="height: 100%; width: 0%; background-color: #22c55e; transition: width 0.3s ease;"></div>
				</div>
			</div>
		</div>

		<!-- Interactive Seating Studio Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 340px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="seating-workspace-grid">
			
			<!-- Left Column: Unassigned Guests Tray + Quick Add -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin: 0; color: var(--fg-pencil);">
						👥 Unassigned (<span id="unassigned-badge-count">0</span>)
					</h3>
					<button type="button" id="btn-auto-assign" class="hand-btn secondary" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">
						⚡ Auto-Fill
					</button>
				</div>

				<!-- Search Unassigned -->
				<div style="margin-bottom: 0.75rem;">
					<input type="text" id="unassigned-search" placeholder="🔍 Search unassigned guests..." style="width: 100%; box-sizing: border-box; padding: 0.55rem 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: var(--bg-paper); color: var(--fg-pencil);">
				</div>

				<!-- Drop Zone for Unassigned -->
				<div id="unassigned-dropzone" class="drop-zone" data-table-id="unassigned" style="min-height: 240px; max-height: 480px; overflow-y: auto; padding: 0.5rem; border: 2px dashed var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); display: flex; flex-direction: column; gap: 0.5rem;">
					<!-- Injected via JS -->
				</div>

				<!-- Quick Add Guest Directly -->
				<div style="margin-top: 1.25rem; border-top: 2px dashed var(--fg-pencil); padding-top: 1rem;">
					<label for="quick-guest-name" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.4rem;">
						➕ Quick Add Extra Guest:
					</label>
					<form id="quick-add-guest-form" style="display: flex; gap: 0.4rem; align-items: center;">
						<input type="text" id="quick-guest-name" required placeholder="Enter guest name..." style="flex: 1; min-width: 0; padding: 0.55rem 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem; background: var(--bg-paper); color: var(--fg-pencil);">
						<select id="quick-guest-party" title="Party Size (Seats)" style="width: 78px; padding: 0.55rem 0.25rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem; background: #fff; color: var(--fg-pencil);">
							<option value="1">1 Seat</option>
							<option value="2" selected>2 Seats</option>
							<option value="3">3 Seats</option>
							<option value="4">4 Seats</option>
							<option value="5">5 Seats</option>
						</select>
						<button type="submit" class="hand-btn" style="padding: 0.55rem 0.85rem; font-size: 0.95rem; white-space: nowrap;">
							➕ Add
						</button>
					</form>
				</div>

			</div>

			<!-- Right Column: Interactive Reception Tables Layout Grid -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h3 class="font-heading" style="font-size: 1.4rem; margin: 0; color: var(--fg-pencil);">
							🍽️ Reception Tables Floor
						</h3>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
							Drag cards onto tables, or use <strong>"➕ Add Guest"</strong> on any table card
						</span>
					</div>
					
					<button type="button" id="btn-add-table-top" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
						➕ New Table
					</button>
				</div>

				<!-- Tables Grid Container -->
				<div id="tables-grid-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;">
					<!-- Injected via JS -->
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Official Reception Seating Chart</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Total Seated: <span id="print-seated-count"></span></p>
			</div>
			<div id="print-tables-content"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Quick Rule of Thumb (BLUF)
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					1-Minute Seating Formula
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Core Table Sizing Rule:</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">60" Round = 8–10 Guests</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">72" Round = 10–12 Guests</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">8ft Banquet = 8–10 Guests</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Floor Clearance Standard:</strong> Maintain a minimum of <strong>60 inches (5 feet)</strong> from table-edge to table-edge to allow seated chair push-back and a smooth 24" server corridor.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Table Format</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Diameter / Dimensions</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Comfortable Capacity</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Max Headcount</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Linen Size Required</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Min. Room Clearance</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Sweetheart Table</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">36"–48" Semi-Circle / Rect</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">2 Guests (Couple Only)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">2</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">90" Round / Custom</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">48" front / dance floor access</td>
						</tr>
						<tr style="background: #faf8f3;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">60" Round (5-Foot)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">60" Diameter (152 cm)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">8 Guests (Ideal)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">10 Guests (Snug)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">120" Round (Floor length)</td>
