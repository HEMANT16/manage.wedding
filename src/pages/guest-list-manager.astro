---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Guest List Manager & RSVP Tracker",
      "url": "https://manage.wedding/guest-list-manager",
      "description": "Free wedding guest list tracker and CRM. Manage plus-ones, dietary restrictions, party sizes, and export to Word, PDF, or Excel instantly.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I export my wedding guest list to Word or PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Click the 'Export Word (.doc)' button above to download an editable Microsoft Word table, or click 'Export PDF / Print' to generate a clean, printer-friendly PDF document with all guest names, groups, dietary notes, and RSVP statuses."
          }
        },
        {
          "@type": "Question",
          "name": "What is the standard rule for wedding plus-ones?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Etiquette dictates giving a plus-one to guests who are married, engaged, living together, or in long-term relationships (over 1 year). For the wedding party, plus-ones are standard regardless of relationship status. For casual single guests, plus-ones are optional based on venue capacity and budget."
          }
        },
        {
          "@type": "Question",
          "name": "How does the A-List and B-List wedding guest strategy work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The A-List includes immediate family and close friends who receive invitations 8-10 weeks in advance. As A-List guests decline, B-List invitations are sent out immediately in rounds (at least 5-6 weeks before the wedding) without letting guests know they were on a secondary list."
          }
        },
        {
          "@type": "Question",
          "name": "How do I sync my guest list with the Seating Chart Maker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Manage.Wedding stores all guest data securely in your local browser storage. Any guests added here automatically appear in the Seating Chart Maker, RSVP Tracker, and Table & Place Card generator without needing to re-type names."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Guest List Manager | Free CRM with Word & PDF Export"
	description="Organize your wedding guest list effortlessly. Manage plus-ones, dietary restrictions, RSVPs, and export directly to Word (.doc), PDF, or CSV Excel instantly."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Wedding Guest List Manager
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Track RSVPs, plus-ones, dietary restrictions, and table seating in one place. Export your list to <strong>Word (.doc)</strong>, <strong>PDF</strong>, or <strong>Excel (.csv)</strong> with one click.
				</p>
			</div>
		</section>

		<!-- Overview Metrics & Dashboard -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.5rem; background: #fff;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin: 0;">
						📊 Guest List Dashboard
					</h2>
					<span class="font-body" style="color: var(--text-secondary); font-size: 0.95rem;">
						Auto-synced with your Seating Chart & RSVP Tracker
					</span>
				</div>

				<!-- Export & Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" class="export-btn-group">
					<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #eff6ff;">
						📝 Export Word (.doc)
					</button>
					<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; background: #fef2f2;">
						🖨️ Export PDF / Print
					</button>
					<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						📊 Export Excel (.csv)
					</button>
					<button type="button" id="btn-sample-data" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
						➕ Load Sample
					</button>
					<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem; color: var(--accent-red);">
						🗑️ Clear
					</button>
				</div>
			</div>

			<!-- Stat Counters Grid -->
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;" class="stats-counter-grid">
				<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total Party Seats</span>
					<strong id="stat-total-seats" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil);">0</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(<span id="stat-total-parties">0</span> invitations)</span>
				</div>
				<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Confirmed Attending</span>
					<strong id="stat-attending" class="font-heading" style="font-size: 1.8rem; color: #15803d;">0</strong>
					<span id="stat-attending-pct" style="font-size: 0.75rem; color: #166534; display: block;">0% of total</span>
				</div>
				<div style="background: #fefce8; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #854d0e; display: block;">Awaiting RSVP</span>
					<strong id="stat-pending" class="font-heading" style="font-size: 1.8rem; color: #a16207;">0</strong>
					<span id="stat-pending-pct" style="font-size: 0.75rem; color: #854d0e; display: block;">0% of total</span>
				</div>
				<div style="background: #fef2f2; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #991b1b; display: block;">Declined</span>
					<strong id="stat-declined" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red);">0</strong>
					<span id="stat-declined-pct" style="font-size: 0.75rem; color: #991b1b; display: block;">0% of total</span>
				</div>
				<div style="background: #faf5ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; text-align: center;">
					<span class="font-body" style="font-size: 0.85rem; color: #6b21a8; display: block;">Special Diets</span>
					<strong id="stat-dietary" class="font-heading" style="font-size: 1.8rem; color: #7e22ce;">0</strong>
					<span style="font-size: 0.75rem; color: #6b21a8; display: block;">Requires Catering</span>
				</div>
			</div>

			<!-- Dynamic Visual Stacked Group Distribution Bar -->
			<div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
					<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Group Distribution Breakdown</span>
					<span id="group-balance-indicator" class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">Balanced sides</span>
				</div>
				<div id="chart-container" style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: var(--bg-paper); margin-bottom: 0.75rem;">
					<!-- Progress segments rendered via JS -->
				</div>
				<div id="chart-legend" style="display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.85rem; color: var(--fg-pencil);">
					<!-- Legend items rendered via JS -->
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Add Guest Form + Searchable Filterable List -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 360px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="guest-workspace-grid">
			
			<!-- Left Column: Add Guest Card -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.5rem; margin-bottom: 1.25rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>➕</span> Add New Guest
				</h2>

				<form id="guest-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Primary Guest Name -->
					<div>
						<label for="guest-name" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Guest Full Name *
						</label>
						<input type="text" id="guest-name" required placeholder="e.g., Sarah Jenkins" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1.05rem;">
					</div>

					<!-- Group Category -->
					<div>
						<label for="guest-group" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Guest Affiliation / Group
						</label>
						<select id="guest-group" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
							<option value="Bride's Family">Bride's Family</option>
							<option value="Groom's Family">Groom's Family</option>
							<option value="Bride's Friends">Bride's Friends</option>
							<option value="Groom's Friends">Groom's Friends</option>
							<option value="Mutual Friends">Mutual Friends</option>
							<option value="Wedding Party / VIP">Wedding Party / VIP</option>
							<option value="Coworkers">Coworkers</option>
						</select>
					</div>

					<!-- Party Size & Plus-One -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="guest-party" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Party Size
							</label>
							<select id="guest-party" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="1">1 (Solo)</option>
								<option value="2" selected>2 (Couple / +1)</option>
								<option value="3">3 (Family)</option>
								<option value="4">4 (Family of 4)</option>
								<option value="5">5+ (Large Family)</option>
							</select>
						</div>
						<div>
							<label for="guest-rsvp" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								RSVP Status
							</label>
							<select id="guest-rsvp" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 1.05rem;">
								<option value="Pending">⏳ Pending</option>
								<option value="Attending">✅ Attending</option>
								<option value="Declined">❌ Declined</option>
							</select>
						</div>
					</div>

					<!-- Dietary Restrictions -->
					<div>
						<label for="guest-dietary" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
							Dietary Restrictions / Allergies
						</label>
						<input type="text" id="guest-dietary" placeholder="e.g. Vegetarian, Gluten-Free, Nut Allergy" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						<!-- Quick Dietary Tags -->
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem;">
							<button type="button" class="diet-quick-btn" data-val="Vegetarian" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Vegetarian</button>
							<button type="button" class="diet-quick-btn" data-val="Vegan" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Vegan</button>
							<button type="button" class="diet-quick-btn" data-val="Gluten-Free" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Gluten-Free</button>
							<button type="button" class="diet-quick-btn" data-val="Nut Allergy" style="font-size: 0.75rem; padding: 0.15rem 0.4rem; border: 1px dashed var(--fg-pencil); background: #fff; border-radius: 3px; cursor: pointer;">+ Nut Allergy</button>
						</div>
					</div>

					<!-- Optional Table & Contact Notes -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="guest-table" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Table # (Optional)
							</label>
							<input type="text" id="guest-table" placeholder="e.g. Table 4" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						</div>
						<div>
							<label for="guest-email" class="font-heading" style="display: block; margin-bottom: 0.3rem; font-size: 1rem; color: var(--fg-pencil);">
								Email / Phone (Optional)
							</label>
							<input type="text" id="guest-email" placeholder="sarah@example.com" class="form-input" style="width: 100%; padding: 0.65rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: var(--bg-paper); font-family: var(--font-body); font-size: 1rem;">
						</div>
					</div>

					<button type="submit" class="hand-btn" style="width: 100%; padding: 0.85rem; font-size: 1.15rem; margin-top: 0.5rem;">
						✨ Add to Guest List
					</button>

				</form>
			</div>

			<!-- Right Column: Interactive Searchable Table & Filter Bar -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<!-- Filter Bar -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem;">
					
					<!-- Search Input -->
					<div style="flex: 1; min-width: 180px;">
						<input type="text" id="search-input" placeholder="🔍 Search guest by name, diet, or group..." class="form-input" style="width: 100%; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1rem;">
					</div>

					<!-- Group Filter -->
					<div>
						<select id="filter-group" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">All Groups</option>
							<option value="Bride's Family">Bride's Family</option>
							<option value="Groom's Family">Groom's Family</option>
							<option value="Bride's Friends">Bride's Friends</option>
							<option value="Groom's Friends">Groom's Friends</option>
							<option value="Mutual Friends">Mutual Friends</option>
							<option value="Wedding Party / VIP">Wedding Party / VIP</option>
							<option value="Coworkers">Coworkers</option>
						</select>
					</div>

					<!-- RSVP Filter -->
					<div>
						<select id="filter-rsvp" class="form-input" style="padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="all">All Statuses</option>
							<option value="Attending">Confirmed (Attending)</option>
							<option value="Pending">Awaiting (Pending)</option>
							<option value="Declined">Declined</option>
						</select>
					</div>
				</div>

				<!-- Guest List Table Container -->
				<div id="guest-list-table-wrap" style="overflow-x: auto; max-height: 550px;">
					<table id="guest-table-elem" style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 1rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil); position: sticky; top: 0; z-index: 1;">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Guest / Party</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Group</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">RSVP</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Dietary</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Table</th>
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Actions</th>
							</tr>
						</thead>
						<tbody id="guest-table-body">
							<!-- Populated via JS -->
						</tbody>
					</table>
				</div>

				<!-- Empty State Note -->
				<div id="empty-state-box" style="display: none; text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
					<div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💌</div>
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">Your Guest List is Empty</h3>
					<p class="font-body" style="font-size: 1.05rem; margin-bottom: 1.25rem;">Add your first guest above, or click "Load Sample" to explore how the CRM and exports work.</p>
					<button type="button" id="btn-empty-sample" class="hand-btn" style="padding: 0.5rem 1.25rem; font-size: 1rem;">
						➕ Load 8 Sample Guests
					</button>
				</div>

			</div>
		</div>

		<!-- Hidden Printable Sheet Container for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Master Guest List</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Total Seats: <span id="print-total-seats"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Guest Name</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Group</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">Party Size</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">RSVP</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Dietary Needs</th>
						<th style="border: 1px solid #ccc; padding: 6px; text-align: center;">Table #</th>
					</tr>
				</thead>
				<tbody id="print-table-body"></tbody>
			</table>
		</div>

		<!-- SEO Article & Comprehensive Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Wedding CRM Guide</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem;">
					The Complete Wedding Guest List Master Guide
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 700px; margin: 0.5rem auto 0;">
					Strategies for building, organizing, cutting, and exporting your wedding attendee list without family drama.
				</p>
			</div>

			<div style="margin-bottom: 2.5rem;">
				<img 
					src="/images/guest-list-clipboard.jpg" 
					alt="Hand drawn line art sketch of wedding guest list clipboard with pen and address notebook for organized event planning" 
					style="width: 100%; max-height: 420px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil);"
				/>
				<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin-top: 0.5rem; font-style: italic;">
					Organizing guests by affiliation and party size keeps catering and seating effortlessly aligned.
				</p>
			</div>

			<!-- Section 1: A-List vs B-List -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. The A-List & B-List Strategy (How to Invite Without Offending)
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1rem;">
					Nearly every wedding has venue capacity constraints or per-head budget caps. The dual-tier list strategy allows couples to maximize attendance without over-committing seats:
				</p>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin: 1.5rem 0;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-blue); margin-bottom: 0.5rem;">
							The "A-List" (Immediate Core)
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.5; margin: 0;">
							Immediate family, closest friends, and wedding party members. Invitations are mailed <strong>8 to 10 weeks</strong> before the wedding with an RSVP deadline of 4 to 5 weeks prior.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-red); margin-bottom: 0.5rem;">
							The "B-List" (Secondary Wave)
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.5; margin: 0;">
							Extended cousins, coworkers, and newer friends. As "declines" arrive from the A-List, B-List invitations are sent out immediately in discrete batches. Print separate RSVP cards with a later deadline so B-list guests never suspect!
						</p>
					</div>
				</div>
			</section>

			<!-- Section 2: Plus-One Etiquette -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. The Golden Rules of Plus-One Etiquette
				</h3>
				<ul class="font-body" style="padding-left: 1.5rem; line-height: 1.8; font-size: 1.05rem;">
					<li><strong>Married & Engaged:</strong> Always receive a named invitation for both partners as a social unit.</li>
					<li><strong>Cohabitating Couples:</strong> Couples living together should always receive a joint invitation, even if you haven't personally met the partner.</li>
					<li><strong>Wedding Party:</strong> Bridesmaids and Groomsmen should always be extended a plus-one as a thank you for their financial and emotional investment.</li>
					<li><strong>Truly Single Guests:</strong> If budget is tight, single guests do not need a plus-one—especially if they will know plenty of mutual friends at the reception.</li>
				</ul>
			</section>

			<!-- Section 3: Word & PDF Export Advantages -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					3. Why Exporting to Word & PDF Saves Weeks of Coordination
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1rem;">
					Caterers, wedding coordinators, and stationery calligraphers all demand guest information in different formats:
				</p>
				<div style="background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
					<ul class="font-body" style="padding-left: 1.2rem; line-height: 1.6; font-size: 1rem; margin: 0;">
						<li><strong>Microsoft Word (.doc):</strong> Ideal for sending to your wedding planner or venue coordinator who needs to paste dietary requirements directly into the banquet event order (BEO).</li>
						<li><strong>Printable PDF:</strong> Gives you a physical paper binder copy to hand to your day-of coordinator or ushers greeting guests at the ceremony entrance.</li>
						<li><strong>CSV / Excel:</strong> Perfect for mass-uploading recipient addresses into envelope addressing services or mail merge tools.</li>
					</ul>
				</div>
			</section>

			<!-- Section 4: Related Tools -->
			<section style="margin-bottom: 3rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.5rem;">
				<h3 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 1rem;">
					🔗 Integrated Wedding Workflow Tools
				</h3>
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
					<a href="/seating-chart-maker" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-blue); display: block;">Seating Chart Maker</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Visual drag-and-drop table planner synced with this guest list.</span>
					</a>
					<a href="/rsvp-tracker" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-red); display: block;">RSVP Tracker</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Track incoming response cards, meal selections, and headcounts.</span>
					</a>
					<a href="/table-place-cards" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--fg-pencil); display: block;">Table & Place Cards</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Generate printable place cards directly from your assigned guests.</span>
					</a>
					<a href="/guest-count-estimator" style="text-decoration: none; color: inherit; display: block; border: 1px solid var(--fg-pencil); padding: 0.75rem; border-radius: 4px; background: #fff;">
						<strong class="font-heading" style="color: var(--accent-blue); display: block;">Guest Count Estimator</strong>
						<span class="font-body" style="font-size: 0.9rem; color: var(--text-secondary);">Determine realistic guest capacity based on catering and venue budget.</span>
					</a>
				</div>
			</section>

			<!-- Section 5: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Frequently Asked Questions
				</h3>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						How do I export this guest list to Microsoft Word or PDF?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Simply click the <strong>"📝 Export Word (.doc)"</strong> button at the top right of the dashboard. Your browser will instantly generate and download an editable Word table formatted with all guest names, party sizes, groups, dietary notes, and tables. To export a PDF, click <strong>"🖨️ Export PDF / Print"</strong> and select "Save as PDF" in your print window.
					</p>
				</details>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						Is my wedding guest data saved securely?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Yes! All guest data is stored 100% locally in your browser's private storage (localStorage). We never transmit or store your personal guest names or contact addresses on any external servers, ensuring maximum privacy.
					</p>
				</details>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						How do I balance guest counts between the bride's and groom's families?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						A classic etiquette rule is splitting total capacity into thirds: 1/3 for the couple's mutual friends and VIPs, 1/3 for the bride's family, and 1/3 for the groom's family. Our live visual group distribution bar highlights exact percentages so neither side feels shortchanged.
					</p>
				</details>

				<details class="faq-accordion" style="margin-bottom: 1rem; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem; background: var(--bg-paper);">
					<summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; color: var(--accent-blue);">
						When is the absolute latest date to finalize the guest list?
					</summary>
					<p class="font-body" style="margin-top: 0.75rem; line-height: 1.6; padding-left: 1rem; border-left: 3px solid var(--accent-blue); font-size: 1.05rem;">
						Your final headcount must typically be submitted to your caterer and venue <strong>14 to 21 days before the wedding</strong>. This locks in meal preparations, staffing numbers, and final banquet invoicing.
					</p>
				</details>
			</section>

		</article>

	</main>
</Layout>

