---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/cake-pricing-calculator/#webapp",
      "name": "Wedding Cake Pricing & Cost Per Slice Calculator",
      "url": "https://manage.wedding/cake-pricing-calculator",
      "description": "Calculate custom wedding cake prices, price per slice, baker labor hours, ingredient costs, structural tier fees, and bakery profit margins. Includes sheet cake money-saving comparisons, cutting fee calculations, and printable client invoice quotes.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Price a Custom Wedding Cake for Profit and Budget Accuracy",
      "description": "Step-by-step mathematical framework for calculating cost per slice, baker labor wages, structural support hardware, design complexity markups, and healthy bakery profit margins.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Determine Total Servings and Tier Architecture",
          "text": "Input guest portion count and stacked tier diameters (e.g. 3 tiers: 6\", 8\", 10\" for 120 guests) to establish base structural scale and slice yield."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Itemize Direct Ingredients & Structural Supports",
          "text": "Calculate raw commodity costs (European butter, flour, eggs, Madagascar vanilla, fruit curds, fondant) plus structural hardware (Masonite base drums, internal food-grade poly-dowels, center stabilizing rods, and insulated transport bakery boxes)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Factor in Hands-On Baking, Chilling & Decorating Labor",
          "text": "Multiply total labor hours across all production phases (baking, leveling, torting, crumb coating, chilling, stacking, piping, and sugar flower crafting) by a professional living wage hourly rate ($30–$65/hr)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Apply Artistic Design Complexity Markup",
          "text": "Select a design complexity multiplier (1.1x for semi-naked rustic to 3.0x for handcrafted wafer paper or sugar floral artistry) to ensure sustainable bakery profit margins."
        },
        {
          "@type": "HowToStep",
          "name": "Step 5: Incorporate Refrigerated Delivery and On-Site Setup",
          "text": "Calculate round-trip transit mileage at $1.50–$2.50/mile plus an on-site final assembly and floral placement staging fee ($50–$100)."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the average cost of a wedding cake per slice in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In the United States, custom wedding cakes range from $5.00 to $8.50 per slice for buttercream designs and $8.50 to $15.00+ per slice for custom fondant, wafer paper textures, and handcrafted sugar floral artistry. Nationwide, the average wedding cake total ranges between $550 and $950 for 120 to 150 guests."
          }
        },
        {
          "@type": "Question",
          "name": "How does the 'Cutting Cake + Sheet Cake' strategy save money?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Couples order a small 2-tier display cake (30–40 servings) for ceremonial cake cutting photos, and serve undisplayed kitchen sheet cakes ($2.50–$3.50/slice from a bakery or $25 for 48 servings from Costco) from the catering kitchen. This strategy routinely saves $400 to $750 on a 150-person wedding without guests noticing any difference."
          }
        },
        {
          "@type": "Question",
          "name": "What is a venue cake cutting fee, and why do venues charge it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A cake cutting fee is a charge imposed by catering venues ($1.50 to $4.50 per guest slice) when you bring in a cake from an outside bakery. It covers the catering staff's labor to unbox, slice according to portion grids, plate, garnish, serve with dessert forks, and wash the fine china afterward."
          }
        },
        {
          "@type": "Question",
          "name": "How many cake slices do I need for 100, 150, or 200 guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because 10% to 20% of guests typically skip cake in favor of dancing, alcohol, or dessert tables, planners recommend ordering cake portions for 80% to 85% of your final guest count if a full meal is served, or 100% if cake is the sole dessert offered."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a wedding cake portion and a party portion?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An industry-standard wedding cake slice measures 1 inch wide by 2 inches deep by 4 to 5 inches tall (approx. 8 cubic inches). A standard birthday or party slice measures 2 inches wide by 2 inches deep by 4 inches tall (16 cubic inches), which is double the volume of a wedding portion."
          }
        },
        {
          "@type": "Question",
          "name": "Why is fondant significantly more expensive than buttercream?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fondant requires a double-labor process: the cake must first be coated in a flawless, razor-sharp ganache or stiff buttercream foundation, chilled thoroughly, and then covered in rolled sugar paste without tears or air pockets. This adds 3 to 6 additional hours of precision labor."
          }
        },
        {
          "@type": "Question",
          "name": "How much should bakers charge for wedding cake delivery and setup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard bakery delivery rates are $1.50 to $2.50 per round-trip mile plus a flat $50 to $100 on-site assembly and floral placement fee for tiered cakes requiring climate-controlled transit and on-site tier stacking."
          }
        },
        {
          "@type": "Question",
          "name": "What should a custom cake profit margin be for a professional bakery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A sustainable bakery net profit margin is 25% to 40% AFTER paying the baker a fair living hourly wage ($30–$50/hr). Treating hourly labor as 'profit' is the primary cause of home bakery insolvency."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Cake Pricing Calculator (Price Per Slice & Baker Profit)"
	description="Calculate custom wedding cake prices, price per slice, baker labor hours, ingredient costs, structural tier fees, and bakery profit margins. Includes sheet cake savings, cutting fees, and printable invoice quotes."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Cake Pricing Calculator" category="food-dining" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Cost Per Slice & Bakery Margins</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Wedding Cake <span class="accent-italic">Pricing Calculator</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 820px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calculate accurate wedding cake quotes, price per slice, ingredients, labor hours, design complexity markups, and delivery fees. Designed for independent bakers, cake artists, and couples planning dessert budgets.
			</p>
		</header>

		<!-- Editorial Guide Interlink Banner -->
		<div style="background: #fef3c7; border: 2px solid #d97706; border-radius: 8px; padding: 1rem 1.5rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; box-shadow: 2px 2px 0px #d97706;">
			<div style="display: flex; align-items: center; gap: 0.75rem;">
				<span style="font-size: 1.5rem;">🎂</span>
				<div>
					<strong style="color: #92400e; font-size: 0.95rem; display: block;">Looking for Exact Tier Dimensions and Slicing Diagrams?</strong>
					<span style="color: #78350f; font-size: 0.88rem;">Explore our companion guides on <a href="/cake-serving-calculator" style="color: #92400e; text-decoration: underline; font-weight: 700;">Tier Serving Sizer</a> and <a href="/wedding-cake-sizes-and-prices-tier-guide" style="color: #92400e; text-decoration: underline; font-weight: 700;">Cake Sizes & Sheet Cake Strategy</a>.</span>
				</div>
			</div>
			<a href="/sheet-cake-for-wedding-costco-hack" style="background: #b45309; color: #fff; text-decoration: none; font-weight: 700; font-size: 0.85rem; padding: 6px 14px; border-radius: 6px; border: 1px solid #78350f; white-space: nowrap;">
				Sheet Cake Guide &rarr;
			</a>
		</div>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Controls & Inputs -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Cake Specifications & Labor
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Live Costing
					</span>
				</div>

				<!-- Cake Design Archetype Presets -->
				<div class="form-group">
					<label class="form-label" for="cake-preset">Design Archetype Preset</label>
					<select id="cake-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="textured-buttercream" selected>🌸 Textured Buttercream & Fresh Flowers (Standard 1.4x)</option>
						<option value="semi-naked">🌿 Semi-Naked Rustic Cake (Simple 1.1x)</option>
						<option value="smooth-fondant">👑 Smooth Fondant & Monogram (Elaborate 1.8x)</option>
						<option value="sugar-art">💎 Intricate Sugar Florals & Gold Leaf (Luxury 2.5x)</option>
						<option value="cutting-sheet">🍰 Cutting Cake + Kitchen Sheet Cakes (Cost Saver 1.2x)</option>
						<option value="custom">✏️ Custom Settings</option>
					</select>
				</div>

				<!-- Servings & Tier Count -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="servings">Total Guest Servings</label>
						<input type="number" id="servings" class="form-input" value="120" min="10" max="600" step="5" style="font-size: 1.1rem; font-weight: 700;" />
					</div>
					<div>
						<label class="form-label" for="tiers">Stacked Tiers</label>
						<select id="tiers" class="form-input" style="cursor: pointer; font-weight: 700;">
							<option value="1">1 Tier (Cutting Cake)</option>
							<option value="2">2 Tiers (30–60 Servings)</option>
							<option value="3" selected>3 Tiers (80–140 Servings)</option>
							<option value="4">4 Tiers (150–220 Servings)</option>
							<option value="5">5 Tiers (240+ Servings)</option>
						</select>
					</div>
				</div>

				<!-- Ingredients & Structural Costs -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="ingredientCost">Raw Ingredients ($)</label>
						<input type="number" id="ingredientCost" class="form-input" value="85" min="10" max="2000" step="5" style="font-weight: 600;" />
						<span style="font-size: 0.78rem; color: #64748b;">Flour, butter, eggs, fillings</span>
					</div>
					<div>
						<label class="form-label" for="tierSupplyCost">Tier Hardware ($)</label>
						<input type="number" id="tierSupplyCost" class="form-input" value="45" min="0" max="500" step="5" style="font-weight: 600;" />
						<span style="font-size: 0.78rem; color: #64748b;">Boards, dowels, boxes</span>
					</div>
				</div>

				<!-- Labor Hours & Hourly Wage -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="laborHours">Hands-On Labor (Hours)</label>
						<input type="number" id="laborHours" class="form-input" value="10" min="1" max="100" step="0.5" style="font-weight: 700;" />
						<span style="font-size: 0.78rem; color: #64748b;">Bake, frost, stack, decorate</span>
					</div>
					<div>
						<label class="form-label" for="hourlyRate">Baker Hourly Wage ($/hr)</label>
						<input type="number" id="hourlyRate" class="form-input" value="35" min="15" max="150" step="5" style="font-weight: 700;" />
						<span style="font-size: 0.78rem; color: #64748b;">Living wage baseline</span>
					</div>
				</div>

				<!-- Design Complexity Markup Slider -->
				<div class="form-group" style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
						<label class="form-label" for="complexity" style="margin: 0;">
							Design & Artistic Markup Multiplier:
						</label>
						<span id="val-complexity" style="font-size: 1.05rem; font-weight: 800; color: var(--accent-red); background: #fef2f2; padding: 2px 8px; border-radius: 4px; border: 1px solid var(--accent-red);">
							1.4x
						</span>
					</div>
					<input type="range" id="complexity" min="1.0" max="3.0" step="0.1" value="1.4" style="width: 100%; cursor: pointer;" />
					<div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem;">
						<span>Simple Rustic (1.0x)</span>
						<span>Textured (1.5x)</span>
						<span>Intricate Sugar Art (3.0x)</span>
					</div>
				</div>

				<!-- Delivery & Setup Optional Checkbox -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.75rem;">
						<input type="checkbox" id="check-delivery" checked style="width: 18px; height: 18px;" />
						<span>Include Delivery & On-Site Setup Fee</span>
					</label>

					<div id="delivery-inputs" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; background: #f8fafc; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px;">
						<div>
							<label class="form-label" for="deliveryMiles" style="font-size: 0.85rem;">Roundtrip Miles</label>
							<input type="number" id="deliveryMiles" class="form-input" value="25" min="0" max="300" step="5" />
						</div>
						<div>
							<label class="form-label" for="setupFee" style="font-size: 0.85rem;">On-Site Setup Fee ($)</label>
							<input type="number" id="setupFee" class="form-input" value="50" min="0" max="300" step="10" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Results, Slices & Profit Breakdown -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Primary Results Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Recommended Cake Price Quote
						</span>
						<span id="tier-badge" style="font-size: 0.85rem; font-weight: 800; background: var(--accent-red); color: #fff; padding: 3px 8px; border-radius: 4px;">
							3 Tiers
						</span>
					</div>

					<div id="res-total-price" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						$749.00
					</div>
					
					<!-- Price Per Slice Hero Highlight -->
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
						<span style="font-size: 1.25rem; font-weight: 800; color: var(--accent-red); background: #fee2e2; border: 1.5px solid var(--accent-red); padding: 4px 10px; border-radius: 6px;">
							<span id="res-price-per-slice">$6.24</span> / slice
						</span>
						<span style="font-size: 0.92rem; color: var(--text-secondary);">
							for <strong id="res-servings-label" style="color: var(--fg-pencil);">120 guest servings</strong>
						</span>
					</div>

					<!-- Visual Cost Split Bar -->
					<h4 class="font-heading" style="font-size: 0.95rem; margin-bottom: 0.4rem; color: var(--fg-pencil);">
						Financial Breakdown Graph
					</h4>
					<div style="display: flex; height: 26px; border: 2px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; margin-bottom: 0.5rem; font-size: 0.78rem; font-weight: 800; color: #fff; text-align: center; line-height: 26px;">
						<div id="bar-materials" style="background-color: var(--accent-blue); width: 18%; transition: width 0.2s;" title="Materials">Materials</div>
						<div id="bar-labor" style="background-color: var(--fg-pencil); width: 48%; transition: width 0.2s;" title="Labor">Labor</div>
						<div id="bar-profit" style="background-color: var(--accent-red); width: 28%; transition: width 0.2s;" title="Profit">Profit</div>
						<div id="bar-delivery" style="background-color: #16a34a; width: 6%; transition: width 0.2s;" title="Delivery">Delivery</div>
					</div>

					<!-- Itemized Cost Breakdown Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin: 1.25rem 0;">
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>🍰 Raw Ingredients + Hardware:</span>
							<strong id="res-materials-total">$130.00</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>👩‍🍳 Baker Labor Wage (<span id="res-labor-hours-label">10 hrs @ $35/hr</span>):</span>
							<strong id="res-labor-total">$350.00</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>📈 Net Bakery Profit Margin (<span id="res-profit-margin-pct">29%</span>):</span>
							<strong id="res-profit-dollars" style="color: var(--accent-red);">$219.00</strong>
						</div>
						<div id="row-delivery-fee" style="display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.92rem; border-bottom: 1px dashed #e2e8f0;">
							<span>🚚 Delivery & On-Site Stacking:</span>
							<strong id="res-delivery-total">$87.50</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.5rem 0 0 0; font-size: 1.05rem; font-weight: 800; color: var(--fg-pencil);">
							<span>Total Client Invoice Amount:</span>
							<span id="res-invoice-total" style="color: var(--accent-red);">$836.50</span>
						</div>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-cake-quote" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Print Baker Quote (PDF)
						</button>
						<button id="btn-export-cake-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Word Invoice
						</button>
					</div>

				</div>

				<!-- Cutting Cake Strategy Callout -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						💡 The "Cutting Cake + Sheet Cake" Secret:
					</strong>
					<p style="margin: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						Save up to <strong>50% ($400–$750)</strong> by ordering a stunning 2-tier display cutting cake for photos (35 servings), and serving matching kitchen sheet cakes ($3.00/slice) from behind the scenes!
					</p>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Bottom Line Up Front (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Wedding Cake Pricing & Slice Cost Matrix
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Reference matrix comparing design styles, complexity markups, average price per slice, and typical cost for 100 to 150 guests.
				</p>
			</div>

			<!-- Formula Highlight Box -->
			<div style="background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; box-shadow: 2px 2px 0px 0px rgba(0,0,0,0.06);">
				<strong class="font-heading" style="font-size: 1.05rem; color: var(--accent-red); margin-bottom: 0.35rem; display: block; text-align: center;">
					📐 The Professional Cake Pricing Formula:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; color: var(--fg-pencil); margin: 0; line-height: 1.5; text-align: center; font-weight: 600;">
					Total Cake Price = [Ingredients + Structural Hardware + (Labor Hours × Hourly Wage)] × Design Markup Multiplier (1.1× – 3.0×) + Delivery Fee.
				</p>
			</div>

			<!-- Benchmark Table -->
			<div style="overflow-x: auto; background: #ffffff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.90rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
