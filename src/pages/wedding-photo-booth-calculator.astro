---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "DIY Wedding Photo Booth Calculator & Complete Studio Builder",
      "url": "https://manage.wedding/wedding-photo-booth-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Interactive calculator and complete engineering guide for DIY wedding photo booths. Calculate film packs, thermal print paper, PVC pipe cut sheets, arcade start buttons, backdrop clearance, and guestbook supplies.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Build a Portable DIY Wedding Photo Booth",
      "description": "Step-by-step engineering blueprint to construct a portable PVC photo booth with automated software, arcade start button, continuous AC power, and double-strip guestbook printing.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Select Software & 4-Screen Automated Flow",
          "text": "Use photo booth software (DSLR Remote Pro, DSLRBooth, Sparkbooth, or LumaBooth) with automated Start, 3-2-1 Countdown, Smile, and Processing screens."
        },
        {
          "@type": "HowToStep",
          "name": "Install the Big Red Illuminated Arcade Start Button",
          "text": "Wire a 4-inch illuminated arcade push button via USB arcade encoder so guests never touch keyboards or mice."
        },
        {
          "@type": "HowToStep",
          "name": "Assemble the Portable 3/4-inch PVC Frame",
          "text": "Construct a 6 ft tall by 40-inch wide portable PVC pipe frame using furniture-grade 3-way and 4-way corner joints that breaks down into a single duffel bag."
        },
        {
          "@type": "HowToStep",
          "name": "Configure Continuous Camera AC Power & Perforated Paper",
          "text": "Connect a DSLR dummy battery AC adapter to avoid mid-wedding battery swaps, and use pre-perforated 4x6 paper for instant 2x6 strip tearing."
        },
        {
          "@type": "HowToStep",
          "name": "Set Up the Dual-Display Live Feed and Guestbook Station",
          "text": "Place an external monitor outside the booth for waiting guests and equip the scrapbook table with double-sided tape runners and metallic gel pens."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does it cost to build a DIY wedding photo booth vs renting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Building a DIY iPad or DSLR photo booth costs between $180 and $350 in materials (software license, PVC frame, fabric panels, arcade button, props, and guestbook supplies). Professional photo booth rentals cost $900 to $1,600, saving couples $600 to $1,200+ while allowing you to keep or resell the hardware."
          }
        },
        {
          "@type": "Question",
          "name": "Why use an arcade button instead of a mouse or touchscreen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At wedding receptions, guests holding drinks or wearing gloves struggle with small touchscreens or mice. A giant 4-inch illuminated arcade push button creates a foolproof, tactile experience that anyone can hit to trigger the automated 4-photo sequence."
          }
        },
        {
          "@type": "Question",
          "name": "How do you solve the photo cutting problem for the guestbook?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Rather than leaving dangerous scissors on the guestbook table, purchase pre-perforated 4x6 photo paper or configure your dye-sub printer (like the Canon Selphy or DNP) to automatically score or cut double 2x6 strips. Guests simply snap the print in half: one for them, one for your album."
          }
        },
        {
          "@type": "Question",
          "name": "Why is a camera AC wall adapter mandatory?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "DSLR cameras running in continuous live-view mode drain standard camera batteries in 60 to 90 minutes. Swapping batteries requires opening the booth enclosure and re-aligning the camera angle. A dummy battery DC coupler wall adapter guarantees uninterrupted power all night."
          }
        }
      ]
    }
  ]
};
---

<Layout
	title="DIY Wedding Photo Booth Calculator & Builder Guide — Plans, Film & Blueprint"
	description="Complete DIY wedding photo booth calculator and build guide. Calculate film packs, thermal print rolls, PVC frame cut lists, arcade start buttons, and floor clearance."
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/budget" style="color: var(--text-secondary); text-decoration: none;">Budget & Entertainment</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Photo Booth Calculator & Guide</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>📸</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Interactive Calculator + Complete DIY Engineering Guide</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				DIY Wedding Photo Booth Calculator & Studio Guide
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 840px; margin: 0 auto; line-height: 1.5;">
				Calculate <strong>film cartridges, thermal paper rolls, PVC frame cut sheets, guestbook kits</strong>, and follow our step-by-step blueprint to build an automated, portable wedding booth for under $300.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Interactive Controls -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				
				<!-- Section 1: Hardware & Build Style -->
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>🛠️</span> 1. Booth Architecture & Print Media
				</h2>

				<div style="margin-bottom: 1.25rem;">
					<label for="select-booth-architecture" style="display: block; font-size: 0.85rem; font-weight: 700; color: #334155; margin-bottom: 0.35rem;">Booth Build Style:</label>
					<select id="select-booth-architecture" style="width: 100%; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 6px; font-size: 0.88rem; background: #fff; font-weight: 600;">
						<option value="pvc-enclosed" selected>🎪 Portable Enclosed PVC Booth (Arcade Button + Curtains + Internal Monitor)</option>
						<option value="open-air-ipad">📱 Open-Air iPad Ring Light Kiosk (Touchscreen + Canon Selphy)</option>
						<option value="dslr-studio">📷 Open-Air DSLR Studio Kiosk (Reflex Camera + Studio Flash + Laptop)</option>
						<option value="instax-vintage">🎞️ Vintage Instant Film Station (Fujifilm Instax / Polaroid Tabletop)</option>
						<option value="pro-rental">🎩 Full-Service Commercial Rental (Attendant + Pro Sublimation)</option>
					</select>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="select-media-format" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Print / Film Format:</label>
						<select id="select-media-format" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="canon-selphy" selected>🖨️ Canon Selphy 4x6" / 2x6" Strips</option>
							<option value="instax-mini">📷 Instax Mini (Credit-Card)</option>
							<option value="instax-wide">📸 Instax WIDE (Panoramics)</option>
							<option value="polaroid-itype">🎞️ Polaroid Square (i-Type/600)</option>
							<option value="dnp-pro">⚡ DNP Dye-Sub (700 prints/roll)</option>
							<option value="digital-only">📲 100% Digital (AirDrop/QR)</option>
						</select>
					</div>
					<div>
						<label for="input-booth-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Total Wedding Guests:</label>
						<input type="number" id="input-booth-guests" min="20" max="600" value="125" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700; font-size: 1rem;" />
					</div>
				</div>

				<!-- Section 2: Engagement & Guestbook Mode -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					📖 2. Guest Engagement & Scrapbook Duplication
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label for="select-participation-rate" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Guest Participation:</label>
						<select id="select-participation-rate" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="0.60">Intimate / Low Key (60%)</option>
							<option value="0.75" selected>Standard Wedding (75%)</option>
							<option value="0.90">Party Crowd / High Energy (90%)</option>
						</select>
					</div>
					<div>
						<label for="select-guestbook-mode" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Photo Guestbook Scrapbook?</label>
						<select id="select-guestbook-mode" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="double" selected>Yes (Double prints: 1 for guest + 1 for album)</option>
							<option value="single">No (Single print for guests to keep)</option>
							<option value="triple">Group Reprint (1 for each guest in group)</option>
						</select>
					</div>
				</div>

				<div style="margin-bottom: 1.25rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.2rem;">
						<label for="range-waste-buffer" style="font-size: 0.82rem; font-weight: 700; color: #334155;">Test Shots & Misprint Buffer:</label>
						<span id="label-waste-buffer" style="font-size: 0.82rem; font-weight: 700; color: #b91c1c;">+15% Buffer</span>
					</div>
					<input type="range" id="range-waste-buffer" min="5" max="30" step="5" value="15" style="width: 100%; accent-color: var(--accent-red);" />
					<span style="font-size: 0.72rem; color: #64748b;">Covers camera angle calibration, test runs, and paper reloads.</span>
				</div>

				<!-- Section 3: Trigger & Accessories -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🔘 3. Start Trigger & Props Setup
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label for="select-trigger-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Start Trigger:</label>
						<select id="select-trigger-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="arcade-button" selected>🔴 4" Glowing Red Arcade Button (USB)</option>
							<option value="touchscreen">📱 Touchscreen Tap (iPad Kiosk)</option>
							<option value="foot-pedal">🦶 Foot Switch Pedal</option>
							<option value="camera-shutter">📸 Manual Camera Shutter / Timer</option>
						</select>
					</div>
					<div>
						<label for="select-props-tier" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Props Variety Pack:</label>
						<select id="select-props-tier" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="standard" selected>Classic Pack (45 signs, glasses, hats)</option>
							<option value="deluxe">Deluxe VIP (70 PVC signs, boas, LED shades)</option>
							<option value="minimal">Minimal / Classy (20 real sunglasses & dry-erase boards)</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Results & Supply Breakdown -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Calculated Bill of Materials</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Photo Supplies & Cost
						</h2>
					</div>
					<span id="badge-total-prints" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">215 Exposures</span>
				</div>

				<!-- Highlight Hero Cards -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Film / Print Media</span>
						<strong id="stat-film-packs" style="font-size: 1.65rem; font-weight: 900; color: #b91c1c; line-height: 1.15;">2 Media Boxes</strong>
						<span id="stat-film-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 3px;">(216 pre-perforated 4x6" strips)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Estimated Total Cost</span>
						<strong id="stat-total-cost" style="font-size: 1.65rem; font-weight: 900; color: #1e40af; line-height: 1.15;">$275 DIY</strong>
						<span id="stat-cost-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 3px;">(Saves $675 vs Rental)</span>
					</div>
				</div>

				<!-- Itemized Shopping Breakdown -->
				<div style="background: #f0fdf4; border: 1.5px solid #16a34a; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #166534; display: block; margin-bottom: 0.4rem;">📦 Complete Hardware & Equipment Order:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem; color: #14532d;">
						<div>• <strong id="stat-camera-spec">Canon DSLR + AC Wall Adapter</strong></div>
						<div>• <strong id="stat-trigger-spec">4" Glowing Red Arcade Button (USB)</strong></div>
						<div>• <strong id="stat-frame-spec">PVC Pipe Frame (Breaks into duffel bag)</strong></div>
						<div>• <strong id="stat-guestbook-spec">1 Scrapbook + 540 Tape Dots</strong></div>
						<div>• <strong id="stat-pens-spec">6 Quick-Dry Metallic Gel Pens</strong></div>
						<div>• <strong id="stat-props-spec">45 Themed Props & Sign Sticks</strong></div>
					</div>
				</div>

				<!-- Venue Clearance & Power -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">📐 Venue Space Footprint:</span>
						<strong id="stat-space-req" style="color: var(--fg-pencil);">6 x 3.5 ft Enclosed (or 10x10 ft Open)</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">⚡ Electrical & Cords:</span>
						<strong id="stat-power-req" style="color: var(--fg-pencil);">1 x 15A Outlet + Gaffer Tape</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">💻 Software License:</span>
						<strong id="stat-software-req" style="color: #1e40af;">DSLR Remote Pro / DSLRBooth / LumaBooth</strong>
					</div>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.65rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Print Master Cut Sheet & Table Sign (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.65rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Export Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Interactive Floor Plan & Space Clearance Diagram -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<div>
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						📐 Interactive Layout Blueprint & Blueprint Diagrams
					</h2>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0.2rem 0 0;">
						Switch between the <strong>Enclosed Portable PVC Booth</strong> and <strong>Open-Air Studio Kiosk</strong> layout blueprints.
					</p>
				</div>
				<div style="display: inline-flex; gap: 0.5rem;">
					<button type="button" id="btn-tab-pvc" class="hand-btn" style="background: var(--post-it); border: 2px solid var(--fg-pencil); padding: 4px 12px; border-radius: 4px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">
						🎪 Enclosed PVC Booth (6' x 40")
					</button>
					<button type="button" id="btn-tab-openair" class="hand-btn" style="background: #fff; border: 2px solid var(--fg-pencil); padding: 4px 12px; border-radius: 4px; font-size: 0.82rem; font-weight: 700; cursor: pointer;">
						📸 Open-Air Studio (10' x 10')
					</button>
				</div>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; align-items: center;">
				
				<!-- SVG Diagram Container -->
				<div id="svg-diagram-container" style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; text-align: center;">
					
					<!-- Blueprint 1: Enclosed PVC Booth (Default) -->
					<svg id="svg-pvc-blueprint" viewBox="0 0 540 400" style="width: 100%; max-width: 500px; height: auto; display: block; margin: 0 auto;">
						<!-- Card Background -->
						<rect x="0" y="0" width="540" height="400" fill="#f8fafc" rx="8" />
						
						<!-- Top Dimension Header Badge -->
						<rect x="70" y="12" width="400" height="26" fill="#0f172a" rx="4" />
						<text x="270" y="29" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle" letter-spacing="0.5">🎪 PORTABLE PVC BOOTH: 6 FT HIGH × 40" WIDE × 48" DEEP</text>

						<!-- Outer Booth PVC Enclosure Frame -->
						<rect x="25" y="48" width="490" height="335" fill="#ffffff" stroke="#1e293b" stroke-width="2.5" rx="8" />

						<!-- COMPARTMENT 1: Electronics & Equipment Tower -->
						<rect x="38" y="60" width="464" height="150" fill="#f0fdf4" stroke="#16a34a" stroke-width="1.5" stroke-dasharray="4 4" rx="6" />
						
						<!-- Section Label Pill -->
						<rect x="48" y="68" width="220" height="20" fill="#dcfce7" stroke="#16a34a" stroke-width="1" rx="3" />
						<text x="56" y="82" font-size="10" font-weight="bold" fill="#15803d">⚙️ ELECTRONICS TOWER (18" DEPTH)</text>

						<!-- Big Red Arcade Start Button (Left) -->
						<g transform="translate(90, 130)">
							<circle cx="0" cy="0" r="22" fill="#fee2e2" stroke="#dc2626" stroke-width="1.5" />
							<circle cx="0" cy="0" r="16" fill="#ef4444" stroke="#991b1b" stroke-width="2" />
							<text x="0" y="4" font-size="9" font-weight="bold" fill="#ffffff" text-anchor="middle">PUSH</text>
							<text x="0" y="32" font-size="9" font-weight="bold" fill="#b91c1c" text-anchor="middle">4" Arcade Button</text>
							<text x="0" y="44" font-size="7.5" fill="#64748b" text-anchor="middle">(USB Spacebar)</text>
						</g>

						<!-- Center Display & Camera Bezel (Middle) -->
						<g transform="translate(270, 100)">
							<!-- Bezel Frame -->
							<rect x="-85" y="-5" width="170" height="68" fill="#0f172a" rx="4" />
							<!-- 17" Screen Glass -->
							<rect x="-78" y="2" width="156" height="54" fill="#1e293b" rx="2" />
