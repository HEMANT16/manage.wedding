<script is:inline>
	// Form Inputs
	const selectFloralStyle = document.getElementById('select-floral-style');
	const inputBridalBouquet = document.getElementById('input-bridal-bouquet');
	const inputBridesmaidBouquets = document.getElementById('input-bridesmaid-bouquets');
	const inputBoutonnieres = document.getElementById('input-boutonnieres');
	const inputCorsages = document.getElementById('input-corsages');
	const inputCenterpiecesLow = document.getElementById('input-centerpieces-low');
	const inputBudVases = document.getElementById('input-bud-vases');
	const selectArchInstall = document.getElementById('select-arch-install');
	const inputCakeBarFlorals = document.getElementById('input-cake-bar-florals');
	const selectBufferMargin = document.getElementById('select-buffer-margin');

	// Result Elements
	const badgeTotalBunches = document.getElementById('badge-total-bunches');
	const statTotalStems = document.getElementById('stat-total-stems');
	const statStemsBufferSub = document.getElementById('stat-stems-buffer-sub');
	const statTotalFlowerCost = document.getElementById('stat-total-flower-cost');
	const statFocalStems = document.getElementById('stat-focal-stems');
	const statSecondaryStems = document.getElementById('stat-secondary-stems');
	const statFillerStems = document.getElementById('stat-filler-stems');
	const statGreeneryStems = document.getElementById('stat-greenery-stems');
	const statPrepHardware = document.getElementById('stat-prep-hardware');

	function calculateFlorals() {
		const style = selectFloralStyle.value;
		let mult = 1.0;
		if (style === 'wildflower') mult = 0.75;
		else if (style === 'luxury') mult = 1.5;

		const bridal = (parseInt(inputBridalBouquet.value, 10) || 0) * (32 * mult);
		const bridesmaids = (parseInt(inputBridesmaidBouquets.value, 10) || 0) * (18 * mult);
		const bouts = (parseInt(inputBoutonnieres.value, 10) || 0) * 3;
		const corsages = (parseInt(inputCorsages.value, 10) || 0) * 4;
		const centerpieces = (parseInt(inputCenterpiecesLow.value, 10) || 0) * (24 * mult);
		const budVases = (parseInt(inputBudVases.value, 10) || 0) * 3;
		const cakeBar = (parseInt(inputCakeBarFlorals.value, 10) || 0) * 2;

		let archStems = 0;
		const archType = selectArchInstall.value;
		if (archType === 'corner') archStems = 70 * mult;
		else if (archType === 'lush') archStems = 140 * mult;
		else if (archType === 'grand') archStems = 240 * mult;

		const rawStemCount = Math.round(bridal + bridesmaids + bouts + corsages + centerpieces + budVases + cakeBar + archStems);
		const bufferFactor = parseFloat(selectBufferMargin.value) || 1.15;
		const totalWithBuffer = Math.round(rawStemCount * bufferFactor);
		const bufferStems = totalWithBuffer - rawStemCount;

		statTotalStems.textContent = totalWithBuffer;
		statStemsBufferSub.textContent = `(${rawStemCount} exact + ${bufferStems} safety buffer)`;

		// Stem Category Breakdown (35% Focal, 30% Secondary, 15% Filler, 20% Greens)
		const focalStems = Math.round(totalWithBuffer * 0.35);
		const secondaryStems = Math.round(totalWithBuffer * 0.30);
		const fillerStems = Math.round(totalWithBuffer * 0.15);
		const greeneryStems = Math.round(totalWithBuffer * 0.20);

		// Bunch estimations
		const focalBunches = Math.ceil(focalStems / 25); // Roses usually 25/bunch
		const secondaryBunches = Math.ceil(secondaryStems / 10); // 10/bunch
		const fillerBunches = Math.ceil(fillerStems / 10); // 10/bunch
		const greeneryBunches = Math.ceil(greeneryStems / 10); // 10 stems/bunch

		const totalBunches = focalBunches + secondaryBunches + fillerBunches + greeneryBunches;
		badgeTotalBunches.textContent = `${totalBunches} Wholesale Bunches`;

		statFocalStems.innerHTML = `${focalStems} stems <em>(~${focalBunches} bunches @ 25/pk)</em>`;
		statSecondaryStems.innerHTML = `${secondaryStems} stems <em>(~${secondaryBunches} bunches @ 10/pk)</em>`;
		statFillerStems.innerHTML = `${fillerStems} stems <em>(~${fillerBunches} bunches @ 10/pk)</em>`;
		statGreeneryStems.innerHTML = `${greeneryStems} stems <em>(~${greeneryBunches} bunches @ 10/pk)</em>`;

		// Estimated Wholesale Cost ($1.50/stem avg across wholesale suppliers)
		const estimatedCost = Math.round(totalWithBuffer * 1.50);
		statTotalFlowerCost.textContent = `$${estimatedCost.toLocaleString('en-US')}`;

		// Buckets & Hardware
		const bucketsCount = Math.max(4, Math.ceil(totalWithBuffer / 32));
		statPrepHardware.innerHTML = `Requires <strong>${bucketsCount} Five-Gallon Buckets</strong>, 1 bottle of quick-dip hydration, and delivery on <strong>Wednesday morning</strong>.`;

		// Print Table Generation
		document.getElementById('print-floral-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Flower Recipe Classification</th>
						<th style="padding:6pt; text-align:center;">Total Stems</th>
						<th style="padding:6pt; text-align:center;">Wholesale Bunches</th>
						<th style="padding:6pt;">Recommended Flower Varieties</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">🌹 Focal Blooms (35%)</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#1e40af;">${focalStems} stems</td>
						<td style="padding:6pt; text-align:center;">~${focalBunches} bunches (25/pk)</td>
						<td style="padding:6pt;">Standard Roses, Garden Roses, Dahlias, Peonies, Hydrangeas</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">🌸 Secondary Flowers (30%)</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#c026d3;">${secondaryStems} stems</td>
						<td style="padding:6pt; text-align:center;">~${secondaryBunches} bunches (10/pk)</td>
						<td style="padding:6pt;">Ranunculus, Lisianthus, Spray Roses, Carnations, Anemones</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">🌾 Texture & Fillers (15%)</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#d97706;">${fillerStems} stems</td>
						<td style="padding:6pt; text-align:center;">~${fillerBunches} bunches (10/pk)</td>
						<td style="padding:6pt;">Waxflower, Astilbe, Veronica, Baby's Breath, Blue Thistle</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">🌿 Greenery & Foliage (20%)</td>
						<td style="padding:6pt; text-align:center; font-weight:bold; color:#15803d;">${greeneryStems} stems</td>
						<td style="padding:6pt; text-align:center;">~${greeneryBunches} bunches (10/pk)</td>
						<td style="padding:6pt;">Silver Dollar Eucalyptus, Italian Ruscus, Salal Tips, Olive Greens</td>
					</tr>
					<tr style="background:#f8fafc; font-weight:bold;">
						<td style="padding:8pt;">TOTAL PROCUREMENT:</td>
						<td style="padding:8pt; text-align:center; font-size:12pt; color:#1e40af;">${totalWithBuffer} stems</td>
						<td style="padding:8pt; text-align:center; font-size:12pt; color:#15803d;">${totalBunches} Bunches</td>
						<td style="padding:8pt;">Estimated Wholesale Cost: ~$${estimatedCost.toLocaleString('en-US')} (Prep: ${bucketsCount} buckets)</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	// Listeners
	const allInputs = [
		selectFloralStyle, inputBridalBouquet, inputBridesmaidBouquets,
		inputBoutonnieres, inputCorsages, inputCenterpiecesLow,
		inputBudVases, selectArchInstall, inputCakeBarFlorals, selectBufferMargin
	];
	allInputs.forEach(input => {
		input.addEventListener('input', calculateFlorals);
		input.addEventListener('change', calculateFlorals);
	});

	// Direct In-Page Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		calculateFlorals();
		window.print();
	});

	// Word Document Export
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateFlorals();
		const totalStems = statTotalStems.textContent;
		const totalCost = statTotalFlowerCost.textContent;
		const bunches = badgeTotalBunches.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>DIY Wedding Flowers Order Brief</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Wholesale Bulk Wedding Flowers Order Brief</h1>
				<p><strong>Total Stems to Buy:</strong> ${totalStems} stems | <strong>Wholesale Bunches:</strong> ${bunches} | <strong>Estimated Cost:</strong> ${totalCost}</p>
				<hr/>
				<h2>Stem Count Breakdown</h2>
				<table>
					<tr style="background:#f1f5f9;">
						<th>Botanical Role</th><th>Stem Count</th><th>Common Varieties</th>
					</tr>
					<tr><td><strong>Focal Blooms (35%):</strong></td><td>${statFocalStems.textContent}</td><td>Garden Roses, Standard Roses, Dahlias, Peonies</td></tr>
					<tr><td><strong>Secondary (30%):</strong></td><td>${statSecondaryStems.textContent}</td><td>Ranunculus, Lisianthus, Spray Roses, Carnations</td></tr>
					<tr><td><strong>Fillers (15%):</strong></td><td>${statFillerStems.textContent}</td><td>Waxflower, Astilbe, Veronica, Thistle</td></tr>
					<tr><td><strong>Greenery (20%):</strong></td><td>${statGreeneryStems.textContent}</td><td>Silver Dollar Eucalyptus, Italian Ruscus, Salal</td></tr>
				</table>
				<br/>
				<h2>Delivery & Conditioning Reminders</h2>
				<p>• Schedule delivery for Wednesday morning (for a Saturday wedding).</p>
				<p>• Strip foliage below waterline and hydrate for 24 hours in clean buckets with flower food.</p>
				<hr/>
				<p><em>Generated by Manage.Wedding DIY Flowers Sizer</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `DIY-Wedding-Flowers-Order-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateFlorals();
</script>
