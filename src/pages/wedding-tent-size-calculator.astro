---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Wedding Tent Size, Dance Floor & Generator Calculator",
      "url": "https://manage.wedding/wedding-tent-size-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calculate exact wedding tent square footage, frame vs pole tent dimensions, dance floor size, and generator power kW for outdoor weddings.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate the Right Wedding Tent Size",
      "description": "A comprehensive formula to determine total square footage for guest seating, dance floor, staging, buffet lines, and tent generator sizing.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Calculate Base Seating Square Footage",
          "text": "Allocate 12 to 15 square feet per guest for round banquet tables, or 10 to 12 square feet for rectangular family-style tables."
        },
        {
          "@type": "HowToStep",
          "name": "Add Dance Floor & Stage Dimensions",
          "text": "Add 4.5 square feet per expected dancer (approx. 50% of guests) and 150 to 250 square feet for a DJ booth or live band stage."
        },
        {
          "@type": "HowToStep",
          "name": "Include Buffets & Bar Space",
          "text": "Add 100 square feet per double-sided buffet line and 60 square feet per cocktail bar station."
        },
        {
          "@type": "HowToStep",
          "name": "Match with Standard Tent Sizes",
          "text": "Select from industry-standard frame or pole tent dimensions (e.g. 40x60, 40x80, 40x100) and calculate generator wattage requirements."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What size tent do I need for 100 wedding guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For 100 guests with round tables, a dance floor, a DJ booth, and a bar, you need approximately 1,800 to 2,000 square feet of tent space. A 40 x 50 ft or 30 x 70 ft tent is the standard recommendation."
          }
        },
        {
          "@type": "Question",
          "name": "What size tent is required for 150 wedding guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For 150 guests with seated dinner, a 16x16 ft dance floor, DJ/band, buffet, and bar, you need roughly 2,600 to 3,000 square feet. A 40 x 70 ft, 40 x 80 ft, or 30 x 90 ft tent fits this layout comfortably."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a Frame Tent and a Pole Tent?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pole tents have high sweeping peaks supported by center poles and must be staked into grass or dirt. Frame tents have no center poles (leaving 100% unobstructed interior space) and can be weighted on concrete, asphalt, patios, or grass."
          }
        },
        {
          "@type": "Question",
          "name": "What size generator do I need for a wedding tent?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most 100-to-200 person outdoor tent weddings require a 25kW to 45kW whisper-quiet diesel generator to safely power catering hot boxes, DJ/band sound systems, bistro string lights, and luxury restroom trailers."
          }
        }
      ]
    }
  ]
};
---

<Layout
	title="Wedding Tent Size Calculator — Square Footage & Floor Sizer"
	description="Calculate exact tent dimensions, square footage per guest, dance floor size, frame vs pole tent selection, and generator kW for outdoor weddings."
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/budget" style="color: var(--text-secondary); text-decoration: none;">Venue & Rentals</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Tent Size Calculator</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🎪</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Outdoor Venue Layout & Power Sizer</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Wedding Tent Size & Layout Calculator
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Calculate <strong>total tent square footage</strong>, determine standard tent dimensions (40x60, 40x80, etc.), size your dance floor and stage, and calculate <strong>generator power requirements</strong>.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Inputs -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>👥</span> 1. Guest Count & Seating Style
				</h2>

				<!-- Headcount & Style Grid -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-tent-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Total Wedding Guests:</label>
						<input type="number" id="input-tent-guests" min="20" max="500" value="130" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="select-seating-style" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Dinner Seating Style:</label>
						<select id="select-seating-style" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="round" selected>⚪ 60"/72" Round Tables (14 sq ft/guest)</option>
							<option value="rect">📏 Rectangular Banquet (11 sq ft/guest)</option>
							<option value="cocktail">🍸 Cocktail / Lounge (8 sq ft/guest)</option>
							<option value="ceremony">⛪ Cathedral Row Seating (7 sq ft/guest)</option>
						</select>
					</div>
				</div>

				<!-- Entertainment & Dance Floor -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					💃 2. Dance Floor & Entertainment
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label for="select-music-setup" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Music / Audio Setup:</label>
						<select id="select-music-setup" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="dj" selected>🎧 DJ Booth (100 sq ft)</option>
							<option value="band-small">🎸 4-Piece Band Stage (200 sq ft)</option>
							<option value="band-large">🎷 7-9 Piece Band Stage (350 sq ft)</option>
							<option value="none">🔇 Background Playlist (0 sq ft)</option>
						</select>
					</div>
					<div>
						<label for="select-dance-ratio" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Dance Floor Size:</label>
						<select id="select-dance-ratio" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="0.5" selected>Standard (~50% crowd on floor)</option>
							<option value="0.7">Heavy Dance Party (~70% crowd)</option>
							<option value="0">No Dance Floor (Dinner only)</option>
						</select>
					</div>
				</div>

				<!-- Buffets, Bars & Specialty Space -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🍹 3. Catering Stations, Bars & Extras
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="input-buffet-stations" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Buffet / Food Stations:</label>
						<input type="number" id="input-buffet-stations" min="0" max="6" value="2" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="input-bar-stations" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Bar Service Stations:</label>
						<input type="number" id="input-bar-stations" min="0" max="6" value="2" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0.75rem;">
					<div>
						<label for="select-tent-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Tent Construction:</label>
						<select id="select-tent-type" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="frame" selected>🏛️ Frame Tent (No center poles, concrete/grass)</option>
							<option value="pole">⛺ Pole Tent (High swooping peaks, grass/staking)</option>
							<option value="sailcloth">⛵ Sailcloth Tent (Translucent canopy, wood poles)</option>
						</select>
					</div>
					<div>
						<label for="select-flooring-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Flooring Option:</label>
						<select id="select-flooring-type" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="dance-only" selected>Wood Dance Floor Only</option>
							<option value="full-turf">Full Tent Turf / Carpet</option>
							<option value="full-hardwood">Full Hardwood Subflooring</option>
						</select>
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Tent Specification</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Recommended Tent Size
						</h2>
					</div>
					<span id="badge-tent-sqft" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">2,450 sq ft</span>
				</div>

				<!-- Big Number Highlights -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Primary Tent Dimensions</span>
						<strong id="stat-tent-dimension" style="font-size: 1.9rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">40 x 70 ft</strong>
						<span id="stat-tent-alt" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(or 30 x 90 ft)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Dance Floor Size</span>
						<strong id="stat-dance-size" style="font-size: 1.9rem; font-weight: 900; color: #1e40af; line-height: 1.1;">16 x 20 ft</strong>
						<span id="stat-dance-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">320 sq ft (for 65 dancers)</span>
					</div>
				</div>

				<!-- Power & Equipment Box -->
				<div style="background: #eff6ff; border: 1.5px solid #1e40af; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #1e40af; display: block; margin-bottom: 0.35rem;">⚡ Power & Generator Recommendation:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #1e3a8a;">
						<div>• <strong id="stat-generator-kw">25 kW Generator</strong> (Whisper quiet)</div>
						<div>• <strong id="stat-lighting-strands">400 ft</strong> Bistro String Lights</div>
						<div>• <strong id="stat-power-circuits">6 x 20A</strong> Dedicated Circuits</div>
						<div>• <strong id="stat-side-walls">220 ft</strong> Perimeter Sidewalls</div>
					</div>
				</div>

				<!-- Space Breakdown Box -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🪑 Guest Seating Space:</span>
						<strong id="stat-space-seating" style="color: var(--fg-pencil);">1,820 sq ft</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">💃 Dance Floor Space:</span>
						<strong id="stat-space-dance" style="color: var(--fg-pencil);">320 sq ft</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🎧 Stage & Audio:</span>
						<strong id="stat-space-stage" style="color: var(--fg-pencil);">100 sq ft</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">🍸 Buffets & Bars:</span>
						<strong id="stat-space-buffet" style="color: var(--fg-pencil);">320 sq ft</strong>
					</div>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Print Tent Plan (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Export Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Sizing Reference Table -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem;">
				📋 Standard Wedding Tent Sizes & Capacities Reference
			</h2>
			
			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
					<thead>
						<tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.6rem; color: var(--fg-pencil);">Tent Dimension</th>
							<th style="padding: 0.6rem; color: var(--fg-pencil);">Total Area</th>
							<th style="padding: 0.6rem; color: var(--fg-pencil);">Seated Dinner + Dance Floor</th>
							<th style="padding: 0.6rem; color: var(--fg-pencil);">Cocktail Reception</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem; font-weight: 700;">30 x 60 ft</td>
							<td style="padding: 0.6rem;">1,800 sq ft</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">80 – 100 Guests</td>
							<td style="padding: 0.6rem;">180 Guests</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem; font-weight: 700;">40 x 60 ft</td>
							<td style="padding: 0.6rem;">2,400 sq ft</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">110 – 130 Guests</td>
							<td style="padding: 0.6rem;">240 Guests</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem; font-weight: 700;">40 x 80 ft</td>
							<td style="padding: 0.6rem;">3,200 sq ft</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">150 – 180 Guests</td>
							<td style="padding: 0.6rem;">320 Guests</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem; font-weight: 700;">40 x 100 ft</td>
							<td style="padding: 0.6rem;">4,000 sq ft</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">200 – 240 Guests</td>
							<td style="padding: 0.6rem;">400 Guests</td>
						</tr>
						<tr>
							<td style="padding: 0.6rem; font-weight: 700;">60 x 90 ft</td>
							<td style="padding: 0.6rem;">5,400 sq ft</td>
							<td style="padding: 0.6rem; color: #b91c1c; font-weight: 700;">280 – 350 Guests</td>
							<td style="padding: 0.6rem;">540 Guests</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<!-- Frequently Asked Questions -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1.25rem;">
				❓ Frequently Asked Questions: Wedding Tent Rentals
			</h2>
			
			<div style="display: flex; flex-direction: column; gap: 1rem;">
				<div style="border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.85rem;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						Do I need a permit to put up a wedding tent?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						In most municipalities, tents larger than 400 square feet (20x20 ft) require a local building or fire department permit. Your tent rental company typically handles permit filing and fire marshal inspections.
					</p>
				</div>

				<div style="border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.85rem;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						How much clearance space is needed around the tent?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						Pole tents require an extra <strong>5 to 10 feet of staking clearance</strong> on all four sides (a 40x60 ft pole tent requires a 50x70 ft flat ground area). Frame tents require only 2 to 3 feet of perimeter clearance.
					</p>
				</div>
			</div>
		</section>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/wedding-tent-size-calculator" category="budget" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-tent-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Wedding Tent Size & Site Layout Specification</h1>
				<p id="print-tent-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Outdoor Rental Equipment Specification | Manage.Wedding</p>
			</div>
			<div id="print-tent-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	// Elements
	const inputTentGuests = document.getElementById('input-tent-guests');
	const selectSeatingStyle = document.getElementById('select-seating-style');
	const selectMusicSetup = document.getElementById('select-music-setup');
	const selectDanceRatio = document.getElementById('select-dance-ratio');
	const inputBuffetStations = document.getElementById('input-buffet-stations');
	const inputBarStations = document.getElementById('input-bar-stations');
	const selectTentType = document.getElementById('select-tent-type');
	const selectFlooringType = document.getElementById('select-flooring-type');

	const badgeTentSqft = document.getElementById('badge-tent-sqft');
	const statTentDimension = document.getElementById('stat-tent-dimension');
	const statTentAlt = document.getElementById('stat-tent-alt');
	const statDanceSize = document.getElementById('stat-dance-size');
	const statDanceSub = document.getElementById('stat-dance-sub');

	const statGeneratorKw = document.getElementById('stat-generator-kw');
	const statLightingStrands = document.getElementById('stat-lighting-strands');
	const statPowerCircuits = document.getElementById('stat-power-circuits');
	const statSideWalls = document.getElementById('stat-side-walls');

	const statSpaceSeating = document.getElementById('stat-space-seating');
	const statSpaceDance = document.getElementById('stat-space-dance');
	const statSpaceStage = document.getElementById('stat-space-stage');
	const statSpaceBuffet = document.getElementById('stat-space-buffet');

	function calculateTent() {
		const guests = Math.max(10, parseInt(inputTentGuests.value, 10) || 130);
		const seatingStyle = selectSeatingStyle.value;

		// 1. Seating space
		let sqftPerGuest = 14;
		if (seatingStyle === 'rect') sqftPerGuest = 11;
		else if (seatingStyle === 'cocktail') sqftPerGuest = 8;
		else if (seatingStyle === 'ceremony') sqftPerGuest = 7;
		const seatingSqft = guests * sqftPerGuest;

		// 2. Dance Floor
		const danceRatio = parseFloat(selectDanceRatio.value) || 0.5;
		const dancers = Math.round(guests * danceRatio);
		const danceSqft = Math.round(dancers * 4.8);
		let danceDim = '16 x 20 ft';
		if (danceSqft <= 150) danceDim = '12 x 12 ft';
		else if (danceSqft <= 225) danceDim = '15 x 15 ft';
		else if (danceSqft <= 325) danceDim = '16 x 20 ft';
		else if (danceSqft <= 450) danceDim = '20 x 20 ft';
		else danceDim = '24 x 24 ft';

		// 3. Stage
		const musicSetup = selectMusicSetup.value;
		let stageSqft = 100;
		if (musicSetup === 'band-small') stageSqft = 200;
		else if (musicSetup === 'band-large') stageSqft = 350;
		else if (musicSetup === 'none') stageSqft = 0;

		// 4. Buffets and Bars
		const buffets = parseInt(inputBuffetStations.value, 10) || 0;
		const bars = parseInt(inputBarStations.value, 10) || 0;
		const buffetSqft = (buffets * 100) + (bars * 60);

		// Total Square Footage
		const rawTotalSqft = seatingSqft + danceSqft + stageSqft + buffetSqft;
		const totalSqft = Math.round(rawTotalSqft * 1.08); // 8% buffer for walkways and exits

		badgeTentSqft.textContent = `${totalSqft.toLocaleString()} sq ft`;
		statSpaceSeating.textContent = `${seatingSqft.toLocaleString()} sq ft`;
		statSpaceDance.textContent = `${danceSqft.toLocaleString()} sq ft`;
		statSpaceStage.textContent = `${stageSqft.toLocaleString()} sq ft`;
		statSpaceBuffet.textContent = `${buffetSqft.toLocaleString()} sq ft`;

		statDanceSize.textContent = danceDim;
		statDanceSub.textContent = `${danceSqft} sq ft (for ${dancers} dancers)`;

		// Standard Tent Matching
		let tentDim = '40 x 60 ft';
		let tentAlt = '(or 30 x 80 ft)';
		let perimeter = 200;

		if (totalSqft <= 1000) {
			tentDim = '30 x 30 ft';
			tentAlt = '(900 sq ft)';
			perimeter = 120;
		} else if (totalSqft <= 1500) {
			tentDim = '30 x 50 ft';
			tentAlt = '(or 40 x 40 ft)';
			perimeter = 160;
		} else if (totalSqft <= 2000) {
			tentDim = '40 x 50 ft';
			tentAlt = '(or 30 x 70 ft)';
			perimeter = 180;
		} else if (totalSqft <= 2600) {
			tentDim = '40 x 60 ft';
			tentAlt = '(or 30 x 80 ft)';
			perimeter = 200;
		} else if (totalSqft <= 3200) {
			tentDim = '40 x 80 ft';
			tentAlt = '(or 30 x 100 ft)';
			perimeter = 240;
		} else if (totalSqft <= 4200) {
			tentDim = '40 x 100 ft';
			tentAlt = '(or 60 x 70 ft)';
			perimeter = 280;
		} else if (totalSqft <= 5500) {
			tentDim = '60 x 90 ft';
			tentAlt = '(5,400 sq ft)';
			perimeter = 300;
		} else {
			tentDim = '60 x 120 ft';
			tentAlt = '(7,200 sq ft)';
			perimeter = 360;
		}

		statTentDimension.textContent = tentDim;
		statTentAlt.textContent = tentAlt;

		// Generator sizing
		let genKw = '25 kW';
		let circuits = 6;
		if (guests > 150 || musicSetup === 'band-large') {
			genKw = '45 kW';
			circuits = 10;
		} else if (guests > 250) {
			genKw = '70 kW';
			circuits = 16;
		}

		statGeneratorKw.textContent = `${genKw} Generator`;
		statLightingStrands.textContent = `${Math.round(perimeter * 1.8)} ft`;
		statPowerCircuits.textContent = `${circuits} x 20A`;
		statSideWalls.textContent = `${perimeter} ft`;

		// Print Layout
		document.getElementById('print-tent-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Tent Space Component</th>
						<th style="padding:6pt;">Calculation Factor</th>
						<th style="padding:6pt; text-align:right;">Required Area</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Guest Seating Area</td>
						<td style="padding:6pt;">${guests} guests @ ${sqftPerGuest} sq ft/person</td>
						<td style="padding:6pt; text-align:right;"><strong>${seatingSqft.toLocaleString()} sq ft</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Dance Floor</td>
						<td style="padding:6pt;">${danceDim} (${dancers} peak dancers)</td>
						<td style="padding:6pt; text-align:right;"><strong>${danceSqft} sq ft</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Stage & Audio Setup</td>
						<td style="padding:6pt;">${selectMusicSetup.options[selectMusicSetup.selectedIndex].text}</td>
						<td style="padding:6pt; text-align:right;"><strong>${stageSqft} sq ft</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Buffets & Bars</td>
						<td style="padding:6pt;">${buffets} buffet lines & ${bars} bar stations</td>
						<td style="padding:6pt; text-align:right;"><strong>${buffetSqft} sq ft</strong></td>
					</tr>
					<tr style="background:#eff6ff; font-weight:bold; font-size:11pt; border-top:2pt solid #000;">
						<td style="padding:8pt;">TOTAL REQUIRED TENT SIZE</td>
						<td style="padding:8pt;">${selectTentType.options[selectTentType.selectedIndex].text}</td>
						<td style="padding:8pt; text-align:right; color:#b91c1c;">${tentDim} (${totalSqft.toLocaleString()} sq ft)</td>
					</tr>
					<tr style="background:#f0fdf4; font-weight:bold; font-size:10.5pt; border-top:1.5pt solid #15803d;">
						<td style="padding:8pt; color:#15803d;">GENERATOR & POWER</td>
						<td style="padding:8pt; color:#15803d;">${genKw} Whisper Quiet Diesel Generator</td>
						<td style="padding:8pt; text-align:right; color:#15803d;">${circuits} Dedicated 20A Circuits</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	// Listeners
	[inputTentGuests, selectSeatingStyle, selectMusicSetup, selectDanceRatio, inputBuffetStations, inputBarStations, selectTentType, selectFlooringType].forEach(el => {
		el.addEventListener('input', calculateTent);
		el.addEventListener('change', calculateTent);
	});

	// Print PDF
	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateTent();
		window.print();
	});

	// Export Word
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateTent();
		const dimension = statTentDimension.textContent;
		const totalArea = badgeTentSqft.textContent;
		const dance = statDanceSize.textContent;
		const guests = inputTentGuests.value;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Wedding Tent Specification</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Wedding Tent Size & Site Layout Specification</h1>
				<p><strong>Guests:</strong> ${guests} | <strong>Recommended Tent:</strong> ${dimension} (${totalArea}) | <strong>Dance Floor:</strong> ${dance} | <strong>Generator:</strong> ${statGeneratorKw.textContent}</p>
				<hr/>
				<p><em>Generated by Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding-Tent-Specification-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateTent();
</script>
