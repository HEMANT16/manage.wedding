---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Wedding Vow Word Count & Speaking Pace Timer",
      "url": "https://manage.wedding/wedding-vow-timer",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calculate your wedding vow speaking duration, word count, partner balance, and practice with a live rehearsal teleprompter.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Time and Pace Your Wedding Vows",
      "description": "Step-by-step method to write, balance, and practice delivering personal wedding vows at the ideal 2-minute ceremony length.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Aim for the 250–350 Word Sweet Spot",
          "text": "The ideal wedding vow is between 250 and 350 words, which translates to exactly 2 to 3 minutes of spoken delivery."
        },
        {
          "@type": "HowToStep",
          "name": "Account for Emotional Pauses",
          "text": "Add a 20% time buffer for deep breaths, holding back tears, laughing, and eye contact with your partner."
        },
        {
          "@type": "HowToStep",
          "name": "Balance Length with Your Partner",
          "text": "Agree with your partner on a target length (e.g. 2 minutes) so one person's vows are not drastically longer than the other's."
        },
        {
          "@type": "HowToStep",
          "name": "Practice with Live Rehearsal Mode",
          "text": "Read your vows out loud using the stopwatch timer at a slow, deliberate pace of 100 to 115 words per minute."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long should wedding vows be?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wedding vows should ideally be between 2 and 3 minutes long (250 to 350 words). Anything under 1 minute feels rushed, while vows exceeding 4 minutes (500+ words) can cause guests to lose attention and disrupt the ceremony schedule."
          }
        },
        {
          "@type": "Question",
          "name": "How many words is a 2-minute wedding vow?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At a natural, emotional speaking pace of 110 words per minute (with natural breathing pauses), a 2-minute wedding vow is approximately 220 to 250 words."
          }
        },
        {
          "@type": "Question",
          "name": "Should you memorize your wedding vows?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Wedding planners and officiants strongly advise against memorizing vows. The emotional gravity and adrenaline of standing at the altar make it easy to blank out. Always print your vows in a dedicated vow booklet or 4x6 card."
          }
        },
        {
          "@type": "Question",
          "name": "How do we make sure our vows match in length without reading them?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Give both of your written drafts to a trusted friend, maid of honor, or officiant to review word counts and tone, or simply agree together on a strict word limit (e.g., exactly 300 words each)."
          }
        }
      ]
    }
  ]
};
---

<Layout
	title="Wedding Vow Word Count & Speaking Pace Timer — Vow Length Sizer"
	description="Time your personal wedding vows, calculate word count, compare length with your partner, practice with a live stopwatch, and print 4x6 vow booklet cards."
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/stationery" style="color: var(--text-secondary); text-decoration: none;">Speeches & Stationery</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Wedding Vow Timer</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>💍</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Live Altar Speech Timer & Vow Booklet Sizer</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Wedding Vow Word Count & Speaking Timer
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Paste your draft vows to calculate exact <strong>Speaking Time</strong>, adjust for emotional pauses and tears, compare word counts with your partner, and rehearse with our live rehearsal stopwatch.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Vow Text Editor & Controls -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<h2 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.4rem;">
						<span>✍️</span> Your Wedding Vow Draft
					</h2>
					<button type="button" id="btn-load-sample" style="background: none; border: none; color: #1e40af; font-size: 0.8rem; font-weight: 700; cursor: pointer; text-decoration: underline;">
						Load Sample Vows
					</button>
				</div>

				<!-- Textarea Editor -->
				<div style="margin-bottom: 1.25rem;">
					<textarea id="input-vow-text" rows="11" placeholder="Write or paste your vows here... (e.g., 'From the moment I met you in that coffee shop, I knew my life was about to change...')" style="width: 100%; padding: 0.85rem; border: 2px solid var(--fg-pencil); border-radius: 6px; font-family: inherit; font-size: 0.95rem; line-height: 1.6; resize: vertical; box-sizing: border-box;"></textarea>
				</div>

				<!-- Speaking Pace & Emotion Settings -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; margin-bottom: 1.25rem;">
					<strong style="color: var(--fg-pencil); display: block; font-size: 0.85rem; margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
						Speaking Pace & Emotional Pauses
					</strong>

					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
						<div>
							<label for="select-speaking-pace" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Speaking Pace:</label>
							<select id="select-speaking-pace" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
								<option value="105" selected>❤️ Romantic / Slow (105 WPM)</option>
								<option value="125">🗣️ Natural Conversational (125 WPM)</option>
								<option value="145">⚡ Fast / Nervous (145 WPM)</option>
							</select>
						</div>
						<div>
							<label for="select-emotion-buffer" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Tears & Pause Buffer:</label>
							<select id="select-emotion-buffer" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
								<option value="20" selected>💧 +20% (Breaths, emotion, laughs)</option>
								<option value="10">🙂 +10% (Light pauses)</option>
								<option value="0">⏱️ +0% (Continuous reading)</option>
							</select>
						</div>
					</div>

					<!-- Partner Word Count Comparison -->
					<div>
						<label for="input-partner-words" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">
							Partner's Word Count (Optional Balance Check):
						</label>
						<input type="number" id="input-partner-words" min="0" max="2000" placeholder="e.g. 310 words" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

			</div>

			<!-- Right Column: Speech Duration Blueprint & Practice Mode -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Speech Length Analysis</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Estimated Speaking Duration
						</h2>
					</div>
					<span id="badge-word-status" style="background: #dcfce7; border: 1.5px solid #15803d; color: #15803d; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">Sweet Spot</span>
				</div>

				<!-- Big Number Highlights -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Spoken Duration</span>
						<strong id="stat-duration-time" style="font-size: 2rem; font-weight: 900; color: #1e40af; line-height: 1.1;">2m 35s</strong>
						<span id="stat-duration-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(Ideal: 2m 00s – 3m 00s)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Total Word Count</span>
						<strong id="stat-word-count" style="font-size: 2rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">274</strong>
						<span id="stat-words-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">Target: 250–350 words</span>
					</div>
				</div>

				<!-- Summary Breakdown -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">📏 Character Count:</span>
						<strong id="stat-char-count" style="color: var(--fg-pencil);">1,450 characters</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">📑 Vow Booklet Pages (4x6 card):</span>
						<strong id="stat-booklet-pages" style="color: var(--fg-pencil);">2 pages / 1 double-sided card</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.3rem 0;">
						<span style="color: #475569;">⚖️ Partner Balance:</span>
						<strong id="stat-partner-balance" style="color: #15803d;">Well Balanced</strong>
					</div>
				</div>

				<!-- Live Rehearsal Stopwatch -->
				<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1rem; margin-bottom: 1.25rem; text-align: center;">
					<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase;">🎙️ Altar Rehearsal Practice Stopwatch</span>
					<div id="display-stopwatch" style="font-size: 2.25rem; font-family: monospace; font-weight: 900; color: var(--fg-pencil); margin: 0.25rem 0 0.5rem;">
						00:00.0
					</div>
					<div style="display: flex; justify-content: center; gap: 0.5rem;">
						<button type="button" id="btn-timer-toggle" class="hand-btn" style="background: #15803d; color: #fff; padding: 0.4rem 1.2rem; font-weight: 700; font-size: 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer;">
							▶️ Start Practice
						</button>
						<button type="button" id="btn-timer-reset" class="hand-btn" style="background: #e2e8f0; color: #334155; padding: 0.4rem 0.8rem; font-weight: 700; font-size: 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer;">
							🔄 Reset
						</button>
					</div>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-vow-card" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Print 4x6 Vow Cards (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Export Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Section: Vow Structure Template -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem;">
				📜 The Anatomy of a Perfect 2-Minute Wedding Vow
			</h2>
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; font-size: 0.88rem;">
				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						1. The Hook & Fond Memory (50 words)
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						Share a brief, heartwarming anecdote about the moment you fell in love or realized they were your person. Keep it under 30 seconds.
					</p>
				</div>

				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						2. What You Admire (75 words)
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						Express the specific qualities you love—their kindness, sense of adventure, ability to make you laugh on hard days, or boundless patience.
					</p>
				</div>

				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						3. The Real Promises (120 words)
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						Mix 3–4 serious lifetime commitments with 1 lighthearted personal promise (e.g., <em>"I promise to always cheer for your dreams, and to let you have the last slice of pizza"</em>).
					</p>
				</div>

				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						4. The Final Closing (30 words)
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						End on a memorable, definitive romantic declaration of eternal devotion to carry into the ring exchange.
					</p>
				</div>
			</div>
		</section>

		<!-- Frequently Asked Questions -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1.25rem;">
				❓ Frequently Asked Questions: Wedding Vow Timing & Length
			</h2>
			
			<div style="display: flex; flex-direction: column; gap: 1rem;">
				<div style="border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.85rem;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						What happens if I start crying while reading my vows?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						That is completely natural and expected! Don't try to power through or rush. Take a slow, deep breath, look up at your partner, wipe your eyes with a handkerchief, and continue. That is why our calculator adds a 20% emotional pause buffer.
					</p>
				</div>

				<div style="border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.85rem;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						Can I read my vows from my phone?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						Wedding photographers recommend <strong>never reading from a smartphone</strong>. Phone screens reflect harsh blue light onto your face and look tacky in heirloom ceremony portraits. Print your vows onto 4x6 cardstock or write them in an embossed vow booklet.
					</p>
				</div>

				<div>
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						What font size should I use for printed vow cards?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						Print your vows in a clean <strong>14pt to 16pt serif font</strong> with 1.5 line spacing. In the dim lighting of an altar or with watery eyes, small 10pt text is impossible to read without squinting.
					</p>
				</div>
			</div>
		</section>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/wedding-vow-timer" category="stationery" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-vow-container" class="print-page" style="padding: 15mm; font-family: 'Times New Roman', serif;">
			<div style="border: 2pt solid #444; border-radius: 8pt; padding: 15mm; min-height: 80vh; display: flex; flex-direction: column; justify-content: space-between;">
				<div>
					<div style="text-align: center; border-bottom: 1pt solid #ccc; padding-bottom: 4mm; margin-bottom: 8mm;">
						<h1 style="font-size: 18pt; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 2mm 0;">My Wedding Vows</h1>
						<p id="print-vow-meta" style="font-size: 9pt; color: #666; margin: 0;">Ceremony Card | Manage.Wedding</p>
					</div>
					<div id="print-vow-body" style="font-size: 13pt; line-height: 1.8; color: #111; white-space: pre-wrap;">
					</div>
				</div>
				<div style="text-align: center; border-top: 1pt solid #eee; padding-top: 4mm; font-size: 9pt; color: #888;">
					Forever & Always
				</div>
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	// Elements
	const inputVowText = document.getElementById('input-vow-text');
	const btnLoadSample = document.getElementById('btn-load-sample');
	const selectSpeakingPace = document.getElementById('select-speaking-pace');
	const selectEmotionBuffer = document.getElementById('select-emotion-buffer');
	const inputPartnerWords = document.getElementById('input-partner-words');

	const statDurationTime = document.getElementById('stat-duration-time');
	const statDurationSub = document.getElementById('stat-duration-sub');
	const statWordCount = document.getElementById('stat-word-count');
	const badgeWordStatus = document.getElementById('badge-word-status');
	const statCharCount = document.getElementById('stat-char-count');
	const statBookletPages = document.getElementById('stat-booklet-pages');
	const statPartnerBalance = document.getElementById('stat-partner-balance');

	const displayStopwatch = document.getElementById('display-stopwatch');
	const btnTimerToggle = document.getElementById('btn-timer-toggle');
	const btnTimerReset = document.getElementById('btn-timer-reset');

	const SAMPLE_VOWS = `From the moment I met you on that rainy Tuesday in Chicago, I knew my life was going to change forever. You brought laughter into every quiet day and showed me what true partnership really feels like.

I love your kindness, your boundless curiosity, and how you always know exactly what to say to make me smile after a long day. 

Standing before our family and friends today, I make these promises to you:
I promise to always listen with an open heart.
I promise to encourage your wildest ambitions and celebrate every milestone by your side.
I promise to comfort you in sorrow and laugh with you in joy.
And I promise to always let you pick the music on long road trips.

You are my best friend, my greatest adventure, and the love of my life. Today, tomorrow, and for all our years to come, I choose you.`;

	function calculateVows() {
		const text = inputVowText.value.trim();
		const words = text.length > 0 ? text.split(/\s+/).filter(Boolean) : [];
		const wordCount = words.length;
		const charCount = text.length;

		statWordCount.textContent = wordCount.toLocaleString();
		statCharCount.textContent = `${charCount.toLocaleString()} characters`;

		const paceWPM = parseInt(selectSpeakingPace.value, 10) || 105;
		const emotionPercent = parseInt(selectEmotionBuffer.value, 10) || 20;

		const rawMinutes = wordCount / paceWPM;
		const totalSeconds = Math.round(rawMinutes * 60 * (1 + emotionPercent / 100));

		const mins = Math.floor(totalSeconds / 60);
		const secs = totalSeconds % 60;
		statDurationTime.textContent = `${mins}m ${secs < 10 ? '0' : ''}${secs}s`;

		// Sweet spot status (250–350 words)
		if (wordCount === 0) {
			badgeWordStatus.textContent = 'Enter Vows';
			badgeWordStatus.style.background = '#f1f5f9';
			badgeWordStatus.style.color = '#64748b';
			badgeWordStatus.style.borderColor = '#cbd5e1';
		} else if (wordCount < 180) {
			badgeWordStatus.textContent = 'Too Short (<1.5m)';
			badgeWordStatus.style.background = '#fef3c7';
			badgeWordStatus.style.color = '#b45309';
			badgeWordStatus.style.borderColor = '#b45309';
		} else if (wordCount > 450) {
			badgeWordStatus.textContent = 'Too Long (>4m)';
			badgeWordStatus.style.background = '#fee2e2';
			badgeWordStatus.style.color = '#dc2626';
			badgeWordStatus.style.borderColor = '#dc2626';
		} else {
			badgeWordStatus.textContent = 'Perfect Sweet Spot (2–3m)';
			badgeWordStatus.style.background = '#dcfce7';
			badgeWordStatus.style.color = '#15803d';
			badgeWordStatus.style.borderColor = '#15803d';
		}

		// Booklet Pages (approx 140 words per 4x6 page with 14pt font)
		const pagesNeeded = Math.max(1, Math.ceil(wordCount / 140));
		statBookletPages.textContent = `${pagesNeeded} ${pagesNeeded === 1 ? 'page' : 'pages'} (4x6 card booklet)`;

		// Partner Balance Check
		const partnerWords = parseInt(inputPartnerWords.value, 10);
		if (!partnerWords || partnerWords <= 0) {
			statPartnerBalance.textContent = 'Enter partner words to compare';
			statPartnerBalance.style.color = '#64748b';
		} else {
			const diff = Math.abs(wordCount - partnerWords);
			const ratio = wordCount / partnerWords;
			if (ratio >= 0.75 && ratio <= 1.35) {
				statPartnerBalance.textContent = `✅ Perfectly Balanced (${diff} word diff)`;
				statPartnerBalance.style.color = '#15803d';
			} else if (ratio < 0.75) {
				statPartnerBalance.textContent = `⚠️ Your vows are shorter by ${diff} words`;
				statPartnerBalance.style.color = '#b45309';
			} else {
				statPartnerBalance.textContent = `⚠️ Your vows are longer by ${diff} words`;
				statPartnerBalance.style.color = '#dc2626';
			}
		}

		// Update Print Container
		document.getElementById('print-vow-body').textContent = text || 'Write your vows to print...';
	}

	btnLoadSample.addEventListener('click', () => {
		inputVowText.value = SAMPLE_VOWS;
		inputPartnerWords.value = "290";
		calculateVows();
	});

	[inputVowText, selectSpeakingPace, selectEmotionBuffer, inputPartnerWords].forEach(el => {
		el.addEventListener('input', calculateVows);
		el.addEventListener('change', calculateVows);
	});

	// Stopwatch Logic
	let timerInterval = null;
	let startTime = 0;
	let elapsedTime = 0;
	let isRunning = false;

	function updateStopwatch() {
		const now = Date.now();
		const totalMs = elapsedTime + (now - startTime);
		const totalSecs = Math.floor(totalMs / 1000);
		const mins = Math.floor(totalSecs / 60);
		const secs = totalSecs % 60;
		const tenths = Math.floor((totalMs % 1000) / 100);
		displayStopwatch.textContent = `${mins < 10 ? '0' : ''}${mins}:${secs < 10 ? '0' : ''}${secs}.${tenths}`;
	}

	btnTimerToggle.addEventListener('click', () => {
		if (!isRunning) {
			isRunning = true;
			startTime = Date.now();
			timerInterval = setInterval(updateStopwatch, 100);
			btnTimerToggle.textContent = '⏸️ Pause';
			btnTimerToggle.style.background = '#dc2626';
		} else {
			isRunning = false;
			elapsedTime += Date.now() - startTime;
			clearInterval(timerInterval);
			btnTimerToggle.textContent = '▶️ Resume';
			btnTimerToggle.style.background = '#15803d';
		}
	});

	btnTimerReset.addEventListener('click', () => {
		isRunning = false;
		clearInterval(timerInterval);
		elapsedTime = 0;
		displayStopwatch.textContent = '00:00.0';
		btnTimerToggle.textContent = '▶️ Start Practice';
		btnTimerToggle.style.background = '#15803d';
	});

	// Print PDF
	document.getElementById('btn-print-vow-card').addEventListener('click', () => {
		calculateVows();
		window.print();
	});

	// Export Word Doc
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateVows();
		const text = inputVowText.value.replace(/\n/g, '<br/>');
		const duration = statDurationTime.textContent;
		const words = statWordCount.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Wedding Vows</title>
			<style>body{font-family:Georgia,serif;line-height:1.8;padding:20pt;} h1{text-align:center;font-size:20pt;} .meta{text-align:center;color:#666;font-size:10pt;}</style>
			</head>
			<body>
				<h1>Our Wedding Vows</h1>
				<p class="meta"><strong>Speaking Time:</strong> ${duration} | <strong>Word Count:</strong> ${words} words</p>
				<hr/>
				<div style="font-size:14pt; margin-top:20pt;">
					${text}
				</div>
				<br/><br/>
				<p style="text-align:center;font-style:italic;">— Forever & Always —</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding-Vows-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Auto-load sample if empty
	if (!inputVowText.value) {
		inputVowText.value = SAMPLE_VOWS;
		inputPartnerWords.value = "290";
	}
	calculateVows();
</script>
