---
import Layout from '../../layouts/Layout.astro';

const title = "【公式】結婚式 席次表・2次会・スピーチ準備 計算＆運営ツール一覧 | Manage.Wedding 日本版";
const description = "結婚式の席次表・上座下座配置ビルダー、2次会（二次会）会費＆予算計算機、友人代表スピーチ＆乾杯挨拶タイマーなど、披露宴当日と二次会の運営を成功させる無料ツール集。完全無料・登録不要・ローカル保存。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/ja/logistics/#collection",
      "name": "結婚式 席次表・2次会・スピーチ準備 ツール一覧",
      "url": "https://manage.wedding/ja/logistics",
      "description": "日本の結婚式に特化した上座・下座席次表作成、二次会会費計算、友人代表スピーチタイマーツール集。",
      "inLanguage": "ja",
      "hasPart": [
        { "@type": "WebApplication", "name": "結婚式 席次表・上座下座 配置ビルダー", "url": "https://manage.wedding/ja/sekijihyo-seating-builder" },
        { "@type": "WebApplication", "name": "2次会（二次会）会費＆予算計算機", "url": "https://manage.wedding/ja/nijikai-fee-calculator" },
        { "@type": "WebApplication", "name": "友人代表スピーチ＆乾杯 挨拶タイマー", "url": "https://manage.wedding/ja/speech-toast-timer" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "結婚式の席次表で「上座」と「下座」の順番はどう決まりますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "高砂（新郎新婦のメインテーブル）に最も近い席が「上座」となり、主賓（会社上司・恩師）を配席します。次に勤務先同僚、学生時代の友人、親族の順となり、出入口に最も近い席が「下座（末席）」として新郎新婦の両親・家族が座るのが日本の絶対マナーです。"
          }
        },
        {
          "@type": "Question",
          "name": "二次会の会費設定で赤字を出さない計算方法は？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "会場費＋飲食代（飲み放題付きビュッフェ）＋ビンゴ・ゲーム景品代＋予備費を合計し、出席予想人数（男性人数×男性会費 ＋ 女性人数×女性会費）で割り戻します。一般的に男性会費は7,500円〜8,500円、女性会費は6,500円〜7,500円に設定し、ドタキャン10%を想定して計算するのが鉄則です。"
          }
        },
        {
          "@type": "Question",
          "name": "友人代表スピーチの理想的な長さと文字数はどれくらいですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "最も聞きやすく飽きさせない理想の長さは「3分間」です。日本人が落ち着いて聞き取りやすい話速（1分間に約300文字）で計算すると、原稿用紙2枚半〜3枚分（約800字〜900字）で原稿を作成するのが黄金比率です。"
          }
        },
        {
          "@type": "Question",
          "name": "席次表で「両親」に敬称（様）をつけないのはなぜですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "結婚式において新郎新婦の両親や同居の家族は、ゲストをおもてなしする「主催者側（ホスト）」の立場になるためです。身内に敬称をつけるのはマナー違反となるため、両親・未婚の同居兄弟には「様」をつけず肩書きのみ（新郎 父 / 新郎 母など）とします。"
          }
        }
      ]
    }
  ]
};

const tools = [
  {
    title: "結婚式 席次表・上座下座 配置ビルダー",
    url: "/ja/sekijihyo-seating-builder",
    icon: "🪑",
    badge: "配席マナー診断",
    badgeBg: "#FDF2F8",
    badgeText: "#9D174D",
    lead: "高砂ステージに近い最上座（主賓・上司）から出入口側の末席（両親）まで、日本の厳格なテーブル配席ルールをチェック。円卓（ラウンド）と長テーブルの両形式に対応。",
    highlights: ["上座〜末席の序列自動判定", "両親・親族・友人の配置ルール", "肩書き表記マナー＆敬称チェック"],
    cta: "席次表ビルダーを開く →"
  },
  {
    title: "2次会（二次会）会費＆予算計算機",
    url: "/ja/nijikai-fee-calculator",
    icon: "🥂",
    badge: "赤字ゼロ会費設定",
    badgeBg: "#FEF3C7",
    badgeText: "#92400E",
    lead: "会場貸切代・飲み放題・ビンゴ景品代から、男女別の会費設定とドタキャン10%を考慮した赤字ゼロ損益分岐点を瞬時に計算。幹事マニュアル＆進行表も生成。",
    highlights: ["男女別会費の自動シミュレーション", "景品予算＆備品コスト配分", "当日ドタキャン耐性チェック"],
    cta: "二次会会費を計算する →"
  },
  {
    title: "友人代表スピーチ＆乾杯 挨拶タイマー",
    url: "/ja/speech-toast-timer",
    icon: "⏱️",
    badge: "3分スピーチ添削",
    badgeBg: "#E0E7FF",
    badgeText: "#3730A3",
    lead: "聞き取りやすい話速（1分約300文字）に合わせた原稿文字数カウントと3分ストップウォッチタイマー。忌み言葉・重ね言葉の自動チェックと構成テンプレート付き。",
    highlights: ["3分スピーチ文字数チェッカー（800〜900字）", "忌み言葉・重ね言葉のNGワード自動検出", "リアルタイム発話タイマー＆構成ガイド"],
    cta: "スピーチタイマーを使う →"
  }
];

const seatingNorms = [
  { rank: "1. 最上座（最前列・高砂正面）", target: "主賓（会社社長・役員・恩師）", note: "高砂に最も近く、新郎新婦の表情が一番よく見える席" },
  { rank: "2. 前列〜中列", target: "職場の上司・先輩・取引先関係", note: "役職の高い順に高砂に近い位置へ配席" },
  { rank: "3. 中列〜後列", target: "職場の同僚・学生時代の友人", note: "グループごとの仲良しグループで円卓を構成" },
  { rank: "4. 後列（出入口寄り）", target: "親族（祖父母・叔父叔母・従兄弟）", note: "年配の祖父母には移動しやすい通路側が配慮として好まれる" },
  { rank: "5. 最下座（末席・出入口直近）", target: "新郎新婦の両親・兄弟姉妹", note: "【最重要】両親は主催者のため末席に座る。敬称（様）はつけない" }
];

const nijikaiNorms = [
  { item: "男性会費相場", avg: "7,500 〜 8,500 円", note: "飲食代5,000円＋景品・設備代2,500〜3,000円" },
  { item: "女性会費相場", avg: "6,500 〜 7,500 円", note: "男性より1,000円安く設定するのが一般的" },
  { item: "景品予算比率", avg: "総予算の 15% 〜 20%", note: "目玉景品（テーマパークペア券・家電等）＋参加賞" },
  { item: "新郎新婦自己負担", avg: "0 〜 30,000 円", note: "赤字補填用または景品代の一部を新郎新婦が出資" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Category Hero Section -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3rem) 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1100px; margin: 0 auto;">
			
			<!-- Breadcrumb Link -->
			<div style="margin-bottom: 1.25rem; font-size: 0.88rem;">
				<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
				<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
				<span style="color: var(--text-secondary);">席次表・2次会・スピーチ運営</span>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FDF2F8; border: 1.5px solid #FBCFE8; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 800; color: #9D174D; margin-bottom: 1rem;">
						<span>🪑</span>
						<span>CATEGORY 04 • 席次表・二次会・スピーチ運営</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
						結婚式 席次表・2次会・スピーチ<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">専門計算＆運営ツール一覧</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.8; margin-bottom: 1.5rem;">
						披露宴当日の上座下座マナーに則った席次表の作成から、赤字を出さない二次会会費の設定、感動を呼ぶ3分友人スピーチの文字数・タイマー管理まで。<strong>結婚式当日とアフターパーティーを大成功に導く運営ツール</strong>をご利用いただけます。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.80rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.80rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.80rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷
						</span>
					</div>
				</div>

				<!-- Mini Live Estimator: Quick Nijikai Fee & Breakeven Estimator -->
				<div class="hand-card" style="background: #fff; padding: 1.5rem; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil);">
					<div class="tape" style="top: -12px; left: 30%;"></div>
					<div style="font-size: 0.82rem; font-weight: 800; color: #9D174D; text-transform: uppercase; margin-bottom: 0.3rem;">
						NIJIKAI ESTIMATOR
					</div>
					<h3 style="font-size: 1.1rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 1rem;">
						🥂 二次会会費 クイック試算
					</h3>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; margin-bottom: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
							<label for="q-nijikai-guests" style="font-weight: 700;">予想参加人数</label>
							<div style="display: flex; align-items: center; gap: 0.35rem;">
								<input type="number" id="q-nijikai-guests" value="40" min="10" max="150" step="5" style="width: 55px; text-align: center; padding: 3px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
								<span style="font-size: 0.78rem;">名</span>
							</div>
						</div>

						<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
							<label for="q-food-plan" style="font-weight: 700;">飲食プラン（1人）</label>
							<div style="display: flex; align-items: center; gap: 0.35rem;">
								<span>¥</span>
								<input type="number" id="q-food-plan" value="5000" step="500" style="width: 70px; text-align: right; padding: 3px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
							</div>
						</div>

						<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
							<label for="q-prize-budget" style="font-weight: 700;">景品・ゲーム総予算</label>
							<div style="display: flex; align-items: center; gap: 0.35rem;">
								<span>¥</span>
								<input type="number" id="q-prize-budget" value="50000" step="5000" style="width: 70px; text-align: right; padding: 3px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
							</div>
						</div>
					</div>

					<div style="background: #FDF2F8; border: 2px solid #DB2777; border-radius: 6px; padding: 0.75rem 1rem; text-align: center;">
						<div style="font-size: 0.78rem; font-weight: 800; color: #9D174D;">おすすめ会費設定（赤字ゼロ基準）</div>
						<div style="display: flex; justify-content: space-around; margin-top: 0.35rem; font-size: 1.1rem; font-weight: 900; color: #9D174D;">
							<div>男性: <span id="q-fee-male">7,500</span> 円</div>
							<div>女性: <span id="q-fee-female">6,500</span> 円</div>
						</div>
						<div style="font-size: 0.72rem; color: #BE185D; margin-top: 0.25rem;">※ ドタキャン10%（約4名）発生しても赤字になりません</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Main Tools Section -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1100px; margin: 0 auto;">
			
			<!-- Tool Cards Grid -->
			<div style="display: flex; flex-direction: column; gap: 1.75rem; margin-bottom: 3.5rem;">
				{tools.map((tool) => (
					<div class="hand-card" style="background: #fff; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); overflow: hidden;">
						
						<div style="padding: clamp(1.25rem, 3vw, 2rem);">
							<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
								<span style="font-size: 1.8rem;">{tool.icon}</span>
								<span style={`font-size: 0.75rem; font-weight: 700; padding: 3px 8px; border-radius: 4px; background: ${tool.badgeBg}; color: ${tool.badgeText}; border: 1px solid ${tool.badgeText}22;`}>
									{tool.badge}
								</span>
							</div>

							<h2 style="font-size: 1.3rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.5rem; line-height: 1.4;">
								{tool.title}
							</h2>

							<p style="font-size: 0.90rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 1rem;">
								{tool.lead}
							</p>

							<ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; display: flex; flex-direction: column; gap: 0.3rem;">
								{tool.highlights.map((h) => (
									<li style="font-size: 0.82rem; color: var(--fg-pencil); font-weight: 600; display: flex; align-items: center; gap: 0.4rem;">
										<span style="color: #2563EB; font-weight: 800;">✓</span> {h}
									</li>
								))}
							</ul>

							<a href={tool.url} class="hand-btn" style="text-align: center; text-decoration: none; display: inline-block; padding: 10px 20px; font-size: 0.90rem; font-weight: 800;">
								{tool.cta}
							</a>
						</div>

					</div>
				))}
			</div>

			<!-- Seating Order Reference Table -->
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); margin-bottom: 3.5rem; border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil);">
				<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
					🪑 【早見表】披露宴の席順（上座から末席）序列ルール一覧
				</h2>
				<p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
					日本の結婚式では「高砂に最も近い席が上座、出入口に最も近い席が下座（末席）」という明確なルールがあります。
				</p>

				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
						<thead>
							<tr style="border-bottom: 2px solid var(--fg-pencil); background: #FAF8F5;">
								<th style="padding: 10px 12px; font-weight: 800;">座席の序列</th>
								<th style="padding: 10px 12px; font-weight: 800; color: #1E40AF;">対象となるゲスト</th>
								<th style="padding: 10px 12px; font-weight: 800;">配席のポイントとマナー</th>
							</tr>
						</thead>
						<tbody>
							{seatingNorms.map((row) => (
								<tr style="border-bottom: 1px dashed #e2e8f0;">
									<td style="padding: 10px 12px; font-weight: 800; color: var(--fg-pencil);">{row.rank}</td>
									<td style="padding: 10px 12px; font-weight: 900; color: #1E40AF; background: #EFF6FF;">{row.target}</td>
									<td style="padding: 10px 12px; font-size: 0.82rem; color: var(--text-secondary);">{row.note}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Nijikai Benchmark Reference Table -->
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); margin-bottom: 3.5rem; border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil);">
				<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
					🥂 【早見表】二次会会費＆景品予算の標準相場
				</h2>
				<p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
					幹事様・新郎新婦様が無理なく黒字運営するための全国平均基準です。
				</p>

				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
						<thead>
							<tr style="border-bottom: 2px solid var(--fg-pencil); background: #FAF8F5;">
								<th style="padding: 10px 12px; font-weight: 800;">項目</th>
								<th style="padding: 10px 12px; font-weight: 800; color: #9D174D;">相場基準</th>
								<th style="padding: 10px 12px; font-weight: 800;">解説と留意点</th>
							</tr>
						</thead>
						<tbody>
							{nijikaiNorms.map((row) => (
								<tr style="border-bottom: 1px dashed #e2e8f0;">
									<td style="padding: 10px 12px; font-weight: 800; color: var(--fg-pencil);">{row.item}</td>
									<td style="padding: 10px 12px; font-weight: 900; color: #9D174D; background: #FDF2F8;">{row.avg}</td>
									<td style="padding: 10px 12px; font-size: 0.82rem; color: var(--text-secondary);">{row.note}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<!-- FAQ Section -->
			<div style="max-width: 850px; margin: 0 auto 3.5rem auto;">
				<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); text-align: center; margin-bottom: 1.25rem;">
					席次表・二次会・スピーチに関するよくあるご質問（FAQ）
				</h2>

				<div style="display: flex; flex-direction: column; gap: 0.75rem;">
					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							結婚式の席次表で「上座」と「下座」の順番はどう決まりますか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							高砂（新郎新婦のメインテーブル）に最も近い席が「上座」となり、主賓（会社上司・恩師）を配席します。次に勤務先同僚、学生時代の友人、親族の順となり、出入口に最も近い席が「下座（末席）」として新郎新婦の両親・家族が座るのが日本の絶対マナーです。
						</p>
					</details>

					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							二次会の会費設定で赤字を出さない計算方法は？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							会場費＋飲食代（飲み放題付きビュッフェ）＋ビンゴ・ゲーム景品代＋予備費を合計し、出席予想人数（男性人数×男性会費 ＋ 女性人数×女性会費）で割り戻します。一般的に男性会費は7,500円〜8,500円、女性会費は6,500円〜7,500円に設定し、ドタキャン10%を想定して計算するのが鉄則です。
						</p>
					</details>

					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							友人代表スピーチの理想的な長さと文字数はどれくらいですか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							最も聞きやすく飽きさせない理想の長さは「3分間」です。日本人が落ち着いて聞き取りやすい話速（1分間に約300文字）で計算すると、原稿用紙2枚半〜3枚分（約800字〜900字）で原稿を作成するのが黄金比率です。
						</p>
