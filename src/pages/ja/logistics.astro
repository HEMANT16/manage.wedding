	<!-- Mini Live Calculator Script -->
	<script is:inline>
		const qNijikaiGuests = document.getElementById('q-nijikai-guests');
		const qFoodPlan = document.getElementById('q-food-plan');
		const qPrizeBudget = document.getElementById('q-prize-budget');
		const qFeeMale = document.getElementById('q-fee-male');
		const qFeeFemale = document.getElementById('q-fee-female');

		function calculateQuickNijikai() {
			const guests = parseInt(qNijikaiGuests?.value || '40', 10);
			const food = parseFloat(qFoodPlan?.value || '5000');
			const prize = parseFloat(qPrizeBudget?.value || '50000');

			// Total estimated expense
			const totalCost = (guests * food) + prize + 20000; // 20k contingency

			// Safe attendance factoring 10% drop
			const safeGuests = Math.max(10, Math.floor(guests * 0.9));
			const costPerGuest = totalCost / safeGuests;

			// Male +500, Female -500 relative to costPerGuest, rounded up to 500
			let maleFee = Math.ceil((costPerGuest + 500) / 500) * 500;
			let femaleFee = Math.max(5000, maleFee - 1000);

			if (qFeeMale) qFeeMale.textContent = maleFee.toLocaleString('ja-JP');
			if (qFeeFemale) qFeeFemale.textContent = femaleFee.toLocaleString('ja-JP');
		}

		[qNijikaiGuests, qFoodPlan, qPrizeBudget].forEach(el => {
			if (el) {
				el.addEventListener('input', calculateQuickNijikai);
				el.addEventListener('change', calculateQuickNijikai);
			}
		});

		calculateQuickNijikai();
	</script>

