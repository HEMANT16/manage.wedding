---
import Layout from '../../layouts/Layout.astro';

const title = "【持ち込み料 vs DIY 損益分岐点チェッカー】ドレス・カメラマン・引出物の節約判定 | Manage.Wedding 日本版";
const description = "ドレス（持ち込み料5万円）、カメラマン、ブーケ、引出物、ペーパーアイテムなど、式場の持ち込み料を支払ってでも外部ショップやDIYで持ち込んだ方が安くなるかを瞬時に判定。完全無料・登録不要・A4/PDF印刷対応。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/mochikomi-savings-calculator#app",
      "name": "持ち込み料 vs DIY 損益分岐点チェッカー",
      "url": "https://manage.wedding/ja/mochikomi-savings-calculator",
      "description": "日本の結婚式場特有の持ち込み料（ドレス5万、引出物800円等）を加味し、式場プランと外部手配・DIYの実質総費用と損益分岐点を自動計算するシミュレーター。",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "結婚式の持ち込み料を計算して賢く節約する4つの手順",
      "description": "式場の提示価格と外部ショップの購入・レンタル費用に持ち込み料を合算し、損益分岐点を判定して費用を削減する手順。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "式場の持ち込み可否と持ち込み料（保管料）を確認する",
          "text": "ドレス（1着3〜5万円）、タキシード（1〜3万円）、カメラマン（3〜5万円）、引出物（300〜500円/個）など、会場規定の持ち込み手数料を規約で確認します。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "外部ショップの本体価格＋送料＋持込料を合算する",
          "text": "外部ドレスショップやネット通販の価格に、式場へ支払う持ち込み料を加えた「持ち込み総額」を計算します。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "式場プラン（中間〜上位ランク）の価格と比較する",
          "text": "式場提携ショップで同等クオリティのアイテムを選んだ場合の価格と比較し、差額（節約額）を算出します。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "持ち込み無料アイテム（ペーパー・ムービー・ヒキタク）をフル活用する",
          "text": "ペーパーアイテムや動画、ゲスト宅へ直接届ける「引き出物宅配便（ヒキタク）」など、持ち込み料が0円のサービスを優先して手配します。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "結婚式の「持ち込み料」とは何ですか？なぜ発生するのですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "持ち込み料とは、新郎新婦が式場提携外のドレスやカメラマン、引出物などを持ち込む際に式場に支払う手数料（保管料・管理料）です。式場側が提携業者から得る紹介マージン（仲介料）の補填や、外部業者の当日動線管理、ドレスのシワ伸ばし・保管責任の対価という名目で設定されています。"
          }
        },
        {
          "@type": "Question",
          "name": "持ち込み料を払ってでも外部で手配した方が安くなるアイテムは何ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「ウェディングドレス」「タキシード」「ブーケ」の3点です。式場提携ドレスは30万〜45万円しますが、外部専門ショップなら10万〜15万円でレンタル可能。持ち込み料5万円を支払っても、トータルで15万〜25万円安くなるケースが多数あります。"
          }
        },
        {
          "@type": "Question",
          "name": "持ち込み料が「完全無料」のアイテムには何がありますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "約90%以上の式場で「ペーパーアイテム（招待状・席次表・席札）」「オープニング＆プロフィールムービー」「ウェルカムスペースの装飾品」「プチギフト」「ドレスインナー・アクセサリー」は持ち込み料が無料です。これらをDIY・外注するだけで20万〜35万円浮きます。"
          }
        },
        {
          "@type": "Question",
          "name": "引き出物の持ち込み料（1個500円）を合法的に0円にする方法はありますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「引き出物宅配便（ヒキタク / ギフトナビ等）」を利用することです。式場内に紙袋を持ち込まず、挙式翌日以降にゲストの自宅へ直接配送するため、式場の持ち込み料が一切発生しません。ゲストも重い荷物を持たずに帰れるため非常に好評です。"
          }
        },
        {
          "@type": "Question",
          "name": "持ち込み料の免除交渉はどのように行えば良いですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "必ず「式場契約書にサインする直前」に交渉します。「こちらの会場が第一候補なのですが、母の着たいドレス（または知人のプロカメラマン）があり、ドレスとカメラマンの持ち込み料を無料にしていただけるなら、本日即決で契約します」と伝えるのが最も成功率の高い交渉術です。"
          }
        }
      ]
    }
  ]
};

const mochikomiNorms = [
  { item: "👗 ウェディングドレス / 和装", fee: "3万 〜 5万円 / 着", freeRate: "約 15%", verdict: "◎ 払っても持ち込みがお得（差額で15万〜25万円節約）" },
  { item: "🤵 タキシード", fee: "1万 〜 3万円 / 着", freeRate: "約 20%", verdict: "◯ 外部レンタルで5万〜10万円節約可能" },
  { item: "📷 写真スナップカメラマン", fee: "3万 〜 5万円 / 名", freeRate: "約 10%", verdict: "◯ 撮影データ全カット＋指名料込みで外部が高コスパ" },
  { item: "💐 ブーケ・ブートニア", fee: "5,000 〜 1万円 / 個", freeRate: "約 40%", verdict: "◎ 外部フローリストやアーティフィシャルフラワーで半額" },
  { item: "🎁 引き出物（記念品＋引菓子）", fee: "500円 + 300円 / ゲスト", freeRate: "約 5%", verdict: "⚠️ 紙袋持ち込みは損。ヒキタク（宅配便）なら無料" },
  { item: "💌 ペーパーアイテム（招待状等）", fee: "0円（無料）", freeRate: "約 95%", verdict: "★ 100%自作・Web化推奨（15万〜20万円節約）" },
  { item: "🎬 オープニング＆プロフィール動画", fee: "0円（無料）", freeRate: "約 90%", verdict: "★ 100%自作・外注推奨（10万〜15万円節約）" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<a href="/ja/budget" style="color: #2563EB; text-decoration: none; font-weight: 600;">費用・見積もり</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">持ち込み料 vs DIY 損益分岐点</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #DCFCE7; border: 1.5px solid #86EFAC; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #166534; margin-bottom: 0.75rem;">
						<span>✂️</span>
						<span>節約・損益分岐点 判定ツール</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						持ち込み料 vs DIY<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">損益分岐点チェッカー</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						「持ち込み料（ドレス5万円、引出物800円等）を払ってでも外注した方が安い？それとも式場に頼むべき？」を自動計算。<strong>実質節約額と持ち込みの損得判定</strong>を瞬時に導き出します。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 40%;"></div>
						<img 
							src="/images/ja_mochikomi_flatlay.webp" 
							alt="DIY結婚準備とシーリングスタンプ・クラフトペーパーのフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							✂️ 賢い持ち込み＆DIYで、理想と節約を両立。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Calculator Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
							🧮 持ち込みアイテム別 損益比較シミュレーター
						</h2>
						<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
							検討中のアイテムにチェックを入れ、式場価格と外部手配・持ち込み料を比較してください。
						</p>
					</div>
					<button id="reset-mochikomi-btn" type="button" style="font-size: 0.80rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
						🔄 初期値に戻す
					</button>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem;">
					
					<!-- Left Form: Interactive Item Cards -->
					<div style="display: flex; flex-direction: column; gap: 1.25rem;">
						
						<!-- Item 1: Wedding Dress -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
								<label style="font-size: 0.92rem; font-weight: 800; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
									<input type="checkbox" id="check-dress" checked style="width: 16px; height: 16px; accent-color: #2563EB;" />
									<span>👗 ウェディングドレス (1着)</span>
								</label>
								<span id="diff-dress" style="font-size: 0.80rem; font-weight: 800; color: #059669; background: #ECFDF5; padding: 2px 6px; border-radius: 4px;">
									150,000円 節約
								</span>
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; font-size: 0.75rem;">
								<div>
									<span style="color: var(--text-secondary); display: block;">式場提示価格</span>
									<input type="number" id="venue-dress" value="350000" step="10000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">外部ショップ価格</span>
									<input type="number" id="ext-dress" value="150000" step="10000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">式場持ち込み料</span>
									<input type="number" id="fee-dress" value="50000" step="5000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
							</div>
						</div>

						<!-- Item 2: Tuxedo -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
								<label style="font-size: 0.92rem; font-weight: 800; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
									<input type="checkbox" id="check-tuxedo" checked style="width: 16px; height: 16px; accent-color: #2563EB;" />
									<span>🤵 新郎タキシード (1着)</span>
								</label>
								<span id="diff-tuxedo" style="font-size: 0.80rem; font-weight: 800; color: #059669; background: #ECFDF5; padding: 2px 6px; border-radius: 4px;">
									60,000円 節約
								</span>
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; font-size: 0.75rem;">
								<div>
									<span style="color: var(--text-secondary); display: block;">式場提示価格</span>
									<input type="number" id="venue-tuxedo" value="150000" step="5000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">外部ショップ価格</span>
									<input type="number" id="ext-tuxedo" value="60000" step="5000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">式場持ち込み料</span>
									<input type="number" id="fee-tuxedo" value="30000" step="5000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
							</div>
						</div>

						<!-- Item 3: Photographer -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
								<label style="font-size: 0.92rem; font-weight: 800; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
									<input type="checkbox" id="check-photo" checked style="width: 16px; height: 16px; accent-color: #2563EB;" />
									<span>📷 スナップカメラマン指名</span>
								</label>
								<span id="diff-photo" style="font-size: 0.80rem; font-weight: 800; color: #059669; background: #ECFDF5; padding: 2px 6px; border-radius: 4px;">
									60,000円 節約
								</span>
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; font-size: 0.75rem;">
								<div>
									<span style="color: var(--text-secondary); display: block;">式場提携撮影</span>
									<input type="number" id="venue-photo" value="210000" step="10000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">外部プロ指名</span>
									<input type="number" id="ext-photo" value="100000" step="10000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">式場持ち込み料</span>
									<input type="number" id="fee-photo" value="50000" step="5000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
							</div>
						</div>

						<!-- Item 4: Paper Items -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
								<label style="font-size: 0.92rem; font-weight: 800; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
									<input type="checkbox" id="check-paper" checked style="width: 16px; height: 16px; accent-color: #2563EB;" />
									<span>💌 ペーパーアイテム一式（招待状・席次表・席札）</span>
								</label>
								<span id="diff-paper" style="font-size: 0.80rem; font-weight: 800; color: #059669; background: #ECFDF5; padding: 2px 6px; border-radius: 4px;">
									80,000円 節約
								</span>
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; font-size: 0.75rem;">
								<div>
									<span style="color: var(--text-secondary); display: block;">式場印刷（60名分）</span>
									<input type="number" id="venue-paper" value="100000" step="5000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">Canva自作＆印刷</span>
									<input type="number" id="ext-paper" value="20000" step="2000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">式場持ち込み料</span>
									<input type="number" id="fee-paper" value="0" step="1000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;" />
								</div>
							</div>
						</div>

						<!-- Item 5: Movie Video -->
