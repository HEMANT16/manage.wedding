							「引き出物宅配便（ヒキタク / ギフトナビ等）」を利用することです。式場内に紙袋を持ち込まず、挙式翌日以降にゲストの自宅へ直接配送するため、式場の持ち込み料が一切発生しません。ゲストも重い荷物を持たずに帰れるため非常に好評です。
						</p>
					</details>

					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							持ち込み料の免除交渉はどのように行えば良いですか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							必ず「式場契約書にサインする直前」に交渉します。「こちらの会場が第一候補なのですが、母の着たいドレス（または知人のプロカメラマン）があり、ドレスとカメラマンの持ち込み料を無料にしていただけるなら、本日即決で契約します」と伝えるのが最も成功率の高い交渉術です。
						</p>
					</details>
				</div>
			</div>

			<!-- Related Tools Navigation -->
			<div style="border-top: 2px dashed #e2e8f0; padding-top: 2.5rem;">
				<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); text-align: center; margin-bottom: 1.25rem;">
					あわせて使いたい！費用関連の計算ツール
				</h2>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
					<a href="/ja/jiko-futangaku-calculator" class="hand-card" style="background: #fff; padding: 1.25rem; text-decoration: none; color: inherit; border: 2px solid var(--fg-pencil); box-shadow: 3px 3px 0px var(--fg-pencil);">
						<div style="font-size: 0.75rem; font-weight: 800; color: #1E40AF; margin-bottom: 0.25rem;">手出し額計算</div>
						<div style="font-size: 1.05rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.35rem;">💰 自己負担額シミュレーター</div>
						<div style="font-size: 0.82rem; color: var(--text-secondary);">ご祝儀と親援助を相殺して貯金持ち出し額を計算 →</div>
					</a>

					<a href="/ja/mitsumori-jump-calculator" class="hand-card" style="background: #fff; padding: 1.25rem; text-decoration: none; color: inherit; border: 2px solid var(--fg-pencil); box-shadow: 3px 3px 0px var(--fg-pencil);">
						<div style="font-size: 0.75rem; font-weight: 800; color: #DC2626; margin-bottom: 0.25rem;">値上がり防止</div>
						<div style="font-size: 1.05rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.35rem;">📈 見積もり跳ね上がり予測計算機</div>
						<div style="font-size: 0.82rem; color: var(--text-secondary);">ドレス・料理・映像の追加料金を事前予測 →</div>
					</a>

					<a href="/ja/hikidemono-calculator" class="hand-card" style="background: #fff; padding: 1.25rem; text-decoration: none; color: inherit; border: 2px solid var(--fg-pencil); box-shadow: 3px 3px 0px var(--fg-pencil);">
						<div style="font-size: 0.75rem; font-weight: 800; color: #3730A3; margin-bottom: 0.25rem;">マナー対応</div>
						<div style="font-size: 1.05rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.35rem;">🎁 引き出物・引き菓子 予算計算機</div>
						<div style="font-size: 0.82rem; color: var(--text-secondary);">10%ルールに基づくギフト＋引き菓子の適正個数 →</div>
					</a>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Client Script for Calculator -->
	<script is:inline>
		const items = [
			{ id: 'dress', check: 'check-dress', venue: 'venue-dress', ext: 'ext-dress', fee: 'fee-dress', diff: 'diff-dress' },
			{ id: 'tuxedo', check: 'check-tuxedo', venue: 'venue-tuxedo', ext: 'ext-tuxedo', fee: 'fee-tuxedo', diff: 'diff-tuxedo' },
			{ id: 'photo', check: 'check-photo', venue: 'venue-photo', ext: 'ext-photo', fee: 'fee-photo', diff: 'diff-photo' },
			{ id: 'paper', check: 'check-paper', venue: 'venue-paper', ext: 'ext-paper', fee: 'fee-paper', diff: 'diff-paper' },
			{ id: 'movie', check: 'check-movie', venue: 'venue-movie', ext: 'ext-movie', fee: 'fee-movie', diff: 'diff-movie' }
		];

		const resVenueTotal = document.getElementById('res-venue-total');
		const resExtTotal = document.getElementById('res-ext-total');
		const resNetSavings = document.getElementById('res-net-savings');
		const mochikomiBadge = document.getElementById('mochikomi-status-badge');

		const barVenue = document.getElementById('bar-venue');
		const barExt = document.getElementById('bar-ext');

		const resetBtn = document.getElementById('reset-mochikomi-btn');
		const printBtn = document.getElementById('print-mochikomi-sheet-btn');

		function calculateMochikomi() {
			let totalVenue = 0;
			let totalExt = 0;

			items.forEach(item => {
				const isChecked = document.getElementById(item.check)?.checked;
				const vVal = parseFloat(document.getElementById(item.venue)?.value || '0');
				const eVal = parseFloat(document.getElementById(item.ext)?.value || '0');
				const fVal = parseFloat(document.getElementById(item.fee)?.value || '0');

				const itemDiffDisplay = document.getElementById(item.diff);

				if (isChecked) {
					totalVenue += vVal;
					const combinedExt = eVal + fVal;
					totalExt += combinedExt;
					const itemSavings = vVal - combinedExt;

					if (itemDiffDisplay) {
						if (itemSavings > 0) {
							itemDiffDisplay.textContent = `${itemSavings.toLocaleString('ja-JP')}円 節約`;
							itemDiffDisplay.style.color = '#059669';
							itemDiffDisplay.style.background = '#ECFDF5';
						} else if (itemSavings === 0) {
							itemDiffDisplay.textContent = '同額 (±0円)';
							itemDiffDisplay.style.color = '#4B5563';
							itemDiffDisplay.style.background = '#F3F4F6';
						} else {
							const loss = Math.abs(itemSavings);
							itemDiffDisplay.textContent = `式場の方が${loss.toLocaleString('ja-JP')}円安い`;
							itemDiffDisplay.style.color = '#DC2626';
							itemDiffDisplay.style.background = '#FEF2F2';
						}
					}
				} else {
					if (itemDiffDisplay) {
						itemDiffDisplay.textContent = '対象外';
						itemDiffDisplay.style.color = '#9CA3AF';
						itemDiffDisplay.style.background = '#F3F4F6';
					}
				}
			});

			const netSavings = totalVenue - totalExt;

			// Update Text Outputs
			if (resVenueTotal) resVenueTotal.textContent = `${totalVenue.toLocaleString('ja-JP')} 円`;
			if (resExtTotal) resExtTotal.textContent = `${totalExt.toLocaleString('ja-JP')} 円`;

			if (resNetSavings) {
				if (netSavings > 0) {
					resNetSavings.textContent = `+ ${netSavings.toLocaleString('ja-JP')} 円 お得！`;
					resNetSavings.style.color = '#059669';
				} else if (netSavings === 0) {
					resNetSavings.textContent = `± 0 円（同額）`;
					resNetSavings.style.color = '#4B5563';
				} else {
					const loss = Math.abs(netSavings);
					resNetSavings.textContent = `- ${loss.toLocaleString('ja-JP')} 円（式場が安い）`;
					resNetSavings.style.color = '#DC2626';
				}
			}

			// Badge Status
			if (mochikomiBadge) {
				if (netSavings >= 100000) {
					mochikomiBadge.textContent = `🎉 持ち込み大成功！大幅な節約（約${Math.round(netSavings/10000)}万円）になります。`;
					mochikomiBadge.style.background = '#D1FAE5';
					mochikomiBadge.style.borderColor = '#6EE7B7';
					mochikomiBadge.style.color = '#065F46';
				} else if (netSavings > 0) {
					mochikomiBadge.textContent = `◯ 持ち込みがお得（約${netSavings.toLocaleString('ja-JP')}円の節約）。`;
					mochikomiBadge.style.background = '#EFF6FF';
					mochikomiBadge.style.borderColor = '#BFDBFE';
					mochikomiBadge.style.color = '#1E40AF';
				} else {
					mochikomiBadge.textContent = `⚠️ 式場手配の方がお得です（持ち込み料で割高になります）。`;
					mochikomiBadge.style.background = '#FEF2F2';
					mochikomiBadge.style.borderColor = '#FCA5A5';
					mochikomiBadge.style.color = '#991B1B';
				}
			}

			// Comparison Bars
			if (barVenue && barExt && totalVenue > 0) {
				const pctExt = Math.min(100, Math.round((totalExt / totalVenue) * 100));
				barExt.style.width = `${pctExt}%`;
				barExt.textContent = `${pctExt}% (${totalExt.toLocaleString('ja-JP')}円)`;
			}
		}

		// Attach Event Listeners
		items.forEach(item => {
			const chk = document.getElementById(item.check);
			const v = document.getElementById(item.venue);
			const e = document.getElementById(item.ext);
			const f = document.getElementById(item.fee);

			if (chk) chk.addEventListener('change', calculateMochikomi);
			if (v) v.addEventListener('input', calculateMochikomi);
			if (e) e.addEventListener('input', calculateMochikomi);
			if (f) f.addEventListener('input', calculateMochikomi);
		});

		// Reset Button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				document.getElementById('check-dress').checked = true;
				document.getElementById('venue-dress').value = '350000';
				document.getElementById('ext-dress').value = '150000';
				document.getElementById('fee-dress').value = '50000';

				document.getElementById('check-tuxedo').checked = true;
				document.getElementById('venue-tuxedo').value = '150000';
				document.getElementById('ext-tuxedo').value = '60000';
				document.getElementById('fee-tuxedo').value = '30000';

				document.getElementById('check-photo').checked = true;
				document.getElementById('venue-photo').value = '210000';
				document.getElementById('ext-photo').value = '100000';
				document.getElementById('fee-photo').value = '50000';

				document.getElementById('check-paper').checked = true;
				document.getElementById('venue-paper').value = '100000';
				document.getElementById('ext-paper').value = '20000';
				document.getElementById('fee-paper').value = '0';

				document.getElementById('check-movie').checked = true;
				document.getElementById('venue-movie').value = '160000';
				document.getElementById('ext-movie').value = '20000';
				document.getElementById('fee-movie').value = '0';

				calculateMochikomi();
			});
		}

		// Print Button
		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Initial Run
		calculateMochikomi();
	</script>

</Layout>
