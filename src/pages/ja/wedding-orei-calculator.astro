---
import Layout from '../../layouts/Layout.astro';

const title = "【結婚式 お礼・心付け 相場計算機】受付・主賓・スピーチ・ヘアメイクへの謝礼と封筒リスト (無料) | Manage.Wedding 日本版";
const description = "受付（3〜5千円）、主賓（1〜3万円）、スピーチ、ヘアメイク、介添え、カメラマンへの謝礼・心付け相場を自動計算。総合計額、銀行で準備すべき新札枚数（1万円/5千円/千円）、祝儀袋・ポチ袋の必要枚数を瞬時にリストアップ。完全無料・登録不要・A4/PDF印刷対応。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/wedding-orei-calculator#app",
      "name": "結婚式 お礼・心付け 相場計算機",
      "url": "https://manage.wedding/ja/wedding-orei-calculator",
      "description": "結婚式でお世話になる主賓、受付、友人スピーチ、ヘアメイク、カメラマンなどへの御礼・心付け金額と新札枚数・封筒リストを自動計算するツール。",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "結婚式のお礼・心付けを準備する4つの手順",
      "description": "役割別の相場を確認し、新札と封筒を用意して当日スマートにお渡しするまでの手順。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "依頼する役割と人数をリストアップする",
          "text": "主賓、乾杯発声、受付担当、スピーチ・余興、ヘアメイク、介添え、カメラマンなどのお礼対象者を整理します。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "役割別の相場金額を設定する",
          "text": "主賓（1万〜3万円）、受付（3千〜5千円）、ヘアメイク（3千〜1万円）など、相場に基づき1人あたりの金額を決めます。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "銀行で新札に両替し、封筒（祝儀袋・ポチ袋）に包む",
          "text": "必要な1万円札・5千円札・千円札の枚数を把握し、銀行で新札を用意。金額に合った封筒に表書きをして包みます。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "誰からいつ渡すかの担当者を決める",
          "text": "受付や主賓への御礼は親から、スタッフへの心付けは新郎新婦または親から、渡すタイミングをタイムスケジュールに組み込みます。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "「お礼」と「心付け」の違いは何ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「お礼（御礼）」は、主賓祝辞や受付、スピーチなどを引き受けてくれた「ゲスト」に対する感謝の謝礼です。「心付け」は、ヘアメイクや介添え、カメラマンなど、結婚式を裏方として支えてくれる「スタッフ」への感謝の気持ち（謝礼）として渡すお金です。"
          }
        },
        {
          "@type": "Question",
          "name": "式場スタッフへの「心付け」は絶対に渡さないといけませんか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "心付けはあくまで「感謝の気持ち（任意）」であり、必須ではありません。最近のホテルや専門式場では「サービス料を頂戴しているため、スタッフへの心付けは一切辞退いたします」という規約の会場も増えています。迷った場合は、菓子折りを差し入れるのも好印象です。"
          }
        },
        {
          "@type": "Question",
          "name": "受付をしてくれた友人へのお礼はいくら包むべきですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "受付は通常2名（新郎側1名・新婦側1名）に依頼し、1人あたり「3,000円〜5,000円」が相場です。おしゃれなポチ袋に新札を入れて、受付開始前に新郎新婦の親から「本日はよろしくお願いいたします」と手渡すのが最も丁寧なマナーです。"
          }
        },
        {
          "@type": "Question",
          "name": "お礼・心付けの封筒の表書きには何と書きますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ゲストへの謝礼には「御礼」、スタッフへの心付けには「御礼」または「寿」「お心づけ」と書きます。目下の人から目上の人へ渡す際に「寸志」と書くのはマナー違反ですので注意してください。下段には両家の姓（または新郎新婦の姓）を記入します。"
          }
        },
        {
          "@type": "Question",
          "name": "お礼に包むお札は新札（ピン札）でなければいけませんか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "はい、結婚式のような慶事でお渡しするお金は、金額の多寡にかかわらずすべて「新札（ピン札）」を用意するのが鉄則です。銀行の窓口や両替機で挙式の1〜2週間前にまとめて新札を確保しておきましょう。"
          }
        }
      ]
    }
  ]
};

const oreiNorms = [
  { role: "🎤 主賓・祝辞のお願い", amount: "10,000 〜 30,000円", envelope: "結び切り祝儀袋（御車代/御礼）", timing: "挙式前、新郎新婦の親から手渡し", note: "遠方の場合はお車代と合算して包む" },
  { role: "🥂 乾杯のご発声", amount: "10,000 〜 20,000円", envelope: "結び切り祝儀袋（御礼）", timing: "挙式前、新郎新婦の親から手渡し", note: "主賓と同格として丁寧に対応" },
  { role: "🧑‍💼 受付担当の友人", amount: "3,000 〜 5,000円", envelope: "ポチ袋（御礼 / お礼）", timing: "受付開始前、親から手渡し", note: "通常2名（新郎側1名＋新婦側1名）" },
  { role: "🎤 スピーチ・余興の友人", amount: "3,000 〜 5,000円 or ギフト", envelope: "ポチ袋 / ギフトカード", timing: "披露宴お見送り時、新郎新婦から", note: "後日食事をごちそうするのも◎" },
  { role: "💇 ヘアメイク・着付けスタッフ", amount: "3,000 〜 10,000円（心付け）", envelope: "ポチ袋（御礼/お心づけ）", timing: "お支度開始時、新婦から直接", note: "式場規定で辞退される場合あり" },
  { role: "👰 介添えスタッフ（アテンダー）", amount: "3,000 〜 5,000円（心付け）", envelope: "ポチ袋（お心づけ）", timing: "挙式前、新婦または親から", note: "一日付き添ってくれる感謝として" },
  { role: "📷 カメラマン（写真・ビデオ）", amount: "3,000 〜 5,000円（心付け）", envelope: "ポチ袋（お心づけ）", timing: "撮影開始前の挨拶時", note: "外注プロカメラマンへの差し入れも喜ばれる" },
  { role: "🎵 司会者（友人に依頼した場合）", amount: "20,000 〜 30,000円 ＋ ギフト", envelope: "結び切り祝儀袋（御礼）", timing: "披露宴前後に親または新郎新婦から", note: "プロ外注時はプラン内（追加不要）" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<a href="/ja/goshugi" style="color: #2563EB; text-decoration: none; font-weight: 600;">ご祝儀・お車代・お礼</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">お礼・心付け 相場計算機</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #DCFCE7; border: 1.5px solid #86EFAC; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #166534; margin-bottom: 0.75rem;">
						<span>🧧</span>
						<span>謝礼マナー＆封筒準備ツール</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						結婚式 お礼・心付け<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">相場計算機＆封筒リスト</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						主賓、受付、友人スピーチ、ヘアメイク、カメラマンへのお礼・心付け相場を自動計算。<strong>当日に必要な現金の総合計、銀行で両替すべき新札枚数（1万円/5千円/千円）、封筒準備リスト</strong>を瞬時に導き出します。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 40%;"></div>
						<img 
							src="/images/ja_orei_flatlay.webp" 
							alt="お礼のポチ袋と新札・ホワイトピオニーの上品なフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							🧧 支えてくれた方々へ、感謝が伝わる新札準備。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Calculator Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
							🧮 お礼・心付け 役割別シミュレーター
						</h2>
						<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
							お礼を渡す役割にチェックを入れ、人数と金額を調整してください。
						</p>
					</div>
					<button id="reset-orei-btn" type="button" style="font-size: 0.80rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
						🔄 初期値に戻す
					</button>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem;">
					
					<!-- Left Form: Role Items -->
					<div style="display: flex; flex-direction: column; gap: 1rem;">
						
						<!-- Item 1: 主賓 -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
								<label style="font-size: 0.90rem; font-weight: 800; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
									<input type="checkbox" id="chk-shuhin" checked style="width: 16px; height: 16px; accent-color: #2563EB;" />
									<span>🎤 主賓・祝辞のお願い</span>
								</label>
								<div style="display: flex; align-items: center; gap: 0.25rem;">
									<input type="number" id="cnt-shuhin" value="1" min="0" max="10" style="width: 45px; padding: 2px 4px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
									<span style="font-size: 0.78rem;">名</span>
								</div>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem;">
								<span style="color: var(--text-secondary);">1人あたり金額</span>
								<div style="display: flex; align-items: center; gap: 0.25rem;">
									<span>¥</span>
									<input type="number" id="amt-shuhin" value="20000" step="5000" style="width: 90px; padding: 3px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; text-align: right;" />
								</div>
							</div>
						</div>

						<!-- Item 2: 乾杯 -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
								<label style="font-size: 0.90rem; font-weight: 800; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
									<input type="checkbox" id="chk-kanpai" checked style="width: 16px; height: 16px; accent-color: #2563EB;" />
									<span>🥂 乾杯のご発声</span>
								</label>
								<div style="display: flex; align-items: center; gap: 0.25rem;">
									<input type="number" id="cnt-kanpai" value="1" min="0" max="10" style="width: 45px; padding: 2px 4px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
									<span style="font-size: 0.78rem;">名</span>
								</div>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem;">
								<span style="color: var(--text-secondary);">1人あたり金額</span>
								<div style="display: flex; align-items: center; gap: 0.25rem;">
									<span>¥</span>
									<input type="number" id="amt-kanpai" value="10000" step="5000" style="width: 90px; padding: 3px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; text-align: right;" />
								</div>
							</div>
						</div>

						<!-- Item 3: 受付 -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
								<label style="font-size: 0.90rem; font-weight: 800; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
									<input type="checkbox" id="chk-uketsuke" checked style="width: 16px; height: 16px; accent-color: #2563EB;" />
									<span>🧑‍💼 受付担当の友人</span>
								</label>
								<div style="display: flex; align-items: center; gap: 0.25rem;">
									<input type="number" id="cnt-uketsuke" value="2" min="0" max="10" style="width: 45px; padding: 2px 4px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
									<span style="font-size: 0.78rem;">名</span>
								</div>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem;">
								<span style="color: var(--text-secondary);">1人あたり金額</span>
								<div style="display: flex; align-items: center; gap: 0.25rem;">
									<span>¥</span>
									<input type="number" id="amt-uketsuke" value="5000" step="1000" style="width: 90px; padding: 3px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; text-align: right;" />
								</div>
							</div>
						</div>

						<!-- Item 4: スピーチ・余興 -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
								<label style="font-size: 0.90rem; font-weight: 800; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
									<input type="checkbox" id="chk-speech" checked style="width: 16px; height: 16px; accent-color: #2563EB;" />
									<span>🎤 スピーチ・余興の友人</span>
								</label>
								<div style="display: flex; align-items: center; gap: 0.25rem;">
									<input type="number" id="cnt-speech" value="2" min="0" max="20" style="width: 45px; padding: 2px 4px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
									<span style="font-size: 0.78rem;">名</span>
								</div>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem;">
								<span style="color: var(--text-secondary);">1人あたり金額</span>
								<div style="display: flex; align-items: center; gap: 0.25rem;">
									<span>¥</span>
									<input type="number" id="amt-speech" value="3000" step="1000" style="width: 90px; padding: 3px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; text-align: right;" />
								</div>
							</div>
						</div>

						<!-- Item 5: ヘアメイク -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
								<label style="font-size: 0.90rem; font-weight: 800; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
									<input type="checkbox" id="chk-hair" checked style="width: 16px; height: 16px; accent-color: #2563EB;" />
									<span>💇 ヘアメイク・着付けスタッフ（心付け）</span>
								</label>
								<div style="display: flex; align-items: center; gap: 0.25rem;">
									<input type="number" id="cnt-hair" value="2" min="0" max="10" style="width: 45px; padding: 2px 4px; font-weight: 700; border: 1px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
									<span style="font-size: 0.78rem;">名</span>
								</div>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem;">
								<span style="color: var(--text-secondary);">1人あたり金額</span>
