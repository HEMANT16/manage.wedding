						<div style="font-size: 0.75rem; font-weight: 800; color: #3730A3; margin-bottom: 0.25rem;">中袋の書き方</div>
						<div style="font-size: 1.05rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.35rem;">🖋️ 漢数字（大字）変換ジェネレーター</div>
						<div style="font-size: 0.82rem; color: var(--text-secondary);">3万円→金 参萬圓 也を即時縦書きプレビュー →</div>
					</a>

					<a href="/ja/jiko-futangaku-calculator" class="hand-card" style="background: #fff; padding: 1.25rem; text-decoration: none; color: inherit; border: 2px solid var(--fg-pencil); box-shadow: 3px 3px 0px var(--fg-pencil);">
						<div style="font-size: 0.75rem; font-weight: 800; color: #1E40AF; margin-bottom: 0.25rem;">自己負担計算</div>
						<div style="font-size: 1.05rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.35rem;">💰 自己負担額シミュレーター</div>
						<div style="font-size: 0.82rem; color: var(--text-secondary);">ご祝儀相殺後のリアル手出し額を計算 →</div>
					</a>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Client Script for Calculator -->
	<script is:inline>
		const roleItems = [
			{ chk: 'chk-shuhin', cnt: 'cnt-shuhin', amt: 'amt-shuhin' },
			{ chk: 'chk-kanpai', cnt: 'cnt-kanpai', amt: 'amt-kanpai' },
			{ chk: 'chk-uketsuke', cnt: 'cnt-uketsuke', amt: 'amt-uketsuke' },
			{ chk: 'chk-speech', cnt: 'cnt-speech', amt: 'amt-speech' },
			{ chk: 'chk-hair', cnt: 'cnt-hair', amt: 'amt-hair' },
			{ chk: 'chk-attender', cnt: 'cnt-attender', amt: 'amt-attender' },
			{ chk: 'chk-photo', cnt: 'cnt-photo', amt: 'amt-photo' }
		];

		const resOreiTotal = document.getElementById('res-orei-total');
		const resOrei10k = document.getElementById('res-orei-10k');
		const resOrei5k = document.getElementById('res-orei-5k');
		const resOrei1k = document.getElementById('res-orei-1k');
		const resOreiShugi = document.getElementById('res-orei-shugi');
		const resOreiPochi = document.getElementById('res-orei-pochi');

		const resetBtn = document.getElementById('reset-orei-btn');
		const printBtn = document.getElementById('print-orei-btn');

		function calculateOrei() {
			let total = 0;
			let count10k = 0;
			let count5k = 0;
			let count1k = 0;
			let countShugi = 0;
			let countPochi = 0;

			roleItems.forEach(item => {
				const isChecked = document.getElementById(item.chk)?.checked;
				const count = parseInt(document.getElementById(item.cnt)?.value || '0', 10);
				const amount = parseFloat(document.getElementById(item.amt)?.value || '0');

				if (isChecked && count > 0 && amount > 0) {
					total += count * amount;

					// Bill Breakdown per person
					const tens = Math.floor(amount / 10000);
					const remTen = amount % 10000;
					const fives = Math.floor(remTen / 5000);
					const remFive = remTen % 5000;
					const ones = Math.floor(remFive / 1000);

					count10k += tens * count;
					count5k += fives * count;
					count1k += ones * count;

					// Envelope type
					if (amount >= 10000) {
						countShugi += count;
					} else {
						countPochi += count;
					}
				}
			});

			if (resOreiTotal) resOreiTotal.textContent = `${total.toLocaleString('ja-JP')} 円`;
			if (resOrei10k) resOrei10k.textContent = count10k.toString();
			if (resOrei5k) resOrei5k.textContent = count5k.toString();
			if (resOrei1k) resOrei1k.textContent = count1k.toString();
			if (resOreiShugi) resOreiShugi.textContent = countShugi.toString();
			if (resOreiPochi) resOreiPochi.textContent = countPochi.toString();
		}

		// Attach Event Listeners
		roleItems.forEach(item => {
			const c = document.getElementById(item.chk);
			const n = document.getElementById(item.cnt);
			const a = document.getElementById(item.amt);

			if (c) c.addEventListener('change', calculateOrei);
			if (n) {
				n.addEventListener('input', calculateOrei);
				n.addEventListener('change', calculateOrei);
			}
			if (a) {
				a.addEventListener('input', calculateOrei);
				a.addEventListener('change', calculateOrei);
			}
		});

		// Reset Button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				document.getElementById('chk-shuhin').checked = true;
				document.getElementById('cnt-shuhin').value = '1';
				document.getElementById('amt-shuhin').value = '20000';

				document.getElementById('chk-kanpai').checked = true;
				document.getElementById('cnt-kanpai').value = '1';
				document.getElementById('amt-kanpai').value = '10000';

				document.getElementById('chk-uketsuke').checked = true;
				document.getElementById('cnt-uketsuke').value = '2';
				document.getElementById('amt-uketsuke').value = '5000';

				document.getElementById('chk-speech').checked = true;
				document.getElementById('cnt-speech').value = '2';
				document.getElementById('amt-speech').value = '3000';

				document.getElementById('chk-hair').checked = true;
				document.getElementById('cnt-hair').value = '2';
				document.getElementById('amt-hair').value = '5000';

				document.getElementById('chk-attender').checked = true;
				document.getElementById('cnt-attender').value = '1';
				document.getElementById('amt-attender').value = '5000';

				document.getElementById('chk-photo').checked = true;
				document.getElementById('cnt-photo').value = '1';
				document.getElementById('amt-photo').value = '5000';

				calculateOrei();
			});
		}

		// Print Button
		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Initial Run
		calculateOrei();
	</script>

</Layout>
