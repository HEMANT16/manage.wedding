	<!-- Interactive Client Script for Calculator -->
	<script is:inline>
		const selectSeason = document.getElementById('select-season');
		const selectDaytime = document.getElementById('select-daytime');
		const selectRokuyo = document.getElementById('select-rokuyo');
		const inputGuestCount = document.getElementById('input-guest-count');

		const resDiscountHero = document.getElementById('res-discount-hero');
		const resDiscountSub = document.getElementById('res-discount-sub');
		const resFortuneBox = document.getElementById('res-fortune-box');
		const resFortuneText = document.getElementById('res-fortune-text');
		const resFortuneDesc = document.getElementById('res-fortune-desc');
		const resParentAdvice = document.getElementById('res-parent-advice');

		const resetBtn = document.getElementById('reset-rokuyo-btn');
		const printBtn = document.getElementById('print-rokuyo-btn');

		function calculateRokuyo() {
			const season = selectSeason?.value || 'high';
			const daytime = selectDaytime?.value || 'sat_day';
			const rokuyo = selectRokuyo?.value || 'taian';
			const guests = parseInt(inputGuestCount?.value || '60', 10);

			let discount = 0;

			// Season Discount
			if (season === 'off') {
				discount += 300000 + (guests * 2000); // Off-season summer/winter
			} else if (season === 'mid') {
				discount += 100000 + (guests * 1000); // June / Dec
			}

			// Daytime Discount
			if (daytime === 'weekday') {
				discount += 350000;
			} else if (daytime === 'sun_night') {
				discount += 250000;
			} else if (daytime === 'sat_night' || daytime === 'sun_day') {
				discount += 100000;
			}

			// Rokuyo Discount
			if (rokuyo === 'butsumetsu') {
				discount += 400000;
			} else if (rokuyo === 'shakko' || rokuyo === 'senbu') {
				discount += 150000;
			} else if (rokuyo === 'sensho' && (daytime === 'sat_night' || daytime === 'sun_night')) {
				discount += 100000;
			}

			// Update Hero Discount Text
			if (resDiscountHero && resDiscountSub) {
				if (discount === 0) {
					resDiscountHero.textContent = '0 円（正規料金枠）';
					resDiscountHero.style.color = '#475569';
					resDiscountSub.textContent = '※ 最も人気の日程のため、割引特典は少なめです';
				} else {
					resDiscountHero.textContent = `約 ${discount.toLocaleString('ja-JP')} 円 引き`;
					resDiscountHero.style.color = '#059669';
					resDiscountSub.textContent = `※ 挙式料・衣装・料理特典等を含む想定節約総額（${guests}名規模）`;
				}
			}

			// Fortune Advice Matrix
			if (resFortuneBox && resFortuneText && resFortuneDesc && resParentAdvice) {
				if (rokuyo === 'taian') {
					resFortuneBox.style.background = '#FEF2F2';
					resFortuneBox.style.borderColor = '#FCA5A5';
					resFortuneText.textContent = '💮 終日大吉（結婚式に最も安心のお日柄）';
					resFortuneText.style.color = '#991B1B';
					resFortuneDesc.textContent = '万事に大吉。親族・上司・友人すべてのゲスト受けが抜群です。';
					resParentAdvice.textContent = '親御様への相談も極めてスムーズ。「この日で進めたい」と報告すれば大賛成されます。';
				} else if (rokuyo === 'tomobiki') {
					resFortuneBox.style.background = '#EFF6FF';
					resFortuneBox.style.borderColor = '#93C5FD';
					resFortuneText.textContent = '🤝 大吉日（友に幸せをお裾分けする縁起良し）';
					resFortuneText.style.color = '#1E40AF';
					resFortuneDesc.textContent = '大安に次ぐ大人気。※正午（11〜13時）のみ凶のため、午前開始または午後14時開始がベスト。';
					resParentAdvice.textContent = '「友引で友人に幸せを分ける良い日柄」と説明すれば、親御様も快くご納得いただけます。';
				} else if (rokuyo === 'sensho') {
					resFortuneBox.style.background = '#ECFDF5';
					resFortuneBox.style.borderColor = '#86EFAC';
					resFortuneText.textContent = '🏃 午前中が大吉（先んずれば勝つ）';
					resFortuneText.style.color = '#166534';
					resFortuneDesc.textContent = '14時までに挙式をスタートすれば終日吉となります。午前挙式プランとの相性抜群です。';
					resParentAdvice.textContent = '「先勝なので午前中から挙式をスタートします」とタイムスケジュールを添えて伝えると好印象です。';
				} else if (rokuyo === 'senbu') {
					resFortuneBox.style.background = '#FFFBEB';
					resFortuneBox.style.borderColor = '#FDE047';
					resFortuneText.textContent = '⏳ 午後（14時以降）が大吉（先んずれば負ける）';
					resFortuneText.style.color = '#854D0E';
					resFortuneDesc.textContent = '午前は控えめに、午後のトワイライト挙式やディナータイム披露宴に最適なお日柄です。';
					resParentAdvice.textContent = '「先負なので午後からの吉の時間帯に合わせました」と説明すると納得が得られやすいです。';
				} else if (rokuyo === 'shakko') {
					resFortuneBox.style.background = '#F5F3FF';
					resFortuneBox.style.borderColor = '#C4B5FD';
					resFortuneText.textContent = '⚠️ 正午（11時〜13時）のみ吉 / 朝夕は凶';
					resFortuneText.style.color = '#5B21B6';
					resFortuneDesc.textContent = 'ランチタイム挙式が狙い目。お日柄値引きが期待できる日程です。';
					resParentAdvice.textContent = '日柄を気にする親御様には「正午の吉の時間に挙式を行う」または入籍日を大安にする旨を伝えましょう。';
				} else if (rokuyo === 'butsumetsu') {
					resFortuneBox.style.background = '#F8FAFC';
					resFortuneBox.style.borderColor = '#CBD5E1';
					resFortuneText.textContent = '🏷️ 仏滅（最大割引適用・コスパ最高枠）';
					resFortuneText.style.color = '#334155';
					resFortuneDesc.textContent = '「物滅」から新しく始める前向きな解釈も。浮いた予算を料理やドレスのグレードアップに投資可能。';
					resParentAdvice.textContent = '「仏滅プランで80万円浮いた分、ゲストのお料理を最高ランクにしました」と伝えると親御様も納得しやすいです。';
				}
			}
		}

		// Attach Event Listeners
		[selectSeason, selectDaytime, selectRokuyo, inputGuestCount].forEach(el => {
			if (el) {
				el.addEventListener('change', calculateRokuyo);
				el.addEventListener('input', calculateRokuyo);
			}
		});

		// Reset Button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (selectSeason) selectSeason.value = 'high';
				if (selectDaytime) selectDaytime.value = 'sat_day';
				if (selectRokuyo) selectRokuyo.value = 'taian';
				if (inputGuestCount) inputGuestCount.value = '60';

				calculateRokuyo();
			});
		}

		// Print Button
		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Dynamic Share Text Formatter for LINE & Clipboard
		window.getJaLiveShareText = function() {
			const seasonMap = {
				high: '春・秋ハイシーズン（3〜5月 / 9〜11月・気候最高・定価）',
				mid: '初夏・初冬（6月 / 12月・ジューンブライド / 微割）',
				off: '夏・冬オフシーズン（7〜8月 / 1〜2月・大幅割引期）'
			};
			const daytimeMap = {
				sat_day: '土曜日 昼の部（11〜15時・最も人気・定価）',
				sat_night: '土曜日 夜の部 / ナイト（16時〜・トワイライト割）',
				sun_day: '日曜日 昼の部（11〜15時）',
				sun_night: '日曜日 夜の部（16時〜・大幅割引枠）',
				weekday: '平日挙式（お得プラン多数）'
			};
			const rokuyoMap = {
				taian: '大安（たいあん・終日大吉）',
				tomobiki: '友引（ともびき・朝夕吉 / 正午凶）',
				sensho: '先勝（せんしょう・午前吉 / 午後凶）',
				senbu: '先負（せんぶ・午前凶 / 午後吉）',
				shakko: '赤口（しゃっく・正午のみ吉）',
				butsumetsu: '仏滅（ぶつめつ・最大割引適用日）'
			};

			const seasonVal = selectSeason ? selectSeason.value : 'high';
			const daytimeVal = selectDaytime ? selectDaytime.value : 'sat_day';
			const rokuyoVal = selectRokuyo ? selectRokuyo.value : 'taian';
			const guests = inputGuestCount ? inputGuestCount.value : '60';

			const discountText = resDiscountHero ? resDiscountHero.textContent.trim() : '0 円';
			const fortuneText = resFortuneText ? resFortuneText.textContent.trim() : '';

			return [
				'【結婚式 六曜・お日柄＆式場割引診断メモ】',
				'--------------------------------',
				`■ 挙式希望時期: ${seasonMap[seasonVal] || seasonVal}`,
				`■ 希望曜日・時間帯: ${daytimeMap[daytimeVal] || daytimeVal}`,
				`■ 六曜（お日柄）: ${rokuyoMap[rokuyoVal] || rokuyoVal}`,
				`■ 想定規模: ゲスト ${guests} 名`,
				`■ お日柄評価: ${fortuneText}`,
				`■ 式場見積もり割引見込み: ${discountText}`,
				'--------------------------------',
				'#プレ花嫁 #結婚式準備 #六曜 #大安 #仏滅割 #ManageWedding',
				'\n▼ ツールで確認する\nhttps://manage.wedding/ja/rokuyo-wedding-calendar'
			].join('\n');
		};

		// Initial Run
		calculateRokuyo();
	</script>

</Layout>
