---
import Layout from '../../layouts/Layout.astro';
import JaShareActionBar from '../../components/ja/JaShareActionBar.astro';

const title = "【六曜カレンダー＆大安・仏滅 割引比較チェッカー】結婚式のお日柄・値引き診断 (無料) | Manage.Wedding 日本版";
const description = "2026/2027年 六曜（大安・友引・先勝・先負・赤口・仏滅）カレンダー。大安土曜日の人気日程と仏滅・日曜夕方のお得な値引き額（最大100万円OFF）をシミュレーション比較。時間帯別の吉凶判定や親世代への相談マナーも完全網羅。完全無料・登録不要・A4/PDF印刷対応。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/rokuyo-wedding-calendar#app",
      "name": "六曜カレンダー＆大安・仏滅 割引比較チェッカー",
      "url": "https://manage.wedding/ja/rokuyo-wedding-calendar",
      "description": "結婚式の日程選びにおける六曜（大安・友引・先勝・先負・赤口・仏滅）の吉凶判定と、お日柄・シーズン・曜日別の式場割引額を比較診断するツール。",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "結婚式のお日柄と割引日程を選ぶ4つのステップ",
      "description": "六曜の意味を理解し、予算と親世代の意向を両立させた日程決定の手順。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "希望する季節（ハイシーズン vs オフシーズン）を決める",
          "text": "気候が良い春（3〜5月）・秋（9〜11月）か、割引特典が大きい夏（7〜8月）・冬（1〜2月）かを検討します。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "六曜（大安・友引・仏滅等）と時間帯の組み合わせを確認する",
          "text": "大安・友引だけでなく、先勝の午前中や先負の午後など、時間帯によって吉となるお日柄をチェックします。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "仏滅割引やナイトウェディング割引の金額を比較する",
          "text": "仏滅や日曜夜、オフシーズンを選ぶことで受けられる見積もり割引額（30万〜100万円）を試算します。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "両家の親御様にお日柄の意向を相談する",
          "text": "日程を最終決定する前に、お日柄にこだわりがあるかを両家の親に確認し、納得を得た上で契約します。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "仏滅（ぶつめつ）に結婚式を挙げるのは本当に不吉ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "六曜は中国発祥の民間信仰・賭け事の吉凶占いが起源であり、仏教や神道などの宗教とは一切関係がありません。近年では「物滅（これまでの関係が一度滅び、新しくスタートする）」と前向きに解釈され、大幅な割引特典が受けられることから合理的に仏滅を選ぶカップルも約15%存在します。"
          }
        },
        {
          "@type": "Question",
          "name": "仏滅に結婚式を挙げると式場費用はどれくらい安くなりますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "大安の土曜日昼（定価）と比較して、仏滅プランでは挙式料無料、ドレス1着プレゼント、料理ワンランクアップなどの特典がつき、総額で30万円〜100万円ほど安くなるケースが一般的です。"
          }
        },
        {
          "@type": "Question",
          "name": "「友引（ともびき）」はお葬式だけでなく結婚式でも注意が必要ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "友引は「友に幸せをお裾分けする」という意味で、結婚式では大安に次ぐ大吉日です。ただし、時間帯としては「朝夕は吉、正午（11時〜13時）のみ凶」とされているため、挙式開始を午前中または14時以降に設定するのがより好ましいとされています。"
          }
        },
        {
          "@type": "Question",
          "name": "親がお日柄（大安）に強くこだわる場合はどう説得すべきですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "親世代はお日柄を「ゲストへの礼儀」と捉えていることが多いため、無理に仏滅を強要するのは避けましょう。「先勝の午前中」や「友引の夕方」など吉の時間帯を提案するか、入籍日を「大安」にして挙式日はゲストが集まりやすい日程にするなどの折衷案が効果的です。"
          }
        },
        {
          "@type": "Question",
          "name": "結婚式に最も人気のある月と曜日はいつですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "気候が温暖で雨の少ない「10月・11月の秋」と「4月・5月の春」の「土曜日・大安（昼の部）」が全国で最も予約が集中する超激戦枠です。この枠は1年前から予約が埋まり、割引はほとんど適用されません。"
          }
        }
      ]
    }
  ]
};

const rokuyoDetails = [
  { 
    name: "大安（たいあん）", 
    timing: "終日吉（何をするにも最良の日）", 
    popularity: "★★★★★（人気No.1）", 
    rateDiff: "基準料金（割引なし / 予約最激戦）", 
    color: "#DC2626", 
    bg: "#FEF2F2",
    desc: "「大いに安し」の意味。終日万事において吉とされ、結婚式・結納・入籍のすべてで最も選ばれる王道のお日柄です。" 
  },
  { 
    name: "友引（ともびき）", 
    timing: "朝夕吉 / 正午（11〜13時）のみ凶", 
    popularity: "★★★★☆（大安に次ぐ人気）", 
    rateDiff: "小幅割引 or 演出特典", 
    color: "#2563EB", 
    bg: "#EFF6FF",
    desc: "「友に幸せを引き寄せる」として結婚式には大吉日。正午を避けて午前挙式または午後14時以降のスタートが理想的です。" 
  },
  { 
    name: "先勝（せんしょう）", 
    timing: "午前（14時まで）吉 / 午後凶", 
    popularity: "★★★☆☆（午前挙式で人気）", 
    rateDiff: "午前：定価 / 午後：〜15万円引", 
    color: "#059669", 
    bg: "#ECFDF5",
    desc: "「先んずれば即ち勝つ」の意味。午前中に挙式を開始すれば一日を通じて吉の恩恵を受けられます。" 
  },
  { 
    name: "先負（せんぶ）", 
    timing: "午前凶 / 午後（14時以降）吉", 
    popularity: "★★★☆☆（午後・ナイトに人気）", 
    rateDiff: "10万 〜 25万円引", 
    color: "#D97706", 
    bg: "#FFFBEB",
    desc: "「先んずれば即ち負ける」の意味。急用や午前を避け、午後のゆったりした時間帯や夕暮れのトワイライト挙式に最適です。" 
  },
  { 
    name: "赤口（しゃっく）", 
    timing: "正午（11〜13時）のみ吉 / 朝夕凶", 
    popularity: "★★☆☆☆（日柄不問派向け）", 
    rateDiff: "20万 〜 40万円引", 
    color: "#7C3AED", 
    bg: "#F5F3FF",
    desc: "「火と刃物に注意」とされる日。正午のランチタイム挙式にするか、親御様の意向を確認した上で日程選択を推奨します。" 
  },
  { 
    name: "仏滅（ぶつめつ）", 
    timing: "終日凶（※式場割引は最大！）", 
    popularity: "★☆☆☆☆（コスパ重視派に人気）", 
    rateDiff: "30万 〜 100万円引（大幅値引き）", 
    color: "#475569", 
    bg: "#F8FAFC",
    desc: "「物滅」から新しく始まる解釈も。式場の大幅な特典・値引きが狙えるため、浮いた予算を料理やハネムーンに回せます。" 
  }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<a href="/ja/schedule" style="color: #2563EB; text-decoration: none; font-weight: 600;">日程・準備</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">六曜カレンダー＆大安・仏滅 割引比較</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FEF3C7; border: 1.5px solid #FDE047; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #92400E; margin-bottom: 0.75rem;">
						<span>📅</span>
						<span>六曜カレンダー＆お日柄割引シミュレーター</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						六曜カレンダー＆大安・仏滅<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">式場割引・お日柄診断チェッカー</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						大安・友引の王道吉日から、最大100万円安くなる仏滅・オフシーズン割引まで。<strong>六曜ごとの時間帯別吉凶判定と、日程の選び方で変わる式場見積もりの差額</strong>を瞬時にシミュレーションします。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 40%;"></div>
						<img 
							src="/images/ja_rokuyo_flatlay.webp" 
							alt="結婚式の日程選びと六曜カレンダー・筆記具のフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							📅 お日柄と予算のベストバランスを見つけよう。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Calculator Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
							🧮 お日柄・日程 割引シミュレーター
						</h2>
						<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
							希望のシーズン、曜日・時間帯、六曜を選択して割引額と吉凶を診断します。
						</p>
					</div>
					<button id="reset-rokuyo-btn" type="button" style="font-size: 0.80rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
						🔄 初期値（大安土曜）に戻す
					</button>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem;">
					
					<!-- Left Form: Date Options -->
					<div style="display: flex; flex-direction: column; gap: 1.25rem;">
						
						<!-- 1. Season Selection -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<label for="select-season" style="font-size: 0.88rem; font-weight: 800; color: #2563EB; display: block; margin-bottom: 0.4rem;">
								1. 挙式シーズン（季節）
							</label>
							<select id="select-season" style="width: 100%; padding: 8px; font-size: 0.90rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
								<option value="high" selected>春・秋ハイシーズン（3〜5月 / 9〜11月・気候最高・定価）</option>
								<option value="mid">初夏・初冬（6月 / 12月・ジューンブライド / 微割）</option>
								<option value="off">夏・冬オフシーズン（7〜8月 / 1〜2月・大幅割引期）</option>
							</select>
						</div>

						<!-- 2. Day & Time Selection -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<label for="select-daytime" style="font-size: 0.88rem; font-weight: 800; color: #166534; display: block; margin-bottom: 0.4rem;">
								2. 曜日と時間帯
							</label>
							<select id="select-daytime" style="width: 100%; padding: 8px; font-size: 0.90rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
								<option value="sat_day" selected>土曜日 昼の部（11〜15時・最も人気・定価）</option>
								<option value="sat_night">土曜日 夜の部 / ナイト（16時〜・トワイライト割）</option>
								<option value="sun_day">日曜日 昼の部（11〜15時・翌日仕事考慮で微割）</option>
								<option value="sun_night">日曜日 夜の部（16時〜・大幅割引枠）</option>
								<option value="weekday">平日挙式（月〜金・超お得プラン多数）</option>
							</select>
						</div>

						<!-- 3. Rokuyo Selection -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<label for="select-rokuyo" style="font-size: 0.88rem; font-weight: 800; color: #DC2626; display: block; margin-bottom: 0.4rem;">
								3. 六曜（お日柄）
							</label>
							<select id="select-rokuyo" style="width: 100%; padding: 8px; font-size: 0.90rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
								<option value="taian" selected>💮 大安（たいあん・終日大吉）</option>
								<option value="tomobiki">🤝 友引（ともびき・朝夕吉 / 正午凶）</option>
								<option value="sensho">🏃 先勝（せんしょう・午前吉 / 午後凶）</option>
								<option value="senbu">⏳ 先負（せんぶ・午前凶 / 午後吉）</option>
								<option value="shakko">⚠️ 赤口（しゃっく・正午のみ吉）</option>
								<option value="butsumetsu">🏷️ 仏滅（ぶつめつ・最大割引適用日）</option>
							</select>
						</div>

						<!-- 4. Guest Scale -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<label for="input-guest-count" style="font-size: 0.88rem; font-weight: 800; color: var(--fg-pencil);">
									4. 想定ゲスト人数
								</label>
								<div style="display: flex; align-items: center; gap: 0.35rem;">
									<input type="number" id="input-guest-count" value="60" min="10" max="150" step="5" style="width: 60px; padding: 4px 6px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
									<span style="font-size: 0.82rem;">名</span>
								</div>
							</div>
						</div>

					</div>

					<!-- Right Column: Live Diagnostic Dashboard -->
					<div>
						<div style="background: #FAF8F5; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.5rem;">
							
							<div style="font-size: 0.82rem; font-weight: 800; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 0.25rem;">
								SCHEDULE & DISCOUNT DIAGNOSIS
							</div>
							<h3 style="font-size: 1.15rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 1.25rem;">
								📅 日程診断・見積もり割引結果
							</h3>

							<div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
								
								<!-- Discount Hero Result -->
								<div style="background: #ECFDF5; border: 2px solid #059669; border-radius: 6px; padding: 1rem;">
									<div style="font-size: 0.82rem; font-weight: 800; color: #065F46; margin-bottom: 0.25rem;">
										式場見積もりの推定値引き・特典額
									</div>
									<div id="res-discount-hero" style="font-size: 1.7rem; font-weight: 900; color: #059669; line-height: 1.2;">
										0 円（正規料金枠）
									</div>
									<div id="res-discount-sub" style="font-size: 0.75rem; color: #047857; margin-top: 0.35rem;">
										※ 最も人気の日程のため、割引特典は少なめです
									</div>
								</div>

								<!-- Fortune Status Box -->
								<div id="res-fortune-box" style="background: #FEF2F2; border: 1.5px solid #FCA5A5; border-radius: 6px; padding: 0.85rem 1rem;">
									<div style="font-size: 0.82rem; font-weight: 800; color: #991B1B; margin-bottom: 0.3rem;">
										お日柄・時間帯判定
									</div>
									<div id="res-fortune-text" style="font-size: 0.90rem; font-weight: 800; color: #7F1D1D;">
										💮 終日大吉（結婚式に最も安心のお日柄）
									</div>
									<div id="res-fortune-desc" style="font-size: 0.78rem; color: #991B1B; margin-top: 0.25rem;">
										親族・ゲスト受け抜群。予約が埋まりやすいため早めの式場見学が必須です。
									</div>
								</div>

								<!-- Parent Advice Recommendation -->
