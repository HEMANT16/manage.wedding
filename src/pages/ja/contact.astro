---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "お問い合わせ | Manage.Wedding 日本版",
  "url": "https://manage.wedding/ja/contact",
  "description": "Manage.Wedding 日本版に関するご質問、計算ツールのリクエスト、お問い合わせ窓口。"
};
---

<Layout 
	title="お問い合わせ | Manage.Wedding 日本版"
	description="Manage.Wedding 日本版へのご意見・ご要望・新機能リクエスト。"
	schema={schema}
>
	<main style="max-width: 800px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box;">
		
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(28px, 5vw, 44px); color: var(--fg-pencil); line-height: 1.2; text-align: center; margin-bottom: 0.75rem;">
					お問い合わせ
				</h1>
				<p class="font-body" style="font-size: 1rem; color: var(--text-secondary); max-width: 500px; margin: 0 auto; text-align: center;">
					ご意見・ご感想・新しいツールのリクエストなど、お気軽にお寄せください。
				</p>
			</div>
		</section>

		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 2.5rem); background: #fff; line-height: 1.8; font-family: var(--font-body); font-size: 0.98rem; margin-bottom: 4rem;">
			<div style="text-align: center; padding: 1rem 0;">
				<p style="font-size: 1.05rem; color: var(--fg-pencil); margin-bottom: 1rem;">
					計算ツールの追加リクエストや不具合のご報告は、公式メール窓口までお送りください。
				</p>
				<div class="hand-card" style="display: inline-block; padding: 12px 24px; background: #FAF8F5; border: 1.5px solid var(--fg-pencil); font-weight: 700; color: #2563EB; font-size: 1.1rem; margin-bottom: 1.5rem;">
					hello@manage.wedding
				</div>
				<p style="font-size: 0.85rem; color: var(--text-secondary);">
					通常2〜3営業日以内に確認・ご返信いたします。
				</p>
			</div>
		</article>
	</main>
</Layout>
