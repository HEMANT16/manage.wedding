	<!-- Interactive Client Script for Calculator -->
	<script is:inline>
		const totalCostRange = document.getElementById('total-cost-range');
		const totalCostBadge = document.getElementById('total-cost-badge');
		const savingsInput = document.getElementById('savings-amount');
		const parentAidInput = document.getElementById('parent-aid');

		const friendsInput = document.getElementById('guest-friends');
		const bossesInput = document.getElementById('guest-bosses');
		const couplesInput = document.getElementById('guest-couples');
		const relativesInput = document.getElementById('guest-relatives');

		const totalGuestsCount = document.getElementById('total-guests-count');
		const resTotalCost = document.getElementById('res-total-cost');
		const resGoshugi = document.getElementById('res-goshugi');
		const resAid = document.getElementById('res-aid');
		const resJikoFutan = document.getElementById('res-jiko-futan');
		const resRemainingSavings = document.getElementById('res-remaining-savings');
		const savingsStatusBadge = document.getElementById('savings-status-badge');
		const resCostPerGuest = document.getElementById('res-cost-per-guest');

		const barGoshugi = document.getElementById('bar-goshugi');
		const barAid = document.getElementById('bar-aid');
		const barJiko = document.getElementById('bar-jiko');

		const resetBtn = document.getElementById('reset-btn');
		const printBtn = document.getElementById('print-sheet-btn');

		function calculate() {
			const totalCost = parseFloat(totalCostRange?.value || '3500000');
			const savings = parseFloat(savingsInput?.value || '2500000');
			const aid = parseFloat(parentAidInput?.value || '500000');

			const countFriends = parseInt(friendsInput?.value || '0', 10);
			const countBosses = parseInt(bossesInput?.value || '0', 10);
			const countCouples = parseInt(couplesInput?.value || '0', 10);
			const countRelatives = parseInt(relativesInput?.value || '0', 10);

			const totalGuests = countFriends + countBosses + (countCouples * 2) + countRelatives;

			// Goshugi norms
			const goshugiFriends = countFriends * 30000;
			const goshugiBosses = countBosses * 50000;
			const goshugiCouples = countCouples * 60000;
			const goshugiRelatives = countRelatives * 80000;
			const totalGoshugi = goshugiFriends + goshugiBosses + goshugiCouples + goshugiRelatives;

			// Net self-pay out of pocket
			const netSelfPay = Math.max(0, totalCost - totalGoshugi - aid);
			const remainingSavings = savings - netSelfPay;

			// Update Text Displays
			if (totalCostBadge) totalCostBadge.textContent = `${totalCost.toLocaleString('ja-JP')} 円`;
			if (totalGuestsCount) totalGuestsCount.textContent = `合計: ${totalGuests} 名`;
			if (resTotalCost) resTotalCost.textContent = `${totalCost.toLocaleString('ja-JP')} 円`;
			if (resGoshugi) resGoshugi.textContent = `${totalGoshugi.toLocaleString('ja-JP')} 円`;
			if (resAid) resAid.textContent = `${aid.toLocaleString('ja-JP')} 円`;
			if (resJikoFutan) resJikoFutan.textContent = `${netSelfPay.toLocaleString('ja-JP')} 円`;
			if (resRemainingSavings) resRemainingSavings.textContent = `${remainingSavings.toLocaleString('ja-JP')} 円`;

			// Guest unit cost
			if (resCostPerGuest) {
				const unitCost = totalGuests > 0 ? Math.round(totalCost / totalGuests) : 0;
				resCostPerGuest.textContent = `約 ${unitCost.toLocaleString('ja-JP')} 円 / 名`;
			}

			// Savings Health Badge
			if (savingsStatusBadge) {
				if (remainingSavings >= 1000000) {
					savingsStatusBadge.textContent = '✅ 安心圏（新生活の準備資金も十分に確保できています）';
					savingsStatusBadge.style.color = '#166534';
				} else if (remainingSavings >= 0) {
					savingsStatusBadge.textContent = '⚠️ やや注意（結婚式後の貯金が少なめです。新生活費を要確認）';
					savingsStatusBadge.style.color = '#D97706';
				} else {
					const deficit = Math.abs(remainingSavings);
					savingsStatusBadge.textContent = `🚨 資金不足（貯金が約 ${deficit.toLocaleString('ja-JP')} 円不足します。予算見直しを推奨）`;
					savingsStatusBadge.style.color = '#DC2626';
				}
			}

			// Update Composition Bar Chart
			if (barGoshugi && barAid && barJiko && totalCost > 0) {
				const pctGoshugi = Math.min(100, Math.round((totalGoshugi / totalCost) * 100));
				const pctAid = Math.min(100 - pctGoshugi, Math.round((aid / totalCost) * 100));
				const pctJiko = Math.max(0, 100 - pctGoshugi - pctAid);

				barGoshugi.style.width = `${pctGoshugi}%`;
				barGoshugi.textContent = pctGoshugi > 10 ? `ご祝儀 ${pctGoshugi}%` : `${pctGoshugi}%`;

				barAid.style.width = `${pctAid}%`;
				barAid.textContent = pctAid > 8 ? `援助 ${pctAid}%` : `${pctAid}%`;

				barJiko.style.width = `${pctJiko}%`;
				barJiko.textContent = pctJiko > 8 ? `手出し ${pctJiko}%` : `${pctJiko}%`;
			}
		}

		// Event Listeners
		[totalCostRange, savingsInput, parentAidInput, friendsInput, bossesInput, couplesInput, relativesInput].forEach(el => {
			if (el) el.addEventListener('input', calculate);
		});

		// Reset Button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (totalCostRange) totalCostRange.value = '3500000';
				if (savingsInput) savingsInput.value = '2500000';
				if (parentAidInput) parentAidInput.value = '500000';
				if (friendsInput) friendsInput.value = '40';
				if (bossesInput) bossesInput.value = '6';
				if (couplesInput) couplesInput.value = '2';
				if (relativesInput) relativesInput.value = '10';
				calculate();
			});
		}

		// Print Button (Fallback)
		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Dynamic Share Formatter for LINE / Clipboard
		window.getJaLiveShareText = function() {
			const totalCost = parseFloat(totalCostRange?.value || '3500000');
			const savings = parseFloat(savingsInput?.value || '2500000');
			const aid = parseFloat(parentAidInput?.value || '500000');

			const countFriends = parseInt(friendsInput?.value || '0', 10);
			const countBosses = parseInt(bossesInput?.value || '0', 10);
			const countCouples = parseInt(couplesInput?.value || '0', 10);
			const countRelatives = parseInt(relativesInput?.value || '0', 10);
			const totalGuests = countFriends + countBosses + (countCouples * 2) + countRelatives;

			const goshugiFriends = countFriends * 30000;
			const goshugiBosses = countBosses * 50000;
			const goshugiCouples = countCouples * 60000;
			const goshugiRelatives = countRelatives * 80000;
			const totalGoshugi = goshugiFriends + goshugiBosses + goshugiCouples + goshugiRelatives;

			const netSelfPay = Math.max(0, totalCost - totalGoshugi - aid);
			const remainingSavings = savings - netSelfPay;

			return `【結婚式 自己負担額シミュレーション結果】
・総費用: 約${totalCost.toLocaleString('ja-JP')}円 (${totalGuests}名)
・想定ご祝儀: 約${totalGoshugi.toLocaleString('ja-JP')}円
・親援助: ${aid.toLocaleString('ja-JP')}円
━━━━━━━━━━━━━━━━
★ 自己負担額（実質手出し）: 約${netSelfPay.toLocaleString('ja-JP')}円
★ 式後の貯金残高: 約${remainingSavings.toLocaleString('ja-JP')}円

▼ 見積もり・計算ツールで確認する
https://manage.wedding/ja/jiko-futangaku-calculator`;
		};

		// Initial Run
		calculate();
	</script>

</Layout>
