---
import Layout from '../../layouts/Layout.astro';
import JaShareActionBar from '../../components/ja/JaShareActionBar.astro';

const title = "【結婚式 自己負担額シミュレーター】ご祝儀相殺とリアル手出し額計算 (無料・登録不要) | Manage.Wedding 日本版";
const description = "式場総見積もりとゲスト内訳（友人・上司・親族・夫婦）を入力するだけで、予想ご祝儀総額、両親援助、新郎新婦の実質自己負担額（手出し金）、式後の貯金残高を瞬時に自動計算。完全無料・登録不要・ローカル保存・A4/PDF印刷対応。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/jiko-futangaku-calculator#app",
      "name": "結婚式 自己負担額シミュレーター",
      "url": "https://manage.wedding/ja/jiko-futangaku-calculator",
      "description": "日本の結婚式に特化し、式場総費用とゲストごとの予想ご祝儀相場・親援助から、新郎新婦の持ち出し自己負担額と式後貯金残高を自動計算するシミュレーター。",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "結婚式の自己負担額（手出し額）を正確に計算する方法",
      "description": "初期見積もりの総額から予想されるご祝儀総額と親の援助金を差し引いて、ふたりが実際に貯金から持ち出す金額を算出する手順。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "式場のリアルな総費用（最終見積もり見込み）を設定する",
          "text": "式場から提示された初期見積もりに、衣装差額や料理のランクアップ、エンドロールムービー追加など想定される跳ね上がり費用（+20〜30%）を加味したリアルな総費用を設定します。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "ゲストの関係性別にご祝儀を算出する",
          "text": "友人・同僚（3万円）、上司（5万円）、夫婦出席（6万円/組）、親族（8万〜10万円）のように、ゲストの属性ごとに人数を整理して予想ご祝儀総額を正確に割り出します。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "両家両親からの援助金を加味する",
          "text": "両家両親からの結婚準備金や援助金がある場合はその合計額を入力し、キャッシュフローに反映させます。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "実質自己負担額と結婚式後の貯金残高を判定する",
          "text": "総費用からご祝儀と援助金を差し引いて手出し額を算出し、結婚式後の新生活用貯金（引っ越し・ハネムーン・予備費）が手元に十分残るかを確認します。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "結婚式の自己負担額（手出し額）の計算式はどうなっていますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「実質自己負担額 ＝ 式場の総費用（最終見積もり） − 予想ご祝儀総額 − 親からの援助金」で計算します。ご祝儀は一律ではなく、友人（3万円）、上司（5万円）、親族（8万〜10万円）のように関係性ごとに傾斜をつけて試算するのが正確です。"
          }
        },
        {
          "@type": "Question",
          "name": "結婚式の自己負担額の平均相場はいくらですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "全国平均（ゲスト60名規模）では、結婚式の総費用約330万〜350万円に対し、ご祝儀総額が約200万〜220万円となるため、親の援助がない場合の自己負担額（手出し）は約110万〜140万円程度が一般的な相場です。"
          }
        },
        {
          "@type": "Question",
          "name": "結婚式費用の支払いはいつ行いますか？当日のご祝儀で払えますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "約80%の結婚式場は「挙式の1〜2週間前までの事前銀行振込（前払い）」を原則としています。当日のご祝儀で後払い清算できる会場は全体の10〜20%にとどまるため、一時的にまとまった貯金やブライダルローンを用意しておく必要があります。"
          }
        },
        {
          "@type": "Question",
          "name": "自己負担額を100万円以内に抑えるためのコツはありますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. 持ち込み料無料のペーパーアイテムやプロフィールムービーを自作する（15万〜25万円節約）。2. 仏滅や日曜午後、夏・冬のオフシーズン割引を活用する（30万〜80万円割引）。3. 装花やドレスの小物をフリマアプリ等で工夫することで、ゲストへのおもてなし（料理・引出物）を削らずに手出しを大幅に抑えられます。"
          }
        },
        {
          "@type": "Question",
          "name": "入力した金額やゲスト人数などのデータは外部に送信されますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "いいえ、当サイトは完全ローカルファースト設計です。入力されたすべての数字はお使いの端末のブラウザ内（LocalStorage）でのみ処理・保存され、当社のサーバーに送信されることは一切ありません。"
          }
        }
      ]
    }
  ]
};

const scaleBenchmarks = [
  { count: "30名（家族・親族中心）", cost: "180 〜 220 万円", goshugi: "120 〜 150 万円", jiko: "60 〜 80 万円", note: "親族比率が高くご祝儀平均が高め。料理にこだわりやすい規模。" },
  { count: "50名（親族＋親しい友人）", cost: "270 〜 310 万円", goshugi: "170 〜 190 万円", jiko: "90 〜 120 万円", note: "アットホームな人気規模。演出と費用のバランスが取りやすい。" },
  { count: "60名（全国平均規模）", cost: "320 〜 360 万円", goshugi: "200 〜 230 万円", jiko: "110 〜 140 万円", note: "最も標準的な人数。友人40名・親族15名・上司5名の構成が多め。" },
  { count: "70名（標準〜やや多め）", cost: "370 〜 410 万円", goshugi: "230 〜 260 万円", jiko: "130 〜 160 万円", note: "職場関係や友人を幅広く招待。装花や写真アルバムの追加が増加。" },
  { count: "80名（大人数・華やか）", cost: "410 〜 470 万円", goshugi: "260 〜 300 万円", jiko: "140 〜 180 万円", note: "余興や演出が華やかになる分、会場貸切料や引出物個数が増加。" },
  { count: "100名（大規模披露宴）", cost: "480 〜 550 万円", goshugi: "320 〜 370 万円", jiko: "160 〜 200 万円", note: "テーブル数が多く装花代がかさむが、ご祝儀総額も大きくなる。" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<a href="/ja/budget" style="color: #2563EB; text-decoration: none; font-weight: 600;">費用・見積もり</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">自己負担額シミュレーター</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FEE2E2; border: 1.5px solid #FCA5A5; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #991B1B; margin-bottom: 0.75rem;">
						<span>💰</span>
						<span>自己負担額・手出し金 診断ツール</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						結婚式 自己負担額<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">シミュレーター</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						式場の総費用とゲストの人数内訳（友人・上司・親族）から、予想ご祝儀総額と<strong>おふたりが実際に貯金から持ち出す「手出し金額」</strong>を瞬時に計算します。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 42%;"></div>
						<img 
							src="/images/ja_budget_flatlay.webp" 
							alt="結婚式の予算管理とリング・万年筆の上品なフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							🌸 ふたりのお金をクリアにして、安心して当日を迎えましょう。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Calculator Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
							🧮 自己負担額の計算フォーム
						</h2>
						<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
							数字を変更すると右側の計算結果とグラフがリアルタイムに更新されます。
						</p>
					</div>
					<button id="reset-btn" type="button" style="font-size: 0.80rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
						🔄 初期値に戻す
					</button>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.5rem;">
					
					<!-- Left Form: Cost & Guest Inputs -->
					<div>
						
						<!-- Step A: Total Cost & Savings -->
						<div style="margin-bottom: 2rem;">
							<div style="font-size: 0.85rem; font-weight: 900; color: #2563EB; margin-bottom: 0.6rem; text-transform: uppercase;">
								1. 式場総費用とおふたりの資金
							</div>

							<div style="margin-bottom: 1.25rem;">
								<label for="total-cost-range" style="display: flex; justify-content: space-between; font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem;">
									<span>式場総費用・見積もり総額</span>
									<span id="total-cost-badge" style="color: #2563EB; font-weight: 800;">3,500,000 円</span>
								</label>
								<input 
									type="range" 
									id="total-cost-range" 
									min="1000000" 
									max="7000000" 
									step="50000" 
									value="3500000" 
									style="width: 100%; accent-color: #2563EB; cursor: pointer;"
								/>
								<div style="display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--text-secondary); margin-top: 2px;">
									<span>100万円</span>
									<span>350万円（平均）</span>
									<span>700万円</span>
								</div>
							</div>

							<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
								<div>
									<label for="savings-amount" style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.25rem;">
										現在のふたりの貯金額
									</label>
									<input 
										type="number" 
										id="savings-amount" 
										value="2500000" 
										step="100000" 
										style="width: 100%; padding: 8px 10px; font-size: 0.95rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;"
									/>
								</div>

								<div>
									<label for="parent-aid" style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.25rem;">
										親からの援助金（合計）
									</label>
									<input 
										type="number" 
										id="parent-aid" 
										value="500000" 
										step="100000" 
										style="width: 100%; padding: 8px 10px; font-size: 0.95rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;"
									/>
								</div>
							</div>
						</div>

						<!-- Step B: Guest Count & Relationship Breakdown -->
						<div>
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem;">
								<span style="font-size: 0.85rem; font-weight: 900; color: #2563EB; text-transform: uppercase;">
									2. 招待ゲストの人数内訳
								</span>
								<span id="total-guests-count" style="font-size: 0.85rem; font-weight: 800; background: #EFF6FF; border: 1px solid #BFDBFE; color: #1E40AF; padding: 2px 8px; border-radius: 4px;">
									合計: 60 名
								</span>
							</div>

							<div style="display: flex; flex-direction: column; gap: 0.75rem;">
								
								<!-- Friends -->
								<div style="background: #FAF8F5; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 12px; display: flex; justify-content: space-between; align-items: center;">
									<div>
										<div style="font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil);">友人・同僚</div>
										<div style="font-size: 0.72rem; color: var(--text-secondary);">相場: 30,000円 / 人</div>
									</div>
									<div style="display: flex; align-items: center; gap: 0.5rem;">
										<input type="number" id="guest-friends" value="40" min="0" max="200" style="width: 60px; padding: 4px 6px; font-size: 0.95rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
										<span style="font-size: 0.85rem; color: var(--fg-pencil);">名</span>
									</div>
								</div>

								<!-- Bosses -->
								<div style="background: #FAF8F5; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 12px; display: flex; justify-content: space-between; align-items: center;">
									<div>
										<div style="font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil);">上司・恩師・先輩</div>
										<div style="font-size: 0.72rem; color: var(--text-secondary);">相場: 50,000円 / 人</div>
									</div>
									<div style="display: flex; align-items: center; gap: 0.5rem;">
										<input type="number" id="guest-bosses" value="6" min="0" max="100" style="width: 60px; padding: 4px 6px; font-size: 0.95rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
										<span style="font-size: 0.85rem; color: var(--fg-pencil);">名</span>
									</div>
								</div>

								<!-- Couples -->
								<div style="background: #FAF8F5; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 12px; display: flex; justify-content: space-between; align-items: center;">
									<div>
										<div style="font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil);">夫婦・ペア出席</div>
										<div style="font-size: 0.72rem; color: var(--text-secondary);">相場: 60,000円 / 組 (2名)</div>
									</div>
									<div style="display: flex; align-items: center; gap: 0.5rem;">
										<input type="number" id="guest-couples" value="2" min="0" max="50" style="width: 60px; padding: 4px 6px; font-size: 0.95rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
										<span style="font-size: 0.85rem; color: var(--fg-pencil);">組</span>
									</div>
								</div>

								<!-- Relatives -->
								<div style="background: #FAF8F5; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 12px; display: flex; justify-content: space-between; align-items: center;">
									<div>
										<div style="font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil);">親族・叔父叔母・兄弟</div>
										<div style="font-size: 0.72rem; color: var(--text-secondary);">相場: 80,000円 / 人</div>
									</div>
									<div style="display: flex; align-items: center; gap: 0.5rem;">
										<input type="number" id="guest-relatives" value="10" min="0" max="100" style="width: 60px; padding: 4px 6px; font-size: 0.95rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
										<span style="font-size: 0.85rem; color: var(--fg-pencil);">名</span>
									</div>
								</div>

							</div>
						</div>

					</div>

					<!-- Right Column: Live Output Dashboard & Visual Graph -->
					<div>
						<div style="background: #FAF8F5; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.5rem;">
							
							<div style="font-size: 0.82rem; font-weight: 800; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 0.25rem;">
								SIMULATION RESULTS
							</div>
							<h3 style="font-size: 1.15rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 1.25rem;">
								💡 リアル計算結果まとめ
							</h3>

							<!-- Master Highlights -->
							<div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
								
								<!-- Total Cost -->
								<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.5rem;">
