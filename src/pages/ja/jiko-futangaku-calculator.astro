				<!-- Section 5: Cost-Reduction Tactics -->
				<section>
					<h3 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.85rem; border-left: 4px solid #D97706; padding-left: 0.75rem;">
