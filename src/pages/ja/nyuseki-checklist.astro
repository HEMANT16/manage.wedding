---
import Layout from '../../layouts/Layout.astro';
import JaShareActionBar from '../../components/ja/JaShareActionBar.astro';

const title = "【婚姻届・入籍 準備チェックリスト＆開運日】最強開運日と必要書類・名義変更 (無料) | Manage.Wedding 日本版";
const description = "婚姻届提出と入籍準備の完全チェックリスト。2026/2027年 一粒万倍日・天赦日・大安が重なる「最強開運日」カレンダー、戸籍謄本・証人サインなどの提出前準備から、入籍後の名義変更（免許証・マイナンバー・銀行・パスポート）の手続き手順を自動管理。完全無料・登録不要・A4/PDF印刷対応。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/nyuseki-checklist#app",
      "name": "婚姻届・入籍 準備チェックリスト＆開運日",
      "url": "https://manage.wedding/ja/nyuseki-checklist",
      "description": "婚姻届の必要書類（戸籍謄本・証人署名）から最強開運日（一粒万倍日・天赦日・大安）の検索、入籍後の名義変更手続きまでを管理するインタラクティブチェックリスト。",
      "applicationCategory": "PlannerApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "婚姻届提出と入籍手続きを完了する4つのステップ",
      "description": "開運日の選定から書類準備、役所提出、名義変更までの完全ガイド。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "入籍日（最強開運日）を決める",
          "text": "一粒万倍日、天赦日、大安、ふたりの記念日などから、特別な入籍日を選定します。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "必要書類（戸籍謄本・本人確認書類）を準備する",
          "text": "本籍地以外の役所に提出する場合は戸籍謄本（戸籍全部事項証明書）を取り寄せます。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "証人2名に署名をもらい婚姻届を記入する",
          "text": "18歳以上の成人（親や親友など）2名に証人欄を自筆で記入してもらい、不備がないか確認します。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "役所へ提出し、名義変更手続きを進める",
          "text": "役所の窓口へ提出し、運転免許証・マイナンバー・銀行口座・クレカ・パスポートの順に名義変更を行います。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "婚姻届の提出に必要な書類は何ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「記入済みの婚姻届」「提出者の本人確認書類（運転免許証やマイナンバーカード）」「戸籍謄本（本籍地以外の市区町村役場に提出する場合）」の3点です。2021年の法改正により、届出書への押印（印鑑）は任意となりましたが、念のため旧姓の認印を持参しておくと訂正時に安心です。"
          }
        },
        {
          "@type": "Question",
          "name": "「一粒万倍日」と「天赦日」とは何ですか？入籍日に良い理由は？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「一粒万倍日（いちりゅうまんばいび）」は一粒の籾（もみ）が万倍にも実る吉日で、新しいスタートに最適とされます。「天赦日（てんしゃにち）」は天がすべての罪を許す日本の暦で最上の大吉日です。これらが重なる日は「最強開運日」と呼ばれ、入籍や結婚式の日程として絶大な人気があります。"
          }
        },
        {
          "@type": "Question",
          "name": "土日や夜間・祝日でも婚姻届は提出・受理されますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "はい、全国の市区町村役場の「時間外窓口（夜間・休日窓口）」で24時間365日いつでも婚姻届を提出できます。その日に預かり（受領）となり、後日開庁時に書類の審査が行われ、不備がなければ提出した日に遡って正式に受理・入籍日となります。"
          }
        },
        {
          "@type": "Question",
          "name": "入籍後の名義変更（改姓手続き）はどの順番で行うのが最も効率的ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "①「運転免許証・マイナンバーカード（写真付き本人確認書類）」を即日変更 ➔ ②「銀行口座・クレジットカード」 ➔ ③「勤務先への改姓届・社会保険」 ➔ ④「パスポート・携帯電話契約」の順番で進めるのが最もスムーズです。"
          }
        },
        {
          "@type": "Question",
          "name": "婚姻届の証人（2名）は誰にお願いするのが一般的ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「新郎の親（父または母）＋新婦の親（父または母）」の組み合わせが約60%と最も多く選ばれています。次いで「おふたりを引き合わせてくれた友人・キューピッド」「恩師・上司」などにお願いするケースがあります。18歳以上の成人であれば誰でも証人になれます。"
          }
        }
      ]
    }
  ]
};

const luckyDays2026 = [
  { date: "2026年 3月5日 (木)", type: "★ 天赦日 ＋ 一粒万倍日 ＋ 寅の日", fortune: "超最強開運日（年に数回のみ）", popular: "入籍・プロポーズに最高" },
  { date: "2026年 5月20日 (水)", type: "★ 天赦日 ＋ 大安", fortune: "最上吉日（大安と天赦日の重なり）", popular: "入籍・結納に大人気" },
  { date: "2026年 7月19日 (日)", type: "★ 天赦日 ＋ 一粒万倍日 ＋ 日曜日", fortune: "週末の超最強開運日", popular: "婚姻届提出・記念デートに最適" },
  { date: "2026年 10月1日 (木)", type: "★ 天赦日 ＋ 一粒万倍日", fortune: "秋の最強開運日", popular: "秋婚・入籍の最有力候補" },
  { date: "2026年 11月22日 (日)", type: "💮 いい夫婦の日 ＋ 大安", fortune: "語呂合わせ吉日 ＋ 大安吉日", popular: "毎年全国で最も入籍が多い日" },
  { date: "2026年 12月16日 (水)", type: "★ 天赦日 ＋ 一粒万倍日", fortune: "年内最後の最強開運日", popular: "年内入籍のベストタイミング" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<a href="/ja/schedule" style="color: #2563EB; text-decoration: none; font-weight: 600;">日程・準備</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">婚姻届・入籍 準備チェックリスト＆開運日</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #E0E7FF; border: 1.5px solid #A5B4FC; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #3730A3; margin-bottom: 0.75rem;">
						<span>💍</span>
						<span>入籍・婚姻届 パーフェクトプランナー</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						婚姻届・入籍 準備チェックリスト<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">最強開運日＆名義変更手続きナビ</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						一粒万倍日・天赦日・大安が重なる<strong>最強開運日カレンダー</strong>と、戸籍謄本取得・証人署名などの提出前準備から、入籍後の名義変更（免許証・マイナンバー・銀行口座・クレカ）まで全手続きをチェック管理。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 40%;"></div>
						<img 
							src="/images/ja_nyuseki_flatlay.webp" 
							alt="婚姻届の準備と万年筆・指輪ケースのフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							💍 ふたりが夫婦になる大切な一日を、完璧な段取りで。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Checklist Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<!-- Header Progress Bar -->
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1.25rem; margin-bottom: 2rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
						<div>
							<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
								📋 入籍・婚姻届 準備進行チェックリスト
							</h2>
							<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
								完了した項目にチェックを入れると進捗率が更新され、ブラウザに自動保存されます。
							</p>
						</div>
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<span id="progress-percent" style="font-size: 1.2rem; font-weight: 900; color: #2563EB;">0%</span>
							<button id="reset-checklist-btn" type="button" style="font-size: 0.78rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
								🔄 リセット
							</button>
						</div>
					</div>

					<!-- Progress Bar Track -->
					<div style="width: 100%; height: 12px; background: #e2e8f0; border-radius: 6px; overflow: hidden; border: 1px solid #cbd5e1;">
						<div id="progress-bar-fill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #3B82F6, #10B981); transition: width 0.3s ease;"></div>
					</div>
				</div>

				<!-- 3 Step Checklists Grid -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.75rem; margin-bottom: 2.5rem;">
					
					<!-- Step 1: 提出前の準備 -->
					<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem;">
						<div style="font-size: 0.88rem; font-weight: 900; color: #3730A3; border-bottom: 1.5px solid #3730A3; padding-bottom: 0.4rem; margin-bottom: 0.85rem; display: flex; justify-content: space-between;">
							<span>① 提出前の書類・準備</span>
							<span style="font-size: 0.75rem; background: #E0E7FF; padding: 2px 6px; border-radius: 4px;">提出1ヶ月前〜</span>
						</div>

						<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.84rem;">
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>婚姻届用紙の入手</strong>（役所窓口またはダウンロード・可愛いデザイン婚姻届もOK）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>戸籍謄本の取り寄せ</strong>（本籍地以外の役所に提出する場合のみ必要）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>証人2名の署名もらい</strong>（成人2名・親や親友に自筆記入を依頼）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>本人記入欄の記入＆見直し</strong>（誤字脱字・新本籍地の確認）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>記念写真グッズの準備</strong>（指輪・婚姻届フォト用ボード等）</span>
							</label>
						</div>
					</div>

					<!-- Step 2: 提出当日の持ち物 -->
					<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem;">
						<div style="font-size: 0.88rem; font-weight: 900; color: #166534; border-bottom: 1.5px solid #166534; padding-bottom: 0.4rem; margin-bottom: 0.85rem; display: flex; justify-content: space-between;">
							<span>② 提出当日の持ち物・提出</span>
							<span style="font-size: 0.75rem; background: #DCFCE7; padding: 2px 6px; border-radius: 4px;">入籍日当日</span>
						</div>

						<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.84rem;">
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>記入済みの婚姻届</strong>（クリアファイルに入れて折らずに持参）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>ふたりの本人確認書類</strong>（運転免許証・マイナンバーカード等）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>旧姓の認印（2本）</strong>（万が一の訂正印用・押印は任意だが持参推奨）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>婚姻届受理証明書の申請</strong>（会社提出や記念用に1通350円で即日取得）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>役所前での記念撮影</strong>（提出記念に日付入りでパシャリ）</span>
							</label>
						</div>
					</div>

					<!-- Step 3: 入籍後の名義変更 -->
					<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem;">
						<div style="font-size: 0.88rem; font-weight: 900; color: #DC2626; border-bottom: 1.5px solid #DC2626; padding-bottom: 0.4rem; margin-bottom: 0.85rem; display: flex; justify-content: space-between;">
							<span>③ 入籍後の名義変更（改姓）</span>
							<span style="font-size: 0.75rem; background: #FEE2E2; padding: 2px 6px; border-radius: 4px;">入籍後1〜2週間</span>
						</div>

						<div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.84rem;">
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>1. 運転免許証の裏面変更</strong>（警察署・運転免許センターで最優先更新）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>2. マイナンバーカードの券面更新</strong>（役所の戸籍住民課で暗証番号入力）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>3. 銀行口座の名義変更＆新印鑑届出</strong>（メインバンク・給与振込口座）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>4. クレジットカードの改姓更新</strong>（新氏名カードの再発行手配）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
								<span><strong>5. 勤務先への婚姻届出・社会保険</strong>（人事総務への氏名・扶養変更申請）</span>
							</label>
							<label style="display: flex; align-items: flex-start; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" class="chk-item" style="margin-top: 3px; accent-color: #2563EB;" />
