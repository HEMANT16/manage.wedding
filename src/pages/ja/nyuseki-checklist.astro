	<!-- Interactive Client Script for Checklist -->
	<script is:inline>
		const checkItems = document.querySelectorAll('.chk-item');
		const progressPercent = document.getElementById('progress-percent');
		const progressBarFill = document.getElementById('progress-bar-fill');
		const resetBtn = document.getElementById('reset-checklist-btn');
		const printBtn = document.getElementById('print-nyuseki-btn');

		const STORAGE_KEY = 'mw_nyuseki_checklist_ja';

		function saveAndCalculateProgress() {
			const states = [];
			let checkedCount = 0;

			checkItems.forEach((chk, idx) => {
				states.push(chk.checked);
				if (chk.checked) checkedCount++;
			});

			const total = checkItems.length;
			const pct = total > 0 ? Math.round((checkedCount / total) * 100) : 0;

			if (progressPercent) progressPercent.textContent = `${pct}%`;
			if (progressBarFill) progressBarFill.style.width = `${pct}%`;

			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify(states));
			} catch (e) {
				// ignore
			}
		}

		function loadSavedState() {
			try {
				const saved = localStorage.getItem(STORAGE_KEY);
				if (saved) {
					const states = JSON.parse(saved);
					checkItems.forEach((chk, idx) => {
						if (states[idx] !== undefined) {
							chk.checked = states[idx];
						}
					});
				}
			} catch (e) {
				// ignore
			}
			saveAndCalculateProgress();
		}

		checkItems.forEach(chk => {
			chk.addEventListener('change', saveAndCalculateProgress);
		});

		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				checkItems.forEach(chk => {
					chk.checked = false;
				});
				saveAndCalculateProgress();
			});
		}

		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Dynamic Share Text Formatter for LINE & Clipboard
		window.getJaLiveShareText = function() {
			let s1Checked = 0, s2Checked = 0, s3Checked = 0;
			checkItems.forEach((chk, idx) => {
				if (chk.checked) {
					if (idx < 5) s1Checked++;
					else if (idx < 10) s2Checked++;
					else s3Checked++;
				}
			});

			const totalChecked = s1Checked + s2Checked + s3Checked;
			const totalItems = checkItems.length || 16;
			const pct = progressPercent ? progressPercent.textContent.trim() : `${Math.round((totalChecked / totalItems) * 100)}%`;

			return [
				'【婚姻届・入籍 準備チェック進捗メモ】',
				'--------------------------------',
				`■ 全体進捗: ${totalChecked}/${totalItems} 項目完了 (${pct})`,
