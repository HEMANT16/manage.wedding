		const resSubTransport = document.getElementById('res-sub-transport');
		const resSubHotel = document.getElementById('res-sub-hotel');
		const resBills10k = document.getElementById('res-bills-10k');
		const resBills5k = document.getElementById('res-bills-5k');
		const resEnvShugi = document.getElementById('res-env-shugi');
		const resEnvPochi = document.getElementById('res-env-pochi');

		const resetBtn = document.getElementById('reset-okuruma-btn');
		const printBtn = document.getElementById('print-okuruma-btn');

		function getPayAmount(oneWayCost, policy) {
			const roundTrip = oneWayCost * 2;
			if (policy === 'full') {
				// Round to nearest 5000/10000
				return Math.round(roundTrip / 5000) * 5000;
			} else if (policy === 'half') {
				return Math.round(oneWayCost);
			} else { // half_round
				// Half rounded up to nearest 5000
				return Math.ceil(oneWayCost / 5000) * 5000;
			}
		}

		function calculateOkurumadai() {
			const policy = policySelect?.value || 'half_round';

			const nShinkansen = parseInt(countShinkansen?.value || '0', 10);
			const cShinkansen = parseFloat(costShinkansen?.value || '0');
			const payShinkansen = getPayAmount(cShinkansen, policy);
			if (perShinkansen) perShinkansen.textContent = `${payShinkansen.toLocaleString('ja-JP')} 円`;

			const nAirplane = parseInt(countAirplane?.value || '0', 10);
			const cAirplane = parseFloat(costAirplane?.value || '0');
			const payAirplane = getPayAmount(cAirplane, policy);
			if (perAirplane) perAirplane.textContent = `${payAirplane.toLocaleString('ja-JP')} 円`;

			const nCar = parseInt(countCar?.value || '0', 10);
			const cCar = parseFloat(costCar?.value || '0');
			const payCar = getPayAmount(cCar, policy);
			if (perCar) perCar.textContent = `${payCar.toLocaleString('ja-JP')} 円`;

			const nHotel = parseInt(countHotel?.value || '0', 10);
			const cHotel = parseFloat(costHotel?.value || '0');

			const totalTransport = (nShinkansen * payShinkansen) + (nAirplane * payAirplane) + (nCar * payCar);
			const totalHotel = nHotel * cHotel;
			const grandTotal = totalTransport + totalHotel;

			// Bill & Envelope Counts
			let count10k = 0;
			let count5k = 0;
			let envShugi = 0;
			let envPochi = 0;

			const guestList = [
				{ count: nShinkansen, pay: payShinkansen },
				{ count: nAirplane, pay: payAirplane },
				{ count: nCar, pay: payCar }
			];

			guestList.forEach(g => {
				if (g.count > 0 && g.pay > 0) {
					const tens = Math.floor(g.pay / 10000);
					const rem = g.pay % 10000;
					const fives = Math.floor(rem / 5000);

					count10k += tens * g.count;
					count5k += fives * g.count;

					if (g.pay >= 10000) {
						envShugi += g.count;
					} else {
						envPochi += g.count;
					}
				}
			});

			// Update Text Displays
			if (resGrandTotal) resGrandTotal.textContent = `${grandTotal.toLocaleString('ja-JP')} 円`;
			if (resSubTransport) resSubTransport.textContent = `${totalTransport.toLocaleString('ja-JP')} 円`;
			if (resSubHotel) resSubHotel.textContent = `${totalHotel.toLocaleString('ja-JP')} 円`;
			if (resBills10k) resBills10k.textContent = count10k.toString();
			if (resBills5k) resBills5k.textContent = count5k.toString();
			if (resEnvShugi) resEnvShugi.textContent = envShugi.toString();
			if (resEnvPochi) resEnvPochi.textContent = envPochi.toString();
		}

		// Attach Event Listeners
		[policySelect, countShinkansen, costShinkansen,
		 countAirplane, costAirplane, countCar, costCar,
		 countHotel, costHotel].forEach(el => {
			if (el) {
				el.addEventListener('input', calculateOkurumadai);
				el.addEventListener('change', calculateOkurumadai);
			}
		});

		// Reset Button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (policySelect) policySelect.value = 'half_round';
				if (countShinkansen) countShinkansen.value = '3';
				if (costShinkansen) costShinkansen.value = '14000';
				if (countAirplane) countAirplane.value = '2';
				if (costAirplane) costAirplane.value = '25000';
				if (countCar) countCar.value = '1';
				if (costCar) costCar.value = '5000';
				if (countHotel) countHotel.value = '2';
				if (costHotel) costHotel.value = '10000';

				calculateOkurumadai();
			});
		}

		// Print Button
		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Dynamic LINE/Clipboard Share Text
		window.getJaLiveShareText = function() {
			const grandTotal = document.getElementById('res-grand-total')?.textContent?.trim() || '0 円';
			const transportTotal = document.getElementById('res-sub-transport')?.textContent?.trim() || '0 円';
			const hotelTotal = document.getElementById('res-sub-hotel')?.textContent?.trim() || '0 円';
			const bills10k = document.getElementById('res-bills-10k')?.textContent?.trim() || '0';
			const bills5k = document.getElementById('res-bills-5k')?.textContent?.trim() || '0';
			const envShugi = document.getElementById('res-env-shugi')?.textContent?.trim() || '0';
			const envPochi = document.getElementById('res-env-pochi')?.textContent?.trim() || '0';

			return `【お車代＆宿泊費 計算結果】\n` +
				`遠方ゲストおもてなし総額: ${grandTotal}\n` +
				`・お車代総額: ${transportTotal}\n` +
				`・宿泊費総額: ${hotelTotal}\n\n` +
				`【準備リスト】\n` +
				`・必要な新札: 1万円札×${bills10k}枚、5千円札×${bills5k}枚\n` +
				`・必要な封筒: 祝儀袋(結び切り)×${envShugi}枚、ポチ袋×${envPochi}枚` +
				`\n\n▼ 計算ツールで確認する\nhttps://manage.wedding/ja/okurumadai-calculator`;
		};

		// Initial Run
		calculateOkurumadai();
	</script>

</Layout>
