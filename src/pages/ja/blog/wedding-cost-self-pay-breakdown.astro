  <!-- Client-side script for interactive mini-simulator -->
  <script is:inline>
    (function() {
      const guestRange = document.getElementById('sim-guest-range');
      const guestVal = document.getElementById('sim-guest-val');
      const goshugiTierSelect = document.getElementById('sim-goshugi-tier');
      const parentAidSelect = document.getElementById('sim-parent-aid');
      
      const totalCostEl = document.getElementById('sim-total-cost');
      const goshugiEl = document.getElementById('sim-goshugi');
      const selfPayEl = document.getElementById('sim-self-pay');

      function updateSimulation() {
        if (!guestRange || !guestVal || !goshugiTierSelect || !parentAidSelect || !totalCostEl || !goshugiEl || !selfPayEl) return;
        
        const guests = parseInt(guestRange.value, 10);
        const goshugiPerHead = parseInt(goshugiTierSelect.value, 10);
        const parentAid = parseInt(parentAidSelect.value, 10);
        guestVal.textContent = guests.toString();

        // Baseline model: Fixed base ~1.45M, Variable ~25,000/guest
        const totalCost = 1450000 + (guests * 25000) + (guests > 70 ? 150000 : 0);
        
        // Total Goshugi based on selected tier
        const goshugi = guests * goshugiPerHead;

        // Net self-pay
        let selfPay = totalCost - (goshugi + parentAid);
        if (selfPay < 0) selfPay = 0;

        totalCostEl.textContent = '約' + Math.round(totalCost / 10000) + '万円';
        goshugiEl.textContent = '約' + Math.round(goshugi / 10000) + '万円';
        
        if (selfPay === 0) {
          selfPayEl.textContent = '実質 0円 (黒字)';
          selfPayEl.style.color = '#047857';
        } else {
          selfPayEl.textContent = '約' + Math.round(selfPay / 10000) + '万円';
          selfPayEl.style.color = '#B45309';
        }
      }

      if (guestRange && goshugiTierSelect && parentAidSelect) {
        guestRange.addEventListener('input', updateSimulation);
        goshugiTierSelect.addEventListener('change', updateSimulation);
        parentAidSelect.addEventListener('change', updateSimulation);
        updateSimulation();
      }
    })();
  </script>
