  </main>

  <!-- Client-side script for interactive diagnostic widget -->
  <script is:inline>
    (function() {
      const guestRange = document.getElementById('diag-guest-range');
      const guestVal = document.getElementById('diag-guest-val');
      const foodSelect = document.getElementById('diag-food');
      const dressSelect = document.getElementById('diag-dress');
      const photoSelect = document.getElementById('diag-photo');
      
      const jumpAmountEl = document.getElementById('diag-jump-amount');
      const riskBadgeEl = document.getElementById('diag-risk-badge');
      const finalEstEl = document.getElementById('diag-final-est');

      function updateDiagnosis() {
        if (!guestRange || !guestVal || !foodSelect || !dressSelect || !photoSelect || !jumpAmountEl || !riskBadgeEl || !finalEstEl) return;
        
        const guests = parseInt(guestRange.value, 10);
        const foodDiffPerHead = parseInt(foodSelect.value, 10);
        const dressDiff = parseInt(dressSelect.value, 10);
        const photoDiff = parseInt(photoSelect.value, 10);
        guestVal.textContent = guests.toString();

        // Calculations
        const foodTotalDiff = guests * foodDiffPerHead;
        const floralDiff = 150000; // standard floral jump baseline
        const baseJump = foodTotalDiff + dressDiff + photoDiff + floralDiff;
        
        // Service fee + tax multiplier on the jump (~21%)
        const totalJump = Math.round(baseJump * 1.21);

        // Final estimated realistic total cost
        const realisticTotal = 1450000 + (guests * 25000) + totalJump;

        jumpAmountEl.textContent = '+約' + Math.round(totalJump / 10000) + '万円';
        finalEstEl.textContent = '約' + Math.round(realisticTotal / 10000) + '万円';

        if (totalJump >= 1000000) {
          riskBadgeEl.textContent = '🚨 超高リスク（要契約監査）';
          riskBadgeEl.style.color = '#DC2626';
          jumpAmountEl.style.color = '#DC2626';
        } else if (totalJump >= 500000) {
          riskBadgeEl.textContent = '⚠️ 要注意（標準的値上がり）';
          riskBadgeEl.style.color = '#D97706';
          jumpAmountEl.style.color = '#D97706';
        } else {
          riskBadgeEl.textContent = '✨ 良好（着地予算管理中）';
          riskBadgeEl.style.color = '#059669';
          jumpAmountEl.style.color = '#059669';
        }
      }

      if (guestRange && foodSelect && dressSelect && photoSelect) {
        guestRange.addEventListener('input', updateDiagnosis);
        foodSelect.addEventListener('change', updateDiagnosis);
        dressSelect.addEventListener('change', updateDiagnosis);
        photoSelect.addEventListener('change', updateDiagnosis);
        updateDiagnosis();
      }
    })();
  </script>
</Layout>
