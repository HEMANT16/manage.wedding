        </div>

      </article>

    </div>
  </main>

  <!-- Client-side script for interactive budget cut simulator -->
  <script is:inline>
    (function() {
      const checkboxes = document.querySelectorAll('.budget-cut-checkbox');
      const totalEl = document.getElementById('sim-savings-total');
      const badgeEl = document.getElementById('sim-safety-badge');
      const adviceEl = document.getElementById('sim-advice-text');

      function calculateBudget() {
        let totalSavings = 0;
        let hasDanger = false;

        checkboxes.forEach(cb => {
          if (cb.checked) {
            const amount = parseInt(cb.dataset.amount, 10) || 0;
            totalSavings += amount;
            if (cb.dataset.danger === 'true') {
              hasDanger = true;
            }
          }
        });

        if (totalEl) {
          totalEl.textContent = '-' + totalSavings.toLocaleString() + ' 円';
        }

        if (badgeEl && adviceEl) {
          if (hasDanger) {
            badgeEl.textContent = '🚨 要注意！ゲスト後悔リスク大';
            badgeEl.style.color = '#DC2626';
            adviceEl.textContent = '⚠️ 危険な項目（料理ランクダウンやお車代カット）が含まれています！ゲストの不満に繋がりやすいため、装花やペーパーアイテムなど他の安全な項目での節約を優先しましょう。';
            adviceEl.style.color = '#991B1B';
            adviceEl.style.background = '#FEF2F2';
            adviceEl.style.borderColor = '#FCA5A5';
          } else if (totalSavings === 0) {
            badgeEl.textContent = '⚪ 項目未選択';
            badgeEl.style.color = '#64748B';
            adviceEl.textContent = '上のチェックボックスから、検討している節約項目を選択してください。';
            adviceEl.style.color = '#475569';
            adviceEl.style.background = '#F8FAFC';
            adviceEl.style.borderColor = '#CBD5E1';
          } else {
            badgeEl.textContent = '🟢 安全（ゲスト満足度100%◎）';
            badgeEl.style.color = '#059669';
            adviceEl.textContent = '👏 素晴らしい選択です！ゲストのおもてなし（料理・お車代）を維持したまま、装飾や中間マージンを上手に削れています。';
            adviceEl.style.color = '#166534';
            adviceEl.style.background = '#DCFCE7';
            adviceEl.style.borderColor = '#86EFAC';
          }
        }
      }

      checkboxes.forEach(cb => {
        cb.addEventListener('change', calculateBudget);
      });

      calculateBudget();
    })();
  </script>
</Layout>
