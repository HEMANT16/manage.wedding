  <!-- Client-side script for interactive mochikomi breakeven simulator -->
  <script is:inline>
    (function() {
      const itemTypeSelect = document.getElementById('calc-item-type');
      const venuePriceInput = document.getElementById('calc-venue-price');
      const externalPriceInput = document.getElementById('calc-external-price');
      
      const totalOutEl = document.getElementById('calc-total-out');
      const savingsEl = document.getElementById('calc-savings');
      const verdictBadgeEl = document.getElementById('calc-verdict-badge');

      const itemDefaults = {
        dress: { fee: 50000, venue: 350000, ext: 120000 },
        tuxedo: { fee: 30000, venue: 150000, ext: 50000 },
        photo: { fee: 30000, venue: 250000, ext: 120000 },
        hikidemono: { fee: 30000, venue: 300000, ext: 210000 },
        paper: { fee: 0, venue: 90000, ext: 20000 }
      };

      function updateItemDefaults() {
        if (!itemTypeSelect || !venuePriceInput || !externalPriceInput) return;
        const sel = itemTypeSelect.value;
        const config = itemDefaults[sel] || itemDefaults.dress;
        venuePriceInput.value = config.venue;
        externalPriceInput.value = config.ext;
        updateCalculation();
      }

      function updateCalculation() {
        if (!itemTypeSelect || !venuePriceInput || !externalPriceInput || !totalOutEl || !savingsEl || !verdictBadgeEl) return;
        
        const sel = itemTypeSelect.value;
        const fee = (itemDefaults[sel] || itemDefaults.dress).fee;
        const venuePrice = parseInt(venuePriceInput.value, 10) || 0;
        const externalPrice = parseInt(externalPriceInput.value, 10) || 0;

        const totalOut = externalPrice + fee;
        const savings = venuePrice - totalOut;

        totalOutEl.textContent = totalOut.toLocaleString() + ' 円';

        if (savings > 0) {
          savingsEl.textContent = '+' + savings.toLocaleString() + ' 円';
          savingsEl.style.color = '#059669';
          verdictBadgeEl.textContent = '🎉 持ち込みが圧倒的にお得！';
          verdictBadgeEl.style.color = '#059669';
        } else if (savings === 0) {
          savingsEl.textContent = '±0 円 (同額)';
          savingsEl.style.color = '#64748B';
          verdictBadgeEl.textContent = '⚖️ 費用同等（手間で判断）';
          verdictBadgeEl.style.color = '#64748B';
        } else {
          savingsEl.textContent = savings.toLocaleString() + ' 円 (割高)';
          savingsEl.style.color = '#DC2626';
          verdictBadgeEl.textContent = '⚠️ 式場プランの方が有利';
          verdictBadgeEl.style.color = '#DC2626';
        }
      }

      if (itemTypeSelect && venuePriceInput && externalPriceInput) {
        itemTypeSelect.addEventListener('change', updateItemDefaults);
        venuePriceInput.addEventListener('input', updateCalculation);
        externalPriceInput.addEventListener('input', updateCalculation);
        updateCalculation();
      }
    })();
  </script>
</Layout>
