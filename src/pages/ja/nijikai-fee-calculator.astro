	<!-- Interactive Client Script for Calculator -->
	<script is:inline>
		const countMale = document.getElementById('count-male');
		const countFemale = document.getElementById('count-female');
		const costFoodPlan = document.getElementById('cost-food-plan');
		const costVenueFee = document.getElementById('cost-venue-fee');
		const costPrizes = document.getElementById('cost-prizes');
		const costGifts = document.getElementById('cost-gifts');
		const selectFeeDiff = document.getElementById('select-fee-diff');
		const costCoupleSubsidy = document.getElementById('cost-couple-subsidy');

		const labelTotalNijikai = document.getElementById('label-total-nijikai');
		const resMaleFee = document.getElementById('res-male-fee');
		const resFemaleFee = document.getElementById('res-female-fee');
		const resBreakevenSub = document.getElementById('res-breakeven-sub');
		const resBalanceBox = document.getElementById('res-balance-box');
		const resBalanceAmount = document.getElementById('res-balance-amount');
		const resDropBufferDesc = document.getElementById('res-drop-buffer-desc');
		const resTotalExpense = document.getElementById('res-total-expense');
		const resTotalRevenue = document.getElementById('res-total-revenue');

		const resetBtn = document.getElementById('reset-nijikai-btn');
		const printBtn = document.getElementById('print-nijikai-btn');

		function calculateNijikai() {
			const nMale = parseInt(countMale?.value || '0', 10);
			const nFemale = parseInt(countFemale?.value || '0', 10);
			const totalGuests = nMale + nFemale;

			if (labelTotalNijikai) labelTotalNijikai.textContent = totalGuests.toString();

			const cFood = parseFloat(costFoodPlan?.value || '0');
			const cVenue = parseFloat(costVenueFee?.value || '0');
			const cPrizes = parseFloat(costPrizes?.value || '0');
			const cGifts = parseFloat(costGifts?.value || '0');
			const cSubsidy = parseFloat(costCoupleSubsidy?.value || '0');
			const diff = parseFloat(selectFeeDiff?.value || '1000');

			const totalExpense = (totalGuests * cFood) + cVenue + cPrizes + cGifts;
			const netExpense = Math.max(0, totalExpense - cSubsidy);

			// Breakeven target with 10% dropout buffer
			const safeGuests = Math.max(5, totalGuests * 0.9);
			const baseCostPerHead = netExpense / safeGuests;

			// Calculate Male/Female fees in 500 yen increments
			let maleFee = Math.ceil((baseCostPerHead + (diff / 2)) / 500) * 500;
			let femaleFee = Math.max(3000, maleFee - diff);

			const projectedRevenue = (nMale * maleFee) + (nFemale * femaleFee) + cSubsidy;
			const balance = projectedRevenue - totalExpense;

			// Dropout tolerance check
			const dropOutGuests = Math.max(1, Math.floor(totalGuests * 0.1));
			const dropRevenue = ((nMale - Math.floor(dropOutGuests / 2)) * maleFee) + ((nFemale - Math.ceil(dropOutGuests / 2)) * femaleFee) + cSubsidy;
			const dropBalance = dropRevenue - totalExpense;

			if (resMaleFee) resMaleFee.textContent = maleFee.toLocaleString('ja-JP');
			if (resFemaleFee) resFemaleFee.textContent = femaleFee.toLocaleString('ja-JP');
			if (resBreakevenSub) resBreakevenSub.textContent = `※ 参加者${totalGuests}名・総支出 ${totalExpense.toLocaleString('ja-JP')} 円基準`;

			if (resTotalExpense) resTotalExpense.textContent = `${totalExpense.toLocaleString('ja-JP')} 円`;
			if (resTotalRevenue) resTotalRevenue.textContent = `${projectedRevenue.toLocaleString('ja-JP')} 円`;

			if (resBalanceAmount && resBalanceBox && resDropBufferDesc) {
				if (balance >= 0) {
					resBalanceAmount.textContent = `+ ${balance.toLocaleString('ja-JP')} 円（黒字）`;
					resBalanceAmount.style.color = '#059669';
					resBalanceBox.style.background = '#ECFDF5';
					resBalanceBox.style.borderColor = '#86EFAC';
				} else {
					resBalanceAmount.textContent = `- ${Math.abs(balance).toLocaleString('ja-JP')} 円（赤字）`;
					resBalanceAmount.style.color = '#DC2626';
					resBalanceBox.style.background = '#FEF2F2';
					resBalanceBox.style.borderColor = '#FCA5A5';
				}

				if (dropBalance >= 0) {
					resDropBufferDesc.textContent = `🛡️ 当日${dropOutGuests}名（10%）の急な欠席が発生しても赤字になりません（耐性クリア）。`;
				} else {
					resDropBufferDesc.textContent = `⚠️ 当日${dropOutGuests}名欠席すると約 ${Math.abs(dropBalance).toLocaleString('ja-JP')} 円の赤字になります。会費を+500円上げるか景品予算の調整を推奨します。`;
				}
			}
		}

		// Attach Event Listeners
		[countMale, countFemale, costFoodPlan, costVenueFee, costPrizes, costGifts, selectFeeDiff, costCoupleSubsidy].forEach(el => {
			if (el) {
				el.addEventListener('input', calculateNijikai);
				el.addEventListener('change', calculateNijikai);
			}
		});

		// Reset Button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (countMale) countMale.value = '20';
				if (countFemale) countFemale.value = '20';
				if (costFoodPlan) costFoodPlan.value = '5000';
				if (costVenueFee) costVenueFee.value = '20000';
				if (costPrizes) costPrizes.value = '50000';
				if (costGifts) costGifts.value = '15000';
				if (selectFeeDiff) selectFeeDiff.value = '1000';
				if (costCoupleSubsidy) costCoupleSubsidy.value = '0';

				calculateNijikai();
			});
		}

		// Print Button
		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Initial Run
		calculateNijikai();

		window.getJaLiveShareText = function() {
			const nMale = parseInt(countMale?.value || '20', 10);
			const nFemale = parseInt(countFemale?.value || '20', 10);
			const totalGuests = nMale + nFemale;
			const maleFee = resMaleFee?.textContent || '8,000';
			const femaleFee = resFemaleFee?.textContent || '7,000';
			const foodPlan = parseInt(costFoodPlan?.value || '5000', 10).toLocaleString('ja-JP');
			const prizes = parseInt(costPrizes?.value || '50000', 10).toLocaleString('ja-JP');
			const totalExp = resTotalExpense?.textContent || '285,000 円';
			const dropGuests = Math.max(1, Math.floor(totalGuests * 0.1));

			return `【結婚式二次会 会費＆予算シミュレーション結果】\n` +
				`・想定参加人数: 計${totalGuests}名（男性 ${nMale}名 / 女性 ${nFemale}名）\n` +
				`・おすすめ設定会費: 男性 ${maleFee}円 / 女性 ${femaleFee}円\n` +
				`・飲食プラン: 1人あたり ¥${foodPlan}\n` +
				`・ビンゴ景品予算: ¥${prizes}\n` +
				`・総支出予想: ${totalExp}\n` +
				`・ドタキャンバッファー: 当日${dropGuests}名（10%）の急な欠席でも赤字ゼロ耐性\n\n` +
				`▼ ツールで確認する\nhttps://manage.wedding/ja/nijikai-fee-calculator`;
		};
	</script>

</Layout>
