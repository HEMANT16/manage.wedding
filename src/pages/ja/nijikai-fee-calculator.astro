---
import Layout from '../../layouts/Layout.astro';
import JaShareActionBar from '../../components/ja/JaShareActionBar.astro';

const title = "【2次会（二次会）会費＆予算計算機】男女別会費・景品予算・赤字ゼロ損益計算 (無料) | Manage.Wedding 日本版";
const description = "結婚式二次会の幹事・新郎新婦向け会費計算機。参加人数（男性・女性）、飲食プラン料金、会場設備費、ビンゴ景品代から、男女別の適正会費設定とドタキャン10%耐性・損益分岐点を自動計算。幹事マニュアルと当日の進行タイムラインも完全網羅。完全無料・登録不要・A4/PDF印刷対応。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/nijikai-fee-calculator#app",
      "name": "2次会（二次会）会費＆予算計算機",
      "url": "https://manage.wedding/ja/nijikai-fee-calculator",
      "description": "結婚式二次会の飲食費・会場費・景品代から、男女別の適正会費と赤字ゼロ損益分岐点を算出するシミュレーター。",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "二次会の予算と会費を赤字ゼロで設定する4つの手順",
      "description": "幹事・新郎新婦が無理なく黒字運営するための計算ステップ。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "想定参加人数（男性・女性）を把握する",
          "text": "披露宴からのスライド出席者と二次会から参加する友人の人数を男女別に集計します。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "支出総額（飲食代＋会場費＋景品代＋プチギフト）を算出する",
          "text": "1人あたりのビュッフェ・飲み放題代、プロジェクター使用料、ビンゴ景品代を合計します。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "ドタキャン（10%欠席）を想定した安全会費を設定する",
          "text": "当日急な体調不良等で1割の欠席が出ても赤字にならないよう、500円単位で切り上げた会費を設定します。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "新郎新婦の出資額や幹事へのお礼を配分する",
          "text": "余剰金が出た場合の使途（幹事への謝礼や新郎新婦へのプレゼント）をあらかじめ決めておきます。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "二次会の会費設定で赤字を出さない計算方法は？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「総支出 ÷（予想参加人数 × 0.9）」で1人あたりの損益分岐点単価を算出し、男性は＋500〜1,000円、女性は−500〜1,000円の傾斜をつけて500円単位で切り上げるのが鉄則です。これにより当日10%のドタキャンが発生しても幹事や新郎新婦が自腹を切るリスクを防げます。"
          }
        },
        {
          "@type": "Question",
          "name": "二次会の会費相場はいくらですか？男女で差をつけるべき？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "全国平均は「男性 7,500円〜8,500円」「女性 6,500円〜7,500円」です。飲食量の差やヘアメイク代・ドレスアップ費用がかかる女性への配慮として、男女で1,000円の差額をつける設定が約80%の二次会で採用されています。"
          }
        },
        {
          "@type": "Question",
          "name": "ビンゴやゲームの景品予算は総額いくらが目安ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "参加者40〜50名規模の場合、「総額4万円〜6万円（総予算の約15〜20%）」が標準相場です。当選者数は参加人数の約20%（8〜10名）にし、目玉景品（1位：2万円相当のテーマパーク券や高級肉）に予算の半分を集中させると会場全体が大いに盛り上がります。"
          }
        },
        {
          "@type": "Question",
          "name": "二次会幹事へのお礼（謝礼金・ギフト）の相場は？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "幹事を引き受けてくれた友人には、「1人あたり5,000円〜10,000円（または二次会会費の全額免除＋商品券5,000円）」をお礼として渡すのがマナーです。打ち合わせ時の飲食代も新郎新婦が全額ご馳走するのが一般的です。"
          }
        },
        {
          "@type": "Question",
          "name": "新郎新婦自身も二次会の飲食代（会費）を支払うべきですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "新郎新婦は主役として参加するため「会費無料」とするケースが一般的です。ただし、会場側から新郎新婦分の飲食代が別途請求される場合は、新郎新婦が自己負担（または出資金）として事前に支払うのがルールです。"
          }
        }
      ]
    }
  ]
};

const prizeRankings = [
  { rank: "👑 1位（目玉賞）", budget: "15,000 〜 25,000 円", item: "有名テーマパーク ペアチケット / 高級松阪牛・神戸牛カタログギフト", tip: "会場全体がどよめく超人気アイテム" },
  { rank: "🥈 2位（準目玉賞）", budget: "8,000 〜 12,000 円", item: "小型人気家電（スマート加湿器・高級トースター・ワイヤレスイヤホン）", tip: "男女問わず一人暮らしでも喜ばれる実用家電" },
  { rank: "🥉 3位（バラエティ賞）", budget: "4,000 〜 6,000 円", item: "スタバカード / ハーゲンダッツギフト券 / 高級お米ギフト", tip: "手荷物にならず持ち帰りやすい金券・グルメ" },
  { rank: "🎁 4〜8位（参加賞）", budget: "1,000 〜 2,000 円", item: "ご当地ラーメンセット / 入浴剤詰め合わせ / 高級スイーツ", tip: "全員に当たるチャンスを残して最後まで楽しませる" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<a href="/ja/logistics" style="color: #2563EB; text-decoration: none; font-weight: 600;">席次・2次会</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">2次会（二次会）会費＆予算計算機</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FEF3C7; border: 1.5px solid #FDE047; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #92400E; margin-bottom: 0.75rem;">
						<span>🥂</span>
						<span>二次会会費＆予算プランナー</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						2次会（二次会）会費＆予算計算機<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">男女別会費・景品予算・赤字ゼロ診断</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						参加人数、飲食代、会場費、ビンゴ景品代から<strong>男女別の適正会費設定とドタキャン10%耐性</strong>を自動計算。幹事も新郎新婦も自腹ゼロで大成功させる収支シミュレーターです。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 40%;"></div>
						<img 
							src="/images/ja_nijikai_flatlay.webp" 
							alt="結婚式二次会の乾杯グラスとパーティー演出のフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							🥂 幹事もゲストも笑顔になれる、赤字ゼロの二次会へ。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Calculator Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
							🧮 二次会会費＆損益シミュレーター
						</h2>
						<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
							人数と各経費を入力すると、男女別の適正会費と収支バランスをリアルタイムに計算します。
						</p>
					</div>
					<button id="reset-nijikai-btn" type="button" style="font-size: 0.80rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
						🔄 初期値（40名標準）に戻す
					</button>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem;">
					
					<!-- Left Form: Input Parameters -->
					<div style="display: flex; flex-direction: column; gap: 1.25rem;">
						
						<!-- 1. Attendees Count -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.88rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.5rem;">
								1. 参加予定人数（計 <span id="label-total-nijikai" style="color: #2563EB; font-weight: 900;">40</span> 名）
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.80rem;">
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">男性参加者数</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<input type="number" id="count-male" value="20" min="5" max="100" style="width: 60px; padding: 4px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
										<span>名</span>
									</div>
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">女性参加者数</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<input type="number" id="count-female" value="20" min="5" max="100" style="width: 60px; padding: 4px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
										<span>名</span>
									</div>
								</div>
							</div>
						</div>

						<!-- 2. Venue & Food Expenses -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.88rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.5rem;">
								2. 会場・飲食・設備経費
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.80rem;">
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">飲食プラン（1人）</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<span>¥</span>
										<input type="number" id="cost-food-plan" value="5000" step="500" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px;" />
									</div>
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">会場貸切料・設備費</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<span>¥</span>
										<input type="number" id="cost-venue-fee" value="20000" step="5000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px;" />
									</div>
								</div>
							</div>
						</div>

						<!-- 3. Prizes & Extras -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.88rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.5rem;">
								3. ビンゴ景品＆プチギフト予算
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.80rem;">
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">ビンゴ景品総額</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<span>¥</span>
										<input type="number" id="cost-prizes" value="50000" step="5000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px;" />
									</div>
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">プチギフト・備品</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<span>¥</span>
										<input type="number" id="cost-gifts" value="15000" step="2000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px;" />
									</div>
								</div>
							</div>
						</div>

						<!-- 4. Subsidies & Fee Diff -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.88rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.5rem;">
								4. 男女会費差額 ＆ ふたりの出資金
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.80rem;">
								<div>
									<label for="select-fee-diff" style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">男女の会費差額</label>
									<select id="select-fee-diff" style="width: 100%; padding: 4px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px;">
										<option value="1000" selected>男性＋1,000円（主流）</option>
										<option value="1500">男性＋1,500円</option>
										<option value="0">男女同額（均等）</option>
									</select>
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">新郎新婦出資（自己負担）</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<span>¥</span>
										<input type="number" id="cost-couple-subsidy" value="0" step="5000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px;" />
									</div>
								</div>
							</div>
						</div>

					</div>

					<!-- Right Column: Live Output Dashboard -->
					<div>
						<div style="background: #FAF8F5; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.5rem;">
							
							<div style="font-size: 0.82rem; font-weight: 800; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 0.25rem;">
								RECOMMENDED FEE & BREAKEVEN
							</div>
							<h3 style="font-size: 1.15rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 1.25rem;">
								🥂 おすすめ会費＆収支診断
							</h3>

							<div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
								
								<!-- Recommended Fee Box -->
								<div style="background: #FEF3C7; border: 2px solid #D97706; border-radius: 6px; padding: 1rem; text-align: center;">
									<div style="font-size: 0.82rem; font-weight: 800; color: #92400E; margin-bottom: 0.25rem;">
										おすすめ設定会費（赤字ゼロ基準）
									</div>
									<div style="display: flex; justify-content: space-around; margin: 0.4rem 0; font-size: 1.45rem; font-weight: 900; color: #B45309;">
										<div>男性: <span id="res-male-fee">8,000</span> 円</div>
										<div>女性: <span id="res-female-fee">7,000</span> 円</div>
									</div>
									<div id="res-breakeven-sub" style="font-size: 0.75rem; color: #92400E;">
										※ 参加者40名・総支出 285,000 円基準
									</div>
								</div>

								<!-- Balance Status Box -->
								<div id="res-balance-box" style="background: #ECFDF5; border: 1.5px solid #86EFAC; border-radius: 6px; padding: 0.85rem 1rem;">
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.2rem;">
										<span style="font-size: 0.82rem; font-weight: 800; color: #065F46;">収支バランス予想:</span>
										<span id="res-balance-amount" style="font-size: 1.05rem; font-weight: 900; color: #059669;">+ 15,000 円（黒字）</span>
									</div>
									<div id="res-drop-buffer-desc" style="font-size: 0.75rem; color: #047857;">
										🛡️ 当日4名（10%）の急な欠席が発生しても赤字になりません。
									</div>
								</div>

								<!-- Cost Breakdown -->
								<div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.85rem 1rem; font-size: 0.80rem; display: flex; flex-direction: column; gap: 0.35rem;">
									<div style="display: flex; justify-content: space-between;">
										<span style="color: var(--text-secondary);">総支出額（飲食＋会場＋景品）:</span>
										<span id="res-total-expense" style="font-weight: 800;">285,000 円</span>
