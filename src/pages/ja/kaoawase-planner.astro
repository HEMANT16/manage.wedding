	<!-- Interactive Client Script for Calculator -->
	<script is:inline>
		const selectSplit = document.getElementById('select-split');
		const countGroomSide = document.getElementById('count-groom-side');
		const countBrideSide = document.getElementById('count-bride-side');
		const costCourse = document.getElementById('cost-course');
		const costDrink = document.getElementById('cost-drink');
		const costRoom = document.getElementById('cost-room');
		const costGift = document.getElementById('cost-gift');

		const labelTotalGuests = document.getElementById('label-total-guests');
		const resGrandBudget = document.getElementById('res-grand-budget');
		const resPerPersonLabel = document.getElementById('res-per-person-label');
		const resCouplePay = document.getElementById('res-couple-pay');
		const resGroomParentPay = document.getElementById('res-groom-parent-pay');
		const resBrideParentPay = document.getElementById('res-bride-parent-pay');

		const resetBtn = document.getElementById('reset-kaoawase-btn');
		const printBtn = document.getElementById('print-kaoawase-btn');

		function calculateKaoawase() {
			const nGroom = parseInt(countGroomSide?.value || '0', 10);
			const nBride = parseInt(countBrideSide?.value || '0', 10);
			const totalGuests = nGroom + nBride;

			if (labelTotalGuests) labelTotalGuests.textContent = totalGuests.toString();

			const cCourse = parseFloat(costCourse?.value || '0');
			const cDrink = parseFloat(costDrink?.value || '0');
			const cRoom = parseFloat(costRoom?.value || '0');
			const cGift = parseFloat(costGift?.value || '0');

			const totalFood = totalGuests * (cCourse + cDrink);
			const grandTotal = totalFood + cRoom + cGift;
			const perPersonAvg = totalGuests > 0 ? Math.round(grandTotal / totalGuests) : 0;

			const split = selectSplit?.value || 'couple';

			let couplePay = 0;
			let groomParentPay = 0;
			let brideParentPay = 0;

			if (split === 'couple') {
				couplePay = grandTotal;
				groomParentPay = 0;
				brideParentPay = 0;
			} else if (split === 'half') {
				couplePay = 0;
				groomParentPay = Math.round(grandTotal / 2);
				brideParentPay = grandTotal - groomParentPay;
			} else if (split === 'groom') {
				couplePay = 0;
				groomParentPay = grandTotal;
				brideParentPay = 0;
			}

			if (resGrandBudget) resGrandBudget.textContent = `${grandTotal.toLocaleString('ja-JP')} 円`;
			if (resPerPersonLabel) resPerPersonLabel.textContent = `※ 1人あたり平均: 約 ${perPersonAvg.toLocaleString('ja-JP')} 円（料理＋飲物＋諸経費）`;

			if (resCouplePay) {
				resCouplePay.textContent = split === 'couple' ? `${couplePay.toLocaleString('ja-JP')} 円（全額）` : `${couplePay.toLocaleString('ja-JP')} 円`;
			}
			if (resGroomParentPay) {
				resGroomParentPay.textContent = split === 'couple' ? '0 円（ご招待）' : `${groomParentPay.toLocaleString('ja-JP')} 円`;
			}
			if (resBrideParentPay) {
				resBrideParentPay.textContent = split === 'couple' ? '0 円（ご招待）' : `${brideParentPay.toLocaleString('ja-JP')} 円`;
			}
		}

		// Attach Event Listeners
		[selectSplit, countGroomSide, countBrideSide, costCourse, costDrink, costRoom, costGift].forEach(el => {
			if (el) {
				el.addEventListener('input', calculateKaoawase);
				el.addEventListener('change', calculateKaoawase);
			}
		});

		// Reset Button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (selectSplit) selectSplit.value = 'couple';
				if (countGroomSide) countGroomSide.value = '3';
				if (countBrideSide) countBrideSide.value = '3';
				if (costCourse) costCourse.value = '12000';
				if (costDrink) costDrink.value = '2500';
				if (costRoom) costRoom.value = '5000';
				if (costGift) costGift.value = '8000';

				calculateKaoawase();
			});
		}

		// Print Button
		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Initial Run
		calculateKaoawase();
	</script>

