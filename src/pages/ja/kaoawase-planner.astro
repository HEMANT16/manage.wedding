---
import Layout from '../../layouts/Layout.astro';

const title = "【両家顔合わせ 予算・割り勘＆タイムライン】食事代・手土産・しおり準備 (無料) | Manage.Wedding 日本版";
const description = "両家顔合わせ食事会の費用計算機。コース料理代（1人1万円〜）・個室料・手土産代の総予算と支払い分担（ふたり全額奢り vs 両家折半）を自動計算。当日の2時間進行タイムテーブル、席次マナー、会話が弾む「しおり」準備リストも完全網羅。完全無料・登録不要・A4/PDF印刷対応。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/kaoawase-planner#app",
      "name": "両家顔合わせ 予算・割り勘＆タイムライン",
      "url": "https://manage.wedding/ja/kaoawase-planner",
      "description": "両家顔合わせ食事会の料理代・個室料・手土産代の総額試算と、新郎新婦全額負担/両家折半の計算、当日の2時間タイムテーブルを自動作成するプランナー。",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "両家顔合わせ食事会を成功させる4つの手順",
      "description": "日程決定から会場予約、費用分担、当日の進行までの完全ステップ。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "日程と開催エリアを決める（挙式8〜6ヶ月前）",
          "text": "両家の親の都合と中間地点（または新婦側地元）を考慮し、大安や友引などの週末ランチタイムで日程を決定します。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "個室のある料亭またはホテルレストランを予約する",
          "text": "落ち着いて会話ができる完全個室で、お祝い向け会席料理（1人1万円〜1.5万円）を予約します。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "費用分担ルールを決め、親に事前に伝える",
          "text": "当日のお会計で揉めないよう「本日は私たちがご招待します」と事前に伝え、新郎新婦が全額負担または折半を決定します。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "しおり・手土産・婚約記念品を用意する",
          "text": "家族紹介やプロフィールを載せた「顔合わせしおり」と、3,000円〜5,000円の手土産、婚約指輪などの記念品を準備します。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "両家顔合わせの費用は誰が支払うのが一般的ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "近年は「新郎新婦のふたりが全額負担（親を招待する）」するスタイルが約65〜70%と圧倒的多数派です。親が支払いを希望する場合は両家で完全折半（50%ずつ）にするのが公平です。当日親にお会計を見せないよう、デザート中に新郎が席を立って事前決済するのが最もスマートです。"
          }
        },
        {
          "@type": "Question",
          "name": "食事代の相場は1人あたりいくらくらいですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ランチの会席・コース料理で1人あたり「10,000円〜15,000円（ドリンク・サービス料込）」が全国の標準相場です。ディナーの場合は15,000円〜20,000円程度になります。両家6名の場合、総額で約6万〜10万円が目安です。"
          }
        },
        {
          "@type": "Question",
          "name": "手土産は両家で用意すべきですか？金額の相場は？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "片方だけ用意して気まずくならないよう、事前に「手土産を交換しよう」と両家ですり合わせておくのがマナーです。相場は「3,000円〜5,000円」で、日持ちする地元の銘菓や特産品が喜ばれます。のし紙は「紅白結び切り」で表書きは「御挨拶」または「寿」にします。"
          }
        },
        {
          "@type": "Question",
          "name": "両家顔合わせ食事会と「結納」の違いは何ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "結納は結納金や結納品を取り交わす伝統的・儀式的な婚約式です。一方、顔合わせ食事会は両家の親睦を深めることを主目的としたカジュアル〜セミフォーマルな食事会です。現代では約85%以上のカップルが結納を行わず、顔合わせ食事会のみを選択しています。"
          }
        },
        {
          "@type": "Question",
          "name": "「顔合わせしおり」は絶対に作った方がいいですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "必須ではありませんが、作成したカップルの満足度は非常に高いです。ふたりの生い立ちや家族のプロフィール、結婚式場の予定、連絡先を載せておくことで、初対面の親同士でも会話が途切れず和やかに進行できます。"
          }
        }
      ]
    }
  ]
};

const timelineSamples = [
  { time: "0:00 (開始前)", title: "会場集合・入室", desc: "開始10〜15分前に到着。新郎側・新婦側の順で入室し着席（上座＝新郎父、下座＝新郎新婦）。" },
  { time: "0:05", title: "始まりの挨拶・家族紹介", desc: "新郎が主催者として開会の挨拶。続いて新郎から新郎家族、新婦から新婦家族を紹介。" },
  { time: "0:15", title: "婚約記念品の交換・お披露目", desc: "婚約指輪や時計などを両親にお披露目し、記念撮影を行います。" },
  { time: "0:25", title: "乾杯・会食スタート", desc: "新郎父（または新郎）による乾杯の発声。料理を楽しみながら歓談。" },
  { time: "1:40", title: "スマートなお会計（事前決済）", desc: "デザート提供時、新郎がさりげなく席を外してお手洗いに行くふりをして会計を済ませる。" },
  { time: "1:50", title: "結びの挨拶・記念撮影", desc: "新郎（＋新婦）よりお礼の言葉。全員で集合写真を撮影し手土産を交換して解散。" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<a href="/ja/schedule" style="color: #2563EB; text-decoration: none; font-weight: 600;">日程・準備</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">両家顔合わせ 予算・割り勘＆タイムライン</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #DCFCE7; border: 1.5px solid #86EFAC; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #166534; margin-bottom: 0.75rem;">
						<span>🥢</span>
						<span>顔合わせ食事会 総合プランナー</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						両家顔合わせ食事会<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">予算・割り勘＆タイムライン作成機</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						コース料理代、個室料、ドリンク、手土産代を含む総額予算と、<strong>「ふたり全額奢り vs 両家折半」の支払額</strong>を自動計算。当日の2時間進行スケジュールと席次マナーも完璧にサポートします。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 40%;"></div>
						<img 
							src="/images/ja_kaoawase_flatlay.webp" 
							alt="両家顔合わせ食事会の和食器・手土産・結び切りのフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							🥢 両家を結ぶ最初の記念日を、最高のおもてなしで。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Calculator Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
							🧮 顔合わせ食事会 予算・割り勘シミュレーター
						</h2>
						<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
							参加人数、コース料金、手土産代を入力し、分担パターンを選択してください。
						</p>
					</div>
					<button id="reset-kaoawase-btn" type="button" style="font-size: 0.80rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
						🔄 初期値（6名標準）に戻す
					</button>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem;">
					
					<!-- Left Form: Input Items -->
					<div style="display: flex; flex-direction: column; gap: 1.25rem;">
						
						<!-- 1. Payment Policy -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<label for="select-split" style="font-size: 0.88rem; font-weight: 800; color: #166534; display: block; margin-bottom: 0.4rem;">
								1. 費用のお支払い分担ルール
							</label>
							<select id="select-split" style="width: 100%; padding: 8px; font-size: 0.90rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
								<option value="couple" selected>新郎新婦が全額負担（★おすすめ・現代の主流 約70%）</option>
								<option value="half">両家で完全折半（親が支払う場合・50%ずつ均等）</option>
								<option value="groom">新郎側が全額負担（伝統的な結納型スタイル）</option>
							</select>
						</div>

						<!-- 2. Attendance Counts -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.88rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.5rem;">
								2. 出席人数（計 <span id="label-total-guests" style="color: #2563EB; font-weight: 900;">6</span> 名）
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.80rem;">
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">新郎側（本人＋親等）</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<input type="number" id="count-groom-side" value="3" min="1" max="10" style="width: 55px; padding: 4px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
										<span>名</span>
									</div>
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">新婦側（本人＋親等）</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<input type="number" id="count-bride-side" value="3" min="1" max="10" style="width: 55px; padding: 4px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
										<span>名</span>
									</div>
								</div>
							</div>
						</div>

						<!-- 3. Course & Drink Costs -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.88rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.5rem;">
								3. 料理コース＆ドリンク単価（1人あたり）
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.80rem;">
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">料理コース単価</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<span>¥</span>
										<input type="number" id="cost-course" value="12000" step="1000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px;" />
									</div>
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">ドリンク目安単価</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<span>¥</span>
										<input type="number" id="cost-drink" value="2500" step="500" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px;" />
									</div>
								</div>
							</div>
						</div>

						<!-- 4. Room fee & Souvenirs -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.88rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.5rem;">
								4. 個室料・手土産代
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.80rem;">
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">個室料・室料合計</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<span>¥</span>
										<input type="number" id="cost-room" value="5000" step="1000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px;" />
									</div>
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">手土産代（2家分合計）</span>
									<div style="display: flex; align-items: center; gap: 0.25rem;">
										<span>¥</span>
										<input type="number" id="cost-gift" value="8000" step="1000" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px;" />
									</div>
								</div>
							</div>
						</div>

					</div>

					<!-- Right Column: Live Output Dashboard -->
					<div>
						<div style="background: #FAF8F5; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.5rem;">
							
							<div style="font-size: 0.82rem; font-weight: 800; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 0.25rem;">
								KAOAWASE BUDGET & SPLIT SUMMARY
							</div>
							<h3 style="font-size: 1.15rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 1.25rem;">
								🥢 顔合わせ総費用＆分担結果
							</h3>

							<div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
								
								<!-- Total Budget Hero -->
								<div style="background: #DCFCE7; border: 2px solid #059669; border-radius: 6px; padding: 1rem;">
									<div style="font-size: 0.82rem; font-weight: 800; color: #065F46; margin-bottom: 0.25rem;">
										顔合わせ食事会 総合計費用
									</div>
									<div id="res-grand-budget" style="font-size: 1.8rem; font-weight: 900; color: #059669; line-height: 1.2;">
										100,000 円
									</div>
									<div id="res-per-person-label" style="font-size: 0.75rem; color: #047857; margin-top: 0.35rem;">
										※ 1人あたり平均: 約 16,600 円
									</div>
								</div>

								<!-- Split Breakdown Matrix -->
								<div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.85rem 1rem; font-size: 0.82rem; display: flex; flex-direction: column; gap: 0.4rem;">
									<div style="display: flex; justify-content: space-between;">
										<span style="color: var(--text-secondary);">新郎新婦ふたりの負担額:</span>
										<span id="res-couple-pay" style="font-weight: 900; color: #166534; font-size: 0.95rem;">100,000 円（全額）</span>
									</div>
									<div style="display: flex; justify-content: space-between;">
										<span style="color: var(--text-secondary);">新郎側親御様の支払額:</span>
										<span id="res-groom-parent-pay" style="font-weight: 800; color: #2563EB;">0 円（ご招待）</span>
									</div>
									<div style="display: flex; justify-content: space-between;">
										<span style="color: var(--text-secondary);">新婦側親御様の支払額:</span>
										<span id="res-bride-parent-pay" style="font-weight: 800; color: #DC2626;">0 円（ご招待）</span>
									</div>
								</div>

								<!-- Smart Payment Advice -->
								<div style="background: #EFF6FF; border: 1.5px solid #93C5FD; border-radius: 6px; padding: 0.85rem 1rem;">
									<div style="font-size: 0.82rem; font-weight: 800; color: #1E40AF; margin-bottom: 0.3rem;">
										💡 スマートなお会計マナー
									</div>
									<div style="font-size: 0.78rem; color: #1E40AF; line-height: 1.6;">
