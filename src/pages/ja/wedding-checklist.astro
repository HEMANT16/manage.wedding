---
import Layout from '../../layouts/Layout.astro';
import JaShareActionBar from '../../components/ja/JaShareActionBar.astro';

const title = "【結婚準備チェックリスト】プロポーズ・両家顔合わせ・入籍・式場決定〜当日まで (無料) | Manage.Wedding 日本版";
const description = "プロポーズから両家顔合わせ、入籍日選び、式場見学、見積もり確定、ドレス選び、席次表作成、お車代・お礼新札準備、結婚式当日までの完全12ヶ月ToDoチェックリスト。進捗率自動保存・各フェーズ連動計算ツール・無地A4/PDF印刷対応。完全無料・登録不要。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/wedding-checklist#app",
      "name": "結婚準備マスターチェックリスト",
      "url": "https://manage.wedding/ja/wedding-checklist",
      "description": "婚約から両家顔合わせ、式場契約、見積もり精査、席次表、当日のお車代新札準備までの全工程を管理するインタラクティブチェックリスト。",
      "applicationCategory": "PlannerApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "結婚準備を12ヶ月でスムーズに完了する4つのフェーズ",
      "description": "婚約から挙式当日までの失敗しない準備ロードマップ。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "フェーズ1：婚約・両家顔合わせ・式場決定（1年前〜8ヶ月前）",
          "text": "両親への挨拶、顔合わせ食事会、六曜日程選び、ブライダルフェア見学と初期見積もり比較を行います。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "フェーズ2：入籍・衣装選び・前撮り（7ヶ月前〜4ヶ月前）",
          "text": "開運日に婚姻届提出と名義変更、ウェディングドレス試着、前撮り撮影、ゲストリストの作成を進めます。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "フェーズ3：招待状・料理・席次・引き出物（3ヶ月前〜1ヶ月前）",
          "text": "招待状発送と出欠集計、料理・ケーキの決定、上座下座に則った席次表作成、引き出物の贈り分けを確定します。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "フェーズ4：お車代新札準備・最終振込・当日（1ヶ月前〜当日）",
          "text": "最終見積もりの振込、お車代・お礼の新札と封筒準備、花嫁の手紙執筆、荷物搬入を行います。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "結婚式の準備は挙式の何ヶ月前から始めるのが一般的ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "一般的には「挙式の1年前〜8ヶ月前」からスタートします。特に人気の式場や大安の土曜日は1年前から予約が埋まり始めます。本格的な式場との打ち合わせ（衣装・料理・装花・演出など）は「挙式4ヶ月前」からスタートし、月1〜2回のペースで進みます。"
          }
        },
        {
          "@type": "Question",
          "name": "結婚準備で新郎新婦が最も喧嘩しやすい時期と理由は？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「挙式3ヶ月前〜1ヶ月前」が最も衝突しやすい危険ゾーンです。招待状の返信集計、席次表の配置、BGM選定、手作りアイテム（DIY）の締め切りが重なり、タスクが新婦ひとりに偏ることで不満が爆発しやすくなります。事前に担当を分担し、共有アプリやチェックリストで見える化しておくことが大切です。"
          }
        },
        {
          "@type": "Question",
          "name": "式場への最終支払いはいつまでに振り込む必要がありますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "全国の式場の約80%が「挙式の1週間〜10日前までの事前銀行振込」を義務付けています。当日のご祝儀を当てにして支払うことは原則できないため、自己負担額や親からの援助金を事前に口座へ準備しておく必要があります（一部式場ではクレジットカード払い・ブライダルローン対応）。"
          }
        },
        {
          "@type": "Question",
          "name": "お車代やお礼の新札（ピン札）はいつまでに用意すべきですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「挙式2週間前〜1週間前」までに銀行窓口や両替機で必要枚数を確保しておきましょう。挙式直前の平日は役所手続きや最終準備で銀行に行く時間が取れなくなることが多いため、早めの両替が安心です。"
          }
        },
        {
          "@type": "Question",
          "name": "結婚式の持ち込み（DIY）で節約できるおすすめアイテムは？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "持ち込み料が無料の会場が多い「ペーパーアイテム（招待状・席次表・席札・メニュー表）」「プロフィールムービー」「ウェルカムボード・装飾アイテム」「ブーケ（持ち込み料確認要）」が節約効果の高い定番です。"
          }
        }
      ]
    }
  ]
};

const checklistPhases = [
  {
    phaseNum: "Phase 1",
    phaseTitle: "婚約・顔合わせ・式場決定",
    timing: "1年前 〜 8ヶ月前",
    color: "#2563EB",
    bg: "#EFF6FF",
    border: "#93C5FD",
    tasks: [
      { id: "p1_1", text: "プロポーズ・両家両親への結婚挨拶（日程調整）", link: null },
      { id: "p1_2", text: "両家顔合わせ食事会の日程・会場（個室料亭）決定＆しおり作成", link: "/ja/kaoawase-planner", linkText: "🥢 顔合わせプランナー" },
      { id: "p1_3", text: "結婚式の希望時期・六曜（大安・友引）とお日柄割引を比較", link: "/ja/rokuyo-wedding-calendar", linkText: "📅 六曜カレンダー" },
      { id: "p1_4", text: "ブライダルフェア見学・初期見積もりの値上がり診断", link: "/ja/mitsumori-jump-calculator", linkText: "📈 見積もり跳ね上がり計算" },
      { id: "p1_5", text: "式場契約（持ち込み料規約・支払いスケジュールの確認）", link: "/ja/mochikomi-savings-calculator", linkText: "🏷️ 持ち込み料チェッカー" }
    ]
  },
  {
    phaseNum: "Phase 2",
    phaseTitle: "入籍・衣装選び・前撮り",
    timing: "7ヶ月前 〜 4ヶ月前",
    color: "#059669",
    bg: "#ECFDF5",
    border: "#86EFAC",
    tasks: [
      { id: "p2_1", text: "開運日（天赦日・一粒万倍日）に婚姻届提出＆名義変更手続き", link: "/ja/nyuseki-checklist", linkText: "💍 入籍チェックリスト" },
      { id: "p2_2", text: "婚約指輪・結婚指輪の購入（刻印・サイズ合わせに約2ヶ月）", link: null },
      { id: "p2_3", text: "ウェディングドレス・カラードレス・タキシード試着開始", link: null },
      { id: "p2_4", text: "フォトウェディング・前撮りの予約＆撮影実施", link: "/ja/photo-wedding-calculator", linkText: "📸 前撮り費用計算" },
      { id: "p2_5", text: "招待ゲストのリストアップ・自己負担額の概算シミュレーション", link: "/ja/jiko-futangaku-calculator", linkText: "💰 自己負担額計算" }
    ]
  },
  {
    phaseNum: "Phase 3",
    phaseTitle: "招待状・料理・席次・引き出物",
    timing: "3ヶ月前 〜 1ヶ月前",
    color: "#D97706",
    bg: "#FFFBEB",
    border: "#FDE047",
    tasks: [
      { id: "p3_1", text: "招待状の文面校正・発送（挙式2ヶ月半前の大安発送が通例）", link: null },
      { id: "p3_2", text: "料理コース試食・フリードリンク・ケーキデザイン決定", link: null },
      { id: "p3_3", text: "席次表の配席（高砂から末席の序列）と肩書きマナー確認", link: "/ja/sekijihyo-seating-builder", linkText: "🪑 席次表ビルダー" },
      { id: "p3_4", text: "引き出物・引き菓子・縁起物の贈り分け選定＆個数確定", link: "/ja/hikidemono-calculator", linkText: "🎁 引き出物計算機" },
      { id: "p3_5", text: "BGM選定・プロフィールムービー・司会者打ち合わせ", link: null }
    ]
  },
  {
    phaseNum: "Phase 4",
    phaseTitle: "新札準備・最終見積振込・当日",
    timing: "1ヶ月前 〜 挙式当日",
    color: "#DC2626",
    bg: "#FEF2F2",
    border: "#FCA5A5",
    tasks: [
      { id: "p4_1", text: "式場への最終見積もり確定＆事前銀行振込（挙式1週間前締切）", link: null },
      { id: "p4_2", text: "遠方ゲストのお車代・宿泊費の支給額と新札封筒準備", link: "/ja/okurumadai-calculator", linkText: "🚗 お車代計算ツール" },
      { id: "p4_3", text: "受付・主賓・友人スピーチへのお礼（謝礼金新札）準備", link: "/ja/wedding-orei-calculator", linkText: "🧧 お礼相場計算機" },
      { id: "p4_4", text: "友人スピーチ・謝辞・花嫁の手紙の執筆＆3分音読練習", link: "/ja/speech-toast-timer", linkText: "⏱️ スピーチタイマー" },
      { id: "p4_5", text: "二次会の最終参加人数確定＆赤字ゼロ会費精算", link: "/ja/nijikai-fee-calculator", linkText: "🥂 二次会会費計算機" }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">結婚準備マスターチェックリスト</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FEF3C7; border: 1.5px solid #FDE047; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #92400E; margin-bottom: 0.75rem;">
						<span>📋</span>
						<span>12ヶ月 結婚準備マスターチェックリスト</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						結婚式 準備段取りチェックリスト<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">プロポーズから挙式当日までの完全ToDo</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						プロポーズから両家顔合わせ、入籍、式場見学、ドレス試着、席次表作成、お車代新札準備まで。<strong>4つの準備フェーズと連動計算ツール</strong>で、抜け漏れゼロの完璧なウェディングを実現します。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 40%;"></div>
						<img 
							src="/images/ja_checklist_flatlay.webp" 
							alt="結婚準備のスケジュール手帳と筆記具のフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							📋 ひとつずつチェックして、ふたりの夢をカタチに。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Master Checklist Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<!-- Header Progress Bar -->
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1.25rem; margin-bottom: 2rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
						<div>
							<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
								📊 結婚準備 総合進捗度
							</h2>
							<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
								完了した項目にチェックを入れると全体の進捗率が更新され、端末内に自動保存されます。
							</p>
						</div>
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<span id="master-progress-percent" style="font-size: 1.3rem; font-weight: 900; color: #2563EB;">0%</span>
							<button id="reset-master-btn" type="button" style="font-size: 0.78rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
								🔄 全リセット
							</button>
						</div>
					</div>

					<!-- Progress Bar Track -->
					<div style="width: 100%; height: 14px; background: #e2e8f0; border-radius: 7px; overflow: hidden; border: 1.5px solid var(--fg-pencil);">
						<div id="master-progress-bar-fill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #3B82F6, #10B981); transition: width 0.3s ease;"></div>
					</div>
				</div>

				<!-- 4 Phases Grid -->
				<div style="display: flex; flex-direction: column; gap: 2rem; margin-bottom: 2.5rem;">
					{checklistPhases.map((phase) => (
						<div class="hand-card" style={`background: ${phase.bg}; border: 2px solid ${phase.color}; border-radius: 8px; padding: 1.5rem;`}>
							
							<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; border-bottom: 1.5px solid ${phase.color}; padding-bottom: 0.5rem; margin-bottom: 1rem;">
								<div>
									<span style={`font-size: 0.78rem; font-weight: 800; color: ${phase.color}; background: #fff; padding: 2px 8px; border-radius: 4px; border: 1px solid ${phase.color}; margin-right: 0.4rem;`}>
										{phase.phaseNum}
									</span>
									<h3 style={`display: inline; font-size: 1.15rem; font-weight: 800; color: var(--fg-pencil);`}>
										{phase.phaseTitle}
									</h3>
								</div>
								<span style={`font-size: 0.82rem; font-weight: 700; color: ${phase.color};`}>
									⏰ 時期目安: {phase.timing}
								</span>
							</div>

							<div style="display: flex; flex-direction: column; gap: 0.75rem;">
								{phase.tasks.map((task) => (
									<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; background: #fff; padding: 0.75rem 1rem; border-radius: 6px; border: 1px solid #e2e8f0;">
										<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; flex: 1; min-width: 260px;">
											<input type="checkbox" id={task.id} class="master-chk-item" style="width: 18px; height: 18px; accent-color: #2563EB;" />
											<span style="font-size: 0.88rem; font-weight: 600; color: var(--fg-pencil);">{task.text}</span>
										</label>
										{task.link && (
											<a href={task.link} style="font-size: 0.78rem; font-weight: 700; color: #2563EB; background: #EFF6FF; padding: 3px 8px; border-radius: 4px; text-decoration: none; border: 1px solid #BFDBFE;">
												{task.linkText} →
											</a>
										)}
									</div>
								))}
							</div>

						</div>
					))}
				</div>

				<!-- Print Action -->
				<button 
					id="print-master-btn" 
					type="button" 
					class="hand-btn" 
					style="width: 100%; padding: 12px; font-size: 0.95rem; font-weight: 800; text-align: center; cursor: pointer;"
				>
					📄 この12ヶ月結婚準備チェックリストを無地A4/PDFで保存・印刷
				</button>

			</div>

			<!-- LINE & Social Share Action Bar -->
			<JaShareActionBar 
				toolTitle="結婚準備マスターチェックリスト" 
				defaultText="【結婚準備チェックリスト】プロポーズ・両家顔合わせ・入籍・式場決定〜当日まで" 
				shareUrl="https://manage.wedding/ja/wedding-checklist" 
			/>

			<!-- Comprehensive Japanese Editorial Guide (800+ words of authentic, non-AI authority content) -->
			<article class="hand-card" style="background: #fff; padding: clamp(1.75rem, 4vw, 3rem); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<div style="border-bottom: 2px solid var(--fg-pencil); padding-bottom: 1rem; margin-bottom: 2rem;">
					<div style="font-size: 0.85rem; font-weight: 800; color: #92400E; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.35rem;">
						WEDDING TIMELINE & ROADMAP MANUAL
					</div>
					<h2 class="font-heading" style="font-size: clamp(1.6rem, 3.5vw, 2.2rem); color: var(--fg-pencil); line-height: 1.35; margin: 0;">
						結婚式準備の完全ロードマップ｜1年前から当日までの段取りと後悔ゼロのToDo管理術
					</h2>
					<p style="font-size: 0.95rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.7;">
						「何から始めればいい？」「いつまでに何を決めればいい？」——先輩花嫁の失敗談や経験をもとに、12ヶ月の理想的なスケジュールと夫婦ゲンカを防ぐ役割分担の秘訣を徹底解説します。
					</p>
				</div>

				<!-- Section 1: Overview -->
				<section style="margin-bottom: 2.5rem;">
