	<!-- Interactive Client Script for Master Checklist -->
	<script is:inline>
		const checkItems = document.querySelectorAll('.master-chk-item');
		const progressPercent = document.getElementById('master-progress-percent');
		const progressBarFill = document.getElementById('master-progress-bar-fill');
		const resetBtn = document.getElementById('reset-master-btn');
		const printBtn = document.getElementById('print-master-btn');

		const STORAGE_KEY = 'mw_master_wedding_checklist_ja';

		function saveAndCalculateMasterProgress() {
			const stateMap = {};
			let checkedCount = 0;

			checkItems.forEach((chk) => {
				stateMap[chk.id] = chk.checked;
				if (chk.checked) checkedCount++;
			});

			const total = checkItems.length;
			const pct = total > 0 ? Math.round((checkedCount / total) * 100) : 0;

			if (progressPercent) progressPercent.textContent = `${pct}%`;
			if (progressBarFill) progressBarFill.style.width = `${pct}%`;

			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify(stateMap));
			} catch (e) {
				// ignore
			}
		}

		function loadSavedMasterState() {
			try {
				const saved = localStorage.getItem(STORAGE_KEY);
				if (saved) {
					const stateMap = JSON.parse(saved);
					checkItems.forEach((chk) => {
						if (stateMap[chk.id] !== undefined) {
							chk.checked = stateMap[chk.id];
						}
					});
				}
			} catch (e) {
				// ignore
			}
			saveAndCalculateMasterProgress();
		}

		checkItems.forEach(chk => {
			chk.addEventListener('change', saveAndCalculateMasterProgress);
		});

		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				checkItems.forEach(chk => {
					chk.checked = false;
				});
				saveAndCalculateMasterProgress();
			});
		}

		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		loadSavedMasterState();

		window.getJaLiveShareText = function() {
			let checkedCount = 0;
			checkItems.forEach(chk => {
				if (chk.checked) checkedCount++;
			});
			const total = checkItems.length || 20;
			const pct = total > 0 ? Math.round((checkedCount / total) * 100) : 0;

			return `【12ヶ月 結婚準備マスターチェックリスト進捗】\n` +
				`・準備進捗率: ${pct}%\n` +
				`・完了タスク数: ${checkedCount} / ${total} 項目完了\n` +
				`・ステータス: ${pct === 100 ? '🎉 全準備完了！当日を迎える準備が整いました' : (pct >= 50 ? '✨ 準備は順調に進んでいます！' : '📝 ひとつずつ計画的に進めましょう')}\n\n` +
				`▼ ツールで確認する\nhttps://manage.wedding/ja/wedding-checklist`;
		};
	</script>

