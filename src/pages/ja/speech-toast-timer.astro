	<!-- Interactive Client Script for Speech Studio -->
	<script is:inline>
		const textarea = document.getElementById('speech-textarea');
		const statCharCount = document.getElementById('stat-char-count');
		const statTimeEst = document.getElementById('stat-time-est');
		const statPaceBadge = document.getElementById('stat-pace-badge');
		const ngAlertBox = document.getElementById('ng-alert-box');
		const ngAlertWords = document.getElementById('ng-alert-words');

		const insertTemplateBtn = document.getElementById('insert-template-btn');
		const clearBtn = document.getElementById('clear-speech-btn');
		const printBtn = document.getElementById('print-speech-btn');

		// Taboo words dictionary
		const taboos = [
			'別れる', '切れる', '離れる', '壊れる', '終わる', '失う', '枯れる', '冷える', 
			'重ね重ね', 'ますます', 'たびたび', '再三', 'しばしば', '再び', 'いろいろ', '色々', 
			'おしまい', '最後に', '度々'
		];

		function analyzeSpeech() {
			const text = textarea?.value || '';
			// Strip whitespace & newlines for pure character count
			const cleanText = text.replace(/\s+/g, '');
			const count = cleanText.length;

			// Estimation based on 300 chars/min
			const totalSeconds = Math.round((count / 300) * 60);
			const minutes = Math.floor(totalSeconds / 60);
			const seconds = totalSeconds % 60;

			if (statCharCount) statCharCount.textContent = `${count} 文字`;
			if (statTimeEst) statTimeEst.textContent = `${minutes} 分 ${seconds} 秒`;

			// Pace analysis
			if (statPaceBadge) {
				if (count === 0) {
					statPaceBadge.textContent = '✍️ 原稿を入力してください';
					statPaceBadge.style.background = '#E2E8F0';
					statPaceBadge.style.color = '#475569';
				} else if (count < 600) {
					statPaceBadge.textContent = '⏱️ やや短め（2分未満・エピソードを追加推奨）';
					statPaceBadge.style.background = '#FEF3C7';
					statPaceBadge.style.color = '#92400E';
				} else if (count <= 1000) {
					statPaceBadge.textContent = '✨ 理想の3分ペース（800〜900文字・黄金比率）';
					statPaceBadge.style.background = '#ECFDF5';
					statPaceBadge.style.color = '#065F46';
				} else {
					statPaceBadge.textContent = '⚠️ やや長め（3分半以上・中だるみに注意）';
					statPaceBadge.style.background = '#FEE2E2';
					statPaceBadge.style.color = '#991B1B';
				}
			}

			// Taboo words checker
			const foundTaboos = [];
			taboos.forEach(word => {
				if (text.includes(word)) {
					foundTaboos.push(word);
				}
			});

			if (ngAlertBox && ngAlertWords) {
				if (foundTaboos.length > 0) {
					ngAlertBox.style.display = 'block';
					ngAlertWords.innerHTML = foundTaboos.map(w => `<span style="font-weight:bold; background:#FCA5A5; padding:1px 6px; border-radius:3px; margin-right:4px;">「${w}」</span>`).join(' ');
				} else {
					ngAlertBox.style.display = 'none';
				}
			}
		}

		if (textarea) {
			textarea.addEventListener('input', analyzeSpeech);
		}

		// Template Insertion
		const sampleTemplate = `〇〇さん、〇〇さん、ならびにご両家の皆様、本日は誠におめでとうございます。

ただいまご紹介にあずかりました、新婦友人の〇〇と申します。
親しみを込めて、普段通り「〇〇ちゃん」と呼ばせていただきます。

〇〇ちゃんとは大学時代からの友人で、いつも明るく周りを笑顔にしてくれる太陽のような存在でした。
試験前にはいつも優しくノートを見せてくれ、私が悩んでいた時も朝まで話を聞いて励ましてくれたことを今でも鮮明に覚えています。

そんな誰よりも思いやりのある〇〇ちゃんが、素敵な〇〇さんと出会い、今日という素晴らしい日を迎えられたことを心から嬉しく思います。

〇〇さん、〇〇ちゃんは時々頑張りすぎてしまうところがありますので、どうぞ優しく支えてあげてください。
おふたりなら、笑顔の絶えない温かい家庭を築いていかれると確信しております。

おふたりの末永いお幸せと、ご両家ならびにご列席の皆様のご健勝を心よりお祈り申し上げ、私からのお祝いの言葉とさせていただきます。
本日は本当におめでとうございます。`;

		if (insertTemplateBtn && textarea) {
			insertTemplateBtn.addEventListener('click', () => {
				textarea.value = sampleTemplate;
				analyzeSpeech();
			});
		}

		if (clearBtn && textarea) {
			clearBtn.addEventListener('click', () => {
				textarea.value = '';
				analyzeSpeech();
			});
		}

		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Stopwatch Timer Logic
		let timerInterval = null;
		let startTime = 0;
		let elapsedTime = 0;

		const timerDisplay = document.getElementById('timer-display');
		const timerStartBtn = document.getElementById('timer-start-btn');
		const timerPauseBtn = document.getElementById('timer-pause-btn');
		const timerResetBtn = document.getElementById('timer-reset-btn');

		function updateTimer() {
			const now = Date.now();
			const totalMs = elapsedTime + (now - startTime);
			const totalSec = Math.floor(totalMs / 1000);
			const ms = Math.floor((totalMs % 1000) / 100);
			const mins = Math.floor(totalSec / 60);
			const secs = totalSec % 60;

			const mStr = String(mins).padStart(2, '0');
			const sStr = String(secs).padStart(2, '0');

			if (timerDisplay) {
				timerDisplay.textContent = `${mStr}:${sStr}.${ms}`;
				if (mins >= 3) {
					timerDisplay.style.color = '#DC2626';
				} else {
					timerDisplay.style.color = 'var(--fg-pencil)';
				}
			}
		}

		if (timerStartBtn) {
			timerStartBtn.addEventListener('click', () => {
				startTime = Date.now();
				timerInterval = setInterval(updateTimer, 100);
				timerStartBtn.style.display = 'none';
				if (timerPauseBtn) timerPauseBtn.style.display = 'inline-block';
			});
		}

		if (timerPauseBtn) {
			timerPauseBtn.addEventListener('click', () => {
				clearInterval(timerInterval);
				elapsedTime += Date.now() - startTime;
				timerPauseBtn.style.display = 'none';
				if (timerStartBtn) {
					timerStartBtn.textContent = '▶ 再開';
					timerStartBtn.style.display = 'inline-block';
				}
			});
		}

		if (timerResetBtn) {
			timerResetBtn.addEventListener('click', () => {
				clearInterval(timerInterval);
				elapsedTime = 0;
				if (timerDisplay) {
					timerDisplay.textContent = '00:00.0';
					timerDisplay.style.color = 'var(--fg-pencil)';
				}
				if (timerStartBtn) {
					timerStartBtn.textContent = '▶ スタート';
					timerStartBtn.style.display = 'inline-block';
				}
				if (timerPauseBtn) timerPauseBtn.style.display = 'none';
			});
		}

		analyzeSpeech();
	</script>

