---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const title = "佐藤 綾乃（ウェディングプランナー・卒花マネーアドバイザー）監修者プロフィール | Manage.Wedding 日本版";
const description = "Manage.Wedding 日本版 監修者・佐藤 綾乃（27歳・ブライダル業界歴11年）の公式プロフィール。日本の結婚式市場に特化した見積もり診断・マナー計算機の監修方針をご紹介します。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": "https://manage.wedding/ja/authors/ayano-sato#profile",
      "name": "佐藤 綾乃 監修者プロフィール",
      "url": "https://manage.wedding/ja/authors/ayano-sato",
      "description": "Manage.Wedding 日本版 監修者・佐藤 綾乃のプロフィールおよび監修方針。",
      "mainEntity": {
        "@type": "Person",
        "@id": "https://manage.wedding/ja/authors/ayano-sato#person",
        "name": "佐藤 綾乃",
        "jobTitle": "ウェディングプランナー & 卒花マネーアドバイザー",
        "description": "27歳・ブライダル業界歴11年。元大手ゲストハウス支配人・現フリーアドバイザー。350組以上の挙式を担当し、デザインと和装・伝統文化を愛する卒花プランナー。",
        "worksFor": {
          "@type": "Organization",
          "name": "Manage.Wedding 日本版",
          "url": "https://manage.wedding/ja"
        },
        "knowsAbout": [
          "結婚式 自己負担額・見積もり査定",
          "ご祝儀袋 漢数字（大字）変換・中袋マナー",
          "お車代・心付け相場と新札封筒準備",
          "六曜カレンダーとお日柄割引交渉",
          "両家顔合わせ・婚姻届段取り",
          "席次表 上座下座・肩書きマナー"
        ]
      }
    }
  ]
};

const jaTools = [
  {
    category: "💰 費用・見積もり・自己負担 (/ja/budget)",
    items: [
      { title: "自己負担額シミュレーター（想定ご祝儀と実質手出し計算）", url: "/ja/jiko-futangaku-calculator" },
      { title: "見積もり跳ね上がり予測計算機（初期見積もりからの値上がり診断）", url: "/ja/mitsumori-jump-calculator" },
      { title: "持ち込み料 vs DIY 損益分岐点チェッカー", url: "/ja/mochikomi-savings-calculator" },
      { title: "引き出物・引き菓子 予算＆個数計算機（贈り分け比率）", url: "/ja/hikidemono-calculator" },
      { title: "フォトウェディング・前撮り 費用計算機（ロケ vs スタジオ）", url: "/ja/photo-wedding-calculator" }
    ]
  },
  {
    category: "✉️ ご祝儀・お車代・お礼マナー (/ja/goshugi)",
    items: [
      { title: "お車代＆宿泊費 計算・封筒準備ツール（新幹線・飛行機・新札リスト）", url: "/ja/okurumadai-calculator" },
      { title: "ご祝儀袋・中袋 漢数字（大字）変換ジェネレーター", url: "/ja/goshugi-kanji-formatter" },
      { title: "結婚式 お礼・心付け 相場計算機（受付・主賓・スタッフ謝礼）", url: "/ja/wedding-orei-calculator" }
    ]
  },
  {
    category: "📅 日程・顔合わせ・入籍段取り (/ja/schedule)",
    items: [
      { title: "六曜カレンダー＆大安・仏滅 割引比較チェッカー", url: "/ja/rokuyo-wedding-calendar" },
      { title: "両家顔合わせ 予算・割り勘＆タイムライン作成", url: "/ja/kaoawase-planner" },
      { title: "婚姻届・入籍 準備チェックリスト＆開運日カレンダー", url: "/ja/nyuseki-checklist" }
    ]
  },
  {
    category: "🪑 席次表・2次会・スピーチ運営 (/ja/logistics)",
    items: [
      { title: "結婚式 席次表・上座下座 配置ビルダー", url: "/ja/sekijihyo-seating-builder" },
      { title: "2次会・二次会 会費＆予算計算機（ドタキャン耐性バッファー）", url: "/ja/nijikai-fee-calculator" },
      { title: "友人代表スピーチ＆乾杯 挨拶タイマー（忌み言葉チェッカー）", url: "/ja/speech-toast-timer" },
      { title: "12ヶ月 結婚準備マスターチェックリスト", url: "/ja/wedding-checklist" }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="container" style="padding-top: 2rem; padding-bottom: 5rem; max-width: 960px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "ホーム", url: "/ja" },
        { name: "サイトについて", url: "/ja/about" },
        { name: "佐藤 綾乃 プロフィール" }
      ]}
    />

    <!-- Author Profile Hero Card -->
    <header class="section-paper" style="margin: 2rem 0 3rem; background: #fff; border: 2.5px solid var(--fg-pencil); border-radius: 12px; padding: clamp(1.5rem, 4vw, 3rem); box-shadow: 6px 6px 0px var(--fg-pencil); position: relative;">
      <div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
      
      <div style="display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;">
        <!-- Avatar Circle -->
        <div style="width: 120px; height: 120px; border-radius: 50%; background: #fdf2f8; border: 3px solid var(--fg-pencil); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 800; color: #be185d; box-shadow: 4px 4px 0px var(--fg-pencil); flex-shrink: 0;">
          <span>AS</span>
        </div>
        
        <!-- Info Column -->
        <div style="flex: 1; min-width: 280px;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #ecfdf5; color: #065f46; border: 1.5px solid #10b981; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 800; margin-bottom: 0.5rem;">
            <span>✓ 日本版 監修プランナー</span>
          </div>
          <h1 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.5rem; line-height: 1.2;">
            佐藤 綾乃 <span style="font-size: 1.2rem; color: var(--text-secondary); font-weight: 600;">(Ayano Sato)</span>
          </h1>
          <p class="font-body" style="font-size: 1.15rem; color: #be185d; font-weight: 700; margin: 0 0 0.75rem;">
            ウェディングプランナー & 卒花マネーアドバイザー • Manage.Wedding 日本版
          </p>
          <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; color: var(--text-secondary); font-size: 0.95rem; font-weight: 600;">
            <span>📍 東京都内・全国対応</span>
            <span>•</span>
            <span>🌸 ブライダル業界歴11年</span>
            <span>•</span>
            <span>💍 350組以上の挙式監修</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Bio & Editorial Philosophy -->
    <section class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 2rem 2.5rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); line-height: 1.8; font-size: 1.05rem; color: var(--fg-pencil);">
      <h2 class="font-heading" style="font-size: 1.65rem; color: var(--fg-pencil); border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; margin-top: 0; margin-bottom: 1.25rem;">
        佐藤 綾乃のメッセージと監修理念
      </h2>
      <p>
        <strong>プレ花嫁のみなさま、こんにちは！綾乃です🌸</strong>
      </p>
      <p>
        私は27歳のウェディングプランナー兼アドバイザーです。元々は大手ゲストハウス式場にてブライダルマネージャーとして350組以上の結婚式を担当し、現在はフリーランスとしてプレ花嫁さま向けの見積もり診断やマナー監修を行っています。自身も卒花（結婚式経験者）であり、和紙の風合いや水引デザイン、カリグラフィーや空間コーディネートが大好きです。
      </p>
      <p>
        <strong>Manage.Wedding 日本版を監修する理由:</strong><br>
        式場見学の初期見積もりは、料理や装花、ドレスのランクが最低ランクで計算されていることが多く、<strong>「最終的に平均102万円跳ね上がる」</strong>という現実に多くの新郎新婦が涙しています。また、ご祝儀やお車代、心付けのマナーなど、ゲストに失礼がないか不安を抱えながら準備を進めているプレ花嫁さまがたくさんいらっしゃいます。
      </p>
      <p>
        営業トークや広告のしがらみがない中立な立場で、<strong>「本当の実質手出し額」と「失礼のない本物のマナー」</strong>を誰もが完全無料で計算・確認できるツールをお届けしたいという想いから、Manage.Wedding 日本版の全ツールの計算ロジックと解説記事を監修しています。
      </p>
      
      <!-- Core Principles Box -->
      <div style="background: #fdf6e2; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; margin: 1.5rem 0 0.5rem; box-shadow: 3px 3px 0px rgba(0,0,0,0.06);">
        <strong class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); display: block; margin-bottom: 0.5rem;">
          🌸 佐藤 綾乃の4大監修ポリシー：
        </strong>
        <ul style="margin: 0; padding-left: 1.25rem; font-size: 0.95rem; color: #444; line-height: 1.7;">
          <li><strong>脱・初期見積もり幻想:</strong> 見積もり総額ではなく、ご祝儀と親援助金を差し引いた「自己負担額（実質手出し）」を明快に可視化します。</li>
          <li><strong>マナーの境界線の明確化:</strong> お車代の半額/全額支給ルールや端数1万円切り上げ、漢数字（大字）の正しい書き方を完全ナビゲート。</li>
          <li><strong>完全中立・広告掲載ゼロ:</strong> 特定の結婚式場や提携業者からの紹介料・キックバックは一切受け取っていません。</li>
          <li><strong>おふたりの納得感の最優先:</strong> 伝統マナーを重んじつつ、無駄な式場マージンを省くスマートな工夫をご提案します。</li>
        </ul>
      </div>
    </section>

    <!-- Published Tools Directory -->
    <section>
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin-bottom: 1.5rem;">
        佐藤 綾乃 監修ツール＆解説ガイド一覧（全14ツール）
      </h2>

      <div style="display: flex; flex-direction: column; gap: 2rem;">
        {jaTools.map((cat) => (
          <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; box-shadow: 4px 4px 0px var(--fg-pencil);">
            <h3 class="font-heading" style="font-size: 1.35rem; color: #be185d; margin-top: 0; margin-bottom: 1rem; border-bottom: 1.5px solid #fce7f3; padding-bottom: 0.4rem;">
              {cat.category}
            </h3>
            <ul style="margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
              {cat.items.map((art) => (
                <li>
                  <a href={art.url} style="color: var(--fg-pencil); text-decoration: none; font-weight: 600; font-size: 1.05rem; line-height: 1.4; transition: color 0.1s;" onmouseover="this.style.color='#be185d'" onmouseout="this.style.color='var(--fg-pencil)'">
                    {art.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

  </main>
</Layout>
