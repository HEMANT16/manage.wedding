---
import Layout from '../../layouts/Layout.astro';

const title = "【公式】結婚式 ご祝儀・お車代・お礼マナー 計算＆準備ツール一覧 | Manage.Wedding 日本版";
const description = "遠方ゲストのお車代・宿泊費計算、ご祝儀袋の漢数字（大字）変換ジェネレーター、受付・主賓・スピーチへのお礼相場計算機など、結婚式の現金準備とマナーツール集。完全無料・登録不要・ローカル保存。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/ja/goshugi/#collection",
      "name": "結婚式 ご祝儀・お車代・お礼マナー 計算ツール一覧",
      "url": "https://manage.wedding/ja/goshugi",
      "description": "遠方ゲストのお車代計算、ご祝儀袋の漢数字（大字）変換、主賓・受付へのお礼相場ツール集。",
      "inLanguage": "ja",
      "hasPart": [
        { "@type": "WebApplication", "name": "お車代＆宿泊費 計算・封筒準備ツール", "url": "https://manage.wedding/ja/okurumadai-calculator" },
        { "@type": "WebApplication", "name": "ご祝儀袋・中袋 漢数字変換ジェネレーター", "url": "https://manage.wedding/ja/goshugi-kanji-formatter" },
        { "@type": "WebApplication", "name": "結婚式 お礼・心付け 相場計算機", "url": "https://manage.wedding/ja/wedding-orei-calculator" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "遠方から来るゲストのお車代は全額出すべきですか？半額でも良いですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "新幹線や飛行機を利用する遠方ゲストには、交通費の「半額〜全額」を支給するのがマナーです。端数は切り上げ、1万円・2万円・3万円などキリの良い金額を新札でご祝儀袋やポチ袋に包みます。宿泊が必要な場合は、ホテルを手配して新郎新婦側で全額負担するのが一般的です。"
          }
        },
        {
          "@type": "Question",
          "name": "ご祝儀袋の中袋に書く漢数字（大字）はどう書きますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "改ざんを防ぐため旧字体の漢数字（大字）を使用します。3万円は「金 参萬圓 也（または金 参万円）」、5万円は「金 伍萬圓 也」、10万円は「金 拾萬圓 也」と縦書きの中央に楷書で記入します。"
          }
        },
        {
          "@type": "Question",
          "name": "受付をしてくれた友人へのお礼の相場はいくらですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "受付は通常2名（新郎側1名・新婦側1名）に依頼し、お礼として1人あたり3,000円〜5,000円を新札で用意します。おしゃれなポチ袋に入れ、受付開始前に新郎新婦の親から直接お渡しするのが一般的なマナーです。"
          }
        },
        {
          "@type": "Question",
          "name": "主賓スピーチ・乾杯の挨拶をお願いした上司へのお礼はいくらですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "主賓のスピーチや乾杯のご発声をお願いした方には、1万円〜3万円が相場です。「御車代」名目で結び切りの祝儀袋に入れ、挙式前に新郎新婦の親からご挨拶とともにお渡しします。お車代が別途発生する場合は、御礼と合算して1つの封筒にまとめます。"
          }
        }
      ]
    }
  ]
};

const tools = [
  {
    title: "お車代＆宿泊費 計算・封筒準備ツール",
    url: "/ja/okurumadai-calculator",
    icon: "🚗",
    badge: "遠方ゲスト必須",
    badgeBg: "#FEE2E2",
    badgeText: "#991B1B",
    lead: "新幹線・飛行機代の半額/全額支給ルールと端数切り上げ（1万円単位）に対応。ゲストの出発地と交通手段を入力するだけで、お車代の金額と新札封筒の準備リストを自動生成。",
    highlights: ["出発地→式場間の交通費計算", "半額/全額支給の自動選択", "宿泊手配リスト＆封筒準備チェック"],
    cta: "お車代を計算する →"
  },
  {
    title: "ご祝儀袋・中袋 漢数字変換ジェネレーター",
    url: "/ja/goshugi-kanji-formatter",
    icon: "🖋️",
    badge: "書き方マナー",
    badgeBg: "#E0E7FF",
    badgeText: "#3730A3",
    lead: "「3万円→金 参萬圓 也」「5万円→金 伍萬圓 也」など、旧字体の大字への即時変換と中袋・表書き（寿 / 御祝）の正しい縦書き配置をプレビュー表示。",
    highlights: ["旧字体大字への即時変換", "中袋の裏面（住所・氏名）配置", "表書き＆水引の選び方ガイド"],
    cta: "漢数字を変換する →"
  },
  {
    title: "結婚式 お礼・心付け 相場計算機",
    url: "/ja/wedding-orei-calculator",
    icon: "🧧",
    badge: "謝礼マナー",
    badgeBg: "#DCFCE7",
    badgeText: "#166534",
    lead: "受付（3〜5千円）、主賓スピーチ・乾杯（1〜3万円）、司会、ヘアメイク、カメラマン、介添えへの御礼・心付け相場を自動算出。必要な新札枚数と封筒リストも生成。",
    highlights: ["役割別の相場を自動適用", "必要な新札枚数リスト", "封筒の表書き＆渡し方ガイド"],
    cta: "お礼・心付けを計算する →"
  }
];

const oreiTable = [
  { role: "主賓（祝辞）・乾杯の挨拶", amount: "10,000 〜 30,000円", envelope: "結び切り祝儀袋（御車代/御礼）", timing: "挙式前、新郎新婦の親から", note: "お車代が別途必要な場合は合算OK" },
  { role: "受付を担当してくれた友人", amount: "3,000 〜 5,000円", envelope: "おしゃれなポチ袋（お礼/心ばかり）", timing: "受付開始前、親から手渡し", note: "通常2名（新郎側1名＋新婦側1名）" },
  { role: "スピーチ・余興をしてくれた友人", amount: "3,000 〜 5,000円 or ギフト", envelope: "ポチ袋 / ギフトカード", timing: "お見送り時、新郎新婦から", note: "後日食事に誘ってお礼する方も" },
  { role: "遠方ゲスト（新幹線・飛行機利用）", amount: "往復交通費の半額〜全額（1万単位）", envelope: "金額に応じた祝儀袋 / ポチ袋", timing: "受付で担当者経由で手渡し", note: "宿泊費は別途手配が原則" },
  { role: "司会（プロ外注）", amount: "式場手配なら追加なし", envelope: "—", timing: "—", note: "知人に頼む場合は1万〜3万円＋ギフト" },
  { role: "ヘアメイク・着付けスタッフ", amount: "3,000 〜 10,000円（心付け）", envelope: "ポチ袋（お心づけ/寸志）", timing: "支度開始前、新婦から直接", note: "式場スタッフは辞退する場合あり" },
  { role: "介添えスタッフ（アテンダー）", amount: "3,000 〜 5,000円", envelope: "ポチ袋（お心づけ）", timing: "挙式前、新婦または親から", note: "終日付き添いへの感謝として" }
];

const kanjiSamples = [
  { yen: "10,000円（壱萬圓）", kanji: "壱萬圓", usage: "受付お礼・心付け" },
  { yen: "20,000円（弐萬圓）", kanji: "弐萬圓", usage: "お車代（中距離）" },
  { yen: "30,000円（参萬圓）", kanji: "参萬圓", usage: "友人のご祝儀相場" },
  { yen: "50,000円（伍萬圓）", kanji: "伍萬圓", usage: "上司・恩師のご祝儀" },
  { yen: "70,000円（七萬圓）", kanji: "七萬圓", usage: "夫婦出席のご祝儀" },
  { yen: "100,000円（拾萬圓）", kanji: "拾萬圓", usage: "親族のご祝儀" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Category Hero Section -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3rem) 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1100px; margin: 0 auto;">
			
			<!-- Breadcrumb Link -->
			<div style="margin-bottom: 1.25rem; font-size: 0.88rem;">
				<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
				<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
				<span style="color: var(--text-secondary);">ご祝儀・お車代・お礼マナー</span>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #E0E7FF; border: 1.5px solid #A5B4FC; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 800; color: #3730A3; margin-bottom: 1rem;">
						<span>✉️</span>
						<span>CATEGORY 02 • ご祝儀マナー＆現金準備</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
						ご祝儀・お車代・お礼マナー<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #C7D2FE 65%);">計算＆準備ツール一覧</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.8; margin-bottom: 1.5rem;">
						「遠方ゲストのお車代は全額？半額？」「ご祝儀袋の漢数字はどう書く？」「主賓への御礼はいくら包む？」——結婚式当日に必要な<strong>現金の金額・枚数・封筒・渡し方</strong>をすべて自動計算。恥をかかない完璧なマナー対応をサポートします。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.80rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.80rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.80rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷
						</span>
					</div>
				</div>

				<!-- Mini Live Calculator: Quick Orei Total Estimator -->
				<div class="hand-card" style="background: #fff; padding: 1.5rem; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil);">
					<div class="tape" style="top: -12px; left: 30%;"></div>
					<div style="font-size: 0.82rem; font-weight: 800; color: #3730A3; text-transform: uppercase; margin-bottom: 0.3rem;">
						QUICK ESTIMATOR
					</div>
					<h3 style="font-size: 1.1rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 1rem;">
						✉️ お車代・お礼 クイック試算
					</h3>

					<div style="display: flex; flex-direction: column; gap: 0.65rem; margin-bottom: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
							<label for="q-shubin" style="font-weight: 700;">主賓・乾杯の挨拶</label>
							<div style="display: flex; align-items: center; gap: 0.35rem;">
								<input type="number" id="q-shubin" value="2" min="0" max="5" style="width: 48px; text-align: center; padding: 3px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
								<span style="font-size: 0.78rem;">名 × 2万円</span>
							</div>
						</div>

						<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
							<label for="q-uketsuke" style="font-weight: 700;">受付担当の友人</label>
							<div style="display: flex; align-items: center; gap: 0.35rem;">
								<input type="number" id="q-uketsuke" value="2" min="0" max="6" style="width: 48px; text-align: center; padding: 3px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
								<span style="font-size: 0.78rem;">名 × 5千円</span>
							</div>
						</div>

						<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
							<label for="q-enpo" style="font-weight: 700;">遠方ゲスト（お車代）</label>
							<div style="display: flex; align-items: center; gap: 0.35rem;">
								<input type="number" id="q-enpo" value="5" min="0" max="50" style="width: 48px; text-align: center; padding: 3px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
								<span style="font-size: 0.78rem;">名 × 2万円</span>
							</div>
						</div>

						<div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
							<label for="q-kokorozuke" style="font-weight: 700;">心付け（ヘアメイク等）</label>
							<div style="display: flex; align-items: center; gap: 0.35rem;">
								<input type="number" id="q-kokorozuke" value="3" min="0" max="10" style="width: 48px; text-align: center; padding: 3px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px;" />
								<span style="font-size: 0.78rem;">名 × 5千円</span>
							</div>
						</div>
					</div>

					<div style="background: #EFF6FF; border: 2px solid #2563EB; border-radius: 6px; padding: 0.75rem 1rem; text-align: center;">
						<div style="font-size: 0.78rem; font-weight: 800; color: #1E40AF;">当日に必要な現金合計（概算）</div>
						<div id="q-result" style="font-size: 1.6rem; font-weight: 900; color: #1E40AF; margin-top: 0.2rem;">
							175,000 円
						</div>
						<div style="font-size: 0.72rem; color: #2563EB; margin-top: 0.2rem;">※ 新札で銀行から両替しておきましょう</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Main Tools Section -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1100px; margin: 0 auto;">
			
			<!-- Tool Cards Grid -->
			<div style="display: flex; flex-direction: column; gap: 1.75rem; margin-bottom: 3.5rem;">
				{tools.map((tool) => (
					<div class="hand-card" style="background: #fff; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); overflow: hidden;">
						
						<div style="padding: clamp(1.25rem, 3vw, 2rem);">
							<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
								<span style="font-size: 1.8rem;">{tool.icon}</span>
								<span style={`font-size: 0.75rem; font-weight: 700; padding: 3px 8px; border-radius: 4px; background: ${tool.badgeBg}; color: ${tool.badgeText}; border: 1px solid ${tool.badgeText}22;`}>
									{tool.badge}
								</span>
							</div>

							<h2 style="font-size: 1.3rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.5rem; line-height: 1.4;">
								{tool.title}
							</h2>

							<p style="font-size: 0.90rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 1rem;">
								{tool.lead}
							</p>

							<ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; display: flex; flex-direction: column; gap: 0.3rem;">
								{tool.highlights.map((h) => (
									<li style="font-size: 0.82rem; color: var(--fg-pencil); font-weight: 600; display: flex; align-items: center; gap: 0.4rem;">
										<span style="color: #2563EB; font-weight: 800;">✓</span> {h}
									</li>
								))}
							</ul>

							<a href={tool.url} class="hand-btn" style="text-align: center; text-decoration: none; display: inline-block; padding: 10px 20px; font-size: 0.90rem; font-weight: 800;">
								{tool.cta}
							</a>
						</div>

					</div>
				))}
			</div>

			<!-- Comprehensive Orei / Okurumadai Etiquette Table -->
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); margin-bottom: 3.5rem; border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil);">
				<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
					📋 【早見表】結婚式のお礼・お車代・心付け 相場一覧
				</h2>
				<p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
					当日の朝慌てないよう、事前にすべての封筒・新札を準備しておきましょう。
				</p>

				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
						<thead>
							<tr style="border-bottom: 2px solid var(--fg-pencil); background: #FAF8F5;">
								<th style="padding: 10px 12px; font-weight: 800;">対象 / 役割</th>
								<th style="padding: 10px 12px; font-weight: 800; color: #1E40AF;">相場金額</th>
								<th style="padding: 10px 12px; font-weight: 800;">封筒の種類</th>
								<th style="padding: 10px 12px; font-weight: 800;">渡すタイミング</th>
								<th style="padding: 10px 12px; font-weight: 800;">補足</th>
							</tr>
						</thead>
						<tbody>
							{oreiTable.map((row) => (
								<tr style="border-bottom: 1px dashed #e2e8f0;">
									<td style="padding: 10px 12px; font-weight: 700; color: var(--fg-pencil);">{row.role}</td>
									<td style="padding: 10px 12px; font-weight: 800; color: #1E40AF; background: #EFF6FF;">{row.amount}</td>
									<td style="padding: 10px 12px;">{row.envelope}</td>
									<td style="padding: 10px 12px; font-size: 0.82rem;">{row.timing}</td>
									<td style="padding: 10px 12px; font-size: 0.78rem; color: var(--text-secondary);">{row.note}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Kanji Daiji Quick Reference Table -->
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); margin-bottom: 3.5rem; border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil);">
				<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
					🖋️ 【早見表】ご祝儀袋の旧字体・大字 変換一覧
				</h2>
				<p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
					中袋には改ざん防止のため旧字体（大字）で金額を記入します。楷書で丁寧に書きましょう。
				</p>

				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
						<thead>
							<tr style="border-bottom: 2px solid var(--fg-pencil); background: #FAF8F5;">
								<th style="padding: 10px 12px; font-weight: 800;">金額（算用数字）</th>
								<th style="padding: 10px 12px; font-weight: 800; color: #3730A3; font-size: 1rem;">大字表記</th>
								<th style="padding: 10px 12px; font-weight: 800;">中袋に書く文例</th>
								<th style="padding: 10px 12px; font-weight: 800;">よく使う場面</th>
							</tr>
						</thead>
						<tbody>
							{kanjiSamples.map((row) => (
								<tr style="border-bottom: 1px dashed #e2e8f0;">
									<td style="padding: 10px 12px; font-weight: 700;">{row.yen}</td>
									<td style="padding: 10px 12px; font-weight: 900; font-size: 1.05rem; color: #3730A3; background: #E0E7FF;">金 {row.kanji} 也</td>
									<td style="padding: 10px 12px; font-weight: 700; color: var(--fg-pencil);">金 {row.kanji} 也</td>
									<td style="padding: 10px 12px; font-size: 0.82rem; color: var(--text-secondary);">{row.usage}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<!-- FAQ Section -->
			<div style="max-width: 850px; margin: 0 auto 3.5rem auto;">
				<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); text-align: center; margin-bottom: 1.25rem;">
					ご祝儀・お車代・お礼に関するよくあるご質問（FAQ）
				</h2>

				<div style="display: flex; flex-direction: column; gap: 0.75rem;">
					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							遠方から来るゲストのお車代は全額出すべきですか？半額でも良いですか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							新幹線や飛行機を利用する遠方ゲストには、交通費の「半額〜全額」を支給するのがマナーです。端数は切り上げ、1万円・2万円・3万円などキリの良い金額を新札でご祝儀袋やポチ袋に包みます。宿泊が必要な場合は、ホテルを手配して新郎新婦側で全額負担するのが一般的です。
						</p>
					</details>

					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							ご祝儀袋の中袋に書く漢数字（大字）はどう書きますか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							改ざんを防ぐため旧字体の漢数字（大字）を使用します。3万円は「金 参萬圓 也（または金 参万円）」、5万円は「金 伍萬圓 也」、10万円は「金 拾萬圓 也」と縦書きの中央に楷書で記入します。
						</p>
					</details>

					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							受付をしてくれた友人へのお礼の相場はいくらですか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							受付は通常2名（新郎側1名・新婦側1名）に依頼し、お礼として1人あたり3,000円〜5,000円を新札で用意します。おしゃれなポチ袋に入れ、受付開始前に新郎新婦の親から直接お渡しするのが一般的なマナーです。
						</p>
					</details>

					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							主賓スピーチ・乾杯の挨拶をお願いした上司へのお礼はいくらですか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							主賓のスピーチや乾杯のご発声をお願いした方には、1万円〜3万円が相場です。「御車代」名目で結び切りの祝儀袋に入れ、挙式前に新郎新婦の親からご挨拶とともにお渡しします。お車代が別途発生する場合は、御礼と合算して1つの封筒にまとめます。
						</p>
					</details>
				</div>
			</div>

			<!-- Cross Category Navigation -->
			<div style="border-top: 2px dashed #e2e8f0; padding-top: 2.5rem;">
				<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); text-align: center; margin-bottom: 1.25rem;">
					他のカテゴリの計算ツール
				</h2>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
					<a href="/ja/budget" class="hand-card" style="background: #fff; padding: 1.25rem; text-decoration: none; color: inherit; border: 2px solid var(--fg-pencil); box-shadow: 3px 3px 0px var(--fg-pencil);">
						<div style="font-size: 0.75rem; font-weight: 800; color: #991B1B; margin-bottom: 0.25rem;">CATEGORY 01</div>
						<div style="font-size: 1.05rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.35rem;">💰 費用・見積もり・自己負担</div>
						<div style="font-size: 0.82rem; color: var(--text-secondary);">自己負担額・値上がり予測・持ち込み料など全5ツール →</div>
					</a>

					<a href="/ja/schedule" class="hand-card" style="background: #fff; padding: 1.25rem; text-decoration: none; color: inherit; border: 2px solid var(--fg-pencil); box-shadow: 3px 3px 0px var(--fg-pencil);">
						<div style="font-size: 0.75rem; font-weight: 800; color: #B45309; margin-bottom: 0.25rem;">CATEGORY 03</div>
						<div style="font-size: 1.05rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.35rem;">📅 スケジュール・段取り</div>
						<div style="font-size: 0.82rem; color: var(--text-secondary);">準備タイムライン・当日進行表など →</div>
					</a>

					<a href="/ja/logistics" class="hand-card" style="background: #fff; padding: 1.25rem; text-decoration: none; color: inherit; border: 2px solid var(--fg-pencil); box-shadow: 3px 3px 0px var(--fg-pencil);">
						<div style="font-size: 0.75rem; font-weight: 800; color: #0E7490; margin-bottom: 0.25rem;">CATEGORY 04</div>
						<div style="font-size: 1.05rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.35rem;">🪑 席次表・2次会・スピーチ</div>
						<div style="font-size: 0.82rem; color: var(--text-secondary);">席次上座下座・2次会会費・スピーチなど →</div>
					</a>
				</div>
			</div>

		</div>
	</section>

	<!-- Mini Calculator Script -->
	<script is:inline>
		const qShubin = document.getElementById('q-shubin');
		const qUketsuke = document.getElementById('q-uketsuke');
		const qEnpo = document.getElementById('q-enpo');
		const qKokorozuke = document.getElementById('q-kokorozuke');
		const qResult = document.getElementById('q-result');

		function calcQuickOrei() {
			const nShubin = parseInt(qShubin?.value || '0', 10);
			const nUketsuke = parseInt(qUketsuke?.value || '0', 10);
			const nEnpo = parseInt(qEnpo?.value || '0', 10);
			const nKokorozuke = parseInt(qKokorozuke?.value || '0', 10);

			const total = (nShubin * 20000) + (nUketsuke * 5000) + (nEnpo * 20000) + (nKokorozuke * 5000);

			if (qResult) {
				qResult.textContent = `${total.toLocaleString('ja-JP')} 円`;
			}
		}

		[qShubin, qUketsuke, qEnpo, qKokorozuke].forEach(el => {
			if (el) {
				el.addEventListener('input', calcQuickOrei);
				el.addEventListener('change', calcQuickOrei);
			}
		});

		calcQuickOrei();
	</script>

</Layout>
