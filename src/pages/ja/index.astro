		];

		const searchInput = document.getElementById('ja-search-input');
		const searchResults = document.getElementById('ja-search-results');

		if (searchInput && searchResults) {
			searchInput.addEventListener('input', (e) => {
				const q = e.target.value.trim().toLowerCase();
				if (!q) {
					searchResults.style.display = 'none';
					searchResults.innerHTML = '';
					return;
				}

				const matched = searchData.filter(item => 
					item.title.toLowerCase().includes(q) || 
					item.keywords.toLowerCase().includes(q) ||
					item.cat.toLowerCase().includes(q)
				);

				if (matched.length === 0) {
					searchResults.innerHTML = '<div style="padding: 10px 14px; font-size: 0.88rem; color: #64748b;">該当するツールが見つかりませんでした</div>';
					searchResults.style.display = 'block';
					return;
				}

				searchResults.innerHTML = matched.map(m => `
