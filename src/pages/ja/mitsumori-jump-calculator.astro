				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Client Script for Calculator -->
	<script is:inline>
		const quoteRange = document.getElementById('initial-quote-range');
		const quoteBadge = document.getElementById('initial-quote-badge');
		const guestInput = document.getElementById('guest-count-input');
		const serviceSelect = document.getElementById('service-rate-select');

		const dressSelect = document.getElementById('dress-upgrade');
		const foodSelect = document.getElementById('food-upgrade');
		const drinkSelect = document.getElementById('drink-upgrade');
		const movieSelect = document.getElementById('movie-upgrade');
		const flowerSelect = document.getElementById('flower-upgrade');
		const photoSelect = document.getElementById('photo-upgrade');

		const dressDisplay = document.getElementById('dress-cost-display');
		const foodDisplay = document.getElementById('food-cost-display');
		const drinkDisplay = document.getElementById('drink-cost-display');
		const movieDisplay = document.getElementById('movie-cost-display');
		const flowerDisplay = document.getElementById('flower-cost-display');
		const photoDisplay = document.getElementById('photo-cost-display');

		const resInitQuote = document.getElementById('res-init-quote');
		const resJumpTotal = document.getElementById('res-jump-total');
		const resFinalInvoice = document.getElementById('res-final-invoice');
		const resJumpPct = document.getElementById('res-jump-percentage');
		const jumpBadge = document.getElementById('jump-status-badge');

		const barInitial = document.getElementById('bar-initial');
		const barJump = document.getElementById('bar-jump');

		const resetBtn = document.getElementById('reset-jump-btn');
		const printBtn = document.getElementById('print-jump-sheet-btn');

		function calculateJump() {
			const initQuote = parseFloat(quoteRange?.value || '2800000');
			const guests = parseInt(guestInput?.value || '60', 10);
			const serviceRate = parseFloat(serviceSelect?.value || '0.10');
			const taxRate = 0.10; // Japanese consumption tax 10%

			// Raw upgrade items
			const dressRaw = parseFloat(dressSelect?.value || '0');
			const foodPerHead = parseFloat(foodSelect?.value || '0');
			const drinkPerHead = parseFloat(drinkSelect?.value || '0');
			const movieRaw = parseFloat(movieSelect?.value || '0');
			const flowerRaw = parseFloat(flowerSelect?.value || '0');
			const photoRaw = parseFloat(photoSelect?.value || '0');

			const foodRawTotal = foodPerHead * guests;
			const drinkRawTotal = drinkPerHead * guests;

			// Update Item Cost Displays
			if (dressDisplay) dressDisplay.textContent = `+${dressRaw.toLocaleString('ja-JP')} 円`;
			if (foodDisplay) foodDisplay.textContent = `+${foodRawTotal.toLocaleString('ja-JP')} 円`;
			if (drinkDisplay) drinkDisplay.textContent = `+${drinkRawTotal.toLocaleString('ja-JP')} 円`;
			if (movieDisplay) movieDisplay.textContent = `+${movieRaw.toLocaleString('ja-JP')} 円`;
			if (flowerDisplay) flowerDisplay.textContent = `+${flowerRaw.toLocaleString('ja-JP')} 円`;
			if (photoDisplay) photoDisplay.textContent = `+${photoRaw.toLocaleString('ja-JP')} 円`;

			// Total Base Upgrade Items
			const totalRawUpgrades = dressRaw + foodRawTotal + drinkRawTotal + movieRaw + flowerRaw + photoRaw;

			// With service fee and tax multiplier (Item * (1 + serviceRate) * (1 + taxRate))
			const jumpMultiplier = (1 + serviceRate) * (1 + taxRate);
			const totalJumpWithTax = Math.round(totalRawUpgrades * jumpMultiplier);
			const finalInvoiceTotal = initQuote + totalJumpWithTax;

			const jumpPercent = initQuote > 0 ? ((totalJumpWithTax / initQuote) * 100).toFixed(1) : '0.0';

			// Update Text Outputs
			if (quoteBadge) quoteBadge.textContent = `${initQuote.toLocaleString('ja-JP')} 円`;
			if (resInitQuote) resInitQuote.textContent = `${initQuote.toLocaleString('ja-JP')} 円`;
			if (resJumpTotal) resJumpTotal.textContent = `+ ${totalJumpWithTax.toLocaleString('ja-JP')} 円`;
			if (resFinalInvoice) resFinalInvoice.textContent = `${finalInvoiceTotal.toLocaleString('ja-JP')} 円`;
			if (resJumpPct) resJumpPct.textContent = `（初期見積もりから +${jumpPercent}% のアップ）`;

			// Jump Severity Status
			if (jumpBadge) {
				if (totalJumpWithTax <= 500000) {
					jumpBadge.textContent = '✅ 優秀な抑制プラン（値上がりを50万円以内にしっかり抑えられています）';
					jumpBadge.style.background = '#ECFDF5';
					jumpBadge.style.borderColor = '#A7F3D0';
					jumpBadge.style.color = '#065F46';
				} else if (totalJumpWithTax <= 1500000) {
					jumpBadge.textContent = '⚠️ 全国平均通りの値上がり（+100万〜150万円）です。予算調整を推奨。';
					jumpBadge.style.background = '#FEF3C7';
					jumpBadge.style.borderColor = '#FDE68A';
					jumpBadge.style.color = '#92400E';
				} else {
					jumpBadge.textContent = '🚨 危険な大幅アップ（+150万円以上）。持ち込みや自作で即見直しが必要です。';
					jumpBadge.style.background = '#FEF2F2';
					jumpBadge.style.borderColor = '#FCA5A5';
					jumpBadge.style.color = '#991B1B';
				}
			}

			// Breakdown Bar Chart
			if (barInitial && barJump && finalInvoiceTotal > 0) {
				const pctInit = Math.min(100, Math.round((initQuote / finalInvoiceTotal) * 100));
				const pctJump = Math.max(0, 100 - pctInit);

				barInitial.style.width = `${pctInit}%`;
				barInitial.textContent = `初期見積 ${pctInit}%`;

				barJump.style.width = `${pctJump}%`;
				barJump.textContent = `値上がり ${pctJump}%`;
			}
		}

		// Event Listeners
		[quoteRange, guestInput, serviceSelect, dressSelect, foodSelect, drinkSelect, movieSelect, flowerSelect, photoSelect].forEach(el => {
			if (el) el.addEventListener('input', calculateJump);
		});

		// Reset Button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (quoteRange) quoteRange.value = '2800000';
				if (guestInput) guestInput.value = '60';
				if (serviceSelect) serviceSelect.value = '0.10';
				if (dressSelect) dressSelect.value = '250000';
				if (foodSelect) foodSelect.value = '3000';
				if (drinkSelect) drinkSelect.value = '1500';
				if (movieSelect) movieSelect.value = '220000';
				if (flowerSelect) flowerSelect.value = '180000';
				if (photoSelect) photoSelect.value = '150000';
				calculateJump();
			});
		}

		// Print Button
		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Initial Run
		calculateJump();
	</script>

</Layout>
