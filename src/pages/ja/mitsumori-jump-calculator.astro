---
import Layout from '../../layouts/Layout.astro';

const title = "【結婚式 見積もり跳ね上がり予測計算機】値上がり平均+100万円を契約前に完全診断 | Manage.Wedding 日本版";
const description = "「初期見積もりから100万円以上上がった…」を防ぐ専門シミュレーター。ドレス差額、料理・ドリンクのランクアップ、撮って出しエンドロール、装花ボリュームなど、契約後に跳ね上がるリアルな最終請求金額を瞬時に予測。完全無料・登録不要・A4/PDF印刷対応。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/mitsumori-jump-calculator#app",
      "name": "結婚式 見積もり跳ね上がり予測計算機",
      "url": "https://manage.wedding/ja/mitsumori-jump-calculator",
      "description": "日本の結婚式場特有の初期見積もりからの値上がり（平均100万〜150万円）を契約前に項目別に診断し、リアルな最終請求見込み額を算出するシミュレーター。",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "結婚式の初期見積もりからの値上がりを防ぐ5つの手順",
      "description": "式場契約前に初期見積もりの最低ランク項目を見直し、最終請求書とのギャップをなくす実践ステップ。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "初期見積もりの各項目ランク（松竹梅）を確認する",
          "text": "料理、衣装、装花、写真・映像が「最安プラン（梅）」で設定されていないかプランナーに確認します。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "本命ドレスと料理の中間〜上位ランクで再見積もりを取る",
          "text": "契約前に「着たいブランドドレスの平均価格（30万〜40万円）」と「牛フィレ肉コース（1.6万〜1.8万円）」を反映した見積もりを作成してもらいます。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "初期見積もりに含まれていない必須演出を洗い出す",
          "text": "撮って出しエンドロールムービー、記録ビデオ、ブーケ2点目、親族着付け代、引き出物袋など、未掲載の項目を追加します。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "持ち込み料の発生条件と免除交渉を行う",
          "text": "ドレス、カメラマン、ペーパーアイテム、ムービーの持ち込み可否と保管料を契約前に確認し、可能な限り無料化の交渉を行います。"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "サービス料（10〜15%）と消費税を加味した最終総額を算出する",
          "text": "項目アップ分に加算されるサービス料と消費税（計約21〜26.5%の割増）を含めたリアルな最終請求見込み額を把握します。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "日本の結婚式で初期見積もりから最終見積もりは平均いくら上がりますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ゼクシィ結婚トレンド調査によると、約80%のカップルが初期見積もりから値上がりを経験しており、その平均値上がり額は「約100万〜150万円」です。特にドレス衣装差額、料理・ドリンクのランクアップ、撮って出しエンドロールムービーの3大項目が値上がりの約7割を占めています。"
          }
        },
        {
          "@type": "Question",
          "name": "式場はなぜ最初からリアルな見積もりを出してくれないのですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "見学時のカップルに「予算内で挙げられる」と好印象を持ってもらい成約率を高めるため、最低限のベースプラン（最安料理、最低限の装花、基本ドレスプラン）で見積書を作成する式場が多いためです。悪気はなくとも業界の商慣習となっているため、新郎新婦側から中間ランクでの見積もり提示を依頼する必要があります。"
          }
        },
        {
          "@type": "Question",
          "name": "契約後に見積もりを下げたい場合、どこを削るのが最も効果的ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ゲストの満足度に直結する料理や引き出物は削らず、「ペーパーアイテム（招待状・席次表）の自作・Web化（約15万〜20万円節約）」「オープニング＆プロフィールムービーの自作（約10万〜15万円節約）」「装花をキャンドルやグリーンで高見えさせる（約10万〜15万円節約）」の3点を実践するのが最も効果的です。"
          }
        },
        {
          "@type": "Question",
          "name": "持ち込み料の交渉は契約後でもできますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "契約後の持ち込み料免除や値引き交渉は非常に困難です。式場側の約款に同意してサインした後のため、原則として規定通りの持ち込み料（ドレス1着5万円、カメラマン3万〜5万円等）が発生します。必ず「契約書にサイン・内金を支払う前」に持ち込み条件を交渉してください。"
          }
        },
        {
          "@type": "Question",
          "name": "サービス料とは何ですか？なぜ追加項目にもかかるのですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "サービス料とは、披露宴当日の配膳スタッフや音響照明オペレーターへのサービス対価として式場が請求する費用（通常10%〜15%）です。料理やドリンク、会場費などをランクアップすると、その増額分に対してもサービス料と消費税が連動して加算されるため、予想以上に最終請求額が跳ね上がる原因となります。"
          }
        }
      ]
    }
  ]
};

const topJumpRankings = [
  { rank: "1位", category: "👗 衣装・ドレス・タキシード", avgJump: "+20万 〜 45万円", trigger: "初期見積もりの基本ドレス（15万〜20万円）では選べる種類が少なく、人気のインポート・ブランドドレス（35万〜50万円）を選ぶため。" },
  { rank: "2位", category: "🍽️ 料理・フリードリンク", avgJump: "+20万 〜 40万円", trigger: "試食会で最安コース（1.2万円）の内容に不安を感じ、国産牛やオマール海老のコース（1.6万〜2万円）へランクアップするため。" },
  { rank: "3位", category: "📹 撮って出しエンドロール＆記録映像", avgJump: "+25万 〜 45万円", trigger: "初期見積もりに一切含まれていないことが多く、当日の感動的なダイジェスト映像や全編記録撮影を追加するため。" },
  { rank: "4位", category: "💐 会場装花・ブーケ", avgJump: "+15万 〜 30万円", trigger: "初期見積もりの装花はボリュームが寂しく、メイン高砂の華やかさやゲスト卓装花、お色直しブーケを追加するため。" },
  { rank: "5位", category: "📷 スナップ写真アルバム・全データ", avgJump: "+10万 〜 20万円", trigger: "挙式のみの撮影から披露宴全編スナップ＋全カットデータ納品＋親用増刷アルバムを追加するため。" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<a href="/ja/budget" style="color: #2563EB; text-decoration: none; font-weight: 600;">費用・見積もり</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">見積もり跳ね上がり予測計算機</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FEF3C7; border: 1.5px solid #FDE68A; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #92400E; margin-bottom: 0.75rem;">
						<span>📈</span>
						<span>契約前・最終請求書 診断ツール</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						見積もり跳ね上がり予測<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">計算機</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						「契約後に見積もりが100万円以上上がった…」を防ぐ。初期見積もりに潜む<strong>ドレス差額・料理ランクアップ・エンドロール等の追加費用</strong>を事前に洗い出し、リアルな最終請求書額を予測します。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 40%;"></div>
						<img 
							src="/images/ja_mitsumori_flatlay.webp" 
							alt="結婚式の見積書チェックと虫眼鏡・リングのフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							🔍 契約前の「見積もり精査」が、最高の節約になります。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Calculator Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
							📊 見積もり跳ね上がり診断フォーム
						</h2>
						<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
							初期見積もり金額と、希望するランクアップ項目を選択してください。
						</p>
					</div>
					<button id="reset-jump-btn" type="button" style="font-size: 0.80rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
						🔄 初期値に戻す
					</button>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2.5rem;">
					
					<!-- Left Form: Base Inputs & Upgrades -->
					<div>
						
						<!-- Base Settings -->
						<div style="margin-bottom: 1.75rem; background: #FAF8F5; border: 1.5px solid #e2e8f0; border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.85rem; font-weight: 900; color: #2563EB; margin-bottom: 0.75rem; text-transform: uppercase;">
								1. 初期見積もりとゲスト人数の設定
							</div>

							<div style="margin-bottom: 1rem;">
								<label for="initial-quote-input" style="display: flex; justify-content: space-between; font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem;">
									<span>提示された初期見積もり総額</span>
									<span id="initial-quote-badge" style="color: #2563EB; font-weight: 800;">2,800,000 円</span>
								</label>
								<input 
									type="range" 
									id="initial-quote-range" 
									min="1000000" 
									max="6000000" 
									step="50000" 
									value="2800000" 
									style="width: 100%; accent-color: #2563EB; cursor: pointer;"
								/>
							</div>

							<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
								<div>
									<label for="guest-count-input" style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.25rem;">
										招待ゲスト人数（名）
									</label>
									<input 
										type="number" 
										id="guest-count-input" 
										value="60" 
										min="10" 
										max="200" 
										style="width: 100%; padding: 6px 10px; font-size: 0.95rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box;"
									/>
								</div>
								<div>
									<label for="service-rate-select" style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.25rem;">
										式場サービス料率
									</label>
									<select 
										id="service-rate-select" 
										style="width: 100%; padding: 6px 10px; font-size: 0.90rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; box-sizing: border-box; background: #fff;"
									>
										<option value="0.10">10%（標準）</option>
										<option value="0.12">12%</option>
										<option value="0.15">15%（高級ホテル等）</option>
									</select>
								</div>
							</div>
						</div>

						<!-- Upgrade Selectors -->
						<div>
							<div style="font-size: 0.85rem; font-weight: 900; color: #2563EB; margin-bottom: 0.75rem; text-transform: uppercase;">
								2. 主要項目のランクアップ選択（5大跳ね上がり要因）
							</div>

							<div style="display: flex; flex-direction: column; gap: 0.85rem;">
								
								<!-- Dress -->
								<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 10px 12px;">
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
										<span style="font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil);">👗 新婦・新郎 衣装ランクアップ</span>
										<span id="dress-cost-display" style="font-size: 0.85rem; font-weight: 800; color: #DC2626;">+250,000 円</span>
									</div>
									<select id="dress-upgrade" style="width: 100%; padding: 6px 8px; font-size: 0.84rem; border: 1px solid #cbd5e1; border-radius: 4px; background: #FAF8F5;">
										<option value="0">プラン内基本衣装のみ（差額なし）</option>
										<option value="250000" selected>標準ランクアップ（ドレス差額+20万、タキシード+5万）</option>
										<option value="450000">人気ブランドドレス＋小物一式（+45万円）</option>
										<option value="650000">インポートドレス＋お色直し和装追加（+65万円）</option>
									</select>
								</div>

								<!-- Food -->
								<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 10px 12px;">
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
										<span style="font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil);">🍽️ 料理コースのグレードアップ</span>
										<span id="food-cost-display" style="font-size: 0.85rem; font-weight: 800; color: #DC2626;">+180,000 円</span>
									</div>
									<select id="food-upgrade" style="width: 100%; padding: 6px 8px; font-size: 0.84rem; border: 1px solid #cbd5e1; border-radius: 4px; background: #FAF8F5;">
										<option value="0">初期見積もりの最安コース（差額なし）</option>
										<option value="3000" selected>1人あたり +3,000円（スタンダード国産牛コース）</option>
										<option value="6000">1人あたり +6,000円（特選和牛＋デザートビュッフェ）</option>
										<option value="10000">1人あたり +10,000円（最高峰プレミアムフレンチ）</option>
									</select>
								</div>

								<!-- Drinks -->
								<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 10px 12px;">
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
										<span style="font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil);">🍷 フリードリンクのランクアップ</span>
										<span id="drink-cost-display" style="font-size: 0.85rem; font-weight: 800; color: #DC2626;">+90,000 円</span>
									</div>
									<select id="drink-upgrade" style="width: 100%; padding: 6px 8px; font-size: 0.84rem; border: 1px solid #cbd5e1; border-radius: 4px; background: #FAF8F5;">
										<option value="0">基本プラン（ビール・ワイン・ソフトドリンク）</option>
										<option value="1500" selected>1人あたり +1,500円（カクテル・乾杯用シャンパン追加）</option>
										<option value="3000">1人あたり +3,000円（銘柄指定・プレミアム飲み放題）</option>
									</select>
								</div>

								<!-- Movie / Video -->
								<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 10px 12px;">
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
										<span style="font-size: 0.88rem; font-weight: 700; color: var(--fg-pencil);">📹 撮って出しエンドロール＆記録映像</span>
										<span id="movie-cost-display" style="font-size: 0.85rem; font-weight: 800; color: #DC2626;">+220,000 円</span>
									</div>
									<select id="movie-upgrade" style="width: 100%; padding: 6px 8px; font-size: 0.84rem; border: 1px solid #cbd5e1; border-radius: 4px; background: #FAF8F5;">
										<option value="0">映像演出なし（追加なし）</option>
										<option value="220000" selected>撮って出しエンドロールムービー（再入場まで/+22万円）</option>
										<option value="380000">エンドロール ＋ 挙式披露宴 全編記録ビデオ（+38万円）</option>
									</select>
								</div>

								<!-- Flowers -->
