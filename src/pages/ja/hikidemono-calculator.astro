---
import Layout from '../../layouts/Layout.astro';
import JaShareActionBar from '../../components/ja/JaShareActionBar.astro';

const title = "【引き出物・引き菓子 予算＆個数計算機】10%ルールと贈り分け相場 (無料・登録不要) | Manage.Wedding 日本版";
const description = "友人（3千〜4千円）、上司（5千〜1万円）、夫婦・親族（7千〜1.5万円）のランク別贈り分けに対応。ご祝儀10%ルールに基づく本命記念品＋引き菓子＋縁起物の総予算と必要セット数を自動計算。完全無料・登録不要・A4/PDF印刷対応。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/hikidemono-calculator#app",
      "name": "引き出物・引き菓子 予算＆個数計算機",
      "url": "https://manage.wedding/ja/hikidemono-calculator",
      "description": "日本の結婚式マナー（ご祝儀10%ルール・3品構成・贈り分け・夫婦1世帯1セット）に基づき、引き出物・引菓子・縁起物の必要個数と総予算を算出するシミュレーター。",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "結婚式の引き出物予算と個数を正確に計算する4つの手順",
      "description": "ゲストの属性と世帯数から、ご祝儀10%相場に応じた記念品・引き菓子・縁起物の適正予算を割り出す手順。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "ゲストを世帯単位でカウントする",
          "text": "夫婦やご家族で出席されるゲストは「1世帯につき1セット」の引き出物を用意するため、個人数ではなく世帯数を把握します。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "属性ごとのご祝儀相場から「本命記念品（約10%）」を設定する",
          "text": "友人（3,000円〜4,000円）、上司（5,000円〜10,000円）、親族（8,000円〜15,000円）のように予想ご祝儀の約1割を目安に記念品予算を決めます。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "引き菓子と縁起物（2品目・3品目）を追加する",
          "text": "引き菓子（バームクーヘン等 / 1,000円〜1,500円）と縁起物（鰹節・紅茶・お出汁等 / 1,000円〜1,200円）を組み合わせ、奇数3品セットを構成します。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "式場渡し（紙袋代）かヒキタク（宅配便）かを選択する",
          "text": "式場の紙袋代（1枚約400円〜600円）を考慮し、自宅へ直送する「引き出物宅配便」との総額コストと利便性を比較します。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "引き出物の相場金額（10%ルール）とは何ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "結婚式の引き出物は「予想されるご祝儀の約10%に相当するメイン記念品」＋「引き菓子（1,000〜1,500円）」＋「縁起物（1,000〜1,200円）」の3品セット（総額でご祝儀の約15〜20%）を用意するのが日本の標準マナーです。友人（ご祝儀3万円）なら総額5,000〜6,000円、上司（ご祝儀5万円）なら総額8,000〜10,000円が相場です。"
          }
        },
        {
          "@type": "Question",
          "name": "夫婦や家族で出席するゲストの引き出物はどう用意しますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "夫婦や家族で連名のご祝儀（5万〜7万円）をいただく場合、引き出物は「1世帯に1セット」お渡しするのが基本ルールです。ただし、1人出席のゲストよりもメイン記念品のランクを上げ（7,000〜10,000円程度）、引き菓子のサイズをファミリー向けにするなどの配慮を行います。"
          }
        },
        {
          "@type": "Question",
          "name": "引き出物はなぜ奇数の「3品」が良いとされているのですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "日本の慶事（お祝い事）では、「割り切れない奇数」が縁起が良いとされているためです。メインの記念品（本命）、引き菓子（お砂糖・甘味）、縁起物（鰹節・昆布・お茶漬けなど）の3品が最も一般的です。ただし関西など地域によっては2品または5品（名披露など）にする文化もあります。"
          }
        },
        {
          "@type": "Question",
          "name": "引き出物の「贈り分け」はゲストにバレませんか？マナー違反になりませんか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "贈り分けは現在の結婚式では9割以上の新郎新婦が実践している標準的なおもてなしです。外見（式場紙袋のサイズや色）を統一しておけば、中身のカタログギフトの価格差や引き菓子の違いが他のゲストに知られることはなく、マナー違反には一切当たりません。"
          }
        },
        {
          "@type": "Question",
          "name": "引き出物宅配便（ヒキタク）を使うメリットは何ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. ゲストが重い荷物を持たずに身軽に帰れる（二次会参加や遠方・雨天時に大好評）。2. 式場の持ち込み料（1個500円）や式場紙袋代（1枚500円）が完全0円になる。3. 会場で他のゲストと贈り分けの中身を比較される心配が完全にゼロになる、という3大メリットがあります。"
          }
        }
      ]
    }
  ]
};

const tierNorms = [
  { tier: "友人・同僚（単身）", goshugi: "30,000円", main: "3,000 〜 4,000円", kashi: "1,000円", engi: "1,000円", total: "5,000 〜 6,000円", popular: "体験カタログ、上質フェイスタオル、ブランド食器" },
  { tier: "上司・恩師・先輩", goshugi: "50,000円", main: "5,000 〜 8,000円", kashi: "1,200円", engi: "1,000円", total: "7,200 〜 10,200円", popular: "グルメ特化カタログ、高級グラス・酒器、今治バスタオル" },
  { tier: "夫婦・ペア出席（1世帯）", goshugi: "50,000 〜 70,000円", main: "7,000 〜 10,000円", kashi: "1,500円", engi: "1,200円", total: "9,700 〜 12,700円", popular: "高価格帯総合カタログ、ペア食器、ファミリー向けスイーツ" },
  { tier: "親族・叔父叔母・親戚", goshugi: "70,000 〜 100,000円", main: "10,000 〜 15,000円", kashi: "1,500円", engi: "1,200円", total: "12,700 〜 17,700円", popular: "老舗料亭グルメ、日本の伝統工芸品、高級寝具ギフト" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<a href="/ja/budget" style="color: #2563EB; text-decoration: none; font-weight: 600;">費用・見積もり</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">引き出物・引き菓子 予算＆個数計算機</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #E0E7FF; border: 1.5px solid #A5B4FC; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #3730A3; margin-bottom: 0.75rem;">
						<span>🎁</span>
						<span>ギフトマナー・予算配分ツール</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						引き出物・引き菓子<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">予算＆個数計算機</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						「友人・上司・親族の贈り分け金額は？」「夫婦出席は何セット用意すべき？」を自動解決。<strong>ご祝儀10%ルールに基づく3品セット（記念品＋引菓子＋縁起物）の総予算と必要個数</strong>を瞬時に計算します。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 40%;"></div>
						<img 
							src="/images/ja_hikidemono_flatlay.webp" 
							alt="上品なホワイトとゴールドのギフトボックスとティーカップのフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							🎁 感謝の気持ちを伝える、失敗しない贈り分け。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Calculator Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
							🧮 引き出物 贈り分け・予算計算フォーム
						</h2>
						<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
							ゲストの世帯数と各ランクの単価を設定すると、必要なセット数と総予算がリアルタイムに算出されます。
						</p>
					</div>
					<button id="reset-hiki-btn" type="button" style="font-size: 0.80rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
						🔄 初期値に戻す
					</button>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem;">
					
					<!-- Left Form: Guest Tiers & Prices -->
					<div style="display: flex; flex-direction: column; gap: 1.25rem;">
						
						<!-- Options Strip -->
						<div style="background: #FAF8F5; border: 1.5px solid #e2e8f0; border-radius: 6px; padding: 0.85rem 1rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
							<label style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
								<input type="checkbox" id="include-engi" checked style="width: 16px; height: 16px; accent-color: #2563EB;" />
								<span>縁起物（3品目 / 約1,000円）を含める</span>
							</label>
							<div style="font-size: 0.78rem; color: var(--text-secondary);">
								※ 東日本は3品が主流
							</div>
						</div>

						<!-- Tier 1: Friends -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
								<span style="font-size: 0.92rem; font-weight: 800; color: var(--fg-pencil);">
									🧑‍🤝‍🧑 友人・同僚（単身）
								</span>
								<div style="display: flex; align-items: center; gap: 0.35rem;">
									<input type="number" id="count-friends" value="35" min="0" max="150" style="width: 55px; padding: 3px 6px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
									<span style="font-size: 0.82rem;">世帯(名)</span>
								</div>
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; font-size: 0.75rem;">
								<div>
									<span style="color: var(--text-secondary); display: block;">本命記念品</span>
									<input type="number" id="price-main-friends" value="3300" step="100" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">引き菓子</span>
									<input type="number" id="price-kashi-friends" value="1100" step="100" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">縁起物</span>
									<input type="number" id="price-engi-friends" value="1080" step="100" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;" />
								</div>
							</div>
						</div>

						<!-- Tier 2: Bosses -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
								<span style="font-size: 0.92rem; font-weight: 800; color: var(--fg-pencil);">
									👔 上司・主賓・恩師
								</span>
								<div style="display: flex; align-items: center; gap: 0.35rem;">
									<input type="number" id="count-bosses" value="6" min="0" max="50" style="width: 55px; padding: 3px 6px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
									<span style="font-size: 0.82rem;">世帯(名)</span>
								</div>
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; font-size: 0.75rem;">
								<div>
									<span style="color: var(--text-secondary); display: block;">本命記念品</span>
									<input type="number" id="price-main-bosses" value="5500" step="100" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">引き菓子</span>
									<input type="number" id="price-kashi-bosses" value="1300" step="100" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">縁起物</span>
									<input type="number" id="price-engi-bosses" value="1080" step="100" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;" />
								</div>
							</div>
						</div>

						<!-- Tier 3: Couples -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
								<span style="font-size: 0.92rem; font-weight: 800; color: var(--fg-pencil);">
									💍 夫婦・ペア出席（1世帯1セット）
								</span>
								<div style="display: flex; align-items: center; gap: 0.35rem;">
									<input type="number" id="count-couples" value="3" min="0" max="30" style="width: 55px; padding: 3px 6px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
									<span style="font-size: 0.82rem;">組 (世帯)</span>
								</div>
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; font-size: 0.75rem;">
								<div>
									<span style="color: var(--text-secondary); display: block;">本命記念品</span>
									<input type="number" id="price-main-couples" value="8800" step="100" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">引き菓子</span>
									<input type="number" id="price-kashi-couples" value="1620" step="100" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">縁起物</span>
									<input type="number" id="price-engi-couples" value="1080" step="100" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;" />
								</div>
							</div>
						</div>

						<!-- Tier 4: Relatives -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
								<span style="font-size: 0.92rem; font-weight: 800; color: var(--fg-pencil);">
									👴👵 親族・叔父叔母（親戚世帯）
								</span>
								<div style="display: flex; align-items: center; gap: 0.35rem;">
									<input type="number" id="count-relatives" value="8" min="0" max="50" style="width: 55px; padding: 3px 6px; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center;" />
									<span style="font-size: 0.82rem;">世帯</span>
								</div>
							</div>
							<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; font-size: 0.75rem;">
								<div>
									<span style="color: var(--text-secondary); display: block;">本命記念品</span>
									<input type="number" id="price-main-relatives" value="11000" step="500" style="width: 100%; padding: 4px 6px; font-weight: 700; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;" />
								</div>
								<div>
									<span style="color: var(--text-secondary); display: block;">引き菓子</span>
