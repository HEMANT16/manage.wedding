	<!-- Interactive Client Script for Calculator -->
	<script is:inline>
		const includeEngiCheckbox = document.getElementById('include-engi');

		const countFriends = document.getElementById('count-friends');
		const priceMainFriends = document.getElementById('price-main-friends');
		const priceKashiFriends = document.getElementById('price-kashi-friends');
		const priceEngiFriends = document.getElementById('price-engi-friends');

		const countBosses = document.getElementById('count-bosses');
		const priceMainBosses = document.getElementById('price-main-bosses');
		const priceKashiBosses = document.getElementById('price-kashi-bosses');
		const priceEngiBosses = document.getElementById('price-engi-bosses');

		const countCouples = document.getElementById('count-couples');
		const priceMainCouples = document.getElementById('price-main-couples');
		const priceKashiCouples = document.getElementById('price-kashi-couples');
		const priceEngiCouples = document.getElementById('price-engi-couples');

		const countRelatives = document.getElementById('count-relatives');
		const priceMainRelatives = document.getElementById('price-main-relatives');
		const priceKashiRelatives = document.getElementById('price-kashi-relatives');
		const priceEngiRelatives = document.getElementById('price-engi-relatives');

		const resTotalSets = document.getElementById('res-total-sets');
		const resTotalBudget = document.getElementById('res-total-budget');
		const resSubMain = document.getElementById('res-sub-main');
		const resSubKashi = document.getElementById('res-sub-kashi');
		const resSubEngi = document.getElementById('res-sub-engi');
		const resAvgPerSet = document.getElementById('res-avg-per-set');

		const resetBtn = document.getElementById('reset-hiki-btn');
		const printBtn = document.getElementById('print-hiki-sheet-btn');

		function calculateHikidemono() {
			const hasEngi = includeEngiCheckbox?.checked ?? true;

			const nFriends = parseInt(countFriends?.value || '0', 10);
			const nBosses = parseInt(countBosses?.value || '0', 10);
			const nCouples = parseInt(countCouples?.value || '0', 10);
			const nRelatives = parseInt(countRelatives?.value || '0', 10);

			const totalSets = nFriends + nBosses + nCouples + nRelatives;

			// Subtotal Main Gifts
			const subMain = (nFriends * parseFloat(priceMainFriends?.value || '0')) +
			                (nBosses * parseFloat(priceMainBosses?.value || '0')) +
			                (nCouples * parseFloat(priceMainCouples?.value || '0')) +
			                (nRelatives * parseFloat(priceMainRelatives?.value || '0'));

			// Subtotal Kashi
			const subKashi = (nFriends * parseFloat(priceKashiFriends?.value || '0')) +
			                 (nBosses * parseFloat(priceKashiBosses?.value || '0')) +
			                 (nCouples * parseFloat(priceKashiCouples?.value || '0')) +
			                 (nRelatives * parseFloat(priceKashiRelatives?.value || '0'));

			// Subtotal Engi
			const subEngi = hasEngi ? ((nFriends * parseFloat(priceEngiFriends?.value || '0')) +
			                           (nBosses * parseFloat(priceEngiBosses?.value || '0')) +
			                           (nCouples * parseFloat(priceEngiCouples?.value || '0')) +
			                           (nRelatives * parseFloat(priceEngiRelatives?.value || '0'))) : 0;

			const totalBudget = subMain + subKashi + subEngi;
			const avgPerSet = totalSets > 0 ? Math.round(totalBudget / totalSets) : 0;

			// Update Text Outputs
			if (resTotalSets) resTotalSets.textContent = `${totalSets} セット`;
			if (resTotalBudget) resTotalBudget.textContent = `${totalBudget.toLocaleString('ja-JP')} 円`;
			if (resSubMain) resSubMain.textContent = `${subMain.toLocaleString('ja-JP')} 円`;
			if (resSubKashi) resSubKashi.textContent = `${subKashi.toLocaleString('ja-JP')} 円`;
			if (resSubEngi) resSubEngi.textContent = `${subEngi.toLocaleString('ja-JP')} 円`;
			if (resAvgPerSet) resAvgPerSet.textContent = `約 ${avgPerSet.toLocaleString('ja-JP')} 円 / 世帯`;
		}

		// Attach Event Listeners
		[includeEngiCheckbox, countFriends, priceMainFriends, priceKashiFriends, priceEngiFriends,
		 countBosses, priceMainBosses, priceKashiBosses, priceEngiBosses,
		 countCouples, priceMainCouples, priceKashiCouples, priceEngiCouples,
		 countRelatives, priceMainRelatives, priceKashiRelatives, priceEngiRelatives].forEach(el => {
			if (el) {
				el.addEventListener('input', calculateHikidemono);
				el.addEventListener('change', calculateHikidemono);
			}
		});

		// Reset Button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (includeEngiCheckbox) includeEngiCheckbox.checked = true;
				if (countFriends) countFriends.value = '35';
				if (priceMainFriends) priceMainFriends.value = '3300';
				if (priceKashiFriends) priceKashiFriends.value = '1100';
				if (priceEngiFriends) priceEngiFriends.value = '1080';

				if (countBosses) countBosses.value = '6';
				if (priceMainBosses) priceMainBosses.value = '5500';
				if (priceKashiBosses) priceKashiBosses.value = '1300';
				if (priceEngiBosses) priceEngiBosses.value = '1080';

				if (countCouples) countCouples.value = '3';
				if (priceMainCouples) priceMainCouples.value = '8800';
				if (priceKashiCouples) priceKashiCouples.value = '1620';
				if (priceEngiCouples) priceEngiCouples.value = '1080';

				if (countRelatives) countRelatives.value = '8';
				if (priceMainRelatives) priceMainRelatives.value = '11000';
				if (priceKashiRelatives) priceKashiRelatives.value = '1620';
				if (priceEngiRelatives) priceEngiRelatives.value = '1080';

				calculateHikidemono();
			});
		}

		// Print Button (Fallback)
		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Dynamic Share Formatter for LINE / Clipboard
		window.getJaLiveShareText = function() {
			const hasEngi = includeEngiCheckbox?.checked ?? true;

			const nFriends = parseInt(countFriends?.value || '0', 10);
			const nBosses = parseInt(countBosses?.value || '0', 10);
			const nCouples = parseInt(countCouples?.value || '0', 10);
			const nRelatives = parseInt(countRelatives?.value || '0', 10);
			const totalSets = nFriends + nBosses + nCouples + nRelatives;
			const totalGuests = nFriends + nBosses + (nCouples * 2) + nRelatives;

			const subMain = (nFriends * parseFloat(priceMainFriends?.value || '0')) +
			                (nBosses * parseFloat(priceMainBosses?.value || '0')) +
			                (nCouples * parseFloat(priceMainCouples?.value || '0')) +
			                (nRelatives * parseFloat(priceMainRelatives?.value || '0'));

			const subKashi = (nFriends * parseFloat(priceKashiFriends?.value || '0')) +
			                 (nBosses * parseFloat(priceKashiBosses?.value || '0')) +
			                 (nCouples * parseFloat(priceKashiCouples?.value || '0')) +
			                 (nRelatives * parseFloat(priceKashiRelatives?.value || '0'));

			const subEngi = hasEngi ? ((nFriends * parseFloat(priceEngiFriends?.value || '0')) +
			                           (nBosses * parseFloat(priceEngiBosses?.value || '0')) +
			                           (nCouples * parseFloat(priceEngiCouples?.value || '0')) +
			                           (nRelatives * parseFloat(priceEngiRelatives?.value || '0'))) : 0;

			const totalBudget = subMain + subKashi + subEngi;
			const avgPerGuest = totalGuests > 0 ? Math.round(totalBudget / totalGuests) : 0;
			const avgPerSet = totalSets > 0 ? Math.round(totalBudget / totalSets) : 0;

			return `【引き出物・引き菓子 予算計算結果】
・ゲスト人数: ${totalGuests}名 (${totalSets}世帯分)
・本命記念品: 約${subMain.toLocaleString('ja-JP')}円
・引き菓子: 約${subKashi.toLocaleString('ja-JP')}円${hasEngi ? `\n・縁起物: 約${subEngi.toLocaleString('ja-JP')}円` : ''}
━━━━━━━━━━━━━━━━
★ 引き出物総額（総予算）: 約${totalBudget.toLocaleString('ja-JP')}円
★ 1人あたり平均: 約${avgPerGuest.toLocaleString('ja-JP')}円 (1世帯あたり約${avgPerSet.toLocaleString('ja-JP')}円)

▼ 見積もり・計算ツールで確認する
https://manage.wedding/ja/hikidemono-calculator`;
		};

		// Initial Run
		calculateHikidemono();
	</script>

</Layout>
