---
import Layout from '../../layouts/Layout.astro';

const title = "ページが見つかりませんでした (404) — Manage.Wedding 日本版";
const description = "お探しのページは見つかりませんでした。自己負担額シミュレーター、お車代計算、六曜カレンダー、席次表マナーなど、日本の結婚式計算ツールをご利用ください。";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "ページが見つかりません (404) — Manage.Wedding 日本版",
  "url": "https://manage.wedding/ja/404",
  "description": "お探しのページが見つかりませんでした。日本の結婚式準備に役立つ無料計算ツールをご利用ください。"
};

const categoryHubs = [
  {
    title: "費用・見積もり・自己負担",
    url: "/ja/budget",
    icon: "💰",
    count: "5 ツール",
    desc: "自己負担額シミュレーター、見積もり跳ね上がり予測、持ち込み料損益分岐点、引き出物相場計算。"
  },
  {
    title: "ご祝儀・お車代・マナー",
    url: "/ja/goshugi",
    icon: "✉️",
    count: "3 ツール",
    desc: "遠方ゲストのお車代・宿泊費計算、ご祝儀袋の漢数字（大字）変換、受付・主賓への御礼相場。"
  },
  {
    title: "日程・顔合わせ・準備",
    url: "/ja/schedule",
    icon: "📅",
    count: "3 ツール",
    desc: "大安・仏滅の六曜カレンダーと割引比較、両家顔合わせの食事代割り勘、婚姻届開運日チェック。"
  },
  {
    title: "席次表・2次会・スピーチ",
    url: "/ja/logistics",
    icon: "🪑",
    count: "3 ツール",
    desc: "上座・下座の席次表配席ルール、二次会の男女別会費・景品予算計算、3分スピーチ添削タイマー。"
  }
];

const popularTools = [
  {
    title: "自己負担額シミュレーター",
    url: "/ja/jiko-futangaku-calculator",
    icon: "💰",
    badge: "人気No.1",
    category: "費用・見積もり",
    desc: "式場総費用と予想ご祝儀から、おふたりが実際に貯金から持ち出す自己負担額を瞬時に計算。",
    cta: "手出し額を計算する →"
  },
  {
    title: "お車代＆宿泊費 計算ツール",
    url: "/ja/okurumadai-calculator",
    icon: "🚗",
    badge: "遠方ゲスト必須",
    category: "ご祝儀・マナー",
    desc: "新幹線・飛行機代の半額/全額支給ルールとキリの良い新札封筒準備リストを自動生成。",
    cta: "お車代を計算する →"
  },
  {
    title: "六曜カレンダー＆割引比較",
    url: "/ja/rokuyo-wedding-calendar",
    icon: "📅",
    badge: "お日柄診断",
    category: "日程・準備",
    desc: "2026/2027年 六曜カレンダー。仏滅割・日曜夕方割とお日柄のメリット比較。",
    cta: "お日柄をチェックする →"
  },
  {
    title: "席次表・上座下座 配置ビルダー",
    url: "/ja/sekijihyo-seating-builder",
    icon: "🪑",
    badge: "マナー配席",
    category: "席次・2次会",
    desc: "高砂に近い上座（主賓・上司）から末席（両親・家族）までの円卓マナー配席チェック。",
    cta: "席次表を確認する →"
  }
];
---

<Layout title={title} description={description} schema={schema} noindex={true}>
	<div class="section-paper" style="padding: 3rem 1rem 4rem 1rem; text-align: center;">
		<div style="max-width: 900px; margin: 0 auto;">
			
			<!-- 404 Badge -->
			<div class="hand-card" style="display: inline-block; padding: 6px 18px; font-weight: 700; font-size: 0.9rem; background: #FEF2F2; color: #991B1B; border: 1.5px solid #F87171; margin-bottom: 1.5rem; transform: rotate(-1deg);">
				⚠️ 404 PAGE NOT FOUND
			</div>

			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3rem); color: var(--fg-pencil); margin-bottom: 1rem; line-height: 1.3;">
				お探しのページが<br/>
				見つかりませんでした
			</h1>

			<p style="color: var(--text-secondary); font-size: 1.05rem; max-width: 600px; margin: 0 auto 2.5rem auto; line-height: 1.8;">
				URLが変更されたか、ページが削除された可能性があります。<br/>
				以下のカテゴリや人気の計算ツールからお探しのページをお選びください。
			</p>

			<!-- Home Button -->
			<div style="margin-bottom: 3.5rem;">
				<a href="/ja" class="hand-btn" style="display: inline-block; padding: 10px 28px; font-size: 1rem; text-decoration: none;">
					🌸 日本版ホームへ戻る
				</a>
			</div>

			<!-- 4 Major Categories -->
			<div style="text-align: left; margin-bottom: 3rem;">
				<h2 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
					準備フェーズから探す
				</h2>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
					{categoryHubs.map((hub) => (
						<a href={hub.url} style="text-decoration: none; color: inherit;">
							<div class="hand-card" style="background: #fff; padding: 1.25rem; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
								<div>
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
										<span style="font-size: 1.8rem;">{hub.icon}</span>
										<span style="font-size: 0.75rem; font-weight: 700; color: #2563EB; background: rgba(37,99,235,0.08); padding: 2px 6px; border-radius: 3px;">
											{hub.count}
										</span>
									</div>
									<h3 style="font-size: 1.1rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem;">
										{hub.title}
									</h3>
									<p style="font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5;">
										{hub.desc}
									</p>
								</div>
								<span style="font-size: 0.82rem; font-weight: 700; color: #2563EB; margin-top: 0.75rem;">
									開く →
								</span>
							</div>
						</a>
					))}
				</div>
			</div>

			<!-- Popular Tools Showcase -->
			<div style="text-align: left;">
				<h2 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 1.25rem; text-align: center;">
					人気の計算ツール＆シミュレーター
				</h2>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
					{popularTools.map((tool) => (
						<a href={tool.url} style="text-decoration: none; color: inherit;">
							<div class="hand-card" style="background: var(--bg-paper, #fcfaf7); padding: 1.25rem; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
								<div>
									<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
										<span style="font-size: 1.5rem;">{tool.icon}</span>
										<span style="font-size: 0.72rem; font-weight: 700; padding: 2px 6px; background: #FEF3C7; color: #92400E; border-radius: 3px;">
											{tool.badge}
										</span>
									</div>
									<h3 style="font-size: 1.05rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.35rem;">
										{tool.title}
									</h3>
									<p style="font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5;">
										{tool.desc}
									</p>
								</div>
								<span style="font-size: 0.82rem; font-weight: 700; color: #059669; margin-top: 0.75rem;">
									{tool.cta}
								</span>
							</div>
						</a>
					))}
				</div>
			</div>

		</div>
	</div>
</Layout>
