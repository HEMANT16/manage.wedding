---
import Layout from '../../layouts/Layout.astro';

const title = "【フォトウェディング・前撮り 費用計算機】和装・洋装・ロケ・スタジオ相場診断 (無料・登録不要) | Manage.Wedding 日本版";
const description = "スタジオ撮影 vs ロケーション撮影、和装（白無垢・色打掛） vs 洋装（ドレス）、全カットデータ納品、土日追加料金を含めたリアルな総費用を瞬時に計算。「1万円〜」の広告から跳ね上がる追加料金を契約前に完全把握。完全無料・登録不要・A4/PDF印刷対応。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://manage.wedding/ja/photo-wedding-calculator#app",
      "name": "フォトウェディング・前撮り 費用計算機",
      "url": "https://manage.wedding/ja/photo-wedding-calculator",
      "description": "スタジオ撮影・ロケーション撮影、和装・洋装、全カットデータ、アルバム、土日祝日料金を加味し、フォトウェディング・前撮りのリアルな総額費用を自動計算するシミュレーター。",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All",
      "inLanguage": "ja",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "JPY"
      }
    },
    {
      "@type": "HowTo",
      "name": "フォトウェディング・前撮りの総費用を正確に見積もる4つの手順",
      "description": "広告の最安プランに惑わされず、衣装・全データ・土日料金を含めたリアルな総額を算出する手順。",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "撮影場所（スタジオ vs ロケーション）を決める",
          "text": "天候に左右されないスタジオ撮影（相場3万〜10万円）か、日本庭園や海辺で撮るロケーション撮影（相場10万〜20万円）かを選択します。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "衣装のタイプ（和装 vs 洋装）と着数を選択する",
          "text": "洋装（ウェディングドレス）、和装（白無垢・色打掛）、または和洋2着の組み合わせと、新作・ブランドドレスの差額を加算します。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "「全カットデータ」の納品料金を確認する",
          "text": "広告の最安プランには台紙写真1枚しか含まれていないことが多いため、結婚式ムービーやSNSで使える全データ（約100〜200カット / 3万〜5万円）を追加します。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "土日料金・ヘアメイク・ロケ申請料を合算する",
          "text": "土日祝日の撮影追加料（1.5万〜3万円）や新郎ヘアセット、施設使用料を加味した最終総額を算出します。"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "フォトウェディング・前撮りの平均費用相場はいくらですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ゼクシィ結婚トレンド調査によると、スタジオ洋装プランで約5万〜10万円、スタジオ和装プランで約8万〜14万円、ロケーション洋装プランで約12万〜18万円、ロケーション和装プランで約15万〜25万円が一般的な総額相場です。"
          }
        },
        {
          "@type": "Question",
          "name": "「1万円〜」などの格安広告プランには何が含まれていないのですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "格安プランは「撮影料＋基本衣装1着＋台紙写真1枚（紙）」のみで構成されていることがほとんどです。結婚式準備やスマホ保存に必須の「全撮影データ（+3万〜5万円）」、気に入るデザインの「衣装差額（+2万〜5万円）」、土日料金（+2万円）が別料金のため、最終的には10万円以上になります。"
          }
        },
        {
          "@type": "Question",
          "name": "前撮りは「和装」と「洋装」のどちらが人気ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "結婚式当日にウェディングドレスやカラードレスを着るカップルの約70%が、前撮りでは「和装（白無垢・色打掛）」を選んでいます。当日の衣装替え時間を節約しつつ、日本庭園や神社で美しい着物姿をご両親に見せられるため非常に高い人気を誇ります。"
          }
        },
        {
          "@type": "Question",
          "name": "フォトウェディングの費用を最も効果的に安く抑えるコツは何ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1. 「平日」に撮影して土日祝日料金（2万〜3万円）を0円にする。2. アルバムはスタジオに注文せず、「全データ納品」のみを購入して自作フォトブックアプリ（しまうまプリント等）で製本する（5万〜8万円節約）。3. 夏（7〜8月）や冬（1〜2月）のオフシーズン割引キャンペーンを利用する、の3点が鉄則です。"
          }
        },
        {
          "@type": "Question",
          "name": "前撮りのベストな撮影時期・タイミングはいつ頃ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "結婚式当日の「2〜3ヶ月前」までに撮影するのがベストです。データの納品・レタッチに約2〜4週間かかるため、ウェルカムボードの印刷やプロフィールムービーの動画編集に写真を使用する場合は、挙式3ヶ月前までの撮影をおすすめします。"
          }
        }
      ]
    }
  ]
};

const photoMatrix = [
  { style: "スタジオ撮影（洋装1着）", avg: "5万 〜 10万円", cuts: "100〜150カット", merits: "天候に左右されない。最もリーズナブルに撮影可能。" },
  { style: "スタジオ撮影（和装1着）", avg: "8万 〜 14万円", cuts: "100〜150カット", merits: "着付け・ヘアメイク込み。スタジオセットで本格和装。" },
  { style: "スタジオ撮影（和洋2着）", avg: "12万 〜 18万円", cuts: "150〜200カット", merits: "ドレスと色打掛の両方を一日で効率よく撮影。" },
  { style: "ロケーション撮影（洋装1着）", avg: "12万 〜 18万円", cuts: "150〜250カット", merits: "海・洋館・公園など開放感あふれるドラマチックな写真。" },
  { style: "ロケーション撮影（和装1着）", avg: "15万 〜 25万円", cuts: "150〜250カット", merits: "日本庭園・神社・歴史的建造物で四季を感じる最高の一枚。" },
  { style: "ロケーション撮影（和洋2着）", avg: "22万 〜 32万円", cuts: "250〜350カット", merits: "昼ロケ＋夜景ロケなど一生の記念になるフルパッケージ。" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Breadcrumb Navigation -->
	<section class="section-paper" style="padding: 1.25rem 1rem 0; background: #fff;">
		<div style="max-width: 1050px; margin: 0 auto; font-size: 0.88rem;">
			<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<a href="/ja/budget" style="color: #2563EB; text-decoration: none; font-weight: 600;">費用・見積もり</a>
			<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
			<span style="color: var(--text-secondary);">フォトウェディング・前撮り 費用計算機</span>
		</div>
	</section>

	<!-- Header Hero with WebP Flatlay Theme Image -->
	<section class="section-paper" style="padding: 2rem 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FDF2F8; border: 1.5px solid #FBCFE8; padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 800; color: #9D174D; margin-bottom: 0.75rem;">
						<span>📷</span>
						<span>前撮り・フォト婚 リアル費用診断</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4.5vw, 2.7rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 0.75rem;">
						フォトウェディング・前撮り<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">費用計算機</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 0.98rem; line-height: 1.7; margin-bottom: 1.25rem;">
						「1万円〜の広告で行ったら20万円になった…」を防ぐ。スタジオ・ロケーション、和装・洋装、<strong>全カットデータ納品や土日追加料金を含めたリアルな総額費用</strong>を瞬時にシミュレーションします。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.78rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.78rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷対応
						</span>
					</div>
				</div>

				<!-- Aesthetic Flatlay Image Frame (Optimized WebP, No Text) -->
				<div style="position: relative;">
					<div class="hand-card" style="padding: 10px; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil); transform: rotate(1deg);">
						<div class="tape" style="top: -12px; left: 40%;"></div>
						<img 
							src="/images/ja_photo_flatlay.webp" 
							alt="クラシックカメラとホワイトローズブートニア・リングの上品なフラットレイ" 
							width="800" 
							height="450" 
							style="width: 100%; height: auto; border-radius: 4px; display: block; object-fit: cover; aspect-ratio: 16/10;"
							loading="eager"
						/>
						<div style="padding: 8px 4px 2px; text-align: center; font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil);">
							📷 一生の宝物になる前撮りを、納得の価格で。
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Calculator Main Body -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1050px; margin: 0 auto;">
			
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
				
				<div style="border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 1rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
					<div>
						<h2 style="font-size: 1.35rem; font-weight: 800; color: var(--fg-pencil); margin: 0;">
							🧮 前撮り・フォトウェディング 費用シミュレーター
						</h2>
						<p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">
							撮影ロケーション、衣装の組み合わせ、必須オプションを選択してください。
						</p>
					</div>
					<button id="reset-photo-btn" type="button" style="font-size: 0.80rem; font-weight: 700; background: #FAF8F5; border: 1px solid var(--fg-pencil); padding: 4px 10px; border-radius: 4px; cursor: pointer;">
						🔄 初期値に戻す
					</button>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem;">
					
					<!-- Left Form: Options -->
					<div style="display: flex; flex-direction: column; gap: 1.25rem;">
						
						<!-- 1. Location & Style -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.85rem; font-weight: 900; color: #2563EB; margin-bottom: 0.4rem; text-transform: uppercase;">
								1. 撮影ロケーションの選択
							</div>
							<select id="select-location" style="width: 100%; padding: 8px; font-size: 0.90rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
								<option value="35000">🏢 屋内スタジオ撮影（天候安心・最安 / 基本3.5万円）</option>
								<option value="85000" selected>🌳 ロケーション撮影（日本庭園・公園・海 / 基本8.5万円）</option>
								<option value="120000">✨ スタジオ ＋ ロケーション両方撮影（基本12万円）</option>
							</select>
						</div>

						<!-- 2. Outfits Type & Count -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.85rem; font-weight: 900; color: #2563EB; margin-bottom: 0.4rem; text-transform: uppercase;">
								2. 衣装タイプ＆着数（着付け・ヘアメイク込）
							</div>
							<select id="select-outfits" style="width: 100%; padding: 8px; font-size: 0.90rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
								<option value="0">👗 洋装1着（ウェディングドレス or カラードレス / 差額なし）</option>
								<option value="25000" selected>👘 和装1着（白無垢 or 色打掛 / +2.5万円）</option>
								<option value="60000">👗👘 和洋2着セット（ドレス ＋ 白無垢/色打掛 / +6万円）</option>
								<option value="95000">👘👘👗 和洋3着フルセット（白無垢＋色打掛＋ドレス / +9.5万円）</option>
							</select>
						</div>

						<!-- 3. Dress Grade Upgrade -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.85rem; font-weight: 900; color: #2563EB; margin-bottom: 0.4rem; text-transform: uppercase;">
								3. 衣装ランクアップ（グレード差額）
							</div>
							<select id="select-dress-grade" style="width: 100%; padding: 8px; font-size: 0.90rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
								<option value="0">プラン内基本衣装（差額なし / 種類少なめ）</option>
								<option value="30000" selected>人気トレンドドレス・金糸刺繍色打掛（+3万円）</option>
								<option value="60000">高級インポートブランド・伝統友禅和装（+6万円）</option>
							</select>
						</div>

						<!-- 4. Data Delivery & Album -->
						<div class="hand-card" style="background: #FAF8F5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.85rem; font-weight: 900; color: #2563EB; margin-bottom: 0.4rem; text-transform: uppercase;">
								4. 写真データ納品・アルバム仕様
							</div>
							<select id="select-data-album" style="width: 100%; padding: 8px; font-size: 0.90rem; font-weight: 700; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff;">
								<option value="0">台紙写真1枚のみ（広告最安 / データなし）</option>
								<option value="40000" selected>⭐ 全カットデータ納品（100〜200枚 / +4万円）【一番人気】</option>
								<option value="85000">全カットデータ ＋ 高級製本デザインアルバム（+8.5万円）</option>
								<option value="115000">全データ ＋ アルバム ＋ 両親用増刷ミニアルバム2冊（+11.5万円）</option>
							</select>
						</div>

						<!-- 5. Options Checkboxes -->
						<div class="hand-card" style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
							<div style="font-size: 0.85rem; font-weight: 900; color: #2563EB; margin-bottom: 0.6rem; text-transform: uppercase;">
								5. 追加オプション
							</div>
							<div style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem;">
								<label style="display: flex; justify-content: space-between; align-items: center; cursor: pointer;">
									<span style="display: flex; align-items: center; gap: 0.4rem;">
										<input type="checkbox" id="opt-weekend" checked style="accent-color: #2563EB;" />
										<span>土日祝日 撮影追加料金</span>
									</span>
									<span style="font-weight: 700; color: #DC2626;">+22,000 円</span>
								</label>

								<label style="display: flex; justify-content: space-between; align-items: center; cursor: pointer;">
									<span style="display: flex; align-items: center; gap: 0.4rem;">
										<input type="checkbox" id="opt-groom-makeup" checked style="accent-color: #2563EB;" />
										<span>新郎 ヘアセット＆眉カットメイク</span>
									</span>
									<span style="font-weight: 700; color: var(--fg-pencil);">+8,800 円</span>
								</label>

								<label style="display: flex; justify-content: space-between; align-items: center; cursor: pointer;">
									<span style="display: flex; align-items: center; gap: 0.4rem;">
										<input type="checkbox" id="opt-retouch" style="accent-color: #2563EB;" />
										<span>美肌レタッチ・スタイル補正加工（全データ）</span>
									</span>
									<span style="font-weight: 700; color: var(--fg-pencil);">+16,500 円</span>
								</label>

								<label style="display: flex; justify-content: space-between; align-items: center; cursor: pointer;">
									<span style="display: flex; align-items: center; gap: 0.4rem;">
										<input type="checkbox" id="opt-permit" checked style="accent-color: #2563EB;" />
										<span>ロケーション施設使用料・移動タクシー代</span>
									</span>
									<span style="font-weight: 700; color: var(--fg-pencil);">+15,000 円</span>
								</label>
							</div>
						</div>

					</div>

					<!-- Right Column: Live Output Dashboard & Visual Summary -->
					<div>
						<div style="background: #FAF8F5; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.5rem;">
							
							<div style="font-size: 0.82rem; font-weight: 800; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 0.25rem;">
								REAL COST PREDICTION
							</div>
							<h3 style="font-size: 1.15rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 1.25rem;">
								📷 フォトウェディング総額シミュレーション
							</h3>

							<div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
								
								<!-- Total Estimated -->
								<div style="background: #FDF2F8; border: 2px solid #DB2777; border-radius: 6px; padding: 1rem;">
									<div style="font-size: 0.85rem; font-weight: 800; color: #9D174D; margin-bottom: 0.25rem;">
										リアルな前撮り・フォト婚 最終総額
									</div>
									<div id="res-photo-total" style="font-size: 1.8rem; font-weight: 900; color: #DB2777; line-height: 1.2;">
										225,800 円
									</div>
									<div style="font-size: 0.75rem; color: #9D174D; margin-top: 0.35rem;">
										※ 衣装・全データ・ヘアメイク・税込総額
									</div>
								</div>

