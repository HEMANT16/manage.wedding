		</div>
	</section>

	<!-- Interactive Client Script for Calculator -->
	<script is:inline>
		const locSelect = document.getElementById('select-location');
		const outfitsSelect = document.getElementById('select-outfits');
		const dressGradeSelect = document.getElementById('select-dress-grade');
		const dataAlbumSelect = document.getElementById('select-data-album');

		const optWeekend = document.getElementById('opt-weekend');
		const optGroom = document.getElementById('opt-groom-makeup');
		const optRetouch = document.getElementById('opt-retouch');
		const optPermit = document.getElementById('opt-permit');

		const resPhotoTotal = document.getElementById('res-photo-total');
		const resAdDiff = document.getElementById('res-ad-diff');
		const resSubBase = document.getElementById('res-sub-base');
		const resSubOutfit = document.getElementById('res-sub-outfit');
		const resSubAlbum = document.getElementById('res-sub-album');
		const resSubOptions = document.getElementById('res-sub-options');
		const photoBadge = document.getElementById('photo-status-badge');

		const barBase = document.getElementById('bar-base');
		const barOutfit = document.getElementById('bar-outfit');
		const barAlbum = document.getElementById('bar-album');
		const barOpt = document.getElementById('bar-opt');

		const resetBtn = document.getElementById('reset-photo-btn');
		const printBtn = document.getElementById('print-photo-sheet-btn');

		function calculatePhoto() {
			const costBase = parseFloat(locSelect?.value || '0');
			const costOutfitType = parseFloat(outfitsSelect?.value || '0');
			const costDressGrade = parseFloat(dressGradeSelect?.value || '0');
			const costTotalOutfit = costOutfitType + costDressGrade;

			const costAlbum = parseFloat(dataAlbumSelect?.value || '0');

			let costOptions = 0;
			if (optWeekend?.checked) costOptions += 22000;
			if (optGroom?.checked) costOptions += 8800;
			if (optRetouch?.checked) costOptions += 16500;
			if (optPermit?.checked) costOptions += 15000;

			const grandTotal = costBase + costTotalOutfit + costAlbum + costOptions;
			const adDiff = Math.max(0, grandTotal - 9800);

			// Update Text Displays
			if (resPhotoTotal) resPhotoTotal.textContent = `${grandTotal.toLocaleString('ja-JP')} 円`;
			if (resAdDiff) resAdDiff.textContent = `+ ${adDiff.toLocaleString('ja-JP')} 円`;

			if (resSubBase) resSubBase.textContent = `${costBase.toLocaleString('ja-JP')} 円`;
			if (resSubOutfit) resSubOutfit.textContent = `${costTotalOutfit.toLocaleString('ja-JP')} 円`;
			if (resSubAlbum) resSubAlbum.textContent = `${costAlbum.toLocaleString('ja-JP')} 円`;
			if (resSubOptions) resSubOptions.textContent = `${costOptions.toLocaleString('ja-JP')} 円`;

			// Badge Status
			if (photoBadge) {
				if (grandTotal <= 100000) {
					photoBadge.textContent = '💡 コスパ最優先プラン（10万円以下のリーズナブルな構成）';
					photoBadge.style.background = '#EFF6FF';
					photoBadge.style.borderColor = '#BFDBFE';
					photoBadge.style.color = '#1E40AF';
				} else if (grandTotal <= 250000) {
					photoBadge.textContent = '✅ 全国平均相場内（全データ＋和装/ロケーションの標準人気構成）';
					photoBadge.style.background = '#ECFDF5';
					photoBadge.style.borderColor = '#A7F3D0';
					photoBadge.style.color = '#065F46';
				} else {
					photoBadge.textContent = '👑 贅沢プレミアムプラン（和洋2〜3着＋高級アルバムの豪華構成）';
					photoBadge.style.background = '#FDF2F8';
					photoBadge.style.borderColor = '#FBCFE8';
					photoBadge.style.color = '#9D174D';
				}
			}

			// Breakdown Bar
			if (barBase && barOutfit && barAlbum && barOpt && grandTotal > 0) {
				const pctBase = Math.round((costBase / grandTotal) * 100);
				const pctOutfit = Math.round((costTotalOutfit / grandTotal) * 100);
				const pctAlbum = Math.round((costAlbum / grandTotal) * 100);
				const pctOpt = Math.max(0, 100 - pctBase - pctOutfit - pctAlbum);

				barBase.style.width = `${pctBase}%`;
				barBase.textContent = pctBase > 10 ? `撮影 ${pctBase}%` : '';

				barOutfit.style.width = `${pctOutfit}%`;
				barOutfit.textContent = pctOutfit > 10 ? `衣装 ${pctOutfit}%` : '';

				barAlbum.style.width = `${pctAlbum}%`;
				barAlbum.textContent = pctAlbum > 10 ? `データ ${pctAlbum}%` : '';

				barOpt.style.width = `${pctOpt}%`;
				barOpt.textContent = pctOpt > 10 ? `OP ${pctOpt}%` : '';
			}
		}

		// Attach Event Listeners
		[locSelect, outfitsSelect, dressGradeSelect, dataAlbumSelect,
		 optWeekend, optGroom, optRetouch, optPermit].forEach(el => {
			if (el) {
				el.addEventListener('change', calculatePhoto);
				el.addEventListener('input', calculatePhoto);
			}
		});

		// Reset Button
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (locSelect) locSelect.value = '85000';
				if (outfitsSelect) outfitsSelect.value = '25000';
				if (dressGradeSelect) dressGradeSelect.value = '30000';
				if (dataAlbumSelect) dataAlbumSelect.value = '40000';

				if (optWeekend) optWeekend.checked = true;
				if (optGroom) optGroom.checked = true;
				if (optRetouch) optRetouch.checked = false;
				if (optPermit) optPermit.checked = true;

				calculatePhoto();
			});
		}

		// Print Button
		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Initial Run
		calculatePhoto();
	</script>

</Layout>
