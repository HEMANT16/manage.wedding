---
import Layout from '../../layouts/Layout.astro';

const title = "【公式】結婚式 日程・六曜・顔合わせ・入籍準備 計算＆段取りツール一覧 | Manage.Wedding 日本版";
const description = "六曜カレンダー＆大安・仏滅割引比較、両家顔合わせの食事代・手土産代割り勘＆タイムライン、婚姻届・入籍準備チェックリスト＆開運日チェッカーなど、結婚準備のマイルストーン管理ツール集。完全無料・登録不要・ローカル保存。";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/ja/schedule/#collection",
      "name": "結婚式 日程・六曜・顔合わせ・入籍準備 ツール一覧",
      "url": "https://manage.wedding/ja/schedule",
      "description": "六曜カレンダー、仏滅割引比較、両家顔合わせ食事会プランナー、入籍日開運日チェックツール集。",
      "inLanguage": "ja",
      "hasPart": [
        { "@type": "WebApplication", "name": "六曜カレンダー＆大安・仏滅 割引比較チェッカー", "url": "https://manage.wedding/ja/rokuyo-wedding-calendar" },
        { "@type": "WebApplication", "name": "両家顔合わせ 予算・割り勘＆タイムライン", "url": "https://manage.wedding/ja/kaoawase-planner" },
        { "@type": "WebApplication", "name": "婚姻届・入籍 準備チェックリスト＆開運日", "url": "https://manage.wedding/ja/nyuseki-checklist" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "仏滅（ぶつめつ）に結婚式を挙げると式場代はどれくらい安くなりますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "式場やシーズンによりますが、大安の土曜日と比べて仏滅や日曜日の夕方・オフシーズン（夏・冬）は「仏滅割引」や「特別特典」として約30万〜100万円ほど見積もりが安くなるケースが多くあります。両家の親御様の了承が得られれば非常に賢いコスト削減策です。"
          }
        },
        {
          "@type": "Question",
          "name": "両家顔合わせ食事会の費用は誰が払うのが一般的ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "近年は「新郎新婦のふたりが全額招待（全額負担）」するケースが約65〜70%と圧倒的多数派です。両親が支払う場合は、両家で折半（50%ずつ均等負担）するのが一般的です。遠方から親御様が来られる場合は「交通費・宿泊費を片方が負担し、食事代をもう片方が負担する」というバランス調整もよく用いられます。"
          }
        },
        {
          "@type": "Question",
          "name": "入籍日（婚姻届提出日）と挙式日はどちらを先にするのが良いですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ゼクシィ結婚トレンド調査によると、約80%以上のカップルが「結婚式の数ヶ月〜1年前に入籍」を先に済ませています。同居や名義変更、新婚旅行の手続きがスムーズに進むため入籍先行が主流ですが、どちらが先でも法的な問題やマナー違反はありません。"
          }
        },
        {
          "@type": "Question",
          "name": "六曜の中で結婚式に最もおすすめのお日柄は何ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "1位は終日吉の「大安（たいあん）」、2位は「友に幸せをお裾分けする」とされる「友引（ともびき / 正午のみ凶）」です。また「先勝（せんしょう / 午前中が吉）」の午前挙式も非常に人気があります。"
          }
        }
      ]
    }
  ]
};

const tools = [
  {
    title: "六曜カレンダー＆大安・仏滅 割引比較",
    url: "/ja/rokuyo-wedding-calendar",
    icon: "📅",
    badge: "お日柄・割引診断",
    badgeBg: "#FEF3C7",
    badgeText: "#92400E",
    lead: "大安・友引・先勝・先負・赤口・仏滅の六曜カレンダーとお日柄別の式場値引き相場を比較。「仏滅割（最大100万円引き）」のメリットと親世代への相談マナーも解説。",
    highlights: ["2026/2027年 六曜カレンダー対応", "大安 vs 仏滅の割引額シミュレーション", "時間帯別（午前・午後・ナイト）吉凶判定"],
    cta: "六曜・お日柄を診断する →"
  },
  {
    title: "両家顔合わせ 予算・割り勘＆タイムライン",
    url: "/ja/kaoawase-planner",
    icon: "🥢",
    badge: "顔合わせ成功ガイド",
    badgeBg: "#DCFCE7",
    badgeText: "#166534",
    lead: "コース料理代（1人1万円〜）・個室料・手土産代の総予算と費用分担（新郎新婦負担 vs 両家折半）を自動計算。当日の2時間進行スケジュールと「しおり」準備リストも生成。",
    highlights: ["食事代＋手土産代の総額算出", "ふたり奢り / 両家折半の自動計算", "当日の2時間タイムテーブル＆進行例"],
    cta: "顔合わせプランを作成する →"
  },
  {
    title: "婚姻届・入籍 準備チェックリスト＆開運日",
    url: "/ja/nyuseki-checklist",
    icon: "💍",
    badge: "入籍パーフェクト",
    badgeBg: "#E0E7FF",
    badgeText: "#3730A3",
    lead: "一粒万倍日・天赦日・大安が重なる「最強開運日」カレンダーと、婚姻届の必要書類（戸籍謄本・証人サイン）から入籍後の名義変更（免許・口座・パスポート）まで全手順を管理。",
    highlights: ["最強開運日カレンダー（一粒万倍日・天赦日）", "婚姻届の準備・提出ステップ", "入籍後の名義変更チェックリスト"],
    cta: "入籍準備リストをチェックする →"
  }
];

const rokuyoNorms = [
  { name: "大安（たいあん）", fortune: "◎ 終日大吉（何事にも最高の吉日）", popular: "人気No.1（予約最激戦）", discount: "割引なし（通常正規料金）" },
  { name: "友引（ともびき）", fortune: "◯ 「友に幸せを引き寄せる」吉日（※正午のみ凶）", popular: "人気No.2（昼前後の挙式が人気）", discount: "特典プレゼント等（小幅）" },
  { name: "先勝（せんしょう）", fortune: "◯ 「先んずれば勝つ」午前中が吉", popular: "午前中の挙式で高需要", discount: "午前プランで通常〜微割" },
  { name: "先負（せんぶ）", fortune: "△ 「先んずれば負ける」午後（14時以降）が吉", popular: "午後・夕方挙式に選ばれる", discount: "5万 〜 20万円引き" },
  { name: "赤口（しゃっく）", fortune: "△ 正午（11時〜13時）のみ吉。お祝いには慎重に", popular: "日柄にこだわらない層に", discount: "10万 〜 30万円引き" },
  { name: "仏滅（ぶつめつ）", fortune: "★ 「物滅」から新しく始まる。式場割引が最大！", popular: "コスパ最優先派に大人気", discount: "30万 〜 100万円引き（大幅割引）" }
];

const kaoawasePaymentPatterns = [
  { pattern: "新郎新婦が全額負担（ふたりがご招待）", ratio: "約 65%", merit: "親に気を使わせず、感謝の気持ちを伝えられる。最も揉めない現代の主流。" },
  { pattern: "両家で完全折半（食事代を50%ずつ）", ratio: "約 20%", merit: "両家の親が「自分たちが出したい」と希望する場合の公平な分担法。" },
  { pattern: "遠方の親＝交通費、地元の親＝食事代", ratio: "約 10%", merit: "遠方から新幹線・飛行機で来る親御様の交通負担を相殺する合理的な方法。" },
  { pattern: "新郎側が全額負担（伝統的な結納スタイル）", ratio: "約 5%", merit: "格式や地域のしきたりを重視する場合のスタイル。" }
];
---

<Layout title={title} description={description} schema={schema}>
	
	<!-- Category Hero Section -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3rem) 1rem; background: #fff; border-bottom: 2px solid var(--fg-pencil);">
		<div style="max-width: 1100px; margin: 0 auto;">
			
			<!-- Breadcrumb Link -->
			<div style="margin-bottom: 1.25rem; font-size: 0.88rem;">
				<a href="/ja" style="color: #2563EB; text-decoration: none; font-weight: 600;">ホーム</a>
				<span style="margin: 0 0.5rem; color: var(--text-secondary);">›</span>
				<span style="color: var(--text-secondary);">日程・顔合わせ・入籍段取り</span>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; align-items: center;">
				<div>
					<div style="display: inline-flex; align-items: center; gap: 0.4rem; background: #FEF3C7; border: 1.5px solid #FDE047; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 800; color: #92400E; margin-bottom: 1rem;">
						<span>📅</span>
						<span>CATEGORY 03 • 日程・顔合わせ・入籍段取り</span>
					</div>

					<h1 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
						結婚式 日程・六曜・顔合わせ・入籍<br/>
						<span style="background: linear-gradient(180deg, transparent 65%, #FDE68A 65%);">専門計算＆段取りツール一覧</span>
					</h1>

					<p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.8; margin-bottom: 1.5rem;">
						プロポーズ後の両家顔合わせ食事会から、一粒万倍日などの入籍開運日選び、結婚式当日のお日柄（大安・仏滅割引）まで。<strong>結婚準備の全マイルストーンをスムーズに進めるための専用ツール</strong>を完全無料でご利用いただけます。
					</p>

					<!-- Trust Badges -->
					<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.80rem; font-weight: 700; background: #f0fdf4; border: 1px solid #86efac; color: #166534; padding: 3px 8px; border-radius: 4px;">
							🔒 完全ローカル保存（データ送信ゼロ）
						</span>
						<span style="font-size: 0.80rem; font-weight: 700; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 3px 8px; border-radius: 4px;">
							⚡ 会員登録・営業電話なし
						</span>
						<span style="font-size: 0.80rem; font-weight: 700; background: #fefce8; border: 1px solid #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px;">
							📄 無地・ノーブランドPDF印刷
						</span>
					</div>
				</div>

				<!-- Mini Live Estimator: Marriage Milestone Timeline Estimator -->
				<div class="hand-card" style="background: #fff; padding: 1.5rem; border: 2.5px solid var(--fg-pencil); box-shadow: 5px 5px 0px var(--fg-pencil);">
					<div class="tape" style="top: -12px; left: 30%;"></div>
					<div style="font-size: 0.82rem; font-weight: 800; color: #92400E; text-transform: uppercase; margin-bottom: 0.3rem;">
						MILESTONE CALCULATOR
					</div>
					<h3 style="font-size: 1.1rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 1rem;">
						🗓️ 挙式予定月から逆算！準備タイムライン
					</h3>

					<div style="margin-bottom: 1rem;">
						<label for="wedding-target-date" style="font-size: 0.82rem; font-weight: 700; color: var(--fg-pencil); display: block; margin-bottom: 0.35rem;">
							結婚式の予定年月を選択
						</label>
						<input type="month" id="wedding-target-date" value="2026-10" style="width: 100%; padding: 8px 12px; font-size: 1rem; font-weight: 800; border: 1.5px solid var(--fg-pencil); border-radius: 6px; box-sizing: border-box;" />
					</div>

					<div style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.80rem;">
						<div style="display: flex; justify-content: space-between; padding: 6px 8px; background: #FAF8F5; border-radius: 4px; border: 1px solid #e2e8f0;">
							<span style="font-weight: 700;">🥢 両家顔合わせ（8〜6ヶ月前）:</span>
							<span id="m-kaoawase" style="font-weight: 900; color: #166534;">2026年 2月 〜 4月</span>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 6px 8px; background: #FAF8F5; border-radius: 4px; border: 1px solid #e2e8f0;">
							<span style="font-weight: 700;">💍 婚姻届・入籍日（6〜3ヶ月前）:</span>
							<span id="m-nyuseki" style="font-weight: 900; color: #3730A3;">2026年 4月 〜 7月</span>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 6px 8px; background: #FAF8F5; border-radius: 4px; border: 1px solid #e2e8f0;">
							<span style="font-weight: 700;">💌 招待状発送（3〜2.5ヶ月前）:</span>
							<span id="m-invitation" style="font-weight: 900; color: #92400E;">2026年 7月 〜 8月</span>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 6px 8px; background: #FAF8F5; border-radius: 4px; border: 1px solid #e2e8f0;">
							<span style="font-weight: 700;">💰 最終見積・振込（1〜2週間前）:</span>
							<span id="m-payment" style="font-weight: 900; color: #DC2626;">2026年 10月 上旬</span>
						</div>
					</div>

					<div style="font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.75rem; text-align: center;">
						※ 上記スケジュールを目安に各ツールのチェックリストをご活用ください
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- Main Tools Section -->
	<section class="section-paper" style="padding: clamp(2rem, 4vw, 3.5rem) 1rem; background: var(--bg-paper, #fcfaf7);">
		<div style="max-width: 1100px; margin: 0 auto;">
			
			<!-- Tool Cards Grid -->
			<div style="display: flex; flex-direction: column; gap: 1.75rem; margin-bottom: 3.5rem;">
				{tools.map((tool) => (
					<div class="hand-card" style="background: #fff; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); overflow: hidden;">
						
						<div style="padding: clamp(1.25rem, 3vw, 2rem);">
							<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
								<span style="font-size: 1.8rem;">{tool.icon}</span>
								<span style={`font-size: 0.75rem; font-weight: 700; padding: 3px 8px; border-radius: 4px; background: ${tool.badgeBg}; color: ${tool.badgeText}; border: 1px solid ${tool.badgeText}22;`}>
									{tool.badge}
								</span>
							</div>

							<h2 style="font-size: 1.3rem; font-weight: 800; color: var(--fg-pencil); margin-bottom: 0.5rem; line-height: 1.4;">
								{tool.title}
							</h2>

							<p style="font-size: 0.90rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 1rem;">
								{tool.lead}
							</p>

							<ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; display: flex; flex-direction: column; gap: 0.3rem;">
								{tool.highlights.map((h) => (
									<li style="font-size: 0.82rem; color: var(--fg-pencil); font-weight: 600; display: flex; align-items: center; gap: 0.4rem;">
										<span style="color: #2563EB; font-weight: 800;">✓</span> {h}
									</li>
								))}
							</ul>

							<a href={tool.url} class="hand-btn" style="text-align: center; text-decoration: none; display: inline-block; padding: 10px 20px; font-size: 0.90rem; font-weight: 800;">
								{tool.cta}
							</a>
						</div>

					</div>
				))}
			</div>

			<!-- Rokuyo Table Reference -->
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); margin-bottom: 3.5rem; border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil);">
				<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
					📋 【早見表】六曜の意味とお日柄別の式場値引き相場
				</h2>
				<p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
					日柄にこだわる親御様への配慮と、結婚式費用節約のバランスを見極めるための基準表です。
				</p>

				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
						<thead>
							<tr style="border-bottom: 2px solid var(--fg-pencil); background: #FAF8F5;">
								<th style="padding: 10px 12px; font-weight: 800;">六曜</th>
								<th style="padding: 10px 12px; font-weight: 800;">吉凶の意味</th>
								<th style="padding: 10px 12px; font-weight: 800;">結婚式の人気度</th>
								<th style="padding: 10px 12px; font-weight: 800; color: #DC2626;">式場値引き・特典目安</th>
							</tr>
						</thead>
						<tbody>
							{rokuyoNorms.map((row) => (
								<tr style="border-bottom: 1px dashed #e2e8f0;">
									<td style="padding: 10px 12px; font-weight: 800; color: var(--fg-pencil);">{row.name}</td>
									<td style="padding: 10px 12px;">{row.fortune}</td>
									<td style="padding: 10px 12px; font-weight: 700;">{row.popular}</td>
									<td style="padding: 10px 12px; font-weight: 800; color: #DC2626; background: #FEF2F2;">{row.discount}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Kaoawase Table Reference -->
			<div class="hand-card" style="background: #fff; padding: clamp(1.5rem, 3vw, 2.5rem); margin-bottom: 3.5rem; border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil);">
				<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
					🥢 【早見表】両家顔合わせ食事会の費用分担パターン
				</h2>
				<p style="font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
					食事会当日にお会計で揉めないよう、事前にふたりで支払い方法を決めて親御様に伝えておきましょう。
				</p>

				<div style="overflow-x: auto;">
					<table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left;">
						<thead>
							<tr style="border-bottom: 2px solid var(--fg-pencil); background: #FAF8F5;">
								<th style="padding: 10px 12px; font-weight: 800;">分担パターン</th>
								<th style="padding: 10px 12px; font-weight: 800; color: #1E40AF;">実施割合</th>
								<th style="padding: 10px 12px; font-weight: 800;">特徴とメリット</th>
							</tr>
						</thead>
						<tbody>
							{kaoawasePaymentPatterns.map((row) => (
								<tr style="border-bottom: 1px dashed #e2e8f0;">
									<td style="padding: 10px 12px; font-weight: 800; color: var(--fg-pencil);">{row.pattern}</td>
									<td style="padding: 10px 12px; font-weight: 900; color: #1E40AF; background: #EFF6FF;">{row.ratio}</td>
									<td style="padding: 10px 12px; font-size: 0.82rem; color: var(--text-secondary);">{row.merit}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<!-- FAQ Section -->
			<div style="max-width: 850px; margin: 0 auto 3.5rem auto;">
				<h2 class="font-heading" style="font-size: 1.5rem; color: var(--fg-pencil); text-align: center; margin-bottom: 1.25rem;">
					日程・顔合わせ・入籍に関するよくあるご質問（FAQ）
				</h2>

				<div style="display: flex; flex-direction: column; gap: 0.75rem;">
					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							仏滅（ぶつめつ）に結婚式を挙げると式場代はどれくらい安くなりますか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							式場やシーズンによりますが、大安の土曜日と比べて仏滅や日曜日の夕方・オフシーズン（夏・冬）は「仏滅割引」や「特別特典」として約30万〜100万円ほど見積もりが安くなるケースが多くあります。両家の親御様の了承が得られれば非常に賢いコスト削減策です。
						</p>
					</details>

					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							両家顔合わせ食事会の費用は誰が払うのが一般的ですか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							近年は「新郎新婦のふたりが全額招待（全額負担）」するケースが約65〜70%と圧倒的多数派です。両親が支払う場合は、両家で折半（50%ずつ均等負担）するのが一般的です。遠方から親御様が来られる場合は「交通費・宿泊費を片方が負担し、食事代をもう片方が負担する」というバランス調整もよく用いられます。
						</p>
					</details>

					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							入籍日（婚姻届提出日）と挙式日はどちらを先にするのが良いですか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							ゼクシィ結婚トレンド調査によると、約80%以上のカップルが「結婚式の数ヶ月〜1年前に入籍」を先に済ませています。同居や名義変更、新婚旅行の手続きがスムーズに進むため入籍先行が主流ですが、どちらが先でも法的な問題やマナー違反はありません。
						</p>
					</details>

					<details class="hand-card" style="background: #fff; padding: 1.1rem; cursor: pointer; border: 1.5px solid var(--fg-pencil);">
						<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							六曜の中で結婚式に最もおすすめのお日柄は何ですか？
						</summary>
						<p style="margin-top: 0.6rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;">
							1位は終日吉の「大安（たいあん）」、2位は「友に幸せをお裾分けする」とされる「友引（ともびき / 正午のみ凶）」です。また「先勝（せんしょう / 午前中が吉）」の午前挙式も非常に人気があります。
						</p>
					</details>
