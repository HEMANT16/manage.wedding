	<!-- Milestone Script -->
	<script is:inline>
		const targetDateInput = document.getElementById('wedding-target-date');
		const mKaoawase = document.getElementById('m-kaoawase');
		const mNyuseki = document.getElementById('m-nyuseki');
		const mInvitation = document.getElementById('m-invitation');
		const mPayment = document.getElementById('m-payment');

		function formatYearMonth(date) {
			return `${date.getFullYear()}年 ${date.getMonth() + 1}月`;
		}

		function updateMilestones() {
			const val = targetDateInput?.value;
			if (!val) return;

			const parts = val.split('-');
			const year = parseInt(parts[0], 10);
			const month = parseInt(parts[1], 10) - 1; // 0-indexed

			const weddingDate = new Date(year, month, 1);

			// Kaoawase (8-6 months before)
			const kao8 = new Date(weddingDate);
			kao8.setMonth(kao8.getMonth() - 8);
			const kao6 = new Date(weddingDate);
			kao6.setMonth(kao6.getMonth() - 6);

			// Nyuseki (6-3 months before)
			const nyu6 = new Date(weddingDate);
			nyu6.setMonth(nyu6.getMonth() - 6);
			const nyu3 = new Date(weddingDate);
			nyu3.setMonth(nyu3.getMonth() - 3);

			// Invitation (3-2.5 months before)
			const inv3 = new Date(weddingDate);
			inv3.setMonth(inv3.getMonth() - 3);
			const inv2 = new Date(weddingDate);
			inv2.setMonth(inv2.getMonth() - 2);

			// Payment (same month early)
			const payMonth = formatYearMonth(weddingDate);

			if (mKaoawase) mKaoawase.textContent = `${formatYearMonth(kao8)} 〜 ${formatYearMonth(kao6)}`;
			if (mNyuseki) mNyuseki.textContent = `${formatYearMonth(nyu6)} 〜 ${formatYearMonth(nyu3)}`;
			if (mInvitation) mInvitation.textContent = `${formatYearMonth(inv3)} 〜 ${formatYearMonth(inv2)}`;
			if (mPayment) mPayment.textContent = `${payMonth} 上旬（挙式直前）`;
		}

		if (targetDateInput) {
			targetDateInput.addEventListener('change', updateMilestones);
			targetDateInput.addEventListener('input', updateMilestones);
		}

		updateMilestones();
	</script>

</Layout>
