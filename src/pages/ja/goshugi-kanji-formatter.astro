	<!-- Interactive Client Script for Calculator -->
	<script is:inline>
		const inputAmount = document.getElementById('input-amount');
		const resDaijiText = document.getElementById('res-daiji-text');
		const mockFrontText = document.getElementById('mock-front-text');
		const quickBtns = document.querySelectorAll('.quick-amt-btn');
		const resetBtn = document.getElementById('reset-kanji-btn');
		const printBtn = document.getElementById('print-kanji-btn');

		const digits = {
			0: '', 1: '壱', 2: '弐', 3: '参', 4: '四', 5: '伍', 6: '六', 7: '七', 8: '八', 9: '九'
		};

		function convertToDaiji(num) {
			if (num === 0) return '金 零圓 也';
			if (num < 0) return '正の金額を入力してください';

			let man = Math.floor(num / 10000);
			let sen = Math.floor((num % 10000) / 1000);
			let hyaku = Math.floor((num % 1000) / 100);

			let manStr = '';
			if (man > 0) {
				if (man >= 100) {
					const hMan = Math.floor(man / 100);
					const remMan = man % 100;
					const tMan = Math.floor(remMan / 10);
					const uMan = remMan % 10;
					
					let part = (hMan === 1 ? '壱百' : (digits[hMan] + '百'));
					if (tMan === 1) part += '拾';
					else if (tMan > 1) part += digits[tMan] + '拾';
					if (uMan > 0) part += digits[uMan];
					manStr = part + '萬';
				} else if (man >= 10) {
					const tMan = Math.floor(man / 10);
					const uMan = man % 10;
					let part = (tMan === 1 ? '拾' : (digits[tMan] + '拾'));
					if (uMan > 0) part += digits[uMan];
					manStr = part + '萬';
				} else {
					manStr = digits[man] + '萬';
				}
			}

			let senStr = '';
			if (sen > 0) {
				senStr = (sen === 1 ? '壱阡' : (digits[sen] + '阡'));
			}

			let hyakuStr = '';
			if (hyaku > 0) {
				hyakuStr = (hyaku === 1 ? '壱百' : (digits[hyaku] + '百'));
			}

			const fullStr = '金 ' + manStr + senStr + hyakuStr + '圓 也';
			return fullStr.trim();
		}

		function updateDisplay() {
			const val = parseInt(inputAmount?.value || '0', 10);
			const daiji = convertToDaiji(val);

			if (resDaijiText) resDaijiText.textContent = daiji;
			if (mockFrontText) mockFrontText.textContent = daiji;
		}

		if (inputAmount) {
			inputAmount.addEventListener('input', updateDisplay);
		}

		quickBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const val = btn.getAttribute('data-val');
				if (inputAmount && val) {
					inputAmount.value = val;
					updateDisplay();
				}
			});
		});

		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				if (inputAmount) {
					inputAmount.value = '30000';
					updateDisplay();
				}
			});
		}

		if (printBtn) {
			printBtn.addEventListener('click', () => {
				window.print();
			});
		}

		// Initial Run
		updateDisplay();
	</script>

