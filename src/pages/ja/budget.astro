	<!-- Quick Estimator Client Script -->
	<script is:inline>
		const costInput = document.getElementById('quick-total-cost');
		const guestInput = document.getElementById('quick-guest-count');
		const goshugiDisplay = document.getElementById('quick-goshugi-display');
		const jikoDisplay = document.getElementById('quick-jiko-display');

		function recalculateQuickBudget() {
			if (!costInput || !guestInput || !goshugiDisplay || !jikoDisplay) return;
			const totalCost = parseFloat(costInput.value) || 0;
			const guestCount = parseFloat(guestInput.value) || 0;

			// Weighted average Goshugi in Japan ~ ¥35,000 / guest (Friends 30k, Bosses 50k, Relatives 70k+)
			const estimatedGoshugi = Math.round(guestCount * 35000);
			const jikoFutan = Math.max(0, totalCost - estimatedGoshugi);

			goshugiDisplay.textContent = `約 ${estimatedGoshugi.toLocaleString('ja-JP')} 円`;
			jikoDisplay.textContent = `約 ${jikoFutan.toLocaleString('ja-JP')} 円`;
		}

		if (costInput && guestInput) {
			costInput.addEventListener('input', recalculateQuickBudget);
			guestInput.addEventListener('input', recalculateQuickBudget);
		}
	</script>

</Layout>
