			<!-- Realistic Wedding Cost Benchmarks Table -->
			<div class="hand-card" style="background: #fff; padding: 2rem; border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); margin-bottom: 3.5rem;">
