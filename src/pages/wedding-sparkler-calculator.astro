	const resBufferCount = document.getElementById('res-buffer-count');
	
	const resBurnTotalText = document.getElementById('res-burn-total-text');
	const resTimeWave = document.getElementById('res-time-wave');
	const resTimePhoto = document.getElementById('res-time-photo');
	const resTimeEmber = document.getElementById('res-time-ember');
	const barLightingWave = document.getElementById('bar-lighting-wave');
	const barPhotoWindow = document.getElementById('bar-photo-window');
	const barBurnout = document.getElementById('bar-burnout');
	
	const resCountTorches = document.getElementById('res-count-torches');
	const resCountBuckets = document.getElementById('res-count-buckets');
	const resCorridorLen = document.getElementById('res-corridor-len');
	
	// Timeline Dyn Elements
	const dynCueTargetTime = document.getElementById('dyn-cue-target-time');
	const timeT30 = document.getElementById('time-t30');
	const timeT15 = document.getElementById('time-t15');
	const timeT10 = document.getElementById('time-t10');
	const timeT3 = document.getElementById('time-t3');
	const timeT1 = document.getElementById('time-t1');
	const timeT0 = document.getElementById('time-t0');
	const timeTp2 = document.getElementById('time-tp2');

	// Sign Elements
	const signStyleBtns = document.querySelectorAll('.btn-sign-style');
	const signViewStyleA = document.getElementById('sign-view-style-a');
	const signViewStyleB = document.getElementById('sign-view-style-b');
	const signViewStyleC = document.getElementById('sign-view-style-c');
	const dynSignTimeEls = document.querySelectorAll('.dyn-sign-time');
	const dynSignNamesEls = document.querySelectorAll('.dyn-sign-names');
	const dynSignSubtextEls = document.querySelectorAll('.dyn-sign-subtext');
	const dynCoupleTexts = document.querySelectorAll('.dyn-couple-text');
	const dynGuestsTexts = document.querySelectorAll('.dyn-guests-text');
	const dynBucketsTexts = document.querySelectorAll('.dyn-buckets-text');
	const dynTorchesTexts = document.querySelectorAll('.dyn-torches-text');

	function parseTimeString(timeStr) {
		const match = (timeStr || '').match(/(\d+):(\d+)\s*(AM|PM)?/i);
		if (!match) return { hours: 22, minutes: 45, period: 'PM' };
		let hours = parseInt(match[1], 10);
		let minutes = parseInt(match[2], 10);
		let period = match[3] ? match[3].toUpperCase() : (hours >= 12 ? 'PM' : 'AM');
		return { hours, minutes, period };
	}

	function formatTimeOffset(baseObj, offsetMinutes) {
		let totalMins = baseObj.hours * 60 + baseObj.minutes + offsetMinutes;
		if (baseObj.period === 'PM' && baseObj.hours < 12) totalMins += 12 * 60;
		if (baseObj.period === 'AM' && baseObj.hours === 12) totalMins -= 12 * 60;
		
		totalMins = (totalMins + 1440) % 1440;
		let h = Math.floor(totalMins / 60);
		let m = totalMins % 60;
		let p = h >= 12 ? 'PM' : 'AM';
		h = h % 12;
		if (h === 0) h = 12;
		const mStr = m < 10 ? '0' + m : m;
		return `${h}:${mStr} ${p}`;
	}

	function calculate() {
		const totalGuests = parseInt(sliderGuests.value, 10);
		if (labelGuestCount) labelGuestCount.textContent = `${totalGuests} guests`;

		// Retention Rate
		let retentionPct = 0.70;
		const timingVal = selectTiming.value;
		if (timingVal === 'late-night') {
			retentionPct = 0.70;
			if (customRetentionBox) customRetentionBox.style.display = 'none';
		} else if (timingVal === 'staged') {
			retentionPct = 0.95;
			if (customRetentionBox) customRetentionBox.style.display = 'none';
		} else if (timingVal === 'ceremony') {
			retentionPct = 1.00;
			if (customRetentionBox) customRetentionBox.style.display = 'none';
		} else {
			if (customRetentionBox) customRetentionBox.style.display = 'block';
			retentionPct = parseInt(sliderRetention.value, 10) / 100;
			if (labelRetentionVal) labelRetentionVal.textContent = `${Math.round(retentionPct * 100)}%`;
		}

		const participatingGuests = Math.max(10, Math.round(totalGuests * retentionPct));
		const earlyDepartures = Math.max(0, totalGuests - participatingGuests);

		if (retentionSummary) retentionSummary.textContent = `${participatingGuests} guests`;
		if (attritionSummary) attritionSummary.textContent = `${earlyDepartures} guests`;

		// Sparkler Length
		let sparklerLen = 20;
		radioSparklerLens.forEach(r => {
			if (r.checked) sparklerLen = parseInt(r.value, 10);
			const card = document.getElementById(`card-len-${r.value}`);
			if (card) {
				if (r.checked) {
					card.classList.add('active');
					card.style.borderColor = '#b45309';
					card.style.background = '#fffbeb';
					card.style.boxShadow = '0 0 0 1px #b45309';
				} else {
					card.classList.remove('active');
					card.style.borderColor = '#cbd5e1';
					card.style.background = '#ffffff';
					card.style.boxShadow = 'none';
				}
			}
		});

		const perGuest = parseInt(selectSparklersPerGuest.value, 10);
		const bufferPct = parseInt(selectBufferPct.value, 10) / 100;

		const baseCount = participatingGuests * perGuest;
		const bufferCount = Math.ceil(baseCount * bufferPct);
		const totalSparklers = baseCount + bufferCount;

		// Update Totals
		if (resTotalSparklers) resTotalSparklers.textContent = totalSparklers;
		if (resCalcGuests) resCalcGuests.textContent = `${participatingGuests} guests`;
		if (resBaseCount) resBaseCount.textContent = `${baseCount} sparklers`;
		if (resBufferCount) resBufferCount.textContent = `+${bufferCount} sparklers`;

		// Standard packs
		const packsOf8 = Math.ceil(totalSparklers / 8);
		const boxesOf24 = Math.ceil(totalSparklers / 24);
		if (badgePackSize) badgePackSize.textContent = `~${packsOf8} packs (8-ct) / ${boxesOf24} boxes (24-ct)`;

		// Timing & Burn Photo Window
		let burnSec = 120;
		let waveSec = 25;
		let photoSec = 75;
		let emberSec = 20;

		if (sparklerLen === 10) {
			burnSec = 40;
			waveSec = 20;
			photoSec = 15;
			emberSec = 5;
		} else if (sparklerLen === 20) {
			burnSec = 120;
			waveSec = 25;
			photoSec = 75;
			emberSec = 20;
		} else if (sparklerLen === 36) {
			burnSec = 240;
			waveSec = 30;
			photoSec = 180;
			emberSec = 30;
		}

		if (resBurnTotalText) resBurnTotalText.textContent = `${burnSec} Seconds Total`;
		if (resTimeWave) resTimeWave.textContent = `${waveSec}s`;
		if (resTimePhoto) resTimePhoto.textContent = `${photoSec}s`;
		if (resTimeEmber) resTimeEmber.textContent = `${emberSec}s`;

		if (barLightingWave) barLightingWave.style.width = `${(waveSec / burnSec) * 100}%`;
		if (barPhotoWindow) barPhotoWindow.style.width = `${(photoSec / burnSec) * 100}%`;
		if (barBurnout) barBurnout.style.width = `${(emberSec / burnSec) * 100}%`;

		// Equipment Math
		const torchCount = Math.max(2, Math.ceil(participatingGuests / 9));
		const bucketCount = Math.max(2, Math.ceil(participatingGuests / 25));
		const corridorFt = Math.round((participatingGuests / 2) * 1.5);
		const corridorM = Math.round(corridorFt * 0.3048);

		if (resCountTorches) resCountTorches.textContent = `${torchCount} Torches`;
		if (resCountBuckets) resCountBuckets.textContent = `${bucketCount} Buckets`;
		if (resCorridorLen) resCorridorLen.textContent = `~${corridorFt} ft (${corridorM}m) long × 10 ft wide`;

		// Couple & Names & Time
		const coupleNames = (inputSignNames ? inputSignNames.value.trim() : '') || (inputCoupleNames ? inputCoupleNames.value.trim() : '') || 'Emma & Liam';
		const exitTime = (inputSignTime ? inputSignTime.value.trim() : '') || (inputExitTime ? inputExitTime.value.trim() : '') || '10:45 PM';
		const customMsg = inputSignCustomMsg ? inputSignCustomMsg.value.trim() : '';

		if (dynCueTargetTime) dynCueTargetTime.textContent = exitTime;
		dynSignTimeEls.forEach(el => el.textContent = exitTime);
		dynSignNamesEls.forEach(el => el.textContent = coupleNames);
		dynCoupleTexts.forEach(el => el.textContent = coupleNames);
		dynGuestsTexts.forEach(el => el.textContent = participatingGuests);
		dynBucketsTexts.forEach(el => el.textContent = bucketCount);
		dynTorchesTexts.forEach(el => el.textContent = torchCount);

		if (customMsg) {
			dynSignSubtextEls.forEach(el => el.textContent = customMsg);
		}

		// Dynamic Timeline calculation
		const timeObj = parseTimeString(exitTime);
		if (timeT30) timeT30.textContent = formatTimeOffset(timeObj, -30);
		if (timeT15) timeT15.textContent = formatTimeOffset(timeObj, -15);
		if (timeT10) timeT10.textContent = formatTimeOffset(timeObj, -10);
		if (timeT3) timeT3.textContent = formatTimeOffset(timeObj, -3);
		if (timeT1) timeT1.textContent = formatTimeOffset(timeObj, -1);
		if (timeT0) timeT0.textContent = formatTimeOffset(timeObj, 0);
		if (timeTp2) timeTp2.textContent = formatTimeOffset(timeObj, 2);
	}

	// Two-Way Sync for Names, Time, and Custom Message
	if (inputSignNames && inputCoupleNames) {
		inputSignNames.addEventListener('input', () => {
			inputCoupleNames.value = inputSignNames.value;
			calculate();
		});
		inputCoupleNames.addEventListener('input', () => {
			inputSignNames.value = inputCoupleNames.value;
			calculate();
		});
	}

	if (inputSignTime && inputExitTime) {
		inputSignTime.addEventListener('input', () => {
			inputExitTime.value = inputSignTime.value;
			calculate();
		});
		inputExitTime.addEventListener('input', () => {
			inputSignTime.value = inputExitTime.value;
			calculate();
		});
	}

	if (inputSignCustomMsg) {
		inputSignCustomMsg.addEventListener('input', () => {
			const msg = inputSignCustomMsg.value.trim() || "Please take one sparkler and join us along the terrace path for the newlyweds' grand farewell!";
			dynSignSubtextEls.forEach(el => el.textContent = msg);
		});
	}

	// Sign Switcher
	signStyleBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			signStyleBtns.forEach(b => {
				b.classList.remove('active');
				b.style.background = 'transparent';
				b.style.color = 'var(--fg-pencil)';
			});
			btn.classList.add('active');
			btn.style.background = '#b45309';
			btn.style.color = '#ffffff';

			const style = btn.getAttribute('data-style');
			if (signViewStyleA) signViewStyleA.style.display = style === 'style-a' ? 'block' : 'none';
			if (signViewStyleB) signViewStyleB.style.display = style === 'style-b' ? 'block' : 'none';
			if (signViewStyleC) signViewStyleC.style.display = style === 'style-c' ? 'block' : 'none';
		});
	});

	// Print Actions
	const btnPrintSign = document.getElementById('btn-print-sign');
	if (btnPrintSign) {
		btnPrintSign.addEventListener('click', () => {
			document.body.classList.add('print-sign-only-mode');
			window.print();
		});
	}

	const btnPrintTop = document.getElementById('btn-print-top');
	if (btnPrintTop) {
		btnPrintTop.addEventListener('click', () => {
			document.body.classList.remove('print-sign-only-mode');
			window.print();
		});
	}

	window.addEventListener('afterprint', () => {
		document.body.classList.remove('print-sign-only-mode');
	});

	// PNG Image Download via html2canvas
	const btnDownloadImage = document.getElementById('btn-download-image');
	if (btnDownloadImage) {
		btnDownloadImage.addEventListener('click', () => {
			const targetCanvas = document.getElementById('printable-sign-canvas');
			if (!targetCanvas) return;

			const originalHtml = btnDownloadImage.innerHTML;
			btnDownloadImage.innerHTML = '<span>⏳</span> Rendering PNG...';

			if (typeof html2canvas !== 'undefined') {
				html2canvas(targetCanvas, {
					scale: 2,
					useCORS: true,
					backgroundColor: '#ffffff'
				}).then(canvas => {
					const coupleNames = (inputSignNames ? inputSignNames.value.trim() : '') || 'Emma_and_Liam';
					const link = document.createElement('a');
					link.download = `Let-Love-Sparkle-Sign-${coupleNames.replace(/[^a-zA-Z0-9]/g, '_')}.png`;
					link.href = canvas.toDataURL('image/png');
					link.click();
					btnDownloadImage.innerHTML = originalHtml;
				}).catch(err => {
					console.error('Error generating image:', err);
					btnDownloadImage.innerHTML = originalHtml;
					alert('Unable to capture image. Please use "Print Calculation (PDF)".');
				});
			} else {
				btnDownloadImage.innerHTML = originalHtml;
				alert('Image generator is initializing. Please try again in a moment or use Print (PDF).');
			}
		});
	}

	// Download Word Doc Action
	function downloadWordDoc() {
		const coupleNames = (inputSignNames ? inputSignNames.value.trim() : '') || (inputCoupleNames ? inputCoupleNames.value.trim() : '') || 'Emma & Liam';
		const exitTime = (inputSignTime ? inputSignTime.value.trim() : '') || (inputExitTime ? inputExitTime.value.trim() : '') || '10:45 PM';
		const customMsg = (inputSignCustomMsg ? inputSignCustomMsg.value.trim() : '') || "Please take one sparkler and join us along the terrace path for the newlyweds' grand farewell!";
		const totalSparklers = resTotalSparklers ? resTotalSparklers.textContent : '97';
		const participatingGuests = resCalcGuests ? resCalcGuests.textContent : '84';
		const torchCount = resCountTorches ? resCountTorches.textContent : '9';
		const bucketCount = resCountBuckets ? resCountBuckets.textContent : '4';

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Wedding Sparkler Exit Guide & Signs — ${coupleNames}</title>
				<style>
					body { font-family: 'Calibri', 'Segoe UI', Arial, sans-serif; padding: 25pt; font-size: 11pt; color: #1e293b; }
					h1 { color: #b45309; font-size: 24pt; margin-bottom: 4pt; text-align: center; }
					h2 { color: #0f172a; font-size: 14pt; margin-top: 18pt; border-bottom: 1.5pt solid #cbd5e1; padding-bottom: 4pt; }
					.sign-box { border: 2pt solid #b45309; padding: 25pt; text-align: center; margin: 20pt 0; background: #fffdfa; }
					.badge { background: #fef08a; padding: 4pt 10pt; font-weight: bold; }
					table { width: 100%; border-collapse: collapse; margin-top: 10pt; }
					th, td { border: 1pt solid #cbd5e1; padding: 8pt; text-align: left; }
					th { background: #f8fafc; }
				</style>
			</head>
			<body>
				<div class="sign-box">
					<p style="font-size: 16pt; color: #b45309; letter-spacing: 2pt;">✦ ✨ ✦</p>
					<h1 style="font-size: 28pt; margin: 10pt 0;">Let Love Sparkle</h1>
					<p style="font-size: 16pt; font-weight: bold; color: #b45309;">Sparkler Send-Off at ${exitTime}</p>
					<p style="font-size: 12pt; margin: 15pt 0;">${customMsg}<br><em>Do not light until instructed by the coordinator.</em></p>
					<p style="font-size: 18pt; font-weight: bold; margin-top: 20pt;">${coupleNames}</p>
				</div>

				<h2>📋 Coordinator Sparkler Send-Off Briefing</h2>
				<table>
					<tr><th>Parameter</th><th>Value</th></tr>
					<tr><td>Couple Names</td><td><strong>${coupleNames}</strong></td></tr>
					<tr><td>Target Exit Time</td><td><strong>${exitTime}</strong></td></tr>
					<tr><td>Total Sparklers to Order</td><td><strong>${totalSparklers}</strong></td></tr>
					<tr><td>Participating Guests</td><td><strong>${participatingGuests}</strong></td></tr>
					<tr><td>Windproof Butane Torches</td><td><strong>${torchCount}</strong></td></tr>
					<tr><td>Metal Sand Disposal Buckets</td><td><strong>${bucketCount}</strong></td></tr>
				</table>

				<h2>🛡️ Mandatory Safety Instructions</h2>
				<ul>
					<li><strong>Smokeless Wire-Core Only:</strong> Never use wooden or bamboo stick sparklers.</li>
					<li><strong>Corridor Clearance:</strong> Keep a minimum 10-foot width between guest rows.</li>
					<li><strong>Lighting Wave:</strong> Light only with butane torches, then touch tip-to-tip.</li>
					<li><strong>Sand Buckets:</strong> Insert spent hot wires tip-down into metal sand buckets immediately.</li>
				</ul>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Sparkler-Send-Off-Guide-${coupleNames.replace(/[^a-zA-Z0-9]/g, '_')}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	}

	const btnDownloadWord = document.getElementById('btn-download-word');
	if (btnDownloadWord) btnDownloadWord.addEventListener('click', downloadWordDoc);
	const btnDocTop = document.getElementById('btn-download-word-top');
	if (btnDocTop) btnDocTop.addEventListener('click', downloadWordDoc);

	// General Form Listeners
	if (sliderGuests) sliderGuests.addEventListener('input', calculate);
	if (selectTiming) selectTiming.addEventListener('change', calculate);
	if (sliderRetention) sliderRetention.addEventListener('input', calculate);
	radioSparklerLens.forEach(r => r.addEventListener('change', calculate));
	if (selectSparklersPerGuest) selectSparklersPerGuest.addEventListener('change', calculate);
	if (selectBufferPct) selectBufferPct.addEventListener('change', calculate);

	// Initial Run
	calculate();
})();
</script>
