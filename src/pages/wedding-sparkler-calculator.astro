---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import RelatedTools from '../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/wedding-sparkler-calculator/#webapp",
      "name": "Wedding Sparkler Send-Off Calculator & Free Printable Bar Signs",
      "url": "https://manage.wedding/wedding-sparkler-calculator",
      "description": "Calculate exact wedding sparklers needed (20\" vs 36\" burn time photo windows), butane torch stations, and sand buckets. Includes free 1-click printable 'Let Love Sparkle' bar signs & safety cards.",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Plan and Execute a Flawless Wedding Sparkler Send-Off",
      "description": "Step-by-step coordinator dispatch guide to lighting and organizing a safe, breathtaking sparkler exit tunnel.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Calculate Real Headcount & Sparkler Size",
          "text": "Factor in late-night guest attrition (typically 25-30% leave before late exits) and select 20-inch (90-120s burn) or 36-inch (210-240s burn) smokeless wire-core sparklers."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Prepare Safety Stations & Sand Buckets",
          "text": "Place galvanized metal buckets filled with water or sand at the start and end of the exit corridor. Never use plastic trash cans or drop hot wires on dry grass."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Form Two Parallel Lines with 10-Foot Clearance",
          "text": "Arrange remaining guests into two parallel lines leaving a wide 10-12 foot corridor so sparks cannot touch wedding dresses, hairspray, or veils."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Execute the Domino Lighting Wave",
          "text": "Assign 1 lighting captain with a windproof butane torch per 8-10 guests. Light the first sparkler in each pod, then guests touch sparkler-to-sparkler in a fast 20-second wave."
        },
        {
          "@type": "HowToStep",
          "name": "Step 5: Stroll, Dip, Kiss, and Immediate Quench",
          "text": "The couple strolls slowly through the sparkling tunnel, stopping midway for photos. Once complete, guests immediately plunge burning tips into sand buckets."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What size sparklers are best for a wedding send-off: 10, 20, or 36 inches?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "20-inch sparklers (burning 90–120 seconds) are the gold standard for weddings with 50–150 guests, providing ample time for the lighting wave and a relaxed walk. 36-inch sparklers (burning 210–240 seconds / 3.5–4 mins) are ideal for large weddings of 150+ guests, long driveways, or multiple photo dips. 10-inch sparklers burn for only 30–45 seconds and are NOT recommended for send-offs because the first sparklers burn out before the last ones are lit."
          }
        },
        {
          "@type": "Question",
          "name": "Why do wedding venues require smokeless wire-core sparklers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Smokeless sparklers are made with a metal steel wire core rather than wooden or bamboo sticks. Wooden sticks create heavy choking gray smoke that obscures the couple and ruins photography, drop burning charcoal embers onto bridal gowns, and trigger indoor/outdoor smoke alarms. Wire-core sparklers burn virtually smokeless with zero dropping ash."
          }
        },
        {
          "@type": "Question",
          "name": "How many sparklers should you order per wedding guest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For 20-inch and 36-inch sparklers, 1 sparkler per participating guest plus a 10-15% buffer for testing and lighting leads is standard. If using 10-inch sparklers or hosting an energetic crowd where guests want to light a second round, plan 2 sparklers per guest."
          }
        },
        {
          "@type": "Question",
          "name": "How do you light 100+ sparklers quickly at the same time?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never use standard matches or cigarette lighters. Assign 4 to 6 'lighting captains' equipped with windproof butane culinary torches. Captains ignite 1 sparkler per pod of 8-10 guests, and guests immediately touch their sparklers tip-to-tip in a domino effect. A 100-person tunnel can be fully illuminated in under 20 seconds using this relay method."
          }
        },
        {
          "@type": "Question",
          "name": "What is late-night guest attrition and how does it affect sparkler counts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For late-night exits occurring after 10:30 PM, typically 25% to 35% of total guests (especially elderly relatives, parents with young children, and designated drivers) leave before the grand finale. Calculating based on full RSVP headcount leads to wasted sparklers. Alternatively, host a 'staged / fake send-off' right after the cake cutting (around 9:00 PM) to capture 100% of your guests."
          }
        },
        {
          "@type": "Question",
          "name": "How do you safely extinguish and dispose of hot sparklers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Set up galvanized metal buckets filled 3/4 with play sand or water at the start and end of the exit aisle. Instruct guests to insert the spent hot wires tip-down into the sand. Never discard hot sparkler wires into plastic garbage cans, cardboard boxes, or dry grass, as spent wires remain hot enough to cause fires for several minutes."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Sparkler Send-Off Calculator — Free Printable 'Let Love Sparkle' Signs & Safety Guide"
	description="Calculate exact wedding sparklers (20\" vs 36\" burn time photo windows), butane torch stations & metal sand buckets. Includes free 1-click printable 'Let Love Sparkle' bar signs & safety cards."
	schema={schema}
>
	<!-- Include html2canvas for instant image capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Sparkler Send-Off Sizer" category="guests-logistics" />
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center; position: relative;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.25rem 1rem 1.75rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">✨</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Free • Smokeless Wire-Core Math • Printable Signs & Safety Cards Included</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(28px, 4.5vw, 50px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Wedding Sparkler <span class="accent-italic" style="color: #b45309; text-shadow: 1px 1px 0px #fef08a;">Send-Off Calculator & Signs</span>
				</h1>
				<p class="font-body" style="font-size: 1.125rem; color: var(--text-secondary); max-width: 820px; margin: 0 auto; line-height: 1.6;">
					Calculate the exact sparklers to order, 20" vs 36" burn-time photo runways, windproof butane torch captains, and metal sand quench buckets. Plus, customize and print ready-to-frame <strong>"Let Love Sparkle" 8×10 bar signs</strong> and <strong>safety bucket cards</strong>.
				</p>
			</div>
		</section>

		<!-- NEW: Visual Step-by-Step "How to Use This Tool" Guide -->
		<section class="hand-card" style="padding: 1.5rem; background: #fffdfa; margin-bottom: 2.5rem; border: 2px solid var(--fg-pencil);">
			<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
				<span style="font-size: 1.4rem;">💡</span>
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0;">
					How to Use This Calculator (In 3 Simple Steps)
				</h2>
			</div>

			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
				
				<!-- Guide Step 1 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">1</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Pick Guest Count & Exit Time</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Enter total invited guests and select your exit time. If your exit is late at night (10:30 PM+), ~30% of guests leave early, so the tool automatically prevents ordering wasted sparklers!
					</p>
				</div>

				<!-- Guide Step 2 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">2</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Select 20" or 36" Sparklers</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Choose <strong>20-inch (2-min burn)</strong> for standard weddings (40–150 guests) or <strong>36-inch (4-min burn)</strong> for large crowds (150+ guests) and multiple photo dips. Avoid 10-inch sparklers (they burn out in 35s!).
					</p>
				</div>

				<!-- Guide Step 3 -->
				<div style="background: #ffffff; border: 1.5px solid #fed7aa; border-radius: 8px; padding: 1rem;">
					<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
						<span style="background: #b45309; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">3</span>
						<strong style="color: #9a3412; font-size: 0.95rem;">Get Order List & Print Signs</strong>
					</div>
					<p style="font-size: 0.85rem; color: #475569; margin: 0; line-height: 1.5;">
						Get your exact sparkler pack count, butane torches, and metal sand buckets. Then enter your names to print your customized <strong>8×10 framed bar sign and safety cards</strong> in 1 click!
					</p>
				</div>

			</div>
		</section>

		<!-- Main Interactive Calculator Studio -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; margin-bottom: 3rem; align-items: start;">
			
			<!-- Left Column: Simplified Step-by-Step Inputs -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #ffffff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.35rem; margin: 0; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
						<span>⚙️</span> Send-Off Setup & Details
					</h2>
					<span style="font-size: 0.78rem; font-weight: 700; background: #fef08a; border: 1.5px solid var(--fg-pencil); padding: 2px 8px; border-radius: 4px;">
						Real-Time Math
					</span>
				</div>

				<!-- Step 1: Total Invited Guests Headcount -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem;">
						<label class="form-label" for="slider-guests" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem;">
							1. Total Invited / RSVP Guests:
						</label>
						<span id="label-guest-count" style="font-weight: 800; font-size: 1.15rem; color: #b45309; background: #fef3c7; border: 1.5px solid #d97706; padding: 2px 10px; border-radius: 6px;">
							120 guests
						</span>
					</div>
					<input type="range" id="slider-guests" min="15" max="400" value="120" step="5" style="width: 100%; accent-color: #b45309; cursor: pointer;" />
					<div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.2rem;">
						<span>15 (Intimate)</span>
						<span>75 (Small)</span>
						<span>120 (Avg)</span>
						<span>250 (Large)</span>
						<span>400+</span>
					</div>
				</div>

				<!-- Step 2: Send-Off Timing (Explained Simply) -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label class="form-label" for="select-timing-preset" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem; margin-bottom: 0.3rem; display: block;">
						2. When Will Your Send-Off Take Place?
					</label>
					<select id="select-timing-preset" class="form-input" style="cursor: pointer; font-weight: 600; background: #f8fafc; border: 2px solid var(--fg-pencil); width: 100%; padding: 0.6rem; border-radius: 6px; font-size: 0.9rem;">
						<option value="late-night" selected>🌙 Late-Night Grand Exit (10:30 PM+) — ~70% Guests Stay</option>
						<option value="staged">🍰 Early "Staged" Send-Off (9:00 PM post-cake) — ~95% Guests Stay</option>
						<option value="ceremony">🌅 Sunset / Ceremony Exit (Dusk) — 100% Guests Present</option>
						<option value="custom">🎛️ Custom Guest Percentage</option>
					</select>
					
					<div id="custom-retention-box" style="display: none; margin-top: 0.75rem; padding: 0.75rem; background: #fffbeb; border: 1.5px dashed #d97706; border-radius: 6px;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
							<label style="font-size: 0.85rem; font-weight: 700; color: #92400e;">Custom Attendance Rate:</label>
							<span id="label-retention-val" style="font-weight: 800; color: #92400e;">70%</span>
						</div>
						<input type="range" id="slider-retention" min="40" max="100" value="70" step="5" style="width: 100%; accent-color: #d97706;" />
					</div>

					<div style="background: #f8fafc; border-left: 3px solid #b45309; padding: 0.5rem 0.75rem; margin-top: 0.5rem; border-radius: 0 4px 4px 0;">
						<p style="font-size: 0.82rem; color: #475569; margin: 0; line-height: 1.45;">
							👥 <strong>Real Attendance:</strong> <strong id="retention-summary-text" style="color: #b45309;">84 guests</strong> estimated at exit (<span id="attrition-summary-text">36 guests</span> depart early due to babysitters, fatigue, or travel).
						</p>
					</div>
				</div>

				<!-- Step 3: Sparkler Length & Burn Time Selector -->
				<div class="form-group" style="margin-bottom: 1.5rem;">
					<label class="form-label" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.95rem; margin-bottom: 0.4rem; display: block;">
						3. Choose Sparkler Size:
					</label>
					
					<div class="sparkler-size-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem;">
						<!-- 20-inch option (Default Gold Standard) -->
						<label class="size-pill active" id="card-len-20" style="border: 2px solid #b45309; background: #fffbeb; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative; box-shadow: 0 0 0 1px #b45309;">
							<input type="radio" name="sparkler-len" value="20" checked style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 800; color: #92400e; background: #fef08a; border: 1px solid #d97706; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">⭐ Best Pick</span>
							<strong style="display: block; font-size: 0.9rem; color: #92400e; line-height: 1.15;">20-Inch</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #b45309; margin-top: 1px;">2 Min Burn</span>
							<span style="display: block; font-size: 0.67rem; color: #78350f; margin-top: 1px;">40–150 Guests</span>
						</label>

						<!-- 36-inch option (Grand Exits) -->
						<label class="size-pill" id="card-len-36" style="border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative;">
							<input type="radio" name="sparkler-len" value="36" style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 700; color: #0369a1; background: #e0f2fe; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">👑 Grand</span>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil); line-height: 1.15;">36-Inch</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #0369a1; margin-top: 1px;">4 Min Burn</span>
							<span style="display: block; font-size: 0.67rem; color: #64748b; margin-top: 1px;">150+ Guests</span>
						</label>

						<!-- 10-inch option (Small/Risky) -->
						<label class="size-pill" id="card-len-10" style="border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 8px; padding: 0.55rem 0.35rem; text-align: center; cursor: pointer; transition: all 0.15s ease; position: relative;">
							<input type="radio" name="sparkler-len" value="10" style="position: absolute; opacity: 0; width: 0; height: 0;" />
							<span style="display: inline-block; font-size: 0.66rem; font-weight: 700; color: #991b1b; background: #fee2e2; border-radius: 4px; padding: 1px 4px; margin-bottom: 0.2rem;">⚠️ Micro Only</span>
							<strong style="display: block; font-size: 0.9rem; color: var(--fg-pencil); line-height: 1.15;">10-Inch</strong>
							<span style="display: block; font-size: 0.74rem; font-weight: 700; color: #dc2626; margin-top: 1px;">35s Burn</span>
							<span style="display: block; font-size: 0.67rem; color: #64748b; margin-top: 1px;">&lt;25 Guests</span>
						</label>
					</div>
				</div>

				<!-- Sparklers Per Guest & Buffer Options -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem;">
					<div>
						<label class="form-label" for="select-sparklers-per-guest" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.85rem;">
							Sparklers per Guest:
						</label>
						<select id="select-sparklers-per-guest" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<option value="1" selected>1 Sparkler (Standard)</option>
							<option value="2">2 Sparklers (Double Spark / Backup)</option>
						</select>
					</div>
					<div>
						<label class="form-label" for="select-buffer-pct" style="font-weight: 700; color: var(--fg-pencil); font-size: 0.85rem;">
							Safety Buffer:
						</label>
						<select id="select-buffer-pct" class="form-input" style="cursor: pointer; font-weight: 600; width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<option value="15" selected>+15% Buffer (Recommended)</option>
							<option value="10">+10% Buffer</option>
							<option value="20">+20% Extra Buffer</option>
							<option value="0">0% Exact Only</option>
						</select>
					</div>
				</div>

				<!-- Step 4: Couple Names & Target Send-Off Time (Personalizes Signs!) -->
				<div style="border-top: 1.5px dashed #cbd5e1; padding-top: 1.25rem;">
					<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
						<h3 class="font-heading" style="font-size: 1.05rem; margin: 0; color: var(--fg-pencil);">
							4. Personalize Printable Signs & Timeline:
						</h3>
						<span style="font-size: 0.72rem; color: #166534; background: #dcfce7; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Updates Signs Below ⬇️</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="input-couple-names" style="font-size: 0.82rem; font-weight: 600;">Couple Names:</label>
							<input type="text" id="input-couple-names" class="form-input" value="Emma & Liam" placeholder="e.g. Jessica & Alex" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						</div>
						<div>
							<label class="form-label" for="input-exit-time" style="font-size: 0.82rem; font-weight: 600;">Target Exit Time:</label>
							<input type="text" id="input-exit-time" class="form-input" value="10:45 PM" placeholder="e.g. 10:45 PM" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Live Results & Equipment Blueprint -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Metric Hero Card -->
				<div class="hand-card shadow-hard" style="padding: clamp(1.25rem, 3vw, 2rem); background: #fffdfa; border: 3px solid var(--fg-pencil); position: relative;">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
						<div>
							<span style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #92400e;">
								Exact Order Recommendation
							</span>
							<h3 class="font-heading" style="font-size: 1.35rem; margin: 0.2rem 0 0; color: var(--fg-pencil);">
								Sparklers to Order
							</h3>
						</div>
						<div id="badge-pack-size" style="background: #fef08a; border: 2px solid var(--fg-pencil); padding: 4px 10px; border-radius: 6px; font-weight: 800; font-size: 0.85rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
							~12 Packs (8-ct)
						</div>
					</div>

					<div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.5rem;">
						<span id="res-total-sparklers" style="font-size: clamp(3rem, 6vw, 4.2rem); font-weight: 900; color: #b45309; line-height: 1; font-family: var(--font-heading);">
							97
						</span>
						<span style="font-size: 1.25rem; font-weight: 700; color: var(--fg-pencil);">Total Sparklers</span>
					</div>

