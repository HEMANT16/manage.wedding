---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Dress Alterations Cost Estimator",
      "url": "https://manage.wedding/dress-alterations-estimator",
      "description": "Free wedding dress alterations cost estimator. Calculate exact pricing for hemming, bustle points, taking in the bodice, bra cups, custom sleeves, and rush fees. Export to Word, PDF, or Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much do wedding dress alterations cost on average?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The average wedding dress alterations cost ranges from $300 to $800 for standard tailoring (hemming, taking in the bodice, and adding a 3-point bustle). Complex gowns with multiple tulle layers, beaded lace appliques, or rush deadlines can reach $900 to $1,400."
          }
        },
        {
          "@type": "Question",
          "name": "Why is hemming a lace wedding dress so expensive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If a gown has a scalloped lace border or horsehair braid along the bottom, the seamstress cannot simply cut off the excess fabric. They must unpick the delicate lace appliques by hand, hem each underlying layer of lining and tulle, and hand-sew the lace border back onto the shortened skirt."
          }
        },
        {
          "@type": "Question",
          "name": "When should I schedule my wedding dress alterations fittings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan for 3 fitting appointments: 1) First Fitting: 8 to 10 weeks before the wedding (hemming, bodice pinning, bustle selection); 2) Second Fitting: 4 to 5 weeks before (checking pinned adjustments and fine-tuning); 3) Final Pickup: 10 to 14 days before the wedding (final try-on and professional steaming)."
          }
        },
        {
          "@type": "Question",
          "name": "What must I bring to my first bridal alteration appointment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You MUST bring the exact bridal shoes/heels you will wear down the aisle (to measure the floor hem length) and the exact undergarments, bra, or shapewear you plan to wear (to accurately pin the bust and waist)."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Estimate Wedding Dress Alteration Costs and Fittings",
      "description": "Step-by-step bridal guide to estimating alteration fees, scheduling 3 fitting milestones, and budgeting for hem, bodice, and bustle tailoring.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Assess Dress Construction & Skirt Layers",
          "text": "Identify hem complexity (plain edge, horsehair braid, or scalloped lace) and count the number of tulle and lining skirt layers."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Select Fit Adjustments & Bustle Points",
          "text": "Determine if the bodice needs taking in/letting out, straps shortened, bra cups sewn in, and choose a bustle style (1-point, 3-point, or ballroom)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Schedule 3 Fitting Appointments",
          "text": "Book your 1st fitting (8-10 weeks out), 2nd fitting (4-5 weeks out), and final pickup try-on (10-14 days before the wedding)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Bring Exact Wedding Shoes & Undergarments",
          "text": "Always wear the exact bridal heels and planned shapewear to every fitting to guarantee floor-length hem accuracy."
        },
        {
          "@type": "HowToStep",
          "name": "Step 5: Export Itemized Fitting Sheet",
          "text": "Export your tailored estimate to Word (.doc) or PDF to bring directly to prospective bridal seamstresses."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Dress Alterations Cost Estimator (Free Price Calculator & Word Export) | Manage.Wedding"
	description="Calculate exact wedding dress alteration costs. Estimate hemming, bustling, taking in the bodice, bra cups, and rush fees with instant Word and PDF exports."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Dress Alterations Cost Estimator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Estimate real-world tailoring prices for hemming, bustling, bodice taking-in, bra cups, and fabric complexity. Export your official <strong>Alterations Checklist</strong> to <strong>Word (.doc)</strong> or <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> How to Use This Estimator in 3 Easy Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Select Skirt & Hem Style
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Choose your skirt edge (plain, horsehair braid, or scalloped lace) and enter how many extra tulle/lining layers need hemming.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Check Fit & Bustle Details
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Check the boxes for bodice taking-in, strap shortening, bra cups, and choose your train bustle style (1-point, 3-point, or ballroom).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Export Your Fitting Sheet
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Click <strong>"📝 Export Word (.doc)"</strong> or <strong>"🖨️ Export PDF"</strong> to print an itemized checklist to bring directly to your seamstress.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="alterations-calc-grid">
			
			<!-- Left Column: Itemized Tailoring Services -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div style="width: 100%;">
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							✂️ Select Alteration Services
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Check all tailoring adjustments needed on your gown
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Currency:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="$" selected>$ (USD/CAD/AUD)</option>
							<option value="£">£ (GBP)</option>
							<option value="€">€ (EUR)</option>
							<option value="₹">₹ (INR)</option>
						</select>
					</div>
				</div>

				<form id="alterations-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Hemming & Skirt Layers -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							1. Skirt Hemming & Construction
						</h3>
						<div style="display: flex; flex-direction: column; gap: 0.5rem;">
							<div>
								<label for="select-hem-type" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
									Hem Style & Edge Complexity
								</label>
								<select id="select-hem-type" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.9rem;">
									<option value="0">No Hemming Needed ($0)</option>
									<option value="140" selected>Plain Clean Hem (Crepe, Satin, Chiffon) ($140)</option>
									<option value="210">Horsehair Braid / Crinoline Edge Hem ($210)</option>
									<option value="320">Scalloped Lace Border (Hand-detached & sewn back) ($320)</option>
								</select>
							</div>

							<div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-paper); padding: 0.5rem 0.75rem; border: 1px dashed var(--fg-pencil); border-radius: 4px;">
								<div>
									<label for="input-skirt-layers" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block;">Extra Skirt Underlayers (Tulle/Lining)</label>
									<span style="font-size: 0.75rem; color: var(--text-secondary);">$40 per additional layer beyond outer shell</span>
								</div>
								<div style="display: flex; align-items: center; gap: 0.3rem;">
									<input type="number" id="input-skirt-layers" value="2" min="0" max="10" style="width: 50px; padding: 0.3rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center; background: #fff;">
									<span style="font-size: 0.85rem;">layers</span>
								</div>
							</div>
						</div>
					</div>

					<!-- 2. Bodice, Straps & Bra Structure -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--accent-blue); margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							2. Bodice, Straps & Fit Tailoring
						</h3>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-take-in-bodice" value="120" checked class="alt-checkbox">
								<span>Take In / Let Out Bodice ($120)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-shorten-straps" value="50" checked class="alt-checkbox">
								<span>Shorten Straps / Sleeves ($50)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-sew-in-cups" value="40" checked class="alt-checkbox">
								<span>Sew-In Molded Bra Cups ($40)</span>
							</label>

							<label class="service-checkbox-label">
								<input type="checkbox" id="chk-reshape-neckline" value="130" class="alt-checkbox">
								<span>Reshape Neckline / Back ($130)</span>
							</label>

							<label class="service-checkbox-label" style="grid-column: span 2;">
								<input type="checkbox" id="chk-corset-back" value="180" class="alt-checkbox">
								<span>Convert Zipper to Corset Lace-Up Back ($180)</span>
							</label>
						</div>
					</div>

					<!-- 3. Bustle & Train Management -->
					<div>
						<h3 class="font-heading" style="font-size: 1.15rem; color: #16a34a; margin-bottom: 0.6rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.2rem;">
							3. Train Bustle Style & Points
						</h3>
						<div>
							<label for="select-bustle-style" class="font-body" style="font-size: 0.85rem; font-weight: bold; display: block; margin-bottom: 0.2rem;">
								Bustle Style & Pickup Points
							</label>
							<select id="select-bustle-style" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.9rem;">
								<option value="0">No Bustle / Short Train ($0)</option>
								<option value="75">1-Point Over-Bustle (American Style) ($75)</option>
								<option value="135" selected>3 to 5-Point Under-Bustle (French Style) ($135)</option>
								<option value="220">7 to 10+ Point Royal Ballroom Bustle ($220)</option>
							</select>
						</div>
					</div>

					<!-- 4. Embellishments, Steaming & Rush Surcharge -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<label class="service-checkbox-label" style="background:#fff;">
								<input type="checkbox" id="chk-beading-repair" value="95" class="alt-checkbox">
								<span>Hand-Beading & Appliques ($95)</span>
							</label>

							<label class="service-checkbox-label" style="background:#fff;">
								<input type="checkbox" id="chk-steaming-press" value="85" checked class="alt-checkbox">
								<span>Professional Steaming ($85)</span>
							</label>
						</div>

						<div style="margin-top: 0.25rem;">
							<label for="select-timeline-rush" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.2rem;">
								Fitting Timeline & Rush Fee
							</label>
							<select id="select-timeline-rush" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
								<option value="1.0" selected>Standard Timeline (8 - 12 weeks out) (No Rush Fee)</option>
								<option value="1.2">Express Rush (4 - 6 weeks out) (+20% Surcharge)</option>
								<option value="1.45">Emergency Rush (Under 3 weeks out) (+45% Surcharge)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Line-Item Invoice -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Alteration Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								👗 Alterations Cost Estimate
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Itemized tailoring estimate for bridal salon fittings
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Estimated Range Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Estimated Tailoring Total</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">$570</strong>
						<span id="res-range-subtext" style="font-size: 0.8rem; color: var(--accent-red);">Typical Range: $485 - $655</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Line-Item Tailoring Breakdown
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">✂️ Skirt Hem & Extra Layers:</td>
									<td id="res-hem-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$220.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🪡 Bodice, Straps & Bra Cups:</td>
									<td id="res-bodice-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$210.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">👗 Train Bustle Construction:</td>
									<td id="res-bustle-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$135.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">✨ Embellishments & Steaming:</td>
									<td id="res-extras-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$85.00</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.4rem 0; font-weight: bold;">Rush Timeline Surcharge:</td>
									<td id="res-rush-total" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$0.00</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Cost Scale Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span>Budget ($250)</span>
							<span>Average ($600)</span>
							<span style="color: var(--accent-red);">Couture ($1,200+)</span>
						</div>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="cost-gauge-bar" style="width: 48%; height: 100%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Fitting Appointment Reminder Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						📌 The First Fitting Checklist:
					</strong>
					<ul class="font-body" style="font-size: 0.85rem; line-height: 1.5; padding-left: 1.1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Shoes:</strong> You MUST bring the exact heel height to hem the floor length.</li>
						<li><strong>Undergarments:</strong> Bring the exact bra, corset, or shapewear.</li>
						<li><strong>Accessories:</strong> Bring your veil to test the bustle drape together.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Official Dress Alterations Estimate</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Estimated Total: <span id="print-total"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Alteration Service Item</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 120px; text-align: right;">Estimated Cost</th>
					</tr>
				</thead>
				<tbody id="print-alteration-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ BLUF Rule of Thumb</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Quick Rule of Thumb: Bridal Alterations Cost & Turnaround Formulas
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
