		}
		.print-only {
			display: block !important;
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			background: #fff;
			color: #000;
			padding: 20px;
		}
	}
</style>

<script is:inline>
	let currencySymbol = '$';

	const currencySelect = document.getElementById('currency-select');
	const hemSelect = document.getElementById('select-hem-type');
	const skirtLayersInput = document.getElementById('input-skirt-layers');

	const chkTakeIn = document.getElementById('chk-take-in-bodice');
	const chkStraps = document.getElementById('chk-shorten-straps');
	const chkCups = document.getElementById('chk-sew-in-cups');
	const chkNeckline = document.getElementById('chk-reshape-neckline');
	const chkCorset = document.getElementById('chk-corset-back');

	const bustleSelect = document.getElementById('select-bustle-style');
	const chkBeading = document.getElementById('chk-beading-repair');
	const chkSteaming = document.getElementById('chk-steaming-press');
	const rushSelect = document.getElementById('select-timeline-rush');

	// Result Elements
	const resGrandTotal = document.getElementById('res-grand-total');
	const resRangeSubtext = document.getElementById('res-range-subtext');
	const resHemTotal = document.getElementById('res-hem-total');
	const resBodiceTotal = document.getElementById('res-bodice-total');
	const resBustleTotal = document.getElementById('res-bustle-total');
	const resExtrasTotal = document.getElementById('res-extras-total');
	const resRushTotal = document.getElementById('res-rush-total');
	const costGaugeBar = document.getElementById('cost-gauge-bar');

	function formatMoney(amount) {
		return `${currencySymbol}${Math.round(amount).toLocaleString('en-US')}`;
	}

	function calculateAlterations() {
		currencySymbol = currencySelect.value;
		const rushMultiplier = parseFloat(rushSelect.value) || 1.0;

		// 1. Hemming
		const baseHem = parseFloat(hemSelect.value) || 0;
		const extraLayers = parseInt(skirtLayersInput.value) || 0;
		const layersCost = baseHem > 0 ? (extraLayers * 40) : 0;
		const hemSubtotal = baseHem + layersCost;

		// 2. Bodice
		let bodiceSubtotal = 0;
		if (chkTakeIn.checked) bodiceSubtotal += parseFloat(chkTakeIn.value);
		if (chkStraps.checked) bodiceSubtotal += parseFloat(chkStraps.value);
		if (chkCups.checked) bodiceSubtotal += parseFloat(chkCups.value);
		if (chkNeckline.checked) bodiceSubtotal += parseFloat(chkNeckline.value);
		if (chkCorset.checked) bodiceSubtotal += parseFloat(chkCorset.value);

		// 3. Bustle
		const bustleSubtotal = parseFloat(bustleSelect.value) || 0;

		// 4. Extras
		let extrasSubtotal = 0;
		if (chkBeading.checked) extrasSubtotal += parseFloat(chkBeading.value);
		if (chkSteaming.checked) extrasSubtotal += parseFloat(chkSteaming.value);

		// Pre-rush subtotal
		const preRushTotal = hemSubtotal + bodiceSubtotal + bustleSubtotal + extrasSubtotal;
		const finalTotal = preRushTotal * rushMultiplier;
		const rushFeeAmount = finalTotal - preRushTotal;

		// Update UI
		resGrandTotal.textContent = formatMoney(finalTotal);
		const lowRange = Math.round(finalTotal * 0.88);
		const highRange = Math.round(finalTotal * 1.15);
		resRangeSubtext.textContent = `Typical Range: ${formatMoney(lowRange)} - ${formatMoney(highRange)}`;

		resHemTotal.textContent = formatMoney(hemSubtotal);
		resBodiceTotal.textContent = formatMoney(bodiceSubtotal);
		resBustleTotal.textContent = formatMoney(bustleSubtotal);
		resExtrasTotal.textContent = formatMoney(extrasSubtotal);
		resRushTotal.textContent = formatMoney(rushFeeAmount);

		// Gauge
		const gaugePct = Math.min(100, Math.max(10, Math.round((finalTotal / 1200) * 100)));
		costGaugeBar.style.width = `${gaugePct}%`;
	}

	// Listeners
	document.querySelectorAll('.alt-checkbox, #input-skirt-layers').forEach(el => {
		el.addEventListener('input', calculateAlterations);
		el.addEventListener('change', calculateAlterations);
	});
	[hemSelect, bustleSelect, rushSelect, currencySelect].forEach(el => {
		el.addEventListener('change', calculateAlterations);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let rows = '';
		if (parseFloat(hemSelect.value) > 0) {
			rows += `<tr><td>Skirt Hemming (${hemSelect.options[hemSelect.selectedIndex].text.split('(')[0]})</td><td style="text-align:right;">${resHemTotal.textContent}</td></tr>`;
		}
		if (chkTakeIn.checked) rows += `<tr><td>Take In / Let Out Bodice Side Seams</td><td style="text-align:right;">${formatMoney(chkTakeIn.value)}</td></tr>`;
		if (chkStraps.checked) rows += `<tr><td>Shorten Straps / Sleeves</td><td style="text-align:right;">${formatMoney(chkStraps.value)}</td></tr>`;
		if (chkCups.checked) rows += `<tr><td>Sew-In Molded Bra Cups</td><td style="text-align:right;">${formatMoney(chkCups.value)}</td></tr>`;
		if (chkNeckline.checked) rows += `<tr><td>Reshape Neckline / Back</td><td style="text-align:right;">${formatMoney(chkNeckline.value)}</td></tr>`;
		if (chkCorset.checked) rows += `<tr><td>Convert to Corset Lace-Up Back</td><td style="text-align:right;">${formatMoney(chkCorset.value)}</td></tr>`;
		if (parseFloat(bustleSelect.value) > 0) {
			rows += `<tr><td>Train Bustle (${bustleSelect.options[bustleSelect.selectedIndex].text.split('(')[0]})</td><td style="text-align:right;">${resBustleTotal.textContent}</td></tr>`;
		}
		if (chkBeading.checked) rows += `<tr><td>Hand Beading & Applique Repair</td><td style="text-align:right;">${formatMoney(chkBeading.value)}</td></tr>`;
		if (chkSteaming.checked) rows += `<tr><td>Professional Steaming & Pressing</td><td style="text-align:right;">${formatMoney(chkSteaming.value)}</td></tr>`;
		if (parseFloat(rushSelect.value) > 1.0) {
			rows += `<tr><td>Rush Timeline Surcharge (${rushSelect.options[rushSelect.selectedIndex].text.split('(')[0]})</td><td style="text-align:right;">${resRushTotal.textContent}</td></tr>`;
		}

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Wedding Dress Alterations Proposal</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Official Dress Alterations Estimate</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Estimated Tailoring Total: <strong>${resGrandTotal.textContent}</strong> (${resRangeSubtext.textContent})</p>
				
				<h3>Selected Tailoring Services:</h3>
				<table>
					<thead>
						<tr><th>Service Description</th><th style="text-align:right;">Estimated Price</th></tr>
					</thead>
					<tbody>
						${rows}
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;"><td>Total Alterations Estimate</td><td style="text-align:right; color:#b91c1c;">${resGrandTotal.textContent}</td></tr>
					</tbody>
				</table>

				<h3 style="margin-top:20px;">Fitting Appointment Reminders:</h3>
				<p>• Bring exact wedding shoes/heels to establish floor hem.</p>
				<p>• Bring exact bridal shapewear and bra cups.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Dress_Alterations_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString();
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-alteration-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Skirt Hemming & Extra Layers</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resHemTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Bodice, Straps & Bra Cups</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBodiceTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Train Bustle Construction</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBustleTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Embellishments & Steaming</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Rush Timeline Surcharge</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resRushTotal.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:14px;">Estimated Tailoring Total</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:14px;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Alteration Service Item,Estimated Cost\n";
		csv += `"Skirt Hemming & Extra Layers","${resHemTotal.textContent}"\n`;
		csv += `"Bodice, Straps & Bra Cups","${resBodiceTotal.textContent}"\n`;
		csv += `"Train Bustle Construction","${resBustleTotal.textContent}"\n`;
		csv += `"Embellishments & Steaming","${resExtrasTotal.textContent}"\n`;
		csv += `"Rush Timeline Surcharge","${resRushTotal.textContent}"\n`;
		csv += `"Estimated Tailoring Total","${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Dress_Alterations_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateAlterations();
</script>
