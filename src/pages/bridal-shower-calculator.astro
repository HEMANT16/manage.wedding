---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Bridal Shower Budget & Mimosa Bar Calculator",
      "url": "https://manage.wedding/bridal-shower-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calculate total bridal shower costs, split expenses evenly among bridesmaids/co-hosts, size food and mimosa bar champagne, and schedule gift opening time.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate and Split Bridal Shower Expenses",
      "description": "A step-by-step formula for maids of honor to budget food, champagne, decor, favors, and divide costs transparently across co-hosts.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Determine Guest Count & Co-Host Split",
          "text": "Tally the confirmed guest list and specify how many bridesmaids or family members are sharing the total financial cost."
        },
        {
          "@type": "HowToStep",
          "name": "Select Venue & Food Style",
          "text": "Choose between a backyard brunch, restaurant private dining, or rented venue with catering."
        },
        {
          "@type": "HowToStep",
          "name": "Size the Mimosa & Dessert Bar",
          "text": "Calculate champagne bottles (3–4 glasses per drinker over a 3-hour shower), juices, and dessert servings."
        },
        {
          "@type": "HowToStep",
          "name": "Share the Line-Item Cost Split",
          "text": "Export a transparent cost breakdown so every bridesmaid knows her exact share before purchasing supplies."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who traditionally pays for the bridal shower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditionally, the maid of honor and bridesmaids host and split the cost of the bridal shower, sometimes co-hosted or financially subsidized by the mother of the bride or mother of the groom."
          }
        },
        {
          "@type": "Question",
          "name": "How much does the average bridal shower cost per person?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A home or backyard bridal shower typically costs $25 to $45 per guest. A restaurant or private venue shower with full catering and open champagne averages $65 to $110 per guest."
          }
        },
        {
          "@type": "Question",
          "name": "How much champagne do I need for a bridal shower mimosa bar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a standard 3-hour bridal shower, plan for 3 mimosas per drinking guest. Since 1 standard 750ml champagne bottle makes approximately 5 to 6 mimosas (when mixed 50/50 with juice), divide drinking guests by 2 to determine the number of prosecco/champagne bottles needed."
          }
        },
        {
          "@type": "Question",
          "name": "How long should a bridal shower last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The sweet spot for a bridal shower is 2.5 to 3 hours. This allows 45 minutes for arrival and mimosas, 45 minutes for food and games, 45 minutes for gift opening, and 15 minutes for dessert and farewells."
          }
        }
      ]
    }
  ]
};
---

<Layout
	title="Bridal Shower Budget & Mimosa Bar Calculator — Split Costs Fairly"
	description="Calculate bridal shower food, mimosa bar champagne, favors, decor, and split expenses evenly among bridesmaids and co-hosts with instant PDF export."
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/budget" style="color: var(--text-secondary); text-decoration: none;">Budget & Parties</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Bridal Shower Calculator</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🧁</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Maid of Honor Budget & Mimosa Bar Planner</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Bridal Shower Budget & Cost Split Calculator
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Calculate total bridal shower expenses, size your <strong>Mimosa Bar & Catering quantities</strong>, and calculate the <strong>exact financial split per bridesmaid / co-host</strong>.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Inputs & Variables -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>👥</span> 1. Guests & Co-Host Split
				</h2>

				<!-- Headcount Grid -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-shower-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Total Shower Guests:</label>
						<input type="number" id="input-shower-guests" min="5" max="100" value="25" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="input-shower-hosts" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Co-Hosts Splitting Cost:</label>
						<input type="number" id="input-shower-hosts" min="1" max="12" value="5" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
				</div>

				<!-- Venue & Food Style -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🥂 2. Venue, Catering & Bar
				</h2>

				<!-- Venue Type -->
				<div style="margin-bottom: 1rem;">
					<label for="select-venue-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Venue Style:</label>
					<select id="select-venue-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="home" selected>🏡 Home / Backyard ($0 venue fee)</option>
						<option value="loft">🏛️ Rented Studio / Tea Room (~$350 flat rental)</option>
						<option value="restaurant">🍽️ Restaurant Private Room (~$45 / guest minimum)</option>
					</select>
				</div>

				<!-- Food Tier -->
				<div style="margin-bottom: 1rem;">
					<label for="select-food-tier" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Catering / Brunch Menu:</label>
					<select id="select-food-tier" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="light">🥐 Light Charcuterie, Pastries & Fruit ($18 / guest)</option>
						<option value="brunch" selected>🍳 Full Brunch Buffet (Quiche, bagels, waffles, bacon - $30 / guest)</option>
						<option value="plated">🥗 Plated 2-Course Lunch / Tea Sandwiches ($48 / guest)</option>
					</select>
				</div>

				<!-- Alcohol / Mimosa Bar -->
				<div style="margin-bottom: 1rem;">
					<label for="select-bar-package" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Drink & Mimosa Bar:</label>
					<select id="select-bar-package" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="full-mimosa" selected>🍾 DIY Mimosa Bar (Prosecco, 3 juices, berry garnishes - $14 / guest)</option>
						<option value="wine-beer">🍷 Wine, Prosecco & Non-Alcoholic Mocktails ($20 / guest)</option>
						<option value="dry">☕ Coffee, Tea & Artisan Lemonade Bar ($6 / guest)</option>
					</select>
				</div>

				<!-- Extras: Decor, Favors, Games -->
				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🎈 3. Cake, Decor & Favors
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="input-cake-cost" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Cake / Cupcakes ($):</label>
						<input type="number" id="input-cake-cost" min="0" max="500" value="85" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="input-decor-cost" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Balloons & Florals ($):</label>
						<input type="number" id="input-decor-cost" min="0" max="1000" value="150" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0.75rem;">
					<div>
						<label for="input-favors-pp" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Favors ($ / guest):</label>
						<input type="number" id="input-favors-pp" min="0" max="30" value="5" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
					<div>
						<label for="input-game-prizes" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Game Prizes ($ total):</label>
						<input type="number" id="input-game-prizes" min="0" max="300" value="60" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

			</div>

			<!-- Right Column: Budget Breakdown & Cost Split -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Financial Summary</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Bridal Shower Budget
						</h2>
					</div>
					<span id="badge-guest-cost" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">$59 / guest</span>
				</div>

				<!-- Big Number Highlights -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Total Shower Cost</span>
						<strong id="stat-total-budget" style="font-size: 2rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">$1,470</strong>
						<span id="stat-total-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(All categories combined)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Per Co-Host Share</span>
						<strong id="stat-host-share" style="font-size: 2rem; font-weight: 900; color: #1e40af; line-height: 1.1;">$294</strong>
						<span id="stat-host-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">Split across 5 bridesmaids</span>
					</div>
				</div>

				<!-- Mimosa Bar Shopping List Box -->
				<div style="background: #eff6ff; border: 1.5px solid #1e40af; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #1e40af; display: block; margin-bottom: 0.35rem;">🍾 Mimosa Bar Sizer (for 25 guests):</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #1e3a8a;">
						<div>• <strong id="stat-champagne-bottles">13 Bottles</strong> Prosecco</div>
						<div>• <strong id="stat-juice-carafes">4 Carafes</strong> Juice</div>
						<div>• <strong id="stat-berry-tubs">3 Tubs</strong> Fresh Berries</div>
						<div>• <strong id="stat-gift-time">~30 Mins</strong> Gift Opening</div>
					</div>
				</div>

				<!-- Line Item Breakdown -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🏛️ Venue / Space:</span>
						<strong id="stat-line-venue" style="color: var(--fg-pencil);">$0</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🥐 Food & Catering:</span>
						<strong id="stat-line-food" style="color: var(--fg-pencil);">$750</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🍾 Mimosa / Drinks:</span>
						<strong id="stat-line-bar" style="color: var(--fg-pencil);">$350</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🎈 Decor, Cake & Prizes:</span>
						<strong id="stat-line-decor" style="color: var(--fg-pencil);">$295</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">🎁 Guest Favors:</span>
						<strong id="stat-line-favors" style="color: var(--fg-pencil);">$125</strong>
					</div>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Print Cost Split (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Export Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Section: Shower Planning Timeline -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem;">
				🕒 The Ideal 3-Hour Bridal Shower Timeline
			</h2>
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; font-size: 0.88rem;">
				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						11:00 AM – Arrival & Mimosas
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						Guests arrive, grab a glass from the DIY Mimosa bar, pin their clothespins (for the "Don't Say Wedding" game), and mingle with the bride.
					</p>
				</div>

				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						11:45 AM – Brunch & Trivia Game
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						Guests serve themselves brunch buffet while playing "He Said / She Said" or Couple Trivia with small gift card prizes.
					</p>
				</div>

				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						12:30 PM – Gift Opening & Gift Bingo
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						Hand out Gift Bingo cards so guests mark off blender, towels, and lingerie as the bride opens gifts. Keeps the energy high!
					</p>
				</div>

				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						1:30 PM – Cake, Coffee & Favors
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						Cut the cake, toast the bride with espresso or champagne, take group photos, and hand out guest favors at departure.
					</p>
				</div>
			</div>
		</section>

		<!-- Frequently Asked Questions -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1.25rem;">
				❓ Frequently Asked Questions: Bridal Shower Planning
			</h2>
			
			<div style="display: flex; flex-direction: column; gap: 1rem;">
				<div style="border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.85rem;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						How can bridesmaids keep bridal shower costs affordable?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						Hosting at a bridesmaid's or family home eliminates $300–$800 venue fees. Assembling your own charcuterie boards and buying bulk prosecco from Costco or Trader Joe's cuts catering costs by over 60%.
					</p>
				</div>

				<div style="border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.85rem;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						Should the bride pay for anything at her shower?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						No. As the guest of honor, the bride should never be asked to pay for food, drinks, or venue fees at her bridal shower.
					</p>
				</div>

				<div>
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						How many game prizes should you buy?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						Plan for <strong>3 to 5 prizes</strong> valued at $15 to $25 each (e.g., luxury hand lotion, scented candles, Starbucks gift cards, or a bottle of rosé).
					</p>
				</div>
			</div>
		</section>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/bridal-shower-calculator" category="budget" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-shower-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Bridal Shower Budget & Co-Host Cost Split</h1>
				<p id="print-shower-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Maid of Honor Planning Sheet | Generated by Manage.Wedding</p>
			</div>
			<div id="print-shower-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	// Elements
	const inputShowerGuests = document.getElementById('input-shower-guests');
	const inputShowerHosts = document.getElementById('input-shower-hosts');
	const selectVenueType = document.getElementById('select-venue-type');
	const selectFoodTier = document.getElementById('select-food-tier');
	const selectBarPackage = document.getElementById('select-bar-package');
	const inputCakeCost = document.getElementById('input-cake-cost');
	const inputDecorCost = document.getElementById('input-decor-cost');
	const inputFavorsPp = document.getElementById('input-favors-pp');
	const inputGamePrizes = document.getElementById('input-game-prizes');

	const statTotalBudget = document.getElementById('stat-total-budget');
	const statHostShare = document.getElementById('stat-host-share');
	const statHostSub = document.getElementById('stat-host-sub');
	const badgeGuestCost = document.getElementById('badge-guest-cost');

	const statLineVenue = document.getElementById('stat-line-venue');
	const statLineFood = document.getElementById('stat-line-food');
	const statLineBar = document.getElementById('stat-line-bar');
	const statLineDecor = document.getElementById('stat-line-decor');
	const statLineFavors = document.getElementById('stat-line-favors');

	const statChampagneBottles = document.getElementById('stat-champagne-bottles');
	const statJuiceCarafes = document.getElementById('stat-juice-carafes');
	const statBerryTubs = document.getElementById('stat-berry-tubs');
	const statGiftTime = document.getElementById('stat-gift-time');

	function calculateShower() {
		const guests = Math.max(1, parseInt(inputShowerGuests.value, 10) || 25);
		const hosts = Math.max(1, parseInt(inputShowerHosts.value, 10) || 5);

		// Venue
		let venueCost = 0;
		if (selectVenueType.value === 'loft') venueCost = 350;
		else if (selectVenueType.value === 'restaurant') venueCost = guests * 45;

		// Food
		let foodRate = 30;
		if (selectFoodTier.value === 'light') foodRate = 18;
		else if (selectFoodTier.value === 'plated') foodRate = 48;
		const foodCost = guests * foodRate;

		// Bar
		let barRate = 14;
		if (selectBarPackage.value === 'wine-beer') barRate = 20;
		else if (selectBarPackage.value === 'dry') barRate = 6;
		const barCost = guests * barRate;

		// Extras
		const cakeCost = parseFloat(inputCakeCost.value) || 0;
		const decorCost = parseFloat(inputDecorCost.value) || 0;
		const favorsCost = guests * (parseFloat(inputFavorsPp.value) || 0);
		const prizesCost = parseFloat(inputGamePrizes.value) || 0;

		const totalBudget = venueCost + foodCost + barCost + cakeCost + decorCost + favorsCost + prizesCost;
		const perHost = totalBudget / hosts;
		const perGuest = totalBudget / guests;

		statTotalBudget.textContent = `$${Math.round(totalBudget).toLocaleString()}`;
		statHostShare.textContent = `$${Math.round(perHost).toLocaleString()}`;
		statHostSub.textContent = `Split evenly across ${hosts} co-hosts`;
		badgeGuestCost.textContent = `$${Math.round(perGuest)} / guest`;

		statLineVenue.textContent = `$${Math.round(venueCost).toLocaleString()}`;
		statLineFood.textContent = `$${Math.round(foodCost).toLocaleString()}`;
		statLineBar.textContent = `$${Math.round(barCost).toLocaleString()}`;
		statLineDecor.textContent = `$${Math.round(cakeCost + decorCost + prizesCost).toLocaleString()}`;
		statLineFavors.textContent = `$${Math.round(favorsCost).toLocaleString()}`;

		// Mimosa Bar Quantities
		const champagneBottles = Math.ceil(guests / 2);
		const juiceCarafes = Math.max(2, Math.ceil(guests / 7));
		const berryTubs = Math.max(2, Math.ceil(guests / 9));
		const giftMins = Math.round(guests * 1.2);

		statChampagneBottles.textContent = `${champagneBottles} Bottles`;
		statJuiceCarafes.textContent = `${juiceCarafes} Carafes`;
		statBerryTubs.textContent = `${berryTubs} Tubs`;
		statGiftTime.textContent = `~${giftMins} Mins`;

		// Print Layout
		document.getElementById('print-shower-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Expense Category</th>
						<th style="padding:6pt;">Calculation Details</th>
						<th style="padding:6pt; text-align:right;">Category Total</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Venue Rental</td>
						<td style="padding:6pt;">${selectVenueType.options[selectVenueType.selectedIndex].text}</td>
						<td style="padding:6pt; text-align:right;">$${Math.round(venueCost)}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Catering / Brunch</td>
						<td style="padding:6pt;">${guests} guests @ $${foodRate}/person</td>
						<td style="padding:6pt; text-align:right;">$${Math.round(foodCost)}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Mimosa & Beverage Bar</td>
						<td style="padding:6pt;">${champagneBottles} prosecco bottles, juices & fruit garnishes</td>
						<td style="padding:6pt; text-align:right;">$${Math.round(barCost)}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Cake, Balloons & Game Prizes</td>
						<td style="padding:6pt;">Custom bakery cake, decor centerpieces & trivia prizes</td>
						<td style="padding:6pt; text-align:right;">$${Math.round(cakeCost + decorCost + prizesCost)}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Guest Favors</td>
						<td style="padding:6pt;">${guests} favors @ $${inputFavorsPp.value}/guest</td>
						<td style="padding:6pt; text-align:right;">$${Math.round(favorsCost)}</td>
					</tr>
					<tr style="background:#eff6ff; font-weight:bold; font-size:11pt; border-top:2pt solid #000;">
						<td style="padding:8pt;">TOTAL SHOWER BUDGET</td>
						<td style="padding:8pt;">${guests} Total Guests</td>
						<td style="padding:8pt; text-align:right; color:#b91c1c;">$${Math.round(totalBudget)}</td>
					</tr>
					<tr style="background:#f0fdf4; font-weight:bold; font-size:12pt; border-top:1.5pt solid #15803d;">
						<td style="padding:8pt; color:#15803d;">SHARE PER CO-HOST</td>
						<td style="padding:8pt; color:#15803d;">Split evenly across ${hosts} bridesmaids</td>
						<td style="padding:8pt; text-align:right; color:#15803d;">$${Math.round(perHost)} / host</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	// Listeners
	[inputShowerGuests, inputShowerHosts, selectVenueType, selectFoodTier, selectBarPackage, inputCakeCost, inputDecorCost, inputFavorsPp, inputGamePrizes].forEach(el => {
		el.addEventListener('input', calculateShower);
		el.addEventListener('change', calculateShower);
	});

	// Print PDF
	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateShower();
		window.print();
	});

	// Export Word
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateShower();
		const total = statTotalBudget.textContent;
		const perHost = statHostShare.textContent;
		const guests = inputShowerGuests.value;
		const hosts = inputShowerHosts.value;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Bridal Shower Budget</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Bridal Shower Budget & Cost Split</h1>
				<p><strong>Total Guests:</strong> ${guests} | <strong>Co-Hosts:</strong> ${hosts} | <strong>Total Budget:</strong> ${total} | <strong>Cost Per Bridesmaid:</strong> ${perHost}</p>
				<hr/>
				<h2>Mimosa Bar Shopping Checklist</h2>
				<p>• ${statChampagneBottles.textContent} of Prosecco / Champagne</p>
				<p>• ${statJuiceCarafes.textContent} of Orange, Peach & Guava juices</p>
				<p>• ${statBerryTubs.textContent} of fresh strawberries, raspberries & blueberries</p>
				<hr/>
				<p><em>Generated by Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Bridal-Shower-Budget-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateShower();
</script>
