---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Date Numerology & Marriage Compatibility Calculator",
      "url": "https://manage.wedding/wedding-date-numerology",
      "description": "Free wedding date numerology calculator. Calculate life path numbers, reduce calendar dates to single digits, and discover spiritual marriage compatibility scores.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What exactly is wedding date numerology?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wedding date numerology is the ancient practice of using the numbers in your chosen wedding date (month, day, and year) to uncover the energetic theme of your marriage. By adding these numbers together and reducing them to a single digit, you can discover the unique cosmic vibe and potential of your big day."
          }
        },
        {
          "@type": "Question",
          "name": "How does the calculator determine our marriage date compatibility score?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our calculator takes both partners' Life Path numbers (derived entirely from your birthdates) and your wedding date number. It uses a fun algorithmic formula that looks at how these distinct energetic vibrations interact, giving you an insightful compatibility score to reflect the harmony of your union."
          }
        },
        {
          "@type": "Question",
          "name": "Which number is luckiest for a wedding date?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There isn't one single 'luckiest' number, as it depends entirely on what you want out of your marriage! However, numbers like 2 (partnership and harmony) and 6 (love and family) are incredibly popular for weddings. Every number brings its own unique, positive blessings to your marriage date compatibility."
          }
        },
        {
          "@type": "Question",
          "name": "Can we change our wedding date if the numbers don't match?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely! If you're exploring different options and want a date that resonates perfectly with both of your Life Path numbers, you can run as many dates through our calculator as you like. Finding the right wedding date numerology is a fun way to intentionalize your planning process without any stress."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to be spiritual to use this calculator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not at all! While wedding date numerology has mystical roots, many couples simply use it as a fun, romantic way to add deeper meaning to their special day. It's a wonderful conversation starter and a sweet way to reflect on the strengths of your relationship."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate Your Wedding Date Numerology and Compatibility",
      "description": "Step-by-step guide to calculating partner life path numbers, reducing calendar dates, and interpreting marriage numerology vibrations.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Calculate Partner 1 Life Path",
          "text": "Add all digits in Partner 1's birthday (Month + Day + Year) and continuously sum them until reaching a single digit from 1 to 9 (or master 11/22/33)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Calculate Partner 2 Life Path",
          "text": "Sum all digits in Partner 2's birthday and reduce down to a single root number."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Calculate Wedding Date Vibration",
          "text": "Add all digits of your planned wedding date (e.g. October 14, 2026 = 1+0+1+4+2+0+2+6 = 16 = 1+6 = 7) to find your marriage archetype."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Cross-Reference Number Archetypes",
          "text": "Explore your union's core energetic theme (e.g. 1 Leadership, 2 Harmony, 4 Stability, 6 Family Love, 8 Abundance)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 5: Compare Alternative Dates",
          "text": "Test multiple potential wedding dates to find the one that spiritually aligns with your relationship goals."
        }
      ]
    }
  ]
};
---

