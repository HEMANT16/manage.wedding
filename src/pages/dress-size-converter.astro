---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Dress Size Converter & Bridal Measurement Calculator",
      "url": "https://manage.wedding/dress-size-converter",
      "description": "Free wedding dress size converter. Calculate your estimated US, UK, and EU bridal gown size from bust, waist, and hip measurements, discover flattering silhouettes, and export your measurement card.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why is my wedding dress size larger than my everyday street size?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bridal designers still use traditional European sizing charts established in the 1950s that have zero stretch. Over the decades, ready-to-wear everyday brands adopted vanity sizing, while bridal sizing remained fixed. Consequently, bridal gowns typically run 1 to 2 sizes larger than everyday street sizes."
          }
        },
        {
          "@type": "Question",
          "name": "Which measurement should I use when ordering a wedding dress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Always order the dress size that corresponds to your largest measurement (between bust, waist, and hips). It is simple and standard for a bridal seamstress to take a dress in, but extremely difficult or impossible to let a dress out due to strict seam allowances."
          }
        },
        {
          "@type": "Question",
          "name": "How do I measure myself accurately for a wedding dress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use a flexible fabric measuring tape. 1) Bust: around the fullest point wearing your planned wedding undergarments. 2) Waist: around your natural waist (1-2 inches above navel). 3) Hips: around the fullest part of your buttocks with feet together."
          }
        },
        {
          "@type": "Question",
          "name": "Do all bridal designers use the exact same sizing chart?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. European couture houses (like Pronovias) tend to run smaller through the ribcage and hips, while American brands (like David's Bridal) align closer to modern street sizes. Our tool provides standard universal conversions plus designer adjustments."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Measure and Convert Your Wedding Dress Size",
      "description": "Step-by-step instructions to measure bust, waist, and hips and convert everyday street sizes to US, UK, and European bridal gown sizes.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Take 3 Key Body Measurements",
          "text": "Using a flexible fabric measuring tape, measure your bust at the fullest point, natural waist (1-2 inches above navel), and hips at the widest point of the buttocks."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Map Measurements to Bridal Sizing Charts",
          "text": "Cross-reference your inch or centimeter measurements against standard bridal manufacturer dimensions."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Order to Your Largest Measurement",
          "text": "Select the size that accommodates your largest body metric. Bridal seamstresses easily take gowns in, but letting out is constrained by 0.5-inch seam allowances."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Factor in 1–2 Size Difference from Street Wear",
          "text": "Expect your bridal gown size number to be 1 to 2 sizes larger than your everyday jeans or dress street size."
        },
        {
          "@type": "HowToStep",
          "name": "Step 5: Export Your Fitting Measurement Card",
          "text": "Export your measurements to Word (.doc) or PDF to bring to your bridal salon stylist and seamstress."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Dress Size Converter (Free Bridal & Street Size Chart) | Manage.Wedding"
	description="Accurately convert your bust, waist, and hip measurements to standard US, UK, and EU bridal dress sizes. Compare designer sizing and export your measurement card."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Wedding Dress Size Converter
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Find your exact bridal gown size across US, UK, and EU standards. Compare street vs. bridal sizing, discover flattering silhouettes, and export your official <strong>Bridal Measurement Fitting Card</strong>.
				</p>
			</div>
		</section>

		<!-- Main Interactive Sizing Studio Workspace Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 380px 1fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="dress-calc-grid">
			
			<!-- Left Column: Input Form Card -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
						📏 Body Measurements
					</h2>
					
					<!-- Unit Switcher -->
					<div style="display: flex; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden;">
						<button type="button" id="unit-in" class="unit-toggle-btn active-unit">Inches (in)</button>
						<button type="button" id="unit-cm" class="unit-toggle-btn">cm</button>
					</div>
				</div>

				<form id="dress-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Bust -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-bust" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								1. Bust (<span class="unit-label">inches</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Fullest point over bra</span>
						</div>
						<input type="number" step="0.5" id="input-bust" value="36" min="20" max="180" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Waist -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-waist" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								2. Natural Waist (<span class="unit-label">inches</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Narrowest torso point</span>
						</div>
						<input type="number" step="0.5" id="input-waist" value="28" min="15" max="160" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Hips -->
					<div>
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
							<label for="input-hips" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								3. Hips (<span class="unit-label">inches</span>) *
							</label>
							<span style="font-size: 0.8rem; color: var(--text-secondary);">Widest buttocks point</span>
						</div>
						<input type="number" step="0.5" id="input-hips" value="39" min="20" max="200" required style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.1rem; background: var(--bg-paper);">
					</div>

					<!-- Designer Preference -->
					<div>
						<label for="input-designer" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							Bridal Designer Sizing Standard
						</label>
						<select id="input-designer" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
							<option value="standard" selected>Standard Industry Bridal (Average)</option>
							<option value="couture">European Couture (Pronovias / Galia Lahav - Runs Small)</option>
							<option value="davids">Modern US Ready-To-Wear (David's Bridal / BHLDN)</option>
							<option value="maggie">Maggie Sottero / Essense of Australia</option>
						</select>
					</div>

					<!-- Sample Presets -->
					<div style="margin-top: 0.5rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem;">
						<span class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							⚡ Quick Sample Measurements:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.3rem;">
							<button type="button" class="preset-meas-btn" data-b="34" data-w="26" data-h="37">Size 4/6 (34-26-37)</button>
							<button type="button" class="preset-meas-btn" data-b="37.5" data-w="29.5" data-h="40.5">Size 10/12 (37.5-29.5-40.5)</button>
							<button type="button" class="preset-meas-btn" data-b="43" data-w="35" data-h="46">Size 16/18 (43-35-46)</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Interactive Results, Sizing Badges, International Matrix & Silhouette Guide -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Sizing Results Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div>
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
								👗 Your Recommended Bridal Size
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								Calculated to fit your largest measurement
							</span>
						</div>

						<!-- Exports -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print
							</button>
						</div>
					</div>

					<!-- Side by Side Sizing Comparison Boxes -->
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
						
						<!-- Street Size -->
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Everyday Street Size</span>
							<strong id="res-street-size" class="font-heading" style="font-size: 2.4rem; color: var(--accent-blue); display: block; line-height: 1.2;">US 6</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Normal clothing</span>
						</div>

						<!-- Primary Bridal Size -->
						<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1rem; text-align: center; position: relative;">
							<span style="position: absolute; top: -10px; right: 10px; background: var(--accent-red); color: #fff; font-size: 0.7rem; font-weight: bold; padding: 2px 6px; border-radius: 10px;">ORDER THIS</span>
							<span class="font-body" style="font-size: 0.85rem; color: var(--accent-red); display: block; font-weight: bold;">Recommended Bridal Size</span>
							<strong id="res-bridal-size" class="font-heading" style="font-size: 2.4rem; color: var(--accent-red); display: block; line-height: 1.2;">US 10</strong>
							<span style="font-size: 0.75rem; color: var(--accent-red); font-weight: bold;">+2 sizes (Standard)</span>
						</div>

						<!-- Body Shape Archetype -->
						<div style="background: #f0fdf4; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: #166534; display: block;">Body Silhouette</span>
							<strong id="res-body-shape" class="font-heading" style="font-size: 1.3rem; color: #15803d; display: block; line-height: 1.3; margin: 0.4rem 0;">Hourglass</strong>
							<span id="res-shape-desc" style="font-size: 0.75rem; color: #166534; display: block;">Balanced bust & hips</span>
						</div>

					</div>

					<!-- Visual Comparison Bar -->
					<div style="margin-bottom: 1.5rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
							<span class="font-heading" style="font-size: 0.95rem; color: var(--fg-pencil);">Street vs. Bridal Sizing Shift</span>
							<span id="size-diff-note" class="font-body" style="font-size: 0.85rem; color: var(--accent-red); font-weight: bold;">+2 Sizes Larger</span>
						</div>
						<div style="display: flex; flex-direction: column; gap: 0.5rem;">
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="width: 80px; font-size: 0.85rem; font-weight: bold;">Street:</span>
								<div style="flex: 1; height: 18px; background: #e5e7eb; border-radius: 4px; border: 1px solid var(--fg-pencil); overflow: hidden;">
									<div id="bar-street" style="height: 100%; width: 30%; background: var(--accent-blue); transition: width 0.4s ease;"></div>
								</div>
								<span id="bar-label-street" style="width: 45px; font-size: 0.9rem; font-weight: bold;">US 6</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.75rem;">
								<span style="width: 80px; font-size: 0.85rem; font-weight: bold; color: var(--accent-red);">Bridal:</span>
								<div style="flex: 1; height: 18px; background: #e5e7eb; border-radius: 4px; border: 1px solid var(--fg-pencil); overflow: hidden;">
									<div id="bar-bridal" style="height: 100%; width: 45%; background: var(--accent-red); transition: width 0.4s ease;"></div>
								</div>
								<span id="bar-label-bridal" style="width: 45px; font-size: 0.9rem; font-weight: bold; color: var(--accent-red);">US 10</span>
							</div>
						</div>
					</div>

					<!-- International Conversion Matrix Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🌐 International Bridal Sizing Matrix
						</h4>
						<div style="overflow-x: auto;">
							<table style="width: 100%; border-collapse: collapse; text-align: center; font-size: 0.95rem; font-family: var(--font-body);">
								<thead>
									<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Region</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">US Bridal</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">UK Bridal</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">EU Bridal</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">AU / NZ</th>
										<th style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">IT (Italy)</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">Your Size</td>
										<td id="matrix-us" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">10</td>
										<td id="matrix-uk" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">12</td>
										<td id="matrix-eu" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">40</td>
										<td id="matrix-au" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">12</td>
										<td id="matrix-it" style="padding: 0.5rem; border: 1px solid var(--fg-pencil); font-weight: bold;">44</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>

					<!-- Measurement Anchor Alert & Alteration Guidance -->
					<div style="background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<strong class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.3rem;">
							✂️ Seamstress Ordering & Alteration Advisory:
						</strong>
						<p id="alteration-advice-text" class="font-body" style="font-size: 0.95rem; margin: 0; line-height: 1.5; color: var(--fg-pencil);">
							Your largest measurement is your hips (Size 10). Always order size 10 to ensure the dress zips comfortably. Your seamstress will easily take in the waist and bust during bridal fittings.
						</p>
					</div>

				</div>

				<!-- Flattering Gown Silhouette Recommendations Card -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
						<span>✨</span> Recommended Gown Silhouettes for Your Shape
					</h3>
					<div id="silhouette-cards-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
						<!-- Injected via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Official Bridal Fitting & Measurement Card</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Ready for Salon Stylist & Seamstress</p>
			</div>
			
			<table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 8px; text-align: left;">Measurement Area</th>
						<th style="border: 1px solid #ccc; padding: 8px; text-align: center;">Client Measurement</th>
						<th style="border: 1px solid #ccc; padding: 8px; text-align: center;">Corresponding Size</th>
					</tr>
				</thead>
				<tbody id="print-meas-body"></tbody>
			</table>

			<div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px; background: #fafafa;">
				<h3 style="margin: 0 0 8px 0; font-size: 15px;">Official Sizing Recommendations:</h3>
				<p style="margin: 4px 0;">• <strong>Recommended Bridal Size to Order:</strong> <span id="print-rec-size"></span></p>
				<p style="margin: 4px 0;">• <strong>Everyday Street Size:</strong> <span id="print-street-size"></span></p>
				<p style="margin: 4px 0;">• <strong>Body Archetype:</strong> <span id="print-body-shape"></span></p>
				<p style="margin: 4px 0;">• <strong>Alterations Note:</strong> <span id="print-alteration-note"></span></p>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ BLUF Rule of Thumb</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Quick Rule of Thumb: Street Size vs. Bridal Gown Size Conversion
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>The 1-Minute Core Formula:</strong> Bridal gowns use rigid 1950s European sizing charts with zero vanity sizing or stretch fabric. As a golden rule, <strong>Bridal Sizes run 1 to 2 sizes smaller than modern US street sizes</strong> (e.g. US Street Size 6 = US Bridal Size 8–10 = UK Size 12 = EU Size 40). Always order to your <strong>largest single measurement</strong> (Bust, Waist, or Hips) because taking a dress in is standard, but letting out is constrained by tight seam allowances.
			</p>
			
			<!-- Benchmark Size Conversion Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">US Street Size</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">US Bridal Size</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">UK Bridal Size</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">EU Bridal Size</th>
