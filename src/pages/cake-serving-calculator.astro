---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Cake Serving Calculator & Tier Guide",
      "url": "https://manage.wedding/cake-serving-calculator",
      "description": "Estimate exact wedding cake servings, tier sizes, square vs round cake yields, and sheet cake portions. Includes interactive tier visuals and cutting charts.",
      "applicationCategory": "CalculatorApplication",
      "operatingSystem": "All"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How big of a wedding cake do I need for 100 guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For 100 guests, a standard 3-tier round wedding cake measuring 6\", 9\", and 12\" in diameter yields exactly 100 wedding-sized servings (1\" x 2\" x 4\"). Alternatively, a 6\", 8\", and 10\" 3-tier cake combined with a 9\"x13\" quarter sheet cake in the kitchen comfortably serves 100+ guests while saving on decorating costs."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between wedding cake servings and party cake servings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard wedding cake servings measure 1 inch by 2 inches by 4 inches tall (~2 sq. in. / 8 cubic in.), designed for formal events where cake is served after a multi-course dinner. Party cake servings measure 2 inches by 2 inches (~4 sq. in. / 16 cubic in.), providing double the volume for casual birthdays or events where cake is the primary dessert."
          }
        },
        {
          "@type": "Question",
          "name": "Should you include the top tier in your guest serving count?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you follow the tradition of freezing and saving the 6-inch top tier for your first wedding anniversary, do not count it toward your guest servings. Subtract approximately 12 servings from your total cake yield or order an additional tier or sheet cake."
          }
        },
        {
          "@type": "Question",
          "name": "How many people does a full, half, and quarter sheet cake feed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A full sheet cake (18\" x 24\" or 18\" x 26\") feeds 96 to 117 people with 2\"x2\" party slices, or up to 192 people with 1\"x2\" wedding slices. A half sheet cake (12\" x 18\") feeds 48 to 54 party slices (96 wedding slices). A quarter sheet cake (9\" x 13\") feeds 24 to 28 party slices (48 wedding slices)."
          }
        },
        {
          "@type": "Question",
          "name": "How do bakers support and stack multi-tiered cakes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Each tier sits on a sturdy greaseproof cake board cut to the exact diameter of the tier. Food-safe wooden or plastic support dowels are inserted into the tier below to bear the weight of the tiers above, preventing sinking or leaning."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Cake Serving Calculator | Wedding Tier & Sheet Size Guide [Free]"
	description="Calculate exact wedding cake servings, tier sizes, round vs square yields, and sheet cake portions. Includes interactive tier visuals, cutting guides, and serving charts."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header -->
		<section class="section-paper" style="margin-bottom: 2.5rem;">
			<div style="max-width: 900px; margin: 0 auto; padding: 3rem 1.5rem; text-align: center;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15;">
					Wedding Cake Serving Calculator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 650px; margin: 1rem auto 0;">
					Estimate how much cake you need for your wedding or party. Choose cake shape, tier style, slice dimensions, and explore visual tier breakdowns and cutting charts.
				</p>
			</div>
		</section>

		<!-- Interactive Calculator & Visual Studio Grid -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; margin-bottom: 3.5rem;" class="calc-container-grid">
			
			<!-- Left Column: Controls & Inputs -->
			<div class="hand-card" style="padding: 2rem;">
				<h2 class="font-heading" style="font-size: 1.8rem; margin-bottom: 1.5rem; color: var(--fg-pencil); display: flex; align-items: center; gap: 0.5rem;">
					<span>🎂</span> Cake Specifications
				</h2>

				<form id="cake-calc-form">
					
					<!-- Calculation Mode -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Cake Style / Mode:
						</label>
						<div class="mode-select-grid">
							<label class="mode-tab active" id="tab-tiered">
								<input type="radio" name="cakeMode" value="tiered" checked style="display: none;"> Tiered Display
							</label>
							<label class="mode-tab" id="tab-sheet">
								<input type="radio" name="cakeMode" value="sheet" style="display: none;"> Sheet Cake
							</label>
							<label class="mode-tab" id="tab-combo">
								<input type="radio" name="cakeMode" value="combo" style="display: none;"> Display + Sheet
							</label>
						</div>
					</div>

					<!-- Guest Count -->
					<div style="margin-bottom: 1.5rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label class="font-heading" for="guest-count" style="font-size: 1.15rem; color: var(--fg-pencil);">
								Number of Guests:
							</label>
							<span id="guest-badge" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.9rem;">100 Guests</span>
						</div>
						<input type="range" id="guest-slider" min="10" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="guest-count" class="form-input" min="1" max="1000" value="100" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem;">
						</div>
					</div>

					<!-- Cake Shape -->
					<div id="shape-group" style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Cake Tier Shape:
						</label>
						<select id="cake-shape" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem; background: #fff;">
							<option value="round">Round (Traditional & Elegant)</option>
							<option value="square">Square (~25% more servings per tier)</option>
							<option value="heart">Heart Shape (Romantic & Trendy)</option>
						</select>
					</div>

					<!-- Slice / Portion Size -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Portion / Slice Size:
						</label>
						<select id="portion-size" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem; background: #fff;">
							<option value="wedding">Wedding Serving (1" x 2" x 4" tall — Standard 2 sq in)</option>
							<option value="party">Party / Birthday Serving (2" x 2" x 4" tall — Generous 4 sq in)</option>
							<option value="dessert">Dessert Serving (1.5" x 2" x 4" tall — Mid 3 sq in)</option>
						</select>
						<small class="font-body" style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">
							*Wedding slices are standard for receptions with a multi-course dinner.
						</small>
					</div>

					<!-- Tier Preference (Tiered Mode) -->
					<div id="tier-pref-group" style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Tier Configuration:
						</label>
						<select id="tier-count-pref" class="form-input" style="width: 100%; padding: 0.75rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 1.15rem; background: #fff;">
							<option value="auto">Auto-Recommend Best Tier Proportions</option>
							<option value="1">Single Tier (1 Tier)</option>
							<option value="2">2 Tiers (Intimate 30-65 Guests)</option>
							<option value="3">3 Tiers (Classic 75-130 Guests)</option>
							<option value="4">4 Tiers (Grand 130-220 Guests)</option>
							<option value="5">5 Tiers (Royal 220+ Guests)</option>
						</select>
					</div>

					<!-- Anniversary Top Tier Checkbox -->
					<div style="margin-bottom: 1.5rem; padding: 0.75rem; background: var(--bg-paper); border: 2px dashed var(--fg-pencil); border-radius: 4px;">
						<label style="display: flex; align-items: flex-start; gap: 0.5rem; cursor: pointer;">
							<input type="checkbox" id="save-top-tier" style="margin-top: 0.3rem; transform: scale(1.2);">
							<span class="font-body" style="font-size: 1.05rem; color: var(--fg-pencil); line-height: 1.4;">
								<strong>Save Top Tier for 1st Anniversary?</strong><br>
								<span style="color: var(--text-secondary); font-size: 0.9rem;">Subtracts ~12-16 servings from the top tier so your guests don't run short.</span>
							</span>
						</label>
					</div>

					<!-- Cake Height Preference -->
					<div style="margin-bottom: 1.5rem;">
						<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1.15rem; color: var(--fg-pencil);">
							Tier Height / Layers:
						</label>
						<div class="height-select-grid">
							<label class="height-opt active">
								<input type="radio" name="cakeHeight" value="4" checked style="display: none;"> 4" Standard (3 layers)
							</label>
							<label class="height-opt">
								<input type="radio" name="cakeHeight" value="5" style="display: none;"> 5" Tall Event
							</label>
							<label class="height-opt">
								<input type="radio" name="cakeHeight" value="6" style="display: none;"> 6" Double Barrel
							</label>
						</div>
					</div>

					<button type="button" id="recalc-btn" class="hand-btn" style="width: 100%; padding: 1rem; font-size: 1.25rem;">
						✨ Update Cake Calculation
					</button>

				</form>
			</div>

			<!-- Right Column: Interactive Visuals & Results -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Results Summary Card -->
				<div class="hand-card" style="background: #fff;">
					<div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
						<h2 class="font-heading" style="font-size: 1.8rem; color: var(--accent-red); margin: 0;">
							Cake Blueprint
						</h2>
						<span id="match-status" class="font-heading" style="background: var(--post-it); border: 1px solid var(--fg-pencil); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem;">
							Exact Match
						</span>
					</div>

					<!-- Big Stats -->
					<div class="cake-stats-grid">
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Total Servings</span>
							<strong id="res-total-servings" class="font-heading" style="font-size: 1.6rem; color: var(--accent-blue); display: block;">100</strong>
							<span id="res-servings-diff" style="font-size: 0.75rem; color: var(--text-secondary);">Exact for 100</span>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Tiers / Layers</span>
							<strong id="res-tier-count" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); display: block;">3 Tiers</strong>
							<span id="res-tier-detail" style="font-size: 0.75rem; color: var(--text-secondary);">6", 9", 12"</span>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem 0.4rem; text-align: center;">
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">Est. Surface Area</span>
							<strong id="res-cake-area" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); display: block;">205 in²</strong>
							<span style="font-size: 0.75rem; color: var(--text-secondary);">Frosting & Decor</span>
						</div>
					</div>

					<!-- Visual Cake Tier Render Container -->
					<div id="visual-cake-studio" style="border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 1.5rem 0.5rem 0.5rem; background: var(--bg-paper); min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; position: relative; overflow: hidden; max-width: 100%;">
						<div style="position: absolute; top: 8px; left: 10px; font-size: 0.8rem; color: var(--text-secondary); font-family: var(--font-heading);">
							📐 Scale Tier Blueprint
						</div>
						<!-- Tiers dynamically rendered here -->
						<div id="tiers-render-box" style="display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 100%;"></div>
						<!-- Cake Stand -->
						<div id="cake-stand-plate" style="width: min(240px, 90%); height: 10px; background: #e5e0d8; border: 2px solid var(--fg-pencil); border-radius: 10px; margin-top: -2px;"></div>
						<div id="cake-stand-stem" style="width: 50px; height: 20px; background: #dcd6cc; border: 2px solid var(--fg-pencil); border-top: none; margin-bottom: 4px;"></div>
						<div id="cake-stand-foot" style="width: 100px; height: 8px; background: #dcd6cc; border: 2px solid var(--fg-pencil); border-radius: 4px;"></div>
					</div>

					<!-- Breakdown List per Tier -->
					<div id="tier-breakdown-list" style="margin-top: 1.5rem; font-family: var(--font-body); font-size: 1rem;">
						<!-- Populated via JS -->
					</div>

					<!-- Pro-Tip Callout Box -->
					<div id="pro-tip-box" style="margin-top: 1.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
						<div class="font-heading" style="font-size: 1.1rem; margin-bottom: 0.25rem; color: var(--fg-pencil);">
							💡 Smart Money-Saving Strategy:
						</div>
						<p id="pro-tip-text" class="font-body" style="font-size: 0.95rem; margin: 0; line-height: 1.4;">
							Order a smaller 2-tier display cake for photos and ceremonial cutting, paired with a matching kitchen sheet cake kept in the back to feed remaining guests at 50% lower cost!
						</p>
					</div>

				</div>

				<!-- Visual Slice Scale Comparison Card -->
				<div class="hand-card" style="padding: 1.5rem;">
					<h3 class="font-heading" style="font-size: 1.3rem; margin-bottom: 1rem; color: var(--fg-pencil);">
						📏 Serving Size Visual Comparison
					</h3>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; text-align: center;">
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
							<div class="font-heading" style="font-size: 1.1rem; color: var(--accent-blue); margin-bottom: 0.5rem;">Wedding Slice</div>
							<div style="width: 40px; height: 80px; background: #ffeaa7; border: 2px solid var(--fg-pencil); margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
								1" × 2"
							</div>
							<div class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								2 sq in / 8 cu in<br>Standard for 3-course dinners
							</div>
						</div>
						<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1rem;">
							<div class="font-heading" style="font-size: 1.1rem; color: var(--accent-red); margin-bottom: 0.5rem;">Party Slice</div>
							<div style="width: 80px; height: 80px; background: #fab1a0; border: 2px solid var(--fg-pencil); margin: 0 auto 0.5rem; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold;">
								2" × 2"
							</div>
							<div class="font-body" style="font-size: 0.85rem; color: var(--text-secondary);">
								4 sq in / 16 cu in<br>Generous / Birthday standard
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>

		<!-- Quick Navigation Anchor Links -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: 1.5rem; background: var(--bg-paper);">
			<div class="font-heading" style="font-size: 1.2rem; margin-bottom: 0.75rem; color: var(--fg-pencil);">
				📑 In-Depth Cake Planning Guide — Table of Contents:
			</div>
			<div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
				<a href="#how-many-feed" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">1. How Many Does a Cake Feed?</a>
				<a href="#serving-charts" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">2. Round & Square Serving Charts</a>
				<a href="#popular-combos" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">3. Popular Tier Combinations</a>
				<a href="#sheet-cake-guide" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">4. Sheet Cake Sizes & Yields</a>
				<a href="#cutting-guide" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">5. Professional Cutting Guide</a>
				<a href="#faq-section" class="hand-btn secondary" style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">6. Frequently Asked Questions</a>
			</div>
		</div>

		<!-- SEO Article & Comprehensive Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Master Cake Guide</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem;">
					The Complete Wedding Cake Serving & Size Guide
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 700px; margin: 0.5rem auto 0;">
					Everything you need to know about portion sizes, tier dimensions, sheet cake hacks, and cutting styles to avoid overspending or leaving guests empty-handed.
				</p>
			</div>

			<!-- Visual Feature Illustration -->
			<div style="margin-bottom: 2.5rem;">
				<img 
					src="/cake_cutting_sketch.jpg" 
					alt="Hand drawn line art illustration of bride and groom cutting tiered wedding cake with floral accents on a wooden banquet table" 
					style="width: 100%; max-height: 420px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil);"
				/>
				<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin-top: 0.5rem; font-style: italic;">
					Tiered wedding cakes balance visual elegance with accurate portion math.
				</p>
			</div>

			<!-- Section 1: How Many People Does a Cake Feed? -->
			<section id="how-many-feed" style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. How Many People Does a Cake Feed? (The 4 Deciding Factors)
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1rem;">
					Figuring out how much cake you need isn't as simple as guessing one slice per person. The number of servings a cake yields depends on four critical factors that dictate cutting dimensions, density, and event flow:
				</p>
				
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin: 1.5rem 0;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.25rem; color: var(--accent-blue); margin-bottom: 0.5rem;">1. Slice Surface Area</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.5; margin: 0;">
							A formal wedding slice is <strong>1" × 2" (2 sq. in.)</strong>, while a casual party slice is <strong>2" × 2" (4 sq. in.)</strong>. Choosing party slices cuts your total cake yield in half, requiring double the cake volume.
						</p>
					</div>
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.25rem; color: var(--accent-red); margin-bottom: 0.5rem;">2. Cake Height & Layers</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.5; margin: 0;">
							Standard tiered cakes stand <strong>4 inches tall</strong> with 3 sponge layers and 2 filling layers. Modern 5" or 6" double-barrel tiers contain significantly more volume per slice, satisfying guests with narrower cuts.
						</p>
					</div>
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">3. Cake Type & Richness</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.5; margin: 0;">
							Decadent chocolate ganache, rich mud cakes, or buttercream tortes are deeply satisfying in small portions. Lighter sponge cakes, angel food, and berry shortcakes generally encourage larger slices.
						</p>
					</div>
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.25rem; color: #27ae60; margin-bottom: 0.5rem;">4. Dessert Table Alternatives</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.5; margin: 0;">
							If your reception features a donut wall, late-night dessert buffet, or plated dessert, industry planners recommend sizing your wedding cake for only <strong>70% to 80%</strong> of your total RSVP count.
						</p>
					</div>
				</div>
			</section>

			<!-- Section 2: Comprehensive Serving Charts (Round vs Square) -->
			<section id="serving-charts" style="margin-bottom: 3rem;">
