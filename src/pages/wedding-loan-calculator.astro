---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Loan Calculator & Amortization Schedule Maker",
      "url": "https://manage.wedding/wedding-loan-calculator",
      "description": "Free wedding loan calculator. Calculate monthly payments, total interest, origination fees, and full amortization schedules. Simulate extra payments and export to Word, PDF, or Excel.",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate Wedding Loan Monthly Payments and Interest",
      "description": "Step-by-step guide to calculating monthly loan amortization, APR interest costs, and payoff timelines for wedding financing.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Determine Your Funding Gap",
          "text": "Calculate the difference between your total wedding expenses and confirmed cash savings to borrow only what you truly need."
        },
        {
          "@type": "HowToStep",
          "name": "Enter Loan Amount and Interest Rate (APR)",
          "text": "Input your principal loan amount and expected APR (typically 8% to 18% for personal loans depending on credit score)."
        },
        {
          "@type": "HowToStep",
          "name": "Select Repayment Term Length",
          "text": "Choose a term between 12 and 60 months to balance affordable monthly payments against lifetime interest costs."
        },
        {
          "@type": "HowToStep",
          "name": "Simulate Extra Principal Payments",
          "text": "Add extra monthly payments to see how quickly you can eliminate debt and reduce total finance charges."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the average interest rate (APR) for a wedding loan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wedding loan interest rates typically range from 7% to 12% for borrowers with excellent credit scores (720+). For average credit scores (640-719), rates generally range between 13% and 18%, while lower credit scores may face rates of 20% to 28%."
          }
        },
        {
          "@type": "Question",
          "name": "Should you take out a personal loan for a wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Financial planners generally advise against taking on high-interest debt for a one-day celebration. However, a small, fixed-rate personal loan with comfortable monthly payments can be useful to bridge cash flow gaps for deposits if paid off within 12 to 24 months."
          }
        },
        {
          "@type": "Question",
          "name": "How does making extra monthly payments affect a wedding loan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paying just $50 to $100 extra toward your principal each month directly reduces the compounding interest balance, helping you shave several months or years off your loan term and saving hundreds in finance charges."
          }
        },
        {
          "@type": "Question",
          "name": "Can I export my wedding loan amortization schedule?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Click the 'Export Word (.doc)', 'Export PDF / Print', or 'Export Excel (.csv)' button at the top of the calculator. You will receive an itemized monthly repayment schedule ready for your personal finance records."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Loan Calculator (Free Monthly Payment & Amortization Schedule) | Manage.Wedding"
	description="Calculate monthly payments, total interest, and amortization schedules for wedding loans. Simulate extra payments and export your repayment plan to Word, PDF, or Excel."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Wedding Loan Calculator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calculate your monthly payments, total interest cost, and payoff timeline. Simulate extra monthly payments, origination fees, and export your <strong>Amortization Schedule</strong> to <strong>Word (.doc)</strong> or <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> How to Use This Loan Calculator in 3 Easy Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Choose Loan Amount & APR
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Enter your needed borrowing amount and lender's interest rate (APR %), or select a quick popular tier preset.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Simulate Term & Extra Payments
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Select your term (12 to 60 months) and slide the extra monthly payment to see how much interest and time you save.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Export Amortization Table
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Click <strong>"📝 Export Word (.doc)"</strong> or <strong>"🖨️ Export PDF"</strong> to download your complete month-by-month repayment schedule.
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.1fr 0.9fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="loan-calc-grid">
			
			<!-- Left Column: Input Form & Presets -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div style="width: 100%;">
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							🏦 Loan Terms & Rates
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Configure principal, interest rate, term length, and fees
						</span>
					</div>
				</div>

				<!-- Quick Presets -->
				<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; text-align: center;">
					<span class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.4rem; text-align: center;">
						⚡ Popular Loan Presets:
					</span>
					<div style="display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center;">
						<button type="button" class="loan-preset-btn" data-amt="5000" data-apr="8.5" data-term="24">💵 $5k (24 Mo • 8.5%)</button>
						<button type="button" class="loan-preset-btn active-preset" data-amt="15000" data-apr="10.5" data-term="36">💳 $15k (36 Mo • 10.5%)</button>
						<button type="button" class="loan-preset-btn" data-amt="25000" data-apr="12.0" data-term="48">💎 $25k (48 Mo • 12%)</button>
						<button type="button" class="loan-preset-btn" data-amt="40000" data-apr="14.5" data-term="60">👑 $40k (60 Mo • 14.5%)</button>
					</div>
				</div>

				<form id="loan-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- Loan Amount & Currency -->
					<div style="display: grid; grid-template-columns: 1.4fr 0.8fr; gap: 0.75rem;">
						<div>
							<label for="input-loan-amount" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Loan Amount Borrowed *
							</label>
							<div style="display: flex; align-items: center; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; overflow: hidden;">
								<span id="currency-symbol-display" style="padding: 0.55rem 0.75rem; background: var(--bg-paper); border-right: 1px solid var(--fg-pencil); font-weight: bold; font-family: var(--font-heading);">$</span>
								<input type="number" id="input-loan-amount" value="15000" min="500" max="150000" step="500" required style="flex: 1; border: none; padding: 0.55rem; font-family: var(--font-body); font-size: 1.1rem; font-weight: bold; outline: none; background: transparent;">
							</div>
						</div>

						<div>
							<label for="currency-select" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Currency
							</label>
							<select id="currency-select" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
								<option value="$" selected>$ (USD/CAD/AUD)</option>
								<option value="£">£ (GBP)</option>
								<option value="€">€ (EUR)</option>
								<option value="₹">₹ (INR)</option>
							</select>
						</div>
					</div>

					<!-- APR % & Term Months -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label for="input-apr" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Interest Rate (APR %) *
							</label>
							<div style="display: flex; align-items: center; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; overflow: hidden;">
								<input type="number" id="input-apr" value="10.5" min="0" max="36" step="0.25" required style="flex: 1; border: none; padding: 0.55rem; font-family: var(--font-body); font-size: 1.1rem; outline: none; background: transparent;">
								<span style="padding: 0.55rem 0.75rem; background: var(--bg-paper); border-left: 1px solid var(--fg-pencil); font-weight: bold;">%</span>
							</div>
						</div>

						<div>
							<label for="select-loan-term" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Loan Term (Months)
							</label>
							<select id="select-loan-term" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
								<option value="12">12 Months (1 Year)</option>
								<option value="24">24 Months (2 Years)</option>
								<option value="36" selected>36 Months (3 Years)</option>
								<option value="48">48 Months (4 Years)</option>
								<option value="60">60 Months (5 Years)</option>
							</select>
						</div>
					</div>

					<!-- Origination Fee & Extra Monthly Payment -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-origination-pct" class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil);">
									Upfront Origination Fee (%)
								</label>
								<span id="origination-fee-display" style="font-size: 0.8rem; color: var(--accent-red); font-weight: bold;">$0</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.5rem;">
								<input type="range" id="input-origination-pct" min="0" max="8" step="0.5" value="0" style="flex: 1; accent-color: var(--fg-pencil);">
								<span id="origination-pct-label" style="font-size: 0.85rem; font-weight: bold; width: 35px;">0%</span>
							</div>
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-extra-payment" class="font-heading" style="font-size: 0.85rem; color: var(--fg-pencil);">
									Extra Monthly Payment (Principal)
								</label>
								<span id="extra-payment-display" style="font-size: 0.85rem; color: var(--accent-blue); font-weight: bold;">+$0/mo</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.5rem;">
								<input type="range" id="input-extra-payment" min="0" max="500" step="25" value="0" style="flex: 1; accent-color: var(--accent-blue);">
								<span id="extra-payment-label" style="font-size: 0.85rem; font-weight: bold; width: 45px;">$0</span>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Surcharge Comparison -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Monthly Payment Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								💳 Estimated Monthly Repayment
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Principal + Interest per month
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Monthly Payment Highlight -->
					<div style="background: #eff6ff; border: 2.5px solid var(--accent-blue); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-blue); display: block; font-weight: bold;">Estimated Monthly Payment</span>
						<strong id="res-monthly-payment" class="font-heading" style="font-size: 2.6rem; color: var(--accent-blue); display: block; line-height: 1.2;">$487.52</strong>
						<span id="res-term-note" style="font-size: 0.8rem; color: var(--accent-blue);">For 36 Months at 10.5% APR</span>
					</div>

					<!-- Line-Item Totals Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Total Cost of Borrowing
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.95rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">💵 Total Principal Borrowed:</td>
									<td id="res-principal-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$15,000.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb; color: var(--accent-red);">
									<td style="padding: 0.4rem 0;">📈 Total Interest Charges:</td>
									<td id="res-interest-amount" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$2,550.72</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.4rem 0;">🏷️ Upfront Origination Fee:</td>
									<td id="res-origination-fee" style="padding: 0.4rem 0; text-align: right; font-weight: bold;">$0.00</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa; font-size: 1.05rem;">
									<td style="padding: 0.45rem 0; font-weight: bold;">Grand Total Out-of-Pocket:</td>
									<td id="res-grand-total-paid" style="padding: 0.45rem 0; text-align: right; font-weight: bold; color: var(--accent-red);">$17,550.72</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Principal vs Interest Visual Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span style="color: var(--accent-blue);">Principal (<span id="bar-principal-pct">85%</span>)</span>
							<span style="color: var(--accent-red);">Interest (<span id="bar-interest-pct">15%</span>)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-principal" style="width: 85%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-interest" style="width: 15%; background: var(--accent-red); transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Extra Payment Interest Savings Alert Card -->
				<div id="extra-savings-card" class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil); display: none;">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						🎉 Extra Payment Savings Impact!
					</strong>
					<p id="extra-savings-text" class="font-body" style="font-size: 0.9rem; line-height: 1.5; margin: 0; color: var(--fg-pencil); text-align: center;">
						By paying extra each month, you save $420 in interest and pay off your wedding loan 5 months early!
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Official Wedding Loan Repayment Schedule</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Principal: <span id="print-principal"></span> | Monthly Payment: <span id="print-monthly"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 5px; text-align: center;">Month</th>
						<th style="border: 1px solid #ccc; padding: 5px; text-align: right;">Payment</th>
						<th style="border: 1px solid #ccc; padding: 5px; text-align: right;">Principal</th>
						<th style="border: 1px solid #ccc; padding: 5px; text-align: right;">Interest</th>
						<th style="border: 1px solid #ccc; padding: 5px; text-align: right;">Remaining Balance</th>
					</tr>
				</thead>
				<tbody id="print-schedule-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 2.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Bottom Line Up Front (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Quick Rule of Thumb: Wedding Loan Amortization
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 750px; margin: 0 auto; font-weight: 500;">
					Short on time? Here is the standard monthly amortization formula and quick benchmark repayment table for $10k, $20k, and $30k loans at 8% to 12% APR.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📐 The Monthly Payment Amortization Formula:
				</strong>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 700; font-family: monospace;">
					M = P × [ r(1 + r)ⁿ ] / [ (1 + r)ⁿ − 1 ]
				</p>
				<p class="font-body" style="font-size: 0.88rem; line-height: 1.5; margin: 0.5rem 0 0 0; color: var(--text-secondary); text-align: center;">
