	const barInterestPct = document.getElementById('bar-interest-pct');

	const extraSavingsCard = document.getElementById('extra-savings-card');
	const extraSavingsText = document.getElementById('extra-savings-text');

	let amortizationSchedule = [];

	function formatMoney(amount) {
		return `${currencySymbol}${amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
	}

	function calculateLoan() {
		currencySymbol = currencySelect.value;
		currencySymbolDisplay.textContent = currencySymbol;

		const P = parseFloat(loanAmountInput.value) || 0;
		const annualRate = parseFloat(aprInput.value) || 0;
		const n = parseInt(loanTermSelect.value) || 12;
		const origPct = parseFloat(originationPctInput.value) || 0;
		const extraPay = parseFloat(extraPaymentInput.value) || 0;

		originationPctLabel.textContent = `${origPct}%`;
		const originationFee = P * (origPct / 100);
		originationFeeDisplay.textContent = formatMoney(originationFee);

		extraPaymentLabel.textContent = `${currencySymbol}${extraPay}`;
		extraPaymentDisplay.textContent = `+${currencySymbol}${extraPay}/mo`;

		let monthlyBase = 0;
		const i = annualRate / 100 / 12;

		if (P > 0 && n > 0) {
			if (i > 0) {
				monthlyBase = P * (i * Math.pow(1 + i, n)) / (Math.pow(1 + i, n) - 1);
			} else {
				monthlyBase = P / n;
			}
		}

		// Calculate Amortization Schedule
		amortizationSchedule = [];
		let balance = P;
		let totalInterestPaid = 0;
		let totalPaid = 0;
		let monthsElapsed = 0;

		const standardTotalInterest = (monthlyBase * n) - P;

		while (balance > 0.01 && monthsElapsed < 360) {
			monthsElapsed++;
			const monthlyInterest = balance * i;
			let actualMonthlyPayment = monthlyBase + extraPay;

			if (balance + monthlyInterest < actualMonthlyPayment) {
				actualMonthlyPayment = balance + monthlyInterest;
			}

			const principalPortion = actualMonthlyPayment - monthlyInterest;
			balance -= principalPortion;
			if (balance < 0) balance = 0;

			totalInterestPaid += monthlyInterest;
			totalPaid += actualMonthlyPayment;

			amortizationSchedule.push({
				month: monthsElapsed,
				payment: actualMonthlyPayment,
				principal: principalPortion,
				interest: monthlyInterest,
				balance: balance
			});
		}

		const grandTotal = totalPaid + originationFee;

		// Update UI
		resMonthlyPayment.textContent = formatMoney(monthlyBase + extraPay);
		resTermNote.textContent = `For ${monthsElapsed} Months at ${annualRate}% APR`;
		resPrincipalAmount.textContent = formatMoney(P);
		resInterestAmount.textContent = formatMoney(totalInterestPaid);
		resOriginationFee.textContent = formatMoney(originationFee);
		resGrandTotalPaid.textContent = formatMoney(grandTotal);

		// Proportions
		if (grandTotal > 0) {
			const pPct = Math.round((P / grandTotal) * 100);
			const iPct = 100 - pPct;
			barPrincipal.style.width = `${pPct}%`;
			barInterest.style.width = `${iPct}%`;
			barPrincipalPct.textContent = `${pPct}%`;
			barInterestPct.textContent = `${iPct}%`;
		}

		// Extra payment alert
		if (extraPay > 0 && monthsElapsed < n) {
			const interestSaved = standardTotalInterest - totalInterestPaid;
			const monthsSaved = n - monthsElapsed;
			extraSavingsCard.style.display = 'block';
			extraSavingsText.innerHTML = `
				By paying <strong>+${currencySymbol}${extraPay}/mo</strong>, you will save <strong>${formatMoney(interestSaved)} in interest</strong> and become debt-free <strong>${monthsSaved} months early</strong>!
			`;
		} else {
			extraSavingsCard.style.display = 'none';
		}
	}

	// Listeners
	[loanAmountInput, aprInput, originationPctInput, extraPaymentInput].forEach(el => {
		el.addEventListener('input', calculateLoan);
	});
	[loanTermSelect, currencySelect].forEach(el => {
		el.addEventListener('change', calculateLoan);
	});

	// Presets
	document.querySelectorAll('.loan-preset-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.loan-preset-btn').forEach(b => b.classList.remove('active-preset'));
			btn.classList.add('active-preset');

			loanAmountInput.value = btn.getAttribute('data-amt');
			aprInput.value = btn.getAttribute('data-apr');
			loanTermSelect.value = btn.getAttribute('data-term');
			extraPaymentInput.value = 0;
			originationPctInput.value = 0;

			calculateLoan();
		});
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let rows = '';
		amortizationSchedule.forEach(row => {
			rows += `
				<tr>
					<td style="border:1px solid #ccc; padding:6px; text-align:center;">Month ${row.month}</td>
					<td style="border:1px solid #ccc; padding:6px; text-align:right;">${formatMoney(row.payment)}</td>
					<td style="border:1px solid #ccc; padding:6px; text-align:right;">${formatMoney(row.principal)}</td>
					<td style="border:1px solid #ccc; padding:6px; text-align:right; color:#b91c1c;">${formatMoney(row.interest)}</td>
					<td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${formatMoney(row.balance)}</td>
				</tr>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Wedding Loan Amortization Schedule</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 6px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Official Wedding Loan Repayment Schedule</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Principal: <strong>${resPrincipalAmount.textContent}</strong> | APR: <strong>${aprInput.value}%</strong> | Total Interest: <strong>${resInterestAmount.textContent}</strong></p>
				
				<h3>Month-by-Month Amortization Schedule:</h3>
				<table>
					<thead>
						<tr>
							<th style="text-align:center;">Month</th>
							<th style="text-align:right;">Monthly Payment</th>
							<th style="text-align:right;">Principal Applied</th>
							<th style="text-align:right;">Interest Charge</th>
							<th style="text-align:right;">Remaining Balance</th>
						</tr>
					</thead>
					<tbody>
						${rows}
					</tbody>
				</table>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Loan_Amortization_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString();
		document.getElementById('print-principal').textContent = resPrincipalAmount.textContent;
		document.getElementById('print-monthly').textContent = resMonthlyPayment.textContent;

		const tbody = document.getElementById('print-schedule-body');
		tbody.innerHTML = '';

		amortizationSchedule.forEach(row => {
			const tr = document.createElement('tr');
			tr.innerHTML = `
				<td style="border:1px solid #ccc; padding:5px; text-align:center;">Month ${row.month}</td>
				<td style="border:1px solid #ccc; padding:5px; text-align:right;">${formatMoney(row.payment)}</td>
				<td style="border:1px solid #ccc; padding:5px; text-align:right;">${formatMoney(row.principal)}</td>
				<td style="border:1px solid #ccc; padding:5px; text-align:right; color:#b91c1c;">${formatMoney(row.interest)}</td>
				<td style="border:1px solid #ccc; padding:5px; text-align:right; font-weight:bold;">${formatMoney(row.balance)}</td>
			`;
			tbody.appendChild(tr);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Month,Monthly Payment,Principal Applied,Interest Charge,Remaining Balance\n";
		amortizationSchedule.forEach(row => {
			csv += `Month ${row.month},${row.payment.toFixed(2)},${row.principal.toFixed(2)},${row.interest.toFixed(2)},${row.balance.toFixed(2)}\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Loan_Amortization_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateLoan();
</script>
