		const now = new Date();
		let y = now.getFullYear() - wedding.getFullYear();
		if (now.getMonth() < wedding.getMonth() || (now.getMonth() === wedding.getMonth() && now.getDate() < wedding.getDate())) {
			y--;
		}
		// If they married this year or upcoming, show 1st anniversary
		return Math.max(1, y);
	}

	function renderGifts() {
		let yr = parseInt(yearSelect.value) || 1;

		const mData = getMilestone(yr);
		const recipient = recipientSelect.value;

		resYearTitle.textContent = `${yr}${getOrdinal(yr)} Wedding Anniversary`;
		themeTraditionalTitle.textContent = mData.traditional;
		themeTraditionalDesc.textContent = mData.tDesc;
		themeModernTitle.textContent = mData.modern;
		themeModernDesc.textContent = mData.mDesc;
		themeGemstone.textContent = mData.gemstone;
		themeFlower.textContent = mData.flower;

		const pct = Math.min(100, Math.max(5, (yr / 60) * 100));
		gaugeMilestoneBar.style.width = `${pct}%`;

		// 3 Curated Recommendations for this specific year
		const gifts = [mData.gift1, mData.gift2, mData.gift3];

		curatedGiftsContainer.innerHTML = '';
		gifts.forEach(item => {
			if (!item) return;
			const card = document.createElement('div');
			card.style.cssText = `background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;`;
			
			const amazonQuery = encodeURIComponent(`${mData.traditional} anniversary gifts ${recipient === 'her' ? 'for wife her' : recipient === 'him' ? 'for husband him' : 'for couples'}`);
			const amazonUrl = `https://www.amazon.com/s?k=${amazonQuery}&tag=managewedding-20`;

			card.innerHTML = `
				<div style="flex: 1;">
					<div style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.2rem;">
						<span style="font-size: 0.75rem; font-weight: bold; background: #eff6ff; color: #1e3a8a; padding: 0.1rem 0.35rem; border-radius: 3px;">${item.tag}</span>
						<span style="font-size: 0.75rem; color: #16a34a; font-weight: bold;">${item.price}</span>
					</div>
					<strong class="font-heading" style="font-size: 0.98rem; color: var(--fg-pencil); display: block;">${item.title}</strong>
					<p class="font-body" style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.15rem 0 0 0; line-height: 1.3;">${item.desc}</p>
				</div>
				<div>
					<a href="${amazonUrl}" target="_blank" rel="noopener noreferrer nofollow" class="hand-btn" style="padding: 0.35rem 0.65rem; font-size: 0.8rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem; background: #fff;">
						<span>🛒 View on Amazon</span>
					</a>
				</div>
			`;
			curatedGiftsContainer.appendChild(card);
		});
	}

	function getOrdinal(n) {
		const s = ["th", "st", "nd", "rd"];
		const v = n % 100;
		return s[(v - 20) % 10] || s[v] || s[0];
	}

	yearSelect.addEventListener('change', renderGifts);

	dateInput.addEventListener('change', () => {
		if (dateInput.value) {
			const calculatedYr = calculateYearsFromDate(dateInput.value);
			// Match closest available dropdown option
			const options = Array.from(yearSelect.options).map(o => parseInt(o.value));
			let match = options[0];
			for (let opt of options) {
				if (opt <= calculatedYr) match = opt;
			}
			yearSelect.value = match.toString();
			renderGifts();
		}
	});

	[vibeSelect, budgetSelect, recipientSelect].forEach(el => {
		el.addEventListener('change', renderGifts);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Anniversary Gift Guide</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					.box { border: 1px solid #ccc; background: #fafafa; padding: 15px; margin-bottom: 15px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — ${yr}${getOrdinal(yr)} Anniversary Gift Proposal</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Traditional: <strong>${mData.traditional}</strong> | Modern: <strong>${mData.modern}</strong></p>
				
				<div class="box">
					<h3>Milestone Symbolism:</h3>
					<p>• Traditional Material: <strong>${mData.traditional}</strong> — ${mData.tDesc}</p>
					<p>• Modern Theme: <strong>${mData.modern}</strong> — ${mData.mDesc}</p>
					<p>• Symbolic Gemstone: <strong>${mData.gemstone}</strong></p>
					<p>• Symbolic Flower: <strong>${mData.flower}</strong></p>
				</div>

				<div class="box">
					<h3>Top Curated Gift Recommendations:</h3>
					<p>1. <strong>${mData.gift1.title}</strong> (${mData.gift1.price}) — ${mData.gift1.desc}</p>
					<p>2. <strong>${mData.gift2.title}</strong> (${mData.gift2.price}) — ${mData.gift2.desc}</p>
					<p>3. <strong>${mData.gift3.title}</strong> (${mData.gift3.price}) — ${mData.gift3.desc}</p>
				</div>

				<div class="box">
					<h3>Romantic Love Letter & Card Wish Prompt:</h3>
					<p style="font-style:italic;">"Happy ${yr}${getOrdinal(yr)} Anniversary, my love! Looking back on our wedding day and everything we have built since, my love and admiration for you only grow stronger with each passing year. Here's to forever!"</p>
				</div>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Anniversary_Gift_Guide_Year_${yr}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		document.getElementById('print-date').textContent = new Date().toLocaleDateString();
		document.getElementById('print-milestone').textContent = `${yr}${getOrdinal(yr)} Anniversary (${mData.traditional} / ${mData.modern})`;

		const body = document.getElementById('print-content-body');
		body.innerHTML = `
			<div style="border:1px solid #ccc; padding:15px; margin-bottom:15px;">
				<h2 style="margin:0 0 5px 0;">Year ${yr}: ${mData.traditional} & ${mData.modern}</h2>
				<p style="margin:5px 0;"><strong>Gemstone:</strong> ${mData.gemstone} | <strong>Flower:</strong> ${mData.flower}</p>
				<p style="font-size:13px; color:#444;">${mData.tDesc}</p>
			</div>
			<div style="border:1px solid #ccc; padding:15px;">
				<h3 style="margin:0 0 8px 0;">Recommended Card Message:</h3>
				<p style="font-style:italic; font-size:13px; margin:0;">"Happy ${yr}${getOrdinal(yr)} Anniversary! Thank you for being my rock, my love, and my favorite adventure partner. Cheers to many more!"</p>
			</div>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const yr = yearSelect.value || 1;
		const mData = getMilestone(parseInt(yr));

		let csv = "Anniversary Year,Traditional Theme,Modern Theme,Gemstone,Flower,Partner Vibe,Budget\n";
		csv += `"${yr}","${mData.traditional}","${mData.modern}","${mData.gemstone}","${mData.flower}","${vibeSelect.value}","${budgetSelect.value}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Anniversary_Gift_Themes_Year_${yr}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	renderGifts();
</script>
