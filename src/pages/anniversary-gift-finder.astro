---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Anniversary Gift Finder & Affiliate Gift Recommender",
      "url": "https://manage.wedding/anniversary-gift-finder",
      "description": "Free anniversary gift finder by year. Discover traditional and modern gift themes, curated gift ideas, experiences, and subscription boxes tailored to your budget and partner's personality.",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": "All"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the traditional anniversary gifts by year?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The traditional list starts with Paper (1st), Cotton (2nd), Leather (3rd), Fruit/Flowers (4th), Wood (5th), Iron (6th), Copper/Wool (7th), Bronze (8th), Pottery (9th), Tin/Aluminum (10th), Crystal (15th), China (20th), Silver (25th), Pearl (30th), Ruby (40th), Gold (50th), and Diamond (60th)."
          }
        },
        {
          "@type": "Question",
          "name": "How does the anniversary calculator determine milestone years from wedding dates?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you enter your past wedding date (e.g. June 15, 2021), the calculator measures the elapsed years to your next upcoming anniversary (e.g. 5 Years = Wood & Silverware)."
          }
        },
        {
          "@type": "Question",
          "name": "Can I give an experience or subscription box for an anniversary?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Experiential gifts (such as couple's cooking classes, date night subscription boxes, wine clubs, and weekend getaways) have become the most popular anniversary presents for modern couples."
          }
        },
        {
          "@type": "Question",
          "name": "What is the best 1st wedding anniversary gift for a husband or wife?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For the 1st anniversary (Paper), popular gifts include custom framed wedding vows, a personalized star map of your wedding night, tickets to a dream concert/trip, or a customized photo book of your first year of marriage."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Anniversary Gift Finder by Year (Curated Ideas & Word Export) | Manage.Wedding"
	description="Find perfect traditional, modern, and experiential anniversary gifts for any year. Curated gifts by budget and partner personality with instant Word and PDF exports."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Anniversary Gift Finder
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Discover official traditional & modern materials, symbolic gemstones & flowers, and <strong>curated gift recommendations</strong> for every milestone from Year 1 to 60!
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> How to Use This Gift Finder in 3 Easy Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Choose Milestone Year or Date
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Select your anniversary year (1st, 2nd, 5th, 10th, 25th, 50th) or enter your wedding date to calculate it automatically.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Personalize Vibe & Budget
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Choose your partner's vibe (Romantic Keepsakes, Foodie/Wine, Luxury Experiences, or Cozy Home) and target price range.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ View Curated Gifts & Card Wishes
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Instantly view curated Amazon gift links, romantic card message templates, and export complete proposals in Word or PDF!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Quiz Form + Themes & Curated Gift Stream -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="gift-finder-grid">
			
			<!-- Left Column: Simplified Interactive Questionnaire -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🎁 Milestone Selector & Quiz
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Select your anniversary year or calculate by wedding date
					</span>
				</div>

				<form id="gift-quiz-form" style="display: flex; flex-direction: column; gap: 1.1rem;">
					
					<!-- 1. Milestone Year Dropdown -->
					<div>
						<label for="select-anniversary-year" class="font-heading" style="display: block; font-size: 0.95rem; color: var(--accent-red); margin-bottom: 0.25rem;">
							1. Select Anniversary Year *
						</label>
						<select id="select-anniversary-year" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-heading); font-size: 1.05rem; background: #fff;">
							<option value="1" selected>1st Anniversary — Paper (Modern: Clocks)</option>
							<option value="2">2nd Anniversary — Cotton (Modern: China)</option>
							<option value="3">3rd Anniversary — Leather (Modern: Crystal / Glass)</option>
							<option value="4">4th Anniversary — Fruit & Flowers (Modern: Appliances)</option>
							<option value="5">5th Anniversary — Wood (Modern: Silverware)</option>
							<option value="6">6th Anniversary — Iron / Candy (Modern: Wood Objects)</option>
							<option value="7">7th Anniversary — Wool / Copper (Modern: Desk Sets)</option>
							<option value="8">8th Anniversary — Bronze / Pottery (Modern: Linens / Lace)</option>
							<option value="9">9th Anniversary — Willow / Pottery (Modern: Leather)</option>
							<option value="10">10th Anniversary — Tin / Aluminum (Modern: Diamond Jewelry)</option>
							<option value="11">11th Anniversary — Steel (Modern: Fashion Jewelry)</option>
							<option value="12">12th Anniversary — Silk / Linen (Modern: Pearls)</option>
							<option value="13">13th Anniversary — Lace (Modern: Textiles)</option>
							<option value="14">14th Anniversary — Ivory Alternatives (Modern: Gold Jewelry)</option>
							<option value="15">15th Anniversary — Crystal (Modern: Luxury Watches)</option>
							<option value="20">20th Anniversary — China (Modern: Platinum)</option>
							<option value="25">25th Anniversary — Sterling Silver (Silver Jubilee)</option>
							<option value="30">30th Anniversary — Pearl (Modern: Diamond)</option>
							<option value="35">35th Anniversary — Coral (Modern: Jade)</option>
							<option value="40">40th Anniversary — Ruby (Ruby Jubilee)</option>
							<option value="45">45th Anniversary — Sapphire</option>
							<option value="50">50th Anniversary — Pure Gold (Golden Jubilee)</option>
							<option value="55">55th Anniversary — Emerald</option>
							<option value="60">60th Anniversary — Diamond (Diamond Jubilee)</option>
						</select>
					</div>

					<!-- Optional Date Calculator Accordion -->
					<details style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.6rem;">
						<summary style="font-size: 0.88rem; font-family: var(--font-heading); color: var(--accent-blue); cursor: pointer;">
							📅 Or Calculate Automatically by Wedding Date
						</summary>
						<div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.3rem;">
							<span style="font-size: 0.78rem; color: var(--text-secondary);">Enter the date you got married:</span>
							<input type="date" id="input-wedding-date" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</details>

					<!-- 2. Partner's Personality Vibe -->
					<div>
						<label for="select-partner-vibe" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
							2. Partner's Personality & Interests
						</label>
						<select id="select-partner-vibe" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="sentimental" selected>💖 Sentimental & Romantic (Keepsakes, custom vows, photo art)</option>
							<option value="experiences">✈️ Experiential & Adventure (Date nights, forest cabins, spas)</option>
							<option value="foodie">🍷 Foodie & Wine Connoisseur (Gourmet baskets, wine tasting clubs)</option>
							<option value="practical">⚡ Practical, Tech & Luxury (Watches, appliances, home tools)</option>
							<option value="home">🏡 Cozy Home & Garden (Decor, cashmere throws, plants)</option>
						</select>
					</div>

					<!-- 3. Target Budget & Recipient -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="select-gift-budget" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								3. Target Budget
							</label>
							<select id="select-gift-budget" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="under50">Under $50 (Sweet & Budget)</option>
								<option value="50to150" selected>$50 - $150 (Sweet Spot)</option>
								<option value="150to300">$150 - $300 (Premium Keepsake)</option>
								<option value="300plus">$300+ (Luxury Milestone & Fine Jewelry)</option>
							</select>
						</div>

						<div>
							<label for="select-recipient" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								4. Shopping For
							</label>
							<select id="select-recipient" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.88rem;">
								<option value="couple" selected>Both of Us (Shared)</option>
								<option value="her">For Her (Wife / Partner)</option>
								<option value="him">For Him (Husband / Partner)</option>
							</select>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Themes & Curated Gift Stream -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Theme Overview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🎉 <span id="res-year-title">1st Wedding Anniversary</span>
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Official traditional & modern milestone symbols
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word Proposal (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Dual Themes Comparison Grid -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
						<div style="background: #faf8f5; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-red); font-weight: bold; display: block;">
								Traditional Theme
							</span>
							<strong id="theme-traditional-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Paper
							</strong>
							<p id="theme-traditional-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Symbolizes the clean, blank pages upon which your new shared story is written.
							</p>
						</div>

						<div style="background: #eff6ff; border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; text-align: center;">
							<span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-blue); font-weight: bold; display: block;">
								Modern Theme
							</span>
							<strong id="theme-modern-title" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); display: block; margin: 0.2rem 0;">
								Clocks
							</strong>
							<p id="theme-modern-desc" class="font-body" style="font-size: 0.78rem; color: var(--text-secondary); margin: 0; line-height: 1.3;">
								Represents the precious passage of time and lifelong memories created together.
							</p>
						</div>
					</div>

					<!-- Gemstone & Flower Sub-Themes -->
					<div style="display: flex; justify-content: space-around; font-size: 0.85rem; background: var(--bg-paper); border: 1px dashed var(--fg-pencil); border-radius: 4px; padding: 0.5rem; margin-bottom: 1.25rem;">
						<span>💎 Gemstone: <strong id="theme-gemstone">Gold Jewelry</strong></span>
						<span>🌸 Flower: <strong id="theme-flower">Carnation</strong></span>
					</div>

					<!-- 60-Year Milestone Progress Gauge -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.25rem;">
							<span>Year 1 (Paper)</span>
							<span>Year 25 (Silver)</span>
							<span>Year 50 (Gold)</span>
							<span>Year 60 (Diamond)</span>
						</div>
						<div style="width: 100%; height: 16px; border: 1.5px solid var(--fg-pencil); border-radius: 8px; overflow: hidden; background: #eee;">
							<div id="gauge-milestone-bar" style="width: 5%; height: 100%; background: var(--accent-red); transition: width 0.4s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Curated Gift Recommendations Stream (With Search/Affiliate Links) -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff;">
					<h3 class="font-heading" style="font-size: 1.2rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						🛍️ Curated Gift & Experience Ideas
					</h3>
					<div id="curated-gifts-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<!-- Injected via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Anniversary Gift Guide & Milestone Proposal</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exported on: <span id="print-date"></span> | Milestone: <span id="print-milestone"></span></p>
			</div>
			<div id="print-content-body"></div>
		</div>

		<!-- SEO Article & Comprehensive Guide (Centered Headings) -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; margin-bottom: 2.5rem;">
				<span class="badge-postit">Milestone Gift & Romance Playbook</span>
				<h2 class="font-heading" style="font-size: clamp(28px, 4vw, 42px); color: var(--fg-pencil); margin-top: 0.5rem; text-align: center;">
					The Complete Year-by-Year Anniversary Gift Guide
				</h2>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 750px; margin: 0.5rem auto 0; text-align: center;">
					The history of traditional vs. modern anniversary lists, gemstone symbolism, and romantic card message ideas.
				</p>
			</div>

			<div style="margin-bottom: 2.5rem; text-align: center;">
				<img 
					src="/images/rsvp_envelopes.jpg" 
					alt="Hand drawn line art sketch of anniversary gifts and love letters representing traditional and modern wedding anniversary milestones" 
					style="width: 100%; max-height: 420px; object-fit: cover; border: 2px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); margin: 0 auto; display: block;"
				/>
				<p style="font-size: 0.85rem; color: var(--text-secondary); text-align: center; margin-top: 0.5rem; font-style: italic;">
					From 1st year paper vows to 50th year gold jewelry, each material symbolizes the strengthening bond of marriage.
				</p>
			</div>

			<!-- Section 1: Detailed Step-by-Step Guide on How to Use This Tool Flawlessly -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					1. Step-by-Step Guide: How to Select an Unforgettable Anniversary Gift
				</h3>
				<p class="font-body" style="line-height: 1.7; margin-bottom: 1.25rem;">
					Finding a gift that feels deeply personal while honoring the historical anniversary theme is simple with these 4 steps:
				</p>

				<div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.5rem;">
					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-red); margin-bottom: 0.4rem;">
							Step 1: Understand the Material Symbolism
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Traditional lists start with fragile materials (Paper, Cotton, Leather) representing the early foundation of marriage, gradually strengthening into solid materials (Wood, Iron, Bronze) and precious metals (Silver, Gold, Diamond).
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: var(--accent-blue); margin-bottom: 0.4rem;">
							Step 2: Balance Tangible vs. Experiential Gifts
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							If your partner prefers shared memories over physical clutter, interpret the theme experientially: e.g., for Year 1 (Paper), gift airline boarding passes or concert tickets; for Year 5 (Wood), book a cozy cabin getaway in the forest!
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: #16a34a; margin-bottom: 0.4rem;">
							Step 3: Consider Subscription & Date Night Boxes
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Monthly date-night subscriptions, craft cocktail kits, or gourmet coffee/wine clubs provide ongoing celebrations that keep the romance alive throughout the entire anniversary year.
						</p>
					</div>

					<div style="background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem;">
						<h4 class="font-heading" style="font-size: 1.2rem; color: #d97706; margin-bottom: 0.4rem;">
							Step 4: Export Curated Proposal & Card Wishes
						</h4>
						<p class="font-body" style="font-size: 0.95rem; line-height: 1.6; margin: 0;">
							Click <strong>"📝 Export Word Gift Proposal (.doc)"</strong> to download a formatted shopping list alongside pre-written romantic love letter prompts!
						</p>
					</div>
				</div>
			</section>

			<!-- Section 2: Master Milestone Matrix Table (Years 1 to 60) -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem; text-align: center;">
					2. Master Anniversary Milestone Matrix (Years 1 to 60)
				</h3>
				<div style="overflow-x: auto; margin-bottom: 1.5rem;">
					<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.95rem;">
						<thead>
							<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
								<th style="padding: 0.6rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Anniversary Year</th>
