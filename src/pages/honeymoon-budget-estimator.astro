		const days = parseInt(tripDaysSlider.value) || 8;
		tripDaysNum.value = days;
		tripDaysDisplay.textContent = `${days} Days / ${days} Nights`;
		resNightsCount.textContent = days;

		// 1. Flights
		let flightCost = tier.flightsBase;
		const flightClass = flightClassSelect.value;
		if (flightClass === 'premium') flightCost *= 1.4;
		else if (flightClass === 'business') flightCost *= 2.5;
		else if (flightClass === 'points') flightCost = 150; // Taxes/fees only

		// 2. Lodging
		const lodgingPerNight = tier.lodging[lodgingStyleSelect.value] || tier.lodging.resort4;
		const hotelCost = lodgingPerNight * days;

		// 3. Dining
		const diningPerDay = tier.dining[diningStyleSelect.value] || tier.dining.fine_dining;
		const foodCost = diningPerDay * days;

		// 4. Excursions
		const excursionsPerDay = tier.excursions[excursionsStyleSelect.value] || tier.excursions.moderate;
		const excursionsCost = excursionsPerDay * days;

		// 5. Extras
		let extrasCost = 0;
		if (chkInsurance.checked) extrasCost += 250;
		if (chkBuffer.checked) extrasCost += 350;

		const grandTotal = flightCost + hotelCost + foodCost + excursionsCost + extrasCost;
		const perDayCost = Math.round(grandTotal / days);

		// Update UI
		resGrandTotal.textContent = formatMoney(grandTotal);
		resPerDayNote.textContent = `Approx. ${formatMoney(perDayCost)} / Day for Two Travelers`;
		resFlightTotal.textContent = formatMoney(flightCost);
		resHotelTotal.textContent = formatMoney(hotelCost);
		resFoodTotal.textContent = formatMoney(foodCost);
		resExcursionsTotal.textContent = formatMoney(excursionsCost);
		resExtrasTotal.textContent = formatMoney(extrasCost);

		// Bar Chart
		if (grandTotal > 0) {
			const pF = Math.round((flightCost / grandTotal) * 100);
			const pH = Math.round((hotelCost / grandTotal) * 100);
			const pD = Math.round((foodCost / grandTotal) * 100);
			const pE = 100 - pF - pH - pD;

			barFlights.style.width = `${pF}%`;
			barHotel.style.width = `${pH}%`;
			barFood.style.width = `${pD}%`;
			barExcursions.style.width = `${Math.max(2, pE)}%`;

			pctFlights.textContent = `${pF}%`;
			pctHotel.textContent = `${pH}%`;
			pctFood.textContent = `${pD}%`;
			pctExcursions.textContent = `${Math.max(2, pE)}%`;
		}
	}

	// Listeners
	tripDaysSlider.addEventListener('input', () => {
		tripDaysNum.value = tripDaysSlider.value;
		calculateHoneymoon();
	});
	tripDaysNum.addEventListener('input', () => {
		tripDaysSlider.value = tripDaysNum.value;
		calculateHoneymoon();
	});

	[countryTierSelect, flightClassSelect, lodgingStyleSelect, diningStyleSelect, excursionsStyleSelect, chkInsurance, chkBuffer, currencySelect].forEach(el => {
		el.addEventListener('change', calculateHoneymoon);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Honeymoon Travel Budget Plan</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Official Honeymoon Travel Budget</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Destination: <strong>${countryTierSelect.options[countryTierSelect.selectedIndex].text.split('(')[0]}</strong> | Duration: <strong>${tripDaysSlider.value} Days</strong> | Estimated Total: <strong>${resGrandTotal.textContent}</strong> (${resPerDayNote.textContent})</p>
				
				<h3>Itemized Travel Expense Breakdown:</h3>
				<table>
					<thead>
						<tr>
							<th>Travel Category</th>
							<th style="text-align:right;">Estimated Budget</th>
						</tr>
					</thead>
					<tbody>
						<tr><td>Round-Trip Flights for Two (${flightClassSelect.options[flightClassSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resFlightTotal.textContent}</td></tr>
						<tr><td>Resort Lodging (${tripDaysSlider.value} Nights @ ${lodgingStyleSelect.options[lodgingStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resHotelTotal.textContent}</td></tr>
						<tr><td>Dining, Cocktails & Food (${diningStyleSelect.options[diningStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resFoodTotal.textContent}</td></tr>
						<tr><td>Excursions & Couple's Activities (${excursionsStyleSelect.options[excursionsStyleSelect.selectedIndex].text})</td><td style="text-align:right; font-weight:bold;">${resExcursionsTotal.textContent}</td></tr>
						<tr><td>Travel Insurance, Airport Transfers & Shopping Buffer</td><td style="text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;">
							<td>Total Trip Budget Needed</td>
							<td style="text-align:right; color:#16a34a;">${resGrandTotal.textContent}</td>
						</tr>
					</tbody>
				</table>

				<h3 style="margin-top:25px;">Honeymoon Travel Reminders:</h3>
				<p>• Check passport expiration dates (must have at least 6 months validity from departure date).</p>
				<p>• Notify credit card companies of international travel to avoid blocked transactions.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Honeymoon_Budget_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString();
		document.getElementById('print-total').textContent = resGrandTotal.textContent;

		const tbody = document.getElementById('print-honeymoon-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px;">Round-Trip Flights for Two</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFlightTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Resort Lodging (${tripDaysSlider.value} Nights)</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resHotelTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Dining & Romantic Meals</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resFoodTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Excursions & Spa Activities</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExcursionsTotal.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px;">Insurance, Transfers & Buffer</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resExtrasTotal.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Estimated Total Trip Budget</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#16a34a;">${resGrandTotal.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Travel Category,Estimated Budget\n";
		csv += `"Round-Trip Flights (2 Travelers)","${resFlightTotal.textContent}"\n`;
		csv += `"Resort Lodging (${tripDaysSlider.value} Nights)","${resHotelTotal.textContent}"\n`;
		csv += `"Food & Romantic Dining","${resFoodTotal.textContent}"\n`;
		csv += `"Excursions & Activities","${resExcursionsTotal.textContent}"\n`;
		csv += `"Insurance & Incidentals","${resExtrasTotal.textContent}"\n`;
		csv += `"Total Honeymoon Budget","${resGrandTotal.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Honeymoon_Budget_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateHoneymoon();
</script>
