---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Honeymoon Budget Estimator by Country Tier",
      "url": "https://manage.wedding/honeymoon-budget-estimator",
      "description": "Free honeymoon budget estimator by destination country tiers. Calculate exact travel costs for flights, hotels, overwater bungalows, romantic dining, excursions, and travel insurance. Export to Word, PDF, or Excel.",
      "applicationCategory": "TravelApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Estimate and Plan a Honeymoon Budget",
      "description": "Step-by-step guide to estimating honeymoon costs across flights, lodging, dining, and activities based on destination tiers.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Select Destination Tier",
          "text": "Choose between budget-friendly tropical (Tier 1), classic international/European (Tier 2), or ultra-luxury (Tier 3)."
        },
        {
          "@type": "HowToStep",
          "name": "Allocate 50% for Lodging & Resorts",
          "text": "Reserve half of your travel budget for luxury hotels, beachfront resorts, or overwater villas."
        },
        {
          "@type": "HowToStep",
          "name": "Allocate 25% for Flights & Transportation",
          "text": "Budget for round-trip flights, inter-island ferries, trains, and airport transfers."
        },
        {
          "@type": "HowToStep",
          "name": "Allocate 15% for Romantic Dining & 10% for Excursions",
          "text": "Plan for candlelit dinners, wine pairings, couples massage, snorkeling tours, and souvenirs."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does the average honeymoon cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The average honeymoon costs between $4,500 and $8,500 for a 7 to 10-day trip. However, costs depend heavily on the country tier: an affordable trip to Bali or Mexico averages $3,000 to $5,000, a classic European or Caribbean vacation ranges from $6,000 to $10,000, while ultra-luxury overwater bungalow escapes in the Maldives or Bora Bora range from $12,000 to $25,000+."
          }
        },
        {
          "@type": "Question",
          "name": "Why does the destination country tier impact the honeymoon budget so drastically?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Local purchasing power and daily cost of living index vary wildly between destinations. In Tier 1 countries (like Thailand, Vietnam, or Costa Rica), a 5-star beachfront villa and Michelin-caliber romantic dinners cost a fraction ($150-$250/day) of what the same luxury standards cost in Tier 3 destinations like the Amalfi Coast, Switzerland, or the Maldives ($800-$1,800/day)."
          }
        },
        {
          "@type": "Question",
          "name": "How far in advance should couples book their honeymoon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For international flights and popular luxury resorts (especially in high season), book 6 to 9 months in advance to secure optimal flight routes and early-bird resort rates. For domestic trips or all-inclusive Caribbean packages, 4 to 6 months is generally sufficient."
          }
        },
        {
          "@type": "Question",
          "name": "Can we fund our honeymoon using a wedding cash registry?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Modern couples frequently set up a Honeymoon Registry fund where guests can sponsor specific experiences—such as round-trip flights, a sunset catamaran cruise, couple's spa massages, or a romantic wine tasting dinner. This can offset 40% to 70% of your total trip cost."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Honeymoon Budget Estimator by Country Tier (Free Travel Calculator & Word Export) | Manage.Wedding"
	description="Calculate exact honeymoon costs based on destination country tiers. Estimate flights, overwater bungalows, dining, excursions, and transit with instant Word and PDF exports."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Honeymoon Budget Estimator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calculate realistic getaway expenses based on your <strong>destination country tier</strong>, travel style, flight class, and trip duration. Export your official <strong>Honeymoon Budget & Itinerary</strong> to <strong>Word (.doc)</strong> or <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> How to Use This Honeymoon Estimator in 3 Easy Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Select Destination Tier & Country
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Choose your destination tier—from affordable tropical spots (Bali, Mexico) to classic European getaways or luxury overwater bungalows (Maldives, Bora Bora).
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Customize Lodging & Dining Style
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Adjust your flight class, resort tier (boutique vs. 5-star vs. overwater villa), daily excursions, and duration (in days) for two travelers.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Export Your Travel Budget Plan
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Click <strong>"📝 Export Word (.doc)"</strong> or <strong>"🖨️ Export PDF"</strong> to save your complete honeymoon cost proposal for budgeting or your honeymoon cash registry!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="honeymoon-calc-grid">
			
			<!-- Left Column: Travel Parameters Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							✈️ Destination & Travel Parameters
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							All calculations automatically include costs for two travelers
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Currency:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="$" selected>$ (USD/CAD/AUD)</option>
							<option value="£">£ (GBP)</option>
							<option value="€">€ (EUR)</option>
							<option value="₹">₹ (INR)</option>
						</select>
					</div>
				</div>

				<form id="honeymoon-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Destination Country Tier -->
					<div>
						<label for="select-country-tier" class="font-heading" style="display: block; font-size: 1rem; color: var(--accent-red); margin-bottom: 0.3rem;">
							1. Destination Country Tier & Cost Index *
						</label>
						<select id="select-country-tier" style="width: 100%; box-sizing: border-box; padding: 0.6rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.95rem;">
							<option value="tier1">🌴 Tier 1: Affordable Tropical & Culture (Bali, Thailand, Mexico, Portugal, Costa Rica)</option>
							<option value="tier2" selected>🏖️ Tier 2: Classic Mid-Range & Resorts (Caribbean, Italy, Spain, Japan, Hawaii, Greece)</option>
							<option value="tier3">💎 Tier 3: Ultra-Luxury & Overwater (Maldives, Bora Bora/Tahiti, Amalfi, Swiss Alps)</option>
							<option value="tier4">🦁 Tier 4: Specialty Bucket-List (African Safari, Galapagos, Private Island)</option>
							<option value="domestic">🚗 Tier 5: Domestic Getaways & Road Trips (Napa Valley, Charleston, National Parks)</option>
						</select>
					</div>

					<!-- 2. Trip Duration & Flight Class -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem;">
						<div>
							<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.2rem;">
								<label for="input-trip-days" class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
									Trip Duration (Days / Nights)
								</label>
								<span id="trip-days-display" style="font-size: 0.95rem; font-weight: bold; color: var(--accent-blue);">8 Days</span>
							</div>
							<div style="display: flex; align-items: center; gap: 0.5rem;">
								<input type="range" id="input-trip-days" min="3" max="28" value="8" step="1" style="flex: 1; accent-color: var(--accent-blue);">
								<input type="number" id="input-trip-days-num" value="8" min="3" max="28" style="width: 50px; padding: 0.3rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; text-align: center; font-weight: bold;">
							</div>
						</div>

						<div>
							<label for="select-flight-class" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Flights for Two (Round-Trip)
							</label>
							<select id="select-flight-class" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
								<option value="economy" selected>Main Cabin Economy</option>
								<option value="premium">Premium Economy (+40%)</option>
								<option value="business">Business / First Class (2.5x)</option>
								<option value="points">Credit Card Points / Miles ($150 taxes)</option>
							</select>
						</div>
					</div>

					<!-- 3. Resort & Lodging Standard -->
					<div>
						<label for="select-lodging-style" class="font-heading" style="display: block; font-size: 1rem; color: var(--accent-blue); margin-bottom: 0.3rem;">
							2. Accommodation & Resort Style (Per Night)
						</label>
						<select id="select-lodging-style" style="width: 100%; box-sizing: border-box; padding: 0.55rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="boutique">Cozy Boutique Hotel / Airbnb Superhost</option>
							<option value="resort4" selected>4-Star Beachfront Resort / Historic City Hotel</option>
							<option value="luxury5">5-Star Luxury Resort / Private Pool Villa</option>
							<option value="overwater">Overwater Bungalow / Ultra-Luxe Safari Lodge</option>
						</select>
					</div>

					<!-- 4. Dining, Excursions & Extras -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.75rem;">
						<span class="font-heading" style="font-size: 0.95rem; color: #16a34a; display: block;">
							3. Dining, Excursions & Incidentals (For Couple)
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">Dining & Cocktail Style</span>
								<select id="select-dining-style" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="moderate">Mix of Casual Cafes & Romantic Dinners</option>
									<option value="fine_dining" selected>Upscale Dining & Sunset Cocktails Daily</option>
									<option value="budget">Local Markets & Street Food Exploration</option>
									<option value="michelin">Michelin-Star Tasting Menus & Private Dinners</option>
								</select>
							</div>

							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-bottom: 0.2rem;">Daily Excursions & Activities</span>
								<select id="select-excursions-style" style="width: 100%; box-sizing: border-box; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-size: 0.85rem;">
									<option value="moderate" selected>Couple's Massage, Catamaran & Tours</option>
									<option value="light">Relaxed Beach Days & Self-Guided Walks</option>
									<option value="heavy">Daily Adventure (Helicopters, Scuba, Private Guides)</option>
								</select>
							</div>
						</div>

						<div style="display: flex; gap: 1rem; flex-wrap: wrap; padding-top: 0.3rem;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-travel-insurance" checked style="accent-color: var(--fg-pencil);">
								<span>Include Travel Insurance & Airport Transfers ($250)</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-shopping-buffer" checked style="accent-color: var(--fg-pencil);">
								<span>Souvenirs & Shopping Buffer ($350)</span>
							</label>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Financial Results & Cost Breakdown -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Honeymoon Total Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🏖️ Estimated Honeymoon Budget
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Complete all-inclusive vacation forecast for two
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Budget Total Highlight -->
					<div style="background: #f0fdf4; border: 2.5px solid #16a34a; border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: #16a34a; display: block; font-weight: bold;">Estimated Total Trip Budget</span>
						<strong id="res-grand-total" class="font-heading" style="font-size: 2.6rem; color: #16a34a; display: block; line-height: 1.2;">$7,450</strong>
						<span id="res-per-day-note" style="font-size: 0.8rem; color: #16a34a;">Approx. $931 / Day for Two Travelers</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Itemized Travel Expense Summary
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">✈️ Round-Trip Flights (2 Travelers):</td>
									<td id="res-flight-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$2,400.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🏨 Resort Lodging (<span id="res-nights-count">8</span> Nights):</td>
									<td id="res-hotel-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$2,800.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Food & Romantic Dining:</td>
									<td id="res-food-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$1,360.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🏄 Excursions & Couple Activities:</td>
									<td id="res-excursions-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$800.00</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0;">🛡️ Insurance, Transit & Buffer:</td>
									<td id="res-extras-total" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$600.00</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Visual Travel Proportion Bar -->
					<div>
						<div style="display: flex; justify-content: space-between; font-size: 0.78rem; font-weight: bold; margin-bottom: 0.3rem;">
							<span style="color: var(--accent-red);">Flights (<span id="pct-flights">32%</span>)</span>
							<span style="color: var(--accent-blue);">Resort (<span id="pct-hotel">38%</span>)</span>
							<span style="color: #16a34a;">Dining (<span id="pct-food">18%</span>)</span>
							<span style="color: #7c3aed;">Fun (<span id="pct-excursions">12%</span>)</span>
						</div>
						<div style="display: flex; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; background: #eee;">
							<div id="bar-flights" style="width: 32%; background: var(--accent-red); transition: width 0.3s ease;"></div>
							<div id="bar-hotel" style="width: 38%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-food" style="width: 18%; background: #16a34a; transition: width 0.3s ease;"></div>
							<div id="bar-excursions" style="width: 12%; background: #7c3aed; transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Registry Cash Fund Tip Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						💡 Honeymoon Registry Pro-Tip:
					</strong>
					<p class="font-body" style="font-size: 0.85rem; line-height: 1.5; margin: 0; color: var(--fg-pencil); text-align: center;">
						Turn line items from this calculator into tangible registry gifts! Guests love gifting specific experiences like <em>"Romantic Sunset Dinner in Italy ($150)"</em> or <em>"Couple's Beachside Massage ($200)"</em>.
					</p>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Official Honeymoon Travel Budget</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Total Trip Budget: <span id="print-total"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Travel Budget Category</th>
						<th style="border: 1px solid #ccc; padding: 6px; width: 120px; text-align: right;">Estimated Cost</th>
					</tr>
				</thead>
				<tbody id="print-honeymoon-body"></tbody>
			</table>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 2.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="text-align: center; margin-bottom: 1.25rem;">
