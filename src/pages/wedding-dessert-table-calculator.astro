		<!-- Final Page: Master Bakery & Candy Order Sheet -->
		<div id="print-bakery-sheet-container" class="print-page" style="page-break-after: auto; break-after: auto; page-break-inside: avoid; break-inside: avoid; padding: 8mm 10mm; box-sizing: border-box;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 3mm; margin-bottom: 5mm;">
				<h1 style="font-size: 18pt; margin: 0 0 2mm 0; color: #000; font-family: 'Georgia', serif;">Wedding Dessert & Candy Bar Order Sheet</h1>
				<p id="print-bakery-meta" style="font-size: 10pt; color: #333; margin: 0; font-family: Arial, sans-serif;">Couple: Emma & Liam | Date: October 18, 2026 | Headcount: 100 Guests</p>
			</div>
			<div id="print-bakery-tables">
				<!-- Injected by script -->
			</div>
			<div style="margin-top: 6mm; padding-top: 3mm; border-top: 1pt dashed #cbd5e1; font-size: 8.5pt; color: #64748b; text-align: center; font-family: Arial, sans-serif;">
				Generated by Manage.Wedding Dessert Table & Candy Bar Sizer • Print on heavy cardstock (80–110 lb) for best results.
