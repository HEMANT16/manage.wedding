---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import RelatedTools from '../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/wedding-dessert-table-calculator/#webapp",
      "name": "Wedding Dessert Table, Candy Bar & Cookie Sizer",
      "url": "https://manage.wedding/wedding-dessert-table-calculator",
      "description": "Free interactive wedding dessert table calculator, bulk candy buffet sizer, and Pittsburgh cookie table planner. Calculate exact bite-size piece counts, baker dozens, candy pounds, jar staging, and export printable 8x10 'Love is Sweet' signs, dietary tent cards, and master bakery order sheets in PDF and Word.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate Dessert Table Quantities, Variety & Candy for a Wedding",
      "description": "Step-by-step formula to calculate mini dessert portions, bulk candy buffet pounds, apothecary jars, and bakery dozen orders for wedding receptions.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Choose Dessert Format & Serving Style",
          "text": "Determine if desserts are served alongside a traditional wedding cake (2–3 bite-size pieces per guest), in lieu of wedding cake (4–6 pieces per guest), as a traditional Cookie Table (6–8 cookies per guest + favor boxes), or as a bulk Candy Buffet (0.25 to 0.35 lbs / 4–6 oz per guest)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Select Variety Mix and Auto-Balance Portions",
          "text": "Choose 4 to 8 dessert varieties based on headcount (e.g. macarons, mini cupcakes, mousse shooters, tartlets, cake pops, cannoli) and convert piece counts into standard bakery dozen orders."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Size Candy Bar Jars, Scoops & Favor Packaging",
          "text": "Calculate bulk candy weight in pounds and kilograms, select apothecary jar height configurations, assign stainless scoops, and provide 4x6 favor bags with a 15% spill buffer."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Export Printable 'Love is Sweet' Signs & Bakery Briefs",
          "text": "Generate printable 8x10 and 5x7 framed signs, foldable dietary food cards (Gluten-Free, Vegan, Nut-Free), and a formatted Master Bakery Order Sheet in PDF and Word."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How many mini desserts do you need per person at a wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If you are serving a traditional wedding cake alongside the dessert table, plan for 2 to 3 bite-size mini desserts per guest. If the dessert bar is the sole sweet course (in lieu of wedding cake), plan for 4 to 6 bite-size desserts per guest so each attendee can sample multiple flavor varieties."
          }
        },
        {
          "@type": "Question",
          "name": "How many different dessert varieties should be on a wedding dessert table?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Follow the industry variety rule: For 50–75 guests, offer 3 to 4 dessert varieties. For 75–125 guests, offer 4 to 5 varieties. For 125–200 guests, offer 5 to 7 varieties. For 200+ guests, offer 6 to 8 varieties. Offering more than 8 varieties causes choice paralysis, creates bottlenecks around the table, and increases bakery setup fees."
          }
        },
        {
          "@type": "Question",
          "name": "How many pounds of candy do you need for a wedding candy buffet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan for 0.25 to 0.35 pounds (4 to 6 ounces / 115g to 170g) of bulk candy per guest. For 100 guests, that equals 25 to 35 lbs (11.5 to 16 kg) of candy distributed across 6 to 8 apothecary jars of varied heights. If you provide large takeaway favor bags (5x7 inches or bigger), increase candy by 25% to avoid bare jars early in the evening."
          }
        },
        {
          "@type": "Question",
          "name": "What is the tradition of the Pittsburgh Wedding Cookie Table and how many cookies per guest are needed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Pittsburgh / Italian-American Cookie Table is a beloved wedding tradition where family and friends bake dozens of homemade cookies (such as pizzelles, ladylocks, nut rolls, thumbprints, and biscotti). Tradition calls for 6 to 8 cookies per guest for eating during the reception, plus an additional 4 to 6 cookies per guest to fill take-home favor boxes."
          }
        },
        {
          "@type": "Question",
          "name": "What dessert table items melt or spoil in warm outdoor wedding weather?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Real dairy buttercream begins softening at 75°F (24°C) and melts completely at 82°F (28°C). Chocolate truffles, ganache tarts, and mousse shooters should not be displayed in direct sunlight or temperatures above 72°F (22°C). French macarons are sensitive to humidity and become soggy, while cannoli shells lose crispness if filled more than 2 hours prior to display. In warm weather, opt for glazed cookies, royal icing sugar cookies, cake pops, brownies, and hard candies."
          }
        },
        {
          "@type": "Question",
          "name": "How should dietary restrictions and allergens be labeled on a wedding dessert table?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Place clear, foldable food tent cards directly in front of each platter indicating dessert name and allergen icons: Gluten-Free (GF), Vegan (V), Dairy-Free (DF), Nut-Free (NF), and Contains Alcohol. To prevent cross-contamination, place dedicated allergen-friendly platters (especially nut-free and gluten-free items) on separate elevated risers with individual serving tongs."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Dessert Table, Candy Bar & Cookie Sizer (Free PDF Signs & Bakery Order) | Manage.Wedding"
	description="Calculate bite-size dessert counts, bulk candy bar pounds, apothecary jar sizing, and Pittsburgh cookie table dozens. Includes printable 8x10 signs, dietary tent cards, and master bakery order sheets in PDF & Word."
	schema={schema}
>
	<main style="max-width: 1240px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		<Breadcrumb title="Dessert Table & Candy Bar Sizer" category="food-dining" />
		
		<!-- Hero Section -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 960px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 20px; padding: 4px 14px; margin-bottom: 1rem; box-shadow: 2px 2px 0px var(--fg-pencil); transform: rotate(-0.5deg);">
					<span style="font-size: 1rem;">🧁</span>
					<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">100% Free • Interactive Sizing • 1-Click Printable PDF Signs & Bakery Orders</span>
				</div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Wedding Dessert Table, Candy Bar & Cookie Sizer
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); max-width: 760px; margin: 0 auto; text-align: center;">
					Calculate exact bite-size dessert quantities, bulk candy buffet weights, apothecary jar configurations, and bakery dozen orders. Customize variety mixes, design printable <strong>8x10 & 5x7 "Love is Sweet" Signs</strong>, dietary tent cards, and export your <strong>Master Bakery Order Sheet</strong> in PDF and Word!
				</p>
			</div>
		</section>

		<!-- Editorial Guide Interlink Banner -->
		<div style="background: #fef3c7; border: 2px solid #d97706; border-radius: 8px; padding: 1rem 1.5rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; box-shadow: 2px 2px 0px #d97706;">
			<div style="display: flex; align-items: center; gap: 0.75rem;">
				<span style="font-size: 1.5rem;">🧁</span>
				<div>
					<strong style="color: #92400e; font-size: 0.95rem; display: block;">Wondering How Many Mini Treats to Order Per Guest?</strong>
					<span style="color: #78350f; font-size: 0.88rem;">Read our comprehensive guide on <a href="/wedding-dessert-table-ideas-treats-per-guest" style="color: #92400e; text-decoration: underline; font-weight: 700;">Wedding Dessert Table Ideas: How Many Treats Per Guest (The 3.5x Formula)</a>.</span>
				</div>
			</div>
			<a href="/wedding-dessert-table-ideas-treats-per-guest" style="background: #b45309; color: #fff; text-decoration: none; font-weight: 700; font-size: 0.85rem; padding: 6px 14px; border-radius: 6px; border: 1px solid #78350f; white-space: nowrap;">
				Read Guide &rarr;
			</a>
		</div>

		<!-- 3-Step Quick Guide -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>✨</span> How to Size Your Wedding Sweet Table in 3 Easy Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Choose Service Format
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Select whether desserts complement a traditional wedding cake (2–3 pcs/guest), replace cake entirely (4–6 pcs/guest), or feature a Pittsburgh Cookie Table or Candy Bar.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Balance Variety & Dozens
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Select your favorite pastries (macarons, tartlets, shooters, cannoli) and let our auto-balancer calculate exact baker dozens with zero waste.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Print Signs & Order Sheet
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Generate framed table signs (8x10 / 5x7), dietary allergen food flags, and download a ready-to-send Master Bakery Brief in PDF & Word.
					</p>
				</div>
			</div>
		</div>

		<!-- Interactive Application Workspace -->
		<div style="display: grid; grid-template-columns: 1fr; gap: 2rem; margin-bottom: 3.5rem;">
			
			<!-- SECTION 1: Format & Guest Headcount Setup -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🍰 1. Event Setup & Dessert Table Format
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Set your RSVP guest count, sweet tooth intensity, and dessert service style
						</span>
					</div>
					<span id="badge-variety-rec" class="badge-postit" style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); padding: 4px 10px; border: 1.5px solid var(--fg-pencil); border-radius: 6px;">
						Recommended: 4–5 Varieties
					</span>
				</div>

				<!-- Format Mode Selector Tabs -->
				<div style="margin-bottom: 1.5rem;">
					<label class="font-heading" style="display: block; margin-bottom: 0.5rem; font-size: 1rem; color: var(--fg-pencil);">
						Select Primary Dessert Format:
					</label>
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.75rem;" id="format-tabs-container">
						
						<label class="format-tab active" data-format="with-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fef08a; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="with-cake" checked style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🎂 + 🧁</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Alongside Cake</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">2–3 bite items/guest</span>
						</label>

						<label class="format-tab" data-format="no-cake" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="no-cake" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🧁✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">In Lieu of Cake</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">4–6 bite items/guest</span>
						</label>

						<label class="format-tab" data-format="cookie-table" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="cookie-table" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍪📦</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Cookie Table</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">6–8 cookies + take-home</span>
						</label>

						<label class="format-tab" data-format="candy-buffet" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="candy-buffet" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">🍬🍭</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Candy Buffet</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">0.25–0.35 lbs / guest</span>
						</label>

						<label class="format-tab" data-format="hybrid" style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem; cursor: pointer; background: #fff; transition: all 0.2s ease; display: block; text-align: center;">
							<input type="radio" name="dessertFormat" value="hybrid" style="display: none;">
							<span style="font-size: 1.3rem; display: block; margin-bottom: 0.2rem;">👑✨</span>
							<strong class="font-heading" style="display: block; font-size: 0.95rem; color: var(--fg-pencil);">Grand Hybrid Bar</strong>
							<span class="font-body" style="font-size: 0.75rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">Pastries + Candy + Favors</span>
						</label>
					</div>
				</div>

				<!-- Guest Count & Appetite Controls -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
					
					<!-- Guest Count Slider -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
							<label for="input-guests" class="font-heading" style="font-size: 1rem; color: var(--fg-pencil);">
								👥 Guest Headcount:
							</label>
							<span id="badge-guests" class="font-heading" style="background: var(--accent-blue); color: #fff; padding: 2px 10px; border-radius: 12px; font-size: 0.9rem;">
								100 Guests
							</span>
						</div>
						<input type="range" id="slider-guests" min="20" max="400" step="5" value="100" style="width: 100%; margin-bottom: 0.5rem; accent-color: var(--accent-blue);">
						<div style="display: flex; align-items: center; gap: 0.5rem;">
							<input type="number" id="input-guests" min="10" max="1000" value="100" class="form-input" style="width: 100%; padding: 0.5rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 1rem; font-weight: 600; background: #fff;">
						</div>
					</div>

					<!-- Sweet Tooth / Appetite Multiplier -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
						<label for="select-appetite" class="font-heading" style="display: block; font-size: 1rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
							🍽️ Crowd Appetite & Dinner Context:
						</label>
						<select id="select-appetite" style="width: 100%; padding: 0.6rem 0.75rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.95rem; font-weight: 600; background: #fff; margin-bottom: 0.5rem;">
							<option value="light">Light Appetite (After heavy 4-course plated dinner & wine)</option>
							<option value="standard" selected>Standard Crowd (Balanced 2.5 pcs / 4.5 oz candy)</option>
							<option value="generous">Generous Sweet Tooth (Late-night dancing & sugar lovers)</option>
						</select>
						<div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
							<input type="checkbox" id="chk-takeaway-favors" style="width: 18px; height: 18px; accent-color: var(--accent-blue);">
							<label for="chk-takeaway-favors" class="font-body" style="font-size: 0.85rem; color: var(--fg-pencil); cursor: pointer;">
								<strong>Include Takeaway Favor Boxes</strong> (+2 pieces / +3 oz candy per guest)
							</label>
						</div>
					</div>

				</div>

				<!-- Live Dynamic Top Stat Badges Grid -->
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem;">
					
					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Total Bite Pieces</span>
						<strong id="stat-total-pieces" class="font-heading" style="font-size: 1.8rem; color: var(--accent-red); line-height: 1.2;">250</strong>
						<span id="stat-pieces-per-guest" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(2.5 pcs / guest)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Baker Dozens</span>
						<strong id="stat-total-dozens" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); line-height: 1.2;">21 Doz</strong>
						<span id="stat-exact-dozens" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(252 total units)</span>
					</div>

					<div style="text-align: center; border-right: 1px dashed #cbd5e1; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Bulk Candy Weight</span>
						<strong id="stat-total-candy" class="font-heading" style="font-size: 1.8rem; color: #16a34a; line-height: 1.2;">28 lbs</strong>
						<span id="stat-candy-kg" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(~12.7 kg / 6–8 Jars)</span>
					</div>

					<div style="text-align: center; padding: 0.25rem;">
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-secondary); display: block;">Table Staging</span>
						<strong id="stat-table-size" class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); line-height: 1.2;">6–8 ft Table</strong>
						<span id="stat-napkins-count" style="font-size: 0.75rem; color: var(--text-secondary); display: block;">150 mini cocktail napkins</span>
					</div>

				</div>
			</div>

			<!-- SECTION 2: Custom Dessert Variety & Baker Dozen Allocation -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							🧁 2. Dessert Variety & Baker Dozen Allocator
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block;">
							Toggle items, adjust piece counts, and view exact bakery order dozens with allergen tags
						</span>
					</div>
					<div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
						<button type="button" id="btn-auto-balance" class="hand-btn" style="background: var(--post-it); font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 700; display: inline-flex; align-items: center; gap: 0.3rem;">
							<span>⚖️</span> Auto-Balance Variety
						</button>
						<button type="button" id="btn-reset-varieties" class="hand-btn" style="background: #fff; font-size: 0.85rem; padding: 0.4rem 0.85rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; cursor: pointer; font-weight: 600;">
							🔄 Reset Defaults
						</button>
					</div>
				</div>

				<!-- Variety Allocation Status Bar -->
				<div style="margin-bottom: 1.25rem; background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; font-size: 0.85rem;">
