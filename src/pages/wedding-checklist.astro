---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Checklist & 12-Month Task Manager",
      "url": "https://manage.wedding/wedding-checklist",
      "description": "Free interactive 12-month wedding checklist and task manager. Track planning milestones, save progress to browser storage, and ensure nothing is forgotten.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "When should I start using a wedding checklist?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You should start using a wedding checklist ideally 12 to 14 months before your desired wedding date. This gives you ample time to secure high-demand vendors and venues without feeling rushed."
          }
        },
        {
          "@type": "Question",
          "name": "Does this wedding checklist save my progress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Our wedding checklist automatically saves your checked tasks directly to your browser's local storage. Whenever you return to this page, your progress bar and checked items will be exactly as you left them."
          }
        },
        {
          "@type": "Question",
          "name": "What are the first things I need to book?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The very first things on your wedding checklist should be determining your budget, estimating a guest count, and booking your venue. Venue availability often dictates your final wedding date."
          }
        },
        {
          "@type": "Question",
          "name": "How do I track smaller details?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our massive 12-month categorized task manager breaks down the timeline into smaller chunks. Focus on the current month's tasks so you aren't overwhelmed by the smaller details that happen closer to the big day."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Plan Your Wedding Using a 12-Month Timeline Checklist",
      "description": "Step-by-step master checklist workflow for organizing a complete wedding from engagement to day-of execution.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Phase 1 (12+ Months): Budget, Guest List & Venue",
          "text": "Determine your total budget, draft your initial guest count, set a tentative date, and book your primary ceremony/reception venue."
        },
        {
          "@type": "HowToStep",
          "name": "Phase 2 (9–10 Months): Major Vendors & Attire",
          "text": "Hire high-demand vendors including your photographer, videographer, caterer, and band/DJ, and begin wedding dress shopping."
        },
        {
          "@type": "HowToStep",
          "name": "Phase 3 (6–7 Months): Save-the-Dates & Florals",
          "text": "Mail save-the-date cards, book your florist, order bridesmaid dresses, and reserve hotel blocks and honeymoon travel."
        },
        {
          "@type": "HowToStep",
          "name": "Phase 4 (3–4 Months): Invitations, Cake & Rings",
          "text": "Order and address wedding invitations, order the cake, purchase wedding bands, and schedule hair and makeup trials."
        },
        {
          "@type": "HowToStep",
          "name": "Phase 5 (1–2 Months): RSVPs & Marriage License",
          "text": "Mail formal invitations (8 weeks out), collect RSVPs, apply for your marriage license, and conduct final dress fittings."
        },
        {
          "@type": "HowToStep",
          "name": "Phase 6 (Day-Of & Week-Of): Execution & Celebration",
          "text": "Finalize seating charts, hand vendor tips to a trusted helper, attend rehearsal dinner, and enjoy your wedding day!"
        }
      ]
    }
  ]
};

const tasks = [
  {
    month: "12+ Months Before",
    items: [
      "Determine your budget",
      "Draft a rough guest list",
      "Choose a wedding date",
      "Hire a wedding planner (optional)",
      "Book your venue"
    ]
  },
  {
    month: "10-11 Months Before",
    items: [
      "Choose your wedding party",
      "Hire a photographer and videographer",
      "Book an officiant",
      "Start shopping for wedding attire"
    ]
  },
  {
    month: "8-9 Months Before",
    items: [
      "Book caterer and tastings",
      "Hire a band or DJ",
      "Register for gifts",
      "Reserve hotel blocks for guests"
    ]
  },
  {
    month: "6-7 Months Before",
    items: [
      "Purchase wedding attire",
      "Book florist",
      "Send save-the-dates",
      "Plan the honeymoon",
      "Order bridesmaids dresses"
    ]
  },
  {
    month: "4-5 Months Before",
    items: [
      "Book rehearsal dinner venue",
      "Order wedding cake",
      "Buy wedding bands",
      "Book hair and makeup artists",
      "Finalize guest list"
    ]
  },
  {
    month: "3 Months Before",
    items: [
      "Order wedding invitations",
      "Finalize menu and bar",
      "Rent groom/groomsmen attire",
      "Purchase guest favors"
    ]
  },
  {
    month: "2 Months Before",
    items: [
      "Send wedding invitations",
      "Write vows",
      "Purchase wedding party gifts",
      "Do a hair and makeup trial"
    ]
  },
  {
    month: "1 Month Before",
    items: [
      "Apply for marriage license",
      "Have final dress fitting",
      "Create seating chart",
      "Finalize timelines with vendors"
    ]
  },
  {
    month: "2 Weeks Before",
    items: [
      "Give final head count to caterer",
      "Review final shot list with photographer",
      "Get haircut and color"
    ]
  },
  {
    month: "1 Week Before",
    items: [
      "Pack for honeymoon",
      "Practice your vows out loud",
      "Give vendor payments to a trusted friend",
      "Get a manicure and pedicure"
    ]
  },
  {
    month: "The Day Before",
    items: [
      "Attend wedding rehearsal",
      "Enjoy the rehearsal dinner",
      "Get a good night's sleep"
    ]
  },
  {
    month: "Wedding Day",
    items: [
      "Eat a good breakfast",
      "Give rings to the best man",
      "Get married!"
    ]
  }
];

---

<Layout 
	title="Wedding Checklist & Task Manager (Free & Instant Results)"
	description="Our massive 12-month wedding checklist helps you plan every detail. Save your progress and stay organized with this free interactive tool."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<header class="fade-in category-header" style="text-align: center;">
			<h1 class="font-heading" style="font-size: 3.5rem; margin-bottom: 0.5rem; font-weight: 500;">Wedding <span class="accent-italic">Checklist</span></h1>
			<p class="font-body" style="color: var(--secondary-ink); max-width: 600px; margin: 0 auto;">Keep track of everything with our massive 12-month categorized task manager.</p>
		</header>

		<div class="home-grid fade-in" style="animation-delay: 0.2s; max-width: 900px; margin: 0 auto;">
            
			<div class="hand-card result-box" style="margin-bottom: 2rem;">
				<h3 class="font-heading" style="margin-bottom: 1rem; text-align: center;">Total Completion</h3>
				
                <div style="width: 100%; border: 2px solid var(--fg-pencil); height: 30px; position: relative; overflow: hidden; background: var(--bg-paper);">
                    <div id="progress-bar-fill" style="width: 0%; height: 100%; background-color: var(--fg-pencil); transition: width 0.3s ease;"></div>
                    <div id="progress-text" class="font-heading" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--bg-paper); mix-blend-mode: difference;">0%</div>
                </div>
			</div>

			<div class="hand-card">
				<form id="checklist-form">
                    {tasks.map((category, catIndex) => (
                        <div class="checklist-category" style="margin-bottom: 2rem;">
                            <h3 class="font-heading" style="margin-bottom: 1rem; border-bottom: 1px dashed var(--fg-pencil); padding-bottom: 0.5rem;">{category.month}</h3>
                            {category.items.map((item, itemIndex) => (
                                <label style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; cursor: pointer; font-family: var(--font-body);">
                                    <input 
                                        type="checkbox" 
                                        class="task-checkbox" 
                                        data-id={`task-${catIndex}-${itemIndex}`}
                                        style="width: 1.2rem; height: 1.2rem; accent-color: var(--fg-pencil); cursor: pointer;"
                                    />
                                    <span>{item}</span>
                                </label>
                            ))}
                        </div>
                    ))}
				</form>
			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="max-width: 900px; margin: 0 auto 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ BLUF Rule of Thumb</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Quick Rule of Thumb: 12-Month Countdown Milestones
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>The 1-Minute Core Formula:</strong> Divide your wedding journey into <strong>6 distinct milestone phases</strong>: <strong>12+ Months</strong> (Venue, Budget & Total Guest Count), <strong>9–10 Months</strong> (Priority 1 Vendors & Dress), <strong>6–7 Months</strong> (Save-the-Dates & Florals), <strong>3–4 Months</strong> (Invitations & Rings), <strong>1–2 Months</strong> (Marriage License & RSVPs), and <strong>Day-Of</strong> (Execution & Vows).
			</p>
			
			<!-- Benchmark Milestone Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Milestone Phase</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Countdown Window</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Top Non-Negotiable Tasks</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Risk If Delayed</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">1. Foundation</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">12+ Months Out</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Set max budget, rough guest list, book venue</td>
							<td style="padding: 0.6rem 0.8rem; color: var(--accent-red); font-weight: 600;">Prime Saturday dates sell out 12-18 mos early</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">2. Core Vendors</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">9–10 Months Out</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Photo/video, caterer, DJ/band, start dress shopping</td>
							<td style="padding: 0.6rem 0.8rem;">Bridal gowns require 6–9 months to manufacture</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">3. Guest Engagement</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">6–7 Months Out</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Mail Save-the-Dates, hotel blocks, bridesmaid dresses</td>
							<td style="padding: 0.6rem 0.8rem;">Guests book other travel or hotel prices double</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0; background: #fdfbf7;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">4. Logistics & Details</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">3–4 Months Out</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Order invitations, cake, rings, hair/makeup trial</td>
							<td style="padding: 0.6rem 0.8rem;">Rush fees for printing & custom ring sizing</td>
						</tr>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">5. Final Countdown</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">1–2 Months Out</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Mail invites (8 wks), marriage license, dress fittings</td>
							<td style="padding: 0.6rem 0.8rem;">Marriage license expiration / caterer headcounts</td>
						</tr>
						<tr>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">6. Big Day & Week-Of</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Final 1–2 Weeks</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">Seating chart, tips in labeled envelopes, rehearse</td>
							<td style="padding: 0.6rem 0.8rem; color: #16a34a; font-weight: 600;">Stress-free execution & unforgettable memories</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

        <article class="hand-card" style="max-width: 900px; margin: 3rem auto;">
            <h2 class="font-heading" style="font-size: 2.5rem; margin-bottom: 1.5rem;">The Ultimate 12-Month Wedding Checklist</h2>
            
            <p class="font-body" style="margin-bottom: 1.5rem; line-height: 1.6;">Planning a wedding can feel like a monumental task, but it doesn't have to be overwhelming. Breaking down the process into manageable, bite-sized tasks is the secret to staying sane. Our free interactive wedding checklist acts as your personal project manager, guiding you month by month through the entire journey. Whether you are 12 months out or just weeks away, this guide ensures nothing slips through the cracks.</p>
            
            <img src="/images/clipboard_sketch.webp" alt="Wedding Checklist — 12-Month Countdown Task Manager" loading="lazy" decoding="async" style="width: 100%; max-width: 500px; margin: 2rem auto; display: block; border: 2px solid var(--fg-pencil);" />
            
            <h3 class="font-heading" style="font-size: 1.8rem; margin-bottom: 1rem;">Why Use a Digital Task Manager?</h3>
            <p class="font-body" style="margin-bottom: 1.5rem; line-height: 1.6;">A physical binder is great, but a digital task manager allows you to instantly track your progress. As you check off items like booking your venue or finalizing the guest list, the progress bar gives you a satisfying visual representation of your accomplishments. Your browser saves your progress automatically, so you can close the window and pick right back up where you left off!</p>
            
            <h3 class="font-heading" style="font-size: 1.8rem; margin-bottom: 1rem;">Key Milestones Not to Miss</h3>
            <p class="font-body" style="margin-bottom: 1.5rem; line-height: 1.6;">Certain tasks are time-sensitive. Securing your venue and primary vendors (photographer, caterer) should happen as soon as possible. Later on, your focus shifts to details like dress fittings, finalizing timelines, and sending out invitations. Using this checklist guarantees you hit these crucial deadlines with time to spare.</p>

            <div style="margin-top: 3rem;">
                <h3 class="font-heading" style="font-size: 2rem; margin-bottom: 1.5rem;">Frequently Asked Questions</h3>
                
                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">When should I start using a wedding checklist?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">You should start using a wedding checklist ideally 12 to 14 months before your desired wedding date. This gives you ample time to secure high-demand vendors and venues without feeling rushed.</p>
                </details>
                
                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">Does this wedding checklist save my progress?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">Yes! Our wedding checklist automatically saves your checked tasks directly to your browser's local storage. Whenever you return to this page, your progress bar and checked items will be exactly as you left them.</p>
                </details>

                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">What are the first things I need to book?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">The very first things on your wedding checklist should be determining your budget, estimating a guest count, and booking your venue. Venue availability often dictates your final wedding date.</p>
                </details>
                
                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">How do I track smaller details?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">Our massive 12-month categorized task manager breaks down the timeline into smaller chunks. Focus on the current month's tasks so you aren't overwhelmed by the smaller details that happen closer to the big day.</p>
                </details>
            </div>
        </article>
	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const checkboxes = document.querySelectorAll('.task-checkbox');
		const progressBarFill = document.getElementById('progress-bar-fill');
        const progressText = document.getElementById('progress-text');
        
        const STORAGE_KEY = 'wedding_checklist_tasks';

        // Load saved state
        const loadState = () => {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    checkboxes.forEach((cb) => {
                        if (parsed.includes(cb.dataset.id)) {
                            cb.checked = true;
                        }
                    });
                } catch(e) {
                    console.error("Error parsing saved checklist tasks", e);
                }
            }
            updateProgress();
        };

        // Save current state
        const saveState = () => {
            const checkedIds = Array.from(checkboxes)
                .filter(cb => cb.checked)
                .map(cb => cb.dataset.id);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(checkedIds));
        };

        // Update progress bar
        const updateProgress = () => {
            const total = checkboxes.length;
            const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
            
            if (total === 0) return;

            const percentage = Math.round((checkedCount / total) * 100);
            
            if(progressBarFill) {
                progressBarFill.style.width = `${percentage}%`;
            }
            if(progressText) {
                progressText.textContent = `${percentage}%`;
            }
        };

        // Event listeners
        checkboxes.forEach(cb => {
            cb.addEventListener('change', () => {
                saveState();
                updateProgress();
            });
        });

        loadState();
	});
</script>
