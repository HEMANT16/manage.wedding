---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": ["WebApplication", "CalculatorApplication"],
  "name": "Wedding Checklist & Task Manager",
  "url": "https://manage.wedding/wedding-checklist",
  "description": "Our massive 12-month wedding checklist helps you plan every detail. Save your progress and stay organized with this free interactive tool.",
  "applicationCategory": "CalculatorApplication",
  "operatingSystem": "Any"
};

const tasks = [
  {
    month: "12+ Months Before",
    items: [
      "Determine your budget",
      "Draft a rough guest list",
      "Choose a wedding date",
      "Hire a wedding planner (optional)",
      "Book your venue"
    ]
  },
  {
    month: "10-11 Months Before",
    items: [
      "Choose your wedding party",
      "Hire a photographer and videographer",
      "Book an officiant",
      "Start shopping for wedding attire"
    ]
  },
  {
    month: "8-9 Months Before",
    items: [
      "Book caterer and tastings",
      "Hire a band or DJ",
      "Register for gifts",
      "Reserve hotel blocks for guests"
    ]
  },
  {
    month: "6-7 Months Before",
    items: [
      "Purchase wedding attire",
      "Book florist",
      "Send save-the-dates",
      "Plan the honeymoon",
      "Order bridesmaids dresses"
    ]
  },
  {
    month: "4-5 Months Before",
    items: [
      "Book rehearsal dinner venue",
      "Order wedding cake",
      "Buy wedding bands",
      "Book hair and makeup artists",
      "Finalize guest list"
    ]
  },
  {
    month: "3 Months Before",
    items: [
      "Order wedding invitations",
      "Finalize menu and bar",
      "Rent groom/groomsmen attire",
      "Purchase guest favors"
    ]
  },
  {
    month: "2 Months Before",
    items: [
      "Send wedding invitations",
      "Write vows",
      "Purchase wedding party gifts",
      "Do a hair and makeup trial"
    ]
  },
  {
    month: "1 Month Before",
    items: [
      "Apply for marriage license",
      "Have final dress fitting",
      "Create seating chart",
      "Finalize timelines with vendors"
    ]
  },
  {
    month: "2 Weeks Before",
    items: [
      "Give final head count to caterer",
      "Review final shot list with photographer",
      "Get haircut and color"
    ]
  },
  {
    month: "1 Week Before",
    items: [
      "Pack for honeymoon",
      "Practice your vows out loud",
      "Give vendor payments to a trusted friend",
      "Get a manicure and pedicure"
    ]
  },
  {
    month: "The Day Before",
    items: [
      "Attend wedding rehearsal",
      "Enjoy the rehearsal dinner",
      "Get a good night's sleep"
    ]
  },
  {
    month: "Wedding Day",
    items: [
      "Eat a good breakfast",
      "Give rings to the best man",
      "Get married!"
    ]
  }
];

---

<Layout 
	title="Wedding Checklist & Task Manager (Free & Instant Results)"
	description="Our massive 12-month wedding checklist helps you plan every detail. Save your progress and stay organized with this free interactive tool."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
		<header class="fade-in category-header" style="text-align: center;">
			<h1 class="font-heading" style="font-size: 3.5rem; margin-bottom: 0.5rem; font-weight: 500;">Wedding <span class="accent-italic">Checklist</span></h1>
			<p class="font-body" style="color: var(--secondary-ink); max-width: 600px; margin: 0 auto;">Keep track of everything with our massive 12-month categorized task manager.</p>
		</header>

		<div class="home-grid fade-in" style="animation-delay: 0.2s; max-width: 900px; margin: 0 auto;">
            
			<div class="hand-card result-box" style="margin-bottom: 2rem;">
				<h3 class="font-heading" style="margin-bottom: 1rem; text-align: center;">Total Completion</h3>
				
                <div style="width: 100%; border: 2px solid var(--fg-pencil); height: 30px; position: relative; overflow: hidden; background: var(--bg-paper);">
                    <div id="progress-bar-fill" style="width: 0%; height: 100%; background-color: var(--fg-pencil); transition: width 0.3s ease;"></div>
                    <div id="progress-text" class="font-heading" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--bg-paper); mix-blend-mode: difference;">0%</div>
                </div>
			</div>

			<div class="hand-card">
				<form id="checklist-form">
                    {tasks.map((category, catIndex) => (
                        <div class="checklist-category" style="margin-bottom: 2rem;">
                            <h3 class="font-heading" style="margin-bottom: 1rem; border-bottom: 1px dashed var(--fg-pencil); padding-bottom: 0.5rem;">{category.month}</h3>
                            {category.items.map((item, itemIndex) => (
                                <label style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; cursor: pointer; font-family: var(--font-body);">
                                    <input 
                                        type="checkbox" 
                                        class="task-checkbox" 
                                        data-id={`task-${catIndex}-${itemIndex}`}
                                        style="width: 1.2rem; height: 1.2rem; accent-color: var(--fg-pencil); cursor: pointer;"
                                    />
                                    <span>{item}</span>
                                </label>
                            ))}
                        </div>
                    ))}
				</form>
			</div>

		</div>

        <article class="hand-card" style="max-width: 900px; margin: 3rem auto;">
            <h2 class="font-heading" style="font-size: 2.5rem; margin-bottom: 1.5rem;">The Ultimate 12-Month Wedding Checklist</h2>
            
            <p class="font-body" style="margin-bottom: 1.5rem; line-height: 1.6;">Planning a wedding can feel like a monumental task, but it doesn't have to be overwhelming. Breaking down the process into manageable, bite-sized tasks is the secret to staying sane. Our free interactive wedding checklist acts as your personal project manager, guiding you month by month through the entire journey. Whether you are 12 months out or just weeks away, this guide ensures nothing slips through the cracks.</p>
            
            <img src="/images/clipboard_sketch.jpg" alt="A pure B&W ink sketch of a clipboard used for a 12-month categorized wedding checklist and task manager" style="width: 100%; max-width: 500px; margin: 2rem auto; display: block; border: 2px solid var(--fg-pencil);" />
            
            <h3 class="font-heading" style="font-size: 1.8rem; margin-bottom: 1rem;">Why Use a Digital Task Manager?</h3>
            <p class="font-body" style="margin-bottom: 1.5rem; line-height: 1.6;">A physical binder is great, but a digital task manager allows you to instantly track your progress. As you check off items like booking your venue or finalizing the guest list, the progress bar gives you a satisfying visual representation of your accomplishments. Your browser saves your progress automatically, so you can close the window and pick right back up where you left off!</p>
            
            <h3 class="font-heading" style="font-size: 1.8rem; margin-bottom: 1rem;">Key Milestones Not to Miss</h3>
            <p class="font-body" style="margin-bottom: 1.5rem; line-height: 1.6;">Certain tasks are time-sensitive. Securing your venue and primary vendors (photographer, caterer) should happen as soon as possible. Later on, your focus shifts to details like dress fittings, finalizing timelines, and sending out invitations. Using this checklist guarantees you hit these crucial deadlines with time to spare.</p>

            <div style="margin-top: 3rem;">
                <h3 class="font-heading" style="font-size: 2rem; margin-bottom: 1.5rem;">Frequently Asked Questions</h3>
                
                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">When should I start using a wedding checklist?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">You should start using a wedding checklist ideally 12 to 14 months before your desired wedding date. This gives you ample time to secure high-demand vendors and venues without feeling rushed.</p>
                </details>
                
                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">Does this wedding checklist save my progress?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">Yes! Our wedding checklist automatically saves your checked tasks directly to your browser's local storage. Whenever you return to this page, your progress bar and checked items will be exactly as you left them.</p>
                </details>

                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">What are the first things I need to book?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">The very first things on your wedding checklist should be determining your budget, estimating a guest count, and booking your venue. Venue availability often dictates your final wedding date.</p>
                </details>
                
                <details style="margin-bottom: 1rem; border-bottom: 1px solid var(--fg-pencil); padding-bottom: 0.5rem;">
                    <summary class="font-heading" style="font-size: 1.2rem; cursor: pointer; list-style-type: '👉 '; margin-bottom: 0.5rem;">How do I track smaller details?</summary>
                    <p class="font-body" style="padding-left: 1.5rem; margin-top: 0.5rem; line-height: 1.5;">Our massive 12-month categorized task manager breaks down the timeline into smaller chunks. Focus on the current month's tasks so you aren't overwhelmed by the smaller details that happen closer to the big day.</p>
                </details>
            </div>
        </article>
	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const checkboxes = document.querySelectorAll('.task-checkbox');
		const progressBarFill = document.getElementById('progress-bar-fill');
        const progressText = document.getElementById('progress-text');
        
        const STORAGE_KEY = 'wedding_checklist_tasks';

        // Load saved state
        const loadState = () => {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    checkboxes.forEach((cb) => {
                        if (parsed.includes(cb.dataset.id)) {
                            cb.checked = true;
                        }
                    });
                } catch(e) {
                    console.error("Error parsing saved checklist tasks", e);
                }
            }
            updateProgress();
        };

        // Save current state
        const saveState = () => {
            const checkedIds = Array.from(checkboxes)
                .filter(cb => cb.checked)
                .map(cb => cb.dataset.id);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(checkedIds));
        };

        // Update progress bar
        const updateProgress = () => {
            const total = checkboxes.length;
            const checkedCount = Array.from(checkboxes).filter(cb => cb.checked).length;
            
            if (total === 0) return;

            const percentage = Math.round((checkedCount / total) * 100);
            
            if(progressBarFill) {
                progressBarFill.style.width = `${percentage}%`;
            }
            if(progressText) {
                progressText.textContent = `${percentage}%`;
            }
        };

        // Event listeners
        checkboxes.forEach(cb => {
            cb.addEventListener('change', () => {
                saveState();
                updateProgress();
            });
        });

        loadState();
	});
</script>
