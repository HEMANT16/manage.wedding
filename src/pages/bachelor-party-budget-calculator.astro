---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/bachelor-party-budget-calculator/#webapp",
      "name": "Bachelor Party Budget & Cost Splitter",
      "url": "https://manage.wedding/bachelor-party-budget-calculator",
      "description": "Free bachelor party budget calculator and expense splitter. Calculates exact per-guy costs for Airbnb, golf, boat rentals, steak dinners, nightlife, and booze while covering the groom. Export Venmo payment requests, Word documents, and PDF itineraries.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Plan and Split Bachelor Party Expenses Fairly",
      "description": "Step-by-step best man guide to setting a bachelor party budget, splitting costs fairly, and collecting deposits without chasing attendees.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Set Headcount & Decide on Covering the Groom",
          "text": "Count total attendees and confirm that the groomsmen will evenly split the groom's lodging, meals, and activities (standard N-1 cost split)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Lock Shared Lodging and Transport",
          "text": "Calculate non-negotiable group fixed costs: large Airbnb/villa rental, rental SUV/van, airport shuttles, and initial grocery run."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Estimate Group Activities and Nightlife",
          "text": "Add budgeted estimates for golf tee times, chartered boats, brewery tours, group steak dinners, and club VIP tables."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Collect Upfront Deposit via Venmo/Zelle",
          "text": "Send an itemized payment schedule: collect a 50% deposit 3-6 months ahead to secure lodging, and collect the final balance 2 weeks before departure."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does the groom pay for his own bachelor party?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In standard modern bachelor party etiquette, the groom does NOT pay for his share of group lodging, activities, dinners, or drinks—these expenses are split evenly among the groomsmen and attending guests (the N-1 split rule). The groom traditionally pays only for his own personal flights or individual transportation to the destination."
          }
        },
        {
          "@type": "Question",
          "name": "How much does the average bachelor party cost per person?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The average domestic destination bachelor party (e.g., Las Vegas, Austin, Scottsdale, Miami) costs between $850 and $1,450 per guy for a 3-night weekend, including lodging, meals, activities, alcohol, and covering the groom. A local cabin or staycation weekend averages $300 to $550 per person."
          }
        },
        {
          "@type": "Question",
          "name": "When should the Best Man collect money for the bachelor party?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Collect Deposit #1 (50% of the estimated total to lock the Airbnb and major excursions) 3 to 6 months before the trip. Collect Deposit #2 (the remaining 50% for dinners, groceries, and nightlife) 2 to 3 weeks before departure. Never book non-refundable reservations on your personal card without receiving deposits first."
          }
        },
        {
          "@type": "Question",
          "name": "How do you handle a guy who cannot afford the bachelor party trip?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Send an anonymous budget survey before picking a destination. If an attendee cannot afford the full multi-day trip, invite him to join for a single day/event (e.g., Saturday dinner and golf), or allow him to chip in a voluntary flat amount ($50-$100) toward the groom's steak dinner or bar tab."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Bachelor Party Budget Calculator & Cost Splitter (Cover the Groom)"
	description="Free bachelor party budget calculator and expense splitter. Calculates exact per-guy costs for Airbnb, golf, boat rentals, steak dinners, nightlife, and booze while covering the groom. Export Venmo payment requests, Word doc, and PDF."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		<Breadcrumb title="Bachelor Party Budget Splitter" category="budget-finance" />
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Cover the Groom & Venmo Splitter</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Bachelor Party Budget <span class="accent-italic">& Cost Splitter</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Calculate exact per-guy shares for Airbnb villas, tee times, boat charters, steak dinners, and nightlife. Automatically cover the groom's tab and export instant Venmo & WhatsApp payment requests.
			</p>
		</header>

		<!-- Main Interactive Studio Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Trip Setup & Categorized Expense Inputs -->
			<div class="hand-card" style="padding: clamp(1.25rem, 3vw, 2.25rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.45rem; margin: 0; color: var(--fg-pencil);">
						Trip Setup & Headcount
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						N-1 Split Engine
					</span>
				</div>

				<!-- Destination / Preset Picker -->
				<div class="form-group" style="margin-bottom: 1.25rem;">
					<label class="form-label" for="destination-preset" style="font-weight: 700;">Destination / Trip Vibe Preset</label>
					<select id="destination-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600; padding: 0.65rem;">
						<option value="vegas" selected>🎰 Las Vegas, NV (Strip Suites / VIP Nightclub / $1,250/guy)</option>
						<option value="austin">🤠 Austin, TX (Rainey St BBQ / Lake Travis Boat / $850/guy)</option>
						<option value="scottsdale">🏌️ Scottsdale, AZ (Golf Rounds / Pool Villa / $950/guy)</option>
						<option value="miami">🛥️ Miami, FL (Yacht Charter / Oceanfront Penthouse / $1,400/guy)</option>
						<option value="cabin">🏔️ Mountain Cabin / Ski Weekend (Tahoe/Denver / $650/guy)</option>
						<option value="custom">✏️ Custom Trip Inputs</option>
					</select>
				</div>

				<!-- Groom Name, Paying Guys, Nights -->
				<div style="display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
					<div>
						<label class="form-label" for="groom-name" style="font-size: 0.9rem; font-weight: 600;">Groom's Name</label>
						<input type="text" id="groom-name" class="form-input" value="Alex" placeholder="e.g. Alex" />
					</div>
					<div>
						<label class="form-label" for="guys-count" style="font-size: 0.9rem; font-weight: 600;">Paying Guys</label>
						<input type="number" id="guys-count" class="form-input" value="7" min="1" max="40" />
					</div>
					<div>
						<label class="form-label" for="trip-nights" style="font-size: 0.9rem; font-weight: 600;">Nights</label>
						<input type="number" id="trip-nights" class="form-input" value="3" min="1" max="30" />
					</div>
				</div>

				<!-- Cover Groom Toggle -->
				<div class="form-group" style="background: #fffcf5; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.5rem;">
					<label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 700; font-size: 0.98rem; margin: 0;">
						<input type="checkbox" id="toggle-cover-groom" checked style="width: 18px; height: 18px; cursor: pointer;" />
						<span>Cover Groom's Costs 100% (Groom Pays $0)</span>
					</label>
					<span style="font-size: 0.82rem; color: #64748b; display: block; margin-top: 4px; margin-left: 26px;">
						Standard etiquette: The 7 paying guys divide the entire group bill equally.
					</span>
				</div>

				<!-- Accordion / Expense Categories -->
				
				<!-- Category 1: Accommodations -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏡 1. Accommodations & Lodging ($)
						</strong>
						<span id="subtotal-lodging" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">$2,800</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-airbnb" style="font-size: 0.85rem;">Airbnb / Hotel Total</label>
							<input type="number" id="exp-airbnb" class="form-input" value="2500" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-cleaning" style="font-size: 0.85rem;">Cleaning & Service Fees</label>
							<input type="number" id="exp-cleaning" class="form-input" value="300" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Category 2: Daytime Activities -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🏌️ 2. Daytime Activities & Excursions ($)
						</strong>
						<span id="subtotal-activities" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">$1,600</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-golf" style="font-size: 0.85rem;">Golf Rounds & Rentals</label>
							<input type="number" id="exp-golf" class="form-input" value="800" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-boat" style="font-size: 0.85rem;">Boat / Yacht Charter</label>
							<input type="number" id="exp-boat" class="form-input" value="500" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-shooting" style="font-size: 0.85rem;">Shooting / Paintball / ATVs</label>
							<input type="number" id="exp-shooting" class="form-input" value="0" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-tours" style="font-size: 0.85rem;">Brewery / Distillery Tour</label>
							<input type="number" id="exp-tours" class="form-input" value="300" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Category 3: Food & Dining -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🥩 3. Food & Group Meals ($)
						</strong>
						<span id="subtotal-food" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">$1,600</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-dinners" style="font-size: 0.85rem;">Steakhouse & Dinners</label>
							<input type="number" id="exp-dinners" class="form-input" value="1000" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-groceries" style="font-size: 0.85rem;">Groceries & House Snacks</label>
							<input type="number" id="exp-groceries" class="form-input" value="350" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-brunch" style="font-size: 0.85rem;">Hangover Brunch & Quick Lunches</label>
						<input type="number" id="exp-brunch" class="form-input" value="250" min="0" step="25" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Category 4: Nightlife & Drinks -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🍻 4. Nightlife & Alcohol ($)
						</strong>
						<span id="subtotal-nightlife" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">$1,500</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.5rem;">
						<div>
							<label class="form-label" for="exp-bars" style="font-size: 0.85rem;">Bar Tabs & Pub Crawls</label>
							<input type="number" id="exp-bars" class="form-input" value="600" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-vip" style="font-size: 0.85rem;">VIP Table / Club Cover</label>
							<input type="number" id="exp-vip" class="form-input" value="500" min="0" step="50" style="font-size: 0.95rem;" />
						</div>
					</div>
					<div>
						<label class="form-label" for="exp-booze" style="font-size: 0.85rem;">House Beer, Seltzers & Spirits</label>
						<input type="number" id="exp-booze" class="form-input" value="400" min="0" step="25" style="font-size: 0.95rem;" />
					</div>
				</div>

				<!-- Category 5: Transportation -->
				<div style="margin-bottom: 1.25rem; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🚗 5. Transportation ($)
						</strong>
						<span id="subtotal-transport" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">$550</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-rental" style="font-size: 0.85rem;">Rental Van / SUV & Gas</label>
							<input type="number" id="exp-rental" class="form-input" value="350" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-uber" style="font-size: 0.85rem;">Rideshares (Uber / Lyft)</label>
							<input type="number" id="exp-uber" class="form-input" value="200" min="0" step="25" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

				<!-- Category 6: Swag & Favors -->
				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #fafafa;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
						<strong class="font-heading" style="font-size: 1.05rem; color: var(--fg-pencil);">
							🧢 6. Swag, Gear & Favors ($)
						</strong>
						<span id="subtotal-swag" style="font-weight: 700; color: var(--accent-blue); font-size: 0.95rem;">$250</span>
					</div>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
						<div>
							<label class="form-label" for="exp-shirts" style="font-size: 0.85rem;">Custom Shirts & Hats</label>
							<input type="number" id="exp-shirts" class="form-input" value="150" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
						<div>
							<label class="form-label" for="exp-kits" style="font-size: 0.85rem;">Hangover Kits & Koozies</label>
							<input type="number" id="exp-kits" class="form-input" value="100" min="0" step="10" style="font-size: 0.95rem;" />
						</div>
					</div>
				</div>

			</div>

			<!-- Right Column: Results Summary, Payment Generator, & Exports -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Cost Breakdown Card -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.25rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
						<span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--accent-red); letter-spacing: 0.05em;">
							Cost Per Paying Guy
						</span>
						<span id="groom-status-badge" style="font-size: 0.85rem; font-weight: 800; background: #16a34a; color: #fff; padding: 3px 8px; border-radius: 4px;">
							🤵 Alex Pays: $0
						</span>
					</div>

					<div id="display-per-person" class="font-heading" style="font-size: clamp(2.4rem, 5vw, 3.6rem); color: var(--fg-pencil); line-height: 1.1; margin-bottom: 0.25rem;">
						$1,186
					</div>

					<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.25rem; font-size: 0.95rem; color: var(--text-secondary); flex-wrap: wrap;">
						<span>🌙 <strong id="display-per-night" style="color: var(--fg-pencil);">$395</strong> / night</span>
						<span>•</span>
						<span>🎁 Groom subsidy: <strong id="display-groom-subsidy" style="color: var(--accent-red); font-weight: 700;">+$148</strong> / guy</span>
					</div>

					<p style="font-size: 0.92rem; color: var(--text-secondary); margin: 0 0 1.25rem 0; padding-bottom: 1rem; border-bottom: 1px dashed #cbd5e1;">
						Total group trip spend: <strong id="display-trip-grand-total" style="color: var(--fg-pencil); font-weight: 700;">$8,300</strong> across <span id="display-headcount-text">7 paying guys</span> (+ groom).
					</p>

					<!-- Itemized Per-Person Split Table -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.25rem;">
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏡 Lodging Share:</span>
							<strong id="item-lodging-share">$400</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🏌️ Daytime Activities:</span>
							<strong id="item-activity-share">$229</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🥩 Food & Group Dinners:</span>
							<strong id="item-food-share">$229</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🍻 Nightlife & Drinks:</span>
							<strong id="item-nightlife-share">$214</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.9rem;">
							<span>🚗 Transportation:</span>
							<strong id="item-transport-share">$79</strong>
						</div>
						<div style="display: flex; justify-content: space-between; padding: 0.3rem 0; font-size: 0.9rem;">
							<span>🧢 Swag & Gear:</span>
							<strong id="item-swag-share">$36</strong>
						</div>
					</div>

					<!-- Suggested Payment Schedule -->
					<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 1.25rem; font-size: 0.88rem; line-height: 1.5;">
						<strong style="display: block; color: var(--fg-pencil); margin-bottom: 4px;">📅 Recommended 2-Part Payment Schedule:</strong>
						• <strong>Deposit 1 (Upfront Lock):</strong> <span id="sched-dep-1" style="font-weight: 700; color: var(--accent-red);">$593</span> (Airbnb & reservations)<br />
						• <strong>Deposit 2 (2 Wks Before):</strong> <span id="sched-dep-2" style="font-weight: 700; color: var(--accent-blue);">$593</span> (dinners, drinks & logistics)
					</div>

					<!-- Payment Handle & Deadline Setup -->
					<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem;">
						<strong class="font-heading" style="display: block; font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--fg-pencil);">
							💳 Payment Request Settings
						</strong>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<label class="form-label" for="payment-handle" style="font-size: 0.8rem;">Venmo / Zelle / Handle</label>
								<input type="text" id="payment-handle" class="form-input" value="@BestManDave" placeholder="@VenmoHandle" style="font-size: 0.85rem; padding: 0.4rem 0.6rem;" />
							</div>
							<div>
								<label class="form-label" for="payment-deadline" style="font-size: 0.8rem;">Deposit 1 Due Date</label>
