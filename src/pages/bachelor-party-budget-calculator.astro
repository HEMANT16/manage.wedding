	<!-- Interactive Logic & Export Handlers -->
	<script is:inline>
		// Form Elements
		const presetSelect = document.getElementById('destination-preset');
		const groomNameInput = document.getElementById('groom-name');
		const guysCountInput = document.getElementById('guys-count');
		const tripNightsInput = document.getElementById('trip-nights');
		const toggleCoverGroom = document.getElementById('toggle-cover-groom');

		// Inputs
		const expAirbnb = document.getElementById('exp-airbnb');
		const expCleaning = document.getElementById('exp-cleaning');
		const expGolf = document.getElementById('exp-golf');
		const expBoat = document.getElementById('exp-boat');
		const expShooting = document.getElementById('exp-shooting');
		const expTours = document.getElementById('exp-tours');
		const expDinners = document.getElementById('exp-dinners');
		const expGroceries = document.getElementById('exp-groceries');
		const expBrunch = document.getElementById('exp-brunch');
		const expBars = document.getElementById('exp-bars');
		const expVip = document.getElementById('exp-vip');
		const expBooze = document.getElementById('exp-booze');
		const expRental = document.getElementById('exp-rental');
		const expUber = document.getElementById('exp-uber');
		const expShirts = document.getElementById('exp-shirts');
		const expKits = document.getElementById('exp-kits');

		// Subtotal displays
		const subLodging = document.getElementById('subtotal-lodging');
		const subActivities = document.getElementById('subtotal-activities');
		const subFood = document.getElementById('subtotal-food');
		const subNightlife = document.getElementById('subtotal-nightlife');
		const subTransport = document.getElementById('subtotal-transport');
		const subSwag = document.getElementById('subtotal-swag');

		// Summary Displays
		const displayPerPerson = document.getElementById('display-per-person');
		const displayPerNight = document.getElementById('display-per-night');
		const displayGroomSubsidy = document.getElementById('display-groom-subsidy');
		const displayGrandTotal = document.getElementById('display-trip-grand-total');
		const displayHeadcountText = document.getElementById('display-headcount-text');
		const groomStatusBadge = document.getElementById('groom-status-badge');

		// Itemized Shares
		const itemLodgingShare = document.getElementById('item-lodging-share');
		const itemActivityShare = document.getElementById('item-activity-share');
		const itemFoodShare = document.getElementById('item-food-share');
		const itemNightlifeShare = document.getElementById('item-nightlife-share');
		const itemTransportShare = document.getElementById('item-transport-share');
		const itemSwagShare = document.getElementById('item-swag-share');

		// Payment Sched & Action Elements
		const schedDep1 = document.getElementById('sched-dep-1');
		const schedDep2 = document.getElementById('sched-dep-2');
		const paymentHandleInput = document.getElementById('payment-handle');
		const paymentDeadlineInput = document.getElementById('payment-deadline');

		const btnCopyVenmo = document.getElementById('btn-copy-venmo');
		const btnExportDoc = document.getElementById('btn-export-doc');
		const btnPrintPdf = document.getElementById('btn-print-pdf');

		function calculateBachelor() {
			const guys = parseInt(guysCountInput.value, 10) || 1;
			const nights = parseInt(tripNightsInput.value, 10) || 1;
			const coverGroom = toggleCoverGroom.checked;
			const groom = groomNameInput.value.trim() || 'Alex';

			// Group Category Sums
			const lodgingTotal = (parseFloat(expAirbnb.value) || 0) + (parseFloat(expCleaning.value) || 0);
			const activitiesTotal = (parseFloat(expGolf.value) || 0) + (parseFloat(expBoat.value) || 0) + (parseFloat(expShooting.value) || 0) + (parseFloat(expTours.value) || 0);
			const foodTotal = (parseFloat(expDinners.value) || 0) + (parseFloat(expGroceries.value) || 0) + (parseFloat(expBrunch.value) || 0);
			const nightlifeTotal = (parseFloat(expBars.value) || 0) + (parseFloat(expVip.value) || 0) + (parseFloat(expBooze.value) || 0);
			const transportTotal = (parseFloat(expRental.value) || 0) + (parseFloat(expUber.value) || 0);
			const swagTotal = (parseFloat(expShirts.value) || 0) + (parseFloat(expKits.value) || 0);

			const grandTotal = lodgingTotal + activitiesTotal + foodTotal + nightlifeTotal + transportTotal + swagTotal;
			
			// Headcount Division
			const totalHeadcount = guys + 1; // guys + groom
			const payingCount = coverGroom ? guys : totalHeadcount;

			const perPersonTotal = grandTotal / payingCount;
			const perPersonPerNight = perPersonTotal / Math.max(nights, 1);

			// Groom subsidy calculation (how much extra per guy to cover groom)
			const baseEqualSplit = grandTotal / totalHeadcount;
			const subsidyPerGuy = coverGroom ? (perPersonTotal - baseEqualSplit) : 0;

			// Category Shares
			const lodgingShare = lodgingTotal / payingCount;
			const activityShare = activitiesTotal / payingCount;
			const foodShare = foodTotal / payingCount;
			const nightlifeShare = nightlifeTotal / payingCount;
			const transportShare = transportTotal / payingCount;
			const swagShare = swagTotal / payingCount;

			// Update Subtotals
			subLodging.textContent = `$${Math.round(lodgingTotal).toLocaleString()}`;
			subActivities.textContent = `$${Math.round(activitiesTotal).toLocaleString()}`;
			subFood.textContent = `$${Math.round(foodTotal).toLocaleString()}`;
			subNightlife.textContent = `$${Math.round(nightlifeTotal).toLocaleString()}`;
			subTransport.textContent = `$${Math.round(transportTotal).toLocaleString()}`;
			subSwag.textContent = `$${Math.round(swagTotal).toLocaleString()}`;

			// Update Summary Card
			displayPerPerson.textContent = `$${Math.round(perPersonTotal).toLocaleString()}`;
			displayPerNight.textContent = `$${Math.round(perPersonPerNight).toLocaleString()}`;
			displayGrandTotal.textContent = `$${Math.round(grandTotal).toLocaleString()}`;
			displayHeadcountText.textContent = `${payingCount} paying guy${payingCount === 1 ? '' : 's'}`;

			if (coverGroom) {
				groomStatusBadge.textContent = `🤵 ${groom} Pays: $0`;
				groomStatusBadge.style.background = '#16a34a';
				displayGroomSubsidy.textContent = `+$${Math.round(subsidyPerGuy).toLocaleString()}`;
			} else {
				groomStatusBadge.textContent = `🤵 ${groom} Pays Equal Share: $${Math.round(perPersonTotal).toLocaleString()}`;
				groomStatusBadge.style.background = '#0284c7';
				displayGroomSubsidy.textContent = `$0`;
			}

			// Update Itemized Shares
			itemLodgingShare.textContent = `$${Math.round(lodgingShare).toLocaleString()}`;
			itemActivityShare.textContent = `$${Math.round(activityShare).toLocaleString()}`;
			itemFoodShare.textContent = `$${Math.round(foodShare).toLocaleString()}`;
			itemNightlifeShare.textContent = `$${Math.round(nightlifeShare).toLocaleString()}`;
			itemTransportShare.textContent = `$${Math.round(transportShare).toLocaleString()}`;
			itemSwagShare.textContent = `$${Math.round(swagShare).toLocaleString()}`;

			// 2-Deposit Schedule
			const dep1 = Math.round(perPersonTotal / 2);
			const dep2 = Math.round(perPersonTotal) - dep1;
			schedDep1.textContent = `$${dep1.toLocaleString()}`;
			schedDep2.textContent = `$${dep2.toLocaleString()}`;
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'vegas') {
				tripNightsInput.value = 3;
				expAirbnb.value = 2500;
				expCleaning.value = 300;
				expGolf.value = 800;
				expBoat.value = 500;
				expShooting.value = 0;
				expTours.value = 300;
				expDinners.value = 1000;
				expGroceries.value = 350;
				expBrunch.value = 250;
				expBars.value = 600;
				expVip.value = 500;
				expBooze.value = 400;
				expRental.value = 350;
				expUber.value = 200;
				expShirts.value = 150;
				expKits.value = 100;
			} else if (p === 'austin') {
				tripNightsInput.value = 3;
				expAirbnb.value = 2000;
				expCleaning.value = 250;
				expGolf.value = 400;
				expBoat.value = 750; // Lake Travis pontoon
				expShooting.value = 300;
