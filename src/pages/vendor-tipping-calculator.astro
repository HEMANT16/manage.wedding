---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Vendor Tipping Calculator & Cash Envelope Maker",
      "url": "https://manage.wedding/vendor-tipping-calculator",
      "description": "Free wedding vendor tipping calculator. Calculate exact gratuities for caterers, DJs, photographers, planners, hair/makeup, drivers, and setup crews. Export cash tip envelopes and distribution schedules to Word, PDF, or Excel.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do you have to tip wedding vendors who own their own business?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditional etiquette stated that business owners set their own prices and do not expect a tip. However, modern wedding etiquette has evolved: if a solo owner (like a photographer or planner) goes above and beyond, a tip of $75 to $200 or a thoughtful gift and a 5-star review is warmly appreciated."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a caterer's service charge and a gratuity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 'service charge' (usually 20-24%) is an administrative fee retained by the catering company to cover operational overhead, insurance, and setup costs. It is rarely distributed directly to waitstaff and bartenders. Always ask your venue or caterer: 'Does the service charge go directly to the service staff as gratuity?' If not, tip $25 to $50 per server and bartender in cash."
          }
        },
        {
          "@type": "Question",
          "name": "Who should be responsible for handing out tip envelopes on the wedding day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never carry cash yourself on your wedding day. Prepare labeled cash envelopes in advance and delegate distribution to your Wedding Planner, Day-Of Coordinator, or Best Man. Most tips are handed out at the end of the vendor's shift or at the close of the reception."
          }
        },
        {
          "@type": "Question",
          "name": "How much should I tip hair and makeup artists?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hair and makeup artists should be tipped 18% to 22% of the total service bill, just as you would at a traditional salon. If the beauty team travelled to your bridal suite on-site, a 20% tip is standard etiquette."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Vendor Tipping Calculator (Free Gratuity Cheat Sheet & Envelope Export) | Manage.Wedding"
	description="Calculate exact gratuities for your wedding vendors. Accurate tipping cheat sheet for caterers, DJs, photographers, planners, and hair/makeup with instant Word and PDF envelope exports."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Vendor Tipping Calculator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Calculate exact gratuities based on modern etiquette guidelines. Itemize tips across 10+ wedding vendor categories and export formatted <strong>Cash Tip Envelopes</strong> to <strong>Word (.doc)</strong> or <strong>PDF</strong>.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> How to Use This Tipping Calculator in 3 Easy Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Enter Vendor Contract Costs
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Enter your contract bills and staff counts. Uncheck any vendors you haven't hired or whose contract already includes gratuity.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Review Suggested Gratuities
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						The calculator automatically applies standard percentages (18-20%) or flat-rate benchmarks ($50-$200) for photographers, DJs, and officiants.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Export Printable Tip Envelopes
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Click <strong>"📝 Export Word (.doc)"</strong> or <strong>"🖨️ Export PDF"</strong> to print envelope labels and a day-of hand-out schedule for your coordinator or best man!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Inputs + Financial Summary -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.15fr 0.85fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="tipping-calc-grid">
			
			<!-- Left Column: 10+ Vendor Categories Form -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
							💵 Vendor Contracts & Staff
						</h2>
						<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
							Configure your hired pros and contract amounts
						</span>
					</div>

					<!-- Currency Selector -->
					<div style="display: flex; align-items: center; gap: 0.3rem;">
						<span style="font-size: 0.85rem; font-weight: bold;">Currency:</span>
						<select id="currency-select" style="padding: 0.25rem 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.9rem;">
							<option value="$" selected>$ (USD/CAD/AUD)</option>
							<option value="£">£ (GBP)</option>
							<option value="€">€ (EUR)</option>
							<option value="₹">₹ (INR)</option>
						</select>
					</div>
				</div>

				<form id="tipping-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
					
					<!-- 1. Catering & Bartenders -->
					<div class="vendor-input-group">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
							<label class="font-heading" style="font-size: 1rem; color: var(--accent-red);">
								🍽️ Catering & Waitstaff
							</label>
							<label style="font-size: 0.78rem; display: flex; align-items: center; gap: 0.3rem; cursor: pointer; color: var(--text-secondary);">
								<input type="checkbox" id="chk-caterer-included"> Gratuity already in contract
							</label>
						</div>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Total Food/Beverage Bill</span>
								<input type="number" id="input-caterer-bill" value="6500" min="0" step="100" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Tip Mode</span>
								<select id="select-caterer-rate" class="tip-select">
									<option value="0.18" selected>18% of Bill ($1,170)</option>
									<option value="0.20">20% of Bill ($1,300)</option>
									<option value="0.15">15% of Bill ($975)</option>
									<option value="flat">Flat $40 / Server Staff</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 2. Hair & Makeup (HMUA) -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: var(--accent-blue); display: block; margin-bottom: 0.3rem;">
							💄 Hair & Makeup Artists (HMUA)
						</label>
						<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Total Beauty Service Bill</span>
								<input type="number" id="input-beauty-bill" value="850" min="0" step="50" class="tip-input">
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Tip Percentage</span>
								<select id="select-beauty-rate" class="tip-select">
									<option value="0.20" selected>20% (Standard Salon Rate)</option>
									<option value="0.18">18% (Standard)</option>
									<option value="0.25">25% (Exceptional On-Site)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 3. Photography & Videography -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #16a34a; display: block; margin-bottom: 0.3rem;">
							📸 Lead & Second Photographers / Videographers
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Lead Shooter Tip</span>
								<select id="select-photo-lead" class="tip-select">
									<option value="100" selected>Lead Photographer ($100 flat)</option>
									<option value="150">Lead Photographer ($150 flat)</option>
									<option value="75">Lead Photographer ($75 flat)</option>
									<option value="0">No Tip / Business Owner ($0)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Second Shooter / Assistant</span>
								<select id="select-photo-second" class="tip-select">
									<option value="75" selected>Second Shooter ($75 flat)</option>
									<option value="50">Second Shooter ($50 flat)</option>
									<option value="100">Second Shooter ($100 flat)</option>
									<option value="0">No Second Shooter ($0)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 4. DJ & Entertainment -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #7c3aed; display: block; margin-bottom: 0.3rem;">
							🎵 Wedding DJ & Live Musicians
						</label>
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Lead DJ / Emcee Tip</span>
								<select id="select-dj-tip" class="tip-select">
									<option value="100" selected>Lead DJ ($100 flat)</option>
									<option value="150">Lead DJ ($150 flat)</option>
									<option value="75">Lead DJ ($75 flat)</option>
									<option value="0">No Tip / In Contract ($0)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Live Ceremony Musicians</span>
								<select id="select-band-tip" class="tip-select">
									<option value="50" selected>Live Musicians ($50 / member)</option>
									<option value="35">Live Musicians ($35 / member)</option>
									<option value="0">No Live Musicians ($0)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- 5. Wedding Planner & Coordinator -->
					<div class="vendor-input-group">
						<label class="font-heading" style="font-size: 1rem; color: #d97706; display: block; margin-bottom: 0.3rem;">
							📋 Wedding Planner / Day-Of Coordinator
						</label>
						<div>
							<select id="select-planner-tip" class="tip-select">
								<option value="150" selected>Day-Of Coordinator ($150 flat)</option>
								<option value="250">Full-Service Planner ($250 flat)</option>
								<option value="100">Day-Of Coordinator ($100 flat)</option>
								<option value="0">No Tip / Business Owner ($0)</option>
							</select>
						</div>
					</div>

					<!-- 6. Drivers, Officiant & Delivery Setup Crew -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block; text-align: center;">
							🚐 Logistics, Officiant & Delivery Crews
						</span>
						
						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Limo / Shuttle Drivers</span>
								<select id="select-driver-tip" class="tip-select">
									<option value="60" selected>Shuttle Driver ($60 flat)</option>
									<option value="100">Multiple Drivers ($100 total)</option>
									<option value="0">Included in Rental ($0)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Ceremony Officiant</span>
								<select id="select-officiant-tip" class="tip-select">
									<option value="75" selected>Officiant Tip / Donation ($75)</option>
									<option value="100">Officiant Donation ($100)</option>
									<option value="50">Officiant Tip ($50)</option>
									<option value="0">Fee Covered ($0)</option>
								</select>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Florist & Rental Delivery Crew</span>
								<select id="select-delivery-tip" class="tip-select">
									<option value="40" selected>Delivery Crew ($40 total)</option>
									<option value="60">Heavy Setup Crew ($60 total)</option>
									<option value="20">Small Setup ($20 total)</option>
									<option value="0">No Delivery Tip ($0)</option>
								</select>
							</div>
							<div>
								<span style="font-size: 0.75rem; color: var(--text-secondary);">Cake Delivery Driver</span>
								<select id="select-cake-tip" class="tip-select">
									<option value="20" selected>Cake Driver ($20 flat)</option>
									<option value="30">Complex Tiered Cake ($30)</option>
									<option value="0">No Tip ($0)</option>
								</select>
							</div>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Gratuity Breakdown & Cash Envelope Planner -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Main Total Gratuity Quote Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								✉️ Total Gratuity Budget
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Cash needed for wedding day tip envelopes
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Key Gratuity Total Highlight -->
					<div style="background: #fdf2f8; border: 2.5px solid var(--accent-red); border-radius: 6px; padding: 1.2rem; text-align: center; margin-bottom: 1.5rem;">
						<span class="font-body" style="font-size: 0.9rem; color: var(--accent-red); display: block; font-weight: bold;">Total Wedding Tips to Prepare</span>
						<strong id="res-total-gratuity" class="font-heading" style="font-size: 2.6rem; color: var(--accent-red); display: block; line-height: 1.2;">$1,885</strong>
						<span id="res-envelope-count" style="font-size: 0.8rem; color: var(--accent-red);">Across 8 Prepared Cash Envelopes</span>
					</div>

					<!-- Line-Item Category Breakdown Table -->
					<div style="margin-bottom: 1.5rem;">
						<h4 class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); margin-bottom: 0.5rem; text-align: center;">
							🧾 Itemized Tip Envelope Summary
						</h4>
						<table style="width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: 0.92rem;">
							<tbody>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🍽️ Catering & Waitstaff:</td>
									<td id="res-caterer-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$1,170.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">💄 Hair & Makeup Artists:</td>
									<td id="res-beauty-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$170.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📸 Photo & Video Team:</td>
									<td id="res-photo-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$175.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🎵 DJ & Live Musicians:</td>
									<td id="res-dj-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$150.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">📋 Planner / Coordinator:</td>
									<td id="res-planner-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$150.00</td>
								</tr>
								<tr style="border-bottom: 1px solid #e5e7eb;">
									<td style="padding: 0.35rem 0;">🚐 Drivers & Officiant:</td>
									<td id="res-logistics-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$135.00</td>
								</tr>
								<tr style="border-bottom: 2px solid var(--fg-pencil); background: #fafafa;">
									<td style="padding: 0.35rem 0;">🌸 Setup & Cake Delivery:</td>
									<td id="res-delivery-tip" style="padding: 0.35rem 0; text-align: right; font-weight: bold;">$60.00</td>
								</tr>
							</tbody>
						</table>
					</div>

					<!-- Gratuity Distribution Bar Chart -->
					<div>
						<span class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.3rem; text-align: center;">
							Tip Distribution by Category
						</span>
						<div style="width: 100%; height: 18px; border: 1.5px solid var(--fg-pencil); border-radius: 4px; overflow: hidden; display: flex; background: #eee;">
							<div id="bar-caterer" style="width: 55%; background: var(--accent-red); transition: width 0.3s ease;"></div>
							<div id="bar-beauty" style="width: 10%; background: var(--accent-blue); transition: width 0.3s ease;"></div>
							<div id="bar-photo" style="width: 10%; background: #16a34a; transition: width 0.3s ease;"></div>
							<div id="bar-dj" style="width: 10%; background: #7c3aed; transition: width 0.3s ease;"></div>
							<div id="bar-planner" style="width: 8%; background: #d97706; transition: width 0.3s ease;"></div>
							<div id="bar-other" style="width: 7%; background: #64748b; transition: width 0.3s ease;"></div>
						</div>
					</div>

				</div>

				<!-- Envelope Delegation Card -->
				<div class="hand-card" style="padding: 1.25rem; background: var(--post-it); border: 2px solid var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.1rem; color: var(--fg-pencil); display: block; margin-bottom: 0.4rem; text-align: center;">
						📌 The Wedding Day Delegation Rule:
					</strong>
					<ul class="font-body" style="font-size: 0.85rem; line-height: 1.5; padding-left: 1.1rem; margin: 0; color: var(--fg-pencil);">
						<li><strong>Do not carry cash:</strong> Give all sealed envelopes to the Best Man or Coordinator at rehearsal.</li>
						<li><strong>Timing:</strong> HMUA is tipped at suite departure; DJ/photo tipped during the last 30 minutes of reception.</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; text-align: center;">
				<h1 style="font-size: 24px; margin: 0 0 5px 0;">Manage.Wedding — Wedding Vendor Tip Envelope Schedule</h1>
				<p style="margin: 0; font-size: 13px; color: #555;">Exported on: <span id="print-date"></span> | Total Gratuity: <span id="print-total"></span></p>
			</div>
			<table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 15px;">
				<thead>
					<tr style="background: #f2f2f2;">
						<th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Vendor & Role</th>
