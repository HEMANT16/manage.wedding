<script is:inline>
	let currencySymbol = '$';

	const currencySelect = document.getElementById('currency-select');
	const chkCatererIncluded = document.getElementById('chk-caterer-included');
	const inputCatererBill = document.getElementById('input-caterer-bill');
	const selectCatererRate = document.getElementById('select-caterer-rate');

	const inputBeautyBill = document.getElementById('input-beauty-bill');
	const selectBeautyRate = document.getElementById('select-beauty-rate');

	const selectPhotoLead = document.getElementById('select-photo-lead');
	const selectPhotoSecond = document.getElementById('select-photo-second');

	const selectDjTip = document.getElementById('select-dj-tip');
	const selectBandTip = document.getElementById('select-band-tip');

	const selectPlannerTip = document.getElementById('select-planner-tip');
	const selectDriverTip = document.getElementById('select-driver-tip');
	const selectOfficiantTip = document.getElementById('select-officiant-tip');
	const selectDeliveryTip = document.getElementById('select-delivery-tip');
	const selectCakeTip = document.getElementById('select-cake-tip');

	// Result Elements
	const resTotalGratuity = document.getElementById('res-total-gratuity');
	const resEnvelopeCount = document.getElementById('res-envelope-count');
	const resCatererTip = document.getElementById('res-caterer-tip');
	const resBeautyTip = document.getElementById('res-beauty-tip');
	const resPhotoTip = document.getElementById('res-photo-tip');
	const resDjTip = document.getElementById('res-dj-tip');
	const resPlannerTip = document.getElementById('res-planner-tip');
	const resLogisticsTip = document.getElementById('res-logistics-tip');
	const resDeliveryTip = document.getElementById('res-delivery-tip');

	const barCaterer = document.getElementById('bar-caterer');
	const barBeauty = document.getElementById('bar-beauty');
	const barPhoto = document.getElementById('bar-photo');
	const barDj = document.getElementById('bar-dj');
	const barPlanner = document.getElementById('bar-planner');
	const barOther = document.getElementById('bar-other');

	function formatMoney(amount) {
		return `${currencySymbol}${Math.round(amount).toLocaleString('en-US')}`;
	}

	function calculateTips() {
		currencySymbol = currencySelect.value;

		// 1. Caterer
		let catererTip = 0;
		if (!chkCatererIncluded.checked) {
			const bill = parseFloat(inputCatererBill.value) || 0;
			const rate = selectCatererRate.value;
			if (rate === 'flat') {
				catererTip = 40 * 10; // Approx 10 servers
			} else {
				catererTip = bill * parseFloat(rate);
			}
		}

		// 2. Beauty
		const beautyBill = parseFloat(inputBeautyBill.value) || 0;
		const beautyRate = parseFloat(selectBeautyRate.value) || 0.20;
		const beautyTip = beautyBill * beautyRate;

		// 3. Photo / Video
		const photoLead = parseFloat(selectPhotoLead.value) || 0;
		const photoSecond = parseFloat(selectPhotoSecond.value) || 0;
		const photoTotal = photoLead + photoSecond;

		// 4. DJ & Band
		const djTip = parseFloat(selectDjTip.value) || 0;
		const bandTip = parseFloat(selectBandTip.value) || 0;
		const musicTotal = djTip + bandTip;

		// 5. Planner
		const plannerTip = parseFloat(selectPlannerTip.value) || 0;

		// 6. Drivers & Officiant
		const driverTip = parseFloat(selectDriverTip.value) || 0;
		const officiantTip = parseFloat(selectOfficiantTip.value) || 0;
		const logisticsTotal = driverTip + officiantTip;

		// 7. Delivery Crews
		const deliveryTip = parseFloat(selectDeliveryTip.value) || 0;
		const cakeTip = parseFloat(selectCakeTip.value) || 0;
		const deliveryTotal = deliveryTip + cakeTip;

		const grandTotal = catererTip + beautyTip + photoTotal + musicTotal + plannerTip + logisticsTotal + deliveryTotal;

		// Count active envelopes
		let count = 0;
		if (catererTip > 0) count++;
		if (beautyTip > 0) count++;
		if (photoLead > 0) count++;
		if (photoSecond > 0) count++;
		if (djTip > 0) count++;
		if (bandTip > 0) count++;
		if (plannerTip > 0) count++;
		if (driverTip > 0) count++;
		if (officiantTip > 0) count++;
		if (deliveryTotal > 0) count++;

		// Update UI
		resTotalGratuity.textContent = formatMoney(grandTotal);
		resEnvelopeCount.textContent = `Across ${count} Prepared Cash Envelopes`;
		resCatererTip.textContent = formatMoney(catererTip);
		resBeautyTip.textContent = formatMoney(beautyTip);
		resPhotoTip.textContent = formatMoney(photoTotal);
		resDjTip.textContent = formatMoney(musicTotal);
		resPlannerTip.textContent = formatMoney(plannerTip);
		resLogisticsTip.textContent = formatMoney(logisticsTotal);
		resDeliveryTip.textContent = formatMoney(deliveryTotal);

		// Bar Chart
		if (grandTotal > 0) {
			barCaterer.style.width = `${Math.round((catererTip / grandTotal) * 100)}%`;
			barBeauty.style.width = `${Math.round((beautyTip / grandTotal) * 100)}%`;
			barPhoto.style.width = `${Math.round((photoTotal / grandTotal) * 100)}%`;
			barDj.style.width = `${Math.round((musicTotal / grandTotal) * 100)}%`;
			barPlanner.style.width = `${Math.round((plannerTip / grandTotal) * 100)}%`;
			barOther.style.width = `${Math.round(((logisticsTotal + deliveryTotal) / grandTotal) * 100)}%`;
		}
	}

	// Listeners
	document.querySelectorAll('.tip-input, #chk-caterer-included').forEach(el => {
		el.addEventListener('input', calculateTips);
		el.addEventListener('change', calculateTips);
	});
	document.querySelectorAll('.tip-select, #currency-select').forEach(el => {
		el.addEventListener('change', calculateTips);
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		let rows = '';
		if (parseFloat(resCatererTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Catering & Banquet Staff</strong></td><td>End of Reception</td><td>Best Man / Coordinator</td><td style="text-align:right; font-weight:bold;">${resCatererTip.textContent}</td></tr>`;
		}
		if (parseFloat(resBeautyTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Hair & Makeup Artists</strong></td><td>After Suite Styling</td><td>Maid of Honor / Bride</td><td style="text-align:right; font-weight:bold;">${resBeautyTip.textContent}</td></tr>`;
		}
		if (parseFloat(selectPhotoLead.value) > 0) {
			rows += `<tr><td><strong>Lead Photographer</strong></td><td>End of Reception</td><td>Best Man / Groom</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPhotoLead.value)}</td></tr>`;
		}
		if (parseFloat(selectPhotoSecond.value) > 0) {
			rows += `<tr><td><strong>Second Shooter / Assistant</strong></td><td>End of Reception</td><td>Best Man</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPhotoSecond.value)}</td></tr>`;
		}
		if (parseFloat(selectDjTip.value) > 0) {
			rows += `<tr><td><strong>Wedding DJ / Emcee</strong></td><td>End of Reception</td><td>Best Man</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectDjTip.value)}</td></tr>`;
		}
		if (parseFloat(selectPlannerTip.value) > 0) {
			rows += `<tr><td><strong>Wedding Planner / Coordinator</strong></td><td>End of Reception</td><td>Mother of Bride / Groom</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectPlannerTip.value)}</td></tr>`;
		}
		if (parseFloat(selectDriverTip.value) > 0) {
			rows += `<tr><td><strong>Shuttle & Limo Drivers</strong></td><td>After Final Drop-off</td><td>Best Man</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectDriverTip.value)}</td></tr>`;
		}
		if (parseFloat(selectOfficiantTip.value) > 0) {
			rows += `<tr><td><strong>Ceremony Officiant</strong></td><td>Before Ceremony</td><td>Best Man</td><td style="text-align:right; font-weight:bold;">${formatMoney(selectOfficiantTip.value)}</td></tr>`;
		}
		if (parseFloat(resDeliveryTip.textContent.replace(/[^0-9.]/g, '')) > 0) {
			rows += `<tr><td><strong>Floral Setup & Cake Delivery</strong></td><td>Upon Morning Delivery</td><td>Day-Of Coordinator</td><td style="text-align:right; font-weight:bold;">${resDeliveryTip.textContent}</td></tr>`;
		}

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Wedding Vendor Cash Tip Schedule</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
					th { background-color: #f2f2f2; border: 1px solid #ccc; padding: 8px; text-align: left; }
					td { border: 1px solid #ccc; padding: 8px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Official Wedding Vendor Cash Tip Schedule</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Total Cash Gratuities Needed: <strong>${resTotalGratuity.textContent}</strong> (${resEnvelopeCount.textContent})</p>
				
				<h3>Cash Tip Envelope Distribution Schedule:</h3>
				<table>
					<thead>
						<tr>
							<th>Vendor / Staff Role</th>
							<th>When to Hand Out</th>
							<th>Assigned Delegate</th>
							<th style="text-align:right;">Cash Tip Amount</th>
						</tr>
					</thead>
					<tbody>
						${rows}
						<tr style="background:#f2f2f2; font-weight:bold; font-size:15px;">
							<td colspan="3">Total Gratuity Budget Needed</td>
							<td style="text-align:right; color:#b91c1c;">${resTotalGratuity.textContent}</td>
						</tr>
					</tbody>
				</table>

				<h3 style="margin-top:25px;">Day-Of Cash Tips Checklist:</h3>
				<p>• Seal exact cash in labeled envelopes 3-5 days before wedding.</p>
				<p>• Hand all envelopes to the designated Best Man or Wedding Planner at rehearsal.</p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Vendor_Tips_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString();
		document.getElementById('print-total').textContent = resTotalGratuity.textContent;

		const tbody = document.getElementById('print-tipping-body');
		tbody.innerHTML = `
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Catering & Banquet Staff</td><td style="border:1px solid #ccc; padding:6px;">End of Reception</td><td style="border:1px solid #ccc; padding:6px;">Best Man / Coordinator</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resCatererTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Hair & Makeup Artists</td><td style="border:1px solid #ccc; padding:6px;">After Suite Styling</td><td style="border:1px solid #ccc; padding:6px;">Maid of Honor</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resBeautyTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Photo & Video Team</td><td style="border:1px solid #ccc; padding:6px;">End of Reception</td><td style="border:1px solid #ccc; padding:6px;">Best Man</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPhotoTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">DJ & Live Musicians</td><td style="border:1px solid #ccc; padding:6px;">End of Reception</td><td style="border:1px solid #ccc; padding:6px;">Best Man</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDjTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Planner / Coordinator</td><td style="border:1px solid #ccc; padding:6px;">End of Reception</td><td style="border:1px solid #ccc; padding:6px;">Mother of Bride</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resPlannerTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Drivers & Officiant</td><td style="border:1px solid #ccc; padding:6px;">Upon Service Completion</td><td style="border:1px solid #ccc; padding:6px;">Best Man</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resLogisticsTip.textContent}</td></tr>
			<tr><td style="border:1px solid #ccc; padding:6px; font-weight:bold;">Delivery & Setup Crews</td><td style="border:1px solid #ccc; padding:6px;">Upon Morning Drop-off</td><td style="border:1px solid #ccc; padding:6px;">Day-Of Coordinator</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold;">${resDeliveryTip.textContent}</td></tr>
			<tr style="background:#f2f2f2;"><td colspan="3" style="border:1px solid #ccc; padding:6px; font-weight:bold; font-size:13px;">Total Gratuities Prepared</td><td style="border:1px solid #ccc; padding:6px; text-align:right; font-weight:bold; font-size:13px; color:#b91c1c;">${resTotalGratuity.textContent}</td></tr>
		`;

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Vendor Role,Timing,Delegate,Cash Amount\n";
		csv += `"Catering & Waitstaff","End of Reception","Best Man / Coordinator","${resCatererTip.textContent}"\n`;
		csv += `"Hair & Makeup Artists","After Suite Styling","Maid of Honor","${resBeautyTip.textContent}"\n`;
		csv += `"Photo & Video Team","End of Reception","Best Man","${resPhotoTip.textContent}"\n`;
		csv += `"DJ & Musicians","End of Reception","Best Man","${resDjTip.textContent}"\n`;
		csv += `"Wedding Planner","End of Reception","Mother of Bride","${resPlannerTip.textContent}"\n`;
		csv += `"Drivers & Officiant","Upon Service Completion","Best Man","${resLogisticsTip.textContent}"\n`;
		csv += `"Delivery & Setup Crews","Upon Drop-off","Day-Of Coordinator","${resDeliveryTip.textContent}"\n`;
		csv += `"Total Gratuities","--","--","${resTotalGratuity.textContent}"\n`;

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Vendor_Tips_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	calculateTips();
</script>
