---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Wedding Late-Night Snack & Pizza Calculator",
      "url": "https://manage.wedding/wedding-late-night-snack-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calculate exact pizza pies, sliders, tacos, and snack portions for wedding late-night cravings based on alcohol volume and late-night guest drop-off rates.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Calculate Wedding Late-Night Food Quantities",
      "description": "A proven catering formula to estimate how many guests stay late, how many pizza boxes or food truck portions to order, and when to schedule delivery.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Estimate Late-Night Attendance Rate",
          "text": "Typically, 60% to 70% of total wedding guests remain for the final 2 hours of dancing and after-party."
        },
        {
          "@type": "HowToStep",
          "name": "Select Snack Type & Alcohol Level",
          "text": "Choose between delivery pizza (2 slices/guest), sliders (2/guest), tacos (2-3/guest), or soft pretzels, factoring in open-bar alcohol consumption."
        },
        {
          "@type": "HowToStep",
          "name": "Calculate Pie Counts & Flavor Ratios",
          "text": "Divide total slices by 8 (standard large pie) with a 50% pepperoni, 30% cheese, and 20% vegetarian/specialty split."
        },
        {
          "@type": "HowToStep",
          "name": "Schedule Delivery Timing",
          "text": "Coordinate delivery exactly 90 minutes before the send-off (usually 10:00 PM or 10:30 PM) so food is piping hot."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What percentage of wedding guests eat late-night snacks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Approximately 60% to 70% of total guests stay until the final hours. Of those remaining, virtually 90% to 100% will grab a late-night snack, especially if alcohol was served."
          }
        },
        {
          "@type": "Question",
          "name": "How many pizzas should I order for 100 wedding guests?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For 100 total guests, expect ~65 guests to stay late. At 2 slices per person (130 slices total / 8 slices per large pie), order approximately 16 to 18 large pizzas."
          }
        },
        {
          "@type": "Question",
          "name": "What time should late-night food be served at a wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Late-night food is best served 1 to 1.5 hours before the reception ends (typically 10:00 PM for an 11:30 PM grand exit). This re-energizes the dance floor before the last call."
          }
        },
        {
          "@type": "Question",
          "name": "What are the most popular wedding late-night snack options?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The top 5 favorites are: (1) Local delivery pizza / flatbreads, (2) Mini smash burger sliders with french fry cones, (3) Street taco truck, (4) Warm soft pretzels with beer cheese, and (5) Gourmet donut or churro station."
          }
        }
      ]
    }
  ]
};
---

<Layout
	title="Wedding Late-Night Snack & Pizza Calculator — Food Sizer"
	description="Calculate how many pizzas, sliders, tacos, or pretzel snacks to order for wedding late-night cravings based on guest headcount and bar consumption."
	schema={jsonLd}
>
	<nav class="breadcrumb-nav" aria-label="Breadcrumb" style="max-width: 1200px; margin: 1rem auto 0; padding: 0 1rem; font-size: 0.88rem;">
		<ol style="list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; color: var(--text-secondary);">
			<li><a href="/" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li><a href="/dining" style="color: var(--text-secondary); text-decoration: none;">Dining & Catering</a></li>
			<li><span style="color: var(--text-muted);">&rsaquo;</span></li>
			<li aria-current="page" style="color: var(--fg-pencil); font-weight: 700;">Late-Night Snack Calculator</li>
		</ol>
	</nav>

	<main style="max-width: 1200px; margin: 0 auto; padding: 1rem 1rem 3.5rem;">
		
		<!-- Hero Section -->
		<div style="text-align: center; margin-bottom: 2rem;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			<div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--post-it); border: 2px solid var(--fg-pencil); border-radius: 999px; padding: 4px 14px; margin-bottom: 0.75rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<span>🍕</span>
				<span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil);">Dance Floor Fuel & Late-Night Catering Sizer</span>
			</div>
			<h1 class="font-heading" style="font-size: clamp(1.85rem, 4vw, 2.75rem); color: var(--fg-pencil); margin: 0.25rem 0 0.75rem; line-height: 1.15;">
				Wedding Late-Night Snack & Pizza Calculator
			</h1>
			<p class="font-body" style="font-size: 1.05rem; color: var(--text-secondary); max-width: 780px; margin: 0 auto; line-height: 1.5;">
				Never run out of dance floor fuel or over-order 20 wasted pizza boxes. Calculate <strong>exact late-night attendee headcount</strong>, pie counts by topping, slider quantities, and delivery schedules.
			</p>
		</div>

		<!-- Interactive Calculator Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start; margin-bottom: 2.5rem;">
			
			<!-- Left Column: Inputs -->
			<div class="hand-card" style="padding: 1.5rem; background: #fff;">
				<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					<span>👥</span> 1. Guest Count & Party Energy
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div>
						<label for="input-total-guests" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Total Dinner Guests:</label>
						<input type="number" id="input-total-guests" min="20" max="500" value="120" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-weight: 700;" />
					</div>
					<div>
						<label for="select-crowd-stay" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Crowd Staying Late (%):</label>
						<select id="select-crowd-stay" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="0.55">Moderate / Older Crowd (55%)</option>
							<option value="0.65" selected>Standard Wedding Party (65%)</option>
							<option value="0.80">Party Animal / College Crew (80%)</option>
						</select>
					</div>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					🍔 2. Snack Selection & Bar Appetite
				</h2>

				<div style="margin-bottom: 1rem;">
					<label for="select-snack-type" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Late-Night Food Concept:</label>
					<select id="select-snack-type" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="pizza" selected>🍕 Delivery Pizza (Large 14-16" 8-slice pies)</option>
						<option value="sliders">🍔 Mini Sliders & French Fry Cones</option>
						<option value="tacos">🌮 Street Tacos (Carne Asada, Chicken, Veggie)</option>
						<option value="pretzels">🥨 Warm Soft Bavarian Pretzels & Beer Cheese</option>
						<option value="donuts">🍩 Gourmet Donut Wall / Warm Churros</option>
					</select>
				</div>

				<div style="margin-bottom: 1rem;">
					<label for="select-bar-factor" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Reception Bar & Drunk Munchies Factor:</label>
					<select id="select-bar-factor" style="width: 100%; padding: 0.45rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
						<option value="1.0">🍺 Moderate Drinks / Cash Bar (1.8 - 2.0 items/person)</option>
						<option value="1.15" selected>🍸 Open Bar / Lively Dance Floor (2.2 - 2.5 items/person)</option>
						<option value="1.30">🔥 Heavy Open Bar / After-Party Rave (2.8 - 3.0 items/person)</option>
					</select>
				</div>

				<h2 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 1.25rem 0 0.75rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem;">
					⏰ 3. Reception End Time & Pricing
				</h2>

				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div>
						<label for="input-reception-end" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Reception Send-Off:</label>
						<select id="input-reception-end" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
							<option value="22:00">10:00 PM</option>
							<option value="23:00" selected>11:00 PM</option>
							<option value="24:00">12:00 Midnight</option>
							<option value="01:00">1:00 AM</option>
						</select>
					</div>
					<div>
						<label for="input-unit-cost" style="display: block; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 0.2rem;">Estimated Cost ($/pie or $/person):</label>
						<input type="number" id="input-unit-cost" min="1" max="100" value="22" style="width: 100%; padding: 0.4rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;" />
					</div>
				</div>

			</div>

			<!-- Right Column: Results -->
			<div class="hand-card" style="padding: 1.5rem; background: #fffdfa; border-color: var(--fg-pencil); position: sticky; top: 1rem;">
				<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<div>
						<span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary);">Catering Sizing</span>
						<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							Late-Night Snack Order
						</h2>
					</div>
					<span id="badge-night-guests" style="background: var(--post-it); border: 1.5px solid var(--fg-pencil); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">78 Late Guests</span>
				</div>

				<!-- Big Number Highlights -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Total To Order</span>
						<strong id="stat-primary-quantity" style="font-size: 2rem; font-weight: 900; color: #b91c1c; line-height: 1.1;">22 Pizzas</strong>
						<span id="stat-primary-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">(176 total slices)</span>
					</div>

					<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 0.85rem; text-align: center; box-shadow: 3px 3px 0px var(--fg-pencil);">
						<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Estimated Cost</span>
						<strong id="stat-total-cost" style="font-size: 2rem; font-weight: 900; color: #1e40af; line-height: 1.1;">$484</strong>
						<span id="stat-cost-sub" style="font-size: 0.75rem; color: #64748b; display: block; margin-top: 2px;">~$6.20 per late-night guest</span>
					</div>
				</div>

				<!-- Pizza Breakdown / Toppings Box -->
				<div id="box-pizza-breakdown" style="background: #fef3c7; border: 1.5px solid #d97706; border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.85rem;">
					<strong style="color: #92400e; display: block; margin-bottom: 0.35rem;">🍕 Recommended Pizza Topping Breakdown:</strong>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; color: #78350f;">
						<div>• <strong id="stat-top-pep">11 Pepperoni / Meat</strong></div>
						<div>• <strong id="stat-top-cheese">7 Classic Cheese / Margherita</strong></div>
						<div>• <strong id="stat-top-veg">3 Veggie / Mushroom</strong></div>
						<div>• <strong id="stat-top-gf">1 Gluten-Free / Vegan</strong></div>
					</div>
				</div>

				<!-- Schedule & Delivery Timeline Box -->
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem; margin-bottom: 1.25rem; font-size: 0.88rem;">
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🚚 Delivery / Food Truck Arrival:</span>
						<strong id="stat-time-delivery" style="color: #1e40af;">9:30 PM</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px dashed #cbd5e1;">
						<span style="color: #475569;">🛎️ Serving / Dance Floor Drop:</span>
						<strong id="stat-time-serve" style="color: #b91c1c;">9:45 PM</strong>
					</div>
					<div style="display: flex; justify-content: space-between; padding: 0.25rem 0;">
						<span style="color: #475569;">🎆 Grand Send-Off / Last Call:</span>
						<strong id="stat-time-exit" style="color: var(--fg-pencil);">11:00 PM</strong>
					</div>
				</div>

				<!-- Action Buttons -->
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
					<button type="button" id="btn-print-summary" class="hand-btn" style="flex: 1; background: var(--accent-red); color: #fff; padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>🖨️</span> Print Order Sheet (PDF)
					</button>
					<button type="button" id="btn-export-doc" class="hand-btn" style="flex: 1; background: #fff; color: var(--fg-pencil); padding: 0.6rem 1rem; font-size: 0.9rem; font-weight: 700; border: 2px solid var(--fg-pencil); border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
						<span>📄</span> Export Word (.doc)
					</button>
				</div>
			</div>

		</div>

		<!-- Pro-Tips Section -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem;">
				💡 Expert Rules for Late-Night Wedding Food
			</h2>
			
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; font-size: 0.88rem;">
				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						1. Keep It Handheld & Napkin-Only
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						Guests on the dance floor will not sit down with forks and knives. Choose bite-sized sliders, pizza slices in parchment squares, or paper fry cones that can be eaten with one hand while holding a drink.
					</p>
				</div>

				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						2. Pre-Order Weeks in Advance
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						Do NOT call a local pizzeria at 9:30 PM on a Saturday asking for 25 large pies! Call 2 weeks ahead, pre-pay, and confirm a strict delivery window with a 15-minute buffer.
					</p>
				</div>

				<div style="border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; background: #f8fafc;">
					<strong style="color: #1e40af; display: block; font-size: 0.95rem; margin-bottom: 0.3rem;">
						3. Designate a "Snack Captain"
					</strong>
					<p style="color: #334155; margin: 0; line-height: 1.45;">
						Assign a groomsman, day-of coordinator, or usher to receive the delivery driver, tip in cash, and set out napkins so the bride and groom stay on the dance floor uninterrupted.
					</p>
				</div>
			</div>
		</section>

		<!-- Frequently Asked Questions -->
		<section class="hand-card" style="padding: 1.75rem; background: #fff; margin-bottom: 2.5rem;">
			<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1.25rem;">
				❓ Frequently Asked Questions: Late-Night Snacks
			</h2>
			
			<div style="display: flex; flex-direction: column; gap: 1rem;">
				<div style="border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.85rem;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						Do I have to feed the entire guest list for late-night food?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						No. Grandparents, families with young children, and older guests almost always depart immediately after cake cutting and first dances. Budgeting for 60% to 70% of total dinner guests avoids wasteful leftover food.
					</p>
				</div>

				<div style="border-bottom: 1px dashed #cbd5e1; padding-bottom: 0.85rem;">
					<h3 style="font-size: 1rem; font-weight: 700; color: var(--fg-pencil); margin: 0 0 0.35rem;">
						What about dietary restrictions for late-night snacks?
					</h3>
					<p style="font-size: 0.88rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
						Always include at least 1–2 gluten-free / vegan options clearly labeled in a separate box so guests with celiac disease or dairy allergies can safely celebrate with everyone else.
					</p>
				</div>
			</div>
		</section>

		<!-- Related Tools Component -->
		<RelatedTools currentPath="/wedding-late-night-snack-calculator" category="dining" />

	</main>

	<!-- Hidden Print Containers for Vector PDF / Window.print -->
	<div id="print-root" class="print-only">
		<div id="print-snack-container" class="print-page" style="padding: 10mm;">
			<div style="border-bottom: 2pt solid #000; padding-bottom: 4mm; margin-bottom: 6mm;">
				<h1 style="font-size: 20pt; margin: 0 0 3mm 0; color: #000;">Wedding Late-Night Snack & Pizza Order Sheet</h1>
				<p id="print-snack-meta" style="font-size: 10.5pt; color: #333; margin: 0;">Catering Coordinator & Delivery Order | Manage.Wedding</p>
			</div>
			<div id="print-snack-tables">
			</div>
		</div>
	</div>
</Layout>

<style>
	.hand-card {
		background: #fff;
		border: 2px solid var(--fg-pencil);
		border-radius: 8px;
		box-shadow: 4px 4px 0px var(--fg-pencil);
	}

	.badge-postit {
		background: var(--post-it);
		border: 1.5px solid var(--fg-pencil);
		box-shadow: 2px 2px 0px var(--fg-pencil);
	}
</style>

<style is:global>
	.print-only {
		display: none;
	}

	@media print {
		nav,
		footer,
		.nav-sketch,
		.site-footer,
		.site-header,
		.nav-links-desktop,
		.lang-dropdown-wrapper,
		.hamburger-btn,
		.no-print,
		main,
		.breadcrumb-nav {
			display: none !important;
		}

		.print-only,
		#print-root {
			display: block !important;
			visibility: visible !important;
			position: static !important;
			width: 100% !important;
			background: #fff !important;
			color: #000 !important;
		}

		#print-root * {
			visibility: visible !important;
		}

		.print-page {
			page-break-after: always !important;
			break-after: page !important;
		}
	}
</style>

<script is:inline>
	// Elements
	const inputTotalGuests = document.getElementById('input-total-guests');
	const selectCrowdStay = document.getElementById('select-crowd-stay');
	const selectSnackType = document.getElementById('select-snack-type');
	const selectBarFactor = document.getElementById('select-bar-factor');
	const inputReceptionEnd = document.getElementById('input-reception-end');
	const inputUnitCost = document.getElementById('input-unit-cost');

	const badgeNightGuests = document.getElementById('badge-night-guests');
	const statPrimaryQuantity = document.getElementById('stat-primary-quantity');
	const statPrimarySub = document.getElementById('stat-primary-sub');
	const statTotalCost = document.getElementById('stat-total-cost');
	const statCostSub = document.getElementById('stat-cost-sub');

	const boxPizzaBreakdown = document.getElementById('box-pizza-breakdown');
	const statTopPep = document.getElementById('stat-top-pep');
	const statTopCheese = document.getElementById('stat-top-cheese');
	const statTopVeg = document.getElementById('stat-top-veg');
	const statTopGf = document.getElementById('stat-top-gf');

	const statTimeDelivery = document.getElementById('stat-time-delivery');
	const statTimeServe = document.getElementById('stat-time-serve');
	const statTimeExit = document.getElementById('stat-time-exit');

	function calculateSnacks() {
		const totalGuests = Math.max(10, parseInt(inputTotalGuests.value, 10) || 120);
		const stayRate = parseFloat(selectCrowdStay.value) || 0.65;
		const lateGuests = Math.round(totalGuests * stayRate);
		const barMultiplier = parseFloat(selectBarFactor.value) || 1.15;
		const unitCost = parseFloat(inputUnitCost.value) || 22;
		const snackType = selectSnackType.value;

		badgeNightGuests.textContent = `${lateGuests} Late Guests`;

		let totalCost = 0;

		if (snackType === 'pizza') {
			boxPizzaBreakdown.style.display = 'block';
			const slicesPerPerson = 2.25 * barMultiplier;
			const totalSlices = Math.round(lateGuests * slicesPerPerson);
			const totalPies = Math.ceil(totalSlices / 8);

			statPrimaryQuantity.textContent = `${totalPies} Large Pizzas`;
			statPrimarySub.textContent = `(${totalSlices} total 8-cut slices)`;

			const pepPies = Math.round(totalPies * 0.50);
			const cheesePies = Math.round(totalPies * 0.30);
			const vegPies = Math.max(1, Math.round(totalPies * 0.15));
			const gfPies = Math.max(1, totalPies - pepPies - cheesePies - vegPies);

			statTopPep.textContent = `${pepPies} Pepperoni / Meat Lover`;
			statTopCheese.textContent = `${cheesePies} 4-Cheese / Margherita`;
			statTopVeg.textContent = `${vegPies} Veggie Supreme / Mushroom`;
			statTopGf.textContent = `${gfPies} Gluten-Free / Vegan Crust`;

			totalCost = totalPies * unitCost;
		} else if (snackType === 'sliders') {
			boxPizzaBreakdown.style.display = 'none';
			const slidersPerPerson = Math.round(2.3 * barMultiplier);
			const totalSliders = lateGuests * slidersPerPerson;
			const fryCones = Math.round(lateGuests * 0.9);

			statPrimaryQuantity.textContent = `${totalSliders} Sliders`;
			statPrimarySub.textContent = `+ ${fryCones} French Fry Cones`;
			totalCost = lateGuests * unitCost;
		} else if (snackType === 'tacos') {
			boxPizzaBreakdown.style.display = 'none';
			const tacosPerPerson = Math.round(2.6 * barMultiplier);
			const totalTacos = lateGuests * tacosPerPerson;

			statPrimaryQuantity.textContent = `${totalTacos} Street Tacos`;
			statPrimarySub.textContent = `(~${tacosPerPerson} tacos per late guest)`;
			totalCost = lateGuests * unitCost;
		} else if (snackType === 'pretzels') {
			boxPizzaBreakdown.style.display = 'none';
			const totalPretzels = Math.round(lateGuests * 1.15);

			statPrimaryQuantity.textContent = `${totalPretzels} Warm Pretzels`;
			statPrimarySub.textContent = `+ Warm Beer Cheese & Mustard`;
			totalCost = lateGuests * unitCost;
		} else { // donuts
			boxPizzaBreakdown.style.display = 'none';
			const totalDonuts = Math.round(lateGuests * 1.5);

			statPrimaryQuantity.textContent = `${totalDonuts} Donuts / Churros`;
			statPrimarySub.textContent = `(~1.5 sweet treats per guest)`;
			totalCost = lateGuests * unitCost;
		}

		statTotalCost.textContent = `$${Math.round(totalCost).toLocaleString()}`;
		statCostSub.textContent = `~$${(totalCost / lateGuests).toFixed(2)} per late-night attendee`;

		// Timing Logic
		const endTime = inputReceptionEnd.value;
		let [endH, endM] = endTime.split(':').map(Number);
		if (endH === 24) endH = 0;

		const formatTime = (h, m) => {
			const ampm = h >= 12 && h < 24 ? 'PM' : 'AM';
			let displayH = h % 12;
			if (displayH === 0) displayH = 12;
			return `${displayH}:${m < 10 ? '0' : ''}${m} ${ampm}`;
		};

		let serveH = (endH - 1 + 24) % 24;
		let serveM = (endM - 15 + 60) % 60;
		if (endM < 15) serveH = (serveH - 1 + 24) % 24;

		let delivH = (serveH + 24) % 24;
		let delivM = (serveM - 15 + 60) % 60;
		if (serveM < 15) delivH = (delivH - 1 + 24) % 24;

		statTimeDelivery.textContent = formatTime(delivH, delivM);
		statTimeServe.textContent = formatTime(serveH, serveM);
		statTimeExit.textContent = formatTime(endH, endM);

		// Print Layout
		document.getElementById('print-snack-tables').innerHTML = `
			<table style="width:100%; border-collapse:collapse; font-size:10pt; text-align:left; margin-top:10px;">
				<thead>
					<tr style="background:#e2e8f0; border-bottom:2pt solid #000;">
						<th style="padding:6pt;">Planning Variable</th>
						<th style="padding:6pt;">Calculated Metric</th>
						<th style="padding:6pt; text-align:right;">Order Quantity</th>
					</tr>
				</thead>
				<tbody>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Late-Night Headcount</td>
						<td style="padding:6pt;">${totalGuests} total guests x ${Math.round(stayRate * 100)}% stay rate</td>
						<td style="padding:6pt; text-align:right;"><strong>${lateGuests} guests</strong></td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Snack Requirement</td>
						<td style="padding:6pt;">${selectSnackType.options[selectSnackType.selectedIndex].text}</td>
						<td style="padding:6pt; text-align:right; font-weight:bold; color:#b91c1c;">${statPrimaryQuantity.textContent}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Delivery Arrival Target</td>
						<td style="padding:6pt;">Pre-arranged delivery window for hot food</td>
						<td style="padding:6pt; text-align:right; font-weight:bold; color:#1e40af;">${statTimeDelivery.textContent}</td>
					</tr>
					<tr style="border-bottom:1pt solid #cbd5e1;">
						<td style="padding:6pt; font-weight:bold;">Dance Floor Serving Time</td>
						<td style="padding:6pt;">Served 75 mins before reception end</td>
						<td style="padding:6pt; text-align:right; font-weight:bold;">${statTimeServe.textContent}</td>
					</tr>
					<tr style="background:#f0fdf4; font-weight:bold; font-size:11pt; border-top:2pt solid #15803d;">
						<td style="padding:8pt; color:#15803d;">ESTIMATED FOOD COST</td>
						<td style="padding:8pt; color:#15803d;">Delivery / Food Truck total</td>
						<td style="padding:8pt; text-align:right; color:#15803d;">$${Math.round(totalCost)}</td>
					</tr>
				</tbody>
			</table>
		`;
	}

	// Listeners
	[inputTotalGuests, selectCrowdStay, selectSnackType, selectBarFactor, inputReceptionEnd, inputUnitCost].forEach(el => {
		el.addEventListener('input', calculateSnacks);
		el.addEventListener('change', calculateSnacks);
	});

	// Print PDF
	document.getElementById('btn-print-summary').addEventListener('click', () => {
		calculateSnacks();
		window.print();
	});

	// Export Word
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		calculateSnacks();
		const totalCost = statTotalCost.textContent;
		const quantity = statPrimaryQuantity.textContent;
		const lateGuests = badgeNightGuests.textContent;
		const deliveryTime = statTimeDelivery.textContent;

		const html = `
			<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
			<head><meta charset='utf-8'><title>Late Night Wedding Snacks</title>
			<style>body{font-family:Arial,sans-serif;line-height:1.4;} table{border-collapse:collapse;width:100%;} th,td{padding:6pt;border:1pt solid #ccc;text-align:left;}</style>
			</head>
			<body>
				<h1>Wedding Late-Night Snack & Pizza Order</h1>
				<p><strong>Estimated Late-Night Guests:</strong> ${lateGuests} | <strong>Quantity to Order:</strong> ${quantity} | <strong>Target Delivery Time:</strong> ${deliveryTime} | <strong>Total Cost:</strong> ${totalCost}</p>
				<hr/>
				<p><em>Generated by Manage.Wedding</em></p>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Late-Night-Snack-Order-${new Date().toISOString().slice(0,10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	calculateSnacks();
</script>
