---
import Layout from '../layouts/Layout.astro';

const newTools = [
  {
    id: "wedding-envelope-addressing",
    title: "Wedding Envelope Address Formatter",
    category: "stationery",
    categoryLabel: "Stationery & Printables",
    icon: "✉️",
    badge: "💌 Etiquette & A7",
    badgeColor: "#dc2626",
    desc: "Format A7 outer envelopes, A2 RSVP envelopes, and inner envelopes with proper etiquette for married couples, doctors, unmarried couples, and families. Features live font switcher, batch CSV guest importer, and printable PDF/Word export.",
    time: "2 mins",
    tags: ["A7 Envelope Sizes", "Outer & Inner Envelopes", "Batch CSV Importer", "Printable PDF"],
    url: "/wedding-envelope-addressing",
    btnText: "Format Envelopes →"
  },
  {
    id: "wedding-thank-you-cards",
    title: "Wedding Thank-You Note Generator",
    category: "stationery",
    categoryLabel: "Stationery & Printables",
    icon: "✍️",
    badge: "✍️ Cash & Registry",
    badgeColor: "#7c3aed",
    desc: "Instant etiquette-approved thank-you note wording generator for cash gifts, honeymoon funds, registry items, wedding attendance, and vendors. Produces 3 tone styles with word counts and handwriting time estimates.",
    time: "2 mins",
    tags: ["Cash Gift Formulas", "Honeymoon Funds", "Vendor Thank Yous", "Stationery Export"],
    url: "/wedding-thank-you-cards",
    btnText: "Generate Notes →"
  },
  {
    id: "seating-clearance-calculator",
    title: "Floor Plan, Dance Floor & Table Sizer",
    category: "guest-management",
    categoryLabel: "Guests & Seating",
    icon: "🕺",
    badge: "🕺 Floor Plan Sizer",
    badgeColor: "#0284c7",
    desc: "Calculate exact dance floor dimensions and 3×3 modular tile counts based on peak dancer formulas. Sizes 60\" vs 72\" round table counts, 60-inch server aisle clearances, and total venue room square footage.",
    time: "2 mins",
    tags: ["Dance Floor Sizing", "60\" Round Tables", "60-Inch Aisle Rule", "Venue Sq Ft Fit"],
    url: "/seating-clearance-calculator",
    btnText: "Size Floor Plan →"
  },
  {
    id: "wedding-processional-order",
    title: "Processional Order & Lineup Builder",
    category: "planning",
    categoryLabel: "Planning & Logistics",
    icon: "⛪",
    badge: "⛪ Ceremony Lineup",
    badgeColor: "#16a34a",
    desc: "Interactive ceremony processional walking lineup and recessional exit builder for Christian, Jewish, Catholic, secular, and LGBTQ+ ceremonies. Reorder with 1-click controls and export printable coordinator pocket guides.",
    time: "3 mins",
    tags: ["Aisle Walking Order", "Jewish & Catholic Presets", "Recessional Exits", "Pocket Guides"],
    url: "/wedding-processional-order",
    btnText: "Build Lineup →"
  },
  {
    id: "wedding-venue-cost-calculator",
    title: "Venue True Cost & Hidden Fee Calculator",
    category: "budgeting",
    categoryLabel: "Budgeting & Finance",
    icon: "🏰",
    badge: "🏰 Plus-Plus (++) Math",
    badgeColor: "#d97706",
    desc: "Unmask the real out-of-pocket total of a venue beyond the base rental. Factors in Food & Beverage minimums, 22% Plus-Plus (++) service fees, sales tax, security guards, cleaning fees, and raw infrastructure rentals.",
    time: "3 mins",
    tags: ["Plus-Plus (++) Math", "Hidden Fee Audit", "Hotel vs Barn vs Estate", "PDF Contract Sheet"],
    url: "/wedding-venue-cost-calculator",
    btnText: "Audit Venue Cost →"
  },
  {
    id: "wedding-invitation-suite-sizer",
    title: "Invitation Suite Sizer & Layering Guide",
    category: "stationery",
    categoryLabel: "Stationery & Printables",
    icon: "📐",
    badge: "📐 Canva 300 DPI Specs",
    badgeColor: "#4f46e5",
    desc: "Calculate precise layer dimensions, backer mat trimming tolerances, and envelope clearances for A7, A2, A8, Square, and Tea Length suites. Includes full 300 DPI Canva and Photoshop print bleed specifications.",
    time: "2 mins",
    tags: ["A7 5×7 Dimensions", "Backer Mat Borders", "Canva 300 DPI Bleed", "Trim Cut Sheet"],
    url: "/wedding-invitation-suite-sizer",
    btnText: "Size Suite →"
  },
  {
    id: "bachelorette-budget-calculator",
    title: "Bachelorette Budget & Expense Splitter",
    category: "budgeting",
    categoryLabel: "Budgeting & Finance",
    icon: "🍸",
    badge: "👰 Cover the Bride",
    badgeColor: "#db2777",
    desc: "Split Airbnb lodging, groceries, theme decor, and group excursions evenly among bridesmaids while automatically covering the bride's share (N-1 split). Exports formatted WhatsApp and Venmo payment requests in 1-click.",
    time: "2 mins",
    tags: ["Cover the Bride Math", "Venmo Text Exporter", "Nashville vs Scottsdale", "Theme Ideas"],
    url: "/bachelorette-budget-calculator",
    btnText: "Split Budget →"
  },
  {
    id: "wedding-invitation-postage-calculator",
    title: "Invitation Postage & Weight Calculator",
    category: "stationery",
    categoryLabel: "Stationery & Printables",
    icon: "📮",
    badge: "📮 USPS 2026 Rates",
    badgeColor: "#059669",
    desc: "Calculate exact envelope weight and USPS postage rates. Automatically detects wax seals, square shapes, and ribbon ties that trigger the $0.44 non-machinable fee. Includes hand-canceling checklist.",
    time: "2 mins",
    tags: ["Wax Seal Surcharges", "1oz vs 2oz Forever Stamps", "Hand-Canceling Guide", "Stamp Shopping List"],
    url: "/wedding-invitation-postage-calculator",
    btnText: "Calculate Postage →"
  },
  {
    id: "who-pays-for-what-wedding",
    title: "Who Pays for What? Expense Splitter",
    category: "budgeting",
    categoryLabel: "Budgeting & Finance",
    icon: "👥",
    badge: "👥 1950s vs Modern",
    badgeColor: "#b45309",
    desc: "Compare 1950s traditional etiquette against modern 3-way family splits (Couple + Bride's Family + Groom's Family). Assign ownership for 20+ line items with printable financial agreements.",
    time: "2 mins",
    tags: ["Traditional 1950s Etiquette", "3-Way Family Splits", "Rehearsal Dinner Sponsor", "Printable Agreement"],
    url: "/who-pays-for-what-wedding",
    btnText: "Split Expenses →"
  },
  {
    id: "rehearsal-dinner-planner",
    title: "Rehearsal Dinner Guest & Budget Planner",
    category: "planning",
    categoryLabel: "Planning & Logistics",
    icon: "🍷",
    badge: "🍷 Rehearsal Timeline",
    badgeColor: "#9333ea",
    desc: "Calculate tiered guest list headcounts (bridal party vs out-of-towners), private dining costs, and generate minute-by-minute rehearsal night timelines from 5:00 PM ceremony walkthrough to 9:30 PM toasts.",
    time: "2 mins",
    tags: ["Tiered Headcounts", "Welcome Drinks Strategy", "Rehearsal Timeline", "Private Dining Math"],
    url: "/rehearsal-dinner-planner",
    btnText: "Plan Rehearsal →"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/new-tools/#collection",
      "name": "New Wedding Planning Calculators & Tools — Manage.Wedding",
      "url": "https://manage.wedding/new-tools",
      "description": "Explore the newest 10 high-traffic wedding planning calculators: Envelope Address Formatter, Thank-You Note Generator, Venue Cost Calculator, Dance Floor Sizer, Bachelorette Splitter, and more.",
      "hasPart": newTools.map(t => ({
        "@type": "WebApplication",
        "name": t.title,
        "url": `https://manage.wedding${t.url}`,
        "description": t.desc
      }))
    }
  ]
};
---

<Layout 
	title="New Wedding Planning Calculators & Interactive Tools (2026 Collection)"
	description="Discover our newest 10 free wedding tools: Envelope Formatter, Thank-You Generator, Venue True Cost, Dance Floor Sizer, Bachelorette Splitter, and Postage Calculator."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1240px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 3rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit" style="background: #fef08a; border: 2px solid var(--fg-pencil); color: var(--fg-pencil); font-weight: 800;">
				✨ Fresh 2026 Additions
			</span>
			<h1 class="font-heading" style="font-size: clamp(2.2rem, 5.5vw, 3.8rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.15;">
				New Wedding <span class="accent-italic">Calculators & Tools</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 780px; margin: 0 auto; font-size: 1.2rem; line-height: 1.6;">
				Explore our 10 newest interactive calculators designed to eliminate wedding stress, decode hidden venue fees, format stationery, and split budgets with ease.
			</p>

			<!-- Quick Metric Badges -->
			<div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 6px 14px; font-size: 0.92rem; font-weight: 700; box-shadow: 2px 2px 0px var(--fg-pencil);">
					🎉 10 Brand New Tools
				</div>
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 6px 14px; font-size: 0.92rem; font-weight: 700; box-shadow: 2px 2px 0px var(--fg-pencil);">
					📱 Instant Mobile & PDF Export
				</div>
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 6px 14px; font-size: 0.92rem; font-weight: 700; box-shadow: 2px 2px 0px var(--fg-pencil);">
					🔒 100% Free & Local-First
				</div>
			</div>
		</header>

		<!-- Interactive Category Filter Bar -->
		<div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
			<button class="filter-pill active" data-filter="all" style="cursor: pointer; padding: 8px 18px; border-radius: 20px; font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; border: 2px solid var(--fg-pencil); background: var(--fg-pencil); color: #fff; transition: all 0.2s;">
				All 10 New Tools
			</button>
			<button class="filter-pill" data-filter="stationery" style="cursor: pointer; padding: 8px 18px; border-radius: 20px; font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; border: 2px solid var(--fg-pencil); background: #fff; color: var(--fg-pencil); transition: all 0.2s;">
				💌 Stationery & Postage (4)
			</button>
			<button class="filter-pill" data-filter="budgeting" style="cursor: pointer; padding: 8px 18px; border-radius: 20px; font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; border: 2px solid var(--fg-pencil); background: #fff; color: var(--fg-pencil); transition: all 0.2s;">
				💰 Budgeting & Splitting (3)
			</button>
			<button class="filter-pill" data-filter="planning" style="cursor: pointer; padding: 8px 18px; border-radius: 20px; font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; border: 2px solid var(--fg-pencil); background: #fff; color: var(--fg-pencil); transition: all 0.2s;">
				📅 Planning & Rehearsal (2)
			</button>
			<button class="filter-pill" data-filter="guest-management" style="cursor: pointer; padding: 8px 18px; border-radius: 20px; font-family: var(--font-heading); font-weight: 700; font-size: 0.95rem; border: 2px solid var(--fg-pencil); background: #fff; color: var(--fg-pencil); transition: all 0.2s;">
				👥 Seating & Floor Plans (1)
			</button>
		</div>

		<!-- 10 Tools Showcase Grid -->
		<div id="tools-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
			{newTools.map((tool, idx) => (
				<div class="hand-card tool-card-item" data-category={tool.category} style="display: flex; flex-direction: column; justify-content: space-between; padding: 1.75rem; background: #fff; border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative; transition: transform 0.2s, box-shadow 0.2s;">
					
					<div>
						<!-- Top Card Header with Badge -->
						<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem; gap: 0.5rem;">
							<span style="font-size: 2.2rem; line-height: 1;">{tool.icon}</span>
							<span style={`font-size: 0.78rem; font-weight: 800; background: ${tool.badgeColor}; color: #fff; padding: 4px 10px; border-radius: 4px; border: 1.5px solid var(--fg-pencil); text-transform: uppercase; letter-spacing: 0.03em; box-shadow: 1.5px 1.5px 0px var(--fg-pencil);`}>
								{tool.badge}
							</span>
						</div>

						<!-- Title -->
						<h2 class="font-heading" style="font-size: 1.45rem; margin: 0 0 0.5rem 0; color: var(--fg-pencil); line-height: 1.25;">
							<a href={tool.url} style="color: inherit; text-decoration: none;">
								{tool.title}
							</a>
						</h2>

						<!-- Category & Est Time -->
						<div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.75rem; font-weight: 600;">
							📂 {tool.categoryLabel} • ⏱️ {tool.time}
						</div>

						<!-- Description -->
						<p class="font-body" style="font-size: 0.98rem; line-height: 1.55; color: var(--fg-pencil); margin: 0 0 1.25rem 0;">
							{tool.desc}
						</p>

						<!-- Feature Tags -->
						<div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem;">
							{tool.tags.map(tag => (
								<span style="font-size: 0.75rem; font-weight: 700; background: var(--muted-paper); border: 1px solid var(--fg-pencil); padding: 2px 7px; border-radius: 3px; color: var(--fg-pencil);">
									{tag}
								</span>
							))}
						</div>
					</div>

					<!-- Bottom Launch Button -->
					<a href={tool.url} class="hand-btn" style="width: 100%; text-align: center; text-decoration: none; padding: 12px; font-size: 1.02rem; justify-content: center;">
						{tool.btnText}
					</a>

				</div>
			))}
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Bottom Line Up Front (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Why We Built These 10 New Wedding Tools
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Modern couples are tired of wedding paywalls, spam emails, and clumsy spreadsheet math. Here is how our new tools solve real planning roadblocks:
				</p>
			</div>

			<!-- Comparison Matrix Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Common Wedding Roadblock</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">The Problem</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Our Solution & Tool</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Venue Hidden Fees</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">A $6,000 venue quote turns into $25k+ after F&B minimums and 22% ++ service fees.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;"><a href="/wedding-venue-cost-calculator">Venue True Cost Calculator →</a></td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Returned Mail / Insufficient Postage</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Wax seals and square cards get hit with $0.44 non-machinable surcharges.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;"><a href="/wedding-invitation-postage-calculator">Postage & Weight Calculator →</a></td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Awkward Bachelorette Money Talks</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Maids of honor struggle to divide Airbnb, decor, and dining while comping the bride.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;"><a href="/bachelorette-budget-calculator">Bachelorette Budget Splitter →</a></td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Dance Floor & Table Crowding</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Oversized dance floors kill party energy; cramped tables block catering servers.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;"><a href="/seating-clearance-calculator">Floor Plan & Dance Floor Sizer →</a></td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

	</main>

	<!-- Interactive Category Filter Script -->
	<script is:inline>
		const pills = document.querySelectorAll('.filter-pill');
		const cards = document.querySelectorAll('.tool-card-item');

		pills.forEach(pill => {
			pill.addEventListener('click', () => {
				// Toggle active style
				pills.forEach(p => {
					p.classList.remove('active');
					p.style.background = '#fff';
					p.style.color = 'var(--fg-pencil)';
				});
				pill.classList.add('active');
				pill.style.background = 'var(--fg-pencil)';
				pill.style.color = '#fff';

				const filter = pill.getAttribute('data-filter');

				cards.forEach(card => {
					const cat = card.getAttribute('data-category');
					if (filter === 'all' || cat === filter) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});
			});
		});
	</script>
</Layout>
