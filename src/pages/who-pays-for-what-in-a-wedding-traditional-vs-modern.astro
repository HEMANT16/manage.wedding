---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Who Pays for What in a Wedding: Traditional vs Modern (Line-Item PDF Agreement)",
      "description": "Compare traditional 1950s wedding payment etiquette with modern 50/50 and 3-way split models across 25 line items. Download a printable family financial agreement.",
      "datePublished": "2026-08-18T00:00:00+00:00",
      "dateModified": "2026-08-18T00:00:00+00:00",
      "author": {
        "@type": "Organization",
        "name": "Manage.Wedding Editorial Team",
        "url": "https://manage.wedding"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Manage.Wedding",
        "url": "https://manage.wedding",
        "logo": {
          "@type": "ImageObject",
          "url": "https://manage.wedding/favicon.svg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://manage.wedding/who-pays-for-what-in-a-wedding-traditional-vs-modern"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who pays for the wedding in modern 2026 etiquette?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Over 70% of modern couples pay for a substantial portion (or 100%) of their own wedding. The most popular collaborative model is the 3-Way Split: the couple pays 40-50%, Partner 1's family contributes 25-30%, and Partner 2's family contributes 25-30%."
          }
        },
        {
          "@type": "Question",
          "name": "What did the bride's family traditionally pay for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Historically, the bride's family was responsible for nearly 80% of expenses: the wedding dress, veil, ceremony venue, reception venue, catering, open bar, florals, wedding cake, photography, invitations, and music."
          }
        },
        {
          "@type": "Question",
          "name": "What did the groom's family traditionally pay for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The groom's family traditionally paid for the rehearsal dinner, bride's engagement and wedding rings, marriage license, officiant fee, bridal bouquet, boutonnieres, and the entire honeymoon."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Who Pays for What in a Wedding: Traditional vs Modern (Line-Item PDF Agreement)"
  description="Compare traditional 1950s wedding payment etiquette with modern 50/50 and 3-way split models across 25 line items. Download a printable family financial agreement."
  schema={schema}
>
  <main class="container" style="padding-top: 2rem; padding-bottom: 4rem; max-width: 900px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog", url: "/blog" },
        { name: "Who Pays For What Wedding Breakdown" }
      ]}
    />

    <!-- Header Section -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #fef3c7; color: #92400e; padding: 4px 12px; border-radius: 20px; border: 1.5px solid #d97706; font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem;">
        <span>💵</span>
        <span>Family Financial Agreements & Modern Etiquette</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--fg-pencil); line-height: 1.25; margin-bottom: 1rem;">
        Who Pays for What in a Wedding: Traditional vs Modern <span style="color: #b45309; font-style: italic;">(Line-Item PDF Agreement)</span>
      </h1>
      <div style="display: flex; align-items: center; gap: 1rem; color: var(--text-secondary); font-size: 0.9rem; font-weight: 600;">
        <span>Published: August 2026</span>
        <span>•</span>
        <span>9 min read</span>
        <span>•</span>
        <span>By Manage.Wedding Editorial Team</span>
      </div>
    </header>

    <!-- AI Direct Citation Callout (BLUF) -->
    <div style="background: #f0fdf4; border: 2px solid #16a34a; border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: 3px 3px 0px #16a34a;">
      <div style="font-size: 0.82rem; font-weight: 800; color: #15803d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.4rem;">
        🎯 Modern Contribution Baseline
      </div>
      <p class="font-body" style="font-size: 1.15rem; color: #14532d; font-weight: 600; line-height: 1.5; margin: 0;">
        Traditionally the bride's family paid for the ceremony, reception, and dress while the groom's family paid for rehearsal dinner, marriage license, and honeymoon; today <strong>over 70% of couples contribute directly or split costs equally in 3 ways</strong> between both families and the couple.
      </p>
    </div>

    <!-- Interactive Tool Callout Hero -->
    <div class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem 2rem; margin-bottom: 3rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
      <div>
        <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.35rem;">
          Assign Line Items & Print a Financial Agreement
        </h3>
        <p class="font-body" style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
          Select Traditional, 50/50, or Custom contribution models and export a signed PDF agreement.
        </p>
      </div>
      <a href="/who-pays-for-what-wedding" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 10px 22px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); display: inline-flex; align-items: center; gap: 0.5rem;">
        <span>Open Who Pays Sizer</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Main Content Body -->
    <article class="font-body" style="font-size: 1.1rem; line-height: 1.7; color: var(--fg-pencil);">
      
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2rem 0 1rem;">
        The Evolution of Wedding Expense Splitting
      </h2>
      <p>
        In the 1950s, women often lived with their parents until marriage, making a wedding a formal "giving away" hosted by the bride's father.
      </p>
      <p>
        Today, the average couple gets married at ages 28–33, has established careers, and has lived independently for years. Financial contributions are no longer about rigid patriarchal traditions; they are about open communication, family harmony, and clear financial boundaries.
      </p>

      <!-- 25 Line Item Comparison Table -->
      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        Comprehensive 25 Line-Item Responsibility Matrix
      </h2>

      <div style="overflow-x: auto; margin: 1.5rem 0 2.5rem; border: 2px solid var(--fg-pencil); border-radius: 8px; box-shadow: 3px 3px 0px var(--fg-pencil);">
        <table style="width: 100%; border-collapse: collapse; background: #fff; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="background: #f1f5f9; border-bottom: 2px solid var(--fg-pencil);">
              <th style="padding: 12px 14px; font-weight: 800;">Wedding Line Item</th>
              <th style="padding: 12px 14px; font-weight: 800;">Traditional 1950s Custom</th>
              <th style="padding: 12px 14px; font-weight: 800;">Modern 3-Way Model (2026)</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Reception Venue & Catering</td>
              <td style="padding: 12px 14px; color: #b45309; font-weight: 600;">Bride's Family (100%)</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">Split 3 Ways (Couple + Both Families)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700;">Rehearsal Dinner</td>
              <td style="padding: 12px 14px; color: #0284c7; font-weight: 600;">Groom's Family (100%)</td>
              <td style="padding: 12px 14px; font-weight: 600; color: #0284c7;">Groom's Family or Joint Couple</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Wedding Dress & Veil</td>
              <td style="padding: 12px 14px; color: #b45309; font-weight: 600;">Bride's Family</td>
              <td style="padding: 12px 14px; font-weight: 600;">The Bride / Couple</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700;">Tuxedo / Suit Rental</td>
              <td style="padding: 12px 14px; color: #0284c7; font-weight: 600;">Groom / Groomsmen</td>
              <td style="padding: 12px 14px; font-weight: 600;">The Groom / Couple</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Photography & Videography</td>
              <td style="padding: 12px 14px; color: #b45309; font-weight: 600;">Bride's Family</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #16a34a;">The Couple (Direct Priority)</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700;">Open Bar & Alcohol</td>
              <td style="padding: 12px 14px; color: #b45309; font-weight: 600;">Bride's Family</td>
              <td style="padding: 12px 14px; font-weight: 600; color: #0284c7;">Groom's Family or Shared Bar Fund</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Florals & Ceremony Arch</td>
              <td style="padding: 12px 14px; color: #b45309; font-weight: 600;">Bride's Family</td>
              <td style="padding: 12px 14px; font-weight: 600;">Couple / Partner 1's Family</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
              <td style="padding: 12px 14px; font-weight: 700;">Bridal Bouquet & Boutonnieres</td>
              <td style="padding: 12px 14px; color: #0284c7; font-weight: 600;">Groom's Family</td>
              <td style="padding: 12px 14px; font-weight: 600;">Groom / Included in Floral Package</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 12px 14px; font-weight: 700;">Honeymoon Flights & Resort</td>
              <td style="padding: 12px 14px; color: #0284c7; font-weight: 600;">Groom's Family (100%)</td>
              <td style="padding: 12px 14px; font-weight: 700; color: #7c3aed;">The Couple (via Honeyfund Registry)</td>
            </tr>
            <tr style="background: #fff;">
              <td style="padding: 12px 14px; font-weight: 700;">Marriage License & Officiant Fee</td>
              <td style="padding: 12px 14px; color: #0284c7; font-weight: 600;">Groom's Family</td>
              <td style="padding: 12px 14px; font-weight: 600;">The Couple</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="font-heading" style="font-size: 1.85rem; color: var(--fg-pencil); margin: 2.5rem 0 1rem;">
        How to Have the "Wedding Money Talk" with Parents
      </h2>
      <p>
        Money discussions with parents can feel uncomfortable. Use this proven 3-step conversation script:
      </p>
      <div style="background: #fffbeb; border: 1.5px solid #d97706; border-radius: 8px; padding: 1.5rem; margin-bottom: 2rem;">
        <h3 class="font-heading" style="font-size: 1.15rem; color: #92400e; margin-bottom: 0.5rem;">
          💡 The "Lump Sum vs Specific Line Item" Script
        </h3>
        <p style="font-size: 0.95rem; line-height: 1.6; color: #78350f; margin: 0;">
          <em>"We are currently mapping out our wedding budget and wanted to ask if you'd like to contribute toward a specific element—such as the rehearsal dinner, the photographer, or the wine bar—or if you had a specific lump-sum dollar figure in mind. There is zero pressure; we just want to plan responsibly without any financial surprises!"</em>
        </p>
      </div>

      <!-- Bottom Interactive CTA Section -->
      <div style="background: #f8fafc; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 2rem; box-shadow: 4px 4px 0px var(--fg-pencil); text-align: center; margin: 3rem 0;">
        <h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
          Build & Print Your Line-Item Agreement
        </h3>
        <p class="font-body" style="font-size: 1.05rem; max-width: 600px; margin: 0 auto 1.5rem; color: var(--text-secondary);">
          Assign categories to Partner 1, Partner 2, and both families, then export a clean PDF budget sheet.
        </p>
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="/who-pays-for-what-wedding" style="background: var(--brand-primary, #dc2626); color: #fff; text-decoration: none; font-weight: 700; padding: 12px 24px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Open Who Pays Calculator &rarr;
          </a>
          <a href="/master-budget-calculator" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 12px 20px; border-radius: 6px; font-size: 1rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
            Master Budget Allocator &rarr;
          </a>
        </div>
      </div>

    </article>

    <RelatedTools currentPath="/who-pays-for-what-in-a-wedding-traditional-vs-modern" category="budget-finance" />
  </main>
</Layout>
