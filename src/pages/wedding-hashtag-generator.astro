<script is:inline>
	let selectedFeaturedTag = '#HappilyEverKelce';
	let currentVibeFilter = 'all';

	const p1FirstInput = document.getElementById('p1-first');
	const p1LastInput = document.getElementById('p1-last');
	const p2FirstInput = document.getElementById('p2-first');
	const p2LastInput = document.getElementById('p2-last');
	const nicknameInput = document.getElementById('couple-nickname');
	const yearInput = document.getElementById('wedding-year');
	const cityInput = document.getElementById('wedding-city');

	const displaySelectedHashtag = document.getElementById('display-selected-hashtag');
	const printHashtagDisplay = document.getElementById('print-hashtag-display');
	const tagsCountBadge = document.getElementById('tags-count-badge');
	const hashtagsStreamContainer = document.getElementById('hashtags-stream-container');

	function cap(str) {
		if (!str) return '';
		return str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();
	}

	function clean(str) {
		return str.replace(/[^a-zA-Z0-9]/g, '');
	}

	function generateAllTags() {
		const f1 = cap(clean(p1FirstInput.value.trim())) || 'Taylor';
		const l1 = cap(clean(p1LastInput.value.trim())) || 'Swift';
		const f2 = cap(clean(p2FirstInput.value.trim())) || 'Travis';
		const l2 = cap(clean(p2LastInput.value.trim())) || 'Kelce';
		const nick = cap(clean(nicknameInput.value.trim())) || `${f1}And${f2}`;
		const yr = clean(yearInput.value.trim()) || '2026';
		const y2 = yr.slice(-2);
		const city = cap(clean(cityInput.value.trim())) || 'Paradise';

		const allTags = [
			// Romantic
			{ tag: `#HappilyEver${l2}`, vibe: 'romantic', score: '99%' },
			{ tag: `#HappilyEver${l1}`, vibe: 'romantic', score: '98%' },
			{ tag: `#${f1}And${f2}Forever`, vibe: 'romantic', score: '95%' },
			{ tag: `#${f1}FoundHer${l2}`, vibe: 'romantic', score: '96%' },
			{ tag: `#${l2}PartyOf2`, vibe: 'romantic', score: '94%' },
			{ tag: `#WrittenInTheStars${l2}`, vibe: 'romantic', score: '92%' },
			{ tag: `#ToHaveAndTo${l2}`, vibe: 'romantic', score: '97%' },
			{ tag: `#${f1}And${f2}SayIDo`, vibe: 'romantic', score: '96%' },
			{ tag: `#Forever${l2}`, vibe: 'romantic', score: '93%' },
			{ tag: `#${l1}Meets${l2}`, vibe: 'romantic', score: '91%' },
			{ tag: `#${f1}Hearts${f2}`, vibe: 'romantic', score: '90%' },
			
			// Funny / Punny
			{ tag: `#HookedOn${l2}`, vibe: 'funny', score: '99%' },
			{ tag: `#YouHadMeAt${l2}`, vibe: 'funny', score: '97%' },
			{ tag: `#${l2}CaughtA${l1}`, vibe: 'funny', score: '96%' },
			{ tag: `#ReadySet${l2}`, vibe: 'funny', score: '95%' },
			{ tag: `#HolyMatri${l2}`, vibe: 'funny', score: '98%' },
			{ tag: `#ItWasAlways${l2}`, vibe: 'funny', score: '94%' },
			{ tag: `#TwoLessFishInTheSea${l2}`, vibe: 'funny', score: '93%' },
			{ tag: `#${l1}PutARingOnIt`, vibe: 'funny', score: '95%' },
			{ tag: `#${l2}OrBust`, vibe: 'funny', score: '92%' },
			{ tag: `#BetterTogether${l2}`, vibe: 'funny', score: '91%' },
			{ tag: `#${f1}Takes${l2}`, vibe: 'funny', score: '90%' },

			// Party / Drinks / Celebration
			{ tag: `#CheersToThe${l2}s`, vibe: 'party', score: '99%' },
			{ tag: `#CheersToThe${l1}s`, vibe: 'party', score: '97%' },
			{ tag: `#${l2}TurnedUp`, vibe: 'party', score: '96%' },
			{ tag: `#PourSome${l2}OnMe`, vibe: 'party', score: '98%' },
			{ tag: `#${nick}AllNightLong`, vibe: 'party', score: '95%' },
			{ tag: `#LetThe${l2}sDance`, vibe: 'party', score: '94%' },
			{ tag: `#PopTheBubblyFor${nick}`, vibe: 'party', score: '96%' },
			{ tag: `#${l2}WeddingBash${yr}`, vibe: 'party', score: '93%' },
			{ tag: `#${f1}And${f2}TieTheKnot`, vibe: 'party', score: '92%' },

			// Short & Sweet
			{ tag: `#${f1}And${f2}${yr}`, vibe: 'short', score: '98%' },
			{ tag: `#${f1}And${f2}${y2}`, vibe: 'short', score: '95%' },
			{ tag: `#${nick}${yr}`, vibe: 'short', score: '97%' },
			{ tag: `#${l1}To${l2}${yr}`, vibe: 'short', score: '96%' },
			{ tag: `#The${l2}s${yr}`, vibe: 'short', score: '99%' },
			{ tag: `#Team${nick}`, vibe: 'short', score: '94%' },
			{ tag: `#${f1}Plus${f2}`, vibe: 'short', score: '91%' },

			// Destination
			{ tag: `#${l2}In${city}`, vibe: 'romantic', score: '97%' },
			{ tag: `#${nick}Take${city}`, vibe: 'party', score: '96%' },
			{ tag: `#${f1}And${f2}In${city}`, vibe: 'short', score: '93%' }
		];

		return allTags;
	}

	function renderTags() {
		const allTags = generateAllTags();
		
		const filtered = currentVibeFilter === 'all' 
			? allTags 
			: allTags.filter(t => t.vibe === currentVibeFilter);

		tagsCountBadge.textContent = `${filtered.length} Tags`;

		hashtagsStreamContainer.innerHTML = '';
		filtered.forEach(item => {
			const card = document.createElement('div');
			card.className = 'hand-card';
			card.style.cssText = `padding: 0.75rem; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; transition: transform 0.15s ease;`;
			
			const isFeatured = item.tag === selectedFeaturedTag;
			if (isFeatured) {
				card.style.borderColor = 'var(--accent-blue)';
				card.style.background = '#eff6ff';
			}

			const igSearchUrl = `https://www.instagram.com/explore/tags/${item.tag.replace('#', '')}/`;

			card.innerHTML = `
				<div style="margin-bottom: 0.5rem;">
					<strong class="font-heading tag-title" style="font-size: 1.05rem; color: var(--fg-pencil); display: block; word-break: break-word;">${item.tag}</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase;">Style: ${item.vibe}</span>
				</div>
				<div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed #ddd; padding-top: 0.4rem; gap: 0.3rem;">
					<button type="button" class="btn-copy-tag hand-btn" data-tag="${item.tag}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; background: #f0fdf4;">
						📋 Copy
					</button>
					<a href="${igSearchUrl}" target="_blank" rel="noopener noreferrer nofollow" class="hand-btn secondary" style="padding: 0.2rem 0.45rem; font-size: 0.72rem; text-decoration: none;">
						🔍 IG
					</a>
				</div>
			`;

			// Click to feature on Table Sign
			card.addEventListener('click', (e) => {
				if (e.target.tagName === 'BUTTON' || e.target.tagName === 'A') return;
				selectedFeaturedTag = item.tag;
				displaySelectedHashtag.textContent = selectedFeaturedTag;
				printHashtagDisplay.textContent = selectedFeaturedTag;
				renderTags();
			});

			hashtagsStreamContainer.appendChild(card);
		});

		// Attach Copy Listeners
		document.querySelectorAll('.btn-copy-tag').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const tag = btn.getAttribute('data-tag');
				navigator.clipboard.writeText(tag).then(() => {
					const oldText = btn.textContent;
					btn.textContent = 'Copied! ✅';
					btn.style.background = '#dcfce7';
					setTimeout(() => {
						btn.textContent = oldText;
						btn.style.background = '#f0fdf4';
					}, 1500);
				});
			});
		});
	}

	// Filter Tabs
	document.querySelectorAll('.filter-tab-btn').forEach(btn => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.filter-tab-btn').forEach(b => {
				b.classList.remove('active-tab');
				b.classList.add('secondary');
			});
			btn.classList.add('active-tab');
			btn.classList.remove('secondary');
			currentVibeFilter = btn.getAttribute('data-vibe');
			renderTags();
		});
	});

	// Input Listeners
	[p1FirstInput, p1LastInput, p2FirstInput, p2LastInput, nicknameInput, yearInput, cityInput].forEach(el => {
		el.addEventListener('input', () => {
			const all = generateAllTags();
			selectedFeaturedTag = all[0].tag;
			displaySelectedHashtag.textContent = selectedFeaturedTag;
			printHashtagDisplay.textContent = selectedFeaturedTag;
			renderTags();
		});
	});

	// 📝 Export Word (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const allTags = generateAllTags();
		let tagsHtml = '';
		allTags.forEach(t => {
			tagsHtml += `<li style="font-size:14px; font-weight:bold; color:#1e3a8a; margin-bottom:4px;">${t.tag} <span style="font-size:11px; color:#666; font-weight:normal;">(${t.vibe})</span></li>`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Wedding Hashtags & Table Signage</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 14px; margin-bottom: 20px; }
					.sign-box { border: 2px solid #333; background: #fafafa; padding: 25px; text-align: center; margin-bottom: 25px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Wedding Hashtag & Signage Master</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Featured Tag: <strong>${selectedFeaturedTag}</strong></p>
				
				<div class="sign-box">
					<p style="text-transform:uppercase; letter-spacing:2px; font-size:12px; margin:0 0 10px 0;">Help Us Capture The Love</p>
					<h2 style="font-size:24px; margin:0 0 15px 0;">Please Tag Your Photos & Reels On Instagram</h2>
					<h1 style="font-size:32px; color:#1e3a8a; margin:10px 0;">${selectedFeaturedTag}</h1>
					<p style="font-style:italic; font-size:13px; margin:15px 0 0 0;">Thank you for celebrating our special day with us!</p>
				</div>

				<h3>All 50+ Brainstormed Wedding Hashtags:</h3>
				<ul>${tagsHtml}</ul>
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Hashtags_${clean(selectedFeaturedTag)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print Sign
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		printHashtagDisplay.textContent = selectedFeaturedTag;
		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		const allTags = generateAllTags();
		let csv = "Hashtag,Style Vibe,Quality Score\n";
		allTags.forEach(t => {
			csv += `"${t.tag}","${t.vibe}","${t.score}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Hashtags_Roster.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	renderTags();
</script>
