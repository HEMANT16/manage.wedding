---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "name": "Wedding Hashtag Generator & Table Sign Maker",
      "url": "https://manage.wedding/wedding-hashtag-generator",
      "description": "Free wedding hashtag generator. Generate 50+ clever, romantic, punny, and party wedding hashtags by name, with instant 1-click clipboard copy, printable table signs, Word, and PDF exports.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does this wedding hashtag generator create unique tags?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our algorithm combines both partners' first names, last names, blended couple nicknames, wedding year, and rhyming wordplay across 5 distinct vibe categories (Romantic, Punny/Funny, Party/Celebration, Destination, and Short & Sweet)."
          }
        },
        {
          "@type": "Question",
          "name": "Why should I use CamelCase (capitalizing each word) in wedding hashtags?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Using CamelCase (e.g. #HappilyEverJohnson instead of #happilyeverjohnson) makes your hashtag vastly easier for guests to read, prevents accidental misspellings, and ensures screen readers for visually impaired guests pronounce each word correctly."
          }
        },
        {
          "@type": "Question",
          "name": "How do I check if our wedding hashtag is already taken?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Search your tag on Instagram and TikTok. If there are fewer than 10 older posts, it is safe to use. If thousands of posts exist, add your wedding year (e.g. #TaylorAndTravis2026) or your wedding city to make it completely unique."
          }
        },
        {
          "@type": "Question",
          "name": "Where should we display our wedding hashtag during the wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Display your wedding hashtag on your save-the-date cards, wedding website, photo booth backdrop, cocktail bar signs, DJ booth, and reception table place cards. You can export a printable 8x10 table sign directly from this tool!"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Create and Use a Custom Wedding Hashtag",
      "description": "Step-by-step guide to generating memorable, punny, and easy-to-read wedding hashtags and displaying them at your reception.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Enter Partner Names & Details",
          "text": "Input both partners' first and last names, your couple nickname, and wedding year or city."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Choose Your Vibe & Wordplay",
          "text": "Browse categories (Romantic, Punny & Funny, Party/Celebration, Destination, or Short & Sweet) and pick your favorites."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Check Social Media Availability",
          "text": "Search Instagram and TikTok to ensure the hashtag is free of clutter or thousands of existing posts."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Use Proper CamelCase Formatting",
          "text": "Capitalize the first letter of each word (e.g. #HappilyEverJohnson) for instant legibility and accessibility."
        },
        {
          "@type": "HowToStep",
          "name": "Step 5: Export Printable Table Sign",
          "text": "Generate and print 8x10 reception table signs, photo booth cards, or bar signs in Word and PDF."
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Hashtag Generator (Free Punny Ideas & Printable Signs) | Manage.Wedding"
	description="Generate unique, clever, and punny wedding hashtags instantly. Categorized into Romantic, Funny, Party, and Short styles with printable table signs and Word export."
	schema={schema}
>
	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Wedding Hashtag Generator
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Generate 50+ clever, romantic, punny, and celebratory wedding hashtags. Copy with 1-click, check Instagram availability, and export <strong>Printable Table Signs</strong> in Word or PDF!
				</p>
			</div>
		</section>

		<!-- Editorial Guide Interlink Banner -->
		<div style="background: #fef3c7; border: 2px solid #d97706; border-radius: 8px; padding: 1rem 1.5rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; box-shadow: 2px 2px 0px #d97706;">
			<div style="display: flex; align-items: center; gap: 0.75rem;">
				<span style="font-size: 1.5rem;">🍸</span>
				<div>
					<strong style="color: #92400e; font-size: 0.95rem; display: block;">Brainstorming His, Hers & Pet Signature Cocktail Names?</strong>
					<span style="color: #78350f; font-size: 0.88rem;">Read our comprehensive guide on <a href="/wedding-cocktail-names-his-hers-pet-ideas" style="color: #92400e; text-decoration: underline; font-weight: 700;">Wedding Cocktail Names: His, Hers & Pet Ideas (50+ Punny Formulas)</a>.</span>
				</div>
			</div>
			<a href="/wedding-cocktail-names-his-hers-pet-ideas" style="background: #b45309; color: #fff; text-decoration: none; font-weight: 700; font-size: 0.85rem; padding: 6px 14px; border-radius: 6px; border: 1px solid #78350f; white-space: nowrap;">
				Read Guide &rarr;
			</a>
		</div>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> How to Generate the Perfect Hashtag in 3 Easy Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Enter Names & Nicknames
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Enter both partners' first and last names, couple nickname (e.g. Tayvis), and wedding year or destination city.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Filter by Vibe & Pin Favorites
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Browse tags by category (Romantic, Funny/Puns, Party Vibes, or Short & Sweet) and click to copy or save favorites.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Export Printable Table Sign
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Click <strong>"🖨️ Export Printable Sign"</strong> or <strong>"📝 Export Word"</strong> to create framed reception bar & photo booth signage!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Generator Form + Live Results & Sign Mockup -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="hashtag-grid">
			
			<!-- Left Column: Couple Details Form & Filter Tabs -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						💍 Couple Details & Wordplay
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Enter your names to generate dozens of custom hashtag combinations
					</span>
				</div>

				<form id="hashtag-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Partner 1 -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p1-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Partner 1 First Name *
							</label>
							<input type="text" id="p1-first" value="Taylor" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p1-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Partner 1 Last Name *
							</label>
							<input type="text" id="p1-last" value="Swift" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Partner 2 -->
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
						<div>
							<label for="p2-first" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Partner 2 First Name *
							</label>
							<input type="text" id="p2-first" value="Travis" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
						<div>
							<label for="p2-last" class="font-heading" style="display: block; font-size: 0.88rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Partner 2 Last Name *
							</label>
							<input type="text" id="p2-last" value="Kelce" required style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.95rem; background: #fff;">
						</div>
					</div>

					<!-- Nickname, Year, Destination -->
					<div style="display: grid; grid-template-columns: 1.2fr 0.8fr 1fr; gap: 0.6rem;">
						<div>
							<label for="couple-nickname" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Couple Nickname (Optional)
							</label>
							<input type="text" id="couple-nickname" value="Tayvis" placeholder="e.g. Tayvis" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-year" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								Year
							</label>
							<input type="number" id="wedding-year" value="2026" min="2024" max="2035" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
						<div>
							<label for="wedding-city" class="font-heading" style="display: block; font-size: 0.85rem; color: var(--fg-pencil); margin-bottom: 0.25rem;">
								City / Venue (Opt)
							</label>
							<input type="text" id="wedding-city" placeholder="e.g. Maui / Paris" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1.5px solid var(--fg-pencil); border-radius: 4px; font-family: var(--font-body); font-size: 0.88rem; background: #fff;">
						</div>
					</div>

					<!-- Vibe Filter Selector -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
							🎨 Filter by Hashtag Style:
						</span>
						<div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
							<button type="button" class="filter-tab-btn active-tab hand-btn" data-vibe="all" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">✨ All Ideas (50+)</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="romantic" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">💖 Romantic</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="funny" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">😂 Punny & Funny</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="party" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">🥂 Party & Drinks</button>
							<button type="button" class="filter-tab-btn hand-btn secondary" data-vibe="short" style="padding: 0.25rem 0.55rem; font-size: 0.8rem;">⚡ Short & Sweet</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Hashtag Cards Stream & Printable Sign Mockup -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Printable Table Sign Mockup Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖨️ Reception Table Sign Preview
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								Print-ready 8x10 photo frame display for cocktail bar & guestbook table
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word Sign (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print Sign
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Table Sign Mockup Box -->
					<div id="table-sign-mockup" style="border: 2.5px solid var(--fg-pencil); border-radius: 6px; padding: 2rem 1.5rem; background: var(--bg-paper); text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1rem;">
						
						<!-- Corner Marks -->
						<div style="position: absolute; top: 6px; left: 6px; width: 14px; height: 14px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 6px; right: 6px; width: 14px; height: 14px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; left: 6px; width: 14px; height: 14px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 6px; right: 6px; width: 14px; height: 14px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<p style="font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; color: var(--accent-red); margin: 0 0 0.5rem 0; font-weight: bold;">
							HELP US CAPTURE THE LOVE!
						</p>

						<h2 style="font-family: var(--font-heading); font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 0.5rem 0;">
							Tag your photos & videos on Instagram:
						</h2>

						<div style="background: #fff; border: 2px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem 1rem; margin: 1rem 0; display: inline-block;">
							<strong id="display-selected-hashtag" class="font-heading" style="font-size: 1.8rem; color: var(--accent-blue); word-break: break-word;">
								#HappilyEverKelce
							</strong>
						</div>

						<p style="font-family: var(--font-body); font-size: 0.88rem; color: var(--text-secondary); margin: 0.5rem 0 0 0; font-style: italic;">
							So we can relive every moment of our special celebration!
						</p>
					</div>

					<span style="font-size: 0.78rem; color: var(--text-secondary); text-align: center; display: block;">
						💡 Tip: Click any hashtag card below to set it as your featured table sign tag!
					</span>

				</div>

				<!-- Generated Hashtags Stream Box -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 480px; overflow-y: auto;">
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
						<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0;">
							🏷️ Generated Hashtag Roster (<span id="tags-count-badge">50+</span>)
						</h3>
						<span style="font-size: 0.78rem; color: var(--accent-red); font-weight: bold;">
							Click to Copy & Preview
						</span>
					</div>

					<div id="hashtags-stream-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem;">
						<!-- Populated via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border: 4px solid #000; padding: 50px 30px; text-align: center; font-family: 'Times New Roman', serif; max-width: 600px; margin: 0 auto;">
				<p style="font-size: 16px; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 15px 0;">Help Us Capture The Love</p>
				<h1 style="font-size: 32px; margin: 0 0 25px 0;">Please Tag Your Photos & Reels</h1>
				<div style="border: 2px dashed #000; padding: 20px; margin: 25px 0; background: #fafafa;">
					<h2 id="print-hashtag-display" style="font-size: 36px; margin: 0; color: #000;">#HappilyEverKelce</h2>
				</div>
				<p style="font-size: 16px; font-style: italic; color: #444; margin: 20px 0 0 0;">Thank you for celebrating with us!</p>
			</div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="result-box" style="margin-bottom: 2.5rem; background: var(--post-it); border: 2.5px solid var(--fg-pencil); border-radius: 6px; box-shadow: 4px 4px 0px var(--fg-pencil); padding: 1.5rem 1.75rem; position: relative;">
			<div class="badge-postit" style="top: -12px; right: 15px;">⚡ BLUF Rule of Thumb</div>
			<h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
				<span>⚡</span> Quick Rule of Thumb: Wedding Hashtag Formulas & Best Practices
			</h3>
			<p class="font-body" style="font-size: 1rem; line-height: 1.6; margin-bottom: 1.25rem; color: var(--fg-pencil);">
				<strong>The 1-Minute Core Formula:</strong> The most memorable and searchable hashtags follow the structure: <strong>[Partner LastName] + [Pun/Rhyme/Catchphrase] + [Optional Year/Location]</strong>. Always capitalize the first letter of every word (<strong>CamelCase</strong>) so visually impaired screen readers pronounce each word correctly and guests avoid typos when tagging ceremony and reception photos.
			</p>
			
			<!-- Benchmark Hashtag Formulas Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 4px; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Hashtag Style / Formula</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Naming Pattern</th>
							<th style="padding: 0.65rem 0.8rem; border-right: 1px solid var(--fg-pencil); font-family: var(--font-heading); color: var(--fg-pencil);">Example Live Tag</th>
							<th style="padding: 0.65rem 0.8rem; font-family: var(--font-heading); color: var(--fg-pencil);">Best Suited For</th>
						</tr>
					</thead>
					<tbody>
						<tr style="border-bottom: 1px solid #e2e8f0;">
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 700;">1. The Timeless Romantic</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1;">#HappilyEver[LastName]</td>
							<td style="padding: 0.6rem 0.8rem; border-right: 1px solid #cbd5e1; font-weight: 600; color: var(--accent-blue);">#HappilyEverJohnson</td>
