---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/who-pays-for-what-wedding/#webapp",
      "name": "Who Pays for What? Wedding Expense Splitter",
      "url": "https://manage.wedding/who-pays-for-what-wedding",
      "description": "Free wedding expense splitter and traditional vs modern payment breakdown calculator. Compare 1950s traditional etiquette against modern 3-way family splits with itemized line-item tracking. Export printable payment agreements.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Split Wedding Costs Between Families and Couples",
      "description": "Step-by-step etiquette guide for allocating wedding expenses across the couple, bride's family, and groom's family.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Determine Total Wedding Budget",
          "text": "Calculate your target overall wedding spend (e.g. $35,000) based on venue and catering estimates."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Review Traditional vs Modern Payment Standards",
          "text": "Decide whether to follow traditional Western etiquette (bride's family pays reception/dress, groom's family pays rehearsal/honeymoon), a 50/50 couple split, or a 3-way blended contribution."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Assign Specific Line Items to Contributors",
          "text": "Assign clear ownership for major milestone categories: Reception & Catering, Attire, Rehearsal Dinner, Honeymoon, Florals, and Rings."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Establish Payment Timelines with Parents",
          "text": "Confirm whether family contributions will be given as lump-sum gift checks or if parents prefer paying vendor invoices directly."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who traditionally pays for what in a wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditionally, the bride's family pays for the wedding dress, ceremony, reception venue, catering, cake, florals, invitations, and photography. The groom's family pays for the rehearsal dinner, marriage license, officiant fee, bridal bouquet, boutonnieres, and the honeymoon."
          }
        },
        {
          "@type": "Question",
          "name": "Who pays for the rehearsal dinner?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditionally, the groom's family hosts and pays for the entire rehearsal dinner (including private room rental, food, drinks, and invitations). In modern weddings, couples often host it themselves or split it equally."
          }
        },
        {
          "@type": "Question",
          "name": "Who pays for the wedding dress and bridal alterations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Traditionally, the bride and her family purchase the wedding gown, veil, shoes, accessories, and alteration tailoring."
          }
        },
        {
          "@type": "Question",
          "name": "How do modern couples split wedding expenses today?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "According to modern wedding surveys, roughly 50% to 60% of couples pay for the majority of their wedding themselves. When parents contribute, the modern norm is a '3-Way Split' where the couple covers 30-50%, and both sets of parents contribute equal cash gifts."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Who Pays for What? Wedding Expense Splitter (Traditional vs Modern)"
	description="Free wedding expense splitter and traditional vs modern payment breakdown calculator. Compare 1950s etiquette against 3-way family splits with itemized line items. Export printable agreements."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">Traditional Etiquette vs Modern 3-Way Split</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Who Pays for What? <span class="accent-italic">Wedding Splitter</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 740px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Compare 1950s traditional protocol with modern 3-way family splits. Assign ownership for all 20+ wedding categories and export a printable financial agreement in 1-click.
			</p>
		</header>

		<!-- Main Interactive Splitter Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Split Model Setup & Controls -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Payment Model & Budget
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Etiquette Engine
					</span>
				</div>

				<!-- Total Budget -->
				<div class="form-group">
					<label class="form-label" for="total-wedding-budget">Total Estimated Wedding Budget ($)</label>
					<input type="number" id="total-wedding-budget" class="form-input" value="35000" min="5000" step="1000" style="font-size: 1.2rem; font-weight: 700;" />
				</div>

				<!-- Split Model Shortcut Selector -->
				<div class="form-group">
					<label class="form-label" for="split-model-preset">Split Protocol Preset</label>
					<select id="split-model-preset" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="traditional" selected>📜 1950s Traditional (Bride's Family 70% / Groom's Family 25% / Couple 5%)</option>
						<option value="modern-3way">🤝 Modern 3-Way Equal Split (Couple 40% / Bride Family 30% / Groom Family 30%)</option>
						<option value="couple-100">💍 Couple Self-Funded (Couple Pays 100% / No Family Money)</option>
						<option value="couple-50-50">⚖️ Couple 50/50 Split (Partner 1 Pays 50% / Partner 2 Pays 50%)</option>
						<option value="custom">✏️ Custom Itemized Assignment</option>
					</select>
				</div>

				<!-- Visual Split Percentages Sliders -->
				<div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<strong class="font-heading" style="font-size: 1.05rem; display: block; margin-bottom: 0.75rem; color: var(--fg-pencil);">
						Contribution Percentage Shares (%)
					</strong>

					<div style="display: flex; flex-direction: column; gap: 0.85rem;">
						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-red);">👰 Bride's Family Share:</span>
								<span id="slider-bride-pct-val">70%</span>
							</div>
							<input type="range" id="slider-bride-pct" min="0" max="100" value="70" style="width: 100%; accent-color: var(--accent-red);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: var(--accent-blue);">🤵 Groom's Family Share:</span>
								<span id="slider-groom-pct-val">25%</span>
							</div>
							<input type="range" id="slider-groom-pct" min="0" max="100" value="25" style="width: 100%; accent-color: var(--accent-blue);" />
						</div>

						<div>
							<div style="display: flex; justify-content: space-between; font-size: 0.92rem; font-weight: 700; margin-bottom: 3px;">
								<span style="color: #16a34a;">💍 Couple's Out-of-Pocket Share:</span>
								<span id="slider-couple-pct-val">5%</span>
							</div>
							<input type="range" id="slider-couple-pct" min="0" max="100" value="5" style="width: 100%; accent-color: #16a34a;" />
						</div>
					</div>
				</div>

				<!-- Quick Money Talk Guide -->
				<div style="margin-top: 1.5rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1rem; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
					<strong style="display: block; color: var(--fg-pencil); margin-bottom: 4px;">💬 How to Ask Parents About Contributions:</strong>
					"We are beginning our budget planning! We'd love to know if you would like to contribute toward a specific element (like the rehearsal dinner or flowers), or if you prefer us to plan everything independently."
				</div>

			</div>

			<!-- Right Column: Results Breakdown & Itemized Checklist -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Contribution Summary Cards -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #fffcf5; border: 2.5px solid var(--fg-pencil); box-shadow: 6px 6px 0px var(--fg-pencil);">
					
					<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0 0 1rem 0;">
						Expense Allocation Breakdown
					</h3>

					<!-- 3 Contribution Summary Bars -->
					<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem; text-align: center;">
						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-red);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Bride's Family</span>
							<strong id="card-bride-amount" style="font-size: 1.2rem; color: var(--accent-red); display: block; margin-top: 2px;">$24,500</strong>
							<span id="card-bride-pct" style="font-size: 0.75rem; color: #64748b;">(70%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid var(--accent-blue);">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Groom's Family</span>
							<strong id="card-groom-amount" style="font-size: 1.2rem; color: var(--accent-blue); display: block; margin-top: 2px;">$8,750</strong>
							<span id="card-groom-pct" style="font-size: 0.75rem; color: #64748b;">(25%)</span>
						</div>

						<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.75rem 0.5rem; border-top: 4px solid #16a34a;">
							<span style="font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block;">Couple</span>
							<strong id="card-couple-amount" style="font-size: 1.2rem; color: #16a34a; display: block; margin-top: 2px;">$1,750</strong>
							<span id="card-couple-pct" style="font-size: 0.75rem; color: #64748b;">(5%)</span>
						</div>
					</div>

					<!-- Itemized Traditional Responsibilities Table -->
					<div style="max-height: 280px; overflow-y: auto; background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; margin-bottom: 1.5rem;">
						<table style="width: 100%; border-collapse: collapse; font-size: 0.86rem; text-align: left;">
							<thead>
								<tr style="background: var(--muted-paper); border-bottom: 1.5px solid var(--fg-pencil);">
									<th style="padding: 6px 8px;">Wedding Line Item</th>
									<th style="padding: 6px 8px; text-align: right;">Traditional Payer</th>
								</tr>
							</thead>
							<tbody>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Ceremony & Reception Venue</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Bride's Family</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Catering, Bar & Wedding Cake</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Bride's Family</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Wedding Dress & Veil</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Bride's Family</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Photography & Videography</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Bride's Family</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Invitations & Stationery</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Bride's Family</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Rehearsal Dinner (Food/Drinks)</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Groom's Family</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Honeymoon Flights & Resort</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Groom's Family</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Marriage License & Officiant Fee</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Groom's Family</td></tr>
								<tr style="border-bottom: 1px dashed #e2e8f0;"><td>Bride's Bouquet & Boutonnieres</td><td style="text-align: right; font-weight: bold; color: var(--accent-blue);">Groom's Family</td></tr>
								<tr><td>Groom's Wedding Ring</td><td style="text-align: right; font-weight: bold; color: var(--accent-red);">Bride</td></tr>
							</tbody>
						</table>
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
						<button id="btn-print-agreement" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Print Agreement (PDF)
						</button>
						<button id="btn-export-doc" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📄</span> Export Word Doc
						</button>
					</div>

				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Bottom Line Up Front (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Quick Rule of Thumb: Who Pays for What at a Wedding
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Short on time? Here is the 1-minute breakdown of traditional 1950s responsibilities vs. modern 2026 financial realities.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					📋 The Traditional "Who Pays for What" Cheat Sheet:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Bride's Family: [Dress + Reception Venue/Catering + Photography + Flowers + Cake] • Groom's Family: [Rehearsal Dinner + Honeymoon + Marriage License/Officiant + Boutonnieres] • Attendants: [Own Attire + Bachelorette/Bachelor Travel].
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Payment Model</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Bride's Family Share</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Groom's Family Share</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Couple's Share</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">1950s Traditional</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">65% – 75% (Reception, Dress, Decor)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">20% – 25% (Rehearsal, Honeymoon)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">0% – 10% (Rings, Attendant gifts)</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Modern 3-Way Equal Split</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">30% – 35% Flat Contribution</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">30% – 35% Flat Contribution</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">30% – 40% (Remaining Balance)</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Couple Self-Funded (100%)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">$0 (Guests of Honor)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">$0 (Guests of Honor)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center; font-weight: bold;">100% Total Independence</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					The Complete Wedding Cost Splitting & Etiquette Guide
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Navigating financial contributions with family requires diplomacy, clear boundaries, and graceful communication.
				</p>
			</div>

			<!-- Section 1: Traditional vs Modern Evolution -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. The Evolution from Dowries to Modern Partnerships
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					The tradition of the bride's family paying for the majority of the wedding originated in historic dowry customs. However, as couples marry later in life with established careers, the financial dynamic has fundamentally shifted:
				</p>
				<ul class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Who Controls the Guest List:</strong> Traditionally, whoever pays for the food and venue controls the guest list allocations. If parents contribute 50% of the budget, etiquette generally grants them roughly 50% of the guest invites.</li>
					<li><strong>Lump Sum vs Invoiced Payments:</strong> To avoid micro-management and contract disagreements, ask contributing parents for a single flat cash contribution into a dedicated wedding account rather than having parents negotiate with individual vendors directly.</li>
				</ul>
			</section>

			<!-- Section 2: Rehearsal Dinner & Groomsmen Costs -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Who Pays for the Rehearsal Dinner & Attendant Attire?
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					Specific pre-wedding events have clear dedicated sponsors:
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>🎩 Specific Milestone Sponsorship:</strong><br />
					• <strong>Rehearsal Dinner:</strong> Groom's family hosts and pays.<br />
					• <strong>Bridal Shower:</strong> Hosted and paid by the Maid of Honor, bridesmaids, or the bride's mother/family.<br />
					• <strong>Bachelor / Bachelorette Party:</strong> Attendees split expenses and cover the bride/groom.<br />
					• <strong>Attendant Attire:</strong> Bridesmaids pay for their own dresses; Groomsmen pay for their tuxedo rentals.
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Frequently Asked Questions
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Who traditionally pays for the wedding dress?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						Traditionally, the bride and her family purchase the wedding dress, veil, alteration fittings, and bridal accessories.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">What does the groom's family pay for?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						The groom's family traditionally covers the rehearsal dinner, marriage license, officiant cash fee, bridal bouquet, floral boutonnieres, and the honeymoon.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">How should second weddings be financed?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						For second marriages, standard etiquette dictates that the couple pays for 100% of the celebration themselves, without financial expectations from parents.
					</p>
				</details>
			</section>

		</article>

	</main>

	<!-- Interactive Logic -->
	<script is:inline>
		const totalBudgetInput = document.getElementById('total-wedding-budget');
		const presetSelect = document.getElementById('split-model-preset');

		const sliderBride = document.getElementById('slider-bride-pct');
		const sliderGroom = document.getElementById('slider-groom-pct');
		const sliderCouple = document.getElementById('slider-couple-pct');

		const bridePctVal = document.getElementById('slider-bride-pct-val');
		const groomPctVal = document.getElementById('slider-groom-pct-val');
		const couplePctVal = document.getElementById('slider-couple-pct-val');

		const cardBrideAmount = document.getElementById('card-bride-amount');
		const cardBridePct = document.getElementById('card-bride-pct');
		const cardGroomAmount = document.getElementById('card-groom-amount');
		const cardGroomPct = document.getElementById('card-groom-pct');
		const cardCoupleAmount = document.getElementById('card-couple-amount');
		const cardCouplePct = document.getElementById('card-couple-pct');

		const btnPrint = document.getElementById('btn-print-agreement');
		const btnDoc = document.getElementById('btn-export-doc');

		function calculateSplits() {
			const total = parseFloat(totalBudgetInput.value) || 0;
			const bPct = parseInt(sliderBride.value, 10);
			const gPct = parseInt(sliderGroom.value, 10);
			const cPct = parseInt(sliderCouple.value, 10);

			bridePctVal.textContent = `${bPct}%`;
			groomPctVal.textContent = `${gPct}%`;
			couplePctVal.textContent = `${cPct}%`;

			const bAmount = (total * bPct) / 100;
			const gAmount = (total * gPct) / 100;
			const cAmount = (total * cPct) / 100;

			cardBrideAmount.textContent = `$${Math.round(bAmount).toLocaleString()}`;
			cardBridePct.textContent = `(${bPct}%)`;
			cardGroomAmount.textContent = `$${Math.round(gAmount).toLocaleString()}`;
			cardGroomPct.textContent = `(${gPct}%)`;
			cardCoupleAmount.textContent = `$${Math.round(cAmount).toLocaleString()}`;
			cardCouplePct.textContent = `(${cPct}%)`;
		}

		// Preset Selection Handler
		presetSelect.addEventListener('change', () => {
			const p = presetSelect.value;
			if (p === 'traditional') {
				sliderBride.value = 70;
				sliderGroom.value = 25;
				sliderCouple.value = 5;
			} else if (p === 'modern-3way') {
				sliderBride.value = 30;
				sliderGroom.value = 30;
				sliderCouple.value = 40;
			} else if (p === 'couple-100') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			} else if (p === 'couple-50-50') {
				sliderBride.value = 0;
				sliderGroom.value = 0;
				sliderCouple.value = 100;
			}
			calculateSplits();
		});

		// Slider Listeners with Normalization
		sliderBride.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderBride.value, 10);
			sliderGroom.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderGroom.value;
			calculateSplits();
		});
		sliderGroom.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderGroom.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderCouple.value = rem - sliderBride.value;
			calculateSplits();
		});
		sliderCouple.addEventListener('input', () => {
			const rem = 100 - parseInt(sliderCouple.value, 10);
			sliderBride.value = Math.round(rem / 2);
			sliderGroom.value = rem - sliderBride.value;
			calculateSplits();
		});

		totalBudgetInput.addEventListener('input', calculateSplits);

		// Print Agreement Sheet
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			printWindow.document.write(`
				<!DOCTYPE html>
				<html>
				<head>
					<title>Wedding Expense Split Agreement — Manage.Wedding</title>
					<style>
						@page { size: 8.5in 11in; margin: 0.5in; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 20pt; margin-bottom: 4px; color: #0f172a; }
						table { width: 100%; border-collapse: collapse; margin-top: 15px; }
						th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
						.total-row { font-size: 12pt; font-weight: bold; background-color: #fef3c7; }
					</style>
				</head>
				<body>
					<h1>Wedding Expense Allocation Agreement</h1>
					<p>Total Estimated Budget: $${parseFloat(totalBudgetInput.value).toLocaleString()} | Protocol: ${presetSelect.options[presetSelect.selectedIndex].text}</p>
					
					<table>
						<thead><tr><th>Contributing Party</th><th>Agreed Percentage</th><th>Allocated Amount ($)</th><th>Primary Category Responsibilities</th></tr></thead>
						<tbody>
							<tr><td><strong>Bride's Family</strong></td><td>${sliderBride.value}%</td><td><strong>${cardBrideAmount.textContent}</strong></td><td>Ceremony & Reception Venue, Catering, Dress, Flowers, Photography</td></tr>
							<tr><td><strong>Groom's Family</strong></td><td>${sliderGroom.value}%</td><td><strong>${cardGroomAmount.textContent}</strong></td><td>Rehearsal Dinner, Honeymoon, Officiant Fee, Boutonnieres</td></tr>
							<tr><td><strong>The Couple</strong></td><td>${sliderCouple.value}%</td><td><strong>${cardCoupleAmount.textContent}</strong></td><td>Wedding Rings, Bridal Party Gifts, Remaining Balances</td></tr>
							<tr class="total-row"><td>TOTAL BUDGET</td><td>100%</td><td>$${parseFloat(totalBudgetInput.value).toLocaleString()}</td><td>Full Wedding Financial Plan</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`);
			printWindow.document.close();
		});

		// Export Word Doc
		btnDoc.addEventListener('click', () => {
			const content = `
				<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
				<head><title>Wedding Cost Allocation Agreement</title>
				<style>body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #999; padding: 8px; }</style>
				</head>
				<body>
					<h2>Manage.Wedding — Wedding Expense Allocation Agreement</h2>
					<p>Total Budget: $${parseFloat(totalBudgetInput.value).toLocaleString()}</p>
					<table>
						<thead><tr><th>Contributor</th><th>Share (%)</th><th>Amount ($)</th></tr></thead>
						<tbody>
							<tr><td>Bride's Family</td><td>${sliderBride.value}%</td><td>${cardBrideAmount.textContent}</td></tr>
							<tr><td>Groom's Family</td><td>${sliderGroom.value}%</td><td>${cardGroomAmount.textContent}</td></tr>
							<tr><td>The Couple</td><td>${sliderCouple.value}%</td><td>${cardCoupleAmount.textContent}</td></tr>
							<tr style="font-weight:bold; background-color:#eee;"><td>TOTAL</td><td>100%</td><td>$${parseFloat(totalBudgetInput.value).toLocaleString()}</td></tr>
						</tbody>
					</table>
				</body></html>
			`;
			const blob = new Blob([content], { type: 'application/msword' });
			const link = document.createElement('a');
			link.href = URL.createObjectURL(blob);
			link.download = 'wedding-cost-split-agreement.doc';
			link.click();
		});

		// Initial Calculation
		calculateSplits();
	</script>
</Layout>
