---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const title = "Wedding Planning Guides, Formulas & Checklists — Manage.Wedding Blog";
const description = "Expert, calculation-backed wedding planning guides, guest count formulas, alcohol buying charts, budgeting rules, and timeline templates.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://manage.wedding/blog/#collection",
      "name": "Wedding Planning Guides & Calculators Blog",
      "url": "https://manage.wedding/blog",
      "description": "Comprehensive library of wedding planning guides, alcohol formulas, seating rules, and budget breakdown blueprints.",
      "hasPart": [
        {
          "@type": "Article",
          "name": "Wedding Drink Calculator: How Much Alcohol to Buy (100, 150 & 200 Guest Formula)",
          "url": "https://manage.wedding/wedding-drink-calculator-guest-formula"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What makes Manage.Wedding guides different?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our guides are 100% calculation-driven and verified by professional wedding planners. Rather than generic fluff, we provide concrete numbers, bottle counts, formulas, and direct links to free interactive planning tools."
          }
        },
        {
          "@type": "Question",
          "name": "Are the wedding planning calculators in these guides free to use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! All calculators and templates on Manage.Wedding are 100% free, private (local-first storage with zero sign-ups), and feature one-click printable PDF exports."
          }
        }
      ]
    }
  ]
};

const publishedArticles = [
  {
    id: 1,
    category: "Food & Beverage",
    icon: "🍷",
    title: "Wedding Drink Calculator: How Much Alcohol to Buy (100, 150 & 200 Guest Formula)",
    url: "/wedding-drink-calculator-guest-formula",
    badge: "Master Guide",
    readTime: "8 min read",
    date: "August 2026",
    summary: "The definitive formula for stocking your wedding open bar. Includes exact bottle breakdowns for 50, 100, 150, and 200 guests, seasonal adjustments, and the champagne toast myth.",
    toolUrl: "/wedding-drink-calculator",
    toolName: "Drink Calculator",
    tags: ["Alcohol Math", "Beer & Wine Split", "Ice Calculations"]
  }
];

const upcomingTopics = [
  {
    category: "Budget & Finance",
    icon: "💰",
    title: "Wedding Venue Hidden Costs: 15 Contract Red Flags (Plus-Plus ++ & 22% Service Fee Math)",
    toolUrl: "/wedding-venue-cost-calculator",
    toolName: "Venue Cost Calculator",
    tag: "Plus-Plus Math"
  },
  {
    category: "Budget & Finance",
    icon: "💵",
    title: "Who Pays for What in a Wedding: Traditional vs Modern (Line-Item PDF Agreement)",
    toolUrl: "/who-pays-for-what-wedding",
    toolName: "Who Pays Calculator",
    tag: "Expense Splitting"
  },
  {
    category: "Guests & Logistics",
    icon: "👥",
    title: "Wedding Seating Chart Maker: Table Layout & Etiquette (Visual Drag & Drop Tool)",
    toolUrl: "/seating-chart-maker",
    toolName: "Seating Chart Maker",
    tag: "Floor Plans"
  },
  {
    category: "Ceremony & Timing",
    icon: "⏱️",
    title: "Wedding Day Timeline Template: 4 Sample Schedules (With & Without First Look)",
    toolUrl: "/day-of-timeline-generator",
    toolName: "Timeline Generator",
    tag: "Day-Of Schedule"
  },
  {
    category: "Stationery & Design",
    icon: "💌",
    title: "Wedding Invitation Postage Calculator: Stamp Weight Rules (USPS Non-Machinable Rates)",
    toolUrl: "/wedding-invitation-postage-calculator",
    toolName: "Postage Calculator",
    tag: "Mailing Rates"
  },
  {
    category: "Attire & Decor",
    icon: "👗",
    title: "Wedding Dress Alterations Cost: Hemming, Bustle & Bodice (Tailor Pricing Breakdown)",
    toolUrl: "/dress-alterations-estimator",
    toolName: "Alterations Sizer",
    tag: "Tailor Pricing"
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <main class="container" style="padding-top: 2.5rem; padding-bottom: 5rem; max-width: 1200px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Planning Guides & Blog" }
      ]}
    />

    <!-- Master Header -->
    <header class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 12px; padding: 3rem 2.5rem; margin: 2rem 0 3rem; box-shadow: 5px 5px 0px var(--fg-pencil); position: relative;">
      <div class="tape" style="top: -12px; left: 50%; transform: translateX(-50%) rotate(-1deg); width: 180px;"></div>
      
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #fef3c7; color: #92400e; padding: 5px 14px; border-radius: 20px; border: 1.5px solid #d97706; font-size: 0.88rem; font-weight: 700; margin-bottom: 1.25rem;">
        <span>📚</span>
        <span>Math-Backed Planning Guides • 100% Free Calculators</span>
      </div>

      <h1 class="font-heading" style="font-size: clamp(2.2rem, 4vw, 3.2rem); color: var(--fg-pencil); line-height: 1.2; margin-bottom: 1rem;">
        Wedding Planning Guides, Formulas & Blueprints
      </h1>
      <p class="font-body" style="font-size: 1.2rem; color: var(--fg-pencil); opacity: 0.85; max-width: 820px; line-height: 1.6; margin-bottom: 1.5rem;">
        No fluff, no sponsored vendor spam. Just battle-tested mathematical formulas, alcohol buying guides, guest decline statistics, and contract breakdown tools for stress-free wedding planning.
      </p>

      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <span style="background: #f1f5f9; border: 1.5px solid var(--fg-pencil); padding: 6px 12px; border-radius: 6px; font-weight: 700; font-size: 0.88rem;">📊 Data-Backed Formulas</span>
        <span style="background: #f1f5f9; border: 1.5px solid var(--fg-pencil); padding: 6px 12px; border-radius: 6px; font-weight: 700; font-size: 0.88rem;">🔒 100% Private (No Logins)</span>
        <span style="background: #f1f5f9; border: 1.5px solid var(--fg-pencil); padding: 6px 12px; border-radius: 6px; font-weight: 700; font-size: 0.88rem;">📄 Instant Vector PDF Exports</span>
      </div>
    </header>

    <!-- Published Featured Articles Section -->
    <section style="margin-bottom: 4rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 class="font-heading" style="font-size: 2rem; color: var(--fg-pencil);">
          Featured Planning Guides
        </h2>
        <span style="font-weight: 700; font-size: 0.90rem; color: var(--text-secondary);">
          Showing {publishedArticles.length} Guide
        </span>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
        {publishedArticles.map(article => (
          <article class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 2rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.15s ease;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <span style="background: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; padding: 3px 10px; border-radius: 4px; font-weight: 800; font-size: 0.78rem; text-transform: uppercase;">
                  {article.icon} {article.category}
                </span>
                <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-secondary);">
                  {article.readTime}
                </span>
              </div>

              <h3 class="font-heading" style="font-size: 1.45rem; line-height: 1.35; margin-bottom: 0.85rem;">
                <a href={article.url} style="color: var(--fg-pencil); text-decoration: none;">
                  {article.title}
                </a>
              </h3>

              <p class="font-body" style="font-size: 1rem; color: var(--fg-pencil); opacity: 0.85; line-height: 1.55; margin-bottom: 1.5rem;">
                {article.summary}
              </p>

              <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
                {article.tags.map(tag => (
                  <span style="background: #f8fafc; border: 1px dashed var(--fg-pencil); padding: 2px 8px; border-radius: 4px; font-size: 0.78rem; font-weight: 600;">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; pt: 1rem; border-top: 1.5px dashed #cbd5e1; padding-top: 1rem;">
              <a href={article.toolUrl} style="font-size: 0.85rem; font-weight: 700; color: #b45309; text-decoration: underline;">
                Use {article.toolName} &rarr;
              </a>
              <a href={article.url} style="background: var(--brand-primary, #dc2626); color: #fff; font-weight: 700; font-size: 0.90rem; padding: 8px 16px; border-radius: 6px; text-decoration: none; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
                Read Guide &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Upcoming Guides & Interactive Blueprints -->
    <section style="margin-bottom: 4rem;">
      <div class="hand-card" style="background: #fffbeb; border: 2px solid #d97706; border-radius: 10px; padding: 2.5rem; box-shadow: 4px 4px 0px var(--fg-pencil);">
        <div style="margin-bottom: 1.5rem;">
          <h2 class="font-heading" style="font-size: 1.8rem; color: #92400e; margin-bottom: 0.4rem;">
            Upcoming In-Depth Blueprints
          </h2>
          <p class="font-body" style="font-size: 1.05rem; color: #78350f; margin: 0;">
            Our editorial team is publishing full guides for our suite of 39+ interactive tools. Explore the corresponding calculators below:
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
          {upcomingTopics.map(topic => (
            <div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 8px; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                  <span style="font-size: 0.78rem; font-weight: 800; color: #b45309; text-transform: uppercase;">
                    {topic.icon} {topic.category}
                  </span>
                  <span style="background: #fef08a; border: 1px solid #ca8a04; font-size: 0.70rem; font-weight: 800; padding: 2px 6px; border-radius: 4px; color: #854d0e;">
                    {topic.tag}
                  </span>
                </div>
                <h4 class="font-heading" style="font-size: 1.1rem; line-height: 1.35; color: var(--fg-pencil); margin-bottom: 0.75rem;">
                  {topic.title}
                </h4>
              </div>
              <div style="margin-top: 0.75rem; pt: 0.5rem; border-top: 1px dashed #e2e8f0; padding-top: 0.5rem; text-align: right;">
                <a href={topic.toolUrl} style="font-weight: 700; font-size: 0.85rem; color: var(--brand-primary, #dc2626); text-decoration: underline;">
                  Try {topic.toolName} &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Master Hub Footer Banner -->
    <div style="text-align: center; margin-top: 3rem;">
      <h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">
        Explore All Interactive Wedding Calculators
      </h3>
      <p class="font-body" style="font-size: 1.05rem; max-width: 600px; margin: 0 auto 1.5rem; color: var(--text-secondary);">
        Browse our 4 main categories to calculate budgets, reception drinks, seating layouts, and stationery suites.
      </p>
      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/budget" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 10px 18px; border-radius: 6px; font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          💰 Budget Tools
        </a>
        <a href="/dining" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 10px 18px; border-radius: 6px; font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          🍾 Food & Bar Tools
        </a>
        <a href="/guests" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 10px 18px; border-radius: 6px; font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          👥 Guest & Seating Tools
        </a>
        <a href="/stationery" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 10px 18px; border-radius: 6px; font-size: 0.95rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          💌 Stationery Tools
        </a>
      </div>
    </div>

  </main>
</Layout>
