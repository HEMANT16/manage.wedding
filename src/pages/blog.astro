---

<Layout title={title} description={description} schema={schema}>
  <main class="container" style="padding-top: 2rem; padding-bottom: 5rem; max-width: 1050px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog" }
      ]}
    />

    <!-- Clean Header -->
    <header style="margin: 2.5rem 0 2rem;">
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 4vw, 3rem); color: var(--fg-pencil); line-height: 1.2; margin-bottom: 0.5rem;">
        Wedding Planning Blog
      </h1>
      <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); max-width: 750px; line-height: 1.5; margin: 0;">
        Practical, calculation-backed guides, buying checklists, and formulas for planning your wedding without the stress.
      </p>
    </header>

    <!-- Published Articles List -->
    <section style="margin-top: 2rem;">
      <div style="display: flex; flex-direction: column; gap: 1.75rem;">
        {publishedArticles.map(article => (
          <article class="hand-card" style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 2rem; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; flex-direction: column; gap: 1rem; transition: transform 0.15s ease;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
              <span style="background: #f1f5f9; border: 1.5px solid var(--fg-pencil); color: var(--fg-pencil); padding: 3px 10px; border-radius: 4px; font-weight: 800; font-size: 0.78rem; text-transform: uppercase;">
                {article.icon} {article.category}
              </span>
              <div style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); display: flex; gap: 0.75rem;">
                <span>{article.date}</span>
                <span>•</span>
                <span>{article.readTime}</span>
              </div>
            </div>

            <h2 class="font-heading" style="font-size: clamp(1.35rem, 2.2vw, 1.75rem); line-height: 1.3; margin: 0;">
              <a href={article.url} style="color: var(--fg-pencil); text-decoration: none;">
                {article.title}
              </a>
            </h2>

            <p class="font-body" style="font-size: 1.05rem; color: var(--fg-pencil); opacity: 0.85; line-height: 1.6; margin: 0;">
              {article.summary}
            </p>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; border-top: 1.5px dashed #cbd5e1; padding-top: 1rem; margin-top: 0.5rem;">
              <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
                {article.tags.map(tag => (
                  <span style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 2px 8px; border-radius: 4px; font-size: 0.78rem; font-weight: 600; color: var(--text-secondary);">
                    #{tag}
                  </span>
                ))}
              </div>

              <div style="display: flex; align-items: center; gap: 1rem;">
                <a href={article.toolUrl} style="font-size: 0.90rem; font-weight: 700; color: #b45309; text-decoration: underline;">
                  Open {article.toolName} &rarr;
                </a>
                <a href={article.url} style="background: var(--brand-primary, #dc2626); color: #fff; font-weight: 700; font-size: 0.92rem; padding: 8px 18px; border-radius: 6px; text-decoration: none; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
                  Read Article &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Simple Category Navigation -->
    <div style="margin-top: 4rem; padding-top: 2rem; border-top: 2px dashed #cbd5e1; text-align: center;">
      <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 1rem;">
        Explore Interactive Wedding Calculators
      </h3>
      <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/budget" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 8px 16px; border-radius: 6px; font-size: 0.90rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          💰 Budget
        </a>
        <a href="/dining" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 8px 16px; border-radius: 6px; font-size: 0.90rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          🍾 Dining
        </a>
        <a href="/guests" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 8px 16px; border-radius: 6px; font-size: 0.90rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          👥 Guests
        </a>
        <a href="/stationery" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 8px 16px; border-radius: 6px; font-size: 0.90rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          💌 Stationery
        </a>
      </div>
    </div>

  </main>
</Layout>
