---

<Layout title={title} description={description} schema={schema}>
  <main class="container" style="padding-top: 2rem; padding-bottom: 5rem; max-width: 1200px; margin: 0 auto;">
    
    <Breadcrumb
      items={[
        { name: "Home", url: "/" },
        { name: "Blog" }
      ]}
    />

    <!-- Header & Category Filters -->
    <header style="margin: 2.5rem 0 2rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #fef2f2; color: #991b1b; padding: 4px 14px; border-radius: 20px; border: 1.5px solid #dc2626; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.75rem;">
        <span>📚</span>
        <span>Expert Planning & Calculation Guides</span>
      </div>
      <h1 class="font-heading" style="font-size: clamp(2.2rem, 4vw, 3rem); color: var(--fg-pencil); line-height: 1.2; margin-bottom: 0.5rem;">
        Wedding Planning Blog
      </h1>
      <p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); max-width: 800px; line-height: 1.5; margin: 0 0 1.75rem 0;">
        Practical, calculation-backed guides, buying checklists, vendor pricing breakdowns, and formulas for planning your wedding without the stress.
      </p>

      <!-- Category Filter Pills -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
        <button class="filter-btn active" data-category="all" style="background: var(--fg-pencil); color: #fff; border: 1.5px solid var(--fg-pencil); padding: 6px 16px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: all 0.15s ease;">
          All Articles ({publishedArticles.length})
        </button>
        <button class="filter-btn" data-category="Budget & Finance" style="background: #fff; color: var(--fg-pencil); border: 1.5px solid var(--fg-pencil); padding: 6px 16px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: all 0.15s ease;">
          💰 Budget & Finance
        </button>
        <button class="filter-btn" data-category="Dining & Bar" style="background: #fff; color: var(--fg-pencil); border: 1.5px solid var(--fg-pencil); padding: 6px 16px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: all 0.15s ease;">
          🍾 Dining & Bar
        </button>
        <button class="filter-btn" data-category="Guests & Seating" style="background: #fff; color: var(--fg-pencil); border: 1.5px solid var(--fg-pencil); padding: 6px 16px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: all 0.15s ease;">
          👥 Guests & Seating
        </button>
      </div>
    </header>

    <!-- 2-Box Responsive Grid -->
    <section style="margin-top: 1.5rem;">
      <div id="articles-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 540px), 1fr)); gap: 1.5rem;">
        {publishedArticles.map(article => (
          <article class="article-card hand-card" data-category={article.category} style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 10px; padding: 1.5rem; box-shadow: 3px 3px 0px var(--fg-pencil); display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; transition: transform 0.15s ease, box-shadow 0.15s ease;">
            
            <div>
              <!-- Category Badge & Date/ReadTime -->
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
                <span style="background: #f1f5f9; border: 1.5px solid var(--fg-pencil); color: var(--fg-pencil); padding: 2px 10px; border-radius: 4px; font-weight: 800; font-size: 0.75rem; text-transform: uppercase;">
                  {article.icon} {article.category}
                </span>
                <div style="font-size: 0.82rem; font-weight: 600; color: var(--text-secondary); display: flex; gap: 0.5rem; align-items: center;">
                  <span>{article.date}</span>
                  <span>•</span>
                  <span>{article.readTime}</span>
                </div>
              </div>

              <!-- Title -->
              <h2 class="font-heading" style="font-size: 1.25rem; line-height: 1.35; margin: 0 0 0.65rem 0;">
                <a href={article.url} style="color: var(--fg-pencil); text-decoration: none;">
                  {article.title}
                </a>
              </h2>

              <!-- Summary -->
              <p class="font-body" style="font-size: 0.95rem; color: #475569; line-height: 1.55; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {article.summary}
              </p>
            </div>

            <!-- Bottom Meta & Actions -->
            <div style="border-top: 1.5px dashed #cbd5e1; padding-top: 0.85rem; margin-top: 0.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                <a href={article.toolUrl} style="font-size: 0.85rem; font-weight: 700; color: #b45309; text-decoration: underline;">
                  Open {article.toolName} &rarr;
                </a>
                <a href={article.url} style="background: var(--brand-primary, #dc2626); color: #fff; font-weight: 700; font-size: 0.85rem; padding: 6px 14px; border-radius: 6px; text-decoration: none; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil); white-space: nowrap;">
                  Read Article &rarr;
                </a>
              </div>
            </div>

          </article>
        ))}
      </div>
    </section>

    <!-- Category Hubs Navigation -->
    <div style="margin-top: 4rem; padding-top: 2rem; border-top: 2px dashed #cbd5e1; text-align: center;">
      <h3 class="font-heading" style="font-size: 1.35rem; color: var(--fg-pencil); margin-bottom: 1rem;">
        Explore Interactive Wedding Calculators by Category
      </h3>
      <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/budget" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 8px 16px; border-radius: 6px; font-size: 0.90rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          💰 Budget & Finance (11 Tools)
        </a>
        <a href="/dining" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 8px 16px; border-radius: 6px; font-size: 0.90rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          🍾 Food & Bar (11 Tools)
        </a>
        <a href="/guests" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 8px 16px; border-radius: 6px; font-size: 0.90rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          👥 Guests & Seating (7 Tools)
        </a>
        <a href="/stationery" style="background: #fff; color: var(--fg-pencil); text-decoration: none; font-weight: 700; padding: 8px 16px; border-radius: 6px; font-size: 0.90rem; border: 1.5px solid var(--fg-pencil); box-shadow: 2px 2px 0px var(--fg-pencil);">
          💌 Stationery & Planning (9 Tools)
        </a>
      </div>
    </div>

  </main>

  <script is:inline>
    // Client-side category filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const articleCards = document.querySelectorAll('.article-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');
        
        // Update active button styling
        filterButtons.forEach(b => {
          b.style.background = '#fff';
          b.style.color = 'var(--fg-pencil)';
        });
        btn.style.background = 'var(--fg-pencil)';
        btn.style.color = '#fff';

        // Filter cards
        articleCards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
