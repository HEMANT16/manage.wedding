---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Us | Manage.Wedding",
  "url": "https://manage.wedding/about",
  "description": "Learn about Manage.Wedding: our mission to provide 100% free, private, local-first wedding planning calculators and printable tools without paywalls or data harvesting."
};
---

<Layout 
	title="About Us | Manage.Wedding — Free, Private Wedding Planning Tools"
	description="Learn about Manage.Wedding. Our mission is to provide 100% free, privacy-first wedding calculators and printables designed to remove stress from wedding planning."
	schema={schema}
>
	<main style="max-width: 1000px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box;">
		
		<!-- Header -->
		<section class="section-paper" style="margin-bottom: 2rem; text-align: center;">
			<div style="padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<span class="badge-postit">Our Story & Mission</span>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 52px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin: 0.75rem 0;">
					About Manage.Wedding
				</h1>
				<p class="font-body" style="font-size: 1.2rem; color: var(--text-secondary); max-width: 650px; margin: 0 auto; text-align: center;">
					Simple, honest, and completely free wedding planning calculators — built for couples, bridal parties, and planners who value privacy.
				</p>
			</div>
		</section>

		<!-- Main Content Document -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3rem); background: #fff; line-height: 1.75; font-family: var(--font-body); font-size: 1.05rem; margin-bottom: 4rem;">
			
			<!-- Mission Box -->
			<div style="background: #fdf6e2; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: 3px 3px 0px rgba(0,0,0,0.08);">
				<strong class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); display: block; margin-bottom: 0.5rem; text-align: center;">
					💍 Why We Built Manage.Wedding
				</strong>
				<p style="margin: 0; font-size: 1rem; color: #444; line-height: 1.6; text-align: center;">
					Planning a wedding should be joyful, not overwhelming. We got tired of modern wedding websites that force couples to create accounts, hit paywalls, or sell their guest lists and personal details to third-party advertisers. <strong>Manage.Wedding was created to be the antidote:</strong> a completely open, 100% free, client-side toolkit that helps you calculate, budget, and organize your big day with complete privacy.
				</p>
			</div>

			<!-- Core Pillars -->
			<section style="margin-bottom: 3rem;">
				<h2 class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem; text-align: center; margin-bottom: 1.5rem;">
					Our 4 Core Pillars
				</h2>
				
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
					<div style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; background: var(--bg-paper);">
						<div style="font-size: 1.8rem; margin-bottom: 0.5rem;">🛡️</div>
						<h3 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">1. Zero-Tracking Privacy</h3>
						<p style="font-size: 0.95rem; margin: 0; color: #555;">
							Every calculation, guest name, speech draft, and budget number is processed locally inside your web browser. Nothing is sent to our servers or stored in remote databases.
						</p>
					</div>

					<div style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; background: var(--bg-paper);">
						<div style="font-size: 1.8rem; margin-bottom: 0.5rem;">🔓</div>
						<h3 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">2. 100% Free Forever</h3>
						<p style="font-size: 0.95rem; margin: 0; color: #555;">
							No premium tiers, no subscription trials, and no registration forms. You get unlimited access to all 30+ interactive calculators and templates instantly.
						</p>
					</div>

					<div style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; background: var(--bg-paper);">
						<div style="font-size: 1.8rem; margin-bottom: 0.5rem;">📐</div>
						<h3 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">3. Real Hospitality Math</h3>
						<p style="font-size: 0.95rem; margin: 0; color: #555;">
							Our formulas are calibrated against real-world event standards — from catering portion ratios and bar consumption rates to dress sizing standards and speech timing metrics.
						</p>
					</div>

					<div style="border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; background: var(--bg-paper);">
						<div style="font-size: 1.8rem; margin-bottom: 0.5rem;">📄</div>
						<h3 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin-bottom: 0.5rem;">4. Instant Multi-Format Exports</h3>
						<p style="font-size: 0.95rem; margin: 0; color: #555;">
							Take your planning offline in seconds. Every tool provides 1-click downloads in Microsoft Word (.doc), Print/PDF, and CSV formats ready for vendors and coordinators.
						</p>
					</div>
				</div>
			</section>

			<!-- What We Offer -->
			<section style="margin-bottom: 3rem;">
				<h2 class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem; text-align: center; margin-bottom: 1.5rem;">
					What You'll Find on Manage.Wedding
				</h2>
				<p>
					Our suite of over 30 specialized wedding planning tools covers every phase of the planning timeline:
				</p>
				<ul style="margin-left: 1.5rem; margin-bottom: 1.5rem; list-style-type: square;">
					<li><strong>Bar & Catering:</strong> Calculate exact bottle counts for liquor, wine, beer, champagne, alcohol dilution for batch cocktails, and cake servings across multiple tier sizes.</li>
					<li><strong>Guest Management & Seating:</strong> Manage interactive RSVP lists, estimate attendance probabilities, calculate invitation mailing deadlines, and build drag-and-drop table seating charts.</li>
					<li><strong>Budgeting & Finance:</strong> Master budget allocation, vendor gratuity calculators, wedding loan repayment estimates, and cash gift forecasting.</li>
					<li><strong>Stationery & Creative:</strong> Generate printable folded place cards, custom dinner menus, 50+ wedding hashtags with 8x10 bar signs, digital invitations, and speeches with pacing stopwatch.</li>
					<li><strong>Logistics & Milestones:</strong> 12-month countdown checklists, day-of timeline itineraries, international dress and ring size converters, and traditional anniversary gift finders (years 1–60).</li>
				</ul>
			</section>

			<!-- Editorial Team & Authors -->
			<section style="margin-bottom: 3rem;">
				<h2 class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem; text-align: center; margin-bottom: 1.5rem;">
					Meet Our Lead Editorial Authors
				</h2>
				
				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
					
					<!-- Elena Foster Card -->
					<div style="border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; background: #fff; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; flex-direction: column; justify-content: space-between;">
						<div>
							<div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
								<div style="width: 60px; height: 60px; border-radius: 50%; background: #fef3c7; border: 2px solid var(--fg-pencil); display: flex; align-items: center; justify-content: center; font-size: 1.35rem; font-weight: 800; color: #92400e; box-shadow: 2px 2px 0px var(--fg-pencil);">
									EF
								</div>
								<div>
									<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin: 0;">
										<a href="/authors/elena-foster" style="color: var(--fg-pencil); text-decoration: underline; text-decoration-thickness: 1.5px;">Elena Foster</a>
									</h3>
									<span style="font-size: 0.85rem; color: #1e40af; font-weight: 700;">Lead Wedding Financial Strategist</span>
								</div>
							</div>
							<p style="font-size: 0.95rem; color: #475569; line-height: 1.6; margin: 0 0 1rem;">
								35-year-old mother of two daughters and hospitality director with 12+ years in luxury estate banquet management. Having coordinated 400+ weddings, Elena authors our financial guides, open bar calculations, and venue contract auditing tools.
							</p>
						</div>
						<a href="/authors/elena-foster" style="background: #f8fafc; color: var(--fg-pencil); text-decoration: none; font-size: 0.9rem; font-weight: 700; padding: 8px 16px; border-radius: 6px; border: 1.5px solid var(--fg-pencil); text-align: center; box-shadow: 2px 2px 0px var(--fg-pencil);">
							View Elena's Author Profile & Articles &rarr;
						</a>
					</div>

					<!-- Ayano Sato Card -->
					<div style="border: 2px solid var(--fg-pencil); border-radius: 8px; padding: 1.5rem; background: #fff; box-shadow: 4px 4px 0px var(--fg-pencil); display: flex; flex-direction: column; justify-content: space-between;">
						<div>
							<div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
								<div style="width: 60px; height: 60px; border-radius: 50%; background: #fdf2f8; border: 2px solid var(--fg-pencil); display: flex; align-items: center; justify-content: center; font-size: 1.35rem; font-weight: 800; color: #be185d; box-shadow: 2px 2px 0px var(--fg-pencil);">
									AS
								</div>
								<div>
									<h3 class="font-heading" style="font-size: 1.3rem; color: var(--fg-pencil); margin: 0;">
										<a href="/ja/authors/ayano-sato" style="color: var(--fg-pencil); text-decoration: underline; text-decoration-thickness: 1.5px;">佐藤 綾乃 (Ayano Sato)</a>
									</h3>
									<span style="font-size: 0.85rem; color: #be185d; font-weight: 700;">ウェディングプランナー & 卒花アドバイザー</span>
								</div>
							</div>
							<p style="font-size: 0.95rem; color: #475569; line-height: 1.6; margin: 0 0 1rem;">
								27歳・ブライダル業界歴11年。元大手ゲストハウス支配人。デザインと和装・伝統文化を愛する卒花プランナーとして、日本の結婚式市場に特化した自己負担額計算やご祝儀・お車代マナーを監修。
							</p>
						</div>
						<a href="/ja/authors/ayano-sato" style="background: #fdf2f8; color: #be185d; text-decoration: none; font-size: 0.9rem; font-weight: 700; padding: 8px 16px; border-radius: 6px; border: 1.5px solid var(--fg-pencil); text-align: center; box-shadow: 2px 2px 0px var(--fg-pencil);">
							佐藤 綾乃の監修プロフィールを見る &rarr;
						</a>
					</div>

				</div>
			</section>

			<!-- Mathematical & Editorial Standards -->
			<section style="margin-bottom: 2.5rem;">
				<h2 class="font-heading" style="font-size: 1.8rem; color: var(--fg-pencil); border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.4rem; text-align: center; margin-bottom: 1.5rem;">
					Mathematical & Editorial Standards
				</h2>
				<p>
					Every calculator on this platform is engineered with transparent formulas based on verified industry practices:
				</p>
				<div style="background: var(--bg-paper); border-left: 4px solid var(--fg-pencil); padding: 1rem 1.25rem; margin-bottom: 1rem;">
					<strong style="color: var(--fg-pencil);">Beverage Mathematics:</strong> Based on the standard 1 drink per guest per hour rule, factoring 750ml bottle yields (5 wine pours, 16 liquor cocktails, 6 champagne flutes) and customized crowd drinking preferences.
				</div>
				<div style="background: var(--bg-paper); border-left: 4px solid var(--fg-pencil); padding: 1rem 1.25rem; margin-bottom: 1rem;">
					<strong style="color: var(--fg-pencil);">Guest Probability Modeling:</strong> Calibrated with standard 75%–85% local acceptance rates and 60%–70% out-of-town guest attendance curves.
				</div>
				<div style="background: var(--bg-paper); border-left: 4px solid var(--fg-pencil); padding: 1rem 1.25rem; margin-bottom: 1rem;">
					<strong style="color: var(--fg-pencil);">Speech & Public Speaking Cadence:</strong> Timed at 110–130 Words Per Minute (the ideal conversational toast speed) with adjustable laughter and pause buffers.
				</div>
			</section>

			<!-- CTA Box -->
			<div style="text-align: center; padding: 2rem 1rem; border-top: 2px dashed var(--fg-pencil); margin-top: 2rem;">
				<h3 class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin-bottom: 0.75rem;">
					Ready to Plan Your Big Day?
				</h3>
				<p style="color: var(--text-secondary); max-width: 500px; margin: 0 auto 1.5rem;">
					Explore our collection of 30+ free tools and make your wedding planning simple and organized.
				</p>
				<a href="/" class="hand-btn" style="padding: 12px 28px; font-size: 1.15rem; text-decoration: none; display: inline-block;">
					Explore All 30+ Free Tools →
				</a>
			</div>

		</article>

	</main>
</Layout>
