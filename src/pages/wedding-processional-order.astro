---
import Layout from '../layouts/Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/wedding-processional-order/#webapp",
      "name": "Wedding Processional & Ceremony Order Generator",
      "url": "https://manage.wedding/wedding-processional-order",
      "description": "Free wedding processional and recessional order generator. Build customized ceremony walking lineups for Christian, Jewish, Catholic, Non-denominational, and LGBTQ+ weddings. Export printable coordinator pocket guides.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Arrange the Wedding Ceremony Processional Order",
      "description": "Step-by-step ceremony walking order and aisle spacing etiquette for modern weddings.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Seat Grandparents and Parents First",
          "text": "The processional begins with the seating of the groom's grandparents and parents, followed by the mother of the bride (the final seated family member)."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Officiant, Groom and Best Man Take Altar Position",
          "text": "The officiant, groom, and best man enter from the side of the altar, or walk down the aisle before the bridal party."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Groomsmen, Bridesmaids & Ring Bearers Enter",
          "text": "Wedding attendants walk down the aisle spaced 4 to 6 paces apart, either individually or paired, followed by the ring bearer and flower girl."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: The Bridal Entrance & Music Transition",
          "text": "The music transitions to the bridal entrance song. The bride enters escorted by her father, both parents, or solo."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who walks down the aisle first in a traditional wedding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In a traditional Christian processional, the groom's grandparents and parents are seated first, followed by the mother of the bride. The officiant, groom, and best man typically enter from the side of the sanctuary."
          }
        },
        {
          "@type": "Question",
          "name": "How does the Jewish wedding processional differ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In a Jewish wedding processional, both the groom and the bride are escorted down the aisle by both of their parents (father and mother on either side). The rabbi and cantor lead the processional, and all participants stand beneath the Chuppah."
          }
        },
        {
          "@type": "Question",
          "name": "How far apart should bridesmaids and groomsmen walk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wedding party members should maintain a spacing of roughly 4 to 6 paces (about 15 to 20 feet) or wait until the person in front of them is halfway down the aisle before starting."
          }
        },
        {
          "@type": "Question",
          "name": "What is the order of the wedding recessional exit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The recessional is the exact reverse of the processional: the newly married couple exits first, followed by the flower girl and ring bearer, Maid of Honor and Best Man paired together, bridesmaids and groomsmen paired, and finally parents and grandparents."
          }
        },
        {
          "@type": "Question",
          "name": "On which side does the bride stand at the altar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In Christian and Western ceremonies, the bride stands on the left side of the altar (facing the altar) and the groom stands on the right. In Jewish traditions, the bride stands on the right and the groom stands on the left."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Processional & Ceremony Order Generator (Free Printable Lineup)"
	description="Free wedding processional and recessional order builder. Customize ceremony walking lineups for Christian, Jewish, Catholic, and LGBTQ+ weddings. Export printable coordinator pocket guides."
	schema={schema}
>
	<main class="section-paper" style="max-width: 1200px; margin: 0 auto; padding: clamp(1rem, 3vw, 2.5rem);">
		
		<!-- Header -->
		<header class="fade-in category-header" style="text-align: center; margin-bottom: 2.5rem; position: relative;">
			<div class="tape" style="margin: 0 auto 1rem;"></div>
			<span class="badge-postit">4,400+ Monthly Rehearsals Planned</span>
			<h1 class="font-heading" style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 0.5rem 0; color: var(--fg-pencil); line-height: 1.2;">
				Wedding Ceremony <span class="accent-italic">Processional Builder</span>
			</h1>
			<p class="font-body" style="color: var(--text-secondary); max-width: 720px; margin: 0 auto; font-size: 1.15rem; line-height: 1.6;">
				Customize walking orders, altar standing positions, and recessional exits for traditional Christian, Jewish, Catholic, and modern ceremonies. Export printable pocket cards for your officiant and coordinator.
			</p>
		</header>

		<!-- Main Interactive Grid -->
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; margin-bottom: 3.5rem; align-items: start;">
			
			<!-- Left Column: Ceremony Configuration & Lineup Builder -->
			<div class="hand-card" style="padding: clamp(1.5rem, 3.5vw, 2.5rem); background: #fff;">
				
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.5rem; margin: 0; color: var(--fg-pencil);">
						Ceremony Lineup Setup
					</h2>
					<span style="font-size: 0.85rem; font-weight: 700; background: var(--post-it); border: 1.5px solid var(--fg-pencil); padding: 3px 8px; border-radius: 4px;">
						Multi-Tradition
					</span>
				</div>

				<!-- Tradition Selector -->
				<div class="form-group">
					<label class="form-label" for="ceremony-tradition">Ceremony Tradition / Archetype</label>
					<select id="ceremony-tradition" class="form-input" style="cursor: pointer; background: #f8fafc; font-weight: 600;">
						<option value="christian" selected>✝️ Traditional Christian / Western Processional</option>
						<option value="jewish">✡️ Jewish Ceremony Processional (Under the Chuppah)</option>
						<option value="catholic">⛪ Catholic Mass Processional</option>
						<option value="nondenom">✨ Modern Non-Denominational / Secular</option>
						<option value="lgbtq">🌈 Dual Entrance / LGBTQ+ Symmetrical</option>
						<option value="minimalist">🌿 Intimate & Minimalist (Short Lineup)</option>
					</select>
				</div>

				<!-- Mode Selector (Processional vs Recessional vs Altar) -->
				<div class="form-group">
					<label class="form-label">View / Lineup Phase</label>
					<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
						<button type="button" class="phase-btn hand-btn is-active" data-phase="processional" style="padding: 8px; font-size: 0.9rem;">
							🚶‍♂️ 1. Processional (Entrance)
						</button>
						<button type="button" class="phase-btn hand-btn" data-phase="recessional" style="padding: 8px; font-size: 0.9rem;">
							🎉 2. Recessional (Exit)
						</button>
					</div>
				</div>

				<!-- Couple Names -->
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;" class="form-group">
					<div>
						<label class="form-label" for="partner1-name">Partner 1 (Bride / Groom)</label>
						<input type="text" id="partner1-name" class="form-input" value="Sarah" placeholder="e.g. Sarah" />
					</div>
					<div>
						<label class="form-label" for="partner2-name">Partner 2 (Groom / Partner)</label>
						<input type="text" id="partner2-name" class="form-input" value="John" placeholder="e.g. John" />
					</div>
				</div>

				<!-- Escort Selection -->
				<div class="form-group">
					<label class="form-label" for="escort-style">Partner 1 Escort</label>
					<select id="escort-style" class="form-input" style="cursor: pointer;">
						<option value="father" selected>Escorted by Father</option>
						<option value="both-parents">Escorted by Both Parents (Mother & Father)</option>
						<option value="mother">Escorted by Mother</option>
						<option value="sibling">Escorted by Sibling / Close Family</option>
						<option value="solo">Walking Solo Down the Aisle</option>
						<option value="together">Walking Together as Couple</option>
					</select>
				</div>

				<!-- Quick Add Custom Attendant -->
				<div class="form-group" style="margin-top: 1.5rem; padding-top: 1rem; border-top: 2px dashed var(--fg-pencil);">
					<label class="form-label">Add Custom Member to Lineup</label>
					<div style="display: flex; gap: 0.5rem;">
						<input type="text" id="custom-member-input" class="form-input" placeholder="e.g. Dog Ring Bearer, Step-Father" style="flex: 1;" />
						<button id="btn-add-custom-member" type="button" class="hand-btn secondary" style="padding: 8px 14px; font-size: 0.9rem;">
							+ Add
						</button>
					</div>
				</div>

			</div>

			<!-- Right Column: Interactive Lineup Cards & Coordinator Pocket Sheet -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Lineup Card Container -->
				<div class="hand-card" style="padding: clamp(1.5rem, 3vw, 2.5rem); background: #ffffff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
						<h3 id="lineup-heading" class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0;">
							1. Processional Walking Order
						</h3>
						<span id="lineup-count-badge" style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); background: #f1f5f9; padding: 4px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
							9 Steps | ~4-6 paces spacing
						</span>
					</div>

					<!-- Visual Lineup Cards List -->
					<div id="lineup-list-container" style="display: flex; flex-direction: column; gap: 0.6rem; max-height: 520px; overflow-y: auto; padding-right: 4px;">
						<!-- Dynamic Step Rows Rendered Here -->
					</div>

					<!-- Action Buttons -->
					<div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
						<button id="btn-print-pocket-sheet" class="hand-btn" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>🖨️</span> Print Coordinator Pocket Guide
						</button>
						<button id="btn-export-text" class="hand-btn secondary" style="flex: 1; padding: 12px; font-size: 1rem; gap: 0.4rem;">
							<span>📲</span> Copy WhatsApp Lineup
						</button>
					</div>

				</div>

				<!-- Music Transition & Timing Cue Box -->
				<div class="hand-card" style="padding: 1.5rem; background: var(--bg-paper);">
					<strong class="font-heading" style="font-size: 1.15rem; color: var(--accent-red); display: block; margin-bottom: 0.4rem;">
						🎵 Music Timing & Song Transition Cues:
					</strong>
					<ul style="margin: 0 0 0 1.25rem; padding: 0; font-size: 0.92rem; color: var(--fg-pencil); line-height: 1.6;">
						<li><strong>Song 1 (Processional Prelude):</strong> For seating of Grandparents, Parents, and entrance of Groomsmen & Bridesmaids.</li>
						<li><strong>Music Pause (10-15s):</strong> Complete silence while doors close and guests stand.</li>
						<li><strong>Song 2 (Bridal Processional):</strong> Dramatic entrance song as the bride walks down the aisle.</li>
						<li><strong>Song 3 (Recessional Anthem):</strong> High-energy celebratory track as the married couple exits!</li>
					</ul>
				</div>

			</div>

		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Section -->
		<div class="hand-card" style="margin-bottom: 3.5rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--post-it); border: 2.5px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); position: relative;">
			<div class="tape" style="margin: 0 auto 0.75rem;"></div>
			
			<div style="text-align: center; margin-bottom: 1.25rem;">
				<span class="badge-postit" style="position: static; display: inline-block; transform: rotate(-1deg); margin-bottom: 0.5rem;">⚡ Bottom Line Up Front (BLUF)</span>
				<h2 class="font-heading" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: var(--fg-pencil); margin: 0 0 0.4rem 0;">
					Quick Rule of Thumb: Wedding Ceremony Walking Orders
				</h2>
				<p class="font-body" style="font-size: 1.02rem; color: var(--fg-pencil); max-width: 780px; margin: 0 auto; font-weight: 500;">
					Short on time? Here is the 1-minute walking sequence matrix comparing Christian, Jewish, Catholic, and secular processional hierarchies.
				</p>
			</div>

			<!-- Formula Callout -->
			<div style="background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<strong class="font-heading" style="display: block; font-size: 1.15rem; color: var(--accent-red); margin-bottom: 0.35rem; text-align: center;">
					🚶‍♂️ The Standard Processional & Recessional Rule:
				</strong>
				<p class="font-body" style="font-size: 0.98rem; line-height: 1.6; margin: 0; color: var(--fg-pencil); text-align: center; font-weight: 600;">
					Processional: [Grandparents → Parents → Officiant/Groom → Attendants → Ring Bearer/Flower Girl → Maid of Honor → Bride] • Recessional: [Newlyweds FIRST → Flower Girl/Ring Bearer → Maid of Honor/Best Man → Attendants → Parents → Grandparents].
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto; background: #fff; border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 0.5rem; box-shadow: 2px 2px 0px var(--fg-pencil);">
				<table style="width: 100%; border-collapse: collapse; text-align: left; font-family: var(--font-body); font-size: 0.92rem; min-width: 650px;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Ceremony Tradition</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Entrance Style & Escorts</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading);">Altar Standing Sides</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); text-align: center;">Key Distinction</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-red);">Traditional Christian</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Officiant/Groom enter from side; Bride escorted by Father.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Bride on LEFT, Groom on RIGHT</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Mother of bride is final seated family member</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: var(--accent-blue);">Jewish (Chuppah)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Groom escorted by Both Parents; Bride escorted by Both Parents.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Bride on RIGHT, Groom on LEFT</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Rabbi/Cantor leads; Parents stand under Chuppah</td>
						</tr>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #16a34a);">Catholic Mass</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Priest and altar servers lead liturgical procession down aisle.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Bride on LEFT, Groom on RIGHT</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Includes full Liturgy of the Word and Eucharist</td>
						</tr>
						<tr style="background: #faf8f5;">
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: bold; color: #7c3aed);">Modern / LGBTQ+</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 600;">Dual aisle simultaneous entrance, walking together, or solo.</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Flexible based on preference</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); text-align: center;">Symmetrical entrance celebrating equality</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<!-- Comprehensive SEO Guide -->
		<article class="hand-card" style="padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: 4rem;">
			
			<div style="text-align: center; max-width: 800px; margin: 0 auto 2.5rem;">
				<h2 class="font-heading" style="font-size: clamp(2rem, 4vw, 2.8rem); color: var(--fg-pencil); margin-bottom: 0.75rem;">
					The Complete Wedding Processional & Recessional Guide
				</h2>
				<p class="font-body" style="font-size: 1.15rem; color: var(--text-secondary); line-height: 1.6;">
					Ensure seamless ceremony transitions with zero awkward collisions, missed music cues, or rehearsal confusion.
				</p>
			</div>

			<!-- Section 1: Step-by-Step Walking Order -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-red); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					1. The Anatomy of a Flawless Processional
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					The ceremony walk should feel graceful and unhurried. Follow these standard walking orders and pacing guidelines:
				</p>
				<ol class="font-body" style="font-size: 1.02rem; line-height: 1.7; color: var(--fg-pencil); margin-left: 1.5rem; margin-bottom: 1.5rem;">
					<li><strong>Seating of the Grandparents:</strong> Escorted down the aisle by an usher or groomsman and seated in the first row.</li>
					<li><strong>Seating of the Groom's Parents:</strong> Groom's mother escorted by groom or usher, followed by father of the groom.</li>
					<li><strong>Seating of the Mother of the Bride:</strong> Signals to the entire congregation that the ceremony is about to commence. Once she is seated, no further guests may be seated in the main nave.</li>
					<li><strong>Officiant & Groom Entrance:</strong> Enter quietly from the side or take their position at the center of the altar.</li>
					<li><strong>Bridesmaids & Groomsmen:</strong> Walk down the aisle individually or in pairs spaced roughly 4 to 6 paces apart.</li>
					<li><strong>Ring Bearer & Flower Girl:</strong> Enter directly ahead of the bride. If very young, seat their parents near the front row aisle so they walk toward familiar faces.</li>
					<li><strong>The Bride & Escort:</strong> The climactic moment. Walk slowly, breathe, and look ahead at your partner.</li>
				</ol>
			</section>

			<!-- Section 2: Pacing & Aisle Etiquette -->
			<section style="margin-bottom: 3rem;">
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--accent-blue); margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.5rem;">
					2. Pacing, Spacing & The "Halfway Rule"
				</h3>
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.7; color: var(--fg-pencil); margin-bottom: 1rem;">
					The #1 mistake wedding parties make during rehearsals is walking too quickly or bunching up. Use the <strong>"Halfway Rule"</strong>:
				</p>
				<div style="background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; font-size: 0.98rem; line-height: 1.6; color: var(--fg-pencil);">
					<strong>📏 The Halfway Spacing Rule:</strong><br />
					Each pair or bridesmaid should NOT start walking down the aisle until the person ahead of them has reached the halfway mark of the aisle. This guarantees your photographer gets clean, unobstructed individual portraits of every attendant without someone walking directly behind them!
				</div>
			</section>

			<!-- Section 3: FAQs -->
			<section>
				<h3 class="font-heading" style="font-size: 1.75rem; color: var(--fg-pencil); margin-bottom: 1.5rem; text-align: center;">
					Frequently Asked Questions
				</h3>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Who walks down the aisle first in a traditional wedding?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						The groom's grandparents and parents are seated first, followed by the mother of the bride. The officiant, groom, and best man enter next.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">How does the wedding recessional exit work?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						The newly married couple exits down the aisle first as the crowd cheers, followed by the flower girl/ring bearer, Maid of Honor and Best Man paired together, bridesmaids and groomsmen paired, and parents.
					</p>
				</details>

				<details style="margin-bottom: 0.75rem; cursor: pointer;">
					<summary style="font-weight: 700; color: var(--fg-pencil); font-size: 1.05rem;">Should both parents walk the bride down the aisle?</summary>
					<p style="font-size: 0.98rem; color: var(--text-secondary); margin-top: 0.5rem; line-height: 1.6;">
						While traditional Western etiquette specifies the father, having both mother and father escort the bride is standard in Jewish weddings and increasingly popular in modern weddings to honor both parents equally.
					</p>
				</details>
			</section>

		</article>

		<RelatedTools currentPath="/wedding-processional-order" category="logistics" />

	</main>

	<!-- Interactive Script -->
	<script is:inline>
		const traditionSelect = document.getElementById('ceremony-tradition');
		const partner1Input = document.getElementById('partner1-name');
		const partner2Input = document.getElementById('partner2-name');
		const escortSelect = document.getElementById('escort-style');
		const phaseButtons = document.querySelectorAll('.phase-btn');
		const lineupContainer = document.getElementById('lineup-list-container');
		const lineupHeading = document.getElementById('lineup-heading');
		const lineupCountBadge = document.getElementById('lineup-count-badge');
		const customInput = document.getElementById('custom-member-input');
		const btnAddCustom = document.getElementById('btn-add-custom-member');
		const btnPrint = document.getElementById('btn-print-pocket-sheet');
		const btnCopyText = document.getElementById('btn-export-text');

		let currentPhase = 'processional';
		let lineupData = [];

		const presets = {
			christian: [
				{ role: "Seating of Groom's Grandparents", names: "Grandparents of the Groom", cue: "Song 1 begins" },
				{ role: "Seating of Bride's Grandparents", names: "Grandparents of the Bride", cue: "" },
				{ role: "Seating of Groom's Parents", names: "Parents of the Groom", cue: "" },
				{ role: "Seating of Mother of the Bride", names: "Mother of the Bride", cue: "Signals start of wedding" },
				{ role: "Officiant & Groom Take Position", names: "Officiant & Groom (John)", cue: "Enter from side of altar" },
				{ role: "Best Man Entrance", names: "Best Man", cue: "Enters from side or down aisle" },
				{ role: "Bridesmaids & Groomsmen (Paired/Solo)", names: "Wedding Party Attendants", cue: "Halfway spacing" },
				{ role: "Maid of Honor", names: "Maid of Honor", cue: "Stands left of bride" },
				{ role: "Ring Bearer & Flower Girl", names: "Ring Bearer & Flower Girl", cue: "Carries rings & petals" },
				{ role: "Bridal Entrance (Sarah & Escort)", names: "Bride (Sarah) & Father", cue: "🎵 Song 2 (Bridal Chorus)" }
			],
			jewish: [
				{ role: "Rabbi and/or Cantor", names: "Rabbi & Cantor", cue: "Stand beneath Chuppah" },
				{ role: "Grandparents of the Bride", names: "Grandparents", cue: "" },
				{ role: "Grandparents of the Groom", names: "Grandparents", cue: "" },
				{ role: "Groomsmen", names: "Groomsmen", cue: "Take position under Chuppah" },
				{ role: "Best Man", names: "Best Man", cue: "" },
				{ role: "Groom Escorted by Both Parents", names: "Groom (John) + Mother & Father", cue: "Stands on right side under Chuppah" },
				{ role: "Bridesmaids", names: "Bridesmaids", cue: "" },
				{ role: "Maid of Honor", names: "Maid of Honor", cue: "" },
				{ role: "Ring Bearer & Flower Girl", names: "Ring Bearer & Flower Girl", cue: "" },
				{ role: "Bride Escorted by Both Parents", names: "Bride (Sarah) + Mother & Father", cue: "🎵 Bridal Entrance under Chuppah" }
			],
			catholic: [
				{ role: "Liturgical Procession", names: "Priest, Deacons & Altar Servers", cue: "Process down center aisle" },
				{ role: "Groom & Best Man", names: "Groom (John) & Best Man", cue: "Enter from side or altar" },
				{ role: "Mother of the Groom & Mother of Bride", names: "Mothers seated", cue: "" },
				{ role: "Groomsmen & Bridesmaids (Paired)", names: "Attendants in pairs", cue: "Spaced 6 paces apart" },
				{ role: "Maid of Honor", names: "Maid of Honor", cue: "" },
				{ role: "Ring Bearer & Flower Girl", names: "Ring Bearer & Flower Girl", cue: "" },
				{ role: "Bride & Escort", names: "Bride (Sarah) & Escort", cue: "🎵 Bridal March to Sanctuary" }
			],
			nondenom: [
				{ role: "Seating of VIP Family / Parents", names: "Parents & Grandparents", cue: "Music Prelude" },
				{ role: "Officiant Entrance", names: "Officiant", cue: "Takes center position" },
				{ role: "Partner 2 Entrance", names: "Partner 2 (John)", cue: "Solo or with parents" },
				{ role: "Wedding Party Attendants", names: "Mixed Attendants / Bridesmaids / Groomsmen", cue: "Halfway spacing rule" },
				{ role: "Honor Attendants", names: "Maid of Honor & Best Man", cue: "" },
				{ role: "Ring Security / Flower Crew", names: "Ring Bearer / Flower Crew", cue: "" },
				{ role: "Partner 1 Entrance", names: "Partner 1 (Sarah) & Escort", cue: "🎵 Main Processional Anthem" }
			],
			lgbtq: [
				{ role: "Seating of Families", names: "Parents & Grandparents of Both Partners", cue: "Song 1" },
				{ role: "Officiant Takes Position", names: "Officiant / Celebrant", cue: "Center altar" },
				{ role: "Wedding Party Attendants", names: "Attendants & Friends", cue: "Symmetrical lineup" },
				{ role: "Honor Attendants", names: "Best People / Honor Attendants", cue: "" },
				{ role: "Dual Couple Entrance", names: "Partner 1 (Sarah) & Partner 2 (John) Enter Together", cue: "🎵 Walk together down center aisle" }
			],
			minimalist: [
				{ role: "Officiant & Partner 2", names: "Officiant & Partner 2 (John)", cue: "Take center position" },
				{ role: "Witnesses / Attendants", names: "Two Witnesses / Attendants", cue: "" },
				{ role: "Partner 1 Entrance", names: "Partner 1 (Sarah) & Escort", cue: "🎵 Ceremony Entrance" }
			]
		};

		function loadTradition() {
			const t = traditionSelect.value;
			const raw = presets[t] || presets.christian;
			lineupData = JSON.parse(JSON.stringify(raw));
			applyCustomNames();
		}

		function applyCustomNames() {
			const p1 = partner1Input.value.trim() || 'Sarah';
			const p2 = partner2Input.value.trim() || 'John';
			const escort = escortSelect.options[escortSelect.selectedIndex].text;

			lineupData.forEach(item => {
				item.role = item.role.replace(/Sarah/g, p1).replace(/John/g, p2);
				item.names = item.names.replace(/Sarah/g, p1).replace(/John/g, p2);
				if (item.role.includes('Bridal Entrance') || item.role.includes('Partner 1 Entrance')) {
					item.names = `${p1} & ${escort}`;
				}
			});
			renderLineup();
		}

		function renderLineup() {
			lineupContainer.innerHTML = '';

			let displayList = [...lineupData];
			if (currentPhase === 'recessional') {
				lineupHeading.textContent = '2. Recessional Exit Order';
				// Reverse for recessional
				displayList = [
					{ role: "Married Couple Exits First", names: `${partner1Input.value || 'Sarah'} & ${partner2Input.value || 'John'} (Married!)`, cue: "🎵 Celebratory Recessional Anthem" },
					{ role: "Flower Girl & Ring Bearer", names: "Flower Girl & Ring Bearer", cue: "Exit immediately after couple" },
					{ role: "Maid of Honor & Best Man", names: "Maid of Honor & Best Man (Paired)", cue: "" },
					{ role: "Bridesmaids & Groomsmen", names: "Wedding Party Attendants (Paired)", cue: "" },
					{ role: "Parents of the Bride / Partner 1", names: "Parents of Partner 1", cue: "" },
					{ role: "Parents of the Groom / Partner 2", names: "Parents of Partner 2", cue: "" },
					{ role: "Grandparents", names: "Grandparents", cue: "" },
					{ role: "Guests Dismissal / Ushers", names: "Ushers dismiss row by row", cue: "" }
				];
			} else {
				lineupHeading.textContent = '1. Processional Walking Order';
			}

			lineupCountBadge.textContent = `${displayList.length} Steps | ~4-6 paces apart`;

			displayList.forEach((item, idx) => {
				const row = document.createElement('div');
				row.style.cssText = "display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #f8fafc; border: 1.5px solid var(--fg-pencil); border-radius: 6px; gap: 0.75rem;";
				
				row.innerHTML = `
					<div style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">
						<span style="font-weight: 800; font-size: 1.1rem; color: var(--accent-red); width: 24px; text-align: center;">${idx + 1}</span>
						<div>
							<strong style="font-size: 0.98rem; color: var(--fg-pencil); display: block;">${item.role}</strong>
							<span style="font-size: 0.88rem; color: #475569;">${item.names}</span>
							${item.cue ? `<span style="display: block; font-size: 0.78rem; font-weight: 700; color: var(--accent-blue); margin-top: 2px;">⚡ Cue: ${item.cue}</span>` : ''}
						</div>
					</div>
					<div style="display: flex; gap: 4px;">
						<button type="button" class="btn-move-up hand-btn secondary" data-index="${idx}" style="padding: 3px 7px; font-size: 0.75rem;" ${idx === 0 ? 'disabled' : ''}>▲</button>
						<button type="button" class="btn-move-down hand-btn secondary" data-index="${idx}" style="padding: 3px 7px; font-size: 0.75rem;" ${idx === displayList.length - 1 ? 'disabled' : ''}>▼</button>
					</div>
				`;
				lineupContainer.appendChild(row);
			});

			// Attach Move Listeners
			if (currentPhase === 'processional') {
				document.querySelectorAll('.btn-move-up').forEach(b => {
					b.addEventListener('click', (e) => {
						const idx = parseInt(b.getAttribute('data-index'), 10);
						if (idx > 0) {
							const temp = lineupData[idx];
							lineupData[idx] = lineupData[idx - 1];
							lineupData[idx - 1] = temp;
							renderLineup();
						}
					});
				});
				document.querySelectorAll('.btn-move-down').forEach(b => {
					b.addEventListener('click', (e) => {
						const idx = parseInt(b.getAttribute('data-index'), 10);
						if (idx < lineupData.length - 1) {
							const temp = lineupData[idx];
							lineupData[idx] = lineupData[idx + 1];
							lineupData[idx + 1] = temp;
							renderLineup();
						}
					});
				});
			}
		}

		// Phase Button Toggles
		phaseButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				phaseButtons.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentPhase = btn.getAttribute('data-phase');
				renderLineup();
			});
		});

		// Custom Member Addition
		btnAddCustom.addEventListener('click', () => {
			const val = customInput.value.trim();
			if (!val) return;
			lineupData.splice(lineupData.length - 1, 0, {
				role: val,
				names: val,
				cue: "Custom Member"
			});
			customInput.value = '';
			renderLineup();
		});

		traditionSelect.addEventListener('change', loadTradition);
		[partner1Input, partner2Input, escortSelect].forEach(inp => {
			inp.addEventListener('input', applyCustomNames);
		});

		// Print Coordinator Pocket Guide
		btnPrint.addEventListener('click', () => {
			const printWindow = window.open('', '_blank');
			let html = `
				<!DOCTYPE html>
				<html>
				<head>
					<title>Ceremony Lineup Pocket Guide — Manage.Wedding</title>
					<style>
						@page { size: 8.5in 11in; margin: 0.5in; }
						body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1e293b; }
						h1 { font-size: 18pt; margin-bottom: 4px; color: #0f172a; }
						h2 { font-size: 14pt; margin-top: 18px; margin-bottom: 6px; border-bottom: 2px solid #0f172a; padding-bottom: 3px; }
						table { width: 100%; border-collapse: collapse; margin-top: 8px; }
						th, td { border: 1px solid #cbd5e1; padding: 6px 10px; text-align: left; }
						th { background-color: #f1f5f9; font-weight: bold; }
					</style>
				</head>
				<body>
					<h1>Ceremony Lineup Guide: ${partner1Input.value || 'Sarah'} & ${partner2Input.value || 'John'}</h1>
					<p style="font-size: 10pt; color: #64748b; margin-top: 0;">Tradition: ${traditionSelect.options[traditionSelect.selectedIndex].text} | Spacing: 4-6 paces (Halfway Rule)</p>
					
					<h2>1. Processional Walking Order (Entrance)</h2>
					<table>
						<thead><tr><th style="width: 40px;">#</th><th>Role / Group</th><th>Participant Name(s)</th><th>Music & Timing Cue</th></tr></thead>
						<tbody>
			`;

			lineupData.forEach((item, idx) => {
				html += `
					<tr>
						<td><strong>${idx + 1}</strong></td>
						<td><strong>${item.role}</strong></td>
						<td>${item.names}</td>
						<td>${item.cue || '—'}</td>
					</tr>
				`;
			});

			html += `
						</tbody>
					</table>

					<h2>2. Recessional Exit Order</h2>
					<table>
						<thead><tr><th style="width: 40px;">#</th><th>Order</th><th>Group</th></tr></thead>
						<tbody>
							<tr><td>1</td><td><strong>Newly Married Couple (First)</strong></td><td>${partner1Input.value || 'Sarah'} & ${partner2Input.value || 'John'}</td></tr>
							<tr><td>2</td><td>Flower Girl & Ring Bearer</td><td>Flower Girl & Ring Bearer</td></tr>
							<tr><td>3</td><td>Maid of Honor & Best Man</td><td>Maid of Honor & Best Man (Paired)</td></tr>
							<tr><td>4</td><td>Bridesmaids & Groomsmen</td><td>Attendants Paired</td></tr>
							<tr><td>5</td><td>Parents of the Couple</td><td>Mother & Father of Both Partners</td></tr>
							<tr><td>6</td><td>Grandparents</td><td>Grandparents</td></tr>
						</tbody>
					</table>
					<script>window.onload = function() { window.print(); };<\/script>
				</body></html>
			`;
			printWindow.document.write(html);
			printWindow.document.close();
		});

		// Copy WhatsApp Lineup
		btnCopyText.addEventListener('click', () => {
			let text = `⛪ *Ceremony Lineup for ${partner1Input.value || 'Sarah'} & ${partner2Input.value || 'John'}*\n\n`;
			text += `*🚶‍♂️ Processional Order:*\n`;
			lineupData.forEach((item, idx) => {
				text += `${idx + 1}. ${item.role} (${item.names})${item.cue ? ` - _Cue: ${item.cue}_` : ''}\n`;
			});
			text += `\n*🎉 Recessional (Exit):*\n1. Married Couple First!\n2. Flower Girl & Ring Bearer\n3. Maid of Honor & Best Man\n4. Attendants (Paired)\n5. Parents & Grandparents`;

			navigator.clipboard.writeText(text).then(() => {
				const orig = btnCopyText.textContent;
				btnCopyText.textContent = '✅ Copied to WhatsApp!';
				setTimeout(() => { btnCopyText.textContent = orig; }, 2500);
			});
		});

		// Initial Load
		loadTradition();
	</script>
</Layout>
