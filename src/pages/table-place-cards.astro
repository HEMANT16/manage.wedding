	// Initial State starts with 1 clean sample guest
	// Helper to extract clean meal icon (returns empty string if None or no icon)
	function getMealIcon(mealStr) {
		if (!mealStr) return '';
		const trimmed = mealStr.trim();
		if (trimmed === 'None' || trimmed.toLowerCase().includes('none') || trimmed.startsWith('⚪')) {
			return '';
		}
		const icon = trimmed.split(' ')[0];
		if (icon === '⚪' || icon.toLowerCase() === 'none') {
			return '';
		}
		return icon;
	}

