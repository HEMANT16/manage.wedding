</style>

<script is:inline>
	let seatedGuestList = [
		{ name: "Olivia Johnson", table: "1", meal: "🥩 Beef" },
		{ name: "Liam Johnson", table: "1", meal: "🐟 Fish" },
		{ name: "Marcus Chen", table: "2", meal: "🍗 Chicken" },
		{ name: "Sophia Chen", table: "2", meal: "🥦 Vegetarian" },
		{ name: "David Miller", table: "3", meal: "🥩 Beef" },
		{ name: "Grandma Evelyn", table: "Head Table", meal: "🐟 Fish" },
		{ name: "Grandpa Joe", table: "Head Table", meal: "🥩 Beef" }
	];

	let selectedGuestIndex = 0;

	const selectCardType = document.getElementById('select-card-type');
	const selectBorderTheme = document.getElementById('select-border-theme');
	const chkShowMealIcons = document.getElementById('chk-show-meal-icons');
	const chkShowTableBadge = document.getElementById('chk-show-table-badge');
	const previewCanvas = document.getElementById('preview-placecard-canvas');
	const previewScaleLabel = document.getElementById('preview-scale-label');
	const assignedCountBadge = document.getElementById('assigned-count-badge');
	const tableCardsStream = document.getElementById('table-cards-stream');

	const inputGuestName = document.getElementById('input-new-guest-name');
	const inputTableNum = document.getElementById('input-new-table-num');
	const selectMeal = document.getElementById('select-new-meal');

	function loadSeatedGuests() {
		try {
			const saved = localStorage.getItem('manage_wedding_guests');
			if (saved) {
				const all = JSON.parse(saved);
				const valid = all.filter(g => g.name && g.name.trim() !== "");
				if (valid.length > 0) {
					seatedGuestList = valid.map(g => ({
						name: g.name,
						table: g.table || "1",
						meal: g.meal || "🥩 Beef"
					}));
				}
			}
		} catch (e) {}

		renderPlaceCards();
	}

	function loadSampleTables() {
		seatedGuestList = [
			{ name: "Olivia Johnson", table: "1", meal: "🥩 Beef" },
			{ name: "Liam Johnson", table: "1", meal: "🐟 Fish" },
			{ name: "Marcus Chen", table: "2", meal: "🍗 Chicken" },
			{ name: "Sophia Chen", table: "2", meal: "🥦 Vegetarian" },
			{ name: "David Miller", table: "3", meal: "🥩 Beef" },
			{ name: "Grandma Evelyn", table: "Head Table", meal: "🐟 Fish" },
			{ name: "Grandpa Joe", table: "Head Table", meal: "🥩 Beef" }
		];
		selectedGuestIndex = 0;
		renderPlaceCards();
	}

	function renderPlaceCards() {
		const cardType = selectCardType.value; // 'tent', 'flat', 'tablenum'
		const theme = selectBorderTheme.value; // 'botanical', 'classic', 'crest'
		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;

		// Ensure valid index
		if (selectedGuestIndex >= seatedGuestList.length) {
			selectedGuestIndex = Math.max(0, seatedGuestList.length - 1);
		}

		const currentGuest = seatedGuestList[selectedGuestIndex] || {
			name: inputGuestName.value.trim() || "Guest Name",
			table: inputTableNum.value.trim() || "1",
			meal: selectMeal.value || "🥩 Beef"
		};

		// Update preview frame classes
		previewCanvas.className = `card-format-${cardType} theme-${theme}`;

		// Update scale label
		if (cardType === 'tent') {
			previewScaleLabel.textContent = `Folded Tent Card (3.5" x 4" Flat • 3.5" x 2" Folded Stand)`;
		} else if (cardType === 'flat') {
			previewScaleLabel.textContent = `Flat Escort Card (3.5" x 2" Horizontal Card)`;
		} else {
			previewScaleLabel.textContent = `Table Centerpiece Sign (5" x 7" Vertical Table Number)`;
		}

		// Botanical SVG Corners
		const botanicalSvg = `
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.85;">
				<path d="M12 2C8 6 4 10 4 15a8 8 0 0 0 16 0c0-5-4-9-8-13z"></path>
				<path d="M12 2v20"></path>
				<path d="M8 8c2 2 4 3 4 3"></path>
				<path d="M16 12c-2 2-4 3-4 3"></path>
			</svg>
		`;

		// Crest Corner Flourish
		const crestCornerSvg = `
			<svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" style="opacity: 0.8;">
				<path d="M2 2h6v2H4v4H2V2zm16 0h-6v2h4v4h2V2zM2 18h6v-2H4v-4H2v6zm16 0h-6v-2h4v-4h2v6z"/>
			</svg>
		`;

		// Build Live Preview Canvas HTML based on Format & Theme
		if (cardType === 'tent') {
			// Folded Tent Card (Top Fold Flap + Bottom Front Face)
			previewCanvas.innerHTML = `
				<div style="flex: 1; border-bottom: 1.5px dashed #94a3b8; display: flex; align-items: center; justify-content: center; position: relative; background: rgba(0,0,0,0.02);">
					<span style="font-size: 0.72rem; letter-spacing: 2px; text-transform: uppercase; opacity: 0.6; font-family: sans-serif;">
						✂️ FOLD LINE • BACK STAND
					</span>
					<span style="position: absolute; top: 8px; font-style: italic; font-size: 0.82rem; opacity: 0.7;">
						Welcome to Our Wedding
					</span>
				</div>
				<div style="flex: 1.25; padding: 0.75rem 1rem; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; box-sizing: border-box;">
					<div class="card-inner-border" style="position: absolute; inset: 4px; border-radius: 2px; pointer-events: none;"></div>
					${theme === 'botanical' ? `
						<div style="position: absolute; top: 4px; left: 4px; color: #234e32;">${botanicalSvg}</div>
						<div style="position: absolute; top: 4px; right: 4px; transform: scaleX(-1); color: #234e32;">${botanicalSvg}</div>
					` : ''}
					${theme === 'crest' ? `
						<div style="position: absolute; top: 4px; left: 4px; color: #b45309;">${crestCornerSvg}</div>
						<div style="position: absolute; top: 4px; right: 4px; transform: scaleX(-1); color: #b45309;">${crestCornerSvg}</div>
					` : ''}
					<h2 style="font-size: 1.35rem; margin: 0 0 0.2rem 0; line-height: 1.2; font-weight: 600; text-align: center;">
						${currentGuest.name}
					</h2>
					<div class="divider-line" style="width: 32px; height: 1.5px; margin: 0.2rem auto;"></div>
					${showTable ? `
						<p class="accent-color" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; margin: 0.2rem 0 0 0; font-weight: bold;">
							Table ${currentGuest.table}
						</p>
					` : ''}
					${showMeal ? `
						<div style="position: absolute; bottom: 6px; right: 8px; font-size: 1.1rem;" title="Meal Choice">
							${currentGuest.meal.split(' ')[0] || '🥩'}
						</div>
					` : ''}
				</div>
			`;
		} else if (cardType === 'flat') {
			// Flat Escort Card
			previewCanvas.innerHTML = `
				<div style="flex: 1; padding: 1.25rem; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; box-sizing: border-box;">
					<div class="card-inner-border" style="position: absolute; inset: 6px; border-radius: 2px; pointer-events: none;"></div>
					${theme === 'botanical' ? `
						<div style="position: absolute; top: 6px; left: 6px; color: #234e32;">${botanicalSvg}</div>
						<div style="position: absolute; top: 6px; right: 6px; transform: scaleX(-1); color: #234e32;">${botanicalSvg}</div>
						<div style="position: absolute; bottom: 6px; left: 6px; transform: scaleY(-1); color: #234e32;">${botanicalSvg}</div>
						<div style="position: absolute; bottom: 6px; right: 6px; transform: scale(-1); color: #234e32;">${botanicalSvg}</div>
					` : ''}
					${theme === 'crest' ? `
						<div style="position: absolute; top: 6px; left: 6px; color: #b45309;">${crestCornerSvg}</div>
						<div style="position: absolute; top: 6px; right: 6px; transform: scaleX(-1); color: #b45309;">${crestCornerSvg}</div>
						<div style="position: absolute; bottom: 6px; left: 6px; transform: scaleY(-1); color: #b45309;">${crestCornerSvg}</div>
						<div style="position: absolute; bottom: 6px; right: 6px; transform: scale(-1); color: #b45309;">${crestCornerSvg}</div>
					` : ''}
					<h2 style="font-size: 1.45rem; margin: 0 0 0.25rem 0; line-height: 1.2; font-weight: 600; text-align: center;">
						${currentGuest.name}
					</h2>
					<div class="divider-line" style="width: 40px; height: 1.5px; margin: 0.25rem auto;"></div>
					${showTable ? `
						<p class="accent-color" style="font-size: 0.92rem; text-transform: uppercase; letter-spacing: 2px; margin: 0.25rem 0 0 0; font-weight: bold;">
							Table ${currentGuest.table}
						</p>
					` : ''}
					${showMeal ? `
						<div style="position: absolute; bottom: 8px; right: 10px; font-size: 1.15rem;" title="Meal Choice">
							${currentGuest.meal.split(' ')[0] || '🥩'}
						</div>
					` : ''}
				</div>
			`;
		} else {
			// Table Centerpiece Number (5" x 7" Sign)
			const tableNumStr = currentGuest.table ? currentGuest.table.toString() : "1";
			previewCanvas.innerHTML = `
				<div style="flex: 1; padding: 2rem 1.5rem; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; box-sizing: border-box; text-align: center;">
					<div class="card-inner-border" style="position: absolute; inset: 8px; border-radius: 4px; pointer-events: none;"></div>
					${theme === 'botanical' ? `
						<div style="position: absolute; top: 10px; left: 10px; color: #234e32;">${botanicalSvg}</div>
						<div style="position: absolute; top: 10px; right: 10px; transform: scaleX(-1); color: #234e32;">${botanicalSvg}</div>
						<div style="position: absolute; bottom: 10px; left: 10px; transform: scaleY(-1); color: #234e32;">${botanicalSvg}</div>
						<div style="position: absolute; bottom: 10px; right: 10px; transform: scale(-1); color: #234e32;">${botanicalSvg}</div>
					` : ''}
					${theme === 'crest' ? `
						<div style="position: absolute; top: 10px; left: 10px; color: #b45309;">${crestCornerSvg}</div>
						<div style="position: absolute; top: 10px; right: 10px; transform: scaleX(-1); color: #b45309;">${crestCornerSvg}</div>
						<div style="position: absolute; bottom: 10px; left: 10px; transform: scaleY(-1); color: #b45309;">${crestCornerSvg}</div>
						<div style="position: absolute; bottom: 10px; right: 10px; transform: scale(-1); color: #b45309;">${crestCornerSvg}</div>
					` : ''}
					
					<p style="font-size: 0.95rem; letter-spacing: 4px; text-transform: uppercase; margin: 0 0 0.5rem 0; opacity: 0.85;">
						TABLE
					</p>
					<div style="font-size: 3.8rem; font-weight: 700; line-height: 1; margin: 0.25rem 0 0.5rem 0;" class="accent-color">
						${tableNumStr.replace(/[^0-9]/g, '') || tableNumStr}
					</div>
					<div class="divider-line" style="width: 50px; height: 2px; margin: 0.5rem auto 1rem;"></div>
					<p style="font-size: 0.88rem; font-style: italic; opacity: 0.8; margin: 0;">
						Please Be Seated
					</p>
				</div>
			`;
		}

		assignedCountBadge.textContent = `${seatedGuestList.length} Guests`;

		// Group by table
		const grouped = {};
		seatedGuestList.forEach((g, idx) => {
			const tbl = g.table || 'Unassigned';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push({ ...g, originalIndex: idx });
		});

		tableCardsStream.innerHTML = '';
		if (seatedGuestList.length === 0) {
			tableCardsStream.innerHTML = `
				<div style="text-align: center; padding: 1.5rem; color: var(--text-secondary); font-style: italic; font-size: 0.95rem;">
					No seated guests yet. Click "✨ Load Sample Tables" to test!
				</div>
			`;
			return;
		}

		Object.keys(grouped).forEach(tbl => {
			const groupBlock = document.createElement('div');
			groupBlock.style.cssText = `background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 0.85rem;`;
			
			let listHtml = '';
			grouped[tbl].forEach(g => {
				const isSelected = g.originalIndex === selectedGuestIndex;
				listHtml += `
					<div class="guest-item-row ${isSelected ? 'selected-guest-row' : ''}" data-idx="${g.originalIndex}" style="display: flex; justify-content: space-between; align-items: center; padding: 0.35rem 0.5rem; border-bottom: 1px dotted #ccc; font-size: 0.9rem; cursor: pointer; border-radius: 4px; transition: background 0.15s ease;">
						<span style="font-weight: ${isSelected ? '700' : '500'}; color: ${isSelected ? '#1d4ed8' : 'inherit'};">
							${isSelected ? '👉 ' : ''}${g.name} <small style="color:#64748b; font-weight: normal;">(${g.meal || 'Beef'})</small>
						</span>
						<button type="button" class="btn-del-seat hand-btn secondary" data-name="${g.name}" style="padding: 0.2rem 0.45rem; font-size: 0.75rem; color: #b91c1c;">🗑️</button>
					</div>
				`;
			});

			groupBlock.innerHTML = `
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
					<strong class="font-heading" style="color: var(--accent-red); font-size: 1.05rem;">Table: ${tbl}</strong>
					<span style="font-size: 0.8rem; color: var(--text-secondary); font-weight: bold; background: #fff; border: 1px solid var(--fg-pencil); padding: 1px 6px; border-radius: 3px;">${grouped[tbl].length} Seated</span>
				</div>
				<div style="display: flex; flex-direction: column; gap: 2px;">${listHtml}</div>
			`;
			tableCardsStream.appendChild(groupBlock);
		});

		// Attach delete listeners
		document.querySelectorAll('.btn-del-seat').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const gName = btn.getAttribute('data-name');
				seatedGuestList = seatedGuestList.filter(g => g.name !== gName);
				if (selectedGuestIndex >= seatedGuestList.length) {
					selectedGuestIndex = Math.max(0, seatedGuestList.length - 1);
				}
				renderPlaceCards();
			});
		});

		// Attach row click listeners for instant preview selection
		document.querySelectorAll('.guest-item-row').forEach(row => {
			row.addEventListener('click', () => {
				const idx = parseInt(row.getAttribute('data-idx'), 10);
				if (!isNaN(idx)) {
					selectedGuestIndex = idx;
					renderPlaceCards();
				}
			});
		});
	}

	// Capture PNG
	document.getElementById('btn-download-sample-png').addEventListener('click', () => {
		if (window.html2canvas) {
			window.html2canvas(previewCanvas, {
				scale: 3,
				backgroundColor: null,
				useCORS: true
			}).then(canvas => {
				const link = document.createElement('a');
				link.download = `Place_Card_${seatedGuestList[selectedGuestIndex]?.name?.replace(/\s+/g, '_') || 'Sample'}.png`;
				link.href = canvas.toDataURL("image/png");
				link.click();
			});
		} else {
			alert("Canvas initializing. Please try again in 2 seconds.");
		}
	});

	// Quick Add Guest
	document.getElementById('btn-add-guest').addEventListener('click', () => {
		const name = inputGuestName.value.trim();
		const table = inputTableNum.value.trim() || '1';
		const meal = selectMeal.value;

		if (name) {
			seatedGuestList.push({ name, table, meal });
			selectedGuestIndex = seatedGuestList.length - 1; // Select the newly added guest
			inputGuestName.value = '';
			renderPlaceCards();
		}
	});

	// Live typing preview
	inputGuestName.addEventListener('input', () => {
		if (seatedGuestList.length === 0) {
			renderPlaceCards();
		}
	});

	// Load Sample Tables
	document.getElementById('btn-load-samples').addEventListener('click', loadSampleTables);

	// Clear All
	document.getElementById('btn-clear-all').addEventListener('click', () => {
		seatedGuestList = [];
		selectedGuestIndex = 0;
		renderPlaceCards();
	});

	// Form Inputs Listeners
	[selectCardType, selectBorderTheme, chkShowMealIcons, chkShowTableBadge].forEach(el => {
		el.addEventListener('change', renderPlaceCards);
	});

	// 📝 Export Word Manifest (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const grouped = {};
		seatedGuestList.forEach(g => {
			const tbl = g.table || 'Unassigned';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push(g);
		});

		let tablesHtml = '';
		Object.keys(grouped).forEach(tbl => {
			let rows = '';
			grouped[tbl].forEach(g => {
				rows += `<tr><td style="padding:6px; border:1px solid #cbd5e1;">${g.name}</td><td style="padding:6px; border:1px solid #cbd5e1;">${g.meal || 'Standard'}</td></tr>`;
			});

			tablesHtml += `
				<h3 style="color:#1e3a8a; margin-top:20px; border-bottom:2px solid #cbd5e1; padding-bottom:4px;">Table: ${tbl} (${grouped[tbl].length} Guests)</h3>
				<table style="width:100%; border-collapse:collapse; margin-bottom:15px; font-size:12px;">
					<thead><tr style="background:#f1f5f9;"><th style="border:1px solid #cbd5e1; padding:6px; text-align:left;">Guest Name</th><th style="border:1px solid #cbd5e1; padding:6px; text-align:left;">Entree Choice</th></tr></thead>
					<tbody>${rows}</tbody>
				</table>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Wedding Reception Seating Manifest</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; color: #1e293b; }
					h1 { color: #0f172a; margin-bottom: 4px; font-size: 20px; }
					p { color: #64748b; font-size: 13px; margin-bottom: 20px; }
					th { border: 1px solid #cbd5e1; padding: 6px; }
					td { border: 1px solid #cbd5e1; padding: 6px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Official Reception Seating & Meal Manifest</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Total Seated Guests: <strong>${seatedGuestList.length}</strong></p>
				${tablesHtml}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Seating_Manifest_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print Cards
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString();
		document.getElementById('print-guest-count').textContent = seatedGuestList.length;

		const grid = document.getElementById('print-cards-grid');
		grid.innerHTML = '';

		const cardType = selectCardType.value;
		const theme = selectBorderTheme.value;
		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;

		if (cardType === 'tablenum') {
			// Print Table Numbers (Unique tables only)
			const uniqueTables = [...new Set(seatedGuestList.map(g => g.table))];
			if (uniqueTables.length === 0) uniqueTables.push("1");

			grid.style.gridTemplateColumns = "1fr 1fr";

			uniqueTables.forEach(tbl => {
				const card = document.createElement('div');
				card.style.cssText = `border: 2.5px solid #000; padding: 40px 20px; text-align: center; font-family: 'Playfair Display', serif; position: relative; height: 320px; box-sizing: border-box; page-break-inside: avoid; display: flex; flex-direction: column; justify-content: center; align-items: center; background: #fff; margin-bottom: 20px;`;
				card.innerHTML = `
					<p style="font-size: 14px; letter-spacing: 4px; text-transform: uppercase; margin: 0 0 10px 0;">TABLE</p>
					<div style="font-size: 54px; font-weight: bold; line-height: 1; margin: 5px 0;">${tbl.replace(/[^0-9]/g, '') || tbl}</div>
					<div style="width: 40px; height: 1.5px; background: #000; margin: 15px auto;"></div>
					<p style="font-size: 12px; font-style: italic; margin: 0;">Please Be Seated</p>
				`;
				grid.appendChild(card);
			});
		} else if (cardType === 'tent') {
			// Print Folded Tent Cards (with fold & cut lines)
			grid.style.gridTemplateColumns = "1fr 1fr";

			seatedGuestList.forEach(g => {
				const card = document.createElement('div');
				card.style.cssText = `border: 1.5px solid #000; height: 220px; display: flex; flex-direction: column; box-sizing: border-box; page-break-inside: avoid; background: #fff; margin-bottom: 20px; font-family: 'Playfair Display', serif;`;
				card.innerHTML = `
					<div style="flex: 1; border-bottom: 1px dashed #666; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #777;">
						✂️ FOLD LINE
					</div>
					<div style="flex: 1.25; padding: 12px; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; text-align: center;">
						<h2 style="font-size: 18px; margin: 0 0 4px 0;">${g.name}</h2>
						<div style="width: 30px; height: 1px; background: #000; margin: 4px auto;"></div>
						${showTable ? `<p style="font-size: 12px; font-weight: bold; margin: 2px 0 0 0; text-transform: uppercase;">Table ${g.table}</p>` : ''}
						${showMeal ? `<span style="position: absolute; bottom: 8px; right: 10px; font-size: 16px;">${g.meal.split(' ')[0] || '🥩'}</span>` : ''}
					</div>
				`;
				grid.appendChild(card);
			});
		} else {
			// Print Flat Escort Cards
			grid.style.gridTemplateColumns = "1fr 1fr";

			seatedGuestList.forEach(g => {
				const card = document.createElement('div');
				card.style.cssText = `border: 1.5px solid #000; padding: 25px 15px; text-align: center; font-family: 'Playfair Display', serif; position: relative; height: 130px; box-sizing: border-box; page-break-inside: avoid; background: #fff; margin-bottom: 15px; display: flex; flex-direction: column; justify-content: center; align-items: center;`;
				card.innerHTML = `
					<h2 style="font-size: 18px; margin: 0 0 4px 0;">${g.name}</h2>
					<div style="width: 30px; height: 1px; background: #000; margin: 4px auto;"></div>
					${showTable ? `<p style="font-size: 12px; font-weight: bold; margin: 2px 0 0 0; text-transform: uppercase;">Table ${g.table}</p>` : ''}
					${showMeal ? `<span style="position: absolute; bottom: 8px; right: 10px; font-size: 16px;">${g.meal.split(' ')[0] || '🥩'}</span>` : ''}
				`;
				grid.appendChild(card);
			});
		}

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Guest Name,Table Number,Meal Choice\n";
		seatedGuestList.forEach(g => {
			csv += `"${g.name}","Table ${g.table}","${g.meal || 'Standard'}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Place_Cards_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	loadSeatedGuests();
</script>
