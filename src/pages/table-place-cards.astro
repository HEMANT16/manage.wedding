<script is:inline>
	let seatedGuestList = [];

	const selectCardType = document.getElementById('select-card-type');
	const selectBorderTheme = document.getElementById('select-border-theme');
	const chkShowMealIcons = document.getElementById('chk-show-meal-icons');
	const chkShowTableBadge = document.getElementById('chk-show-table-badge');

	const prevGuestNameDisplay = document.getElementById('prev-guest-name-display');
	const prevTableBadgeDisplay = document.getElementById('prev-table-badge-display');
	const prevMealIconDisplay = document.getElementById('prev-meal-icon-display');
	const previewCanvas = document.getElementById('preview-placecard-canvas');

	const assignedCountBadge = document.getElementById('assigned-count-badge');
	const tableCardsStream = document.getElementById('table-cards-stream');

	function loadSeatedGuests() {
		try {
			const saved = localStorage.getItem('manage_wedding_guests');
			if (saved) {
				const all = JSON.parse(saved);
				seatedGuestList = all.filter(g => g.table && g.table.trim() !== "");
			}
		} catch (e) {
			seatedGuestList = [];
		}

		if (!seatedGuestList || seatedGuestList.length === 0) {
			loadSampleTables();
			return;
		}
		renderPlaceCards();
	}

	function loadSampleTables() {
		seatedGuestList = [
			{ name: "Olivia Johnson", table: "1", meal: "🥩 Beef" },
			{ name: "Liam Johnson", table: "1", meal: "🐟 Fish" },
			{ name: "Marcus Chen", table: "2", meal: "🍗 Chicken" },
			{ name: "Sophia Chen", table: "2", meal: "🥦 Vegetarian" },
			{ name: "David Miller", table: "3", meal: "🥩 Beef" },
			{ name: "Grandma Evelyn", table: "Head Table", meal: "🐟 Fish" },
			{ name: "Grandpa Joe", table: "Head Table", meal: "🥩 Beef" }
		];
		renderPlaceCards();
	}

	function renderPlaceCards() {
		const cardType = selectCardType.value;
		const theme = selectBorderTheme.value;
		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;

		// Preview update
		previewCanvas.className = `theme-${theme}`;
		
		if (cardType === 'tablenum') {
			prevGuestNameDisplay.textContent = "Table Number";
			prevTableBadgeDisplay.textContent = "TABLE 1";
			prevTableBadgeDisplay.style.fontSize = "1.8rem";
			prevMealIconDisplay.style.display = "none";
		} else {
			if (seatedGuestList.length > 0) {
				prevGuestNameDisplay.textContent = seatedGuestList[0].name;
				prevTableBadgeDisplay.textContent = `Table ${seatedGuestList[0].table}`;
				prevTableBadgeDisplay.style.fontSize = "0.9rem";
				prevMealIconDisplay.textContent = seatedGuestList[0].meal.split(' ')[0] || '🥩';
			} else {
				prevGuestNameDisplay.textContent = "Guest Name";
				prevTableBadgeDisplay.textContent = "Table 1";
				prevMealIconDisplay.textContent = "🥩";
			}
			prevTableBadgeDisplay.style.display = showTable ? "block" : "none";
			prevMealIconDisplay.style.display = showMeal ? "block" : "none";
		}

		assignedCountBadge.textContent = `${seatedGuestList.length} Guests`;

		// Group by table
		const grouped = {};
		seatedGuestList.forEach(g => {
			const tbl = g.table || 'Unassigned';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push(g);
		});

		tableCardsStream.innerHTML = '';
		if (seatedGuestList.length === 0) {
			tableCardsStream.innerHTML = `
				<div style="text-align: center; padding: 1rem; color: var(--text-secondary); font-style: italic; font-size: 0.9rem;">
					No seated guests yet. Click "✨ Load Sample Tables" to test!
				</div>
			`;
			return;
		}

		Object.keys(grouped).forEach(tbl => {
			const groupBlock = document.createElement('div');
			groupBlock.style.cssText = `background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.75rem;`;
			
			let listHtml = '';
			grouped[tbl].forEach((g, idx) => {
				listHtml += `
					<div style="display: flex; justify-content: space-between; align-items: center; padding: 0.25rem 0; border-bottom: 1px dotted #ccc; font-size: 0.88rem;">
						<span>${g.name} <small style="color:#666;">(${g.meal || 'No meal selected'})</small></span>
						<button type="button" class="btn-del-seat hand-btn secondary" data-name="${g.name}" style="padding: 0.15rem 0.4rem; font-size: 0.7rem; color: #b91c1c;">🗑️</button>
					</div>
				`;
			});

			groupBlock.innerHTML = `
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
					<strong class="font-heading" style="color: var(--accent-red); font-size: 1rem;">Table: ${tbl}</strong>
					<span style="font-size: 0.75rem; color: var(--text-secondary); font-weight: bold;">${grouped[tbl].length} Seated</span>
				</div>
				<div>${listHtml}</div>
			`;
			tableCardsStream.appendChild(groupBlock);
		});

		// Attach delete listeners
		document.querySelectorAll('.btn-del-seat').forEach(btn => {
			btn.addEventListener('click', () => {
				const gName = btn.getAttribute('data-name');
				seatedGuestList = seatedGuestList.filter(g => g.name !== gName);
				renderPlaceCards();
			});
		});
	}

	// Capture PNG
	document.getElementById('btn-download-sample-png').addEventListener('click', () => {
		if (window.html2canvas) {
			window.html2canvas(previewCanvas, {
				scale: 3,
				backgroundColor: null,
				useCORS: true
			}).then(canvas => {
				const link = document.createElement('a');
				link.download = `Place_Card_Sample.png`;
				link.href = canvas.toDataURL("image/png");
				link.click();
			});
		} else {
			alert("Canvas initializing. Please try again in 2 seconds.");
		}
	});

	// Quick Add Guest
	document.getElementById('btn-add-guest').addEventListener('click', () => {
		const nameInput = document.getElementById('input-new-guest-name');
		const tblInput = document.getElementById('input-new-table-num');
		const mealSelect = document.getElementById('select-new-meal');

		const name = nameInput.value.trim();
		const table = tblInput.value.trim() || '1';
		const meal = mealSelect.value;

		if (name) {
			seatedGuestList.push({ name, table, meal });
			nameInput.value = '';
			renderPlaceCards();
		}
	});

	// Load Sample Tables
	document.getElementById('btn-load-samples').addEventListener('click', loadSampleTables);

	// Clear All
	document.getElementById('btn-clear-all').addEventListener('click', () => {
		seatedGuestList = [];
		renderPlaceCards();
	});

	// Form Inputs Listeners
	[selectCardType, selectBorderTheme, chkShowMealIcons, chkShowTableBadge].forEach(el => {
		el.addEventListener('change', renderPlaceCards);
	});

	// 📝 Export Word Manifest (.doc)
	document.getElementById('btn-export-doc').addEventListener('click', () => {
		const grouped = {};
		seatedGuestList.forEach(g => {
			const tbl = g.table || 'Unassigned';
			if (!grouped[tbl]) grouped[tbl] = [];
			grouped[tbl].push(g);
		});

		let tablesHtml = '';
		Object.keys(grouped).forEach(tbl => {
			let rows = '';
			grouped[tbl].forEach(g => {
				rows += `<tr><td>${g.name}</td><td>${g.meal || 'Standard'}</td></tr>`;
			});

			tablesHtml += `
				<h3 style="color:#1e3a8a; margin-top:20px; border-bottom:1px solid #ccc; padding-bottom:4px;">Table: ${tbl} (${grouped[tbl].length} Guests)</h3>
				<table style="width:100%; border-collapse:collapse; margin-bottom:15px; font-size:12px;">
					<thead><tr style="background:#f2f2f2;"><th style="border:1px solid #ccc; padding:6px; text-align:left;">Guest Name</th><th style="border:1px solid #ccc; padding:6px; text-align:left;">Entree Choice</th></tr></thead>
					<tbody>${rows}</tbody>
				</table>
			`;
		});

		const html = `
			<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
			<head>
				<meta charset="utf-8">
				<title>Wedding Reception Seating Manifest</title>
				<style>
					body { font-family: 'Segoe UI', Arial, sans-serif; padding: 20px; }
					h1 { color: #2d2d2d; margin-bottom: 4px; }
					p { color: #555; font-size: 13px; margin-bottom: 20px; }
					th { border: 1px solid #ccc; padding: 6px; }
					td { border: 1px solid #ccc; padding: 6px; }
				</style>
			</head>
			<body>
				<h1>Manage.Wedding — Official Reception Seating & Meal Manifest</h1>
				<p>Generated on ${new Date().toLocaleDateString()} | Total Seated Guests: <strong>${seatedGuestList.length}</strong></p>
				${tablesHtml}
			</body>
			</html>
		`;

		const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Seating_Manifest_${new Date().toISOString().slice(0, 10)}.doc`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// 🖨️ Export PDF / Print Cards
	document.getElementById('btn-export-pdf').addEventListener('click', () => {
		document.getElementById('print-date').textContent = new Date().toLocaleDateString();
		document.getElementById('print-guest-count').textContent = seatedGuestList.length;

		const grid = document.getElementById('print-cards-grid');
		grid.innerHTML = '';

		const showMeal = chkShowMealIcons.checked;
		const showTable = chkShowTableBadge.checked;

		seatedGuestList.forEach(g => {
			const card = document.createElement('div');
			card.style.cssText = `border: 2px solid #000; padding: 25px 15px; text-align: center; font-family: 'Times New Roman', serif; position: relative; height: 130px; box-sizing: border-box;`;
			card.innerHTML = `
				<h2 style="font-size: 20px; margin: 10px 0 5px 0;">${g.name}</h2>
				<div style="width: 30px; height: 1px; background: #000; margin: 5px auto;"></div>
				${showTable ? `<p style="font-size: 13px; font-weight: bold; margin: 5px 0 0 0; text-transform: uppercase;">Table ${g.table}</p>` : ''}
				${showMeal ? `<span style="position: absolute; bottom: 8px; right: 10px; font-size: 16px;">${g.meal.split(' ')[0] || '🥩'}</span>` : ''}
			`;
			grid.appendChild(card);
		});

		window.print();
	});

	// 📊 Export Excel (.csv)
	document.getElementById('btn-export-csv').addEventListener('click', () => {
		let csv = "Guest Name,Table Number,Meal Choice\n";
		seatedGuestList.forEach(g => {
			csv += `"${g.name}","Table ${g.table}","${g.meal || 'Standard'}"\n`;
		});

		const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = `Wedding_Place_Cards_${new Date().toISOString().slice(0, 10)}.csv`;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	// Initialize
	loadSeatedGuests();
</script>
