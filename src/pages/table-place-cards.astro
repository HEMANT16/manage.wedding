---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "CalculatorApplication"],
      "@id": "https://manage.wedding/table-place-cards/#webapp",
      "name": "Wedding Place Cards & Table Numbers Maker",
      "url": "https://manage.wedding/table-place-cards",
      "description": "Free printable wedding place cards and table numbers generator. Create folded tent cards with meal icons, flat escort cards, and centerpiece table numbers with instant PDF, Word, and CSV exports.",
      "applicationCategory": "DesignApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Format, Print, and Organize Wedding Place & Escort Cards",
      "description": "Step-by-step instructions for selecting card layouts, embedding catering meal icons, printing on heavyweight cardstock, and trimming.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Step 1: Choose Card Format and Border Motif",
          "text": "Select folded tent cards (3.5x2 inches folded) for plate settings, flat cards for stands, or large table number signs."
        },
        {
          "@type": "HowToStep",
          "name": "Step 2: Assign Tables and Catering Meal Icons",
          "text": "Pair each guest name with their assigned table number and dietary indicator (beef, poultry, seafood, vegetarian) for catering banquet staff."
        },
        {
          "@type": "HowToStep",
          "name": "Step 3: Print on 80lb to 110lb Cardstock",
          "text": "Download high-resolution print sheets and feed heavy cover stock (216-300 GSM) through your printer or local print shop."
        },
        {
          "@type": "HowToStep",
          "name": "Step 4: Score, Trim, and Alphabetize",
          "text": "Use a rotary paper trimmer along the guide lines, score folded tents along the center spine, and arrange alphabetically for display."
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the difference between a place card and an escort card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An escort card is displayed at the reception entrance to tell guests which table number they are assigned to (e.g., 'Table 4'). A place card is placed directly at their specific seat at the table to assign their exact chair and display their pre-selected meal choice to catering staff."
          }
        },
        {
          "@type": "Question",
          "name": "What paper weight is best for printing DIY wedding place cards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use heavy cardstock between 80lb and 110lb cover weight (216 to 300 GSM). This ensures folded tent cards stand firmly on dinner napkins without collapsing or curling under reception venue lighting."
          }
        },
        {
          "@type": "Question",
          "name": "Why are meal indicators necessary on wedding place cards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Catering banquet servers rely on meal indicator stamps or icons (e.g. 🥩 Beef, 🐟 Fish, 🥦 Vegetarian) on place cards to quickly serve the correct hot entrees to guests without awkwardly interrupting speeches."
          }
        },
        {
          "@type": "Question",
          "name": "Can I export a master seating list for my caterer and venue coordinator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Click 'Export Word (.doc)' or 'Export PDF / Print' to generate an itemized table-by-table seating manifest complete with guest names, seat positions, and meal tallies for your catering captain."
          }
        }
      ]
    }
  ]
};
---

<Layout 
	title="Wedding Place Cards & Table Numbers Maker (Free Printable PDF & Word) | Manage.Wedding"
	description="Generate printable wedding place cards, folded tent cards, and table numbers with meal icons. Export cut-ready PDF sheets, Word rosters, and CSV files instantly."
	schema={schema}
>
	<!-- Include html2canvas for preview card capture -->
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

	<main style="max-width: 1200px; margin: 0 auto; padding: clamp(0.75rem, 2.5vw, 2rem); box-sizing: border-box; overflow-x: hidden;">
		
		<!-- Hero & Header (Centered Headings) -->
		<section class="section-paper" style="margin-bottom: 1.5rem; text-align: center;">
			<div style="max-width: 900px; margin: 0 auto; padding: 2.5rem 1rem;">
				<div class="tape" style="margin: 0 auto 1rem;"></div>
				<h1 class="font-heading" style="font-size: clamp(32px, 5vw, 56px); color: var(--fg-pencil); line-height: 1.15; text-align: center; margin-bottom: 0.75rem;">
					Place Cards & Table Numbers Maker
				</h1>
				<p class="font-body" style="font-size: 1.25rem; color: var(--fg-pencil); max-width: 680px; margin: 0 auto; text-align: center;">
					Generate print-ready folded tent cards, flat escort cards, and centerpiece table numbers. Include <strong>caterer meal icons</strong>, customize border motifs, and export <strong>Printable PDFs</strong> or <strong>Word (.doc)</strong> manifests.
				</p>
			</div>
		</section>

		<!-- 3-Step Visual Quick Guide Card -->
		<div class="hand-card" style="margin-bottom: 2rem; padding: 1.25rem; background: var(--bg-paper); border: 2px solid var(--fg-pencil);">
			<h2 class="font-heading" style="font-size: 1.25rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
				<span>📖</span> How to Generate Printable Place Cards in 3 Easy Steps
			</h2>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-red); font-size: 1rem; margin-bottom: 0.25rem;">
						1️⃣ Select Card Format & Theme
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Choose between folded tent cards (3.5" x 2" folded), flat escort cards, or large table numbers, and pick your border theme.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: var(--accent-blue); font-size: 1rem; margin-bottom: 0.25rem;">
						2️⃣ Organize Tables & Meal Icons
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Add guests and table numbers, or click <strong>"✨ Load Sample Tables"</strong>. Enable meal icons (Beef, Chicken, Fish, Veg) for seamless catering service.
					</p>
				</div>

				<div style="background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem;">
					<strong class="font-heading" style="display: block; color: #16a34a; font-size: 1rem; margin-bottom: 0.25rem;">
						3️⃣ Export PDF & Caterer Manifest
					</strong>
					<p class="font-body" style="font-size: 0.85rem; margin: 0; line-height: 1.4; color: var(--fg-pencil);">
						Click <strong>"🖨️ Export PDF / Print"</strong> for cut-ready printable sheets, or <strong>"📝 Export Word (.doc)"</strong> for a table manifest for your venue captain!
					</p>
				</div>
			</div>
		</div>

		<!-- Main Workspace Grid: Config Form + Live Preview & Table Roster -->
		<div style="display: grid; grid-template-columns: 1fr; lg:grid-template-columns: 1.05fr 0.95fr; gap: 2rem; align-items: start; margin-bottom: 3.5rem;" class="placecards-calc-grid">
			
			<!-- Left Column: Card Configuration & Table Manager -->
			<div class="hand-card" style="padding: 1.75rem; background: #fff;">
				
				<div style="margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
					<h2 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
						🏷️ Card Styling & Layout Options
					</h2>
					<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
						Customize place card format, border motifs, and table assignments
					</span>
				</div>

				<form id="placecards-form" style="display: flex; flex-direction: column; gap: 1rem;">
					
					<!-- Card Type & Border Theme -->
					<div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.6rem;">
						<div>
							<label for="select-card-type" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-red); margin-bottom: 0.25rem;">
								Card Format *
							</label>
							<select id="select-card-type" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
								<option value="tent" selected>🏷️ Folded Tent Cards (3.5" x 2" folded)</option>
								<option value="flat">🎴 Flat Escort Cards (3.5" x 2")</option>
								<option value="tablenum">🔢 Table Centerpiece Cards (5" x 7")</option>
							</select>
						</div>

						<div>
							<label for="select-border-theme" class="font-heading" style="display: block; font-size: 0.9rem; color: var(--accent-blue); margin-bottom: 0.25rem;">
								Artistic Border Theme
							</label>
							<select id="select-border-theme" style="width: 100%; box-sizing: border-box; padding: 0.5rem; border: 2px solid var(--fg-pencil); border-radius: 4px; background: #fff; font-family: var(--font-body); font-size: 0.9rem;">
								<option value="botanical" selected>🌿 Botanical Floral Border</option>
								<option value="classic">✒️ Classic Minimalist Double Line</option>
								<option value="crest">🏛️ Elegant Flourish & Corner Accents</option>
							</select>
						</div>
					</div>

					<!-- Options: Meal Icons & Table Number Badges -->
					<div style="background: var(--bg-paper); border: 1.5px dashed var(--fg-pencil); border-radius: 4px; padding: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem;">
						<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil); display: block;">
							⚙️ Place Card Customizations
						</span>
						<div style="display: flex; gap: 1rem; flex-wrap: wrap;">
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-meal-icons" checked style="accent-color: var(--fg-pencil);">
								<span>Show Caterer Meal Icons (🥩 / 🐟 / 🥦)</span>
							</label>
							<label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
								<input type="checkbox" id="chk-show-table-badge" checked style="accent-color: var(--fg-pencil);">
								<span>Show Table Number on Place Card</span>
							</label>
						</div>
					</div>

					<!-- Quick Add Guest & Table Entry -->
					<div style="background: var(--bg-paper); border: 1.5px solid var(--fg-pencil); border-radius: 4px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.6rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.4rem;">
							<span class="font-heading" style="font-size: 0.9rem; color: var(--fg-pencil);">
								👥 Table Seating List: <strong id="assigned-count-badge">0 Guests</strong>
							</span>
							<div style="display: flex; gap: 0.3rem;">
								<button type="button" id="btn-load-samples" class="hand-btn" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; background: #eff6ff;">
									✨ Load Sample Tables
								</button>
								<button type="button" id="btn-clear-all" class="hand-btn secondary" style="padding: 0.25rem 0.55rem; font-size: 0.78rem; color: #b91c1c;">
									🗑️ Clear All
								</button>
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1.3fr 0.8fr 0.9fr auto; gap: 0.35rem; align-items: center;">
							<input type="text" id="input-new-guest-name" placeholder="Guest Name" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<input type="text" id="input-new-table-num" placeholder="Table #" value="1" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem;">
							<select id="select-new-meal" style="padding: 0.4rem; border: 1px solid var(--fg-pencil); border-radius: 4px; font-size: 0.85rem; background: #fff;">
								<option value="🥩 Beef">🥩 Beef</option>
								<option value="🍗 Chicken">🍗 Chicken</option>
								<option value="🐟 Fish">🐟 Fish</option>
								<option value="🥦 Vegetarian">🥦 Veg</option>
							</select>
							<button type="button" id="btn-add-guest" class="hand-btn" style="padding: 0.4rem 0.65rem; font-size: 0.85rem;">
								+ Add
							</button>
						</div>
					</div>

				</form>
			</div>

			<!-- Right Column: Live Card Preview & Table Cards Stream -->
			<div style="display: flex; flex-direction: column; gap: 1.5rem;">
				
				<!-- Live Card Preview Card -->
				<div class="hand-card" style="padding: 1.75rem; background: #fff;">
					
					<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
						<div style="width: 100%;">
							<h3 class="font-heading" style="font-size: 1.4rem; color: var(--fg-pencil); margin: 0; text-align: center;">
								🖼️ Live Place Card Preview
							</h3>
							<span class="font-body" style="font-size: 0.85rem; color: var(--text-secondary); display: block; text-align: center;">
								3.5" x 2" standard table place card scale
							</span>
						</div>

						<!-- Exports Toolbar -->
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 0.5rem;">
							<button type="button" id="btn-export-doc" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #eff6ff;">
								📝 Export Word Manifest (.doc)
							</button>
							<button type="button" id="btn-export-pdf" class="hand-btn" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; background: #fef2f2;">
								🖨️ Export PDF / Print Cards
							</button>
							<button type="button" id="btn-export-csv" class="hand-btn secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
								📊 CSV
							</button>
						</div>
					</div>

					<!-- Interactive Preview Place Card Frame -->
					<div id="preview-placecard-canvas" class="theme-botanical" style="border: 2px solid var(--fg-pencil); border-radius: 4px; padding: 1.75rem 1.25rem; background: #faf8f5; text-align: center; position: relative; box-shadow: 3px 3px 0px var(--fg-pencil); margin-bottom: 1.25rem;">
						
						<!-- Corner accents -->
						<div style="position: absolute; top: 4px; left: 4px; width: 12px; height: 12px; border-top: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; top: 4px; right: 4px; width: 12px; height: 12px; border-top: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 4px; left: 4px; width: 12px; height: 12px; border-bottom: 2px solid var(--fg-pencil); border-left: 2px solid var(--fg-pencil);"></div>
						<div style="position: absolute; bottom: 4px; right: 4px; width: 12px; height: 12px; border-bottom: 2px solid var(--fg-pencil); border-right: 2px solid var(--fg-pencil);"></div>

						<h2 id="prev-guest-name-display" class="font-heading" style="font-size: 1.6rem; color: var(--fg-pencil); margin: 0 0 0.3rem 0; line-height: 1.2;">
							Olivia Johnson
						</h2>

						<div style="width: 40px; height: 1.5px; background: var(--fg-pencil); margin: 0.4rem auto;"></div>

						<p id="prev-table-badge-display" class="font-body" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent-red); margin: 0.3rem 0 0 0; font-weight: bold;">
							Table 1
						</p>

						<div id="prev-meal-icon-display" style="position: absolute; bottom: 6px; right: 8px; font-size: 1.1rem;" title="Meal Choice">
							🥩
						</div>
					</div>

					<button type="button" id="btn-download-sample-png" class="hand-btn" style="width: 100%; text-align: center; font-size: 0.95rem; padding: 0.55rem; background: #f0fdf4;">
						📸 Download Sample Place Card PNG
					</button>

				</div>

				<!-- Table Roster & Group Breakdown Stream -->
				<div class="hand-card" style="padding: 1.5rem; background: #fff; max-height: 400px; overflow-y: auto;">
					<h3 class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil); margin: 0 0 0.75rem 0; text-align: center;">
						📋 Assigned Guests by Table
					</h3>
					<div id="table-cards-stream" style="display: flex; flex-direction: column; gap: 0.75rem;">
						<!-- Populated via JS -->
					</div>
				</div>

			</div>

		</div>

		<!-- Hidden Printable Sheet for PDF Generation -->
		<div id="printable-pdf-sheet" class="print-only">
			<div style="border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; text-align: center;">
				<h1 style="font-size: 22px; margin: 0 0 4px 0;">Official Wedding Reception Place Cards</h1>
				<p style="margin: 0; font-size: 12px; color: #555;">Exported on: <span id="print-date"></span> | Total Assigned Guests: <span id="print-guest-count"></span></p>
			</div>
			<div id="print-cards-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;"></div>
		</div>

		<!-- ⚡ Quick Rule of Thumb (BLUF) Post-It Box -->
		<div class="hand-card" style="margin: 0 auto 3rem auto; max-width: 900px; background: var(--post-it); border: 2px solid var(--fg-pencil); box-shadow: 4px 4px 0px var(--fg-pencil); padding: clamp(1.25rem, 3vw, 2rem); position: relative;">
			<div class="tape" style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%);"></div>
			<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px dashed var(--fg-pencil); padding-bottom: 0.75rem;">
				<h2 class="font-heading" style="font-size: clamp(1.3rem, 2.5vw, 1.7rem); color: var(--fg-pencil); margin: 0; display: flex; align-items: center; gap: 0.5rem;">
					<span>⚡</span> Quick Rule of Thumb (BLUF)
				</h2>
				<span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(0,0,0,0.06); padding: 0.2rem 0.6rem; border-radius: 4px; border: 1px solid var(--fg-pencil);">
					1-Minute Stationery Specs
				</span>
			</div>
			
			<!-- Core Formula Banner -->
			<div style="background: rgba(255, 255, 255, 0.9); border: 2px solid var(--fg-pencil); border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
				<p class="font-body" style="font-size: 1.05rem; line-height: 1.6; margin: 0 0 0.5rem 0; color: var(--fg-pencil);">
					<strong>Standard Place Card Specs:</strong> 
					<span style="display: inline-block; background: #fef3c7; border: 1px solid #d97706; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #92400e; margin: 2px 4px;">Folded Tent Cards = 3.5" × 2" (4 per letter sheet)</span> · 
					<span style="display: inline-block; background: #eff6ff; border: 1px solid #3b82f6; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #1e40af; margin: 2px 4px;">Flat Escort Cards = 3.5" × 2" (8–10 per sheet)</span> · 
					<span style="display: inline-block; background: #f0fdf4; border: 1px solid #22c55e; padding: 2px 8px; border-radius: 4px; font-weight: 700; color: #166534; margin: 2px 4px;">Table Numbers = 5" × 7" (2 per sheet)</span>
				</p>
				<p class="font-body" style="font-size: 0.9rem; margin: 0; color: var(--text-secondary); line-height: 1.5;">
					<strong>Print & Legibility Standard:</strong> Print on <strong>80lb to 110lb cover cardstock (216–300 GSM)</strong>. Use <strong>16–20pt font</strong> for guest names, <strong>12–14pt</strong> for table numbers, and <strong>14–18px meal icons</strong> for caterers.
				</p>
			</div>

			<!-- Semantic Benchmark Table -->
			<div style="overflow-x: auto;">
				<table style="width: 100%; border-collapse: collapse; background: #fff; border: 2px solid var(--fg-pencil); font-family: var(--font-body); font-size: 0.92rem; text-align: left;">
					<thead>
						<tr style="background: var(--muted-paper); border-bottom: 2px solid var(--fg-pencil);">
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Stationery Item</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Finished Size</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-blue);">Per Letter Sheet (8.5×11")</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Recommended Cardstock</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem; color: var(--accent-red);">Font Sizing Standard</th>
							<th style="padding: 0.65rem 0.75rem; border: 1px solid var(--fg-pencil); font-family: var(--font-heading); font-size: 1rem;">Primary Reception Role</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700;">Folded Tent Place Card</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">3.5" × 2" (Folded)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); font-weight: 700; color: var(--accent-blue);">4 Cards (Unfolded: 3.5×4")</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">100lb–110lb Cover (Self-standing)</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">Name: 18–20pt · Table: 12pt</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Assigned dinner plate setting</td>
						</tr>
						<tr style="background: #faf8f3;">
