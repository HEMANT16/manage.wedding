							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil); color: var(--accent-red); font-weight: 600;">Name: 16–18pt · Table: 14pt</td>
							<td style="padding: 0.55rem 0.75rem; border: 1px solid var(--fg-pencil);">Entrance table / card stand</td>
						</tr>
