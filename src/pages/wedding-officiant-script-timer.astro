  // State Management
  let currentPresetKey = 'romantic';
  let phasesState = JSON.parse(JSON.stringify(ceremonyPresets.romantic.phases));

  // DOM Elements
  const inputPartnerA = document.getElementById('input-partner-a');
  const inputPartnerB = document.getElementById('input-partner-b');
  const inputOfficiant = document.getElementById('input-officiant-name');
  const selectPace = document.getElementById('select-speaking-pace');
  const phasesContainer = document.getElementById('phases-container');

  const displayTotalRuntime = document.getElementById('display-total-runtime');
  const displayCeremonyStatus = document.getElementById('display-ceremony-status');
  const displayTotalWords = document.getElementById('display-total-words');
  const displaySpokenDuration = document.getElementById('display-spoken-duration');
  const displayActionDuration = document.getElementById('display-action-duration');
  const displayTotalCards = document.getElementById('display-total-cards');
  const runtimeGaugeBar = document.getElementById('runtime-gauge-bar');

  function getCleanText(text) {
    const partnerA = inputPartnerA.value.trim() || 'Partner A';
    const partnerB = inputPartnerB.value.trim() || 'Partner B';
    const officiant = inputOfficiant.value.trim() || 'Officiant';

    return text
      .replace(/{PARTNER_A}/g, partnerA)
      .replace(/{PARTNER_B}/g, partnerB)
      .replace(/{OFFICIANT}/g, officiant);
  }

  function countWords(str) {
    if (!str) return 0;
    // Strip bracketed stage directions from word count so speaking time represents actual spoken words
    const stripped = str.replace(/\[.*?\]/g, ' ').trim();
    if (!stripped) return 0;
    return stripped.split(/\s+/).filter(w => w.length > 0).length;
  }

  function formatTime(seconds) {
    const mins = Math.floor(seconds / 60);
    const secs = Math.round(seconds % 60);
    return `${mins}m ${secs.toString().padStart(2, '0')}s`;
  }

  function renderPhases() {
    phasesContainer.innerHTML = '';
    const pace = parseInt(selectPace.value, 10) || 120;

    phasesState.forEach((phase, idx) => {
      const renderedText = getCleanText(phase.text);
      const words = countWords(renderedText);
      const spokenSec = Math.round((words / pace) * 60);
      const actionSec = parseInt(phase.durationAction, 10) || 0;
      const totalPhaseSec = spokenSec + actionSec;

      const card = document.createElement('div');
      card.className = 'hand-card phase-card-item';
      card.id = `phase-card-${phase.id}`;
      card.style.cssText = 'background: #fff; border: 1.5px solid var(--fg-pencil); border-radius: 6px; padding: 1.25rem; margin-bottom: 0.5rem; transition: box-shadow 0.2s ease;';

      card.innerHTML = `
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; border-bottom: 1.5px dashed #cbd5e1; padding-bottom: 0.75rem; margin-bottom: 0.75rem;">
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="font-size: 1.4rem;">${phase.icon}</span>
            <div>
              <strong class="font-heading" style="font-size: 1.15rem; color: var(--fg-pencil);">
                Phase ${phase.id}: ${phase.title}
              </strong>
              <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.1rem;">
                Card ${phase.id} of 9 • <span class="phase-words-display" style="font-weight: 600;">${words} words</span> (~${formatTime(spokenSec)} speaking + ${formatTime(actionSec)} buffer)
              </div>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span class="font-heading phase-runtime-badge" style="font-size: 1.2rem; color: var(--accent-blue); background: #f0f9ff; border: 1px solid #bae6fd; padding: 0.2rem 0.6rem; border-radius: 4px;">
              ⏱️ ${formatTime(totalPhaseSec)}
            </span>
          </div>
        </div>

        <div style="margin-bottom: 0.75rem;">
          <label style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.25rem;">
            <span>Physical Action, Music & Emotional Pause Buffer:</span>
            <span id="label-buffer-${phase.id}" style="color: #854d0e; font-weight: 700;">${actionSec} seconds</span>
          </label>
          <input type="range" class="phase-slider" data-phase-id="${phase.id}" min="0" max="180" step="5" value="${actionSec}" style="width: 100%; cursor: pointer;" />
        </div>

        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--fg-pencil); margin-bottom: 0.25rem;">
            Script & Stage Directions (Stage cues in [BRACKETS]):
          </label>
          <textarea class="phase-textarea" data-phase-id="${phase.id}" rows="6" style="width: 100%; box-sizing: border-box; padding: 0.75rem; font-family: 'Times New Roman', Georgia, serif; font-size: 1rem; line-height: 1.6; border: 1.5px solid var(--fg-pencil); border-radius: 4px; background: #fafafa; resize: vertical;">${phase.text}</textarea>
        </div>
      `;

      phasesContainer.appendChild(card);
    });

    attachPhaseEventListeners();
    updateRecalculation();
  }

  function attachPhaseEventListeners() {
    // Textarea input
    document.querySelectorAll('.phase-textarea').forEach(ta => {
      ta.addEventListener('input', (e) => {
        const id = parseInt(e.target.getAttribute('data-phase-id'), 10);
        const phase = phasesState.find(p => p.id === id);
        if (phase) {
          phase.text = e.target.value;
          updateRecalculation();
        }
      });
    });

    // Range slider input
    document.querySelectorAll('.phase-slider').forEach(sl => {
      sl.addEventListener('input', (e) => {
        const id = parseInt(e.target.getAttribute('data-phase-id'), 10);
        const phase = phasesState.find(p => p.id === id);
        if (phase) {
          phase.durationAction = parseInt(e.target.value, 10);
          const lbl = document.getElementById(`label-buffer-${id}`);
          if (lbl) lbl.textContent = `${phase.durationAction} seconds`;
          updateRecalculation();
        }
      });
    });
  }

  function updateRecalculation() {
    const pace = parseInt(selectPace.value, 10) || 120;
    let grandWords = 0;
    let grandSpokenSec = 0;
    let grandActionSec = 0;

    phasesState.forEach(phase => {
      const renderedText = getCleanText(phase.text);
      const words = countWords(renderedText);
      const spokenSec = Math.round((words / pace) * 60);
      const actionSec = parseInt(phase.durationAction, 10) || 0;
      const totalSec = spokenSec + actionSec;

      grandWords += words;
      grandSpokenSec += spokenSec;
      grandActionSec += actionSec;

      // Update in card if rendered
      const card = document.getElementById(`phase-card-${phase.id}`);
      if (card) {
        const wordsSpan = card.querySelector('.phase-words-display');
        const badge = card.querySelector('.phase-runtime-badge');
        if (wordsSpan) wordsSpan.textContent = `${words} words`;
        if (badge) badge.textContent = `⏱️ ${formatTime(totalSec)}`;
      }
    });

    const grandTotalSec = grandSpokenSec + grandActionSec;
    const totalMinutes = grandTotalSec / 60;

    displayTotalRuntime.textContent = formatTime(grandTotalSec);
    displayTotalWords.textContent = `${grandWords.toLocaleString()} words`;
    displaySpokenDuration.textContent = formatTime(grandSpokenSec);
    displayActionDuration.textContent = formatTime(grandActionSec);
    displayTotalCards.textContent = `9 Cards`;

    // Visual gauge
    const pct = Math.min(100, Math.max(5, (totalMinutes / 35) * 100));
    runtimeGaugeBar.style.width = `${pct}%`;

    // Status evaluation
    if (totalMinutes < 14) {
      displayCeremonyStatus.textContent = '⚡ Short / Elopement (< 14 min)';
      displayCeremonyStatus.style.color = 'var(--accent-blue)';
      runtimeGaugeBar.style.backgroundColor = 'var(--accent-blue)';
    } else if (totalMinutes >= 14 && totalMinutes <= 26) {
      displayCeremonyStatus.textContent = '✨ Ideal Sweet Spot (18–25 min)';
      displayCeremonyStatus.style.color = '#16a34a';
      runtimeGaugeBar.style.backgroundColor = '#16a34a';
    } else if (totalMinutes > 26 && totalMinutes <= 34) {
      displayCeremonyStatus.textContent = '⚠️ Moderately Long (26–34 min)';
      displayCeremonyStatus.style.color = '#ca8a04';
      runtimeGaugeBar.style.backgroundColor = '#eab308';
    } else {
      displayCeremonyStatus.textContent = '🛑 Over 35 min (Consider trimming speech)';
      displayCeremonyStatus.style.color = 'var(--accent-red)';
      runtimeGaugeBar.style.backgroundColor = 'var(--accent-red)';
    }
  }

  // Presets click handling
  document.querySelectorAll('.btn-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const presetKey = btn.getAttribute('data-preset');
      if (ceremonyPresets[presetKey]) {
        currentPresetKey = presetKey;
        phasesState = JSON.parse(JSON.stringify(ceremonyPresets[presetKey].phases));
        
        document.querySelectorAll('.btn-preset').forEach(b => {
          b.style.background = '#fff';
          b.style.borderColor = 'var(--fg-pencil)';
          b.style.fontWeight = 'normal';
        });
        btn.style.background = '#fef08a';
        btn.style.fontWeight = 'bold';

        renderPhases();
      }
    });
  });

  // Name & Pace live update
  [inputPartnerA, inputPartnerB, inputOfficiant, selectPace].forEach(inp => {
    inp.addEventListener('input', () => {
      updateRecalculation();
    });
  });

  // Expand / Collapse buttons
  document.getElementById('btn-expand-all').addEventListener('click', () => {
    document.querySelectorAll('.phase-textarea').forEach(ta => ta.style.display = 'block');
  });
  document.getElementById('btn-collapse-all').addEventListener('click', () => {
    document.querySelectorAll('.phase-textarea').forEach(ta => ta.style.display = 'none');
  });

  // ==========================================
  // Teleprompter & Live Stopwatch Rehearsal Mode
  // ==========================================
  const teleprompterModal = document.getElementById('teleprompter-modal');
  const btnOpenTp = document.getElementById('btn-open-teleprompter');
  const btnCloseTp = document.getElementById('btn-close-teleprompter');
  const tpTitle = document.getElementById('tp-phase-title');
  const tpCounter = document.getElementById('tp-phase-counter');
  const tpTextBody = document.getElementById('tp-text-body');
  const tpTimerDisplay = document.getElementById('tp-timer-display');
  const tpTotalTimerDisplay = document.getElementById('tp-total-timer-display');
  const tpBtnStart = document.getElementById('tp-btn-start');
  const tpBtnPause = document.getElementById('tp-btn-pause');
  const tpBtnReset = document.getElementById('tp-btn-reset');
  const tpBtnPrev = document.getElementById('tp-btn-prev');
  const tpBtnNext = document.getElementById('tp-btn-next');
  const tpProgressDots = document.getElementById('tp-progress-dots');

  let tpCurrentIndex = 0;
  let tpInterval = null;
  let tpPhaseStartTime = 0;
  let tpPhaseElapsed = 0;
  let tpTotalElapsed = 0;
  let tpIsRunning = false;

  function formatStopwatch(ms) {
    const sec = Math.floor(ms / 1000);
    const m = Math.floor(sec / 60).toString().padStart(2, '0');
    const s = (sec % 60).toString().padStart(2, '0');
    const tenth = Math.floor((ms % 1000) / 100);
    return `${m}:${s}.${tenth}`;
  }

  function formatStopwatchSimple(ms) {
    const sec = Math.floor(ms / 1000);
    const m = Math.floor(sec / 60).toString().padStart(2, '0');
    const s = (sec % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  }

  function loadTeleprompterPhase(index) {
    tpCurrentIndex = index;
    const phase = phasesState[tpCurrentIndex];
    if (!phase) return;

    tpTitle.textContent = `Phase ${phase.id}: ${phase.title}`;
    const pace = parseInt(selectPace.value, 10) || 120;
    const clean = getCleanText(phase.text);
    const words = countWords(clean);
    const estSec = Math.round((words / pace) * 60) + (parseInt(phase.durationAction, 10) || 0);

    tpCounter.textContent = `Phase ${phase.id} of 9 • Target: ${formatTime(estSec)}`;
    tpProgressDots.textContent = `${phase.id} / 9`;

    // Format bracketed directions nicely
    let formattedHtml = clean
      .replace(/\n\n/g, '<br/><br/>')
      .replace(/\[(.*?)\]/g, '<span style="background:#e2e8f0; color:#0f172a; padding:2px 6px; border-radius:4px; font-size:1.1rem; font-weight:bold; display:inline-block; margin:4px 0;">[$1]</span>');

    tpTextBody.innerHTML = formattedHtml;
    tpTextBody.scrollTop = 0;

    tpBtnPrev.disabled = tpCurrentIndex === 0;
    tpBtnNext.disabled = tpCurrentIndex === phasesState.length - 1;
    tpBtnPrev.style.opacity = tpCurrentIndex === 0 ? '0.5' : '1';
    tpBtnNext.style.opacity = tpCurrentIndex === phasesState.length - 1 ? '0.5' : '1';
  }

  btnOpenTp.addEventListener('click', () => {
    teleprompterModal.style.display = 'flex';
    loadTeleprompterPhase(0);
  });

  btnCloseTp.addEventListener('click', () => {
    teleprompterModal.style.display = 'none';
    if (tpIsRunning) {
      clearInterval(tpInterval);
      tpIsRunning = false;
      tpBtnStart.style.display = 'inline-block';
      tpBtnPause.style.display = 'none';
    }
  });

  tpBtnStart.addEventListener('click', () => {
    if (!tpIsRunning) {
      tpIsRunning = true;
      tpPhaseStartTime = Date.now() - tpPhaseElapsed;
      tpInterval = setInterval(() => {
        tpPhaseElapsed = Date.now() - tpPhaseStartTime;
        tpTotalElapsed += 100;
        tpTimerDisplay.textContent = formatStopwatch(tpPhaseElapsed);
        tpTotalTimerDisplay.textContent = formatStopwatchSimple(tpTotalElapsed);
      }, 100);
      tpBtnStart.style.display = 'none';
      tpBtnPause.style.display = 'inline-block';
    }
  });

  tpBtnPause.addEventListener('click', () => {
    if (tpIsRunning) {
      tpIsRunning = false;
      clearInterval(tpInterval);
      tpBtnStart.style.display = 'inline-block';
      tpBtnPause.style.display = 'none';
    }
  });

  tpBtnReset.addEventListener('click', () => {
    tpIsRunning = false;
    clearInterval(tpInterval);
    tpPhaseElapsed = 0;
    tpTotalElapsed = 0;
    tpTimerDisplay.textContent = '00:00.0';
    tpTotalTimerDisplay.textContent = '00:00';
    tpBtnStart.style.display = 'inline-block';
    tpBtnPause.style.display = 'none';
  });

  tpBtnPrev.addEventListener('click', () => {
    if (tpCurrentIndex > 0) {
      tpPhaseElapsed = 0;
      tpTimerDisplay.textContent = '00:00.0';
      if (tpIsRunning) tpPhaseStartTime = Date.now();
      loadTeleprompterPhase(tpCurrentIndex - 1);
    }
  });

  tpBtnNext.addEventListener('click', () => {
    if (tpCurrentIndex < phasesState.length - 1) {
      tpPhaseElapsed = 0;
      tpTimerDisplay.textContent = '00:00.0';
      if (tpIsRunning) tpPhaseStartTime = Date.now();
      loadTeleprompterPhase(tpCurrentIndex + 1);
    }
  });

  // ==========================================
  // Export Word (.doc) Feature
  // ==========================================
  document.getElementById('btn-export-doc').addEventListener('click', () => {
    const partnerA = inputPartnerA.value.trim() || 'Partner A';
    const partnerB = inputPartnerB.value.trim() || 'Partner B';
    const officiant = inputOfficiant.value.trim() || 'Officiant';
    const pace = parseInt(selectPace.value, 10) || 120;

    let phasesHtml = '';
    phasesState.forEach(p => {
      const clean = getCleanText(p.text);
      const words = countWords(clean);
      const spokenSec = Math.round((words / pace) * 60);
      const actionSec = parseInt(p.durationAction, 10) || 0;
      const totalSec = spokenSec + actionSec;

      const paragraphs = clean.split('\n\n').filter(t => t.trim().length > 0);
      let pTags = '';
      paragraphs.forEach(par => {
        pTags += `<p style="font-size:14pt; line-height:1.7; margin-bottom:12pt; color:#111;">${par.replace(/\[(.*?)\]/g, '<strong style="color:#0f172a; background:#e2e8f0; padding:2pt 4pt;">[$1]</strong>')}</p>`;
      });

      phasesHtml += `
        <div style="border: 2pt solid #000; padding: 18pt; margin-bottom: 25pt; page-break-inside: avoid;">
          <div style="border-bottom: 1pt solid #000; padding-bottom: 6pt; margin-bottom: 12pt; font-size: 11pt; font-weight: bold; text-transform: uppercase;">
            <span>CARD ${p.id} OF 9 — ${p.title}</span> | 
            <span>EST. TIME: ${formatTime(totalSec)}</span> | 
            <span>${words} WORDS</span>
          </div>
          ${pTags}
        </div>
      `;
    });

    const docHtml = `
      <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
      <head>
        <meta charset="utf-8">
        <title>Wedding Ceremony Script - ${partnerA} & ${partnerB}</title>
        <style>
          body { font-family: 'Times New Roman', Georgia, serif; padding: 25pt; font-size: 14pt; }
          h1 { color: #1e3a8a; font-size: 20pt; margin-bottom: 4pt; }
          .meta-box { border: 1pt solid #cbd5e1; background: #f8fafc; padding: 10pt; font-size: 10pt; margin-bottom: 20pt; color: #334155; }
        </style>
      </head>
      <body>
        <h1>Wedding Ceremony Officiant Script — ${partnerA} & ${partnerB}</h1>
        <div class="meta-box">
          <strong>Officiant:</strong> ${officiant} | 
          <strong>Total Ceremony Time:</strong> ${displayTotalRuntime.textContent} | 
          <strong>Speaking Cadence:</strong> ${pace} WPM | 
          <strong>Preset:</strong> ${ceremonyPresets[currentPresetKey]?.name || 'Custom'}
        </div>
        ${phasesHtml}
      </body>
      </html>
    `;

    const blob = new Blob(['\ufeff', docHtml], { type: 'application/msword' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Officiant_Script_${partnerA}_${partnerB}_${new Date().toISOString().slice(0, 10)}.doc`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  // ==========================================
  // Export Vector PDF / Print A5 Cards Feature
  // ==========================================
  document.getElementById('btn-export-pdf').addEventListener('click', () => {
    const listContainer = document.getElementById('print-cue-cards-list');
    listContainer.innerHTML = '';
    const pace = parseInt(selectPace.value, 10) || 120;

    phasesState.forEach(p => {
      const clean = getCleanText(p.text);
      const words = countWords(clean);
      const spokenSec = Math.round((words / pace) * 60);
      const actionSec = parseInt(p.durationAction, 10) || 0;
      const totalSec = spokenSec + actionSec;

      const card = document.createElement('div');
      card.className = 'cue-card-page';

      const paragraphs = clean.split('\n\n').filter(t => t.trim().length > 0);
      let bodyHtml = '';
      paragraphs.forEach(par => {
        bodyHtml += `<p style="margin-bottom: 12px; font-size: 14pt; line-height: 1.6;">${par.replace(/\[(.*?)\]/g, '<span class="cue-card-stage-dir">[$1]</span>')}</p>`;
      });

      card.innerHTML = `
        <div class="cue-card-header">
          <span>CARD ${p.id} OF 9 • ${p.title}</span>
          <span>EST: ${formatTime(totalSec)} (${words} WORDS)</span>
        </div>
        <div class="cue-card-body">
          ${bodyHtml}
        </div>
      `;

      listContainer.appendChild(card);
    });

    window.print();
  });

  // ==========================================
  // Copy Full Text to Clipboard
  // ==========================================
  document.getElementById('btn-copy-script').addEventListener('click', () => {
    const partnerA = inputPartnerA.value.trim() || 'Partner A';
    const partnerB = inputPartnerB.value.trim() || 'Partner B';
    const officiant = inputOfficiant.value.trim() || 'Officiant';

    let fullText = `WEDDING CEREMONY SCRIPT: ${partnerA} & ${partnerB}\n`;
    fullText += `Officiant: ${officiant} | Est. Duration: ${displayTotalRuntime.textContent}\n`;
    fullText += `====================================================\n\n`;

    phasesState.forEach(p => {
      fullText += `--- PHASE ${p.id}: ${p.title.toUpperCase()} ---\n`;
      fullText += `${getCleanText(p.text)}\n\n`;
    });

    navigator.clipboard.writeText(fullText).then(() => {
      const btn = document.getElementById('btn-copy-script');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span>✅</span> <strong>Copied!</strong>';
      setTimeout(() => {
        btn.innerHTML = originalText;
      }, 2000);
    });
  });

  // Initial render on page load
  renderPhases();
</script>
